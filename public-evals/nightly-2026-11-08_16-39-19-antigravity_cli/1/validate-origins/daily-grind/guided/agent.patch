+  <script type="module">
+    // Trusted ordering origin and current application site origin
+    const TRUSTED_ORDER_URL = 'https://order.dailygrind.com';
+    const TRUSTED_SITE_DOMAIN = globalThis.location?.hostname || 'dailygrind.com';
+
+    const TRUSTED_ORDER_ORIGIN =
+      'Origin' in globalThis ? Origin.from(TRUSTED_ORDER_URL) : null;
+    const APP_ORIGIN =
+      'Origin' in globalThis ? Origin.from(self) : null;
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        // Synthetic new MessageEvent('message', { origin }) objects in tests lack an
+        // internal browser origin; fall back to parsing candidate.origin if it is a URL.
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    // 1. Verify exact origin for privileged cross-window ordering messages
+    export function isTrustedSameOrigin(candidate, trustedReference = TRUSTED_ORDER_ORIGIN ?? TRUSTED_ORDER_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          const trustedOrigin =
+            trustedReference instanceof Origin
+              ? trustedReference
+              : Origin.from(trustedReference);
+          const candidateOrigin = extractOrigin(candidate);
+          return !candidateOrigin.opaque && candidateOrigin.isSameOrigin(trustedOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(extractUrlString(trustedReference));
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedUrl.origin;
+      } catch {
+        // Rejects invalid URLs, "null" strings, or unsupported objects
+        return false;
+      }
+    }
+
+    // 2. Validate same-site redirect URLs and classify internal vs. external links
+    export function isAllowedSameSiteUrl(candidateUrlOrElement, siteReference = APP_ORIGIN ?? globalThis) {
+      try {
+        if ('Origin' in globalThis) {
+          const referenceOrigin =
+            siteReference instanceof Origin
+              ? siteReference
+              : Origin.from(siteReference);
+          const candidateOrigin = extractOrigin(candidateUrlOrElement);
+          if (candidateOrigin.opaque) return false;
+          return candidateOrigin.isSameSite(referenceOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidateUrlOrElement), globalThis.location?.href);
+        const trustedUrl = new URL(extractUrlString(siteReference), globalThis.location?.href);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedUrl.protocol &&
+          (candidateUrl.hostname === TRUSTED_SITE_DOMAIN ||
+            candidateUrl.hostname.endsWith(`.${TRUSTED_SITE_DOMAIN}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    // 3. Distinguish and pin opaque origins for the sandboxed rewards iframe widget
+    let pinnedSandboxOrigin = 'Origin' in globalThis ? new Origin() : null;
+    let isSandboxPinned = false;
+
+    export function handleSandboxedWidgetMessage(event, expectedWidgetWindow) {
+      try {
+        if ('Origin' in globalThis) {
+          const senderOrigin = Origin.from(event);
+          if (!senderOrigin.opaque) return false;
+
+          // Pin the opaque origin only once on initialization from the expected sandboxed iframe
+          if (!isSandboxPinned && event.source === expectedWidgetWindow && event.data?.type === 'init') {
+            pinnedSandboxOrigin = senderOrigin;
+            isSandboxPinned = true;
+          }
+
+          // Subsequent messages from the SAME sandboxed iframe match pinnedSandboxOrigin;
+          // messages from any other sandboxed iframe (also event.origin === "null") return false.
+          return senderOrigin.isSameOrigin(pinnedSandboxOrigin);
+        }
+
+        // Fallback for browsers without the Origin API
+        if (event.origin !== 'null' || event.source !== expectedWidgetWindow) {
+          return false;
+        }
+        if (!isSandboxPinned && event.data?.type === 'init') {
+          isSandboxPinned = true;
+        }
+        return isSandboxPinned;
+      } catch {
+        return false;
+      }
+    }
+
+    // Classify all anchor links on the page using Origin.from(anchorElement) + isSameSite()
+    export function classifyPageLinks(root = document) {
+      const links = root.querySelectorAll('a[href]');
+      for (const link of links) {
+        if (isAllowedSameSiteUrl(link)) {
+          link.dataset.external = 'false';
+        } else {
+          link.dataset.external = 'true';
+          link.setAttribute('rel', 'noopener noreferrer');
+          link.setAttribute('target', '_blank');
+        }
+      }
+    }
+
+    // Validate post-login / post-logout redirect URL (?returnTo=...) using isSameSite()
+    export function resolveSafeRedirectUrl(rawRedirectParam, fallbackPath = '/') {
+      if (!rawRedirectParam) return fallbackPath;
+      try {
+        const resolvedUrl = new URL(rawRedirectParam, globalThis.location?.href);
+        if (isAllowedSameSiteUrl(resolvedUrl.href)) {
+          return resolvedUrl.href;
+        }
+      } catch {
+        // Invalid URL falls through to fallbackPath
+      }
+      return fallbackPath;
+    }
+
+    const rewardsIframe = document.getElementById('rewards-widget');
+    const orderStatusText = document.getElementById('order-status-text');
+    const redirectStatusText = document.getElementById('redirect-status-text');
+    const widgetStatusText = document.getElementById('widget-status-text');
+
+    classifyPageLinks();
+
+    // Check any ?returnTo= query parameter on the current URL or logout link
+    const pageParams = new URLSearchParams(globalThis.location?.search);
+    const requestedReturnTo = pageParams.get('returnTo');
+    if (requestedReturnTo !== null) {
+      if (isAllowedSameSiteUrl(requestedReturnTo)) {
+        redirectStatusText.textContent = `Verified same-site redirect: ${requestedReturnTo}`;
+      } else {
+        redirectStatusText.textContent = 'Blocked untrusted or cross-site redirect URL.';
+      }
+    }
+
+    const logoutLink = document.getElementById('logout-link');
+    if (logoutLink) {
+      logoutLink.addEventListener('click', (event) => {
+        const linkUrl = new URL(logoutLink.href, globalThis.location?.href);
+        const returnTo = linkUrl.searchParams.get('returnTo');
+        if (returnTo) {
+          const candidateUrl = new URL(returnTo, globalThis.location?.href);
+          if (!isAllowedSameSiteUrl(candidateUrl.href)) {
+            event.preventDefault();
+            redirectStatusText.textContent = 'Blocked untrusted logout redirect target.';
+          }
+        }
+      });
+    }
+
+    // Listen for cross-window messages from either the trusted ordering origin or the pinned sandboxed widget
+    window.addEventListener('message', (event) => {
+      const expectedWidgetWindow = rewardsIframe?.contentWindow ?? null;
+
+      if (handleSandboxedWidgetMessage(event, expectedWidgetWindow)) {
+        if (event.data?.type === 'init') {
+          widgetStatusText.textContent = 'Sandboxed rewards widget initialized and origin pinned.';
+        } else if (event.data?.type === 'points-update') {
+          const points = Number(event.data.points) || 0;
+          widgetStatusText.textContent = `Rewards update accepted from pinned widget: +${points} Bean Points!`;
+        }
+        return;
+      }
+
+      if (!isTrustedSameOrigin(event)) {
+        return;
+      }
+
+      // Safe to process privileged ordering commands from the verified origin
+      if (event.data?.type === 'order-update' && typeof event.data.summary === 'string') {
+        orderStatusText.textContent = `Order update: ${event.data.summary}`;
+      }
+    });
+
+    // Expose helpers on globalThis for programmatic inspection
+    Object.assign(globalThis, {
+      extractOrigin,
+      isTrustedSameOrigin,
+      isAllowedSameSiteUrl,
+      handleSandboxedWidgetMessage,
+      classifyPageLinks,
+      resolveSafeRedirectUrl,
+    });
+  </script>
