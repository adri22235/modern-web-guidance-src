+  <script type="module">
+    const ALLOWED_ELEMENTS = [
+      'p', 'b', 'i', 'strong', 'em', 'u', 'br', 'ul', 'ol', 'li', 'blockquote', 'code', 'span'
+    ];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then(
+        (mod) => mod.default ?? mod
+      );
+      return domPurifyPromise;
+    }
+
+    export async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function safePreviewHTML(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.replaceChildren();
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const initialReviews = [
+      {
+        name: 'Elena Rostova',
+        drink: 'Maple Oat Latte',
+        rating: 5,
+        html: '<p>The <strong>Maple Oat Latte</strong> has the perfect balance of <em>velvety</em> steamed oat milk and real Vermont maple sweetness!</p><blockquote>Best autumn drink in town.</blockquote>'
+      },
+      {
+        name: 'Marcus Vance',
+        drink: 'Dark Roast Espresso',
+        rating: 5,
+        html: '<p>Rich crema and <b>bold</b> smokey notes without any bitterness. My go-to morning fuel.</p>'
+      },
+      {
+        name: 'Priya Patel',
+        drink: 'Cold Brew',
+        rating: 4,
+        html: '<p>Incredibly smooth 18-hour steep!<ul><li>Zero acidity</li><li>Chocolatey finish</li></ul></p>'
+      }
+    ];
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const nameInput = document.getElementById('reviewer-name');
+    const nameError = document.getElementById('name-error');
+    const feedbackInput = document.getElementById('review-feedback');
+    const feedbackError = document.getElementById('feedback-error');
+    const previewBox = document.getElementById('review-preview');
+    const statusBox = document.getElementById('review-status');
+    const submitBtn = document.getElementById('review-submit-btn');
+
+    async function renderReviewCard(review, prepend = false) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+      const stars = '★'.repeat(Number(review.rating)) + '☆'.repeat(5 - Number(review.rating));
+      meta.textContent = `${review.name} · ${stars} (${review.rating}/5)`;
+
+      const badge = document.createElement('span');
+      badge.className = 'review-drink-badge';
+      badge.textContent = review.drink;
+
+      header.append(meta, badge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, review.html);
+
+      article.append(header, body);
+
+      if (prepend && reviewsList.firstChild) {
+        reviewsList.prepend(article);
+      } else {
+        reviewsList.append(article);
+      }
+    }
+
+    function setFieldError(input, errorEl, message) {
+      if (message) {
+        input.setCustomValidity(message);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = message;
+        errorEl.hidden = false;
+      } else {
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+      }
+    }
+
+    function validateName() {
+      if (!nameInput.value.trim()) {
+        setFieldError(nameInput, nameError, 'Please enter your full name.');
+        return false;
+      }
+      setFieldError(nameInput, nameError, '');
+      return true;
+    }
+
+    function validateFeedback() {
+      const val = feedbackInput.value.trim();
+      if (!val) {
+        setFieldError(feedbackInput, feedbackError, 'Please enter your review feedback.');
+        return false;
+      }
+      if (val.length < 3) {
+        setFieldError(feedbackInput, feedbackError, 'Feedback must be at least 3 characters.');
+        return false;
+      }
+      setFieldError(feedbackInput, feedbackError, '');
+      return true;
+    }
+
+    let nameDirty = false;
+    let feedbackDirty = false;
+
+    nameInput.addEventListener('input', () => {
+      nameDirty = true;
+      if (nameInput.getAttribute('aria-invalid') === 'true') {
+        validateName();
+      }
+    });
+
+    nameInput.addEventListener('blur', () => {
+      if (nameDirty) {
+        validateName();
+      }
+    });
+
+    feedbackInput.addEventListener('input', () => {
+      feedbackDirty = true;
+      if (feedbackInput.getAttribute('aria-invalid') === 'true') {
+        validateFeedback();
+      }
+      safePreviewHTML(previewBox, feedbackInput.value);
+    });
+
+    feedbackInput.addEventListener('blur', () => {
+      if (feedbackDirty) {
+        validateFeedback();
+      }
+    });
+
+    reviewForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      statusBox.textContent = '';
+
+      const isNameValid = validateName();
+      const isFeedbackValid = validateFeedback();
+
+      if (!isNameValid) {
+        nameInput.focus();
+        return;
+      }
+      if (!isFeedbackValid) {
+        feedbackInput.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        const formData = new FormData(reviewForm);
+        const newReview = {
+          name: String(formData.get('reviewer_name') || '').trim(),
+          drink: String(formData.get('drink') || 'Maple Oat Latte'),
+          rating: Number(formData.get('rating') || 5),
+          html: String(formData.get('feedback') || '')
+        };
+
+        await renderReviewCard(newReview, true);
+
+        reviewForm.reset();
+        nameDirty = false;
+        feedbackDirty = false;
+        previewBox.replaceChildren();
+        statusBox.textContent = `Thank you, ${newReview.name}! Your sanitized review for ${newReview.drink} has been posted.`;
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    for (const review of initialReviews) {
+      await renderReviewCard(review);
+    }
+  </script>
 </body>
 
