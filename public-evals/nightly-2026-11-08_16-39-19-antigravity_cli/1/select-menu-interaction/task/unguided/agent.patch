+  <script>
+    (function () {
+      const orderForm = document.getElementById('order-form');
+      const shopSelect = document.getElementById('shop-select');
+      const shopFormGroup = document.getElementById('shop-form-group');
+      const shopError = document.getElementById('shop-error');
+      const orderSuccess = document.getElementById('order-success');
+
+      let hasInteracted = false;
+      let submitAttempted = false;
+
+      function updateValidationState() {
+        const isValid = shopSelect.value.trim() !== '' && shopSelect.checkValidity();
+        const shouldShowError = (hasInteracted || submitAttempted) && !isValid;
+
+        if (hasInteracted || submitAttempted) {
+          shopSelect.classList.add('touched');
+        }
+
+        if (shouldShowError) {
+          shopSelect.classList.add('is-invalid');
+          shopSelect.classList.remove('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopFormGroup.classList.add('has-error');
+          shopError.hidden = false;
+          shopError.classList.add('visible');
+        } else {
+          shopSelect.classList.remove('is-invalid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopFormGroup.classList.remove('has-error');
+          shopError.hidden = true;
+          shopError.classList.remove('visible');
+
+          if ((hasInteracted || submitAttempted) && isValid) {
+            shopSelect.classList.add('is-valid');
+          } else {
+            shopSelect.classList.remove('is-valid');
+          }
+        }
+
+        return isValid;
+      }
+
+      shopSelect.addEventListener('change', function () {
+        hasInteracted = true;
+        orderSuccess.hidden = true;
+        orderSuccess.classList.remove('visible');
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      orderForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        submitAttempted = true;
+        orderForm.classList.add('was-validated');
+
+        const isValid = updateValidationState();
+        if (!isValid) {
+          orderSuccess.hidden = true;
+          orderSuccess.classList.remove('visible');
+          shopSelect.focus();
+          return;
+        }
+
+        const selectedShopText = shopSelect.options[shopSelect.selectedIndex].text;
+        const selectedDrinkInput = orderForm.querySelector('input[name="drink"]:checked');
+        const selectedDrink = selectedDrinkInput ? selectedDrinkInput.value : 'Coffee';
+
+        orderSuccess.textContent = 'Order received! Your ' + selectedDrink + ' will be ready for pickup at ' + selectedShopText + '.';
+        orderSuccess.hidden = false;
+        orderSuccess.classList.add('visible');
+      });
+    })();
+  </script>
+
