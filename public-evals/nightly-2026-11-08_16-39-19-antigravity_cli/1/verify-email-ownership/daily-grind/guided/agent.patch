+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { readFile } from 'node:fs/promises';
+import { createServer } from 'node:http';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const ORIGIN_TRIAL_TOKEN =
+  process.env.ORIGIN_TRIAL_TOKEN || 'DAILY_GRIND_EVP_ORIGIN_TRIAL_TOKEN';
+
+// Server-side session store mapping session ID -> single-use cryptographic nonce
+const sessionNonceStore = new Map();
+// Registered rewards accounts store
+const rewardsAccounts = new Map();
+
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+/**
+ * Generates a fresh 256-bit cryptographic nonce and stores it in server-side
+ * session state keyed by an HttpOnly session ID cookie.
+ */
+export function createSessionNonce(existingSessionId) {
+  const sessionId = existingSessionId || randomBytes(24).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessionNonceStore.set(sessionId, nonce);
+  return { sessionId, nonce };
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce from server-side session storage.
+ */
+export function consumeSessionNonce(sessionId) {
+  if (!sessionId || !sessionNonceStore.has(sessionId)) {
+    return null;
+  }
+  const expectedNonce = sessionNonceStore.get(sessionId);
+  sessionNonceStore.delete(sessionId);
+  return expectedNonce;
+}
+
+/**
+ * Verifies an Email Verification Protocol (EVP) SD-JWT presentation (`EVT + KB-JWT`)
+ * strictly on the server.
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience = RP_ORIGIN,
+}) {
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation before making any network request to `iss`
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email domain.');
+  }
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    r.join('')
+  );
+  if (
+    !txtRecords.some(
+      (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+    )
+  ) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+  const metadata = await (await fetch(discoveryUrl)).json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws ERR_JWKS_MULTIPLE_MATCHING_KEYS, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+function completeAccountCreation(submittedEmail, fullName) {
+  const account = {
+    id: randomBytes(12).toString('hex'),
+    name: fullName,
+    email: submittedEmail,
+    emailVerified: true,
+    verificationMethod: 'evp',
+    points: 100,
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(submittedEmail.toLowerCase(), account);
+  return {
+    ok: true,
+    verified: true,
+    method: 'evp',
+    message: `Welcome to Daily Grind Rewards, ${fullName}! Your email (${submittedEmail}) was verified instantly by your browser—100 bonus points have been added to your account.`,
+    account,
+  };
+}
+
+function sendTraditionalVerificationEmail(submittedEmail, fullName) {
+  const account = {
+    id: randomBytes(12).toString('hex'),
+    name: fullName,
+    email: submittedEmail,
+    emailVerified: false,
+    verificationMethod: 'fallback-email',
+    points: 0,
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(submittedEmail.toLowerCase(), account);
+  return {
+    ok: true,
+    verified: false,
+    method: 'fallback-email',
+    message: `Thanks for joining, ${fullName}! We've sent a confirmation link to ${submittedEmail} to finish activating your 100 bonus points.`,
+    account,
+  };
+}
+
+/**
+ * Handles Rewards sign-up form submissions (supports Web Fetch API Request or parsed fields).
+ */
+export async function handleSignupSubmission({
+  fullName,
+  submittedEmail,
+  rawToken,
+  sessionId,
+  expectedAudience = RP_ORIGIN,
+}) {
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = consumeSessionNonce(sessionId);
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return completeAccountCreation(submittedEmail, fullName);
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return sendTraditionalVerificationEmail(submittedEmail, fullName);
+}
+
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const pair of cookieHeader.split(';')) {
+    const idx = pair.indexOf('=');
+    if (idx > -1) {
+      const key = pair.slice(0, idx).trim();
+      const val = pair.slice(idx + 1).trim();
+      cookies[key] = decodeURIComponent(val);
+    }
+  }
+  return cookies;
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function parseFormPayload(body, contentType = '') {
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(body);
+    } catch {
+      return {};
+    }
+  }
+  const params = new URLSearchParams(body);
+  return Object.fromEntries(params.entries());
+}
+
+export const server = createServer(async (req, res) => {
+  const url = new URL(req.url || '/', `http://${req.headers.host || `localhost:${PORT}`}`);
+  const cookies = parseCookies(req.headers.cookie);
+
+  if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+    const { sessionId, nonce } = createSessionNonce(cookies.dg_session);
+    const rawHtml = await readFile(join(__dirname, 'index.html'), 'utf8');
+    const renderedHtml = rawHtml.replaceAll(
+      'SERVER_GENERATED_PER_FORM_NONCE',
+      nonce
+    );
+
+    res.writeHead(200, {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Cache-Control': 'no-store',
+      'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+      'Set-Cookie': `dg_session=${encodeURIComponent(sessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+    });
+    res.end(renderedHtml);
+    return;
+  }
+
+  if (req.method === 'POST' && url.pathname === '/api/verify-email') {
+    const bodyText = await readRequestBody(req);
+    const fields = parseFormPayload(bodyText, req.headers['content-type']);
+    const fullName = String(fields.full_name || fields.name || 'Coffee Lover').trim();
+    const submittedEmail = String(fields.email || '').trim();
+    const rawToken = String(fields.token || '').trim();
+    const password = String(fields['new-password'] || fields.password || '');
+
+    if (!submittedEmail || ! submittedEmail.includes('@') || password.length < 8) {
+      const { sessionId, nonce } = createSessionNonce(cookies.dg_session);
+      res.writeHead(400, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Set-Cookie': `dg_session=${encodeURIComponent(sessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+      });
+      res.end(
+        JSON.stringify({
+          ok: false,
+          error: 'Please provide a valid full name, email address, and password (at least 8 characters).',
+          nextNonce: nonce,
+        })
+      );
+      return;
+    }
+
+    const requestOrigin = req.headers.origin || `${url.protocol}//${url.host}`;
+    const result = await handleSignupSubmission({
+      fullName,
+      submittedEmail,
+      rawToken,
+      sessionId: cookies.dg_session,
+      expectedAudience: requestOrigin,
+    });
+
+    // Issue a fresh single-use nonce for any subsequent form render/submission
+    const { sessionId: nextSessionId, nonce: nextNonce } = createSessionNonce(
+      cookies.dg_session
+    );
+
+    const acceptsJson = (req.headers.accept || '').includes('application/json');
+    if (acceptsJson) {
+      res.writeHead(200, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Set-Cookie': `dg_session=${encodeURIComponent(nextSessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+      });
+      res.end(JSON.stringify({ ...result, nextNonce }));
+    } else {
+      res.writeHead(303, {
+        Location: '/?signup=' + (result.verified ? 'verified' : 'pending'),
+        'Cache-Control': 'no-store',
+        'Set-Cookie': `dg_session=${encodeURIComponent(nextSessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+      });
+      res.end();
+    }
+    return;
+  }
+
+  res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+  res.end(JSON.stringify({ error: 'Not found' }));
+});
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
