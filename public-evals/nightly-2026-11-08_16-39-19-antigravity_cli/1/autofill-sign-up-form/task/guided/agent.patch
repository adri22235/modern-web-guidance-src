+  <script>
+    (function () {
+      const form = document.getElementById('signup-form');
+      const passwordInput = document.getElementById('new-password');
+      const togglePasswordBtn = document.getElementById('toggle-password');
+      const submitBtn = document.getElementById('sign-up-btn');
+      const statusEl = document.getElementById('signup-status');
+
+      togglePasswordBtn.addEventListener('click', () => {
+        const isShowing = passwordInput.type === 'text';
+        passwordInput.type = isShowing ? 'password' : 'text';
+        togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+        togglePasswordBtn.setAttribute('aria-label', isShowing ? 'Show password' : 'Hide password');
+        togglePasswordBtn.textContent = isShowing ? 'Show' : 'Hide';
+      });
+
+      const fields = [
+        {
+          input: document.getElementById('full-name'),
+          error: document.getElementById('name-error'),
+          getMessage(el) {
+            if (el.validity.valueMissing || !el.value.trim()) {
+              return 'Please enter your full name.';
+            }
+            return '';
+          }
+        },
+        {
+          input: document.getElementById('email'),
+          error: document.getElementById('email-error'),
+          getMessage(el) {
+            if (el.validity.valueMissing) {
+              return 'Please enter your email address.';
+            }
+            if (el.validity.typeMismatch) {
+              return 'Please enter a valid email address (for example, name@example.com).';
+            }
+            return '';
+          }
+        },
+        {
+          input: passwordInput,
+          error: document.getElementById('password-error'),
+          getMessage(el) {
+            if (el.validity.valueMissing) {
+              return 'Please create a password.';
+            }
+            if (el.validity.tooShort) {
+              return 'Password must be at least 8 characters long.';
+            }
+            return '';
+          }
+        }
+      ];
+
+      function validateField(field) {
+        const { input, error, getMessage } = field;
+        input.setCustomValidity('');
+        const msg = getMessage(input);
+        if (msg) {
+          input.setCustomValidity(msg);
+          input.setAttribute('aria-invalid', 'true');
+          error.textContent = '⚠ ' + msg;
+          error.hidden = false;
+          return false;
+        }
+        input.removeAttribute('aria-invalid');
+        error.textContent = '';
+        error.hidden = true;
+        return true;
+      }
+
+      fields.forEach((field) => {
+        let dirty = false;
+        field.input.addEventListener('input', () => {
+          dirty = true;
+          if (field.input.getAttribute('aria-invalid') === 'true') {
+            validateField(field);
+          }
+        });
+        field.input.addEventListener('blur', () => {
+          if (dirty) {
+            validateField(field);
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        statusEl.hidden = true;
+        statusEl.textContent = '';
+        statusEl.className = 'form-status';
+
+        let firstInvalid = null;
+        fields.forEach((field) => {
+          const valid = validateField(field);
+          if (!valid && !firstInvalid) {
+            firstInvalid = field.input;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Account created';
+        statusEl.textContent = 'Welcome to The Daily Grind! Your account has been created.';
+        statusEl.classList.add('success');
+        statusEl.hidden = false;
+      });
+    })();
+  </script>
 </body>
 
