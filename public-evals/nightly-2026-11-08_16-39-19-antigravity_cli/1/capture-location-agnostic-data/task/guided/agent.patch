+  <script>
+    const STORAGE_KEYS = {
+      pickupTime: 'dailyGrind.pickupReminderPlainTime',
+      anniversaryDate: 'dailyGrind.coffeeAnniversaryPlainDate',
+    };
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-schedule-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const statusEl = document.getElementById('form-status');
+
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const displayRecurringAnniversary = document.getElementById('display-recurring-anniversary');
+      const displayNextOccurrence = document.getElementById('display-next-occurrence');
+      const displayBadge = document.getElementById('display-anniversary-badge');
+
+      const savedTimeStr = localStorage.getItem(STORAGE_KEYS.pickupTime) || timeInput.value || '08:30';
+      const savedDateStr = localStorage.getItem(STORAGE_KEYS.anniversaryDate) || dateInput.value || '2023-11-08';
+
+      timeInput.value = savedTimeStr.slice(0, 5);
+      dateInput.value = savedDateStr;
+
+      function renderSchedule(rawTime, rawDate) {
+        // 1. Parse wall-clock time and calendar date using Temporal Plain types (no time zone offset)
+        const reminderTime = Temporal.PlainTime.from(rawTime);
+        const anniversaryDate = Temporal.PlainDate.from(rawDate);
+
+        // Read calendar fields directly from the Plain type without formatToParts()
+        const { year, month, day } = anniversaryDate;
+
+        // 2. Model the annual recurring anniversary using Temporal.PlainMonthDay with explicit calendar
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        // 3. Compare with today's local calendar date and convert PlainMonthDay to PlainDate with a specific year before arithmetic
+        const today = Temporal.Now.plainDateISO();
+        const isToday = annualAnniversary.equals(today.toPlainMonthDay());
+
+        let occurrenceThisYear = annualAnniversary.toPlainDate({ year: today.year });
+        if (Temporal.PlainDate.compare(occurrenceThisYear, today) < 0) {
+          occurrenceThisYear = occurrenceThisYear.add({ years: 1 }, { overflow: 'constrain' });
+        }
+
+        // 4. Combine calendar date and wall-clock time into a location-agnostic PlainDateTime
+        const nextCelebrationPickup = occurrenceThisYear.toPlainDateTime(reminderTime);
+
+        // 5. Display without time zone conversion so values remain identical in any time zone
+        displayPickupTime.textContent = `${reminderTime.toLocaleString([], { hour: '2-digit', minute: '2-digit' })} (${reminderTime.toString()})`;
+        displayAnniversaryDate.textContent = `${anniversaryDate.toLocaleString()} (${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')})`;
+        displayRecurringAnniversary.textContent = annualAnniversary.toString();
+        displayNextOccurrence.textContent = nextCelebrationPickup.toString();
+
+        if (isToday) {
+          displayBadge.textContent = 'Happy Coffee Anniversary Today!';
+        } else {
+          displayBadge.textContent = `Next celebration on ${occurrenceThisYear.toString()} at ${reminderTime.toString().slice(0, 5)} (wherever you are)`;
+        }
+      }
+
+      // Clear validation error state on input
+      [timeInput, dateInput].forEach((input) => {
+        input.addEventListener('input', () => {
+          input.setCustomValidity('');
+          input.removeAttribute('aria-invalid');
+          statusEl.textContent = '';
+        });
+
+        input.addEventListener('blur', () => {
+          if (!input.checkValidity()) {
+            input.setAttribute('aria-invalid', 'true');
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.checkValidity()) {
+          const firstInvalid = form.querySelector(':invalid');
+          if (firstInvalid) {
+            firstInvalid.setAttribute('aria-invalid', 'true');
+            firstInvalid.focus();
+          }
+          return;
+        }
+
+        const plainTime = Temporal.PlainTime.from(timeInput.value);
+        const plainDate = Temporal.PlainDate.from(dateInput.value);
+
+        localStorage.setItem(STORAGE_KEYS.pickupTime, plainTime.toString());
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, plainDate.toString());
+
+        renderSchedule(plainTime.toString(), plainDate.toString());
+        statusEl.textContent = `Saved! Reminder set for ${plainTime.toString().slice(0, 5)} daily and anniversary locked to ${plainDate.toString()}.`;
+      });
+
+      renderSchedule(timeInput.value, dateInput.value);
+    }
+
+    // Check if Temporal is supported natively; dynamically load temporal-polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
