+  <script>
+    (function () {
+      const TIME_STORAGE_KEY = 'dailyGrind_pickupReminderTime';
+      const DATE_STORAGE_KEY = 'dailyGrind_coffeeAnniversaryDate';
+
+      const MONTHS = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeDisplay = document.getElementById('pickup-reminder-display');
+      const dateDisplay = document.getElementById('coffee-anniversary-display');
+      const timeText = document.getElementById('pickup-time-text');
+      const dateText = document.getElementById('anniversary-date-text');
+      const form = document.getElementById('coffee-preferences-form');
+
+      // Format plain HH:MM string without using Date objects or time zones
+      function formatPlainTime(plainTime) {
+        if (!plainTime || typeof plainTime !== 'string') return '';
+        const parts = plainTime.split(':');
+        if (parts.length < 2) return plainTime;
+        const hours24 = parseInt(parts[0], 10);
+        const minutes = parts[1];
+        if (Number.isNaN(hours24)) return plainTime;
+        const period = hours24 >= 12 ? 'PM' : 'AM';
+        const hours12 = hours24 % 12 === 0 ? 12 : hours24 % 12;
+        const normalized24 = String(hours24).padStart(2, '0') + ':' + minutes;
+        return normalized24 + ' (' + hours12 + ':' + minutes + ' ' + period + ')';
+      }
+
+      // Format plain YYYY-MM-DD string without using Date objects or time zones
+      function formatPlainDate(plainDate) {
+        if (!plainDate || typeof plainDate !== 'string') return '';
+        const parts = plainDate.split('-');
+        if (parts.length !== 3) return plainDate;
+        const year = parts[0];
+        const monthIndex = parseInt(parts[1], 10) - 1;
+        const day = parseInt(parts[2], 10);
+        if (monthIndex < 0 || monthIndex > 11 || Number.isNaN(day)) return plainDate;
+        return MONTHS[monthIndex] + ' ' + day + ', ' + year + ' (' + plainDate + ')';
+      }
+
+      function updateTimePreference(rawValue, persist) {
+        const plainTime = (rawValue || '').trim();
+        if (!plainTime) return;
+        timeInput.value = plainTime;
+        timeDisplay.setAttribute('data-value', plainTime);
+        timeText.textContent = formatPlainTime(plainTime);
+        if (persist) {
+          try {
+            localStorage.setItem(TIME_STORAGE_KEY, plainTime);
+          } catch (e) {
+            // Ignore storage errors in restricted environments
+          }
+        }
+      }
+
+      function updateDatePreference(rawValue, persist) {
+        const plainDate = (rawValue || '').trim();
+        if (!plainDate) return;
+        dateInput.value = plainDate;
+        dateDisplay.setAttribute('data-value', plainDate);
+        dateText.textContent = formatPlainDate(plainDate);
+        if (persist) {
+          try {
+            localStorage.setItem(DATE_STORAGE_KEY, plainDate);
+          } catch (e) {
+            // Ignore storage errors in restricted environments
+          }
+        }
+      }
+
+      // Load saved plain values from localStorage if available
+      try {
+        const savedTime = localStorage.getItem(TIME_STORAGE_KEY);
+        if (savedTime && /^\d{2}:\d{2}(:\d{2})?$/.test(savedTime)) {
+          updateTimePreference(savedTime, false);
+        } else {
+          updateTimePreference(timeInput.value, false);
+        }
+
+        const savedDate = localStorage.getItem(DATE_STORAGE_KEY);
+        if (savedDate && /^\d{4}-\d{2}-\d{2}$/.test(savedDate)) {
+          updateDatePreference(savedDate, false);
+        } else {
+          updateDatePreference(dateInput.value, false);
+        }
+      } catch (e) {
+        updateTimePreference(timeInput.value, false);
+        updateDatePreference(dateInput.value, false);
+      }
+
+      timeInput.addEventListener('input', function (event) {
+        updateTimePreference(event.target.value, true);
+      });
+      timeInput.addEventListener('change', function (event) {
+        updateTimePreference(event.target.value, true);
+      });
+
+      dateInput.addEventListener('input', function (event) {
+        updateDatePreference(event.target.value, true);
+      });
+      dateInput.addEventListener('change', function (event) {
+        updateDatePreference(event.target.value, true);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        updateTimePreference(timeInput.value, true);
+        updateDatePreference(dateInput.value, true);
+      });
+    })();
+  </script>
+
 </body>
 
