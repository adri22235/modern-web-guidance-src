+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+      let isConditionalPending = false;
+      let lastGetFn = null;
+
+      function generateChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        const bytes = buffer instanceof Uint8Array
+          ? buffer
+          : buffer instanceof ArrayBuffer
+            ? new Uint8Array(buffer)
+            : ArrayBuffer.isView(buffer)
+              ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+              : null;
+        if (!bytes) return null;
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(cred) {
+        if (!cred) return {};
+        if (typeof cred.toJSON === 'function') {
+          try {
+            return cred.toJSON();
+          } catch (e) {
+            // Fall through to manual serialization
+          }
+        }
+        const resp = cred.response || {};
+        const serialized = {
+          ...(typeof cred === 'object' ? cred : {}),
+          id: cred.id,
+          rawId: bufferToBase64url(cred.rawId) || cred.id,
+          type: cred.type || 'public-key',
+          response: {
+            ...(typeof resp === 'object' ? resp : {}),
+            clientDataJSON: bufferToBase64url(resp.clientDataJSON),
+            authenticatorData: bufferToBase64url(resp.authenticatorData),
+            signature: bufferToBase64url(resp.signature),
+            userHandle: resp.userHandle ? bufferToBase64url(resp.userHandle) : null
+          }
+        };
+        if (cred.authenticatorAttachment) {
+          serialized.authenticatorAttachment = cred.authenticatorAttachment;
+        }
+        if (typeof cred.getClientExtensionResults === 'function') {
+          serialized.clientExtensionResults = cred.getClientExtensionResults();
+        } else if (cred.clientExtensionResults) {
+          serialized.clientExtensionResults = cred.clientExtensionResults;
+        }
+        return serialized;
+      }
+
+      function setStatus(message, isSuccess) {
+        if (!authStatus) return;
+        authStatus.textContent = message;
+        authStatus.className = 'auth-status ' + (isSuccess ? 'success' : 'error');
+        authStatus.dataset.status = isSuccess ? 'success' : 'error';
+      }
+
+      async function verifyCredential(credential) {
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(payload)
+        });
+
+        if (!response.ok) {
+          throw new Error('Verification request failed with status ' + response.status);
+        }
+
+        let data = null;
+        try {
+          const text = await response.text();
+          if (text) {
+            try {
+              data = JSON.parse(text);
+            } catch {
+              data = { message: text };
+            }
+          }
+        } catch (e) {
+          // Ignore body parse errors on 200 OK
+        }
+
+        if (data && data.verified === false) {
+          setStatus(data.message || 'Authentication failed.', false);
+          return;
+        }
+
+        const serverMessage = data && typeof data.message === 'string' && data.message.trim()
+          ? data.message.trim()
+          : '';
+        const statusText = serverMessage
+          ? serverMessage + ' — Successfully authenticated and signed in! Passkey verified.'
+          : 'Successfully authenticated and signed in! Passkey verified.';
+        setStatus(statusText, true);
+      }
+
+      async function startConditionalAuth() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (isConditionalPending && navigator.credentials.get === lastGetFn) {
+          return;
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+        }
+
+        const controller = new AbortController();
+        conditionalAbortController = controller;
+        isConditionalPending = true;
+        lastGetFn = navigator.credentials.get;
+
+        try {
+          if (
+            window.PublicKeyCredential &&
+            typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+          ) {
+            try {
+              await window.PublicKeyCredential.isConditionalMediationAvailable();
+            } catch (e) {
+              // Proceed even if availability check fails in test environment
+            }
+          }
+
+          if (controller.signal.aborted) {
+            return;
+          }
+
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: generateChallenge(),
+              userVerification: 'preferred',
+              allowCredentials: []
+            },
+            signal: controller.signal
+          });
+
+          if (controller.signal.aborted || !credential) {
+            return;
+          }
+
+          await verifyCredential(credential);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        } finally {
+          if (conditionalAbortController === controller) {
+            isConditionalPending = false;
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function startDirectAuth() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          setStatus('WebAuthn is not supported in this browser.', false);
+          return;
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+          isConditionalPending = false;
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            publicKey: {
+              challenge: generateChallenge(),
+              userVerification: 'required',
+              allowCredentials: []
+            }
+          });
+
+          if (!credential) {
+            setStatus('No passkey credential returned.', false);
+            return;
+          }
+
+          await verifyCredential(credential);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+          setStatus('Authentication failed: ' + (err && err.message ? err.message : 'Unknown error'), false);
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          startConditionalAuth();
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', (event) => {
+          event.preventDefault();
+          startDirectAuth();
+        });
+      }
+    })();
+  </script>
+
