+
+    .roast-picker-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.35rem;
+      margin-top: 1.25rem;
+      width: 100%;
+      max-width: 340px;
+      text-align: left;
+    }
+
+    .roast-picker-label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      color: var(--light);
+      letter-spacing: 0.02em;
+    }
+
+    select.roast-select,
+    select.roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 0.65rem 0.9rem;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      background-color: rgba(62, 39, 35, 0.92);
+      color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    select.roast-select:hover {
+      border-color: var(--accent);
+      background-color: var(--text);
+    }
+
+    select.roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: #2b1b17;
+      color: var(--light);
+      border: 1px solid var(--primary);
+      border-radius: 8px;
+      padding: 0.5rem;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
+      width: anchor-size(width);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.65rem 0.75rem;
+      border-radius: 6px;
+      color: var(--light);
+      cursor: pointer;
+    }
+
+    select.roast-select option + option {
+      margin-top: 0.25rem;
+    }
+
+    select.roast-select option:hover {
+      background-color: var(--primary);
+    }
+
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: var(--text);
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      width: 24px;
+      height: 24px;
+      color: var(--accent);
+    }
+
+    select.roast-select option:checked .option-icon {
+      color: var(--text);
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 600;
+      font-size: 0.95rem;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
+    }
