+              count: results.length,
+              sizePricingAdjustments: SIZE_PRICE_DELTAS,
+              availableMilks: ALLOWED_MILKS,
+              drinks: results
+            };
+          },
+          annotations: { readOnlyHint: true }
+        }, { signal: registrationSignal });
+
+        function applyMenuFilterForQuery({ query = '', dietary = 'all', temperature = 'all', maxPrice }) {
+          const q = String(query || '').trim().toLowerCase();
+          return SEASONAL_MENU.filter((drink) => {
+            const matchesQuery =
+              !q ||
+              drink.name.toLowerCase().includes(q) ||
+              drink.description.toLowerCase().includes(q) ||
+              drink.detailedNotes.toLowerCase().includes(q);
+            const matchesDietary = dietary === 'all' || drink.dietaryTags.includes(dietary);
+            const matchesTemp =
+              temperature === 'all' ||
+              drink.availableTemperatures.some((t) => t.toLowerCase() === temperature);
+            const matchesPrice =
+              typeof maxPrice !== 'number' || Number.isNaN(maxPrice) || drink.basePrice <= maxPrice;
+            return matchesQuery && matchesDietary && matchesTemp && matchesPrice;
+          });
+        }
+
+        // 2. Get detailed info for a specific Seasonal Favorite drink and optionally highlight it on the page
+        await document.modelContext.registerTool({
+          name: 'inspect_seasonal_drink',
+          description: 'Retrieves full nutritional details, tasting notes, and customization pricing for a single Seasonal Favorites coffee drink, and highlights its card on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'Drink ID or name from the Seasonal Favorites menu.'
+              },
+              expandDetailsOnPage: {
+                type: 'boolean',
+                default: true,
+                description: 'Whether to expand the tasting notes and highlight the drink card in the page UI.'
+              }
+            },
+            required: ['drink']
+          },
+          execute(input = {}) {
+            const { drink: drinkQuery, expandDetailsOnPage = true } = input || {};
+            const drink = findDrink(drinkQuery);
+            if (!drink) {
+              return {
+                error: `Seasonal drink "${drinkQuery}" was not found.`,
+                availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+              };
+            }
+
+            if (expandDetailsOnPage) {
+              updateDrinkCardUI({
+                drinkId: drink.id,
+                highlight: true,
+                showDetails: true,
+                scrollIntoView: true
+              });
+              showNotification(`Viewing details for ${drink.name}.`);
+            }
+
+            return {
+              drink,
+              pricesBySize: {
+                Small: calculateUnitPrice(drink, 'Small'),
+                Medium: calculateUnitPrice(drink, 'Medium'),
+                Large: calculateUnitPrice(drink, 'Large')
+              },
+              availableMilks: ALLOWED_MILKS
+            };
+          },
+          annotations: { readOnlyHint: false }
+        }, { signal: registrationSignal });
+
+        // 3. Order / Add a Seasonal Favorite drink to the interactive order tray
+        await document.modelContext.registerTool({
+          name: 'order_seasonal_drink',
+          description: 'Adds a customized Seasonal Favorites drink to the interactive order tray on the page and updates the live order summary UI.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'Name or ID of the Seasonal Favorites drink to order.'
+              },
+              size: {
+                type: 'string',
+                enum: ALLOWED_SIZES,
+                default: 'Medium',
+                description: 'Cup size for the drink.'
+              },
+              milk: {
+                type: 'string',
+                enum: ALLOWED_MILKS,
+                description: 'Milk or non-dairy alternative to prepare the drink with.'
+              },
+              temperature: {
+                type: 'string',
+                enum: ALLOWED_TEMPS,
+                description: 'Serving temperature for the drink.'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                maximum: 10,
+                default: 1,
+                description: 'Number of cups of this drink configuration to add.'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Customer name to write on the cup.'
+              },
+              notes: {
+                type: 'string',
+                description: 'Special preparation notes for the barista.'
+              }
+            },
+            required: ['drink']
+          },
+          execute(input = {}) {
+            const {
+              drink,
+              size = 'Medium',
+              milk,
+              temperature,
+              quantity = 1,
+              customerName = '',
+              notes = ''
+            } = input || {};
+
+            return addOrderItem({
+              drink,
+              size,
+              milk,
+              temperature,
+              quantity,
+              customerName,
+              notes
+            });
+          },
+          annotations: {
+            readOnlyHint: false,
+            consequentialHint: false
+          }
+        }, { signal: registrationSignal });
+
+        // 4. Get current order tray status (read-only)
+        await document.modelContext.registerTool({
+          name: 'get_current_order',
+          description: 'Returns the items currently in the user order tray, total cup count, total price, and the most recent confirmed order receipt.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          execute() {
+            return getOrderSummaryPayload();
+          },
+          annotations: { readOnlyHint: true }
+        }, { signal: registrationSignal });
+
+        // 5. Update the homepage UI state (highlight a drink card, prefill the order builder, or clear/reset menu filters)
+        await document.modelContext.registerTool({
+          name: 'update_menu_page_ui',
+          description: 'Updates the Daily Grind homepage UI by highlighting a specific Seasonal Favorites card, toggling its nutritional details, pre-filling the interactive drink order builder, or resetting active menu filters.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'Drink name or ID to highlight or pre-select on the page.'
+              },
+              showDetails: {
+                type: 'boolean',
+                default: true,
+                description: 'Whether to expand the nutritional and tasting details panel on the drink card.'
+              },
+              prefillOrderBuilder: {
+                type: 'boolean',
+                default: true,
+                description: 'Whether to pre-populate the interactive order form with this drink.'
+              },
+              resetMenuFilters: {
+                type: 'boolean',
+                default: false,
+                description: 'Whether to reset any active search or dietary filters so all seasonal drinks are visible.'
+              },
+              bannerMessage: {
+                type: 'string',
+                description: 'Optional status message to display in the page notification banner.'
+              }
+            }
+          },
+          execute(input = {}) {
+            const {
+              drink: drinkQuery,
+              showDetails = true,
+              prefillOrderBuilder = true,
+              resetMenuFilters = false,
+              bannerMessage
+            } = input || {};
+
+            if (resetMenuFilters) {
+              applyMenuFilter({ query: '', dietary: 'all', temperature: 'all' });
+            }
+
+            let selectedDrink = null;
+            if (drinkQuery) {
+              selectedDrink = findDrink(drinkQuery);
+              if (!selectedDrink) {
+                return {
+                  error: `Cannot highlight unknown drink "${drinkQuery}".`,
+                  availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+                };
+              }
+
+              updateDrinkCardUI({
+                drinkId: selectedDrink.id,
+                highlight: true,
+                showDetails: Boolean(showDetails),
+                scrollIntoView: true
+              });
+
+              if (prefillOrderBuilder) {
+                populateOrderFormUI({
+                  drinkId: selectedDrink.id,
+                  size: 'Medium',
+                  milk: selectedDrink.defaultMilk,
+                  temperature: selectedDrink.defaultTemperature,
+                  quantity: 1
+                });
+              }
+            }
+
+            if (bannerMessage && typeof bannerMessage === 'string') {
+              showNotification(bannerMessage.trim());
+            } else if (selectedDrink) {
+              showNotification(`Updated page view for ${selectedDrink.name}.`);
+            }
+
+            return {
+              status: 'ui_updated',
+              highlightedDrink: selectedDrink ? selectedDrink.name : null,
+              filtersReset: Boolean(resetMenuFilters),
+              bannerMessage: notificationBanner.textContent
+            };
+          },
+          annotations: { readOnlyHint: false }
+        }, { signal: registrationSignal });
+
+        // 6. Submit / Confirm final pickup order (Consequential action)
+        await document.modelContext.registerTool({
+          name: 'submit_pickup_order',
+          description: 'Places and finalizes the current drink order tray for in-store pickup and displays the confirmation receipt on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              customerName: {
+                type: 'string',
+                description: 'Name of the customer picking up the order.'
+              },
+              pickupTime: {
+                type: 'string',
+                default: 'ASAP',
+                description: 'Requested pickup time window (e.g., ASAP, in 15 minutes).'
+              }
+            }
+          },
+          execute(input = {}) {
+            const { customerName = '', pickupTime = 'ASAP' } = input || {};
+            return submitPickupOrder({ customerName, pickupTime });
+          },
+          annotations: {
+            readOnlyHint: false,
+            consequentialHint: true,
+            untrustedContentHint: false
+          }
+        }, { signal: registrationSignal });
+
+        // 7. Clear the active order tray
+        await document.modelContext.registerTool({
+          name: 'clear_drink_order',
+          description: 'Removes all drinks currently in the active order tray and resets the order total to zero.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          execute() {
+            const clearedCount = state.orderItems.length;
+            state.orderItems = [];
+            renderOrderTray();
+            showNotification('Cleared all drinks from the order tray.');
+            return {
+              status: 'cleared',
+              clearedLineItems: clearedCount,
+              orderSummary: getOrderSummaryPayload()
+            };
+          },
+          annotations: { readOnlyHint: false }
+        }, { signal: registrationSignal });
+      }
+
+      registerDailyGrindWebMCPTools();
+    })();
+  </script>
 </body>
 
 </html>
