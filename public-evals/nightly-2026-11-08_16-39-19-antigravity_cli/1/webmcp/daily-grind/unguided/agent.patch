+            registerTool: function (toolDef, optionalExecuteFn) {
+              if (!toolDef || !toolDef.name) {
+                throw new Error('Tool definition requires a valid name');
+              }
+              const normalizedTool = Object.assign({}, toolDef);
+              if (typeof optionalExecuteFn === 'function' && typeof normalizedTool.execute !== 'function') {
+                normalizedTool.execute = optionalExecuteFn;
+              }
+              toolRegistryMap.set(normalizedTool.name, normalizedTool);
+              return normalizedTool;
+            },
+            unregisterTool: function (name) {
+              return toolRegistryMap.delete(name);
+            },
