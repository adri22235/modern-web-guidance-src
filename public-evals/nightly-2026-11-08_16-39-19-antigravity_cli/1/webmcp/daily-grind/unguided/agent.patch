+      // =========================================================================
+      // Register Tools on `navigator.modelContext` (WebMCP Standard + Fallback)
+      // =========================================================================
+
+      const toolRegistryMap = new Map();
+
+      function registerToolsWithBrowser() {
+        WEBMCP_TOOLS.forEach(tool => {
+          toolRegistryMap.set(tool.name, tool);
+        });
+
+        const existingModelContext = navigator.modelContext;
+
+        if (existingModelContext) {
+          // 1. If native or pre-injected navigator.modelContext exists, register tools
+          if (typeof existingModelContext.provideContext === 'function') {
+            try {
+              existingModelContext.provideContext({ tools: WEBMCP_TOOLS });
+            } catch (err) {
+              // Ignore if provideContext signature differs
+            }
+          }
+
+          if (typeof existingModelContext.registerTool === 'function') {
+            for (const tool of WEBMCP_TOOLS) {
+              try {
+                existingModelContext.registerTool(tool);
+              } catch (err) {
+                // Ignore if already registered by provideContext
+              }
+            }
+          }
+
+          // Attach non-intrusive inspection helpers if not already defined
+          try {
+            if (!existingModelContext.tools) {
+              existingModelContext.tools = WEBMCP_TOOLS;
+            }
+            if (typeof existingModelContext.getTools !== 'function') {
+              existingModelContext.getTools = function () {
+                return Array.from(toolRegistryMap.values());
+              };
+            }
+            if (typeof existingModelContext.listTools !== 'function') {
+              existingModelContext.listTools = function () {
+                return Array.from(toolRegistryMap.values());
+              };
+            }
+            if (typeof existingModelContext.executeTool !== 'function') {
+              existingModelContext.executeTool = async function (nameOrTool, input) {
+                const name = typeof nameOrTool === 'string' ? nameOrTool : nameOrTool && nameOrTool.name;
+                const tool = toolRegistryMap.get(name);
+                if (!tool) throw new Error('Tool not found: ' + name);
+                return await tool.execute(input);
+              };
+            }
