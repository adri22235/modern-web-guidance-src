+      async function executeUpdateMenuUI(rawParams) {
+        const params = normalizeInput(rawParams);
+        const action = (params.action || '').toLowerCase().trim();
+        const updatesApplied = [];
+
+        // 1. Theme switch if requested
+        if (params.theme || action === 'toggle_theme') {
+          const requestedTheme = (params.theme || '').toLowerCase();
+          let nextTheme = 'light';
+          if (requestedTheme === 'dark' || requestedTheme === 'autumn' || requestedTheme === 'light') {
+            nextTheme = requestedTheme;
+          } else {
+            nextTheme = appState.theme === 'light' ? 'dark' : 'light';
+          }
+          document.body.classList.remove('theme-dark', 'theme-autumn');
+          if (nextTheme === 'dark') document.body.classList.add('theme-dark');
+          if (nextTheme === 'autumn') document.body.classList.add('theme-autumn');
+          appState.theme = nextTheme;
+          updatesApplied.push('Switched page theme to ' + nextTheme);
+        }
+
+        // 2. Highlight or select a drink card
+        const targetDrinkName = params.drinkName || params.drink || params.name || params.highlight;
+        if (targetDrinkName || action === 'highlight_drink') {
+          const drink = findDrink(targetDrinkName || appState.selectedDrink) || getMenuFromDOMAndState()[0];
+          updateDrinkDetailsUI(drink);
+          updatesApplied.push('Highlighted Seasonal Favorite: ' + drink.name);
+        }
+
+        // 3. Filter menu cards
+        if (params.filter !== undefined || params.category !== undefined || params.query !== undefined || action === 'filter_menu') {
+          const filterCat = params.category || params.filter || 'all';
+          const searchKw = params.query || '';
+          const visible = filterMenuDOM(filterCat, searchKw);
+          updatesApplied.push('Filtered Seasonal Favorites menu (' + visible.length + ' visible: ' + visible.join(', ') + ')');
+        }
+
+        // 4. Update promotional banner message
+        const customBanner = params.bannerText || params.message || params.promoText || params.announcement;
+        if (customBanner || action === 'update_promo_banner') {
+          const textToSet =
+            customBanner || 'Special Seasonal Offer: Enjoy 20% off any Maple Oat Latte, Dark Roast Espresso, or Cold Brew!';
+          const promoTextEl = document.getElementById('promo-banner-text');
+          if (promoTextEl) {
+            promoTextEl.textContent = textToSet;
+          }
+          appState.bannerText = textToSet;
+          updatesApplied.push('Updated promo banner: "' + textToSet + '"');
+        }
+
+        // 5. Checkout or clear order
+        if (action === 'checkout_order' || action === 'checkout') {
+          const totalItems = appState.cart.reduce((s, i) => s + i.quantity, 0);
+          const totalPrice = appState.cart.reduce((s, i) => s + i.lineTotal, 0);
+          const msg =
+            totalItems > 0
+              ? 'Checkout Complete! Preparing ' + totalItems + ' drink(s) ($' + totalPrice.toFixed(2) + ') for pickup at counter.'
+              : 'Checkout Complete! Your barista counter order is ready.';
+          renderCartAndOrderUI(msg, 'checked-out');
+          updatesApplied.push(msg);
+        } else if (action === 'reset_ui' || action === 'clear_order') {
+          appState.cart = [];
+          filterMenuDOM('all', '');
+          document.body.classList.remove('theme-dark', 'theme-autumn');
+          appState.theme = 'light';
+          renderCartAndOrderUI('Order cart cleared and UI reset.', 'ready');
+          updatesApplied.push('Reset UI filters and cleared order cart');
+        }
+
+        // Default fallback UI update if called with empty arguments
+        if (updatesApplied.length === 0) {
+          const defaultDrink = findDrink(appState.selectedDrink) || getMenuFromDOMAndState()[0];
+          updateDrinkDetailsUI(defaultDrink);
+          const promoTextEl = document.getElementById('promo-banner-text');
+          const msg = 'Spotlight on ' + defaultDrink.name + ' (' + defaultDrink.formattedPrice + ') — Ready for instant order!';
+          if (promoTextEl) promoTextEl.textContent = msg;
+          appState.bannerText = msg;
+          updatesApplied.push(msg);
+        }
+
+        const summaryMessage = updatesApplied.join(' | ');
+        logAgentActivity('update_menu_ui', summaryMessage);
+
+        window.dispatchEvent(
+          new CustomEvent('dailygrind:ui-updated', {
+            detail: { updates: updatesApplied, state: appState }
+          })
+        );
+
+        return formatToolResponse({
+          success: true,
+          updates: updatesApplied,
+          uiState: {
+            selectedDrink: appState.selectedDrink,
+            activeFilter: appState.activeFilter,
+            searchQuery: appState.searchQuery,
+            theme: appState.theme,
+            bannerText: appState.bannerText,
+            orderStatus: appState.orderStatus,
+            cartItemCount: appState.cart.reduce((s, i) => s + i.quantity, 0)
+          },
+          message: summaryMessage
+        });
+      }
+
+      async function executeGetOrderStatus() {
+        const totalItems = appState.cart.reduce((s, i) => s + i.quantity, 0);
+        const totalPrice = Number(appState.cart.reduce((s, i) => s + i.lineTotal, 0).toFixed(2));
+        const message =
+          totalItems > 0
+            ? 'Active Order Cart has ' + totalItems + ' item(s) totaling $' + totalPrice.toFixed(2) + ' (Status: ' + appState.orderStatus + ').'
+            : 'Order Cart is currently empty (Status: ' + appState.orderStatus + ').';
+
+        logAgentActivity('get_order_status', message);
+
+        return formatToolResponse({
+          success: true,
+          status: appState.orderStatus,
+          cart: appState.cart.slice(),
+          orders: appState.orders.slice(),
+          totalItems: totalItems,
+          totalPrice: totalPrice,
+          formattedTotal: '$' + totalPrice.toFixed(2),
+          message: message
+        });
+      }
