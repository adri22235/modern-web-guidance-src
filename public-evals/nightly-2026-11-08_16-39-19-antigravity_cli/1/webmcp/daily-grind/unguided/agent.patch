+          matchedDrink.sizes && matchedDrink.sizes[size] != null
+            ? matchedDrink.sizes[size]
+            : matchedDrink.price;
+        const lineTotal = Number((unitPrice * quantity).toFixed(2));
+
+        const orderId = 'DG-' + (1000 + appState.orders.length + 1);
+        const orderItem = {
+          orderId: orderId,
+          drinkId: matchedDrink.id,
+          drinkName: matchedDrink.name,
+          category: matchedDrink.category,
+          size: size,
+          milk: milk,
+          temperature: temperature,
+          quantity: quantity,
+          unitPrice: unitPrice,
+          lineTotal: lineTotal,
+          notes: notes,
+          status: 'confirmed',
+          orderedAt: new Date().toISOString()
+        };
+
+        appState.cart.push(orderItem);
+        appState.orders.push(orderItem);
+
+        // Sync form inputs on the page
+        const selectDrink = document.getElementById('order-drink-select');
+        const selectSize = document.getElementById('order-size-select');
+        const selectMilk = document.getElementById('order-milk-select');
+        const selectTemp = document.getElementById('order-temp-select');
+        const inputQty = document.getElementById('order-quantity-input');
+        const inputNotes = document.getElementById('order-notes-input');
+
+        if (selectDrink) selectDrink.value = matchedDrink.name;
+        if (selectSize) selectSize.value = size;
+        if (selectMilk) selectMilk.value = milk;
+        if (selectTemp) selectTemp.value = temperature;
+        if (inputQty) inputQty.value = String(quantity);
+        if (inputNotes && notes) inputNotes.value = notes;
+
+        updateDrinkDetailsUI(matchedDrink);
+
+        const statusMessage =
+          'Order Confirmed (' +
+          orderId +
+          '): ' +
+          quantity +
+          'x ' +
+          size +
+          ' ' +
+          temperature +
+          ' ' +
+          matchedDrink.name +
+          (milk && milk !== 'None' ? ' with ' + milk : '') +
+          ' ($' +
+          lineTotal.toFixed(2) +
+          ')!';
+
+        renderCartAndOrderUI(statusMessage, 'confirmed');
+
+        const promoText = document.getElementById('promo-banner-text');
+        if (promoText) {
+          promoText.textContent = statusMessage;
+        }
+
+        logAgentActivity('order_drink', statusMessage);
