+                ? contextInit
+                : (contextInit && Array.isArray(contextInit.tools) ? contextInit.tools : []);
+              list.forEach(t => {
+                if (t && t.name) {
+                  toolRegistryMap.set(t.name, t);
+                }
+              });
+            },
+            clearContext: function () {
+              toolRegistryMap.clear();
+            },
+            getTools: function () {
+              return Array.from(toolRegistryMap.values());
+            },
+            listTools: function () {
+              return Array.from(toolRegistryMap.values());
+            },
+            executeTool: async function (nameOrTool, input) {
+              const name = typeof nameOrTool === 'string' ? nameOrTool : nameOrTool && nameOrTool.name;
+              const tool = toolRegistryMap.get(name);
+              if (!tool || typeof tool.execute !== 'function') {
