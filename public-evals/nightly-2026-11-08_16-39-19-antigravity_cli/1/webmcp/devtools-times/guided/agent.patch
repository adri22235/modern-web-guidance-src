diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..11bf220
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,195 @@
+import React from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface ArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+}
+
+interface Props {
+  article: ArticleMetadata;
+  initialIsBookmarked: boolean;
+}
+
+const EMPTY_OBJECT_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const SHARE_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    channel: {
+      type: 'string',
+      enum: ['copy_link', 'email', 'x', 'facebook'],
+      default: 'copy_link',
+      description: 'Destination channel for sharing the article link.',
+    },
+  },
+} as const;
+
+const READ_ONLY_ANNOTATIONS = { readOnlyHint: true } as const;
+const MUTATION_ANNOTATIONS = { readOnlyHint: false } as const;
+
+const SUPPORTED_SHARE_CHANNELS = ['copy_link', 'email', 'x', 'facebook'] as const;
+
+export default function ArticleTools({ article, initialIsBookmarked }: Props) {
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_details',
+    description: 'Extracts the current article metadata, full body text, headings, word count, and estimated reading time from the page. Use when the user wants to read, summarize, or analyze the current article.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: () => {
+      const bodyElement = document.querySelector('article .prose');
+      const fullText = bodyElement?.textContent?.trim() ?? '';
+      const words = fullText ? fullText.split(/\s+/).filter(Boolean).length : 0;
+      const estimatedMinutes = Math.max(1, Math.ceil(words / 200));
+      const headings = Array.from(document.querySelectorAll('article .prose h2, article .prose h3')).map(
+        heading => heading.textContent?.trim() ?? ''
+      ).filter(Boolean);
+
+      return {
+        slug: article.slug,
+        title: article.title,
+        summary: article.summary,
+        author: article.author,
+        date: article.date,
+        category: article.category,
+        readingTimeMinutes: article.readingTime ?? estimatedMinutes,
+        wordCount: words,
+        headings,
+        content: fullText,
+        url: window.location.href,
+      };
+    },
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'bookmark_current_article',
+    description: 'Toggles the current article in the user reading list. Use when the user wants to bookmark or unbookmark the article currently open on the page.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    execute: async (_args, { signal }) => {
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug: article.slug }),
+          signal,
+        });
+
+        if (!response.ok) {
+          return { error: `Failed to update reading list (status ${response.status}).` };
+        }
+
+        const data = await response.json();
+        const updatedList: string[] = Array.isArray(data.readingList) ? data.readingList : [];
+        const isBookmarked = updatedList.includes(article.slug);
+
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } })
+        );
+
+        return {
+          slug: article.slug,
+          title: article.title,
+          bookmarked: isBookmarked,
+          action: isBookmarked ? 'added' : 'removed',
+          readingList: updatedList,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP<{ channel?: string }, unknown>({
+    name: 'share_current_article',
+    description: 'Shares the current article by copying its URL to the clipboard or generating a share link for the chosen channel. Use when the user wants to share or copy the link to the current article.',
+    inputSchema: SHARE_ARTICLE_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: async ({ channel = 'copy_link' }) => {
+      if (
+        typeof channel !== 'string' ||
+        !SUPPORTED_SHARE_CHANNELS.includes(channel as (typeof SUPPORTED_SHARE_CHANNELS)[number])
+      ) {
+        return {
+          error: 'Invalid share channel specified.',
+          supportedChannels: SUPPORTED_SHARE_CHANNELS,
+        };
+      }
+
+      const shareUrl = window.location.href;
+      const encodedUrl = encodeURIComponent(shareUrl);
+      const encodedTitle = encodeURIComponent(article.title);
+
+      if (channel === 'copy_link') {
+        let copiedToClipboard = false;
+        if (navigator.clipboard?.writeText) {
+          try {
+            await navigator.clipboard.writeText(shareUrl);
+            copiedToClipboard = true;
+          } catch {
+            copiedToClipboard = false;
+          }
+        }
+        return {
+          channel,
+          title: article.title,
+          url: shareUrl,
+          copiedToClipboard,
+        };
+      }
+
+      const shareTargets: Record<string, string> = {
+        email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
+        x: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
+        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
+      };
+
+      return {
+        channel,
+        title: article.title,
+        url: shareUrl,
+        shareTargetUrl: shareTargets[channel],
+      };
+    },
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_popularity',
+    description: 'Fetches real-time view count and trending status for the current article. Use when the user asks how popular or trending the current article is.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: async (_args, { signal }) => {
+      try {
+        const url = `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(article.slug)}`;
+        const response = await fetch(url, { signal });
+        if (!response.ok) {
+          return { error: `Popularity request failed with status ${response.status}.` };
+        }
+        const stats = await response.json();
+        return {
+          slug: article.slug,
+          title: article.title,
+          ...stats,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  return null;
+}
