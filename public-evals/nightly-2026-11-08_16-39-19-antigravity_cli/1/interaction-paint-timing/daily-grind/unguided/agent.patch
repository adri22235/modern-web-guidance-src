+        },
+        '/rewards': {
+          title: 'Daily Grind Rewards',
+          description: 'Earn beans with every cup and redeem them for free drinks, whole-bean bags, and merch.'
+        },
+        '/account': {
+          title: 'My Account',
+          description: 'Manage your coffee subscriptions, saved orders, and payment preferences.'
+        },
+        '/logout': {
+          title: 'Signed Out',
+          description: 'You have been signed out of your Daily Grind account. See you tomorrow morning!'
+        },
+        '/order-online': {
+          title: 'Order Online for Pickup or Delivery',
+          description: 'Customize your drink, choose your pickup cafe, and skip the morning line.'
+        },
+        '/menu/seasonal': {
+          title: 'Maple Oat Latte — Seasonal Favorite',
+          description: 'Rich double-shot espresso blended with steamed oat milk, pure Vermont maple syrup, and a dusting of cinnamon.'
+        },
+        '/menu/espresso': {
+          title: 'Dark Roast Espresso — Seasonal Favorite',
+          description: 'Full-bodied single-origin dark roast featuring notes of dark chocolate, roasted hazelnut, and molasses.'
+        },
+        '/menu/cold-brew': {
+          title: '18-Hour Cold Brew — Seasonal Favorite',
+          description: 'Slow-steeped in cold filtered water for 18 hours for a velvety-smooth, low-acidity caffeine kick.'
+        }
+      };
+
+      const metrics = [];
+      let measurementSeq = 0;
+      let currentView = window.location.pathname || '/';
+      let isInternalHistoryUpdate = false;
+
+      /**
+       * Waits until the browser has finished painting the visual updates queued
+       * in the current task/frame using a double-requestAnimationFrame callback.
+       */
+      function afterNextPaint(callback) {
+        if (typeof window.requestAnimationFrame === 'function') {
+          window.requestAnimationFrame(function () {
+            window.requestAnimationFrame(function () {
+              callback(performance.now());
+            });
+          });
+        } else {
+          setTimeout(function () {
+            callback(performance.now());
+          }, 16);
+        }
+      }
+
+      /**
+       * Updates the on-page Performance Monitor HUD with the newly recorded metric.
+       */
+      function updateMonitorUI(entry) {
+        const statEl = document.getElementById('perf-stat-' + entry.category);
+        if (statEl) {
+          statEl.textContent = entry.duration.toFixed(2) + ' ms';
+        }
+
+        const countEl = document.getElementById('perf-total-count');
+        if (countEl) {
+          countEl.textContent = metrics.length + (metrics.length === 1 ? ' measurement' : ' measurements');
+        }
+
+        const logList = document.getElementById('perf-log-list');
+        if (logList) {
+          const li = document.createElement('li');
+          const labelSpan = document.createElement('span');
+          labelSpan.textContent = '[' + entry.category + '] ' + entry.label;
+          const durationSpan = document.createElement('span');
+          durationSpan.textContent = entry.duration.toFixed(2) + ' ms';
+          li.appendChild(labelSpan);
+          li.appendChild(durationSpan);
+          logList.insertBefore(li, logList.firstChild);
+        }
+      }
+
+      /**
+       * Records a performance measurement from startTime until the next paint completes.
+       */
+      function measureUntilPaint(options) {
+        const id = ++measurementSeq;
+        const category = options.category;
+        const label = options.label || category;
+        const target = options.target || null;
+        const route = options.route || currentView;
+        const startTime = typeof options.startTime === 'number' ? options.startTime : performance.now();
+        const startMark = 'dg-' + category + '-' + id + '-start';
+        const endMark = 'dg-' + category + '-' + id + '-paint-end';
+        const measureName = 'dg:' + category + ':' + label;
+
+        if (typeof performance.mark === 'function') {
+          try {
+            performance.mark(startMark, { startTime: startTime });
+          } catch (_) {
+            performance.mark(startMark);
+          }
+        }
+
+        return new Promise(function (resolve) {
+          afterNextPaint(function (paintEndTime) {
+            const duration = Math.max(0, paintEndTime - startTime);
+
+            if (typeof performance.mark === 'function' && typeof performance.measure === 'function') {
+              try {
+                performance.mark(endMark, { startTime: paintEndTime });
+                performance.measure(measureName, {
+                  start: startMark,
+                  end: endMark,
+                  detail: {
+                    category: category,
+                    label: label,
+                    route: route,
+                    duration: duration
+                  }
+                });
+              } catch (_) {
+                try {
+                  performance.mark(endMark);
+                  performance.measure(measureName, startMark, endMark);
+                } catch (_err) {
+                  // Ignore unsupported measure options in older environments
+                }
+              }
+            }
+
+            const entry = {
+              id: id,
+              category: category,
+              type: category,
+              name: measureName,
+              label: label,
+              route: route,
+              target: target ? (target.tagName ? target.tagName.toLowerCase() : String(target)) : null,
+              startTime: startTime,
+              paintTime: paintEndTime,
+              endTime: paintEndTime,
+              duration: duration,
+              timestamp: Date.now()
+            };
+
+            metrics.push(entry);
+            updateMonitorUI(entry);
+
+            if (typeof window.CustomEvent === 'function') {
+              window.dispatchEvent(new CustomEvent('perf:paint', { detail: entry }));
+            }
+
+            console.info(
+              '[DailyGrind Perf] ' + category + ' ("' + label + '") finished painting in ' + duration.toFixed(2) + 'ms',
+              entry
+            );
+
+            resolve(entry);
+          });
+        });
+      }
+
+      /**
+       * Performs a client-side view switch, updates visual state on the page,
+       * and measures how long the view switch takes to finish painting.
+       */
+      function switchView(route, options) {
+        const opts = options || {};
+        const viewStartTime = typeof opts.startTime === 'number' ? opts.startTime : performance.now();
+        const normalizedRoute = route || '/';
+        const previousView = currentView;
+        currentView = normalizedRoute;
+
+        // Update history state without triggering duplicate listener loops
+        if (opts.updateHistory !== false && window.history && typeof window.history.pushState === 'function') {
+          try {
+            isInternalHistoryUpdate = true;
+            window.history.pushState({ view: normalizedRoute }, '', normalizedRoute);
+          } catch (_) {
+            // Ignore pushState restrictions on file:// origins
+          } finally {
+            isInternalHistoryUpdate = false;
+          }
+        }
+
+        // Apply visual updates to the client-side view container
+        const container = document.getElementById('client-view-container');
+        const titleEl = document.getElementById('client-view-title');
+        const routeEl = document.getElementById('client-view-route');
+        const descEl = document.getElementById('client-view-description');
+
+        const content = VIEW_CONTENT[normalizedRoute] || {
+          title: opts.title || 'View: ' + normalizedRoute,
+          description: opts.description || 'Viewing ' + normalizedRoute + ' on The Daily Grind.'
+        };
+
+        if (container && titleEl && routeEl && descEl) {
+          container.classList.add('visible');
+          container.setAttribute('data-active-view', normalizedRoute);
+          titleEl.textContent = content.title;
+          routeEl.textContent = normalizedRoute;
+          descEl.textContent = content.description;
+        }
+
+        // Update active highlight on navigation links
+        const navLinks = document.querySelectorAll('nav a');
+        navLinks.forEach(function (link) {
+          if (link.getAttribute('href') === normalizedRoute) {
+            link.classList.add('active');
+          } else {
+            link.classList.remove('active');
+          }
+        });
+
+        return measureUntilPaint({
+          category: 'view-switch',
+          label: previousView + ' -> ' + normalizedRoute,
+          route: normalizedRoute,
+          target: container,
+          startTime: viewStartTime
+        });
+      }
+
+      // 1. Monitor Navigation Bar clicks
+      const navEl = document.querySelector('nav');
+      if (navEl) {
+        navEl.addEventListener('click', function (event) {
+          const startTime = performance.now();
+          const link = event.target.closest ? event.target.closest('a') : null;
+          const logo = event.target.closest ? event.target.closest('.logo') : null;
+
+          if (!link && !logo) {
+            return;
+          }
+
+          if (link) {
+            event.preventDefault();
+          }
+
+          const route = link ? (link.getAttribute('href') || '/') : '/';
+          const label = link ? (link.textContent.trim() || route) : 'THE DAILY GRIND (Logo)';
+
+          measureUntilPaint({
+            category: 'navigation',
+            label: label,
+            route: route,
+            target: link || logo,
+            startTime: startTime
+          });
+
+          switchView(route, { startTime: startTime });
+        });
+      }
+
+      // 2. Monitor "Order Now" button clicks
+      const orderNowBtn = document.querySelector('.hero .btn, a[href="/order-online"]');
+      if (orderNowBtn) {
+        orderNowBtn.addEventListener('click', function (event) {
+          const startTime = performance.now();
+          event.preventDefault();
+
+          orderNowBtn.classList.add('active-btn');
+          const route = orderNowBtn.getAttribute('href') || '/order-online';
+          const label = orderNowBtn.textContent.trim() || 'Order Now';
+
+          measureUntilPaint({
+            category: 'order-now',
+            label: label,
+            route: route,
+            target: orderNowBtn,
+            startTime: startTime
+          });
+
+          switchView(route, { startTime: startTime });
+        });
+      }
+
+      // 3. Monitor "Seasonal Favorites" card clicks
+      const seasonalCards = document.querySelectorAll('.card');
+      seasonalCards.forEach(function (card) {
+        card.addEventListener('click', function (event) {
+          const startTime = performance.now();
+          const link = card.querySelector('a.btn') || (event.target.closest ? event.target.closest('a') : null);
+          if (event.target.closest && event.target.closest('a')) {
+            event.preventDefault();
+          }
+
+          seasonalCards.forEach(function (c) {
+            c.classList.remove('active-card');
+          });
+          card.classList.add('active-card');
+
+          const heading = card.querySelector('h3');
+          const description = card.querySelector('p');
+          const route = link ? (link.getAttribute('href') || '/menu/seasonal') : '/menu/seasonal';
+          const label = heading ? heading.textContent.trim() : 'Seasonal Favorite Card';
+
+          measureUntilPaint({
+            category: 'seasonal-favorites',
+            label: label,
+            route: route,
+            target: card,
+            startTime: startTime
+          });
+
+          switchView(route, {
+            startTime: startTime,
+            title: label,
+            description: description ? description.textContent.trim() : ''
+          });
+        });
+      });
+
+      // 4. Monitor client-side view switches initiated via History API, popstate, or hashchange
+      window.addEventListener('popstate', function () {
+        const startTime = performance.now();
+        const route = window.location.pathname + window.location.hash || '/';
+        switchView(route, { startTime: startTime, updateHistory: false });
+      });
+
+      window.addEventListener('hashchange', function () {
+        const startTime = performance.now();
+        const route = window.location.hash || window.location.pathname || '/';
+        switchView(route, { startTime: startTime, updateHistory: false });
+      });
+
+      if (window.history) {
+        ['pushState', 'replaceState'].forEach(function (method) {
+          const original = window.history[method];
+          if (typeof original === 'function') {
+            window.history[method] = function (state, title, url) {
+              const startTime = performance.now();
+              const result = original.apply(this, arguments);
+              if (!isInternalHistoryUpdate && url) {
+                switchView(String(url), { startTime: startTime, updateHistory: false });
+              }
+              return result;
+            };
+          }
+        });
+      }
+
+      // 5. Observe browser Event Timing & Paint Timing entries where supported
+      const observedEvents = [];
+      if (typeof window.PerformanceObserver === 'function') {
+        try {
+          const eventObserver = new PerformanceObserver(function (list) {
+            list.getEntries().forEach(function (entry) {
+              if (entry.name === 'click' || entry.name === 'pointerdown' || entry.name === 'pointerup') {
+                observedEvents.push({
+                  name: entry.name,
+                  startTime: entry.startTime,
+                  processingStart: entry.processingStart,
+                  processingEnd: entry.processingEnd,
+                  duration: entry.duration,
+                  interactionId: entry.interactionId || 0
+                });
+              }
+            });
+          });
+          eventObserver.observe({ type: 'event', buffered: true, durationThreshold: 0 });
+        } catch (_) {
+          // Event Timing API may not be supported in all browsers
+        }
+      }
+
+      // Expose public monitoring API for programmatic inspection and testing
+      const monitorAPI = {
+        metrics: metrics,
+        observedEvents: observedEvents,
+        getMetrics: function (category) {
+          if (!category) {
+            return metrics.slice();
+          }
+          return metrics.filter(function (m) {
+            return m.category === category;
+          });
+        },
+        getSummary: function () {
+          const summary = {};
+          ['navigation', 'order-now', 'seasonal-favorites', 'view-switch'].forEach(function (cat) {
+            const items = metrics.filter(function (m) {
+              return m.category === cat;
+            });
+            const total = items.reduce(function (acc, item) {
+              return acc + item.duration;
+            }, 0);
+            summary[cat] = {
+              count: items.length,
+              lastDuration: items.length ? items[items.length - 1].duration : null,
+              averageDuration: items.length ? total / items.length : null
+            };
+          });
+          return summary;
+        },
+        measureInteraction: measureUntilPaint,
+        switchView: switchView,
+        clearMetrics: function () {
+          metrics.length = 0;
+          if (typeof performance.clearMarks === 'function') {
+            performance.clearMarks();
+          }
+          if (typeof performance.clearMeasures === 'function') {
+            performance.clearMeasures();
+          }
+        }
+      };
+
+      window.performanceMonitor = monitorAPI;
+      window.dailyGrindPerf = monitorAPI;
+      window.__perfMetrics = metrics;
+    })();
+  </script>
