+  <script>
+    (function () {
+      'use strict';
+
+      const VIEW_CONTENT = {
+        '/': {
+          title: 'Welcome to The Daily Grind',
+          description: 'Ethically sourced, locally roasted artisanal coffee crafted fresh daily.'
+        },
+        '/menu': {
+          title: 'Full Coffee & Pastry Menu',
