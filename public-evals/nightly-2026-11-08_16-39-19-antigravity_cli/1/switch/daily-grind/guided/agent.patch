+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const notificationsToggle = document.getElementById('notifications');
+    const statusOutput = document.getElementById('preference-status');
+    const STORAGE_KEY = 'daily_grind_notifications_enabled';
+
+    const updateStatus = (isChecked) => {
+      if (statusOutput) {
+        statusOutput.textContent = `Notifications: ${isChecked ? 'On' : 'Off'}`;
+      }
+    };
+
+    if (notificationsToggle) {
+      try {
+        const savedPref = localStorage.getItem(STORAGE_KEY);
+        if (savedPref !== null) {
+          notificationsToggle.checked = savedPref === 'true';
+        }
+      } catch {
+        // Ignore storage errors in restricted environments
+      }
+      updateStatus(notificationsToggle.checked);
+
+      notificationsToggle.addEventListener('change', (event) => {
+        const isChecked = event.currentTarget.checked;
+        updateStatus(isChecked);
+        try {
+          localStorage.setItem(STORAGE_KEY, String(isChecked));
+        } catch {
+          // Ignore storage errors
+        }
+      });
+    }
+  </script>
+
 </body>
 
