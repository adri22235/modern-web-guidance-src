+  <script>
+    (function () {
+      const STORAGE_KEY = 'dailyGrind_darkModePreference';
+      const toggleInput = document.getElementById('preference-toggle');
+      const statusBadge = document.getElementById('preference-status');
+
+      function applyPreference(isEnabled) {
+        document.body.classList.toggle('dark-mode', isEnabled);
+        document.documentElement.setAttribute('data-theme', isEnabled ? 'dark' : 'light');
+
+        if (toggleInput) {
+          toggleInput.checked = isEnabled;
+          toggleInput.setAttribute('aria-checked', String(isEnabled));
+        }
+
+        if (statusBadge) {
+          statusBadge.textContent = isEnabled ? 'On' : 'Off';
+          statusBadge.classList.toggle('is-on', isEnabled);
+        }
+      }
+
+      // Load saved preference from localStorage
+      let savedPreference = false;
+      try {
+        const storedValue = localStorage.getItem(STORAGE_KEY);
+        savedPreference = storedValue === 'true' || storedValue === 'on' || storedValue === '1';
+      } catch (e) {
+        // Fallback if localStorage is restricted
+      }
+
+      applyPreference(savedPreference);
+
+      if (toggleInput) {
+        toggleInput.addEventListener('change', function (event) {
+          const isEnabled = Boolean(event.target.checked);
+          applyPreference(isEnabled);
+          try {
+            localStorage.setItem(STORAGE_KEY, String(isEnabled));
+          } catch (e) {
+            // Ignore storage write errors
+          }
+        });
+      }
+    })();
+  </script>
+
