+  <script>
+    const notificationsSwitch = document.getElementById('notifications');
+    const notificationsStatus = document.getElementById('notifications-status');
+    const STORAGE_KEY = 'daily_grind_order_notifications';
+
+    function updatePreferenceStatus(isEnabled) {
+      notificationsStatus.textContent = isEnabled
+        ? 'Order ready notifications are currently on.'
+        : 'Order ready notifications are currently off.';
+    }
+
+    try {
+      const savedPreference = localStorage.getItem(STORAGE_KEY);
+      if (savedPreference !== null) {
+        notificationsSwitch.checked = savedPreference === 'true';
+        updatePreferenceStatus(notificationsSwitch.checked);
+      }
+    } catch {
+      // Ignore storage access errors in restricted environments
+    }
+
+    notificationsSwitch.addEventListener('change', (event) => {
+      const isEnabled = event.currentTarget.checked;
+      updatePreferenceStatus(isEnabled);
+      try {
+        localStorage.setItem(STORAGE_KEY, String(isEnabled));
+      } catch {
+        // Ignore storage write errors
+      }
+    });
+  </script>
