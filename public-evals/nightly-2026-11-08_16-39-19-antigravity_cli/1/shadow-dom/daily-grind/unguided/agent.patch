+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'title',
+          'description',
+          'href',
+          'link',
+          'link-text',
+          'action-text',
+          'limited',
+          'badge',
+          'is-limited'
+        ];
+      }
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+      }
+
+      connectedCallback() {
+        this.render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue !== newValue) {
+          this.render();
+        }
+      }
+
+      get title() {
+        return this.getAttribute('title') || '';
+      }
+
+      set title(value) {
+        this.setAttribute('title', value ?? '');
+      }
+
+      get description() {
+        return this.getAttribute('description') || '';
+      }
+
+      set description(value) {
+        this.setAttribute('description', value ?? '');
+      }
+
+      get href() {
+        return this.getAttribute('href') || this.getAttribute('link') || '#';
+      }
+
+      set href(value) {
+        this.setAttribute('href', value ?? '#');
+      }
+
+      get linkText() {
+        return this.getAttribute('link-text') || this.getAttribute('action-text') || 'View Details';
+      }
+
+      set linkText(value) {
+        this.setAttribute('link-text', value ?? 'View Details');
+      }
+
+      get limited() {
+        return this._hasBadge();
+      }
+
+      set limited(value) {
+        if (value && String(value).toLowerCase() !== 'false') {
+          this.setAttribute('limited', '');
+        } else {
+          this.removeAttribute('limited');
+          this.removeAttribute('badge');
+          this.removeAttribute('is-limited');
+        }
+      }
+
+      get badge() {
+        return this._getBadgeText();
+      }
+
+      set badge(value) {
+        if (value && String(value).toLowerCase() !== 'false') {
+          this.setAttribute('badge', value === true ? 'Limited' : String(value));
+        } else {
+          this.removeAttribute('badge');
+          this.removeAttribute('limited');
+          this.removeAttribute('is-limited');
+        }
+      }
+
+      _hasBadge() {
+        for (const attr of ['limited', 'badge', 'is-limited']) {
+          if (this.hasAttribute(attr)) {
+            const val = this.getAttribute(attr);
+            if (val !== null && val.toLowerCase() !== 'false') {
+              return true;
+            }
+          }
+        }
+        return false;
+      }
+
+      _getBadgeText() {
+        if (!this._hasBadge()) return '';
+        const badgeVal = this.getAttribute('badge');
+        if (badgeVal && badgeVal.toLowerCase() !== 'true') {
+          return badgeVal;
+        }
+        const limitedVal = this.getAttribute('limited');
+        if (limitedVal && limitedVal.toLowerCase() !== 'true') {
+          return limitedVal;
+        }
+        return 'Limited';
+      }
+
+      _escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      }
+
+      render() {
+        const title = this._escapeHtml(this.title);
+        const description = this._escapeHtml(this.description);
+        const href = this._escapeHtml(this.href);
+        const linkText = this._escapeHtml(this.linkText);
+        const hasBadge = this._hasBadge();
+        const badgeText = this._escapeHtml(this._getBadgeText());
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: block;
+            }
+
+            * {
+              box-sizing: border-box;
+              margin: 0;
+              padding: 0;
+            }
+
+            .card {
+              position: relative;
+              background: white;
+              padding: 20px;
+              border-radius: 8px;
+              box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+              text-align: center;
+              height: 100%;
+            }
+
+            .badge {
+              position: absolute;
+              top: 10px;
+              right: 10px;
+              display: inline-block;
+              background: var(--accent, #ffab40);
+              color: var(--text, #3e2723);
+              font-size: 0.75rem;
+              font-weight: bold;
+              text-transform: uppercase;
+              letter-spacing: 0.5px;
+              padding: 2px 8px;
+              border-radius: 12px;
+            }
+
+            h3 {
+              margin-bottom: 10px;
+              color: var(--primary, #4e342e);
+            }
+
+            .btn {
+              display: inline-block;
+              background: var(--primary, #4e342e);
+              color: white;
+              padding: 10px 20px;
+              text-decoration: none;
+              border-radius: 5px;
+              margin-top: 15px;
+              transition: background 0.3s;
+            }
+
+            .btn:hover {
+              background: #3e2723;
+            }
+          </style>
+          <div class="card" part="card">
+            <slot name="badge">${hasBadge ? `<span class="badge" part="badge">${badgeText}</span>` : ''}</slot>
+            <h3><slot name="title">${title}</slot></h3>
+            <p><slot name="description">${description}</slot></p>
+            <slot name="action"><a href="${href}" class="btn" part="button">${linkText}</a></slot>
+          </div>
+        `;
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
