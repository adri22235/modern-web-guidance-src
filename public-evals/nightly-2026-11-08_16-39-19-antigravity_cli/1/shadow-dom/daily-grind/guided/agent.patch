+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+        container-type: inline-size;
+        --_card-bg: var(--card-bg, white);
+        --_card-primary: var(--primary, #4e342e);
+        --_card-accent: var(--accent, #ffab40);
+        --_card-text: var(--text, #3e2723);
+      }
+
+      * {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        background: var(--_card-bg);
+        color: var(--_card-text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        align-items: center;
+      }
+
+      .badge-wrapper {
+        display: none;
+        margin-bottom: 8px;
+      }
+
+      :host([limited]) .badge-wrapper,
+      :host([badge]) .badge-wrapper,
+      :host([has-badge]) .badge-wrapper {
+        display: inline-block;
+      }
+
+      .badge,
+      ::slotted([slot="badge"]) {
+        display: inline-block;
+        background: var(--_card-accent);
+        color: var(--_card-text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 3px 10px;
+        border-radius: 999px;
+      }
+
+      .title,
+      ::slotted([slot="title"]) {
+        margin-bottom: 10px;
+        color: var(--_card-primary);
+        font-size: 1.17em;
+        font-weight: bold;
+      }
+
+      .description,
+      ::slotted([slot="description"]),
+      ::slotted(p) {
+        margin-bottom: 5px;
+      }
+
+      .btn,
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--_card-primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover,
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div class="badge-wrapper" part="badge-wrapper">
+          <slot name="badge"><span class="badge" part="badge">Limited</span></slot>
+        </div>
+        <slot name="title"><h3 class="title" part="title"></h3></slot>
+        <slot name="description"><p class="description" part="description"></p></slot>
+        <slot></slot>
+        <slot name="action"><a class="btn" part="action" href="#">View Details</a></slot>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['title', 'description', 'href', 'action-text', 'limited', 'badge'];
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        // MANDATORY: deep-clone the template content so each instance gets its own nodes.
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        const badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        badgeSlot.addEventListener('slotchange', (e) => {
+          const nodes = e.target.assignedNodes({ flatten: false }).filter(
+            (n) => n.nodeType === Node.ELEMENT_NODE || (n.nodeType === Node.TEXT_NODE && n.textContent.trim() !== '')
+          );
+          this.toggleAttribute('has-badge', nodes.length > 0);
+        });
+      }
+
+      connectedCallback() {
+        this.render();
+      }
+
+      get title() {
+        return this.getAttribute('title') ?? '';
+      }
+      set title(v) {
+        v ? this.setAttribute('title', v) : this.removeAttribute('title');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', v) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get actionText() {
+        return this.getAttribute('action-text') ?? 'View Details';
+      }
+      set actionText(v) {
+        v ? this.setAttribute('action-text', v) : this.removeAttribute('action-text');
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+      set limited(on) {
+        this.toggleAttribute('limited', !!on);
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+      set badge(v) {
+        v ? this.setAttribute('badge', v) : this.removeAttribute('badge');
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.render();
+        }
+      }
+
+      render() {
+        const titleEl = this.shadowRoot.querySelector('.title');
+        const descEl = this.shadowRoot.querySelector('.description');
+        const actionEl = this.shadowRoot.querySelector('.btn');
+        const badgeEl = this.shadowRoot.querySelector('.badge');
+
+        if (titleEl) titleEl.textContent = this.title;
+        if (descEl) descEl.textContent = this.description;
+        if (actionEl) {
+          actionEl.setAttribute('href', this.href || '#');
+          actionEl.textContent = this.actionText || 'View Details';
+        }
+        if (badgeEl) {
+          const badgeVal = this.getAttribute('badge');
+          badgeEl.textContent = badgeVal && badgeVal !== 'true' ? badgeVal : 'Limited';
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
 </html>
