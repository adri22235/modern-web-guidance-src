+  <script>
+    (function () {
+      const lockup = document.querySelector('.hero h1.poster-lockup');
+      if (!lockup) return;
+      const lines = lockup.querySelectorAll('.poster-line');
+
+      function fitPosterLockup() {
+        const targetWidth = lockup.clientWidth;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          const baseSize = 100;
+          line.style.fontSize = baseSize + 'px';
+          const initialWidth = line.getBoundingClientRect().width;
+          if (initialWidth > 0) {
+            let fittedSize = (baseSize * targetWidth) / initialWidth;
+            line.style.fontSize = fittedSize + 'px';
+
+            const refinedWidth = line.getBoundingClientRect().width;
+            if (refinedWidth > 0 && Math.abs(refinedWidth - targetWidth) > 0.05) {
+              fittedSize = (fittedSize * targetWidth) / refinedWidth;
+              line.style.fontSize = fittedSize + 'px';
+            }
+          }
+        });
+      }
+
+      fitPosterLockup();
+      window.addEventListener('resize', fitPosterLockup);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(fitPosterLockup).observe(lockup);
+      }
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitPosterLockup);
+      }
+    })();
+  </script>
+
