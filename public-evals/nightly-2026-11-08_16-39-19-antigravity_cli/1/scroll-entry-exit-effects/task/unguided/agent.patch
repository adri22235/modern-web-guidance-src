diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,45 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    @keyframes card-reveal {
+      0%,
+      entry 0% {
+        opacity: 0;
+        transform: scale(0.5);
+      }
+
+      entry 100%,
