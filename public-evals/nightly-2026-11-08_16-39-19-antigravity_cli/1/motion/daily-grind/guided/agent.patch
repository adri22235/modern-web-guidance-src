+      // 1. Daily Roast Banner Pause / Resume Control
+      const roastBanner = document.getElementById('daily-roast-banner');
+      const roastTrack = document.getElementById('daily-roast-track');
+      const pauseToggleBtn = document.getElementById('roast-pause-toggle');
+      const pauseIcon = document.getElementById('roast-pause-icon');
+      const pauseLabel = document.getElementById('roast-pause-label');
+
+      function setBannerPaused(paused) {
+        roastBanner.setAttribute('data-paused', String(paused));
+        roastTrack.classList.toggle('is-paused', paused);
+        pauseToggleBtn.setAttribute('aria-pressed', String(paused));
+        pauseToggleBtn.setAttribute(
+          'aria-label',
+          paused ? 'Resume daily roast banner animation' : 'Pause daily roast banner animation'
+        );
+        pauseIcon.textContent = paused ? '▶' : '⏸';
+        pauseLabel.textContent = paused ? 'Resume' : 'Pause';
+
+        const trackAnimations = roastTrack.getAnimations();
+        for (const anim of trackAnimations) {
+          if (paused) {
+            anim.pause();
+          } else {
+            anim.play();
+          }
+        }
+        document.body.setAttribute('data-last-animation-state', paused ? 'paused' : 'running');
+      }
+
+      pauseToggleBtn?.addEventListener('click', () => {
+        const isCurrentlyPaused = roastBanner.getAttribute('data-paused') === 'true';
+        setBannerPaused(!isCurrentlyPaused);
+      });
+
+      // 2. Top-Layer Animated Dialog Open & Close Support
+      const dialog = document.getElementById('drink-details-dialog');
+      const dialogBadge = document.getElementById('dialog-drink-badge');
+      const dialogTitle = document.getElementById('dialog-drink-title');
+      const dialogDescription = document.getElementById('dialog-drink-description');
+      const dialogNotes = document.getElementById('dialog-drink-notes');
+      const dialogOrigin = document.getElementById('dialog-drink-origin');
+      const dialogNutrition = document.getElementById('dialog-drink-nutrition');
+      const dialogOrderLink = document.getElementById('dialog-order-link');
+
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      function supportsTopLayerExit() {
+        return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+      }
+
+      async function closeTopLayer(element) {
+        if (!element.open) return;
+        if (!supportsTopLayerExit()) {
+          element.setAttribute('data-closing', '');
+          const animations = element.getAnimations({ subtree: true });
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 2000)),
+            ]);
+          }
+          if (!element.hasAttribute('data-closing')) return;
+          element.removeAttribute('data-closing');
+        }
+        element.close();
+      }
+
+      function openDrinkDialog(drinkKey) {
+        const details = DRINK_DATA[drinkKey] || DRINK_DATA['maple-oat-latte'];
+        dialogBadge.textContent = details.badge;
+        dialogTitle.textContent = details.title;
+        dialogDescription.textContent = details.description;
+        dialogNotes.textContent = details.notes;
+        dialogOrigin.textContent = details.origin;
+        dialogNutrition.textContent = details.nutrition;
+        dialogOrderLink.setAttribute('href', details.href);
+
+        dialog.removeAttribute('data-closing');
+        if (!dialog.open) {
+          dialog.showModal();
+        }
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          const drinkKey = btn.getAttribute('data-drink');
+          openDrinkDialog(drinkKey);
+        });
+      });
+
+      document.getElementById('dialog-close-top')?.addEventListener('click', () => {
+        closeTopLayer(dialog);
+      });
+
+      document.getElementById('dialog-close-btn')?.addEventListener('click', () => {
+        closeTopLayer(dialog);
+      });
+
+      // Route native close requests (Esc, closedby light dismiss) through closeTopLayer
+      dialog?.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        closeTopLayer(dialog);
+      });
+
+      // Fallback for browsers without closedby support
+      if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          const rect = dialog.getBoundingClientRect();
+          const isDialogContent =
+            rect.top <= event.clientY &&
+            event.clientY <= rect.top + rect.height &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.left + rect.width;
+          if (isDialogContent) return;
+          closeTopLayer(dialog);
+        });
+      }
+
+      // 3. Animation & Transition Event Listeners Inspecting event.animation Directly
+      function handleAnimationOrTransitionEvent(event) {
+        // Directly access the exact Animation object via event.animation
+        const animation =
+          event.animation ??
+          event.target?.getAnimations?.().find((anim) =>
+            'animationName' in event
+              ? anim.animationName === event.animationName
+              : anim.transitionProperty === event.propertyName
+          );
+
+        const animId =
+          animation?.animationName ||
+          animation?.transitionProperty ||
+          animation?.id ||
+          event.animationName ||
+          event.propertyName ||
+          'animation';
+
+        const playState = animation?.playState || event.type;
+        const pseudoTarget = animation?.effect?.pseudoElement || '';
+        const stateDescriptor = `${event.type}:${animId}${pseudoTarget}:${playState}`;
+
+        document.body.setAttribute('data-last-animation-state', stateDescriptor);
+      }
+
+      const trackedEvents = [
+        'animationstart',
+        'animationiteration',
+        'animationend',
+        'animationcancel',
+        'transitionrun',
+        'transitionstart',
+        'transitionend',
+        'transitioncancel',
+      ];
+
+      for (const eventType of trackedEvents) {
+        document.addEventListener(eventType, handleAnimationOrTransitionEvent);
+      }
+    })();
+  </script>
