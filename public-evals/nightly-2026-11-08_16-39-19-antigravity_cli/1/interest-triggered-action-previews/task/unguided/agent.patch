+  <script>
+    const previewBox = document.getElementById('seasonal-preview');
+
+    previewBox.addEventListener('interest', (event) => {
+      const invoker = event.source;
+      const card = invoker?.closest('.card');
+      const drinkName = invoker?.dataset.drink || card?.querySelector('h3')?.textContent?.trim() || invoker?.textContent?.trim();
+      const description = invoker?.dataset.description || card?.querySelector('p')?.textContent?.trim() || '';
+      const accentColor = invoker?.dataset.accent || '#ffab40';
+
+      previewBox.textContent = description ? `${drinkName} — ${description}` : `Previewing: ${drinkName}`;
+      previewBox.style.borderColor = accentColor;
+      previewBox.style.backgroundColor = accentColor;
+      previewBox.style.color = '#ffffff';
+    });
+
+    previewBox.addEventListener('loseinterest', () => {
+      previewBox.textContent = 'Select a drink to preview';
+      previewBox.style.borderColor = '';
+      previewBox.style.backgroundColor = '';
+      previewBox.style.color = '';
+    });
+  </script>
