+
+      const columns = Array.from(document.querySelectorAll('.board-column'));
+      const announcer = document.getElementById('board-status-announcer');
+      let activeDraggedCard = null;
+      let nextOrderNumber = 107;
+
+      function renderCardFooterActions(card, status) {
+        const footer = card.querySelector('footer');
+        if (!footer) return;
+
+        const orderId = card.dataset.orderId || card.id;
+        const drinkTitle = card.querySelector('h3')?.textContent?.trim() || 'Drink';
+        const srContext = `Order #${orderId} ${drinkTitle}`;
+
+        footer.replaceChildren();
+
+        const createMoveButton = (labelPrefix, arrowSuffix, targetColumnId) => {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.className = 'card-action-btn';
+          btn.dataset.moveTarget = targetColumnId;
+
+          const prefixNode = document.createTextNode(`${labelPrefix} `);
+          const srSpan = document.createElement('span');
+          srSpan.className = 'visually-hidden';
+          srSpan.textContent = srContext;
+
+          btn.append(prefixNode, srSpan);
+          if (arrowSuffix) {
+            btn.append(document.createTextNode(` ${arrowSuffix}`));
+          }
+          return btn;
+        };
+
+        if (status === 'queued') {
+          footer.append(
+            createMoveButton('Brew', '→', 'column-brewing'),
+            createMoveButton('Mark Ready', '', 'column-ready')
+          );
+        } else if (status === 'brewing') {
+          footer.append(
+            createMoveButton('← Queue', '', 'column-queued'),
+            createMoveButton('Mark Ready', '→', 'column-ready')
+          );
+        } else if (status === 'ready') {
+          footer.append(
+            createMoveButton('← Re-brew', '', 'column-brewing'),
+            createMoveButton('Queue', '', 'column-queued')
+          );
+        }
+      }
+
+      function updateBoardCounts() {
+        columns.forEach((col) => {
+          const status = col.dataset.status;
+          const count = col.querySelectorAll('.card').length;
+          const badge = col.querySelector('.column-count');
+          if (badge) {
+            badge.textContent = String(count);
+            badge.setAttribute('aria-label', `${count} ${count === 1 ? 'order' : 'orders'} in ${STATUS_LABELS[status] || status}`);
+          }
+        });
+      }
+
+      function moveItemToColumn(itemId, columnId) {
+        const item = document.getElementById(itemId);
+        const column = document.getElementById(columnId);
+        if (!item || !column) return;
+
+        // With content-visibility: auto on .board-column, the browser isolates layout
+        // and paint calculations to the affected column containers rather than the full page.
+        column.appendChild(item);
+
+        const newStatus = column.dataset.status || 'queued';
+        item.dataset.status = newStatus;
+
+        const statusBadge = item.querySelector('.order-badge');
+        if (statusBadge) {
+          statusBadge.dataset.badgeStatus = newStatus;
+          statusBadge.textContent = STATUS_LABELS[newStatus] || newStatus;
+        }
+
+        renderCardFooterActions(item, newStatus);
+        updateBoardCounts();
+
+        if (announcer) {
+          const title = item.querySelector('h3')?.textContent?.trim() || itemId;
+          const orderNum = item.dataset.orderId ? `#${item.dataset.orderId}` : '';
+          announcer.textContent = `Moved ${orderNum} ${title} to ${STATUS_LABELS[newStatus] || newStatus}.`;
+        }
+      }
+
+      // Expose helper for programmatic movement
+      window.moveItemToColumn = moveItemToColumn;
+
+      function attachCardDragListeners(card) {
