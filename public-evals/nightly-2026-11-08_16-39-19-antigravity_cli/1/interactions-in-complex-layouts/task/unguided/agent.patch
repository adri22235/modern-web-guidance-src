+        });
+
+        columnEl.addEventListener('dragleave', (e) => {
+          if (!columnEl.contains(e.relatedTarget)) {
+            columnEl.classList.remove('drag-over');
+          }
+        });
+
+        columnEl.addEventListener('drop', (e) => {
+          e.preventDefault();
+          columnEl.classList.remove('drag-over');
+
+          let droppedCardId = activeDragCardId;
+          if (!droppedCardId && e.dataTransfer) {
+            try {
+              droppedCardId = e.dataTransfer.getData('text/plain');
+            } catch (_) {}
+          }
+          if (!droppedCardId && activeDragCardEl) {
+            droppedCardId = activeDragCardEl.dataset.id || activeDragCardEl.id;
+          }
+
+          if (activeDragCardEl) {
+            activeDragCardEl.classList.remove('dragging');
+          }
+
+          if (droppedCardId) {
+            moveOrderBetweenColumns(droppedCardId, targetStatus);
+          }
+
+          activeDragCardId = null;
+          activeDragCardEl = null;
+          nativeDragActive = false;
+        });
+      }
+
+      // Window-level mouse fallback listeners (only engage if native HTML5 dragstart did not fire)
+      window.addEventListener('mousemove', (e) => {
+        if (!mouseDragState || nativeDragActive) return;
+        const dx = e.clientX - mouseDragState.startX;
+        const dy = e.clientY - mouseDragState.startY;
+        if (!mouseDragState.active && Math.hypot(dx, dy) > 6) {
+          mouseDragState.active = true;
+          mouseDragState.cardEl.classList.add('dragging');
+        }
+      });
+
+      window.addEventListener('mouseup', (e) => {
+        if (!mouseDragState) return;
+        const state = mouseDragState;
+        mouseDragState = null;
+
+        if (nativeDragActive || !state.active) {
+          state.cardEl.classList.remove('dragging');
+          return;
+        }
+
+        state.cardEl.classList.remove('dragging');
+        clearDragHighlights();
+
+        const columns = Array.from(document.querySelectorAll('.board-column'));
+        let targetCol = null;
+
+        if (typeof document.elementsFromPoint === 'function') {
+          const hitElements = document.elementsFromPoint(e.clientX, e.clientY);
+          for (const el of hitElements) {
+            const col = el.closest && el.closest('.board-column');
+            if (col) {
+              targetCol = col;
+              break;
+            }
+          }
+        }
+
+        if (!targetCol) {
+          targetCol = columns.find((col) => {
+            const rect = col.getBoundingClientRect();
+            return (
+              e.clientX >= rect.left &&
+              e.clientX <= rect.right &&
+              e.clientY >= rect.top &&
+              e.clientY <= rect.bottom
+            );
+          });
+        }
+
+        if (targetCol && targetCol.dataset.status) {
+          moveOrderBetweenColumns(state.cardId, targetCol.dataset.status);
+        }
+      });
+
+      // Initialize isolated column controllers
+      document.querySelectorAll('.board-column').forEach((columnEl) => {
+        createIsolatedColumn(columnEl);
+        setupColumnDropZone(columnEl);
+      });
+
+      // Handle new order submission (updates ONLY the 'queued' column)
+      const newOrderForm = document.getElementById('new-order-form');
+      if (newOrderForm) {
+        newOrderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const customerInput = document.getElementById('order-customer');
+          const drinkSelect = document.getElementById('order-drink');
+          const sizeSelect = document.getElementById('order-size');
+
+          const customer = (customerInput.value || '').trim();
+          if (!customer) return;
+
+          const orderNum = nextOrderNum++;
+          const newOrder = {
+            id: `order-${orderNum}`,
+            number: `#${orderNum}`,
+            customer,
+            drink: drinkSelect.value,
+            meta: `${sizeSelect.value} \u2022 Barista Ticket`,
+            time: 'Just now',
+            status: 'queued'
+          };
+
+          columnState.queued.push(newOrder);
+          notifyColumn('queued');
+          customerInput.value = '';
+        });
+      }
+    })();
+  </script>
 </body>
 
