+  <script type="module">
+    // Feature detect 'commandForElement' on HTMLButtonElement.prototype and conditionally load polyfill
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const moveModalBtn = document.getElementById('move-modal-btn');
+    const parentLabel = document.getElementById('modal-parent-label');
+
+    const sections = [
+      document.getElementById('hero-section'),
+      document.getElementById('seasonal-section'),
+      document.getElementById('footer-section')
+    ].filter(Boolean);
+
+    function updateParentDisplay() {
+      const currentParent = feedbackDialog.parentElement;
+      if (!currentParent) return;
+      const name = currentParent.dataset.sectionName || currentParent.id || currentParent.tagName.toLowerCase();
+      parentLabel.textContent = name;
+    }
+
+    moveModalBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const currentIndex = sections.indexOf(currentParent);
+      const nextIndex = (currentIndex + 1) % sections.length;
+      const targetParent = sections[nextIndex];
+
+      if (!targetParent) return;
+
+      // Use atomic moveBefore() to keep the open <dialog> in the top layer and preserve focus/state
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+      } else {
+        // Fallback for browsers without moveBefore support
+        const wasOpen = feedbackDialog.hasAttribute('open');
+        targetParent.insertBefore(feedbackDialog, null);
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        }
+      }
+
+      updateParentDisplay();
+    });
+
+    // Reset returnValue on close so stale values do not leak across dismissals
+    feedbackDialog.addEventListener('close', () => {
+      feedbackDialog.returnValue = '';
+    });
+
+    // Fallback for browsers without declarative closedby="any" light-dismiss support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => {
+          if (e.target === dialog) {
+            pressedOutside = outside(e, dialog);
+          } else {
+            pressedOutside = false;
+          }
+        });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && e.target === dialog && outside(e, dialog)) {
+            dialog.close();
+          }
+          pressedOutside = false;
+        });
+      }
+    }
+  </script>
