+  <script>
+    (function () {
+      const modal = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const closeBtn = document.getElementById('close-modal-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const form = document.getElementById('feedback-form');
+      const sectionLabel = document.getElementById('modal-current-section');
+      const statusText = document.getElementById('feedback-status');
+      const sections = Array.from(document.querySelectorAll('main section.page-section'));
+
+      function updateSectionHighlight() {
+        const currentParentSection = modal.closest('section.page-section');
+        sections.forEach((sec) => {
+          sec.classList.toggle('has-modal', sec === currentParentSection);
+        });
+        if (currentParentSection && sectionLabel) {
+          const title =
+            currentParentSection.getAttribute('data-section-title') ||
+            currentParentSection.id ||
+            'Section';
+          sectionLabel.textContent = title;
+          modal.setAttribute('data-current-section', currentParentSection.id);
+        }
+      }
+
+      function openModal() {
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            try {
+              modal.showModal();
+            } catch (err) {
+              modal.setAttribute('open', '');
+            }
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+        updateSectionHighlight();
+      }
+
+      function moveModalToNextSection() {
+        if (sections.length < 2) return;
+        const currentSection = modal.closest('section.page-section');
+        const currentIndex = sections.indexOf(currentSection);
+        const nextIndex = (currentIndex + 1) % sections.length;
+        const targetSection = sections[nextIndex];
+
+        if (typeof targetSection.moveBefore === 'function') {
+          targetSection.moveBefore(modal, null);
+        } else {
+          const activeEl = document.activeElement;
+          const wasModal = typeof modal.matches === 'function' && modal.matches(':modal');
+          const wasOpen = modal.open;
+          targetSection.appendChild(modal);
+          if (wasModal && typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else if (wasOpen) {
+            modal.setAttribute('open', '');
+          }
+          if (activeEl && typeof activeEl.focus === 'function') {
+            activeEl.focus();
+          }
+        }
+
+        updateSectionHighlight();
+      }
+
+      moveBtn.addEventListener('click', moveModalToNextSection);
+
+      closeBtn.addEventListener('click', function () {
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+      });
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        openModal();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        statusText.textContent = 'Thank you for your feedback!';
+      });
+
+      openModal();
+    })();
+  </script>
