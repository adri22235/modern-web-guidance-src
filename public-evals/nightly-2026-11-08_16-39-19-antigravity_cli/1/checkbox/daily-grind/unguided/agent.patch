+    .card > p {
+      margin-bottom: 16px;
+      font-size: 0.95rem;
+    }
+
+    /* Drink Customization Checkboxes */
+    .customization-group {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 12px 14px 14px;
+      margin: 8px 0 12px;
+      background-color: var(--light);
+      text-align: left;
+    }
+
+    .customization-legend {
+      font-size: 0.8rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 0.8px;
+      color: var(--primary);
+      padding: 0 6px;
+    }
+
+    .customization-list {
+      display: flex;
+      flex-direction: column;
+      gap: 8px;
+      margin-top: 6px;
+    }
+
+    .checkbox-label {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      padding: 8px 10px;
+      border-radius: 6px;
+      border: 1px solid var(--secondary);
+      background-color: #ffffff;
+      color: var(--text);
+      font-size: 0.9rem;
+      cursor: pointer;
+      user-select: none;
+      transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
+    }
+
+    .checkbox-label:hover {
+      border-color: var(--accent);
+      background-color: #fffaf3;
+    }
+
+    .checkbox-label:active {
+      transform: scale(0.99);
+    }
+
+    /* Keep native checkbox accessible & interactive in tab order */
+    .checkbox-input {
+      appearance: none;
+      -webkit-appearance: none;
+      position: absolute;
+      opacity: 0;
+      width: 22px;
+      height: 22px;
+      left: 10px;
+      margin: 0;
+      cursor: pointer;
+      z-index: 2;
+    }
+
+    /* Custom visual checkbox box */
+    .checkbox-control {
+      position: relative;
+      width: 22px;
+      height: 22px;
+      flex-shrink: 0;
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      background-color: var(--light);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      transition: background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
+        box-shadow 0.25s ease;
+      animation: checkboxUncheck 0.25s ease forwards;
+    }
+
+    .checkbox-label:hover .checkbox-control {
+      border-color: var(--accent);
+    }
+
+    /* Checkmark SVG icon inside checkbox box */
+    .checkbox-icon {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 24;
+      stroke-dashoffset: 24;
+      opacity: 0;
+      transform: scale(0.5) rotate(-10deg);
+      transition: stroke-dashoffset 0.28s cubic-bezier(0.4, 0, 0.2, 1),
+        transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
+        opacity 0.2s ease;
+    }
+
+    /* Option decorative icon */
+    .option-icon {
+      width: 16px;
+      height: 16px;
+      flex-shrink: 0;
+      color: var(--primary);
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 2;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      transition: color 0.25s ease, transform 0.25s ease;
+    }
+
+    .checkbox-text {
+      flex: 1;
+      font-weight: 500;
+      line-height: 1.3;
+      transition: color 0.25s ease, font-weight 0.2s ease;
+    }
+
+    .checkbox-price {
+      font-size: 0.78rem;
+      font-weight: 600;
+      color: var(--primary);
+      background-color: var(--secondary);
+      padding: 2px 7px;
+      border-radius: 12px;
+      transition: background-color 0.25s ease, color 0.25s ease;
+    }
+
+    /* Checked state styles and animations */
+    .checkbox-input:checked + .checkbox-control {
+      background-color: var(--primary);
+      border-color: var(--primary);
+      animation: checkboxCheck 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+    }
+
+    .checkbox-input:checked + .checkbox-control .checkbox-icon {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1) rotate(0deg);
+    }
+
+    .checkbox-input:checked ~ .option-icon {
+      color: var(--accent);
+      transform: scale(1.12);
+    }
+
+    .checkbox-input:checked ~ .checkbox-text {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .checkbox-input:checked ~ .checkbox-price {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    .checkbox-label:has(.checkbox-input:checked) {
+      border-color: var(--primary);
+      background-color: #f8f3f0;
+      box-shadow: 0 1px 4px rgba(78, 52, 46, 0.1);
+    }
+
+    /* Accessible keyboard focus indicator */
+    .checkbox-input:focus + .checkbox-control,
+    .checkbox-input:focus-visible + .checkbox-control {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.35);
+    }
+
+    @keyframes checkboxCheck {
+      0% {
+        transform: scale(0.85);
+      }
+      55% {
+        transform: scale(1.14);
+      }
+      100% {
+        transform: scale(1);
+      }
+    }
+
+    @keyframes checkboxUncheck {
+      0% {
+        transform: scale(1.06);
+      }
+      50% {
+        transform: scale(0.92);
+      }
+      100% {
+        transform: scale(1);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .checkbox-label,
+      .checkbox-control,
+      .checkbox-icon,
+      .option-icon,
+      .checkbox-text,
+      .checkbox-price {
+        transition: none;
+        animation: none;
+      }
+    }
+
