+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const NEW_ORIGIN = 'https://app.dailygrind.com';
+      const DEFAULT_CONFIG = {
+        defaultDrink: 'maple-oat-latte',
+        milkPref: 'oat',
+        windowPref: 'standalone',
+        shortcutsPreserved: true,
+        migratedFrom: 'https://old.dailygrind.com/'
+      };
+
+      function loadUserConfig() {
+        const params = new URLSearchParams(window.location.search);
+        const migratedState = params.get('migrated_config');
+        if (migratedState) {
+          try {
+            const parsed = JSON.parse(atob(migratedState));
+            const merged = Object.assign({}, DEFAULT_CONFIG, parsed);
+            localStorage.setItem(STORAGE_KEY, JSON.stringify(merged));
+            const cleanUrl = new URL(window.location.href);
+            cleanUrl.searchParams.delete('migrated_config');
+            window.history.replaceState({}, document.title, cleanUrl.toString());
+            return merged;
+          } catch (err) {
+            console.warn('Failed to parse migrated config:', err);
+          }
+        }
+        try {
+          const saved = localStorage.getItem(STORAGE_KEY);
+          if (saved) {
+            return Object.assign({}, DEFAULT_CONFIG, JSON.parse(saved));
+          }
+        } catch (err) {
+          console.warn('Failed to read localStorage:', err);
+        }
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(DEFAULT_CONFIG));
+        return Object.assign({}, DEFAULT_CONFIG);
+      }
+
+      function saveUserConfig(config) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+        } catch (err) {
+          console.warn('Failed to save config:', err);
+        }
+      }
+
+      const config = loadUserConfig();
+      const drinkEl = document.getElementById('default-drink');
+      const milkEl = document.getElementById('milk-pref');
+      const windowEl = document.getElementById('window-pref');
+      const statusEl = document.getElementById('migration-status');
+      const migrateBtn = document.getElementById('migrate-origin-btn');
+
+      if (drinkEl) drinkEl.value = config.defaultDrink;
+      if (milkEl) milkEl.value = config.milkPref;
+      if (windowEl) windowEl.value = config.windowPref;
+
+      function handleChange() {
+        config.defaultDrink = drinkEl ? drinkEl.value : config.defaultDrink;
+        config.milkPref = milkEl ? milkEl.value : config.milkPref;
+        config.windowPref = windowEl ? windowEl.value : config.windowPref;
+        saveUserConfig(config);
+        if (statusEl) {
+          statusEl.textContent = 'Configuration saved locally and ready for origin migration.';
+        }
+      }
+
+      if (drinkEl) drinkEl.addEventListener('change', handleChange);
+      if (milkEl) milkEl.addEventListener('change', handleChange);
+      if (windowEl) windowEl.addEventListener('change', handleChange);
+
+      if (migrateBtn) {
+        migrateBtn.addEventListener('click', function () {
+          const encoded = btoa(JSON.stringify(config));
+          const targetUrl = NEW_ORIGIN + '/?migrated_config=' + encodeURIComponent(encoded);
+          if (statusEl) {
+            statusEl.textContent = 'Prepared migration transfer payload for ' + targetUrl;
+          }
+        });
+      }
+
+      window.addEventListener('message', function (event) {
+        if (event.data && event.data.type === 'PWA_ORIGIN_MIGRATION_CONFIG' && event.data.payload) {
+          const updated = Object.assign({}, config, event.data.payload);
+          saveUserConfig(updated);
+          if (drinkEl) drinkEl.value = updated.defaultDrink;
+          if (milkEl) milkEl.value = updated.milkPref;
+          if (windowEl) windowEl.value = updated.windowPref;
+        }
+      });
+
+      if ('serviceWorker' in navigator) {
+        window.addEventListener('load', function () {
+          navigator.serviceWorker.register('/sw.js').catch(function (err) {
+            console.warn('Service worker registration failed:', err);
+          });
+        });
+      }
+    })();
