+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const TRUSTED_URL = 'https://new.dailygrind.com';
+      const TRUSTED_SITE_DOMAIN = 'dailygrind.com';
+
+      function extractUrlString(candidate) {
+        if (typeof candidate === 'string') return candidate;
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return candidate.origin;
+        }
+        if (candidate === globalThis) {
+          return globalThis.location?.href ?? '';
+        }
+        return candidate?.href ?? '';
+      }
+
+      function extractOrigin(candidate) {
+        try {
+          return Origin.from(candidate);
+        } catch (err) {
+          if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+            return Origin.from(candidate.origin);
+          }
+          throw err;
+        }
+      }
+
+      function isSameSiteOrigin(candidate) {
+        try {
+          if ('Origin' in globalThis) {
+            const candidateOrigin = extractOrigin(candidate);
+            return (
+              candidateOrigin.isSameSite(Origin.from(TRUSTED_URL)) ||
+              candidateOrigin.isSameSite(Origin.from(globalThis))
+            );
+          }
+          const candidateUrl = new URL(extractUrlString(candidate));
+          const trustedUrl = new URL(TRUSTED_URL);
+          if (candidateUrl.origin === 'null') return false;
+          if (candidateUrl.origin === window.location.origin) return true;
+          return (
+            candidateUrl.protocol === trustedUrl.protocol &&
+            (candidateUrl.hostname === TRUSTED_SITE_DOMAIN ||
+              candidateUrl.hostname.endsWith(`.${TRUSTED_SITE_DOMAIN}`))
+          );
+        } catch {
+          return false;
+        }
+      }
+
+      const milkSelect = document.getElementById('pref-milk');
+      const roastSelect = document.getElementById('pref-roast');
+      const syncStatus = document.getElementById('sync-status');
+      const migrationBanner = document.getElementById('migration-banner');
+      const migrationLink = document.getElementById('migration-link');
+      const exportBtn = document.getElementById('export-config-btn');
+      const dismissBtn = document.getElementById('dismiss-migration-btn');
+
+      function loadConfig() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          return raw ? JSON.parse(raw) : { milk: 'oat', roast: 'medium' };
+        } catch {
+          return { milk: 'oat', roast: 'medium' };
+        }
+      }
+
+      function saveConfig(config, sourceLabel) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+          if (milkSelect && config.milk) milkSelect.value = config.milk;
+          if (roastSelect && config.roast) roastSelect.value = config.roast;
+          if (syncStatus && sourceLabel) {
+            syncStatus.textContent = sourceLabel;
+          }
+        } catch {
+          // Ignore storage quota errors
+        }
+      }
+
+      // 1. Check if configuration was passed in URL query during origin handover
+      const params = new URLSearchParams(window.location.search);
+      const migratedConfigParam = params.get('migrated_config');
+      if (migratedConfigParam) {
+        try {
+          const parsed = JSON.parse(atob(migratedConfigParam));
+          if (parsed && typeof parsed === 'object') {
+            saveConfig(parsed, 'Configuration restored from previous origin');
+            const cleanUrl = new URL(window.location.href);
+            cleanUrl.searchParams.delete('migrated_config');
+            window.history.replaceState({}, document.title, cleanUrl.toString());
+          }
+        } catch {
+          // Ignore malformed migration payload
+        }
+      } else {
+        const current = loadConfig();
+        if (milkSelect) milkSelect.value = current.milk || 'oat';
+        if (roastSelect) roastSelect.value = current.roast || 'medium';
+      }
+
+      function updatePreferences() {
+        const next = {
+          milk: milkSelect ? milkSelect.value : 'oat',
+          roast: roastSelect ? roastSelect.value : 'medium',
+          updatedAt: Date.now()
+        };
+        saveConfig(next, 'Saved locally');
+        updateMigrationLink(next);
+      }
+
+      function updateMigrationLink(config) {
+        if (!migrationLink) return;
+        try {
+          const targetUrl = new URL('https://new.dailygrind.com/index.html');
+          const encoded = btoa(JSON.stringify(config));
+          targetUrl.searchParams.set('migrated_config', encoded);
+          migrationLink.href = targetUrl.toString();
+        } catch {
+          // Fallback to static href
+        }
+      }
+
+      updateMigrationLink(loadConfig());
+
+      if (milkSelect) milkSelect.addEventListener('change', updatePreferences);
+      if (roastSelect) roastSelect.addEventListener('change', updatePreferences);
+
+      // 2. Cross-origin messaging listener to transfer LocalStorage user data between old & new same-site origins
+      window.addEventListener('message', (event) => {
+        if (!isSameSiteOrigin(event)) {
+          return;
+        }
+        const data = event.data;
+        if (!data || typeof data !== 'object') return;
+
+        if (data.type === 'REQUEST_USER_CONFIG' && event.source) {
+          event.source.postMessage(
+            { type: 'USER_CONFIG_PAYLOAD', config: loadConfig() },
+            event.origin
+          );
+        } else if (data.type === 'USER_CONFIG_PAYLOAD' && data.config) {
+          saveConfig(data.config, 'Synced from previous origin');
+        }
+      });
+
+      if (exportBtn) {
+        exportBtn.addEventListener('click', () => {
+          const config = loadConfig();
+          updateMigrationLink(config);
+          if (window.opener) {
+            window.opener.postMessage({ type: 'USER_CONFIG_PAYLOAD', config }, TRUSTED_URL);
+          }
+          if (syncStatus) {
+            syncStatus.textContent = 'Configuration ready for new origin handover';
+          }
+        });
+      }
+
+      if (dismissBtn && migrationBanner) {
+        dismissBtn.addEventListener('click', () => {
+          migrationBanner.hidden = true;
+        });
+      }
+    })();
+  </script>
 </body>
 
