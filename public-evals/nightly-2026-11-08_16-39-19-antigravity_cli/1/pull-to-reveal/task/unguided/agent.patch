+  <script>
+    (function () {
+      const searchBar = document.getElementById('top-search-bar');
+      const nav = document.getElementById('main-nav');
+
+      function scrollToNavInstant() {
+        if (!searchBar) return;
+        const navOffset = searchBar.offsetHeight;
+        if (navOffset > 0) {
+          window.scrollTo({ top: navOffset, left: 0, behavior: 'instant' });
+        }
+      }
+
+      if ('scrollRestoration' in history) {
+        history.scrollRestoration = 'manual';
+      }
+
+      // Immediately start scrolled out of view at the nav position
+      scrollToNavInstant();
+      window.addEventListener('DOMContentLoaded', scrollToNavInstant);
+      window.addEventListener('load', scrollToNavInstant);
+
+      // Snap search bar into view or back to nav when user scrolls/pulls in the top region
+      let scrollTimeout = null;
+      let lastScrollY = window.scrollY;
+
+      window.addEventListener('scroll', function () {
+        if (!searchBar) return;
+        const threshold = searchBar.offsetHeight;
+        const currentY = window.scrollY;
+        const scrollingUp = currentY < lastScrollY;
+        lastScrollY = currentY;
+
+        if (scrollTimeout) {
+          clearTimeout(scrollTimeout);
+        }
+
+        if (currentY > 0 && currentY < threshold) {
+          scrollTimeout = setTimeout(function () {
+            const y = window.scrollY;
+            if (y > 0 && y < threshold) {
+              // If the user pulled/scrolled up toward the top (or passed halfway), snap the search bar into view
+              if (scrollingUp || y < threshold * 0.6) {
+                window.scrollTo({ top: 0, behavior: 'smooth' });
+              } else {
+                window.scrollTo({ top: threshold, behavior: 'smooth' });
+              }
+            }
+          }, 80);
+        }
+      }, { passive: true });
+    })();
+  </script>
+
 </body>
 
