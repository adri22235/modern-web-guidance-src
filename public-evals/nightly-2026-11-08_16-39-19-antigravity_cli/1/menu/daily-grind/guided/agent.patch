+    }
+    if (menubarTriggers.length) {
+      setMenubarTabStop(menubarTriggers[0]);
+    }
+
+    // 4. Fallback for CSS Anchor Positioning when unsupported
+    const supportsAnchorArea = CSS.supports('position-area', 'block-end');
+    const supportsImplicitAnchor = 'source' in (window.ToggleEvent?.prototype || {});
+
+    function positionMenuFallback(menu, trigger) {
+      if (!menu || !trigger) return;
+      if (supportsAnchorArea) {
+        if (!supportsImplicitAnchor) {
+          const anchorName = `--anchor-${trigger.id}`;
+          trigger.style.anchorName = anchorName;
+          menu.style.positionAnchor = anchorName;
+        }
+        return;
+      }
+      const isSubmenu = Boolean(menu.parentElement?.closest('[popover]'));
+      const tRect = trigger.getBoundingClientRect();
+      const mRect = menu.getBoundingClientRect();
+      const vw = window.innerWidth;
+      const vh = window.innerHeight;
+
+      let left = isSubmenu ? tRect.right + 4 : tRect.left;
+      let top = isSubmenu ? tRect.top : tRect.bottom + 4;
+
+      if (isSubmenu) {
+        if (left + mRect.width > vw - 8) {
+          left = Math.max(8, tRect.left - mRect.width - 4);
+        }
+        if (top + mRect.height > vh - 8) {
+          top = Math.max(8, vh - mRect.height - 8);
+        }
+      } else {
+        if (top + mRect.height > vh - 8 && tRect.top - mRect.height - 4 >= 8) {
+          top = tRect.top - mRect.height - 4;
+        }
+        left = Math.min(Math.max(8, left), Math.max(8, vw - mRect.width - 8));
+      }
+
+      menu.style.left = `${Math.round(left)}px`;
+      menu.style.top = `${Math.round(top)}px`;
+    }
+
+    // 5. Safe triangle bridge for submenus
+    const canHover = matchMedia('(hover: hover)');
+
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      if (event.clientX >= rect.left && event.clientX <= rect.right) return; // --below: no side edge.
+      const style = submenu.style;
+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop(); // Reached an item.
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // 6. Invoker commands fallback & unified open/toggle handling
+    const hasNativeInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+      const isTopMenubarTrigger = menubarTriggers.includes(trigger);
+      const isSubmenuTrigger = Boolean(trigger.closest('[popover]'));
+
+      // Pointerdown: prevent focus from starting a preview mid-click
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      // Fallback when Invoker Commands are unsupported
+      if (!hasNativeInvokers) {
+        trigger.addEventListener('click', event => {
+          event.preventDefault();
+          const fromPointer = pointerTrigger === trigger || event.detail > 0;
+          if (isOpen(menu)) {
+            closeAndRestore(menu, { fromPointer });
+          } else {
+            if (!fromPointer) {
+              enterOnOpen.add(menu);
+            }
+            showMenu(menu, trigger);
+          }
+          pointerTrigger = null;
+        });
+      } else {
+        trigger.addEventListener('click', event => {
+          if (event.detail === 0 && pointerTrigger !== trigger && !previewMenus.has(menu)) {
+            enterOnOpen.add(menu);
+          }
+          pointerTrigger = null;
+        });
+      }
+
+      // Menubar trigger preview on focus & hover switch
+      if (isTopMenubarTrigger) {
+        trigger.addEventListener('focus', () => {
+          setMenubarTabStop(trigger);
+          if (windowBlurred || pointerTrigger === trigger) return;
+          if (!isOpen(menu)) {
+            previewMenus.add(menu);
+            showMenu(menu, trigger);
+          }
+        });
+
+        trigger.addEventListener('blur', event => {
+          if (previewMenus.has(menu) && !menu.contains(event.relatedTarget)) {
+            hideMenu(menu);
+          }
+        });
+
+        trigger.addEventListener('pointerenter', () => {
+          if (!canHover.matches) return;
+          const openSiblingTrigger = menubarTriggers.find(t => t !== trigger && isOpen(menuFor(t)));
+          if (openSiblingTrigger) {
+            hideMenu(menuFor(openSiblingTrigger));
+            trigger.focus({ focusVisible: false, preventScroll: true });
+          }
+        });
+      }
+
+      // Submenu trigger hover preview & safe triangle
+      if (isSubmenuTrigger) {
+        trigger.addEventListener('focus', () => {
+          clearTimeout(hoverSubmenuTimer);
+          hoverSubmenuTimer = setTimeout(() => {
+            if (document.activeElement === trigger && !isOpen(menu)) {
+              previewMenus.add(menu);
+              showMenu(menu, trigger);
+            }
+          }, 110);
+        });
+
+        trigger.addEventListener('pointerleave', event => {
+          startBridge(menu, event);
+        });
+      }
+
+      // Toggle listener: synchronize aria-expanded, position fallback, and manage focus entry
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
+
+        if (!open) {
+          previewMenus.delete(menu);
+          enterOnOpen.delete(menu);
+          enterLastOnOpen.delete(menu);
+          return;
+        }
+
+        positionMenuFallback(menu, trigger);
+
+        const items = ownItems(menu);
+        if (enterLastOnOpen.has(menu)) {
+          enterLastOnOpen.delete(menu);
+          previewMenus.delete(menu);
+          items.at(-1)?.focus({ preventScroll: true });
+        } else if (enterOnOpen.has(menu)) {
+          enterOnOpen.delete(menu);
+          previewMenus.delete(menu);
+          items[0]?.focus({ preventScroll: true });
+        } else if (pointerTrigger === trigger) {
+          trigger.focus({ focusVisible: false, preventScroll: true });
+        }
+      });
+    });
+
+    // 7. Hover follows focus inside menus + closing sibling submenus
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      group.addEventListener('pointermove', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        if (document.activeElement !== item) {
+          item.focus({ focusVisible: false, preventScroll: true });
+        }
+        // Close any open sibling submenu when hovering a non-trigger sibling item
+        const itemSubmenu = menuFor(item);
+        group.querySelectorAll(':scope > [popover]').forEach(sub => {
+          if (sub !== itemSubmenu && isOpen(sub)) {
+            hideMenu(sub);
+          }
+        });
+      });
+    });
+
+    // 8. Keyboard navigation for Menubar, Standalone Triggers, and Nested Submenus
+    document.addEventListener('keydown', event => {
+      const active = document.activeElement;
+      if (!active) return;
+
+      // Case A: Focus is on a trigger button
+      if (active.matches('button[commandfor]')) {
+        const menu = menuFor(active);
+        const inMenubar = menubarTriggers.includes(active);
+        const inSubmenu = Boolean(active.closest('[popover]'));
+
+        if (!inSubmenu) {
+          if (inMenubar && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) {
+            event.preventDefault();
+            const dir = event.key === 'ArrowRight' ? 1 : -1;
+            const idx = menubarTriggers.indexOf(active);
+            const nextTrigger = menubarTriggers[(idx + dir + menubarTriggers.length) % menubarTriggers.length];
+            hideMenu(menu);
+            setMenubarTabStop(nextTrigger);
+            nextTrigger.focus();
+            return;
+          }
+
+          if (event.key === 'ArrowDown' || event.key === 'Home') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              previewMenus.delete(menu);
+              ownItems(menu)[0]?.focus();
+            } else {
+              enterOnOpen.add(menu);
+              active.click();
+            }
+            return;
+          }
+
+          if (event.key === 'ArrowUp' || event.key === 'End') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              previewMenus.delete(menu);
+              ownItems(menu).at(-1)?.focus();
+            } else {
+              enterLastOnOpen.add(menu);
+              active.click();
+            }
+            return;
+          }
+
+          if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            event.stopPropagation();
+            closeAndRestore(menu);
+            return;
+          }
+        }
+      }
+
+      // Case B: Focus is inside an open popover menu
+      const currentMenu = active.closest('[popover]');
+      if (!currentMenu) return;
+
+      const parentMenu = currentMenu.parentElement?.closest('[popover]');
+      const rootMenu = rootMenuOf(currentMenu);
+      const rootTrigger = triggerFor(rootMenu);
+      const isMenubarMenu = menubarTriggers.includes(rootTrigger);
+
+      // Home / End inside a menu
+      if (event.key === 'Home' || event.key === 'End') {
+        const items = ownItems(currentMenu);
+        if (items.length) {
+          event.preventDefault();
+          (event.key === 'Home' ? items[0] : items.at(-1)).focus();
+        }
+        return;
+      }
+
+      // Escape: close only the innermost open menu level and restore focus to its trigger
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        event.stopPropagation();
+        closeAndRestore(currentMenu);
+        return;
+      }
+
+      // ArrowRight inside a menu
+      if (event.key === 'ArrowRight') {
+        const submenu = menuFor(active);
+        if (submenu) {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isOpen(submenu)) {
+            previewMenus.delete(submenu);
+            ownItems(submenu)[0]?.focus();
+          } else {
+            enterOnOpen.add(submenu);
+            active.click();
+          }
+          return;
+        }
+        // On an item without a child submenu inside a menubar hierarchy: preview the next top-level menu
+        if (isMenubarMenu) {
+          event.preventDefault();
+          event.stopPropagation();
+          const idx = menubarTriggers.indexOf(rootTrigger);
+          const nextTrigger = menubarTriggers[(idx + 1) % menubarTriggers.length];
+          hideMenu(rootMenu);
+          setMenubarTabStop(nextTrigger);
+          nextTrigger.focus();
+        }
+        return;
+      }
+
+      // ArrowLeft inside a menu
+      if (event.key === 'ArrowLeft') {
+        event.preventDefault();
+        event.stopPropagation();
+        if (parentMenu) {
+          // Close only this submenu and return focus to its submenu trigger
+          closeAndRestore(currentMenu);
+        } else if (isMenubarMenu) {
+          const idx = menubarTriggers.indexOf(rootTrigger);
+          const prevTrigger = menubarTriggers[(idx - 1 + menubarTriggers.length) % menubarTriggers.length];
+          hideMenu(rootMenu);
+          setMenubarTabStop(prevTrigger);
+          prevTrigger.focus();
+        }
+        return;
+      }
+
+      // Tab leaves the entire menu system cleanly
+      if (event.key === 'Tab') {
+        document.querySelectorAll('[popover]').forEach(p => {
+          if (isOpen(p)) hideMenu(p);
+        });
+      }
+    });
+
+    // 9. Outside focus closes open menus
+    document.addEventListener('focusin', event => {
+      document.querySelectorAll('[popover]').forEach(p => {
+        if (!isOpen(p)) return;
+        const root = rootMenuOf(p);
+        const rTrigger = triggerFor(root);
+        if (!root.contains(event.target) && event.target !== rTrigger) {
+          hideMenu(p);
+        }
+      });
+    });
+
+    // 10. Command activation, checkable items (menuitemcheckbox / menuitemradio), & summary updates
+    function updateCardSummary(cardMenu) {
+      if (!cardMenu) return;
+      const key = cardMenu.dataset.cardMenu;
+      const summaryEl = document.getElementById(`summary-${key}`);
+      if (!summaryEl) return;
+
+      const selectedParts = [];
+      cardMenu.querySelectorAll('[role="group"][data-summary-slot]').forEach(group => {
+        const checked = group.querySelector('[role="menuitemradio"][aria-checked="true"]');
+        if (checked?.dataset.value) {
+          selectedParts.push(checked.dataset.value);
+        }
+      });
+      cardMenu.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]').forEach(chk => {
+        if (chk.dataset.value) {
+          selectedParts.push(chk.dataset.value);
+        }
+      });
+
+      if (selectedParts.length) {
+        summaryEl.textContent = selectedParts.join(' • ');
+      }
+    }
+
+    function announceStatus(message) {
+      if (!statusBanner) return;
+      statusBanner.innerHTML = `<span><strong>Updated:</strong> ${message}</span>`;
+    }
+
+    // Track Space key activations so menuitemcheckbox stays open on Space per APG
+    let lastActivatedKey = null;
+    document.addEventListener('keydown', event => {
+      if (event.key === ' ' || event.key === 'Enter') {
+        lastActivatedKey = event.key;
+      }
+    }, true);
+
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      group.addEventListener('click', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        // Submenu triggers are handled by invoker toggle-popover
+        if (item.hasAttribute('commandfor')) return;
+
+        const fromPointer = event.detail > 0;
+        const activatedBySpace = !fromPointer && lastActivatedKey === ' ';
+        lastActivatedKey = null;
+
+        const rootMenu = rootMenuOf(item);
+        const cardMenu = rootMenu?.hasAttribute('data-card-menu') ? rootMenu : null;
+        const drinkName = cardMenu?.closest('[data-drink]')?.dataset.drink || '';
+        const role = item.getAttribute('role');
+
+        if (role === 'menuitemcheckbox') {
+          const nextChecked = item.getAttribute('aria-checked') !== 'true';
+          item.setAttribute('aria-checked', String(nextChecked));
+          updateCardSummary(cardMenu);
+          const label = item.dataset.action || `${item.textContent.trim()} (${nextChecked ? 'Enabled' : 'Disabled'})`;
+          announceStatus(drinkName ? `${drinkName}: ${label}` : label);
+
+          // APG: Space on a menuitemcheckbox toggles and stays open; Enter or pointer closes after ~300ms
+          if (!activatedBySpace) {
+            setTimeout(() => {
+              closeAndRestore(rootMenu, { fromPointer });
+            }, 300);
+          }
+          return;
+        }
+
+        if (role === 'menuitemradio') {
+          const radioGroup = item.closest('[role="group"]');
+          if (radioGroup) {
+            radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(r => {
+              r.setAttribute('aria-checked', String(r === item));
+            });
+          } else {
+            item.setAttribute('aria-checked', 'true');
+          }
+          updateCardSummary(cardMenu);
+          const label = item.dataset.action || `Selected ${item.textContent.trim()}`;
+          announceStatus(drinkName ? `${drinkName}: ${label}` : label);
+
+          setTimeout(() => {
+            closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+          return;
+        }
+
+        // Standard command button or link
+        if (item.tagName === 'BUTTON') {
+          const actionText = item.dataset.action || item.textContent.trim();
+          const summaryEl = cardMenu ? document.getElementById(`summary-${cardMenu.dataset.cardMenu}`) : null;
+          const details = summaryEl ? ` (${summaryEl.textContent})` : '';
+          announceStatus(`${actionText}${details}`);
+          closeAndRestore(rootMenu, { fromPointer });
+        } else if (item.tagName === 'A') {
+          // Allow links to work natively or announce selection before closing
+          closeAndRestore(rootMenu, { fromPointer });
+        }
+      });
+    });
+  </script>
+
 </body>
 
