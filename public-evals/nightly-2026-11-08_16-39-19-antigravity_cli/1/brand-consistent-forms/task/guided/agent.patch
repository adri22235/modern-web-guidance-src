+  <script>
+    (() => {
+      const form = document.getElementById('coffee-subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-level-output');
+      const emailCheckbox = document.getElementById('email-updates');
+      const progressBar = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-text');
+      const statusRegion = document.getElementById('subscription-status');
+
+      const roastLabels = {
+        1: 'Light Roast (1/5)',
+        2: 'Medium-Light Roast (2/5)',
+        3: 'Medium Roast (3/5)',
+        4: 'Medium-Dark Roast (4/5)',
+        5: 'Dark Roast (5/5)'
+      };
+
+      function updateRoastSlider() {
+        const min = Number(roastSlider.min) || 1;
+        const max = Number(roastSlider.max) || 5;
+        const val = Number(roastSlider.value) || 3;
+        const pct = ((val - min) / (max - min)) * 100;
+        roastSlider.style.setProperty('--progress', `${pct}%`);
+        if (roastOutput) {
+          roastOutput.textContent = roastLabels[val] || `Level ${val}/5`;
+        }
+      }
+
+      function updateSubscriptionProgress() {
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        const selectedFrequency = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFrequency) completedSteps += 1;
+        if (roastSlider && roastSlider.value !== '') completedSteps += 1;
+        if (emailCheckbox && emailCheckbox.checked) completedSteps += 1;
+
+        const pct = Math.round((completedSteps / totalSteps) * 100);
+        progressBar.value = pct;
+        progressBar.textContent = `${pct}%`;
+        if (progressText) {
+          progressText.textContent = `${pct}%`;
+        }
+      }
+
+      if (roastSlider) {
+        roastSlider.addEventListener('input', () => {
+          updateRoastSlider();
+          updateSubscriptionProgress();
+        });
+      }
+
+      form.addEventListener('change', updateSubscriptionProgress);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const frequency = form.querySelector('input[name="delivery_frequency"]:checked')?.value || 'biweekly';
+        const roast = roastLabels[roastSlider.value] || roastSlider.value;
+        const emails = emailCheckbox.checked ? 'with email updates enabled' : 'without email updates';
+        statusRegion.textContent = `Subscription saved: ${frequency} delivery of ${roast}, ${emails}.`;
+      });
+
+      updateRoastSlider();
+      updateSubscriptionProgress();
+    })();
+  </script>
 </body>
 
