+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-value-text');
+      const roastInput = document.getElementById('roast-preference');
+      const roastLabel = document.getElementById('roast-level-label');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMessage = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: 'Light (1 / 5)',
+        2: 'Medium-Light (2 / 5)',
+        3: 'Medium (3 / 5)',
+        4: 'Medium-Dark (4 / 5)',
+        5: 'Dark (5 / 5)'
+      };
+
+      let isSubmitted = false;
+
+      function updateSubscriptionProgress() {
+        let completedSteps = 0;
+        const totalSteps = 4;
+
+        const selectedFrequency = form.querySelector('input[name="delivery-frequency"]:checked');
+        if (selectedFrequency) {
+          completedSteps += 1;
+        }
+
+        if (roastInput && roastInput.value) {
+          completedSteps += 1;
+          if (roastLabel) {
+            roastLabel.textContent = roastNames[roastInput.value] || ('Level ' + roastInput.value + ' / 5');
+          }
+        }
+
+        if (emailCheckbox && emailCheckbox.checked) {
+          completedSteps += 1;
+        }
+
+        if (isSubmitted) {
+          completedSteps += 1;
+        }
+
+        const percentage = Math.round((completedSteps / totalSteps) * 100);
+        if (progress) {
+          progress.value = percentage;
+          progress.textContent = percentage + '%';
+        }
+        if (progressText) {
+          progressText.textContent = percentage + '%';
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', function () {
+          isSubmitted = false;
+          updateSubscriptionProgress();
+        });
+        form.addEventListener('change', function () {
+          isSubmitted = false;
+          updateSubscriptionProgress();
+        });
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          isSubmitted = true;
+          updateSubscriptionProgress();
+          const selectedFrequency = form.querySelector('input[name="delivery-frequency"]:checked');
+          const freqText = selectedFrequency ? selectedFrequency.value : 'custom';
+          if (statusMessage) {
+            statusMessage.textContent = 'Your ' + freqText + ' coffee subscription preferences have been saved!';
+          }
+        });
+        updateSubscriptionProgress();
+      }
+    })();
+  </script>
