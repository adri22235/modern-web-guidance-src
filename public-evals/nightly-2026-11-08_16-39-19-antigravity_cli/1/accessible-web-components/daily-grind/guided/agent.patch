+
+        :host(:state(favorited)) .switch-track {
+          background: var(--_heart-color);
+        }
+
+        :host(:state(favorited)) .switch-thumb {
+          transform: translateX(11px);
+        }
+      }
+    `);
+
+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['favorited', 'label', 'item-id', 'disabled'];
+
+      #internals;
+      #initialized = false;
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [favoriteSheet];
+        this.shadowRoot.append(favoriteTemplate.content.cloneNode(true));
+
+        this.#internals = this.attachInternals?.() ?? null;
+        if (this.#internals && 'role' in this.#internals) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        } else {
+          this.setAttribute('role', 'switch');
+          this.setAttribute('aria-checked', 'false');
+        }
+
+        this.addEventListener('click', () => {
+          if (!this.disabled) this.toggle();
+        });
+        this.addEventListener('keydown', (e) => {
+          if (this.disabled) return;
+          if (e.key === ' ' || e.key === 'Enter') {
+            e.preventDefault();
+            this.toggle();
+          }
+        });
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex')) {
+          this.tabIndex = this.disabled ? -1 : 0;
+        }
+        if (!this.#initialized) {
+          this.#initialized = true;
+          this.#restorePersistedState();
+        }
+        this.#syncState();
+      }
+
+      connectedMoveCallback() {
+        this.#syncState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'disabled') {
+          this.tabIndex = this.disabled ? -1 : 0;
+        }
+        this.#syncState();
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(on) {
+        this.toggleAttribute('favorited', Boolean(on));
+      }
+
+      get checked() {
+        return this.favorited;
+      }
+
+      set checked(on) {
+        this.favorited = on;
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+
+      set label(val) {
+        val ? this.setAttribute('label', val) : this.removeAttribute('label');
+      }
+
+      get itemId() {
+        return this.getAttribute('item-id') ?? '';
+      }
+
+      set itemId(val) {
+        val ? this.setAttribute('item-id', val) : this.removeAttribute('item-id');
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      toggle(force) {
+        const next = typeof force === 'boolean' ? force : !this.favorited;
+        this.favorited = next;
+        this.#persistState();
+        this.dispatchEvent(
+          new CustomEvent('change', {
+            bubbles: true,
+            composed: true,
+            detail: { favorited: this.favorited, itemId: this.itemId }
+          })
+        );
+        return this.favorited;
+      }
+
+      #storageKey() {
+        return this.itemId ? `daily-grind:favorite:${this.itemId}` : '';
+      }
+
+      #restorePersistedState() {
+        const key = this.#storageKey();
+        if (!key || this.hasAttribute('favorited')) return;
+        try {
+          if (localStorage.getItem(key) === 'true') {
+            this.favorited = true;
+          }
+        } catch {
+          // Ignore storage restrictions
+        }
+      }
+
+      #persistState() {
+        const key = this.#storageKey();
+        if (!key) return;
+        try {
+          if (this.favorited) {
+            localStorage.setItem(key, 'true');
+          } else {
+            localStorage.removeItem(key);
+          }
+        } catch {
+          // Ignore storage restrictions
+        }
+      }
+
+      #syncState() {
+        const isFav = this.favorited;
+        const labelText = this.label;
+
+        if (this.#internals && 'ariaChecked' in this.#internals) {
+          this.#internals.ariaChecked = String(isFav);
+          this.#internals.ariaDisabled = String(this.disabled);
+          if (labelText) {
+            this.#internals.ariaLabel = labelText;
+          }
+        } else {
+          this.setAttribute('aria-checked', String(isFav));
+          this.setAttribute('aria-disabled', String(this.disabled));
+          if (labelText) {
+            this.setAttribute('aria-label', labelText);
+          }
+        }
+
+        if (this.#internals?.states) {
+          if (isFav) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+      }
+    }
+
+    customElements.define('favorite-toggle', FavoriteToggle);
+  </script>
