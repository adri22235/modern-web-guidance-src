+  <script type="module">
+    const favoriteTemplate = document.createElement('template');
+    favoriteTemplate.innerHTML = `
+      <span class="pill" part="control">
+        <svg class="heart" part="icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+        </svg>
+        <span class="label" part="label"><slot>Favorite</slot></span>
+        <span class="switch-track" part="track" aria-hidden="true">
+          <span class="switch-thumb" part="thumb"></span>
+        </span>
+      </span>
+    `;
+
+    const favoriteSheet = new CSSStyleSheet();
+    favoriteSheet.replaceSync(`
+      @layer base, state;
+
+      @layer base {
+        :host {
+          --_bg: var(--favorite-bg, #fff8f0);
+          --_fg: var(--favorite-fg, #4e342e);
+          --_border: var(--favorite-border, #d7ccc8);
+          --_active-bg: var(--favorite-active-bg, #fff3e0);
+          --_active-fg: var(--favorite-active-fg, #b71c1c);
+          --_active-border: var(--favorite-active-border, #ffab40);
+          --_heart-color: var(--favorite-heart-color, #d32f2f);
+          --_focus-color: var(--favorite-focus-color, #ffab40);
+
+          display: inline-block;
+          cursor: pointer;
+          user-select: none;
+          border-radius: 999px;
+          font: inherit;
+          color: var(--_fg);
+        }
+
+        :host([disabled]) {
+          opacity: 0.5;
+          pointer-events: none;
+          cursor: not-allowed;
+        }
+
+        :host(:focus-visible) {
+          outline: 3px solid var(--_focus-color);
+          outline-offset: 3px;
+        }
+
+        .pill {
+          display: inline-flex;
+          align-items: center;
+          gap: 6px;
+          padding: 4px 10px;
+          border-radius: 999px;
+          background: var(--_bg);
+          border: 1px solid var(--_border);
+          font-size: 0.8rem;
+          font-weight: 600;
+          line-height: 1.2;
+          transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
+        }
+
+        :host(:hover) .pill {
+          border-color: var(--_active-border);
+        }
+
+        :host(:active) .pill {
+          transform: scale(0.97);
+        }
+
+        .heart {
+          width: 15px;
+          height: 15px;
+          fill: transparent;
+          stroke: currentColor;
+          stroke-width: 2;
+          transition: fill 0.2s ease, stroke 0.2s ease, transform 0.2s ease;
+          flex-shrink: 0;
+        }
+
+        .switch-track {
+          position: relative;
+          width: 26px;
+          height: 15px;
+          border-radius: 999px;
+          background: var(--_border);
+          transition: background-color 0.2s ease;
+          flex-shrink: 0;
+        }
+
+        .switch-thumb {
+          position: absolute;
+          top: 2px;
+          left: 2px;
+          width: 11px;
+          height: 11px;
+          border-radius: 50%;
+          background: #ffffff;
+          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+          transition: transform 0.2s ease;
+        }
+      }
+
+      @layer state {
+        :host(:state(favorited)) {
+          color: var(--_active-fg);
+        }
+
+        :host(:state(favorited)) .pill {
+          background: var(--_active-bg);
+          border-color: var(--_active-border);
