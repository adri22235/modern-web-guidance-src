   </footer>
 
+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'active', 'drink'];
+      }
+
+      constructor() {
+        super();
+        this._favorited = false;
+        this._syncing = false;
+        this.attachShadow({ mode: 'open' });
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+            }
+            button {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+              background: #fafafa;
+              color: #4e342e;
+              border: 1.5px solid #d7ccc8;
+              border-radius: 999px;
+              padding: 5px 12px;
+              font-family: inherit;
+              font-size: 0.82rem;
+              font-weight: 600;
+              cursor: pointer;
+              transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
+              user-select: none;
+            }
+            button:hover {
+              border-color: #ffab40;
+              background: #fff8e1;
+            }
+            button:focus-visible {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+            }
+            button.favorited {
+              background: #fff3e0;
+              color: #bf360c;
+              border-color: #ffab40;
+            }
+            .icon {
+              font-size: 1rem;
+              line-height: 1;
+              color: #8d6e63;
+              transition: color 0.2s ease, transform 0.2s ease;
+            }
+            button.favorited .icon {
+              color: #e53935;
+              transform: scale(1.15);
+            }
+          </style>
+          <button type="button" class="fav-btn" aria-pressed="false" aria-label="Mark as favorite">
+            <span class="icon" aria-hidden="true">&#9825;</span>
+            <span class="label">Favorite</span>
+          </button>
+        `;
+
+        this._button = this.shadowRoot.querySelector('button');
+        this._icon = this.shadowRoot.querySelector('.icon');
+        this._label = this.shadowRoot.querySelector('.label');
+
+        this.addEventListener('click', () => {
+          this.toggle();
+        });
+      }
+
+      connectedCallback() {
+        const initialFav = this.hasAttribute('favorited') || this.hasAttribute('active');
+        this._favorited = initialFav;
+        this._render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (this._syncing) return;
+        if (name === 'favorited' || name === 'active') {
+          this._favorited = newValue !== null && newValue !== 'false';
+          this._render();
+        } else if (name === 'drink') {
+          this._render();
+        }
+      }
+
+      get favorited() {
+        return this._favorited;
+      }
+
+      set favorited(value) {
+        const boolVal = Boolean(value);
+        if (this._favorited !== boolVal) {
+          this._favorited = boolVal;
+          this._render();
+        }
+      }
+
+      get active() {
+        return this._favorited;
+      }
+
+      set active(value) {
+        this.favorited = value;
+      }
+
+      get checked() {
+        return this._favorited;
+      }
+
+      set checked(value) {
+        this.favorited = value;
+      }
+
+      get drink() {
+        return this.getAttribute('drink') || '';
+      }
+
+      set drink(value) {
+        if (value) {
+          this.setAttribute('drink', value);
+        } else {
+          this.removeAttribute('drink');
+        }
+      }
+
+      toggle(force) {
+        this.favorited = typeof force === 'boolean' ? force : !this._favorited;
+        const detail = { favorited: this._favorited, active: this._favorited, drink: this.drink };
+        this.dispatchEvent(new CustomEvent('favorite-toggle', { detail, bubbles: true, composed: true }));
+        this.dispatchEvent(new CustomEvent('change', { detail, bubbles: true, composed: true }));
+        return this._favorited;
+      }
+
+      _render() {
+        this._syncing = true;
+        const isFav = this._favorited;
+        const drinkName = this.drink;
+
+        if (isFav) {
+          this.setAttribute('favorited', '');
+          this.setAttribute('active', '');
+        } else {
+          this.removeAttribute('favorited');
+          this.removeAttribute('active');
+        }
+
+        this.setAttribute('aria-pressed', String(isFav));
+        this.classList.toggle('favorited', isFav);
+        this.classList.toggle('active', isFav);
+
+        if (this._button) {
+          this._button.classList.toggle('favorited', isFav);
+          this._button.classList.toggle('active', isFav);
+          this._button.setAttribute('aria-pressed', String(isFav));
+          const actionText = isFav ? 'Remove from favorites' : 'Mark as favorite';
+          this._button.setAttribute('aria-label', drinkName ? `${actionText}: ${drinkName}` : actionText);
+          this._button.setAttribute('title', drinkName ? `${actionText}: ${drinkName}` : actionText);
+        }
+
+        if (this._icon) {
+          this._icon.innerHTML = isFav ? '&#9829;' : '&#9825;';
+        }
+
+        if (this._label) {
+          this._label.textContent = isFav ? 'Favorited' : 'Favorite';
+        }
+        this._syncing = false;
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
+
 </body>
 
