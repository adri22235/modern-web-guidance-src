+  <script>
+    (function () {
+      const lazyMediaElements = document.querySelectorAll('.lazy-media');
+
+      function loadDeferredMedia(element) {
+        if (!element || element.dataset.loaded === 'true') {
+          return;
+        }
+        element.dataset.loaded = 'true';
+
+        if (element.tagName === 'IMG') {
+          if (element.dataset.src) {
+            element.src = element.dataset.src;
+          }
+          return;
+        }
+
+        if (element.dataset.poster) {
+          element.poster = element.dataset.poster;
+        }
+
+        const sources = element.querySelectorAll('source[data-src]');
+        sources.forEach(function (source) {
+          source.src = source.dataset.src;
+        });
+
+        if (element.dataset.src) {
+          element.src = element.dataset.src;
+        }
+
+        element.preload = 'metadata';
+        if (typeof element.load === 'function') {
+          element.load();
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const mediaObserver = new IntersectionObserver(
+          function (entries, observer) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                loadDeferredMedia(entry.target);
+                observer.unobserve(entry.target);
+              }
+            });
+          },
+          {
+            rootMargin: '200px 0px',
+            threshold: 0.01
+          }
+        );
+
+        lazyMediaElements.forEach(function (element) {
+          mediaObserver.observe(element);
+        });
+      } else {
+        lazyMediaElements.forEach(loadDeferredMedia);
+      }
+
+      lazyMediaElements.forEach(function (element) {
+        ['play', 'focus', 'pointerdown'].forEach(function (eventName) {
+          element.addEventListener(
+            eventName,
+            function () {
+              loadDeferredMedia(element);
+            },
+            { once: true }
+          );
+        });
+      });
+    })();
+  </script>
