+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-scroll-container');
+      const topHint = document.getElementById('scroll-hint-top');
+      const bottomHint = document.getElementById('scroll-hint-bottom');
+
+      function setHintVisibility(hintEl, isVisible) {
+        if (!hintEl) return;
+        hintEl.classList.toggle('visible', isVisible);
+        hintEl.classList.toggle('hidden', !isVisible);
+        hintEl.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
+      }
+
+      function updateScrollHints() {
+        if (!scrollContainer) return;
+        const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
+        const canScrollUp = scrollTop > 0;
+        const canScrollDown = Math.ceil(scrollTop + clientHeight) < scrollHeight - 1;
+
+        setHintVisibility(topHint, canScrollUp);
+        setHintVisibility(bottomHint, canScrollDown);
+      }
+
+      if (scrollContainer) {
+        scrollContainer.addEventListener('scroll', updateScrollHints, { passive: true });
+        window.addEventListener('resize', updateScrollHints);
+        window.addEventListener('load', updateScrollHints);
+        if (typeof ResizeObserver !== 'undefined') {
+          new ResizeObserver(updateScrollHints).observe(scrollContainer);
+        }
+        updateScrollHints();
+      }
+
+      document.querySelectorAll('.helpful-btn').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const voted = btn.getAttribute('data-voted') === 'true';
+          let count = parseInt(btn.getAttribute('data-helpful-count') || '0', 10);
+          if (!voted) {
+            count += 1;
+            btn.setAttribute('data-voted', 'true');
+            btn.setAttribute('data-helpful-count', String(count));
+            btn.textContent = 'Helpful (' + count + ') ✓';
+          }
+        });
+      });
+    })();
+  </script>
