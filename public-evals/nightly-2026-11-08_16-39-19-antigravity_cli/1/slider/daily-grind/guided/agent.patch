+  <script>
+    const slider = document.querySelector('#brew-strength');
+    const output = document.querySelector('#brew-strength-output');
+    const strengthLabels = {
+      1: 'Light Roast',
+      2: 'Mild Roast',
+      3: 'Medium Roast',
+      4: 'Bold Roast',
+      5: 'Extra Strong Espresso'
+    };
+
+    function syncSliderValue() {
+      const val = Number(slider.value);
+      const label = strengthLabels[val] || 'Medium Roast';
+      slider.style.setProperty('--attr-min', slider.min || 1);
+      slider.style.setProperty('--attr-max', slider.max || 5);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', `${val} out of ${slider.max || 5}, ${label}`);
+      if (output) {
+        output.textContent = `${val} / ${slider.max || 5} — ${label}`;
+      }
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
