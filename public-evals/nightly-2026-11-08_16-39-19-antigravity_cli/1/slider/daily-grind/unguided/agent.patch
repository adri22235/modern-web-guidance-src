+  <script>
+    (function () {
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-output');
+      const ratioLabel = document.getElementById('brew-ratio-label');
+      const tastingNotes = document.getElementById('brew-tasting-notes');
+      const ratioMeta = document.getElementById('brew-ratio-meta');
+      const scaleItems = document.querySelectorAll('.brew-scale-item');
+
+      const profiles = {
+        1: {
+          name: 'Mild',
+          profileTitle: 'Mild & Delicate Profile',
+          notes: 'Crisp acidity with floral jasmine and bright citrus undertones.',
+          ratio: '1:18'
+        },
+        2: {
+          name: 'Light-Medium',
+          profileTitle: 'Light-Medium Profile',
+          notes: 'Mellow sweetness with honeyed stone fruit and soft cocoa hints.',
+          ratio: '1:17'
+        },
+        3: {
+          name: 'Medium',
+          profileTitle: 'Medium Roast Profile',
+          notes: 'Balanced body with smooth caramel and toasted nut notes.',
+          ratio: '1:16'
+        },
+        4: {
+          name: 'Bold',
+          profileTitle: 'Bold & Full-Bodied Profile',
+          notes: 'Rich dark chocolate, roasted almond, and a velvety finish.',
+          ratio: '1:15'
+        },
+        5: {
+          name: 'Extra Dark',
+          profileTitle: 'Extra Dark Espresso Profile',
+          notes: 'Intense, smokey body with bittersweet cacao and molasses depth.',
+          ratio: '1:14'
+        }
+      };
+
+      function updateBrewStrength() {
+        const min = parseFloat(slider.min) || 1;
+        const max = parseFloat(slider.max) || 5;
+        const val = parseFloat(slider.value) || 3;
+        const percent = Math.max(0, Math.min(100, ((val - min) / (max - min)) * 100));
+
+        slider.style.setProperty('--fill-percent', percent + '%');
+
+        const roundedVal = Math.round(val);
+        const profile = profiles[roundedVal] || {
+          name: 'Level ' + roundedVal,
+          profileTitle: 'Custom Brew Profile',
+          notes: 'Custom extraction intensity tailored to your preference.',
+          ratio: '1:16'
+        };
+
+        output.textContent = profile.name + ' (' + val + '/' + max + ')';
+        ratioLabel.textContent = Math.round(percent) + '% Intensity';
+        tastingNotes.innerHTML = '<strong>' + profile.profileTitle + ':</strong> ' + profile.notes;
+        ratioMeta.textContent = 'Coffee-to-Water Ratio: ' + profile.ratio;
+
+        slider.setAttribute('aria-valuenow', String(val));
+        slider.setAttribute(
+          'aria-valuetext',
+          'Level ' + val + ' of ' + max + ': ' + profile.name + ' — ' + profile.notes
+        );
+
+        scaleItems.forEach(function (item) {
+          const itemVal = parseInt(item.getAttribute('data-value'), 10);
+          item.classList.toggle('active', itemVal === roundedVal);
+        });
+      }
+
+      slider.addEventListener('input', updateBrewStrength);
+      slider.addEventListener('change', updateBrewStrength);
+
+      scaleItems.forEach(function (item) {
+        item.addEventListener('click', function () {
+          const targetVal = item.getAttribute('data-value');
+          if (targetVal) {
+            slider.value = targetVal;
+            slider.dispatchEvent(new Event('input', { bubbles: true }));
+            slider.dispatchEvent(new Event('change', { bubbles: true }));
+            slider.focus();
+          }
+        });
+      });
+
+      updateBrewStrength();
+    })();
+  </script>
+
