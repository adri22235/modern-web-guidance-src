+  <script>
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+
+      // Skipped if showElement() cancelled the close mid-animation.
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      await hideElement(el);
+      el.remove();
+    }
+
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const extraPromos = [
+      {
+        title: 'Happy Hour Cold Brew',
+        description: 'Get $2 off any signature nitro or classic cold brew between 3 PM and 6 PM daily.',
+        linkText: 'Order Cold Brew',
+        href: '/menu/cold-brew',
+      },
+      {
+        title: 'Double Points Weekend',
+        description: 'Earn 2x Grind Rewards stars on all espresso beverages and seasonal bakery items.',
+        linkText: 'View Rewards',
+        href: '/rewards',
+      },
+      {
+        title: 'Bring Your Own Tumbler',
+        description: 'Save $1.00 on any handcrafted drink when you bring in a clean reusable cup.',
+        linkText: 'Find a Cafe',
+        href: '/locations',
+      },
+      {
+        title: 'Roaster’s Flight Tasting',
+        description: 'Sample three single-origin pour-overs paired with house-made dark chocolate bark.',
+        linkText: 'Reserve a Spot',
+        href: '/menu',
+      },
+    ];
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = extraPromos[promoIndex % extraPromos.length];
+      promoIndex += 1;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+
+      const heading = document.createElement('h3');
+      heading.textContent = promo.title;
+
+      const paragraph = document.createElement('p');
+      paragraph.textContent = promo.description;
+
+      const link = document.createElement('a');
+      link.href = promo.href;
+      link.className = 'btn';
+      link.textContent = promo.linkText;
+
+      card.append(heading, paragraph, link);
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-removing])');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.setAttribute('data-removing', '');
+      await removeElement(lastCard);
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (!toggleCard) return;
+      if (toggleCard.hidden || toggleCard.hasAttribute('data-closing')) {
+        showElement(toggleCard);
+      } else {
+        await hideElement(toggleCard);
+      }
+    });
+  </script>
