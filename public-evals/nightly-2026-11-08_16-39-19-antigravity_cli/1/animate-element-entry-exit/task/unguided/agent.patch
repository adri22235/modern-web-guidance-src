+  <script>
+    (function () {
+      const domContainer = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const promos = [
+        {
+          badge: 'Morning Bundle',
+          title: 'Pastry & Pour-Over Combo',
+          description: 'Pair any freshly baked croissant with a single-origin pour-over for just $7.50 before 10 AM.',
+          image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80',
+          alt: 'Pour-over coffee and croissant'
+        },
+        {
+          badge: 'Members Exclusive',
+          title: 'Double Rewards Weekend',
+          description: 'Earn 2x beans on every espresso drink, cold brew, and whole-bean bag purchase all weekend long.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80',
+          alt: 'Roasted coffee beans'
+        },
+        {
+          badge: 'Roaster Special',
+          title: '20% Off Whole Bean Bags',
+          description: 'Take the café home with 20% off our freshly roasted Ethiopian Yirgacheffe and Colombian Supremo.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
+          alt: 'Cup of freshly brewed coffee'
+        },
+        {
+          badge: 'Refresh & Save',
+          title: '$3 Afternoon Cold Brew',
+          description: 'Beat the afternoon slump with our signature 18-hour steeped cold brew for only $3.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80',
+          alt: 'Iced cold brew coffee'
+        }
+      ];
+
+      let promoIndex = 0;
+
+      addBtn.addEventListener('click', () => {
+        const promo = promos[promoIndex % promos.length];
+        promoIndex += 1;
+
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML = `
+          <img class="card-img" src="${promo.image}" alt="${promo.alt}">
+          <span class="promo-badge">${promo.badge}</span>
+          <h3>${promo.title}</h3>
+          <p>${promo.description}</p>
+          <a href="/rewards" class="btn">Claim Offer</a>
+        `;
+
+        domContainer.appendChild(card);
+      });
+
+      removeBtn.addEventListener('click', () => {
+        const activeCards = Array.from(
+          domContainer.querySelectorAll('.card:not(.removing):not(.exiting):not(.hidden):not(.is-hidden)')
+        );
+        const lastCard = activeCards[activeCards.length - 1];
+        if (!lastCard) return;
+
+        lastCard.classList.add('removing');
+
+        let cleanedUp = false;
+        const removeElement = () => {
+          if (cleanedUp) return;
+          cleanedUp = true;
+          lastCard.remove();
+        };
+
+        lastCard.addEventListener('transitionend', removeElement, { once: true });
+        setTimeout(removeElement, 320);
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        if (!toggleCard) return;
+
+        if (!toggleCard.isConnected) {
+          toggleCard.classList.remove('hidden', 'is-hidden', 'removing', 'exiting');
+          domContainer.prepend(toggleCard);
+          return;
+        }
+
+        toggleCard.classList.toggle('hidden');
+      });
+    })();
+  </script>
+
