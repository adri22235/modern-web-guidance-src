+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['variant', 'badge', 'price', 'href', 'cta-text', 'image', 'image-alt', 'featured'];
+      }
+
+      constructor() {
+        super();
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        if (template) {
+          shadowRoot.appendChild(template.content.cloneNode(true));
+        }
+      }
+
+      connectedCallback() {
+        this._syncAttributes();
+      }
+
+      attributeChangedCallback() {
+        if (this.isConnected) {
+          this._syncAttributes();
+        }
+      }
+
+      _syncAttributes() {
+        const root = this.shadowRoot;
+        if (!root) return;
+
+        const badgeEl = root.querySelector('[part="badge"]');
+        const badgeSlot = root.querySelector('slot[name="badge"]');
+        const priceEl = root.querySelector('[part="price"]');
+        const ctaEl = root.querySelector('[part~="button"]');
+        const mediaEl = root.querySelector('[part="media"]');
+        const imgEl = root.querySelector('[part="image"]');
+
+        const badgeText = this.getAttribute('badge');
+        if (badgeSlot && badgeSlot.assignedNodes().length === 0 && badgeText) {
+          badgeSlot.textContent = badgeText;
+        }
+        if (badgeEl) {
+          badgeEl.hidden = !badgeText && (!badgeSlot || badgeSlot.assignedNodes().length === 0);
+        }
+
+        const priceText = this.getAttribute('price');
+        if (priceEl) {
+          priceEl.textContent = priceText || '';
+          priceEl.hidden = !priceText;
+        }
+
+        const href = this.getAttribute('href');
+        const ctaText = this.getAttribute('cta-text');
+        if (ctaEl) {
+          if (href) ctaEl.setAttribute('href', href);
+          if (ctaText) ctaEl.textContent = ctaText;
+        }
+
+        const imageSrc = this.getAttribute('image');
+        const imageAlt = this.getAttribute('image-alt') || this.getAttribute('badge') || 'Coffee drink';
+        if (mediaEl && imgEl) {
+          if (imageSrc) {
+            imgEl.src = imageSrc;
+            imgEl.alt = imageAlt;
+            mediaEl.hidden = false;
+          } else {
+            mediaEl.hidden = true;
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
