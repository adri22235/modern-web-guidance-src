+  <script type="module">
+    const drinkCardStyles = new CSSStyleSheet();
+    drinkCardStyles.replaceSync(`
+      @layer reset, base, layout, theme, variants;
+
+      @layer reset {
+        :where(article, div, header, footer, figure, img, a, span, slot) {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+
+        img {
+          display: block;
+          max-width: 100%;
+        }
+      }
+
+      @layer base {
+        :host {
+          /* Read inherited page coffee theme variables into private shadow aliases */
+          --_primary: var(--primary, #4e342e);
+          --_secondary: var(--secondary, #d7ccc8);
+          --_accent: var(--accent, #ffab40);
+          --_text: var(--text, #3e2723);
+          --_light: var(--light, #fafafa);
+
+          /* Public component theming hooks with fallbacks to the inherited coffee palette */
+          --_card-bg: var(--card-bg, #ffffff);
+          --_card-fg: var(--card-fg, var(--_text));
+          --_card-heading: var(--card-heading, var(--_primary));
+          --_card-accent: var(--card-accent, var(--_accent));
+          --_card-border: var(--card-border, color-mix(in srgb, var(--_secondary) 70%, transparent));
+          --_card-radius: var(--card-radius, 10px);
+          --_card-shadow: var(--card-shadow, 0 2px 6px rgba(0, 0, 0, 0.1));
+          --_btn-bg: var(--card-btn-bg, var(--_primary));
+          --_btn-fg: var(--card-btn-fg, #ffffff);
+
+          display: block;
+          container-type: inline-size;
+          container-name: drink-card;
+          background: var(--_card-bg);
+          color: var(--_card-fg);
+          border: 1px solid var(--_card-border);
+          border-radius: var(--_card-radius);
+          box-shadow: var(--_card-shadow);
+          overflow: clip;
+          transition: transform 0.2s ease, box-shadow 0.2s ease;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        /* Light touch-ups on projected Light DOM nodes via ::slotted() */
+        ::slotted([slot="title"]),
+        ::slotted(h3) {
+          margin: 0 0 8px;
+          color: var(--_card-heading);
+          font-size: 1.25rem;
+          line-height: 1.3;
+        }
+
+        ::slotted(p) {
+          margin: 0;
+          color: inherit;
+          opacity: 0.92;
+        }
+
+        .cta-btn {
+          font: inherit;
+          color: var(--_btn-fg);
+          background: var(--_btn-bg);
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 6px;
+          border: 1px solid transparent;
+          cursor: pointer;
+          transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
+        }
+      }
+
+      @layer layout {
+        .card-surface {
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          text-align: center;
+        }
+
+        .media-wrap {
+          position: relative;
+          aspect-ratio: 16 / 10;
+          overflow: hidden;
+          background: var(--_secondary);
+        }
+
+        .media-img {
+          width: 100%;
+          height: 100%;
+          object-fit: cover;
+        }
+
+        .content-wrap {
+          display: flex;
+          flex-direction: column;
+          flex: 1;
+          justify-content: space-between;
+          padding: 20px;
+          gap: 16px;
+        }
+
+        .card-header {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 8px;
+        }
+
+        .card-body {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 6px;
+        }
+
+        .card-details {
+          display: none;
+          font-size: 0.85rem;
+          opacity: 0.85;
+        }
+
+        .card-footer {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 12px;
+          margin-top: auto;
+          padding-top: 8px;
+        }
+
+        /* Respond to the card's own dimensions rather than the viewport */
+        @container (min-width: 28rem) {
+          .card-surface {
+            display: grid;
+            grid-template-columns: minmax(200px, 38%) 1fr;
+            text-align: start;
+            align-items: stretch;
+          }
+
+          .media-wrap {
+            aspect-ratio: auto;
+            min-height: 220px;
+          }
+
+          .content-wrap {
+            padding: 24px 28px;
+          }
+
+          .card-header {
+            flex-direction: row;
+            justify-content: space-between;
+            align-items: baseline;
+          }
+
+          .card-body {
+            align-items: flex-start;
+          }
+
+          .card-details {
+            display: block;
+          }
+
+          .card-footer {
+            flex-direction: row;
+            justify-content: space-between;
+            align-items: center;
+            border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
+            padding-top: 14px;
+          }
+        }
+      }
+
+      @layer theme {
+        :host(:hover) {
+          box-shadow: 0 6px 16px rgba(62, 39, 35, 0.16);
+        }
+
+        .badge {
+          display: inline-block;
+          background: color-mix(in srgb, var(--_card-accent) 25%, var(--_secondary));
+          color: var(--_text);
+          font-size: 0.72rem;
+          font-weight: 700;
+          padding: 3px 10px;
+          border-radius: 999px;
+        }
+
+        .badge:empty {
+          display: none;
+        }
+
+        .price {
+          font-weight: 700;
+          font-size: 1.05rem;
+          color: var(--_card-heading);
+        }
+
+        .price:empty {
+          display: none;
+        }
+
+        .cta-btn:hover {
+          background: var(--_text);
+          color: var(--_light);
+        }
+
+        .cta-btn:focus-visible {
+          outline: 2px solid var(--_card-accent);
+          outline-offset: 2px;
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]),
+        :host([featured]) {
+          --_card-bg: linear-gradient(135deg, #fffdf9 0%, color-mix(in srgb, var(--_secondary) 35%, #ffffff) 100%);
+          --_card-border: var(--_card-accent);
+          --_card-shadow: 0 6px 18px rgba(78, 52, 46, 0.16);
+          border-width: 2px;
+        }
+
+        :host([variant="featured"]) .badge,
+        :host([featured]) .badge {
+          background: var(--_card-accent);
+          color: var(--_text);
+        }
+
+        :host([variant="dark"]) {
+          --_card-bg: var(--_primary);
+          --_card-fg: var(--_light);
+          --_card-heading: var(--_card-accent);
+          --_card-border: var(--_text);
+          --_btn-bg: var(--_card-accent);
+          --_btn-fg: var(--_text);
+        }
+
+        :host([variant="dark"]) .badge {
+          background: rgba(255, 171, 64, 0.2);
+          color: var(--_card-accent);
+          border: 1px solid var(--_card-accent);
+        }
+
+        :host([variant="dark"]) .cta-btn:hover {
+          background: var(--_light);
+          color: var(--_primary);
+        }
+
+        :host([variant="chilled"]) {
+          --_card-bg: color-mix(in srgb, var(--_secondary) 22%, #ffffff);
+          --_card-border: var(--_primary);
+        }
+      }
+    `);
+
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <article class="card-surface" part="surface card">
+        <figure class="media-wrap" part="media">
+          <slot name="media">
+            <img class="media-img" part="image" src="" alt="" loading="lazy">
+          </slot>
+        </figure>
+        <div class="content-wrap" part="content">
+          <header class="card-header" part="header">
+            <slot name="title"></slot>
+            <span class="badge" part="badge"></span>
+          </header>
+          <div class="card-body" part="body">
+            <slot></slot>
+            <p class="card-details" part="details">Small-batch roasted daily &bull; Available hot or iced</p>
+          </div>
+          <footer class="card-footer" part="footer">
+            <span class="price" part="price"></span>
+            <a class="cta-btn" part="button cta" href="/menu">View Details</a>
+          </footer>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['href', 'cta', 'badge', 'price', 'image', 'image-alt', 'variant', 'featured'];
+
+      #imgEl;
+      #badgeEl;
+      #priceEl;
+      #ctaEl;
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        shadow.adoptedStyleSheets = [drinkCardStyles];
+        shadow.append(drinkCardTemplate.content.cloneNode(true));
+
+        this.#imgEl = shadow.querySelector('.media-img');
+        this.#badgeEl = shadow.querySelector('.badge');
+        this.#priceEl = shadow.querySelector('.price');
+        this.#ctaEl = shadow.querySelector('.cta-btn');
+      }
+
+      connectedCallback() {
+        this.#syncAll();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#syncAll();
+        }
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '/menu';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get cta() {
+        return this.getAttribute('cta') ?? 'View Details';
+      }
+      set cta(v) {
+        v ? this.setAttribute('cta', v) : this.removeAttribute('cta');
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+      set badge(v) {
+        v ? this.setAttribute('badge', v) : this.removeAttribute('badge');
+      }
+
+      get price() {
+        return this.getAttribute('price') ?? '';
+      }
+      set price(v) {
+        v ? this.setAttribute('price', v) : this.removeAttribute('price');
+      }
+
+      get variant() {
+        return this.getAttribute('variant') ?? '';
+      }
+      set variant(v) {
+        v ? this.setAttribute('variant', v) : this.removeAttribute('variant');
+      }
+
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      #syncAll() {
+        const imgSrc = this.getAttribute('image') ?? '';
+        if (this.#imgEl) {
+          this.#imgEl.src = imgSrc;
+          this.#imgEl.alt = this.getAttribute('image-alt') ?? '';
+          this.#imgEl.closest('.media-wrap').hidden = !imgSrc;
+        }
+        if (this.#badgeEl) {
+          this.#badgeEl.textContent = this.badge;
+          this.#badgeEl.hidden = !this.badge;
+        }
+        if (this.#priceEl) {
+          this.#priceEl.textContent = this.price;
+          this.#priceEl.hidden = !this.price;
+        }
+        if (this.#ctaEl) {
+          this.#ctaEl.href = this.href;
+          this.#ctaEl.textContent = this.cta;
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
