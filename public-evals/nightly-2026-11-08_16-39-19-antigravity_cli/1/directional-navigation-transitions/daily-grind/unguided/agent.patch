+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('#seasonal-carousel .card'));
+      const prevBtn = document.getElementById('prev-drink-btn');
+      const nextBtn = document.getElementById('next-drink-btn');
+      const statusEl = document.getElementById('carousel-status');
+      let currentIndex = 0;
+      let cleanupTimeout = null;
+
+      function clearAnimationClasses(card) {
+        card.classList.remove('slide-in-right', 'slide-in-left', 'slide-out-left', 'slide-out-right');
+      }
+
+      function stepCarousel(direction) {
+        if (cleanupTimeout) {
+          clearTimeout(cleanupTimeout);
+          cleanupTimeout = null;
+          cards.forEach((card, idx) => {
+            clearAnimationClasses(card);
+            if (idx === currentIndex) {
+              card.classList.add('active');
+              card.hidden = false;
+            } else {
+              card.classList.remove('active');
+              card.hidden = true;
+            }
+          });
+        }
+
+        const outgoingCard = cards[currentIndex];
+        const nextIndex =
+          direction === 'next'
+            ? (currentIndex + 1) % cards.length
+            : (currentIndex - 1 + cards.length) % cards.length;
+        const incomingCard = cards[nextIndex];
+
+        clearAnimationClasses(outgoingCard);
+        clearAnimationClasses(incomingCard);
+
+        outgoingCard.classList.remove('active');
+        outgoingCard.classList.add(direction === 'next' ? 'slide-out-left' : 'slide-out-right');
+
+        incomingCard.hidden = false;
+        incomingCard.classList.add('active', direction === 'next' ? 'slide-in-right' : 'slide-in-left');
+
+        currentIndex = nextIndex;
+        statusEl.textContent = (currentIndex + 1) + ' / ' + cards.length;
+
+        cleanupTimeout = setTimeout(() => {
+          clearAnimationClasses(outgoingCard);
+          outgoingCard.hidden = true;
+          clearAnimationClasses(incomingCard);
+          cleanupTimeout = null;
+        }, 350);
+      }
+
+      nextBtn.addEventListener('click', () => stepCarousel('next'));
+      prevBtn.addEventListener('click', () => stepCarousel('prev'));
+    })();
+  </script>
