+    /* Seasonal Favorites Switcher & Directional View Transitions */
+    .seasonal-viewer {
+      max-width: 480px;
+      margin: 20px auto 0;
+    }
+
+    .seasonal-stage {
+      view-transition-name: seasonal-card;
+    }
+
+    .card[hidden] {
+      display: none;
+    }
+
+    .seasonal-controls {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 16px;
+      margin-top: 20px;
+    }
+
+    .seasonal-nav-btn {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 10px 20px;
+      border-radius: 5px;
+      font-family: inherit;
+      font-size: 0.95rem;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .seasonal-nav-btn:hover {
+      background: #3e2723;
+    }
+
+    .seasonal-status {
+      font-size: 0.9rem;
+      font-weight: 600;
+      color: var(--primary);
+      min-width: 60px;
+      text-align: center;
+    }
+
+    /* Slide an element out to the left */
+    @keyframes slide-to-left {
+      to {
+        transform: translateX(-100%);
+      }
+    }
+
+    /* Slide an element in from the right */
+    @keyframes slide-from-right {
+      from {
+        transform: translateX(100%);
+      }
+    }
+
+    /* Slide an element out to the right */
+    @keyframes slide-to-right {
+      to {
+        transform: translateX(100%);
+      }
+    }
+
+    /* Slide an element in from the left */
+    @keyframes slide-from-left {
+      from {
+        transform: translateX(-100%);
+      }
+    }
+
+    ::view-transition-group(root),
+    ::view-transition-group(seasonal-card) {
+      animation: 0.4s ease-in-out both;
+    }
+
+    ::view-transition-group(seasonal-card) {
+      overflow: clip;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-old(root),
+    html:active-view-transition-type(forward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-new(root),
+    html:active-view-transition-type(forward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-right;
+    }
+
+    html:active-view-transition-type(backward)::view-transition-old(root),
+    html:active-view-transition-type(backward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(backward)::view-transition-new(root),
+    html:active-view-transition-type(backward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(root),
+      ::view-transition-group(seasonal-card),
+      ::view-transition-old(root),
+      ::view-transition-new(root),
+      ::view-transition-old(seasonal-card),
+      ::view-transition-new(seasonal-card) {
+        animation: none !important;
+      }
+    }
