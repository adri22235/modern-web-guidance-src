+  <script>
+    const cards = Array.from(document.querySelectorAll('[data-drink-card]'));
+    const prevBtn = document.getElementById('prev-drink-btn');
+    const nextBtn = document.getElementById('next-drink-btn');
+    const statusEl = document.getElementById('seasonal-status');
+    let currentIndex = 0;
+
+    function renderActiveCard(index) {
+      cards.forEach((card, i) => {
+        card.hidden = i !== index;
+      });
+      if (statusEl) {
+        statusEl.textContent = `${index + 1} / ${cards.length}`;
+      }
+    }
+
+    /**
+     * Navigates to a new drink card with a directional view transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM, direction) {
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+
+      if (transition && transition.ready) {
+        transition.ready.catch(() => {});
+      }
+    }
+
+    prevBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex - 1 + cards.length) % cards.length;
+      navigate(() => {
+        currentIndex = nextIndex;
+        renderActiveCard(currentIndex);
+      }, 'backward');
+    });
+
+    nextBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex + 1) % cards.length;
+      navigate(() => {
+        currentIndex = nextIndex;
+        renderActiveCard(currentIndex);
+      }, 'forward');
+    });
+  </script>
+
