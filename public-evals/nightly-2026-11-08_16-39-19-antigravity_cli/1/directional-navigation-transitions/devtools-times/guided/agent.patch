+}
+
+/* Slide an element out to the left */
+@keyframes slide-to-left {
+  to {
+    transform: translateX(-100%);
+  }
+}
+
+/* Slide an element in from the right */
+@keyframes slide-from-right {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+/* Slide an element out to the right */
+@keyframes slide-to-right {
+  to {
+    transform: translateX(100%);
+  }
+}
+
+/* Slide an element in from the left */
+@keyframes slide-from-left {
+  from {
+    transform: translateX(-100%);
+  }
+}
+
+[data-carousel-viewport] {
+  view-transition-name: top-story-slide;
+}
+
+::view-transition-group(root),
+::view-transition-group(top-story-slide) {
+  animation: 0.4s ease-in-out both;
+  overflow: clip;
+}
+
+:active-view-transition-type(forward)::view-transition-old(root),
+html:active-view-transition-type(forward)::view-transition-old(root),
+html:active-view-transition-type(forward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-left;
+}
+
+:active-view-transition-type(forward)::view-transition-new(root),
+html:active-view-transition-type(forward)::view-transition-new(root),
+html:active-view-transition-type(forward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-right;
+}
+
+:active-view-transition-type(backward)::view-transition-old(root),
+html:active-view-transition-type(backward)::view-transition-old(root),
+html:active-view-transition-type(backward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-right;
+}
+
+:active-view-transition-type(backward)::view-transition-new(root),
+html:active-view-transition-type(backward)::view-transition-new(root),
+html:active-view-transition-type(backward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-left;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(root),
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
