             </div>
         </div>
     </div>
 
+    <script>
+        function initTopStoriesCarousel() {
+            const carousel = document.querySelector('[data-top-stories-carousel]');
+            if (!carousel || carousel.hasAttribute('data-initialized')) return;
+            carousel.setAttribute('data-initialized', 'true');
+
+            const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
+            const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
+            const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
+            const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
+
+            if (!viewport || slides.length === 0 || !prevBtn || !nextBtn) return;
+
+            let currentIndex = slides.findIndex((slide) => !slide.hidden);
+            if (currentIndex === -1) currentIndex = 0;
+
+            function navigate(nextIndex: number, direction: 'forward' | 'backward') {
+                const updateDOM = () => {
+                    slides.forEach((slide, idx) => {
+                        slide.hidden = idx !== nextIndex;
+                    });
+                    currentIndex = nextIndex;
+                };
+
+                const anyViewport = viewport as any;
+                if ('startViewTransition' in Element.prototype && typeof anyViewport.startViewTransition === 'function') {
+                    const transition = anyViewport.startViewTransition({
+                        update: updateDOM,
+                        types: [direction],
+                    });
+                    transition.ready?.catch(() => {});
+                    return;
+                }
+
+                if (!document.startViewTransition) {
+                    updateDOM();
+                    return;
+                }
+
+                const transition = document.startViewTransition({
+                    update: updateDOM,
+                    types: [direction],
+                });
+                transition.ready?.catch(() => {});
+            }
+
+            nextBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % slides.length;
+                navigate(nextIndex, 'forward');
+            });
+
+            prevBtn.addEventListener('click', () => {
+                const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
+                navigate(prevIndex, 'backward');
+            });
+        }
+
+        initTopStoriesCarousel();
+        document.addEventListener('astro:page-load', initTopStoriesCarousel);
+    </script>
+
     <!-- Main Content Area -->
