+import React, { useState, useRef, useEffect } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStoryItem {
+    id: string;
+    title: string;
+    dateFormatted: string;
+    category?: string;
+    summary?: string;
+}
+
+interface TopStoriesCarouselProps {
+    stories: TopStoryItem[];
+    baseUrl?: string;
+}
+
+export default function TopStoriesCarousel({ stories, baseUrl = '/' }: TopStoriesCarouselProps) {
+    const [currentIndex, setCurrentIndex] = useState(0);
+    const [prevIndex, setPrevIndex] = useState<number | null>(null);
+    const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+    const [isAnimating, setIsAnimating] = useState(false);
+    const timeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+    const total = stories.length;
+
+    useEffect(() => {
+        return () => {
+            if (timeoutRef.current) {
+                clearTimeout(timeoutRef.current);
+            }
+        };
+    }, []);
+
+    if (total === 0) {
+        return null;
+    }
+
+    const navigate = (dir: 'next' | 'prev') => {
+        if (total <= 1) return;
+
+        if (timeoutRef.current) {
+            clearTimeout(timeoutRef.current);
+        }
+
+        const nextIdx =
+            dir === 'next'
+                ? (currentIndex + 1) % total
+                : (currentIndex - 1 + total) % total;
+
+        setPrevIndex(currentIndex);
+        setCurrentIndex(nextIdx);
+        setDirection(dir);
+        setIsAnimating(true);
+
+        timeoutRef.current = setTimeout(() => {
+            setIsAnimating(false);
+            setPrevIndex(null);
+        }, 350);
+    };
+
+    const handlePrevious = () => navigate('prev');
+    const handleNext = () => navigate('next');
+
+    const currentStory = stories[currentIndex];
+    const previousStory = prevIndex !== null ? stories[prevIndex] : null;
+
+    const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+    return (
+        <section
+            aria-label="Top Stories"
+            aria-roledescription="carousel"
+            className="bg-white border-b border-gray-300"
+        >
+            <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
+                <div className="flex items-center justify-between gap-4">
+                    {/* Left label & counter */}
+                    <div className="hidden sm:flex items-center gap-2 shrink-0 pr-3 border-r border-gray-300">
+                        <span className="text-xs font-bold uppercase tracking-wider text-amber-800">
+                            Top Stories
+                        </span>
+                        <span className="text-xs text-gray-500 font-medium tabular-nums">
+                            {currentIndex + 1}/{total}
+                        </span>
+                    </div>
+
+                    {/* Previous button */}
+                    <button
+                        type="button"
+                        onClick={handlePrevious}
+                        aria-label="Previous story"
+                        className="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded border border-gray-300 transition-colors cursor-pointer shrink-0 focus:outline-none focus:ring-2 focus:ring-amber-400"
+                    >
+                        <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+                        <span>Previous</span>
+                    </button>
+
+                    {/* Single-story viewport */}
+                    <div
+                        className="relative flex-1 overflow-hidden min-h-[3.25rem] flex items-center"
+                        aria-live="polite"
+                        aria-atomic="true"
+                    >
+                        {isAnimating && previousStory && (
+                            <div
+                                key={`outgoing-${previousStory.id}-${prevIndex}`}
+                                aria-hidden="true"
+                                className={`w-full pointer-events-none select-none ${
+                                    direction === 'next'
+                                        ? 'carousel-slide-out-left'
+                                        : 'carousel-slide-out-right'
+                                }`}
+                            >
+                                <div className="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 px-2">
+                                    <a
+                                        href={`${normalizedBaseUrl}articles/${previousStory.id}`}
+                                        tabIndex={-1}
+                                        className="min-w-0"
+                                    >
+                                        <h3 className="font-bold text-gray-900 truncate">
+                                            {previousStory.title}
+                                        </h3>
+                                    </a>
+                                    <span className="text-xs text-gray-500 shrink-0">
+                                        {previousStory.dateFormatted}
+                                    </span>
+                                </div>
+                            </div>
+                        )}
+
+                        <div
+                            key={`incoming-${currentStory.id}-${currentIndex}-${direction ?? 'init'}`}
+                            className={`w-full ${
+                                isAnimating && direction === 'next'
+                                    ? 'carousel-slide-in-right'
+                                    : isAnimating && direction === 'prev'
+                                    ? 'carousel-slide-in-left'
+                                    : ''
+                            }`}
+                        >
+                            <div className="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 px-2">
+                                <a
+                                    href={`${normalizedBaseUrl}articles/${currentStory.id}`}
+                                    className="min-w-0 group"
+                                >
+                                    <h3 className="font-bold text-gray-900 group-hover:text-amber-400 transition-colors cursor-pointer truncate">
+                                        {currentStory.title}
+                                    </h3>
+                                </a>
+                                <span className="text-xs text-gray-500 shrink-0">
+                                    {currentStory.dateFormatted}
+                                </span>
+                            </div>
+                        </div>
+                    </div>
+
+                    {/* Next button */}
+                    <button
+                        type="button"
+                        onClick={handleNext}
+                        aria-label="Next story"
+                        className="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded border border-gray-300 transition-colors cursor-pointer shrink-0 focus:outline-none focus:ring-2 focus:ring-amber-400"
+                    >
+                        <span>Next</span>
+                        <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+                    </button>
+                </div>
+            </div>
+        </section>
+    );
+}
