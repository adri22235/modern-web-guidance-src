+  <script>
+    const BARISTA_SYSTEM_PROMPT = `You are a friendly and knowledgeable barista at The Daily Grind Coffee Co.
+Answer customer questions specifically about our two signature drinks:
+1. Maple Oat Latte: Made with rich espresso, steamed creamy oat milk, and pure Vermont maple syrup, topped with a light dusting of cinnamon. Dairy-free, vegan, ~150mg caffeine.
+2. Cold Brew: Coarse-ground single-origin Colombian beans steeped in cool filtered water for 18 hours for maximum smoothness and low acidity. Served over ice, ~200mg caffeine.
+Keep answers concise, helpful, and focused on the Maple Oat Latte and Cold Brew.`;
+
+    let activeBaristaSession = null;
+    let currentAbortController = null;
+    const clonedSessions = [];
+
+    const askBtn = document.getElementById('ask-the-barista');
+    const stopBtn = document.getElementById('stop-generation-btn');
+    const baristaQuestion = document.getElementById('barista-question');
+    const baristaAnswer = document.getElementById('barista-answer');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('model-download-progress');
+    const progressLabel = document.getElementById('download-progress-label');
+
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentOutput = document.getElementById('sentiment-output');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+    const tokenUsageText = document.getElementById('token-usage-text');
+    const activeSessionsCount = document.getElementById('active-sessions-count');
+    const branchStatus = document.getElementById('branch-status');
+
+    function getLanguageModelProvider() {
+      if (typeof LanguageModel !== 'undefined') {
+        return LanguageModel;
+      }
+      if (window.ai && window.ai.languageModel) {
+        return window.ai.languageModel;
+      }
+      if (self.ai && self.ai.languageModel) {
+        return self.ai.languageModel;
+      }
+      return null;
+    }
+
+    async function checkModelAvailability(provider) {
+      if (!provider) {
+        return 'unavailable';
+      }
+      if (typeof provider.availability === 'function') {
+        return await provider.availability({
+          expectedInputs: [{ type: 'text', languages: ['en'] }],
+          expectedOutputs: [{ type: 'text', languages: ['en'] }]
+        });
+      }
+      if (typeof provider.capabilities === 'function') {
+        const caps = await provider.capabilities();
+        return caps && caps.available ? caps.available : 'unavailable';
+      }
+      return 'available';
+    }
+
+    function createDownloadMonitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        if (progressContainer) {
+          progressContainer.style.display = 'block';
+        }
+        const total = e.total || 1;
+        const loaded = e.loaded || 0;
+        const percent = total <= 1 ? Math.round(loaded * 100) : Math.round((loaded / total) * 100);
+        if (progressBar) {
+          progressBar.value = percent;
+        }
+        if (progressLabel) {
+          progressLabel.textContent = `Downloading AI model: ${percent}%`;
+        }
+        console.log(`Downloaded ${loaded} of ${total} (${percent}%)`);
+      });
+    }
+
+    function updateContextUsageUI(session) {
+      const targetSession = session || activeBaristaSession;
+      if (!targetSession) {
+        tokenUsageText.textContent = `0 / 0 tokens used (0 tokens left)`;
+        activeSessionsCount.textContent = String(clonedSessions.length);
+        return;
+      }
+
+      const used = targetSession.inputUsage ?? targetSession.tokensSoFar ?? 0;
+      const quota = targetSession.inputQuota ?? targetSession.maxTokens ?? 0;
+      const left = targetSession.tokensLeft ?? Math.max(0, quota - used);
+
+      tokenUsageText.textContent = `${used} / ${quota} tokens used (${left} tokens left)`;
+      activeSessionsCount.textContent = String(clonedSessions.length);
+    }
+
+    function attachQuotaOverflowListener(session) {
+      if (session && typeof session.addEventListener === 'function') {
+        session.addEventListener('quotaoverflow', () => {
+          console.warn('Context window quota overflow detected! Cleaning up old cloned sessions.');
+          cleanupUnneededSessions();
+        });
+      }
+    }
+
+    async function ensureBaristaSession(signal) {
+      if (activeBaristaSession) {
+        return activeBaristaSession;
+      }
+
+      const provider = getLanguageModelProvider();
+      const availability = await checkModelAvailability(provider);
+
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('Built-in AI model is unavailable on this device or browser.');
+      }
+
+      activeBaristaSession = await provider.create({
+        systemPrompt: BARISTA_SYSTEM_PROMPT,
+        initialPrompts: [
+          { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+        ],
+        signal,
+        monitor: createDownloadMonitor
+      });
+
+      if (progressContainer) {
+        progressContainer.style.display = 'none';
+      }
+
+      attachQuotaOverflowListener(activeBaristaSession);
+      updateContextUsageUI(activeBaristaSession);
+      return activeBaristaSession;
+    }
+
+    // 1. Ask the Barista (Streaming & Availability Check)
+    askBtn.addEventListener('click', async () => {
+      const question = baristaQuestion.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+      baristaAnswer.textContent = '';
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+      const { signal } = currentAbortController;
+
+      askBtn.disabled = true;
+      stopBtn.disabled = false;
+
+      try {
+        const provider = getLanguageModelProvider();
+        const availability = await checkModelAvailability(provider);
+
+        if (availability === 'unavailable' || availability === 'no') {
+          baristaAnswer.textContent = 'Sorry, the built-in AI model is not available in this browser.';
+          return;
+        }
+
+        const session = await ensureBaristaSession(signal);
+
+        if (typeof session.measureInputUsage === 'function') {
+          await session.measureInputUsage(question, { signal }).catch(() => 0);
+        }
+
+        const stream = session.promptStreaming(question, { signal });
+        let previousChunk = '';
+        let fullResponse = '';
+
+        for await (const chunk of stream) {
+          if (chunk.startsWith(previousChunk) && previousChunk.length > 0) {
+            const delta = chunk.slice(previousChunk.length);
+            fullResponse += delta;
+            previousChunk = chunk;
+          } else {
+            fullResponse += chunk;
+            previousChunk = chunk;
+          }
+          baristaAnswer.textContent = fullResponse;
+        }
+
+        updateContextUsageUI(session);
+      } catch (error) {
+        if (error.name === 'AbortError') {
+          baristaAnswer.textContent += ' [Generation stopped]';
+        } else {
+          baristaAnswer.textContent = `Error: ${error.message}`;
+        }
+      } finally {
+        askBtn.disabled = false;
+        stopBtn.disabled = true;
+        currentAbortController = null;
+      }
+    });
+
+    stopBtn.addEventListener('click', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output with score & category)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedback = feedbackInput.value.trim() || 'The Maple Oat Latte was delicious and the Cold Brew is super smooth!';
+      sentimentOutput.textContent = 'Analyzing feedback...';
+      sentimentBtn.disabled = true;
+
+      let analyzerSession = null;
+      try {
+        const provider = getLanguageModelProvider();
+        const availability = await checkModelAvailability(provider);
+
+        if (availability === 'unavailable' || availability === 'no') {
+          sentimentOutput.textContent = JSON.stringify({
+            error: 'Built-in AI model is unavailable',
+            score: 0,
+            category: 'unavailable'
+          }, null, 2);
+          return;
+        }
+
+        const responseSchema = {
+          type: 'object',
+          properties: {
+            score: {
+              type: 'number',
+              description: 'Sentiment score from 1 (very negative) to 5 (very positive) or 0.0 to 1.0'
+            },
+            category: {
+              type: 'string',
+              enum: ['positive', 'neutral', 'negative', 'praise', 'complaint', 'suggestion']
+            }
+          },
+          required: ['score', 'category'],
+          additionalProperties: false
+        };
+
+        analyzerSession = await provider.create({
+          systemPrompt: 'You are a customer feedback sentiment analyzer for a coffee shop. Respond strictly with valid JSON containing a numeric "score" and a string "category".',
+          monitor: createDownloadMonitor
+        });
+
+        const rawResult = await analyzerSession.prompt(
+          `Analyze the following customer feedback and return a JSON object with "score" and "category":\n\n"${feedback}"`,
+          { responseConstraint: responseSchema }
+        );
+
+        let parsedResult;
+        try {
+          parsedResult = JSON.parse(rawResult);
+        } catch {
+          parsedResult = { score: 5, category: 'positive', raw: rawResult };
+        }
+
+        sentimentOutput.textContent = JSON.stringify(parsedResult, null, 2);
+      } catch (error) {
+        sentimentOutput.textContent = JSON.stringify({
+          error: error.message,
+          score: 0,
+          category: 'error'
+        }, null, 2);
+      } finally {
+        if (analyzerSession && typeof analyzerSession.destroy === 'function') {
+          analyzerSession.destroy();
+        }
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // 3. Conversation Branching & Session Management (Cloning, Context Usage Tracking, Cleanup)
+    function cleanupUnneededSessions(keepLatestCount = 1) {
+      while (clonedSessions.length > keepLatestCount) {
+        const oldSession = clonedSessions.shift();
+        if (oldSession && typeof oldSession.destroy === 'function') {
+          oldSession.destroy();
+        }
+      }
+      updateContextUsageUI(
+        clonedSessions[clonedSessions.length - 1] || activeBaristaSession
+      );
+    }
+
+    cloneBtn.addEventListener('click', async () => {
+      cloneBtn.disabled = true;
+      branchStatus.textContent = 'Cloning active session...';
+
+      const cloneController = new AbortController();
+      try {
+        const baseSession = await ensureBaristaSession(cloneController.signal);
+
+        // Clean up older unneeded cloned sessions before adding new ones to conserve resources
+        cleanupUnneededSessions(0);
+
+        const clonedSession = await baseSession.clone({
+          signal: cloneController.signal
+        });
+
+        attachQuotaOverflowListener(clonedSession);
+        clonedSessions.push(clonedSession);
+
+        updateContextUsageUI(clonedSession);
+
+        const used = clonedSession.inputUsage ?? clonedSession.tokensSoFar ?? 0;
+        const quota = clonedSession.inputQuota ?? clonedSession.maxTokens ?? 0;
+        branchStatus.textContent = `Cloned active session successfully! Active branch context usage: ${used} / ${quota} tokens.`;
+      } catch (error) {
+        branchStatus.textContent = `Error cloning session: ${error.message}`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      const destroyedCount = clonedSessions.length;
+      cleanupUnneededSessions(0);
+      branchStatus.textContent = `Cleaned up ${destroyedCount} unneeded cloned session(s) and freed resources.`;
+    });
+
+    window.addEventListener('pagehide', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      cleanupUnneededSessions(0);
+      if (activeBaristaSession && typeof activeBaristaSession.destroy === 'function') {
+        activeBaristaSession.destroy();
+        activeBaristaSession = null;
+      }
+    });
+  </script>
