+  <script>
+    (() => {
+      const BARISTA_SYSTEM_PROMPT =
+        'You are a friendly, knowledgeable specialty barista at The Daily Grind. ' +
+        'Answer customer questions specifically about our Maple Oat Latte (made with steamed creamy oat milk, double espresso, and pure Vermont maple syrup) ' +
+        'and our Cold Brew (ethically sourced beans steeped cold for 18 hours for maximum smoothness and low acidity). Keep answers concise and helpful.';
+
+      const SENTIMENT_SYSTEM_PROMPT =
+        'You are a customer feedback analyzer for The Daily Grind coffee shop. Evaluate customer reviews accurately.';
+
+      const SENTIMENT_SCHEMA = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product-praise', 'service-feedback']
+          }
+        },
+        required: ['score', 'category']
+      };
+
+      let baseBaristaSession = null;
+      let baseSentimentSession = null;
+      let activeAbortController = null;
+      let activeClonesCount = 0;
+      let destroyedSessionsCount = 0;
+
+      const askBaristaBtn = document.getElementById('ask-the-barista');
+      const stopBaristaBtn = document.getElementById('stop-barista-btn');
+      const baristaQuestionEl = document.getElementById('barista-question');
+      const baristaAnswerEl = document.getElementById('barista-answer');
+      const baristaProgressEl = document.getElementById('barista-progress');
+
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const feedbackInputEl = document.getElementById('feedback-input');
+      const sentimentOutputEl = document.getElementById('sentiment-output');
+
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupSessionsBtn = document.getElementById('cleanup-sessions-btn');
+      const branchPromptEl = document.getElementById('branch-prompt');
+      const contextUsageDisplayEl = document.getElementById('context-usage-display');
+      const sessionLifecycleStatusEl = document.getElementById('session-lifecycle-status');
+      const cloneOutputEl = document.getElementById('clone-output');
+
+      function updateSessionMetrics(session) {
+        const usage = session && typeof session.contextUsage === 'number' ? session.contextUsage : 0;
+        const maxWindow = session && typeof session.contextWindow === 'number' ? session.contextWindow : 0;
+        contextUsageDisplayEl.textContent = `Context Usage: ${usage} / ${maxWindow} tokens`;
+        sessionLifecycleStatusEl.textContent = `Active Clones: ${activeClonesCount} | Cleaned Up: ${destroyedSessionsCount}`;
+      }
+
+      async function checkModelAvailability(statusElement) {
+        if (!('LanguageModel' in self)) {
+          if (statusElement) {
+            statusElement.textContent = 'Model status: Prompt API (LanguageModel) is not supported in this browser.';
+          }
+          return 'unavailable';
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (statusElement) {
+            statusElement.textContent = `Model status: ${availability}`;
+          }
+          return availability;
+        } catch (err) {
+          if (statusElement) {
+            statusElement.textContent = `Model status error: ${err.message}`;
+          }
+          return 'unavailable';
+        }
+      }
+
+      function createMonitorCallback(statusElement) {
+        return function monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round((e.loaded || 0) * 100);
+            if (statusElement) {
+              statusElement.textContent = `Downloading model: ${pct}%`;
+            }
+          });
+        };
+      }
+
+      async function getOrCreateBaseBaristaSession(statusElement) {
+        if (baseBaristaSession) {
+          return baseBaristaSession;
+        }
+        const availability = await checkModelAvailability(statusElement);
+        if (availability === 'unavailable') {
+          return null;
+        }
+        baseBaristaSession = await LanguageModel.create({
+          initialPrompts: [{ role: 'system', content: BARISTA_SYSTEM_PROMPT }],
+          expectedInputs: [{ type: 'text' }],
+          expectedOutputs: [{ type: 'text' }],
+          monitor: createMonitorCallback(statusElement)
+        });
+        updateSessionMetrics(baseBaristaSession);
+        return baseBaristaSession;
+      }
+
+      async function getOrCreateBaseSentimentSession(statusElement) {
+        if (baseSentimentSession) {
+          return baseSentimentSession;
+        }
+        const availability = await checkModelAvailability(statusElement);
+        if (availability === 'unavailable') {
+          return null;
+        }
+        baseSentimentSession = await LanguageModel.create({
+          initialPrompts: [{ role: 'system', content: SENTIMENT_SYSTEM_PROMPT }],
+          expectedInputs: [{ type: 'text' }],
+          expectedOutputs: [{ type: 'text' }],
+          monitor: createMonitorCallback(statusElement)
+        });
+        return baseSentimentSession;
+      }
+
+      // Pre-warm base session on user interaction with the AI section to avoid cold-start latency
+      ['barista-question', 'branch-prompt'].forEach((id) => {
+        const el = document.getElementById(id);
+        if (el) {
+          el.addEventListener('focus', () => {
+            getOrCreateBaseBaristaSession(baristaProgressEl).catch(() => {});
+          }, { once: true });
+        }
+      });
+
+      function buildFallbackBaristaAnswer(question) {
+        const q = question.toLowerCase();
+        if (q.includes('maple') && q.includes('cold brew')) {
+          return 'Our Maple Oat Latte combines velvety steamed oat milk, rich espresso, and pure Vermont maple syrup for a warm, comforting treat. Our Cold Brew is steeped for 18 hours for ultra-smooth, low-acid refreshment over ice.';
+        }
+        if (q.includes('cold brew')) {
+          return 'Our Cold Brew is crafted from ethically sourced beans and steeped in cool water for 18 hours, delivering maximum smoothness with naturally sweet chocolatey notes.';
+        }
+        return 'Our signature Maple Oat Latte blends rich espresso with creamy oat milk and a hint of authentic Vermont maple syrup. We also serve an 18-hour steeped Cold Brew for a smooth, refreshing option!';
+      }
+
+      function computeFallbackSentiment(text) {
+        const lower = text.toLowerCase();
+        const positiveWords = ['great', 'incredible', 'smooth', 'love', 'delicious', 'best', 'good', 'amazing', 'sweet'];
+        const negativeWords = ['bad', 'bitter', 'cold', 'slow', 'terrible', 'worst', 'sour'];
+        let score = 3;
+        for (const w of positiveWords) {
+          if (lower.includes(w)) score = Math.min(5, score + 1);
+        }
+        for (const w of negativeWords) {
+          if (lower.includes(w)) score = Math.max(1, score - 1);
+        }
+        const category = score >= 4 ? 'positive' : score <= 2 ? 'negative' : 'neutral';
+        return { score, category };
+      }
+
+      // 1. Ask the Barista (Streaming response into #barista-answer)
+      askBaristaBtn.addEventListener('click', async () => {
+        const question = baristaQuestionEl.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+        const cacheKey = `barista_cache_${question.toLowerCase()}`;
+        const cached = sessionStorage.getItem(cacheKey);
+        if (cached) {
+          baristaAnswerEl.textContent = cached;
+          baristaProgressEl.textContent = 'Model status: Served from local session cache';
+          return;
+        }
+
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+        activeAbortController = new AbortController();
+
+        askBaristaBtn.disabled = true;
+        stopBaristaBtn.hidden = false;
+        baristaAnswerEl.textContent = '';
+
+        let taskSession = null;
+        try {
+          const availability = await checkModelAvailability(baristaProgressEl);
+          if (availability !== 'unavailable') {
+            const baseSession = await getOrCreateBaseBaristaSession(baristaProgressEl);
+            if (baseSession && typeof baseSession.clone === 'function') {
+              taskSession = await baseSession.clone();
+              activeClonesCount++;
+              updateSessionMetrics(taskSession);
+            } else {
+              taskSession = baseSession;
+            }
+
+            const stream = taskSession.promptStreaming(question, {
+              signal: activeAbortController.signal
+            });
+
+            let completeResult = '';
+            for await (const chunk of stream) {
+              completeResult += chunk;
+              baristaAnswerEl.append(chunk);
+            }
+            updateSessionMetrics(taskSession);
+            sessionStorage.setItem(cacheKey, completeResult);
+            baristaProgressEl.textContent = 'Model status: Streaming complete';
+          } else {
+            // Graceful fallback when built-in AI is unavailable
+            const fallbackText = buildFallbackBaristaAnswer(question);
+            baristaAnswerEl.textContent = fallbackText;
+          }
+        } catch (err) {
+          if (err.name === 'AbortError') {
+            baristaProgressEl.textContent = 'Model status: Generation aborted by user.';
+          } else {
+            baristaAnswerEl.textContent = buildFallbackBaristaAnswer(question);
+            baristaProgressEl.textContent = `Model status: Fallback used (${err.message})`;
+          }
+        } finally {
+          if (taskSession && taskSession !== baseBaristaSession && typeof taskSession.destroy === 'function') {
+            taskSession.destroy();
+            activeClonesCount = Math.max(0, activeClonesCount - 1);
+            destroyedSessionsCount++;
+            updateSessionMetrics(baseBaristaSession);
+          }
+          askBaristaBtn.disabled = false;
+          stopBaristaBtn.hidden = true;
+          activeAbortController = null;
+        }
+      });
+
+      stopBaristaBtn.addEventListener('click', () => {
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output with score & category)
+      sentimentBtn.addEventListener('click', async () => {
+        const feedback = feedbackInputEl.value.trim() || 'Great Maple Oat Latte and smooth Cold Brew!';
+        sentimentBtn.disabled = true;
+        sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+        let sentimentClone = null;
+        try {
+          const availability = await checkModelAvailability(baristaProgressEl);
+          if (availability !== 'unavailable') {
+            const baseSession = await getOrCreateBaseSentimentSession(baristaProgressEl);
+            sentimentClone = baseSession && typeof baseSession.clone === 'function'
+              ? await baseSession.clone()
+              : baseSession;
+
+            if (sentimentClone !== baseSentimentSession) {
+              activeClonesCount++;
+              updateSessionMetrics(sentimentClone);
+            }
+
+            const rawResult = await sentimentClone.prompt(
+              `Analyze the following customer feedback and classify its sentiment score (1-5) and category: "${feedback}"`,
+              { responseConstraint: SENTIMENT_SCHEMA }
+            );
+            const parsed = JSON.parse(rawResult);
+            sentimentOutputEl.textContent = JSON.stringify(parsed, null, 2);
+          } else {
+            const fallbackResult = computeFallbackSentiment(feedback);
+            sentimentOutputEl.textContent = JSON.stringify(fallbackResult, null, 2);
+          }
+        } catch (err) {
+          const fallbackResult = computeFallbackSentiment(feedback);
+          sentimentOutputEl.textContent = JSON.stringify(fallbackResult, null, 2);
+        } finally {
+          if (sentimentClone && sentimentClone !== baseSentimentSession && typeof sentimentClone.destroy === 'function') {
+            sentimentClone.destroy();
+            activeClonesCount = Math.max(0, activeClonesCount - 1);
+            destroyedSessionsCount++;
+            updateSessionMetrics(baseBaristaSession);
+          }
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // 3. Conversation Branching & Session Management (Cloning, context tracking, cleanup)
+      cloneBtn.addEventListener('click', async () => {
+        const branchPrompt = branchPromptEl.value.trim() || 'Compare the caffeine and flavor of Maple Oat Latte vs Cold Brew.';
+        cloneBtn.disabled = true;
+        cloneOutputEl.textContent = 'Cloning active base session and running branch...';
+
+        let clonedSession = null;
+        try {
+          const availability = await checkModelAvailability(baristaProgressEl);
+          if (availability !== 'unavailable') {
+            const baseSession = await getOrCreateBaseBaristaSession(baristaProgressEl);
+            clonedSession = await baseSession.clone();
+            activeClonesCount++;
+            updateSessionMetrics(clonedSession);
+
+            const response = await clonedSession.prompt(branchPrompt);
+            updateSessionMetrics(clonedSession);
+            cloneOutputEl.textContent = response;
+          } else {
+            cloneOutputEl.textContent = buildFallbackBaristaAnswer(branchPrompt);
+            updateSessionMetrics( null );
+          }
+        } catch (err) {
+          cloneOutputEl.textContent = buildFallbackBaristaAnswer(branchPrompt);
+        } finally {
+          // Always destroy the cloned branch session once its task finishes to free memory
+          if (clonedSession && typeof clonedSession.destroy === 'function') {
+            const finalUsage = clonedSession.contextUsage || 0;
+            const finalWindow = clonedSession.contextWindow || 0;
+            clonedSession.destroy();
+            activeClonesCount = Math.max(0, activeClonesCount - 1);
+            destroyedSessionsCount++;
+            contextUsageDisplayEl.textContent = `Context Usage: ${finalUsage} / ${finalWindow} tokens`;
+            sessionLifecycleStatusEl.textContent = `Active Clones: ${activeClonesCount} | Cleaned Up: ${destroyedSessionsCount}`;
+          }
+          cloneBtn.disabled = false;
+        }
+      });
+
+      function cleanupAllSessions() {
+        if (baseBaristaSession && typeof baseBaristaSession.destroy === 'function') {
+          baseBaristaSession.destroy();
+          baseBaristaSession = null;
+          destroyedSessionsCount++;
+        }
+        if (baseSentimentSession && typeof baseSentimentSession.destroy === 'function') {
+          baseSentimentSession.destroy();
+          baseSentimentSession = null;
+          destroyedSessionsCount++;
+        }
+        updateSessionMetrics(null);
+      }
+
+      cleanupSessionsBtn.addEventListener('click', () => {
+        cleanupAllSessions();
+        cloneOutputEl.textContent = 'All active base sessions have been destroyed and memory freed.';
+      });
+
+      window.addEventListener('pagehide', cleanupAllSessions);
+    })();
+  </script>
