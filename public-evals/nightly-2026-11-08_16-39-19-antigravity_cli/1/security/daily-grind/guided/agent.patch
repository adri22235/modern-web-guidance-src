+++ b/security-headers.js
@@ -0,0 +1,250 @@
+/**
+ * Security Headers & Policy Deployment Utilities for The Daily Grind
+ *
+ * Implements Phase 1–3 web security policies:
+ * - Content-Security-Policy (Report-Only & Enforced) with cryptographic nonces/hashes,
+ *   'strict-dynamic', 'report-sample', object-src 'none', base-uri 'none',
+ *   frame-ancestors 'none', and require-trusted-types-for 'script'.
+ * - Connection-Allowlist (RFC 9651 Inner List) with Sec-Fetch-Dest scoping.
+ * - Fetch Metadata (Sec-Fetch-Site / Sec-Fetch-Mode / Sec-Fetch-Dest) resource isolation.
+ * - Companion policies: HSTS, X-Content-Type-Options, X-Frame-Options, Referrer-Policy,
+ *   Permissions-Policy, COOP, CORP, Clear-Site-Data (on /logout), and __Host- cookies.
+ */
+
+const ALLOWLIST_DESTS = new Set([
+  'document',
+  'iframe',
+  'worker',
+  'sharedworker',
+  'serviceworker',
+]);
+
+export const STATIC_SCRIPT_HASH =
+  'sha256-9LsNwaa9lFRunZ1h9XhZlDPFbE/QMX9ToXUFIfK2/fs=';
+export const STATIC_STYLE_HASH =
+  'sha256-pgCbSi087587cIUFgbFArWtLA0rRd95jpzhakzdgwhA=';
+
+/**
+ * Generate a 16-byte cryptographic nonce for per-request SSR CSP headers.
+ */
+export function generateCspNonce() {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+}
+
+/**
+ * Build a Content-Security-Policy (or Content-Security-Policy-Report-Only) header value.
+ */
+export function buildCspHeader({
+  nonce,
+  scriptHashes = [STATIC_SCRIPT_HASH],
+  styleHashes = [STATIC_STYLE_HASH],
+  imgOrigins = ['https://images.unsplash.com'],
+  connectOrigins = [],
+  trustedTypesPolicies = ['escape-html', 'sanitize-html', 'dompurify'],
+  reportTo = 'main-endpoint',
+  frameAncestors = "'none'",
+} = {}) {
+  const scriptTokens = nonce
+    ? [`'nonce-${nonce}'`, "'strict-dynamic'", "'report-sample'"]
+    : [
+        "'self'",
+        ...scriptHashes.map((h) => `'${h}'`),
+        "'strict-dynamic'",
+        "'report-sample'",
+      ];
+
+  const styleTokens = [
+    "'self'",
+    ...(nonce ? [`'nonce-${nonce}'`] : styleHashes.map((h) => `'${h}'`)),
+  ];
+
+  const directives = [
+    "default-src 'self'",
+    `script-src ${scriptTokens.join(' ')}`,
+    `style-src ${styleTokens.join(' ')}`,
+    `img-src 'self' ${imgOrigins.join(' ')} data:`,
+    `connect-src 'self'${connectOrigins.length ? ` ${connectOrigins.join(' ')}` : ''}`,
+    "font-src 'self'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    `frame-ancestors ${frameAncestors}`,
+    "form-action 'self'",
+    "worker-src 'self'",
+    "require-trusted-types-for 'script'",
+    `trusted-types ${trustedTypesPolicies.join(' ')}`,
+  ];
+
+  if (reportTo) {
+    directives.push(`report-to ${reportTo}`);
+  }
+
+  return directives.join('; ');
+}
+
+/**
+ * Normalize a config URL or URLPattern string for Connection-Allowlist:
+ * - Rewrites ws:// and wss:// to http:// and https:// (WebSocket matching rule).
+ * - Strips a bare trailing slash on origin-only URLs so all subpaths are permitted.
+ */
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern)
+    .trim()
+    .replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(
+      `Pattern must include an http:// or https:// scheme: ${rawPattern}`,
+    );
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(
+      `Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`,
+    );
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(
+      `Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`,
+    );
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+/**
+ * Build an RFC 9651 Inner List value for Connection-Allowlist or Connection-Allowlist-Report-Only.
+ */
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = ['https://images.unsplash.com/*'],
+  reportTo = 'conn-reports',
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+/**
+ * Compute a SHA-384 Subresource Integrity digest at build/release time from local asset bytes.
+ */
+export async function computeIntegrityMetadata(bytes) {
+  const rawBytes =
+    typeof bytes === 'string' ? new TextEncoder().encode(bytes) : bytes;
+  const digestBuffer = await crypto.subtle.digest('SHA-384', rawBytes);
+  const binary = Array.from(new Uint8Array(digestBuffer), (b) =>
+    String.fromCharCode(b),
+  ).join('');
+  return `sha384-${btoa(binary)}`;
+}
+
+/**
+ * Apply security headers and Fetch Metadata resource isolation to an HTTP response.
+ */
+export function applySecurityHeaders(req, res, options = {}) {
+  const {
+    reportOnly = false,
+    usePerRequestNonce = false,
+    hstsMaxAge = 31536000,
+    reportingOrigin = 'https://reports.dailygrind.example',
+    connectionAllowlistPatterns = ['https://images.unsplash.com/*'],
+  } = options;
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function'
+      ? res.setHeader(name, value)
+      : res.headers.set(name, value);
+
+  const getReqHeader = (name) =>
+    typeof req.get === 'function'
+      ? req.get(name)
+      : req.headers?.get?.(name) ?? req.headers?.[name.toLowerCase()];
+
+  // 1. Fetch Metadata Resource Isolation (security §3.7) & Connection-Allowlist Vary
+  setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+  const site = getReqHeader('Sec-Fetch-Site');
+  const mode = getReqHeader('Sec-Fetch-Mode');
+  const dest = getReqHeader('Sec-Fetch-Dest');
+
+  if (site && !['same-origin', 'same-site', 'none'].includes(site)) {
+    const isAllowedNavigation =
+      site === 'cross-site' &&
+      mode === 'navigate' &&
+      req.method === 'GET' &&
+      !['object', 'embed'].includes(dest);
+
+    if (!isAllowedNavigation) {
+      if (typeof res.status === 'function') {
+        res.status(403).send('Forbidden');
+      }
+      return { allowed: false, nonce: null };
+    }
+  }
+
+  // 2. Reporting API Endpoints (security §2.2)
+  setHeader(
+    'Reporting-Endpoints',
+    `default="${reportingOrigin}/default", main-endpoint="${reportingOrigin}/csp", conn-reports="${reportingOrigin}/connections"`,
+  );
+
+  // 3. Content Security Policy (security §2.2, §3.2, §3.3)
+  const nonce = usePerRequestNonce ? generateCspNonce() : undefined;
+  const cspHeaderName = reportOnly
+    ? 'Content-Security-Policy-Report-Only'
+    : 'Content-Security-Policy';
+  setHeader(cspHeaderName, buildCspHeader({ nonce }));
+
+  // 4. Connection-Allowlist scoped to document/worker destinations (restrict-outbound-connections)
+  if (!dest || ALLOWLIST_DESTS.has(String(dest).toLowerCase())) {
+    const allowlistHeaderName = reportOnly
+      ? 'Connection-Allowlist-Report-Only'
+      : 'Connection-Allowlist';
+    setHeader(
+      allowlistHeaderName,
+      buildConnectionAllowlistHeader({
+        allowSelf: true,
+        patterns: connectionAllowlistPatterns,
+        reportTo: 'conn-reports',
+      }),
+    );
+  }
+
+  // 5. Companion Security & Isolation Headers (security §1.1, §1.4, §3.4, §3.5, privacy §5)
+  setHeader(
+    'Strict-Transport-Security',
+    `max-age=${hstsMaxAge}; includeSubDomains; preload`,
+  );
+  setHeader('X-Content-Type-Options', 'nosniff');
+  setHeader('X-Frame-Options', 'DENY');
+  setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), accelerometer=(), focus-without-user-activation=()',
+  );
+  setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+
+  // 6. Clear-Site-Data on Logout Endpoint (security Companion Policies, privacy §2)
+  const pathname = req.path ?? req.url ?? '';
+  if (pathname === '/logout' || pathname.startsWith('/logout?')) {
+    setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+  }
+
+  return { allowed: true, nonce: nonce ?? null };
+}
