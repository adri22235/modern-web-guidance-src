diff --git a/security.js b/security.js
new file mode 100644
index 0000000..194d372
--- /dev/null
+++ b/security.js
@@ -0,0 +1,116 @@
+(function () {
+  'use strict';
+
+  // 1. Framebusting / Clickjacking Defense-in-Depth
+  if (window.top !== window.self) {
+    try {
+      window.top.location = window.self.location.href;
+    } catch (e) {
+      document.documentElement.style.display = 'none';
+    }
+  }
+
+  // 2. Trusted Types Default Policy (DOM XSS Prevention)
+  if (window.trustedTypes && window.trustedTypes.createPolicy) {
+    try {
+      if (!window.trustedTypes.defaultPolicy) {
+        window.trustedTypes.createPolicy('default', {
+          createHTML: function (string) {
+            const temp = document.createElement('div');
+            temp.textContent = string;
+            return temp.innerHTML;
+          },
+          createScriptURL: function (url) {
+            const parsed = new URL(url, window.location.origin);
+            if (parsed.origin === window.location.origin) {
+              return parsed.href;
+            }
+            throw new TypeError('Untrusted script URL blocked by TrustedTypes policy: ' + url);
+          },
+          createScript: function () {
+            throw new TypeError('Dynamic script evaluation is blocked by TrustedTypes policy.');
+          }
+        });
+      }
+    } catch (err) {
+      console.warn('TrustedTypes policy registration failed:', err);
+    }
+  }
+
+  // 3. CSP Violation Monitoring (Client-Side Security Telemetry)
+  document.addEventListener('securitypolicyviolation', function (event) {
+    console.warn('[Security Audit] CSP Violation detected:', {
+      blockedURI: event.blockedURI,
+      violatedDirective: event.violatedDirective,
+      effectiveDirective: event.effectiveDirective,
+      originalPolicy: event.originalPolicy,
+      sourceFile: event.sourceFile,
+      lineNumber: event.lineNumber,
+      disposition: event.disposition
+    });
+  });
+
+  // 4. CSRF Token Generation & Secure Logout Handling
+  function getOrCreateCsrfToken() {
+    let token = sessionStorage.getItem('csrf_token');
+    if (!token && window.crypto && window.crypto.getRandomValues) {
+      const array = new Uint8Array(32);
+      window.crypto.getRandomValues(array);
+      token = Array.from(array, function (b) {
+        return b.toString(16).padStart(2, '0');
+      }).join('');
+      sessionStorage.setItem('csrf_token', token);
+    }
+    return token || 'fallback-csrf-token';
+  }
+
+  document.addEventListener('DOMContentLoaded', function () {
+    // Populate CSRF token in state-changing forms
+    const csrfInput = document.getElementById('csrf-token');
+    const csrfToken = getOrCreateCsrfToken();
+    if (csrfInput) {
+      csrfInput.value = csrfToken;
+    }
+
+    // Securely handle logout via POST with CSRF header & same-origin credentials
+    const logoutForm = document.getElementById('logout-form');
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        fetch(logoutForm.action, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/x-www-form-urlencoded',
+            'X-CSRF-Token': csrfToken,
+            'X-Requested-With': 'XMLHttpRequest'
+          },
+          credentials: 'same-origin',
+          body: new URLSearchParams({ _csrf: csrfToken }).toString()
+        })
+          .then(function () {
+            sessionStorage.clear();
+            window.location.assign('/');
+          })
+          .catch(function () {
+            logoutForm.submit();
+          });
+      });
+    }
+
+    // 5. External Link Hardening (Reverse Tabnabbing & Referrer Protection)
+    const links = document.querySelectorAll('a[href]');
+    links.forEach(function (link) {
+      try {
+        const url = new URL(link.href, window.location.origin);
+        if (url.origin !== window.location.origin) {
+          const currentRel = (link.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+          if (!currentRel.includes('noopener')) currentRel.push('noopener');
+          if (!currentRel.includes('noreferrer')) currentRel.push('noreferrer');
+          link.setAttribute('rel', currentRel.join(' '));
+        }
+      } catch (err) {
+        // Ignore invalid URLs
+      }
+    });
+  });
+})();
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..3de7865
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,169 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-form {
+  display: inline;
+  margin: 0;
+}
+
+.logout-btn,
+.logout-link {
+  background: transparent;
+  color: white;
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+  font-family: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  text-decoration: none;
+  transition: color 0.3s, background-color 0.3s;
+}
+
+.logout-btn:hover,
+.logout-link:hover {
+  color: var(--accent);
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
