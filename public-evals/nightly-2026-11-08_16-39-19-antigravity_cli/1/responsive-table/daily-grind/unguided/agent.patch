+    /* Nutritional & Pricing Table */
+    .table-section {
+      margin-top: 40px;
+    }
+
+    .table-container {
+      width: 100%;
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+    }
+
+    .table-container:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      text-align: left;
+      min-width: 600px;
+    }
+
+    .nutrition-table caption {
+      padding: 16px 20px;
+      font-size: 1.15rem;
+      font-weight: bold;
+      color: var(--primary);
+      text-align: left;
+      background-color: #f5f0ee;
+      border-bottom: 2px solid var(--secondary);
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 14px 18px;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      font-weight: 600;
+      color: var(--primary);
+      background-color: #fdfbfa;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+      border-right: 1px solid var(--secondary);
+    }
+
+    .nutrition-table tbody tr:hover td,
+    .nutrition-table tbody tr:hover th[scope="row"] {
+      background-color: #f9f5f3;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    @media (max-width: 640px) {
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+        font-size: 0.9rem;
+      }
+    }
+
