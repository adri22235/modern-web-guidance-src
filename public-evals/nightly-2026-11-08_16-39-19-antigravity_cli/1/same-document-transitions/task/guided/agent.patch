+  <script>
+    const baseTitle = document.title;
+    const heroImg = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailDesc = document.getElementById('detail-description');
+    const listHeading = document.getElementById('list-heading');
+    const backBtn = document.getElementById('back-btn');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    function populateDetail(card) {
+      const cardTitle = card.querySelector('.title')?.textContent || '';
+      const imgUrl = card.dataset.image || card.querySelector('img')?.src || '';
+      const imgAlt = card.dataset.alt || card.querySelector('img')?.alt || cardTitle;
+      const desc = card.dataset.description || card.querySelector('p')?.textContent || '';
+
+      heroImg.src = imgUrl;
+      heroImg.alt = imgAlt;
+      detailTitle.textContent = cardTitle;
+      detailDesc.textContent = desc;
+      document.title = `${cardTitle} | ${baseTitle}`;
+    }
+
+    function goFromListToDetail(e) {
+      e.preventDefault();
+      const card = e.currentTarget;
+
+      document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      card.classList.add('selected');
+      populateDetail(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      document.title = baseTitle;
+
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((el) => {
+          el.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('click', goFromListToDetail);
+    });
+
+    backBtn.addEventListener('click', goFromDetailToList);
+  </script>
+
