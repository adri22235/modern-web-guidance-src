+  <script>
+    (function () {
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const heroImg = document.getElementById('hero');
+      const detailTitle = document.getElementById('title');
+      const detailDescription = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+      const backButton = document.getElementById('back-button');
+      const thumbnails = document.querySelectorAll('.thumbnail');
+
+      let activeCard = null;
+      const prefersReducedMotion = () =>
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      function clearCardTransitionNames() {
+        thumbnails.forEach((card) => {
+          card.style.viewTransitionName = '';
+          const img = card.querySelector('img');
+          const title = card.querySelector('.title');
+          if (img) img.style.viewTransitionName = '';
+          if (title) title.style.viewTransitionName = '';
+        });
+      }
+
+      function applyCardTransitionNames(card) {
+        clearCardTransitionNames();
+        if (!card) return;
+        card.style.viewTransitionName = 'card-transition';
+        const title = card.querySelector('.title');
+        if (title) {
+          title.style.viewTransitionName = 'title-transition';
+        }
+      }
+
+      function showDetail(card) {
+        activeCard = card;
+        const titleText = card.dataset.title || card.querySelector('.title')?.textContent || '';
+        const imgSrc = card.dataset.image || card.querySelector('img')?.src || '';
+        const imgAlt = card.dataset.alt || card.querySelector('img')?.alt || titleText;
+        const descText = card.dataset.description || '';
+        const notesText = card.dataset.notes || '';
+
+        const updateDOM = () => {
+          clearCardTransitionNames();
+          heroImg.src = imgSrc;
+          heroImg.alt = imgAlt;
+          detailTitle.textContent = titleText;
+          detailDescription.textContent = descText;
+          detailNotes.textContent = notesText;
+
+          listPage.hidden = true;
+          detailPage.hidden = false;
+          backButton.focus();
+        };
+
+        if (document.startViewTransition && !prefersReducedMotion()) {
+          applyCardTransitionNames(card);
+          const transition = document.startViewTransition(updateDOM);
+          transition.finished.finally(() => {
+            clearCardTransitionNames();
+          });
+        } else {
+          updateDOM();
+        }
+      }
+
+      function showList() {
+        const targetCard = activeCard || thumbnails[0];
+
+        const updateDOM = () => {
+          detailPage.hidden = true;
+          listPage.hidden = false;
+          applyCardTransitionNames(targetCard);
+          if (targetCard) {
+            targetCard.focus();
+          }
+        };
+
+        if (document.startViewTransition && !prefersReducedMotion()) {
+          const transition = document.startViewTransition(updateDOM);
+          transition.finished.finally(() => {
+            clearCardTransitionNames();
+          });
+        } else {
+          updateDOM();
+          clearCardTransitionNames();
+        }
+      }
+
+      thumbnails.forEach((card) => {
+        card.addEventListener('click', (e) => {
+          e.preventDefault();
+          showDetail(card);
+        });
+
+        card.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            showDetail(card);
+          }
+        });
+      });
+
+      backButton.addEventListener('click', () => {
+        showList();
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && !detailPage.hidden) {
+          showList();
+        }
+      });
+    })();
+  </script>
 </body>
 
