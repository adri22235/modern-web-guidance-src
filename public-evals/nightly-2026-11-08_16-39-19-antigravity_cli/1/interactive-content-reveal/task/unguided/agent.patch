+  <script>
+    (function () {
+      const INNER_START = 45;
+      const OUTER_START = 80;
+      const INNER_TARGET = 90;
+      const OUTER_TARGET = 160;
+      const GROW_DURATION_MS = 180;
+
+      const reducedMotionQuery = window.matchMedia
+        ? window.matchMedia('(prefers-reduced-motion: reduce)')
+        : { matches: false };
+
+      function prefersReducedMotion() {
+        return Boolean(reducedMotionQuery && reducedMotionQuery.matches);
+      }
+
+      const cards = document.querySelectorAll('.product-card');
+
+      cards.forEach((card) => {
+        let isHovered = false;
+        let rafId = null;
+        let startTime = 0;
+
+        card.style.setProperty('--mouse-x', '0px');
+        card.style.setProperty('--mouse-y', '0px');
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+
+        function cancelGrowth() {
+          if (rafId !== null) {
+            cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+        }
+
+        function setSpotlightSize(innerPx, outerPx) {
+          card.style.setProperty('--inner-size', `${Math.round(innerPx)}px`);
+          card.style.setProperty('--outer-size', `${Math.round(outerPx)}px`);
+        }
+
+        function updatePointerPosition(e) {
+          const rect = card.getBoundingClientRect();
+          const clientX = typeof e.clientX === 'number' ? e.clientX : rect.left + rect.width / 2;
+          const clientY = typeof e.clientY === 'number' ? e.clientY : rect.top + rect.height / 2;
+          const x = Math.round(clientX - rect.left);
+          const y = Math.round(clientY - rect.top);
+          card.style.setProperty('--mouse-x', `${x}px`);
+          card.style.setProperty('--mouse-y', `${y}px`);
+        }
+
+        function startHoverGrowth() {
+          cancelGrowth();
+
+          if (prefersReducedMotion()) {
+            setSpotlightSize(INNER_TARGET, OUTER_TARGET);
+            return;
+          }
+
+          setSpotlightSize(INNER_START, OUTER_START);
+          startTime = performance.now();
+
+          function step(now) {
+            if (!isHovered) {
+              setSpotlightSize(0, 0);
+              return;
+            }
+            if (prefersReducedMotion()) {
+              setSpotlightSize(INNER_TARGET, OUTER_TARGET);
+              rafId = null;
+              return;
+            }
+            const elapsed = Math.max(0, now - startTime);
+            const progress = Math.min(1, elapsed / GROW_DURATION_MS);
+            const eased = 1 - Math.pow(1 - progress, 3);
+            const currentInner = INNER_START + (INNER_TARGET - INNER_START) * eased;
+            const currentOuter = OUTER_START + (OUTER_TARGET - OUTER_START) * eased;
+            setSpotlightSize(currentInner, currentOuter);
+
+            if (progress < 1) {
+              rafId = requestAnimationFrame(step);
+            } else {
+              setSpotlightSize(INNER_TARGET, OUTER_TARGET);
+              rafId = null;
+            }
+          }
+
+          rafId = requestAnimationFrame(step);
+        }
+
+        function handleEnter(e) {
+          updatePointerPosition(e);
+          if (!isHovered) {
+            isHovered = true;
+            startHoverGrowth();
+          }
+        }
+
+        function handleMove(e) {
+          updatePointerPosition(e);
+          if (!isHovered) {
+            isHovered = true;
+            startHoverGrowth();
+          }
+        }
+
+        function handleLeave() {
+          isHovered = false;
+          cancelGrowth();
+          setSpotlightSize(0, 0);
+        }
+
+        card.addEventListener('pointerenter', handleEnter);
+        card.addEventListener('mouseenter', handleEnter);
+        card.addEventListener('pointermove', handleMove);
+        card.addEventListener('mousemove', handleMove);
+        card.addEventListener('pointerleave', handleLeave);
+        card.addEventListener('mouseleave', handleLeave);
+      });
+    })();
+  </script>
+
