+  <script type="module">
+    const seasonalPanel = document.querySelector('.seasonal-panel');
+    const tocLinks = document.querySelectorAll('.toc-sidebar a');
+    const headers = seasonalPanel.querySelectorAll('.drink-section h3');
+
+    function setActiveDrink(id) {
+      if (!id) return;
+      tocLinks.forEach((link) => {
+        const isActive = link.getAttribute('href') === `#${id}`;
+        link.classList.toggle('active', isActive);
+        link.classList.toggle('target-current', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // Listen for snap changes when the scroller settles on a new section header
+    seasonalPanel.addEventListener('scrollsnapchange', (event) => {
+      const snappedHeader = event.snapTargetBlock;
+      if (snappedHeader) {
+        const targetId =
+          snappedHeader.id ||
+          snappedHeader.querySelector('[id]')?.id ||
+          snappedHeader.closest('[id]')?.id;
+        setActiveDrink(targetId);
+      }
+    });
+
+    // Fallback for browsers that do not support scrollsnapchange
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const observer = new IntersectionObserver(
+        () => {
+          const panelTop = seasonalPanel.getBoundingClientRect().top;
+          const topEntry = [...headers].reduce((currentTop, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) return currentTop;
+            if (!currentTop) return header;
+            return bottom < currentTop.getBoundingClientRect().bottom
+              ? header
+              : currentTop;
+          }, undefined);
+          if (topEntry) {
+            setActiveDrink(topEntry.id);
+          }
+        },
+        { root: seasonalPanel, threshold: 0.9 }
+      );
+
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    function scrollIntoViewAsync(element, options, scroller = seasonalPanel) {
+      const result = element.scrollIntoView(options);
+      if (result instanceof Promise) {
+        return result;
+      }
+
+      return new Promise((resolve) => {
+        let timeoutId;
+
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    let currentScrollId = 0;
+
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', async (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetHeading = document.getElementById(targetId);
+        if (!targetHeading) return;
+
+        event.preventDefault();
+        const scrollId = ++currentScrollId;
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        await scrollIntoViewAsync(
+          targetHeading,
+          { behavior: prefersReducedMotion ? 'instant' : 'smooth', block: 'start' },
+          seasonalPanel
+        );
+
+        if (scrollId !== currentScrollId) return;
+
+        setActiveDrink(targetId);
+        targetHeading.focus({ preventScroll: true });
+      });
+    });
+  </script>
