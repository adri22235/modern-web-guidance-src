+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const sections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+
+      if (!panel || sections.length === 0 || tocLinks.length === 0) return;
+
+      let isClickScrolling = false;
+      let clickScrollTimer = null;
+      let scrollSettleTimer = null;
+
+      function setActiveSection(sectionId) {
+        if (!sectionId) return;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${sectionId}`;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === sectionId;
+          section.classList.toggle('active', isMatch);
+        });
+      }
+
+      function getSettledSection() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        for (const section of sections) {
+          const header = section.querySelector('header, h3') || section;
+          const headerRect = header.getBoundingClientRect();
+          const distance = Math.abs(headerRect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        }
+        return closestSection;
+      }
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+
+          isClickScrolling = true;
+          clearTimeout(clickScrollTimer);
+          setActiveSection(targetId);
+
+          const header = targetSection.querySelector('header, h3') || targetSection;
+          const targetTop = header.offsetTop;
+
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', href);
+          }
+
+          clickScrollTimer = setTimeout(() => {
+            isClickScrolling = false;
+            const settled = getSettledSection();
+            if (settled) setActiveSection(settled.id);
+          }, 600);
+        });
+      });
+
+      panel.addEventListener('scroll', () => {
+        if (!isClickScrolling) {
+          const current = getSettledSection();
+          if (current) setActiveSection(current.id);
+        }
+
+        clearTimeout(scrollSettleTimer);
+        scrollSettleTimer = setTimeout(() => {
+          isClickScrolling = false;
+          const settled = getSettledSection();
+          if (settled) setActiveSection(settled.id);
+        }, 120);
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', () => {
+        isClickScrolling = false;
+        clearTimeout(scrollSettleTimer);
+        const settled = getSettledSection();
+        if (settled) setActiveSection(settled.id);
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (isClickScrolling) return;
+            for (const entry of entries) {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
+                setActiveSection(entry.target.id);
+              }
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.6, 0.75, 0.9]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      const initialHash = window.location.hash ? window.location.hash.slice(1) : '';
+      const initialSection = sections.find((s) => s.id === initialHash) || sections[0];
+      setActiveSection(initialSection.id);
+    })();
+  </script>
+
