+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopia Yirgacheffe', acidity: 88, body: 62, sweetness: 84, bitterness: 28, notes: ['Jasmine', 'Bergamot', 'Peach'] },
+      { name: 'Colombia Huila', acidity: 76, body: 74, sweetness: 86, bitterness: 34, notes: ['Caramel', 'Red Apple', 'Roasted Almond'] },
+      { name: 'Guatemala Antigua', acidity: 72, body: 80, sweetness: 79, bitterness: 42, notes: ['Dark Cocoa', 'Toffee', 'Orange Zest'] },
+      { name: 'Kenya AA Nyeri', acidity: 92, body: 68, sweetness: 80, bitterness: 30, notes: ['Blackcurrant', 'Grapefruit', 'Brown Sugar'] },
+      { name: 'Brazil Cerrado', acidity: 54, body: 85, sweetness: 78, bitterness: 48, notes: ['Hazelnut', 'Milk Chocolate', 'Malt'] },
+      { name: 'Sumatra Mandheling', acidity: 48, body: 92, sweetness: 70, bitterness: 56, notes: ['Cedar', 'Dark Chocolate', 'Warm Spice'] }
+    ];
+
+    const ROAST_MODIFIERS = {
+      light: { acidity: 1.15, body: 0.9, sweetness: 1.05, bitterness: 0.75, tempBase: 94 },
+      medium: { acidity: 1.0, body: 1.05, sweetness: 1.12, bitterness: 0.95, tempBase: 92 },
+      dark: { acidity: 0.78, body: 1.18, sweetness: 0.95, bitterness: 1.25, tempBase: 89 },
+      espresso: { acidity: 0.85, body: 1.25, sweetness: 1.08, bitterness: 1.15, tempBase: 93 }
+    };
+
+    const BREW_MODIFIERS = {
+      pourover: { clarity: 1.14, bodyFactor: 0.92, extractionTarget: 20.2 },
+      espresso: { clarity: 0.95, bodyFactor: 1.28, extractionTarget: 21.0 },
+      immersion: { clarity: 0.9, bodyFactor: 1.16, extractionTarget: 19.8 },
+      coldbrew: { clarity: 1.05, bodyFactor: 1.1, extractionTarget: 18.5 }
+    };
+
+    const batchSizeSelect = document.getElementById('batch-size');
+    const roastLevelSelect = document.getElementById('roast-level');
+    const brewMethodSelect = document.getElementById('brew-method');
+    const tastingFilterInput = document.getElementById('tasting-filter');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const cancelBtn = document.getElementById('cancel-simulation-btn');
+
+    const statusText = document.getElementById('simulation-status-text');
+    const progressPct = document.getElementById('simulation-progress-pct');
+    const progressBar = document.getElementById('simulation-progressbar');
+    const progressFill = document.getElementById('simulation-progress-fill');
+
+    const metricProcessed = document.getElementById('metric-processed');
+    const metricAvgScore = document.getElementById('metric-avg-score');
+    const metricYields = document.getElementById('metric-yields');
+    const metricElapsed = document.getElementById('metric-elapsed');
+    const blendResultsContainer = document.getElementById('blend-results');
+
+    let isCancelling = false;
+    let lastSimResults = [];
+
+    function generateRecipeBatch(count, roastKey, brewKey) {
+      const recipes = [];
+      for (let i = 0; i < count; i++) {
+        const primary = ORIGINS[i % ORIGINS.length];
+        const secondary = ORIGINS[(i * 7 + 3) % ORIGINS.length];
+        const tertiary = ORIGINS[(i * 13 + 5) % ORIGINS.length];
+
+        const ratioA = 45 + ((i * 17) % 35);
+        const ratioB = Math.min(100 - ratioA, 15 + ((i * 23) % 35));
+        const ratioC = 100 - ratioA - ratioB;
+
+        recipes.push({
+          id: i + 1,
+          name: `Blend #${String(i + 1).padStart(4, '0')}: ${primary.name.split(' ')[0]} / ${secondary.name.split(' ')[0]}`,
+          components: [
+            { origin: primary, weight: ratioA / 100 },
+            { origin: secondary, weight: ratioB / 100 },
+            { origin: tertiary, weight: ratioC / 100 }
+          ],
+          grindMicrons: 350 + ((i * 31) % 650),
+          waterTempC: 88 + ((i * 11) % 9),
+          roastKey,
+          brewKey
+        });
+      }
+      return recipes;
+    }
+
+    // Simulate non-trivial extraction thermodynamics and sensory balance for a single blend
+    function simulateBlendProfile(recipe) {
+      const roast = ROAST_MODIFIERS[recipe.roastKey] || ROAST_MODIFIERS.medium;
+      const brew = BREW_MODIFIERS[recipe.brewKey] || BREW_MODIFIERS.pourover;
+
+      let rawAcidity = 0;
+      let rawBody = 0;
+      let rawSweetness = 0;
+      let rawBitterness = 0;
+      const noteSet = new Set();
+
+      for (const comp of recipe.components) {
+        rawAcidity += comp.origin.acidity * comp.weight;
+        rawBody += comp.origin.body * comp.weight;
+        rawSweetness += comp.origin.sweetness * comp.weight;
+        rawBitterness += comp.origin.bitterness * comp.weight;
+        comp.origin.notes.forEach(n => noteSet.add(n));
+      }
+
+      // Multi-step extraction curve integration across 120 time steps
+      let extractionYield = 0;
+      let aromaticRetention = 1.0;
+      for (let step = 1; step <= 120; step++) {
+        const t = step / 120;
+        const diffusionRate = Math.exp(-t * (600 / recipe.grindMicrons)) * (recipe.waterTempC / roast.tempBase);
+        const kineticFactor = Math.sin(t * Math.PI) * brew.clarity + Math.cos(t * 0.5) * 0.15;
+        extractionYield += (diffusionRate * kineticFactor) * 0.28;
+        aromaticRetention -= Math.pow(diffusionRate * 0.012, 2);
+      }
+
+      const extractionDelta = Math.abs(extractionYield - brew.extractionTarget);
+      const balancePenalty = Math.min(18, extractionDelta * 1.65);
+
+      const acidity = Math.min(100, Math.max(10, Math.round(rawAcidity * roast.acidity * brew.clarity)));
+      const body = Math.min(100, Math.max(10, Math.round(rawBody * roast.body * brew.bodyFactor)));
+      const sweetness = Math.min(100, Math.max(10, Math.round(rawSweetness * roast.sweetness * Math.max(0.75, aromaticRetention))));
+      const bitterness = Math.min(100, Math.max(5, Math.round(rawBitterness * roast.bitterness * (1 + extractionDelta * 0.03))));
+
+      const harmony = (sweetness * 0.36) + (acidity * 0.26) + (body * 0.26) - (bitterness * 0.14) - balancePenalty;
+      const cuppingScore = Math.min(98.5, Math.max(72.0, 74 + harmony * 0.34));
+
+      return {
+        id: recipe.id,
+        name: recipe.name,
+        acidity,
+        body,
+        sweetness,
+        bitterness,
+        notes: Array.from(noteSet).slice(0, 4),
+        extractionYield: Number(extractionYield.toFixed(1)),
+        cuppingScore: Number(cuppingScore.toFixed(1))
+      };
+    }
+
+    function renderTopBlends(results, filterText = '') {
+      const normalizedFilter = filterText.trim().toLowerCase();
+      const filtered = normalizedFilter
+        ? results.filter(item =>
+            item.name.toLowerCase().includes(normalizedFilter) ||
+            item.notes.some(note => note.toLowerCase().includes(normalizedFilter))
+          )
+        : results;
+
+      const topBlends = filtered
+        .slice()
+        .sort((a, b) => b.cuppingScore - a.cuppingScore)
+        .slice(0, 6);
+
+      if (topBlends.length === 0) {
+        blendResultsContainer.innerHTML = '<p style="color: #6d4c41;">No simulated blends match the current tasting note filter.</p>';
+        return;
+      }
+
+      blendResultsContainer.innerHTML = topBlends.map(blend => `
+        <article class="blend-card">
+          <div class="blend-card-header">
+            <h4>${blend.name}</h4>
+            <span class="score-badge">${blend.cuppingScore} pts</span>
+          </div>
+          <div class="tasting-notes">Notes: ${blend.notes.join(', ')} &bull; Yield: ${blend.extractionYield}%</div>
+          <div class="flavor-bars">
+            <div class="flavor-bar-row">
+              <span>Sweetness</span>
+              <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.sweetness}%"></div></div>
+              <span>${blend.sweetness}</span>
+            </div>
+            <div class="flavor-bar-row">
+              <span>Acidity</span>
+              <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.acidity}%"></div></div>
+              <span>${blend.acidity}</span>
+            </div>
+            <div class="flavor-bar-row">
+              <span>Body</span>
+              <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.body}%"></div></div>
+              <span>${blend.body}</span>
+            </div>
+            <div class="flavor-bar-row">
+              <span>Bitterness</span>
+              <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.bitterness}%"></div></div>
+              <span>${blend.bitterness}</span>
+            </div>
+          </div>
+        </article>
+      `).join('');
+    }
+
+    async function processRecipeBatchWithYield(recipes) {
+      const simulatedResults = [];
+      let totalScore = 0;
+      let yieldCount = 0;
+      const startTime = performance.now();
+
+      // Set a 50ms time-based deadline (the boundary for a Long Task)
+      let deadline = performance.now() + 50;
+
+      for (const recipe of recipes) {
+        if (isCancelling) {
+          break;
+        }
+
+        const profile = simulateBlendProfile(recipe);
+        simulatedResults.push(profile);
+        totalScore += profile.cuppingScore;
+
+        // Yield to the main thread periodically when the 50ms budget is reached
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          const processed = simulatedResults.length;
+          const pct = Math.round((processed / recipes.length) * 100);
+          statusText.textContent = `Simulating flavor profiles (${processed.toLocaleString()} / ${recipes.length.toLocaleString()})...`;
+          progressPct.textContent = `${pct}%`;
+          progressBar.setAttribute('aria-valuenow', String(pct));
+          progressFill.style.width = `${pct}%`;
+          metricProcessed.textContent = processed.toLocaleString();
+          metricAvgScore.textContent = (totalScore / processed).toFixed(1);
+          metricYields.textContent = yieldCount.toLocaleString();
+          metricElapsed.textContent = `${Math.round(performance.now() - startTime)} ms`;
+
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+
+      return {
+        simulatedResults,
+        totalScore,
+        yieldCount,
+        elapsedMs: Math.round(performance.now() - startTime)
+      };
+    }
+
+    async function handleRunSimulation() {
+      const count = Number(batchSizeSelect.value) || 3000;
+      const roastKey = roastLevelSelect.value;
+      const brewKey = brewMethodSelect.value;
+
+      isCancelling = false;
+      runBtn.disabled = true;
+      cancelBtn.disabled = false;
+      statusText.textContent = `Generating ${count.toLocaleString()} recipe blends...`;
+
+      const recipes = generateRecipeBatch(count, roastKey, brewKey);
+      const { simulatedResults, totalScore, yieldCount, elapsedMs } = await processRecipeBatchWithYield(recipes);
+
+      lastSimResults = simulatedResults;
+      const processedCount = simulatedResults.length;
+      const pct = recipes.length > 0 ? Math.round((processedCount / recipes.length) * 100) : 0;
+
+      progressPct.textContent = `${pct}%`;
+      progressBar.setAttribute('aria-valuenow', String(pct));
+      progressFill.style.width = `${pct}%`;
+      metricProcessed.textContent = processedCount.toLocaleString();
+      metricAvgScore.textContent = processedCount > 0 ? (totalScore / processedCount).toFixed(1) : '—';
+      metricYields.textContent = yieldCount.toLocaleString();
+      metricElapsed.textContent = `${elapsedMs} ms`;
+
+      if (isCancelling) {
+        statusText.textContent = `Simulation paused at ${processedCount.toLocaleString()} blends (${yieldCount} main-thread yields).`;
+      } else {
+        statusText.textContent = `Completed simulation of ${processedCount.toLocaleString()} blends across ${yieldCount} non-blocking slices.`;
+      }
+
+      renderTopBlends(lastSimResults, tastingFilterInput.value);
+      runBtn.disabled = false;
+      cancelBtn.disabled = true;
+    }
+
+    runBtn.addEventListener('click', handleRunSimulation);
+    cancelBtn.addEventListener('click', () => {
+      isCancelling = true;
+    });
+    tastingFilterInput.addEventListener('input', () => {
+      if (lastSimResults.length > 0) {
+        renderTopBlends(lastSimResults, tastingFilterInput.value);
+      }
+    });
+
+    // Run an initial batch on load so users immediately see simulated blends
+    handleRunSimulation();
+  </script>
