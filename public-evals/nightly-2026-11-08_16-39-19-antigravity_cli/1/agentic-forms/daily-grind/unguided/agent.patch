+  <script>
+    (function () {
+      const form = document.getElementById('coffee-quick-order-form');
+      const resultEl = document.getElementById('order-result');
+      const bannerEl = document.getElementById('agent-status-banner');
+
+      const BASE_PRICES = {
+        'maple-oat-latte': { label: 'Maple Oat Latte', price: 5.50 },
+        'dark-roast-espresso': { label: 'Dark Roast Espresso', price: 3.75 },
+        'cold-brew': { label: 'Cold Brew', price: 4.75 },
+        'cappuccino': { label: 'Artisanal Cappuccino', price: 4.50 },
+        'pour-over': { label: 'Single-Origin Pour Over', price: 4.25 },
+        'caramel-macchiato': { label: 'House Caramel Macchiato', price: 5.25 }
+      };
+
+      const SIZE_UPCHARGE = {
+        small: 0,
+        medium: 0.75,
+        large: 1.50
+      };
+
+      function buildOrderSummary(formData) {
+        const drinkKey = String(formData.get('drink') || 'maple-oat-latte');
+        const drinkInfo = BASE_PRICES[drinkKey] || { label: drinkKey, price: 4.75 };
+        const size = String(formData.get('size') || 'medium');
+        const temperature = String(formData.get('temperature') || 'hot');
+        const milk = String(formData.get('milk') || 'oat');
+        const roast = String(formData.get('roast') || 'medium');
+        const quantity = Math.max(1, parseInt(String(formData.get('quantity') || '1'), 10) || 1);
+        const customerName = String(formData.get('customer_name') || 'Guest').trim() || 'Guest';
+        const notes = String(formData.get('notes') || '').trim();
+
+        const unitPrice = drinkInfo.price + (SIZE_UPCHARGE[size] || 0);
+        const totalPrice = (unitPrice * quantity).toFixed(2);
+        const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+
+        return {
+          status: 'confirmed',
+          orderId,
+          customerName,
+          drink: drinkKey,
+          drinkLabel: drinkInfo.label,
+          size,
+          temperature,
+          milk,
+          roast,
+          quantity,
+          notes,
+          totalPrice: '$' + totalPrice,
+          estimatedPickupMinutes: 5,
+          summary: `Order ${orderId} confirmed for ${customerName}: ${quantity}x ${size} ${temperature} ${drinkInfo.label} (${milk} milk, ${roast} roast)${notes ? ' — Notes: ' + notes : ''}. Total: $${totalPrice}. Ready for pickup in ~5 minutes.`
+        };
+      }
+
+      if (form) {
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+
+          const formData = new FormData(form);
+          const order = buildOrderSummary(formData);
+
+          if (resultEl) {
+            resultEl.classList.add('visible');
+            resultEl.innerHTML = '';
+
+            const heading = document.createElement('h3');
+            heading.textContent = `Order Confirmed (${order.orderId})`;
+
+            const summaryP = document.createElement('p');
+            summaryP.textContent = order.summary;
+
+            resultEl.appendChild(heading);
+            resultEl.appendChild(summaryP);
+          }
+
+          if (bannerEl) {
+            bannerEl.classList.remove('active');
+            bannerEl.textContent = '';
+          }
+
+          if (typeof event.respondWith === 'function') {
+            event.respondWith(
+              Promise.resolve({
+                ...order,
+                agentInvoked: Boolean(event.agentInvoked),
+                content: [{ type: 'text', text: order.summary }]
+              })
+            );
+          }
+        });
+
+        form.addEventListener('reset', function () {
+          if (resultEl) {
+            resultEl.classList.remove('visible');
+            resultEl.innerHTML = '';
+          }
+        });
+      }
+
+      const eventTargets = [window, document, document.modelContext].filter(Boolean);
+      eventTargets.forEach(function (target) {
+        if (typeof target.addEventListener !== 'function') return;
+
+        target.addEventListener('toolactivated', function (e) {
+          const toolName = (e && e.toolName) || 'quick_order_coffee';
+          if (bannerEl) {
+            bannerEl.textContent = `AI Assistant is preparing tool "${toolName}"...`;
+            bannerEl.classList.add('active');
+          }
+        });
+
+        target.addEventListener('toolcancel', function () {
+          if (bannerEl) {
+            bannerEl.classList.remove('active');
+            bannerEl.textContent = '';
+          }
+        });
+      });
+    })();
+  </script>
 </body>
 
 </html>
