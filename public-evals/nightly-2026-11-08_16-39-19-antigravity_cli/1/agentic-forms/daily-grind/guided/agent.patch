+  <script>
+    const COFFEE_CATALOG = [
+      {
+        id: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        roast: 'medium',
+        temperatures: ['hot', 'iced'],
+        milks: ['oat', 'whole', 'almond', 'coconut', 'skim'],
+        decafAvailable: true,
+        price: '$5.75',
+        notes: 'Creamy oat milk with a hint of Vermont maple syrup and warm cinnamon.',
+        keywords: ['maple', 'oat', 'latte', 'sweet', 'cinnamon', 'seasonal', 'creamy']
+      },
+      {
+        id: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        roast: 'dark',
+        temperatures: ['hot', 'iced'],
+        milks: ['black', 'whole', 'oat', 'almond', 'skim'],
+        decafAvailable: true,
+        price: '$3.50',
+        notes: 'Bold, smokey, dark chocolate finish, and perfect for a morning boost.',
+        keywords: ['dark', 'espresso', 'bold', 'smokey', 'smoky', 'chocolate', 'strong']
+      },
+      {
+        id: 'signature-cold-brew',
+        name: '18-Hour Cold Brew',
+        roast: 'medium',
+        temperatures: ['iced'],
+        milks: ['black', 'oat', 'whole', 'almond', 'coconut', 'skim'],
+        decafAvailable: false,
+        price: '$4.75',
+        notes: 'Steeped for 18 hours for maximum smoothness with cocoa and toasted nut notes.',
+        keywords: ['cold brew', 'smooth', 'cocoa', 'chocolate', 'nutty', 'iced']
+      },
+      {
+        id: 'ethiopian-pour-over',
+        name: 'Ethiopian Yirgacheffe Pour-Over',
+        roast: 'light',
+        temperatures: ['hot', 'iced'],
+        milks: ['black'],
+        decafAvailable: false,
+        price: '$5.25',
+        notes: 'Bright floral aroma with vibrant bergamot, citrus, and jasmine tea notes.',
+        keywords: ['light', 'pour-over', 'floral', 'citrus', 'bergamot', 'bright', 'tea', 'fruity']
+      },
+      {
+        id: 'honey-almond-cortado',
+        name: 'Honey Almond Cortado',
+        roast: 'medium',
+        temperatures: ['hot'],
+        milks: ['almond', 'oat', 'whole'],
+        decafAvailable: true,
+        price: '$4.95',
+        notes: 'Equal parts rich espresso and steamed toasted almond milk with wildflower honey.',
+        keywords: ['honey', 'almond', 'cortado', 'nutty', 'sweet', 'espresso']
+      },
+      {
+        id: 'velvet-swiss-decaf',
+        name: 'Swiss Water Velvet Americano',
+        roast: 'dark',
+        temperatures: ['hot', 'iced'],
+        milks: ['black', 'oat', 'whole', 'almond', 'coconut', 'skim'],
+        decafAvailable: true,
+        price: '$4.25',
+        notes: 'Full-bodied Swiss Water decaf roast featuring caramel and roasted hazelnut notes.',
+        keywords: ['decaf', 'americano', 'caramel', 'hazelnut', 'nutty', 'smooth', 'dark']
+      }
+    ];
+
+    const finderForm = document.getElementById('coffee-finder-form');
+    const statusEl = document.getElementById('finder-status');
+    const resultsGrid = document.getElementById('finder-results-grid');
+    const errorEl = document.getElementById('finder-error');
+
+    function validateFinderForm(formData) {
+      const errors = [];
+      const validRoasts = ['any', 'light', 'medium', 'dark'];
+      const validTemps = ['any', 'hot', 'iced'];
+      const validMilks = ['any', 'black', 'whole', 'skim', 'oat', 'almond', 'coconut'];
+
+      const roast = formData.get('roast') || 'any';
+      const temperature = formData.get('temperature') || 'any';
+      const milk = formData.get('milk') || 'any';
+
+      if (!validRoasts.includes(roast)) {
+        errors.push({ field: 'roast', message: 'Select a valid roast level.' });
+      }
+      if (!validTemps.includes(temperature)) {
+        errors.push({ field: 'temperature', message: 'Select a valid serving temperature.' });
+      }
+      if (!validMilks.includes(milk)) {
+        errors.push({ field: 'milk', message: 'Select a valid milk preference.' });
+      }
+      return errors;
+    }
+
+    function filterCoffees(formData) {
+      const query = (formData.get('query') || '').toString().trim().toLowerCase();
+      const roast = (formData.get('roast') || 'any').toString();
+      const temperature = (formData.get('temperature') || 'any').toString();
+      const milk = (formData.get('milk') || 'any').toString();
+      const decafOnly = formData.get('decaf') === 'true' || formData.get('decaf') === 'on';
+
+      return COFFEE_CATALOG.filter((item) => {
+        if (roast !== 'any' && item.roast !== roast) return false;
+        if (temperature !== 'any' && !item.temperatures.includes(temperature)) return false;
+        if (milk !== 'any' && !item.milks.includes(milk)) return false;
+        if (decafOnly && !item.decafAvailable) return false;
+        if (query) {
+          const haystack = `${item.name} ${item.notes} ${item.keywords.join(' ')}`.toLowerCase();
+          if (!haystack.includes(query)) return false;
+        }
+        return true;
+      });
+    }
+
+    function renderCoffeeResults(matches) {
+      resultsGrid.replaceChildren();
+
+      if (matches.length === 0) {
+        statusEl.textContent = 'No exact matches found. Try broadening your roast, milk, or flavor filter.';
+        return;
+      }
+
+      statusEl.textContent = `Found ${matches.length} matching coffee${matches.length === 1 ? '' : 's'}:`;
+
+      for (const item of matches) {
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        const title = document.createElement('h3');
+        title.textContent = `${item.name} (${item.price})`;
+
+        const desc = document.createElement('p');
+        desc.textContent = item.notes;
+
+        const meta = document.createElement('p');
+        meta.className = 'hint';
+        meta.style.marginTop = '8px';
+        meta.textContent = `Roast: ${item.roast} | Served: ${item.temperatures.join('/')}${item.decafAvailable ? ' | Decaf available' : ''}`;
+
+        const link = document.createElement('a');
+        link.href = `/order-online?item=${encodeURIComponent(item.id)}`;
+        link.className = 'btn';
+        link.textContent = 'Order This Cup';
+
+        card.append(title, desc, meta, link);
+        resultsGrid.appendChild(card);
+      }
+    }
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      errorEl.hidden = true;
+      errorEl.textContent = '';
+
+      const formData = new FormData(finderForm);
+      const validationErrors = validateFinderForm(formData);
+
+      if (validationErrors.length > 0) {
+        const errorString =
+          'Validation failed: ' +
+          validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+        errorEl.textContent = errorString;
+        errorEl.hidden = false;
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(errorString));
+        }
+        return;
+      }
+
+      const matches = filterCoffees(formData);
+      renderCoffeeResults(matches);
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        const summary = matches.length > 0
+          ? JSON.stringify({
+              count: matches.length,
+              recommendations: matches.map((m) => ({
+                id: m.id,
+                name: m.name,
+                price: m.price,
+                roast: m.roast,
+                temperatures: m.temperatures,
+                decafAvailable: m.decafAvailable,
+                notes: m.notes
+              }))
+            })
+          : 'No matching coffees found for the given criteria. Try using roast="any" or clearing the flavor query.';
+        event.respondWith(Promise.resolve(summary));
+      }
+    });
+
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', ({ toolName }) => {
+      if (toolName === 'find-coffee') {
+        statusEl.textContent = 'AI Assistant is searching the coffee menu for you...';
+      }
+    });
+
+    targetFor('toolcancel', ({ toolName }) => {
+      if (toolName === 'find-coffee') {
+        statusEl.textContent = 'Coffee search by AI Assistant was cancelled.';
+      }
+    });
+  </script>
 </body>
 
 </html>
