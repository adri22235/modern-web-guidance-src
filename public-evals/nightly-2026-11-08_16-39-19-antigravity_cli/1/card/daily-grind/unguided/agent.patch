+  <script>
+    (function () {
+      let totalItems = 0;
+      const orderCountEl = document.getElementById('order-count');
+
+      document.querySelectorAll('.card').forEach((card) => {
+        const priceDisplay = card.querySelector('[data-price-display]');
+        const form = card.querySelector('.card-order-form');
+        const feedback = card.querySelector('.order-feedback');
+        const drinkName = card.getAttribute('data-drink') || 'Drink';
+
+        card.querySelectorAll('input[type="radio"]').forEach((radio) => {
+          radio.addEventListener('change', () => {
+            if (priceDisplay && radio.dataset.price) {
+              priceDisplay.textContent = `$${ Number(radio.dataset.price).toFixed(2) }`;
+            }
+          });
+        });
+
+        if (form) {
+          form.addEventListener('submit', (event) => {
+            event.preventDefault();
+            const selected = form.querySelector('input[type="radio"]:checked');
+            const size = selected ? selected.value : 'medium';
+            const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+
+            totalItems += 1;
+            if (orderCountEl) {
+              orderCountEl.textContent = String(totalItems);
+            }
+
+            form.setAttribute('data-just-added', 'true');
+            if (feedback) {
+              feedback.textContent = `Added ${sizeLabel} ${drinkName} to order!`;
+            }
+
+            setTimeout(() => {
+              form.removeAttribute('data-just-added');
+            }, 1800);
+          });
+        }
+      });
+    })();
+  </script>
 </body>
 
