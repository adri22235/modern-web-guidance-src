+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      // Ensure scheduler.postTask and scheduler.yield are available with priority support
+      if (!globalThis.scheduler) {
+        globalThis.scheduler = {};
+      }
+
+      if (typeof globalThis.scheduler.yield !== 'function') {
+        globalThis.scheduler.yield = function () {
+          return new Promise((resolve) => setTimeout(resolve, 0));
+        };
+      }
+
+      if (typeof globalThis.scheduler.postTask !== 'function') {
+        const pendingQueue = [];
+        let isFlushing = false;
+        let seq = 0;
+
+        function flushQueue() {
+          if (pendingQueue.length === 0) {
+            isFlushing = false;
+            return;
+          }
+          pendingQueue.sort((a, b) => {
+            if (a.weight !== b.weight) return a.weight - b.weight;
+            return a.seq - b.seq;
+          });
+          const next = pendingQueue.shift();
+          Promise.resolve()
+            .then(() => next.callback())
+            .then(next.resolve, next.reject)
+            .finally(() => {
+              if (pendingQueue.length > 0) {
+                setTimeout(flushQueue, 0);
+              } else {
+                isFlushing = false;
+              }
+            });
+        }
+
+        globalThis.scheduler.postTask = function (callback, options = {}) {
+          const priority = options.priority || 'user-visible';
+          const weight = PRIORITY_WEIGHTS[priority] ?? 1;
+          return new Promise((resolve, reject) => {
+            if (options.signal?.aborted) {
+              reject(options.signal.reason || new DOMException('Task aborted', 'AbortError'));
+              return;
+            }
+            pendingQueue.push({
+              callback,
+              weight,
+              seq: seq++,
+              resolve,
+              reject
+            });
+            if (!isFlushing) {
+              isFlushing = true;
+              setTimeout(flushQueue, 0);
+            }
+          });
+        };
+      }
+
+      const taskQueueList = document.getElementById('ops-task-queue');
+      const executionLogList = document.getElementById('ops-execution-log');
+      const queuedCountEl = document.getElementById('ops-queued-count');
+      const runningCountEl = document.getElementById('ops-running-count');
+      const completedCountEl = document.getElementById('ops-completed-count');
+      const yieldCountEl = document.getElementById('ops-yield-count');
+      const uiStatusEl = document.getElementById('ops-ui-status');
+
+      let taskCounter = 0;
+      let queuedCount = 0;
+      let runningCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+      let executionOrder = 0;
+
+      function updateMetrics() {
+        queuedCountEl.textContent = String(queuedCount);
+        runningCountEl.textContent = String(runningCount);
+        completedCountEl.textContent = String(completedCount);
+        yieldCountEl.textContent = String(yieldCount);
+        uiStatusEl.textContent = runningCount > 0 ? 'Responsive (Yielding)' : 'Responsive';
+      }
+
+      function clearEmptyState(listEl) {
+        const empty = listEl.querySelector('.empty-state');
+        if (empty) {
+          empty.remove();
+        }
+      }
+
+      function ensureEmptyState(listEl, text) {
+        if (listEl.children.length === 0) {
+          const li = document.createElement('li');
+          li.className = 'empty-state';
+          li.textContent = text;
+          listEl.appendChild(li);
+        }
+      }
+
+      function doSimulatedChunkWork(durationMs) {
+        const start = performance.now();
+        let acc = 0;
+        while (performance.now() - start < durationMs) {
+          acc += Math.sqrt(Math.random() * 100);
+        }
+        return acc;
+      }
+
+      async function yieldToMain() {
+        yieldCount++;
+        updateMetrics();
+        if (typeof globalThis.scheduler?.yield === 'function') {
+          await globalThis.scheduler.yield();
+        } else {
+          await new Promise((resolve) => setTimeout(resolve, 0));
+        }
+      }
+
+      function scheduleOperationTask({ name, priority, chunks = 4, chunkDurationMs = 8 }) {
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateMetrics();
+
+        clearEmptyState(taskQueueList);
+        const taskItem = document.createElement('li');
+        taskItem.className = 'task-item';
+        taskItem.dataset.taskId = String(taskId);
+        taskItem.dataset.priority = priority;
+        taskItem.innerHTML = `
+          <div class="task-header">
+            <strong>#${taskId} ${name}</strong>
+            <span class="priority-badge priority-${priority}">${priority}</span>
+          </div>
+          <div class="task-header">
+            <span class="task-state">Queued</span>
+            <span class="task-pct">0%</span>
+          </div>
+          <div class="task-progress-track">
+            <div class="task-progress-bar"></div>
+          </div>
+        `;
+        taskQueueList.appendChild(taskItem);
+
+        const stateEl = taskItem.querySelector('.task-state');
+        const pctEl = taskItem.querySelector('.task-pct');
+        const progressBarEl = taskItem.querySelector('.task-progress-bar');
+
+        const controller = typeof TaskController !== 'undefined'
+          ? new TaskController({ priority })
+          : null;
+
+        const postTaskOptions = controller
+          ? { priority, signal: controller.signal }
+          : { priority };
+
+        return globalThis.scheduler.postTask(async () => {
+          queuedCount = Math.max(0, queuedCount - 1);
+          runningCount++;
+          updateMetrics();
+
+          const orderNum = ++executionOrder;
+          const startedAt = performance.now();
+          stateEl.textContent = 'Running';
+
+          clearEmptyState(executionLogList);
+          const logItem = document.createElement('li');
+          logItem.className = 'log-item';
+          logItem.dataset.taskId = String(taskId);
+          logItem.dataset.priority = priority;
+          logItem.dataset.order = String(orderNum);
+          logItem.innerHTML = `
+            <div class="task-header">
+              <strong>${orderNum}. ${name} (#${taskId})</strong>
+              <span class="priority-badge priority-${priority}">${priority}</span>
+            </div>
+            <div class="log-detail">Started — processing ${chunks} chunks with main-thread yields...</div>
+          `;
+          executionLogList.appendChild(logItem);
+          const logDetailEl = logItem.querySelector('.log-detail');
+
+          for (let i = 1; i <= chunks; i++) {
+            doSimulatedChunkWork(chunkDurationMs);
+            const pct = Math.round((i / chunks) * 100);
+            pctEl.textContent = `${pct}%`;
+            progressBarEl.style.width = `${pct}%`;
+
+            if (i < chunks) {
+              stateEl.textContent = `Yielding (${i}/${chunks})`;
+              await yieldToMain();
+              stateEl.textContent = 'Running';
+            }
+          }
+
+          const elapsedMs = Math.max(1, Math.round(performance.now() - startedAt));
+          runningCount = Math.max(0, runningCount - 1);
+          completedCount++;
+          updateMetrics();
+
+          stateEl.textContent = 'Completed';
+          logDetailEl.textContent = `Completed in ${elapsedMs}ms (${chunks} chunks, yielded ${chunks - 1}x)`;
+
+          setTimeout(() => {
+            taskItem.remove();
+            ensureEmptyState(taskQueueList, 'No active tasks in queue.');
+          }, 600);
+
+          return { taskId, name, priority, orderNum, elapsedMs };
+        }, postTaskOptions);
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        scheduleOperationTask({
+          name: 'Urgent Checkout Task',
+          priority: 'user-blocking',
+          chunks: 3,
+          chunkDurationMs: 6
+        });
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        scheduleOperationTask({
+          name: 'Standard Menu Update',
+          priority: 'user-visible',
+          chunks: 4,
+          chunkDurationMs: 8
+        });
+      });
+
+      document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+        scheduleOperationTask({
+          name: 'Background Telemetry Logging',
+          priority: 'background',
+          chunks: 5,
+          chunkDurationMs: 8
+        });
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        // Enqueue mixed tasks in reverse/mixed order to demonstrate priority scheduling:
+        // user-blocking (Urgent Checkout) runs before user-visible (Standard Menu Update),
+        // which runs before background (Background Telemetry Logging).
+        const batchTasks = [
+          { name: 'Background Telemetry Logging', priority: 'background', chunks: 4, chunkDurationMs: 6 },
+          { name: 'Standard Menu Update', priority: 'user-visible', chunks: 4, chunkDurationMs: 6 },
+          { name: 'Urgent Checkout Task', priority: 'user-blocking', chunks: 3, chunkDurationMs: 6 },
+          { name: 'Background Analytics Sync', priority: 'background', chunks: 4, chunkDurationMs: 6 },
+          { name: 'Menu Inventory Refresh', priority: 'user-visible', chunks: 3, chunkDurationMs: 6 },
+          { name: 'Express Order Payment', priority: 'user-blocking', chunks: 3, chunkDurationMs: 6 }
+        ];
+
+        batchTasks.forEach((task) => scheduleOperationTask(task));
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        taskQueueList.innerHTML = '<li class="empty-state">No active tasks in queue.</li>';
+        executionLogList.innerHTML = '<li class="empty-state">No tasks executed yet.</li>';
+        queuedCount = 0;
+        runningCount = 0;
+        completedCount = 0;
+        yieldCount = 0;
+        executionOrder = 0;
+        updateMetrics();
+      });
+    })();
+  </script>
 </body>
 
