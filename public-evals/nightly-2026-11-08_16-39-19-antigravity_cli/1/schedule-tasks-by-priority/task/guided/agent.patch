+  <script>
+    // Feature detect the Prioritized Task Scheduling API and load scheduler-polyfill when needed
+    let schedulerReadyPromise;
+    if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+      schedulerReadyPromise = new Promise((resolve) => {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => resolve();
+        script.onerror = () => {
+          // Graceful fallback if offline or CDN unreachable
+          window.scheduler = window.scheduler || {};
+          if (!('postTask' in window.scheduler)) {
+            const weight = { 'user-blocking': 0, 'user-visible': 5, 'background': 15 };
+            window.scheduler.postTask = (callback, options = {}) => {
+              const priority = options.priority || 'user-visible';
+              const delay = weight[priority] ?? 5;
+              return new Promise((res, rej) => {
+                setTimeout(() => {
+                  try {
+                    res(callback());
+                  } catch (err) {
+                    rej(err);
+                  }
+                }, delay);
+              });
+            };
+          }
+          resolve();
+        };
+        document.head.appendChild(script);
+      });
+    } else {
+      schedulerReadyPromise = Promise.resolve();
+    }
+
+    const logList = document.getElementById('ops-log');
+    const statusText = document.getElementById('ops-status-text');
+    const completedCountEl = document.getElementById('ops-completed-count');
+    const yieldCountEl = document.getElementById('ops-yield-count');
+
+    let taskSequence = 0;
+    let completedCount = 0;
+    let totalYields = 0;
+    let activeTasks = 0;
+
+    function appendLog(priority, message) {
+      const emptyItem = logList.querySelector('[data-empty="true"]');
+      if (emptyItem) {
+        emptyItem.remove();
+      }
+      const li = document.createElement('li');
+      const badge = document.createElement('span');
+      badge.className = `priority-badge badge-${priority}`;
+      badge.textContent = priority;
+
+      const textSpan = document.createElement('span');
+      const timestamp = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
+      textSpan.textContent = `[${timestamp}] ${message}`;
+
+      li.append(badge, textSpan);
+      logList.prepend(li);
+    }
+
+    // Break up heavy processing in 50ms slices and yield to the main thread
+    async function processOperationItems(items, onItemProcessed) {
+      let deadline = performance.now() + 50; // 50ms budget
+
+      for (const item of items) {
+        onItemProcessed(item);
+
+        if (performance.now() >= deadline) {
+          totalYields++;
+          yieldCountEl.textContent = String(totalYields);
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+    }
+
+    function simulateChunkWork(iterations) {
+      let total = 0;
+      for (let i = 0; i < iterations; i++) {
+        total += Math.sqrt(i + 1);
+      }
+      return total;
+    }
+
+    async function scheduleOperation({ label, priority, itemCount, workPerItem }) {
+      const taskId = ++taskSequence;
+      activeTasks++;
+      statusText.textContent = `Queued Task #${taskId}: ${label} (${priority}) — ${activeTasks} active`;
+      appendLog(priority, `Queued #${taskId}: ${label}`);
+
+      await schedulerReadyPromise;
+
+      // For user-visible default priority, omit or pass priority option explicitly
+      const postTaskPromise = priority === 'user-visible'
+        ? scheduler.postTask(async () => {
+            return await runOperationTask(taskId, label, priority, itemCount, workPerItem);
+          })
+        : scheduler.postTask(async () => {
+            return await runOperationTask(taskId, label, priority, itemCount, workPerItem);
+          }, { priority });
+
+      return postTaskPromise;
+    }
+
+    async function runOperationTask(taskId, label, priority, itemCount, workPerItem) {
+      const startTime = performance.now();
+      statusText.textContent = `Executing Task #${taskId}: ${label} (${priority})...`;
+      appendLog(priority, `Started #${taskId}: ${label} (${itemCount} steps)`);
+
+      const items = Array.from({ length: itemCount }, (_, idx) => idx + 1);
+      await processOperationItems(items, () => {
+        simulateChunkWork(workPerItem);
+      });
+
+      const elapsed = Math.round(performance.now() - startTime);
+      completedCount++;
+      activeTasks = Math.max(0, activeTasks - 1);
+      completedCountEl.textContent = String(completedCount);
+      statusText.textContent = activeTasks > 0
+        ? `Completed #${taskId} (${elapsed}ms) — ${activeTasks} remaining in queue`
+        : `Queue idle — last completed #${taskId}: ${label} in ${elapsed}ms`;
+      appendLog(priority, `Completed #${taskId}: ${label} in ${elapsed}ms`);
+    }
+
+    function runUrgentCheckout() {
+      return scheduleOperation({
+        label: 'Urgent Checkout Validation & Payment Auth',
+        priority: 'user-blocking',
+        itemCount: 30,
+        workPerItem: 15000
+      });
+    }
+
+    function runStandardMenuUpdate() {
+      return scheduleOperation({
+        label: 'Standard Menu & Inventory Sync',
+        priority: 'user-visible',
+        itemCount: 60,
+        workPerItem: 25000
+      });
+    }
+
+    function runBackgroundTelemetry() {
+      return scheduleOperation({
+        label: 'Background Telemetry & Analytics Flush',
+        priority: 'background',
+        itemCount: 90,
+        workPerItem: 30000
+      });
+    }
+
+    document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+      runUrgentCheckout();
+    });
+
+    document.getElementById('btn-standard-menu').addEventListener('click', () => {
+      runStandardMenuUpdate();
+    });
+
+    document.getElementById('btn-bg-telemetry').addEventListener('click', () => {
+      runBackgroundTelemetry();
+    });
+
+    document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+      appendLog('user-visible', 'Batch enqueued: Telemetry + Menu Updates + Urgent Checkouts (executing in priority order)');
+      // Enqueue in reverse priority order to demonstrate scheduler.postTask executing urgent tasks first
+      runBackgroundTelemetry();
+      runStandardMenuUpdate();
+      runBackgroundTelemetry();
+      runUrgentCheckout();
+      runStandardMenuUpdate();
+      runUrgentCheckout();
+    });
+
+    document.getElementById('btn-clear-ops').addEventListener('click', () => {
+      logList.innerHTML = '<li data-empty="true">Log cleared. Ready for new operations.</li>';
+      statusText.textContent = 'Queue idle — log cleared.';
+    });
+  </script>
