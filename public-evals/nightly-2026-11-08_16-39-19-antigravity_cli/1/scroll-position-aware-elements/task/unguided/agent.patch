+  <script>
+    (() => {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = document.querySelector('.scroll-sentinel');
+      const backToTopBtn = document.querySelector('.back-to-top');
+
+      if (!scroller || !sentinel || !backToTopBtn) return;
+
+      const setHiddenState = (hidden) => {
+        if (hidden) {
+          backToTopBtn.classList.remove('is-visible');
+          backToTopBtn.setAttribute('inert', '');
+          backToTopBtn.setAttribute('aria-hidden', 'true');
+          backToTopBtn.tabIndex = -1;
+        } else {
+          backToTopBtn.classList.add('is-visible');
+          backToTopBtn.removeAttribute('inert');
+          backToTopBtn.removeAttribute('aria-hidden');
+          backToTopBtn.tabIndex = 0;
+        }
+      };
+
+      setHiddenState(true);
+
+      const observer = new IntersectionObserver(
+        (entries) => {
+          for (const entry of entries) {
+            setHiddenState(entry.isIntersecting);
+          }
+        },
+        {
+          root: scroller,
+          threshold: 0,
+        }
+      );
+
+      observer.observe(sentinel);
+
+      backToTopBtn.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+    })();
+  </script>
