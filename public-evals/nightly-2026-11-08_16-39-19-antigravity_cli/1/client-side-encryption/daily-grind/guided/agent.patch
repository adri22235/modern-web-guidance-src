--- /dev/null
+++ b/delivery-crypto.js
@@ -0,0 +1,265 @@
+const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const DB_NAME = 'daily-grind-crypto';
+const STORE_NAME = 'keys';
+const RECIPIENT_KEY_ID = 'recipient-kem-key';
+
+export function supportsPostQuantumEnvelope(kemAlgorithm = 'MLKEM768-X25519') {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', kemAlgorithm, 'ChaCha20-Poly1305')
+  );
+}
+
+function openKeyDatabase() {
+  return new Promise((resolve, reject) => {
+    if (typeof indexedDB === 'undefined') {
+      resolve(null);
+      return;
+    }
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(STORE_NAME)) {
+        db.createObjectStore(STORE_NAME);
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+export async function loadPersistedRecipientKeyPair() {
+  const db = await openKeyDatabase();
+  if (!db) return null;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.get(RECIPIENT_KEY_ID);
+    req.onsuccess = () => resolve(req.result || null);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+export async function persistRecipientKeyPair(recipientKeyPair) {
+  const db = await openKeyDatabase();
+  if (!db) return;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const store = tx.objectStore(STORE_NAME);
+    store.put(recipientKeyPair, RECIPIENT_KEY_ID);
+    tx.oncomplete = () => resolve();
+    tx.onerror = () => reject(tx.error);
+  });
+}
+
+export async function generateRecipientKeys(preferredKem = 'MLKEM768-X25519') {
+  if (supportsPostQuantumEnvelope(preferredKem)) {
+    const recipientKeyPair = await crypto.subtle.generateKey(
+      preferredKem,
+      false,
+      ['encapsulateKey', 'decapsulateKey'],
+    );
+    await persistRecipientKeyPair(recipientKeyPair);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', recipientKeyPair.publicKey),
+    );
+    return {
+      suite: `${preferredKem}+ChaCha20-Poly1305`,
+      keyPair: recipientKeyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const recipientKeyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  await persistRecipientKeyPair(recipientKeyPair);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', recipientKeyPair.publicKey),
+  );
+  return {
+    suite: 'X25519+HKDF+AES-GCM',
+    keyPair: recipientKeyPair,
+    publicKeyBytes,
+  };
+}
+
+export async function getOrCreateRecipientKeys(preferredKem = 'MLKEM768-X25519') {
+  try {
+    const storedKeyPair = await loadPersistedRecipientKeyPair();
+    if (storedKeyPair?.privateKey) {
+      const algName = storedKeyPair.privateKey.algorithm.name;
+      const publicKey =
+        storedKeyPair.publicKey ||
+        (algName !== 'X25519' && typeof crypto.subtle.getPublicKey === 'function'
+          ? await crypto.subtle.getPublicKey(storedKeyPair.privateKey, ['encapsulateKey'])
+          : null);
+      if (publicKey) {
+        const format = algName === 'X25519' ? 'raw' : 'raw-public';
+        const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey(format, publicKey));
+        const suite =
+          algName === 'X25519'
+            ? 'X25519+HKDF+AES-GCM'
+            : `${algName}+ChaCha20-Poly1305`;
+        return {
+          suite,
+          keyPair: { publicKey, privateKey: storedKeyPair.privateKey },
+          publicKeyBytes,
+        };
+      }
+    }
+  } catch {
+    // Fall through to fresh key generation if IndexedDB read or export fails
+  }
+  return generateRecipientKeys(preferredKem);
+}
+
+async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return { sharedKey, capsuleBytes };
+}
+
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * @param {CryptoKey} key
+ * @param {string} plaintext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+export function bytesToBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(b64) {
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(b64.trim());
+  }
+  const binary = atob(b64.trim());
+  const out = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    out[i] = binary.charCodeAt(i);
+  }
+  return out;
+}
