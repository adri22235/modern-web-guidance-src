+        message: 'Please enter a valid order reference ID (at least 4 characters).',
+      },
+      {
+        input: addressInput,
+        errorEl: document.getElementById('delivery-address-error'),
+        message: 'Please provide the delivery destination address.',
+      },
+      {
+        input: noteInput,
+        errorEl: document.getElementById('delivery-note-error'),
+        message: 'Please enter the delivery note to encrypt (at least 3 characters).',
+      },
+    ];
+
+    function validateField({ input, errorEl, message }) {
+      input.setCustomValidity('');
+      if (!input.checkValidity()) {
+        input.setCustomValidity(message);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = message;
+        errorEl.hidden = false;
+        return false;
+      }
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+      return true;
+    }
+
+    for (const fieldObj of validatedFields) {
+      let edited = false;
+      fieldObj.input.addEventListener('input', () => {
+        edited = true;
+        fieldObj.input.setCustomValidity('');
+        if (fieldObj.input.checkValidity()) {
+          fieldObj.input.removeAttribute('aria-invalid');
+          fieldObj.errorEl.textContent = '';
+          fieldObj.errorEl.hidden = true;
+        }
+      });
+      fieldObj.input.addEventListener('blur', () => {
+        if (edited) {
+          validateField(fieldObj);
+        }
+      });
+    }
+
+    async function initKeys(forceRotate = false) {
+      try {
+        const recipient = forceRotate
+          ? await generateRecipientKeys('MLKEM768-X25519')
+          : await getOrCreateRecipientKeys('MLKEM768-X25519');
+        updateRecipientUI(recipient);
+        if (forceRotate) {
+          setBanner(
+            `Generated and persisted new courier key pair (${recipient.publicKeyBytes.byteLength}-byte public key) in IndexedDB.`,
+          );
+        }
+      } catch (err) {
+        setBanner(`Failed to initialize recipient keys: ${err.message}`, true);
+      }
+    }
+
+    rotateBtn.addEventListener('click', () => {
+      initKeys(true);
+    });
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+
+      let firstInvalid = null;
+      for (const fieldObj of validatedFields) {
+        const valid = validateField(fieldObj);
+        if (!valid && !firstInvalid) {
+          firstInvalid = fieldObj.input;
+        }
+      }
+      if (firstInvalid) {
+        firstInvalid.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        if (!currentRecipient) {
+          await initKeys(false);
+        }
+
+        const aad = buildAdditionalData(orderIdInput.value, addressInput.value);
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+          currentRecipient.publicKeyBytes,
+          ENVELOPE_INFO,
+        );
+        const { iv, ciphertext } = await encryptMessage(sharedKey, noteInput.value, aad);
+
+        latestEnvelope = {
+          suite: currentRecipient.suite,
+          orderId: orderIdInput.value.trim(),
+          address: addressInput.value.trim(),
+          aad,
+          capsuleBytes,
+          iv,
+          ciphertext,
+        };
+
+        capsuleSizeEl.textContent = String(capsuleBytes.byteLength);
+        capsuleOutputEl.textContent = bytesToBase64(capsuleBytes);
+        ciphertextSizeEl.textContent = String(ciphertext.byteLength);
+        ciphertextOutputEl.textContent = JSON.stringify(
+          {
+            suite: latestEnvelope.suite,
+            iv: bytesToBase64(iv),
+            ciphertext: bytesToBase64(ciphertext),
+            aadOrder: latestEnvelope.orderId,
+          },
+          null,
+          2,
+        );
+        decryptedOutputEl.textContent = 'Ready to decapsulate and verify.';
+        decryptBtn.disabled = false;
+        tamperBtn.disabled = false;
+
+        setBanner(
+          `Encrypted delivery note with ${currentRecipient.suite} using a fresh 12-byte IV and encapsulated shared secret.`,
+        );
+      } catch (err) {
+        setBanner(`Encryption error: ${err.message}`, true);
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      if (!latestEnvelope || !currentRecipient) return;
+      try {
+        const recipientKey = await decapsulateEnvelopeKey(
+          currentRecipient.keyPair.privateKey,
+          latestEnvelope.capsuleBytes,
+          ENVELOPE_INFO,
+        );
+        const plaintext = await decryptMessage(
+          recipientKey,
+          latestEnvelope.iv,
+          latestEnvelope.ciphertext,
+          latestEnvelope.aad,
+        );
+        decryptedOutputEl.textContent = plaintext;
+        setBanner('Courier decapsulated shared secret and authenticated delivery note successfully.');
+      } catch (err) {
+        decryptedOutputEl.textContent = `Decryption rejected (${err.name}): ${err.message || 'Authentication tag mismatch'}`;
+        setBanner('Decryption failed: envelope or courier key did not match.', true);
+      }
+    });
+
+    tamperBtn.addEventListener('click', async () => {
+      if (!latestEnvelope || !currentRecipient) return;
+      try {
+        const recipientKey = await decapsulateEnvelopeKey(
+          currentRecipient.keyPair.privateKey,
+          latestEnvelope.capsuleBytes,
+          ENVELOPE_INFO,
+        );
+        const tamperedAad = buildAdditionalData('DG-TAMPERED-9999', latestEnvelope.address);
+        await decryptMessage(
+          recipientKey,
+          latestEnvelope.iv,
+          latestEnvelope.ciphertext,
+          tamperedAad,
+        );
+      } catch (err) {
+        decryptedOutputEl.textContent = `Tampering detected! crypto.subtle.decrypt rejected with ${err.name || 'OperationError'}.`;
+        setBanner(
+          `AEAD authentication verified: modified AAD caused decrypt() to reject with ${err.name || 'OperationError'}.`,
+          true,
+        );
+      }
+    });
+
+    initKeys(false);
+  </script>
+
 </body>
 
 </html>
