diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Dashboard</title>
+  <script src="/js/app.js" async fetchpriority="high"></script>
+  <script src="/js/legacy-widgets.js" defer fetchpriority="low"></script>
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+  <style>
+    body {
+      font-family: system-ui, -apple-system, sans-serif;
+      margin: 2rem;
+      line-height: 1.5;
+      color: #111827;
+      background-color: #f9fafb;
+    }
+    header {
+      margin-bottom: 1.5rem;
+    }
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+      gap: 1rem;
+    }
+    .card {
+      background: #ffffff;
+      border: 1px solid #e5e7eb;
+      border-radius: 0.5rem;
+      padding: 1.25rem;
+    }
+    .card h2 {
+      font-size: 0.875rem;
+      color: #6b7280;
+      margin: 0 0 0.5rem 0;
+    }
+    .card p {
+      font-size: 1.5rem;
+      font-weight: 600;
+      margin: 0;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Dashboard</h1>
+  </header>
+  <main class="grid">
+    <section class="card">
+      <h2>System Status</h2>
+      <p id="app-status">Ready</p>
+    </section>
+    <section class="card">
+      <h2>Active Sessions</h2>
+      <p>1,248</p>
+    </section>
+    <section class="card">
+      <h2>Legacy Widgets</h2>
+      <p id="widget-container">Loaded</p>
+    </section>
+  </main>
+</body>
+</html>
