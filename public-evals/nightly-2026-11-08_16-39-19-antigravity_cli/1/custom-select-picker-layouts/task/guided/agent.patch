+  <script>
+    const roastPicker = document.getElementById('roast-picker');
+    const orderNowBtn = document.getElementById('order-now-btn');
+
+    if (roastPicker) {
+      roastPicker.addEventListener('change', () => {
+        if (orderNowBtn) {
+          orderNowBtn.href = `/order-online?roast=${encodeURIComponent(roastPicker.value)}`;
+        }
+      });
+
+      roastPicker.addEventListener('keydown', (e) => {
+        if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
+        if (!roastPicker.matches(':open')) return;
+
+        const options = Array.from(roastPicker.querySelectorAll('option'));
+        const activeOption = document.activeElement?.tagName === 'OPTION'
+          ? document.activeElement
+          : roastPicker.selectedOptions[0] || options[0];
+        if (!activeOption) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        const currentCenter = {
+          x: currentRect.left + currentRect.width / 2,
+          y: currentRect.top + currentRect.height / 2,
+        };
+
+        let bestOption = null;
+        let bestDistance = Infinity;
+
+        for (const opt of options) {
+          if (opt === activeOption) continue;
+          const rect = opt.getBoundingClientRect();
+          const center = {
+            x: rect.left + rect.width / 2,
+            y: rect.top + rect.height / 2,
+          };
+          const dx = center.x - currentCenter.x;
+          const dy = center.y - currentCenter.y;
+
+          const isMatch =
+            (e.key === 'ArrowRight' && dx > 4) ||
+            (e.key === 'ArrowLeft' && dx < -4) ||
+            (e.key === 'ArrowDown' && dy > 4) ||
+            (e.key === 'ArrowUp' && dy < -4);
+
+          if (isMatch) {
+            const dist = Math.hypot(dx, dy);
+            if (dist < bestDistance) {
+              bestDistance = dist;
+              bestOption = opt;
+            }
+          }
+        }
+
+        if (bestOption) {
+          e.preventDefault();
+          bestOption.focus();
+        }
+      });
+    }
+  </script>
