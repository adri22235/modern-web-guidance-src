+  <script>
+    const deliveryForm = document.getElementById('delivery-form');
+    const submitBtn = document.getElementById('delivery-submit-btn');
+    const statusBox = document.getElementById('delivery-status');
+
+    if (deliveryForm) {
+      deliveryForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!deliveryForm.checkValidity()) {
+          const firstInvalid = deliveryForm.querySelector(':invalid');
+          if (firstInvalid) {
+            firstInvalid.focus();
+          }
+          return;
+        }
+        submitBtn.disabled = true;
+        statusBox.textContent = 'Shipping address saved! Preparing your coffee bean delivery order...';
+        statusBox.classList.add('visible');
+      });
+    }
+  </script>
