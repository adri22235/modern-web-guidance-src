+++ b/src/components/DeveloperDiagnosticsWidget.tsx
@@ -0,0 +1,512 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import type { TargetAddressSpace } from '../../global';
+
+export type PermissionStateValue = PermissionState | 'unsupported' | 'checking';
+
+export type ConnectionState = 'idle' | 'connecting' | 'connected' | 'error';
+
+export interface EndpointDiagnostics {
+  id: 'lan-device' | 'companion-cli';
+  label: string;
+  subtitle: string;
+  url: string;
+  targetAddressSpace: TargetAddressSpace;
+  permissionName: 'local-network' | 'loopback-network';
+  permissionState: PermissionStateValue;
+  connectionState: ConnectionState;
+  statusMessage: string;
+  responsePreview: string | null;
+  latencyMs: number | null;
+  lastChecked: string | null;
+}
+
+const DEFAULT_LAN_URL = 'http://192.168.1.100:8080/diagnostics';
+const DEFAULT_CLI_URL = 'http://127.0.0.1:9229/diagnostics';
+
+async function queryLnaPermission(
+  permissionName: 'local-network' | 'loopback-network'
+): Promise<PermissionStatus | null> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return null;
+  }
+
+  try {
+    return await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+  } catch {
+    // Fallback to legacy umbrella permission name if granular permission is not supported yet
+    try {
+      return await navigator.permissions.query({
+        name: 'local-network-access' as PermissionName,
+      });
+    } catch {
+      return null;
+    }
+  }
+}
+
+export default function DeveloperDiagnosticsWidget() {
+  const [isSecure, setIsSecure] = useState<boolean>(true);
+  const [lanUrl, setLanUrl] = useState<string>(DEFAULT_LAN_URL);
+  const [cliUrl, setCliUrl] = useState<string>(DEFAULT_CLI_URL);
+
+  const [lanPermission, setLanPermission] = useState<PermissionStateValue>('checking');
+  const [cliPermission, setCliPermission] = useState<PermissionStateValue>('checking');
+
+  const [lanConnectionState, setLanConnectionState] = useState<ConnectionState>('idle');
+  const [cliConnectionState, setCliConnectionState] = useState<ConnectionState>('idle');
+
+  const [lanStatusMessage, setLanStatusMessage] = useState<string>(
+    'Ready to connect to private Wi-Fi LAN hardware device (targetAddressSpace: "local").'
+  );
+  const [cliStatusMessage, setCliStatusMessage] = useState<string>(
+    'Ready to connect to local companion CLI on loopback (targetAddressSpace: "loopback").'
+  );
+
+  const [lanResponse, setLanResponse] = useState<string | null>(null);
+  const [cliResponse, setCliResponse] = useState<string | null>(null);
+
+  const [lanLatency, setLanLatency] = useState<number | null>(null);
+  const [cliLatency, setCliLatency] = useState<number | null>(null);
+
+  const [lanLastChecked, setLanLastChecked] = useState<string | null>(null);
+  const [cliLastChecked, setCliLastChecked] = useState<string | null>(null);
+
+  const refreshPermissions = useCallback(async () => {
+    const [lanStatus, cliStatus] = await Promise.all([
+      queryLnaPermission('local-network'),
+      queryLnaPermission('loopback-network'),
+    ]);
+
+    if (lanStatus) {
+      setLanPermission(lanStatus.state);
+      lanStatus.onchange = () => {
+        setLanPermission(lanStatus.state);
+      };
+    } else {
+      setLanPermission('unsupported');
+    }
+
+    if (cliStatus) {
+      setCliPermission(cliStatus.state);
+      cliStatus.onchange = () => {
+        setCliPermission(cliStatus.state);
+      };
+    } else {
+      setCliPermission('unsupported');
+    }
+
+    return { lanStatus, cliStatus };
+  }, []);
+
+  useEffect(() => {
+    if (typeof window !== 'undefined') {
+      setIsSecure(window.isSecureContext);
+    }
+
+    let lanPermObj: PermissionStatus | null = null;
+    let cliPermObj: PermissionStatus | null = null;
+
+    refreshPermissions().then(({ lanStatus, cliStatus }) => {
+      lanPermObj = lanStatus;
+      cliPermObj = cliStatus;
+    });
+
+    return () => {
+      if (lanPermObj) lanPermObj.onchange = null;
+      if (cliPermObj) cliPermObj.onchange = null;
+    };
+  }, [refreshPermissions]);
+
+  const connectToLanDevice = async () => {
+    setLanConnectionState('connecting');
+    setLanStatusMessage(
+      `Connecting to ${lanUrl} with targetAddressSpace: "local"...`
+    );
+    setLanResponse(null);
+    const startTime = performance.now();
+
+    try {
+      const requestInit: RequestInit = {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'local',
+        headers: {
+          Accept: 'application/json, text/plain, */*',
+        },
+      };
+
+      const request = new Request(lanUrl, requestInit);
+      const response = await fetch(request, requestInit);
+      const elapsed = Math.round(performance.now() - startTime);
+      setLanLatency(elapsed);
+      setLanLastChecked(new Date().toLocaleTimeString());
+
+      const text = await response.text();
+      setLanResponse(text || `HTTP ${response.status} ${response.statusText}`);
+
+      if (response.ok) {
+        setLanConnectionState('connected');
+        setLanStatusMessage(
+          `Connected to LAN hardware device (${response.status} OK in ${elapsed}ms)`
+        );
+      } else {
+        setLanConnectionState('error');
+        setLanStatusMessage(
+          `LAN device responded with HTTP ${response.status} ${response.statusText}`
+        );
+      }
+    } catch (err: unknown) {
+      const elapsed = Math.round(performance.now() - startTime);
+      setLanLatency(elapsed);
+      setLanLastChecked(new Date().toLocaleTimeString());
+      setLanConnectionState('error');
+
+      const errorMessage = err instanceof Error ? err.message : String(err);
+      setLanStatusMessage(
+        `Connection failed (${errorMessage}). Verify the hardware test device at ${lanUrl} is reachable on your private Wi-Fi LAN, sends CORS headers, and that the "local-network" permission is granted.`
+      );
+    } finally {
+      await refreshPermissions();
+    }
+  };
+
+  const connectToCompanionCli = async () => {
+    setCliConnectionState('connecting');
+    setCliStatusMessage(
+      `Connecting to ${cliUrl} with targetAddressSpace: "loopback"...`
+    );
+    setCliResponse(null);
+    const startTime = performance.now();
+
+    try {
+      const requestInit: RequestInit = {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'loopback',
+        headers: {
+          Accept: 'application/json, text/plain, */*',
+        },
+      };
+
+      const request = new Request(cliUrl, requestInit);
+      const response = await fetch(request, requestInit);
+      const elapsed = Math.round(performance.now() - startTime);
+      setCliLatency(elapsed);
+      setCliLastChecked(new Date().toLocaleTimeString());
+
+      const text = await response.text();
+      setCliResponse(text || `HTTP ${response.status} ${response.statusText}`);
+
+      if (response.ok) {
+        setCliConnectionState('connected');
+        setCliStatusMessage(
+          `Connected to local companion CLI (${response.status} OK in ${elapsed}ms)`
+        );
+      } else {
+        setCliConnectionState('error');
+        setCliStatusMessage(
+          `Companion CLI responded with HTTP ${response.status} ${response.statusText}`
+        );
+      }
+    } catch (err: unknown) {
+      const elapsed = Math.round(performance.now() - startTime);
+      setCliLatency(elapsed);
+      setCliLastChecked(new Date().toLocaleTimeString());
+      setCliConnectionState('error');
+
+      const errorMessage = err instanceof Error ? err.message : String(err);
+      setCliStatusMessage(
+        `Connection failed (${errorMessage}). Ensure the local companion CLI is running on ${cliUrl}, allows CORS, and that the "loopback-network" permission is granted.`
+      );
+    } finally {
+      await refreshPermissions();
+    }
+  };
+
+  const connectBoth = async () => {
+    await Promise.all([connectToLanDevice(), connectToCompanionCli()]);
+  };
+
+  const renderPermissionBadge = (
+    permissionName: 'local-network' | 'loopback-network',
+    state: PermissionStateValue
+  ) => {
+    const styles: Record<PermissionStateValue, string> = {
+      granted: 'bg-green-100 text-green-800 border-green-300',
+      prompt: 'bg-amber-100 text-amber-800 border-amber-300',
+      denied: 'bg-red-100 text-red-800 border-red-300',
+      unsupported: 'bg-gray-100 text-gray-700 border-gray-300',
+      checking: 'bg-blue-50 text-blue-700 border-blue-200',
+    };
+
+    return (
+      <span
+        className={`inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono border ${styles[state]}`}
+        title={`Permissions API state for "${permissionName}"`}
+      >
+        {permissionName}: {state}
+      </span>
+    );
+  };
+
+  const renderConnectionBadge = (state: ConnectionState) => {
+    const styles: Record<ConnectionState, string> = {
+      idle: 'bg-gray-100 text-gray-700',
+      connecting: 'bg-amber-100 text-amber-800 animate-pulse',
+      connected: 'bg-green-100 text-green-800',
+      error: 'bg-red-100 text-red-800',
+    };
+
+    const labels: Record<ConnectionState, string> = {
+      idle: 'Idle',
+      connecting: 'Connecting...',
+      connected: 'Connected',
+      error: 'Unreachable / Blocked',
+    };
+
+    return (
+      <span className={`inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${styles[state]}`}>
+        {labels[state]}
+      </span>
+    );
+  };
+
+  return (
+    <section
+      id="developer-diagnostics"
+      aria-label="Developer Diagnostics Connection Widget"
+      className="bg-gray-50 border border-gray-300 rounded-md p-4 md:p-6 my-6 shadow-xs text-left"
+    >
+      <div className="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 mb-4 gap-3">
+        <div>
+          <div className="flex items-center gap-2">
+            <span className="inline-block w-2.5 h-2.5 rounded-full bg-amber-500"></span>
+            <h2 className="text-xl font-bold text-gray-900">
+              Developer Diagnostics Bridge (Local Network Access)
+            </h2>
+          </div>
+          <p className="text-sm text-gray-600 mt-1">
+            Connect directly from your browser to a hardware test device on your private Wi-Fi LAN (
+            <code className="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded">192.168.1.x</code>,{' '}
+            <code className="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded">
+              targetAddressSpace: &quot;local&quot;
+            </code>
+            ) and a local companion CLI on your machine (
+            <code className="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded">127.0.0.1</code>,{' '}
+            <code className="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded">
+              targetAddressSpace: &quot;loopback&quot;
+            </code>
+            ).
+          </p>
+        </div>
+
+        <div className="flex items-center gap-2 shrink-0">
+          <button
+            type="button"
+            onClick={refreshPermissions}
+            className="text-xs font-semibold px-3 py-2 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 cursor-pointer"
+          >
+            Refresh Permissions
+          </button>
+          <button
+            type="button"
+            onClick={connectBoth}
+            className="text-xs font-semibold px-3 py-2 rounded bg-gray-900 text-white hover:bg-gray-700 cursor-pointer"
+          >
+            Connect Both Endpoints
+          </button>
+        </div>
+      </div>
+
+      {!isSecure && (
+        <div className="mb-4 p-3 rounded bg-amber-50 border border-amber-300 text-xs text-amber-900">
+          <strong>Secure Context Required:</strong> Local Network Access (
+          <code className="font-mono">local-network</code> and{' '}
+          <code className="font-mono">loopback-network</code>) requires a secure context (HTTPS) in
+          order for the browser to grant permissions and exempt local endpoints from Mixed Content
+          blocking.
+        </div>
+      )}
+
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
+        {/* Card 1: Private Wi-Fi LAN Hardware Test Device */}
+        <div
+          data-testid="lan-device-card"
+          className="bg-white border border-gray-200 rounded p-4 flex flex-col justify-between"
+        >
+          <div>
+            <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
+              <h3 className="font-bold text-gray-900 text-base">
+                1. Hardware Test Device (Private Wi-Fi LAN)
+              </h3>
+              {renderConnectionBadge(lanConnectionState)}
+            </div>
+
+            <p className="text-xs text-gray-600 mb-3">
+              Targets RFC 1918 private network ranges (e.g.,{' '}
+              <code className="font-mono">192.168.1.x</code>) using{' '}
+              <code className="font-mono">targetAddressSpace: &quot;local&quot;</code> and the{' '}
+              <code className="font-mono">local-network</code> permission.
+            </p>
+
+            <div className="flex flex-wrap items-center gap-2 mb-3">
+              {renderPermissionBadge('local-network', lanPermission)}
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-gray-100 text-gray-800 border border-gray-300">
+                targetAddressSpace: &quot;local&quot;
+              </span>
+            </div>
+
+            <label
+              htmlFor="lan-device-url"
+              className="block text-xs font-semibold text-gray-700 mb-1"
+            >
+              LAN Hardware Device Endpoint URL
+            </label>
+            <div className="flex gap-2 mb-3">
+              <input
+                id="lan-device-url"
+                type="url"
+                value={lanUrl}
+                onChange={(e) => setLanUrl(e.target.value)}
+                placeholder="http://192.168.1.100:8080/diagnostics"
+                className="flex-1 text-xs font-mono border border-gray-300 rounded px-2.5 py-1.5 text-gray-900 focus:outline-none focus:border-gray-900"
+              />
+              <button
+                type="button"
+                data-testid="connect-lan-button"
+                onClick={connectToLanDevice}
+                disabled={lanConnectionState === 'connecting'}
+                className="bg-amber-500 hover:bg-amber-600 disabled:opacity-50 text-gray-900 font-semibold text-xs px-3 py-1.5 rounded whitespace-nowrap cursor-pointer"
+              >
+                {lanConnectionState === 'connecting' ? 'Connecting...' : 'Connect LAN Device'}
+              </button>
+            </div>
+
+            {lanPermission === 'prompt' && (
+              <p className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded p-2 mb-3">
+                Permission is currently <strong>prompt</strong>. Clicking{' '}
+                <strong>Connect LAN Device</strong> will trigger your browser&apos;s Local Network
+                Access prompt for <code className="font-mono">local-network</code>.
+              </p>
+            )}
+
+            {lanPermission === 'denied' && (
+              <p className="text-xs text-red-800 bg-red-50 border border-red-200 rounded p-2 mb-3">
+                <strong>Permission Denied:</strong> Access to{' '}
+                <code className="font-mono">local-network</code> is blocked. Open your browser&apos;s
+                Site Settings (click the tune/lock icon in the address bar) and set{' '}
+                <strong>Local network</strong> access to <strong>Allow</strong>.
+              </p>
+            )}
+          </div>
+
+          <div className="mt-2 pt-3 border-t border-gray-100 text-xs">
+            <div className="text-gray-700 font-medium mb-1">Diagnostics Status:</div>
+            <p className="text-gray-600 font-mono break-words">{lanStatusMessage}</p>
+            {lanLastChecked && (
+              <p className="text-gray-400 mt-1">
+                Last checked: {lanLastChecked}
+                {lanLatency !== null ? ` (${lanLatency}ms)` : ''}
+              </p>
+            )}
+            {lanResponse && (
+              <pre className="mt-2 p-2 bg-gray-900 text-green-400 rounded text-xs font-mono overflow-x-auto max-h-32">
+                {lanResponse}
+              </pre>
+            )}
+          </div>
+        </div>
+
+        {/* Card 2: Local Companion CLI (Loopback 127.0.0.1) */}
+        <div
+          data-testid="companion-cli-card"
+          className="bg-white border border-gray-200 rounded p-4 flex flex-col justify-between"
+        >
+          <div>
+            <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
+              <h3 className="font-bold text-gray-900 text-base">
+                2. Local Companion CLI (127.0.0.1 Loopback)
+              </h3>
+              {renderConnectionBadge(cliConnectionState)}
+            </div>
+
+            <p className="text-xs text-gray-600 mb-3">
+              Targets the local machine loopback interface (<code className="font-mono">127.0.0.1</code>{' '}
+              / <code className="font-mono">localhost</code>) using{' '}
+              <code className="font-mono">targetAddressSpace: &quot;loopback&quot;</code> and the{' '}
+              <code className="font-mono">loopback-network</code> permission.
+            </p>
+
+            <div className="flex flex-wrap items-center gap-2 mb-3">
+              {renderPermissionBadge('loopback-network', cliPermission)}
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-gray-100 text-gray-800 border border-gray-300">
+                targetAddressSpace: &quot;loopback&quot;
+              </span>
+            </div>
+
+            <label
+              htmlFor="companion-cli-url"
+              className="block text-xs font-semibold text-gray-700 mb-1"
+            >
+              Local Companion CLI Endpoint URL
+            </label>
+            <div className="flex gap-2 mb-3">
+              <input
+                id="companion-cli-url"
+                type="url"
+                value={cliUrl}
+                onChange={(e) => setCliUrl(e.target.value)}
+                placeholder="http://127.0.0.1:9229/diagnostics"
+                className="flex-1 text-xs font-mono border border-gray-300 rounded px-2.5 py-1.5 text-gray-900 focus:outline-none focus:border-gray-900"
+              />
+              <button
+                type="button"
+                data-testid="connect-cli-button"
+                onClick={connectToCompanionCli}
+                disabled={cliConnectionState === 'connecting'}
+                className="bg-gray-800 hover:bg-gray-700 disabled:opacity-50 text-white font-semibold text-xs px-3 py-1.5 rounded whitespace-nowrap cursor-pointer"
+              >
+                {cliConnectionState === 'connecting' ? 'Connecting...' : 'Connect Companion CLI'}
+              </button>
+            </div>
+
+            {cliPermission === 'prompt' && (
+              <p className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded p-2 mb-3">
+                Permission is currently <strong>prompt</strong>. Clicking{' '}
+                <strong>Connect Companion CLI</strong> will trigger your browser&apos;s Local Network
+                Access prompt for <code className="font-mono">loopback-network</code>.
+              </p>
+            )}
+
+            {cliPermission === 'denied' && (
+              <p className="text-xs text-red-800 bg-red-50 border border-red-200 rounded p-2 mb-3">
+                <strong>Permission Denied:</strong> Access to{' '}
+                <code className="font-mono">loopback-network</code> is blocked. Open your
+                browser&apos;s Site Settings and set <strong>Loopback / Device apps</strong> access to{' '}
+                <strong>Allow</strong>.
+              </p>
+            )}
+          </div>
+
+          <div className="mt-2 pt-3 border-t border-gray-100 text-xs">
+            <div className="text-gray-700 font-medium mb-1">Diagnostics Status:</div>
+            <p className="text-gray-600 font-mono break-words">{cliStatusMessage}</p>
+            {cliLastChecked && (
+              <p className="text-gray-400 mt-1">
+                Last checked: {cliLastChecked}
+                {cliLatency !== null ? ` (${cliLatency}ms)` : ''}
+              </p>
+            )}
+            {cliResponse && (
+              <pre className="mt-2 p-2 bg-gray-900 text-green-400 rounded text-xs font-mono overflow-x-auto max-h-32">
+                {cliResponse}
+              </pre>
+            )}
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
