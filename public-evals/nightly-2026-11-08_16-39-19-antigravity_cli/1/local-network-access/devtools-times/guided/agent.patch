diff --git a/src/utils/localNetworkDiagnostics.ts b/src/utils/localNetworkDiagnostics.ts
new file mode 100644
index 0000000..4cf8d8e
--- /dev/null
+++ b/src/utils/localNetworkDiagnostics.ts
@@ -0,0 +1,211 @@
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type LnaPermissionState = PermissionState;
+
+export interface HardwareDeviceStatus {
+  deviceName?: string;
+  firmwareVersion?: string;
+  ipAddress?: string;
+  wifiRssiDbm?: number;
+  cpuTempCelsius?: number;
+  status: string;
+  timestamp: string;
+  [key: string]: unknown;
+}
+
+export interface CompanionCliHealth {
+  cliVersion?: string;
+  pid?: number;
+  loopbackHost?: string;
+  inspectorPort?: number;
+  activeTargets?: number;
+  status: string;
+  timestamp: string;
+  [key: string]: unknown;
+}
+
+/**
+ * Cross-browser permission check for the granular Local Network Access permissions
+ * ('local-network' and 'loopback-network').
+ *
+ * Never queries the legacy combined permission name 'local-network-access',
+ * which crashes older Chrome renderer processes.
+ * If the browser does not recognize the granular PermissionName and throws a TypeError,
+ * falls back to 'prompt' so requests remain gated on an explicit user gesture.
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName,
+  onStateChange?: (state: LnaPermissionState) => void
+): Promise<{ state: LnaPermissionState; unsubscribe: () => void }> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return { state: 'prompt', unsubscribe: () => {} };
+  }
+
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+
+    const handleChange = () => {
+      onStateChange?.(status.state);
+    };
+
+    status.addEventListener('change', handleChange);
+    return {
+      state: status.state,
+      unsubscribe: () => status.removeEventListener('change', handleChange),
+    };
+  } catch {
+    // Unrecognized PermissionName in browsers without LNA support; proceed on user gesture
+    return { state: 'prompt', unsubscribe: () => {} };
+  }
+}
+
+/**
+ * Connects to a hardware test device on the reader's private Wi-Fi LAN
+ * (e.g., 192.168.1.x, 10.x.x.x, 172.16.x.x, or .local mDNS).
+ *
+ * Explicitly declares `targetAddressSpace: 'local'` so the browser exempts the
+ * `http://` LAN request from Mixed Content blocking ahead of DNS resolution and
+ * verifies that the resolved IP address belongs to the `local` address space.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  signal?: AbortSignal
+): Promise<HardwareDeviceStatus> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+    signal,
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Hardware test device responded with HTTP ${response.status}`);
+  }
+  const data = await response.json();
+  return {
+    status: 'online',
+    timestamp: new Date().toISOString(),
+    ...data,
+  };
+}
+
+/**
+ * Connects to a local companion CLI running on the reader's own machine
+ * (`127.0.0.1`, `[::1]`, or `localhost`).
+ *
+ * Explicitly declares `targetAddressSpace: 'loopback'` so the browser exempts the
+ * `http://` loopback request from Mixed Content blocking ahead of DNS resolution and
+ * verifies that the resolved IP address belongs to the `loopback` address space.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  signal?: AbortSignal
+): Promise<CompanionCliHealth> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+    signal,
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion CLI responded with HTTP ${response.status}`);
+  }
+  const data = await response.json();
+  return {
+    status: 'ready',
+    timestamp: new Date().toISOString(),
+    ...data,
+  };
+}
+
+/**
+ * Opens a real-time telemetry WebSocket connection to a local LAN device or loopback companion CLI.
+ *
+ * Note: The `WebSocket(url, protocols)` constructor only accepts a subprotocol string or array
+ * as its second argument—never pass a `{ targetAddressSpace }` options object, which throws a `SyntaxError`.
+ */
+export function openLocalWebSocket(wsUrl = 'ws://192.168.1.100:8080/stream'): WebSocket {
+  const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+  return socket;
+}
+
+/**
+ * Validates that a URL targets a private Wi-Fi LAN (`local`) endpoint.
+ */
+export function validateLocalLanUrl(value: string): string {
+  const trimmed = value.trim();
+  if (!trimmed) {
+    return 'Please enter the hardware test device URL (for example, http://192.168.1.100:8080/api/status).';
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(trimmed);
+  } catch {
+    return 'Please enter a valid URL starting with http:// or https:// (for example, http://192.168.1.100:8080/api/status).';
+  }
+  if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+    return 'Protocol must be http:// or https://.';
+  }
+  const host = parsed.hostname.toLowerCase();
+  const isRfc1918OrLocal =
+    /^192\.168\.\d{1,3}\.\d{1,3}$/.test(host) ||
+    /^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(host) ||
+    /^172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}$/.test(host) ||
+    /^169\.254\.\d{1,3}\.\d{1,3}$/.test(host) ||
+    host.endsWith('.local') ||
+    host.startsWith('[fe80:') ||
+    host.startsWith('[fc') ||
+    host.startsWith('[fd');
+
+  if (!isRfc1918OrLocal) {
+    return 'Enter a private Wi-Fi LAN address (such as 192.168.1.x, 10.x.x.x, 172.16.x.x, or a .local hostname).';
+  }
+  return '';
+}
+
+/**
+ * Validates that a URL targets a loopback (`127.0.0.1`, `[::1]`, or `localhost`) endpoint.
+ */
+export function validateLoopbackCliUrl(value: string): string {
+  const trimmed = value.trim();
+  if (!trimmed) {
+    return 'Please enter the local companion CLI URL (for example, http://127.0.0.1:45678/health).';
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(trimmed);
+  } catch {
+    return 'Please enter a valid URL starting with http:// or https:// (for example, http://127.0.0.1:45678/health).';
+  }
+  if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+    return 'Protocol must be http:// or https://.';
+  }
+  const host = parsed.hostname.toLowerCase();
+  const isLoopback =
+    /^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(host) ||
+    host === '[::1]' ||
+    host === 'localhost' ||
+    host.endsWith('.localhost');
+
+  if (!isLoopback) {
+    return 'Enter a loopback address on your machine (127.0.0.1, [::1], or localhost).';
+  }
+  return '';
+}
+
+/**
+ * Derives a `ws://` or `wss://` telemetry URL from an HTTP diagnostics URL.
+ */
+export function toTelemetryWebSocketUrl(httpUrl: string): string {
+  const parsed = new URL(httpUrl.trim());
+  parsed.protocol = parsed.protocol === 'https:' ? 'wss:' : 'ws:';
+  parsed.pathname = '/stream';
+  parsed.search = '';
+  return parsed.toString();
+}
