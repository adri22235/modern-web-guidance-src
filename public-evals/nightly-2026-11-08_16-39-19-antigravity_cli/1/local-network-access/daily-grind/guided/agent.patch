+        loopbackOutput.textContent = `Connected to Desktop Helper: ${JSON.stringify(data, null, 2)}`;
+        if (remediationBox) remediationBox.hidden = true;
+        await checkNetworkPermission('loopback-network');
+      } catch (err) {
+        const reason = err instanceof Error ? err.message : String(err);
+        loopbackOutput.textContent = `Connection failed (${reason}). Ensure the companion app is running on 127.0.0.1 and allowed under Loopback network permission.`;
+        if (remediationBox) remediationBox.hidden = false;
+        await checkNetworkPermission('loopback-network');
+      } finally {
+        loopbackConnectBtn.disabled = false;
+      }
+    }
+
+    lanForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!validateUrlField(lanUrlInput, lanError, 'brewer LAN endpoint')) {
+        lanUrlInput.focus();
+        return;
+      }
+      await handleLanBrewerConnect(lanUrlInput.value.trim());
+    });
+
+    lanWsBtn.addEventListener('click', () => {
+      const wsUrl = lanWsInput.value.trim();
+      if (wsUrl) {
+        openEquipmentWebSocket(wsUrl, 'local-network', lanOutput);
+      }
+    });
+
+    loopbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!validateUrlField(loopbackUrlInput, loopbackError, 'companion helper endpoint')) {
+        loopbackUrlInput.focus();
+        return;
+      }
+      await handleLoopbackHelperConnect(loopbackUrlInput.value.trim());
+    });
+
+    loopbackWsBtn.addEventListener('click', () => {
+      const wsUrl = loopbackWsInput.value.trim();
+      if (wsUrl) {
+        openEquipmentWebSocket(wsUrl, 'loopback-network', loopbackOutput);
+      }
+    });
+
+    // Pre-check granular Local Network Access permissions on load.
+    // Only auto-connect if permission is already 'granted'; never fire requests unconditionally when 'prompt' or 'denied'.
+    async function initEquipmentConnections() {
+      const [localState, loopbackState] = await Promise.all([
+        checkNetworkPermission('local-network'),
+        checkNetworkPermission('loopback-network'),
+      ]);
+
+      if (localState === 'granted') {
+        handleLanBrewerConnect(lanUrlInput.value.trim());
+      }
+      if (loopbackState === 'granted') {
+        handleLoopbackHelperConnect(loopbackUrlInput.value.trim());
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
 </body>
 
