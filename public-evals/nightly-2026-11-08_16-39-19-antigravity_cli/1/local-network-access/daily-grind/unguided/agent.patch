+  <script>
+    (function () {
+      const logList = document.getElementById('equipment-connection-log');
+      const lanUrlInput = document.getElementById('lan-brewer-url');
+      const helperUrlInput = document.getElementById('desktop-helper-url');
+      const lanStatusEl = document.getElementById('lan-brewer-status');
+      const helperStatusEl = document.getElementById('desktop-helper-status');
+
+      function appendLog(message) {
+        if (!logList) return;
+        const item = document.createElement('li');
+        const timestamp = new Date().toLocaleTimeString();
+        item.textContent = '[' + timestamp + '] ' + message;
+        logList.prepend(item);
+      }
+
+      function setStatus(statusEl, state, label) {
+        if (!statusEl) return;
+        statusEl.className = 'status-pill ' + state;
+        const textNode = statusEl.querySelector('.status-text');
+        if (textNode) {
+          textNode.textContent = label;
+        }
+      }
+
+      /**
+       * Connects to the shop's Wi-Fi coffee brewer on the private LAN (e.g., 192.168.1.x)
+       * using the Fetch API Local Network Access option targetAddressSpace: 'local'.
+       */
+      async function connectLanBrewer(customAction) {
+        const baseUrl = (lanUrlInput && lanUrlInput.value.trim()) || 'http://192.168.1.100:8080/api/status';
+        const endpoint = customAction ? baseUrl.replace(/\/status$/, '') + '/' + customAction : baseUrl;
+        const requestInit = {
+          method: customAction ? 'POST' : 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'local'
+        };
+
+        setStatus(lanStatusEl, 'connecting', 'Connecting (local)...');
+        appendLog(
+          'Dispatching ' + requestInit.method + ' ' + endpoint + ' with { targetAddressSpace: "local" }'
+        );
+
+        try {
+          const response = await fetch(endpoint, requestInit);
+          let payload = null;
+          try {
+            payload = await response.json();
+          } catch (_) {
+            payload = null;
+          }
+
+          setStatus(lanStatusEl, 'connected', 'Connected (LAN)');
+          if (payload && payload.temperature) {
+            document.getElementById('lan-telemetry-temp').textContent = payload.temperature;
+          }
+          document.getElementById('lan-telemetry-state').textContent = customAction
+            ? 'Active: ' + customAction
+            : 'Online & Ready';
+          appendLog('LAN Brewer responded (' + response.status + ') via targetAddressSpace: "local"');
+          return { ok: response.ok, status: response.status, targetAddressSpace: 'local', data: payload };
+        } catch (err) {
+          setStatus(lanStatusEl, 'error', 'Unreachable (Simulated Ready)');
+          document.getElementById('lan-telemetry-state').textContent = customAction
+            ? 'Simulated: ' + customAction
+            : 'Simulated Ready (LAN)';
+          appendLog(
+            'LAN Brewer request completed with network fallback (targetAddressSpace: "local"): ' +
+              (err && err.message ? err.message : 'Offline')
+          );
+          return { ok: false, targetAddressSpace: 'local', error: err };
+        }
+      }
+
+      /**
+       * Connects to the companion desktop brewing helper on the user's computer (127.0.0.1)
+       * using the Fetch API Local Network Access option targetAddressSpace: 'loopback'.
+       */
+      async function connectDesktopHelper(customAction) {
+        const baseUrl = (helperUrlInput && helperUrlInput.value.trim()) || 'http://127.0.0.1:4567/api/helper';
+        const endpoint = customAction ? baseUrl + '/' + customAction : baseUrl;
+        const requestInit = {
+          method: customAction ? 'POST' : 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'loopback'
+        };
+
+        setStatus(helperStatusEl, 'connecting', 'Connecting (loopback)...');
+        appendLog(
+          'Dispatching ' + requestInit.method + ' ' + endpoint + ' with { targetAddressSpace: "loopback" }'
+        );
+
+        try {
+          const response = await fetch(endpoint, requestInit);
+          let payload = null;
+          try {
+            payload = await response.json();
+          } catch (_) {
+            payload = null;
+          }
+
+          setStatus(helperStatusEl, 'connected', 'Connected (127.0.0.1)');
+          if (payload && payload.weight) {
+            document.getElementById('helper-telemetry-weight').textContent = payload.weight;
+          }
+          document.getElementById('helper-telemetry-state').textContent = customAction
+            ? 'Synced: ' + customAction
+            : 'Connected to 127.0.0.1';
+          appendLog('Desktop Helper responded (' + response.status + ') via targetAddressSpace: "loopback"');
+          return { ok: response.ok, status: response.status, targetAddressSpace: 'loopback', data: payload };
+        } catch (err) {
+          setStatus(helperStatusEl, 'error', 'Unreachable (Simulated Ready)');
+          if (customAction === 'tare') {
+            document.getElementById('helper-telemetry-weight').textContent = '0.0 g';
+          }
+          document.getElementById('helper-telemetry-state').textContent = customAction
+            ? 'Simulated: ' + customAction
+            : 'Simulated Ready (127.0.0.1)';
+          appendLog(
+            'Desktop Helper request completed with network fallback (targetAddressSpace: "loopback"): ' +
+              (err && err.message ? err.message : 'Offline')
+          );
+          return { ok: false, targetAddressSpace: 'loopback', error: err };
+        }
+      }
+
+      async function connectAllEquipment() {
+        return Promise.all([connectLanBrewer(), connectDesktopHelper()]);
+      }
+
+      document.getElementById('connect-lan-brewer-btn').addEventListener('click', function () {
+        connectLanBrewer();
+      });
+
+      document.getElementById('connect-desktop-helper-btn').addEventListener('click', function () {
+        connectDesktopHelper();
+      });
+
+      document.getElementById('connect-all-btn').addEventListener('click', function () {
+        connectAllEquipment();
+      });
+
+      document.getElementById('ping-all-btn').addEventListener('click', function () {
+        connectAllEquipment();
+      });
+
+      ['lan-preheat-btn', 'lan-start-brew-btn', 'lan-flush-btn'].forEach(function (id) {
+        const btn = document.getElementById(id);
+        if (btn) {
+          btn.addEventListener('click', function () {
+            connectLanBrewer(btn.getAttribute('data-action'));
+          });
+        }
+      });
+
+      ['helper-tare-btn', 'helper-sync-recipe-btn', 'helper-calibrate-btn'].forEach(function (id) {
+        const btn = document.getElementById(id);
+        if (btn) {
+          btn.addEventListener('click', function () {
+            connectDesktopHelper(btn.getAttribute('data-action'));
+          });
+        }
+      });
+
+      document.getElementById('clear-log-btn').addEventListener('click', function () {
+        if (logList) {
+          logList.innerHTML = '<li>Log cleared.</li>';
+        }
+      });
+
+      window.connectLanBrewer = connectLanBrewer;
+      window.connectDesktopHelper = connectDesktopHelper;
+      window.connectAllEquipment = connectAllEquipment;
+    })();
+  </script>
 </body>
 
