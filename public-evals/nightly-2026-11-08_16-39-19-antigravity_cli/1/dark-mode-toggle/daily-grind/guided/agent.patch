+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggleBtn = document.getElementById('theme-toggle');
+      const darkMedia = window.matchMedia('(prefers-color-scheme: dark)');
+
+      toggleBtn.addEventListener('click', () => {
+        const systemScheme = darkMedia.matches ? 'dark' : 'light';
+        let storedScheme = null;
+        try {
+          storedScheme = localStorage.getItem('color-scheme');
+        } catch {}
+
+        const activeOverride =
+          storedScheme === 'light' || storedScheme === 'dark'
+            ? storedScheme
+            : meta.content === 'light' || meta.content === 'dark'
+              ? meta.content
+              : null;
+
+        const currentRendered = activeOverride ?? systemScheme;
+        const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
+
+        if (targetScheme !== systemScheme) {
+          meta.content = targetScheme;
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+        } else {
+          meta.content = 'light dark';
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          meta.content =
+            event.newValue === 'light' || event.newValue === 'dark'
+              ? event.newValue
+              : 'light dark';
+        }
+      });
+    })();
+  </script>
+
