+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theme-toggle');
+      const iconEl = toggleBtn.querySelector('.theme-icon');
+      const labelEl = toggleBtn.querySelector('.theme-label');
+      const root = document.documentElement;
+      const body = document.body;
+      const mediaQuery = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
+
+      function getSavedTheme() {
+        try {
+          return localStorage.getItem('theme');
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function setSavedTheme(theme) {
+        try {
+          localStorage.setItem('theme', theme);
+        } catch (e) {
+          // ignore storage errors
+        }
+      }
+
+      function getCurrentEffectiveTheme() {
+        const attrTheme = root.getAttribute('data-theme') || body.getAttribute('data-theme');
+        if (attrTheme === 'dark' || attrTheme === 'light') {
+          return attrTheme;
+        }
+        const saved = getSavedTheme();
+        if (saved === 'dark' || saved === 'light') {
+          return saved;
+        }
+        return mediaQuery && mediaQuery.matches ? 'dark' : 'light';
+      }
+
+      function updateButtonUI(theme) {
+        const isDark = theme === 'dark';
+        toggleBtn.setAttribute('aria-pressed', String(isDark));
+        toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
+        if (iconEl) iconEl.textContent = isDark ? '☀️' : '🌙';
+        if (labelEl) labelEl.textContent = isDark ? 'Light Mode' : 'Dark Mode';
+      }
+
+      function applyTheme(theme, persist) {
+        const isDark = theme === 'dark';
+        root.setAttribute('data-theme', theme);
+        body.setAttribute('data-theme', theme);
+
+        root.classList.toggle('dark-mode', isDark);
+        root.classList.toggle('light-mode', !isDark);
+        root.classList.toggle('dark', isDark);
+        root.classList.toggle('light', !isDark);
+
+        body.classList.toggle('dark-mode', isDark);
+        body.classList.toggle('light-mode', !isDark);
+        body.classList.toggle('dark', isDark);
+        body.classList.toggle('light', !isDark);
+
+        updateButtonUI(theme);
+
+        if (persist) {
+          setSavedTheme(theme);
+        }
+      }
+
+      const initialSaved = getSavedTheme();
+      if (initialSaved === 'dark' || initialSaved === 'light') {
+        applyTheme(initialSaved, false);
+      } else {
+        updateButtonUI(getCurrentEffectiveTheme());
+      }
+
+      toggleBtn.addEventListener('click', function () {
+        const nextTheme = getCurrentEffectiveTheme() === 'dark' ? 'light' : 'dark';
+        applyTheme(nextTheme, true);
+      });
+
+      if (mediaQuery && mediaQuery.addEventListener) {
+        mediaQuery.addEventListener('change', function (e) {
+          if (!getSavedTheme() && !root.getAttribute('data-theme')) {
+            updateButtonUI(e.matches ? 'dark' : 'light');
+          }
+        });
+      }
+    })();
+  </script>
+
