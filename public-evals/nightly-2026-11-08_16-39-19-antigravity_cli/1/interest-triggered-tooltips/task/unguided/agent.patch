+  <script>
+    document.querySelectorAll('.tooltip-container').forEach((container) => {
+      const btn = container.querySelector('.btn');
+      const popover = container.querySelector('.tooltip-popover');
+      if (!btn || !popover) return;
+
+      const showTooltip = () => {
+        popover.classList.remove('flip-left');
+        const btnRect = btn.getBoundingClientRect();
+        const popoverWidth = popover.offsetWidth || 190;
+        if (btnRect.right + 16 + popoverWidth > window.innerWidth && btnRect.left - 16 - popoverWidth > 0) {
+          popover.classList.add('flip-left');
+        }
+        popover.classList.add('is-visible');
+      };
+
+      const hideTooltip = () => {
+        popover.classList.remove('is-visible');
+      };
+
+      container.addEventListener('mouseenter', showTooltip);
+      container.addEventListener('mouseleave', hideTooltip);
+      btn.addEventListener('focus', showTooltip);
+      btn.addEventListener('blur', hideTooltip);
+    });
+  </script>
