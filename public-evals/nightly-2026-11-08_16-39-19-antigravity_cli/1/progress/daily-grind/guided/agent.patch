+  <script>
+    const progressEl = document.getElementById('order-reward-progress');
+    const statusEl = document.getElementById('order-reward-status');
+    const syncBtn = document.getElementById('btn-sync-order');
+    const stepBtn = document.getElementById('btn-step-progress');
+    const completeBtn = document.getElementById('btn-complete-progress');
+
+    function setDeterminateProgress(val) {
+      const clamped = Math.min(100, Math.max(0, val));
+      progressEl.value = clamped;
+      if (clamped >= 100) {
+        statusEl.textContent = '100 / 100 Beans — Order ready & free reward unlocked!';
+      } else {
+        statusEl.textContent = `${clamped} / 100 Beans — ${100 - clamped} away from a free artisanal drink!`;
+      }
+    }
+
+    syncBtn.addEventListener('click', () => {
+      progressEl.removeAttribute('value');
+      statusEl.textContent = 'Syncing live order & reward points with roastery...';
+    });
+
+    stepBtn.addEventListener('click', () => {
+      const current = progressEl.hasAttribute('value') ? Number(progressEl.value) : 0;
+      const next = current >= 100 ? 25 : current + 25;
+      setDeterminateProgress(next);
+    });
+
+    completeBtn.addEventListener('click', () => {
+      setDeterminateProgress(100);
+    });
+  </script>
+
