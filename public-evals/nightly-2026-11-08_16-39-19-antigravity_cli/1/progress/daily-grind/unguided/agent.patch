+  <script>
+    (function () {
+      const rewardProgress = document.getElementById('reward-progress');
+      const rewardStatus = document.getElementById('reward-progress-status');
+      const rewardCaption = document.getElementById('reward-progress-caption');
+      const controlButtons = document.querySelectorAll('.progress-control-btn');
+
+      controlButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          controlButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          const mode = btn.getAttribute('data-progress-mode');
+          if (mode === 'indeterminate') {
+            rewardProgress.removeAttribute('value');
+            rewardProgress.removeAttribute('aria-valuenow');
+            rewardProgress.setAttribute('aria-busy', 'true');
+            rewardProgress.classList.remove('determinate');
+            rewardProgress.classList.add('indeterminate');
+            rewardProgress.textContent = 'Syncing...';
+            rewardStatus.textContent = 'Syncing Rewards...';
+            rewardCaption.textContent = 'Recalculating Bean Points from your latest artisanal roast order...';
+          } else {
+            const val = Number(btn.getAttribute('data-progress-value') || 75);
+            rewardProgress.setAttribute('value', String(val));
+            rewardProgress.setAttribute('aria-valuenow', String(val));
+            rewardProgress.removeAttribute('aria-busy');
+            rewardProgress.classList.remove('indeterminate');
+            rewardProgress.classList.add('determinate');
+            rewardProgress.textContent = val + '%';
+            rewardStatus.textContent = val + '% (' + val + ' / 100 Beans)';
+            rewardCaption.textContent =
+              val >= 100
+                ? 'Reward unlocked! Redeem your free Seasonal Favorite at checkout.'
+                : 100 - val + ' more Bean Points to unlock your free Seasonal Latte.';
+          }
+        });
+      });
+    })();
+  </script>
