+    /* Store Picker Field in Hero */
+    .store-picker-field {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.375rem;
+      margin-block-start: 1.25rem;
+      margin-block-end: 0.5rem;
+      width: 100%;
+      max-width: 320px;
+      text-align: left;
+    }
+
+    .store-picker-field label {
+      display: inline-block;
+      font-weight: 600;
+      font-size: 0.95rem;
+      color: var(--light);
+      padding: 10px 0;
+      margin: -10px 0;
+    }
+
+    /* Opt-in to customizable select */
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    /* Style the visible trigger and icon rotation */
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 0.75rem 1rem;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      background-color: var(--light);
+      color: var(--text);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      box-sizing: border-box;
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    @media (pointer: coarse) {
+      .store-select {
+        min-height: 52px;
+      }
+    }
+
+    .store-select:hover {
+      border-color: var(--accent);
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    /*
+     * The Picker Container
+     * Uses top-layer animations with `allow-discrete` visibility hooks
+     */
+    .store-select::picker(select) {
+      background: var(--light);
+      color: var(--text);
+      border: 2px solid var(--secondary);
+      border-radius: 12px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.2);
+      padding: 0.5rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+
+      transition:
+        display,
+        overlay,
+        opacity cubic-bezier(0.16, 1, 0.3, 1),
+        height cubic-bezier(0.16, 1, 0.3, 1);
+      transition-duration: 0.4s;
+      /* Separate after transition so the shorthand doesn't reset it or fail in older browsers */
+      transition-behavior: allow-discrete;
+      opacity: 0;
+      height: 0;
+    }
+
+    /* Open State */
+    .store-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    /* @starting-style to hook the transition on initial popover open */
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    /* Style individual options, icons, and hover/checked effects */
+    .store-select option {
+      padding: 0.625rem 0.75rem;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .store-select option:hover {
+      background-color: #efebe9;
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    /* MANDATORY: Provide multiple indicators (bold font and distinct background) for the checked state */
+    .store-select option:checked {
+      font-weight: 700;
+      background-color: var(--secondary);
+      color: var(--text);
+    }
+
+    .store-select option svg,
+    .store-select selectedcontent svg {
+      flex-shrink: 0;
+      width: 1.25rem;
+      height: 1.25rem;
+    }
+
+    /* Ensure safety for users with motion sensitivities */
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
+
