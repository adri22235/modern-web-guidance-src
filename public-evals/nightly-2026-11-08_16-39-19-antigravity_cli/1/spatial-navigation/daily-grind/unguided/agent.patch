+        if (cards.length === 0) return;
+
+        const currentCard = event.target.closest('.card');
+        if (!currentCard || !grid.contains(currentCard)) return;
+
+        const { key } = event;
+
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(key)) {
+          event.preventDefault();
+          const nextCard = findSpatialTarget(cards, currentCard, key);
+          if (nextCard && nextCard !== currentCard) {
+            setActiveCard(nextCard, { focus: true, announceMove: true });
+          }
+          return;
+        }
+
+        if (key === 'Home') {
+          event.preventDefault();
+          if (event.ctrlKey) {
+            setActiveCard(cards[0], { focus: true, announceMove: true });
+          } else {
+            const { items, rows } = computeSpatialMap(cards);
+            const current = items.find((i) => i.card === currentCard);
+            const target =
+              current && rows[current.row] && rows[current.row].length > 1
+                ? rows[current.row][0].card
+                : cards[0];
+            setActiveCard(target, { focus: true, announceMove: true });
+          }
+          return;
+        }
+
+        if (key === 'End') {
+          event.preventDefault();
+          if (event.ctrlKey) {
+            setActiveCard(cards[cards.length - 1], { focus: true, announceMove: true });
+          } else {
+            const { items, rows } = computeSpatialMap(cards);
+            const current = items.find((i) => i.card === currentCard);
+            const currentRow = current ? rows[current.row] : null;
+            const target =
+              currentRow && currentRow.length > 1
+                ? currentRow[currentRow.length - 1].card
+                : cards[cards.length - 1];
+            setActiveCard(target, { focus: true, announceMove: true });
+          }
+          return;
+        }
+
+        if (key === 'PageDown') {
+          event.preventDefault();
+          const { rows } = computeSpatialMap(cards);
+          const lastRow = rows[rows.length - 1];
+          if (lastRow && lastRow.length > 0) {
+            setActiveCard(lastRow[0].card, { focus: true, announceMove: true });
+          }
+          return;
+        }
+
+        if (key === 'PageUp') {
+          event.preventDefault();
+          const { rows } = computeSpatialMap(cards);
+          if (rows[0] && rows[0].length > 0) {
+            setActiveCard(rows[0][0].card, { focus: true, announceMove: true });
+          }
+          return;
+        }
+
+        if (key === 'Enter' || key === ' ') {
+          // If the user pressed Enter/Space on the card itself, activate its primary CTA link
+          if (event.target === currentCard) {
+            const primaryLink = currentCard.querySelector('a.btn, a[href], button');
+            if (primaryLink) {
+              event.preventDefault();
+              primaryLink.click();
+            }
+          }
+        }
+      });
+
+      // Sync roving tabindex when a user clicks or focuses a card or an element inside it
+      grid.addEventListener('focusin', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          setActiveCard(card, { focus: false, announceMove: false });
+        }
+      });
+
+      grid.addEventListener('click', (event) => {
+        const card = event.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+        setActiveCard(card, { focus: true, announceMove: false });
+      });
+
+      // Layout mode switcher controls
+      function setLayoutMode(mode) {
+        grid.setAttribute('data-layout', mode);
+        // Sync layout classes for external or CSS-based consumers
+        grid.className = 'grid layout-' + mode;
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.getAttribute('data-layout-mode') === mode;
+          btn.classList.toggle('active', isMatch);
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        const activeBtn = Array.from(layoutButtons).find(
+          (btn) => btn.getAttribute('data-layout-mode') === mode
+        );
+        const modeLabel = activeBtn ? activeBtn.textContent.trim() : mode;
+        announce(`Layout changed to ${modeLabel}`);
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          if (mode) {
+            setLayoutMode(mode);
+          }
+        });
+      });
+
+      // Observe dynamic card additions/removals so roving tabindex stays valid
+      const observer = new MutationObserver(() => {
+        initializeGridNavigation();
+      });
+      observer.observe(grid, { childList: true });
+
+      initializeGridNavigation();
+
+      // Expose helper API on window for programmatic layout switching & testing
+      window.CardGridSpatialNav = {
+        setLayoutMode,
+        getCards,
+        computeSpatialMap: () => computeSpatialMap(getCards()),
+        findSpatialTarget: (currentCard, key) => findSpatialTarget(getCards(), currentCard, key),
+        setActiveCard
+      };
+    })();
+  </script>
 </body>
 
