+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]'
+      ].join(', ');
+
+      const KEY_TO_DIRECTION = {
+        ArrowRight: 'right',
+        ArrowLeft: 'left',
+        ArrowDown: 'down',
+        ArrowUp: 'up'
+      };
+
+      const TOLERANCE = 2;
+      const FALLBACK_WEIGHT = 2.5;
+
+      function getCandidates(container) {
+        return Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR)).filter(
+          (el) => typeof el.checkVisibility === 'function' ? el.checkVisibility() : true
+        );
+      }
+
+      function updateRovingTabindex(candidates, activeElement) {
+        for (const item of candidates) {
+          item.setAttribute('tabindex', item === activeElement ? '0' : '-1');
+        }
+      }
+
+      function findSpatialCandidate(current, candidates, direction, weight = FALLBACK_WEIGHT) {
+        const currentRect = current.getBoundingClientRect();
+        const isHorizontal = direction === 'left' || direction === 'right';
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+
+        const directional = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+
+          const rect = candidate.getBoundingClientRect();
+          let inDirection = false;
+          let gap = 0;
+
+          if (direction === 'right') {
+            inDirection = rect.left >= currentRect.right - TOLERANCE;
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (direction === 'left') {
+            inDirection = rect.right <= currentRect.left + TOLERANCE;
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (direction === 'down') {
+            inDirection = rect.top >= currentRect.bottom - TOLERANCE;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (direction === 'up') {
+            inDirection = rect.bottom <= currentRect.top + TOLERANCE;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          if (!inDirection) continue;
+
+          const overlap = isHorizontal
+            ? Math.min(currentRect.bottom, rect.bottom) - Math.max(currentRect.top, rect.top)
+            : Math.min(currentRect.right, rect.right) - Math.max(currentRect.left, rect.left);
+
+          const candidateCenterX = (rect.left + rect.right) / 2;
+          const candidateCenterY = (rect.top + rect.bottom) / 2;
+          const perpendicularCentreOffset = isHorizontal
+            ? Math.abs(candidateCenterY - currentCenterY)
+            : Math.abs(candidateCenterX - currentCenterX);
+
+          directional.push({
+            element: candidate,
+            gap,
+            overlapsPerpendicular: overlap > 0,
+            perpendicularCentreOffset
+          });
+        }
+
+        if (directional.length === 0) {
+          return null;
+        }
+
+        const aligned = directional.filter((item) => item.overlapsPerpendicular);
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCentreOffset - b.perpendicularCentreOffset;
+          });
+          return aligned[0].element;
+        }
+
+        directional.sort((a, b) => {
+          const scoreA = a.gap + weight * a.perpendicularCentreOffset;
+          const scoreB = b.gap + weight * b.perpendicularCentreOffset;
+          return scoreA - scoreB;
+        });
+
+        return directional[0].element;
+      }
+
+      function initSpatialGrid(container) {
+        const initialCandidates = getCandidates(container);
+        if (initialCandidates.length > 0) {
+          const active =
+            initialCandidates.find((el) => el.getAttribute('tabindex') === '0') ||
+            initialCandidates[0];
+          updateRovingTabindex(initialCandidates, active);
+        }
+
+        container.addEventListener('focusin', (e) => {
+          const candidates = getCandidates(container);
+          const focused = e.target;
+          if (focused instanceof HTMLElement && candidates.includes(focused)) {
+            updateRovingTabindex(candidates, focused);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          const direction = KEY_TO_DIRECTION[e.key];
+          if (!direction) return;
+
+          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) {
+            return;
+          }
+
+          const innermostTarget = e.composedPath()[0];
+          if (
+            innermostTarget instanceof Element &&
+            innermostTarget.matches(':read-write, select, input[type="range"], [role="slider"]')
+          ) {
+            return;
+          }
+
+          const candidates = getCandidates(container);
+          const current = document.activeElement;
+          if (!(current instanceof HTMLElement) || !candidates.includes(current)) {
+            return;
+          }
+
+          const next = findSpatialCandidate(current, candidates, direction);
+          if (!next) {
+            return;
+          }
+
+          e.preventDefault();
+          updateRovingTabindex(candidates, next);
+          next.focus();
+          next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      const grids = document.querySelectorAll('[role="grid"], .grid');
+      for (const grid of grids) {
+        initSpatialGrid(grid);
+      }
+
+      const layoutButtons = document.querySelectorAll('[data-layout-mode]');
+      const cardGrid = document.querySelector('.grid');
+      for (const btn of layoutButtons) {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          if (!cardGrid || !mode) return;
+          cardGrid.setAttribute('data-layout', mode);
+          for (const other of layoutButtons) {
+            other.setAttribute('aria-pressed', String(other === btn));
+          }
+        });
+      }
+    })();
+  </script>
+
 </body>
 
