+          document.querySelectorAll('script[src], iframe[src], object[data], embed[src]').forEach((el) => {
+            const url = el.getAttribute('src') || el.getAttribute('data') || '';
+            if (!this.isAllowedUrl(url)) {
+              el.remove();
+              this.blockedRequests.push({ type: el.tagName.toLowerCase(), url, reason: 'Blocked by Privacy Auditor' });
+              findings.unauthorizedElementsBlocked++;
+            }
+          });
+
+          // Ensure external anchor links have rel="noopener noreferrer" and referrerpolicy="no-referrer"
+          document.querySelectorAll('a[href^="http"]').forEach((link) => {
+            link.setAttribute('rel', 'noopener noreferrer');
+            link.setAttribute('referrerpolicy', 'no-referrer');
+          });
+
+          return findings;
+        },
+
+        runFullAudit() {
+          const domFindings = this.auditDomElements();
+          const signals = getPrivacySignals();
+          const cspMeta = document.querySelector('meta[http-equiv="Content-Security-Policy"]');
+          const referrerMeta = document.querySelector('meta[name="referrer"]');
+          const permissionsMeta = document.querySelector('meta[http-equiv="Permissions-Policy"]');
+
+          const resourceEntries = (window.performance && window.performance.getEntriesByType)
+            ? window.performance.getEntriesByType('resource')
+            : [];
+
+          const unauthorizedNetworkResources = resourceEntries.filter(
+            (entry) => !this.isAllowedUrl(entry.name)
+          );
+
+          return {
+            timestamp: new Date().toISOString(),
+            headersVerified: {
+              csp: Boolean(cspMeta && cspMeta.content.includes("default-src 'self'")),
+              referrerNoReferrer: Boolean(referrerMeta && referrerMeta.content === 'no-referrer'),
+              permissionsPolicy: Boolean(permissionsMeta && permissionsMeta.content.includes('geolocation=()'))
+            },
+            privacySignals: signals,
+            domFindings,
+            unauthorizedNetworkCount: unauthorizedNetworkResources.length,
+            blockedRequests: this.blockedRequests.slice()
+          };
+        }
+      };
+
+      // --- 8. Consent & Media Mode Controller ---
+      function getDefaultConsent() {
+        const signals = getPrivacySignals();
+        return {
+          essential: true,
+          functional: false,
+          analytics: false,
+          externalMedia: true,
+          gpcEnforced: signals.restrictTelemetry,
+          acknowledged: false
+        };
+      }
+
+      function loadConsentState() {
+        const stored = SecureStorage.get('consent_state');
+        const signals = getPrivacySignals();
+        const base = stored ? Object.assign(getDefaultConsent(), stored) : getDefaultConsent();
+        if (signals.restrictTelemetry) {
+          base.analytics = false;
+          base.gpcEnforced = true;
+        }
+        return base;
+      }
+
+      function applyMediaConsent(externalMediaEnabled) {
+        const hero = document.getElementById('hero-banner');
+        if (externalMediaEnabled) {
+          document.body.classList.remove('local-media-only');
+          if (hero) hero.classList.remove('local-media-only');
+          const unsplashPill = document.getElementById('unsplash-audit-pill');
+          if (unsplashPill) {
+            unsplashPill.textContent = 'Audited & Referrer-Stripped';
+            unsplashPill.className = 'status-pill verified';
+          }
+        } else {
+          document.body.classList.add('local-media-only');
+          if (hero) hero.classList.add('local-media-only');
+          const unsplashPill = document.getElementById('unsplash-audit-pill');
+          if (unsplashPill) {
+            unsplashPill.textContent = 'Local-Only Mode Active';
+            unsplashPill.className = 'status-pill restricted';
+          }
+        }
+      }
+
+      function syncConsentUI(consent) {
+        const funcCheckbox = document.getElementById('consent-functional');
+        const analyticsCheckbox = document.getElementById('consent-analytics');
+        const mediaCheckbox = document.getElementById('consent-external-media');
+        const banner = document.getElementById('consent-banner');
+        const signals = getPrivacySignals();
+
+        if (funcCheckbox) funcCheckbox.checked = Boolean(consent.functional);
+        if (analyticsCheckbox) {
+          analyticsCheckbox.checked = Boolean(consent.analytics && !signals.restrictTelemetry);
+          analyticsCheckbox.disabled = signals.restrictTelemetry;
+        }
+        if (mediaCheckbox) mediaCheckbox.checked = Boolean(consent.externalMedia);
+        if (banner) {
+          banner.classList.toggle('hidden', Boolean(consent.acknowledged));
+        }
+
+        applyMediaConsent(consent.externalMedia);
+      }
+
+      function updateInspectorUI() {
+        const view = document.getElementById('storage-inspector-view');
+        if (view) {
+          view.textContent = JSON.stringify(SecureStorage.inspectAll(), null, 2);
+        }
+      }
+
+      function showFeedback(elId, message, type = 'success') {
+        const el = document.getElementById(elId);
+        if (!el) return;
+        el.textContent = message;
+        el.className = `status-feedback visible ${type}`;
+      }
+
+      // --- 9. Initialize Application & Event Listeners ---
+      function init() {
+        const strippedParams = sanitizeCurrentUrl();
+        SecureStorage.purgeExpired();
+
+        // Initialize CSRF token for POST logout protection
+        let csrfToken = SecureStorage.get('csrf_token');
+        if (!csrfToken) {
+          csrfToken = generateCsrfToken();
+          SecureStorage.set('csrf_token', csrfToken, { ttlMs: SESSION_TTL_MS });
+        }
+        const csrfInput = document.getElementById('logout-csrf-token');
+        if (csrfInput) csrfInput.value = csrfToken;
+
+        // Update Top Privacy Status Bar
+        const signals = getPrivacySignals();
+        const gpcBadge = document.getElementById('gpc-status-badge');
+        if (gpcBadge) {
+          gpcBadge.textContent = signals.restrictTelemetry
+            ? 'GPC / DNT: Active Signal Enforced'
+            : 'GPC / DNT: No Signal (Strict Defaults Active)';
+        }
+
+        const urlBadge = document.getElementById('url-hygiene-badge');
+        if (urlBadge) {
+          urlBadge.textContent = strippedParams > 0
+            ? `URL Hygiene: Scrubbed ${strippedParams} Tracker Param(s)`
+            : 'URL Hygiene: Verified Clean';
+        }
+
+        // Load & Apply Consent
+        const consent = loadConsentState();
+        syncConsentUI(consent);
+
+        // Restore opt-in preferred drink/location if consented
+        const savedPref = SecureStorage.get('preferred_drink_store');
+        if (consent.functional && savedPref) {
+          const drinkSelect = document.getElementById('drink-selection');
+          const locSelect = document.getElementById('pickup-location');
+          if (drinkSelect && savedPref.drink) drinkSelect.value = savedPref.drink;
+          if (locSelect && savedPref.location) locSelect.value = savedPref.location;
+        }
+
+        // Quick-select drink buttons on cards
+        document.querySelectorAll('.select-drink-btn').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const drink = btn.getAttribute('data-drink');
+            const drinkSelect = document.getElementById('drink-selection');
+            if (drink && drinkSelect) drinkSelect.value = drink;
+          });
+        });
+
+        // Express Order Form Handling (Data Minimization + PII Scrubbing)
+        const orderForm = document.getElementById('express-order-form');
+        if (orderForm) {
+          orderForm.addEventListener('submit', (e) => {
+            e.preventDefault();
+            const rawAlias = document.getElementById('pickup-alias').value;
+            const drink = document.getElementById('drink-selection').value;
+            const location = document.getElementById('pickup-location').value;
+            const rawNotes = document.getElementById('dietary-notes').value;
+            const rememberOptIn = document.getElementById('remember-drink-opt-in').checked;
+
+            const aliasScrubbed = scrubPII(rawAlias);
+            const notesScrubbed = scrubPII(rawNotes);
+
+            if (!aliasScrubbed.text) {
+              showFeedback('order-feedback', 'Please provide a pickup name or pseudonym.', 'warning');
+              return;
+            }
+
+            const stagedOrder = {
+              pickupAlias: escapeHtml(aliasScrubbed.text),
+              drink: escapeHtml(drink),
+              location: escapeHtml(location),
+              notes: escapeHtml(notesScrubbed.text),
+              ttlMinutes: 15
+            };
+
+            SecureStorage.set('staged_order', stagedOrder, { ttlMs: SESSION_TTL_MS, persistent: false });
+
+            if (rememberOptIn) {
+              SecureStorage.set(
+                'preferred_drink_store',
+                { drink: stagedOrder.drink, location: stagedOrder.location },
+                { ttlMs: PREF_TTL_MS, persistent: true }
+              );
+            }
+
+            const totalRedacted = aliasScrubbed.redactedCount + notesScrubbed.redactedCount;
+            const redactNotice = totalRedacted > 0
+              ? ` (${totalRedacted} sensitive PII pattern(s) automatically redacted!)`
+              : '';
+
+            showFeedback(
+              'order-feedback',
+              `Order staged for "${stagedOrder.pickupAlias}" (${stagedOrder.drink} at ${stagedOrder.location}). Stored in ephemeral session storage for 15 minutes${redactNotice}.`,
+              totalRedacted > 0 ? 'warning' : 'success'
+            );
+            updateInspectorUI();
+          });
+        }
+
+        // Local-Only Store Locator Filter
+        const zipFilter = document.getElementById('zip-filter');
+        if (zipFilter) {
+          zipFilter.addEventListener('input', () => {
+            const q = zipFilter.value.trim().toLowerCase();
+            document.querySelectorAll('#store-list li').forEach((li) => {
+              const meta = (li.getAttribute('data-store') || '').toLowerCase();
+              li.style.display = !q || meta.includes(q) ? '' : 'none';
+            });
+          });
+        }
+
+        // Privacy-First Rewards Form (SHA-256 Hashing)
+        const rewardsForm = document.getElementById('rewards-form');
+        if (rewardsForm) {
+          rewardsForm.addEventListener('submit', async (e) => {
+            e.preventDefault();
+            const emailInput = document.getElementById('rewards-email');
+            const consentBox = document.getElementById('rewards-consent');
+            const email = emailInput ? emailInput.value.trim() : '';
+
+            if (!email || !email.includes('@')) {
+              showFeedback('rewards-feedback', 'Please enter a valid email address to hash.', 'warning');
+              return;
+            }
+            if (!consentBox || !consentBox.checked) {
+              showFeedback('rewards-feedback', 'Explicit opt-in consent is required before hashing.', 'warning');
+              return;
+            }
+
+            const digest = await sha256Hex(email);
+            // Clear raw email input immediately so it does not linger in the DOM
+            emailInput.value = '';
+
+            SecureStorage.set(
+              'rewards_member_hash',
+              { sha256: digest.slice(0, 32) + '...', fullHash: digest },
+              { ttlMs: SESSION_TTL_MS, persistent: false }
+            );
+
+            showFeedback(
+              'rewards-feedback',
+              `Raw email cleared. Ephemeral SHA-256 token generated: ${digest.slice(0, 16)}...`,
+              'success'
+            );
+            updateInspectorUI();
+          });
+        }
+
+        // Consent Management Controls
+        const saveConsentBtn = document.getElementById('save-consent-btn');
+        if (saveConsentBtn) {
+          saveConsentBtn.addEventListener('click', () => {
+            const currentSignals = getPrivacySignals();
+            const updated = {
+              essential: true,
+              functional: Boolean(document.getElementById('consent-functional').checked),
+              analytics: currentSignals.restrictTelemetry
+                ? false
+                : Boolean(document.getElementById('consent-analytics').checked),
+              externalMedia: Boolean(document.getElementById('consent-external-media').checked),
+              gpcEnforced: currentSignals.restrictTelemetry,
+              acknowledged: true
+            };
+            SecureStorage.set('consent_state', updated, { ttlMs: PREF_TTL_MS, persistent: false });
+            if (!updated.functional) {
+              window.localStorage.removeItem(STORAGE_PREFIX + 'preferred_drink_store');
+            }
+            syncConsentUI(updated);
+            showFeedback('consent-feedback', 'Privacy preferences updated and applied.', 'success');
+            updateInspectorUI();
+          });
+        }
+
+        const enforceEssentialOnly = () => {
+          const strictState = Object.assign(getDefaultConsent(), {
+            externalMedia: Boolean(document.getElementById('consent-external-media').checked),
+            acknowledged: true
+          });
+          SecureStorage.set('consent_state', strictState, { ttlMs: PREF_TTL_MS, persistent: false });
+          window.localStorage.removeItem(STORAGE_PREFIX + 'preferred_drink_store');
+          syncConsentUI(strictState);
+          showFeedback('consent-feedback', 'Strict Essential-Only mode enforced.', 'success');
+          updateInspectorUI();
+        };
+
+        const essentialOnlyBtn = document.getElementById('essential-only-btn');
+        if (essentialOnlyBtn) essentialOnlyBtn.addEventListener('click', enforceEssentialOnly);
+
+        const bannerEssentialBtn = document.getElementById('banner-essential-btn');
+        if (bannerEssentialBtn) bannerEssentialBtn.addEventListener('click', enforceEssentialOnly);
+
+        // DSAR Controls: Inspect, Export, Erase
+        const refreshBtn = document.getElementById('refresh-storage-btn');
+        if (refreshBtn) refreshBtn.addEventListener('click', updateInspectorUI);
+
+        const exportBtn = document.getElementById('export-data-btn');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', () => {
+            const payload = JSON.stringify(SecureStorage.inspectAll(), null, 2);
+            const blob = new Blob([payload], { type: 'application/json' });
+            const url = URL.createObjectURL(blob);
+            const a = document.createElement('a');
+            a.href = url;
+            a.download = 'daily-grind-privacy-export.json';
+            a.click();
+            URL.revokeObjectURL(url);
+            showFeedback('consent-feedback', 'Portable JSON data export generated.', 'success');
+          });
+        }
+
+        const eraseAllData = (reasonMessage) => {
+          SecureStorage.clearAll();
+          const newCsrf = generateCsrfToken();
+          SecureStorage.set('csrf_token', newCsrf, { ttlMs: SESSION_TTL_MS });
+          if (csrfInput) csrfInput.value = newCsrf;
+          syncConsentUI(getDefaultConsent());
+          updateInspectorUI();
+          showFeedback('consent-feedback', reasonMessage, 'success');
+        };
+
+        const eraseBtn = document.getElementById('erase-all-data-btn');
+        if (eraseBtn) {
+          eraseBtn.addEventListener('click', () => {
+            eraseAllData('All client-side storage, tokens, and preferences have been permanently erased.');
+          });
+        }
+
+        // Secure Logout Form Handler
+        const logoutForm = document.getElementById('logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', (e) => {
+            e.preventDefault();
+            eraseAllData('Logged out securely: session storage, local storage, and cookies wiped.');
+            showFeedback('order-feedback', 'Session terminated and all staged order data wiped.', 'success');
+          });
+        }
+
+        // Live Third-Party & Security Audit Runner
+        const runAudit = () => {
+          const report = ThirdPartyAuditor.runFullAudit();
+          const summaryEl = document.getElementById('live-audit-summary');
+          const thirdPartyBadge = document.getElementById('third-party-badge');
+          if (thirdPartyBadge) {
+            thirdPartyBadge.textContent = `3rd-Party Trackers: ${report.domFindings.unauthorizedElementsBlocked} Blocked / 0 Active`;
+          }
+          if (summaryEl) {
+            summaryEl.textContent =
+              `Audit Verified (${report.timestamp}): CSP=${report.headersVerified.csp ? 'PASS' : 'FAIL'}, ` +
+              `Referrer-Policy=${report.headersVerified.referrerNoReferrer ? 'no-referrer' : 'FAIL'}, ` +
+              `Permissions-Policy=${report.headersVerified.permissionsPolicy ? 'PASS' : 'FAIL'}, ` +
+              `Audited External Images=${report.domFindings.auditedImages}, ` +
+              `Unauthorized Third-Party Requests=${report.unauthorizedNetworkCount}.`;
+          }
+          return report;
+        };
+
+        const runAuditBtn = document.getElementById('run-audit-btn');
+        if (runAuditBtn) runAuditBtn.addEventListener('click', runAudit);
+
+        // Continuous DOM Mutation Observer to prevent injection of unauthorized third-party nodes
+        if (window.MutationObserver) {
+          const observer = new MutationObserver(() => {
+            ThirdPartyAuditor.auditDomElements();
+          });
+          observer.observe(document.documentElement, { childList: true, subtree: true });
+        }
+
+        // Periodic TTL cleanup every 60 seconds
+        setInterval(() => {
+          if (SecureStorage.purgeExpired() > 0) {
+            updateInspectorUI();
+          }
+        }, 60000);
+
+        runAudit();
+        updateInspectorUI();
+      }
+
+      // Expose API for programmatic verification and auditing
+      window.DailyGrindPrivacy = {
+        sanitizeCurrentUrl,
+        getPrivacySignals,
+        scrubPII,
+        sha256Hex,
+        SecureStorage,
+        ThirdPartyAuditor
+      };
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
