+      container.replaceChildren(iframe);
+      recordPrivacyLog(
+        '3P Façade',
+        'User activated Roastery video; mounted sandboxed youtube-nocookie.com iframe on demand.'
+      );
+      runThirdPartyAudit();
+    });
+  }
+
+  function runThirdPartyAudit() {
