+
+  const parsedUrl = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = parsedUrl.pathname;
+
+  // Log scrubbed request path
+  console.log(`[Request] ${req.method} ${scrubPII(parsedUrl.pathname + parsedUrl.search)}`);
+
+  // Logout endpoint: Clear-Site-Data header & expire secure cookies
+  if (pathname === '/logout' || pathname === '/api/logout') {
+    res.setHeader('Clear-Site-Data', '"*"');
+    res.setHeader('Cache-Control', 'no-store');
+    res.setHeader(
+      'Set-Cookie',
+      [
+        '__Host-session_id=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax',
+        'theme_pref=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=None; Partitioned',
+      ]
+    );
+    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(
+      JSON.stringify({
+        cleared: true,
+        message: 'Session terminated and browser site data cleared via Clear-Site-Data: "*".',
+      })
+    );
+    return;
+  }
+
+  // Rate-limited API endpoints for data rights, guest checkout, and store search
+  if (pathname.startsWith('/api/')) {
+    const clientIp = req.socket.remoteAddress || 'local';
+    if (!checkRateLimit(clientIp)) {
+      res.writeHead(429, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ error: 'Too many requests. Rate limit enforced to protect user privacy.' }));
+      return;
+    }
+
+    if (pathname === '/api/data-rights/export' && req.method === 'GET') {
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          retentionPolicy: 'Ephemeral session only; zero server-side tracking profiles.',
+          collectedFields: ['pickupAlias', 'ageBracket', 'loyaltyBeveragePref'],
+        })
+      );
+      return;
+    }
+
+    if (pathname === '/api/data-rights/erase' && req.method === 'POST') {
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ erased: true, timestamp: new Date().toISOString() }));
+      return;
+    }
+
+    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ ok: true }));
+    return;
+  }
+
+  // Static file serving (SPA fallback to index.html)
+  let filePath = path.join(ROOT_DIR, pathname === '/' ? 'index.html' : pathname);
+  if (!filePath.startsWith(ROOT_DIR)) {
+    res.writeHead(403);
+    res.end('Forbidden');
+    return;
+  }
+
+  if (!fs.existsSync(filePath) || fs.statSync(filePath).isDirectory()) {
+    filePath = path.join(ROOT_DIR, 'index.html');
+  }
+
+  const ext = path.extname(filePath).toLowerCase();
+  const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+
+  // Set default secure HttpOnly and CHIPS cookies on document responses
+  if (ext === '.html') {
+    res.setHeader(
+      'Set-Cookie',
+      [
+        '__Host-session_id=ephemeral_guest; SameSite=Lax; HttpOnly; Secure; Path=/',
+        'theme_pref=roast-light; SameSite=None; Secure; Path=/; Partitioned; HttpOnly',
+      ]
+    );
+  }
+
+  fs.readFile(filePath, (err, content) => {
+    if (err) {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Internal Server Error');
+      return;
+    }
+
+    res.writeHead(200, { 'Content-Type': contentType });
+    if (ext === '.html') {
+      const htmlWithNonce = content.toString('utf8').replaceAll('__CSP_NONCE__', nonce);
+      res.end(htmlWithNonce);
+    } else {
+      res.end(content);
+    }
+  });
+});
+
+if (require.main === module) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind privacy-hardened server listening on http://localhost:${PORT}`);
+  });
+}
+
+module.exports = {
+  server,
+  scrubPII,
+  buildConnectionAllowlistHeader,
+  applyPrivacyAndSecurityHeaders,
+};
