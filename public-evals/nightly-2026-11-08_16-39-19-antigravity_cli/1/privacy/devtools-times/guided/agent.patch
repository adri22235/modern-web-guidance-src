diff --git a/src/pages/api/logout.ts b/src/pages/api/logout.ts
new file mode 100644
index 0000000..8e39a65
--- /dev/null
+++ b/src/pages/api/logout.ts
@@ -0,0 +1,28 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session }) => {
+  try {
+    // Delete server-side session data immediately once the user logs out or requests erasure
+    await session?.set('readingList', []);
+    if (session && typeof (session as any).destroy === 'function') {
+      await (session as any).destroy();
+    }
+  } catch {
+    // Scrub errors to avoid leaking internal details in logs
+  }
+
+  return new Response(
+    JSON.stringify({
+      message: 'Session terminated and site data cleared.',
+    }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Clear-Site-Data': '"cookies", "storage", "cache"',
+        'Cache-Control': 'no-store',
+        'Set-Cookie': '__Host-session_id=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax',
+      },
+    }
+  );
+};
