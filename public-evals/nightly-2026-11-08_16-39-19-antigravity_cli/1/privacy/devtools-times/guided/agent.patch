 import { defineMiddleware } from 'astro:middleware';
 
+function generateNonce(): string {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+}
+
+function hardenCookieHeader(cookieValue: string): string {
+  const parts = cookieValue.split(';').map((p) => p.trim());
+  const lowerParts = parts.map((p) => p.toLowerCase());
+
+  if (!lowerParts.includes('httponly')) {
+    parts.push('HttpOnly');
+  }
+  if (!lowerParts.includes('secure')) {
+    parts.push('Secure');
+  }
+  if (!lowerParts.some((p) => p.startsWith('samesite='))) {
+    parts.push('SameSite=Lax');
+  } else if (
+    lowerParts.includes('samesite=none') &&
+    !lowerParts.includes('partitioned')
+  ) {
+    // Enforce CHIPS (Cookies Having Independent Partitioned State) for any SameSite=None cookie
+    parts.push('Partitioned');
+  }
+
+  return parts.join('; ');
+}
+
