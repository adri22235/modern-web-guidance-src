diff --git a/src/components/PrivacyConsentBanner.tsx b/src/components/PrivacyConsentBanner.tsx
new file mode 100644
index 0000000..478efb5
--- /dev/null
+++ b/src/components/PrivacyConsentBanner.tsx
@@ -0,0 +1,323 @@
+import React, { useEffect, useState } from 'react';
+
+export interface PrivacyPreferences {
+  necessary: true;
+  analytics: boolean;
+  advertising: boolean;
+  updatedAt: string;
+}
+
+export const PRIVACY_STORAGE_KEY = 'devtools_times_privacy_preferences';
+export const PRIVACY_EVENT_NAME = 'privacy-preferences-updated';
+export const OPEN_PRIVACY_MODAL_EVENT = 'open-privacy-preferences';
+
+const DEFAULT_PREFERENCES: PrivacyPreferences = {
+  necessary: true,
+  analytics: false,
+  advertising: false,
+  updatedAt: '',
+};
+
+export function isPrivacySignalActive(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean; msDoNotTrack?: string };
+  const win = window as Window & { doNotTrack?: string };
+  return (
+    nav.globalPrivacyControl === true ||
+    nav.doNotTrack === '1' ||
+    nav.doNotTrack === 'yes' ||
+    win.doNotTrack === '1' ||
+    nav.msDoNotTrack === '1'
+  );
+}
+
+export function getStoredPrivacyPreferences(): PrivacyPreferences | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = window.localStorage.getItem(PRIVACY_STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw);
+    if (isPrivacySignalActive()) {
+      return {
+        necessary: true,
+        analytics: false,
+        advertising: false,
+        updatedAt: parsed.updatedAt || new Date().toISOString(),
+      };
+    }
+    return {
+      necessary: true,
+      analytics: Boolean(parsed.analytics),
+      advertising: Boolean(parsed.advertising),
+      updatedAt: parsed.updatedAt || '',
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function hasConsentFor(category: 'analytics' | 'advertising'): boolean {
+  if (typeof window === 'undefined') return false;
+  if (isPrivacySignalActive()) return false;
+  const pathname = window.location.pathname;
+  if (pathname.endsWith('/signin') || pathname.endsWith('/signup')) {
+    return false;
+  }
+  const prefs = getStoredPrivacyPreferences();
+  if (!prefs) return false;
+  return Boolean(prefs[category]);
+}
+
+function syncThirdPartyScripts(prefs: PrivacyPreferences) {
+  if (typeof document === 'undefined') return;
+  const pathname = window.location.pathname;
+  const isAuthPage = pathname.endsWith('/signin') || pathname.endsWith('/signup');
+  const gpcOrDnt = isPrivacySignalActive();
+
+  const allowAnalytics = prefs.analytics && !gpcOrDnt && !isAuthPage;
+
+  const existingAnalytics = document.querySelector('script[data-loaded-consent="analytics"]');
+  if (allowAnalytics && !existingAnalytics) {
+    const placeholder = document.querySelector<HTMLScriptElement>(
+      'script[type="text/plain"][data-consent-category="analytics"]'
+    );
+    const src =
+      placeholder?.getAttribute('data-src') ||
+      'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+    const script = document.createElement('script');
+    script.src = src;
+    script.defer = true;
+    script.crossOrigin = 'anonymous';
+    script.referrerPolicy = 'no-referrer';
+    script.setAttribute('data-loaded-consent', 'analytics');
+    document.head.appendChild(script);
+  } else if (!allowAnalytics && existingAnalytics) {
+    existingAnalytics.remove();
+  }
+}
+
+export default function PrivacyConsentBanner() {
+  const [isVisible, setIsVisible] = useState(false);
+  const [showDetails, setShowDetails] = useState(false);
+  const [analyticsConsent, setAnalyticsConsent] = useState(false);
+  const [advertisingConsent, setAdvertisingConsent] = useState(false);
+  const [gpcActive, setGpcActive] = useState(false);
+
+  useEffect(() => {
+    const signalActive = isPrivacySignalActive();
+    setGpcActive(signalActive);
+
+    const stored = getStoredPrivacyPreferences();
+    if (!stored) {
+      // Privacy by design: default all optional tracking to false until user chooses
+      setAnalyticsConsent(false);
+      setAdvertisingConsent(false);
+      setIsVisible(true);
+    } else {
+      setAnalyticsConsent(signalActive ? false : stored.analytics);
+      setAdvertisingConsent(signalActive ? false : stored.advertising);
+      syncThirdPartyScripts(stored);
+    }
+
+    const handleOpenPreferences = () => {
+      const current = getStoredPrivacyPreferences();
+      const currentSignal = isPrivacySignalActive();
+      setGpcActive(currentSignal);
+      setAnalyticsConsent(currentSignal ? false : Boolean(current?.analytics));
+      setAdvertisingConsent(currentSignal ? false : Boolean(current?.advertising));
+      setShowDetails(true);
+      setIsVisible(true);
+    };
+
+    window.addEventListener(OPEN_PRIVACY_MODAL_EVENT, handleOpenPreferences);
+    return () => {
+      window.removeEventListener(OPEN_PRIVACY_MODAL_EVENT, handleOpenPreferences);
+    };
+  }, []);
+
+  const savePreferences = (nextAnalytics: boolean, nextAdvertising: boolean) => {
+    const signalActive = isPrivacySignalActive();
+    const updated: PrivacyPreferences = {
+      necessary: true,
+      analytics: signalActive ? false : nextAnalytics,
+      advertising: signalActive ? false : nextAdvertising,
+      updatedAt: new Date().toISOString(),
+    };
+    try {
+      window.localStorage.setItem(PRIVACY_STORAGE_KEY, JSON.stringify(updated));
+    } catch {
+      // Ignore storage errors in restricted environments
+    }
+    setAnalyticsConsent(updated.analytics);
+    setAdvertisingConsent(updated.advertising);
+    setIsVisible(false);
+    setShowDetails(false);
+    syncThirdPartyScripts(updated);
+    window.dispatchEvent(new CustomEvent(PRIVACY_EVENT_NAME, { detail: updated }));
+  };
+
+  const handleRejectAll = () => {
+    savePreferences(false, false);
+  };
+
+  const handleSaveSelected = () => {
+    savePreferences(analyticsConsent, advertisingConsent);
+  };
+
+  const handleAcceptAll = () => {
+    savePreferences(true, true);
+  };
+
+  if (!isVisible) {
+    return null;
+  }
+
+  const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+
+  return (
+    <aside
+      aria-label="Privacy and Data Transparency Preferences"
+      role="dialog"
+      aria-modal="false"
+      data-skip-tracking="true"
+      className="fixed bottom-0 inset-x-0 z-[9999] bg-white border-t-2 border-gray-900 shadow-2xl p-4 md:p-6 text-gray-900"
+    >
+      <div className="max-w-5xl mx-auto">
+        <div className="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
+          <div className="space-y-2 flex-1">
+            <div className="flex items-center gap-2">
+              <h2 className="text-base font-bold text-gray-900">
+                Your Privacy &amp; Data Transparency Controls
+              </h2>
+              <span className="text-xs font-medium bg-gray-100 text-gray-800 px-2 py-0.5 rounded border border-gray-300">
+                Privacy by Design: Opt-Out by Default
+              </span>
+            </div>
+            <p className="text-xs md:text-sm text-gray-700 leading-relaxed">
+              We practice <strong>data minimization</strong> and <strong>privacy by design</strong>.
+              Non-essential third-party scripts (analytics and ad slots) are{' '}
+              <strong>disabled by default</strong> and never run unless you explicitly opt in. We
+              never run third-party trackers on sign-in or sign-up pages. Read our{' '}
+              <a
+                href={`${baseUrl}legal/privacy`}
+                className="underline font-medium text-gray-900 hover:text-amber-700"
+              >
+                Privacy Policy
+              </a>{' '}
+              for full details on data collection and retention.
+            </p>
+            {gpcActive && (
+              <p className="text-xs text-green-800 bg-green-50 border border-green-200 rounded px-2.5 py-1.5">
+                <strong>Global Privacy Control (GPC) / Do Not Track detected:</strong> Your browser
+                privacy signal is automatically honored. Optional analytics and advertising scripts
+                remain disabled.
+              </p>
+            )}
+          </div>
+
+          <div className="flex flex-wrap items-center gap-2 shrink-0">
+            <button
+              type="button"
+              onClick={handleRejectAll}
+              data-skip-tracking="true"
+              className="px-3.5 py-2 text-xs font-semibold rounded border border-gray-900 bg-gray-900 text-white hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900"
+            >
+              Essential Only (Recommended)
+            </button>
+            <button
+              type="button"
+              onClick={() => setShowDetails((prev) => !prev)}
+              data-skip-tracking="true"
+              aria-expanded={showDetails}
+              className="px-3.5 py-2 text-xs font-semibold rounded border border-gray-400 bg-white text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-900"
+            >
+              {showDetails ? 'Hide Preferences' : 'Customize Preferences'}
+            </button>
+            {showDetails ? (
+              <button
+                type="button"
+                onClick={handleSaveSelected}
+                data-skip-tracking="true"
+                className="px-3.5 py-2 text-xs font-semibold rounded border border-gray-400 bg-gray-100 text-gray-900 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Save Selection
+              </button>
+            ) : (
+              <button
+                type="button"
+                onClick={handleAcceptAll}
+                disabled={gpcActive}
+                data-skip-tracking="true"
+                className="px-3.5 py-2 text-xs font-semibold rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Allow Optional Scripts
+              </button>
+            )}
+          </div>
+        </div>
+
+        {showDetails && (
+          <div className="mt-4 pt-4 border-t border-gray-200 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
+            <div className="p-3 bg-gray-50 rounded border border-gray-200">
+              <div className="flex items-center justify-between mb-1">
+                <span className="font-bold text-gray-900">1. Strictly Necessary</span>
+                <span className="text-[11px] font-semibold text-gray-600 bg-gray-200 px-2 py-0.5 rounded">
+                  Always Active
+                </span>
+              </div>
+              <p className="text-gray-600">
+                Used only when you actively save articles to your Reading List or sign in. No
+                session cookie is created for anonymous browsing, and no data is shared with third
+                parties.
+              </p>
+            </div>
+
+            <div className="p-3 bg-gray-50 rounded border border-gray-200">
+              <div className="flex items-center justify-between mb-1">
+                <label htmlFor="consent-analytics" className="font-bold text-gray-900 cursor-pointer">
+                  2. Analytics Script (Optional)
+                </label>
+                <input
+                  id="consent-analytics"
+                  type="checkbox"
+                  checked={analyticsConsent}
+                  disabled={gpcActive}
+                  onChange={(e) => setAnalyticsConsent(e.target.checked)}
+                  data-skip-tracking="true"
+                  className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                />
+              </div>
+              <p className="text-gray-600">
+                Controls loading of <code>analytics-client.js</code> from{' '}
+                <code>cloudfunctions.net</code>. Loaded with <code>referrerpolicy=&quot;no-referrer&quot;</code>{' '}
+                and <code>crossorigin=&quot;anonymous&quot;</code>, and disabled on authentication pages.
+              </p>
+            </div>
+
+            <div className="p-3 bg-gray-50 rounded border border-gray-200">
+              <div className="flex items-center justify-between mb-1">
+                <label htmlFor="consent-advertising" className="font-bold text-gray-900 cursor-pointer">
+                  3. Contextual Ad Slots (Optional)
+                </label>
+                <input
+                  id="consent-advertising"
+                  type="checkbox"
+                  checked={advertisingConsent}
+                  disabled={gpcActive}
+                  onChange={(e) => setAdvertisingConsent(e.target.checked)}
+                  data-skip-tracking="true"
+                  className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                />
+              </div>
+              <p className="text-gray-600">
+                Controls initialization of page ad slots (<code>window.adNetwork</code>). Disabled
+                by default to prevent third-party ad network requests without your explicit consent.
+              </p>
+            </div>
+          </div>
+        )}
+      </div>
+    </aside>
+  );
+}
