+    /* Auto-sizing Form Section */
+    .form-section {
+      margin-block-start: 3rem;
+      background: white;
+      padding: 2rem;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .form-section h2 {
+      color: var(--primary);
+      margin-block-end: 0.5rem;
+    }
+
+    .form-section > p {
+      margin-block-end: 1.5rem;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.25rem;
+      margin-block-end: 1.5rem;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      display: inline-block;
+      padding: 10px 0;
+      margin: -10px 0;
+    }
+
+    .hint {
+      font-size: 0.875rem;
+      color: #5d4037;
+    }
+
+    input,
+    textarea,
+    select {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--text);
+      background-color: #ffffff;
+      border: 1px solid #767676;
+      border-radius: 5px;
+      padding: 0.65rem 0.75rem;
+      min-height: 48px;
+      align-self: start;
+      justify-self: start;
+    }
+
+    @media (pointer: coarse) {
+      input,
+      textarea,
+      select,
+      button[type="submit"] {
+        min-height: 52px;
+      }
+    }
+
+    input {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    textarea {
+      field-sizing: content;
+      height: auto;
+      width: 50ch;
+      max-inline-size: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: 50ch;
+    }
+
+    input:focus-visible,
+    textarea:focus-visible,
+    select:focus-visible,
+    button[type="submit"]:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    input:user-invalid,
+    textarea:user-invalid,
+    select:user-invalid {
+      border-color: #b71c1c;
+    }
+
+    button[type="submit"] {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      min-height: 48px;
+      border: none;
+      cursor: pointer;
+    }
+
