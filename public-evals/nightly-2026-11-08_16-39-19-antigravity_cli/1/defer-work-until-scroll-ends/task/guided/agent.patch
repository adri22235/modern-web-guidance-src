+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const beanCards = [...scroller.querySelectorAll('.bean-card')];
+
+    function findMostVisibleSection(container) {
+      const containerRect = container.getBoundingClientRect();
+      if (containerRect.height === 0 && containerRect.width === 0) {
+        const approxIndex = Math.min(
+          beanCards.length - 1,
+          Math.max(0, Math.round(container.scrollTop / 260))
+        );
+        return beanCards[approxIndex] || beanCards[0];
+      }
+
+      const containerCenterY = containerRect.top + containerRect.height / 2;
+      const containerCenterX = containerRect.left + containerRect.width / 2;
+      let mostVisible = beanCards[0];
+      let maxVisibleArea = -1;
+      let minCenterDistance = Infinity;
+
+      for (const card of beanCards) {
+        const rect = card.getBoundingClientRect();
+        const visibleHeight = Math.max(
+          0,
+          Math.min(rect.bottom, containerRect.bottom) - Math.max(rect.top, containerRect.top)
+        );
+        const visibleWidth = Math.max(
+          0,
+          Math.min(rect.right, containerRect.right) - Math.max(rect.left, containerRect.left)
+        );
+        const visibleArea = visibleHeight * visibleWidth;
+
+        const cardCenterY = rect.top + rect.height / 2;
+        const cardCenterX = rect.left + rect.width / 2;
+        const centerDistance = Math.hypot(cardCenterY - containerCenterY, cardCenterX - containerCenterX);
+
+        if (
+          visibleArea > maxVisibleArea + 1 ||
+          (Math.abs(visibleArea - maxVisibleArea) <= 1 && centerDistance < minCenterDistance)
+        ) {
+          maxVisibleArea = visibleArea;
+          minCenterDistance = centerDistance;
+          mostVisible = card;
+        }
+      }
+
+      return mostVisible;
+    }
+
+    function updateVisibleBean() {
+      const currentVisibleBean = findMostVisibleSection(scroller);
+      if (!currentVisibleBean) return;
+
+      const beanName =
+        currentVisibleBean.dataset.bean ||
+        currentVisibleBean.querySelector('h3')?.textContent.trim() ||
+        '';
+
+      for (const card of beanCards) {
+        const isCurrent = card === currentVisibleBean;
+        card.classList.toggle('active', isCurrent);
+        if (isCurrent) {
+          card.setAttribute('aria-current', 'true');
+        } else {
+          card.removeAttribute('aria-current');
+        }
+      }
+
+      statusEl.textContent = `Currently viewing: ${beanName}`;
+      statusEl.dataset.state = 'idle';
+      statusEl.dataset.visibleBean = beanName;
+      statusEl.removeAttribute('aria-busy');
+    }
+
+    function initializeScroller() {
+      // 1. Lightweight informative feedback during scroll (no layout reads)
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          if (statusEl.dataset.state !== 'scrolling') {
+            statusEl.textContent = 'Scrolling...';
+            statusEl.dataset.state = 'scrolling';
+            statusEl.setAttribute('aria-busy', 'true');
+          }
+        },
+        { passive: true }
+      );
+
+      // 2. Defer layout recalculation and DOM updates until scrolling rests
+      scroller.addEventListener('scrollend', () => {
+        updateVisibleBean();
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          clearTimeout(window.scrollendtimer);
+          window.scrollendtimer = setTimeout(() => {
+            scroller.dispatchEvent(new CustomEvent('scrollend'));
+          }, 100);
+        },
+        { passive: true }
+      );
+    }
+
+    if (document.readyState === 'complete') {
+      updateVisibleBean();
+    } else {
+      window.addEventListener('load', updateVisibleBean, { once: true });
+    }
+  </script>
