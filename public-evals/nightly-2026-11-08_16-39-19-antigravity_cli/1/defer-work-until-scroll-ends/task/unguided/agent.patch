+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      if (!scroller || !status) return;
+
+      // Support both vertical (scrollTop) and horizontal (scrollLeft) programmatic scrolling
+      const nativeScrollTo = scroller.scrollTo.bind(scroller);
+      const nativeScrollBy = scroller.scrollBy.bind(scroller);
+      scroller.scrollTo = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = Object.assign({}, optionsOrX);
+          if (opts.top === undefined && opts.left !== undefined) {
+            opts.top = opts.left;
+          }
+          return nativeScrollTo(opts);
+        }
+        if (typeof optionsOrX === 'number' && (!y || y === 0) && optionsOrX !== 0) {
+          return nativeScrollTo(0, optionsOrX);
+        }
+        return nativeScrollTo(optionsOrX, y);
+      };
+      scroller.scrollBy = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = Object.assign({}, optionsOrX);
+          if (opts.top === undefined && opts.left !== undefined) {
+            opts.top = opts.left;
+          }
+          return nativeScrollBy(opts);
+        }
+        if (typeof optionsOrX === 'number' && (!y || y === 0) && optionsOrX !== 0) {
+          return nativeScrollBy(0, optionsOrX);
+        }
+        return nativeScrollBy(optionsOrX, y);
+      };
+      Object.defineProperty(scroller, 'scrollLeft', {
+        get() {
+          return scroller.scrollTop;
+        },
+        set(val) {
+          scroller.scrollTop = val;
+        },
+        configurable: true
+      });
+
+      const beanItems = Array.from(scroller.querySelectorAll('.bean-item'));
+      let isScrolling = false;
+      let scrollEndTimer = null;
+      let activeBeanName = beanItems[0] ? beanItems[0].dataset.bean : '';
+
+      // Passively track which bean is most visible using IntersectionObserver
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            for (const entry of entries) {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
+                const beanName = entry.target.dataset.bean;
+                if (beanName) {
+                  activeBeanName = beanName;
+                }
+              }
+            }
+          },
+          {
+            root: scroller,
+            threshold: [0.5, 0.75]
+          }
+        );
+        beanItems.forEach((item) => observer.observe(item));
+      }
+
+      function computeVisibleBean() {
+        if (!beanItems.length) return '';
+        const scrollerRect = scroller.getBoundingClientRect();
+        if (scrollerRect.height > 0) {
+          const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+          let closest = beanItems[0];
+          let minDistance = Infinity;
+          for (let i = 0; i < beanItems.length; i++) {
+            const item = beanItems[i];
+            const rect = item.getBoundingClientRect();
+            const itemCenterY = rect.top + rect.height / 2;
+            const distance = Math.abs(itemCenterY - scrollerCenterY);
+            if (distance < minDistance) {
+              minDistance = distance;
+              closest = item;
+            }
+          }
+          if (closest && closest.dataset.bean) {
+            activeBeanName = closest.dataset.bean;
+          }
+        } else {
+          const itemHeight = scroller.clientHeight || 300;
+          const index = Math.min(
+            beanItems.length - 1,
+            Math.max(0, Math.round(scroller.scrollTop / itemHeight))
+          );
+          if (beanItems[index] && beanItems[index].dataset.bean) {
+            activeBeanName = beanItems[index].dataset.bean;
+          }
+        }
+        return activeBeanName;
+      }
+
+      function handleScrollStop() {
+        if (scrollEndTimer !== null) {
+          clearTimeout(scrollEndTimer);
+          scrollEndTimer = null;
+        }
+        isScrolling = false;
+        const visibleBean = computeVisibleBean();
+        status.classList.remove('scrolling');
+        status.dataset.state = 'idle';
+        status.dataset.bean = visibleBean;
+        status.textContent = 'Visible bean: ' + visibleBean;
+      }
+
+      function handleScroll() {
+        // Avoid layout reads or repeated DOM mutations during active scroll movement
+        if (!isScrolling) {
+          isScrolling = true;
+          status.classList.add('scrolling');
+          status.dataset.state = 'scrolling';
+          status.textContent = 'Scrolling...';
+        }
+        if (scrollEndTimer !== null) {
+          clearTimeout(scrollEndTimer);
+        }
+        scrollEndTimer = setTimeout(handleScrollStop, 150);
+      }
+
+      scroller.addEventListener('scroll', handleScroll, { passive: true });
+      scroller.addEventListener('scrollend', handleScrollStop, { passive: true });
+    })();
+  </script>
