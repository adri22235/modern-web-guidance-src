+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with our signature double-shot espresso and a dusting of warm cinnamon.',
+        price: '$5.50',
+        roast: 'Medium Roast',
+        caffeine: '150 mg',
+        defaultMilk: 'Oat Milk',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+        alt: 'Steaming Maple Oat Latte with latte art in a ceramic mug'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Slow-roasted beans delivering rich dark chocolate notes and a velvety crema.',
+        price: '$3.75',
+        roast: 'Dark Roast',
+        caffeine: '180 mg',
+        defaultMilk: 'No Milk',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+        alt: 'Freshly pulled Dark Roast Espresso shot in a demitasse cup'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours in cold filtered water for maximum smoothness, low acidity, and a naturally sweet cocoa finish.',
+        price: '$4.75',
+        roast: 'Medium-Dark Coarse',
+        caffeine: '200 mg',
+        defaultMilk: 'Oat Milk',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80',
+        alt: 'Chilled Cold Brew coffee poured over ice in a tall glass'
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const titleEl = document.getElementById('dialog-title');
+    const descEl = document.getElementById('dialog-description');
+    const priceEl = document.getElementById('dialog-price');
+    const roastEl = document.getElementById('dialog-roast');
+    const caffeineEl = document.getElementById('dialog-caffeine');
+    const imageEl = document.getElementById('dialog-image');
+    const drinkSelect = document.getElementById('order-drink');
+    const orderForm = document.getElementById('drink-order-form');
+    const orderStatus = document.getElementById('order-status');
+
+    function updateDrinkView(drinkId) {
+      const drink = DRINKS[drinkId] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      descEl.textContent = drink.description;
+      priceEl.textContent = drink.price;
+      roastEl.textContent = drink.roast;
+      caffeineEl.textContent = drink.caffeine;
+      imageEl.src = drink.image;
+      imageEl.alt = drink.alt;
+      drinkSelect.value = drinkId in DRINKS ? drinkId : 'maple-oat-latte';
+
+      const milkInput = orderForm.querySelector(`input[name="milk"][value="${drink.defaultMilk}"]`);
+      if (milkInput) {
+        milkInput.checked = true;
+      }
+    }
+
+    for (const trigger of document.querySelectorAll('button[data-drink]')) {
+      trigger.addEventListener('click', () => {
+        updateDrinkView(trigger.dataset.drink);
+        if (!dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    drinkSelect.addEventListener('change', () => {
+      updateDrinkView(drinkSelect.value);
+    });
+
+    const closeBtn = dialog.querySelector('.dialog-close-btn');
+    closeBtn.addEventListener('click', () => {
+      if (dialog.open) {
+        dialog.close();
+      }
+    });
+
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (action === 'order') {
+        const data = new FormData(orderForm);
+        const drink = DRINKS[data.get('drink')] || DRINKS['maple-oat-latte'];
+        const size = data.get('size');
+        const milk = data.get('milk');
+        const quantity = data.get('quantity');
+        orderStatus.textContent = `Added ${quantity}x ${size} ${drink.name} (${milk}) to your order.`;
+        orderStatus.hidden = false;
+      }
+    });
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dlg.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dlg);
+        });
+        dlg.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dlg)) {
+            dlg.close();
+          }
+        });
+        dlg.addEventListener('click', (event) => {
+          if (event.target !== dlg) return;
+          if (outside(event, dlg)) {
+            dlg.close();
+          }
+        });
+      }
+    }
+  </script>
+
 </body>
 
