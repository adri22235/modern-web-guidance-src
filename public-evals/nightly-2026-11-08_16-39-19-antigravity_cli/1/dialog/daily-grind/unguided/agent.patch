+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          price: '$5.50',
+          description: 'Rich double-shot espresso combined with steamed barista-grade oat milk and pure Grade A Vermont maple syrup, finished with a dash of cinnamon.',
+          notes: 'Toasted oats, warm maple, subtle spice • 210 kcal (12oz)',
+          defaultMilk: 'Oat Milk',
+          defaultTemp: 'Hot'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          price: '$3.75',
+          description: 'Bold, smokey single-origin Sumatra and Colombian blend pulled to perfection with a rich, velvety crema for the ultimate morning boost.',
+          notes: 'Dark chocolate, roasted walnut, smoky finish • 15 kcal (double shot)',
+          defaultMilk: 'None (Black)',
+          defaultTemp: 'Hot'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          price: '$4.75',
+          description: 'Coarse-ground artisanal beans steeped in filtered cold water for 18 hours for maximum smoothness, naturally sweet flavor, and low acidity.',
+          notes: 'Smooth cocoa, caramel undertone, crisp finish • 10 kcal (12oz)',
+          defaultMilk: 'None (Black)',
+          defaultTemp: 'Iced'
+        }
+      };
+
+      const modal = document.getElementById('drink-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalPrice = document.getElementById('modal-price');
+      const modalDesc = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const orderForm = document.getElementById('drink-order-form');
+      const drinkSelectGroup = document.getElementById('drink-select-group');
+      const drinkSelect = document.getElementById('order-drink-select');
+      const milkSelect = document.getElementById('order-milk-select');
+      const tempHot = document.getElementById('temp-hot');
+      const tempIced = document.getElementById('temp-iced');
+      const quantityInput = document.getElementById('order-quantity');
+      const orderStatus = document.getElementById('order-status');
+
+      let lastFocusedTrigger = null;
+
+      function populateDrinkDetails(drinkKey) {
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        modalTitle.textContent = drink.name;
+        modalPrice.textContent = drink.price;
+        modalDesc.textContent = drink.description;
+        modalNotes.textContent = drink.notes;
+        milkSelect.value = drink.defaultMilk;
+        if (drink.defaultTemp === 'Iced') {
+          tempIced.checked = true;
+        } else {
+          tempHot.checked = true;
+        }
+      }
+
+      function getFocusableElements() {
+        const selector = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
+        return Array.from(modal.querySelectorAll(selector)).filter((el) => !el.closest('[hidden]'));
+      }
+
+      function openModal(triggerKey, triggerEl) {
+        lastFocusedTrigger = triggerEl || document.activeElement;
+        orderStatus.hidden = true;
+        orderStatus.textContent = '';
+        quantityInput.value = '1';
+
+        const mediumRadio = orderForm.querySelector('input[name="size"][value="Medium (12oz)"]');
+        if (mediumRadio) mediumRadio.checked = true;
+
+        if (triggerKey === 'order-now') {
+          drinkSelectGroup.hidden = false;
+          drinkSelect.value = 'maple-oat-latte';
+          populateDrinkDetails('maple-oat-latte');
+        } else {
+          drinkSelectGroup.hidden = true;
+          drinkSelect.value = triggerKey;
+          populateDrinkDetails(triggerKey);
+        }
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+
+        closeBtn.focus();
+      }
+
+      function closeModal() {
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+          restoreFocus();
+        }
+      }
+
+      function restoreFocus() {
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+          lastFocusedTrigger = null;
+        }
+      }
+
+      document.querySelectorAll('[data-drink-trigger]').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          const key = btn.getAttribute('data-drink-trigger');
+          openModal(key, btn);
+        });
+      });
+
+      drinkSelect.addEventListener('change', () => {
+        populateDrinkDetails(drinkSelect.value);
+      });
+
+      closeBtn.addEventListener('click', () => {
+        closeModal();
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        closeModal();
+      });
+
+      // Dismiss when clicking on the backdrop (outside the modal content)
+      modal.addEventListener('click', (e) => {
+        if (e.target === modal) {
+          closeModal();
+        }
+      });
+
+      // Return focus to the trigger element whenever the dialog closes (Escape, close button, backdrop, form submit)
+      modal.addEventListener('close', () => {
+        restoreFocus();
+      });
+
+      // Trap Tab focus inside the modal and handle Escape key fallback
+      modal.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeModal();
+          return;
+        }
+
+        if (e.key === 'Tab') {
+          const focusables = getFocusableElements();
+          if (focusables.length === 0) return;
+          const first = focusables[0];
+          const last = focusables[focusables.length - 1];
+
+          if (e.shiftKey) {
+            if (document.activeElement === first || document.activeElement === modal) {
+              e.preventDefault();
+              last.focus();
+            }
+          } else {
+            if (document.activeElement === last) {
+              e.preventDefault();
+              first.focus();
+            }
+          }
+        }
+      });
+
+      orderForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        closeModal();
+      });
+    })();
+  </script>
 </body>
 
