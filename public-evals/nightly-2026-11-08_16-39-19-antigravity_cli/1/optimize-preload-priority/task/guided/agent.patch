diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,135 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Video Showcase</title>
+
+  <!-- Elevate priority for the video poster image (LCP candidate) -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+
+  <!-- Preload critical header font (fonts default to high priority, so omit fetchpriority="high") -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Deprioritize secondary font preload to avoid network contention with critical assets -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <!-- Inline critical styles directly in head to avoid render-blocking stylesheet requests -->
+  <style>
+    @font-face {
+      font-family: "Brand Font";
+      src: url("brand-font.woff2") format("woff2");
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: "Secondary Font";
+      src: url("secondary-font.woff2") format("woff2");
+      font-display: swap;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      min-height: 100vh;
+      display: grid;
+      grid-template-rows: auto 1fr auto;
+      background-color: #0b0d10;
+      color: #f3f4f6;
+      font-family: "Secondary Font", system-ui, sans-serif;
+      font-size-adjust: from-font;
+    }
+
+    header, main, footer {
+      width: min(100% - 2rem, 64rem);
+      margin-inline: auto;
+    }
+
+    header {
+      padding-block: 2rem 1rem;
+    }
+
+    h1 {
+      margin: 0;
+      font-family: "Brand Font", system-ui, sans-serif;
+      font-size-adjust: from-font;
+      font-size: clamp(1.75rem, 4vw, 2.75rem);
+      line-height: 1.15;
+      letter-spacing: -0.02em;
+    }
+
+    .tagline {
+      margin-block: 0.5rem 0;
+      color: #9ca3af;
+      font-size: 1rem;
+    }
+
+    main {
+      padding-block: 1rem 2rem;
+    }
+
+    .video-frame {
+      margin: 0;
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 9;
+      border-radius: 0.5rem;
+      background-color: #161920;
+    }
+
+    .video-meta {
+      margin-block-start: 0.75rem;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 1rem;
+      color: #9ca3af;
+      font-size: 0.875rem;
+    }
+
+    footer {
+      padding-block: 1.5rem;
+      border-block-start: 1px solid #1f242d;
+      color: #9ca3af;
+      font-size: 0.875rem;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Instant Playback Architecture</h1>
+    <p class="tagline">High-efficiency streaming engineered for immediate visual paint.</p>
+  </header>
+
+  <main>
+    <figure class="video-frame">
+      <video
+        controls
+        width="1280"
+        height="720"
+        poster="poster.jpg"
+        preload="none"
+      >
+        <source src="feature.webm" type="video/webm">
+        <source src="feature.mp4" type="video/mp4">
+        <track src="captions.vtt" kind="captions" srclang="en" label="English">
+      </video>
+      <figcaption class="video-meta">
+        <span>Keynote overview (02:14)</span>
+        <span>4K HDR60</span>
+      </figcaption>
+    </figure>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 Video Showcase. All rights reserved.</p>
+  </footer>
+</body>
+</html>
