diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,123 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Minimal Video Landing Page</title>
+
+  <!-- Prioritize the LCP element (video poster image) -->
+  <link rel="preload" href="poster.jpg" as="image" type="image/jpeg" fetchpriority="high">
+
+  <!-- Preload critical header web font -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Note: secondary-font.woff2 is NOT preloaded so it does not compete for bandwidth with poster.jpg -->
+
+  <style>
+    @font-face {
+      font-family: 'BrandFont';
+      src: url('brand-font.woff2') format('woff2');
+      font-weight: 700;
+      font-style: normal;
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: 'SecondaryFont';
+      src: url('secondary-font.woff2') format('woff2');
+      font-weight: 400;
+      font-style: normal;
+      font-display: optional;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'SecondaryFont', system-ui, -apple-system, sans-serif;
+      background-color: #090a0f;
+      color: #f8fafc;
+      line-height: 1.5;
+    }
+
+    header {
+      max-width: 960px;
+      margin: 0 auto;
+      padding: 2rem 1.5rem 1.5rem;
+      text-align: center;
+    }
+
+    h1 {
+      font-family: 'BrandFont', system-ui, -apple-system, sans-serif;
+      font-size: clamp(2rem, 5vw, 3.25rem);
+      letter-spacing: -0.02em;
+      margin-bottom: 0.5rem;
+    }
+
+    .subtitle {
+      color: #94a3b8;
+      font-size: 1.125rem;
+    }
+
+    main {
+      max-width: 960px;
+      margin: 0 auto;
+      padding: 0 1.5rem 3rem;
+    }
+
+    .video-wrapper {
+      position: relative;
+      width: 100%;
+      aspect-ratio: 16 / 9;
+      background-color: #1e293b;
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    footer {
+      text-align: center;
+      padding: 1.5rem;
+      color: #64748b;
+      font-size: 0.875rem;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Next-Gen Video</h1>
+    <p class="subtitle">Ultra-fast playback with instant Largest Contentful Paint.</p>
+  </header>
+
+  <main>
+    <div class="video-wrapper">
+      <!-- preload="none" prevents video stream bytes from competing with poster.jpg during LCP -->
+      <video
+        poster="poster.jpg"
+        preload="none"
+        controls
+        playsinline
+        width="1280"
+        height="720"
+      >
+        <source src="video.mp4" type="video/mp4">
+        Your browser does not support HTML5 video.
+      </video>
+    </div>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 StreamLine. All rights reserved.</p>
+  </footer>
+</body>
+</html>
