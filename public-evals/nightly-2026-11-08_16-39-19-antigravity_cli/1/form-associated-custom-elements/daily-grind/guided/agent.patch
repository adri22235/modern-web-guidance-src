+  <script type="module">
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+      static observedAttributes = ['value', 'required'];
+
+      #internals;
+      #value = '';
+      #buttons = [];
+      #statusEl = null;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.#internals.role = 'group';
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.#buildShadowDom();
+        this.addEventListener('invalid', () => {
+          this.setAttribute('aria-invalid', 'true');
+        });
+      }
+
+      #buildShadowDom() {
+        const style = document.createElement('style');
+        style.textContent = `
+          :host {
+            display: inline-block;
+            --_star-active: var(--star-color-active, #ffab40);
+            --_star-inactive: var(--star-color-inactive, #bcaaa4);
+            --_star-focus: var(--star-color-focus, #4e342e);
+          }
+
+          :host(:disabled) {
+            opacity: 0.55;
+            pointer-events: none;
+          }
+
+          .stars-wrapper {
+            display: inline-flex;
+            align-items: center;
+            gap: 0.35rem;
+          }
+
+          button {
+            font: inherit;
+            color: var(--_star-inactive);
+            background: transparent;
+            border: 2px solid transparent;
+            border-radius: 6px;
+            min-width: 48px;
+            min-height: 48px;
+            padding: 0.25rem;
+            font-size: 1.85rem;
+            line-height: 1;
+            cursor: pointer;
+            display: inline-flex;
+            align-items: center;
+            justify-content: center;
+            transition: transform 0.15s ease, color 0.15s ease, border-color 0.15s ease;
+          }
+
+          @media (pointer: coarse) {
+            button {
+              min-width: 52px;
+              min-height: 52px;
+            }
+          }
+
+          button[aria-pressed="true"],
+          button.filled {
+            color: var(--_star-active);
+          }
+
+          button:hover:not(:disabled) {
+            transform: scale(1.1);
+            color: var(--_star-active);
+          }
+
+          button:focus-visible {
+            outline: 3px solid var(--_star-focus);
+            outline-offset: 2px;
+          }
+
+          button:disabled {
+            cursor: not-allowed;
+          }
+
+          .rating-readout {
+            margin-inline-start: 0.5rem;
+            font-size: 0.95rem;
+            font-weight: 600;
+            color: inherit;
+          }
+        `;
+
+        const wrapper = document.createElement('div');
+        wrapper.className = 'stars-wrapper';
+        wrapper.setAttribute('part', 'wrapper');
+
+        const labels = [
+          '1 star — Poor',
+          '2 stars — Fair',
+          '3 stars — Good',
+          '4 stars — Very Good',
+          '5 stars — Excellent',
+        ];
+
+        for (let i = 1; i <= 5; i += 1) {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.dataset.value = String(i);
+          btn.setAttribute('part', 'star');
+          btn.setAttribute('aria-label', labels[i - 1]);
+          btn.setAttribute('aria-pressed', 'false');
+          btn.setAttribute('tabindex', i === 1 ? '0' : '-1');
+          btn.textContent = '★';
+
+          btn.addEventListener('click', () => {
+            if (btn.disabled) return;
+            this.#selectByUser(String(i));
+          });
+
+          btn.addEventListener('keydown', (event) => {
+            if (btn.disabled) return;
+            const current = Number(this.#value) || i;
+            let next = null;
+            if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
+              next = Math.min(5, (Number(this.#value) || 0) + 1);
+            } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
+              next = Math.max(1, current - 1);
+            } else if (event.key === 'Home') {
+              next = 1;
+            } else if (event.key === 'End') {
+              next = 5;
+            }
+            if (next !== null) {
+              event.preventDefault();
+              this.#selectByUser(String(next));
+              this.#buttons[next - 1]?.focus();
+            }
+          });
+
+          this.#buttons.push(btn);
+          wrapper.appendChild(btn);
+        }
+
+        const readout = document.createElement('span');
+        readout.className = 'rating-readout';
+        readout.setAttribute('part', 'readout');
+        readout.setAttribute('aria-hidden', 'true');
+        readout.textContent = 'No rating selected';
+        this.#statusEl = readout;
+        wrapper.appendChild(readout);
+
+        this.shadowRoot.replaceChildren(style, wrapper);
+      }
+
+      connectedCallback() {
+        if (this.hasAttribute('value') && !this.#value) {
+          this.#value = this.getAttribute('value') ?? '';
+        }
+        this.#internals.setFormValue(this.#value);
+        this.#syncUI();
+        this.#validate();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'value') {
+          this.value = newVal ?? '';
+        } else if (name === 'required') {
+          this.#validate();
+        }
+      }
+
+      get value() {
+        return this.#value;
+      }
+
+      set value(v) {
+        const normalized = v == null ? '' : String(v).trim();
+        this.#value = normalized;
+        this.#internals.setFormValue(this.#value);
+        this.#syncUI();
+        this.#validate();
+      }
+
+      get form() {
+        return this.#internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name');
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this.#internals.validity;
+      }
+
+      get validationMessage() {
+        return this.#internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this.#internals.willValidate;
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        this.toggleAttribute('required', Boolean(val));
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(val) {
+        this.toggleAttribute('disabled', Boolean(val));
+      }
+
+      checkValidity() {
+        return this.#internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this.#internals.reportValidity();
+      }
+
+      #selectByUser(nextValue) {
+        const changed = this.#value !== nextValue;
+        this.value = nextValue;
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        if (changed) {
+          this.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      }
+
+      #syncUI() {
+        const numericValue = Number(this.#value) || 0;
+        const focusTargetIndex = numericValue >= 1 && numericValue <= 5 ? numericValue - 1 : 0;
+
+        this.#buttons.forEach((btn, idx) => {
+          const starNumber = idx + 1;
+          const isFilled = starNumber <= numericValue;
+          const isSelected = starNumber === numericValue;
+          btn.classList.toggle('filled', isFilled);
+          btn.setAttribute('aria-pressed', String(isSelected));
+          btn.setAttribute('tabindex', idx === focusTargetIndex ? '0' : '-1');
+        });
+
+        if (numericValue >= 1 && numericValue <= 5) {
+          this.#internals.states.add('rated');
+          this.#statusEl.textContent = `${numericValue} / 5 stars`;
+        } else {
+          this.#internals.states.delete('rated');
+          this.#statusEl.textContent = 'No rating selected';
+        }
+      }
+
+      #validate() {
+        if (this.hasAttribute('required') && !this.#value) {
+          this.#internals.setValidity(
+            { valueMissing: true },
+            'Please choose a rating.',
+            this.shadowRoot.querySelector('[tabindex="0"]') || this.shadowRoot.querySelector('[tabindex]'),
+          );
+        } else {
+          this.#internals.setValidity({});
+          this.removeAttribute('aria-invalid');
+        }
+      }
+
+      formResetCallback() {
+        this.value = this.getAttribute('value') ?? '';
+        this.removeAttribute('aria-invalid');
+      }
+
+      formDisabledCallback(disabled) {
+        // Disable internal controls so they leave the tab order and ignore clicks.
+        // Do NOT toggle `disabled` on `this`, or a `<fieldset disabled>` toggle will
+        // leave the host permanently stuck with its own `disabled` attribute.
+        for (const el of this.shadowRoot.querySelectorAll('button')) {
+          el.disabled = disabled;
+        }
+      }
+
+      formStateRestoreCallback(state) {
+        this.value = state ?? '';
+      }
+    }
+
+    customElements.define('star-rating', StarRating);
+
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackFieldset = document.getElementById('feedback-fieldset');
+    const disableToggle = document.getElementById('disable-fieldset-toggle');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    disableToggle.addEventListener('change', () => {
+      feedbackFieldset.disabled = disableToggle.checked;
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!feedbackForm.reportValidity()) {
+        return;
+      }
+
+      const formData = new FormData(feedbackForm);
+      const name = formData.get('customerName');
+      const beverageSelect = document.getElementById('coffee-beverage');
+      const beverageLabel =
+        beverageSelect.selectedOptions[0]?.textContent || formData.get('beverage');
+      const rating = formData.get('rating');
+      const notes = formData.get('notes');
+
+      feedbackStatus.hidden = false;
+      feedbackStatus.textContent = notes
+        ? `Thank you, ${name}! Your ${rating}-star review for ${beverageLabel} ("${notes}") has been recorded.`
+        : `Thank you, ${name}! Your ${rating}-star review for ${beverageLabel} has been recorded.`;
+    });
+
+    feedbackForm.addEventListener('reset', () => {
+      feedbackStatus.hidden = true;
+      feedbackStatus.textContent = '';
+    });
+  </script>
