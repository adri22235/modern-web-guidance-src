diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..e586458
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,90 @@
+// Initial theme & layout setup before render
+(function initThemeAndLayout() {
+  try {
+    const savedTheme = localStorage.getItem('theme') || 'light';
+    const savedLayout = localStorage.getItem('layout') || 'grid';
+    document.documentElement.dataset.theme = savedTheme;
+    document.documentElement.dataset.layout = savedLayout;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+    document.documentElement.dataset.layout = 'grid';
+  }
+})();
+
+// Context-dependent cross-document view transition setup
+if ('onpagereveal' in window) {
+  window.addEventListener('pagereveal', async (event) => {
+    if (!event.viewTransition) return;
+
+    const activation = window.navigation?.activation;
+    const from = activation?.from;
+    const entry = activation?.entry;
+    if (!from || !entry) return;
+
+    const fromUrl = new URL(from.url);
+    const toUrl = new URL(entry.url);
+
+    // Determine directional transition type based on route depth/order
+    const routeOrder = ['/', '/menu', '/locations', '/rewards', '/account', '/order-online'];
+    const normalize = (p) => p.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
+    const fromPath = normalize(fromUrl.pathname);
+    const toPath = normalize(toUrl.pathname);
+
+    const fromIdx = routeOrder.indexOf(fromPath);
+    const toIdx = routeOrder.indexOf(toPath);
+
+    if (toPath.startsWith('/menu/') && (fromPath === '/' || fromPath === '/menu')) {
+      event.viewTransition.types?.add('forwards');
+    } else if ((toPath === '/' || toPath === '/menu') && fromPath.startsWith('/menu/')) {
+      event.viewTransition.types?.add('backwards');
+    } else if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
+      event.viewTransition.types?.add(toIdx > fromIdx ? 'forwards' : 'backwards');
+    }
+
+    // Dynamically pair item card titles with detail page headings and clean up after transition
+    const detailSlugMatch = toPath.match(/^\/menu\/([a-z-]+)$/);
+    const reverseSlugMatch = fromPath.match(/^\/menu\/([a-z-]+)$/);
+    let targetEl = null;
+
+    if (detailSlugMatch) {
+      targetEl = document.querySelector('main h2, .hero h1');
+    } else if (reverseSlugMatch) {
+      const slug = reverseSlugMatch[1];
+      targetEl = document.querySelector(`[data-item="${slug}"] h3`);
+    }
+
+    if (targetEl) {
+      targetEl.style.viewTransitionName = 'featured-drink-title';
+      try {
+        await event.viewTransition.ready;
+      } catch (error) {
+        if (error.name !== 'InvalidStateError') {
+          throw error;
+        }
+      } finally {
+        await event.viewTransition.finished;
+        targetEl.style.viewTransitionName = '';
+      }
+    }
+  });
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  const toggleBtn = document.querySelector('.theme-toggle');
+  if (toggleBtn) {
+    const updateLabel = () => {
+      const current = document.documentElement.dataset.theme || 'light';
+      toggleBtn.textContent = current === 'dark' ? 'Light Mode' : 'Dark Mode';
+      toggleBtn.setAttribute('aria-pressed', String(current === 'dark'));
+    };
+    updateLabel();
+    toggleBtn.addEventListener('click', () => {
+      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
+      document.documentElement.dataset.theme = next;
+      try {
+        localStorage.setItem('theme', next);
+      } catch {}
+      updateLabel();
+    });
+  }
+});
