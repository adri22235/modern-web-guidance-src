+
+  ::view-transition-new(root) {
+    animation: 0.35s cubic-bezier(0.22, 1, 0.36, 1) both vt-fade-in;
+  }
+
+  html:active-view-transition-type(forward)::view-transition-old(root) {
+    animation: 0.3s ease-in-out both vt-slide-out-left;
+  }
+
+  html:active-view-transition-type(forward)::view-transition-new(root) {
+    animation: 0.35s cubic-bezier(0.22, 1, 0.36, 1) both vt-slide-in-right;
+  }
+
+  html:active-view-transition-type(backward)::view-transition-old(root) {
+    animation: 0.3s ease-in-out both vt-slide-out-right;
+  }
+
+  html:active-view-transition-type(backward)::view-transition-new(root) {
+    animation: 0.35s cubic-bezier(0.22, 1, 0.36, 1) both vt-slide-in-left;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
