+    <script is:inline blocking="render">
+      if ('onpagereveal' in window) {
+        const parseRoute = (rawUrl) => {
+          try {
+            const url = new URL(rawUrl, window.location.origin);
+            const path = decodeURIComponent(url.pathname).replace(/\/+$/, '');
+            const articleMatch = path.match(/\/articles\/([^/]+)$/);
+            if (articleMatch) {
+              return { type: 'article', slug: articleMatch[1], depth: 2 };
+            }
+            const categoryMatch = path.match(/\/category\/([^/]+)$/);
+            if (categoryMatch) {
+              return { type: 'category', slug: categoryMatch[1].toLowerCase(), depth: 1 };
+            }
+            if (path === '' || path === '/devtools-times') {
+              return { type: 'home', slug: '', depth: 0 };
+            }
+            return { type: 'other', slug: '', depth: 1 };
+          } catch {
+            return { type: 'other', slug: '', depth: 1 };
+          }
+        };
+
+        const getDirectionType = (fromRoute, toRoute) => {
+          if (toRoute.depth > fromRoute.depth) return 'forward';
+          if (toRoute.depth < fromRoute.depth) return 'backward';
+          return 'same-level';
+        };
+
+        const assignCardTransitionNames = (articleSlug, cleanupList) => {
+          if (!articleSlug) return;
+          const card = document.querySelector(`[data-article-slug="${CSS.escape(articleSlug)}"]`);
+          if (!card) return;
+
+          const titleEl = card.querySelector('[data-vt-title]');
+          if (titleEl instanceof HTMLElement) {
+            cleanupList.push([titleEl, titleEl.style.viewTransitionName]);
+            titleEl.style.viewTransitionName = 'article-title';
+          }
+
+          const imageEl = card.querySelector('[data-vt-image]');
+          if (imageEl instanceof HTMLElement) {
+            cleanupList.push([imageEl, imageEl.style.viewTransitionName]);
+            imageEl.style.viewTransitionName = 'article-image';
+          }
+        };
+
+        const assignCategoryTransitionName = (categorySlug, cleanupList) => {
+          if (!categorySlug) return;
+          const catEl = document.querySelector(`[data-category-slug="${CSS.escape(categorySlug)}"]`);
+          if (catEl instanceof HTMLElement) {
+            cleanupList.push([catEl, catEl.style.viewTransitionName]);
+            catEl.style.viewTransitionName = 'category-title';
+          }
+        };
+
+        window.addEventListener('pageswap', async (event) => {
+          if (!event.viewTransition) return;
+          const fromUrl = event.activation?.from?.url || window.location.href;
+          const toUrl = event.activation?.entry?.url;
+          if (!toUrl) return;
+
+          const fromRoute = parseRoute(fromUrl);
+          const toRoute = parseRoute(toUrl);
+          const direction = getDirectionType(fromRoute, toRoute);
+          event.viewTransition.types?.add(direction);
+
+          const cleanupList = [];
+
+          if (toRoute.type === 'article') {
+            if (fromRoute.type === 'article' && fromRoute.slug !== toRoute.slug) {
+              const mainTitle = document.querySelector('.vt-article-title');
+              const mainImage = document.querySelector('.vt-article-image');
+              if (mainTitle instanceof HTMLElement) {
+                cleanupList.push([mainTitle, mainTitle.style.viewTransitionName]);
+                mainTitle.style.viewTransitionName = 'none';
+              }
+              if (mainImage instanceof HTMLElement) {
+                cleanupList.push([mainImage, mainImage.style.viewTransitionName]);
+                mainImage.style.viewTransitionName = 'none';
+              }
+            }
+            if (fromRoute.type !== 'article' || fromRoute.slug !== toRoute.slug) {
+              assignCardTransitionNames(toRoute.slug, cleanupList);
+            }
+          } else if (toRoute.type === 'category' && fromRoute.type !== 'category') {
+            assignCategoryTransitionName(toRoute.slug, cleanupList);
+          }
+
+          try {
+            await event.viewTransition.ready;
+          } catch (error) {
+            if (error.name !== 'InvalidStateError') {
+              throw error;
+            }
+          } finally {
+            await event.viewTransition.finished;
+            for (const [el, prev] of cleanupList) {
+              el.style.viewTransitionName = prev;
+            }
+          }
+        });
+
+        window.addEventListener('pagereveal', async (event) => {
+          if (!event.viewTransition) return;
+          const from = window.navigation?.activation?.from;
+          const entry = window.navigation?.activation?.entry;
+          if (!from || !entry) return;
+
+          const fromRoute = parseRoute(from.url);
+          const toRoute = parseRoute(entry.url || window.location.href);
+          const direction = getDirectionType(fromRoute, toRoute);
+          event.viewTransition.types?.add(direction);
+
+          const cleanupList = [];
+
+          if (fromRoute.type === 'article' && toRoute.type !== 'article') {
+            assignCardTransitionNames(fromRoute.slug, cleanupList);
+          } else if (fromRoute.type === 'category' && toRoute.type !== 'category') {
+            assignCategoryTransitionName(fromRoute.slug, cleanupList);
+          }
+
+          try {
+            await event.viewTransition.ready;
+          } catch (error) {
+            if (error.name !== 'InvalidStateError') {
+              throw error;
+            }
+          } finally {
+            await event.viewTransition.finished;
+            for (const [el, prev] of cleanupList) {
+              el.style.viewTransitionName = prev;
+            }
+          }
+        });
+      }
+    </script>
