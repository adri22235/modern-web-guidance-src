+  <script>
+    (function () {
+      const CALENDARS = [
+        {
+          key: 'islamic',
+          cardId: 'islamic-card',
+          temporalCalendar: 'islamic-civil'
+        },
+        {
+          key: 'hebrew',
+          cardId: 'hebrew-card',
+          temporalCalendar: 'hebrew'
+        },
+        {
+          key: 'japanese',
+          cardId: 'japanese-card',
+          temporalCalendar: 'japanese'
+        }
+      ];
+
+      const dateInput = document.getElementById('calendar-date-picker');
+
+      function getTodayIsoString() {
+        if (typeof Temporal !== 'undefined' && Temporal.Now) {
+          return Temporal.Now.plainDateISO().toString();
+        }
+        const now = new Date();
+        const y = now.getFullYear();
+        const m = String(now.getMonth() + 1).padStart(2, '0');
+        const d = String(now.getDate()).padStart(2, '0');
+        return `${y}-${m}-${d}`;
+      }
+
+      function computeCalendarDataWithTemporal(isoDateStr, todayIsoStr, calendarId) {
+        const selectedPlain = Temporal.PlainDate.from(isoDateStr);
+        const todayPlain = Temporal.PlainDate.from(todayIsoStr);
+        const cmp = Temporal.PlainDate.compare(selectedPlain, todayPlain);
+        const status = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+        const calDate = selectedPlain.withCalendar(calendarId);
+        const localizedDate = calDate.toLocaleString('en-US', {
+          calendar: calendarId,
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+          era: 'long'
+        });
+
+        const months = [];
+        for (let m = 1; m <= calDate.monthsInYear; m++) {
+          const monthStart = calDate.with({ month: m, day: 1 });
+          months.push({
+            monthNumber: m,
+            monthCode: monthStart.monthCode,
+            daysInMonth: monthStart.daysInMonth
+          });
+        }
+
+        return {
+          status,
+          localizedDate,
+          year: calDate.year,
+          eraYear: calDate.eraYear,
+          era: calDate.era,
+          month: calDate.month,
+          monthCode: calDate.monthCode,
+          monthsInYear: calDate.monthsInYear,
+          months
+        };
+      }
+
+      function renderCard(cardEl, data) {
+        const statusEl = cardEl.querySelector('[data-field="status"]');
+        statusEl.textContent = data.status;
+        statusEl.classList.toggle('today', data.status === 'Today');
+
+        const localizedEl = cardEl.querySelector('[data-field="localized-date"]');
+        localizedEl.textContent = data.localizedDate;
+
+        const yearEl = cardEl.querySelector('[data-field="year"]');
+        yearEl.textContent = String(data.year);
+
+        const monthEl = cardEl.querySelector('[data-field="month"]');
+        monthEl.textContent = String(data.month);
+
+        const monthCodeEl = cardEl.querySelector('[data-field="month-code"]');
+        monthCodeEl.textContent = data.monthCode;
+
+        const monthsInYearEl = cardEl.querySelector('[data-field="months-in-year"]');
+        monthsInYearEl.textContent = String(data.monthsInYear);
+
+        const breakdownEl = cardEl.querySelector('[data-field="months-breakdown"]');
+        breakdownEl.innerHTML = '';
+        for (const m of data.months) {
+          const li = document.createElement('li');
+          li.className = 'month-chip' + (m.monthCode === data.monthCode ? ' active-month' : '');
+          li.dataset.monthCode = m.monthCode;
+          li.dataset.days = String(m.daysInMonth);
+          li.innerHTML = `<span class="month-chip-code">${m.monthCode}</span><span class="month-chip-days">${m.daysInMonth} days</span>`;
+          breakdownEl.appendChild(li);
+        }
+      }
+
+      function updateAllCards(isoDateStr) {
+        if (!isoDateStr || !/^\d{4}-\d{2}-\d{2}$/.test(isoDateStr)) return;
+        const todayIsoStr = getTodayIsoString();
+
+        for (const cal of CALENDARS) {
+          const cardEl = document.getElementById(cal.cardId);
+          if (!cardEl) continue;
+          const data = computeCalendarDataWithTemporal(isoDateStr, todayIsoStr, cal.temporalCalendar);
+          renderCard(cardEl, data);
+        }
+      }
+
+      const initialDate = getTodayIsoString();
+      dateInput.value = initialDate;
+      updateAllCards(initialDate);
+
+      dateInput.addEventListener('input', (e) => {
+        updateAllCards(e.target.value);
+      });
+      dateInput.addEventListener('change', (e) => {
+        updateAllCards(e.target.value);
+      });
+    })();
+  </script>
 </body>
 
