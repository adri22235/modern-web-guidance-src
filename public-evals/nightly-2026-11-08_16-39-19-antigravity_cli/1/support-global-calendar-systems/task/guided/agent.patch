+  <script>
+    const WORLD_CALENDARS = [
+      {
+        elementId: 'islamic-date',
+        name: 'Islamic Calendar',
+        calendarId: 'islamic',
+        fallbacks: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla']
+      },
+      {
+        elementId: 'hebrew-date',
+        name: 'Hebrew Calendar',
+        calendarId: 'hebrew',
+        fallbacks: []
+      },
+      {
+        elementId: 'japanese-date',
+        name: 'Japanese Calendar',
+        calendarId: 'japanese',
+        fallbacks: []
+      }
+    ];
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function convertToCalendar(isoDate, calendarId, fallbacks = []) {
+      const candidates = [calendarId, ...fallbacks];
+      for (const candidate of candidates) {
+        if (isCalendarSupported(candidate)) {
+          try {
+            return isoDate.withCalendar(candidate);
+          } catch {
+            // Continue to fallback calendar variant if engine rejects generic alias
+          }
+        }
+      }
+      return isoDate;
+    }
+
+    function renderCalendarCard(config, selectedIsoDate, todayIsoDate) {
+      const cardEl = document.getElementById(config.elementId);
+      if (!cardEl) return;
+
+      const targetDate = convertToCalendar(selectedIsoDate, config.calendarId, config.fallbacks);
+      const todayInCalendar = convertToCalendar(todayIsoDate, config.calendarId, config.fallbacks);
+      const activeCalendarId = targetDate.calendarId || (targetDate.calendar && targetDate.calendar.id) || config.calendarId;
+
+      const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+      const relativeTimeline = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      const localizedDisplay = targetDate.toLocaleString(`en-u-ca-${activeCalendarId}`, {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric',
+        era: 'long'
+      });
+
+      const monthItemsHtml = [];
+      for (let m = 1; m <= targetDate.monthsInYear; m++) {
+        const monthDate = targetDate.with({ month: m });
+        const isCurrentMonth = monthDate.monthCode === targetDate.monthCode;
+        monthItemsHtml.push(
+          `<li class="${isCurrentMonth ? 'active-month' : ''}" data-month="${m}" data-month-code="${monthDate.monthCode}">` +
+            `<span class="month-code">${monthDate.monthCode}</span>` +
+            `<span class="month-days">${monthDate.daysInMonth} days</span>` +
+          `</li>`
+        );
+      }
+
+      cardEl.innerHTML = `
+        <div class="calendar-card-header">
+          <h3>${config.name}</h3>
+          <span class="timeline-badge" data-timeline="${relativeTimeline}">${relativeTimeline}</span>
+        </div>
+        <p class="localized-date">${localizedDisplay}</p>
+        <div class="calendar-meta">
+          <div>
+            <strong>Converted Year</strong>
+            <span class="converted-year">${targetDate.year}</span>
+          </div>
+          <div>
+            <strong>Numeric Month</strong>
+            <span class="numeric-month">${targetDate.month}</span>
+          </div>
+          <div>
+            <strong>Month Code</strong>
+            <span class="month-code-value">${targetDate.monthCode}</span>
+          </div>
+          <div>
+            <strong>Months in Year</strong>
+            <span class="months-in-year">${targetDate.monthsInYear}</span>
+          </div>
+        </div>
+        <div class="months-breakdown">
+          <h4>Months Breakdown (${targetDate.monthsInYear} months)</h4>
+          <ul class="months-list">
+            ${monthItemsHtml.join('')}
+          </ul>
+        </div>
+      `;
+    }
+
+    function updateAllCalendars(isoString) {
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      let selectedIsoDate = todayIsoDate;
+      if (isoString) {
+        try {
+          selectedIsoDate = Temporal.PlainDate.from(isoString);
+        } catch {
+          selectedIsoDate = todayIsoDate;
+        }
+      }
+
+      for (const config of WORLD_CALENDARS) {
+        renderCalendarCard(config, selectedIsoDate, todayIsoDate);
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('calendar-date-picker');
+      const todayIso = Temporal.Now.plainDateISO().toString();
+
+      if (dateInput) {
+        if (!dateInput.value) {
+          dateInput.value = todayIso;
+        }
+        updateAllCalendars(dateInput.value);
+
+        const handleDateChange = (event) => {
+          updateAllCalendars(event.target.value);
+        };
+        dateInput.addEventListener('input', handleDateChange);
+        dateInput.addEventListener('change', handleDateChange);
+      } else {
+        updateAllCalendars(todayIso);
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
