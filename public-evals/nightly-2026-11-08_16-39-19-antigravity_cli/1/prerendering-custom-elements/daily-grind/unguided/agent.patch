+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited', 'name', 'description', 'price', 'calories', 'notes', 'href'];
+      }
+
+      constructor() {
+        super();
+        this._isHydrated = false;
+        this._onDetailsClick = () => this.toggleDetails();
+        this._onFavoriteClick = () => this.toggleFavorite();
+      }
+
+      connectedCallback() {
+        if (!this.shadowRoot) {
+          const dsdTemplate = this.querySelector('template[shadowrootmode]');
+          if (dsdTemplate) {
+            const mode = dsdTemplate.getAttribute('shadowrootmode') || 'open';
+            const root = this.attachShadow({ mode });
+            root.appendChild(dsdTemplate.content);
+            dsdTemplate.remove();
+          } else {
+            this._createClientShadowRoot();
+          }
+        }
+
+        this._hydrateInPlace();
+      }
+
+      _hydrateInPlace() {
+        if (!this.shadowRoot) return;
+
+        this._detailsBtn = this.shadowRoot.querySelector('.details-btn');
+        this._favoriteBtn = this.shadowRoot.querySelector('.favorite-btn');
+        this._detailsPanel = this.shadowRoot.querySelector('.details-panel');
+        this._heartIcon = this.shadowRoot.querySelector('.heart');
+        this._favLabel = this.shadowRoot.querySelector('.fav-label');
+
+        if (!this._isHydrated) {
+          if (this._detailsBtn) {
+            this._detailsBtn.addEventListener('click', this._onDetailsClick);
+          }
+          if (this._favoriteBtn) {
+            this._favoriteBtn.addEventListener('click', this._onFavoriteClick);
+          }
+          this._isHydrated = true;
+          this.setAttribute('data-hydrated', 'true');
+        }
+
+        this._syncExpandedState();
+        this._syncFavoritedState();
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(val) {
+        if (val) {
+          this.setAttribute('expanded', '');
+        } else {
+          this.removeAttribute('expanded');
+        }
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        if (val) {
+          this.setAttribute('favorited', '');
+        } else {
+          this.removeAttribute('favorited');
+        }
+      }
+
+      toggleDetails(force) {
+        const nextState = typeof force === 'boolean' ? force : !this.expanded;
+        this.expanded = nextState;
+        this.dispatchEvent(
+          new CustomEvent('drink-details-toggle', {
+            detail: {
+              drinkId: this.getAttribute('drink-id') || '',
+              name: this.getAttribute('name') || '',
+              expanded: nextState,
+            },
+            bubbles: true,
+            composed: true,
+          })
+        );
+        return nextState;
+      }
+
+      toggleFavorite(force) {
+        const nextState = typeof force === 'boolean' ? force : !this.favorited;
+        this.favorited = nextState;
+        this.dispatchEvent(
+          new CustomEvent('drink-favorite-toggle', {
+            detail: {
+              drinkId: this.getAttribute('drink-id') || '',
+              name: this.getAttribute('name') || '',
+              favorited: nextState,
+            },
+            bubbles: true,
+            composed: true,
+          })
+        );
+        return nextState;
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this.shadowRoot) return;
+
+        if (name === 'expanded') {
+          this._syncExpandedState();
+        } else if (name === 'favorited') {
+          this._syncFavoritedState();
+        } else if (name === 'name') {
+          const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+          if (titleSlot && titleSlot.textContent !== newValue) {
+            titleSlot.textContent = newValue || '';
+          }
+        } else if (name === 'description') {
+          const descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+          if (descSlot && descSlot.textContent !== newValue) {
+            descSlot.textContent = newValue || '';
+          }
+        } else if (name === 'price') {
+          const priceEl = this.shadowRoot.querySelector('.price-badge');
+          if (priceEl && priceEl.textContent !== newValue) {
+            priceEl.textContent = newValue || '';
+          }
+        } else if (name === 'calories') {
+          const calEl = this.shadowRoot.querySelector('.calories-badge');
+          if (calEl && calEl.textContent !== newValue) {
+            calEl.textContent = newValue || '';
+          }
+        } else if (name === 'notes') {
+          const notesSlot = this.shadowRoot.querySelector('slot[name="notes"]');
+          if (notesSlot && notesSlot.textContent !== newValue) {
+            notesSlot.textContent = newValue || '';
+          }
+        } else if (name === 'href') {
+          const linkEl = this.shadowRoot.querySelector('.menu-link');
+          if (linkEl && newValue) {
+            linkEl.setAttribute('href', newValue);
+          }
+        }
+      }
+
+      _syncExpandedState() {
+        const isExpanded = this.expanded;
+        const expandedStr = isExpanded ? 'true' : 'false';
+        const label = isExpanded ? 'Hide Details' : 'View Details';
+
+        if (this._detailsBtn) {
+          if (this._detailsBtn.getAttribute('aria-expanded') !== expandedStr) {
+            this._detailsBtn.setAttribute('aria-expanded', expandedStr);
+          }
+          if (this._detailsBtn.textContent !== label) {
+            this._detailsBtn.textContent = label;
+          }
+        }
+        if (this._detailsPanel && this._detailsPanel.hidden !== !isExpanded) {
+          this._detailsPanel.hidden = !isExpanded;
+        }
+      }
+
+      _syncFavoritedState() {
+        const isFavorited = this.favorited;
+        const pressedStr = isFavorited ? 'true' : 'false';
+        const heartChar = isFavorited ? '\u2665' : '\u2661';
+        const labelText = isFavorited ? 'Favorited' : 'Favorite';
+
+        if (this._favoriteBtn && this._favoriteBtn.getAttribute('aria-pressed') !== pressedStr) {
+          this._favoriteBtn.setAttribute('aria-pressed', pressedStr);
+        }
+        if (this._heartIcon && this._heartIcon.textContent !== heartChar) {
+          this._heartIcon.textContent = heartChar;
+        }
+        if (this._favLabel && this._favLabel.textContent !== labelText) {
+          this._favLabel.textContent = labelText;
+        }
+      }
+
+      _createClientShadowRoot() {
+        const root = this.attachShadow({ mode: 'open' });
+        const existingCard = document.querySelector('drink-card');
+        const styleText = existingCard?.shadowRoot?.querySelector('style')?.textContent || '';
+        const drinkId = this.getAttribute('drink-id') || 'custom';
+        const name = this.getAttribute('name') || 'Seasonal Drink';
+        const description = this.getAttribute('description') || '';
+        const price = this.getAttribute('price') || '';
+        const calories = this.getAttribute('calories') || '';
+        const notes = this.getAttribute('notes') || '';
+        const href = this.getAttribute('href') || '/menu';
+
+        const styleEl = document.createElement('style');
+        styleEl.textContent = styleText;
+
+        const article = document.createElement('article');
+        article.className = 'card';
+        article.setAttribute('part', 'card');
+        article.innerHTML = `
+          <h3><slot name="title"></slot></h3>
+          <p class="summary"><slot name="description"></slot></p>
+          <div class="card-actions">
+            <button type="button" class="btn details-btn" data-action="details" aria-expanded="false" aria-controls="details-${drinkId}">View Details</button>
+            <button type="button" class="favorite-btn" data-action="favorite" aria-pressed="false"><span class="heart" aria-hidden="true">&#9825;</span> <span class="fav-label">Favorite</span></button>
+          </div>
+          <div class="details-panel" id="details-${drinkId}" hidden>
+            <div class="meta-badges">
+              <span class="badge price-badge"></span>
+              <span class="badge calories-badge"></span>
+            </div>
+            <p class="details-notes"><slot name="notes"></slot></p>
+            <a class="menu-link">Explore on Menu &rarr;</a>
+          </div>
+        `;
+
+        article.querySelector('slot[name="title"]').textContent = name;
+        article.querySelector('slot[name="description"]').textContent = description;
+        article.querySelector('.favorite-btn').setAttribute('aria-label', `Favorite ${name}`);
+        article.querySelector('.price-badge').textContent = price;
+        article.querySelector('.calories-badge').textContent = calories;
+        article.querySelector('slot[name="notes"]').textContent = notes;
+        article.querySelector('.menu-link').setAttribute('href', href);
+
+        root.append(styleEl, article);
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
 </body>
 
 </html>
