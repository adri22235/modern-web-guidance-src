+</Layout>
+
+<script>
+    function switchToView(viewId: string, options: { moveFocus?: boolean; updateHistory?: boolean } = {}) {
+        const { moveFocus = true, updateHistory = false } = options;
+        const normalizedId = viewId.startsWith('view-') ? viewId : `view-${viewId}`;
+        const activeView = document.getElementById(normalizedId);
+        if (!activeView) return;
+
+        // Hide all views while preserving their rendered DOM state via content-visibility: hidden
+        document.querySelectorAll<HTMLElement>('.spa-view').forEach((view) => {
+            view.classList.add('inactive');
+            view.setAttribute('aria-hidden', 'true');
+            view.setAttribute('inert', 'inert');
+        });
+
+        // Show the target view
+        activeView.classList.remove('inactive');
+        activeView.setAttribute('aria-hidden', 'false');
+        activeView.removeAttribute('inert');
+
+        // Update navigation tab states
+        document.querySelectorAll<HTMLElement>('[data-view-target]').forEach((tab) => {
+            const isActive = tab.getAttribute('data-view-target') === normalizedId;
+            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
+            tab.classList.toggle('border-amber-500', isActive);
+            tab.classList.toggle('text-gray-900', isActive);
+            tab.classList.toggle('border-transparent', !isActive);
+            tab.classList.toggle('text-gray-500', !isActive);
+        });
+
+        if (updateHistory) {
+            const slug = normalizedId.replace(/^view-/, '');
+            const url = new URL(window.location.href);
+            url.hash = slug;
+            window.history.replaceState({ viewId: normalizedId }, '', url.toString());
+        }
+
+        // MANDATORY: Move focus to the new view to ensure a logical tab-order
+        if (moveFocus) {
+            activeView.focus({ preventScroll: true });
+        }
+    }
+
+    function initSpaNavigation() {
+        (window as any).switchToView = switchToView;
+
+        document.querySelectorAll<HTMLElement>('[data-view-target]').forEach((tab) => {
+            tab.addEventListener('click', () => {
+                const targetId = tab.getAttribute('data-view-target');
+                if (targetId) {
+                    switchToView(targetId, { moveFocus: true, updateHistory: true });
+                }
+            });
+        });
+
+        window.addEventListener('spa-navigate', ((event: CustomEvent<{ viewId: string }>) => {
+            if (event.detail?.viewId) {
+                switchToView(event.detail.viewId, { moveFocus: true, updateHistory: true });
+            }
+        }) as EventListener);
+
+        const hash = window.location.hash.replace(/^#/, '');
+        if (hash && document.getElementById(hash.startsWith('view-') ? hash : `view-${hash}`)) {
+            switchToView(hash, { moveFocus: false, updateHistory: false });
+        }
+    }
+
+    initSpaNavigation();
+    document.addEventListener('astro:page-load', initSpaNavigation);
+</script>
