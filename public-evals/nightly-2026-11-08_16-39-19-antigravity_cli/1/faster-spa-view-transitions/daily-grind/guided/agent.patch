+    function switchToView(viewId) {
+      const normalizedId = viewId.replace(/^view-/, '');
+      const activeView = document.getElementById(normalizedId) || document.getElementById(viewId);
+      if (!activeView) return;
+
+      // Hide all views while keeping their rendered state cached in memory
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+        view.setAttribute('inert', 'inert');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+      activeView.removeAttribute('inert');
+
+      // Update navigation active state
+      document.querySelectorAll('nav a[data-view]').forEach(link => {
+        if (link.dataset.view === activeView.id) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      // Update document title for accessibility
+      if (VIEW_TITLES[activeView.id]) {
+        document.title = VIEW_TITLES[activeView.id];
+      }
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      activeView.focus();
+    }
+
+    // Intercept SPA navigation links
+    document.addEventListener('click', event => {
+      const link = event.target.closest('a[data-view]');
+      if (!link) return;
+
+      const viewId = link.dataset.view;
+      if (!viewId || !document.getElementById(viewId)) return;
+
+      event.preventDefault();
+      const targetHref = link.getAttribute('href') || `/${viewId}`;
+      try {
+        if (window.location.pathname !== targetHref) {
+          window.history.pushState({ viewId }, '', targetHref);
+        }
+      } catch {
+        // Ignore history pushState restrictions on file:// origins
+      }
+      switchToView(viewId);
+    });
+
+    // Sync view with browser back/forward navigation
+    window.addEventListener('popstate', event => {
+      const stateView = event.state && event.state.viewId;
+      const pathView = window.location.pathname.replace(/^\//, '') || 'home';
+      const targetView = stateView || (document.getElementById(pathView) ? pathView : 'home');
+      switchToView(targetView);
+    });
