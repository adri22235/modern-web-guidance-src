+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const paySubmitBtn = document.getElementById('pay-submit-btn');
+    const paymentStatus = document.getElementById('payment-status');
+
+    const errorMessages = {
+      'cc-number': 'Please enter a valid 13 to 19 digit card number.',
+      'cc-name': 'Please enter the cardholder name as it appears on your card.',
+      'cc-exp': 'Please enter a valid expiry date in MM/YY format.',
+      'cc-csc': 'Please enter the 3 or 4 digit security code.'
+    };
+
+    const inputs = paymentForm.querySelectorAll('input');
+
+    inputs.forEach((input) => {
+      const errorEl = document.getElementById(`${input.id}-error`);
+      let touched = false;
+
+      input.addEventListener('invalid', () => {
+        input.setCustomValidity(errorMessages[input.id] || 'Please enter a valid value.');
+      });
+
+      input.addEventListener('input', () => {
+        touched = true;
+        input.setCustomValidity('');
+        if (input.checkValidity()) {
+          input.removeAttribute('aria-invalid');
+          if (errorEl) errorEl.textContent = '';
+        }
+      });
+
+      input.addEventListener('blur', () => {
+        if (!touched && !input.value) return;
+        input.setCustomValidity('');
+        if (!input.checkValidity()) {
+          const msg = errorMessages[input.id] || input.validationMessage;
+          input.setCustomValidity(msg);
+          input.setAttribute('aria-invalid', 'true');
+          if (errorEl) errorEl.textContent = msg;
+        } else {
+          input.removeAttribute('aria-invalid');
+          if (errorEl) errorEl.textContent = '';
+        }
+      });
+    });
+
+    paymentForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      let firstInvalid = null;
+
+      inputs.forEach((input) => {
+        const errorEl = document.getElementById(`${input.id}-error`);
+        input.setCustomValidity('');
+        if (!input.checkValidity()) {
+          const msg = errorMessages[input.id] || input.validationMessage;
+          input.setCustomValidity(msg);
+          input.setAttribute('aria-invalid', 'true');
+          if (errorEl) errorEl.textContent = msg;
+          if (!firstInvalid) firstInvalid = input;
+        } else {
+          input.removeAttribute('aria-invalid');
+          if (errorEl) errorEl.textContent = '';
+        }
+      });
+
+      if (firstInvalid) {
+        firstInvalid.focus();
+        return;
+      }
+
+      paySubmitBtn.disabled = true;
+      paymentStatus.textContent = 'Payment submitted successfully.';
+    });
+  </script>
+
 </body>
 
