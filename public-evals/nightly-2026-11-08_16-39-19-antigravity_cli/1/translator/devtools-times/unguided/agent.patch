+/**
+ * Detects the language of a text snippet using the browser's On-Device `LanguageDetector` API
+ * with an on-device heuristic fallback.
+ */
+export async function detectTextLanguage(
+  text: string,
+  options?: { signal?: AbortSignal; onDownloadProgress?: (percent: number) => void }
+): Promise<{ detectedLanguage: string; confidence: number; engine: string }> {
+  const sample = text.trim().slice(0, 600);
+  if (!sample) {
+    return { detectedLanguage: 'en', confidence: 1, engine: 'heuristic' };
+  }
+
+  if (typeof window !== 'undefined') {
+    const monitorCallback = options?.onDownloadProgress
+      ? (monitor: AICreateMonitor) => {
+          monitor.addEventListener('downloadprogress', (ev: Event) => {
+            const pe = ev as ProgressEvent;
+            const fraction =
+              pe.total && pe.total > 1
+                ? pe.loaded / pe.total
+                : typeof pe.loaded === 'number' && pe.loaded <= 1
+                ? pe.loaded
+                : (pe.loaded ?? 0) / 100;
+            options.onDownloadProgress?.(Math.min(100, Math.max(0, Math.round(fraction * 100))));
+          });
+        }
+      : undefined;
+
+    // 1. Standard `window.LanguageDetector`
+    if ('LanguageDetector' in window && window.LanguageDetector?.create) {
+      try {
+        const detector = await window.LanguageDetector.create({
+          signal: options?.signal,
+          monitor: monitorCallback,
+        });
+        const results = await detector.detect(sample, { signal: options?.signal });
+        if (results && results.length > 0 && results[0].detectedLanguage) {
+          const code = results[0].detectedLanguage.toLowerCase().split('-')[0];
+          if (getLanguageOption(code)) {
+            return {
+              detectedLanguage: code,
+              confidence: results[0].confidence ?? 0.95,
+              engine: 'web-language-detector-api',
+            };
+          }
+        }
+      } catch {
+        // Fall through to heuristic detector
+      }
+    }
+
+    // 2. Legacy `window.ai.languageDetector`
+    if (window.ai?.languageDetector?.create) {
+      try {
+        const detector = await window.ai.languageDetector.create({
+          signal: options?.signal,
+          monitor: monitorCallback,
+        });
+        const results = await detector.detect(sample, { signal: options?.signal });
+        if (results && results.length > 0 && results[0].detectedLanguage) {
+          const code = results[0].detectedLanguage.toLowerCase().split('-')[0];
+          if (getLanguageOption(code)) {
+            return {
+              detectedLanguage: code,
+              confidence: results[0].confidence ?? 0.9,
+              engine: 'legacy-ai-language-detector',
+            };
+          }
+        }
+      } catch {
+        // Fall through
+      }
+    }
+  }
+
+  // 3. Fast On-Device Script & Lexical Heuristic Detection
+  return heuristicDetectLanguage(sample);
+}
+
+function heuristicDetectLanguage(sample: string): {
+  detectedLanguage: string;
+  confidence: number;
+  engine: string;
+} {
+  // Check non-Latin scripts first
+  if (/[\u3040-\u30ff]/.test(sample)) return { detectedLanguage: 'ja', confidence: 0.98, engine: 'on-device-heuristic' };
+  if (/[\uac00-\ud7af]/.test(sample)) return { detectedLanguage: 'ko', confidence: 0.98, engine: 'on-device-heuristic' };
+  if (/[\u4e00-\u9fff]/.test(sample)) return { detectedLanguage: 'zh', confidence: 0.96, engine: 'on-device-heuristic' };
+  if (/[\u0600-\u06ff]/.test(sample)) return { detectedLanguage: 'ar', confidence: 0.98, engine: 'on-device-heuristic' };
+  if (/[\u0900-\u097f]/.test(sample)) return { detectedLanguage: 'hi', confidence: 0.98, engine: 'on-device-heuristic' };
+  if (/[\u0400-\u04ff]/.test(sample)) return { detectedLanguage: 'ru', confidence: 0.97, engine: 'on-device-heuristic' };
+
+  const lower = ` ${sample.toLowerCase()} `;
+  const markers: Record<string, RegExp[]> = {
+    es: [/\b(el|la|los|las|una|del|para|con|por|como|más|sobre|entre|está|son)\b/g, /[áéíóúñ¿¡]/g],
+    fr: [/\b(le|la|les|des|une|dans|pour|avec|sur|plus|sont|comme|cette|aux)\b/g, /[éèêëàâùûçœ]/g],
+    de: [/\b(der|die|das|und|den|von|mit|auf|für|eine|einer|nicht|sich|sind|wird)\b/g, /[äöüß]/g],
+    pt: [/\b(os|as|uma|para|com|não|mais|pelo|pela|são|como|dos|das|está)\b/g, /[ãõçáéíóúâêô]/g],
+    it: [/\b(il|lo|gli|della|delle|degli|nella|con|per|sono|come|più|anche|questa)\b/g],
+    nl: [/\b(de|het|een|van|en|in|op|voor|met|zijn|wordt|naar|over|niet)\b/g],
+    tr: [/\b(bir|ve|için|ile|olan|olarak|daha|gibi|yeni|çok)\b/g, /[ğüşöçıİ]/g],
+    pl: [/\b(oraz|dla|przez|jako|jest|się|nie|tym|przy)\b/g, /[ąćęłńóśźż]/g],
+    vi: [/\b(của|những|trong|được|với|cho|các|một|người|không)\b/g, /[ăâđêôơư]/g],
+    en: [/\b(the|and|that|with|from|this|their|have|are|for|into|more|world|about)\b/g],
+  };
+
+  let bestLang = 'en';
+  let bestScore = 0;
+
+  for (const [lang, regexes] of Object.entries(markers)) {
+    let score = 0;
+    for (const rx of regexes) {
+      const matches = lower.match(rx);
+      if (matches) score += matches.length;
+    }
+    if (score > bestScore) {
+      bestScore = score;
+      bestLang = lang;
+    }
+  }
+
+  return {
+    detectedLanguage: bestLang,
+    confidence: bestScore > 2 ? 0.92 : 0.8,
+    engine: 'on-device-heuristic',
+  };
+}
+
+async function getOrCreateNativeTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  options?: {
+    signal?: AbortSignal;
+    onDownloadProgress?: (percent: number) => void;
+  }
+): Promise<TranslatorInstance | null> {
+  if (typeof window === 'undefined') return null;
+
+  const src = sourceLanguage.toLowerCase().split('-')[0];
+  const tgt = targetLanguage.toLowerCase().split('-')[0];
+  const pairKey = `${src}->${tgt}`;
+
+  const attachMonitor = (monitor: AICreateMonitor) => {
+    monitor.addEventListener('downloadprogress', (ev: Event) => {
+      const pe = ev as ProgressEvent;
+      const fraction =
+        pe.total && pe.total > 1
+          ? pe.loaded / pe.total
+          : typeof pe.loaded === 'number' && pe.loaded <= 1
+          ? pe.loaded
+          : (pe.loaded ?? 0) / 100;
+      const percent = Math.min(100, Math.max(0, Math.round(fraction * 100)));
+      options?.onDownloadProgress?.(percent);
+    });
+  };
+
+  // If no custom abort signal or progress callback is active and we have a cached translator, return it
+  if (translatorInstanceCache.has(pairKey)) {
+    try {
+      return await translatorInstanceCache.get(pairKey)!;
+    } catch {
+      translatorInstanceCache.delete(pairKey);
+    }
+  }
+
+  const createPromise = (async (): Promise<TranslatorInstance> => {
+    // 1. Standard W3C / Chrome Built-in AI `window.Translator`
+    if ('Translator' in window && window.Translator && typeof window.Translator.create === 'function') {
+      return await window.Translator.create({
+        sourceLanguage: src,
+        targetLanguage: tgt,
+        signal: options?.signal,
+        monitor: attachMonitor,
+      });
+    }
+
+    // 2. Legacy `window.ai.translator`
+    if (window.ai?.translator && typeof window.ai.translator.create === 'function') {
+      return await window.ai.translator.create({
+        sourceLanguage: src,
+        targetLanguage: tgt,
+        signal: options?.signal,
+        monitor: attachMonitor,
+      });
+    }
+
+    // 3. Legacy `window.translation`
+    if (window.translation?.createTranslator) {
+      return await window.translation.createTranslator({
+        sourceLanguage: src,
+        targetLanguage: tgt,
+        signal: options?.signal,
+        monitor: attachMonitor,
+      });
+    }
+
+    throw new Error('Native Web Translator API not present');
+  })();
+
+  translatorInstanceCache.set(pairKey, createPromise);
+
+  try {
+    return await createPromise;
+  } catch (err) {
+    translatorInstanceCache.delete(pairKey);
+    throw err;
+  }
+}
