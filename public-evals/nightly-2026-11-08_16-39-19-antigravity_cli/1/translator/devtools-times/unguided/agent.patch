+function localOnDeviceTranslate(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string,
+  originalEnglishText?: string
+): string {
+  const src = sourceLanguage.toLowerCase().split('-')[0];
+  const tgt = targetLanguage.toLowerCase().split('-')[0];
+  if (src === tgt) return text;
+
+  const lookupSource = (originalEnglishText || text).toLowerCase();
+
+  // If translating back to English and we know the original English phrase or reverse lookup
+  if (tgt === 'en') {
+    if (originalEnglishText) return originalEnglishText;
+    for (const [enKey, langMap] of Object.entries(EXACT_PHRASE_TRANSLATIONS)) {
+      for (const val of Object.values(langMap)) {
+        if (val.toLowerCase() === text.toLowerCase()) {
+          return enKey.charAt(0).toUpperCase() + enKey.slice(1);
+        }
+      }
+    }
+  }
+
+  // 1. Check exact phrase dictionary
+  const exactEntry = EXACT_PHRASE_TRANSLATIONS[lookupSource];
+  if (exactEntry && exactEntry[tgt]) {
+    return exactEntry[tgt];
+  }
+
+  // 2. Check reading time pattern e.g. "5 Min." or "5 Min Read"
+  const minMatch = text.match(/^(\d+)\s*Min\.?(\s*Read)?$/i);
+  if (minMatch) {
+    const num = minMatch[1];
+    const unitMap: Record<string, string> = {
+      es: `${num} min de lectura`,
+      fr: `${num} min de lecture`,
+      de: `${num} Min. Lesezeit`,
+      ja: `読了約${num}分`,
+      pt: `${num} min de leitura`,
+      it: `${num} min di lettura`,
+      zh: `${num} 分钟阅读`,
+      ko: `${num}분 읽기`,
+      en: `${num} Min.`,
+    };
+    if (unitMap[tgt]) return unitMap[tgt];
+  }
+
+  // 3. Multi-phrase & sentence-level transformation for article paragraphs and summaries
+  return compositionalTranslateParagraph(originalEnglishText || text, tgt);
+}
