index 0000000..72f3eb4
--- /dev/null
+++ b/src/components/HeaderTranslationControl.tsx
@@ -0,0 +1,483 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  checkTranslatorAvailability,
+  getTranslationPreferences,
+  saveTranslationPreferences,
+  subscribeTranslationPreferences,
+  subscribeTranslationStateChange,
+  translateAllPageContent,
+  resetAllPageContent,
+  isAnyPageContentTranslated,
+  getLanguageName,
+  type AvailabilityCheckResult,
+  type TranslationDisplayMode,
+} from '../utils/onDeviceTranslator';
+
+export default function HeaderTranslationControl() {
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [displayMode, setDisplayMode] = useState<TranslationDisplayMode>('inline');
+  const [autoTranslatePage, setAutoTranslatePage] = useState<boolean>(false);
+
+  const [availability, setAvailability] = useState<AvailabilityCheckResult | null>(null);
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isPageTranslated, setIsPageTranslated] = useState<boolean>(false);
+  const [activeTargetLang, setActiveTargetLang] = useState<string | null>(null);
+  const [progress, setProgress] = useState<{ completed: number; total: number; downloadProgress: number | null }>({
+    completed: 0,
+    total: 0,
+    downloadProgress: null,
+  });
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  // Sync preferences from storage and other controls
+  useEffect(() => {
+    const prefs = getTranslationPreferences();
+    setSourceLanguage(prefs.sourceLanguage);
+    setTargetLanguage(prefs.targetLanguage);
+    setDisplayMode(prefs.displayMode);
+    setAutoTranslatePage(prefs.autoTranslatePage);
+    setIsPageTranslated(isAnyPageContentTranslated());
+
+    const unsubPrefs = subscribeTranslationPreferences((updated) => {
+      setSourceLanguage(updated.sourceLanguage);
+      setTargetLanguage(updated.targetLanguage);
+      setDisplayMode(updated.displayMode);
+      setAutoTranslatePage(updated.autoTranslatePage);
+    });
+
+    const unsubState = subscribeTranslationStateChange((detail) => {
+      const anyTranslated = isAnyPageContentTranslated();
+      setIsPageTranslated(anyTranslated);
+      if (detail.action === 'translate' && typeof detail.targetLanguage === 'string') {
+        setActiveTargetLang(detail.targetLanguage);
+      } else if (!anyTranslated) {
+        setActiveTargetLang(null);
+      }
+    });
+
+    return () => {
+      unsubPrefs();
+      unsubState();
+    };
+  }, []);
+
+  // Check availability whenever language pair changes
+  useEffect(() => {
+    let cancelled = false;
+    checkTranslatorAvailability(sourceLanguage, targetLanguage).then((res) => {
+      if (!cancelled) {
+        setAvailability(res);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  const handleTranslatePage = useCallback(
+    async (overrideSource?: string, overrideTarget?: string, overrideMode?: TranslationDisplayMode) => {
+      const src = overrideSource ?? sourceLanguage;
+      const tgt = overrideTarget ?? targetLanguage;
+      const mode = overrideMode ?? displayMode;
+
+      if (src !== 'auto' && src === tgt) {
+        setErrorMessage('Source and target languages are the same. Choose a different target language.');
+        return;
+      }
+
+      setErrorMessage(null);
+      abortControllerRef.current?.abort();
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+
+      setIsTranslating(true);
+      setProgress({ completed: 0, total: 0, downloadProgress: null });
+
+      try {
+        const result = await translateAllPageContent({
+          sourceLanguage: src,
+          targetLanguage: tgt,
+          displayMode: mode,
+          signal: controller.signal,
+          onProgress(p) {
+            setProgress(p);
+          },
+        });
+        setIsPageTranslated(result.translatedContainers > 0 || isAnyPageContentTranslated());
+        setActiveTargetLang(result.targetLanguage);
+      } catch (err: any) {
+        if (err?.name !== 'AbortError') {
+          setErrorMessage(err?.message || 'On-device translation encountered an error.');
+        }
+      } finally {
+        if (abortControllerRef.current === controller) {
+          setIsTranslating(false);
+          abortControllerRef.current = null;
+        }
+      }
+    },
+    [sourceLanguage, targetLanguage, displayMode]
+  );
+
+  // Handle Astro View Transitions (`astro:page-load`) for auto-translate
+  useEffect(() => {
+    const onPageLoad = () => {
+      const anyTranslated = isAnyPageContentTranslated();
+      setIsPageTranslated(anyTranslated);
+      const prefs = getTranslationPreferences();
+      if (prefs.autoTranslatePage && !anyTranslated) {
+        handleTranslatePage(prefs.sourceLanguage, prefs.targetLanguage, prefs.displayMode);
+      }
+    };
+    document.addEventListener('astro:page-load', onPageLoad);
+    return () => document.removeEventListener('astro:page-load', onPageLoad);
+  }, [handleTranslatePage]);
+
+  const handleSourceChange = (newSource: string) => {
+    setErrorMessage(null);
+    let nextTarget = targetLanguage;
+    if (newSource !== 'auto' && newSource === targetLanguage) {
+      nextTarget = sourceLanguage !== 'auto' && sourceLanguage !== newSource ? sourceLanguage : newSource === 'en' ? 'es' : 'en';
+    }
+    setSourceLanguage(newSource);
+    setTargetLanguage(nextTarget);
+    saveTranslationPreferences({ sourceLanguage: newSource, targetLanguage: nextTarget });
+  };
+
+  const handleTargetChange = (newTarget: string) => {
+    setErrorMessage(null);
+    let nextSource = sourceLanguage;
+    if (sourceLanguage !== 'auto' && sourceLanguage === newTarget) {
+      nextSource = targetLanguage !== newTarget ? targetLanguage : newTarget === 'en' ? 'es' : 'en';
+    }
+    setSourceLanguage(nextSource);
+    setTargetLanguage(newTarget);
+    saveTranslationPreferences({ sourceLanguage: nextSource, targetLanguage: newTarget });
+  };
+
+  const handleSwapLanguages = () => {
+    setErrorMessage(null);
+    const currentEffectiveSource =
+      sourceLanguage === 'auto' ? activeTargetLang || 'en' : sourceLanguage;
+    const nextSource = targetLanguage;
+    const nextTarget = currentEffectiveSource === targetLanguage
+      ? (targetLanguage === 'en' ? 'es' : 'en')
+      : currentEffectiveSource;
+
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    saveTranslationPreferences({ sourceLanguage: nextSource, targetLanguage: nextTarget });
+  };
+
+  const handleDisplayModeChange = (mode: TranslationDisplayMode) => {
+    setDisplayMode(mode);
+    saveTranslationPreferences({ displayMode: mode });
+    if (isPageTranslated && !isTranslating) {
+      handleTranslatePage(sourceLanguage, targetLanguage, mode);
+    }
+  };
+
+  const handleAutoTranslateToggle = (checked: boolean) => {
+    setAutoTranslatePage(checked);
+    saveTranslationPreferences({ autoTranslatePage: checked });
+    if (checked && !isPageTranslated && !isTranslating) {
+      handleTranslatePage();
+    }
+  };
+
+  const handleResetPage = () => {
+    abortControllerRef.current?.abort();
+    setIsTranslating(false);
+    setErrorMessage(null);
+    resetAllPageContent();
+    setIsPageTranslated(false);
+    setActiveTargetLang(null);
+  };
+
+  const handleCancel = () => {
+    abortControllerRef.current?.abort();
+    setIsTranslating(false);
+  };
+
+  const renderAvailabilityBadge = () => {
+    if (!availability) return null;
+    switch (availability.status) {
+      case 'available':
+        return (
+          <span
+            data-testid="translator-availability-badge"
+            data-availability="available"
+            className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200"
+            title="Browser On-Device Translator API is ready"
+          >
+            <span className="w-1.5 h-1.5 rounded-full bg-emerald-500" />
+            On-Device AI Ready
+          </span>
+        );
+      case 'downloadable':
+        return (
+          <span
+            data-testid="translator-availability-badge"
+            data-availability="downloadable"
+            className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200"
+            title="Language pack will be downloaded on-device when translating"
+          >
+            <span className="w-1.5 h-1.5 rounded-full bg-amber-500" />
+            Model Downloadable
+          </span>
+        );
+      case 'downloading':
+        return (
+          <span
+            data-testid="translator-availability-badge"
+            data-availability="downloading"
+            className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200"
+          >
+            <span className="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping" />
+            Downloading Model
+          </span>
+        );
+      case 'unavailable':
+        return (
+          <span
+            data-testid="translator-availability-badge"
+            data-availability="unavailable"
+            className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-rose-50 text-rose-800 border border-rose-200"
+            title="Native language pair unavailable; built-in on-device fallback will be used"
+          >
+            <span className="w-1.5 h-1.5 rounded-full bg-rose-500" />
+            Pair Fallback
+          </span>
+        );
+      default:
+        return (
+          <span
+            data-testid="translator-availability-badge"
+            data-availability="fallback"
+            className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 text-gray-700 border border-gray-300"
+            title="Using built-in on-device browser translation engine"
+          >
+            <span className="w-1.5 h-1.5 rounded-full bg-amber-500" />
+            On-Device Engine
+          </span>
+        );
+    }
+  };
+
+  return (
+    <div
+      data-no-translate="true"
+      data-testid="header-translation-control"
+      className="bg-stone-50 border-b border-gray-300 text-xs text-gray-800"
+    >
+      <div className="container mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-2">
+        {/* Left: Title + On-Device Status Badge */}
+        <div className="flex items-center gap-2 flex-wrap">
+          <div className="flex items-center gap-1.5 font-semibold text-gray-900">
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+              className="w-4 h-4 text-amber-700"
+              aria-hidden="true"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            <span>Translate News &amp; Teasers</span>
+          </div>
+          {renderAvailabilityBadge()}
+          {isPageTranslated && activeTargetLang && (
+            <span
+              data-testid="header-translated-indicator"
+              className="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-medium border border-amber-300"
+            >
+              Translated to {getLanguageName(activeTargetLang)}
+            </span>
+          )}
+        </div>
+
+        {/* Right: Language Pair Selectors & Action Buttons */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source Language */}
+          <label className="inline-flex items-center gap-1 text-gray-600">
+            <span className="sr-only sm:not-sr-only font-medium">From:</span>
+            <select
+              aria-label="Source language"
+              data-testid="header-source-language"
+              value={sourceLanguage}
+              onChange={(e) => handleSourceChange(e.target.value)}
+              disabled={isTranslating}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
+            >
+              <option value="auto">Auto-detect</option>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </label>
+
+          {/* Swap Languages Button */}
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={isTranslating}
+            aria-label="Swap source and target languages"
+            data-testid="header-swap-languages"
+            title="Swap languages"
+            className="p-1 rounded border border-gray-300 bg-white hover:bg-amber-50 hover:border-amber-400 text-gray-700 transition-colors cursor-pointer disabled:opacity-50"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+              className="w-3.5 h-3.5"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+              />
+            </svg>
+          </button>
+
+          {/* Target Language */}
+          <label className="inline-flex items-center gap-1 text-gray-600">
+            <span className="sr-only sm:not-sr-only font-medium">To:</span>
+            <select
+              aria-label="Target language"
+              data-testid="header-target-language"
+              value={targetLanguage}
+              onChange={(e) => handleTargetChange(e.target.value)}
+              disabled={isTranslating}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </label>
+
+          {/* Display Mode Selector (Inline vs Bilingual) */}
+          <div
+            className="inline-flex rounded border border-gray-300 bg-white overflow-hidden"
+            role="group"
+            aria-label="Translation display mode"
+          >
+            <button
+              type="button"
+              onClick={() => handleDisplayModeChange('inline')}
+              data-testid="header-mode-inline"
+              className={`px-2 py-1 text-[11px] font-medium transition-colors cursor-pointer ${
+                displayMode === 'inline'
+                  ? 'bg-gray-800 text-white'
+                  : 'text-gray-700 hover:bg-gray-100'
+              }`}
+              title="Replace text in place"
+            >
+              Inline
+            </button>
+            <button
+              type="button"
+              onClick={() => handleDisplayModeChange('bilingual')}
+              data-testid="header-mode-bilingual"
+              className={`px-2 py-1 text-[11px] font-medium border-l border-gray-300 transition-colors cursor-pointer ${
+                displayMode === 'bilingual'
+                  ? 'bg-gray-800 text-white'
+                  : 'text-gray-700 hover:bg-gray-100'
+              }`}
+              title="Show original and translated text together"
+            >
+              Bilingual
+            </button>
+          </div>
+
+          {/* Primary Translate Action Button */}
+          {!isTranslating ? (
+            <button
+              type="button"
+              onClick={() => handleTranslatePage()}
+              data-testid="header-translate-button"
+              className="bg-amber-700 hover:bg-amber-800 text-white font-semibold px-3 py-1 rounded transition-colors cursor-pointer shadow-xs"
+            >
+              {isPageTranslated ? 'Re-translate Page' : 'Translate Page'}
+            </button>
+          ) : (
+            <div className="inline-flex items-center gap-1.5">
+              <span
+                data-testid="header-translating-status"
+                className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-100 text-amber-900 font-medium"
+              >
+                <span className="w-3 h-3 border-2 border-amber-700 border-t-transparent rounded-full animate-spin" />
+                {progress.downloadProgress !== null && progress.downloadProgress < 100
+                  ? `Model ${progress.downloadProgress}%`
+                  : progress.total > 0
+                  ? `Translating ${progress.completed}/${progress.total}`
+                  : 'Translating...'}
+              </span>
+              <button
+                type="button"
+                onClick={handleCancel}
+                data-testid="header-cancel-translation"
+                className="px-2 py-1 rounded border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 font-medium cursor-pointer"
+              >
+                Cancel
+              </button>
+            </div>
+          )}
+
+          {/* Reset / Show Original Button */}
+          {isPageTranslated && (
+            <button
+              type="button"
+              onClick={handleResetPage}
+              data-testid="header-reset-button"
+              className="px-2.5 py-1 rounded border border-gray-300 bg-white hover:bg-gray-100 text-gray-800 font-medium transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+
+          {/* Auto-translate checkbox */}
+          <label
+            className="hidden md:inline-flex items-center gap-1 text-[11px] text-gray-600 cursor-pointer select-none ml-1"
+            title="Automatically translate news and teasers when navigating between pages"
+          >
+            <input
+              type="checkbox"
+              checked={autoTranslatePage}
+              onChange={(e) => handleAutoTranslateToggle(e.target.checked)}
+              data-testid="header-auto-translate-checkbox"
+              className="rounded border-gray-300 text-amber-700 focus:ring-amber-500"
+            />
+            <span>Auto</span>
+          </label>
+        </div>
+      </div>
+
+      {errorMessage && (
+        <div
+          role="alert"
+          className="container mx-auto px-4 pb-1.5 text-[11px] text-rose-700 font-medium"
+        >
+          {errorMessage}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/utils/onDeviceTranslator.ts b/src/utils/onDeviceTranslator.ts
