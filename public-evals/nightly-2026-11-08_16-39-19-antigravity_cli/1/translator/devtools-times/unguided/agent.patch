+function compositionalTranslateParagraph(text: string, targetLang: string): string {
+  if (targetLang === 'en') return text;
+
+  let output = text;
+  let replacedAnySentence = false;
+
+  for (const item of PHRASE_REPLACEMENTS) {
+    const replacement = item.translations[targetLang];
+    if (replacement && item.en.test(output)) {
+      output = output.replace(item.en, replacement);
+      replacedAnySentence = true;
+    }
+  }
+
+  // Exact heading/label check
+  if (WORD_LEXICON[output.trim()]?.[targetLang]) {
+    return WORD_LEXICON[output.trim()][targetLang];
+  }
+
+  // Word-by-word & common phrase substitution for remaining English segments
+  const commonConnectorReplacements: Array<[RegExp, Record<string, string>]> = [
+    [/\bIn a bold move to fight climate change and urban congestion\b/gi, {
+      es: 'En una medida audaz para combatir el cambio climático y la congestión urbana',
