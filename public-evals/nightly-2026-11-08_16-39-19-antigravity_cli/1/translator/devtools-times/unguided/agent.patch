+function normalizeAvailabilityStatus(raw: BuiltInAIAvailability | string | undefined): NormalizedAvailability {
+  switch (raw) {
+    case 'available':
+    case 'readily':
+      return 'available';
+    case 'downloadable':
+    case 'after-download':
+      return 'downloadable';
+    case 'downloading':
