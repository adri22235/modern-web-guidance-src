+/**
+ * Translates a single text string between `sourceLanguage` and `targetLanguage` using the browser's
+ * on-device `Translator` API, falling back to the local on-device dictionary/phrase translator
+ * when the browser API is not enabled.
+ */
+export async function translateText(
+  text: string,
+  options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal?: AbortSignal;
+    onDownloadProgress?: (percent: number) => void;
+    originalEnglishText?: string;
+  }
+): Promise<string> {
+  if (options.signal?.aborted) {
+    throw new DOMException('Translation aborted', 'AbortError');
+  }
+
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+  const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+
+  let src = options.sourceLanguage.toLowerCase().split('-')[0];
+  const tgt = options.targetLanguage.toLowerCase().split('-')[0];
+
+  if (src === 'auto') {
+    const detected = await detectTextLanguage(trimmed, {
+      signal: options.signal,
+      onDownloadProgress: options.onDownloadProgress,
+    });
+    src = detected.detectedLanguage;
+  }
+
+  if (src === tgt) {
+    return text;
+  }
+
+  loadSessionCache();
+  const cacheKey = `${src}|${tgt}|${trimmed}`;
+  const cached = memoryTranslationCache.get(cacheKey);
+  if (cached) {
+    return `${leadingSpace}${cached}${trailingSpace}`;
+  }
+
+  // Try native browser `Translator` API first
+  const hasNativeTranslator =
+    typeof window !== 'undefined' &&
+    Boolean(
+      ('Translator' in window && window.Translator) ||
+        window.ai?.translator ||
+        window.translation?.createTranslator
+    );
+
+  if (hasNativeTranslator) {
+    try {
+      const translator = await getOrCreateNativeTranslator(src, tgt, {
+        signal: options.signal,
+        onDownloadProgress: options.onDownloadProgress,
+      });
+      if (translator) {
+        const result = await translator.translate(trimmed, { signal: options.signal });
+        if (result && typeof result === 'string') {
+          memoryTranslationCache.set(cacheKey, result.trim());
+          persistSessionCache();
+          return `${leadingSpace}${result.trim()}${trailingSpace}`;
+        }
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError' || options.signal?.aborted) {
+        throw err;
+      }
+      // If native API threw (e.g. model unavailable in headless environment), fall through to on-device local fallback
+    }
+  }
+
+  // Built-in On-Device Local Fallback Engine
+  const fallbackResult = localOnDeviceTranslate(
+    trimmed,
+    src,
+    tgt,
+    options.originalEnglishText?.trim()
+  );
+  memoryTranslationCache.set(cacheKey, fallbackResult);
+  persistSessionCache();
+  return `${leadingSpace}${fallbackResult}${trailingSpace}`;
+}
