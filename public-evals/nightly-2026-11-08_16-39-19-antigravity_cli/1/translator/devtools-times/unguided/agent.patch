+// ============================================================================
+// DOM Traversal & Element Translation / Restoration Utilities
+// ============================================================================
+
+const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'CODE', 'PRE', 'NOSCRIPT', 'SVG', 'SELECT', 'OPTION', 'BUTTON', 'INPUT', 'TEXTAREA']);
+const BILINGUAL_CLONE_CLASS = 'dt-bilingual-translation';
+
+function collectTranslatableBlocks(root: HTMLElement): HTMLElement[] {
+  const blocks: HTMLElement[] = [];
+
+  // 1. Explicit data-translate-target elements inside root (or root itself)
+  if (root.hasAttribute('data-translate-target') && root.getAttribute('data-translate-target') !== 'article-body') {
+    blocks.push(root);
+  }
+
+  const targets = root.querySelectorAll<HTMLElement>('[data-translate-target]');
+  targets.forEach((el) => {
+    if (el.closest('[data-no-translate]')) return;
+    if (el.getAttribute('data-translate-target') === 'article-body') {
+      // Collect prose paragraphs, headings, list items, blockquotes, figcaptions
+      const proseBlocks = el.querySelectorAll<HTMLElement>(
+        'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption'
+      );
+      proseBlocks.forEach((pb) => {
+        if (!pb.classList.contains(BILINGUAL_CLONE_CLASS) && !pb.closest('[data-no-translate]')) {
+          blocks.push(pb);
+        }
+      });
+    } else if (!blocks.includes(el)) {
+      blocks.push(el);
+    }
+  });
+
+  // Fallback if root had no explicit data-translate-target children
+  if (blocks.length === 0) {
+    const fallbackBlocks = root.querySelectorAll<HTMLElement>(
+      'h1, h2, h3, h4, p, li, figcaption, blockquote'
+    );
+    fallbackBlocks.forEach((fb) => {
+      if (!fb.classList.contains(BILINGUAL_CLONE_CLASS) && !fb.closest('[data-no-translate]')) {
+        blocks.push(fb);
+      }
+    });
+  }
+
+  return blocks;
+}
+
+function getDirectTextNodes(element: HTMLElement): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      if (SKIP_TAGS.has(parent.tagName)) return NodeFilter.FILTER_REJECT;
+      if (parent.closest(`.${BILINGUAL_CLONE_CLASS}`) || parent.closest('[data-no-translate]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      // Avoid walking into nested block elements if they are separately collected
+      if (
+        parent !== element &&
+        (parent.tagName === 'P' ||
+          parent.tagName === 'LI' ||
+          parent.tagName === 'UL' ||
+          parent.tagName === 'OL' ||
+          parent.tagName === 'BLOCKQUOTE')
+      ) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      if (!node.nodeValue || !node.nodeValue.trim()) {
+        return NodeFilter.FILTER_SKIP;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  let current = walker.nextNode();
+  while (current) {
+    nodes.push(current as Text);
+    current = walker.nextNode();
+  }
+  return nodes;
+}
+
+function removeBilingualClones(root: HTMLElement): void {
+  root.querySelectorAll(`.${BILINGUAL_CLONE_CLASS}`).forEach((el) => el.remove());
+}
