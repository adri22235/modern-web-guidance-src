+    [/\bwith\b/g, { es: 'con', fr: 'avec', de: 'mit', pt: 'com', it: 'con', nl: 'met' }],
+    [/\bfrom\b/g, { es: 'desde', fr: 'de', de: 'von', pt: 'de', it: 'da', nl: 'van' }],
+    [/\bfor\b/g, { es: 'para', fr: 'pour', de: 'für', pt: 'para', it: 'per', nl: 'voor' }],
+    [/\bthat\b/g, { es: 'que', fr: 'qui', de: 'dass', pt: 'que', it: 'che', nl: 'dat' }],
+    [/\binto\b/g, { es: 'en', fr: 'dans', de: 'in', pt: 'em', it: 'in', nl: 'in' }],
+    [/\bmore than\b/gi, { es: 'más que', fr: 'plus que', de: 'mehr als', pt: 'mais do que', it: 'più di', nl: 'meer dan' }],
+    [/\baround the world\b/gi, { es: 'alrededor del mundo', fr: 'à travers le monde', de: 'auf der ganzen Welt', pt: 'ao redor do mundo', it: 'in tutto il mondo', nl: 'over de hele wereld' }],
+  ];
+
+  for (const [rx, map] of commonConnectorReplacements) {
+    if (map[targetLang]) {
+      output = output.replace(rx, map[targetLang]);
+    }
+  }
+
+  for (const [word, map] of Object.entries(WORD_LEXICON)) {
+    if (map[targetLang] && /^[a-z]+$/i.test(word)) {
