+export interface DOMTranslationProgress {
+  completed: number;
+  total: number;
+  downloadProgress: number | null;
+}
+
+export async function translateContainerDOM(
+  container: HTMLElement,
+  options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    displayMode?: TranslationDisplayMode;
+    signal?: AbortSignal;
+    onProgress?: (progress: DOMTranslationProgress) => void;
+  }
+): Promise<{ translatedCount: number; sourceLanguage: string; targetLanguage: string }> {
+  const displayMode = options.displayMode ?? 'inline';
+  const blocks = collectTranslatableBlocks(container);
+
+  removeBilingualClones(container);
+
+  let resolvedSource = options.sourceLanguage;
+  if (resolvedSource === 'auto') {
+    const sampleBlock = blocks.find((b) => (b.textContent?.trim().length ?? 0) > 15) ?? blocks[0];
+    const sampleText = sampleBlock?.getAttribute('data-original-text') || sampleBlock?.textContent || '';
+    const detected = await detectTextLanguage(sampleText, { signal: options.signal });
+    resolvedSource = detected.detectedLanguage;
+  }
+
+  const targetLang = options.targetLanguage.toLowerCase().split('-')[0];
+  const sourceLang = resolvedSource.toLowerCase().split('-')[0];
+  const targetDir = getLanguageDirection(targetLang);
+
+  let downloadProgress: number | null = null;
+  let completed = 0;
+  const total = blocks.length;
+
+  options.onProgress?.({ completed: 0, total, downloadProgress });
+
+  for (const block of blocks) {
+    if (options.signal?.aborted) {
+      throw new DOMException('Translation aborted', 'AbortError');
+    }
+
+    // Save element's original text attribute once
+    if (!block.hasAttribute('data-original-text')) {
+      block.setAttribute('data-original-text', block.textContent?.trim() ?? '');
+      block.setAttribute('data-original-lang', block.getAttribute('lang') || 'en');
+    }
+
+    const originalFullText = block.getAttribute('data-original-text') ?? '';
+    const textNodes = getDirectTextNodes(block);
+
+    if (displayMode === 'bilingual') {
+      // Restore original text in primary element first so bilingual shows Original + Translation
+      for (const tn of textNodes) {
+        if (originalTextNodeMap.has(tn)) {
+          tn.nodeValue = originalTextNodeMap.get(tn)!;
+        }
+      }
+      const sourceTextForBlock =
+        sourceLang === 'en' && originalFullText ? originalFullText : block.textContent?.trim() ?? '';
+      if (sourceTextForBlock) {
+        const translatedBlockText = await translateText(sourceTextForBlock, {
+          sourceLanguage: sourceLang,
+          targetLanguage: targetLang,
+          signal: options.signal,
+          originalEnglishText: originalFullText,
+          onDownloadProgress(pct) {
+            downloadProgress = pct;
+            options.onProgress?.({ completed, total, downloadProgress });
+          },
+        });
+
+        const clone = document.createElement(block.tagName === 'LI' ? 'div' : 'div');
+        clone.className = `${BILINGUAL_CLONE_CLASS} mt-1.5 pl-3 border-l-2 border-amber-400 text-amber-950/90 bg-amber-50/50 py-1 px-2 rounded-r text-[0.95em] leading-relaxed font-normal`;
+        clone.setAttribute('lang', targetLang);
+        clone.setAttribute('dir', targetDir);
+        clone.setAttribute('data-translated-bilingual', targetLang);
+        clone.textContent = translatedBlockText;
+        block.insertAdjacentElement('afterend', clone);
+      }
+    } else {
+      // Inline replacement mode: translate each text node preserving inline markup (`<strong>`, `<em>`, `<a>`)
+      for (const tn of textNodes) {
+        if (!originalTextNodeMap.has(tn)) {
+          originalTextNodeMap.set(tn, tn.nodeValue ?? '');
+        }
+        const origNodeText = originalTextNodeMap.get(tn) ?? '';
+        const currentText = tn.nodeValue ?? '';
+        // If translating from 'en' (original language), use original node text for best fidelity;
+        // otherwise if translating from the currently displayed language (e.g. after swapping languages), use currentText
+        const inputForNode = sourceLang === 'en' ? origNodeText : currentText;
+
+        const translatedNodeText = await translateText(inputForNode, {
+          sourceLanguage: sourceLang,
+          targetLanguage: targetLang,
+          signal: options.signal,
+          originalEnglishText: origNodeText,
+          onDownloadProgress(pct) {
+            downloadProgress = pct;
+            options.onProgress?.({ completed, total, downloadProgress });
+          },
+        });
+        tn.nodeValue = translatedNodeText;
+      }
+    }
+
+    block.setAttribute('data-translated', 'true');
+    block.setAttribute('data-current-lang', targetLang);
+    block.setAttribute('lang', targetLang);
+    block.setAttribute('dir', targetDir);
+
+    completed += 1;
+    options.onProgress?.({ completed, total, downloadProgress });
+  }
+
+  container.setAttribute('data-translated', 'true');
+  container.setAttribute('data-current-lang', targetLang);
+  container.setAttribute('lang', targetLang);
+  container.setAttribute('dir', targetDir);
+
+  notifyTranslationStateChange({
+    action: 'translate',
+    sourceLanguage: sourceLang,
+    targetLanguage: targetLang,
+  });
+
+  return {
+    translatedCount: completed,
+    sourceLanguage: sourceLang,
+    targetLanguage: targetLang,
+  };
+}
+
+export function resetContainerDOM(container: HTMLElement): void {
+  removeBilingualClones(container);
+
+  const blocks = collectTranslatableBlocks(container);
+  for (const block of blocks) {
+    const textNodes = getDirectTextNodes(block);
+    let restoredViaMap = false;
+    for (const tn of textNodes) {
+      if (originalTextNodeMap.has(tn)) {
+        tn.nodeValue = originalTextNodeMap.get(tn)!;
+        restoredViaMap = true;
+      }
+    }
+    if (!restoredViaMap && block.hasAttribute('data-original-text') && block.children.length === 0) {
+      block.textContent = block.getAttribute('data-original-text');
+    }
+
+    const origLang = block.getAttribute('data-original-lang') || 'en';
+    block.removeAttribute('data-translated');
+    block.setAttribute('data-current-lang', origLang);
+    block.setAttribute('lang', origLang);
+    block.setAttribute('dir', 'ltr');
+  }
+
+  container.removeAttribute('data-translated');
+  container.setAttribute('data-current-lang', 'en');
+  container.setAttribute('lang', 'en');
+  container.setAttribute('dir', 'ltr');
+
+  notifyTranslationStateChange({ action: 'reset' });
+}
+
+export async function translateAllPageContent(options: {
+  sourceLanguage: string;
+  targetLanguage: string;
+  displayMode?: TranslationDisplayMode;
+  signal?: AbortSignal;
+  onProgress?: (progress: DOMTranslationProgress) => void;
+}): Promise<{ translatedContainers: number; sourceLanguage: string; targetLanguage: string }> {
+  if (typeof document === 'undefined') {
+    return {
+      translatedContainers: 0,
+      sourceLanguage: options.sourceLanguage,
+      targetLanguage: options.targetLanguage,
+    };
+  }
+
+  const containers = Array.from(
+    document.querySelectorAll<HTMLElement>(
+      '[data-translatable-article], [data-translatable-teaser], [data-translatable-section]'
+    )
+  );
+
+  // Filter out nested containers if a parent container already wraps them
+  const topContainers = containers.filter(
+    (el) => !containers.some((other) => other !== el && other.contains(el))
+  );
+
+  let completedContainers = 0;
+  const totalContainers = topContainers.length;
+  let lastSource = options.sourceLanguage;
+  let lastTarget = options.targetLanguage;
+
+  for (const container of topContainers) {
+    if (options.signal?.aborted) {
+      throw new DOMException('Translation aborted', 'AbortError');
+    }
+    const res = await translateContainerDOM(container, {
+      sourceLanguage: options.sourceLanguage,
+      targetLanguage: options.targetLanguage,
+      displayMode: options.displayMode,
+      signal: options.signal,
+      onProgress(sub) {
+        options.onProgress?.({
+          completed: completedContainers,
+          total: totalContainers,
+          downloadProgress: sub.downloadProgress,
+        });
+      },
+    });
+    lastSource = res.sourceLanguage;
+    lastTarget = res.targetLanguage;
+    completedContainers += 1;
+    options.onProgress?.({
+      completed: completedContainers,
+      total: totalContainers,
+      downloadProgress: null,
+    });
+  }
+
+  return {
+    translatedContainers: completedContainers,
+    sourceLanguage: lastSource,
+    targetLanguage: lastTarget,
+  };
+}
+
+export function resetAllPageContent(): void {
+  if (typeof document === 'undefined') return;
+  const containers = Array.from(
+    document.querySelectorAll<HTMLElement>(
+      '[data-translatable-article], [data-translatable-teaser], [data-translatable-section]'
+    )
+  );
+  containers.forEach((c) => resetContainerDOM(c));
+}
+
+export function isAnyPageContentTranslated(): boolean {
+  if (typeof document === 'undefined') return false;
+  return Boolean(document.querySelector('[data-translated="true"]'));
+}
