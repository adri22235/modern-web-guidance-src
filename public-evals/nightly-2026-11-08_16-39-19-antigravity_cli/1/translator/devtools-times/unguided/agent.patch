+/**
+ * Checks whether the browser supports the Web On-Device Translation API (`window.Translator` or legacy `window.ai.translator`/`window.translation`)
+ * and queries availability for the given language pair.
+ */
+export async function checkTranslatorAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AvailabilityCheckResult> {
+  const src = (sourceLanguage === 'auto' ? 'en' : sourceLanguage).toLowerCase().split('-')[0];
+  const tgt = targetLanguage.toLowerCase().split('-')[0];
+
+  if (src === tgt) {
+    return {
+      status: 'available',
+      rawStatus: 'available',
+      engine: typeof window !== 'undefined' && 'Translator' in window && window.Translator
+        ? 'web-translator-api'
+        : 'local-on-device-fallback',
+      nativeSupported: typeof window !== 'undefined' && Boolean(window.Translator || window.ai?.translator || window.translation),
+    };
+  }
+
+  if (typeof window === 'undefined') {
+    return {
+      status: 'fallback',
+      rawStatus: 'ssr',
+      engine: 'local-on-device-fallback',
+      nativeSupported: false,
+    };
+  }
+
+  // 1. Standard W3C / Chrome Built-in AI `window.Translator` API
+  if ('Translator' in window && window.Translator && typeof window.Translator.availability === 'function') {
+    try {
+      const raw = await window.Translator.availability({
+        sourceLanguage: src,
+        targetLanguage: tgt,
+      });
+      return {
+        status: normalizeAvailabilityStatus(raw),
+        rawStatus: String(raw),
+        engine: 'web-translator-api',
+        nativeSupported: true,
+      };
+    } catch {
+      return {
+        status: 'fallback',
+        rawStatus: 'error',
+        engine: 'local-on-device-fallback',
+        nativeSupported: false,
+      };
+    }
+  }
+
+  // 2. Legacy `window.ai.translator` API
+  if (window.ai?.translator) {
+    try {
+      if (typeof window.ai.translator.availability === 'function') {
+        const raw = await window.ai.translator.availability({
+          sourceLanguage: src,
+          targetLanguage: tgt,
+        });
+        return {
+          status: normalizeAvailabilityStatus(raw),
+          rawStatus: String(raw),
+          engine: 'legacy-ai-translator',
+          nativeSupported: true,
+        };
+      }
+      if (typeof window.ai.translator.capabilities === 'function') {
+        const caps = await window.ai.translator.capabilities();
+        const raw = caps.languagePairAvailable
+          ? caps.languagePairAvailable(src, tgt)
+          : caps.available;
+        return {
+          status: normalizeAvailabilityStatus(raw),
+          rawStatus: String(raw),
+          engine: 'legacy-ai-translator',
+          nativeSupported: true,
+        };
+      }
+    } catch {
+      // Fall through to fallback
+    }
+  }
+
+  // 3. Legacy `window.translation` API
+  if (window.translation?.canTranslate) {
+    try {
+      const raw = await window.translation.canTranslate({
+        sourceLanguage: src,
+        targetLanguage: tgt,
+      });
+      return {
+        status: normalizeAvailabilityStatus(raw),
+        rawStatus: String(raw),
+        engine: 'legacy-ai-translator',
+        nativeSupported: true,
+      };
+    } catch {
+      // Fall through to fallback
+    }
+  }
+
+  return {
+    status: 'fallback',
+    rawStatus: 'fallback-ready',
+    engine: 'local-on-device-fallback',
+    nativeSupported: false,
+  };
+}
