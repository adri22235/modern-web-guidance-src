diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..35093ec
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,586 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkTranslatorAvailability,
+  checkLanguageDetectorAvailability,
+  createTranslatorWithMonitor,
+  detectLanguageFromText,
+  translateTextOrStream,
+} from '../utils/translator';
+
+interface ArticleTranslationControlProps {
+  articleSelector?: string;
+  compact?: boolean;
+  defaultSourceLanguage?: string;
+  defaultTargetLanguage?: string;
+  label?: string;
+}
+
+interface OriginalDomEntry {
+  element: HTMLElement;
+  originalText: string;
+  originalLang: string | null;
+}
+
+const TRANSLATABLE_SELECTORS = [
+  '[data-translatable]',
+  '.prose p',
+  '.prose h1',
+  '.prose h2',
+  '.prose h3',
+  '.prose h4',
+  '.prose li',
+  '.prose blockquote',
+  'figcaption',
+].join(', ');
+
+export default function ArticleTranslationControl({
+  articleSelector,
+  compact = false,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+  label,
+}: ArticleTranslationControlProps) {
+  const instanceId = useId();
+  const rootRef = useRef<HTMLDivElement>(null);
+  const originalsRef = useRef<OriginalDomEntry[]>([]);
+
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(false);
+  const [sourceLang, setSourceLang] = useState<string>(defaultSourceLanguage);
+  const [targetLang, setTargetLang] = useState<string>(defaultTargetLanguage);
+  const [availability, setAvailability] = useState<AIAvailability>('available');
+  const [detectorAvailability, setDetectorAvailability] = useState<AIAvailability>('unavailable');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isDetecting, setIsDetecting] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translatedCount, setTranslatedCount] = useState<{ current: number; total: number } | null>(null);
+  const [activeTranslationLang, setActiveTranslationLang] = useState<string | null>(null);
+  const [detectedInfo, setDetectedInfo] = useState<{ code: string; confidence: number } | null>(null);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [errorMessage, setErrorMessage] = useState<string>('');
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+
+  // Check initial browser support and model availability
+  useEffect(() => {
+    const supported = isTranslatorSupported();
+    setApiSupported(supported);
+
+    const detSupported = isLanguageDetectorSupported();
+    setDetectorSupported(detSupported);
+
+    if (detSupported) {
+      checkLanguageDetectorAvailability().then(setDetectorAvailability);
+    }
+  }, []);
+
+  // Re-check language pair availability whenever source or target changes
+  useEffect(() => {
+    if (!apiSupported) {
+      setAvailability('unavailable');
+      return;
+    }
+    let cancelled = false;
+    checkTranslatorAvailability(sourceLang, targetLang).then((status) => {
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [apiSupported, sourceLang, targetLang]);
+
+  const getTargetScopeElement = (): HTMLElement | null => {
+    if (typeof document === 'undefined') return null;
+    if (articleSelector) {
+      const explicit = document.querySelector<HTMLElement>(articleSelector);
+      if (explicit) return explicit;
+    }
+    if (rootRef.current) {
+      const closestScope = rootRef.current.closest<HTMLElement>(
+        '[data-translatable-scope], article'
+      );
+      if (closestScope) return closestScope;
+    }
+    return document.querySelector<HTMLElement>('main') || document.body;
+  };
+
+  const collectTranslatableElements = (scope: HTMLElement): HTMLElement[] => {
+    const rawMatches = Array.from(scope.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTORS));
+    // Exclude anything inside our translation control itself or script/style tags
+    return rawMatches.filter((el) => {
+      if (rootRef.current && rootRef.current.contains(el)) return false;
+      if (el.closest('[data-translation-control]')) return false;
+      // Avoid translating parent containers if they also contain nested translatable children
+      const hasNestedTranslatable = rawMatches.some(
+        (other) => other !== el && el.contains(other)
+      );
+      if (hasNestedTranslatable) return false;
+      return Boolean(el.textContent && el.textContent.trim().length > 0);
+    });
+  };
+
+  const ensureOriginalsRecorded = (scope: HTMLElement): OriginalDomEntry[] => {
+    const currentElements = collectTranslatableElements(scope);
+    const existingMap = new Map(
+      originalsRef.current.map((entry) => [entry.element, entry])
+    );
+
+    const updatedEntries: OriginalDomEntry[] = currentElements.map((el) => {
+      const existing = existingMap.get(el);
+      if (existing) return existing;
+      return {
+        element: el,
+        originalText: el.textContent || '',
+        originalLang: el.getAttribute('lang'),
+      };
+    });
+
+    originalsRef.current = updatedEntries;
+    return updatedEntries;
+  };
+
+  // Triggered strictly by a user gesture (click) to satisfy LanguageDetector.create() requirements
+  const handleDetectLanguage = async () => {
+    setErrorMessage('');
+    setStatusMessage('');
+    const scope = getTargetScopeElement();
+    if (!scope) return;
+
+    const entries = ensureOriginalsRecorded(scope);
+    const sampleText = entries
+      .map((e) => e.originalText.trim())
+      .filter(Boolean)
+      .join(' ')
+      .slice(0, 600);
+
+    if (sampleText.length < 20) {
+      setErrorMessage('Not enough article text to accurately detect language.');
+      return;
+    }
+
+    setIsDetecting(true);
+    setDownloadProgress(null);
+
+    try {
+      const result = await detectLanguageFromText(sampleText, (progress) => {
+        setDownloadProgress(progress);
+      });
+      setDownloadProgress(null);
+
+      if (result) {
+        setSourceLang(result.detectedLanguage);
+        setDetectedInfo({
+          code: result.detectedLanguage,
+          confidence: Math.round(result.confidence * 100),
+        });
+        const langName =
+          SUPPORTED_LANGUAGES.find((l) => l.code === result.detectedLanguage)?.name ||
+          result.detectedLanguage;
+        setStatusMessage(`Detected ${langName} (${Math.round(result.confidence * 100)}% confidence).`);
+      } else {
+        setErrorMessage('Could not confidently detect source language on this device.');
+      }
+    } catch (err: any) {
+      setErrorMessage(
+        err?.message || 'On-device language detection is currently unavailable.'
+      );
+    } finally {
+      setIsDetecting(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  // Triggered strictly by a user gesture (click) to satisfy Translator.create() requirements
+  const handleTranslate = async () => {
+    setErrorMessage('');
+    setStatusMessage('');
+
+    if (!apiSupported) {
+      setErrorMessage('Client-side translation is currently unsupported in this browser.');
+      return;
+    }
+
+    if (sourceLang === targetLang) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    const scope = getTargetScopeElement();
+    if (!scope) {
+      setErrorMessage('Unable to locate article content to translate.');
+      return;
+    }
+
+    const entries = ensureOriginalsRecorded(scope);
+    if (entries.length === 0) {
+      setErrorMessage('No translatable text found in this article.');
+      return;
+    }
+
+    setIsTranslating(true);
+    setDownloadProgress(null);
+    setTranslatedCount({ current: 0, total: entries.length });
+
+    try {
+      let effectiveSourceLang = sourceLang;
+
+      // If LanguageDetector is available and user requested auto-detection or source hasn't been verified
+      if (effectiveSourceLang === 'auto') {
+        const sampleText = entries
+          .map((e) => e.originalText.trim())
+          .filter(Boolean)
+          .join(' ')
+          .slice(0, 600);
+        const detected = await detectLanguageFromText(sampleText, (pct) => {
+          setDownloadProgress(pct);
+        });
+        if (detected) {
+          effectiveSourceLang = detected.detectedLanguage;
+          setSourceLang(effectiveSourceLang);
+          setDetectedInfo({
+            code: detected.detectedLanguage,
+            confidence: Math.round(detected.confidence * 100),
+          });
+        } else {
+          effectiveSourceLang = 'en';
+          setSourceLang('en');
+        }
+      }
+
+      if (effectiveSourceLang === targetLang) {
+        handleRestoreOriginal();
+        setIsTranslating(false);
+        setTranslatedCount(null);
+        return;
+      }
+
+      const translator = await createTranslatorWithMonitor(
+        effectiveSourceLang,
+        targetLang,
+        (pct) => {
+          setDownloadProgress(pct);
+        }
+      );
+
+      setDownloadProgress(null);
+
+      // Update language attribute on the scope for screen reader accessibility (WCAG 3.1.2)
+      if (!scope.hasAttribute('data-original-lang')) {
+        scope.setAttribute('data-original-lang', scope.getAttribute('lang') || '');
+      }
+      scope.setAttribute('lang', targetLang);
+
+      for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        setTranslatedCount({ current: i + 1, total: entries.length });
+
+        const translated = await translateTextOrStream(
+          translator,
+          entry.originalText,
+          (partialChunk) => {
+            entry.element.textContent = partialChunk;
+            entry.element.setAttribute('lang', targetLang);
+          }
+        );
+
+        entry.element.textContent = translated;
+        entry.element.setAttribute('lang', targetLang);
+      }
+
+      if (typeof translator.destroy === 'function') {
+        translator.destroy();
+      }
+
+      setActiveTranslationLang(targetLang);
+      setAvailability('available');
+      const targetName =
+        SUPPORTED_LANGUAGES.find((l) => l.code === targetLang)?.name || targetLang;
+      setStatusMessage(`Translated on-device to ${targetName}.`);
+    } catch (err: any) {
+      setErrorMessage(
+        err?.message ||
+          'On-device translation failed. Ensure your browser supports the Built-in AI Translator API.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+      setTranslatedCount(null);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    setErrorMessage('');
+    const scope = getTargetScopeElement();
+    if (scope && scope.hasAttribute('data-original-lang')) {
+      const origLang = scope.getAttribute('data-original-lang');
+      if (origLang) {
+        scope.setAttribute('lang', origLang);
+      } else {
+        scope.removeAttribute('lang');
+      }
+    }
+
+    originalsRef.current.forEach((entry) => {
+      entry.element.textContent = entry.originalText;
+      if (entry.originalLang !== null) {
+        entry.element.setAttribute('lang', entry.originalLang);
+      } else {
+        entry.element.removeAttribute('lang');
+      }
+    });
+
+    setActiveTranslationLang(null);
+    setStatusMessage('Restored original language.');
+  };
+
+  const handleSwapLanguages = () => {
+    if (sourceLang === 'auto') return;
+    const prevSource = sourceLang;
+    setSourceLang(targetLang);
+    setTargetLang(prevSource);
+  };
+
+  const sourceSelectId = `trans-source-${instanceId}`;
+  const targetSelectId = `trans-target-${instanceId}`;
+  const progressId = `trans-progress-${instanceId}`;
+
+  const isTranslateDisabled =
+    !apiSupported ||
+    availability === 'unavailable' ||
+    isTranslating ||
+    isDetecting ||
+    sourceLang === targetLang;
+
+  if (compact && !isExpanded) {
+    return (
+      <div
+        ref={rootRef}
+        data-translation-control="true"
+        className="inline-flex items-center"
+      >
+        <button
+          type="button"
+          onClick={() => setIsExpanded(true)}
+          aria-expanded={false}
+          className="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-amber-700 bg-gray-50 hover:bg-amber-50 border border-gray-200 rounded px-2.5 py-1 transition-colors min-h-[28px]"
+        >
+          <svg
+            aria-hidden="true"
+            className="w-3.5 h-3.5 text-amber-700"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.75}
+            stroke="currentColor"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <span>{activeTranslationLang ? `Translated (${activeTranslationLang.toUpperCase()})` : label || 'Translate'}</span>
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div
+      ref={rootRef}
+      data-translation-control="true"
+      className={
+        compact
+          ? 'mt-2 p-3 bg-gray-50 border border-gray-200 rounded-md text-xs text-gray-700 shadow-xs'
+          : 'my-4 p-4 bg-amber-50/40 border border-gray-200 rounded-lg text-sm text-gray-800 shadow-xs'
+      }
+    >
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-2.5">
+        <div className="flex items-center gap-2">
+          <svg
+            aria-hidden="true"
+            className="w-4 h-4 text-amber-700 shrink-0"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.75}
+            stroke="currentColor"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <span className="font-semibold text-gray-900">
+            {label || (compact ? 'Translate Teaser' : 'On-Device Article Translation')}
+          </span>
+          <span className="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-900">
+            Built-in AI
+          </span>
+          {apiSupported && availability !== 'unavailable' && (
+            <span className="text-[11px] text-gray-500">
+              {availability === 'available'
+                ? 'Model ready'
+                : availability === 'downloadable'
+                ? 'Model downloadable'
+                : 'Downloading model…'}
+            </span>
+          )}
+        </div>
+
+        {compact && (
+          <button
+            type="button"
+            onClick={() => setIsExpanded(false)}
+            aria-label="Collapse translation control"
+            className="text-gray-400 hover:text-gray-700 p-1 rounded"
+          >
+            ✕
+          </button>
+        )}
+      </div>
+
+      <div className="flex flex-wrap items-end gap-2.5">
+        <div className="flex flex-col gap-1">
+          <label htmlFor={sourceSelectId} className="text-xs font-medium text-gray-600">
+            From language
+          </label>
+          <div className="flex items-center gap-1.5">
+            <select
+              id={sourceSelectId}
+              value={sourceLang}
+              onChange={(e) => setSourceLang(e.target.value)}
+              disabled={!apiSupported || isTranslating || isDetecting}
+              className="bg-white border border-gray-300 rounded px-2.5 py-1.5 text-xs md:text-sm text-gray-900 focus:outline-2 focus:outline-amber-600 disabled:opacity-60"
+            >
+              {detectorSupported && detectorAvailability !== 'unavailable' && (
+                <option value="auto">Auto-detect language</option>
+              )}
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.name} ({lang.code})
+                </option>
+              ))}
+            </select>
+
+            {detectorSupported && detectorAvailability !== 'unavailable' && (
+              <button
+                type="button"
+                onClick={handleDetectLanguage}
+                disabled={isTranslating || isDetecting}
+                className="px-2 py-1.5 text-xs font-medium bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 rounded transition-colors disabled:opacity-50 min-h-[30px]"
+              >
+                {isDetecting ? 'Detecting…' : 'Detect'}
+              </button>
+            )}
+          </div>
+        </div>
+
+        <button
+          type="button"
+          onClick={handleSwapLanguages}
+          disabled={!apiSupported || isTranslating || sourceLang === 'auto'}
+          aria-label="Swap source and target languages"
+          className="px-2 py-1.5 text-xs font-medium bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 rounded transition-colors disabled:opacity-50 min-h-[30px]"
+        >
+          ⇄
+        </button>
+
+        <div className="flex flex-col gap-1">
+          <label htmlFor={targetSelectId} className="text-xs font-medium text-gray-600">
+            To language
+          </label>
+          <select
+            id={targetSelectId}
+            value={targetLang}
+            onChange={(e) => setTargetLang(e.target.value)}
+            disabled={!apiSupported || isTranslating || isDetecting}
+            className="bg-white border border-gray-300 rounded px-2.5 py-1.5 text-xs md:text-sm text-gray-900 focus:outline-2 focus:outline-amber-600 disabled:opacity-60"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.name} ({lang.code})
+              </option>
+            ))}
+          </select>
+        </div>
+
+        <div className="flex items-center gap-2">
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={isTranslateDisabled}
+            className="px-3.5 py-1.5 text-xs md:text-sm font-semibold bg-amber-700 hover:bg-amber-800 text-white rounded transition-colors disabled:bg-gray-300 disabled:text-gray-600 disabled:cursor-not-allowed min-h-[32px]"
+          >
+            {isTranslating
+              ? 'Translating…'
+              : availability === 'downloadable'
+              ? 'Download & Translate'
+              : 'Translate'}
+          </button>
+
+          {activeTranslationLang && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              disabled={isTranslating}
+              className="px-3 py-1.5 text-xs md:text-sm font-medium bg-white hover:bg-gray-100 text-gray-800 border border-gray-300 rounded transition-colors min-h-[32px]"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Model download or translation progress bar */}
+      {(downloadProgress !== null || translatedCount !== null) && (
+        <div className="mt-2.5 flex items-center gap-2">
+          <label htmlFor={progressId} className="text-xs text-gray-600">
+            {downloadProgress !== null
+              ? `Downloading language pack (${downloadProgress}%)…`
+              : translatedCount
+              ? `Translating section ${translatedCount.current} of ${translatedCount.total}…`
+              : 'Working…'}
+          </label>
+          <progress
+            id={progressId}
+            value={
+              downloadProgress !== null
+                ? downloadProgress
+                : translatedCount
+                ? Math.round((translatedCount.current / translatedCount.total) * 100)
+                : 0
+            }
+            max={100}
+            className="h-2 w-36 rounded overflow-hidden"
+          />
+        </div>
+      )}
+
+      {/* Graceful degradation message when Translator API is unavailable */}
+      {(!apiSupported || availability === 'unavailable') && (
+        <p className="mt-2 text-xs text-amber-900 bg-amber-100/70 border border-amber-200 rounded px-2.5 py-1.5" role="status">
+          {!apiSupported
+            ? 'Client-side translation is currently unsupported in this browser. Open in Chrome 138+ or Edge 148+ on desktop to translate on-device.'
+            : `The selected language pair (${sourceLang} → ${targetLang}) is unavailable for on-device translation on this device.`}
+        </p>
+      )}
+
+      {/* Polite live region for completion status and errors */}
+      <div aria-live="polite" className="mt-1.5">
+        {errorMessage && (
+          <p className="text-xs text-red-700 font-medium">{errorMessage}</p>
+        )}
+        {!errorMessage && statusMessage && (
+          <p className="text-xs text-emerald-800 font-medium">
+            {statusMessage}
+            {detectedInfo && ` [Source: ${detectedInfo.code}]`}
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
