diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..82e5cec
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,184 @@
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese (Simplified)' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && Boolean(self.Translator);
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return typeof self !== 'undefined' && 'LanguageDetector' in self && Boolean(self.LanguageDetector);
+}
+
+export async function checkTranslatorAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AIAvailability> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unavailable';
+  }
+  if (sourceLanguage === targetLanguage) {
+    return 'available';
+  }
+  const options = { sourceLanguage, targetLanguage };
+  try {
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export async function checkLanguageDetectorAvailability(): Promise<AIAvailability> {
+  if (!isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return 'unavailable';
+  }
+  try {
+    return await self.LanguageDetector.availability();
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export async function createTranslatorWithMonitor(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress?: (percent: number) => void
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    throw new Error('Client-side Translator API is unsupported in this browser.');
+  }
+  const options = { sourceLanguage, targetLanguage };
+  const availability = await self.Translator.availability(options);
+  if (availability === 'unavailable') {
+    throw new Error(`Translation model for ${sourceLanguage} to ${targetLanguage} is unavailable on this device.`);
+  }
+  return await self.Translator.create({
+    ...options,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        const progress = Math.round((e.loaded || 0) * 100);
+        if (onProgress) {
+          onProgress(progress);
+        }
+      });
+    },
+  });
+}
+
+export async function detectLanguageFromText(
+  sampleText: string,
+  onProgress?: (percent: number) => void
+): Promise<{ detectedLanguage: string; confidence: number } | null> {
+  if (!isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return null;
+  }
+  const cleaned = sampleText.trim();
+  // Avoid using the detector on very short phrases or single words, as accuracy drops significantly.
+  if (cleaned.length < 20) {
+    return null;
+  }
+  const availability = await self.LanguageDetector.availability();
+  if (availability === 'unavailable') {
+    return null;
+  }
+  const detector = await self.LanguageDetector.create({
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        const progress = Math.round((e.loaded || 0) * 100);
+        if (onProgress) {
+          onProgress(progress);
+        }
+      });
+    },
+  });
+  const results = await detector.detect(cleaned);
+  if (results && results.length > 0) {
+    const top = results[0];
+    const supportedCodes = new Set(SUPPORTED_LANGUAGES.map((l) => l.code));
+    if (supportedCodes.has(top.detectedLanguage)) {
+      return top;
+    }
+    const baseCode = top.detectedLanguage.split('-')[0];
+    if (supportedCodes.has(baseCode)) {
+      return { detectedLanguage: baseCode, confidence: top.confidence };
+    }
+  }
+  return null;
+}
+
+export async function translateTextOrStream(
+  translator: TranslatorInstance,
+  text: string,
+  onChunk?: (partial: string) => void
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  // Use translateStreaming for long text when onChunk callback is provided
+  if (trimmed.length > 220 && typeof translator.translateStreaming === 'function' && onChunk) {
+    try {
+      const stream = translator.translateStreaming(trimmed);
+      let accumulated = '';
+      // Wait for chunks using async iteration
+      for await (const chunk of stream as unknown as AsyncIterable<string>) {
+        // Handle both delta chunks and cumulative chunks depending on browser implementation
+        if (chunk.startsWith(accumulated) && accumulated.length > 0) {
+          accumulated = chunk;
+        } else {
+          accumulated += chunk;
+        }
+        onChunk(accumulated);
+      }
+      if (accumulated) {
+        return accumulated;
+      }
+    } catch {
+      // Fallback to standard translate if streaming fails
+    }
+  }
+
