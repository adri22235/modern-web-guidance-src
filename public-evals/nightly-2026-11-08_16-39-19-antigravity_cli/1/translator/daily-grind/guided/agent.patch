+  <script>
+    (() => {
+      const langSelect = document.getElementById('language-select');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const banner = document.getElementById('translation-banner');
+      const statusText = document.getElementById('translation-status-text');
+      const progressWrapper = document.getElementById('translation-progress-wrapper');
+      const progressEl = document.getElementById('translation-progress');
+      const progressPct = document.getElementById('translation-progress-pct');
+
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+      for (const el of translatableElements) {
+        el.dataset.originalText = el.textContent.trim();
+      }
+
+      let currentLanguage = 'en';
+      const translatorCache = new Map();
+
+      function showStatus(message, { isUnsupported = false, showProgress = false, progress = 0 } = {}) {
+        banner.hidden = false;
+        banner.classList.toggle('is-unsupported', isUnsupported);
+        statusText.textContent = message;
+        progressWrapper.hidden = !showProgress;
+        if (showProgress) {
+          progressEl.value = progress;
+          progressPct.textContent = `${progress}%`;
+        }
+      }
+
+      function applyLanguageTag(langCode) {
+        for (const el of translatableElements) {
+          el.setAttribute('lang', langCode);
+        }
+      }
+
+      function restoreOriginalEnglish() {
+        for (const el of translatableElements) {
+          el.textContent = el.dataset.originalText;
+        }
+        applyLanguageTag('en');
+        currentLanguage = 'en';
+      }
+
+      // Check global Translator API support
+      if (!('Translator' in self)) {
+        langSelect.disabled = true;
+        translateBtn.disabled = true;
+        showStatus('Client-side translation is currently unsupported in this browser.', {
+          isUnsupported: true,
+        });
+        return;
+      }
+
+      async function checkPairAvailability(sourceLanguage, targetLanguage) {
+        if (sourceLanguage === targetLanguage) {
+          return 'available';
+        }
+        const options = { sourceLanguage, targetLanguage };
+        try {
+          return await self.Translator.availability(options);
+        } catch (err) {
+          console.warn('Error checking Translator availability:', err);
+          return 'unavailable';
+        }
+      }
+
+      async function runTranslation(targetLanguage, { hasUserGesture = false } = {}) {
+        if (targetLanguage === 'en') {
+          restoreOriginalEnglish();
+          showStatus('Showing original English coffee menu descriptions and story text.');
+          return;
+        }
+
+        // Translate from original English ('en') or current active language
+        const sourceLanguage = 'en';
+        const options = {
+          sourceLanguage,
+          targetLanguage,
+        };
+
+        const availability = await checkPairAvailability(sourceLanguage, targetLanguage);
+
+        if (availability === 'unavailable') {
+          translateBtn.disabled = true;
+          showStatus(
+            `Translation model for "${targetLanguage}" is unavailable on this device.`,
+            { isUnsupported: true }
+          );
+          return;
+        }
+
+        if ((availability === 'downloadable' || availability === 'downloading') && !hasUserGesture) {
+          translateBtn.disabled = false;
+          showStatus(
+            `Language pack (${targetLanguage.toUpperCase()}) requires download. Click "Translate" to download and translate on-device.`
+          );
+          return;
+        }
+
+        try {
+          langSelect.disabled = true;
+          translateBtn.disabled = true;
+
+          const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+          let translator = translatorCache.get(cacheKey);
+
+          if (!translator) {
+            showStatus(`Preparing on-device translator for ${targetLanguage.toUpperCase()}...`, {
+              showProgress: availability === 'downloadable' || availability === 'downloading',
+              progress: 0,
+            });
+
+            translator = await self.Translator.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = Math.round((e.loaded || 0) * 100);
+                  showStatus(`Downloading on-device language model (${pct}%)...`, {
+                    showProgress: true,
+                    progress: pct,
+                  });
+                });
+              },
+            });
+
+            translatorCache.set(cacheKey, translator);
+          }
+
+          showStatus('Translating coffee menu descriptions and story text on-device...');
+
+          for (const el of translatableElements) {
+            const sourceText = el.dataset.originalText;
+            const translated = await translator.translate(sourceText);
+            el.textContent = translated;
+          }
+
+          applyLanguageTag(targetLanguage);
+          currentLanguage = targetLanguage;
+          showStatus(`Translated menu descriptions and story text to ${langSelect.options[langSelect.selectedIndex].text}.`);
+        } catch (err) {
+          console.warn('On-device translation failed:', err);
+          showStatus(
+            'Unable to complete on-device translation. Please click "Translate" to try again.',
+            { isUnsupported: true }
+          );
+        } finally {
+          langSelect.disabled = false;
+          translateBtn.disabled = false;
+        }
+      }
+
+      // When user changes the select dropdown, check availability first.
+      // If the model is already 'available' on-device, we can translate immediately
+      // or let them click the Translate button (which always provides a user gesture).
+      langSelect.addEventListener('change', async () => {
+        const targetLanguage = langSelect.value;
+        translateBtn.disabled = false;
+
+        if (targetLanguage === 'en') {
+          restoreOriginalEnglish();
+          showStatus('Showing original English coffee menu descriptions and story text.');
+          return;
+        }
+
+        const availability = await checkPairAvailability('en', targetLanguage);
+        if (availability === 'available') {
+          await runTranslation(targetLanguage, { hasUserGesture: true });
+        } else if (availability === 'downloadable' || availability === 'downloading') {
+          showStatus(
+            `On-device model for ${langSelect.options[langSelect.selectedIndex].text} is ready to download. Click "Translate" to start.`
+          );
+        } else {
+          translateBtn.disabled = true;
+          showStatus(
+            `Translation model for ${langSelect.options[langSelect.selectedIndex].text} is unavailable on this device.`,
+            { isUnsupported: true }
+          );
+        }
+      });
+
+      // Clicking the button strictly satisfies the user gesture requirement for downloadable/downloading models
+      translateBtn.addEventListener('click', async () => {
+        const targetLanguage = langSelect.value;
+        await runTranslation(targetLanguage, { hasUserGesture: true });
+      });
+    })();
+  </script>
+
 </body>
 
