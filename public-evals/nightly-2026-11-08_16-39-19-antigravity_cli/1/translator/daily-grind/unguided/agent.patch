+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                let ratio = 0;
+                if (typeof e.loaded === 'number') {
+                  ratio = (typeof e.total === 'number' && e.total > 1)
+                    ? e.loaded / e.total
+                    : e.loaded;
+                }
+                onProgress(ratio * 100);
+              });
+            }
+          });
+
+          translatorCache.set(cacheKey, translator);
+          return translator;
+        }
+
+        // Legacy Chrome Origin Trial API fallback (self.ai.translator)
+        if ('ai' in self && self.ai && self.ai.translator) {
+          const translator = await self.ai.translator.create({
+            sourceLanguage,
+            targetLanguage,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const ratio = (typeof e.total === 'number' && e.total > 0) ? e.loaded / e.total : (e.loaded || 0);
+                onProgress(ratio * 100);
+              });
+            }
+          });
+          translatorCache.set(cacheKey, translator);
+          return translator;
+        }
+
+        // Legacy self.translation.createTranslator fallback
+        if ('translation' in self && self.translation && typeof self.translation.createTranslator === 'function') {
+          const translator = await self.translation.createTranslator({
+            sourceLanguage,
+            targetLanguage
+          });
+          translatorCache.set(cacheKey, translator);
+          return translator;
+        }
+
+        const unsupportedError = new Error('Built-in Translator API is not supported in this browser.');
+        unsupportedError.code = 'UNSUPPORTED';
+        throw unsupportedError;
+      }
+
+      function applyFallbackTranslations(targetLanguage) {
+        const dict = fallbackDictionary[targetLanguage];
+        if (!dict) {
+          return false;
+        }
+        translatableElements.forEach((el) => {
+          const original = el.dataset.originalText;
+          if (original && dict[original]) {
+            el.textContent = dict[original];
+          }
+        });
+        return true;
+      }
+
+      async function translatePage(targetLanguage) {
+        const requestId = ++activeRequestId;
+        const targetName = languageNames[targetLanguage] || targetLanguage.toUpperCase();
+
+        // Restore original English text immediately when English is selected
+        if (targetLanguage === BASE_LANGUAGE) {
+          hideProgress();
+          setElementsTranslating(false);
+          translatableElements.forEach((el) => {
+            if (el.dataset.originalText) {
+              el.textContent = el.dataset.originalText;
+            }
+          });
+          currentLanguage = BASE_LANGUAGE;
+          document.documentElement.lang = BASE_LANGUAGE;
+          setStatus(
+            'Showing original English text.',
+            hasWebTranslatorAPI() ? 'On-Device AI Ready' : 'On-Device Translator',
+            hasWebTranslatorAPI() ? 'ready' : ''
+          );
+          return;
+        }
+
+        setElementsTranslating(true);
+        setStatus(
+          `Checking on-device model availability for ${targetName}...`,
+          'Translating...',
+          'downloading'
+        );
+
+        try {
+          const translator = await getOrCreateNativeTranslator(
+            BASE_LANGUAGE,
+            targetLanguage,
+            (percent) => {
+              if (requestId !== activeRequestId) return;
+              showProgress(percent);
+              setStatus(
+                `Downloading on-device ${targetName} language pack (${Math.round(percent)}%)...`,
+                'Downloading Model',
+                'downloading'
+              );
+            }
+          );
+
+          if (requestId !== activeRequestId) return;
+          hideProgress();
+          setStatus(
+            `Translating menu descriptions and story into ${targetName} on-device...`,
+            'Translating...',
+            'downloading'
+          );
+
+          for (const el of translatableElements) {
+            if (requestId !== activeRequestId) return;
+            const sourceText = el.dataset.originalText;
+            if (sourceText) {
+              const translatedText = await translator.translate(sourceText);
+              if (requestId !== activeRequestId) return;
+              if (translatedText) {
+                el.textContent = translatedText;
+              }
+            }
+          }
+
+          if (requestId !== activeRequestId) return;
+          currentLanguage = targetLanguage;
+          document.documentElement.lang = targetLanguage;
+          setElementsTranslating(false);
+          setStatus(
+            `Translated menu descriptions and story text into ${targetName} using browser on-device AI (${BASE_LANGUAGE.toUpperCase()} → ${targetLanguage.toUpperCase()}).`,
+            'On-Device AI Active',
+            'ready'
+          );
+        } catch (err) {
+          if (requestId !== activeRequestId) return;
+          hideProgress();
+          setElementsTranslating(false);
+
+          const appliedFallback = applyFallbackTranslations(targetLanguage);
+          if (appliedFallback) {
+            currentLanguage = targetLanguage;
+            document.documentElement.lang = targetLanguage;
+            setStatus(
+              `Translated into ${targetName} using built-in on-device language pack (${err && err.code === 'UNAVAILABLE' ? 'Browser AI model unavailable for this pair' : 'Browser Translator API unavailable'}).`,
+              'On-Device Fallback',
+              'fallback'
+            );
+          } else {
+            selector.value = currentLanguage;
+            setStatus(
+              err && err.message ? err.message : `Unable to translate to ${targetName} on this device.`,
+              'Translation Unavailable',
+              'fallback'
+            );
+          }
+        }
+      }
+
+      // Initialize status indicator based on browser capabilities
+      if (hasWebTranslatorAPI()) {
+        setStatus(
+          'Browser on-device Translator API detected. Choose a language to translate the coffee menu and story locally.',
+          'On-Device AI Ready',
+          'ready'
+        );
+      }
+
+      selector.addEventListener('change', (event) => {
+        const selectedLanguage = event.target.value;
+        translatePage(selectedLanguage);
+      });
+    })();
+  </script>
+
