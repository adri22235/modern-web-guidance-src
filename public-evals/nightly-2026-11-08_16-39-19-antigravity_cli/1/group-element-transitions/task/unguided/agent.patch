+
+    /* Group View Transition animations while maintaining page interactivity */
+    ::view-transition,
+    ::view-transition-group(*),
+    ::view-transition-image-pair(*),
+    ::view-transition-old(*),
+    ::view-transition-new(*) {
+      pointer-events: none;
+    }
+
+    ::view-transition-group(.bean-card) {
+      animation-duration: 380ms;
+      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    ::view-transition-old(.bean-card):only-child {
+      animation: 250ms cubic-bezier(0.4, 0, 1, 1) both bean-card-out;
+    }
+
+    ::view-transition-new(.bean-card):only-child {
+      animation: 300ms cubic-bezier(0, 0, 0.2, 1) both bean-card-in;
+    }
+
+    @keyframes bean-card-in {
+      from {
+        opacity: 0;
+        transform: scale(0.85);
+      }
+      to {
+        opacity: 1;
+        transform: scale(1);
+      }
+    }
+
+    @keyframes bean-card-out {
+      from {
+        opacity: 1;
+        transform: scale(1);
+      }
+      to {
+        opacity: 0;
+        transform: scale(0.85);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
