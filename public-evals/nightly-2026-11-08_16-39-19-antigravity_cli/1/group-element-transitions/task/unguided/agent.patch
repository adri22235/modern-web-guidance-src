+  <script>
+    (function () {
+      const BEAN_CATALOG = {
+        'kenyan-aa': {
+          name: 'Kenyan AA',
+          origin: 'Nyeri, Kenya',
+          roast: 'Light-Medium',
+          notes: 'Juicy blackcurrant, ruby grapefruit brightness, and a clean wine-like finish.',
+          price: '$20.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
