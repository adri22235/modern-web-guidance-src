+        },
+        'ethiopian-yirgacheffe': {
+          name: 'Ethiopian Yirgacheffe',
+          origin: 'Sidama, Ethiopia',
+          roast: 'Light Roast',
+          notes: 'Jasmine blossom aroma with bright bergamot citrus and sweet peach notes.',
+          price: '$19.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        'colombian-supremo': {
+          name: 'Colombian Supremo',
+          origin: 'Huila, Colombia',
+          roast: 'Medium Roast',
+          notes: 'Velvety body featuring toasted caramel, roasted hazelnut, and red apple acidity.',
+          price: '$17.50 / 12oz',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        'sumatra-mandheling': {
+          name: 'Sumatra Mandheling',
+          origin: 'Aceh, Indonesia',
+          roast: 'Dark Roast',
+          notes: 'Full-bodied and syrupy with dark baker\'s chocolate, cedar spice, and low acidity.',
+          price: '$18.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+        },
+        'guatemalan-antigua': {
+          name: 'Guatemalan Antigua',
+          origin: 'Antigua Valley, Guatemala',
+          roast: 'Medium-Dark',
+          notes: 'Rich volcanic soil complexity with milk chocolate, warm cinnamon, and orange zest.',
+          price: '$18.50 / 12oz',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      const beanGrid = document.getElementById('bean-grid');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const varietySelect = document.getElementById('bean-variety-select');
+      const beanCountEl = document.getElementById('bean-count');
+      let nextBeanId = 5;
+
+      function runWithViewTransition(updateDom) {
+        if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(() => {
+            updateDom();
+          });
+        } else {
+          updateDom();
+        }
+      }
+
+      function updateCountAndEmptyState() {
+        const cards = beanGrid.querySelectorAll('.bean-card');
+        const count = cards.length;
+        beanCountEl.textContent = count === 1 ? '1 bean selected' : `${count} beans selected`;
+
+        const existingEmpty = beanGrid.querySelector('.bean-empty-state');
+        if (count === 0 && !existingEmpty) {
+          const empty = document.createElement('div');
+          empty.className = 'bean-empty-state';
+          empty.textContent = 'No coffee beans selected yet. Click "+ Add Bean" above to start building your box.';
+          beanGrid.appendChild(empty);
+        } else if (count > 0 && existingEmpty) {
+          existingEmpty.remove();
+        }
+      }
+
+      function createBeanCard(varietyKey) {
+        const bean = BEAN_CATALOG[varietyKey] || BEAN_CATALOG['kenyan-aa'];
+        const id = `bean-${nextBeanId++}`;
+
+        const article = document.createElement('article');
+        article.className = 'card bean-card';
+        article.setAttribute('role', 'listitem');
+        article.dataset.beanId = id;
+        article.dataset.variety = varietyKey;
+
+        article.innerHTML = `
+          <div class="bean-card-image-wrap">
+            <img class="bean-card-image" src="${bean.image}" alt="${bean.name} coffee beans" loading="lazy">
+            <span class="roast-badge">${bean.roast}</span>
+          </div>
+          <div class="bean-card-body">
+            <span class="bean-origin">${bean.origin}</span>
+            <h3>${bean.name}</h3>
+            <p class="bean-notes">${bean.notes}</p>
+            <div class="bean-card-footer">
+              <span class="bean-price">${bean.price}</span>
+              <button type="button" class="remove-bean-btn" data-action="remove-bean" aria-label="Remove ${bean.name}">Remove</button>
+            </div>
+          </div>
+        `;
+        return article;
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        const selectedKey = varietySelect.value;
+        const newCard = createBeanCard(selectedKey);
+
+        runWithViewTransition(() => {
+          beanGrid.prepend(newCard);
+          updateCountAndEmptyState();
+        });
+
+        // Advance selector to next variety for convenient one-click additions
+        varietySelect.selectedIndex = (varietySelect.selectedIndex + 1) % varietySelect.options.length;
+      });
+
+      beanGrid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.remove-bean-btn');
+        if (!removeBtn) return;
+
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        runWithViewTransition(() => {
+          card.remove();
+          updateCountAndEmptyState();
+        });
+      });
+    })();
+  </script>
