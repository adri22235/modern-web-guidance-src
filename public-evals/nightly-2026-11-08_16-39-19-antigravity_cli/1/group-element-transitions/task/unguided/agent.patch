+          roast: 'Medium Roast',
+          notes: 'Honeyed sweetness balanced by crisp tangerine and toasted almond.',
+          price: '$18.50 / 12oz',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+        },
+        'brazilian-santos': {
+          name: 'Brazilian Santos',
+          origin: 'Minas Gerais, Brazil',
+          roast: 'Medium Roast',
+          notes: 'Smooth praline, sweet hazelnut, and creamy cocoa with gentle acidity.',
+          price: '$17.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+        },
+        'jamaican-blue-mountain': {
+          name: 'Jamaican Blue Mountain',
+          origin: 'Blue Mountains, Jamaica',
+          roast: 'Medium Roast',
