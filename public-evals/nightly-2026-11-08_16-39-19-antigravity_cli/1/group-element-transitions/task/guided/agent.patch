+  <script>
+    (() => {
+      const BEAN_CATALOG = {
+        'kenya-aa': {
+          name: 'Kenya AA',
+          roast: 'Light Roast',
+          price: 19,
+          notes: 'Vibrant blackcurrant acidity with juicy grapefruit and cane sugar finish.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80',
+          alt: 'Whole Kenya AA light roast coffee beans'
+        },
+        'costa-rica-tarrazu': {
+          name: 'Costa Rica Tarrazú',
+          roast: 'Medium Roast',
+          price: 18,
+          notes: 'Crisp honey sweetness with notes of golden raisin and roasted almond.',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80',
+          alt: 'Roasted Costa Rica Tarrazú coffee beans'
+        },
+        'ethiopian-yirgacheffe': {
+          name: 'Ethiopian Yirgacheffe',
+          roast: 'Light Roast',
+          price: 18,
+          notes: 'Floral jasmine aroma with bright bergamot and Meyer lemon notes.',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80',
+          alt: 'Roasted Ethiopian Yirgacheffe coffee beans'
+        },
+        'colombian-supremo': {
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          price: 16,
+          notes: 'Velvety caramel body balanced with toasted walnut and red apple sweetness.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
+          alt: 'Freshly ground Colombian Supremo coffee and whole beans'
+        },
+        'sumatra-mandheling': {
+          name: 'Sumatra Mandheling',
+          roast: 'Dark Roast',
+          price: 17,
+          notes: 'Full-bodied and earthy with rich dark chocolate and warm cedar spice.',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80',
+          alt: 'Dark roasted Sumatra Mandheling coffee beans in a burlap sack'
+        },
+        'guatemala-antigua': {
+          name: 'Guatemala Antigua',
+          roast: 'Medium-Dark',
+          price: 17,
+          notes: 'Smooth cocoa nib finish layered with brown sugar and subtle orange zest.',
+          image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80',
+          alt: 'Artisanal Guatemala Antigua whole coffee beans'
+        }
+      };
+
+      const DEFAULT_ROAST_KEYS = [
+        'ethiopian-yirgacheffe',
+        'colombian-supremo',
+        'sumatra-mandheling',
+        'guatemala-antigua'
+      ];
+
+      const beanList = document.getElementById('bean-selection-list');
+      const beanSelect = document.getElementById('bean-variety-select');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const resetBeansBtn = document.getElementById('reset-beans-btn');
+      const statusEl = document.getElementById('bean-selection-status');
+      const emptyMessageEl = document.getElementById('bean-empty-message');
+
+      let nextIdCounter = 5;
+
+      function runGroupTransition(updateDOM) {
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(() => {
+            updateDOM();
+          });
+          transition.ready.catch(() => {});
+        } else {
+          updateDOM();
+        }
+      }
+
+      function createBeanElement(roastKey, uniqueId) {
+        const bean = BEAN_CATALOG[roastKey];
+        if (!bean) return null;
+
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.itemId = uniqueId;
+        li.dataset.price = String(bean.price);
+        li.style.viewTransitionName = uniqueId;
+
+        const img = document.createElement('img');
+        img.src = bean.image;
+        img.alt = bean.alt;
+        img.width = 600;
+        img.height = 375;
+        img.loading = 'lazy';
+
+        const body = document.createElement('div');
+        body.className = 'bean-item-body';
+
+        const meta = document.createElement('div');
+        meta.className = 'bean-meta';
+
+        const badge = document.createElement('span');
+        badge.className = 'roast-badge';
+        badge.textContent = bean.roast;
+
+        const price = document.createElement('span');
+        price.className = 'bean-price';
+        price.textContent = `$${bean.price}`;
+
+        meta.append(badge, price);
+
+        const title = document.createElement('h3');
+        title.textContent = bean.name;
+
+        const notes = document.createElement('p');
+        notes.className = 'bean-notes';
+        notes.textContent = bean.notes;
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'bean-remove-btn';
+        removeBtn.append('Remove ');
+
+        const hiddenName = document.createElement('span');
+        hiddenName.className = 'visually-hidden';
+        hiddenName.textContent = bean.name;
+        removeBtn.appendChild(hiddenName);
+
+        body.append(meta, title, notes, removeBtn);
+        li.append(img, body);
+        return li;
+      }
+
+      function updateStatus() {
+        const items = Array.from(beanList.querySelectorAll('.bean-item'));
+        const count = items.length;
+        const total = items.reduce((sum, item) => sum + Number(item.dataset.price || 0), 0);
+        const bagWord = count === 1 ? 'bag' : 'bags';
+        statusEl.textContent = `${count} ${bagWord} in your selection ($${total} total)`;
+        emptyMessageEl.hidden = count > 0;
+      }
+
+      function addBean(roastKey) {
+        const uniqueId = `bean-${nextIdCounter++}`;
+        const newItem = createBeanElement(roastKey, uniqueId);
+        if (!newItem) return;
+
+        runGroupTransition(() => {
+          beanList.prepend(newItem);
+          updateStatus();
+        });
+      }
+
+      function removeBeanItem(itemEl) {
+        const hadFocus = itemEl.contains(document.activeElement);
+        const nextFocusTarget =
+          itemEl.nextElementSibling?.querySelector('.bean-remove-btn') ??
+          itemEl.previousElementSibling?.querySelector('.bean-remove-btn') ??
+          addBeanBtn;
+
+        runGroupTransition(() => {
+          itemEl.remove();
+          updateStatus();
+          if (hadFocus) {
+            nextFocusTarget?.focus();
+          }
+        });
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        addBean(beanSelect.value);
+      });
+
+      document.querySelectorAll('[data-add-bean]').forEach((chip) => {
+        chip.addEventListener('click', () => {
+          addBean(chip.dataset.addBean);
+        });
+      });
+
+      beanList.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.bean-remove-btn');
+        if (!removeBtn) return;
+        const itemEl = removeBtn.closest('.bean-item');
+        if (itemEl) {
+          removeBeanItem(itemEl);
+        }
+      });
+
+      resetBeansBtn.addEventListener('click', () => {
+        runGroupTransition(() => {
+          beanList.replaceChildren(
+            ...DEFAULT_ROAST_KEYS.map((key) => createBeanElement(key, `bean-${nextIdCounter++}`))
+          );
+          updateStatus();
+        });
+      });
+    })();
+  </script>
+
 </body>
 
