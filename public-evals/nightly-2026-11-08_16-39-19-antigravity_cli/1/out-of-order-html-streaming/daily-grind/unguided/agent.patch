+          <h3>Cascara Cold Brew</h3>
+          <p>Notes of dried cherry and brown sugar in our 18-hour cold brew.</p>
+          <a href="/menu/cascara-cold-brew" class="btn">View Details</a>
+        </div>
+      `
+    };
+
+    // 1. Refresh all seasonal coffee cards with fresh HTML from the server when the menu changes
+    async function refreshSeasonalCards(season = seasonSelect.value, endpoint = `/api/menu/seasonal?season=${encodeURIComponent(season)}`) {
+      try {
+        const response = await fetch(endpoint, {
+          headers: { Accept: 'text/html' }
+        });
+
+        if (response.ok) {
+          if (typeof response.textStream === 'function' && typeof seasonalGrid.streamHTML === 'function') {
+            await response.textStream().pipeTo(seasonalGrid.streamHTML());
+            return;
+          }
+          if (response.body && typeof seasonalGrid.streamHTML === 'function') {
+            await response.body.pipeThrough(new TextDecoderStream()).pipeTo(seasonalGrid.streamHTML());
+            return;
+          }
+          const html = await response.text();
+          seasonalGrid.setHTML(html);
+          return;
+        }
+      } catch (_) {
+        // Fall back to local seasonal HTML if server endpoint is offline
+      }
+
+      const fallbackHTML = FALLBACK_MENUS[season] || FALLBACK_MENUS.autumn;
+      if (typeof seasonalGrid.setHTML === 'function') {
+        seasonalGrid.setHTML(fallbackHTML);
+      } else {
+        seasonalGrid.innerHTML = fallbackHTML;
+      }
+    }
+
+    // Replace an individual coffee card in place with fresh server HTML
+    async function refreshSingleCardInPlace(cardElement, cardHTML) {
+      if (typeof cardElement.replaceWithHTML === 'function') {
+        cardElement.replaceWithHTML(cardHTML);
+      } else {
+        cardElement.outerHTML = cardHTML;
+      }
+    }
+
+    seasonSelect.addEventListener('change', () => {
+      refreshSeasonalCards(seasonSelect.value);
+    });
+
+    refreshMenuBtn.addEventListener('click', () => {
+      refreshSeasonalCards(seasonSelect.value);
+    });
+
+    window.addEventListener('menu-change', (event) => {
+      const nextSeason = event.detail?.season || seasonSelect.value;
+      if (event.detail?.html && typeof seasonalGrid.setHTML === 'function') {
+        seasonalGrid.setHTML(event.detail.html);
+      } else {
+        refreshSeasonalCards(nextSeason, event.detail?.url);
+      }
+    });
+
+    // 2. Customer-submitted reviews: safely parse & sanitize untrusted user HTML in place via setHTML / appendHTML
+    const initialCustomerReviewsHTML = `
+      <article class="review-item">
+        <strong>Elena R.</strong> &mdash; <em>Maple Oat Latte</em>
+        <p>The <strong>Vermont maple</strong> flavor is spot-on and not overly sweet!</p>
+      </article>
+      <article class="review-item">
+        <strong>Marcus T.</strong> &mdash; <em>Cold Brew</em>
+        <p>Incredibly smooth 18-hour steep. My daily go-to.</p>
+      </article>
+    `;
+
+    function renderCustomerReviews(reviewsMarkup) {
+      if (typeof reviewsList.setHTML === 'function') {
+        reviewsList.setHTML(reviewsMarkup);
+      } else {
+        reviewsList.innerHTML = reviewsMarkup;
+      }
+    }
+
+    function addCustomerReview(authorName, reviewMarkup) {
+      const entryHTML = `
+        <article class="review-item">
+          <strong>${authorName}</strong>
+          <div class="review-body">${reviewMarkup}</div>
+        </article>
+      `;
+      if (typeof reviewsList.appendHTML === 'function') {
+        reviewsList.appendHTML(entryHTML);
+      } else if (typeof reviewsList.setHTML === 'function') {
+        const wrapper = document.createElement('div');
+        wrapper.setHTML(entryHTML);
+        reviewsList.append(...wrapper.childNodes);
+      } else {
+        reviewsList.insertAdjacentHTML('beforeend', entryHTML);
+      }
+    }
+
+    renderCustomerReviews(initialCustomerReviewsHTML);
+
+    reviewForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const nameInput = document.getElementById('reviewer-name');
+      const contentInput = document.getElementById('review-content');
+      addCustomerReview(nameInput.value, contentInput.value);
+      reviewForm.reset();
+    });
+
+    // 3. Trusted CMS promo block with its own embedded widget script via setHTMLUnsafe(..., { runScripts: true })
+    const defaultCmsPromoHTML = `
+      <div class="cms-promo-widget" id="daily-grind-cms-promo">
+        <h4>Double Bean Rewards Week</h4>
+        <p>Order any Seasonal Favorite today and earn 2x loyalty beans.</p>
+        <span class="promo-badge" id="cms-promo-widget-status">Initializing promo widget...</span>
+      </div>
+      <script>
+        (() => {
+          const badge = document.getElementById('cms-promo-widget-status');
+          if (badge) {
+            badge.textContent = 'Use code GRIND2X at checkout — Active Now';
+            badge.dataset.widgetInitialized = 'true';
+          }
+        })();
+      <\/script>
+    `;
+
+    async function loadCmsPromoBlock(cmsHTML = defaultCmsPromoHTML, cmsEndpoint = null) {
+      if (cmsEndpoint) {
+        try {
+          const response = await fetch(cmsEndpoint, {
+            headers: { Accept: 'text/html' }
+          });
+          if (response.ok) {
+            if (typeof response.textStream === 'function' && typeof cmsPromoContainer.streamHTMLUnsafe === 'function') {
+              await response.textStream().pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+              return;
+            }
+            cmsHTML = await response.text();
+          }
+        } catch (_) {
+          // Use provided default CMS promo HTML if endpoint fetch fails
+        }
+      }
+
+      if (typeof cmsPromoContainer.setHTMLUnsafe === 'function') {
+        cmsPromoContainer.setHTMLUnsafe(cmsHTML, { runScripts: true });
+      } else {
+        cmsPromoContainer.innerHTML = cmsHTML;
+      }
+    }
+
+    loadCmsPromoBlock();
+
+    // Expose helpers for programmatic updates
+    window.DailyGrindSeasonal = {
+      refreshSeasonalCards,
+      refreshSingleCardInPlace,
+      renderCustomerReviews,
+      addCustomerReview,
+      loadCmsPromoBlock
+    };
+  </script>
+
