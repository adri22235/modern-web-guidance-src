+    const cmsPromoContainer = document.getElementById('cms-promo-block');
+
+    // Fallback menu markup per season when server endpoint is unavailable
+    const FALLBACK_MENUS = {
+      autumn: `
+        <div class="card" id="card-maple-oat" data-drink-id="maple-oat">
+          <h3>Maple Oat Latte</h3>
