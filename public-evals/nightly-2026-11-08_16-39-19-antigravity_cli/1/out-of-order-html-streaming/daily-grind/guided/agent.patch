+      const promo = codeMap[season] ?? codeMap.autumn;
+      return `
+        <span class="cms-widget-badge">Daily Grind CMS Promo</span>
+        <h3 id="cms-promo-heading">${promo.title}</h3>
+        <p>Use our interactive CMS widget to unlock <strong>${promo.perk}</strong>.</p>
+        <p id="cms-promo-widget-status" class="price-tag">Initializing CMS promo widget...</p>
+        <button type="button" id="cms-claim-promo-btn" class="btn">Claim Promo Code (${promo.code})</button>
+        <script>
+          (() => {
+            const statusEl = document.getElementById('cms-promo-widget-status');
+            const claimBtn = document.getElementById('cms-claim-promo-btn');
+            if (statusEl) {
+              statusEl.textContent = 'Active Promo Code: ${promo.code} (Ready to apply)';
+            }
+            if (claimBtn && !claimBtn.dataset.bound) {
+              claimBtn.dataset.bound = 'true';
+              claimBtn.addEventListener('click', () => {
+                if (statusEl) {
+                  statusEl.textContent = 'Promo ${promo.code} applied to your seasonal order!';
+                }
+              });
+            }
+          })();
+        <\/script>
+      `;
+    }
+
+    function createChunkedHTMLResponse(htmlString) {
+      const encoder = new TextEncoder();
+      const mid = Math.floor(htmlString.length / 2);
+      const chunks = [htmlString.slice(0, mid), htmlString.slice(mid)];
+      const stream = new ReadableStream({
+        start(controller) {
+          for (const chunk of chunks) {
+            controller.enqueue(encoder.encode(chunk));
+          }
+          controller.close();
+        }
+      });
+      return new Response(stream, {
+        status: 200,
+        headers: { 'Content-Type': 'text/html; charset=utf-8' }
+      });
+    }
+
+    async function fetchMenuStreamResponse(season) {
+      try {
+        const response = await fetch(`/api/menu/seasonal?season=${encodeURIComponent(season)}`, {
+          headers: { Accept: 'text/html' }
+        });
+        if (response.ok && response.body) {
+          return response;
+        }
+      } catch {
+        // Fall back to synthesized streaming HTML response when running without an API backend
+      }
+      return createChunkedHTMLResponse(SEASONAL_MENU_HTML[season] ?? SEASONAL_MENU_HTML.autumn);
+    }
+
+    async function fetchCmsPromoResponse(season) {
+      try {
+        const response = await fetch(`/api/cms/promo?season=${encodeURIComponent(season)}`, {
+          headers: { Accept: 'text/html' }
+        });
+        if (response.ok && response.body) {
+          return response;
+        }
+      } catch {
+        // Fall back to synthesized CMS HTML response when running without an API backend
+      }
+      return createChunkedHTMLResponse(buildCmsPromoHTML(season));
+    }
+
+    // 3. Refresh the coffee cards in place by streaming fresh HTML from the server into the grid
+    export async function refreshSeasonalCards(season = 'autumn') {
+      const cardsGrid = document.getElementById('seasonal-cards-grid');
+      if (!cardsGrid) return;
+
+      // Preserve focus if the user's active element is inside the cards grid being replaced
+      const activeCard = cardsGrid.contains(document.activeElement)
+        ? document.activeElement.closest('[data-card-id]')
+        : null;
+      const activeCardId = activeCard?.getAttribute('data-card-id');
+
+      cardsGrid.setAttribute('aria-busy', 'true');
+      const response = await fetchMenuStreamResponse(season);
+
+      if ('streamHTML' in Element.prototype && response.body) {
+        const textStream = 'textStream' in response
+          ? response.textStream()
+          : response.body.pipeThrough(new TextDecoderStream());
+        await textStream.pipeTo(
+          cardsGrid.streamHTML({ sanitizer: createNativeSanitizer(MENU_SANITIZER_CONFIG) })
+        );
+      } else {
+        const html = await response.text();
+        await safeSetHTML(cardsGrid, html, MENU_SANITIZER_CONFIG);
+      }
+
+      cardsGrid.removeAttribute('aria-busy');
+
+      // Restore focus if the previously focused card still exists or move to first card link
+      if (activeCardId) {
+        const replacementCard = cardsGrid.querySelector(`[data-card-id="${CSS.escape(activeCardId)}"] a, .card a`);
+        replacementCard?.focus();
+      }
+    }
+
+    // 4. Render trusted first-party CMS promo block with embedded widget script using setHTMLUnsafe / streamHTMLUnsafe
+    export async function refreshCmsPromoBlock(season = 'autumn') {
+      const promoContainer = document.getElementById('cms-promo-content');
+      if (!promoContainer) return;
+
+      const response = await fetchCmsPromoResponse(season);
+
+      if ('streamHTMLUnsafe' in Element.prototype && response.body) {
+        const textStream = 'textStream' in response
+          ? response.textStream()
+          : response.body.pipeThrough(new TextDecoderStream());
+        await textStream.pipeTo(promoContainer.streamHTMLUnsafe({ runScripts: true }));
+      } else if ('setHTMLUnsafe' in Element.prototype) {
+        const trustedCmsHTML = await response.text();
+        try {
+          promoContainer.setHTMLUnsafe(trustedCmsHTML, { runScripts: true });
+        } catch {
+          promoContainer.setHTMLUnsafe(trustedCmsHTML);
+        }
+      }
+    }
+
+    // 5. Wire up menu changes, server-pushed menu updates, and customer review submissions
+    async function initDailyGrind() {
+      await ensureStreamingPolyfills();
+
+      // Ensure CMS widget script is interactive if browser parsed <template for> without executing script
+      const promoStatus = document.getElementById('cms-promo-widget-status');
+      if (promoStatus && promoStatus.textContent.includes('Activating')) {
+        await refreshCmsPromoBlock('autumn');
+      }
+
+      const menuSelect = document.getElementById('seasonal-menu-select');
+      const refreshBtn = document.getElementById('refresh-menu-btn');
+
+      if (menuSelect) {
+        menuSelect.addEventListener('change', async () => {
+          const season = menuSelect.value;
+          await Promise.all([
+            refreshSeasonalCards(season),
+            refreshCmsPromoBlock(season)
+          ]);
+        });
+      }
+
+      if (refreshBtn) {
+        refreshBtn.addEventListener('click', async () => {
+          const season = menuSelect?.value || 'autumn';
+          await Promise.all([
+            refreshSeasonalCards(season),
+            refreshCmsPromoBlock(season)
+          ]);
+        });
+      }
+
+      // Listen for custom 'menu-change' events dispatched on document/window
+      document.addEventListener('menu-change', async (event) => {
+        const season = event.detail?.season || menuSelect?.value || 'autumn';
+        if (menuSelect && event.detail?.season) {
+          menuSelect.value = season;
+        }
+        await Promise.all([
+          refreshSeasonalCards(season),
+          refreshCmsPromoBlock(season)
+        ]);
+      });
+
+      // Handle untrusted customer review live preview and submission via Sanitizer API
+      const reviewForm = document.getElementById('customer-review-form');
+      const reviewerInput = document.getElementById('reviewer-name');
+      const reviewHtmlInput = document.getElementById('review-html-input');
+      const reviewPreview = document.getElementById('review-live-preview');
+      const reviewsList = document.getElementById('customer-reviews-list');
+
+      if (reviewHtmlInput && reviewPreview) {
+        reviewHtmlInput.addEventListener('input', () => {
+          renderSanitizedPreview(reviewPreview, reviewHtmlInput.value);
+        });
+      }
+
+      if (reviewForm && reviewsList) {
+        reviewForm.addEventListener('submit', async (event) => {
+          event.preventDefault();
+          const authorName = reviewerInput.value.trim() || 'Coffee Lover';
+          const untrustedReviewBody = reviewHtmlInput.value.trim();
+          if (!untrustedReviewBody) return;
+
+          // Create review item container and safely populate author as textContent
+          // and untrusted review body via safeSetHTML()
+          const article = document.createElement('article');
+          article.className = 'review-item';
+
+          const authorStrong = document.createElement('strong');
+          authorStrong.textContent = `${authorName}: `;
+
+          const bodyContainer = document.createElement('span');
+          await safeSetHTML(bodyContainer, untrustedReviewBody, REVIEW_SANITIZER_CONFIG);
+
+          const paragraph = document.createElement('p');
+          paragraph.append(authorStrong, ...bodyContainer.childNodes);
+          article.append(paragraph);
+          reviewsList.append(article);
+
+          reviewForm.reset();
+          if (reviewPreview) {
+            reviewPreview.replaceChildren();
+          }
+        });
+      }
+    }
+
+    initDailyGrind();
+  </script>
 </body>
 
 </html>
