+
+        // Find card closest to carousel left edge
+        const carouselRect = carousel.getBoundingClientRect();
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        cards.forEach((card, index) => {
+          const rect = card.getBoundingClientRect();
+          const dist = Math.abs(rect.left - carouselRect.left);
+          if (dist < minDistance) {
+            minDistance = dist;
+            closestIndex = index;
+          }
+        });
+
+        dots.forEach((dot, idx) => {
+          dot.setAttribute('aria-selected', idx === closestIndex ? 'true' : 'false');
+        });
+      }
+
+      function scrollToCard(index) {
+        const clamped = Math.max(0, Math.min(cards.length - 1, index));
+        const targetCard = cards[clamped];
+        if (!targetCard) return;
+        const leftOffset = targetCard.offsetLeft - carousel.offsetLeft - 8;
+        carousel.scrollTo({ left: leftOffset, behavior: 'smooth' });
+      }
+
+      function getActiveIndex() {
+        const idx = dots.findIndex((d) => d.getAttribute('aria-selected') === 'true');
+        return idx >= 0 ? idx : 0;
+      }
+
+      prevBtn.addEventListener('click', () => {
+        scrollToCard(getActiveIndex() - 1);
+      });
+
+      nextBtn.addEventListener('click', () => {
+        scrollToCard(getActiveIndex() + 1);
+      });
+
+      dots.forEach((dot) => {
+        dot.addEventListener('click', () => {
+          const slideIndex = Number(dot.getAttribute('data-slide-index'));
+          scrollToCard(slideIndex);
+        });
+      });
+
+      // Keyboard navigation for the horizontal carousel track
+      carousel.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowRight') {
+          e.preventDefault();
+          scrollToCard(getActiveIndex() + 1);
+        } else if (e.key === 'ArrowLeft') {
+          e.preventDefault();
+          scrollToCard(getActiveIndex() - 1);
+        } else if (e.key === 'Home') {
+          e.preventDefault();
+          scrollToCard(0);
+        } else if (e.key === 'End') {
+          e.preventDefault();
+          scrollToCard(cards.length - 1);
+        }
+      });
+
+      // Pointer drag-to-swipe support for mouse & touch
+      let isPointerDown = false;
+      let hasDragged = false;
+      let startX = 0;
+      let startScrollLeft = 0;
+
+      carousel.addEventListener('pointerdown', (e) => {
+        if (e.target.closest('button, a')) return;
+        isPointerDown = true;
+        hasDragged = false;
+        startX = e.clientX;
+        startScrollLeft = carousel.scrollLeft;
+        carousel.classList.add('is-dragging');
+        if (carousel.setPointerCapture) {
+          try {
+            carousel.setPointerCapture(e.pointerId);
+          } catch (_) {}
+        }
+      });
+
+      carousel.addEventListener('pointermove', (e) => {
+        if (!isPointerDown) return;
+        const deltaX = e.clientX - startX;
+        if (Math.abs(deltaX) > 5) {
+          hasDragged = true;
+        }
+        carousel.scrollLeft = startScrollLeft - deltaX;
+      });
+
+      function endPointerDrag() {
+        if (!isPointerDown) return;
+        isPointerDown = false;
+        carousel.classList.remove('is-dragging');
+      }
+
+      carousel.addEventListener('pointerup', endPointerDrag);
+      carousel.addEventListener('pointercancel', endPointerDrag);
+      carousel.addEventListener('scroll', updateCarouselState, { passive: true });
+      window.addEventListener('resize', updateCarouselState);
+      updateCarouselState();
+
+      // Favorite toggle buttons on cards
+      document.querySelectorAll('.favorite-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const pressed = btn.getAttribute('aria-pressed') === 'true';
+          btn.setAttribute('aria-pressed', String(!pressed));
+          btn.innerHTML = !pressed ? '&#9829;' : '&#9825;';
+        });
+      });
+
+      // Keyboard Space/Enter pressed visual feedback helper for all interactive buttons and links
+      document.querySelectorAll('a, button').forEach((el) => {
+        el.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            el.classList.add('is-pressed');
+          }
+        });
+        el.addEventListener('keyup', () => {
+          el.classList.remove('is-pressed');
+        });
+        el.addEventListener('blur', () => {
+          el.classList.remove('is-pressed');
+        });
+      });
+
+      // Expanding Detail View right out of the button that triggered it
+      const backdrop = document.getElementById('drink-detail-backdrop');
+      const panel = document.getElementById('drink-detail-panel');
+      const closeBtn = document.getElementById('detail-close-btn');
+      const dismissBtn = document.getElementById('detail-dismiss-btn');
+      const orderBtn = document.getElementById('detail-order-btn');
+      const sizeButtons = Array.from(panel.querySelectorAll('.size-btn'));
+
+      const detailImage = document.getElementById('detail-image');
+      const detailBadge = document.getElementById('detail-badge');
+      const detailTitle = document.getElementById('detail-title');
+      const detailPrice = document.getElementById('detail-price');
+      const detailDescription = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+      const detailOrigin = document.getElementById('detail-origin');
+      const detailNutrition = document.getElementById('detail-nutrition');
+
+      let activeTriggerBtn = null;
+
+      function computeTriggerTransform(triggerEl) {
+        if (!triggerEl) {
+          panel.style.setProperty('--from-x', '0px');
+          panel.style.setProperty('--from-y', '24px');
+          panel.style.setProperty('--from-scale-x', '0.3');
+          panel.style.setProperty('--from-scale-y', '0.15');
+          return;
+        }
+
+        const btnRect = triggerEl.getBoundingClientRect();
+        const viewportCenterX = window.innerWidth / 2;
+        const viewportCenterY = window.innerHeight / 2;
+
+        const btnCenterX = btnRect.left + btnRect.width / 2;
+        const btnCenterY = btnRect.top + btnRect.height / 2;
+
+        const targetWidth = Math.min(640, window.innerWidth - 40);
+        const targetHeight = Math.min(540, window.innerHeight * 0.85);
+
+        const deltaX = btnCenterX - viewportCenterX;
+        const deltaY = btnCenterY - viewportCenterY;
+        const scaleX = Math.max(0.08, btnRect.width / targetWidth);
+        const scaleY = Math.max(0.06, btnRect.height / targetHeight);
+
+        panel.style.setProperty('--from-x', `${deltaX.toFixed(1)}px`);
+        panel.style.setProperty('--from-y', `${deltaY.toFixed(1)}px`);
+        panel.style.setProperty('--from-scale-x', scaleX.toFixed(3));
+        panel.style.setProperty('--from-scale-y', scaleY.toFixed(3));
+      }
+
+      function openDetailView(drinkId, triggerBtn) {
+        const data = DRINK_DATA[drinkId];
+        if (!data) return;
+
+        if (activeTriggerBtn) {
+          activeTriggerBtn.setAttribute('aria-expanded', 'false');
+        }
+        activeTriggerBtn = triggerBtn;
+        activeTriggerBtn.setAttribute('aria-expanded', 'true');
+
+        detailImage.src = data.image;
+        detailImage.alt = data.alt;
+        detailBadge.textContent = data.badge;
+        detailTitle.textContent = data.title;
+        detailPrice.textContent = data.price;
+        detailDescription.textContent = data.description;
+        detailNotes.textContent = data.notes;
+        detailOrigin.textContent = data.origin;
+        detailNutrition.textContent = data.nutrition;
+        orderBtn.textContent = `Add ${data.title} to Order`;
+
+        // Snap panel to the triggering button's coordinates before animating open
+        panel.style.transition = 'none';
+        computeTriggerTransform(triggerBtn);
+        backdrop.classList.remove('is-open');
+        backdrop.setAttribute('aria-hidden', 'false');
+        document.body.classList.add('modal-open');
+
+        // Force reflow so the starting transform from the trigger button is committed
+        void panel.offsetWidth;
+
+        panel.style.transition = '';
+        requestAnimationFrame(() => {
+          backdrop.classList.add('is-open');
+          closeBtn.focus({ preventScroll: true });
+        });
+      }
+
+      function closeDetailView() {
+        if (!backdrop.classList.contains('is-open')) return;
+
+        // Recompute button coordinates in case viewport changed so it collapses right back into the button
+        computeTriggerTransform(activeTriggerBtn);
+        backdrop.classList.remove('is-open');
+        backdrop.setAttribute('aria-hidden', 'true');
+        document.body.classList.remove('modal-open');
+
+        if (activeTriggerBtn) {
+          activeTriggerBtn.setAttribute('aria-expanded', 'false');
+          activeTriggerBtn.focus({ preventScroll: true });
+        }
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          if (hasDragged) return;
+          const drinkId = btn.getAttribute('data-drink-id');
+          openDetailView(drinkId, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDetailView);
+      dismissBtn.addEventListener('click', closeDetailView);
+
+      backdrop.addEventListener('click', (e) => {
+        if (e.target === backdrop) {
+          closeDetailView();
+        }
+      });
+
+      sizeButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
+          btn.setAttribute('aria-pressed', 'true');
+        });
+      });
+
+      orderBtn.addEventListener('click', () => {
+        const selectedSize = panel.querySelector('.size-btn[aria-pressed="true"]')?.getAttribute('data-size') || 'Medium (16oz)';
+        orderBtn.textContent = `Added (${selectedSize}) ✓`;
+        setTimeout(() => {
+          closeDetailView();
+        }, 550);
+      });
+
+      // Trap focus inside detail dialog and handle Escape key
+      document.addEventListener('keydown', (e) => {
+        if (!backdrop.classList.contains('is-open')) return;
+
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeDetailView();
+          return;
+        }
+
+        if (e.key === 'Tab') {
+          const focusable = Array.from(
+            panel.querySelectorAll('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])')
+          );
+          if (focusable.length === 0) return;
+          const first = focusable[0];
+          const last = focusable[focusable.length - 1];
+
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
