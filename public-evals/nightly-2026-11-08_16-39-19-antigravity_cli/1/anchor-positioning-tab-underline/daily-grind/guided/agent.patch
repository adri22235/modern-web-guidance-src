@@ -207,6 +229,28 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const navList = document.querySelector('nav ul');
+    navList.addEventListener('click', (event) => {
+      const link = event.target.closest('a:not(.logout-link)');
+      if (!link || !navList.contains(link)) return;
+      event.preventDefault();
+
+      navList.querySelectorAll('li.active').forEach((item) => {
+        item.classList.remove('active');
+      });
+      navList.querySelectorAll('a[aria-current="page"]').forEach((anchor) => {
+        anchor.removeAttribute('aria-current');
+      });
+
+      const listItem = link.closest('li');
+      if (listItem) {
+        listItem.classList.add('active');
+      }
+      link.setAttribute('aria-current', 'page');
+    });
+  </script>
+
 </body>
 
