+  <script>
+    (function () {
+      const navList = document.querySelector('nav ul');
+      const navLinks = document.querySelectorAll('nav ul a.nav-item');
+      const indicator = document.querySelector('.nav-indicator');
+
+      function updateIndicator(activeLink, animate = true) {
+        if (!activeLink || !indicator || !navList) return;
+        if (!animate) {
+          indicator.style.transition = 'none';
+        }
+        const listRect = navList.getBoundingClientRect();
+        const linkRect = activeLink.getBoundingClientRect();
+        const left = linkRect.left - listRect.left;
+        const width = linkRect.width;
+
+        indicator.style.left = `${left}px`;
+        indicator.style.width = `${width}px`;
+
+        if (!animate) {
+          // Force reflow before restoring CSS transition
+          void indicator.offsetWidth;
+          indicator.style.transition = '';
+        }
+      }
+
+      function setActiveLink(selectedLink, animate = true) {
+        navLinks.forEach((link) => {
+          const isSelected = link === selectedLink;
+          link.classList.toggle('active', isSelected);
+          if (link.parentElement) {
+            link.parentElement.classList.toggle('active', isSelected);
+          }
+          if (isSelected) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        updateIndicator(selectedLink, animate);
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          setActiveLink(link, true);
+        });
+      });
+
+      const initialActive = document.querySelector('nav ul a.nav-item.active') || navLinks[0];
+      setActiveLink(initialActive, false);
+
+      window.addEventListener('resize', () => {
+        const currentActive = document.querySelector('nav ul a.nav-item.active');
+        updateIndicator(currentActive, false);
+      });
+    })();
+  </script>
+
