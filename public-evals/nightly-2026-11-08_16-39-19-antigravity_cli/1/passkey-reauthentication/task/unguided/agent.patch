+  <script>
+    function bufferFromBase64url(input) {
+      if (input instanceof ArrayBuffer) {
+        return new Uint8Array(input);
+      }
+      if (ArrayBuffer.isView(input)) {
+        return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+      }
+      if (Array.isArray(input)) {
+        return new Uint8Array(input);
+      }
+      if (typeof input === 'string') {
+        const base64 = input.replace(/-/g, '+').replace(/_/g, '/');
+        const padLength = (4 - (base64.length % 4)) % 4;
+        const padded = base64 + '='.repeat(padLength);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return bytes;
+      }
+      return new Uint8Array(0);
+    }
+
+    function bufferToBase64url(buffer) {
+      if (typeof buffer === 'string') {
+        return buffer;
+      }
+      const bytes = buffer instanceof ArrayBuffer
+        ? new Uint8Array(buffer)
+        : ArrayBuffer.isView(buffer)
+          ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+          : new Uint8Array(buffer || []);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    async function handleReauth() {
+      const statusEl = document.getElementById('reauth-status');
+      const buttonEl = document.querySelector('[data-testid="reauth-button"]');
+
+      try {
+        if (buttonEl) buttonEl.disabled = true;
+        if (statusEl) statusEl.textContent = 'Requesting verification challenge...';
+
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          credentials: 'same-origin',
+        });
+
+        if (!optionsResponse.ok) {
+          throw new Error('Failed to fetch re-authentication options');
+        }
+
+        const rawOptions = await optionsResponse.json();
+        const options = rawOptions.publicKey || rawOptions;
+
+        const rawAllowCredentials = options.allowCredentials || options.credentials || [];
+        const allowCredentials = rawAllowCredentials.map((cred) => ({
+          ...cred,
+          type: cred.type || 'public-key',
+          id: bufferFromBase64url(cred.id),
+        }));
+
+        const publicKey = {
+          ...options,
+          challenge: bufferFromBase64url(options.challenge),
+          allowCredentials,
+          userVerification: options.userVerification || 'required',
+        };
+
+        const credential = await navigator.credentials.get({ publicKey });
+
+        if (!credential) {
+          throw new Error('No credential returned from authenticator');
+        }
+
+        const assertionResponse = credential.response || {};
+        const verificationPayload = {
+          id: credential.id || (credential.rawId ? bufferToBase64url(credential.rawId) : ''),
+          rawId: bufferToBase64url(credential.rawId || credential.id || ''),
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : credential.clientExtensionResults || {},
+          response: {
+            clientDataJSON: bufferToBase64url(assertionResponse.clientDataJSON),
+            authenticatorData: bufferToBase64url(assertionResponse.authenticatorData),
+            signature: bufferToBase64url(assertionResponse.signature),
+            userHandle: assertionResponse.userHandle
+              ? bufferToBase64url(assertionResponse.userHandle)
+              : null,
+          },
+        };
+
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          credentials: 'same-origin',
+          body: JSON.stringify(verificationPayload),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error('Identity verification failed');
+        }
+
+        if (statusEl) {
+          statusEl.textContent = 'Identity verified. You may now proceed with sensitive account changes.';
+        }
+      } catch (err) {
+        if (statusEl) {
+          statusEl.textContent = err && err.message ? err.message : 'Re-authentication failed.';
+        }
+      } finally {
+        if (buttonEl) buttonEl.disabled = false;
+      }
+    }
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    if (reauthButton) {
+      reauthButton.addEventListener('click', handleReauth);
+    }
+  </script>
+
