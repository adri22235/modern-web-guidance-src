+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const detectionResult = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+    const displayNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+      ? new Intl.DisplayNames(['en'], { type: 'language' })
+      : null;
+
+    function formatLanguageName(code) {
+      if (!code) return 'Unknown';
+      try {
+        return displayNames ? `${displayNames.of(code)} (${code})` : code;
+      } catch {
+        return code;
+      }
+    }
+
+    function showResult(message, isError = false) {
+      detectionResult.textContent = message;
+      detectionResult.classList.toggle('error', isError);
+      detectionResult.hidden = false;
+    }
+
+    async function initLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showResult('Client-side language detection is not supported in this browser.', true);
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          showResult('Language detection model is currently unavailable on this device.', true);
+        }
+      } catch (err) {
+        detectBtn.disabled = true;
+        showResult('Unable to check language detection availability.', true);
+      }
+    }
+
+    initLanguageDetection();
+
+    feedbackMessage.addEventListener('input', () => {
+      feedbackMessage.setCustomValidity('');
+      feedbackMessage.removeAttribute('aria-invalid');
+    });
+
+    feedbackForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+
+      const text = feedbackMessage.value.trim();
+      if (!text) {
+        feedbackMessage.setCustomValidity('Please enter a feedback message to detect its language.');
+        feedbackMessage.setAttribute('aria-invalid', 'true');
+        showResult('Please enter a message before detecting the language.', true);
+        feedbackMessage.focus();
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showResult('Client-side language detection is not supported in this browser.', true);
+        return;
+      }
+
+      detectBtn.disabled = true;
+      showResult('Detecting language...');
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          showResult('Language detection model is unavailable on this device.', true);
+          return;
+        }
+
+        if (!detectorInstance) {
+          detectorInstance = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (event) => {
+                const pct = Math.round((event.loaded || 0) * 100);
+                showResult(`Downloading language detection model: ${pct}%...`);
+              });
+            },
+          });
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (!results || results.length === 0) {
+          showResult('Could not confidently identify the language.', true);
+        } else {
+          const topResult = results[0];
+          const langLabel = formatLanguageName(topResult.detectedLanguage);
+          const confidencePct = (topResult.confidence * 100).toFixed(1);
+          showResult(`Detected Language: ${langLabel} — ${confidencePct}% confidence`);
+          feedbackMessage.setAttribute('lang', topResult.detectedLanguage);
+        }
+      } catch (error) {
+        showResult(`Language detection failed: ${error.message || 'Unknown error'}`, true);
+      } finally {
+        if ('LanguageDetector' in self) {
+          detectBtn.disabled = false;
+        }
+      }
+    });
+  </script>
