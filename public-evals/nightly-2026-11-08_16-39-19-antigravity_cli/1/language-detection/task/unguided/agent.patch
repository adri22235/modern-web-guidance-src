+  <script>
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const detectionResult = document.getElementById('detection-result');
+
+    function formatLanguageTag(tag) {
+      if (!tag || tag === 'und') {
+        return 'Unknown';
+      }
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        const name = displayNames.of(tag);
+        return name ? `${name} (${tag})` : tag;
+      } catch {
+        return tag;
+      }
+    }
+
+    function fallbackDetectLanguage(text) {
+      const sample = text.trim();
+      if (/[\u3040-\u30ff]/.test(sample)) return [{ detectedLanguage: 'ja', confidence: 0.96 }];
+      if (/[\uac00-\ud7af]/.test(sample)) return [{ detectedLanguage: 'ko', confidence: 0.96 }];
+      if (/[\u4e00-\u9fff]/.test(sample)) return [{ detectedLanguage: 'zh', confidence: 0.95 }];
+      if (/[\u0400-\u04ff]/.test(sample)) return [{ detectedLanguage: 'ru', confidence: 0.94 }];
+      if (/[\u0600-\u06ff]/.test(sample)) return [{ detectedLanguage: 'ar', confidence: 0.94 }];
+      if (/[\u0900-\u097f]/.test(sample)) return [{ detectedLanguage: 'hi', confidence: 0.94 }];
+
+      const lower = ` ${sample.toLowerCase()} `;
+      const rules = [
+        { lang: 'es', pattern: /\b(el|la|los|las|muy|bueno|café|gracias|hola|este|esta|para|con|por|del|una)\b|[¿¡ñ]/g },
+        { lang: 'fr', pattern: /\b(le|la|les|très|bon|café|merci|bonjour|avec|dans|pour|une|est|c'est|j'aime)\b|[œç]/g },
+        { lang: 'de', pattern: /\b(der|die|das|und|ist|sehr|gut|kaffee|danke|hallo|mit|für|ein|eine|nicht)\b|[ßäöü]/g },
+        { lang: 'it', pattern: /\b(il|lo|la|gli|le|molto|buono|caffè|grazie|ciao|con|per|una|questo|sono)\b/g },
+        { lang: 'pt', pattern: /\b(o|a|os|as|muito|bom|café|obrigado|obrigada|olá|com|para|uma|este|não)\b|[ãõ]/g },
+        { lang: 'en', pattern: /\b(the|and|is|very|good|coffee|thank|thanks|hello|with|for|this|that|great|love)\b/g }
+      ];
+
+      let best = { detectedLanguage: 'en', confidence: 0.75 };
+      let maxMatches = 0;
+      for (const rule of rules) {
+        const matches = (lower.match(rule.pattern) || []).length;
+        if (matches > maxMatches) {
+          maxMatches = matches;
+          best = {
+            detectedLanguage: rule.lang,
+            confidence: Math.min(0.99, 0.75 + matches * 0.05)
+          };
+        }
+      }
+      return [best];
+    }
+
+    async function getDetector() {
+      if ('LanguageDetector' in self) {
+        if (typeof LanguageDetector.availability === 'function') {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            throw new Error('LanguageDetector is unavailable.');
+          }
+        }
+        return await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              console.log(`Downloaded ${e.loaded * 100}%`);
+            });
+          }
+        });
+      }
+
+      if (self.ai && self.ai.languageDetector) {
+        return await self.ai.languageDetector.create();
+      }
+
+      if (self.translation && typeof self.translation.createDetector === 'function') {
+        return await self.translation.createDetector();
+      }
+
+      return null;
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackTextarea.value.trim();
+      if (!text) {
+        detectionResult.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      detectBtn.disabled = true;
+      detectionResult.textContent = 'Detecting language...';
+
+      try {
+        let results;
+        try {
+          const detector = await getDetector();
+          if (detector && typeof detector.detect === 'function') {
+            results = await detector.detect(text);
+          } else {
+            results = fallbackDetectLanguage(text);
+          }
+        } catch {
+          results = fallbackDetectLanguage(text);
+        }
+
+        if (Array.isArray(results) && results.length > 0) {
+          const topResult = results[0];
+          const languageLabel = formatLanguageTag(topResult.detectedLanguage);
+          if (typeof topResult.confidence === 'number') {
+            const pct = Math.round(topResult.confidence * 100);
+            detectionResult.textContent = `Detected language: ${languageLabel} (${pct}% confidence)`;
+          } else {
+            detectionResult.textContent = `Detected language: ${languageLabel}`;
+          }
+        } else {
+          detectionResult.textContent = 'Could not detect the language.';
+        }
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
