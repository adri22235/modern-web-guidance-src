+  <script>
+    (function () {
+      const siteHierarchy = {
+        '/': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' }
+          ],
+          view: 'grid',
+          heading: 'Seasonal Favorites'
+        },
+        '/menu': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' }
+          ],
+          view: 'grid',
+          heading: 'Full Menu — Seasonal Favorites'
+        },
+        '/menu/seasonal-favorites': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' }
+          ],
+          view: 'grid',
+          heading: 'Seasonal Favorites'
+        },
+        '/menu/seasonal': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' },
+            { label: 'Maple Oat Latte', href: '/menu/seasonal' }
+          ],
+          view: 'detail',
+          item: {
+            title: 'Maple Oat Latte',
+            category: 'Seasonal Favorites',
+            price: '$5.75',
+            description: 'Velvety steamed oat milk paired with our signature double-shot espresso and pure Grade-A Vermont maple syrup, finished with a light dusting of cinnamon.',
+            notes: 'Tasting notes: Toasted maple, caramel, warm spice.'
+          }
+        },
+        '/menu/espresso': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' },
+            { label: 'Dark Roast Espresso', href: '/menu/espresso' }
+          ],
+          view: 'detail',
+          item: {
+            title: 'Dark Roast Espresso',
+            category: 'Seasonal Favorites',
+            price: '$3.50',
+            description: 'Bold, smokey, and full-bodied single-origin beans roasted to perfection for a rich crema and an unmistakable morning boost.',
+            notes: 'Tasting notes: Dark chocolate, roasted walnut, smoky finish.'
+          }
+        },
+        '/menu/cold-brew': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Menu', href: '/menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' },
+            { label: 'Cold Brew', href: '/menu/cold-brew' }
+          ],
+          view: 'detail',
+          item: {
+            title: 'Cold Brew',
+            category: 'Seasonal Favorites',
+            price: '$4.75',
+            description: 'Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness and naturally low acidity.',
+            notes: 'Tasting notes: Smooth cocoa, sweet molasses, crisp finish.'
+          }
+        },
+        '/locations': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Locations', href: '/locations' }
+          ],
+          view: 'grid',
+          heading: 'Seasonal Favorites (Available at All Locations)'
+        },
+        '/rewards': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'Rewards', href: '/rewards' }
+          ],
+          view: 'grid',
+          heading: 'Seasonal Favorites (Earn 2x Stars)'
+        },
+        '/account': {
+          trail: [
+            { label: 'Home', href: '/' },
+            { label: 'My Account', href: '/account' }
+          ],
+          view: 'grid',
+          heading: 'Your Favorite Seasonal Picks'
+        }
+      };
+
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const productGrid = document.getElementById('product-grid');
+      const detailView = document.getElementById('detail-view');
+      const sectionHeading = document.getElementById('section-heading');
+
+      function renderBreadcrumb(trail) {
+        breadcrumbList.innerHTML = '';
+        trail.forEach((crumb, idx) => {
+          const li = document.createElement('li');
+          li.className = 'breadcrumb-item';
+          const isLast = idx === trail.length - 1;
+          if (isLast) {
+            li.setAttribute('aria-current', 'page');
+            li.textContent = crumb.label;
+          } else {
+            const a = document.createElement('a');
+            a.href = crumb.href;
+            a.setAttribute('data-route', crumb.href);
+            a.textContent = crumb.label;
+            li.appendChild(a);
+          }
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function navigateTo(route, pushHistory = true) {
+        const config = siteHierarchy[route] || siteHierarchy['/'];
+        renderBreadcrumb(config.trail);
+
+        if (config.view === 'detail' && config.item) {
+          sectionHeading.textContent = config.item.title;
+          productGrid.hidden = true;
+          detailView.hidden = false;
+          detailView.innerHTML = `
+            <div class="detail-card">
+              <span class="badge">${config.item.category}</span>
+              <h2>${config.item.title} — ${config.item.price}</h2>
+              <p>${config.item.description}</p>
+              <p class="detail-meta"><strong>${config.item.notes}</strong></p>
+              <div class="detail-actions">
+                <a href="/order-online" class="btn">Add to Order</a>
+                <a href="/menu/seasonal-favorites" data-route="/menu/seasonal-favorites" class="btn btn-secondary">← Back to Seasonal Favorites</a>
+                <a href="/menu" data-route="/menu" class="btn btn-secondary">All Menu</a>
+              </div>
+            </div>
+          `;
+        } else {
+          sectionHeading.textContent = config.heading || 'Seasonal Favorites';
+          productGrid.hidden = false;
+          detailView.hidden = true;
+          detailView.innerHTML = '';
+        }
+
+        if (pushHistory && window.history && window.history.pushState) {
+          try {
+            window.history.pushState({ route }, '', '#' + route);
+          } catch (e) {
+            // Ignore pushState restrictions on file:// URLs
+          }
+        }
+      }
+
+      document.addEventListener('click', function (e) {
+        const link = e.target.closest('a[data-route]');
+        if (!link) return;
+        const route = link.getAttribute('data-route');
+        if (route && siteHierarchy[route]) {
+          e.preventDefault();
+          navigateTo(route, true);
+        }
+      });
+
+      window.addEventListener('popstate', function (e) {
+        const route = (e.state && e.state.route) || window.location.hash.replace(/^#/, '') || '/';
+        navigateTo(route, false);
+      });
+
+      const initialHash = window.location.hash.replace(/^#/, '');
+      if (initialHash && siteHierarchy[initialHash]) {
+        navigateTo(initialHash, false);
+      }
+    })();
+  </script>
+
 </body>
 
