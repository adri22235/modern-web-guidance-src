+  <script>
+    (function () {
+      const items = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          href: '/menu/seasonal/maple-oat-latte',
+          description: 'Creamy steamed oat milk infused with pure Vermont grade-A dark maple syrup and a double shot of our house espresso.',
+          price: '$5.50'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          href: '/menu/espresso',
+          description: 'Bold, smokey, and full-bodied single-origin beans roasted to perfection for an intense morning boost.',
+          price: '$3.75'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          href: '/menu/cold-brew',
+          description: 'Coarse-ground artisanal beans steeped in cool filtered water for 18 hours for maximum smoothness and low acidity.',
+          price: '$4.75'
+        }
+      };
+
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const favoritesGrid = document.getElementById('favorites-grid');
+      const detailView = document.getElementById('item-detail-view');
+      const detailTitle = document.getElementById('detail-title');
+      const detailDescription = document.getElementById('detail-description');
+      const detailPrice = document.getElementById('detail-price');
+      const sectionHeading = document.getElementById('section-heading');
+
+      function renderBreadcrumbs(trail) {
+        breadcrumbList.innerHTML = '';
+        trail.forEach((step, index) => {
+          const li = document.createElement('li');
+          const a = document.createElement('a');
+          a.href = step.href;
+          a.textContent = step.label;
+          if (step.level) {
+            a.dataset.level = step.level;
+          }
+          if (index === trail.length - 1) {
+            a.setAttribute('aria-current', 'page');
+          }
+          li.appendChild(a);
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function showOverview(level) {
+        favoritesGrid.hidden = false;
+        detailView.hidden = true;
+        if (level === 'home') {
+          sectionHeading.textContent = 'Seasonal Favorites';
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' }
+          ]);
+        } else if (level === 'menu') {
+          sectionHeading.textContent = 'Our Menu — Seasonal Favorites';
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' }
+          ]);
+        } else {
+          sectionHeading.textContent = 'Seasonal Favorites';
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' }
+          ]);
+        }
+      }
+
+      function showItem(itemKey) {
+        const item = items[itemKey];
+        if (!item) return;
+        favoritesGrid.hidden = true;
+        detailView.hidden = false;
+        detailTitle.textContent = item.title;
+        detailDescription.textContent = item.description;
+        detailPrice.textContent = item.price;
+        renderBreadcrumbs([
+          { label: 'Home', href: '/', level: 'home' },
+          { label: 'Menu', href: '/menu', level: 'menu' },
+          { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' },
+          { label: item.title, href: item.href, level: 'item' }
+        ]);
+      }
+
+      document.addEventListener('click', (e) => {
+        const itemTrigger = e.target.closest('[data-item]');
+        if (itemTrigger) {
+          e.preventDefault();
+          showItem(itemTrigger.dataset.item);
+          return;
+        }
+
+        const crumbLink = e.target.closest('#breadcrumb-list a');
+        if (crumbLink) {
+          e.preventDefault();
+          const level = crumbLink.dataset.level;
+          if (level && level !== 'item') {
+            showOverview(level);
+          }
+          return;
+        }
+
+        const backBtn = e.target.closest('#back-to-seasonal');
+        if (backBtn) {
+          e.preventDefault();
+          showOverview('seasonal');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
