+  <script>
+    (function () {
+      const exportElement = document.getElementById('export_element');
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+
+      const messageInput = document.getElementById('card-message-input');
+      const nameInput = document.getElementById('card-name-input');
+      const amountSelect = document.getElementById('card-amount-select');
+      const bgColorInput = document.getElementById('card-bg-color');
+      const swatches = document.querySelectorAll('.color-swatch');
+
+      const messageDisplay = document.getElementById('card-message-display');
+      const nameDisplay = document.getElementById('card-name-display');
+      const badgeDisplay = document.getElementById('card-badge-display');
+
+      const renderBtn = document.getElementById('render-canvas-btn');
+      const exportBtn = document.getElementById('export-btn');
+
+      function parseLuminance(colorStr) {
+        const tempCtx = document.createElement('canvas').getContext('2d');
+        tempCtx.fillStyle = colorStr || '#4e342e';
+        const hex = tempCtx.fillStyle;
+        if (/^#[0-9a-fA-F]{6}$/.test(hex)) {
+          const r = parseInt(hex.slice(1, 3), 16);
+          const g = parseInt(hex.slice(3, 5), 16);
+          const b = parseInt(hex.slice(5, 7), 16);
+          return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
+        }
+        return 0.2;
+      }
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        context.beginPath();
+        context.moveTo(x + radius, y);
+        context.lineTo(x + width - radius, y);
+        context.quadraticCurveTo(x + width, y, x + width, y + radius);
+        context.lineTo(x + width, y + height - radius);
+        context.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
+        context.lineTo(x + radius, y + height);
+        context.quadraticCurveTo(x, y + height, x, y + height - radius);
+        context.lineTo(x, y + radius);
+        context.quadraticCurveTo(x, y, x + radius, y);
+        context.closePath();
+      }
+
+      function wrapCanvasText(context, text, x, y, maxWidth, lineHeight, maxLines) {
+        const words = (text || '').trim().split(/\s+/);
+        let line = '';
+        let lineCount = 0;
+        for (let n = 0; n < words.length; n++) {
+          const testLine = line ? line + ' ' + words[n] : words[n];
+          const metrics = context.measureText(testLine);
+          if (metrics.width > maxWidth && n > 0) {
+            context.fillText(line, x, y);
+            line = words[n];
+            y += lineHeight;
+            lineCount++;
+            if (maxLines && lineCount >= maxLines - 1) {
+              break;
+            }
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          context.fillText(line, x, y);
+          y += lineHeight;
+        }
+        return y;
+      }
+
+      function renderCardToCanvas() {
+        const width = canvas.width;
+        const height = canvas.height;
+        const computedCard = window.getComputedStyle(exportElement);
+        const bgColor = exportElement.style.backgroundColor || computedCard.backgroundColor || bgColorInput.value || '#4e342e';
+        const isLightBg = parseLuminance(bgColor) > 0.65;
+        const primaryTextColor = isLightBg ? '#3e2723' : '#ffffff';
+        const subtleLineColor = isLightBg ? 'rgba(62, 39, 35, 0.2)' : 'rgba(255, 255, 255, 0.2)';
+
+        ctx.clearRect(0, 0, width, height);
+
+        // Card base with rounded corners
+        ctx.save();
+        drawRoundedRect(ctx, 0, 0, width, height, 16);
+        ctx.clip();
+
+        ctx.fillStyle = bgColor;
+        ctx.fillRect(0, 0, width, height);
+
+        // Decorative subtle coffee rings in background
+        ctx.strokeStyle = isLightBg ? 'rgba(78, 52, 46, 0.08)' : 'rgba(255, 171, 64, 0.1)';
+        ctx.lineWidth = 14;
+        ctx.beginPath();
+        ctx.arc(width - 40, height - 30, 75, 0, Math.PI * 2);
+        ctx.stroke();
+
+        ctx.lineWidth = 6;
+        ctx.beginPath();
+        ctx.arc(width - 40, height - 30, 50, 0, Math.PI * 2);
+        ctx.stroke();
+
+        // Card border
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.55)';
+        ctx.lineWidth = 4;
+        drawRoundedRect(ctx, 2, 2, width - 4, height - 4, 14);
+        ctx.stroke();
+
+        // Read current DOM text from #export_element children (or fallback if #export_element text was replaced directly)
+        const brandEl = exportElement.querySelector('.gift-card-brand-text');
+        const badgeEl = exportElement.querySelector('#card-badge-display');
+        const msgEl = exportElement.querySelector('#card-message-display');
+        const nameEl = exportElement.querySelector('#card-name-display');
+        const footerSpans = exportElement.querySelectorAll('.gift-card-footer span');
+
+        const brandText = brandEl ? brandEl.textContent.trim() : 'THE DAILY GRIND';
+        const badgeText = badgeEl ? badgeEl.textContent.trim() : (amountSelect.value || '$25');
+        let messageText = msgEl ? msgEl.textContent.trim() : '';
+        let recipientText = nameEl ? nameEl.textContent.trim() : '';
+
+        if (!msgEl && !nameEl) {
+          messageText = (exportElement.textContent || '').trim() || messageInput.value;
+          recipientText = nameInput.value;
+        }
+
+        // Top Header Bar
+        ctx.fillStyle = primaryTextColor;
+        ctx.font = 'bold 16px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'middle';
+        ctx.fillText('☕ ' + brandText, 26, 38);
+
+        // Amount Pill Badge
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+        const badgePaddingX = 12;
+        const badgeMetrics = ctx.measureText(badgeText);
+        const badgeW = Math.max(54, badgeMetrics.width + badgePaddingX * 2);
+        const badgeH = 28;
+        const badgeX = width - 26 - badgeW;
+        const badgeY = 24;
+
+        ctx.fillStyle = '#ffab40';
+        drawRoundedRect(ctx, badgeX, badgeY, badgeW, badgeH, 14);
+        ctx.fill();
+
+        ctx.fillStyle = '#3e2723';
+        ctx.textAlign = 'center';
+        ctx.fillText(badgeText, badgeX + badgeW / 2, badgeY + badgeH / 2 + 1);
+        ctx.textAlign = 'left';
+
+        // Divider line under top header
+        ctx.strokeStyle = subtleLineColor;
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(26, 62);
+        ctx.lineTo(width - 26, 62);
+        ctx.stroke();
+
+        // Custom Message Body
+        ctx.fillStyle = primaryTextColor;
+        ctx.font = '600 20px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'top';
+        const nextY = wrapCanvasText(
+          ctx,
+          messageText || 'Enjoy a cup on me!',
+          26,
+          84,
+          width - 52,
+          27,
+          3
+        );
+
+        // Recipient Line
+        const recipientY = Math.max(156, Math.min(nextY + 12, 178));
+        ctx.font = '400 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillStyle = primaryTextColor;
+        ctx.fillText('For:', 26, recipientY);
+
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(recipientText || 'Coffee Lover', 60, recipientY);
+
+        // Footer Divider & Text
+        ctx.strokeStyle = subtleLineColor;
+        ctx.beginPath();
+        ctx.moveTo(26, height - 44);
+        ctx.lineTo(width - 26, height - 44);
+        ctx.stroke();
+
+        ctx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillStyle = primaryTextColor;
+        ctx.globalAlpha = 0.82;
+        const leftFooter = footerSpans[0] ? footerSpans[0].textContent.trim() : 'ARTISANAL COFFEE GIFT CARD';
+        const rightFooter = footerSpans[1] ? footerSpans[1].textContent.trim() : 'REDEEMABLE AT ALL LOCATIONS';
+        ctx.fillText(leftFooter, 26, height - 28);
+
+        ctx.textAlign = 'right';
+        ctx.fillText(rightFooter, width - 26, height - 28);
+        ctx.textAlign = 'left';
+        ctx.globalAlpha = 1;
+
+        ctx.restore();
+      }
+
+      function applyBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        const isLight = parseLuminance(color) > 0.65;
+        exportElement.style.color = isLight ? '#3e2723' : '#ffffff';
+        swatches.forEach(function (swatch) {
+          swatch.classList.toggle('active', swatch.getAttribute('data-color').toLowerCase() === color.toLowerCase());
+        });
+        renderCardToCanvas();
+      }
+
+      // Sync form inputs -> #export_element -> <canvas>
+      messageInput.addEventListener('input', function () {
+        if (messageDisplay && messageDisplay.textContent !== messageInput.value) {
+          messageDisplay.textContent = messageInput.value;
+        }
+        renderCardToCanvas();
+      });
+
+      nameInput.addEventListener('input', function () {
+        if (nameDisplay && nameDisplay.textContent !== nameInput.value) {
+          nameDisplay.textContent = nameInput.value;
+        }
+        renderCardToCanvas();
+      });
+
+      amountSelect.addEventListener('change', function () {
+        if (badgeDisplay) {
+          badgeDisplay.textContent = amountSelect.value;
+        }
+        renderCardToCanvas();
+      });
+
+      bgColorInput.addEventListener('input', function () {
+        applyBackgroundColor(bgColorInput.value);
+      });
+
+      bgColorInput.addEventListener('change', function () {
+        applyBackgroundColor(bgColorInput.value);
+      });
+
+      swatches.forEach(function (swatch) {
+        swatch.addEventListener('click', function () {
+          const color = swatch.getAttribute('data-color');
+          bgColorInput.value = color;
+          applyBackgroundColor(color);
+        });
+      });
+
+      // Sync direct typing on #export_element -> form inputs -> <canvas>
+      if (messageDisplay) {
+        messageDisplay.addEventListener('input', function () {
+          messageInput.value = messageDisplay.textContent;
+          renderCardToCanvas();
+        });
+      }
+
+      if (nameDisplay) {
+        nameDisplay.addEventListener('input', function () {
+          nameInput.value = nameDisplay.textContent;
+          renderCardToCanvas();
+        });
+      }
+
+      exportElement.addEventListener('input', function () {
