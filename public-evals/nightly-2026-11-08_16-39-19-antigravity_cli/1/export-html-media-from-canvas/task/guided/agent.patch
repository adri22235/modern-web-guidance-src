+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+
+      const recipientControl = document.getElementById('recipient-control');
+      const messageControl = document.getElementById('message-control');
+      const amountControl = document.getElementById('amount-control');
+      const bgColorPicker = document.getElementById('bg-color-picker');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export-card-btn');
+      const supportNotice = document.getElementById('canvas-support-notice');
+
+      const cardRecipientInput = document.getElementById('card-recipient-input');
+      const cardMessageInput = document.getElementById('card-message-input');
+      const cardAmountDisplay = document.getElementById('card-amount-display');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      function drawFallbackCanvas() {
+        const dpr = window.devicePixelRatio || 1;
+        const width = canvas.width / dpr;
+        const height = canvas.height / dpr;
+        ctx.save();
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+
+        const bgColor = bgColorPicker.value || '#4e342e';
+        ctx.fillStyle = bgColor;
+        ctx.beginPath();
+        if (ctx.roundRect) {
+          ctx.roundRect(0, 0, width, height, 14);
+        } else {
+          ctx.rect(0, 0, width, height);
+        }
+        ctx.fill();
+
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.35)';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Header
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText('☕ THE DAILY GRIND', 24, 42);
+
+        // Amount pill
+        const amountText = amountControl.value;
+        ctx.font = 'bold 20px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        const amountMetrics = ctx.measureText(amountText);
+        const pillW = amountMetrics.width + 24;
+        const pillX = width - 24 - pillW;
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
+        ctx.beginPath();
+        if (ctx.roundRect) {
+          ctx.roundRect(pillX, 20, pillW, 32, 16);
+        } else {
+          ctx.rect(pillX, 20, pillW, 32);
+        }
+        ctx.fill();
+        ctx.fillStyle = '#ffffff';
+        ctx.fillText(amountText, pillX + 12, 43);
+
+        // Message box
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
+        ctx.beginPath();
+        if (ctx.roundRect) {
+          ctx.roundRect(24, 98, width - 48, 44, 6);
+        } else {
+          ctx.rect(24, 98, width - 48, 44);
+        }
+        ctx.fill();
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 18px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        const msg = cardMessageInput.value || 'Have a brew-tiful day!';
+        ctx.fillText(msg, 34, 126, width - 68);
+
+        // Footer
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
+        ctx.font = '11px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText('TO:', 24, height - 44);
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 15px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        const recipient = cardRecipientInput.value || 'Alex Rivera';
+        ctx.fillText(recipient, 24, height - 24);
+
+        ctx.font = '13px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText('GIFT CARD', width - 95, height - 24);
+        ctx.restore();
+      }
+
+      function requestCanvasUpdate() {
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          drawFallbackCanvas();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        // Render the HTML content inside canvas.onpaint using 2D drawElementImage
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(exportElement, 0, 0);
+        };
+      } else {
+        // Fallback strategy when HTML-in-Canvas is not supported in the browser
+        const wrapper = canvas.parentElement;
+        wrapper.style.position = 'relative';
+        wrapper.insertBefore(exportElement, canvas);
+        canvas.style.position = 'absolute';
+        canvas.style.top = '0';
+        canvas.style.left = '50%';
+        canvas.style.transform = 'translateX(-50%)';
+        canvas.style.pointerEvents = 'none';
+        canvas.style.opacity = '0';
+        supportNotice.textContent = 'Using standard canvas fallback (HTML-in-Canvas API not detected in this browser).';
+      }
+
+      // Scale canvas grid to match device pixel ratio with ResizeObserver outside onpaint
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestCanvasUpdate();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      // Sync side controls and in-card HTML elements
+      function updateBackgroundColor(color) {
+        bgColorPicker.value = color;
+        exportElement.style.backgroundColor = color;
+        colorSwatches.forEach((swatch) => {
+          swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCanvasUpdate();
+      }
+
+      recipientControl.addEventListener('input', () => {
+        cardRecipientInput.value = recipientControl.value;
+        requestCanvasUpdate();
+      });
+
+      cardRecipientInput.addEventListener('input', () => {
+        recipientControl.value = cardRecipientInput.value;
+        requestCanvasUpdate();
+      });
+
+      messageControl.addEventListener('input', () => {
+        cardMessageInput.value = messageControl.value;
+        requestCanvasUpdate();
+      });
+
+      cardMessageInput.addEventListener('input', () => {
+        messageControl.value = cardMessageInput.value;
+        requestCanvasUpdate();
+      });
+
+      amountControl.addEventListener('change', () => {
+        cardAmountDisplay.textContent = amountControl.value;
+        requestCanvasUpdate();
+      });
+
+      bgColorPicker.addEventListener('input', () => {
+        updateBackgroundColor(bgColorPicker.value);
+      });
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          updateBackgroundColor(swatch.dataset.color);
+        });
+      });
+
+      // Export canvas design as an image file
+      exportBtn.addEventListener('click', () => {
+        requestCanvasUpdate();
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = dataURL;
+        link.click();
+      });
+    })();
+  </script>
