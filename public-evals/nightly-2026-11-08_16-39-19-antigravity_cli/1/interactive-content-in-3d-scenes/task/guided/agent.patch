+      const aPosition = gl.getAttribLocation(program, 'aPosition');
+      gl.enableVertexAttribArray(aPosition);
+      gl.vertexAttribPointer(aPosition, 3, gl.FLOAT, false, stride, 0);
+
+      const aTexCoord = gl.getAttribLocation(program, 'aTexCoord');
+      gl.enableVertexAttribArray(aTexCoord);
+      gl.vertexAttribPointer(aTexCoord, 2, gl.FLOAT, false, stride, 3 * Float32Array.BYTES_PER_ELEMENT);
+
+      const aColor = gl.getAttribLocation(program, 'aColor');
+      gl.enableVertexAttribArray(aColor);
+      gl.vertexAttribPointer(aColor, 3, gl.FLOAT, false, stride, 5 * Float32Array.BYTES_PER_ELEMENT);
+
+      const uMVP = gl.getUniformLocation(program, 'uMVP');
+      const uUseTexture = gl.getUniformLocation(program, 'uUseTexture');
+
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      const textureState = { width: 0, height: 0 };
+      let hasUploadedTexture = false;
+
+      let isSpinning = true;
+      let angleY = 0;
+      let lastTime = performance.now();
+
+      toggleSpinBtn.addEventListener('click', () => {
+        isSpinning = !isSpinning;
+        toggleSpinBtn.setAttribute('aria-pressed', String(!isSpinning));
+        toggleSpinBtn.textContent = isSpinning ? 'Pause Rotation' : 'Resume Rotation';
+      });
+
+      function createPerspectiveMatrix(fovRad, aspect, near, far) {
+        const f = 1.0 / Math.tan(fovRad / 2);
+        const nf = 1 / (near - far);
+        return new DOMMatrix([
+          f / aspect, 0, 0, 0,
+          0, f, 0, 0,
+          0, 0, (far + near) * nf, -1,
+          0, 0, (2 * far * near) * nf, 0
+        ]);
+      }
+
+      function renderScene() {
+        const now = performance.now();
+        const dt = (now - lastTime) / 1000;
+        lastTime = now;
+
+        if (isSpinning) {
+          // Gently oscillate/rotate so the front face remains accessible while spinning in 3D
+          angleY += dt * 0.6;
+        }
+
+        const rotY = Math.sin(angleY) * 28; // degrees
+        const rotX = Math.cos(angleY * 0.7) * 10; // degrees
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.enable(gl.DEPTH_TEST);
+        gl.clearColor(0.12, 0.07, 0.06, 1.0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+        const aspect = (canvas.clientWidth || 640) / (canvas.clientHeight || 480);
+        const proj = createPerspectiveMatrix((45 * Math.PI) / 180, aspect, 0.1, 100.0);
+
+        const boxModelView = new DOMMatrix()
+          .translate(0, 0, -2.2)
+          .rotate(rotX, rotY, 0)
+          .scale(1.15, 1.35, 0.75);
+
+        const boxMVPMatrix = proj.multiply(boxModelView);
+        const boxMVP = boxMVPMatrix.toFloat32Array();
+
+        // MVP for the front quad (located at z = +0.5 in unit box model space)
+        const frontFaceModelView = boxModelView.translate(0, 0, 0.5);
+        const htmlElementMVP = proj.multiply(frontFaceModelView).toFloat32Array();
+
+        gl.useProgram(program);
+        gl.bindVertexArray(vao);
+        gl.uniformMatrix4fv(uMVP, false, boxMVP);
+
+        // Draw non-front faces of the coffee box with solid colors
+        gl.uniform1i(uUseTexture, 0);
+        gl.drawElements(gl.TRIANGLES, 30, gl.UNSIGNED_SHORT, 6 * Uint16Array.BYTES_PER_ELEMENT);
+
+        // Draw the front face with the captured HTML element texture
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniform1i(uUseTexture, hasUploadedTexture ? 1 : 0);
+        gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+
+        return htmlElementMVP;
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = (event) => {
+          // 1. Update texture with HTML content when changed or not yet uploaded
+          const shouldUpload =
+            !hasUploadedTexture ||
+            !event ||
+            !event.changedElements ||
+            event.changedElements.length > 0;
+
+          if (shouldUpload) {
+            try {
+              if (uploadElementWebGL(gl, canvas, texture, uiElement, textureState)) {
+                hasUploadedTexture = true;
+              }
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+
+          // Render the 3D coffee box scene and compute the front face MVP
+          const htmlElementMVP = renderScene();
+
+          // 2. Sync DOM position, hit testing, and accessibility bounds with 3D scene
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+          });
+        };
+
+        function animate() {
+          canvas.requestPaint();
+          requestAnimationFrame(animate);
+        }
+        requestAnimationFrame(animate);
+      } else {
+        function animateFallback() {
+          renderScene();
+          requestAnimationFrame(animateFallback);
+        }
+        requestAnimationFrame(animateFallback);
+      }
+    })();
+  </script>
 </body>
 
