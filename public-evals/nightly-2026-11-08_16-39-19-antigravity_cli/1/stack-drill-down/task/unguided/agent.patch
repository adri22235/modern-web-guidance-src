+      document.addEventListener('touchmove', function (e) {
+        if (!e.touches || e.touches.length !== 1) return;
+        onGestureMove(e.touches[0].clientX, e.touches[0].clientY, e);
+      }, { passive: false });
+
+      document.addEventListener('touchend', function () {
+        onGestureEnd();
+      });
+
+      document.addEventListener('touchcancel', function () {
+        onGestureEnd();
+      });
+
+      // Mouse / Pointer drag listeners for desktop swipe-back
+      var mouseDownActive = false;
+      document.addEventListener('mousedown', function (e) {
+        if (e.button !== 0 || currentRoute.depth <= 0) return;
+        mouseDownActive = true;
+        onGestureStart(e.clientX, e.clientY, e.target);
+      });
+
+      document.addEventListener('mousemove', function (e) {
+        if (!mouseDownActive) return;
+        onGestureMove(e.clientX, e.clientY, e);
+      });
+
+      document.addEventListener('mouseup', function () {
+        if (!mouseDownActive) return;
+        mouseDownActive = false;
+        onGestureEnd();
+      });
+
+      // Initial Boot & Deep Link Synchronization
+      var initialRoute = parseRouteFromLocation(window.location);
+      currentRoute = initialRoute;
+      applyStackVisualState(currentRoute, true);
+
+      try {
+        window.history.replaceState({
+          depth: currentRoute.depth,
+          itemId: currentRoute.itemId,
+          subView: currentRoute.subView,
+          inAppDepth: 0
+        }, '', window.location.href);
+      } catch (err) {
+        // Ignore replaceState restriction on file://
+      }
+    })();
+  </script>
