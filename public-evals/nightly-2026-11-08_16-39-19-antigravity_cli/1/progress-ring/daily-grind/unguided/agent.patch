+    /* Loyalty Rewards Section */
+    .rewards-section {
+      margin-top: 50px;
+      text-align: center;
+    }
+
+    .rewards-card {
+      background: white;
+      padding: 35px 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      border-top: 4px solid var(--accent);
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      width: 180px;
+      height: 180px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-shrink: 0;
+    }
+
+    .progress-ring {
+      width: 100%;
+      height: 100%;
+      transform: rotate(-90deg);
+    }
+
+    .progress-ring__track {
+      fill: none;
+      stroke: var(--secondary);
+      stroke-width: 14;
+    }
+
+    .progress-ring__bar {
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 14;
+      stroke-linecap: round;
+      stroke-dasharray: 440;
+      stroke-dashoffset: 110;
+      transition: stroke-dashoffset 0.6s ease;
+    }
+
+    .progress-ring__center {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      padding: 15px;
+    }
+
+    .progress-count {
+      font-size: 2rem;
+      font-weight: bold;
+      color: var(--primary);
+      line-height: 1.1;
+    }
+
+    .progress-unit {
+      font-size: 0.85rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      color: var(--text);
+      margin-top: 4px;
+    }
+
+    .progress-subtext {
+      font-size: 0.75rem;
+      color: #6d4c41;
+      margin-top: 2px;
+    }
+
+    .rewards-details {
+      max-width: 460px;
+      text-align: left;
+    }
+
+    .rewards-details h3 {
+      color: var(--primary);
+      font-size: 1.5rem;
+      margin-bottom: 10px;
+    }
+
+    .rewards-details p {
+      margin-bottom: 12px;
+    }
+
+    .rewards-perks {
+      list-style: none;
+      margin: 15px 0;
+    }
+
+    .rewards-perks li {
+      margin-bottom: 6px;
+      font-size: 0.95rem;
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .rewards-perks li::before {
+      content: "☕";
+      color: var(--accent);
+    }
+
+    @media (max-width: 650px) {
+      .rewards-details {
+        text-align: center;
+      }
+
+      .rewards-perks li {
+        justify-content: center;
+      }
+    }
+
