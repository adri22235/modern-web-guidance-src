+  <script>
+    const progress = document.getElementById("loyalty-progress");
+    const cupsCount = document.getElementById("loyalty-cups-count");
+    const cupsLabel = document.getElementById("loyalty-cups-label");
+    const statusMessage = document.getElementById("loyalty-status-message");
+    const addStampBtn = document.getElementById("add-stamp-btn");
+
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value"));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+    }
+
+    addStampBtn.addEventListener("click", () => {
+      const currentPercent = Number(progress.getAttribute("value")) || 0;
+      const nextPercent = currentPercent >= 100 ? 10 : Math.min(100, currentPercent + 10);
+      const stamps = Math.round(nextPercent / 10);
+      const remaining = 10 - stamps;
+
+      progress.setAttribute("value", String(nextPercent));
+      progress.value = nextPercent;
+      cupsCount.textContent = `${stamps} / 10`;
+
+      if (remaining === 0) {
+        cupsLabel.textContent = "100% \u2022 Free drink!";
+        statusMessage.textContent = "Congratulations! You've collected all 10 stamps (100%) and unlocked a free handcrafted drink on your next order.";
+        addStampBtn.textContent = "Start Next Card (1 / 10)";
+      } else {
+        cupsLabel.textContent = `${nextPercent}% \u2022 ${remaining} to go`;
+        statusMessage.textContent = `You have earned ${stamps} of 10 stamps (${nextPercent}%). Order just ${remaining} more handcrafted ${remaining === 1 ? "drink" : "drinks"} to unlock your next complimentary beverage of any size.`;
+        addStampBtn.textContent = "Log a Drink (+1 Stamp)";
+      }
+    });
+  </script>
