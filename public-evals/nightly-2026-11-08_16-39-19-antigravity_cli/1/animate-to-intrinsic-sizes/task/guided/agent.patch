+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const promoAlert = document.getElementById('promo-alert');
+    const dismissAlert = () => {
+      promoAlert.classList.add('is-dismissed');
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        promoAlert.hidden = true;
+      }
+    };
+
+    promoAlert?.addEventListener('command', (event) => {
+      if (event.command === '--dismiss') {
+        dismissAlert();
+      }
+    });
+
+    promoAlert?.addEventListener('transitionend', (event) => {
+      if (event.propertyName === 'block-size' && promoAlert.classList.contains('is-dismissed')) {
+        promoAlert.hidden = true;
+      }
+    });
+  </script>
