+  <script>
+    document.querySelectorAll('[data-loading-action]').forEach((actionEl) => {
+      actionEl.addEventListener('click', (event) => {
+        if (actionEl.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        // Allow modifier clicks (new tab/window) to proceed normally
+        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
+          return;
+        }
+
+        event.preventDefault();
+        actionEl.setAttribute('aria-disabled', 'true');
+        actionEl.setAttribute('aria-busy', 'true');
+
+        const cardOrSection = actionEl.closest('.card') || actionEl.closest('header');
+        if (cardOrSection) {
+          cardOrSection.setAttribute('aria-busy', 'true');
+        }
+
+        const spinner = actionEl.querySelector('progress.loading-spinner');
+        if (spinner) {
+          spinner.hidden = false;
+        }
+
+        const targetHref = actionEl.getAttribute('href');
+        if (targetHref) {
+          setTimeout(() => {
+            window.location.href = targetHref;
+          }, 600);
+        }
+      });
+    });
+  </script>
