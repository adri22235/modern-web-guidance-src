+  <script>
+    (function () {
+      const orderBtn = document.getElementById('order-now-btn');
+      const heroSection = document.querySelector('.hero');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalStatus = document.getElementById('seasonal-loading-status');
+      const globalAnnouncer = document.getElementById('global-loading-announcer');
+      const detailButtons = document.querySelectorAll('.detail-btn');
+
+      function setButtonLoading(btn, statusMessage) {
+        if (!btn) return;
+        btn.classList.add('is-loading', 'loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('data-loading', 'true');
+
+        const statusEl = btn.querySelector('.status-text');
+        if (statusEl) {
+          statusEl.textContent = statusMessage;
+        }
+        if (globalAnnouncer) {
+          globalAnnouncer.textContent = statusMessage;
+        }
+      }
+
+      function handleOrderStart(event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (orderBtn.getAttribute('aria-busy') === 'true') {
+          return;
+        }
+        if (heroSection) {
+          heroSection.setAttribute('aria-busy', 'true');
+        }
+        setButtonLoading(orderBtn, 'Loading: Starting your order, please wait...');
+      }
+
+      function handleLoadDrinkDetails(btn, event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (!btn || btn.getAttribute('aria-busy') === 'true') {
+          return;
+        }
+        const card = btn.closest('.card');
+        const drinkTitle = card && card.querySelector('h3')
+          ? card.querySelector('h3').textContent.trim()
+          : 'drink';
+        const message = 'Loading details for ' + drinkTitle + ', please wait...';
+
+        if (card) {
+          card.classList.add('is-loading', 'loading');
+          card.setAttribute('aria-busy', 'true');
+        }
+        if (seasonalSection) {
+          seasonalSection.classList.add('is-loading', 'loading');
+          seasonalSection.setAttribute('aria-busy', 'true');
+        }
+        if (seasonalStatus) {
+          seasonalStatus.textContent = message;
+        }
+        setButtonLoading(btn, message);
+      }
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', handleOrderStart);
+        orderBtn.addEventListener('keydown', function (event) {
+          if (event.key === ' ' || event.key === 'Spacebar') {
+            handleOrderStart(event);
+          }
+        });
+      }
+
+      detailButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          handleLoadDrinkDetails(btn, event);
+        });
+        btn.addEventListener('keydown', function (event) {
+          if (event.key === ' ' || event.key === 'Spacebar') {
+            handleLoadDrinkDetails(btn, event);
+          }
+        });
+      });
+
+      window.startOrder = handleOrderStart;
+      window.loadDrinkDetails = handleLoadDrinkDetails;
+    })();
+  </script>
+
