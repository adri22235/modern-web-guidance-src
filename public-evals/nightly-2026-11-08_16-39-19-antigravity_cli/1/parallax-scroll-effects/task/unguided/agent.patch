+  <script>
+    (function () {
+      const section = document.getElementById('craft-parallax');
+      if (!section) return;
+
+      const toggleBtn = document.getElementById('parallax-motion-toggle');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const parallaxItems = Array.from(section.querySelectorAll('[data-parallax-speed]')).map((el) => ({
+        el,
+        speed: parseFloat(el.getAttribute('data-parallax-speed')) || 0,
+        isCardImage: el.tagName === 'IMG'
+      }));
+
+      let isPausedByUser = false;
+      let isInViewport = true;
+      let rafId = null;
+
+      function shouldReduceMotion() {
+        return reducedMotionQuery.matches || isPausedByUser;
+      }
+
+      function resetTransforms() {
+        for (let i = 0; i < parallaxItems.length; i++) {
+          parallaxItems[i].el.style.transform = '';
+        }
+      }
+
+      function updateParallax() {
+        rafId = null;
+        if (shouldReduceMotion() || !isInViewport) {
+          return;
+        }
+
+        const rect = section.getBoundingClientRect();
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        // Distance from the center of the viewport to the center of the section
+        const sectionCenter = rect.top + rect.height * 0.5;
+        const viewportCenter = viewportHeight * 0.5;
+        const deltaFromCenter = viewportCenter - sectionCenter;
+
+        for (let i = 0; i < parallaxItems.length; i++) {
+          const item = parallaxItems[i];
+          const rawOffset = deltaFromCenter * item.speed;
+          const clampedOffset = Math.max(-120, Math.min(120, rawOffset));
+          if (item.isCardImage) {
+            item.el.style.transform = 'translate3d(0, calc(-10% + ' + clampedOffset.toFixed(2) + 'px), 0)';
+          } else {
+            item.el.style.transform = 'translate3d(0, ' + clampedOffset.toFixed(2) + 'px, 0)';
+          }
+        }
+      }
+
+      function requestTick() {
+        if (rafId === null && !shouldReduceMotion() && isInViewport) {
+          rafId = window.requestAnimationFrame(updateParallax);
+        }
+      }
+
+      function syncMotionState() {
+        const disabled = shouldReduceMotion();
+        section.classList.toggle('is-motion-paused', disabled);
+
+        if (toggleBtn) {
+          toggleBtn.setAttribute('aria-pressed', String(disabled));
+          toggleBtn.textContent = disabled ? 'Enable Parallax Motion' : 'Pause Parallax Motion';
+        }
+
+        if (disabled) {
+          if (rafId !== null) {
+            window.cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+          resetTransforms();
+        } else {
+          requestTick();
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            for (let i = 0; i < entries.length; i++) {
+              isInViewport = entries[i].isIntersecting;
+            }
+            if (isInViewport) {
+              requestTick();
+            }
+          },
+          { rootMargin: '150px 0px' }
+        );
+        observer.observe(section);
+      }
+
+      window.addEventListener('scroll', requestTick, { passive: true });
+      window.addEventListener('resize', requestTick, { passive: true });
+
+      if (typeof reducedMotionQuery.addEventListener === 'function') {
+        reducedMotionQuery.addEventListener('change', syncMotionState);
+      }
+
+      if (toggleBtn) {
+        toggleBtn.addEventListener('click', function () {
+          isPausedByUser = !isPausedByUser;
+          syncMotionState();
+        });
+      }
+
+      syncMotionState();
+    })();
+  </script>
+
 </body>
 
