     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+    <p style="font-size: 0.8rem; margin-top: 8px; opacity: 0.75;">
+      Time spent viewing page: <span id="foreground-time-display">0s</span>
+    </p>
   </footer>
 
+  <script>
+    (function () {
+      let accumulatedForegroundTime = 0;
+      let lastVisibleTimestamp =
+        document.visibilityState === 'hidden' || document.hidden ? null : Date.now();
+
+      function pauseForegroundTracking() {
+        if (lastVisibleTimestamp !== null) {
+          accumulatedForegroundTime += Math.max(0, Date.now() - lastVisibleTimestamp);
+          lastVisibleTimestamp = null;
+        }
+      }
+
+      function resumeForegroundTracking() {
+        if (
+          lastVisibleTimestamp === null &&
+          document.visibilityState !== 'hidden' &&
+          !document.hidden
+        ) {
+          lastVisibleTimestamp = Date.now();
+        }
+      }
+
+      /**
+       * Calculates and returns the total time (in milliseconds) the page
+       * has been actively viewed in the foreground.
+       * @returns {number} Total foreground time in milliseconds.
+       */
+      function calculateTotalForegroundTime() {
+        let total = accumulatedForegroundTime;
+        if (
+          lastVisibleTimestamp !== null &&
+          document.visibilityState !== 'hidden' &&
+          !document.hidden
+        ) {
+          total += Math.max(0, Date.now() - lastVisibleTimestamp);
+        }
+        return total;
+      }
+
+      function formatForegroundTime(ms) {
+        const totalSeconds = Math.floor(ms / 1000);
+        const hours = Math.floor(totalSeconds / 3600);
+        const minutes = Math.floor((totalSeconds % 3600) / 60);
+        const seconds = totalSeconds % 60;
+
+        if (hours > 0) {
+          return `${hours}h ${minutes}m ${seconds}s`;
+        }
+        if (minutes > 0) {
+          return `${minutes}m ${seconds}s`;
+        }
+        return `${seconds}s`;
+      }
+
+      function updateForegroundDisplay() {
+        const displayEl = document.getElementById('foreground-time-display');
+        if (displayEl) {
+          displayEl.textContent = formatForegroundTime(calculateTotalForegroundTime());
+        }
+      }
+
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'hidden' || document.hidden) {
+          pauseForegroundTracking();
+        } else {
+          resumeForegroundTracking();
+        }
+        updateForegroundDisplay();
+      });
+
+      window.addEventListener('blur', function () {
+        pauseForegroundTracking();
+        updateForegroundDisplay();
+      });
+
+      window.addEventListener('focus', function () {
+        resumeForegroundTracking();
+        updateForegroundDisplay();
+      });
+
+      window.addEventListener('pagehide', function () {
+        pauseForegroundTracking();
+      });
+
+      window.addEventListener('pageshow', function () {
+        resumeForegroundTracking();
+      });
+
+      setInterval(function () {
+        if (lastVisibleTimestamp !== null) {
+          updateForegroundDisplay();
+        }
+      }, 1000);
+
+      // Expose functions globally
+      window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+      window.getTotalForegroundTime = calculateTotalForegroundTime;
+      window.getForegroundTime = calculateTotalForegroundTime;
+      window.formatForegroundTime = formatForegroundTime;
+    })();
+  </script>
 </body>
 
 </html>
