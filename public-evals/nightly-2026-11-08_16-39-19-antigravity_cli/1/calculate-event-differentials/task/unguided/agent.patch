+  <script>
+    function updateMapleOatCountdown() {
+      const remainingEl = document.getElementById('offer-remaining');
+      const elapsedEl = document.getElementById('offer-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promotionStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const offerEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const remainingDuration = now.until(offerEnd, { largestUnit: 'days' });
+      const elapsedDuration = now.since(promotionStart, { largestUnit: 'days' });
+
+      const remainingDays = Math.max(0, remainingDuration.days);
+      const remainingHours = Math.max(0, remainingDuration.hours);
+      remainingEl.textContent = `Offer ends in: ${remainingDays} days, ${remainingHours} hours`;
+
+      const elapsedDays = Math.max(0, elapsedDuration.days);
+      const elapsedHours = Math.max(0, elapsedDuration.hours);
+      elapsedEl.textContent = `Elapsed since promotion start: ${elapsedDays} days, ${elapsedHours} hours`;
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatCountdown);
+    window.addEventListener('load', updateMapleOatCountdown);
+  </script>
+
