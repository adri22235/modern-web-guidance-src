+  <script>
+    function initializeCountdown() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      const statusEl = document.getElementById('maple-oat-status');
+      if (!remainingEl || !elapsedEl) return;
+
+      // Get the current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // Combine separate date and time strings via Temporal methods in the user's local time zone
+      const startDateStr = '2026-02-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr)
+        .toPlainDateTime(startTimeStr)
+        .toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr)
+        .toPlainDateTime(endTimeStr)
+        .toZonedDateTime(tz);
+
+      // Calculate elapsed time since start and remaining time until end balanced into days and hours
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      const isExpired = timeRemaining.sign < 0;
+      const isPending = timeActive.sign < 0;
+
+      // Format durations for human display using .toLocaleString() (Intl.DurationFormat)
+      // and set machine-readable ISO 8601 duration strings via .toString()
+      if ( isExpired ) {
+        const zeroDuration = Temporal.Duration.from({ days: 0, hours: 0 });
+        const endedAgo = timeRemaining.abs();
+        remainingEl.textContent = `${zeroDuration.toLocaleString('en-US', { style: 'long', hoursDisplay: 'always' })} (Ended ${endedAgo.toLocaleString('en-US', { style: 'long' })} ago)`;
+        remainingEl.setAttribute('datetime', zeroDuration.toString());
+      } else {
+        remainingEl.textContent = timeRemaining.toLocaleString('en-US', { style: 'long' });
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+      }
+
+      if ( isPending ) {
+        const startsIn = timeActive.abs();
+        elapsedEl.textContent = `Starts in ${startsIn.toLocaleString('en-US', { style: 'long' })}`;
+        elapsedEl.setAttribute('datetime', startsIn.toString());
+      } else {
+        elapsedEl.textContent = timeActive.toLocaleString('en-US', { style: 'long' });
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+      }
+
+      if ( statusEl ) {
+        statusEl.hidden = false;
+        if ( isExpired ) {
+          statusEl.textContent = 'Offer ended March 1, 2026';
+        } else if ( isPending ) {
+          statusEl.textContent = 'Upcoming seasonal offer';
+        } else {
+          const isPastHalfway = Temporal.Duration.compare(timeActive, timeRemaining, { relativeTo: now }) > 0;
+          statusEl.textContent = isPastHalfway ? 'Hurry — over halfway through!' : 'Limited-time offer until March 1, 2026';
+        }
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeCountdown();
+    })();
+  </script>
+
