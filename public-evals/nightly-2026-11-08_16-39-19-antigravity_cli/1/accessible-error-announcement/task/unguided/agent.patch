+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+
+      if (!form || !emailInput || !errorEl) return;
+
+      let hasInteracted = false;
+
+      function isUserInvalid(input) {
+        try {
+          return input.matches(':user-invalid');
+        } catch (_) {
+          return false;
+        }
+      }
+
+      function getErrorMessage(input) {
+        if (input.validity.valueMissing) {
+          return 'Email address is required. Please enter a valid email address.';
+        }
+        return 'Please enter a valid email address.';
+      }
+
+      function clearErrorState() {
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+        errorEl.classList.remove('is-visible');
+      }
+
+      function showErrorState() {
+        const message = getErrorMessage(emailInput);
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorEl.hidden = false;
+        errorEl.classList.add('is-visible');
+        if (errorEl.textContent !== message) {
+          errorEl.textContent = message;
+        }
+      }
+
+      function syncValidationState() {
+        if (isUserInvalid(emailInput)) {
+          hasInteracted = true;
+        }
+
+        if (emailInput.validity.valid) {
+          clearErrorState();
+        } else if (hasInteracted) {
+          showErrorState();
+        } else {
+          clearErrorState();
+        }
+      }
+
+      // Initialize pre-interaction state so assistive technologies do not announce an error early
+      clearErrorState();
+
+      emailInput.addEventListener('input', function () {
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('keyup', function () {
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (!emailInput.checkValidity()) {
+          hasInteracted = true;
+          syncValidationState();
+          emailInput.focus();
+        } else {
+          hasInteracted = false;
+          clearErrorState();
+        }
+      });
+
+      form.addEventListener('reset', function () {
+        hasInteracted = false;
+        setTimeout(clearErrorState, 0);
+      });
+    })();
+  </script>
+
 </body>
 
