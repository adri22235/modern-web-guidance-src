+      padding: 12px;
+      min-height: 144px;
+      flex-shrink: 0;
+    }
+
+    .media-card.target {
+      border: 2px solid var(--accent);
+      background: #fff8e1;
+      scroll-start-target: auto;
+      scroll-start-target: nearest;
+    }
+
+    .media-card img {
+      width: 160px;
+      height: 120px;
