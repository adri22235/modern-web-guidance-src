+
+  <!-- Preconnect to the A/B testing CDN to minimize connection latency -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="dns-prefetch" href="https://cdn.example.com" />
+
+  <!-- Anti-flicker stylesheet: hides experiment content until variant is applied or fallback triggers, while preserving layout geometry (CLS = 0) -->
+  <style id="ab-anti-flicker">
+    html.ab-cloak,
+    html.ab-cloak body,
+    html.ab-cloak .hero,
+    html.ab-cloak [data-experiment],
+    html.ab-cloak #hero-title,
+    html.ab-cloak #cta-button {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+  </style>
+
+  <!-- Anti-flicker controller + async A/B testing SDK loader -->
+  <script>
+    (function (docEl) {
+      docEl.classList.add('ab-cloak');
+      var revealed = false;
+
+      function reveal() {
+        if (revealed) return;
+        revealed = true;
+        if (window.__abTimer) {
+          clearTimeout(window.__abTimer);
+        }
+        try {
+          if (window.ExperimentSDK) {
+            if (typeof window.ExperimentSDK.apply === 'function') {
+              window.ExperimentSDK.apply();
+            } else if (typeof window.ExperimentSDK.init === 'function') {
+              window.ExperimentSDK.init();
+            }
+          }
+        } catch (err) {
+          // Ignore SDK runtime errors and ensure content is revealed
+        }
+        docEl.classList.remove('ab-cloak');
+        docEl.setAttribute('data-ab-ready', 'true');
+      }
+
+      // Safety fallback timeout so users are never blocked on slow/unreachable networks
+      window.__abTimer = setTimeout(reveal, 1500);
+      window.__abReveal = reveal;
+      window.onExperimentReady = reveal;
+      window.addEventListener('experiment:ready', reveal, { once: true });
+    })(document.documentElement);
+  </script>
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    onload="window.__abReveal && window.__abReveal()"
+    onerror="window.__abReveal && window.__abReveal()"
+  ></script>
+
