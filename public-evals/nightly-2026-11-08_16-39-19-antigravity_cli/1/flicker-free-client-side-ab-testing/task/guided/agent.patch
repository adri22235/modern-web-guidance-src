diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,320 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow — Ship Faster with Real-Time Analytics</title>
+
+  <link rel="preconnect" href="https://cdn.example.com">
+
+  <!--
+    Load the A/B testing script in <head> with both `async` and `blocking="render"`.
+    - `async`: Prevents parser-blocking so the browser continues building the DOM in parallel.
+    - `blocking="render"`: Holds first paint until the script has fetched and executed,
+      preventing the original content from flashing before the variant is applied.
+  -->
+  <script
+    id="experiment-sdk"
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Feature-detected anti-flicker fallback for browsers that do not support `blocking="render"`.
+    function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    }
+
+    window.onExperimentReady = onExperimentReady;
+
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      const sdkScript = document.getElementById('experiment-sdk');
+      if (sdkScript) {
+        sdkScript.addEventListener('load', onExperimentReady, { once: true });
+        sdkScript.addEventListener('error', onExperimentReady, { once: true });
+      }
+
+      // Timeout safeguard so the page never remains permanently hidden on slow networks.
+      setTimeout(onExperimentReady, 4000);
+    }
+  </script>
+
+  <style>
+    @layer base, theme, components, utilities;
+
+    @layer theme {
+      :root {
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+        --color-bg: #0f172a;
+        --color-surface: #1e293b;
+        --color-surface-border: #334155;
+        --color-text: #f8fafc;
+        --color-text-muted: #94a3b8;
+        --color-accent: #4f46e5;
+        --color-accent-hover: #4338ca;
+        --color-accent-contrast: #ffffff;
+        --color-badge-bg: rgba(79, 70, 229, 0.18);
+        --color-badge-text: #a5b4fc;
+        --radius-md: 0.5rem;
+        --radius-lg: 0.875rem;
+        --radius-pill: 9999px;
+        --space-xs: 0.5rem;
+        --space-sm: 0.75rem;
+        --space-md: 1.25rem;
+        --space-lg: 2rem;
+        --space-xl: 4rem;
+      }
+
+      /* Variant B overrides keyed to a root/body data attribute set by the experiment SDK */
+      :root[data-variant="b"],
+      body[data-variant="b"] {
+        --color-accent: #059669;
+        --color-accent-hover: #047857;
+        --color-badge-bg: rgba(5, 150, 105, 0.2);
+        --color-badge-text: #6ee7b7;
+      }
+    }
+
+    @layer base {
+      body {
+        margin: 0;
+        font-family: var(--font-sans);
+        background-color: var(--color-bg);
+        color: var(--color-text);
+        line-height: 1.6;
+        min-block-size: 100dvh;
+        display: flex;
+        flex-direction: column;
+      }
+
+      h1, h2, h3, p {
+        margin-block: 0;
+      }
+
+      a {
+        color: inherit;
+        text-decoration: none;
+      }
+    }
+
+    @layer components {
+      .site-header {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        max-inline-size: 72rem;
+        inline-size: 100%;
+        margin-inline: auto;
+        padding-block: var(--space-md);
+        padding-inline: var(--space-lg);
+        box-sizing: border-box;
+      }
+
+      .brand {
+        font-weight: 700;
+        font-size: 1.25rem;
+        letter-spacing: -0.02em;
+      }
+
+      .nav-list {
+        display: flex;
+        gap: var(--space-lg);
+        list-style: none;
+        margin: 0;
+        padding: 0;
+        color: var(--color-text-muted);
+      }
+
+      .nav-list a:hover {
+        color: var(--color-text);
+      }
+
+      .hero {
+        flex: 1;
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+        align-items: center;
+        gap: var(--space-xl);
+        max-inline-size: 72rem;
+        inline-size: 100%;
+        margin-inline: auto;
+        padding-block: var(--space-xl);
+        padding-inline: var(--space-lg);
+        box-sizing: border-box;
+      }
+
+      .hero-content {
+        display: flex;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: var(--space-md);
+      }
+
+      .hero-badge {
+        display: inline-block;
+        padding-block: 0.25rem;
+        padding-inline: var(--space-sm);
+        border-radius: var(--radius-pill);
+        background-color: var(--color-badge-bg);
+        color: var(--color-badge-text);
+        font-size: 0.875rem;
+        font-weight: 600;
+      }
+
+      .hero-title {
+        font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
+        line-height: 1.12;
+        letter-spacing: -0.03em;
+        font-weight: 800;
+      }
+
+      .hero-subtitle {
+        font-size: 1.125rem;
+        color: var(--color-text-muted);
+        max-inline-size: 38rem;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: var(--space-md);
+        margin-block-start: var(--space-xs);
+      }
+
+      .cta-button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: var(--space-xs);
+        padding-block: 0.875rem;
+        padding-inline: 1.75rem;
+        border: none;
+        border-radius: var(--radius-md);
+        background-color: var(--color-accent);
+        color: var(--color-accent-contrast);
+        font-family: inherit;
+        font-size: 1rem;
+        font-weight: 600;
+        cursor: pointer;
+        transition: background-color 0.2s ease, transform 0.15s ease;
+      }
+
+      .cta-button:hover:not(:disabled) {
+        background-color: var(--color-accent-hover);
+        transform: translateY(-1px);
+      }
+
+      .cta-button:focus-visible {
+        outline: 2px solid var(--color-text);
+        outline-offset: 3px;
+      }
+
+      .cta-secondary {
+        font-weight: 600;
+        color: var(--color-text-muted);
+        padding-block: 0.875rem;
+        padding-inline: 1rem;
+      }
+
+      .cta-secondary:hover {
+        color: var(--color-text);
+      }
+
+      .hero-visual {
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-surface-border);
+        border-radius: var(--radius-lg);
+        overflow: hidden;
+        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
+      }
+
+      .hero-image {
+        display: block;
+        inline-size: 100%;
+        block-size: auto;
+        aspect-ratio: 16 / 10;
+        object-fit: cover;
+      }
+
+      .site-footer {
+        max-inline-size: 72rem;
+        inline-size: 100%;
+        margin-inline: auto;
+        padding-block: var(--space-lg);
+        padding-inline: var(--space-lg);
+        color: var(--color-text-muted);
+        font-size: 0.875rem;
+        box-sizing: border-box;
+      }
+    }
+
+    @layer utilities {
+      /*
+        Used only when `blocking="render"` is unsupported by the browser
+        to prevent original content from flashing before the experiment runs.
+      */
+      .ab-loading {
+        opacity: 0 !important;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a href="/" class="brand">PulseFlow</a>
+    <nav aria-label="Primary">
+      <ul class="nav-list">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#docs">Documentation</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-heading" data-experiment-container="hero">
+      <div class="hero-content">
+        <span class="hero-badge" id="hero-badge" data-experiment-target="badge">
+          New: Instant Experimentation Engine
+        </span>
+        <h1 class="hero-title" id="hero-heading" data-experiment-target="headline">
+          Turn product insights into growth without the guesswork
+        </h1>
+        <p class="hero-subtitle" id="hero-subtitle" data-experiment-target="subheadline">
+          Measure every release in real time, validate hypotheses with zero-flicker experiments, and ship the experiences your users love.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            class="cta-button"
+            id="hero-cta"
+            data-experiment-target="cta"
+          >
+            Start Free Trial
+          </button>
+          <a href="#demo" class="cta-secondary">View Live Demo</a>
+        </div>
+      </div>
+
+      <div class="hero-visual">
+        <img
+          class="hero-image"
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          alt="Analytics dashboard displaying conversion funnels and live experiment metrics"
+          width="1200"
+          height="750"
+          fetchpriority="high"
+        >
+      </div>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <p>&copy; 2026 PulseFlow Inc. All rights reserved.</p>
+  </footer>
+</body>
+</html>
