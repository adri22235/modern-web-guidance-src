+  <script>
+    document.querySelectorAll('.hovercard-trigger-wrapper').forEach((wrapper) => {
+      let hideTimeout;
+
+      const showCard = () => {
+        clearTimeout(hideTimeout);
+        wrapper.classList.add('active');
+      };
+
+      const hideCard = () => {
+        hideTimeout = setTimeout(() => {
+          wrapper.classList.remove('active');
+        }, 120);
+      };
+
+      wrapper.addEventListener('mouseenter', showCard);
+      wrapper.addEventListener('mouseleave', hideCard);
+      wrapper.addEventListener('focusin', showCard);
+      wrapper.addEventListener('focusout', (e) => {
+        if (!wrapper.contains(e.relatedTarget)) {
+          hideCard();
+        }
+      });
+
+      const priceEl = wrapper.querySelector('[data-price]');
+      const caloriesEl = wrapper.querySelector('[data-calories]');
+      const caffeineEl = wrapper.querySelector('[data-caffeine]');
+      const ctaEl = wrapper.querySelector('[data-cta-base]');
+      const sizeBtns = wrapper.querySelectorAll('.size-btn');
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          sizeBtns.forEach((b) => b.classList.remove('selected'));
+          btn.classList.add('selected');
+
+          if (priceEl && btn.dataset.price) priceEl.textContent = btn.dataset.price;
+          if (caloriesEl && btn.dataset.calories) caloriesEl.textContent = btn.dataset.calories;
+          if (caffeineEl && btn.dataset.caffeine) caffeineEl.textContent = btn.dataset.caffeine;
+          if (ctaEl && btn.dataset.size) {
+            ctaEl.setAttribute('href', `${ctaEl.dataset.ctaBase}?size=${encodeURIComponent(btn.dataset.size)}`);
+          }
+        });
+      });
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') {
+        document.querySelectorAll('.hovercard-trigger-wrapper.active').forEach((w) => {
+          w.classList.remove('active');
+        });
+      }
+    });
+  </script>
+
 </body>
 
 </html>
