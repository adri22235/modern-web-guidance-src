+    /* Hovercard Component */
+    .card {
+      position: relative;
+    }
+
+    .hovercard-trigger-wrapper {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .hovercard-trigger-wrapper .btn {
+      margin-top: 0;
+    }
+
+    .hovercard {
+      position: absolute;
+      bottom: calc(100% + 14px);
+      left: 50%;
+      transform: translateX(-50%) translateY(8px);
+      width: 320px;
+      background: #ffffff;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      box-shadow: 0 14px 32px rgba(62, 39, 35, 0.22), 0 4px 10px rgba(0, 0, 0, 0.08);
+      text-align: left;
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
+      z-index: 900;
+      overflow: hidden;
+    }
+
+    /* Bridge the hover gap between button and card */
+    .hovercard::after {
+      content: "";
+      position: absolute;
+      left: 0;
+      right: 0;
+      bottom: -16px;
+      height: 16px;
+    }
+
+    .hovercard-arrow {
+      position: absolute;
+      bottom: -7px;
+      left: 50%;
+      transform: translateX(-50%) rotate(45deg);
+      width: 14px;
