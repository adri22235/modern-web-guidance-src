+      background: #ffffff;
+      border-right: 1px solid var(--secondary);
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .hovercard-trigger-wrapper:hover .hovercard,
+    .hovercard-trigger-wrapper:focus-within .hovercard,
+    .hovercard-trigger-wrapper.active .hovercard {
