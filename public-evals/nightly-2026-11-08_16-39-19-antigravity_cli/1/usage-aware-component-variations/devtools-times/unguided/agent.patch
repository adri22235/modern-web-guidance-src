+++ b/src/components/semantic/SemanticContext.tsx
@@ -0,0 +1,192 @@
+import React, { createContext, useContext, useEffect, useState } from 'react';
+import {
+  type ContentMetadataInput,
+  type SemanticDensity,
+  type SemanticDomain,
+  type SemanticProfile,
+  type SemanticRole,
+  type SemanticTone,
+  resolveSemanticContext,
+} from '../../utils/semanticContext';
+
+export interface SemanticContextState {
+  domainOverride: 'auto' | SemanticDomain;
+  toneOverride?: SemanticTone;
+  roleOverride?: SemanticRole;
+  density: SemanticDensity;
+  inspectMode: boolean;
+  setDomainOverride: (domain: 'auto' | SemanticDomain) => void;
+  setDensity: (density: SemanticDensity) => void;
+  setInspectMode: (inspect: boolean) => void;
+  resolveForContent: (
+    content: ContentMetadataInput,
+    localOptions?: {
+      role?: SemanticRole;
+      domain?: SemanticDomain;
+      tone?: SemanticTone;
+    }
+  ) => SemanticProfile;
+}
+
+const CUSTOM_EVENT_NAME = 'devtools-times:semantic-change';
+
+const defaultState: SemanticContextState = {
+  domainOverride: 'auto',
+  density: 'standard',
+  inspectMode: false,
+  setDomainOverride: () => {},
+  setDensity: () => {},
+  setInspectMode: () => {},
+  resolveForContent: (content, localOptions) =>
+    resolveSemanticContext(content, {
+      role: localOptions?.role,
+      domainOverride: localOptions?.domain,
+      toneOverride: localOptions?.tone,
+    }),
+};
+
+const SemanticReactContext = createContext<SemanticContextState>(defaultState);
+
+function syncDocumentAttributes(
+  domainOverride: 'auto' | SemanticDomain,
+  density: SemanticDensity,
+  inspectMode: boolean
+) {
+  if (typeof document === 'undefined') return;
+  const root = document.documentElement;
+  root.setAttribute('data-semantic-override', domainOverride);
+  root.setAttribute('data-semantic-density', density);
+  root.setAttribute('data-semantic-inspect', inspectMode ? 'true' : 'false');
+}
+
+export const SemanticContextProvider: React.FC<{
+  children: React.ReactNode;
+  initialDomain?: 'auto' | SemanticDomain;
+  initialTone?: SemanticTone;
+  initialRole?: SemanticRole;
+  initialDensity?: SemanticDensity;
+}> = ({
+  children,
+  initialDomain = 'auto',
+  initialTone,
+  initialRole,
+  initialDensity = 'standard',
+}) => {
+  const [domainOverride, setDomainState] = useState<'auto' | SemanticDomain>(initialDomain);
+  const [density, setDensityState] = useState<SemanticDensity>(initialDensity);
+  const [inspectMode, setInspectState] = useState<boolean>(false);
+
+  useEffect(() => {
+    if (typeof window === 'undefined') return;
+    // Read initial state from documentElement if already set by another island
+    const root = document.documentElement;
+    const existingDomain = root.getAttribute('data-semantic-override') as
+      | 'auto'
+      | SemanticDomain
+      | null;
+    const existingDensity = root.getAttribute('data-semantic-density') as SemanticDensity | null;
+    const existingInspect = root.getAttribute('data-semantic-inspect');
+
+    if (existingDomain && initialDomain === 'auto') {
+      setDomainState(existingDomain);
+    }
+    if (existingDensity) {
+      setDensityState(existingDensity);
+    }
+    if (existingInspect === 'true') {
+      setInspectState(true);
+    }
+
+    const handleExternalChange = (event: Event) => {
+      const customEvent = event as CustomEvent<{
+        domainOverride: 'auto' | SemanticDomain;
+        density: SemanticDensity;
+        inspectMode: boolean;
+      }>;
+      if (customEvent.detail) {
+        if (initialDomain === 'auto') {
+          setDomainState(customEvent.detail.domainOverride);
+        }
+        setDensityState(customEvent.detail.density);
+        setInspectState(customEvent.detail.inspectMode);
+      }
+    };
+
+    window.addEventListener(CUSTOM_EVENT_NAME, handleExternalChange);
+    return () => window.removeEventListener(CUSTOM_EVENT_NAME, handleExternalChange);
+  }, [initialDomain]);
+
+  const broadcastChange = (
+    nextDomain: 'auto' | SemanticDomain,
+    nextDensity: SemanticDensity,
+    nextInspect: boolean
+  ) => {
+    syncDocumentAttributes(nextDomain, nextDensity, nextInspect);
+    if (typeof window !== 'undefined') {
+      window.dispatchEvent(
+        new CustomEvent(CUSTOM_EVENT_NAME, {
+          detail: {
+            domainOverride: nextDomain,
+            density: nextDensity,
+            inspectMode: nextInspect,
+          },
+        })
+      );
+    }
+  };
+
+  const setDomainOverride = (nextDomain: 'auto' | SemanticDomain) => {
+    setDomainState(nextDomain);
+    broadcastChange(nextDomain, density, inspectMode);
+  };
+
+  const setDensity = (nextDensity: SemanticDensity) => {
+    setDensityState(nextDensity);
+    broadcastChange(domainOverride, nextDensity, inspectMode);
+  };
+
+  const setInspectMode = (nextInspect: boolean) => {
+    setInspectState(nextInspect);
+    broadcastChange(domainOverride, density, nextInspect);
+  };
+
+  const resolveForContent = (
+    content: ContentMetadataInput,
+    localOptions?: {
+      role?: SemanticRole;
+      domain?: SemanticDomain;
+      tone?: SemanticTone;
+    }
+  ): SemanticProfile => {
+    const effectiveDomain =
+      domainOverride !== 'auto' ? domainOverride : localOptions?.domain;
+    return resolveSemanticContext(content, {
+      role: localOptions?.role ?? initialRole ?? 'standard',
+      domainOverride: effectiveDomain,
+      toneOverride: localOptions?.tone ?? initialTone,
+      density,
+    });
+  };
+
+  return (
+    <SemanticReactContext.Provider
+      value={{
+        domainOverride,
+        toneOverride: initialTone,
+        roleOverride: initialRole,
+        density,
+        inspectMode,
+        setDomainOverride,
+        setDensity,
+        setInspectMode,
+        resolveForContent,
+      }}
+    >
+      {children}
+    </SemanticReactContext.Provider>
+  );
+};
+
+export function useSemanticContext() {
+  return useContext(SemanticReactContext);
+}
