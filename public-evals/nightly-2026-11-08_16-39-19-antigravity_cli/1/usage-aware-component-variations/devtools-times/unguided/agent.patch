+
+export function resolveSemanticContext(
+  input: ContentMetadataInput,
+  options?: {
+    role?: SemanticRole;
+    domainOverride?: SemanticDomain;
+    toneOverride?: SemanticTone;
+    density?: SemanticDensity;
+  }
+): SemanticProfile {
+  const readingTime = input.readingTime ?? 4;
+  const domain =
+    options?.domainOverride ??
+    inferSemanticDomain(
+      input.category,
+      `${input.title} ${input.summary || ''} ${input.description || ''}`
+    );
+  const tone = options?.toneOverride ?? inferSemanticTone(input, domain);
+  const role = options?.role ?? 'standard';
+  const density = options?.density ?? 'standard';
+  const { readingDepth, depthLabel, depthLevel } = computeReadingDepth(readingTime);
+
+  const dMeta = DOMAIN_META[domain];
+  const tMeta = TONE_META[tone];
+
+  const signals: SemanticSignal[] = [
+    { label: 'Semantic Domain', value: dMeta.label },
+    { label: 'Editorial Mode', value: tMeta.label },
+    { label: 'Analytical Lens', value: tMeta.signalFocus },
+    { label: 'Cognitive Pacing', value: `${depthLabel} (${readingTime}m)` },
+  ];
+
+  return {
+    domain,
+    tone,
+    role,
+    density,
+    readingDepth,
+    readingTime,
+    category: input.category,
+    visual: {
+      layoutVariant: dMeta.layoutVariant,
+      domainLabel: dMeta.label,
+      toneLabel: tMeta.label,
+      roleLabel: ROLE_LABELS[role],
+      depthLabel,
+      depthLevel,
+      cardContainerClass: dMeta.cardContainerClass,
+      topAccentBarClass: dMeta.topAccentBarClass,
+      surfaceTintClass: dMeta.surfaceTintClass,
+      borderTreatmentClass: dMeta.borderTreatmentClass,
+      kickerClass: dMeta.kickerClass,
+      headlineClass: dMeta.headlineClass,
+      summaryClass: dMeta.summaryClass,
+      metaClass: dMeta.metaClass,
+      domainBadgeClass: dMeta.domainBadgeClass,
+      toneBadgeClass: tMeta.badgeClass,
+      statusDotClass: dMeta.statusDotClass,
+      calloutBoxClass: dMeta.calloutBoxClass,
+      imageFrameClass: dMeta.imageFrameClass,
+      contextFramingTitle: `${dMeta.framingPrefix} · ${tMeta.label}`,
+      contextFramingSummary: tMeta.summaryDescriptor,
+      signals,
+    },
+  };
+}
