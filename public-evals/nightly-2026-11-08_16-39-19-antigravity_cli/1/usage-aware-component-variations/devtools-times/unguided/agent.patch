+import React from 'react';
+import type { SemanticProfile } from '../../utils/semanticContext';
+
+interface SemanticBadgeProps {
+  profile: SemanticProfile;
+  showTone?: boolean;
+  showDepth?: boolean;
+  compact?: boolean;
+}
+
+export const SemanticBadge: React.FC<SemanticBadgeProps> = ({
+  profile,
+  showTone = true,
+  showDepth = false,
+  compact = false,
+}) => {
+  const { domain, tone, visual, readingTime } = profile;
+
+  return (
+    <div className="flex flex-wrap items-center gap-1.5" data-semantic-badges>
+      <span
+        className={`inline-flex items-center gap-1.5 ${visual.domainBadgeClass}`}
+        title={`Semantic Domain: ${visual.domainLabel}`}
+      >
+        <span className={`w-1.5 h-1.5 rounded-full ${visual.statusDotClass}`} />
+        <span>{profile.category}</span>
+      </span>
+
+      {showTone && !compact && (
+        <span
+          className={`inline-flex items-center px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded-xs ${visual.toneBadgeClass}`}
+          title={`Editorial Mode: ${visual.toneLabel}`}
+        >
+          {visual.toneLabel}
+        </span>
+      )}
+
+      {showDepth && (
+        <span
+          className={`inline-flex items-center gap-1 px-2 py-0.5 text-[10px] border border-gray-200 bg-white/80 rounded-xs ${visual.metaClass}`}
+          title={`Cognitive Pacing: ${visual.depthLabel} (${readingTime} min)`}
+        >
+          <span className="inline-flex gap-0.5 items-center" aria-hidden="true">
+            {[1, 2, 3].map((lvl) => (
+              <span
+                key={lvl}
+                className={`w-1 h-2.5 rounded-xs ${
+                  lvl <= visual.depthLevel ? visual.statusDotClass : 'bg-gray-200'
+                }`}
+              />
+            ))}
+          </span>
+          <span>{visual.depthLabel}</span>
+        </span>
+      )}
+
+      <span
+        className="semantic-xray-badge items-center gap-1 bg-indigo-950 text-indigo-100 font-mono text-[10px] px-2 py-0.5 rounded-xs border border-indigo-500 shadow-xs"
+        data-xray-indicator
+      >
+        <span>ctx:{domain}</span>
+        <span>·</span>
+        <span>tone:{tone}</span>
+        <span>·</span>
+        <span>role:{profile.role}</span>
+      </span>
+    </div>
+  );
+};
+
+export default SemanticBadge;
