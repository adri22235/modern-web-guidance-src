+++ b/src/utils/semanticContext.ts
@@ -0,0 +1,503 @@
+export type SemanticDomain =
+  | 'civic'      // News, Politics, National, Labor
+  | 'market'     // Business, Economy
+  | 'scientific' // Science, Web Development, Tech
+  | 'cultural'   // Culture, Media, Arts
+  | 'kinetic';   // Sports, Lifestyle, Urban Development, Pets
+
+export type SemanticTone =
+  | 'investigative' // Urgent, crime, crisis, strikes, deep expose
+  | 'analytical'    // Research, data, economic outlook, systems analysis
+  | 'dispatch'      // Live events, championships, protests, breaking action
+  | 'narrative';    // Human interest, essays, arts critique, lifestyle stories
+
+export type SemanticRole =
+  | 'lead'     // Primary hero story
+  | 'feature'  // Section lead or spotlight story
+  | 'standard' // Standard grid teaser
+  | 'compact'; // Wire / ticker / brief item
+
+export type SemanticDensity = 'comfortable' | 'standard' | 'compact';
+
+export type LayoutVariant =
+  | 'broadsheet-authoritative'
+  | 'ledger-quantitative'
+  | 'schematic-technical'
+  | 'magazine-expressive'
+  | 'dispatch-kinetic';
+
+export interface SemanticSignal {
+  label: string;
+  value: string;
+}
+
+export interface VisualLogicTokens {
+  layoutVariant: LayoutVariant;
+  domainLabel: string;
+  toneLabel: string;
+  roleLabel: string;
+  depthLabel: string;
+  depthLevel: 1 | 2 | 3;
+  // Structural & surface styling
+  cardContainerClass: string;
+  topAccentBarClass: string;
+  surfaceTintClass: string;
+  borderTreatmentClass: string;
+  // Typography
+  kickerClass: string;
+  headlineClass: string;
+  summaryClass: string;
+  metaClass: string;
+  // Badges & indicators
+  domainBadgeClass: string;
+  toneBadgeClass: string;
+  statusDotClass: string;
+  calloutBoxClass: string;
+  imageFrameClass: string;
+  // Contextual content annotations
+  contextFramingTitle: string;
+  contextFramingSummary: string;
+  signals: SemanticSignal[];
+}
+
+export interface SemanticProfile {
+  domain: SemanticDomain;
+  tone: SemanticTone;
+  role: SemanticRole;
+  density: SemanticDensity;
+  readingDepth: 'quick' | 'standard' | 'deep';
+  readingTime: number;
+  category: string;
+  visual: VisualLogicTokens;
+}
+
+export interface ContentMetadataInput {
+  id?: string;
+  slug?: string;
+  title: string;
+  summary?: string;
+  description?: string;
+  category: string;
+  author?: string;
+  readingTime?: number;
+  tags?: string[];
+  date?: Date | string;
+}
+
+const DOMAIN_BY_CATEGORY: Record<string, SemanticDomain> = {
+  politics: 'civic',
+  national: 'civic',
+  news: 'civic',
+  labor: 'civic',
+  'news & politics': 'civic',
+  economy: 'market',
+  business: 'market',
+  science: 'scientific',
+  'web development': 'scientific',
+  'science & tech': 'scientific',
+  culture: 'cultural',
+  media: 'cultural',
+  'arts & culture': 'cultural',
+  sports: 'kinetic',
+  lifestyle: 'kinetic',
+  'urban development': 'kinetic',
+  pets: 'kinetic',
+  'lifestyle & sports': 'kinetic',
+};
+
+const INVESTIGATIVE_KEYWORDS = [
+  'killer',
+  'crime',
+  'criminal',
+  'forensic',
+  'crisis',
+  'decay',
+  'strike',
+  'strikes',
+  'unraveling',
+  'threat',
+  'investigation',
+  'illicit',
+  'protest',
+];
+
+const ANALYTICAL_KEYWORDS = [
+  'research',
+  'breakthrough',
+  'outlook',
+  'analysis',
+  'trends',
+  'review',
+  'decline',
+  'boom',
+  'overhaul',
+  'architects',
+  'future',
+  'devtools',
+  'economic',
+  'manufacturing',
+  'data',
+  'market',
+];
+
+const DISPATCH_KEYWORDS = [
+  'championship',
+  'championships',
+  'super bowl',
+  'night game',
+  'olympic',
+  'activism',
+  'festival',
+  'returns',
+  'roundtable',
+  'briefing',
+  'thrills',
+  'race',
+];
+
+export function inferSemanticDomain(category: string, text = ''): SemanticDomain {
+  const normalized = (category || '').trim().toLowerCase();
+  if (DOMAIN_BY_CATEGORY[normalized]) {
+    return DOMAIN_BY_CATEGORY[normalized];
+  }
+  const lowerText = text.toLowerCase();
+  if (lowerText.includes('econom') || lowerText.includes('market') || lowerText.includes('manufacturing')) {
+    return 'market';
+  }
+  if (lowerText.includes('scien') || lowerText.includes('research') || lowerText.includes('ai') || lowerText.includes('devtools')) {
+    return 'scientific';
+  }
+  if (lowerText.includes('art') || lowerText.includes('ballet') || lowerText.includes('improv') || lowerText.includes('media')) {
+    return 'cultural';
+  }
+  if (lowerText.includes('sport') || lowerText.includes('swim') || lowerText.includes('cycl') || lowerText.includes('coast')) {
+    return 'kinetic';
+  }
+  return 'civic';
+}
+
+export function inferSemanticTone(
+  input: ContentMetadataInput,
+  domain: SemanticDomain
+): SemanticTone {
+  const corpus = [
+    input.title || '',
+    input.summary || '',
+    input.description || '',
+    ...(input.tags || []),
+  ]
+    .join(' ')
+    .toLowerCase();
+
+  if (INVESTIGATIVE_KEYWORDS.some((kw) => corpus.includes(kw))) {
+    return 'investigative';
+  }
+  if (DISPATCH_KEYWORDS.some((kw) => corpus.includes(kw))) {
+    return 'dispatch';
+  }
+  if (ANALYTICAL_KEYWORDS.some((kw) => corpus.includes(kw))) {
+    return 'analytical';
+  }
+
+  // Fallback by domain defaults
+  switch (domain) {
+    case 'scientific':
+    case 'market':
+      return 'analytical';
+    case 'cultural':
+      return 'narrative';
+    case 'kinetic':
+      return 'narrative';
+    case 'civic':
+    default:
+      return 'investigative';
+  }
+}
+
+export function computeReadingDepth(readingTime = 4): {
+  readingDepth: 'quick' | 'standard' | 'deep';
+  depthLabel: string;
+  depthLevel: 1 | 2 | 3;
+} {
+  if (readingTime <= 3) {
+    return { readingDepth: 'quick', depthLabel: 'Quick Scan', depthLevel: 1 };
+  }
+  if (readingTime <= 5) {
+    return { readingDepth: 'standard', depthLabel: 'Standard Read', depthLevel: 2 };
+  }
+  return { readingDepth: 'deep', depthLabel: 'Deep Dive', depthLevel: 3 };
+}
