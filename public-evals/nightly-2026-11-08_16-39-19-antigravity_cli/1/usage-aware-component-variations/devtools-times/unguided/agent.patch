+import React from 'react';
+import {
+  SEMANTIC_DOMAINS,
+  type SemanticDensity,
+  type SemanticDomain,
+} from '../../utils/semanticContext';
+import {
+  SemanticContextProvider,
+  useSemanticContext,
+} from './SemanticContext';
+
+interface ToolbarInnerProps {
+  activePageContextLabel?: string;
+}
+
+const ToolbarInner: React.FC<ToolbarInnerProps> = ({ activePageContextLabel }) => {
+  const {
+    domainOverride,
+    density,
+    inspectMode,
+    setDomainOverride,
+    setDensity,
+    setInspectMode,
+  } = useSemanticContext();
+
+  const activeSpec =
+    SEMANTIC_DOMAINS.find((d) => d.id === domainOverride) || SEMANTIC_DOMAINS[0];
+
+  const densities: { id: SemanticDensity; label: string }[] = [
+    { id: 'comfortable', label: 'Immersive' },
+    { id: 'standard', label: 'Standard' },
+    { id: 'compact', label: 'Wire / Compact' },
+  ];
+
+  return (
+    <div
+      className="bg-slate-900 text-slate-100 border-b border-slate-800 text-xs"
+      role="region"
+      aria-label="Semantic Visual Logic Controls"
+    >
+      <div className="max-w-6xl mx-auto px-4 py-2 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2">
+        {/* Left: Status & Active Lens Description */}
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="inline-flex items-center gap-1.5 font-mono uppercase tracking-widest text-[10px] bg-amber-500/20 text-amber-300 border border-amber-400/40 px-2 py-0.5 rounded-xs font-semibold">
+            <span className="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" />
+            Semantic Visual Engine
+          </span>
+          {activePageContextLabel && (
+            <span className="font-mono text-[11px] text-slate-300 border-r border-slate-700 pr-2">
+              Zone: <strong className="text-white">{activePageContextLabel}</strong>
+            </span>
+          )}
+          <span className="text-slate-300 hidden sm:inline">
+            {activeSpec.description}
+          </span>
+        </div>
+
+        {/* Right: Lens Switcher, Density & X-Ray Toggle */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Semantic Context Lens Selector */}
+          <div
+            className="flex flex-wrap items-center bg-slate-800/90 p-0.5 rounded-xs border border-slate-700"
+            role="group"
+            aria-label="Semantic Context Lens"
+          >
+            {SEMANTIC_DOMAINS.map((item) => {
+              const isSelected = domainOverride === item.id;
+              return (
+                <button
+                  key={item.id}
+                  type="button"
+                  onClick={() => setDomainOverride(item.id as 'auto' | SemanticDomain)}
+                  className={`px-2 py-1 text-[11px] font-medium transition-colors rounded-xs cursor-pointer ${
+                    isSelected
+                      ? 'bg-amber-400 text-slate-950 font-bold shadow-xs'
+                      : 'text-slate-300 hover:text-white hover:bg-slate-700/60'
+                  }`}
+                  title={item.description}
+                >
+                  {item.shortLabel}
+                </button>
+              );
+            })}
+          </div>
+
+          {/* Density Selector */}
+          <div
+            className="hidden md:flex items-center bg-slate-800/90 p-0.5 rounded-xs border border-slate-700"
+            role="group"
+            aria-label="Semantic Density"
+          >
+            {densities.map((d) => (
+              <button
+                key={d.id}
+                type="button"
+                onClick={() => setDensity(d.id)}
+                className={`px-2 py-1 text-[11px] font-mono transition-colors rounded-xs cursor-pointer ${
+                  density === d.id
+                    ? 'bg-cyan-500 text-slate-950 font-bold'
+                    : 'text-slate-300 hover:text-white'
+                }`}
+              >
+                {d.label}
+              </button>
+            ))}
+          </div>
+
+          {/* Visual Logic X-Ray Inspector Toggle */}
+          <button
+            type="button"
+            onClick={() => setInspectMode(!inspectMode)}
+            aria-pressed={inspectMode}
+            className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xs font-mono text-[11px] border transition-colors cursor-pointer ${
+              inspectMode
+                ? 'bg-indigo-600 text-white border-indigo-400 font-bold'
+                : 'bg-slate-800 text-slate-300 border-slate-700 hover:text-white'
+            }`}
+          >
+            <span
+              className={`w-2 h-2 rounded-full ${
+                inspectMode ? 'bg-indigo-200' : 'bg-slate-500'
+              }`}
+            />
+            <span>{inspectMode ? 'X-Ray: ON' : 'Inspect Logic'}</span>
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export const SemanticLensToolbar: React.FC<ToolbarInnerProps> = (props) => {
+  return (
+    <SemanticContextProvider>
+      <ToolbarInner {...props} />
+    </SemanticContextProvider>
+  );
+};
+
+export default SemanticLensToolbar;
