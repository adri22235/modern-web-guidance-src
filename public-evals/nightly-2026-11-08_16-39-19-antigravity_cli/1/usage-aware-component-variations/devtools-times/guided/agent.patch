+/* ==========================================================================
+   Semantic Context Surfaces (usage-aware-component-variations)
+   ========================================================================== */
+/* 1. Set semantic context flags using CSS custom properties on containers.
+   Note: DO NOT set container-type for style queries; they query inherited
+   custom properties on the nearest ancestor directly. */
+.surface-featured,
+.featured,
+[data-surface="featured"] {
+  --surface: featured;
+}
+
+.surface-spotlight,
+.spotlight,
+[data-surface="spotlight"] {
+  --surface: spotlight;
+}
+
+.surface-compact,
+.compact,
+[data-surface="compact"] {
+  --surface: compact;
+}
+
+.surface-related,
+[data-surface="related"] {
+  --surface: related;
+}
+
+/* ==========================================================================
+   Context-Adaptive Components: Default Styles (work everywhere)
