+
+/* Article Teaser Card */
+.article-teaser {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background-color: var(--surface-default-bg);
+  color: #1f2937;
+  border: 1px solid transparent;
+  border-radius: 0.375rem;
+  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+.article-teaser__layout {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  gap: 0.75rem;
+}
+
+.article-teaser__media {
+  display: block;
+  overflow: hidden;
+  border-radius: 0.375rem;
+  flex-shrink: 0;
+}
+
+.article-teaser__image {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 16 / 9;
+  object-fit: cover;
+  display: block;
+  transition: transform 0.3s ease;
+}
+
+.article-teaser:hover .article-teaser__image {
+  transform: scale(1.02);
+}
+
+.article-teaser__content {
+  display: flex;
+  flex-direction: column;
+  flex-grow: 1;
+}
+
+.article-teaser__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+  margin-bottom: 0.25rem;
+}
+
+/* Promotional / Context Badge — hidden by default, revealed in semantic contexts */
+.context-badge,
+.badge {
+  display: none;
+  align-items: center;
+  gap: 0.25rem;
+  padding: 0.125rem 0.5rem;
+  font-size: 0.6875rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  border-radius: 9999px;
+  background-color: var(--brand-accent-light);
+  color: var(--brand-accent-dark);
+  border: 1px solid #fcd34d;
+}
+
+.article-teaser__category {
+  color: var(--brand-accent-dark);
+  font-size: 0.875rem;
+  letter-spacing: 0.1em;
+}
+
+.article-teaser__title {
+  font-size: 1.25rem;
+  line-height: 1.35;
+  color: #1f2937;
+  transition: color 0.2s ease;
+}
+
+.article-teaser:hover .article-teaser__title {
+  color: var(--brand-accent);
+}
+
+.article-teaser__summary {
+  color: #4b5563;
+  margin-top: 0.375rem;
+  font-size: 0.9375rem;
+  line-height: 1.5;
+  flex-grow: 1;
+}
+
+.article-teaser__footer {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 0.75rem;
+  color: #6b7280;
+  margin-top: 0.75rem;
+  padding-top: 0.5rem;
+  border-top: 1px solid #f3f4f6;
+}
+
+/* Action CTA / Button — Default: Outlined informational style */
+.context-cta,
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.375rem;
+  padding: 0.375rem 0.75rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  border-radius: 0.25rem;
+  background: transparent;
+  color: #374151;
+  border: 1px solid currentColor;
+  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
+  text-decoration: none;
+}
+
+.context-cta:hover,
+.button:hover {
+  color: var(--brand-accent-dark);
+  border-color: var(--brand-accent-dark);
+}
+
+/* Bookmark Button — adapts to semantic context */
+.bookmark-button {
