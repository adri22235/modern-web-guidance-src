+}
+
+:where(.surface-featured, .featured, [data-surface="featured"]) .bookmark-button__label {
+  display: inline;
+}
+
+/* Spotlight Context Fallback (high-contrast dark editorial surface) */
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .article-teaser {
+  background-color: var(--surface-spotlight-bg);
+  color: #f9fafb;
+  padding: 1.25rem;
+  border-color: #374151;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .article-teaser__category {
+  color: #fbbf24;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .article-teaser__title {
+  color: #ffffff;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .article-teaser__summary {
+  color: #d1d5db;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .article-teaser__footer {
+  color: #9ca3af;
+  border-top-color: #374151;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .context-badge,
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .badge {
+  display: inline-flex;
+  background-color: rgb(217 119 6 / 0.25);
+  color: #fcd34d;
+  border-color: #f59e0b;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .context-cta,
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .button {
+  background: #f59e0b;
+  color: #111827;
+  border-color: transparent;
+}
+
+:where(.surface-spotlight, .spotlight, [data-surface="spotlight"]) .bookmark-button {
+  border-color: #4b5563;
+  color: #e5e7eb;
+}
+
+/* Compact Context Fallback (dense news ticker / sidebar / secondary digest) */
+:where(.surface-compact, .compact, [data-surface="compact"]) .article-teaser__media,
+:where(.surface-compact, .compact, [data-surface="compact"]) .article-teaser__summary {
+  display: none;
+}
+
+:where(.surface-compact, .compact, [data-surface="compact"]) .article-teaser__title {
+  font-size: 1.0625rem;
+}
+
+:where(.surface-compact, .compact, [data-surface="compact"]) .context-cta {
+  padding: 0.25rem 0.5rem;
+  font-size: 0.6875rem;
+}
+
+/* ==========================================================================
+   Progressive Enhancement: CSS Container Style Queries (@container style())
+   ========================================================================== */
+
+@container style(--surface: featured) {
+  .article-teaser {
+    background-color: #ffffff;
+    padding: 1.5rem;
+    border-color: #fde68a;
+    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.05);
+  }
+
+  .article-teaser__layout {
+    display: grid;
+    grid-template-columns: 1fr;
+    gap: 1.5rem;
+    align-items: center;
+  }
+
+  @media (min-width: 1024px) {
+    .article-teaser__layout {
+      grid-template-columns: 1fr 1.6fr;
+      gap: 2rem;
+    }
+
+    .article-teaser__media {
+      order: 2;
+    }
+
+    .article-teaser__content {
+      order: 1;
+    }
+  }
+
+  .article-teaser__title {
+    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
+    line-height: 1.15;
+    color: #111827;
+  }
+
+  .article-teaser__summary {
+    font-size: 1.0625rem;
+    color: #374151;
+    margin-top: 0.75rem;
+  }
+
+  .context-badge,
+  .badge {
+    /* Reveal decorative/promotional badge only in featured context */
+    display: inline-flex;
+  }
+
+  .context-cta,
+  .button {
+    /* Automatic switch to Filled promotional style */
+    background: var(--brand-accent);
+    color: #ffffff;
+    border-color: transparent;
+  }
+
+  .context-cta:hover,
+  .button:hover {
+    background: var(--brand-accent-hover);
+    color: #ffffff;
+  }
+
+  .bookmark-button {
+    border-color: #e5e7eb;
+    color: #4b5563;
+    background-color: #f9fafb;
+  }
+
+  .bookmark-button__label {
+    display: inline;
+  }
+}
+
+@container style(--surface: spotlight) {
+  .article-teaser {
+    background-color: var(--surface-spotlight-bg);
+    color: #f9fafb;
+    padding: 1.25rem;
+    border-color: #374151;
+  }
+
+  .article-teaser__category {
+    color: #fbbf24;
+  }
+
+  .article-teaser__title {
+    color: #ffffff;
+  }
+
+  .article-teaser__summary {
+    color: #d1d5db;
+  }
+
+  .article-teaser__footer {
+    color: #9ca3af;
+    border-top-color: #374151;
+  }
+
+  .context-badge,
+  .badge {
+    display: inline-flex;
+    background-color: rgb(217 119 6 / 0.25);
+    color: #fcd34d;
+    border-color: #f59e0b;
+  }
+
+  .context-cta,
+  .button {
+    background: #f59e0b;
+    color: #111827;
+    border-color: transparent;
+  }
+
+  .bookmark-button {
+    border-color: #4b5563;
+    color: #e5e7eb;
+  }
+}
+
+@container style(--surface: compact) {
+  .article-teaser__media,
+  .article-teaser__summary {
+    display: none;
+  }
+
+  .article-teaser__title {
+    font-size: 1.0625rem;
+  }
+
+  .context-cta {
+    padding: 0.25rem 0.5rem;
+    font-size: 0.6875rem;
+  }
+}
