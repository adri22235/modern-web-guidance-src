+  border: 1px solid transparent;
+  color: #9ca3af;
+  font-size: 0.75rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
+}
+
+.bookmark-button:hover {
+  color: var(--brand-accent);
+}
+
+.bookmark-button__label {
+  display: none;
+}
+
+/* ==========================================================================
