+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const { width = 256, height = 192, samples = 8, colors = null, requestId = 0 } = event.data || {};
+  const startTime = performance.now();
+
+  try {
+    const wasm = await getWasm();
+
+    if (Array.isArray(colors)) {
+      for (const item of colors) {
+        wasm._set_sphere_color(item.index, item.r, item.g, item.b);
+      }
+    } else {
+      wasm._reset_default_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+
+    try {
+      wasm._render_frame(ptr, width, height, samples);
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength,
+      ).slice();
+
+      const elapsedMs = Math.round(performance.now() - startTime);
+      self.postMessage(
+        { type: 'rendered', pixels, width, height, samples, elapsedMs, requestId },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (err) {
+    self.postMessage({
+      type: 'error',
+      message: err instanceof Error ? err.message : String(err),
+      requestId,
+    });
+  }
+});
