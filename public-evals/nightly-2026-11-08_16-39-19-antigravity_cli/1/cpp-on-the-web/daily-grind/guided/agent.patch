@@ -0,0 +1,181 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Adapted for WebAssembly (Emscripten) with configurable sphere colors and direct RGBA buffer output.
+
+#include <cmath>
+#include <cstdlib>
+#include <cstdint>
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1.0 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static Sphere spheres[] = {
+  Sphere(1e5,  Vec( 1e5 + 1, 40.8, 81.6),  Vec(), Vec(.75, .25, .25), DIFF), // Left
+  Sphere(1e5,  Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF), // Rght
+  Sphere(1e5,  Vec(50, 40.8, 1e5),         Vec(), Vec(.75, .75, .75), DIFF), // Back
+  Sphere(1e5,  Vec(50, 40.8, -1e5 + 170),  Vec(), Vec(),              DIFF), // Frnt
+  Sphere(1e5,  Vec(50, 1e5, 81.6),         Vec(), Vec(.75, .75, .75), DIFF), // Botm
+  Sphere(1e5,  Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF), // Top
+  Sphere(16.5, Vec(27, 16.5, 47),          Vec(), Vec(1, 1, 1) * .999, SPEC), // Mirr
+  Sphere(16.5, Vec(73, 16.5, 78),          Vec(), Vec(1, 1, 1) * .999, REFR), // Glas
+  Sphere(600,  Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(),    DIFF)  // Lite
+};
+
+static inline double clamp(double x) {
+  return x < 0 ? 0 : (x > 1 ? 1 : x);
+}
+
+static inline uint8_t toInt(double x) {
+  return static_cast<uint8_t>(std::pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5);
+}
+
+static inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+  for (int i = int(n); i--;) {
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+static Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t;
+  Vec n = (x - obj.p).norm();
+  Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+  Vec f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : (f.y > f.z ? f.y : f.z);
+  if (++depth > 5) {
+    if (erand48(Xi) < p && depth < 100) {
+      f = f * (1.0 / p);
+    } else {
+      return obj.e;
+    }
+  }
+  if (obj.refl == DIFF) {
+    double r1 = 2.0 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = std::sqrt(r2);
+    Vec w = nl;
+    Vec u = ((std::fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm();
+    Vec v = w % u;
+    Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1.0 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2.0 * n.dot(r.d)), depth, Xi));
+  }
+  Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1.0, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn)) < 0) {
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  }
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1.0 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1.0 - R0) * c * c * c * c * c;
+  double Tr = 1.0 - Re;
+  double P = .25 + .5 * Re;
+  double RP = Re / P, TP = Tr / (1.0 - P);
+  return obj.e + f.mult(depth > 2
+      ? (erand48(Xi) < P ? radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP)
+      : radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+extern "C" {
+
+void set_sphere_color(int index, double r, double g, double b) {
+  int count = static_cast<int>(sizeof(spheres) / sizeof(Sphere));
+  if (index >= 0 && index < count) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+  spheres[8].c = Vec(0, 0, 0);
+}
+
+void render_frame(uint8_t *out_rgba, int w, int h, int samps) {
+  if (!out_rgba || w <= 0 || h <= 0) return;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h);
+  Vec cy = (cx % cam.d).norm() * .5135;
+
+  Vec *c = static_cast<Vec *>(std::calloc(w * h, sizeof(Vec)));
+  if (!c) return;
+
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {0, 0, static_cast<unsigned short>(y * y * y)};
+    for (int x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r;
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2.0 * erand48(Xi), dx = r1 < 1 ? std::sqrt(r1) - 1.0 : 1.0 - std::sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi), dy = r2 < 1 ? std::sqrt(r2) - 1.0 : 1.0 - std::sqrt(2.0 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2.0 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2.0 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+          }
+          c[i] = c[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+    }
+  }
+
+  for (int i = 0; i < w * h; i++) {
+    out_rgba[i * 4 + 0] = toInt(c[i].x);
+    out_rgba[i * 4 + 1] = toInt(c[i].y);
+    out_rgba[i * 4 + 2] = toInt(c[i].z);
+    out_rgba[i * 4 + 3] = 255;
+  }
+
+  std::free(c);
+}
+
+}
