index 0000000..462aeb4
--- /dev/null
+++ b/app.js
@@ -0,0 +1,115 @@
+const canvas = document.getElementById('smallpt-canvas');
+const ctx = canvas.getContext('2d');
+const randomizeBtn = document.getElementById('randomize-btn');
+const resetBtn = document.getElementById('reset-btn');
+const statusEl = document.getElementById('render-status');
+const swatchContainer = document.getElementById('swatch-container');
+
+const WIDTH = canvas.width;
+const HEIGHT = canvas.height;
+const SAMPLES = 8;
+
+const SPHERE_LABELS = [
+  { index: 0, name: 'Left Wall', defaultColor: [0.75, 0.25, 0.25] },
+  { index: 1, name: 'Right Wall', defaultColor: [0.25, 0.25, 0.75] },
+  { index: 2, name: 'Back Wall', defaultColor: [0.75, 0.75, 0.75] },
+  { index: 4, name: 'Floor', defaultColor: [0.75, 0.75, 0.75] },
+  { index: 5, name: 'Ceiling', defaultColor: [0.75, 0.75, 0.75] },
+  { index: 6, name: 'Mirror Sphere', defaultColor: [0.999, 0.999, 0.999] },
+  { index: 7, name: 'Glass Sphere', defaultColor: [0.999, 0.999, 0.999] },
+];
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+let activeRequestId = 0;
+
+function toCssRgb(r, g, b) {
+  const to255 = (v) => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+  return `rgb(${to255(r)}, ${to255(g)}, ${to255(b)})`;
+}
+
+function renderSwatches(colors) {
+  swatchContainer.replaceChildren();
+  const colorMap = new Map();
+  if (Array.isArray(colors)) {
+    for (const c of colors) {
+      colorMap.set(c.index, [c.r, c.g, c.b]);
+    }
+  }
+
+  for (const sphere of SPHERE_LABELS) {
+    const [r, g, b] = colorMap.get(sphere.index) || sphere.defaultColor;
+    const pill = document.createElement('span');
+    pill.className = 'swatch-pill';
+
+    const dot = document.createElement('span');
+    dot.className = 'swatch-dot';
+    dot.style.backgroundColor = toCssRgb(r, g, b);
+
+    const text = document.createElement('span');
+    text.textContent = sphere.name;
+
+    pill.append(dot, text);
+    swatchContainer.append(pill);
+  }
+}
+
+function generateRandomColors() {
+  const randomChannel = (min, max) => +(min + Math.random() * (max - min)).toFixed(3);
+  return SPHERE_LABELS.map((sphere) => {
+    const isOrb = sphere.index === 6 || sphere.index === 7;
+    const min = isOrb ? 0.35 : 0.15;
+    const max = isOrb ? 0.999 : 0.85;
+    return {
+      index: sphere.index,
+      r: randomChannel(min, max),
+      g: randomChannel(min, max),
+      b: randomChannel(min, max),
+    };
+  });
+}
+
+function setBusy(busy, statusText) {
+  randomizeBtn.disabled = busy;
+  resetBtn.disabled = busy;
+  statusEl.textContent = statusText;
+}
+
+function triggerRender(colors = null) {
+  activeRequestId += 1;
+  renderSwatches(colors);
+  setBusy(true, `Rendering ${WIDTH}×${HEIGHT} (${SAMPLES * 4} spp)...`);
+  worker.postMessage({
+    width: WIDTH,
+    height: HEIGHT,
+    samples: SAMPLES,
+    colors,
+    requestId: activeRequestId,
+  });
+}
+
+worker.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || data.requestId !== activeRequestId) return;
+
+  if (data.type === 'rendered') {
+    const imageData = new ImageData(data.pixels, data.width, data.height);
+    ctx.putImageData(imageData, 0, 0);
+    setBusy(
+      false,
+      `Rendered ${data.width}×${data.height} (${data.samples * 4} spp) in ${data.elapsedMs} ms`,
+    );
+  } else if (data.type === 'error') {
+    setBusy(false, `Render error: ${data.message}`);
+  }
+});
+
+randomizeBtn.addEventListener('click', () => {
+  triggerRender(generateRandomColors());
+});
+
+resetBtn.addEventListener('click', () => {
+  triggerRender(null);
+});
+
+// Perform initial render on load
+triggerRender(null);
