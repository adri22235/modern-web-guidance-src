+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>smallpt — WebAssembly C++ Path Tracer</title>
+  <style>
+    :root {
+      color-scheme: dark;
+      --bg: #0f172a;
+      --panel: #1e293b;
+      --border: #334155;
+      --text: #f8fafc;
+      --muted: #94a3b8;
+      --accent: #f59e0b;
+      --accent-hover: #d97706;
+    }
+    * {
+      box-sizing: border-box;
+    }
+    body {
+      margin: 0;
+      min-height: 100vh;
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background: radial-gradient(circle at top, #1e293b 0%, #0f172a 70%);
+      color: var(--text);
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 2rem 1rem;
+    }
+    main {
+      width: 100%;
+      max-width: 760px;
+      background: var(--panel);
+      border: 1px solid var(--border);
+      border-radius: 14px;
+      padding: 1.75rem;
+      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
+    }
+    header {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 0.5rem;
+      margin-bottom: 1.25rem;
+      border-bottom: 1px solid var(--border);
+      padding-bottom: 1rem;
+    }
+    h1 {
+      margin: 0;
+      font-size: 1.5rem;
+      letter-spacing: -0.02em;
+    }
+    .subtitle {
+      margin: 0.25rem 0 0;
+      color: var(--muted);
+      font-size: 0.9rem;
+    }
+    .subtitle a {
+      color: var(--accent);
+      text-decoration: none;
+    }
+    .canvas-wrapper {
+      position: relative;
+      width: 100%;
+      background: #000;
+      border-radius: 10px;
+      overflow: hidden;
+      border: 1px solid var(--border);
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      aspect-ratio: 4 / 3;
+    }
+    canvas {
+      width: 100%;
+      height: 100%;
+      display: block;
+      image-rendering: auto;
+    }
+    .controls {
+      margin-top: 1.25rem;
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+    }
+    .btn-Group {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 0.75rem;
+    }
+    button {
+      appearance: none;
+      border: none;
+      border-radius: 8px;
+      background: var(--accent);
+      color: #0f172a;
+      font-weight: 700;
+      font-size: 0.95rem;
+      padding: 0.75rem 1.25rem;
+      cursor: pointer;
+      transition: background 0.15s ease, transform 0.1s ease;
+      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
+    }
+    button:hover {
+      background: var(--accent-hover);
+    }
+    button:active {
+      transform: translateY(1px);
+    }
+    select {
+      background: #0f172a;
+      color: var(--text);
+      border: 1px solid var(--border);
+      border-radius: 8px;
+      padding: 0.6rem 0.75rem;
+      font-size: 0.875rem;
+    }
+    .stats {
+      font-size: 0.85rem;
+      color: var(--muted);
+      font-variant-numeric: tabular-nums;
+    }
+    .swatches {
+      margin-top: 1.25rem;
+      padding-top: 1rem;
+      border-top: 1px solid var(--border);
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
+      gap: 0.6rem;
+    }
+    .swatch-item {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      background: rgba(15, 23, 42, 0.6);
+      padding: 0.45rem 0.65rem;
+      border-radius: 6px;
+      border: 1px solid var(--border);
+      font-size: 0.8rem;
+    }
+    .swatch-color {
+      width: 16px;
+      height: 16px;
+      border-radius: 50%;
+      border: 1px solid rgba(255, 255, 255, 0.35);
+      flex-shrink: 0;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <div>
+        <h1>smallpt WebAssembly Path Tracer</h1>
+        <p class="subtitle">
+          Kevin Beason's C++ global illumination renderer compiled to WebAssembly (<a href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>)
+        </p>
+      </div>
+      <div class="stats" id="status">Initializing WebAssembly...</div>
+    </header>
+
+    <div class="canvas-wrapper">
+      <canvas id="canvas" width="256" height="192"></canvas>
+    </div>
+
+    <div class="controls">
+      <div class="btn-Group">
+        <button id="randomize-btn" type="button">
+          Run Again with Randomized Sphere Colors
+        </button>
+        <label style="font-size: 0.85rem; color: var(--muted);">
+          Target Quality:
+          <select id="samples-select">
+            <option value="4">16 spp (Fast)</option>
+            <option value="8" selected>32 spp (Balanced)</option>
+            <option value="16">64 spp (High Quality)</option>
+          </select>
+        </label>
+      </div>
+      <div class="stats" id="render-metrics">256×192 · 0 spp</div>
+    </div>
+
+    <div class="swatches" id="sphere-swatches" aria-label="Current Sphere Colors"></div>
+  </main>
+
+  <script>
+    (function () {
+      const WIDTH = 256;
+      const HEIGHT = 192;
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const statusEl = document.getElementById('status');
+      const metricsEl = document.getElementById('render-metrics');
+      const randomizeBtn = document.getElementById('randomize-btn');
+      const samplesSelect = document.getElementById('samples-select');
+      const swatchesEl = document.getElementById('sphere-swatches');
+
+      const SPHERE_LABELS = [
+        { index: 0, name: 'Left Sphere' },
+        { index: 1, name: 'Right Sphere' },
+        { index: 2, name: 'Back Sphere' },
+        { index: 4, name: 'Floor Sphere' },
+        { index: 6, name: 'Mirror Sphere' },
+        { index: 7, name: 'Glass Sphere' }
+      ];
+
+      let rafId = null;
+      let currentPass = 0;
+      let targetPasses = parseInt(samplesSelect.value, 10) || 8;
+      let seedCounter = 1;
+      let wasmReady = false;
+      let totalElapsedMs = 0;
+
+      function toDisplayRgb(v) {
+        const clamped = Math.max(0, Math.min(1, v));
+        return Math.round(Math.pow(clamped, 1 / 2.2) * 255);
+      }
+
+      function updateSwatches() {
+        if (!wasmReady || !window.Module || !window.Module._get_sphere_color_channel) return;
+        swatchesEl.innerHTML = '';
+        for (const item of SPHERE_LABELS) {
+          const r = toDisplayRgb(window.Module._get_sphere_color_channel(item.index, 0));
+          const g = toDisplayRgb(window.Module._get_sphere_color_channel(item.index, 1));
+          const b = toDisplayRgb(window.Module._get_sphere_color_channel(item.index, 2));
+          const div = document.createElement('div');
+          div.className = 'swatch-item';
+          div.innerHTML =
+            '<span class="swatch-color" style="background: rgb(' + r + ',' + g + ',' + b + ')"></span>' +
+            '<span>' + item.name + '</span>';
+          swatchesEl.appendChild(div);
+        }
+      }
+
+      function executePass() {
+        const M = window.Module;
+        const t0 = performance.now();
+        currentPass++;
+        seedCounter = (seedCounter * 1664525 + 1013904223) >>> 0;
+        const ptr = M._render_pass(WIDTH, HEIGHT, seedCounter + currentPass);
+        const size = M._get_framebuffer_size();
+        const pixels = new Uint8ClampedArray(M.HEAPU8.buffer, ptr, size);
+        const imageData = new ImageData(new Uint8ClampedArray(pixels), WIDTH, HEIGHT);
+        ctx.putImageData(imageData, 0, 0);
+        const dt = performance.now() - t0;
+        totalElapsedMs += dt;
+
+        const spp = currentPass * 4;
+        metricsEl.textContent = WIDTH + '×' + HEIGHT + ' · ' + spp + ' spp · ' + Math.round(totalElapsedMs) + ' ms';
+
+        if (currentPass < targetPasses) {
+          statusEl.textContent = 'Path tracing pass ' + currentPass + '/' + targetPasses + '...';
+          rafId = requestAnimationFrame(executePass);
+        } else {
+          statusEl.textContent = 'Render complete (' + spp + ' samples/pixel)';
+          rafId = null;
+        }
+      }
+
+      function startRender(randomize) {
+        if (!wasmReady) return;
+        if (rafId !== null) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        const M = window.Module;
+        targetPasses = parseInt(samplesSelect.value, 10) || 8;
+        if (randomize) {
+          seedCounter = (seedCounter + Date.now() + Math.floor(Math.random() * 1000000)) >>> 0;
+          M._randomize_sphere_colors(seedCounter);
+        }
+        updateSwatches();
+        M._reset_accumulation(WIDTH, HEIGHT);
+        currentPass = 0;
+        totalElapsedMs = 0;
+        // Run the first pass synchronously so the canvas updates immediately
+        executePass();
+      }
+
+      randomizeBtn.addEventListener('click', function () {
+        startRender(true);
+      });
+
+      samplesSelect.addEventListener('change', function () {
+        targetPasses = parseInt(samplesSelect.value, 10) || 8;
+        if (wasmReady && currentPass < targetPasses && rafId === null) {
+          rafId = requestAnimationFrame(executePass);
+        }
+      });
+
+      window.Module = {
+        noInitialRun: true,
+        onRuntimeInitialized: function () {
+          wasmReady = true;
+          statusEl.textContent = 'Rendering scene...';
+          startRender(false);
+        }
+      };
+    })();
+  </script>
+  <script src="./smallpt.js"></script>
+</body>
+</html>
