index 0000000..e42ca95
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,272 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColor {
+  index: number;
+  name: string;
+  r: number;
+  g: number;
+  b: number;
+}
+
+const DEFAULT_SPHERE_COLORS: SphereColor[] = [
+  { index: 0, name: 'Left Wall', r: 0.75, g: 0.25, b: 0.25 },
+  { index: 1, name: 'Right Wall', r: 0.25, g: 0.25, b: 0.75 },
+  { index: 2, name: 'Back Wall', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 4, name: 'Floor', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 5, name: 'Ceiling', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 6, name: 'Mirror Sphere', r: 0.999, g: 0.999, b: 0.999 },
+  { index: 7, name: 'Glass Sphere', r: 0.999, g: 0.999, b: 0.999 },
+];
+
+function generateRandomSphereColors(): SphereColor[] {
+  return DEFAULT_SPHERE_COLORS.map((sphere) => {
+    if (sphere.index === 6 || sphere.index === 7) {
+      return {
+        ...sphere,
+        r: Number((0.55 + Math.random() * 0.449).toFixed(3)),
+        g: Number((0.55 + Math.random() * 0.449).toFixed(3)),
+        b: Number((0.55 + Math.random() * 0.449).toFixed(3)),
+      };
+    }
+    return {
+      ...sphere,
+      r: Number((0.15 + Math.random() * 0.75).toFixed(3)),
+      g: Number((0.15 + Math.random() * 0.75).toFixed(3)),
+      b: Number((0.15 + Math.random() * 0.75).toFixed(3)),
+    };
+  });
+}
+
+function toCssRgb(r: number, g: number, b: number): string {
+  const gamma = (c: number) => Math.round(Math.pow(Math.max(0, Math.min(1, c)), 1 / 2.2) * 255);
+  return `rgb(${gamma(r)}, ${gamma(g)}, ${gamma(b)})`;
+}
+
+export default function SmallptPathTracer({
+  baseUrl = '/',
+}: {
+  baseUrl?: string;
+}) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const renderIdRef = useRef<number>(0);
+
+  const [width] = useState<number>(240);
+  const [height] = useState<number>(180);
+  const [samples, setSamples] = useState<number>(4);
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [sphereColors, setSphereColors] = useState<SphereColor[]>(DEFAULT_SPHERE_COLORS);
+  const [renderCount, setRenderCount] = useState<number>(0);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const runRender = useCallback(
+    (colorsToUse: SphereColor[], currentSamples: number) => {
+      const requestId = ++renderIdRef.current;
+      setIsRendering(true);
+      setError(null);
+
+      if (workerRef.current) {
+        workerRef.current.postMessage({
+          id: requestId,
+          width,
+          height,
+          samples: currentSamples,
+          colors: colorsToUse,
+        });
+      }
+    },
+    [width, height],
+  );
+
+  useEffect(() => {
+    const workerUrl = new URL(`${normalizedBase}wasm/smallpt-worker.js`, window.location.origin);
+    const worker = new Worker(workerUrl, { type: 'module' });
+    workerRef.current = worker;
+
+    worker.onmessage = (event) => {
+      const data = event.data;
+      if (!data || data.id !== renderIdRef.current) return;
+
+      if (data.error) {
+        setError(data.error);
+        setIsRendering(false);
+        return;
+      }
+
+      const canvas = canvasRef.current;
+      if (canvas && data.pixels) {
+        const ctx = canvas.getContext('2d');
+        if (ctx) {
+          const imageData = new ImageData(data.pixels, data.width, data.height);
+          ctx.putImageData(imageData, 0, 0);
+        }
+      }
+
+      setElapsedMs(data.elapsedMs ?? null);
+      setIsRendering(false);
+      setRenderCount((c) => c + 1);
+    };
+
+    worker.onerror = (err) => {
+      setError(err.message || 'WebAssembly worker encountered an error.');
+      setIsRendering(false);
+    };
+
+    // Initial render with default Cornell box sphere colors
+    runRender(DEFAULT_SPHERE_COLORS, samples);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [normalizedBase]);
+
+  const handleRandomize = () => {
+    const nextColors = generateRandomSphereColors();
+    setSphereColors(nextColors);
+    runRender(nextColors, samples);
+  };
+
+  const handleResetDefault = () => {
+    setSphereColors(DEFAULT_SPHERE_COLORS);
+    runRender(DEFAULT_SPHERE_COLORS, samples);
+  };
+
+  const handleSamplesChange = (newSamples: number) => {
+    setSamples(newSamples);
+    runRender(sphereColors, newSamples);
+  };
+
+  return (
+    <section
+      id="smallpt-path-tracer"
+      aria-label="smallpt WebAssembly Path Tracer"
+      className="my-6 bg-gray-900 text-white rounded-lg shadow-md border border-gray-800 overflow-hidden"
+    >
+      <div className="p-5 md:p-6 flex flex-col lg:flex-row gap-6 items-center">
+        {/* Left: Canvas Output */}
+        <div className="relative flex-shrink-0 bg-black rounded border border-gray-700 overflow-hidden shadow-inner">
+          <canvas
+            ref={canvasRef}
+            id="smallpt-canvas"
+            width={width}
+            height={height}
+            className="block w-[320px] h-[240px] sm:w-[400px] sm:h-[300px] object-contain"
+            style={{ imageRendering: 'auto' }}
+          />
+          {isRendering && (
+            <div className="absolute inset-0 bg-black/55 flex flex-col items-center justify-center gap-2 backdrop-blur-[1px]">
+              <div className="w-7 h-7 border-2 border-amber-400 border-t-transparent rounded-full animate-spin" />
+              <span className="text-xs font-medium text-amber-300 tracking-wide">
+                Tracing rays in WebAssembly...
+              </span>
+            </div>
+          )}
+        </div>
+
+        {/* Right: Info & Controls */}
+        <div className="flex-1 flex flex-col justify-between space-y-4 w-full">
+          <div>
+            <div className="flex flex-wrap items-center gap-2 mb-1">
+              <span className="px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider bg-amber-400 text-gray-950 rounded">
+                Interactive WebAssembly Demo
+              </span>
+              <span className="text-xs text-gray-400 font-mono">
+                {width}&times;{height} &bull; {samples * 4} spp (2&times;2 subpixels)
+              </span>
+              {elapsedMs !== null && !isRendering && (
+                <span
+                  id="smallpt-status"
+                  className="text-xs text-emerald-400 font-mono"
+                >
+                  &bull; Rendered in {elapsedMs} ms (run #{renderCount})
+                </span>
+              )}
+            </div>
+
+            <h2 className="text-xl sm:text-2xl font-bold text-white">
+              smallpt: Global Illumination Path Tracer in C++ &amp; Wasm
+            </h2>
+            <p className="text-sm text-gray-300 mt-1 leading-relaxed">
+              Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer compiled to WebAssembly with Emscripten,
+              featuring diffuse, specular, and dielectric refractive spheres with Russian roulette path termination.
+            </p>
+          </div>
+
+          {/* Active Sphere Colors Palette */}
+          <div>
+            <div className="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
+              Current Scene Sphere Colors
+            </div>
+            <div className="flex flex-wrap gap-2">
+              {sphereColors.map((s) => (
+                <div
+                  key={s.index}
+                  className="flex items-center gap-1.5 bg-gray-800/90 border border-gray-700 rounded px-2 py-1 text-xs"
+                  title={`RGB(${s.r}, ${s.g}, ${s.b})`}
+                >
+                  <span
+                    className="w-3 h-3 rounded-full border border-white/20 inline-block flex-shrink-0"
+                    style={{ backgroundColor: toCssRgb(s.r, s.g, s.b) }}
+                  />
+                  <span className="text-gray-200">{s.name}</span>
+                </div>
+              ))}
+            </div>
+          </div>
+
+          {error && (
+            <div className="text-xs text-red-400 bg-red-950/50 border border-red-800 rounded px-3 py-2">
+              Error: {error}
+            </div>
+          )}
+
+          {/* Action Buttons */}
+          <div className="flex flex-wrap items-center gap-3 pt-1">
+            <button
+              id="randomize-spheres-btn"
+              type="button"
+              onClick={handleRandomize}
+              disabled={isRendering}
+              className="px-4 py-2 bg-amber-400 hover:bg-amber-300 disabled:opacity-50 text-gray-950 font-bold text-sm rounded shadow transition cursor-pointer"
+            >
+              Randomize Sphere Colors &amp; Re-run
+            </button>
+
+            <button
+              id="reset-spheres-btn"
+              type="button"
+              onClick={handleResetDefault}
+              disabled={isRendering}
+              className="px-3 py-2 bg-gray-800 hover:bg-gray-700 disabled:opacity-50 text-gray-200 font-semibold text-xs rounded border border-gray-700 transition cursor-pointer"
+            >
+              Reset Default Colors
+            </button>
+
+            <div className="flex items-center gap-2 ml-auto text-xs text-gray-300">
+              <label htmlFor="smallpt-samples" className="font-medium">
+                Samples/subpixel:
+              </label>
+              <select
+                id="smallpt-samples"
+                value={samples}
+                disabled={isRendering}
+                onChange={(e) => handleSamplesChange(Number(e.target.value))}
+                className="bg-gray-800 border border-gray-700 text-white rounded px-2 py-1 text-xs"
+              >
+                <option value={1}>1 (Fastest)</option>
+                <option value={2}>2 (Fast)</option>
+                <option value={4}>4 (Balanced)</option>
+                <option value={8}>8 (High Quality)</option>
+                <option value={16}>16 (Ultra)</option>
+              </select>
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
