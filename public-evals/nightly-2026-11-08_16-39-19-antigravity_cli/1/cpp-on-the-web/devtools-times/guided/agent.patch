diff --git a/public/wasm/smallpt-worker.js b/public/wasm/smallpt-worker.js
new file mode 100644
index 0000000..813c03b
--- /dev/null
+++ b/public/wasm/smallpt-worker.js
@@ -0,0 +1,71 @@
+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const {
+    id = 0,
+    width = 320,
+    height = 240,
+    samples = 8,
+    randomize = false,
+    seed = Date.now() >>> 0,
+    colors = null,
+  } = event.data || {};
+
+  try {
+    const startTime = performance.now();
+    const wasm = await getWasm();
+
+    if (Array.isArray(colors)) {
+      for (const item of colors) {
+        if (item && typeof item.index === 'number') {
+          wasm._set_sphere_color(item.index, item.r, item.g, item.b);
+        }
+      }
+    } else if (randomize) {
+      wasm._randomize_sphere_colors(seed >>> 0);
+    } else {
+      wasm._reset_default_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+
+    try {
+      wasm._render_smallpt(ptr, width, height, samples);
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength,
+      ).slice();
+      const elapsedMs = Math.round(performance.now() - startTime);
+
+      self.postMessage(
+        {
+          id,
+          pixels,
+          width,
+          height,
+          samples,
+          elapsedMs,
+        },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (err) {
+    self.postMessage({
+      id,
+      error: err instanceof Error ? err.message : String(err),
+    });
+  }
+});
