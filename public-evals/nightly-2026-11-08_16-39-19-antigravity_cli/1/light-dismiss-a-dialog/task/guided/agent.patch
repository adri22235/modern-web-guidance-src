+  <script type="module">
+    const logoutDialog = document.getElementById('logout-dialog');
+    const logoutTrigger = document.querySelector('.test-dialog-trigger');
+
+    // Feature detect 'commandForElement' on HTMLButtonElement.prototype
+    // Conditionally load the invokers-polyfill from a CDN only in browsers lacking native support,
+    // and ensure showModal() works immediately via a direct listener if native support is missing.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      logoutTrigger?.addEventListener('click', () => {
+        if (!logoutDialog.open) {
+          logoutDialog.showModal();
+        }
+      });
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    // Fallback for browsers without native closedby="any" support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const isOutside = (event, dialog) => {
+        const rect = dialog.getBoundingClientRect();
+        return (
+          event.clientX < rect.left ||
+          event.clientX > rect.right ||
+          event.clientY < rect.top ||
+          event.clientY > rect.bottom
+        );
+      };
+
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+
+        dialog.addEventListener('pointerdown', (event) => {
+          pressedOutside = isOutside(event, dialog);
+        });
+
+        dialog.addEventListener('pointerup', (event) => {
+          if (pressedOutside && isOutside(event, dialog)) {
+            dialog.close();
+          }
+        });
+
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          if (isOutside(event, dialog)) {
+            dialog.close();
+          }
+        });
+      }
+    }
+
+    // Handle dialog returnValue and reset it on close
+    logoutDialog?.addEventListener('close', () => {
+      const choice = logoutDialog.returnValue;
+      logoutDialog.returnValue = '';
+      if (choice === 'confirm') {
+        window.location.href = '/logout';
+      }
+    });
+  </script>
+
