+  <script>
+    const dialogTrigger = document.querySelector('.test-dialog-trigger');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const cancelBtn = document.getElementById('cancel-logout');
+
+    if (dialogTrigger && logoutDialog) {
+      dialogTrigger.addEventListener('click', (event) => {
+        event.preventDefault();
+        logoutDialog.showModal();
+      });
+
+      if (cancelBtn) {
+        cancelBtn.addEventListener('click', () => {
+          logoutDialog.close();
+        });
+      }
+
+      logoutDialog.addEventListener('click', (event) => {
+        const rect = logoutDialog.getBoundingClientRect();
+        const isInDialog =
+          event.clientX >= rect.left &&
+          event.clientX <= rect.right &&
+          event.clientY >= rect.top &&
+          event.clientY <= rect.bottom;
+        if (event.target === logoutDialog || !isInDialog) {
+          logoutDialog.close();
+        }
+      });
+    }
+  </script>
+
