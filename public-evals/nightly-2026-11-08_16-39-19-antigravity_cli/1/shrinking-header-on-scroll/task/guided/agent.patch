+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+      const nav = document.querySelector('nav');
+      const logo = document.querySelector('.logo');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const initialHeight = 100;
+      const finalHeight = 50;
+      const scrollDistance = initialHeight - finalHeight;
+
+      const updateNavOnScroll = () => {
+        if (reducedMotionQuery.matches) {
+          nav.style.height = `${initialHeight}px`;
+          nav.style.boxShadow = 'none';
+          if (logo) logo.style.transform = 'scale(1)';
+          return;
+        }
+
+        const scrollY = window.scrollY;
+        const scrollPercent = Math.min(1, Math.max(0, scrollY / scrollDistance));
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+        const logoScale = 1 - 0.15 * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = scrollPercent > 0
+          ? `0 4px 12px rgb(0 0 0 / ${(0.25 * scrollPercent).toFixed(3)})`
+          : 'none';
+        if (logo) {
+          logo.style.transform = `scale(${logoScale})`;
+        }
+      };
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      reducedMotionQuery.addEventListener('change', updateNavOnScroll);
+      updateNavOnScroll();
+    }
+  </script>
+
 </body>
 
