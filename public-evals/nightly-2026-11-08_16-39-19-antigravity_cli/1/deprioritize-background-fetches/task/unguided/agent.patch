diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,96 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Minimal Concurrent Fetch</title>
+  <style>
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+    body {
+      margin: 0;
+      min-height: 100vh;
+      display: grid;
+      place-items: center;
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background-color: #f8fafc;
+      color: #0f172a;
+    }
+    main {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 1rem;
+      padding: 2rem;
+    }
+    button {
+      appearance: none;
+      border: 1px solid #0f172a;
+      background-color: #0f172a;
+      color: #ffffff;
+      font-size: 1rem;
+      font-weight: 500;
+      padding: 0.75rem 1.5rem;
+      border-radius: 0.5rem;
+      cursor: pointer;
+      transition: background-color 150ms ease, transform 100ms ease;
+    }
+    button:hover {
+      background-color: #1e293b;
+    }
+    button:active {
+      transform: translateY(1px);
+    }
+    button:focus-visible {
+      outline: 2px solid #2563eb;
+      outline-offset: 2px;
+    }
+    #status {
+      font-size: 0.875rem;
+      color: #475569;
+      min-height: 1.25rem;
+      margin: 0;
+      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <button id="fetch-btn" type="button">Load Mission-Critical Data</button>
+    <p id="status" aria-live="polite"></p>
+  </main>
+
+  <script>
+    const btn = document.getElementById('fetch-btn');
+    const statusEl = document.getElementById('status');
+
+    btn.addEventListener('click', () => {
+      statusEl.textContent = 'Requesting data...';
+
+      // 1. Mission-critical data request with highest priority
+      const dataPromise = fetch('/api/data', {
+        method: 'GET',
+        priority: 'high'
+      });
+
+      // 2. Concurrent analytics POST request with low priority and keepalive
+      const analyticsPromise = fetch('/api/analytics', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true
+      });
+
+      Promise.allSettled([dataPromise, analyticsPromise]).then(([dataRes, analyticsRes]) => {
+        const dataStatus = dataRes.status === 'fulfilled' ? dataRes.value.status : 'error';
+        const analyticsStatus = analyticsRes.status === 'fulfilled' ? analyticsRes.value.status : 'error';
+        statusEl.textContent = `/api/data: ${dataStatus} | /api/analytics: ${analyticsStatus}`;
+      });
+    });
+  </script>
+</body>
+</html>
