diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,51 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Mission Critical Data Loader</title>
+</head>
+<body>
+  <main>
+    <h1>Data Loader</h1>
+    <button type="button" id="action-btn">Load Data</button>
+    <pre id="output" role="region" aria-label="Loaded data" tabindex="0"><code id="output-code"></code></pre>
+  </main>
+
+  <script type="module">
+    const button = document.getElementById('action-btn');
+    const outputCode = document.getElementById('output-code');
+
+    button.addEventListener('click', async () => {
+      // Use high priority (default) for mission-critical data
+      const dataRequest = fetch('/api/data');
+
+      // Explicitly deprioritize background analytics to prevent network contention
+      const analyticsRequest = fetch('/api/analytics', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+
+      try {
+        const response = await dataRequest;
+        if (response.ok) {
+          const text = await response.text();
+          outputCode.textContent = text;
+        }
+      } catch (error) {
+        console.error('Failed to load mission-critical data:', error);
+      }
+
+      try {
+        await analyticsRequest;
+      } catch (error) {
+        console.error('Failed to send analytics:', error);
+      }
+    });
+  </script>
+</body>
+</html>
