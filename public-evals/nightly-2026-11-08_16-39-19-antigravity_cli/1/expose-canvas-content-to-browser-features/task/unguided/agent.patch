+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const controlsEl = document.getElementById('customizer-controls');
+      const cupLabelEl = document.getElementById('cup-label');
+
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('milk-select');
+      const syrupSelect = document.getElementById('syrup-select');
+
+      const summaryName = document.getElementById('summary-name');
+      const summaryMilk = document.getElementById('summary-milk');
+      const summarySyrup = document.getElementById('summary-syrup');
+
+      const sleeveNameText = document.getElementById('sleeve-name-text');
+      const sleeveMilkText = document.getElementById('sleeve-milk-text');
+      const sleeveSyrupText = document.getElementById('sleeve-syrup-text');
+
+      const milkColors = {
+        'Oat Milk': '#e8d5b7',
+        'Whole Milk': '#f5ebe0',
+        'Almond Milk': '#e3cbb0',
+        'Coconut Milk': '#faf3eb',
+        'Skim Milk': '#ede5dc'
+      };
+
+      const syrupAccents = {
+        'Vermont Maple': '#c86d28',
+        'Madagascar Vanilla': '#e0b76a',
+        'Salted Caramel': '#d4822a',
+        'Roasted Hazelnut': '#8d5531',
+        'No Syrup': '#6d4c41'
+      };
+
+      function syncOrderText() {
+        const currentName = (nameInput.value || '').trim() || 'Guest';
+        const currentMilk = milkSelect.value;
+        const currentSyrup = syrupSelect.value;
+
+        summaryName.textContent = currentName;
+        summaryMilk.textContent = currentMilk;
+        summarySyrup.textContent = currentSyrup;
+
+        sleeveNameText.textContent = currentName;
+        sleeveMilkText.textContent = currentMilk;
+        sleeveSyrupText.textContent = currentSyrup;
+      }
+
+      function drawCoffeeCup(ctx, centerX, centerY, milk, syrup) {
+        ctx.save();
+
+        // Subtle table shadow beneath the cup
+        ctx.beginPath();
+        ctx.ellipse(centerX, centerY + 150, 82, 16, 0, 0, Math.PI * 2);
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.14)';
+        ctx.fill();
+
+        // Rising steam wisps above the lid
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-28, 0, 28].forEach((offsetX, idx) => {
+          ctx.beginPath();
+          const startY = centerY - 148;
+          ctx.moveTo(centerX + offsetX, startY);
+          ctx.bezierCurveTo(
+            centerX + offsetX - 12, startY - 16,
+            centerX + offsetX + 14, startY - 32,
+            centerX + offsetX - 4, startY - 48 - (idx % 2) * 6
+          );
+          ctx.stroke();
+        });
+
+        // Cup main body (tapered paper cup)
+        const topWidth = 104;
+        const bottomWidth = 72;
+        const cupTopY = centerY - 110;
+        const cupBottomY = centerY + 142;
+
+        ctx.beginPath();
+        ctx.moveTo(centerX - topWidth, cupTopY);
+        ctx.lineTo(centerX + topWidth, cupTopY);
+        ctx.lineTo(centerX + bottomWidth, cupBottomY);
+        ctx.quadraticCurveTo(centerX, cupBottomY + 12, centerX - bottomWidth, cupBottomY);
+        ctx.closePath();
+
+        const cupGrad = ctx.createLinearGradient(centerX - topWidth, cupTopY, centerX + topWidth, cupTopY);
+        cupGrad.addColorStop(0, '#f5efe8');
+        cupGrad.addColorStop(0.45, '#ffffff');
+        cupGrad.addColorStop(1, '#e2d7ce');
+        ctx.fillStyle = cupGrad;
+        ctx.fill();
+        ctx.lineWidth = 2.5;
+        ctx.strokeStyle = '#6d4c41';
+        ctx.stroke();
+
+        // Espresso + milk & syrup swirl preview window near top of cup
+        const milkTint = milkColors[milk] || '#e8d5b7';
+        const syrupTint = syrupAccents[syrup] || '#c86d28';
+
+        ctx.beginPath();
+        ctx.moveTo(centerX - 96, cupTopY + 18);
+        ctx.quadraticCurveTo(centerX, cupTopY + 26, centerX + 96, cupTopY + 18);
+        ctx.lineTo(centerX + 92, cupTopY + 46);
+        ctx.quadraticCurveTo(centerX, cupTopY + 54, centerX - 92, cupTopY + 46);
+        ctx.closePath();
+        ctx.fillStyle = milkTint;
+        ctx.fill();
+
+        // Syrup drizzle wave across the crema band
+        ctx.beginPath();
+        ctx.moveTo(centerX - 84, cupTopY + 32);
+        ctx.bezierCurveTo(
+          centerX - 35, cupTopY + 22,
+          centerX + 35, cupTopY + 44,
+          centerX + 84, cupTopY + 30
+        );
+        ctx.strokeStyle = syrupTint;
+        ctx.lineWidth = 4.5;
+        ctx.stroke();
+
+        // Kraft cardboard sleeve in the middle of the cup
+        const sleeveTopY = centerY - 46;
+        const sleeveBottomY = centerY + 86;
+        const sleeveTopHalfW = 95;
+        const sleeveBottomHalfW = 79;
+
+        ctx.beginPath();
+        ctx.moveTo(centerX - sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(centerX + sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(centerX + sleeveBottomHalfW, sleeveBottomY);
+        ctx.lineTo(centerX - sleeveBottomHalfW, sleeveBottomY);
+        ctx.closePath();
+
+        const sleeveGrad = ctx.createLinearGradient(centerX - sleeveTopHalfW, sleeveTopY, centerX + sleeveTopHalfW, sleeveTopY);
+        sleeveGrad.addColorStop(0, '#c39b77');
+        sleeveGrad.addColorStop(0.5, '#d7b38c');
+        sleeveGrad.addColorStop(1, '#b08662');
+        ctx.fillStyle = sleeveGrad;
+        ctx.fill();
+        ctx.lineWidth = 2;
+        ctx.strokeStyle = '#5d4037';
+        ctx.stroke();
+
+        // Cup Lid (two-tier coffee traveler lid)
+        ctx.beginPath();
+        ctx.roundRect(centerX - topWidth - 10, cupTopY - 16, (topWidth + 10) * 2, 18, 6);
+        ctx.fillStyle = '#4e342e';
+        ctx.fill();
+        ctx.strokeStyle = '#3e2723';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        ctx.beginPath();
+        ctx.moveTo(centerX - topWidth + 6, cupTopY - 16);
+        ctx.lineTo(centerX - topWidth + 18, cupTopY - 34);
+        ctx.lineTo(centerX + topWidth - 18, cupTopY - 34);
+        ctx.lineTo(centerX + topWidth - 6, cupTopY - 16);
+        ctx.closePath();
+        ctx.fillStyle = '#5d4037';
+        ctx.fill();
+        ctx.stroke();
+
+        ctx.restore();
+      }
+
+      function drawElementAndSyncTransform(element, x, y) {
+        if (!element) return;
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform = ctx.drawElementImage(element, x, y);
+          if (transform) {
+            element.style.transform = transform.toString();
+          } else if (typeof canvas.getElementTransform === 'function') {
+            const fallbackTransform = canvas.getElementTransform(element, ctx.getTransform().translate(x, y));
+            if (fallbackTransform) {
+              element.style.transform = fallbackTransform.toString();
+            }
+          }
+        }
+      }
+
+      function paintCanvas() {
+        const dpr = window.devicePixelRatio || 1;
+        const cssWidth = canvas.clientWidth || 820;
+        const cssHeight = canvas.clientHeight || 460;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        // Scale the 2D context for crisp rendering on high-DPI displays
+        ctx.scale(dpr, dpr);
+
+        // Warm café backdrop inside the canvas
+        const bgGrad = ctx.createLinearGradient(0, 0, cssWidth, cssHeight);
+        bgGrad.addColorStop(0, '#fdfbf7');
+        bgGrad.addColorStop(1, '#f3eae2');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+        // Decorative café counter bar along the bottom
+        ctx.fillStyle = '#e6d7cd';
+        ctx.fillRect(0, cssHeight - 58, cssWidth, 58);
+        ctx.strokeStyle = '#d7ccc8';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(0, cssHeight - 58);
+        ctx.lineTo(cssWidth, cssHeight - 58);
+        ctx.stroke();
+
+        // Draw the coffee cup on the right half of the canvas
+        const cupCenterX = Math.max(540, Math.round(cssWidth * 0.72));
+        const cupCenterY = Math.round(cssHeight * 0.52);
+        drawCoffeeCup(ctx, cupCenterX, cupCenterY, milkSelect.value, syrupSelect.value);
+
+        // Draw the interactive HTML controls panel and sync its DOM transform
+        const controlsX = 36;
+        const controlsY = Math.max(24, Math.round((cssHeight - (controlsEl.offsetHeight || 360)) / 2));
+        drawElementAndSyncTransform(controlsEl, controlsX, controlsY);
+
+        // Draw the live cup sleeve label HTML directly over the coffee cup sleeve and sync its DOM transform
+        const labelWidth = cupLabelEl.offsetWidth || 176;
+        const labelHeight = cupLabelEl.offsetHeight || 96;
+        const labelX = Math.round(cupCenterX - labelWidth / 2);
+        const labelY = Math.round(cupCenterY + 20 - labelHeight / 2);
+        drawElementAndSyncTransform(cupLabelEl, labelX, labelY);
+      }
+
+      canvas.onpaint = () => {
+        paintCanvas();
+      };
+
+      function requestCanvasPaint() {
+        syncOrderText();
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          paintCanvas();
+        }
+      }
+
+      nameInput.addEventListener('input', requestCanvasPaint);
+      milkSelect.addEventListener('change', requestCanvasPaint);
+      syrupSelect.addEventListener('change', requestCanvasPaint);
+
+      // High-DPI ResizeObserver using device-pixel-content-box when supported
+      const resizeObserver = new ResizeObserver(([entry]) => {
+        if (!entry) return;
+        const dpr = window.devicePixelRatio || 1;
+        if (entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0]) {
+          canvas.width = entry.devicePixelContentBoxSize[0].inlineSize;
+          canvas.height = entry.devicePixelContentBoxSize[0].blockSize;
+        } else {
+          canvas.width = Math.round(entry.contentRect.width * dpr);
+          canvas.height = Math.round(entry.contentRect.height * dpr);
+        }
+        requestCanvasPaint();
+      });
+
+      const supportsDevicePixelBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+
+      try {
+        resizeObserver.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : undefined);
+      } catch (err) {
+        resizeObserver.observe(canvas);
+      }
+
+      requestCanvasPaint();
+    })();
+  </script>
