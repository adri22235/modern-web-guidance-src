+  <script>
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("ui-element");
+    const customizerStage = document.getElementById("customizer-stage");
+
+    const cupNameInput = document.getElementById("cup-name-input");
+    const milkSelect = document.getElementById("milk-select");
+    const syrupSelect = document.getElementById("syrup-select");
+
+    const summaryName = document.getElementById("summary-name");
+    const summaryMilk = document.getElementById("summary-milk");
+    const summarySyrup = document.getElementById("summary-syrup");
+
+    const milkColors = {
+      "Oat Milk": "#ebd9c5",
+      "Whole Milk": "#f7efe6",
+      "Almond Milk": "#e5ceb5",
+      "Coconut Milk": "#f4f0ea"
+    };
+
+    const syrupColors = {
+      "Vermont Maple": "#c66919",
+      "Madagascar Vanilla": "#f0c879",
+      "Salted Caramel": "#d4812a",
+      "Hazelnut": "#7b4b2a",
+      "No Syrup": "#4e342e"
+    };
+
+    function drawCoffeeCup() {
+      const cssWidth = canvas.clientWidth || 780;
+      const cssHeight = canvas.clientHeight || 420;
+      const scaleX = canvas.width / cssWidth;
+      const scaleY = canvas.height / cssHeight;
+
+      const cupName = (cupNameInput.value || "Guest").trim();
+      const milk = milkSelect.value;
+      const syrup = syrupSelect.value;
+
+      ctx.save();
+      ctx.scale(scaleX, scaleY);
+
+      // Subtle warm background accent on right side for the cup preview
+      const cupCenterX = Math.max(580, cssWidth * 0.74);
+      const cupCenterY = cssHeight * 0.54;
+
+      // Saucer / shadow
+      ctx.fillStyle = "rgba(78, 52, 46, 0.1)";
+      ctx.beginPath();
+      ctx.ellipse(cupCenterX, cupCenterY + 135, 92, 16, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Steam wisps
+      ctx.strokeStyle = "rgba(141, 110, 99, 0.4)";
+      ctx.lineWidth = 3;
+      ctx.lineCap = "round";
+      [-24, 0, 24].forEach((offsetX, i) => {
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX + offsetX, cupCenterY - 125);
+        ctx.quadraticCurveTo(
+          cupCenterX + offsetX - 10,
+          cupCenterY - 145 - i * 4,
+          cupCenterX + offsetX + 6,
+          cupCenterY - 165 - i * 4
+        );
+        ctx.stroke();
+      });
+
+      // Cup body (tapered takeaway artisanal cup)
+      ctx.fillStyle = milkColors[milk] || "#ebd9c5";
+      ctx.strokeStyle = "#4e342e";
+      ctx.lineWidth = 3;
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - 75, cupCenterY - 90);
+      ctx.lineTo(cupCenterX + 75, cupCenterY - 90);
+      ctx.lineTo(cupCenterX + 55, cupCenterY + 125);
+      ctx.lineTo(cupCenterX - 55, cupCenterY + 125);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Syrup drizzle band near top of cup
+      ctx.fillStyle = syrupColors[syrup] || "#c66919";
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - 72, cupCenterY - 72);
+      ctx.lineTo(cupCenterX + 72, cupCenterY - 72);
+      ctx.lineTo(cupCenterX + 70, cupCenterY - 52);
+      ctx.lineTo(cupCenterX - 70, cupCenterY - 52);
+      ctx.closePath();
+      ctx.fill();
+
+      // Kraft cardboard sleeve
+      ctx.fillStyle = "#c8a986";
+      ctx.strokeStyle = "#4e342e";
+      ctx.lineWidth = 2.5;
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - 68, cupCenterY - 30);
+      ctx.lineTo(cupCenterX + 68, cupCenterY - 30);
+      ctx.lineTo(cupCenterX + 60, cupCenterY + 58);
+      ctx.lineTo(cupCenterX - 60, cupCenterY + 58);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Cup lid
+      ctx.fillStyle = "#4e342e";
+      ctx.beginPath();
+      ctx.roundRect(cupCenterX - 84, cupCenterY - 110, 168, 22, 6);
+      ctx.fill();
+      ctx.fillStyle = "#3e2723";
+      ctx.beginPath();
+      ctx.roundRect(cupCenterX - 72, cupCenterY - 120, 144, 12, 4);
+      ctx.fill();
+
+      // Handwritten-style cup markings on sleeve
+      ctx.fillStyle = "#3e2723";
+      ctx.textAlign = "center";
+      ctx.font = "bold 16px 'Segoe UI', sans-serif";
+      ctx.fillText(cupName, cupCenterX, cupCenterY + 5);
+
+      ctx.font = "12px 'Segoe UI', sans-serif";
+      ctx.fillStyle = "#4e342e";
+      ctx.fillText(milk, cupCenterX, cupCenterY + 25);
+      ctx.fillText(syrup, cupCenterX, cupCenterY + 43);
+
+      ctx.restore();
+    }
+
+    function updateOrderSummary() {
+      const cupName = (cupNameInput.value || "Guest").trim();
+      summaryName.textContent = cupName;
+      summaryMilk.textContent = milkSelect.value;
+      summarySyrup.textContent = syrupSelect.value;
+
+      if ("content" in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        drawCoffeeCup();
+      }
+    }
+
+    canvas.onpaint = (event) => {
+      ctx.reset();
+      drawCoffeeCup();
+      // Draw the interactive HTML element at x:24, y:24; browser syncs DOM hit-test geometry
+      ctx.drawElementImage(uiElement, 24, 24);
+    };
+
+    if ("content" in HTMLCanvasElement.prototype) {
+      // Use HTML in Canvas API
+      canvas.requestPaint();
+    } else {
+      // Fallback strategy: style fallback state and render the 2D cup preview
+      customizerStage.classList.add("canvas-fallback");
+      drawCoffeeCup();
+    }
+
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+      if ("content" in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        drawCoffeeCup();
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    cupNameInput.addEventListener("input", updateOrderSummary);
+    milkSelect.addEventListener("change", updateOrderSummary);
+    syrupSelect.addEventListener("change", updateOrderSummary);
+  </script>
 </body>
 
