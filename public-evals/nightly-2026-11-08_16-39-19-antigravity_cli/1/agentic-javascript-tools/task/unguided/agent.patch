diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,225 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const TOOL_NAME = 'get_menu_item_details';
+
+      const MENU_ITEMS = [
+        {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          category: 'Seasonal Favorites',
+          price: '$5.75',
+          calories: 210,
+          sizes: ['Small (12oz)', 'Medium (16oz)', 'Large (20oz)'],
+          ingredients: ['Espresso', 'Steamed oat milk', 'Pure Vermont maple syrup', 'Cinnamon dusting'],
+          dietary: ['Dairy-Free', 'Vegan', 'Plant-Based'],
+          url: '/menu/seasonal'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          category: 'Espresso',
+          price: '$3.50',
+          calories: 10,
+          sizes: ['Single Shot', 'Double Shot', 'Quad Shot'],
+          ingredients: ['100% Arabica dark-roasted coffee beans', 'Filtered water'],
+          dietary: ['Dairy-Free', 'Vegan', 'Gluten-Free', 'Sugar-Free'],
+          url: '/menu/espresso'
+        },
+        {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          category: 'Cold Coffee',
+          price: '$4.75',
+          calories: 15,
+          sizes: ['Medium (16oz)', 'Large (20oz)', 'Extra Large (24oz)'],
+          ingredients: ['Coarse-ground artisanal coffee blend', 'Cold filtered water'],
+          dietary: ['Dairy-Free', 'Vegan', 'Gluten-Free', 'Unsweetened'],
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      function getMenuItemsFromPage() {
+        const itemsByName = new Map();
+        for (const item of MENU_ITEMS) {
+          itemsByName.set(item.name.toLowerCase(), { ...item });
+        }
+
+        const cards = document.querySelectorAll('.card');
+        cards.forEach((card) => {
+          const titleEl = card.querySelector('h3');
+          const descEl = card.querySelector('p');
+          const linkEl = card.querySelector('a');
+          if (!titleEl) return;
+
+          const name = titleEl.textContent.trim();
+          const key = name.toLowerCase();
+          const description = descEl ? descEl.textContent.trim() : '';
+          const url = linkEl ? linkEl.getAttribute('href') : '';
+
+          if (itemsByName.has(key)) {
+            const existing = itemsByName.get(key);
+            if (description) existing.description = description;
+            if (url) existing.url = url;
+          } else {
+            itemsByName.set(key, {
+              name,
+              description,
+              category: 'Menu',
+              url
+            });
+          }
+        });
+
+        return Array.from(itemsByName.values());
+      }
+
+      function findMenuItemByName(rawInput) {
+        const query = (
+          typeof rawInput === 'string'
+            ? rawInput
+            : rawInput?.name ?? rawInput?.itemName ?? rawInput?.item_name ?? rawInput?.item ?? rawInput?.query ?? ''
+        )
+          .toString()
+          .trim()
+          .toLowerCase();
+
+        const items = getMenuItemsFromPage();
+        if (!query) {
+          return {
+            found: false,
+            error: 'Please provide the name of a menu item to look up.',
+            availableItems: items.map((i) => i.name)
+          };
+        }
+
+        const exactMatch = items.find((item) => item.name.toLowerCase() === query);
+        const partialMatch =
+          exactMatch ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(query) ||
+              query.includes(item.name.toLowerCase())
+          );
+
+        if (!partialMatch) {
+          const notFoundText = `Menu item "${query}" was not found. Available items: ${items.map((i) => i.name).join(', ')}.`;
+          const notFoundResult = {
+            found: false,
+            error: notFoundText,
+            message: notFoundText,
+            availableItems: items.map((i) => i.name),
+            content: [{ type: 'text', text: notFoundText }]
+          };
+          Object.defineProperty(notFoundResult, 'toString', {
+            value: () => notFoundText,
+            enumerable: false
+          });
+          return notFoundResult;
+        }
+
+        const summaryText = `${partialMatch.name}: ${partialMatch.description}${partialMatch.price ? ` (Price: ${partialMatch.price})` : ''}`;
+        const result = {
+          found: true,
+          ...partialMatch,
+          item: { ...partialMatch },
+          content: [{ type: 'text', text: summaryText }]
+        };
+        Object.defineProperty(result, 'toString', {
+          value: () => summaryText,
+          enumerable: false
+        });
+        return result;
+      }
+
+      const inputSchema = {
+        type: 'object',
+        properties: {
+          name: {
+            type: 'string',
+            description:
+              'The name of the menu item to look up details for (e.g., "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew").'
+          }
+        },
+        required: ['name']
+      };
+
+      const menuLookupTool = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item at The Daily Grind by name (such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew), returning its description, price, ingredients, sizes, and dietary information.',
+        inputSchema,
+        parameters: inputSchema,
+        annotations: {
+          readOnlyHint: true
+        },
+        execute: async (input) => {
+          return findMenuItemByName(input);
+        }
+      };
+
+      const abortController = new AbortController();
+      let registrationHandle = null;
+
+      function registerMenuTool() {
+        try {
+          if (navigator.modelContext && typeof navigator.modelContext.registerTool === 'function') {
+            registrationHandle = navigator.modelContext.registerTool(menuLookupTool, {
+              signal: abortController.signal
+            });
+          } else if (document.modelContext && typeof document.modelContext.registerTool === 'function') {
+            registrationHandle = document.modelContext.registerTool(menuLookupTool, {
+              signal: abortController.signal
+            });
+          }
+        } catch (err) {
+          console.warn('Failed to register menu lookup tool:', err);
+        }
+      }
+
+      function cleanupMenuTool() {
+        abortController.abort();
+
+        if (navigator.modelContext && typeof navigator.modelContext.unregisterTool === 'function') {
+          try {
+            navigator.modelContext.unregisterTool(TOOL_NAME);
+          } catch (err) {
+            // Ignore errors if already unregistered
+          }
+        } else if (document.modelContext && typeof document.modelContext.unregisterTool === 'function') {
+          try {
+            document.modelContext.unregisterTool(TOOL_NAME);
+          } catch (err) {
+            // Ignore errors if already unregistered
+          }
+        }
+
+        if (registrationHandle) {
+          if (typeof registrationHandle.unregister === 'function') {
+            registrationHandle.unregister();
+          } else if (typeof registrationHandle.then === 'function') {
+            registrationHandle
+              .then((resolved) => {
+                if (resolved && typeof resolved.unregister === 'function') {
+                  resolved.unregister();
+                }
+              })
+              .catch(() => {});
+          }
+        }
+      }
+
+      registerMenuTool();
+
+      window.addEventListener('pagehide', cleanupMenuTool);
+      window.addEventListener('beforeunload', cleanupMenuTool);
+      window.addEventListener('unload', cleanupMenuTool);
+    })();
+  </script>
+
 </body>
 
 </html>
