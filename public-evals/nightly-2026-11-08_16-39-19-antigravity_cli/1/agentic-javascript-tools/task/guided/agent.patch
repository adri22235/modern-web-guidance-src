diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,91 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        category: "Seasonal Favorites",
+        price: "$5.50",
+        calories: 240,
+        ingredients: ["Espresso", "Oat milk", "Vermont maple syrup"],
+        detailsUrl: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        category: "Seasonal Favorites",
+        price: "$3.25",
+        calories: 15,
+        ingredients: ["Dark roast espresso beans", "Filtered water"],
+        detailsUrl: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        category: "Seasonal Favorites",
+        price: "$4.50",
+        calories: 10,
+        ingredients: ["Coarse-ground coffee beans", "Cold filtered water"],
+        detailsUrl: "/menu/cold-brew",
+      },
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      window.addEventListener("pagehide", () => {
+        controller.abort();
+      });
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Retrieves details for a coffee shop menu item, including its description, price, nutritional info, and page link. Use when the user asks about a specific drink or item on the menu.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "The name of the menu item to look up.",
+              },
+            },
+            required: ["itemName"],
+          },
+          execute({ itemName } = {}) {
+            if (typeof itemName !== "string" || itemName.trim() === "") {
+              return {
+                error: "Pass a valid menu item name.",
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            const normalizedName = itemName.trim().toLowerCase();
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === normalizedName
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${itemName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
