+export class CoffeeMenuSection extends HTMLElement {
+  static observedAttributes = ['active-roast', 'favorites-only'];
+
+  #internals;
+  #orderCount = 0;
+  #orderTotal = 0;
+  #boundSlotChange;
+  #boundControlsClick;
+  #boundOrderAdd;
+  #boundFavChange;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [menuSheet];
+    this.shadowRoot.append(menuTemplate.content.cloneNode(true));
+
+    this.#boundSlotChange = () => this.#applyFilters();
+    this.#boundControlsClick = (e) => this.#handleControlsClick(e);
+    this.#boundOrderAdd = (e) => this.#handleOrderAdd(e);
+    this.#boundFavChange = () => this.#applyFilters();
+  }
+
+  connectedCallback() {
+    const defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+    const controls = this.shadowRoot.querySelector('.controls');
+
+    defaultSlot.removeEventListener('slotchange', this.#boundSlotChange);
+    controls.removeEventListener('click', this.#boundControlsClick);
+    this.removeEventListener('coffee-order-add', this.#boundOrderAdd);
+    this.removeEventListener('coffee-favorite-change', this.#boundFavChange);
+
+    defaultSlot.addEventListener('slotchange', this.#boundSlotChange);
+    controls.addEventListener('click', this.#boundControlsClick);
+    this.addEventListener('coffee-order-add', this.#boundOrderAdd);
+    this.addEventListener('coffee-favorite-change', this.#boundFavChange);
+
+    this.#applyFilters();
+  }
+
+  disconnectedCallback() {
+    const defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+    const controls = this.shadowRoot.querySelector('.controls');
+
+    defaultSlot?.removeEventListener('slotchange', this.#boundSlotChange);
+    controls?.removeEventListener('click', this.#boundControlsClick);
+    this.removeEventListener('coffee-order-add', this.#boundOrderAdd);
+    this.removeEventListener('coffee-favorite-change', this.#boundFavChange);
+  }
+
+  get activeRoast() { return this.getAttribute('active-roast') ?? 'all'; }
+  set activeRoast(v) {
+    v && v !== 'all' ? this.setAttribute('active-roast', v) : this.removeAttribute('active-roast');
+  }
+
+  get favoritesOnly() { return this.hasAttribute('favorites-only'); }
+  set favoritesOnly(on) { this.toggleAttribute('favorites-only', !!on); }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.isConnected) {
+      this.#applyFilters();
+    }
+  }
+
+  #handleControlsClick(e) {
+    const roastBtn = e.target.closest('.filter-btn');
+    if (roastBtn) {
+      this.activeRoast = roastBtn.dataset.roast;
+      return;
+    }
+
+    const favOnlyBtn = e.target.closest('.fav-only-btn');
+    if (favOnlyBtn) {
+      this.favoritesOnly = !this.favoritesOnly;
+    }
+  }
+
+  #handleOrderAdd(e) {
+    const { price = 0 } = e.detail || {};
+    this.#orderCount += 1;
+    this.#orderTotal += Number(price) || 0;
+    this.#internals.states.add('has-orders');
+    const bagSummary = this.shadowRoot.querySelector('.bag-summary');
+    if (bagSummary) {
+      bagSummary.textContent = `${this.#orderCount} ${this.#orderCount === 1 ? 'item' : 'items'} ($${this.#orderTotal.toFixed(2)})`;
+    }
+  }
+
+  #applyFilters() {
+    const defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+    if (!defaultSlot) return;
+
+    const roastFilter = this.activeRoast;
+    const favOnly = this.favoritesOnly;
+
+    if (roastFilter !== 'all' || favOnly) {
+      this.#internals.states.add('filtered');
+    } else {
+      this.#internals.states.delete('filtered');
+    }
+
+    const filterButtons = this.shadowRoot.querySelectorAll('.filter-btn');
+    for (const btn of filterButtons) {
+      btn.setAttribute('aria-pressed', String(btn.dataset.roast === roastFilter));
+    }
+
+    const favOnlyBtn = this.shadowRoot.querySelector('.fav-only-btn');
+    if (favOnlyBtn) {
+      favOnlyBtn.setAttribute('aria-pressed', String(favOnly));
+    }
+
+    const cards = defaultSlot.assignedElements().filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+    let visibleCount = 0;
+
+    for (const card of cards) {
+      const cardRoast = card.getAttribute('roast') ?? 'Medium';
+      const isFav = card.hasAttribute('favorited');
+      const matchesRoast = roastFilter === 'all' || cardRoast.toLowerCase() === roastFilter.toLowerCase();
+      const matchesFav = !favOnly || isFav;
+      const show = matchesRoast && matchesFav;
+
+      card.hidden = !show;
+      if (show) visibleCount += 1;
+    }
+
+    const countEl = this.shadowRoot.querySelector('.results-count');
+    if (countEl) {
+      countEl.textContent = `Showing ${visibleCount} of ${cards.length} coffees`;
+    }
+
+    const emptyEl = this.shadowRoot.querySelector('.empty-state');
+    if (emptyEl) {
+      emptyEl.hidden = cards.length === 0 || visibleCount > 0;
+    }
+  }
+}
