+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+if (!customElements.get('coffee-menu-section')) {
+  customElements.define('coffee-menu-section', CoffeeMenuSection);
+}
+if (!customElements.get('brew-finder')) {
+  customElements.define('brew-finder', BrewFinder);
+}
