+    </div>
+  </section>
+`;
+
+export class BrewFinder extends HTMLElement {
+  #selectedRoast = 'Medium';
+  #boundChange;
+  #boundApply;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.shadowRoot.adoptedStyleSheets = [finderSheet];
+    this.shadowRoot.append(finderTemplate.content.cloneNode(true));
+
+    this.#boundChange = (e) => this.#onMethodChange(e);
+    this.#boundApply = () => this.#onApplyFilter();
+  }
+
+  connectedCallback() {
+    const fieldset = this.shadowRoot.querySelector('fieldset');
+    const applyBtn = this.shadowRoot.querySelector('.apply-btn');
+
+    fieldset.removeEventListener('change', this.#boundChange);
+    applyBtn.removeEventListener('click', this.#boundApply);
+
+    fieldset.addEventListener('change', this.#boundChange);
+    applyBtn.addEventListener('click', this.#boundApply);
+  }
+
+  disconnectedCallback() {
+    const fieldset = this.shadowRoot.querySelector('fieldset');
+    const applyBtn = this.shadowRoot.querySelector('.apply-btn');
+
+    fieldset?.removeEventListener('change', this.#boundChange);
+    applyBtn?.removeEventListener('click', this.#boundApply);
+  }
+
+  #onMethodChange(e) {
+    const input = e.target.closest('input[type="radio"]');
+    if (!input) return;
+    this.#selectedRoast = input.value;
+    const matchName = this.shadowRoot.querySelector('.match-name');
+    if (matchName) {
+      matchName.textContent = input.dataset.match || '';
+    }
+  }
+
+  #onApplyFilter() {
+    this.dispatchEvent(new CustomEvent('brew-filter-select', {
+      bubbles: true,
+      composed: true,
+      detail: { roast: this.#selectedRoast }
+    }));
+
+    const menuSection = document.querySelector('coffee-menu-section');
+    if (menuSection) {
+      menuSection.activeRoast = this.#selectedRoast;
+      menuSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    }
+  }
+}
