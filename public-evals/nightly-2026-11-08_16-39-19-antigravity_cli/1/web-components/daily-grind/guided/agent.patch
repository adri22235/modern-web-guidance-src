+const finderTemplate = document.createElement('template');
+finderTemplate.innerHTML = `
+  <section class="finder" part="finder">
+    <h2>Interactive Brew Finder</h2>
+    <p class="subtitle">Select how you brew at home to get a tailored Daily Grind roast match.</p>
