+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'price',
+    'href',
+    'image',
+    'image-alt',
+    'roast',
+    'notes',
+    'badge',
+    'favorited'
+  ];
+
+  #internals;
+  #expanded = false;
+  #cartCount = 0;
+  #boundDetailsClick;
+  #boundFavClick;
+  #boundAddClick;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [cardSheet];
+    this.shadowRoot.append(cardTemplate.content.cloneNode(true));
+
+    this.#boundDetailsClick = () => this.toggleDetails();
+    this.#boundFavClick = () => this.toggleFavorite();
+    this.#boundAddClick = () => this.addToOrder();
+  }
+
+  connectedCallback() {
+    const detailsBtn = this.shadowRoot.querySelector('.btn-details');
+    const favBtn = this.shadowRoot.querySelector('.btn-fav');
+    const addBtn = this.shadowRoot.querySelector('.btn-add');
+
+    detailsBtn.removeEventListener('click', this.#boundDetailsClick);
+    favBtn.removeEventListener('click', this.#boundFavClick);
+    addBtn.removeEventListener('click', this.#boundAddClick);
+
+    detailsBtn.addEventListener('click', this.#boundDetailsClick);
+    favBtn.addEventListener('click', this.#boundFavClick);
+    addBtn.addEventListener('click', this.#boundAddClick);
+
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    const detailsBtn = this.shadowRoot.querySelector('.btn-details');
+    const favBtn = this.shadowRoot.querySelector('.btn-fav');
+    const addBtn = this.shadowRoot.querySelector('.btn-add');
+
+    detailsBtn?.removeEventListener('click', this.#boundDetailsClick);
+    favBtn?.removeEventListener('click', this.#boundFavClick);
+    addBtn?.removeEventListener('click', this.#boundAddClick);
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { v ? this.setAttribute('name', v) : this.removeAttribute('name'); }
+
+  get price() { return Number(this.getAttribute('price')) || 0; }
+  set price(v) { this.setAttribute('price', String(v)); }
+
+  get href() { return this.getAttribute('href') ?? '#'; }
+  set href(v) { v ? this.setAttribute('href', v) : this.removeAttribute('href'); }
+
+  get image() { return this.getAttribute('image') ?? ''; }
+  set image(v) { v ? this.setAttribute('image', v) : this.removeAttribute('image'); }
+
+  get imageAlt() { return this.getAttribute('image-alt') ?? ''; }
+  set imageAlt(v) { v ? this.setAttribute('image-alt', v) : this.removeAttribute('image-alt'); }
+
+  get roast() { return this.getAttribute('roast') ?? 'Medium'; }
+  set roast(v) { v ? this.setAttribute('roast', v) : this.removeAttribute('roast'); }
+
+  get notes() { return this.getAttribute('notes') ?? ''; }
+  set notes(v) { v ? this.setAttribute('notes', v) : this.removeAttribute('notes'); }
+
+  get badge() { return this.getAttribute('badge') ?? ''; }
+  set badge(v) { v ? this.setAttribute('badge', v) : this.removeAttribute('badge'); }
+
+  get favorited() { return this.hasAttribute('favorited'); }
+  set favorited(on) { this.toggleAttribute('favorited', !!on); }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.isConnected) {
+      this.#render();
+    }
+  }
+
+  toggleDetails(force) {
+    this.#expanded = typeof force === 'boolean' ? force : !this.#expanded;
+    if (this.#expanded) {
+      this.#internals.states.add('expanded');
+    } else {
+      this.#internals.states.delete('expanded');
+    }
+    this.#renderDetailsState();
+    this.dispatchEvent(new CustomEvent('coffee-details-toggle', {
+      bubbles: true,
+      composed: true,
+      detail: { name: this.name, expanded: this.#expanded }
+    }));
+  }
+
+  toggleFavorite(force) {
+    const next = typeof force === 'boolean' ? force : !this.favorited;
+    this.favorited = next;
+    this.dispatchEvent(new CustomEvent('coffee-favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { name: this.name, favorited: this.favorited }
+    }));
+  }
+
+  addToOrder() {
+    this.#cartCount += 1;
+    this.#internals.states.add('in-cart');
+    const addBtn = this.shadowRoot.querySelector('.btn-add');
+    if (addBtn) {
+      addBtn.textContent = `Added (${this.#cartCount})`;
+    }
+    this.dispatchEvent(new CustomEvent('coffee-order-add', {
+      bubbles: true,
+      composed: true,
+      detail: {
+        name: this.name,
+        price: this.price,
+        roast: this.roast,
+        count: this.#cartCount
+      }
+    }));
+  }
+
+  #renderDetailsState() {
+    const detailsPanel = this.shadowRoot.querySelector('.details-panel');
+    const detailsBtn = this.shadowRoot.querySelector('.btn-details');
+    if (detailsPanel && detailsBtn) {
+      detailsPanel.hidden = !this.#expanded;
+      detailsBtn.setAttribute('aria-expanded', String(this.#expanded));
+    }
+  }
+
+  #render() {
+    const img = this.shadowRoot.querySelector('img');
+    const badgeEl = this.shadowRoot.querySelector('.badge');
+    const linkEl = this.shadowRoot.querySelector('.card-link');
+    const priceEl = this.shadowRoot.querySelector('.price');
+    const roastEl = this.shadowRoot.querySelector('.roast-val');
+    const notesEl = this.shadowRoot.querySelector('.notes-val');
+    const favBtn = this.shadowRoot.querySelector('.btn-fav');
+    const favLabel = this.shadowRoot.querySelector('.fav-label');
+
+    if (this.image) {
+      img.src = this.image;
+      img.alt = this.imageAlt;
+      img.hidden = false;
+    } else {
+      img.removeAttribute('src');
+      img.hidden = true;
+    }
+
+    if (this.badge) {
+      badgeEl.textContent = this.badge;
+      badgeEl.hidden = false;
+    } else {
+      badgeEl.textContent = '';
+      badgeEl.hidden = true;
+    }
+
+    linkEl.textContent = this.name;
+    linkEl.href = this.href;
+
+    priceEl.textContent = this.price > 0 ? `$${this.price.toFixed(2)}` : '';
+    roastEl.textContent = this.roast;
+    notesEl.textContent = this.notes || 'Balanced & smooth';
+
+    const isFav = this.favorited;
+    if (isFav) {
+      this.#internals.states.add('favorited');
+    } else {
+      this.#internals.states.delete('favorited');
+    }
+
+    if (favBtn && favLabel) {
+      favBtn.setAttribute('aria-pressed', String(isFav));
+      favBtn.setAttribute('aria-label', `${isFav ? 'Remove' : 'Save'} ${this.name} ${isFav ? 'from' : 'to'} favorites`);
+      favLabel.textContent = isFav ? 'Saved' : 'Save';
+    }
+
+    this.#renderDetailsState();
+  }
+}
