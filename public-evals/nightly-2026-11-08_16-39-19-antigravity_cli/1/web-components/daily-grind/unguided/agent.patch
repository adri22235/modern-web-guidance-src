+  }
+
+  _calculateCalories() {
+    const baseCal = this._state.base === 'Cold Brew' ? 15 : this._state.base === 'Americano' ? 15 : 90;
+    const milkCal =
+      this._state.milk === 'Whole Milk' ? 110 :
+      this._state.milk === 'Oat Milk' ? 80 :
+      this._state.milk === 'Almond Milk' ? 40 : 0;
