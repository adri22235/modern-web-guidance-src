+/**
+ * 3. <dg-coffee-card>
+ * Reusable, accessible coffee product card Web Component.
+ * Features:
+ * - Stock image with fallback, roast badge, dietary tags, price & calorie display
+ * - Interactive size selector (Small 12oz, Medium 16oz, Large 20oz) with live price update
+ * - Expandable "Tasting Notes & Details" disclosure (`aria-expanded`, `aria-controls`)
+ * - "Add to Order" button & favorite toggle button dispatching composed CustomEvents
+ */
+class DgCoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'coffee-id',
+      'name',
+      'category',
+      'roast',
+      'price',
+      'calories',
+      'image',
+      'image-alt',
+      'description',
+      'notes',
+      'origin',
+      'dietary',
+      'href',
+      'featured'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = 'Medium';
+    this._sizeDelta = { Small: -0.5, Medium: 0, Large: 0.75 };
+    this._detailsExpanded = false;
+    this._favorited = false;
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.shadowRoot.innerHTML) {
+      this.render();
+    }
+  }
+
+  get basePrice() {
+    return parseFloat(this.getAttribute('price') || '4.75');
+  }
+
+  get currentPrice() {
+    const delta = this._sizeDelta[this._selectedSize] || 0;
+    return (this.basePrice + delta).toFixed(2);
+  }
+
+  _updatePriceUI() {
+    const priceEl = this.shadowRoot.querySelector('.price-value');
+    if (priceEl) {
+      priceEl.textContent = `$${this.currentPrice}`;
+    }
+    const sizeBtns = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeBtns.forEach(btn => {
+      const isSelected = btn.dataset.size === this._selectedSize;
+      btn.setAttribute('aria-pressed', String(isSelected));
+      btn.classList.toggle('active', isSelected);
+    });
+  }
+
+  _toggleDetails() {
+    this._detailsExpanded = !this._detailsExpanded;
+    const toggleBtn = this.shadowRoot.querySelector('.details-toggle');
+    const panel = this.shadowRoot.querySelector('.details-panel');
+    if (toggleBtn && panel) {
+      toggleBtn.setAttribute('aria-expanded', String(this._detailsExpanded));
+      toggleBtn.querySelector('.toggle-label').textContent = this._detailsExpanded ? 'Hide Details' : 'View Details';
+      panel.hidden = !this._detailsExpanded;
+    }
+    this.dispatchEvent(new CustomEvent('dg-card-details-toggle', {
+      bubbles: true,
+      composed: true,
+      detail: {
+        id: this.getAttribute('coffee-id') || this.getAttribute('name'),
+        expanded: this._detailsExpanded
+      }
+    }));
+  }
+
+  _toggleFavorite() {
+    this._favorited = !this._favorited;
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    const name = this.getAttribute('name') || 'Coffee';
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(this._favorited));
+      favBtn.setAttribute('aria-label', this._favorited ? `Remove ${name} from favorites` : `Save ${name} to favorites`);
+      favBtn.classList.toggle('favorited', this._favorited);
+    }
+    this.dispatchEvent(new CustomEvent('dg-favorite-toggle', {
+      bubbles: true,
+      composed: true,
+      detail: {
+        id: this.getAttribute('coffee-id') || name,
+        name,
+        favorited: this._favorited
+      }
+    }));
+  }
+
+  _handleAddToCart() {
+    const id = this.getAttribute('coffee-id') || this.getAttribute('name') || 'coffee-item';
+    const name = this.getAttribute('name') || 'Artisanal Coffee';
+    const price = parseFloat(this.currentPrice);
+    const size = this._selectedSize;
+    const image = this.getAttribute('image') || '';
+
+    const addBtn = this.shadowRoot.querySelector('.add-btn');
+    const liveStatus = this.shadowRoot.querySelector('.card-live-status');
+    if (addBtn) {
+      const originalText = addBtn.querySelector('.btn-text').textContent;
+      addBtn.classList.add('added');
+      addBtn.querySelector('.btn-text').textContent = 'Added to Bag!';
+      if (liveStatus) {
+        liveStatus.textContent = `Added ${size} ${name} ($${price.toFixed(2)}) to your bag.`;
+      }
+      setTimeout(() => {
+        if (addBtn.isConnected) {
+          addBtn.classList.remove('added');
+          addBtn.querySelector('.btn-text').textContent = originalText;
+        }
+      }, 1300);
+    }
+
+    this.dispatchEvent(new CustomEvent('dg-add-to-cart', {
+      bubbles: true,
+      composed: true,
+      detail: { id, name, size, price, image, quantity: 1 }
+    }));
+  }
+
