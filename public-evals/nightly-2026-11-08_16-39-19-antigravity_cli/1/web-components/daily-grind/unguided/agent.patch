+/**
+ * 1. <dg-navbar>
+ * Accessible responsive navigation bar with interactive cart counter and mobile drawer toggle.
+ */
+class DgNavbar extends HTMLElement {
+  static get observedAttributes() {
+    return ['brand', 'cart-count'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._mobileMenuOpen = false;
+    this._handleCartEvent = this._handleCartEvent.bind(this);
+    this._handleKeyDown = this._handleKeyDown.bind(this);
+  }
+
+  connectedCallback() {
+    this.render();
+    window.addEventListener('dg-cart-updated', this._handleCartEvent);
+    this.shadowRoot.addEventListener('keydown', this._handleKeyDown);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('dg-cart-updated', this._handleCartEvent);
+    this.shadowRoot.removeEventListener('keydown', this._handleKeyDown);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.shadowRoot.innerHTML) {
+      if (name === 'cart-count') {
+        const badge = this.shadowRoot.querySelector('.cart-badge');
+        const btn = this.shadowRoot.querySelector('.cart-btn');
+        if (badge && btn) {
+          badge.textContent = newVal || '0';
+          btn.setAttribute('aria-label', `Shopping bag, ${newVal || 0} items`);
+          badge.classList.remove('bump');
+          void badge.offsetWidth;
+          badge.classList.add('bump');
+        }
+      } else {
+        this.render();
+      }
+    }
+  }
+
+  _handleCartEvent(e) {
+    const totalCount = e.detail?.totalCount ?? 0;
+    this.setAttribute('cart-count', String(totalCount));
+  }
+
+  _handleKeyDown(e) {
+    if (e.key === 'Escape' && this._mobileMenuOpen) {
+      this._toggleMobileMenu(false);
+      this.shadowRoot.querySelector('.menu-toggle')?.focus();
+    }
+  }
+
+  _toggleMobileMenu(forceState) {
+    this._mobileMenuOpen = typeof forceState === 'boolean' ? forceState : !this._mobileMenuOpen;
+    const toggleBtn = this.shadowRoot.querySelector('.menu-toggle');
+    const navList = this.shadowRoot.querySelector('.nav-links');
+    if (toggleBtn && navList) {
+      toggleBtn.setAttribute('aria-expanded', String(this._mobileMenuOpen));
+      navList.classList.toggle('open', this._mobileMenuOpen);
+    }
+  }
+
+  render() {
+    const brand = this.getAttribute('brand') || 'THE DAILY GRIND';
+    const cartCount = this.getAttribute('cart-count') || '0';
+
+    this.shadowRoot.innerHTML = `
