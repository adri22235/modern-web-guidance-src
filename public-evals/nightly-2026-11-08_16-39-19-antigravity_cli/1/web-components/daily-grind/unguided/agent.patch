+      </style>
+      <nav aria-label="Primary Navigation">
+        <a href="#top" class="brand-wrap">
+          <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true">
+            <path d="M2 21h18v-2H2v2zM20 8h-2V5h2c1.1 0 2 .9 2 2v1c0 1.1-.9 2-2 2zm-2 2v3c0 2.76-2.24 5-5 5H9c-2.76 0-5-2.24-5-5V5h14v3h2c2.21 0 4-1.79 4-4v-1c0-2.21-1.79-4-4-4H4c-1.1 0-2 .9-2 2v10c0 3.87 3.13 7 7 7h4c3.87 0 7-3.13 7-7v-3h-2z"/>
+          </svg>
