+      const cat = (card.getAttribute('category') || '').toLowerCase();
+      const name = (card.getAttribute('name') || '').toLowerCase();
+      const desc = (card.getAttribute('description') || card.textContent || '').toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const dietary = (card.getAttribute('dietary') || '').toLowerCase();
+
+      const matchesCategory =
+        this._activeCategory === 'all' || cat.includes(this._activeCategory);
+      const matchesQuery =
+        !query ||
+        name.includes(query) ||
+        desc.includes(query) ||
