+/**
+ * Reusable, accessible Web Components for The Daily Grind homepage.
+ * All components use Shadow DOM for encapsulated styling and behavior,
+ * inherit design tokens via CSS custom properties, and follow WAI-ARIA best practices.
+ */
+
+// Shared CSS Custom Properties & Reset helper for Shadow DOM
+const sharedStyles = `
+  :host {
+    box-sizing: border-box;
+    font-family: var(--font-sans, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif);
+    color: var(--text, #3e2723);
+  }
+  *, *::before, *::after {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+  :focus-visible {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 2px;
+  }
+  .sr-only {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+`;
