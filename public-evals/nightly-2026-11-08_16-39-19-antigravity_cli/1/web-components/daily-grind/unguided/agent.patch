+          return parseFloat(a.getAttribute('price') || '0') - parseFloat(b.getAttribute('price') || '0');
+        }
+        if (this._sortBy === 'price-desc') {
+          return parseFloat(b.getAttribute('price') || '0') - parseFloat(a.getAttribute('price') || '0');
+        }
