diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,152 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Visually Stable Mixed Fonts &amp; Independent Theme Typography</title>
+  <style>
+    @layer base, theme, components;
+
+    @layer base {
+      :root {
+        --font-primary: Verdana, Geneva, Tahoma, sans-serif;
+        --font-code: "Courier New", Courier, monospace;
+        --font-independent-theme: "Times New Roman", Times, Georgia, serif;
+        --color-bg: #f8fafc;
+        --color-surface: #ffffff;
+        --color-surface-alt: #f1f5f9;
+        --color-code-bg: #e2e8f0;
+        --color-text: #0f172a;
+        --color-text-muted: #475569;
+        --color-border: #cbd5e1;
+        --color-accent: #2563eb;
+        --space-xs: 0.25rem;
+        --space-sm: 0.5rem;
+        --space-md: 1rem;
+        --space-lg: 1.5rem;
+        --space-xl: 2rem;
+        --radius-sm: 0.25rem;
+        --radius-md: 0.5rem;
+      }
+
+      body {
+        margin: 0;
+        font-family: var(--font-primary);
+        font-size: 1rem;
+        line-height: 1.5;
+        color: var(--color-text);
+        background-color: var(--color-bg);
+        text-align: start;
+      }
+
+      main {
+        max-inline-size: 60ch;
+        margin-inline: auto;
+        padding-block: var(--space-xl);
+        padding-inline: var(--space-lg);
+      }
+
+      h1,
+      h2 {
+        line-height: 1.25;
+        text-wrap: balance;
+      }
+    }
+
+    @layer components {
+      #mixed-fonts-container {
+        font-family: var(--font-primary);
+        font-size: 1rem;
+        line-height: 1.6;
+        /* Automatically extract and apply the primary font's x-height aspect ratio to nested mixed fonts */
+        font-size-adjust: from-font;
+        text-wrap: pretty;
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        border-radius: var(--radius-md);
+        padding-block: var(--space-md);
+        padding-inline: var(--space-lg);
+        margin-block: var(--space-md);
+      }
+
+      #mixed-fonts-container code {
+        font-family: var(--font-code);
+        background-color: var(--color-code-bg);
+        padding-block: 0.125em;
+        padding-inline: 0.375em;
+        border-radius: var(--radius-sm);
+      }
+    }
+
+    @layer theme {
+      #independent-theme-container {
+        font-family: var(--font-independent-theme);
+        font-size: 1rem;
+        line-height: 1.6;
+        /* Explicit numeric x-height aspect-ratio override to lock visual proportions across independent themes */
+        font-size-adjust: 0.51;
+        background-color: var(--color-surface-alt);
+        border-inline-start: 4px solid var(--color-accent);
+        border-radius: var(--radius-md);
+        padding-block: var(--space-md);
+        padding-inline: var(--space-lg);
+        margin-block: var(--space-md);
+      }
+
+      #independent-theme-container p {
+        margin-block: var(--space-sm);
+        text-wrap: pretty;
+      }
+    }
+
+    /* Fallback for browsers that do not support font-size-adjust */
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container {
+        font-size: 1rem;
+        line-height: 1.6;
+      }
+
+      #mixed-fonts-container code {
+        font-size: 1.12em;
+        line-height: 1.5;
+      }
+
+      #independent-theme-container {
+        font-size: 1.14rem;
+        line-height: 1.6;
+      }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Normalized Mixed Fonts &amp; Independent Theme Proportions</h1>
+
+    <section aria-labelledby="mixed-fonts-heading">
+      <h2 id="mixed-fonts-heading">Mixed Font Families Normalization</h2>
+      <p id="mixed-fonts-container">
+        When combining regular body copy with inline code snippets like
+        <code>font-size-adjust: from-font</code> or calling
+        <code>window.getComputedStyle(element)</code>, differences in lowercase
+        x-height between proportional sans-serif text and monospaced inline
+        <code>&lt;code&gt;</code> fragments are automatically normalized so both
+        typefaces share a harmonious visual height.
+      </p>
+    </section>
+
+    <section aria-labelledby="independent-theme-heading">
+      <h2 id="independent-theme-heading">Independent Theme Container</h2>
+      <div id="independent-theme-container">
+        <p>
+          This independent editorial theme uses a serif typeface stack
+          (<code>Times New Roman</code> / <code>Times</code>) whose natural
+          lowercase x-height is smaller than the primary interface font.
+          Applying an explicit numeric aspect-ratio override
+          (<code>font-size-adjust: 0.51</code>) locks down its visual
+          proportions without needing to inherit from a parent container.
+        </p>
+      </div>
+    </section>
+  </main>
+</body>
+</html>
