diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,175 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Modern CSS Typography &amp; Visual Proportions</title>
+  <style>
+    :root {
+      --bg-primary: #f8fafc;
+      --surface-primary: #ffffff;
+      --text-primary: #0f172a;
+      --text-secondary: #475569;
+      --border-color: #e2e8f0;
+      --code-bg: #f1f5f9;
+      --code-text: #0284c7;
+      --accent: #4f46e5;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
+      background-color: var(--bg-primary);
+      color: var(--text-primary);
+      line-height: 1.65;
+      padding: 3rem 1.5rem;
+    }
+
+    main {
+      max-width: 760px;
+      margin: 0 auto;
+      display: flex;
+      flex-direction: column;
+      gap: 2.5rem;
+    }
+
+    header h1 {
+      font-size: 1.875rem;
+      font-weight: 700;
+      letter-spacing: -0.025em;
+      margin-bottom: 0.5rem;
+    }
+
+    header p {
+      color: var(--text-secondary);
+      font-size: 1rem;
+    }
+
+    .card {
+      background-color: var(--surface-primary);
+      border: 1px solid var(--border-color);
+      border-radius: 12px;
+      padding: 2rem;
+      box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.05);
+    }
+
+    .card-label {
+      display: inline-block;
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.06em;
+      color: var(--accent);
+      margin-bottom: 0.75rem;
+    }
+
+    /* Automatic visual height normalization across mixed font families */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", Times, serif;
+      font-size: 1.25rem;
+      line-height: 1.75;
+      color: var(--text-primary);
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+      font-size: 1em;
+      font-size-adjust: inherit;
+      background-color: var(--code-bg);
+      color: var(--code-text);
+      padding: 0.15em 0.4em;
+      border-radius: 6px;
+      border: 1px solid var(--border-color);
+    }
+
+    #mixed-fonts-container span.sans-inline {
+      font-family: Verdana, Geneva, Tahoma, sans-serif;
+      font-size: 1em;
+      font-size-adjust: inherit;
+    }
+
+    /* Independent theme container with explicit numeric aspect-ratio override */
+    #independent-theme-container {
+      --theme-bg: #0f172a;
+      --theme-surface: #1e293b;
+      --theme-text: #f8fafc;
+      --theme-muted: #94a3b8;
+      --theme-accent: #38bdf8;
+      --theme-border: #334155;
+
+      background: linear-gradient(135deg, var(--theme-bg) 0%, var(--theme-surface) 100%);
+      color: var(--theme-text);
+      border: 1px solid var(--theme-border);
+      border-radius: 14px;
+      padding: 2rem;
+      width: 100%;
+      max-width: 640px;
+      aspect-ratio: 16 / 9;
+      font-family: "Trebuchet MS", "Lucida Sans Unicode", "Lucida Grande", "Lucida Sans", Arial, sans-serif;
+      font-size: 1.125rem;
+      font-size-adjust: 0.54;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      gap: 1rem;
+      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
+    }
+
+    #independent-theme-container h2 {
+      font-size: 1.5rem;
+      font-weight: 700;
+      color: var(--theme-accent);
+      font-size-adjust: 0.54;
+    }
+
+    #independent-theme-container p {
+      color: var(--theme-muted);
+      line-height: 1.6;
+      font-size-adjust: 0.54;
+    }
+
+    #independent-theme-container code {
+      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+      color: var(--theme-text);
+      background-color: rgba(56, 189, 248, 0.15);
+      padding: 0.15em 0.45em;
+      border-radius: 4px;
+      font-size-adjust: 0.54;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Font Size Normalization &amp; Independent Theme Proportions</h1>
+      <p>Demonstrating automatic visual x-height matching and locked numeric aspect ratios in modern CSS.</p>
+    </header>
+
+    <section class="card" aria-labelledby="mixed-heading">
+      <span class="card-label" id="mixed-heading">Automatic Mixed-Font Normalization</span>
+      <p id="mixed-fonts-container">
+        When combining prose in a classic serif typeface with inline technical tokens such as
+        <code>font-size-adjust: from-font</code>, <code>const scale = 1.0</code>, and
+        <span class="sans-inline">sans-serif callouts</span>, modern CSS automatically normalizes
+        the visual lowercase height (<code>ex-height</code>) across all mixed font families so
+        every glyph sequence reads with uniform optical balance.
+      </p>
+    </section>
+
+    <div id="independent-theme-container" data-theme="dark">
+      <h2>Independent Theme Environment</h2>
+      <p>
+        This standalone themed container locks down its visual proportions using an explicit
+        numeric override (<code>font-size-adjust: 0.54</code> and <code>aspect-ratio: 16 / 9</code>)
+        to maintain consistent optical metrics and dimensions independent of surrounding styles.
+      </p>
+    </div>
+  </main>
+</body>
+</html>
