+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const indicators = Array.from(document.querySelectorAll('.gallery-indicators button'));
+
+      function getClosestIndex() {
+        const galleryRect = gallery.getBoundingClientRect();
+        const galleryCenter = galleryRect.left + galleryRect.width / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        items.forEach((item, index) => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(itemCenter - galleryCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+
+        return closestIndex;
+      }
+
+      function setPendingTarget(targetIndex) {
+        indicators.forEach((btn, idx) => {
+          btn.classList.toggle('pending', idx === targetIndex);
+        });
+      }
+
+      function setActiveTarget(targetIndex) {
+        indicators.forEach((btn, idx) => {
+          const isActive = idx === targetIndex;
+          btn.classList.remove('pending');
+          btn.classList.toggle('active', isActive);
+          if (isActive) {
+            btn.setAttribute('aria-current', 'true');
+          } else {
+            btn.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      indicators.forEach((btn, index) => {
+        btn.addEventListener('click', () => {
+          const targetItem = items[index];
+          if (!targetItem) return;
+          setPendingTarget(index);
+          const targetScrollLeft =
+            targetItem.offsetLeft - (gallery.clientWidth - targetItem.clientWidth) / 2;
+          gallery.scrollTo({
+            left: targetScrollLeft,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      const supportsSnapChanging = 'onscrollsnapchanging' in gallery || 'onscrollsnapchanging' in window;
+      const supportsSnapChange = 'onscrollsnapchange' in gallery || 'onscrollsnapchange' in window;
+
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const snapTarget = event.snapTargetInline || event.snapTargetBlock;
+        const targetIndex = items.indexOf(snapTarget);
+        if (targetIndex !== -1) {
+          setPendingTarget(targetIndex);
+        }
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const snapTarget = event.snapTargetInline || event.snapTargetBlock;
+        const targetIndex = items.indexOf(snapTarget);
+        if (targetIndex !== -1) {
+          setActiveTarget(targetIndex);
+        }
+      });
+
+      // Fallback detection for browsers or synthetic events without scrollsnapchanging / scrollsnapchange
+      let settleTimer = null;
+      let snapChangingFired = false;
+
+      if (supportsSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', () => {
+          snapChangingFired = true;
+        });
+      }
+
+      gallery.addEventListener('scroll', () => {
+        if (!supportsSnapChanging || !snapChangingFired) {
+          const pendingIdx = getClosestIndex();
+          setPendingTarget(pendingIdx);
+        }
+        snapChangingFired = false;
+
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => {
+          setActiveTarget(getClosestIndex());
+        }, 150);
+      }, { passive: true });
+
+      if ('onscrollend' in gallery) {
+        gallery.addEventListener('scrollend', () => {
+          clearTimeout(settleTimer);
+          setActiveTarget(getClosestIndex());
+        });
+      }
+    })();
+  </script>
