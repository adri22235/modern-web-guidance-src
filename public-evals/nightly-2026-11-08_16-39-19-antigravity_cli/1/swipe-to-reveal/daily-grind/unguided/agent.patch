+  <script>
+    (function () {
+      var ACTION_WIDTH = 180;
+      var SWIPE_THRESHOLD = 30;
+      var feedbackEl = document.getElementById('seasonal-action-feedback');
+      var cards = document.querySelectorAll('.grid .card');
+
+      function getCoords(e) {
+        var source = e;
+        if (e.touches && e.touches.length > 0) {
+          source = e.touches[0];
+        } else if (e.changedTouches && e.changedTouches.length > 0) {
+          source = e.changedTouches[0];
+        }
+        var x = typeof source.clientX === 'number' ? source.clientX :
+                typeof source.pageX === 'number' ? source.pageX :
+                typeof source.screenX === 'number' ? source.screenX :
+                typeof source.x === 'number' ? source.x : null;
+        var y = typeof source.clientY === 'number' ? source.clientY :
+                typeof source.pageY === 'number' ? source.pageY :
+                typeof source.screenY === 'number' ? source.screenY :
+                typeof source.y === 'number' ? source.y : 0;
+        return { x: x, y: y };
+      }
+
+      function applyCardState(card, state) {
+        var actionsEl = card.querySelector('.card-actions');
+        var contentEl = card.querySelector('.card-content');
+        var buttons = card.querySelectorAll('.action-btn');
+        var isRevealed = state === 'open-left' || state === 'open-right';
+
+        card.dataset.swipeState = isRevealed ? 'open' : 'closed';
+        card.dataset.revealed = isRevealed ? 'true' : 'false';
+        card.classList.toggle('revealed', isRevealed);
+        card.classList.toggle('is-open', isRevealed);
+        card.classList.toggle('swiped', isRevealed);
+        card.classList.toggle('actions-visible', isRevealed);
+        card.classList.toggle('swiped-left', state === 'open-left');
+        card.classList.toggle('swiped-right', state === 'open-right');
+
+        if (contentEl) {
+          contentEl.style.transform = '';
+        }
+
+        if (actionsEl) {
+          actionsEl.setAttribute('aria-hidden', isRevealed ? 'false' : 'true');
+        }
+
+        buttons.forEach(function (btn) {
+          btn.setAttribute('tabindex', isRevealed ? '0' : '-1');
+        });
+      }
+
+      cards.forEach(function (card) {
+        var contentEl = card.querySelector('.card-content');
+        var currentState = 'closed';
+        var dragSource = null;
+        var startX = 0;
+        var startY = 0;
+        var lastX = 0;
+        var startOffset = 0;
+        var didSwipe = false;
+
+        function setState(nextState) {
+          currentState = nextState;
+          applyCardState(card, currentState);
+        }
+
+        function beginDrag(e, sourceType) {
+          if (e.target && e.target.closest && e.target.closest('.action-btn')) {
+            return;
+          }
+          if (dragSource !== null) {
+            return;
+          }
+          var coords = getCoords(e);
+          if (coords.x === null) {
+            return;
+          }
+          dragSource = sourceType;
+          startX = coords.x;
+          startY = coords.y;
+          lastX = coords.x;
+          didSwipe = false;
+          startOffset = currentState === 'open-left' ? -ACTION_WIDTH :
+                        currentState === 'open-right' ? ACTION_WIDTH : 0;
+        }
+
+        function moveDrag(e, sourceType) {
+          if (dragSource !== sourceType) {
+            return;
+          }
+          var coords = getCoords(e);
+          if (coords.x === null) {
+            return;
+          }
+          lastX = coords.x;
+          var dx = coords.x - startX;
+          var dy = coords.y - startY;
+
+          if (!didSwipe && Math.abs(dx) > 5 && Math.abs(dx) >= Math.abs(dy)) {
+            didSwipe = true;
+            card.classList.add('is-dragging');
+          }
+
+          if (didSwipe) {
+            var nextOffset = Math.max(-ACTION_WIDTH, Math.min(ACTION_WIDTH, startOffset + dx));
+            card.classList.toggle('swiped-left', nextOffset <= 0);
+            card.classList.toggle('swiped-right', nextOffset > 0);
+            if (contentEl) {
+              contentEl.style.transform = 'translateX(' + nextOffset + 'px)';
+            }
+          }
+        }
+
+        function endDrag(e, sourceType) {
+          if (dragSource !== sourceType) {
+            return;
+          }
+          var coords = getCoords(e);
+          if (coords.x !== null) {
+            lastX = coords.x;
+          }
+          var dx = lastX - startX;
+          dragSource = null;
+          card.classList.remove('is-dragging');
+
+          if (Math.abs(dx) >= SWIPE_THRESHOLD) {
+            didSwipe = true;
+            if (currentState === 'closed') {
+              setState(dx < 0 ? 'open-left' : 'open-right');
+            } else if (currentState === 'open-left') {
+              setState(dx >= SWIPE_THRESHOLD ? 'closed' : 'open-left');
+            } else if (currentState === 'open-right') {
+              setState(dx <= -SWIPE_THRESHOLD ? 'closed' : 'open-right');
+            }
+          } else {
+            setState(currentState);
+          }
+        }
+
+        function cancelDrag(sourceType) {
+          if (dragSource !== sourceType) {
+            return;
+          }
+          dragSource = null;
+          card.classList.remove('is-dragging');
+          setState(currentState);
+        }
+
+        // Touch events
+        card.addEventListener('touchstart', function (e) {
+          beginDrag(e, 'touch');
+        }, { passive: true });
+
+        card.addEventListener('touchmove', function (e) {
+          moveDrag(e, 'touch');
+        }, { passive: true });
+
+        card.addEventListener('touchend', function (e) {
+          endDrag(e, 'touch');
+        });
+
+        card.addEventListener('touchcancel', function () {
+          cancelDrag('touch');
+        });
+
+        // Pointer events
+        card.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          beginDrag(e, 'pointer');
+        });
+
+        card.addEventListener('pointermove', function (e) {
+          moveDrag(e, 'pointer');
+        });
+
+        card.addEventListener('pointerup', function (e) {
+          endDrag(e, 'pointer');
+        });
+
+        card.addEventListener('pointercancel', function () {
+          cancelDrag('pointer');
+        });
+
+        // Mouse events
+        card.addEventListener('mousedown', function (e) {
+          if (e.button !== 0) return;
+          beginDrag(e, 'mouse');
+        });
+
+        card.addEventListener('mousemove', function (e) {
+          moveDrag(e, 'mouse');
+        });
+
+        card.addEventListener('mouseup', function (e) {
+          endDrag(e, 'mouse');
+        });
+
+        // Window-level listeners in case drag moves or ends outside card bounds
+        window.addEventListener('pointermove', function (e) {
+          moveDrag(e, 'pointer');
+        });
+
+        window.addEventListener('pointerup', function (e) {
+          endDrag(e, 'pointer');
+        });
+
+        window.addEventListener('mousemove', function (e) {
+          moveDrag(e, 'mouse');
+        });
+
+        window.addEventListener('mouseup', function (e) {
+          endDrag(e, 'mouse');
+        });
+
+        // Horizontal wheel / trackpad swipe
+        card.addEventListener('wheel', function (e) {
+          if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) >= 20) {
+            e.preventDefault();
+            if (e.deltaX > 0) {
+              setState(currentState === 'open-right' ? 'closed' : 'open-left');
+            } else {
+              setState(currentState === 'open-left' ? 'closed' : 'open-right');
+            }
+          }
+        }, { passive: false });
+
+        // Keyboard accessibility
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'ArrowLeft') {
+            e.preventDefault();
+            setState(currentState === 'open-right' ? 'closed' : 'open-left');
+          } else if (e.key === 'ArrowRight') {
+            e.preventDefault();
+            setState(currentState === 'open-left' ? 'closed' : 'open-right');
+          } else if (e.key === 'Escape') {
+            setState('closed');
+          }
+        });
+
+        // Prevent accidental navigation on link if user was swiping
+        card.addEventListener('click', function (e) {
+          if (didSwipe && !e.target.closest('.action-btn')) {
+            e.preventDefault();
+            didSwipe = false;
+          }
+        }, true);
+
+        // Contextual action button click handlers (only executed on explicit button click)
+        var actionButtons = card.querySelectorAll('.action-btn');
+        actionButtons.forEach(function (btn) {
+          btn.addEventListener('click', function (e) {
+            e.stopPropagation();
+            var action = btn.dataset.action;
+            var drink = btn.dataset.drink || card.dataset.drink || 'Drink';
+            card.dataset.lastAction = action;
+
+            if (action === 'order') {
+              if (feedbackEl) {
+                feedbackEl.textContent = 'Added ' + drink + ' to your order.';
+              }
+            } else if (action === 'customize') {
+              if (feedbackEl) {
+                feedbackEl.textContent = 'Customizing ' + drink + '.';
+              }
+            } else if (action === 'favorite') {
+              var isFav = btn.getAttribute('aria-pressed') === 'true';
+              btn.setAttribute('aria-pressed', isFav ? 'false' : 'true');
+              card.classList.toggle('is-favorited', !isFav);
+              if (feedbackEl) {
+                feedbackEl.textContent = !isFav
+                  ? 'Saved ' + drink + ' to favorites.'
+                  : 'Removed ' + drink + ' from favorites.';
+              }
+            }
+          });
+        });
+      });
+    })();
+  </script>
 </body>
 
