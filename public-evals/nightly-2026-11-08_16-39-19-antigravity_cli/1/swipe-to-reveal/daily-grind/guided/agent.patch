       text-align: center;
     }
 
+    .card.SwipeReveal {
+      padding: 0;
+    }
+
+    .SwipeReveal {
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: auto;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: Canvas;
+      background-color: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+
+      &:first-child {
+        scroll-snap-align: start;
+      }
+    }
+
+    .SwipeReveal-panel button {
+      border: none;
+      padding: 0 16px;
+      font: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      cursor: pointer;
+      color: white;
+      background: var(--primary);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      white-space: nowrap;
+      transition: filter 0.2s;
+    }
+
+    .SwipeReveal-panel button:hover,
+    .SwipeReveal-panel button:focus-visible {
+      filter: brightness(1.15);
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel .action-customize {
+      background: #6d4c41;
+    }
+
+    .SwipeReveal-panel .action-favorite {
+      background: var(--accent);
+      color: var(--text);
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
