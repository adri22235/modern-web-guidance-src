+  <script>
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({
+            block: 'nearest',
+            inline: 'start',
+          });
+        }
+      });
+    }
+
+    for (const favBtn of document.querySelectorAll('.SwipeReveal-panel .action-favorite')) {
+      favBtn.addEventListener('click', () => {
+        const isPressed = favBtn.getAttribute('aria-pressed') === 'true';
+        favBtn.setAttribute('aria-pressed', String(!isPressed));
+        favBtn.textContent = !isPressed ? 'Favorited' : 'Favorite';
+      });
+    }
+  </script>
