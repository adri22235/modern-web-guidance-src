+      }
+
+      function panToPoint(mapX, mapY) {
+        const targetX = mapX - mapViewport.clientWidth / 2;
+        const targetY = mapY - mapViewport.clientHeight / 2;
+        const clamped = clampScroll(targetX, targetY);
+        scrollPosX = clamped.x;
+        scrollPosY = clamped.y;
+        mapViewport.scrollLeft = scrollPosX;
+        mapViewport.scrollTop = scrollPosY;
+        updateReadout();
+      }
+
+      function selectCafe(cafeId, shouldCenter) {
+        const cafe = cafes[cafeId];
+        if (!cafe) return;
+        pins.forEach((pin) => {
+          pin.classList.toggle('active', pin.getAttribute('data-cafe-id') === cafeId);
+        });
+        chips.forEach((chip) => {
+          chip.classList.toggle('active', chip.getAttribute('data-cafe-id') === cafeId);
+        });
+        detailImg.src = cafe.img;
+        detailImg.alt = cafe.title;
+        detailTitle.textContent = cafe.title;
+        detailAddress.textContent = cafe.address;
+        detailDesc.textContent = cafe.desc;
+        detailTags.innerHTML = cafe.tags
+          .map((t) => '<span class="location-tag">' + t + '</span>')
+          .join('');
+        if (shouldCenter) {
+          panToPoint(cafe.x, cafe.y);
+        }
+      }
+
+      function getCoords(e) {
+        const src = (e.touches && e.touches.length > 0)
+          ? e.touches[0]
+          : (e.changedTouches && e.changedTouches.length > 0 ? e.changedTouches[0] : e);
+        const x = (src.clientX !== undefined && src.clientX !== 0) ? src.clientX : (src.pageX || src.clientX || 0);
+        const y = (src.clientY !== undefined && src.clientY !== 0) ? src.clientY : (src.pageY || src.clientY || 0);
+        return { x, y };
+      }
+
+      function startDrag(e) {
+        if (e.type === 'mousedown' && e.button !== 0) return;
+        const coords = getCoords(e);
+        isDragging = true;
+        lastX = coords.x;
+        lastY = coords.y;
+        scrollPosX = mapViewport.scrollLeft;
+        scrollPosY = mapViewport.scrollTop;
+        movedDistance = 0;
+        mapViewport.classList.add('is-dragging');
+      }
+
+      function moveDrag(e) {
+        if (!isDragging) return;
+        if (e.cancelable && e.type === 'touchmove') {
+          e.preventDefault();
+        }
+        const coords = getCoords(e);
+        const dx = coords.x - lastX;
+        const dy = coords.y - lastY;
+        lastX = coords.x;
+        lastY = coords.y;
+        if (dx === 0 && dy === 0) return;
+
+        movedDistance += Math.hypot(dx, dy);
+        const clamped = clampScroll(scrollPosX - dx, scrollPosY - dy);
+        scrollPosX = clamped.x;
+        scrollPosY = clamped.y;
+        mapViewport.scrollLeft = scrollPosX;
+        mapViewport.scrollTop = scrollPosY;
+        updateReadout();
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        mapViewport.classList.remove('is-dragging');
+      }
+
+      mapViewport.addEventListener('dragstart', (e) => e.preventDefault());
+
+      // Pointer, mouse, and touch 2D free-pan handlers (no single-axis locking)
+      mapViewport.addEventListener('pointerdown', startDrag);
+      mapViewport.addEventListener('mousedown', startDrag);
+      mapViewport.addEventListener('touchstart', startDrag, { passive: true });
+
+      [mapSurface, mapViewport, window].forEach((target) => {
+        target.addEventListener('pointermove', moveDrag);
+        target.addEventListener('mousemove', moveDrag);
+        target.addEventListener('touchmove', moveDrag, { passive: false });
+        target.addEventListener('pointerup', endDrag);
+        target.addEventListener('pointercancel', endDrag);
+        target.addEventListener('mouseup', endDrag);
+        target.addEventListener('touchend', endDrag);
+        target.addEventListener('touchcancel', endDrag);
+      });
+
+      // 2D wheel scrolling (simultaneous horizontal + vertical / diagonal scrolling)
+      mapViewport.addEventListener('wheel', (e) => {
+        e.preventDefault();
+        const clamped = clampScroll(
+          mapViewport.scrollLeft + e.deltaX,
+          mapViewport.scrollTop + e.deltaY
+        );
+        scrollPosX = clamped.x;
+        scrollPosY = clamped.y;
+        mapViewport.scrollLeft = scrollPosX;
+        mapViewport.scrollTop = scrollPosY;
+        updateReadout();
+      }, { passive: false });
+
+      mapViewport.addEventListener('scroll', () => {
+        if (!isDragging) {
+          scrollPosX = mapViewport.scrollLeft;
+          scrollPosY = mapViewport.scrollTop;
+        }
+        updateReadout();
+      });
+
+      // Keyboard 2D panning (supports simultaneous keys for diagonal movement)
+      const activeKeys = new Set();
+      mapViewport.addEventListener('keydown', (e) => {
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
+          e.preventDefault();
+          activeKeys.add(e.key);
+          let stepX = 0;
+          let stepY = 0;
+          if (activeKeys.has('ArrowLeft')) stepX -= 40;
+          if (activeKeys.has('ArrowRight')) stepX += 40;
+          if (activeKeys.has('ArrowUp')) stepY -= 40;
+          if (activeKeys.has('ArrowDown')) stepY += 40;
+          const clamped = clampScroll(mapViewport.scrollLeft + stepX, mapViewport.scrollTop + stepY);
+          scrollPosX = clamped.x;
+          scrollPosY = clamped.y;
+          mapViewport.scrollLeft = scrollPosX;
+          mapViewport.scrollTop = scrollPosY;
+          updateReadout();
+        }
+      });
+      mapViewport.addEventListener('keyup', (e) => activeKeys.delete(e.key));
+      mapViewport.addEventListener('blur', () => activeKeys.clear());
+
+      // Pin & toolbar interactions
+      pins.forEach((pin) => {
+        pin.addEventListener('click', () => {
+          if (movedDistance > 6) return;
+          const cafeId = pin.getAttribute('data-cafe-id');
+          selectCafe(cafeId, false);
+        });
+        pin.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            selectCafe(pin.getAttribute('data-cafe-id'), true);
+          }
+        });
+      });
+
+      chips.forEach((chip) => {
+        chip.addEventListener('click', () => {
+          selectCafe(chip.getAttribute('data-cafe-id'), true);
+        });
+      });
+
+      centerBtn.addEventListener('click', () => {
+        selectCafe('downtown', true);
+      });
+
+      // Initialize map centered on Downtown Flagship so all 2D directions have ample pan range
+      panToPoint(cafes.downtown.x, cafes.downtown.y);
+      window.addEventListener('load', () => panToPoint(cafes.downtown.x, cafes.downtown.y));
+    })();
+  </script>
 </body>
 
 </html>
