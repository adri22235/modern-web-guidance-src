+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'cta-label',
+        'price',
+        'calories',
+        'featured',
+        'sold-out',
+        'disabled'
+      ];
+
+      #internals;
+      #favorited = false;
+      #initialized = false;
+      #badgeEl;
+      #titleEl;
+      #descEl;
+      #metaEl;
+      #linkEl;
+      #favBtnEl;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.() ?? null;
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(value) {
+        value ? this.setAttribute('name', String(value)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(value) {
+        value ? this.setAttribute('description', String(value)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(value) {
+        value ? this.setAttribute('href', String(value)) : this.removeAttribute('href');
+      }
+
+      get ctaLabel() {
+        return this.getAttribute('cta-label') ?? 'View Details';
+      }
+      set ctaLabel(value) {
+        value ? this.setAttribute('cta-label', String(value)) : this.removeAttribute('cta-label');
+      }
+
+      // Numeric attributes: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(value) {
+        this.setAttribute('price', String(Number(value) || 0));
+      }
+
+      get calories() {
+        return Number(this.getAttribute('calories')) || 0;
+      }
+      set calories(value) {
+        this.setAttribute('calories', String(Number(value) || 0));
+      }
+
+      // Boolean attributes: present = true, absent = false (never set to "false")
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+      set soldOut(on) {
+        this.toggleAttribute('sold-out', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      // Runtime UI state exposed via CustomStateSet (:state(favorited))
+      get favorited() {
+        return this.#favorited;
+      }
+      set favorited(on) {
+        const next = !!on;
+        if (this.#favorited === next) return;
+        this.#favorited = next;
+        if (this.#internals?.states) {
+          if (next) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+        this.render();
+      }
+
+      connectedCallback() {
+        if (!this.#initialized) {
+          this.#setupStructure();
+          this.#initialized = true;
+        }
+        this.#favBtnEl?.addEventListener('click', this.#handleFavoriteToggle);
+        this.render();
+      }
+
+      connectedMoveCallback() {
+        // Preserve DOM state, focus, and listeners across Node.moveBefore() relocations
+      }
+
+      disconnectedCallback() {
+        this.#favBtnEl?.removeEventListener('click', this.#handleFavoriteToggle);
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.#initialized) {
+          this.render();
+        }
+      }
+
+      #setupStructure() {
+        this.classList.add('card');
+        this.textContent = '';
+
+        this.#badgeEl = document.createElement('span');
+        this.#badgeEl.className = 'card-badge';
+
+        this.#titleEl = document.createElement('h3');
+        this.#descEl = document.createElement('p');
+
+        this.#metaEl = document.createElement('p');
+        this.#metaEl.className = 'card-meta';
+
+        const actionsEl = document.createElement('div');
+        actionsEl.className = 'card-actions';
+
+        this.#linkEl = document.createElement('a');
+        this.#linkEl.className = 'btn';
+
+        this.#favBtnEl = document.createElement('button');
+        this.#favBtnEl.type = 'button';
+        this.#favBtnEl.className = 'favorite-btn';
+
+        actionsEl.append(this.#linkEl, this.#favBtnEl);
+        this.append(this.#badgeEl, this.#titleEl, this.#descEl, this.#metaEl, actionsEl);
+      }
+
+      #handleFavoriteToggle = () => {
+        if (this.disabled || this.soldOut) return;
+        this.favorited = !this.favorited;
+        this.dispatchEvent(
+          new CustomEvent('favorite-change', {
+            bubbles: true,
+            detail: { name: this.name, favorited: this.favorited }
+          })
+        );
+      };
+
+      render() {
+        if (!this.#initialized) return;
+
+        const isUnavailable = this.soldOut || this.disabled;
+
+        if (this.soldOut) {
+          this.#badgeEl.textContent = 'Sold Out';
+          this.#badgeEl.hidden = false;
+        } else if (this.featured) {
+          this.#badgeEl.textContent = 'Seasonal Favorite';
+          this.#badgeEl.hidden = false;
+        } else {
+          this.#badgeEl.textContent = '';
+          this.#badgeEl.hidden = true;
+        }
+
+        this.#titleEl.textContent = this.name;
+        this.#descEl.textContent = this.description;
+
+        const metaParts = [];
+        if (this.price > 0) {
+          metaParts.push(`$${this.price.toFixed(2)}`);
+        }
+        if (this.calories > 0) {
+          metaParts.push(`${this.calories} cal`);
+        }
+        this.#metaEl.textContent = metaParts.join(' • ');
+        this.#metaEl.hidden = metaParts.length === 0;
+
+        this.#linkEl.textContent = this.soldOut ? 'Unavailable' : this.ctaLabel;
+        if (this.href && !isUnavailable) {
+          this.#linkEl.setAttribute('href', this.href);
+          this.#linkEl.removeAttribute('aria-disabled');
+        } else {
+          this.#linkEl.removeAttribute('href');
+          this.#linkEl.setAttribute('aria-disabled', 'true');
+        }
+
+        this.#favBtnEl.disabled = isUnavailable;
+        this.#favBtnEl.setAttribute('aria-pressed', String(this.#favorited));
+        this.#favBtnEl.setAttribute(
+          'aria-label',
+          `${this.#favorited ? 'Remove' : 'Save'} ${this.name || 'item'} as favorite`
+        );
+        this.#favBtnEl.textContent = this.#favorited ? '★ Saved' : '☆ Save';
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
