+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      // String attributes
+      'name',
+      'title',
+      'description',
+      'href',
+      'cta',
+      'roast',
+      'origin',
+      'image',
+      // Numeric attributes
+      'price',
+      'rating',
+      'calories',
+      'stock',
+      // Boolean attributes
+      'featured',
+      'seasonal',
+      'sold-out',
+      'iced',
+      'disabled',
+      'available',
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._isConnected = false;
+    this._onActionClick = this._handleActionClick.bind(this);
+  }
+
+  // Lifecycle: Invoked when the custom element is appended into a document-connected element
+  connectedCallback() {
+    this._isConnected = true;
+
+    // Upgrade properties that may have been set before element definition/upgrade
+    const reflectedProps = [
+      'name',
+      'title',
+      'description',
+      'href',
+      'cta',
+      'roast',
+      'origin',
+      'image',
+      'price',
+      'rating',
+      'calories',
+      'stock',
+      'featured',
+      'seasonal',
+      'soldOut',
+      'iced',
+      'disabled',
+      'available',
+    ];
+    for (const prop of reflectedProps) {
+      this._upgradeProperty(prop);
+    }
+
+    this.render();
+    this.shadowRoot.addEventListener('click', this._onActionClick);
+    this.addEventListener('click', this._onActionClick);
+  }
+
+  // Lifecycle: Invoked when the custom element is disconnected from the document's DOM
+  disconnectedCallback() {
+    this._isConnected = false;
+    this.shadowRoot.removeEventListener('click', this._onActionClick);
+    this.removeEventListener('click', this._onActionClick);
+  }
+
+  // Lifecycle: Invoked when the custom element is moved to a new document
+  adoptedCallback() {
+    if (this._isConnected) {
+      this.render();
+    }
+  }
+
+  // Lifecycle: Invoked when one of the custom element's observed attributes is added, removed, or changed
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (this._isConnected) {
+      this.render();
+    }
+  }
+
+  _upgradeProperty(prop) {
+    if (Object.prototype.hasOwnProperty.call(this, prop)) {
+      const value = this[prop];
+      delete this[prop];
+      this[prop] = value;
+    }
+  }
+
+  // Helper methods for attribute/property reflection
+  _getStringAttribute(attr, fallback = '') {
+    const value = this.getAttribute(attr);
+    return value !== null ? value : fallback;
+  }
+
+  _setStringAttribute(attr, value) {
+    if (value === null || value === undefined) {
+      this.removeAttribute(attr);
+    } else {
+      this.setAttribute(attr, String(value));
+    }
+  }
+
+  _getNumberAttribute(attr, fallback = 0) {
+    if (!this.hasAttribute(attr)) return fallback;
+    const raw = this.getAttribute(attr);
+    if (raw === null || raw.trim() === '') return fallback;
+    const parsed = Number(raw);
+    return Number.isFinite(parsed) ? parsed : fallback;
+  }
+
+  _setNumberAttribute(attr, value) {
+    if (value === null || value === undefined || value === '') {
+      this.removeAttribute(attr);
+      return;
+    }
+    const parsed = Number(value);
+    if (Number.isFinite(parsed)) {
+      this.setAttribute(attr, String(parsed));
+    } else {
+      this.removeAttribute(attr);
+    }
+  }
+
+  _getBooleanAttribute(attr) {
+    return this.hasAttribute(attr);
+  }
+
+  _setBooleanAttribute(attr, value) {
+    const boolVal = Boolean(value);
+    if (boolVal) {
+      if (!this.hasAttribute(attr)) {
+        this.setAttribute(attr, '');
+      }
+    } else if (this.hasAttribute(attr)) {
+      this.removeAttribute(attr);
+    }
+  }
+
+  // String property getters and setters
+  get name() {
+    return this._getStringAttribute('name');
+  }
+
+  set name(value) {
+    this._setStringAttribute('name', value);
+  }
+
+  get title() {
+    return this._getStringAttribute('title');
+  }
+
+  set title(value) {
+    this._setStringAttribute('title', value);
+  }
+
+  get description() {
+    return this._getStringAttribute('description');
+  }
+
+  set description(value) {
+    this._setStringAttribute('description', value);
+  }
+
+  get href() {
+    return this._getStringAttribute('href', '#');
+  }
+
+  set href(value) {
+    this._setStringAttribute('href', value);
+  }
+
+  get cta() {
+    return this._getStringAttribute('cta', 'View Details');
+  }
+
+  set cta(value) {
+    this._setStringAttribute('cta', value);
+  }
+
+  get roast() {
+    return this._getStringAttribute('roast');
+  }
+
+  set roast(value) {
+    this._setStringAttribute('roast', value);
+  }
+
+  get origin() {
+    return this._getStringAttribute('origin');
+  }
+
+  set origin(value) {
+    this._setStringAttribute('origin', value);
+  }
+
+  get image() {
+    return this._getStringAttribute('image');
+  }
+
+  set image(value) {
+    this._setStringAttribute('image', value);
+  }
+
+  // Numeric property getters and setters
+  get price() {
+    return this._getNumberAttribute('price', 0);
+  }
+
+  set price(value) {
+    this._setNumberAttribute('price', value);
+  }
+
+  get rating() {
+    return this._getNumberAttribute('rating', 0);
+  }
+
+  set rating(value) {
+    this._setNumberAttribute('rating', value);
+  }
+
+  get calories() {
+    return this._getNumberAttribute('calories', 0);
+  }
+
+  set calories(value) {
+    this._setNumberAttribute('calories', value);
+  }
+
+  get stock() {
+    return this._getNumberAttribute('stock', 0);
+  }
+
+  set stock(value) {
+    this._setNumberAttribute('stock', value);
+  }
+
+  // Boolean property getters and setters
+  get featured() {
+    return this._getBooleanAttribute('featured');
+  }
+
+  set featured(value) {
+    this._setBooleanAttribute('featured', value);
+  }
+
+  get seasonal() {
+    return this._getBooleanAttribute('seasonal');
+  }
+
+  set seasonal(value) {
+    this._setBooleanAttribute('seasonal', value);
+  }
+
+  get soldOut() {
+    return this._getBooleanAttribute('sold-out');
+  }
+
+  set soldOut(value) {
+    this._setBooleanAttribute('sold-out', value);
+  }
+
+  get iced() {
+    return this._getBooleanAttribute('iced');
+  }
+
+  set iced(value) {
+    this._setBooleanAttribute('iced', value);
+  }
+
+  get disabled() {
+    return this._getBooleanAttribute('disabled');
+  }
+
+  set disabled(value) {
+    this._setBooleanAttribute('disabled', value);
+  }
+
+  get available() {
+    return this._getBooleanAttribute('available');
+  }
+
+  set available(value) {
+    this._setBooleanAttribute('available', value);
+  }
+
+  _handleActionClick(event) {
+    const link = event.target.closest('a.btn');
+    if (!link) return;
+
+    if (this.soldOut || this.disabled) {
+      event.preventDefault();
+      event.stopPropagation();
+      return;
+    }
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.name || this.title,
+          price: this.price,
+          roast: this.roast,
+          href: this.href,
+          featured: this.featured,
+          seasonal: this.seasonal,
+          iced: this.iced,
+        },
+      })
+    );
+  }
+
+  _escapeHtml(str) {
+    return String(str)
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  _buildCardMarkup() {
+    const displayName = this._escapeHtml(this.name || this.title || 'Artisanal Coffee');
+    const displayDesc = this._escapeHtml(this.description);
+    const displayHref = this._escapeHtml(this.href || '#');
+    const isUnavailable = this.soldOut || this.disabled;
+    const displayCta = isUnavailable ? 'Sold Out' : this._escapeHtml(this.cta || 'View Details');
+
+    const badges = [];
+    if (this.featured) {
+      badges.push('<span class="badge badge-featured">Featured</span>');
+    }
+    if (this.seasonal) {
+      badges.push('<span class="badge badge-seasonal">Seasonal</span>');
+    }
+    if (this.iced) {
+      badges.push('<span class="badge badge-iced">Iced</span>');
+    }
+    if (isUnavailable) {
+      badges.push('<span class="badge badge-sold-out">Sold Out</span>');
+    }
+
+    const metaItems = [];
+    if (this.roast) {
+      metaItems.push(`<span class="meta-item roast">${this._escapeHtml(this.roast)} Roast</span>`);
+    }
+    if (this.origin) {
+      metaItems.push(`<span class="meta-item origin">${this._escapeHtml(this.origin)}</span>`);
+    }
+    if (this.hasAttribute('rating') && this.rating > 0) {
+      metaItems.push(`<span class="meta-item rating" aria-label="Rating ${this.rating} out of 5">&starf; ${this.rating.toFixed(1)}</span>`);
+    }
+    if (this.hasAttribute('calories') && this.calories >= 0) {
+      metaItems.push(`<span class="meta-item calories">${this.calories} cal</span>`);
+    }
+
+    const hasPrice = this.hasAttribute('price') && this.price > 0;
+    const priceMarkup = hasPrice
+      ? `<div class="price" data-price="${this.price}">$${this.price.toFixed(2)}</div>`
+      : '';
+
+    const imageMarkup = this.image
+      ? `<img class="card-image" src="${this._escapeHtml(this.image)}" alt="${displayName}" loading="lazy">`
+      : '';
+
+    const cardClasses = [
+      'card',
+      this.featured ? 'is-featured' : '',
+      this.seasonal ? 'is-seasonal' : '',
+      isUnavailable ? 'is-sold-out' : '',
+    ]
+      .filter(Boolean)
+      .join(' ');
+
+    return `
+      <article class="${cardClasses}">
+        ${imageMarkup}
+        ${badges.length ? `<div class="badges">${badges.join('')}</div>` : ''}
+        <h3>${displayName}</h3>
+        <p class="description">${displayDesc}</p>
+        ${metaItems.length ? `<div class="meta">${metaItems.join(' &bull; ')}</div>` : ''}
+        ${priceMarkup}
+        <a href="${displayHref}" class="btn${isUnavailable ? ' btn-disabled' : ''}" ${isUnavailable ? 'aria-disabled="true" tabindex="-1"' : ''}>${displayCta}</a>
+      </article>
+    `;
+  }
+
+  render() {
+    const markup = this._buildCardMarkup();
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        * {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+
+        .card {
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          border: 2px solid transparent;
+          transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+        }
+
+        .card.is-featured {
+          border-color: var(--accent, #ffab40);
+          box-shadow: 0 4px 12px rgba(255, 171, 64, 0.2);
+        }
+
+        .card.is-sold-out {
+          opacity: 0.7;
+        }
+
+        .card-image {
+          width: 100%;
+          height: 160px;
+          object-fit: cover;
+          border-radius: 6px;
+          margin-bottom: 12px;
+        }
+
+        .badges {
+          display: flex;
+          justify-content: center;
+          flex-wrap: wrap;
+          gap: 6px;
+          margin-bottom: 10px;
+        }
+
+        .badge {
+          font-size: 0.72rem;
+          font-weight: 600;
+          text-transform: uppercase;
+          letter-spacing: 0.5px;
+          padding: 2px 8px;
+          border-radius: 999px;
+        }
+
+        .badge-featured {
+          background: var(--accent, #ffab40);
+          color: var(--text, #3e2723);
+        }
+
+        .badge-seasonal {
+          background: var(--secondary, #d7ccc8);
+          color: var(--primary, #4e342e);
+        }
+
+        .badge-iced {
+          background: #e1f5fe;
+          color: #0277bd;
+        }
+
+        .badge-sold-out {
+          background: #ffebee;
+          color: #c62828;
+        }
+
+        .card h3 {
+          margin-bottom: 10px;
+          color: var(--primary, #4e342e);
+        }
+
+        .description {
+          color: var(--text, #3e2723);
+          margin-bottom: 12px;
+          flex-grow: 1;
+        }
+
+        .meta {
+          font-size: 0.85rem;
+          color: #6d4c41;
+          margin-bottom: 10px;
+        }
+
+        .price {
+          font-size: 1.25rem;
+          font-weight: bold;
+          color: var(--primary, #4e342e);
+          margin-bottom: 5px;
+        }
+
+        .btn {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s;
+          align-self: center;
+        }
+
+        .btn:hover {
+          background: #3e2723;
+        }
+
+        .btn.btn-disabled {
+          background: #9e9e9e;
+          cursor: not-allowed;
+        }
+      </style>
+      ${markup}
+    `;
+
+    if (this._isConnected) {
+      this.innerHTML = markup;
+    }
+  }
+}
+
+if (typeof customElements !== 'undefined' && !customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+
+if (typeof window !== 'undefined') {
+  window.CoffeeCard = CoffeeCard;
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { CoffeeCard };
+}
