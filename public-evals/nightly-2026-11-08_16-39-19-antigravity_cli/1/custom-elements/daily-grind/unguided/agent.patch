+
+        get featured() {
+          return this._getBooleanAttribute('featured');
+        }
+
+        set featured(value) {
+          this._setBooleanAttribute('featured', value);
+        }
+
+        get seasonal() {
+          return this._getBooleanAttribute('seasonal');
+        }
+
+        set seasonal(value) {
+          this._setBooleanAttribute('seasonal', value);
+        }
+
+        get soldOut() {
+          return this._getBooleanAttribute('sold-out');
+        }
+
+        set soldOut(value) {
+          this._setBooleanAttribute('sold-out', value);
+        }
+
+        get iced() {
+          return this._getBooleanAttribute('iced');
+        }
+
+        set iced(value) {
+          this._setBooleanAttribute('iced', value);
+        }
+
+        get disabled() {
+          return this._getBooleanAttribute('disabled');
+        }
+
+        set disabled(value) {
+          this._setBooleanAttribute('disabled', value);
+        }
+
+        get available() {
+          return this._getBooleanAttribute('available');
+        }
+
+        set available(value) {
+          this._setBooleanAttribute('available', value);
+        }
+
+        _handleActionClick(event) {
+          const link = event.target.closest('a.btn');
+          if (!link) return;
+
+          if (this.soldOut || this.disabled) {
+            event.preventDefault();
+            event.stopPropagation();
+            return;
+          }
+
+          this.dispatchEvent(
+            new CustomEvent('coffee-select', {
+              bubbles: true,
+              composed: true,
+              detail: {
+                name: this.name || this.title,
+                price: this.price,
+                roast: this.roast,
+                href: this.href,
+                featured: this.featured,
+                seasonal: this.seasonal,
+                iced: this.iced,
+              },
+            })
+          );
+        }
+
+        _escapeHtml(str) {
+          return String(str)
+            .replace(/&/g, '&amp;')
+            .replace(/</g, '&lt;')
+            .replace(/>/g, '&gt;')
+            .replace(/"/g, '&quot;')
+            .replace(/'/g, '&#39;');
+        }
+
+        _buildCardMarkup() {
+          const displayName = this._escapeHtml(this.name || this.title || 'Artisanal Coffee');
+          const displayDesc = this._escapeHtml(this.description);
+          const displayHref = this._escapeHtml(this.href || '#');
+          const isUnavailable = this.soldOut || this.disabled;
+          const displayCta = isUnavailable ? 'Sold Out' : this._escapeHtml(this.cta || 'View Details');
+
+          const badges = [];
+          if (this.featured) {
+            badges.push('<span class="badge badge-featured">Featured</span>');
+          }
+          if (this.seasonal) {
+            badges.push('<span class="badge badge-seasonal">Seasonal</span>');
+          }
+          if (this.iced) {
+            badges.push('<span class="badge badge-iced">Iced</span>');
+          }
+          if (isUnavailable) {
+            badges.push('<span class="badge badge-sold-out">Sold Out</span>');
+          }
+
+          const metaItems = [];
+          if (this.roast) {
+            metaItems.push(`<span class="meta-item roast">${this._escapeHtml(this.roast)} Roast</span>`);
+          }
+          if (this.origin) {
+            metaItems.push(`<span class="meta-item origin">${this._escapeHtml(this.origin)}</span>`);
+          }
+          if (this.hasAttribute('rating') && this.rating > 0) {
+            metaItems.push(`<span class="meta-item rating" aria-label="Rating ${this.rating} out of 5">&starf; ${this.rating.toFixed(1)}</span>`);
+          }
+          if (this.hasAttribute('calories') && this.calories >= 0) {
+            metaItems.push(`<span class="meta-item calories">${this.calories} cal</span>`);
+          }
+
+          const hasPrice = this.hasAttribute('price') && this.price > 0;
+          const priceMarkup = hasPrice
+            ? `<div class="price" data-price="${this.price}">$${this.price.toFixed(2)}</div>`
+            : '';
+
+          const imageMarkup = this.image
+            ? `<img class="card-image" src="${this._escapeHtml(this.image)}" alt="${displayName}" loading="lazy">`
+            : '';
+
+          const cardClasses = [
+            'card',
+            this.featured ? 'is-featured' : '',
+            this.seasonal ? 'is-seasonal' : '',
+            isUnavailable ? 'is-sold-out' : '',
+          ]
+            .filter(Boolean)
+            .join(' ');
+
+          return `
+            <article class="${cardClasses}">
+              ${imageMarkup}
+              ${badges.length ? `<div class="badges">${badges.join('')}</div>` : ''}
+              <h3>${displayName}</h3>
+              <p class="description">${displayDesc}</p>
+              ${metaItems.length ? `<div class="meta">${metaItems.join(' &bull; ')}</div>` : ''}
+              ${priceMarkup}
+              <a href="${displayHref}" class="btn${isUnavailable ? ' btn-disabled' : ''}" ${isUnavailable ? 'aria-disabled="true" tabindex="-1"' : ''}>${displayCta}</a>
+            </article>
+          `;
+        }
+
+        render() {
+          const markup = this._buildCardMarkup();
+
+          this.shadowRoot.innerHTML = `
+            <style>
+              :host {
+                display: block;
+              }
+
+              :host([hidden]) {
+                display: none;
+              }
+
+              * {
+                box-sizing: border-box;
+                margin: 0;
+                padding: 0;
+              }
+
+              .card {
+                background: white;
+                padding: 20px;
+                border-radius: 8px;
+                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+                text-align: center;
+                height: 100%;
+                display: flex;
+                flex-direction: column;
+                justify-content: space-between;
+                border: 2px solid transparent;
+                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+              }
+
+              .card.is-featured {
+                border-color: var(--accent, #ffab40);
+                box-shadow: 0 4px 12px rgba(255, 171, 64, 0.2);
+              }
+
+              .card.is-sold-out {
+                opacity: 0.7;
+              }
+
+              .card-image {
+                width: 100%;
+                height: 160px;
+                object-fit: cover;
+                border-radius: 6px;
+                margin-bottom: 12px;
+              }
+
+              .badges {
+                display: flex;
+                justify-content: center;
+                flex-wrap: wrap;
+                gap: 6px;
+                margin-bottom: 10px;
+              }
+
+              .badge {
+                font-size: 0.72rem;
+                font-weight: 600;
+                text-transform: uppercase;
+                letter-spacing: 0.5px;
+                padding: 2px 8px;
+                border-radius: 999px;
+              }
+
+              .badge-featured {
+                background: var(--accent, #ffab40);
+                color: var(--text, #3e2723);
+              }
+
+              .badge-seasonal {
+                background: var(--secondary, #d7ccc8);
+                color: var(--primary, #4e342e);
+              }
+
+              .badge-iced {
+                background: #e1f5fe;
+                color: #0277bd;
+              }
+
+              .badge-sold-out {
+                background: #ffebee;
+                color: #c62828;
+              }
+
+              .card h3 {
+                margin-bottom: 10px;
+                color: var(--primary, #4e342e);
+              }
+
+              .description {
+                color: var(--text, #3e2723);
+                margin-bottom: 12px;
+                flex-grow: 1;
+              }
+
+              .meta {
+                font-size: 0.85rem;
+                color: #6d4c41;
+                margin-bottom: 10px;
+              }
+
+              .price {
+                font-size: 1.25rem;
+                font-weight: bold;
+                color: var(--primary, #4e342e);
+                margin-bottom: 5px;
+              }
+
+              .btn {
+                display: inline-block;
+                background: var(--primary, #4e342e);
+                color: white;
+                padding: 10px 20px;
+                text-decoration: none;
+                border-radius: 5px;
+                margin-top: 15px;
+                transition: background 0.3s;
+                align-self: center;
+              }
+
+              .btn:hover {
+                background: #3e2723;
+              }
+
+              .btn.btn-disabled {
+                background: #9e9e9e;
+                cursor: not-allowed;
+              }
+            </style>
+            ${markup}
+          `;
+
+          if (this._isConnected) {
+            this.innerHTML = markup;
+          }
+        }
+      }
+
+      customElements.define('coffee-card', CoffeeCard);
+      window.CoffeeCard = CoffeeCard;
+    }
+  </script>
 </body>
 
 </html>
