+  <script>
+    (function () {
+      let activeCleanup = null;
+
+      function resolveTargetElement(trigger) {
+        const dataTarget = trigger.getAttribute('data-scroll-target');
+        if (dataTarget) {
+          const cleanId = dataTarget.replace(/^#/, '');
+          const byId = document.getElementById(cleanId);
+          if (byId) return byId;
+          try {
+            const bySelector = document.querySelector(dataTarget);
+            if (bySelector) return bySelector;
+          } catch (_) {}
+        }
+
+        const href = trigger.getAttribute('href');
+        if (href && href.startsWith('#') && href.length > 1) {
+          const cleanId = decodeURIComponent(href.slice(1));
+          return document.getElementById(cleanId);
+        }
+
+        return null;
+      }
+
+      function clearTargetEffects() {
+        document.querySelectorAll('.page-section, [data-scroll-complete], [data-highlighted]').forEach((section) => {
+          section.classList.remove('section-active', 'scroll-target-active', 'highlighted');
+          section.removeAttribute('data-scroll-complete');
+          section.removeAttribute('data-highlighted');
+        });
+      }
+
+      function applyPostScrollEffects(target, trigger) {
+        clearTargetEffects();
+
+        document.querySelectorAll('nav a').forEach((link) => {
+          link.classList.toggle('nav-active', link === trigger);
+          if (link === trigger) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        target.classList.add('section-active', 'scroll-target-active', 'highlighted');
+        target.setAttribute('data-scroll-complete', 'true');
+        target.setAttribute('data-highlighted', 'true');
+
+        if (!target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+        target.focus({ preventScroll: true });
+
+        if (typeof target.animate === 'function') {
+          target.animate(
+            [
+              { transform: 'translateY(0px) scale(1)', boxShadow: '0 0 0 0 rgba(255, 171, 64, 0.55)' },
+              { transform: 'translateY(-4px) scale(1.008)', boxShadow: '0 0 0 10px rgba(255, 171, 64, 0.3)' },
+              { transform: 'translateY(-2px) scale(1)', boxShadow: '0 0 0 4px rgba(255, 171, 64, 0.25)' }
+            ],
+            { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
+          );
+        }
+
+        if (target.id && history.replaceState) {
+          history.replaceState(null, '', '#' + target.id);
+        }
+
+        target.dispatchEvent(new CustomEvent('scrollcomplete', { bubbles: true, detail: { target, trigger } }));
+      }
+
+      function scrollToTargetWithCompletion(target, trigger) {
+        if (activeCleanup) {
+          activeCleanup();
+          activeCleanup = null;
+        }
+
+        clearTargetEffects();
+        if (document.activeElement && document.activeElement !== document.body) {
+          document.activeElement.blur();
+        }
+
+        const nav = document.querySelector('nav');
+        const navOffset = nav ? nav.getBoundingClientRect().height + 16 : 84;
+        const rawTargetTop = window.scrollY + target.getBoundingClientRect().top - navOffset;
+        const maxScrollTop = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+        const destinationY = Math.max(0, Math.min(rawTargetTop, maxScrollTop));
+        const initialY = window.scrollY;
+        const distance = Math.abs(destinationY - initialY);
+
+        let completed = false;
+        let hasScrolled = false;
+        let debounceTimer = null;
+        let fallbackTimer = null;
+
+        function cleanup() {
+          window.removeEventListener('scroll', onScroll, { passive: true });
+          window.removeEventListener('scrollend', onScrollEnd);
+          if (debounceTimer) clearTimeout(debounceTimer);
+          if (fallbackTimer) clearTimeout(fallbackTimer);
+        }
+
+        function finish() {
+          if (completed) return;
+          completed = true;
+          cleanup();
+          activeCleanup = null;
+          applyPostScrollEffects(target, trigger);
+        }
+
+        function onScroll() {
+          hasScrolled = true;
+          if (debounceTimer) clearTimeout(debounceTimer);
+          const remaining = Math.abs(window.scrollY - destinationY);
+          const waitMs = remaining <= 2 ? 60 : 140;
+          debounceTimer = setTimeout(finish, waitMs);
+        }
+
+        function onScrollEnd() {
+          if (distance > 2 && !hasScrolled && Math.abs(window.scrollY - destinationY) > 2) {
+            return;
+          }
+          finish();
+        }
+
+        activeCleanup = cleanup;
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd);
+
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+
+        if (distance <= 2) {
+          fallbackTimer = setTimeout(finish, 120);
+        } else {
+          fallbackTimer = setTimeout(finish, 1200);
+        }
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+        if (!link) return;
+
+        const target = resolveTargetElement(link);
+        if (!target) return;
+
+        event.preventDefault();
+        scrollToTargetWithCompletion(target, link);
+      });
+    })();
+  </script>
