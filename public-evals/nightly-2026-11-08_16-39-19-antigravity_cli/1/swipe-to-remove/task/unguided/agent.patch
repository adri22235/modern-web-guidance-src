+  <script>
+    (function () {
+      const ACTION_COLOR = '#e53935';
+      const ACTION_TINT = '#ffebee';
+      const DEFAULT_TRACK_BG = '#d7ccc8';
+      const DEFAULT_CONTENT_BG = '#ffffff';
+
+      function getEventX(e) {
+        if (e.touches && e.touches.length > 0) {
+          return e.touches[0].clientX ?? e.touches[0].pageX ?? e.touches[0].screenX ?? 0;
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return e.changedTouches[0].clientX ?? e.changedTouches[0].pageX ?? e.changedTouches[0].screenX ?? 0;
+        }
+        if (typeof e.clientX === 'number') return e.clientX;
+        if (typeof e.pageX === 'number') return e.pageX;
+        if (typeof e.screenX === 'number') return e.screenX;
+        if (typeof e.x === 'number') return e.x;
+        return null;
+      }
+
+      function initSwipeableItem(item) {
+        if (item.classList.contains('is-initialized')) return;
+        item.classList.add('is-initialized');
+
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let isDragging = false;
+        let isRemoving = false;
+        let startX = 0;
+        let deltaX = 0;
+        let autoRemoveTimer = null;
+
+        function getThreshold() {
+          const width = item.offsetWidth || 300;
+          return Math.min(80, Math.max(40, width * 0.2));
+        }
+
+        function applyActionState(active) {
+          if (active) {
+            item.classList.add('is-past-threshold', 'is-active');
+            item.style.backgroundColor = ACTION_COLOR;
+            track.style.backgroundColor = ACTION_COLOR;
+            content.style.backgroundColor = ACTION_TINT;
+          } else {
+            item.classList.remove('is-past-threshold', 'is-active');
+            item.style.backgroundColor = DEFAULT_TRACK_BG;
+            track.style.backgroundColor = DEFAULT_TRACK_BG;
+            content.style.backgroundColor = DEFAULT_CONTENT_BG;
+          }
+        }
+
+        function setTranslate(dx, withTransition) {
+          const transitionValue = withTransition ? 'transform 0.25s ease' : 'none';
+          track.style.transition = transitionValue;
+          content.style.transition = transitionValue;
+          const half = dx * 0.5;
+          track.style.transform = `translateX(${half}px)`;
+          content.style.transform = `translateX(${half}px)`;
+        }
+
+        function collapseAndRemove() {
+          if (isRemoving) return;
+          isRemoving = true;
+          isDragging = false;
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+
+          item.classList.remove('is-dragging');
+          item.classList.add('is-removing', 'is-past-threshold');
+          applyActionState(true);
+
+          const dir = deltaX < 0 ? -1 : 1;
+          const width = item.offsetWidth || 400;
+          setTranslate(dir * width, true);
+
+          const currentHeight = item.offsetHeight;
+          item.style.height = `${currentHeight}px`;
+          void item.offsetHeight;
+
+          item.style.transition = 'height 0.3s ease, margin 0.3s ease, padding 0.3s ease, border-width 0.3s ease, opacity 0.3s ease';
+          item.style.height = '0px';
+          item.style.marginTop = '0px';
+          item.style.marginBottom = '0px';
+          item.style.paddingTop = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.borderWidth = '0px';
+          item.style.opacity = '0';
+
+          let removed = false;
+          function removeElement() {
+            if (removed) return;
+            removed = true;
+            if (item.parentNode) {
+              item.remove();
+            }
+          }
+
+          item.addEventListener('transitionend', function onEnd(ev) {
+            if (ev.propertyName === 'height') {
+              item.removeEventListener('transitionend', onEnd);
+              removeElement();
+            }
+          });
+          setTimeout(removeElement, 320);
+        }
+
+        function onStart(e) {
+          if (isRemoving || isDragging) return;
+          const x = getEventX(e);
+          if (x === null) return;
+          isDragging = true;
+          startX = x;
+          deltaX = 0;
+          item.classList.add('is-dragging');
+          track.style.transition = 'none';
+          content.style.transition = 'none';
+        }
+
+        function onMove(e) {
+          if (!isDragging || isRemoving) return;
+          const x = getEventX(e);
+          if (x === null) return;
+          deltaX = x - startX;
+          setTranslate(deltaX, false);
+
+          const pastThreshold = Math.abs(deltaX) >= getThreshold();
+          applyActionState(pastThreshold);
+
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+          if (pastThreshold) {
+            autoRemoveTimer = setTimeout(function () {
+              if (isDragging && Math.abs(deltaX) >= getThreshold()) {
+                collapseAndRemove();
+              }
+            }, 250);
+          }
+        }
+
+        function onEnd(e) {
+          if (!isDragging || isRemoving) return;
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+          const x = getEventX(e);
+          if (x !== null && x !== startX) {
+            deltaX = x - startX;
+          }
+          isDragging = false;
+          item.classList.remove('is-dragging');
+
+          if (Math.abs(deltaX) >= getThreshold()) {
+            collapseAndRemove();
+          } else {
+            applyActionState(false);
+            setTranslate(0, true);
+            deltaX = 0;
+          }
+        }
+
+        item.addEventListener('pointerdown', onStart);
+        item.addEventListener('mousedown', onStart);
+        item.addEventListener('touchstart', onStart, { passive: true });
+
+        window.addEventListener('pointermove', onMove, true);
+        window.addEventListener('mousemove', onMove, true);
+        window.addEventListener('touchmove', onMove, { capture: true, passive: true });
+
+        window.addEventListener('pointerup', onEnd, true);
+        window.addEventListener('pointercancel', onEnd, true);
+        window.addEventListener('mouseup', onEnd, true);
+        window.addEventListener('touchend', onEnd, true);
+        window.addEventListener('touchcancel', onEnd, true);
+      }
+
+      function initAllSwipeableLists() {
+        const items = document.querySelectorAll('.SwipeableList .SwipeableList-item');
+        items.forEach(initSwipeableItem);
+      }
+
+      initAllSwipeableLists();
+      document.addEventListener('DOMContentLoaded', initAllSwipeableLists);
+    })();
+  </script>
+
