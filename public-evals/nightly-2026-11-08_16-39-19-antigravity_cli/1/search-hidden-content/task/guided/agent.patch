+  <script>
+    const revealBtn = document.getElementById('reveal-coupon-btn');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    if (revealBtn && couponPanel) {
+      revealBtn.addEventListener('click', () => {
+        const isHidden = Boolean(couponPanel.hidden);
+        if (isHidden) {
+          couponPanel.removeAttribute('hidden');
+          revealBtn.setAttribute('aria-expanded', 'true');
+        } else {
+          couponPanel.setAttribute('hidden', 'until-found');
+          revealBtn.setAttribute('aria-expanded', 'false');
+        }
+      });
+
+      couponPanel.addEventListener('beforematch', () => {
+        revealBtn.setAttribute('aria-expanded', 'true');
+      });
+    }
+
+    // Fallback for browsers where hidden="until-found" is unsupported
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        if (el.id) {
+          document.querySelectorAll(`[aria-controls="${CSS.escape(el.id)}"]`).forEach((ctrl) => {
+            ctrl.setAttribute('aria-expanded', 'true');
+          });
+        }
+      });
+    }
+
+    // Fallback for browsers where mutually exclusive <details name="..."> is unsupported
+    if (!Object.hasOwn(HTMLDetailsElement.prototype, 'name')) {
+      document.addEventListener('toggle', (event) => {
+        const details = event.target;
+        if (!(details instanceof HTMLDetailsElement) || !details.open || !details.hasAttribute('name')) return;
+
+        const name = CSS.escape(details.getAttribute('name'));
+        for (const other of document.querySelectorAll(`details[name="${name}"]`)) {
+          if (other !== details) other.open = false;
+        }
+      }, { capture: true });
+    }
+  </script>
