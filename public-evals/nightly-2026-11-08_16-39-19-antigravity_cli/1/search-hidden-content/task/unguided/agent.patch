+  <script>
+    (function () {
+      const wholesaleTabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+
+      function activateTab(activeTab) {
+        wholesaleTabs.forEach((tab) => {
+          const content = tab.querySelector('.wholesale-tab-content');
+          if (tab === activeTab) {
+            if (!tab.open) {
+              tab.open = true;
+            }
+            if (content) {
+              content.removeAttribute('hidden');
+            }
+          } else {
+            if (tab.open) {
+              tab.open = false;
+            }
+            if (content) {
+              content.setAttribute('hidden', 'until-found');
+            }
+          }
+        });
+      }
+
+      wholesaleTabs.forEach((tab) => {
+        const summary = tab.querySelector('summary');
+        if (summary) {
+          summary.addEventListener('click', (e) => {
+            e.preventDefault();
+            activateTab(tab);
+          });
+        }
+
+        tab.addEventListener('click', (e) => {
+          if (!e.target.closest('summary')) {
+            activateTab(tab);
+          }
+        });
+
+        tab.addEventListener('toggle', () => {
+          const content = tab.querySelector('.wholesale-tab-content');
+          if (tab.open) {
+            if (content) {
+              content.removeAttribute('hidden');
+            }
+            wholesaleTabs.forEach((other) => {
+              if (other !== tab) {
+                if (other.open) {
+                  other.open = false;
+                }
+                const otherContent = other.querySelector('.wholesale-tab-content');
+                if (otherContent) {
+                  otherContent.setAttribute('hidden', 'until-found');
+                }
+              }
+            });
+          } else if (content) {
+            content.setAttribute('hidden', 'until-found');
+          }
+        });
+
+        tab.addEventListener('beforematch', () => {
+          activateTab(tab);
+        }, true);
+      });
+
+      const revealBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (couponPanel) {
+          couponPanel.removeAttribute('hidden');
+        }
+        if (revealBtn) {
+          revealBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (revealBtn) {
+        revealBtn.addEventListener('click', revealCoupon);
+      }
+
+      if (couponPanel) {
+        couponPanel.addEventListener('beforematch', revealCoupon, true);
+      }
+    })();
+  </script>
