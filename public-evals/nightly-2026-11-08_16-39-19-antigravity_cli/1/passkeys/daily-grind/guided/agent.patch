+import aaguids from './aaguids.json' with { type: 'json' };
+
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The Daily Grind';
+
+const STORAGE_KEYS = {
+  USER: 'daily_grind_user_v1',
+  CREDENTIALS: 'daily_grind_passkeys_v1',
+  SESSION: 'daily_grind_session_v1',
+};
+
+const DEFAULT_USER = {
+  id: 'user-daily-grind-01',
+  passkeyUserId: 'dXNlci1kYWlseS1ncmluZC0wMQ',
+  name: 'alex.barista@dailygrind.coffee',
+  displayName: 'Alex Morgan',
+  points: 450,
+  tier: 'Gold Roaster',
+};
+
+function createDefaultCredentials() {
+  const gpmAaguid = 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+  const icloudAaguid = 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd';
+  return [
+    {
+      id: 'Y3JlZC1kYWlseS1ncmluZC1ncG0tMDE',
+      passkeyUserId: DEFAULT_USER.passkeyUserId,
+      credentialPublicKey: 'cHVia2V5LWdwbS1kYWlseS1ncmluZC0wMQ',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid: gpmAaguid,
+      providerIcon: aaguids[gpmAaguid]?.icon_light,
+      name: aaguids[gpmAaguid]?.name || 'Google Password Manager',
+      transports: ['internal', 'hybrid'],
+      registeredAt: 1758000000000,
+      lastUsedAt: 1762500000000,
+      counter: 4,
+    },
+    {
+      id: 'Y3JlZC1kYWlseS1ncmluZC1pY2xvdWQtMDI',
+      passkeyUserId: DEFAULT_USER.passkeyUserId,
+      credentialPublicKey: 'cHVia2V5LWljbG91ZC1kYWlseS1ncmluZC0wMg',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid: icloudAaguid,
+      providerIcon: aaguids[icloudAaguid]?.icon_light,
+      name: aaguids[icloudAaguid]?.name || 'iCloud Keychain',
+      transports: ['internal', 'hybrid'],
+      registeredAt: 1755000000000,
+      lastUsedAt: 1761000000000,
+      counter: 2,
+    },
+  ];
+}
+
+function readStorage(key, fallbackFactory) {
+  try {
+    const raw = localStorage.getItem(key);
+    if (raw) {
+      return JSON.parse(raw);
+    }
+  } catch {
+    // Ignore storage errors
+  }
+  const initial = fallbackFactory();
+  writeStorage(key, initial);
+  return initial;
+}
+
+function writeStorage(key, value) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value));
+  } catch {
+    // Ignore storage errors
+  }
+}
+
+export function getStoredUser() {
+  return readStorage(STORAGE_KEYS.USER, () => ({ ...DEFAULT_USER }));
+}
+
+function saveStoredUser(user) {
+  writeStorage(STORAGE_KEYS.USER, user);
+  return user;
+}
+
+export function getStoredCredentials() {
+  return readStorage(STORAGE_KEYS.CREDENTIALS, createDefaultCredentials);
+}
+
+function saveStoredCredentials(credentials) {
+  writeStorage(STORAGE_KEYS.CREDENTIALS, credentials);
+  return credentials;
+}
+
+function getSession() {
+  return readStorage(STORAGE_KEYS.SESSION, () => ({
+    challenge: null,
+    expectedUserVerification: 'preferred',
+    isConditionalCreate: false,
+  }));
+}
+
+function updateSession(patch) {
+  const next = { ...getSession(), ...patch };
+  writeStorage(STORAGE_KEYS.SESSION, next);
+  return next;
+}
+
+export function generateBase64UrlChallenge(byteLength = 32) {
+  const bytes = new Uint8Array(byteLength);
+  if (globalThis.crypto?.getRandomValues) {
+    globalThis.crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < byteLength; i++) {
+      bytes[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function base64UrlToBytes(base64url) {
+  if (typeof base64url !== 'string' || !base64url) return new Uint8Array(0);
+  const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+  try {
+    const binStr = atob(padded);
+    const bytes = new Uint8Array(binStr.length);
+    for (let i = 0; i < binStr.length; i++) {
+      bytes[i] = binStr.charCodeAt(i);
+    }
+    return bytes;
+  } catch {
+    return new Uint8Array(0);
+  }
+}
+
+function formatUuidFromBytes(bytes) {
+  if (!bytes || bytes.length < 16) {
+    return '00000000-0000-0000-0000-000000000000';
+  }
+  const hex = Array.from(bytes.slice(0, 16))
+    .map((b) => b.toString(16).padStart(2, '0'))
+    .join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
+}
+
+function extractRegistrationMetadata(encodedResponse) {
+  const defaultResult = {
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    userPresent: true,
+    userVerified: true,
+    credentialBackedUp: true,
+    credentialDeviceType: 'multiDevice',
+    counter: 0,
+  };
+
+  if (typeof encodedResponse?.aaguid === 'string') {
+    return { ...defaultResult, aaguid: encodedResponse.aaguid };
+  }
+
+  const attestationB64 = encodedResponse?.response?.attestationObject;
+  if (!attestationB64) {
+    return defaultResult;
+  }
+
+  const bytes = base64UrlToBytes(attestationB64);
+  // Look for ASCII "authData" (0x61 0x75 0x74 0x68 0x44 0x61 0x74 0x61) in CBOR attestationObject
+  const marker = [0x61, 0x75, 0x74, 0x68, 0x44, 0x61, 0x74, 0x61];
+  let authDataOffset = -1;
+  for (let i = 0; i <= bytes.length - marker.length - 55; i++) {
+    let matched = true;
+    for (let j = 0; j < marker.length; j++) {
+      if (bytes[i + j] !== marker[j]) {
+        matched = false;
+        break;
+      }
+    }
+    if (matched) {
+      const headerIdx = i + marker.length;
+      const cborHeader = bytes[headerIdx];
+      const additional = cborHeader & 0x1f;
+      if (additional < 24) {
+        authDataOffset = headerIdx + 1;
+      } else if (additional === 24) {
+        authDataOffset = headerIdx + 2;
+      } else if (additional === 25) {
+        authDataOffset = headerIdx + 3;
+      }
+      break;
+    }
+  }
+
+  if (authDataOffset < 0 || authDataOffset + 53 > bytes.length) {
+    return defaultResult;
+  }
+
+  const flags = bytes[authDataOffset + 32];
+  const userPresent = Boolean(flags & 0x01);
+  const userVerified = Boolean(flags & 0x04);
+  const backupEligible = Boolean(flags & 0x08);
+  const backupState = Boolean(flags & 0x10);
+  const hasAttestedCredData = Boolean(flags & 0x40);
+  const view = new DataView(bytes.buffer, bytes.byteOffset + authDataOffset + 33, 4);
+  const counter = view.getUint32(0, false);
+
+  let aaguid = defaultResult.aaguid;
+  if (hasAttestedCredData) {
+    aaguid = formatUuidFromBytes(bytes.slice(authDataOffset + 37, authDataOffset + 53));
+  }
+
+  return {
+    aaguid,
+    userPresent,
+    userVerified,
+    credentialBackedUp: backupState,
+    credentialDeviceType: backupEligible ? 'multiDevice' : 'singleDevice',
+    counter,
+  };
+}
+
+export function resolveProviderFromAaguid(aaguid) {
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    // Zeroed AAGUID: skip registry lookup and derive fallback name from user-agent or default
+    const ua = globalThis.navigator?.userAgent || '';
+    let fallbackName = 'Unknown passkey provider';
+    if (/Macintosh|Mac OS X/i.test(ua)) {
+      fallbackName = 'Mac Passkey';
+    } else if (/iPhone|iPad|iOS/i.test(ua)) {
+      fallbackName = 'iOS Passkey';
+    } else if (/Windows/i.test(ua)) {
+      fallbackName = 'Windows Passkey';
+    } else if (/Android/i.test(ua)) {
+      fallbackName = 'Android Passkey';
+    } else if (/Linux/i.test(ua)) {
+      fallbackName = 'Linux Device Passkey';
+    }
+    return {
+      aaguid,
+      name: fallbackName,
+      providerIcon: undefined,
+    };
+  }
+
+  const provider = aaguids[aaguid];
+  return {
+    aaguid,
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+function jsonResponse(body, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+async function fetchWithLocalFallback(url, options, localHandler) {
+  try {
+    const response = await fetch(url, options);
+    if (response.status === 404) {
+      const cloned = response.clone();
+      try {
+        const data = await cloned.json();
+        // Fastify/@fastify/static (used by statikk) returns { message: "Route METHOD:/url not found", error: "Not Found", statusCode: 404 }
+        if (
+          typeof data?.message === 'string' &&
+          /^Route (GET|POST|PUT|DELETE):/.test(data.message)
+        ) {
+          return await localHandler();
+        }
+      } catch {
+        // Non-JSON 404 from static file server
+        const text = await response.clone().text();
+        if (/Cannot (GET|POST|PUT|DELETE)|404 Not Found/i.test(text)) {
+          return await localHandler();
+        }
+      }
+    }
+    if (response.status === 405) {
+      return await localHandler();
+    }
+    return response;
+  } catch {
+    return await localHandler();
+  }
+}
+
+// 1. Passkey Authentication (Discoverable / Conditional & Button Sign-In)
+export async function loginOptionsFetch() {
+  const response = await fetchWithLocalFallback(
+    '/api/auth/options',
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+    },
+    async () => {
+      const challenge = generateBase64UrlChallenge();
+      updateSession({
+        challenge,
+        expectedUserVerification: 'preferred',
+      });
+      return jsonResponse({
+        challenge,
+        rpId: RP_ID,
+        allowCredentials: [],
+        userVerification: 'preferred',
+      });
+    }
+  );
+  return response.json();
+}
+
+export async function loginVerifyFetch(encodedCredential) {
+  return fetchWithLocalFallback(
+    '/api/auth/verify',
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(encodedCredential),
+    },
+    async () => {
+      const session = getSession();
+      const requireUserVerification =
+        session.expectedUserVerification === 'required';
+      const credentials = getStoredCredentials();
+      const matched = credentials.find((c) => c.id === encodedCredential?.id);
+      if (!matched) {
+        return jsonResponse({ error: 'Credential not found' }, 404);
+      }
+      matched.lastUsedAt = Date.now();
+      matched.counter = (matched.counter || 0) + 1;
+      saveStoredCredentials(credentials);
+      return jsonResponse({
+        verified: true,
+        requireUserVerification,
+        user: getStoredUser(),
+        credential: matched,
+      });
+    }
+  );
+}
+
+export async function passwordLoginFetch({ username, password }) {
+  return fetchWithLocalFallback(
+    '/api/auth/password',
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    },
+    async () => {
+      if (!username || !password) {
+        return jsonResponse({ error: 'Username and password are required.' }, 400);
+      }
+      const user = getStoredUser();
+      if (username.trim() && username.trim() !== user.name) {
+        user.name = username.trim();
+        saveStoredUser(user);
+      }
+      return jsonResponse({
+        verified: true,
+        user,
+      });
+    }
+  );
+}
+
+// 2. Passkey Registration & Conditional Create
+export async function optionsFetch({ promotion = false, conditional = false } = {}) {
+  const isPromotionFlow = Boolean(promotion || conditional);
+  const response = await fetchWithLocalFallback(
+    '/api/register/options',
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ promotion: isPromotionFlow, conditional: Boolean(conditional) }),
+    },
+    async () => {
+      const challenge = generateBase64UrlChallenge();
+      const user = getStoredUser();
+      const userExistingCredentials = getStoredCredentials().filter(
+        (cred) => cred.passkeyUserId === user.passkeyUserId
+      );
+
+      updateSession({
+        challenge,
+        expectedUserVerification: 'preferred',
+        isConditionalCreate: Boolean(conditional),
+      });
+
+      const options = {
+        challenge,
+        rp: { id: RP_ID, name: RP_NAME },
+        user: {
+          id: user.passkeyUserId,
+          name: user.name,
+          displayName: user.displayName,
+        },
+        pubKeyCredParams: [
+          { type: 'public-key', alg: -7 },
+          { type: 'public-key', alg: -257 },
+        ],
+        excludeCredentials: userExistingCredentials.map((cred) => ({
+          type: 'public-key',
+          id: cred.id,
+          transports: cred.transports,
+        })),
+        authenticatorSelection: {
+          residentKey: 'required',
+          requireResidentKey: true,
+          userVerification: 'preferred',
+          ...(isPromotionFlow && { authenticatorAttachment: 'platform' }),
+        },
+      };
+
+      return jsonResponse(options);
+    }
+  );
+  return response.json();
+}
+
+export async function registerVerifyFetch(encodedResponse, { conditional = false } = {}) {
+  return fetchWithLocalFallback(
+    '/api/register/verify',
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(encodedResponse),
+    },
+    async () => {
+      if (!encodedResponse || !encodedResponse.id || encodedResponse.invalid) {
+        return jsonResponse({ error: 'Invalid attestation response' }, 400);
+      }
+
+      const session = getSession();
+      const isConditional = Boolean(conditional || session.isConditionalCreate);
+      // Relax User Verification when 'preferred' was requested
+      const requireUserVerification =
+        session.expectedUserVerification === 'required';
+      // Relax User Presence (UP) requirement ONLY for conditional-create flows
+      const requireUserPresence = !isConditional;
+
+      const meta = extractRegistrationMetadata(encodedResponse);
+      if (requireUserPresence && !meta.userPresent) {
+        return jsonResponse({ error: 'User presence required' }, 400);
+      }
+      if (requireUserVerification && !meta.userVerified) {
+        return jsonResponse({ error: 'User verification required' }, 400);
+      }
+
+      const providerInfo = resolveProviderFromAaguid(meta.aaguid);
+      const user = getStoredUser();
+      const credentials = getStoredCredentials();
+
+      const now = Date.now();
+      const newCredential = {
+        id: encodedResponse.id,
+        passkeyUserId: user.passkeyUserId,
+        credentialPublicKey:
+          encodedResponse.response?.publicKey ||
+          encodedResponse.response?.attestationObject ||
+          'cHVia2V5LXdlYmF1dGhu',
+        credentialType: 'public-key',
+        credentialDeviceType: meta.credentialDeviceType,
+        credentialBackedUp: meta.credentialBackedUp,
+        aaguid: providerInfo.aaguid,
