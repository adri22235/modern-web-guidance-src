+}
+
+function populateUserProfileUI(user) {
+  if (!user) return;
+  const usernameInput = document.getElementById('profile-username');
+  const displayNameInput = document.getElementById('profile-display-name');
+  const headerDisplayName = document.getElementById('account-member-name');
+  const headerUsername = document.getElementById('account-member-email');
+
+  if (usernameInput && document.activeElement !== usernameInput) {
+    usernameInput.value = user.name || '';
+  }
+  if (displayNameInput && document.activeElement !== displayNameInput) {
+    displayNameInput.value = user.displayName || '';
+  }
+  if (headerDisplayName) {
+    headerDisplayName.textContent = user.displayName || 'Coffee Lover';
+  }
+  if (headerUsername) {
+    headerUsername.textContent = user.name || '';
+  }
+}
+
+export async function loadManagementPanel() {
+  try {
+    const response = await listFetch();
+    const { rpId, userId, user, credentials } = await response.json();
+
+    if (user) {
+      populateUserProfileUI(user);
+    }
+    renderUI(credentials || []);
+    // Sync accepted credentials on initial load using server-provided rpId and userId
+    await syncAcceptedCredentials(rpId, userId, credentials || []);
+  } catch (err) {
+    console.warn('Could not load passkey management list:', err);
+  }
+}
+
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { rpId, userId, credentials } = await updatedResponse.json();
+
+    renderUI(credentials || []);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(rpId, userId, credentials || []);
+    setStatusMessage(
+      'passkey-management-status',
+      'Passkey deleted and synchronized with your password manager.',
+      'info'
+    );
+  }
+}
+
+// Renaming a passkey's nickname updates the server record only
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, {
+    name: newCredentialName,
+  });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { credentials } = await updatedResponse.json();
+    renderUI(credentials || []);
+    setStatusMessage(
+      'passkey-management-status',
+      `Passkey renamed to "${newCredentialName}".`,
+      'success'
+    );
+  }
+}
+
+// Renaming the user's account username or displayName triggers signalCurrentUserDetails
+export async function performUserRename(updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({
+    name: updatedName,
+    displayName: updatedDisplayName,
+  });
+
+  if (response.ok) {
+    const data = await response.json();
+    populateUserProfileUI(data);
+    setStatusMessage(
+      'profile-status',
+      'Profile updated and synced with your passkey provider!',
+      'success'
+    );
+
+    if (
+      window.PublicKeyCredential &&
+      PublicKeyCredential.signalCurrentUserDetails
+    ) {
+      const { rpId, userId } = data;
+      if (!rpId || !isValidBase64Url(userId)) {
+        console.warn(
+          'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+        );
+        return;
+      }
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId, // Always use server-provided rpId
+          userId, // Base64URL-encoded user ID from the server
+          name: updatedName,
+          displayName: updatedDisplayName,
+        });
+      } catch (e) {
+        console.warn('SignalCurrentUserDetails sync warning:', e);
+      }
+    }
+  } else {
+    setStatusMessage('profile-status', 'Could not update profile.', 'error');
+  }
+}
+
+// 6. Passkey Reauthentication (Step-Up Verification for Sensitive Actions)
+function showTransactionSuccessUI() {
+  const resultBox = document.getElementById('reauth-result');
+  const statusBanner = document.getElementById('reauth-status');
+  if (resultBox) {
+    resultBox.hidden = false;
+  }
+  setStatusMessage(
+    'reauth-status',
+    'Identity verified with your registered passkey! Sensitive action authorized.',
+    'success'
+  );
+  if (statusBanner) {
+    statusBanner.hidden = false;
+  }
+  loadManagementPanel();
+}
+
+export async function triggerButtonReauth() {
+  // Abort any background suggestion flows to avoid passkey prompt collisions
+  reauthAbortController.abort();
+  reauthAbortController = new AbortController();
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  const optionsJSON = await reauthOptionsFetch();
+  const publicKey =
+    PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  try {
+    const credential = await navigator.credentials.get({
+      publicKey,
+      signal: reauthAbortController.signal,
+    });
+
+    if (credential) {
+      const encodedCredential = credential.toJSON();
+      const verifyResponse = await reauthVerifyFetch(encodedCredential);
+
+      if (verifyResponse.ok) {
+        showTransactionSuccessUI();
+      } else if (
+        verifyResponse.status === 404 &&
+        PublicKeyCredential.signalUnknownCredential
+      ) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId, // Always use server-provided rpId
+          credentialId: encodedCredential.id,
+        });
+        setStatusMessage(
+          'reauth-status',
+          'Passkey was not found for your account and has been removed from suggestions.',
+          'error'
+        );
+      } else {
+        setStatusMessage(
+          'reauth-status',
+          'Reauthentication failed: credential does not match active user.',
+          'error'
+        );
+      }
+    }
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      setStatusMessage(
+        'reauth-status',
+        'Reauthentication was cancelled.',
+        'info'
+      );
+    } else if (err.name !== 'AbortError') {
+      setStatusMessage(
+        'reauth-status',
+        'Could not verify identity with passkey.',
+        'error'
+      );
+    }
+  }
+}
+
+function handleSuccessfulSignIn(user, message) {
+  if (user) {
+    populateUserProfileUI(user);
+  }
+  setStatusMessage('auth-status', message || 'Signed in successfully!', 'success');
+  const postLoginPromo = document.getElementById('post-login-passkey-promo');
+  if (postLoginPromo) {
+    postLoginPromo.hidden = false;
+  }
+  loadManagementPanel();
+}
+
+function bindEventListeners() {
+  const signinForm = document.getElementById('signin-form');
+  if (signinForm) {
+    signinForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const formData = new FormData(signinForm);
+      const username = String(formData.get('username') || '').trim();
+      const password = String(formData.get('password') || '');
+
+      const response = await passwordLoginFetch({ username, password });
+      if (response.ok) {
+        const data = await response.json();
+        handleSuccessfulSignIn(
+          data.user,
+          `Welcome back, ${data.user?.displayName || username}!`
+        );
+        // Immediately attempt silent post-login passkey creation after password sign-in
+        await triggerConditionalCreate(autofillAbortController);
+      } else {
+        setStatusMessage(
+          'auth-status',
+          'Please enter your username and password to sign in.',
+          'error'
+        );
+      }
+    });
+  }
+
+  const passkeySigninBtn = document.getElementById('passkey-signin-btn');
+  if (passkeySigninBtn) {
+    passkeySigninBtn.addEventListener('click', () => {
+      triggerButtonAuthentication();
+    });
+  }
+
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+  if (createPasskeyBtn) {
+    createPasskeyBtn.addEventListener('click', () => {
+      registerPasskey(false);
+    });
+  }
+
+  const promotePasskeyBtn = document.getElementById('promote-passkey-btn');
+  if (promotePasskeyBtn) {
+    promotePasskeyBtn.addEventListener('click', () => {
+      registerPasskey(true);
+    });
+  }
+
+  const profileForm = document.getElementById('profile-form');
+  if (profileForm) {
+    profileForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const usernameInput = document.getElementById('profile-username');
+      const displayNameInput = document.getElementById('profile-display-name');
+      const updatedName = usernameInput ? usernameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput
+        ? displayNameInput.value.trim()
+        : '';
+      await performUserRename(updatedName, updatedDisplayName);
+    });
+  }
+
+  const reauthBtn = document.getElementById('reauth-btn');
+  if (reauthBtn) {
+    reauthBtn.addEventListener('click', () => {
+      triggerButtonReauth();
+    });
+  }
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  bindEventListeners();
+  gatePasskeyCapabilitiesOnLoad();
+  initializeConditionalAutofill();
+  loadManagementPanel();
+});
