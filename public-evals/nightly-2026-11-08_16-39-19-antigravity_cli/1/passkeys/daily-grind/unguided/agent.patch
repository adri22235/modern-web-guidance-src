+            saveUsers(users);
+          }
+
+          els.addPasskeyForm.reset();
+          renderAccountUI();
+          showAlert(`Added new passkey "${newPasskey.label}" to your account.`, 'success');
+        } catch (err) {
+          showAlert(`Could not add new passkey: ${err && err.message ? err.message : 'Operation cancelled'}`, 'error');
+        } finally {
+          els.addPasskeyBtn.disabled = false;
+        }
+      });
+
+      function handleRenamePasskey(credentialId, newLabel) {
+        const trimmed = (newLabel || '').trim();
+        if (!trimmed) {
+          showAlert('Passkey label cannot be empty.', 'error');
+          return;
+        }
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const users = loadUsers();
+        const u = users.find((item) => item.id === user.id);
+        if (!u || !u.passkeys) return;
+
+        const pk = u.passkeys.find((p) => p.credentialId === credentialId);
+        if (pk) {
+          pk.label = trimmed;
+          saveUsers(users);
+          editingPasskeyId = null;
+          renderAccountUI();
+          showAlert(`Passkey renamed to "${trimmed}".`, 'success');
+        }
+      }
+
+      function handleDeletePasskey(credentialId) {
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const users = loadUsers();
+        const u = users.find((item) => item.id === user.id);
+        if (!u || !u.passkeys) return;
+
+        const target = u.passkeys.find((p) => p.credentialId === credentialId);
+        if (!target) return;
+
+        u.passkeys = u.passkeys.filter((p) => p.credentialId !== credentialId);
+        saveUsers(users);
+        if (editingPasskeyId === credentialId) {
+          editingPasskeyId = null;
+        }
+        renderAccountUI();
+        showAlert(`Removed passkey "${target.label}" from your account.`, 'info');
+      }
+
+      // --- 4 & 5. Reauthentication & Profile Updates ---
+      async function performReauthentication(reasonMessage) {
+        const user = getCurrentUser();
+        if (!user) {
+          throw new Error('No active user session to reauthenticate.');
+        }
+        if (!user.passkeys || user.passkeys.length === 0) {
+          throw new Error('No saved passkeys are registered on this account for reauthentication.');
+        }
+
+        const result = await requestPasskeyAssertion(user.passkeys);
+        const users = loadUsers();
+        const currentUserRecord = users.find((u) => u.id === user.id);
+        const matchedPasskey =
+          currentUserRecord &&
+          (currentUserRecord.passkeys || []).find((pk) => matchPasskey(pk, result));
+
+        if (!matchedPasskey) {
+          throw new Error('Presented passkey does not match any saved passkey for this account.');
+        }
+
+        matchedPasskey.lastUsedAt = Date.now();
+        matchedPasskey.useCount = (matchedPasskey.useCount || 0) + 1;
+        saveUsers(users);
+
+        const session = loadSession() || { userId: user.id };
+        session.lastReauthenticatedAt = Date.now();
+        session.reauthCount = (session.reauthCount || 0) + 1;
+        session.requiresReauth = false;
+        session.lastCredentialId = matchedPasskey.credentialId;
+        saveSession(session);
+
+        renderAccountUI();
+        return matchedPasskey;
+      }
+
+      function openReauthModal(reasonMessage) {
+        const user = getCurrentUser();
+        if (!user) return Promise.reject(new Error('Not signed in'));
+
+        els.reauthModalMessage.textContent =
+          reasonMessage || 'Please verify your identity with your saved passkey to continue.';
+        els.reauthModalAccount.textContent = `${user.name} (${user.email})`;
+        els.reauthModal.hidden = false;
+
+        return new Promise((resolve, reject) => {
+          pendingModalResolve = { resolve, reject };
+        });
+      }
+
+      function closeReauthModal() {
+        els.reauthModal.hidden = true;
+        pendingModalResolve = null;
+      }
+
+      els.reauthModalCancelBtn.addEventListener('click', () => {
+        if (pendingModalResolve) {
+          pendingModalResolve.reject(new Error('Reauthentication cancelled by user.'));
+        }
+        closeReauthModal();
+      });
+
+      els.reauthModalVerifyBtn.addEventListener('click', async () => {
+        els.reauthModalVerifyBtn.disabled = true;
+        try {
+          const pk = await performReauthentication();
+          if (pendingModalResolve) {
+            pendingModalResolve.resolve(pk);
+          }
+          closeReauthModal();
+          showAlert(`Reauthentication successful with passkey "${pk.label}".`, 'success');
+        } catch (err) {
+          showAlert(`Reauthentication failed: ${err && err.message ? err.message : 'Verification error'}`, 'error');
+        } finally {
+          els.reauthModalVerifyBtn.disabled = false;
+        }
+      });
+
+      async function handleDirectReauthClick() {
+        hideAlert();
+        els.reauthPasskeyBtn.disabled = true;
+        els.headerReauthBtn.disabled = true;
+        try {
+          const pk = await performReauthentication('Verify your identity with a passkey.');
+          showAlert(`Identity verified! Reauthenticated using passkey "${pk.label}".`, 'success');
+        } catch (err) {
+          showAlert(`Reauthentication failed: ${err && err.message ? err.message : 'Verification cancelled'}`, 'error');
+        } finally {
+          els.reauthPasskeyBtn.disabled = false;
+          els.headerReauthBtn.disabled = false;
+        }
+      }
+
+      els.reauthPasskeyBtn.addEventListener('click', handleDirectReauthClick);
+      els.headerReauthBtn.addEventListener('click', handleDirectReauthClick);
+
+      els.expireSessionBtn.addEventListener('click', () => {
+        const session = loadSession();
+        if (!session) return;
+        session.requiresReauth = true;
+        saveSession(session);
+        renderAccountUI();
+        showAlert('Session marked as requiring reauthentication. Please verify with your passkey before making sensitive changes.', 'warning');
+      });
+
+      // Profile Form Submission (with passkey reauthentication)
+      els.profileForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        hideAlert();
+
+        const user = getCurrentUser();
+        if (!user) {
+          showAlert('Please sign in to update your profile.', 'error');
+          return;
+        }
+
+        const newName = els.profileName.value.trim();
+        const newEmail = els.profileEmail.value.trim().toLowerCase();
+        const newPhone = els.profilePhone.value.trim();
+        const newDrink = els.profileDrink.value;
+        const newLocation = els.profileLocation.value;
+
+        if (!newName || !newEmail) {
+          showAlert('Name and email address are required.', 'error');
+          return;
+        }
+
+        const users = loadUsers();
+        if (users.some((u) => u.id !== user.id && u.email.toLowerCase() === newEmail)) {
+          showAlert('Another customer account is already using that email address.', 'error');
+          return;
+        }
+
+        const session = loadSession();
+        const needsReauth = Boolean(
+          els.profileRequireReauth.checked || (session && session.requiresReauth)
+        );
+
+        els.saveProfileBtn.disabled = true;
+        try {
+          let verifiedPasskey = null;
+          if (needsReauth) {
+            verifiedPasskey = await performReauthentication('Verify your passkey to save profile updates.');
+          }
+
+          const latestUsers = loadUsers();
+          const target = latestUsers.find((u) => u.id === user.id);
+          if (target) {
+            target.name = newName;
+            target.email = newEmail;
+            target.phone = newPhone;
+            target.favoriteDrink = newDrink;
+            target.location = newLocation;
+            target.updatedAt = Date.now();
+            saveUsers(latestUsers);
+          }
+
+          renderAccountUI();
+          if (verifiedPasskey) {
+            showAlert(`Profile updated and verified with passkey "${verifiedPasskey.label}".`, 'success');
+          } else {
+            showAlert('Profile updated successfully.', 'success');
+          }
+        } catch (err) {
+          showAlert(`Reauthentication failed. Profile changes were not saved (${err && err.message ? err.message : 'Verification cancelled'}).`, 'error');
+        } finally {
+          els.saveProfileBtn.disabled = false;
+        }
+      });
+
+      // --- Logout & Navigation Handlers ---
+      function handleLogout(e) {
+        if (e) e.preventDefault();
+        const user = getCurrentUser();
+        saveSession(null);
+        editingPasskeyId = null;
+        closeReauthModal();
+        renderAccountUI();
+        if (user) {
+          showAlert(`Signed out of ${user.name}'s account.`, 'info');
+        } else {
+          showAlert('You are currently signed out.', 'info');
+        }
+      }
+
+      els.navLogoutLink.addEventListener('click', handleLogout);
+      els.accountLogoutBtn.addEventListener('click', handleLogout);
+
+      function scrollToAccount(e) {
+        if (e) e.preventDefault();
+        els.accountSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      }
+
+      els.navAccountLink.addEventListener('click', scrollToAccount);
+      els.heroAccountBtn.addEventListener('click', scrollToAccount);
+
+      // Mode Tabs for Logged-Out View
+      els.tabRegisterBtn.addEventListener('click', () => {
+        els.tabRegisterBtn.classList.add('active');
+        els.tabRegisterBtn.setAttribute('aria-selected', 'true');
+        els.tabSigninBtn.classList.remove('active');
+        els.tabSigninBtn.setAttribute('aria-selected', 'false');
+        els.registerSection.classList.add('focused-panel');
+        els.signinSection.classList.remove('focused-panel');
+        els.registerName.focus();
+      });
+
+      els.tabSigninBtn.addEventListener('click', () => {
+        els.tabSigninBtn.classList.add('active');
+        els.tabSigninBtn.setAttribute('aria-selected', 'true');
+        els.tabRegisterBtn.classList.remove('active');
+        els.tabRegisterBtn.setAttribute('aria-selected', 'false');
+        els.signinSection.classList.add('focused-panel');
+        els.registerSection.classList.remove('focused-panel');
+        els.signinEmail.focus();
+      });
+
+      // --- Render UI State ---
+      function renderPasskeysList(user) {
+        els.passkeyList.innerHTML = '';
+        const passkeys = (user && user.passkeys) || [];
+        els.passkeyCountBadge.textContent = `${passkeys.length} ${passkeys.length === 1 ? 'Passkey' : 'Passkeys'}`;
+
+        if (passkeys.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'passkey-item';
+          emptyLi.textContent = 'No saved passkeys on this account. Add a passkey below.';
+          els.passkeyList.appendChild(emptyLi);
+          return;
+        }
+
+        passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.credentialId;
+
+          const topRow = document.createElement('div');
+          topRow.className = 'passkey-item-top';
+
+          const titleDiv = document.createElement('div');
+          titleDiv.className = 'passkey-title';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'passkey-name';
+          nameSpan.textContent = pk.label;
+
+          const idCode = document.createElement('code');
+          idCode.className = 'passkey-id-code';
+          const shortId =
+            pk.credentialId.length > 14
+              ? pk.credentialId.slice(0, 8) + '...' + pk.credentialId.slice(-4)
+              : pk.credentialId;
+          idCode.textContent = `ID: ${shortId}`;
+
+          titleDiv.appendChild(nameSpan);
+          titleDiv.appendChild(idCode);
+
+          const actionsDiv = document.createElement('div');
+          actionsDiv.className = 'passkey-actions';
+
+          const renameBtn = document.createElement('button');
+          renameBtn.type = 'button';
+          renameBtn.className = 'btn btn-outline btn-sm rename-passkey-btn';
+          renameBtn.textContent = 'Rename';
+          renameBtn.addEventListener('click', () => {
+            editingPasskeyId = editingPasskeyId === pk.credentialId ? null : pk.credentialId;
+            renderPasskeysList(getCurrentUser());
+          });
+
+          const deleteBtn = document.createElement('button');
+          deleteBtn.type = 'button';
+          deleteBtn.className = 'btn btn-danger btn-sm delete-passkey-btn';
+          deleteBtn.textContent = 'Remove';
+          deleteBtn.setAttribute('aria-label', `Remove passkey ${pk.label}`);
+          deleteBtn.addEventListener('click', () => {
+            handleDeletePasskey(pk.credentialId);
+          });
+
+          actionsDiv.appendChild(renameBtn);
+          actionsDiv.appendChild(deleteBtn);
+
+          topRow.appendChild(titleDiv);
+          topRow.appendChild(actionsDiv);
+          li.appendChild(topRow);
+
+          if (editingPasskeyId === pk.credentialId) {
+            const renameRow = document.createElement('div');
+            renameRow.className = 'rename-inline-row';
+
+            const renameInput = document.createElement('input');
+            renameInput.type = 'text';
+            renameInput.className = 'rename-passkey-input';
+            renameInput.value = pk.label;
+            renameInput.setAttribute('aria-label', 'New passkey label');
+
+            const saveRenameBtn = document.createElement('button');
+            saveRenameBtn.type = 'button';
+            saveRenameBtn.className = 'btn btn-sm save-rename-btn';
+            saveRenameBtn.textContent = 'Save';
+            saveRenameBtn.addEventListener('click', () => {
+              handleRenamePasskey(pk.credentialId, renameInput.value);
+            });
+
+            const cancelRenameBtn = document.createElement('button');
+            cancelRenameBtn.type = 'button';
+            cancelRenameBtn.className = 'btn btn-outline btn-sm';
+            cancelRenameBtn.textContent = 'Cancel';
+            cancelRenameBtn.addEventListener('click', () => {
+              editingPasskeyId = null;
+              renderPasskeysList(getCurrentUser());
+            });
+
+            renameRow.appendChild(renameInput);
+            renameRow.appendChild(saveRenameBtn);
+            renameRow.appendChild(cancelRenameBtn);
+            li.appendChild(renameRow);
+          }
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+          metaDiv.innerHTML =
+            `<span>Created: ${formatTimestamp(pk.createdAt)}</span>` +
+            `<span>Last Used: ${formatTimestamp(pk.lastUsedAt)}</span>` +
+            `<span>Uses: ${pk.useCount || 1}</span>`;
+          li.appendChild(metaDiv);
+
+          els.passkeyList.appendChild(li);
+        });
+      }
+
+      function renderAccountUI() {
+        const user = getCurrentUser();
+        const session = loadSession();
+
+        if (!user) {
+          els.loggedOutView.hidden = false;
+          els.loggedInView.hidden = true;
+          els.navUserIndicator.hidden = true;
+          els.navUserName.textContent = '';
+          return;
+        }
+
+        els.loggedOutView.hidden = true;
+        els.loggedInView.hidden = false;
+
+        // Nav indicator
+        els.navUserIndicator.hidden = false;
+        els.navUserName.textContent = user.name;
+
+        // Summary Header
+        els.customerAvatar.textContent = getInitials(user.name);
+        els.userDisplayName.textContent = user.name;
+        els.userDisplayEmail.textContent = user.email;
+        els.userDisplayMeta.textContent = `Favorite: ${user.favoriteDrink || 'Maple Oat Latte'} • Location: ${user.location || 'Downtown Roastery'}`;
+
+        // Session & Reauth Status
+        const requiresReauth = Boolean(session && session.requiresReauth);
+        if (requiresReauth) {
+          els.sessionAuthBadge.className = 'badge badge-stale';
+          els.sessionAuthBadge.textContent = '⚠ Reauthentication Required';
+          els.reauthStatusText.textContent = 'Reauthentication Required';
+        } else {
+          els.sessionAuthBadge.className = 'badge badge-verified';
+          els.sessionAuthBadge.textContent = '✓ Authenticated via Passkey';
+          els.reauthStatusText.textContent = 'Verified (Active)';
+        }
+
+        els.lastReauthTime.textContent = formatTimestamp(session && session.lastReauthenticatedAt);
+        els.reauthCount.textContent = String((session && session.reauthCount) || 1);
+
+        // Profile Form values
+        els.profileName.value = user.name || '';
+        els.profileEmail.value = user.email || '';
+        els.profilePhone.value = user.phone || '';
+        els.profileDrink.value = user.favoriteDrink || 'Maple Oat Latte';
+        els.profileLocation.value = user.location || 'Downtown Roastery';
+
+        // Saved Passkeys
+        renderPasskeysList(user);
+      }
+
+      // Initialize
+      updateWebAuthnBadge();
+      renderAccountUI();
+    })();
+  </script>
 </body>
 
 </html>
