+export interface AuthenticatorMetadata {
+  name: string;
+  provider: string;
+  icon: 'apple' | 'google' | 'microsoft' | '1password' | 'bitwarden' | 'dashlane' | 'proton' | 'chrome' | 'key';
+}
+
+export const KNOWN_AAGUIDS: Record<string, AuthenticatorMetadata> = {
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': {
+    name: 'iCloud Keychain',
+    provider: 'Apple',
+    icon: 'apple',
+  },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': {
+    name: 'iCloud Keychain (Managed)',
+    provider: 'Apple',
+    icon: 'apple',
+  },
+  '00000000-0000-0000-0000-000000000000': {
+    name: 'Platform Authenticator',
+    provider: 'Device / Browser',
+    icon: 'chrome',
+  },
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': {
+    name: 'Google Password Manager',
+    provider: 'Google',
+    icon: 'google',
+  },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': {
+    name: 'Chrome on Mac',
+    provider: 'Google Chrome',
+    icon: 'chrome',
+  },
+  'b5397666-4885-aa6b-cebf-e52262a439a2': {
+    name: 'Chromium Passkey',
+    provider: 'Chromium',
+    icon: 'chrome',
+  },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': {
+    name: 'Windows Hello',
+    provider: 'Microsoft',
+    icon: 'microsoft',
+  },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': {
+    name: 'Windows Hello',
+    provider: 'Microsoft',
+    icon: 'microsoft',
+  },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': {
+    name: 'Windows Hello Hardware',
+    provider: 'Microsoft',
+    icon: 'microsoft',
+  },
+  'bada5566-a7aa-401f-bd96-45619a55120d': {
+    name: '1Password',
+    provider: '1Password',
+    icon: '1password',
+  },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': {
+    name: 'Bitwarden',
+    provider: 'Bitwarden',
+    icon: 'bitwarden',
+  },
+  'f3809540-7f14-49c1-a8b3-8f813b225541': {
+    name: 'Dashlane',
+    provider: 'Dashlane',
+    icon: 'dashlane',
+  },
+  '531126d6-e717-415c-9320-3d9aa6981239': {
+    name: 'Proton Pass',
+    provider: 'Proton',
+    icon: 'proton',
+  },
+};
+
+export function resolveAuthenticatorMetadata(
+  aaguid: string,
+  userAgent?: string | null
+): AuthenticatorMetadata {
+  const normalized = (aaguid || '').toLowerCase();
+  if (KNOWN_AAGUIDS[normalized] && normalized !== '00000000-0000-0000-0000-000000000000') {
+    return KNOWN_AAGUIDS[normalized];
+  }
+
+  if (userAgent) {
+    const ua = userAgent.toLowerCase();
+    if (ua.includes('mac os') || ua.includes('iphone') || ua.includes('ipad')) {
+      return {
+        name: ua.includes('chrome') ? 'Chrome on macOS' : 'iCloud Keychain',
+        provider: 'Apple / macOS',
+        icon: 'apple',
+      };
+    }
+    if (ua.includes('windows')) {
+      return {
+        name: 'Windows Hello',
+        provider: 'Microsoft Windows',
+        icon: 'microsoft',
+      };
+    }
+    if (ua.includes('android')) {
+      return {
+        name: 'Google Password Manager',
+        provider: 'Android',
+        icon: 'google',
+      };
+    }
+    if (ua.includes('linux')) {
+      return {
+        name: 'Chrome on Linux',
+        provider: 'Linux Platform',
+        icon: 'chrome',
+      };
+    }
+  }
+
+  if (KNOWN_AAGUIDS[normalized]) {
+    return KNOWN_AAGUIDS[normalized];
+  }
+
+  return {
+    name: 'Security Passkey',
+    provider: 'WebAuthn Authenticator',
+    icon: 'key',
+  };
+}
