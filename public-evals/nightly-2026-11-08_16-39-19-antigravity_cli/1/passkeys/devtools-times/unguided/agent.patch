+import crypto from 'node:crypto';
+
+export interface ParsedAuthenticatorData {
+  rpIdHash: Buffer;
+  flags: {
+    raw: number;
+    userPresent: boolean;
+    userVerified: boolean;
+    backupEligible: boolean;
+    backedUp: boolean;
+    attestedCredentialDataIncluded: boolean;
+    extensionDataIncluded: boolean;
+  };
+  signCount: number;
+  aaguid?: string;
+  credentialId?: Buffer;
+  cosePublicKey?: Buffer;
+}
+
+/**
+ * Minimal RFC 8949 CBOR decoder supporting WebAuthn attestationObject and COSE_Key structures.
+ */
+export function decodeCborFirst(buffer: Buffer | Uint8Array, startOffset = 0): { value: any; offset: number } {
+  const buf = Buffer.isBuffer(buffer) ? buffer : Buffer.from(buffer);
+  let offset = startOffset;
+
+  function readLength(additionalInfo: number): number {
+    if (additionalInfo < 24) return additionalInfo;
+    if (additionalInfo === 24) {
+      const val = buf.readUInt8(offset);
+      offset += 1;
+      return val;
+    }
+    if (additionalInfo === 25) {
+      const val = buf.readUInt16BE(offset);
+      offset += 2;
+      return val;
+    }
+    if (additionalInfo === 26) {
+      const val = buf.readUInt32BE(offset);
+      offset += 4;
+      return val;
+    }
+    if (additionalInfo === 27) {
+      const high = buf.readUInt32BE(offset);
+      const low = buf.readUInt32BE(offset + 4);
+      offset += 8;
+      return high * 0x100000000 + low;
+    }
+    throw new Error(`Unsupported CBOR additionalInfo: ${additionalInfo}`);
+  }
+
+  function decodeItem(): any {
+    if (offset >= buf.length) {
+      throw new Error('Unexpected end of CBOR buffer');
+    }
+    const initialByte = buf.readUInt8(offset);
+    offset += 1;
+    const majorType = initialByte >> 5;
+    const additionalInfo = initialByte & 0x1f;
+
+    switch (majorType) {
+      case 0: // Unsigned integer
+        return readLength(additionalInfo);
+      case 1: // Negative integer
+        return -1 - readLength(additionalInfo);
+      case 2: { // Byte string
+        const len = readLength(additionalInfo);
+        const slice = buf.subarray(offset, offset + len);
+        offset += len;
+        return Buffer.from(slice);
+      }
+      case 3: { // Text string
+        const len = readLength(additionalInfo);
+        const str = buf.subarray(offset, offset + len).toString('utf-8');
+        offset += len;
+        return str;
+      }
+      case 4: { // Array
+        const len = readLength(additionalInfo);
+        const arr = [];
+        for (let i = 0; i < len; i++) {
+          arr.push(decodeItem());
+        }
+        return arr;
+      }
+      case 5: { // Map
+        const len = readLength(additionalInfo);
+        const map = new Map<any, any>();
+        for (let i = 0; i < len; i++) {
+          const k = decodeItem();
+          const v = decodeItem();
+          map.set(k, v);
+        }
+        return map;
+      }
+      case 6: { // Tag
+        readLength(additionalInfo);
+        return decodeItem();
+      }
+      case 7: { // Simple / float
+        if (additionalInfo === 20) return false;
+        if (additionalInfo === 21) return true;
+        if (additionalInfo === 22) return null;
+        if (additionalInfo === 23) return undefined;
+        return readLength(additionalInfo);
+      }
+      default:
+        throw new Error(`Unsupported CBOR major type: ${majorType}`);
+    }
+  }
+
+  const value = decodeItem();
+  return { value, offset };
+}
+
+export function formatAaguid(bytes: Buffer): string {
+  if (bytes.length !== 16) return '00000000-0000-0000-0000-000000000000';
+  const hex = bytes.toString('hex');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
+}
+
+export function parseAuthenticatorData(authData: Buffer): ParsedAuthenticatorData {
+  if (authData.length < 37) {
+    throw new Error(`Authenticator data too short (${authData.length} bytes)`);
+  }
+
+  const rpIdHash = authData.subarray(0, 32);
+  const rawFlags = authData.readUInt8(32);
+  const signCount = authData.readUInt32BE(33);
+
+  const flags = {
+    raw: rawFlags,
+    userPresent: Boolean(rawFlags & 0x01),
+    userVerified: Boolean(rawFlags & 0x04),
+    backupEligible: Boolean(rawFlags & 0x08),
+    backedUp: Boolean(rawFlags & 0x10),
+    attestedCredentialDataIncluded: Boolean(rawFlags & 0x40),
+    extensionDataIncluded: Boolean(rawFlags & 0x80),
+  };
+
+  const result: ParsedAuthenticatorData = {
+    rpIdHash,
+    flags,
+    signCount,
+  };
+
+  if (flags.attestedCredentialDataIncluded && authData.length >= 55) {
+    const aaguidBytes = authData.subarray(37, 53);
+    result.aaguid = formatAaguid(aaguidBytes);
+    const credIdLen = authData.readUInt16BE(53);
+    if (authData.length >= 55 + credIdLen) {
+      result.credentialId = authData.subarray(55, 55 + credIdLen);
+      result.cosePublicKey = authData.subarray(55 + credIdLen);
+    }
+  }
+
+  return result;
+}
+
+export function parseAttestationObject(attestationObjectBase64url: string): {
+  fmt: string;
+  authData: Buffer;
+  parsedAuthData: ParsedAuthenticatorData;
+} {
+  const raw = Buffer.from(attestationObjectBase64url, 'base64url');
+  const { value } = decodeCborFirst(raw);
+
+  if (value instanceof Map) {
+    const fmt = value.get('fmt') || 'none';
+    const authData = value.get('authData');
+    if (Buffer.isBuffer(authData)) {
+      return {
+        fmt,
+        authData,
+        parsedAuthData: parseAuthenticatorData(authData),
+      };
+    }
+  }
+
+  throw new Error('Invalid attestationObject CBOR structure');
+}
+
+export function cosePublicKeyToPem(cosePublicKeyBuffer: Buffer): { pem: string; algorithm: number } {
+  const { value: coseMap } = decodeCborFirst(cosePublicKeyBuffer);
+  if (!(coseMap instanceof Map)) {
+    throw new Error('COSE public key is not a CBOR map');
+  }
+
+  const kty = coseMap.get(1);
+  const alg = coseMap.get(3) ?? -7;
+
+  // EC2 (P-256 / ES256)
+  if (kty === 2) {
+    const x: Buffer = coseMap.get(-2);
+    const y: Buffer = coseMap.get(-3);
+    if (!Buffer.isBuffer(x) || !Buffer.isBuffer(y)) {
+      throw new Error('Invalid EC2 COSE key coordinates');
+    }
+    const jwk: crypto.JsonWebKey = {
+      kty: 'EC',
+      crv: 'P-256',
+      x: x.toString('base64url'),
+      y: y.toString('base64url'),
+    };
+    const keyObject = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+    return {
+      pem: keyObject.export({ type: 'spki', format: 'pem' }).toString(),
+      algorithm: alg,
+    };
+  }
+
+  // RSA (RS256)
+  if (kty === 3) {
+    const n: Buffer = coseMap.get(-1);
+    const e: Buffer = coseMap.get(-2);
+    if (!Buffer.isBuffer(n) || !Buffer.isBuffer(e)) {
+      throw new Error('Invalid RSA COSE key parameters');
+    }
+    const jwk: crypto.JsonWebKey = {
+      kty: 'RSA',
+      n: n.toString('base64url'),
+      e: e.toString('base64url'),
+    };
+    const keyObject = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+    return {
+      pem: keyObject.export({ type: 'spki', format: 'pem' }).toString(),
+      algorithm: alg,
+    };
+  }
+
+  // OKP (Ed25519 / EdDSA)
+  if (kty === 1) {
+    const x: Buffer = coseMap.get(-2);
+    if (!Buffer.isBuffer(x)) {
+      throw new Error('Invalid OKP COSE key parameter');
+    }
+    const jwk: crypto.JsonWebKey = {
+      kty: 'OKP',
+      crv: 'Ed25519',
+      x: x.toString('base64url'),
+    };
+    const keyObject = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+    return {
+      pem: keyObject.export({ type: 'spki', format: 'pem' }).toString(),
+      algorithm: alg,
+    };
+  }
+
+  throw new Error(`Unsupported COSE key type: ${kty}`);
+}
+
+export function spkiBase64urlToPem(spkiBase64url: string): string {
+  const der = Buffer.from(spkiBase64url, 'base64url');
+  const keyObj = crypto.createPublicKey({ key: der, format: 'der', type: 'spki' });
+  return keyObj.export({ type: 'spki', format: 'pem' }).toString();
+}
+
+export function verifyWebAuthnSignature(params: {
+  authenticatorDataBase64url: string;
+  clientDataJSONBase64url: string;
+  signatureBase64url: string;
+  publicKeyPem: string;
+  algorithm?: number;
+}): boolean {
+  const authData = Buffer.from(params.authenticatorDataBase64url, 'base64url');
+  const clientDataBytes = Buffer.from(params.clientDataJSONBase64url, 'base64url');
+  const signature = Buffer.from(params.signatureBase64url, 'base64url');
+
+  const clientDataHash = crypto.createHash('sha256').update(clientDataBytes).digest();
+  const signedData = Buffer.concat([authData, clientDataHash]);
+
+  if (params.algorithm === -8) {
+    // Ed25519
+    return crypto.verify(null, signedData, params.publicKeyPem, signature);
+  }
+
+  return crypto.verify('sha256', signedData, params.publicKeyPem, signature);
+}
