+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const id = link.getAttribute('href').slice(1);
+          return document.getElementById(id);
+        })
+        .filter(Boolean);
+
+      function setActiveSection(sectionId) {
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveSectionOnScroll() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 68;
+        const viewportHeight = window.innerHeight;
+
+        // If scrolled to the very bottom of the page, highlight the last section
+        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 10) {
+          setActiveSection(sections[sections.length - 1].id);
+          return;
+        }
+
+        // Trigger line just below the sticky navigation bar
+        const triggerLine = navHeight + Math.min(120, (viewportHeight - navHeight) * 0.25);
+
+        let activeId = null;
+
+        // First check which section straddles the trigger line
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerLine && rect.bottom > triggerLine) {
+            activeId = section.id;
+            break;
+          }
+        }
+
+        // Otherwise pick the section with the greatest visible height in the viewport
+        if (!activeId) {
+          let maxVisibleHeight = 0;
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            const visibleTop = Math.max(rect.top, navHeight);
+            const visibleBottom = Math.min(rect.bottom, viewportHeight);
+            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+            if (visibleHeight > maxVisibleHeight) {
+              maxVisibleHeight = visibleHeight;
+              activeId = section.id;
+            }
+          }
+        }
+
+        // If a section is visible, highlight it; otherwise clear active highlights (e.g. if only hero is visible)
+        if (activeId) {
+          setActiveSection(activeId);
+        } else {
+          setActiveSection('');
+        }
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          setActiveSection(targetId);
+        });
+      });
+
+      window.addEventListener('scroll', updateActiveSectionOnScroll, { passive: true });
+      window.addEventListener('resize', updateActiveSectionOnScroll, { passive: true });
+      window.addEventListener('hashchange', () => {
+        const hashId = window.location.hash.replace(/^#/, '');
+        if (hashId && sections.some((s) => s.id === hashId)) {
+          setActiveSection(hashId);
+        } else {
+          updateActiveSectionOnScroll();
+        }
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveSectionOnScroll();
+          },
+          {
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      updateActiveSectionOnScroll();
+    })();
+  </script>
 </body>
 
