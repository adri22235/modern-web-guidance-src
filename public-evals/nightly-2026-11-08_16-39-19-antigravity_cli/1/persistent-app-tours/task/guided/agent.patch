+  <script type="module">
+    const feature = document.getElementById("feature");
+    const tourStep = document.getElementById("tour-step");
+    const closeBtn = tourStep.querySelector("button");
+    let isTourOpen = true;
+
+    function openTour() {
+      if (typeof tourStep.showPopover === "function") {
+        tourStep.showPopover();
+        closeBtn.focus();
+      }
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js").then(openTour);
+    } else {
+      openTour();
+    }
+
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    tourStep.addEventListener("toggle", (event) => {
+      isTourOpen = event.newState === "open";
+      if (event.newState === "closed") {
+        feature.focus();
+      }
+    });
+
+    feature.addEventListener("click", (event) => {
+      if (isTourOpen || tourStep.matches(":popover-open, .\\:popover-open")) {
+        event.preventDefault();
+      }
+    });
+  </script>
+
 </body>
 
