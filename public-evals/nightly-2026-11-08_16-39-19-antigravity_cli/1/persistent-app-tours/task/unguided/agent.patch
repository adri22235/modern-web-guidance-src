+  <script>
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeBtn = document.getElementById('close-tour');
+
+    let isTourOpen = true;
+
+    function updatePosition() {
+      if (!isTourOpen) return;
+      if (!CSS.supports('anchor-name', '--feature-anchor')) {
+        const rect = featureLink.getBoundingClientRect();
+        tourStep.style.top = `${rect.bottom + 10}px`;
+        tourStep.style.left = `${rect.left + rect.width / 2}px`;
+      }
+    }
+
+    if (typeof tourStep.showPopover === 'function') {
+      tourStep.showPopover();
+    } else {
+      tourStep.style.display = 'block';
+    }
+    updatePosition();
+
+    window.addEventListener('resize', updatePosition);
+    window.addEventListener('scroll', updatePosition, true);
+    new ResizeObserver(updatePosition).observe(document.body);
+
+    tourStep.addEventListener('toggle', (e) => {
+      isTourOpen = e.newState === 'open';
+    });
+
+    closeBtn.addEventListener('click', () => {
+      isTourOpen = false;
+      if (typeof tourStep.hidePopover === 'function') {
+        try {
+          tourStep.hidePopover();
+        } catch (err) {}
+      } else {
+        tourStep.style.display = 'none';
+      }
+    });
+
+    featureLink.addEventListener('click', (e) => {
+      if (isTourOpen || tourStep.matches(':popover-open')) {
+        e.preventDefault();
+      }
+    });
+  </script>
+
 </body>
 
