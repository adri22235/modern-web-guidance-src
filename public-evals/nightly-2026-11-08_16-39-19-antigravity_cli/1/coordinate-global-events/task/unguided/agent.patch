+  <script>
+    (function () {
+      const TARGET_TIMEZONES = [
+        { label: 'New York', timeZone: 'America/New_York' },
+        { label: 'London', timeZone: 'Europe/London' },
+        { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+        { label: 'UTC', timeZone: 'UTC' }
+      ];
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function formatLocalTime(zdt) {
+        return zdt.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit',
+          hour12: true
+        });
+      }
+
+      function formatLocalDate(zdt) {
+        return zdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function pad2(num) {
+        return String(num).padStart(2, '0');
+      }
+
+      function updateSchedule() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz || typeof Temporal === 'undefined') {
+          return;
+        }
+
+        const [year, month, day] = dateVal.split('-').map(Number);
+        const [hour, minute] = timeVal.split(':').map(Number);
+
+        const requestedPlainDateTime = Temporal.PlainDateTime.from({
+          year,
+          month,
+          day,
+          hour,
+          minute
+        });
+
+        // Probe with 'earlier' and 'later' disambiguation options to detect DST gaps or overlaps
+        const earlierZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'earlier'
+        });
+        const laterZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'later'
+        });
+
+        // Resolve the canonical host ZonedDateTime using default 'compatible' disambiguation
+        const hostZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'compatible'
+        });
+
+        const requestedTimeFormatted = `${pad2(hour)}:${pad2(minute)}`;
+
+        // Check for DST gap (non-existent local time) or DST overlap (ambiguous local time)
+        if (! hostZdt.toPlainDateTime().equals(requestedPlainDateTime)) {
+          // DST Spring-Forward Gap: the requested wall-clock time does not exist
+          const resolvedTimeStr = formatLocalTime(hostZdt);
+          hostWarning.textContent = `Daylight Saving Time Gap Detected: ${requestedTimeFormatted} (${formatLocalTime(requestedPlainDateTime)}) does not exist in ${hostTz} because clocks spring forward from ${earlierZdt.offset} to ${laterZdt.offset}. Using 'compatible' disambiguation, the time was resolved forward to ${resolvedTimeStr} (${hostZdt.offset}).`;
+          hostWarning.classList.add('visible');
+        } else if (earlierZdt.epochNanoseconds !== laterZdt.epochNanoseconds) {
+          // DST Fall-Back Overlap: the requested wall-clock time occurs twice
+          const resolvedTimeStr = formatLocalTime(hostZdt);
+          hostWarning.textContent = `Daylight Saving Time Overlap Detected: ${requestedTimeFormatted} (${resolvedTimeStr}) is ambiguous and occurs twice in ${hostTz} as clocks fall back from ${earlierZdt.offset} to ${laterZdt.offset}. Using 'compatible' disambiguation, it was resolved to the first (earlier) occurrence at offset ${hostZdt.offset}.`;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        // Compute target times immutably using Temporal.ZonedDateTime.prototype.withTimeZone
+        grid.innerHTML = '';
+        for (const target of TARGET_TIMEZONES) {
+          const targetZdt = hostZdt.withTimeZone(target.timeZone);
+          const isHost = target.timeZone === hostTz;
+
+          const card = document.createElement('div');
+          card.className = `card tz-card${isHost ? ' host-active' : ''}`;
+          card.dataset.timezone = target.timeZone;
+
+          const titleEl = document.createElement('h3');
+          titleEl.textContent = target.label;
+
+          const tzIdEl = document.createElement('span');
+          tzIdEl.className = 'tz-id';
+          tzIdEl.textContent = target.timeZone + (isHost ? ' (Host)' : '');
+
+          const timeEl = document.createElement('div');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formatLocalTime(targetZdt);
+
+          const dateEl = document.createElement('div');
+          dateEl.className = 'tz-date';
+          dateEl.textContent = formatLocalDate(targetZdt);
+
+          const offsetEl = document.createElement('span');
+          offsetEl.className = 'tz-offset';
+          offsetEl.textContent = `UTC${targetZdt.offset === '+00:00' ? '' : targetZdt.offset}`;
+
+          card.appendChild(titleEl);
+          card.appendChild(tzIdEl);
+          card.appendChild(timeEl);
+          card.appendChild(dateEl);
+          card.appendChild(offsetEl);
+          grid.appendChild(card);
+        }
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
 </body>
 
