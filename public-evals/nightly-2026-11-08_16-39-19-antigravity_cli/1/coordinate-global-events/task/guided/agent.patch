+  <script>
+    const TARGET_TIMEZONES = [
+      { label: 'New York', tz: 'America/New_York' },
+      { label: 'London', tz: 'Europe/London' },
+      { label: 'Tokyo', tz: 'Asia/Tokyo' },
+      { label: 'UTC', tz: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) return;
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition gaps or overlaps using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Resolve the host time safely using disambiguation: 'compatible'
+      let hostTime;
+      try {
+        hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+      } catch (err) {
+        return;
+      }
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+
+        // In a DST spring-forward gap, 'compatible' resolves to 'later' (jumping forward).
+        // In a DST fall-back overlap, 'compatible' resolves to 'earlier' (first occurrence).
+        const isGap = Temporal.ZonedDateTime.compare(hostTime, laterTime) === 0 &&
+                      Temporal.ZonedDateTime.compare(earlierTime, laterTime) !== 0 &&
+                      hostTime.toPlainTime().toString().slice(0, 5) !== time.slice(0, 5);
+
+        if (isGap) {
+          hostWarning.textContent = `DST Transition Conflict: The selected time (${time}) does not exist in ${timeZone} due to a Daylight Saving Time spring-forward gap. Using compatible disambiguation, it was resolved forward to ${resolvedFormatted} (${hostTime.offset}).`;
+        } else {
+          hostWarning.textContent = `DST Transition Conflict: The selected time (${time}) is ambiguous in ${timeZone} due to a Daylight Saving Time fall-back overlap. Using compatible disambiguation, it was resolved to the first occurrence at ${resolvedFormatted} (${hostTime.offset}).`;
+        }
+        hostWarning.hidden = false;
+        hostWarning.style.display = 'block';
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+        hostWarning.style.display = 'none';
+      }
+
+      // Render equivalent times in target timezones immutably via .withTimeZone()
+      grid.replaceChildren();
+      for (const target of TARGET_TIMEZONES) {
+        const convertedTime = hostTime.withTimeZone(target.tz);
+        const formattedTime = convertedTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = convertedTime.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = 'card tz-card';
+        card.dataset.timezone = target.tz;
+
+        const heading = document.createElement('h3');
+        heading.textContent = target.label;
+
+        const timeEl = document.createElement('p');
+        timeEl.className = 'tz-time';
+        timeEl.textContent = formattedTime;
+
+        const dateEl = document.createElement('p');
+        dateEl.className = 'tz-date';
+        dateEl.textContent = formattedDate;
+
+        const zoneEl = document.createElement('p');
+        zoneEl.className = 'tz-zone';
+        zoneEl.textContent = `${target.tz} (${convertedTime.offset})`;
+
+        card.append(heading, timeEl, dateEl, zoneEl);
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const form = document.getElementById('tastingForm');
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      form.addEventListener('submit', (e) => e.preventDefault());
+      for (const control of [dateInput, timeInput, hostTzSelect]) {
+        control.addEventListener('change', updateSchedule);
+        control.addEventListener('input', updateSchedule);
+      }
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
