@@ -0,0 +1,72 @@
+import type { APIRoute } from 'astro';
+import { extractHostDomain, formatOriginBoundSms } from '../../utils/smsOtp';
+
+function generateSixDigitOtp(): string {
+  const randomNum = Math.floor(100000 + Math.random() * 900000);
+  return String(randomNum).padStart(6, '0');
+}
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  try {
+    let username = '';
+    let phone = '';
+
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      username = String(body.username ?? '').trim();
+      phone = String(body.phone ?? '').trim();
+    } else {
+      const formData = await request.formData();
+      username = String(formData.get('username') ?? '').trim();
+      phone = String(formData.get('phone') ?? '').trim();
+    }
+
+    if (!phone) {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required to send a verification code.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const code = generateSixDigitOtp();
+    const hostHeader = request.headers.get('x-forwarded-host') || request.headers.get('host') || url.hostname;
+    const domain = extractHostDomain(hostHeader);
+    const smsMessage = formatOriginBoundSms(code, domain);
+
+    if (session) {
+      await session.set('pendingOtp', {
+        code,
+        phone,
+        username,
+        createdAt: Date.now(),
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        phone,
+        domain,
+        code,
+        smsMessage,
+        message: `Verification code sent via SMS to ${phone}.`,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to send SMS verification code.' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
