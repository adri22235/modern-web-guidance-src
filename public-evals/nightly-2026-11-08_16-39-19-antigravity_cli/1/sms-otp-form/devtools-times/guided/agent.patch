@@ -0,0 +1,75 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let otp = '';
+    let phone = '';
+    let username = '';
+
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = String(body.otp ?? '').trim();
+      phone = String(body.phone ?? '').trim();
+      username = String(body.username ?? '').trim();
+    } else {
+      const formData = await request.formData();
+      otp = String(formData.get('otp') ?? '').trim();
+      phone = String(formData.get('phone') ?? '').trim();
+      username = String(formData.get('username') ?? '').trim();
+    }
+
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid 6-digit verification code.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const pendingOtp = (await session?.get('pendingOtp')) as
+      | { code?: string; phone?: string; username?: string }
+      | undefined;
+
+    if (pendingOtp?.code && pendingOtp.code !== otp) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid verification code. Please check the SMS sent to your phone and try again.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (session) {
+      await session.set('pendingOtp', undefined);
+      await session.set('verifiedUser', {
+        username: username || pendingOtp?.username || '',
+        phone: phone || pendingOtp?.phone || '',
+        verifiedAt: Date.now(),
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        verified: true,
+        message: 'Phone number verified and account registered successfully! You can now sign in.',
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Unable to verify code at this time. Please try again.' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
