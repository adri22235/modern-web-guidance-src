+/**
+ * Extracts only the host domain from a URL, origin, or host header string.
+ * Strips URL schemes (https://, http://), ports (:8080), paths (/verify), and whitespace.
+ */
+export function extractHostDomain(originOrHost?: string): string {
+  if (!originOrHost) {
+    if (typeof window !== 'undefined' && window.location?.hostname) {
+      return window.location.hostname;
+    }
+    return 'example.com';
+  }
+
+  const trimmed = originOrHost.trim();
+  if (!trimmed) {
+    return 'example.com';
+  }
+
+  try {
+    if (/^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//.test(trimmed)) {
+      const parsed = new URL(trimmed);
+      if (parsed.hostname) {
+        return parsed.hostname;
+      }
+    }
+  } catch {
+    // Fall back to manual host extraction below
+  }
+
+  const withoutScheme = trimmed.replace(/^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//, '');
+  const authority = withoutScheme.split('/')[0] ?? '';
+  const hostOnly = authority.split(':')[0]?.replace(/\s+/g, '') ?? '';
+
+  return hostOnly || 'example.com';
+}
+
+/**
+ * Formats an origin-bound SMS OTP message following the WebOTP and Safari autofill specification:
+ * - Starts with a clear human-readable sentence containing the 6-digit code.
+ * - Places `@<domain> #<otp>` on the very last line with no trailing text.
+ * - Uses only the host domain (no scheme, port, or path) and a single space between tokens.
+ */
+export function formatOriginBoundSms(code: string, originOrHost?: string): string {
+  const cleanCode = String(code).trim().replace(/\s+/g, '');
+  const domain = extractHostDomain(originOrHost);
+
+  return `Your verification code is ${cleanCode}.\n\n@${domain} #${cleanCode}`;
+}
