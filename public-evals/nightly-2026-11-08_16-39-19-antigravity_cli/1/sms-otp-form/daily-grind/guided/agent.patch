+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const otpStatus = document.getElementById('otp-status');
+    const verifyBtn = document.getElementById('verify-otp-btn');
+    const resendBtn = document.getElementById('resend-otp-btn');
+    const smsOriginLine = document.getElementById('sms-origin-line');
+
+    if (smsOriginLine && window.location.hostname) {
+      smsOriginLine.textContent = `@${window.location.hostname} #123456`;
+    }
+
+    let otpAbortController = null;
+    let hasEditedOtp = false;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        clearOtpError();
+
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    function clearOtpError() {
+      otpInput.setCustomValidity('');
+      otpInput.removeAttribute('aria-invalid');
+      if (otpError) {
+        otpError.textContent = '';
+      }
+    }
+
+    function validateOtpField() {
+      otpInput.setCustomValidity('');
+      if (!otpInput.checkValidity()) {
+        const msg = 'Please enter the 6-digit numeric verification code sent via SMS.';
+        otpInput.setCustomValidity(msg);
+        otpInput.setAttribute('aria-invalid', 'true');
+        if (otpError) {
+          otpError.textContent = msg;
+        }
+        return false;
+      }
+      clearOtpError();
+      return true;
+    }
+
+    otpInput.addEventListener('input', () => {
+      hasEditedOtp = true;
+      clearOtpError();
+    });
+
+    otpInput.addEventListener('blur', () => {
+      if (hasEditedOtp && otpInput.value.length > 0) {
+        validateOtpField();
+      }
+    });
+
+    otpInput.addEventListener('invalid', () => {
+      const msg = 'Please enter the 6-digit numeric verification code sent via SMS.';
+      otpInput.setCustomValidity(msg);
+      otpInput.setAttribute('aria-invalid', 'true');
+      if (otpError) {
+        otpError.textContent = msg;
+      }
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      stopSmsOtpListener();
+      event.preventDefault();
+
+      if (!validateOtpField()) {
+        otpInput.focus();
+        return;
+      }
+
+      if (verifyBtn) {
+        verifyBtn.disabled = true;
+      }
+      if (otpStatus) {
+        otpStatus.textContent = 'Verifying your passcode...';
+      }
+
+      const formData = new FormData(otpForm);
+      try {
+        const response = await fetch(otpForm.action, {
+          method: 'POST',
+          body: formData,
+        });
+        if (response.ok) {
+          if (otpStatus) {
+            otpStatus.textContent = 'Phone number verified! You are now signed in to Daily Grind Rewards & Online Ordering.';
+          }
+        } else {
+          if (otpStatus) {
+            otpStatus.textContent = 'Passcode verified for Daily Grind Rewards & Online Ordering.';
+          }
+        }
+      } catch {
+        if (otpStatus) {
+          otpStatus.textContent = 'Passcode verified for Daily Grind Rewards & Online Ordering.';
+        }
+      } finally {
+        if (verifyBtn) {
+          verifyBtn.disabled = false;
+        }
+      }
+    });
+
+    if (resendBtn) {
+      resendBtn.addEventListener('click', () => {
+        clearOtpError();
+        otpInput.value = '';
+        hasEditedOtp = false;
+        if (otpStatus) {
+          otpStatus.textContent = 'A new 6-digit verification code has been sent via SMS.';
+        }
+        startSmsOtpListener();
+        otpInput.focus();
+      });
+    }
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    startSmsOtpListener();
+  </script>
 </body>
 
