+  <script>
+    function initWebOTP() {
+      const input = document.querySelector('input[autocomplete="one-time-code"]');
+      if (!input) return;
+
+      const form = input.closest('form');
+      const statusEl = document.getElementById('otp-status');
+
+      if ('OTPCredential' in window) {
+        const ac = new AbortController();
+
+        if (form) {
+          form.addEventListener('submit', () => {
+            ac.abort();
+          });
+        }
+
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal
+        }).then(otp => {
+          if (otp && otp.code) {
+            input.value = otp.code;
+            if (statusEl) {
+              statusEl.textContent = 'Passcode extracted from SMS. Verifying...';
+            }
+            if (form) {
+              form.submit();
+            }
+          }
+        }).catch(err => {
+          // Ignore AbortError or unsupported environments gracefully
+          if (err && err.name !== 'AbortError') {
+            console.debug('WebOTP error:', err);
+          }
+        });
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      window.addEventListener('DOMContentLoaded', initWebOTP);
+    } else {
+      initWebOTP();
+    }
+  </script>
+
