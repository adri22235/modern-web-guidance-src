+      // Automatically re-sign the active tab document so the user sees an immediate signed receipt/voucher
+      const isVoucherActive = !document.getElementById('voucher-form').classList.contains('hidden');
+      if (isVoucherActive) {
+        await signGiftVoucher();
+      } else {
+        await signCoffeeOrderReceipt();
+      }
+    }
+
+    async function handleAlgorithmChange() {
+      await generateActiveKeyPair();
+    }
+
+    function copyActivePublicKey() {
+      const input = document.getElementById('active-public-key-display');
+      if (navigator.clipboard && input.value) {
+        navigator.clipboard.writeText(input.value);
+      }
+      document.getElementById('key-status-msg').textContent = `Copied active public key (${activeKeyRecord.keyId}) to clipboard.`;
+    }
+
+    async function createSignedEnvelope(documentType, payloadObject) {
+      if (!activeKeyRecord) {
+        await generateActiveKeyPair();
+      }
+      const canonicalPayload = canonicalizeJson(payloadObject);
+      const contentSha256 = await sha256HexFromString(canonicalPayload);
+
+      let signature;
+      if (activeKeyRecord.algorithm === 'PQ-WOTS-SHA256') {
+        signature = await signPqWots(canonicalPayload, activeKeyRecord.privateKeyInternal);
+      } else {
+        signature = await signClassical(
+          activeKeyRecord.algorithm,
+          canonicalPayload,
+          activeKeyRecord.privateKeyInternal
+        );
+      }
+
+      const envelope = {
+        issuer: 'The Daily Grind Coffee Co.',
+        documentType,
+        securityClass: activeKeyRecord.securityClass,
+        algorithm: activeKeyRecord.algorithm,
+        keyId: activeKeyRecord.keyId,
+        publicKey: activeKeyRecord.publicKeyString,
+        payload: payloadObject,
+        contentSha256,
+        signature,
+        signedAt: new Date().toISOString()
+      };
+
+      latestValidEnvelope = JSON.parse(JSON.stringify(envelope));
+      addEnvelopeToLedger(envelope);
+      renderSignedDocumentCard(envelope);
+      loadEnvelopeIntoVerifier(envelope);
+      return envelope;
+    }
+
+    /*************************************************************************
+     * COFFEE ORDER RECEIPT & GIFT VOUCHER BUILDERS
+     *************************************************************************/
+    function renderOrderItemsList() {
+      const container = document.getElementById('receipt-items-container');
+      let subtotal = 0;
+      const rowsHtml = orderItems.map((item, idx) => {
+        const lineTotal = item.price * item.qty;
+        subtotal += lineTotal;
+        return `
+          <div class="order-item-row">
+            <span><strong>${item.name}</strong> ($${item.price.toFixed(2)})</span>
+            <input type="number" min="1" max="20" value="${item.qty}" aria-label="Quantity for ${item.name}"
+              onchange="updateOrderItemQty(${idx}, this.value)" style="padding: 4px 6px;" />
+            <span style="text-align: right; font-weight: 600;">$${lineTotal.toFixed(2)}</span>
+            <button type="button" class="btn btn-outline btn-sm" onclick="removeOrderItem(${idx})" title="Remove item">×</button>
+          </div>
+        `;
+      }).join('');
+
+      const tax = +(subtotal * TAX_RATE).toFixed(2);
+      const total = +(subtotal + tax).toFixed(2);
+
+      container.innerHTML = `
+        ${rowsHtml}
+        <div class="order-totals">
+          <span>Subtotal: $${subtotal.toFixed(2)} | Tax (8.8%): $${tax.toFixed(2)}</span>
+          <span style="color: var(--primary);">Total: $${total.toFixed(2)}</span>
+        </div>
+      `;
+    }
+
+    function updateOrderItemQty(idx, newQty) {
+      const qty = Math.max(1, parseInt(newQty, 10) || 1);
+      orderItems[idx].qty = qty;
+      renderOrderItemsList();
+    }
+
+    function removeOrderItem(idx) {
+      if (orderItems.length <= 1) return;
+      orderItems.splice(idx, 1);
+      renderOrderItemsList();
+    }
+
+    function addSelectedOrderItem() {
+      const select = document.getElementById('add-menu-item-select');
+      const [name, priceStr] = select.value.split('|');
+      const price = parseFloat(priceStr);
+      const existing = orderItems.find(i => i.name === name);
+      if (existing) {
+        existing.qty += 1;
+      } else {
+        orderItems.push({ name, price, qty: 1 });
+      }
+      renderOrderItemsList();
+    }
+
+    async function quickAddMenuItem(name, price) {
+      switchDocumentTab('RECEIPT');
+      const existing = orderItems.find(i => i.name === name);
+      if (existing) {
+        existing.qty += 1;
+      } else {
+        orderItems.push({ name, price, qty: 1 });
+      }
+      renderOrderItemsList();
+      await signCoffeeOrderReceipt();
+      document.getElementById('crypto-studio').scrollIntoView({ behavior: 'smooth' });
+    }
+
+    function switchDocumentTab(tabType) {
+      const receiptForm = document.getElementById('receipt-form');
+      const voucherForm = document.getElementById('voucher-form');
+      const receiptBtn = document.getElementById('tab-receipt-btn');
+      const voucherBtn = document.getElementById('tab-voucher-btn');
+
+      if (tabType === 'VOUCHER') {
+        receiptForm.classList.add('hidden');
+        voucherForm.classList.remove('hidden');
+        receiptBtn.classList.remove('active');
+        receiptBtn.setAttribute('aria-selected', 'false');
+        voucherBtn.classList.add('active');
+        voucherBtn.setAttribute('aria-selected', 'true');
+      } else {
+        voucherForm.classList.add('hidden');
+        receiptForm.classList.remove('hidden');
+        voucherBtn.classList.remove('active');
+        voucherBtn.setAttribute('aria-selected', 'false');
+        receiptBtn.classList.add('active');
+        receiptBtn.setAttribute('aria-selected', 'true');
+      }
+    }
+
+    async function signCoffeeOrderReceipt() {
+      const orderId = document.getElementById('receipt-order-id').value.trim() || 'ORD-2026-4821';
+      const customerName = document.getElementById('receipt-customer').value.trim() || 'Guest';
+      const storeLocation = document.getElementById('receipt-location').value;
+      const paymentMethod = document.getElementById('receipt-payment').value;
+
+      const items = orderItems.map(item => ({
+        item: item.name,
+        qty: item.qty,
+        unitPrice: +item.price.toFixed(2),
+        lineTotal: +(item.price * item.qty).toFixed(2)
+      }));
+
+      const subtotal = +items.reduce((sum, i) => sum + i.lineTotal, 0).toFixed(2);
+      const tax = +(subtotal * TAX_RATE).toFixed(2);
+      const total = +(subtotal + tax).toFixed(2);
+
+      const payload = {
+        type: 'COFFEE_ORDER_RECEIPT',
+        orderId,
+        customerName,
+        storeLocation,
+        paymentMethod,
+        currency: 'USD',
+        items,
+        subtotal,
+        tax,
+        total,
+        issuedDate: '2026-11-08'
+      };
+
+      return await createSignedEnvelope('COFFEE_ORDER_RECEIPT', payload);
+    }
+
+    async function signGiftVoucher() {
+      const voucherCode = document.getElementById('voucher-code').value.trim() || 'TDG-GIFT-2026-994A';
+      const amount = +(parseFloat(document.getElementById('voucher-amount').value) || 25.00).toFixed(2);
+      const recipientName = document.getElementById('voucher-recipient').value.trim() || 'Recipient';
+      const senderName = document.getElementById('voucher-sender').value.trim() || 'Sender';
+      const expiresOn = document.getElementById('voucher-expiry').value || '2027-12-31';
+      const redeemableFor = document.getElementById('voucher-tier').value;
+      const personalMessage = document.getElementById('voucher-message').value.trim();
+
+      const payload = {
+        type: 'GIFT_VOUCHER',
+        voucherCode,
+        amount,
+        currency: 'USD',
+        recipientName,
+        senderName,
+        redeemableFor,
+        personalMessage,
+        expiresOn,
+        status: 'ACTIVE_UNREDEEMED'
+      };
+
+      return await createSignedEnvelope('GIFT_VOUCHER', payload);
+    }
+
+    function renderSignedDocumentCard(envelope) {
+      const docTypeEl = document.getElementById('preview-doc-type');
+      const docIdEl = document.getElementById('preview-doc-id');
+      const badgeEl = document.getElementById('preview-security-badge');
+      const tbody = document.querySelector('#preview-doc-table tbody');
+
+      if (envelope.securityClass === 'QUANTUM-RESISTANT') {
+        badgeEl.className = 'algo-badge quantum';
+        badgeEl.textContent = `Quantum-Resistant • ${envelope.algorithm}`;
+      } else {
+        badgeEl.className = 'algo-badge classical';
+        badgeEl.textContent = `Classical • ${envelope.algorithm}`;
+      }
+
+      if (envelope.documentType === 'COFFEE_ORDER_RECEIPT') {
+        const p = envelope.payload;
+        docTypeEl.textContent = 'COFFEE ORDER RECEIPT';
+        docIdEl.textContent = `${p.orderId} — ${p.customerName}`;
+        const itemSummary = p.items.map(i => `${i.qty}x ${i.item}`).join(', ');
+        tbody.innerHTML = `
+          <tr><td>Roastery Location</td><td>${p.storeLocation}</td></tr>
+          <tr><td>Items Ordered</td><td>${itemSummary}</td></tr>
+          <tr><td>Payment Method</td><td>${p.paymentMethod}</td></tr>
+          <tr><td>Total Paid (${p.currency})</td><td>$${Number(p.total).toFixed(2)}</td></tr>
+        `;
+      } else {
+        const p = envelope.payload;
+        docTypeEl.textContent = 'GIFT VOUCHER';
+        docIdEl.textContent = `${p.voucherCode} — $${Number(p.amount).toFixed(2)} ${p.currency}`;
+        tbody.innerHTML = `
+          <tr><td>Recipient / From</td><td>To: ${p.recipientName} (From: ${p.senderName})</td></tr>
+          <tr><td>Redeemable For</td><td>${p.redeemableFor}</td></tr>
+          <tr><td>Gift Message</td><td>"${p.personalMessage}"</td></tr>
+          <tr><td>Expiration Date</td><td>${p.expiresOn} (${p.status})</td></tr>
+        `;
+      }
+
+      document.getElementById('preview-digest').textContent = envelope.contentSha256;
+      document.getElementById('preview-kid').textContent = envelope.keyId;
+      document.getElementById('preview-sig').textContent =
+        envelope.signature.length > 84
+          ? envelope.signature.slice(0, 42) + '...' + envelope.signature.slice(-32)
+          : envelope.signature;
+    }
+
+    /*************************************************************************
+     * CRYPTOGRAPHIC VERIFICATION INSPECTOR & TAMPER SIMULATION
+     *************************************************************************/
+    function loadEnvelopeIntoVerifier(envelope) {
+      document.getElementById('verifier-public-key-input').value = envelope.publicKey;
+      document.getElementById('verifier-json-input').value = JSON.stringify(envelope, null, 2);
+      verifyEnvelopeFromInputs();
+    }
+
+    function sendCurrentToVerifier() {
+      if (latestValidEnvelope) {
+        loadEnvelopeIntoVerifier(latestValidEnvelope);
+        document.getElementById('verifier-panel').scrollIntoView({ behavior: 'smooth' });
+      }
+    }
+
+    async function verifyEnvelopeFromInputs() {
+      const rawJson = document.getElementById('verifier-json-input').value;
+      const pubKeyOverride = document.getElementById('verifier-public-key-input').value.trim();
+
+      const banner = document.getElementById('verify-result-banner');
+      const titleEl = document.getElementById('verify-banner-title');
+      const subtitleEl = document.getElementById('verify-banner-subtitle');
+      const badgeEl = document.getElementById('verify-banner-badge');
+
+      const checkSchema = document.getElementById('check-schema');
+      const checkDigest = document.getElementById('check-digest');
+      const checkSignature = document.getElementById('check-signature');
+      const checkTrust = document.getElementById('check-trust');
+
+      function setCheck(el, pass, label) {
+        el.className = `check-status ${pass ? 'pass' : 'fail'}`;
+        el.textContent = label;
+      }
+
+      let envelope;
+      try {
+        envelope = JSON.parse(rawJson);
+      } catch (err) {
+        banner.className = 'verify-banner invalid';
+        titleEl.textContent = '✗ VERIFICATION FAILED — MALFORMED JSON';
+        subtitleEl.textContent = 'The signed document envelope is not valid JSON.';
+        badgeEl.textContent = 'INVALID JSON';
+        setCheck(checkSchema, false, 'MALFORMED JSON');
+        setCheck(checkDigest, false, 'UNAVAILABLE');
+        setCheck(checkSignature, false, 'UNVERIFIED');
+        setCheck(checkTrust, false, 'UNTRUSTED');
+        return false;
+      }
+
+      const hasRequiredFields = Boolean(
+        envelope &&
+        envelope.payload &&
+        typeof envelope.payload === 'object' &&
+        envelope.algorithm &&
+        envelope.signature &&
+        envelope.contentSha256 &&
+        (envelope.documentType === 'COFFEE_ORDER_RECEIPT' || envelope.documentType === 'GIFT_VOUCHER')
+      );
+
+      setCheck(
+        checkSchema,
+        hasRequiredFields,
+        hasRequiredFields ? `VALID (${envelope.documentType})` : 'MISSING FIELDS'
+      );
+
+      if (!hasRequiredFields) {
+        banner.className = 'verify-banner invalid';
+        titleEl.textContent = '✗ VERIFICATION FAILED — INVALID ENVELOPE SCHEMA';
+        subtitleEl.textContent = 'Required receipt or gift voucher cryptographic fields are missing.';
+        badgeEl.textContent = 'SCHEMA ERROR';
+        setCheck(checkDigest, false, 'FAILED');
+        setCheck(checkSignature, false, 'FAILED');
+        setCheck(checkTrust, false, 'FAILED');
+        return false;
+      }
+
+      // Step 2: Recompute canonical SHA-256 content digest
+      const canonicalPayload = canonicalizeJson(envelope.payload);
+      const recomputedDigest = await sha256HexFromString(canonicalPayload);
+      const digestMatches = recomputedDigest.toLowerCase() === String(envelope.contentSha256).toLowerCase();
+      setCheck(
+        checkDigest,
+        digestMatches,
+        digestMatches ? 'SHA-256 MATCH' : 'DIGEST MISMATCH (TAMPERED)'
+      );
+
+      // Step 3: Verify Asymmetric Cryptographic Signature against Public Key
+      const pubKeyToUse = pubKeyOverride || envelope.publicKey || '';
+      let signatureValid = false;
+      if (envelope.algorithm === 'PQ-WOTS-SHA256') {
+        signatureValid = await verifyPqWots(canonicalPayload, envelope.signature, pubKeyToUse);
+      } else if (envelope.algorithm === 'ECDSA-P256' || envelope.algorithm === 'RSA-PSS-2048') {
+        signatureValid = await verifyClassical(envelope.algorithm, canonicalPayload, envelope.signature, pubKeyToUse);
+      }
+
+      setCheck(
+        checkSignature,
+        signatureValid,
+        signatureValid ? `VALID (${envelope.algorithm})` : 'INVALID SIGNATURE'
+      );
+
+      // Step 4: Check Store Key Registry & Voucher Expiration
+      const trustedEntry = trustedKeyRegistry.get(envelope.keyId);
+      const keyIsTrusted = Boolean(trustedEntry && trustedEntry.publicKeyString === pubKeyToUse);
+      let expiryOk = true;
+      if (envelope.documentType === 'GIFT_VOUCHER' && envelope.payload.expiresOn) {
+        expiryOk = envelope.payload.expiresOn >= '2026-11-08';
+      }
+      const trustPass = keyIsTrusted && expiryOk;
+      setCheck(
+        checkTrust,
+        trustPass,
+        !keyIsTrusted ? 'UNTRUSTED PUBLIC KEY' : (!expiryOk ? 'VOUCHER EXPIRED' : `TRUSTED (${envelope.keyId})`)
+      );
+
+      const overallValid = hasRequiredFields && digestMatches && signatureValid && trustPass;
+      if (overallValid) {
+        banner.className = 'verify-banner valid';
+        titleEl.textContent = `✓ AUTHENTIC & INTACT — ${envelope.documentType.replace(/_/g, ' ')}`;
+        subtitleEl.textContent = `Verified with ${envelope.securityClass} key (${envelope.algorithm}, kid: ${envelope.keyId}). Zero tampering detected.`;
+        badgeEl.className = envelope.securityClass === 'QUANTUM-RESISTANT' ? 'algo-badge quantum' : 'algo-badge classical';
+        badgeEl.textContent = 'CRYPTOGRAPHICALLY VERIFIED';
+      } else {
+        banner.className = 'verify-banner invalid';
+        titleEl.textContent = '✗ VERIFICATION FAILED — TAMPERING OR FORGERY DETECTED';
+        if (!signatureValid || !digestMatches) {
+          subtitleEl.textContent = 'Payload or signature was modified after signing, or signed by an invalid private key.';
+        } else if (!keyIsTrusted) {
+          subtitleEl.textContent = 'Public key does not match The Daily Grind trusted key registry.';
+        } else {
+          subtitleEl.textContent = 'Gift voucher has expired or failed validation policy.';
+        }
+        badgeEl.className = 'algo-badge';
+        badgeEl.style.background = '#c62828';
+        badgeEl.style.color = '#fff';
+        badgeEl.textContent = 'REJECTED';
+      }
+
+      return overallValid;
+    }
+
+    async function simulateTamperingOnVerifier() {
+      try {
+        const currentJson = document.getElementById('verifier-json-input').value;
+        const env = JSON.parse(currentJson);
+        if (env.documentType === 'COFFEE_ORDER_RECEIPT') {
+          env.payload.total = 0.01;
+          if (Array.isArray(env.payload.items) && env.payload.items.length > 0) {
+            env.payload.items[0].unitPrice = 0.01;
+          }
+        } else {
+          env.payload.amount = 999.99;
+        }
+        document.getElementById('verifier-json-input').value = JSON.stringify(env, null, 2);
+        await verifyEnvelopeFromInputs();
+      } catch (e) {
+        // Ignore if textarea is empty/malformed
+      }
+    }
+
+    async function testWrongKeyAttack() {
+      const pubInput = document.getElementById('verifier-public-key-input');
+      const current = pubInput.value.trim();
+      if (current.length > 8) {
+        const lastChar = current.slice(-1) === 'a' ? 'b' : 'a';
+        pubInput.value = current.slice(0, -1) + lastChar;
+        await verifyEnvelopeFromInputs();
+      }
+    }
+
+    function restoreValidEnvelope() {
+      if (latestValidEnvelope) {
+        loadEnvelopeIntoVerifier(latestValidEnvelope);
+      }
+    }
+
+    function copySignedEnvelopeJson() {
+      if (!latestValidEnvelope) return;
+      const text = JSON.stringify(latestValidEnvelope, null, 2);
+      if (navigator.clipboard) {
+        navigator.clipboard.writeText(text);
+      }
+    }
+
+    function addEnvelopeToLedger(envelope) {
+      signedDocumentsLedger.unshift(JSON.parse(JSON.stringify(envelope)));
+      if (signedDocumentsLedger.length > 6) {
+        signedDocumentsLedger.pop();
+      }
+      renderLedger();
+    }
+
+    function renderLedger() {
+      const container = document.getElementById('signed-ledger-list');
+      container.innerHTML = signedDocumentsLedger.map((env, idx) => {
+        const isReceipt = env.documentType === 'COFFEE_ORDER_RECEIPT';
+        const title = isReceipt
+          ? `☕ Receipt ${env.payload.orderId} ($${Number(env.payload.total).toFixed(2)})`
+          : `🎁 Voucher ${env.payload.voucherCode} ($${Number(env.payload.amount).toFixed(2)})`;
+        const person = isReceipt
+          ? `Customer: ${env.payload.customerName}`
+          : `Recipient: ${env.payload.recipientName}`;
+        const badgeClass = env.securityClass === 'QUANTUM-RESISTANT' ? 'quantum' : 'classical';
+
+        return `
+          <div class="ledger-item">
+            <div>
+              <div style="display: flex; justify-content: space-between; gap: 6px; align-items: center; margin-bottom: 4px;">
+                <strong>${title}</strong>
+                <span class="algo-badge ${badgeClass}" style="font-size: 0.68rem; padding: 2px 6px;">${env.algorithm}</span>
+              </div>
+              <div style="color: var(--muted);">${person}</div>
+              <div class="mono" style="font-size: 0.72rem; color: var(--muted); margin-top: 4px;">
+                kid: ${env.keyId}
+              </div>
+            </div>
+            <div style="display: flex; gap: 6px; margin-top: 6px;">
+              <button type="button" class="btn btn-sm" onclick="inspectLedgerItem(${idx})">Load &amp; Verify</button>
+              <button type="button" class="btn btn-outline btn-sm" onclick="tamperLedgerItem(${idx})">Test Tamper</button>
+            </div>
+          </div>
+        `;
+      }).join('');
+    }
+
+    function inspectLedgerItem(idx) {
+      const env = signedDocumentsLedger[idx];
+      if (!env) return;
+      latestValidEnvelope = JSON.parse(JSON.stringify(env));
+      renderSignedDocumentCard(env);
+      loadEnvelopeIntoVerifier(env);
+    }
+
+    async function tamperLedgerItem(idx) {
+      const env = signedDocumentsLedger[idx];
+      if (!env) return;
+      latestValidEnvelope = JSON.parse(JSON.stringify(env));
+      renderSignedDocumentCard(env);
+      loadEnvelopeIntoVerifier(env);
+      await simulateTamperingOnVerifier();
+    }
+
+    // Initialize on load: render order items, generate key pair, and issue both a signed receipt & a signed gift voucher in the ledger
+    window.addEventListener('DOMContentLoaded', async () => {
+      renderOrderItemsList();
+      await generateActiveKeyPair();
+      // Also issue an initial signed Gift Voucher and then sign the Coffee Order Receipt so both appear in the ledger immediately
+      await signGiftVoucher();
+      await signCoffeeOrderReceipt();
+    });
+  </script>
