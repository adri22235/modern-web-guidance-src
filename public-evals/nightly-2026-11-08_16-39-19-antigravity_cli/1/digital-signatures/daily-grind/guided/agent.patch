+  <script type="module">
+    const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+      1312: 'ML-DSA-44',
+      1952: 'ML-DSA-65',
+      2592: 'ML-DSA-87',
+    };
+
+    export function supportsPostQuantumSignatures() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('sign', 'ML-DSA-65')
+      );
+    }
+
+    export async function generateSigningKeyPair() {
+      if (supportsPostQuantumSignatures()) {
+        const keyPair = await crypto.subtle.generateKey(
+          'ML-DSA-65',
+          false,
+          ['sign', 'verify'],
+        );
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+        );
+        return {
+          suite: 'ML-DSA-65',
+          keyFormat: 'raw-public',
+          keyPair,
+          publicKeyBytes,
+        };
+      }
+
+      // Classical fallback: Ed25519
+      const keyPair = await crypto.subtle.generateKey(
+        'Ed25519',
+        false,
+        ['sign', 'verify'],
+      );
+      const publicKeyBytes = new Uint8Array(
+        await crypto.subtle.exportKey('raw', keyPair.publicKey),
+      );
+      return {
+        suite: 'Ed25519',
+        keyFormat: 'raw',
+        keyPair,
+        publicKeyBytes,
+      };
+    }
+
+    function frameFallbackInput(payloadBytes, contextBytes) {
+      if (contextBytes.byteLength > 255) {
+        throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+      }
+      const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+      framed[0] = contextBytes.byteLength;
+      framed.set(contextBytes, 1);
+      framed.set(payloadBytes, 1 + contextBytes.byteLength);
+      return framed;
+    }
+
+    export async function signPayload(
+      privateKey,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+        const sig = await crypto.subtle.sign(
+          { name: privateKey.algorithm.name, context: contextBytes },
+          privateKey,
+          payloadBytes,
+        );
+        return new Uint8Array(sig);
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+      return new Uint8Array(sig);
+    }
+
+    export async function verifyPayload(
+      publicKeyOrBytes,
+      signatureBytes,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      const publicKey =
+        publicKeyOrBytes instanceof CryptoKey
+          ? publicKeyOrBytes
+          : await (() => {
+              const bytes =
+                publicKeyOrBytes instanceof Uint8Array
+                  ? publicKeyOrBytes
+                  : new Uint8Array(publicKeyOrBytes);
+              const mlDsaName = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              return mlDsaName
+                ? crypto.subtle.importKey('raw-public', bytes, mlDsaName, true, ['verify'])
+                : crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+            })();
+
+      if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+        return crypto.subtle.verify(
+          { name: publicKey.algorithm.name, context: contextBytes },
+          publicKey,
+          signatureBytes,
+          payloadBytes,
+        );
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+    }
+
+    function bytesToHex(bytes) {
+      return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+    }
+
+    function hexToBytes(hex) {
+      const clean = hex.trim().replace(/\s+/g, '');
+      if (clean.length % 2 !== 0 || !/^[0-9a-fA-F]*$/.test(clean)) {
+        throw new Error('Invalid hex string');
+      }
+      const out = new Uint8Array(clean.length / 2);
+      for (let i = 0; i < clean.length; i += 2) {
+        out[i / 2] = parseInt(clean.slice(i, i + 2), 16);
+      }
+      return out;
+    }
+
+    // UI State & Wiring
+    const suiteStatusText = document.getElementById('suite-status-text');
+    const keySummary = document.getElementById('key-summary');
+    const rotateKeysBtn = document.getElementById('rotate-keys-btn');
+    const artifactTypeSelect = document.getElementById('artifact-type');
+    const artifactIdInput = document.getElementById('artifact-id');
+    const artifactAmountInput = document.getElementById('artifact-amount');
+    const artifactItemInput = document.getElementById('artifact-item');
+    const artifactRecipientInput = document.getElementById('artifact-recipient');
+    const signerPayloadTextarea = document.getElementById('signer-payload');
+    const signArtifactBtn = document.getElementById('sign-artifact-btn');
+    const loadPresetVoucherBtn = document.getElementById('load-preset-voucher-btn');
+    const exportedPublicKeyTextarea = document.getElementById('exported-public-key');
+    const generatedSignatureTextarea = document.getElementById('generated-signature');
+
+    const verifyContextSelect = document.getElementById('verify-context');
+    const verifyPayloadTextarea = document.getElementById('verify-payload');
+    const verifyPublicKeyTextarea = document.getElementById('verify-public-key');
+    const verifySignatureTextarea = document.getElementById('verify-signature');
+    const verifyArtifactBtn = document.getElementById('verify-artifact-btn');
+    const tamperPayloadBtn = document.getElementById('tamper-payload-btn');
+    const verificationResultBanner = document.getElementById('verification-result');
+
+    let activeKeyBundle = null;
+
+    function buildCanonicalPayload() {
+      const context = artifactTypeSelect.value;
+      const isVoucher = context === 'gift-voucher-v1';
+      const payload = {
+        issuer: 'The Daily Grind Coffee Co.',
+        artifactType: isVoucher ? 'gift_voucher' : 'order_receipt',
+        id: artifactIdInput.value.trim(),
+        recipient: artifactRecipientInput.value.trim(),
+        details: artifactItemInput.value.trim(),
+        amountUSD: artifactAmountInput.value.trim(),
+        issuedAt: '2026-11-08T18:00:00Z',
+      };
+      const json = JSON.stringify(payload, null, 2);
+      signerPayloadTextarea.value = json;
+      return json;
+    }
+
+    function showVerificationBanner(isValid, detail) {
+      verificationResultBanner.className = 'status-banner ' + (isValid ? 'valid' : 'invalid');
+      verificationResultBanner.textContent = detail;
+    }
+
+    async function handleSign() {
+      if (!activeKeyBundle) return;
+      try {
+        const payloadText = signerPayloadTextarea.value;
+        const contextString = artifactTypeSelect.value;
+        const encoder = new TextEncoder();
+        const payloadBytes = encoder.encode(payloadText);
+        const contextBytes = encoder.encode(contextString);
+
+        const signatureBytes = await signPayload(
+          activeKeyBundle.keyPair.privateKey,
+          payloadBytes,
+          contextBytes,
+        );
+
+        const pubHex = bytesToHex(activeKeyBundle.publicKeyBytes);
+        const sigHex = bytesToHex(signatureBytes);
+
+        exportedPublicKeyTextarea.value = pubHex;
+        generatedSignatureTextarea.value = sigHex;
+
+        // Populate verifier inputs automatically
+        verifyContextSelect.value = contextString;
+        verifyPayloadTextarea.value = payloadText;
+        verifyPublicKeyTextarea.value = pubHex;
+        verifySignatureTextarea.value = sigHex;
+
+        await handleVerify();
+      } catch (err) {
+        showVerificationBanner(false, `Signing failed: ${err.message}`);
+      }
+    }
+
+    async function handleVerify() {
+      try {
+        const payloadText = verifyPayloadTextarea.value;
+        const contextString = verifyContextSelect.value;
+        const encoder = new TextEncoder();
+        const payloadBytes = encoder.encode(payloadText);
+        const contextBytes = encoder.encode(contextString);
+
+        const pubKeyBytes = hexToBytes(verifyPublicKeyTextarea.value);
+        const signatureBytes = hexToBytes(verifySignatureTextarea.value);
+
+        const isValid = await verifyPayload(
+          pubKeyBytes,
+          signatureBytes,
+          payloadBytes,
+          contextBytes,
+        );
+
+        const suiteName = ML_DSA_PUBLIC_KEY_ALGORITHMS[pubKeyBytes.byteLength] || 'Ed25519';
+        if (isValid) {
+          showVerificationBanner(
+            true,
+            `Verified Authentic (${suiteName}, context: "${contextString}") — Artifact integrity and signer authenticity confirmed.`,
+          );
+        } else {
+          showVerificationBanner(
+            false,
+            `Verification Failed (${suiteName}, context: "${contextString}") — Signature mismatch, altered payload, or wrong domain context.`,
+          );
+        }
+      } catch (err) {
+        showVerificationBanner(false, `Verification Error: ${err.message}`);
+      }
+    }
+
+    async function initKeysAndSign() {
+      try {
+        activeKeyBundle = await generateSigningKeyPair();
+        const isPQ = activeKeyBundle.suite.startsWith('ML-DSA');
+        suiteStatusText.textContent = isPQ
+          ? `Quantum-Resistant (${activeKeyBundle.suite})`
+          : `Classical Fallback (${activeKeyBundle.suite})`;
+        keySummary.innerHTML = `Algorithm: <code>${activeKeyBundle.suite}</code> | Export Format: <code>${activeKeyBundle.keyFormat}</code> | Public Key: <code>${activeKeyBundle.publicKeyBytes.byteLength} bytes</code>`;
+        await handleSign();
+      } catch (err) {
+        suiteStatusText.textContent = 'WebCrypto Unavailable';
+        showVerificationBanner(false, `Key generation error: ${err.message}`);
+      }
+    }
+
+    [artifactTypeSelect, artifactIdInput, artifactAmountInput, artifactItemInput, artifactRecipientInput].forEach((el) => {
+      el.addEventListener('input', () => {
+        buildCanonicalPayload();
+      });
+    });
+
+    rotateKeysBtn.addEventListener('click', () => {
+      initKeysAndSign();
+    });
+
+    signArtifactBtn.addEventListener('click', () => {
+      handleSign();
+    });
+
+    loadPresetVoucherBtn.addEventListener('click', () => {
+      artifactTypeSelect.value = 'gift-voucher-v1';
+      artifactIdInput.value = 'GIFT-2026-9901';
+      artifactAmountInput.value = '50.00';
+      artifactItemInput.value = 'Artisanal Holiday Coffee Gift Card';
+      artifactRecipientInput.value = 'Jordan Taylor';
+      buildCanonicalPayload();
+      handleSign();
+    });
+
+    verifyArtifactBtn.addEventListener('click', () => {
+      handleVerify();
+    });
+
+    verifyContextSelect.addEventListener('change', () => {
+      handleVerify();
+    });
+
+    tamperPayloadBtn.addEventListener('click', () => {
+      try {
+        const parsed = JSON.parse(verifyPayloadTextarea.value);
+        parsed.amountUSD = '999.00';
+        verifyPayloadTextarea.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifyPayloadTextarea.value += '\n// tampered';
+      }
+      handleVerify();
+    });
+
+    buildCanonicalPayload();
+    initKeysAndSign();
+  </script>
