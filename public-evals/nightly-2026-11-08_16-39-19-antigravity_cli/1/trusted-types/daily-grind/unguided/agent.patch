+        .replace(/<(script|style|iframe|object|embed|applet|svg|math|form|noscript|template|base|meta|link)\b[^>]*\/?>/gi, '');
+
+      return input.replace(/<\/?([a-zA-Z][a-zA-Z0-9]*)\b([^>]*)>/g, (match, rawTag, rawAttrs) => {
+        const tag = rawTag.toLowerCase();
+        if (!ALLOWED_TAGS.has(tag)) {
+          return '';
+        }
+        if (match.startsWith('</')) {
+          return `</${tag}>`;
+        }
+
+        const cleanAttrs = [];
+        const attrRegex = /([a-zA-Z_][\w:-]*)\s*(?:=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
