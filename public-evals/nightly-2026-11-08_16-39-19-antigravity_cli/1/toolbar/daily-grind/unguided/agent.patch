+  <script>
+    (function () {
+      const toolbar = document.getElementById('favorites-actions');
+      const toolbarButtons = Array.from(toolbar.querySelectorAll('.toolbar-btn'));
+      const drinksContainer = document.getElementById('favorites-drinks');
+      const btnGridView = document.getElementById('btn-grid-view');
+      const btnListView = document.getElementById('btn-list-view');
+      const btnToggleDetails = document.getElementById('btn-toggle-details');
+      const btnToggleFilters = document.getElementById('btn-toggle-filters');
+      const btnCopyDrinks = document.getElementById('btn-copy-drinks');
+      const filterBar = document.getElementById('favorites-filter-bar');
+      const filterChips = Array.from(filterBar.querySelectorAll('.filter-chip'));
+      const drinkCards = Array.from(drinksContainer.querySelectorAll('.card'));
+      const copyStatus = document.getElementById('copy-status');
+
+      // Roving tabindex keyboard navigation for ARIA toolbar
+      function setActiveToolbarButton(targetBtn, focus = true) {
+        toolbarButtons.forEach((btn) => {
+          btn.setAttribute('tabindex', btn === targetBtn ? '0' : '-1');
+        });
+        if (focus) {
+          targetBtn.focus();
+        }
+      }
+
+      toolbar.addEventListener('keydown', (event) => {
+        const currentIndex = toolbarButtons.indexOf(document.activeElement);
+        if (currentIndex === -1) return;
+
+        let nextIndex = null;
+        if (event.key === 'ArrowRight') {
+          nextIndex = (currentIndex + 1) % toolbarButtons.length;
+        } else if (event.key === 'ArrowLeft') {
+          nextIndex = (currentIndex - 1 + toolbarButtons.length) % toolbarButtons.length;
+        } else if (event.key === 'Home') {
+          nextIndex = 0;
+        } else if (event.key === 'End') {
+          nextIndex = toolbarButtons.length - 1;
+        }
+
+        if (nextIndex !== null) {
+          event.preventDefault();
+          setActiveToolbarButton(toolbarButtons[nextIndex], true);
+        }
+      });
+
+      toolbarButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          setActiveToolbarButton(btn, false);
+        });
+      });
+
+      // Switch between Grid and List views
+      btnGridView.addEventListener('click', () => {
+        drinksContainer.classList.remove('list-view');
+        btnGridView.setAttribute('aria-pressed', 'true');
+        btnListView.setAttribute('aria-pressed', 'false');
+      });
+
+      btnListView.addEventListener('click', () => {
+        drinksContainer.classList.add('list-view');
+        btnListView.setAttribute('aria-pressed', 'true');
+        btnGridView.setAttribute('aria-pressed', 'false');
+      });
+
+      // Toggle drink details on and off
+      btnToggleDetails.addEventListener('click', () => {
+        const showingDetails = btnToggleDetails.getAttribute('aria-pressed') === 'true';
+        const nextState = !showingDetails;
+        btnToggleDetails.setAttribute('aria-pressed', String(nextState));
+        drinksContainer.classList.toggle('hide-details', !nextState);
+      });
+
+      // Toggle drink filters panel on and off
+      btnToggleFilters.addEventListener('click', () => {
+        const isExpanded = btnToggleFilters.getAttribute('aria-pressed') === 'true';
+        const nextState = !isExpanded;
+        btnToggleFilters.setAttribute('aria-pressed', String(nextState));
+        btnToggleFilters.setAttribute('aria-expanded', String(nextState));
+        filterBar.hidden = !nextState;
+      });
+
+      // Filter drink cards by category
+      filterChips.forEach((chip) => {
+        chip.addEventListener('click', () => {
+          const selectedFilter = chip.getAttribute('data-filter');
+          filterChips.forEach((c) => {
+            c.setAttribute('aria-pressed', String(c === chip));
+          });
+          drinkCards.forEach((card) => {
+            const category = card.getAttribute('data-category');
+            card.hidden = selectedFilter !== 'all' && category !== selectedFilter;
+          });
+        });
+      });
+
+      // Copy featured drinks list
+      let copyTimeout = null;
+      btnCopyDrinks.addEventListener('click', async () => {
+        const visibleDrinks = drinkCards
+          .filter((card) => !card.hidden)
+          .map((card) => {
+            const title = card.querySelector('h3').textContent.trim();
+            const desc = card.querySelector('.drink-details').textContent.trim();
+            return `${title} - ${desc}`;
+          })
+          .join('\n');
+
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(visibleDrinks);
+          } else {
+            const textarea = document.createElement('textarea');
+            textarea.value = visibleDrinks;
+            textarea.style.position = 'fixed';
+            textarea.style.opacity = '0';
+            document.body.appendChild(textarea);
+            textarea.select();
+            document.execCommand('copy');
+            document.body.removeChild(textarea);
+          }
+          copyStatus.textContent = 'Copied!';
+        } catch (err) {
+          copyStatus.textContent = 'Copy failed';
+        }
+
+        copyStatus.classList.add('visible');
+        if (copyTimeout) clearTimeout(copyTimeout);
+        copyTimeout = setTimeout(() => {
+          copyStatus.classList.remove('visible');
+          copyStatus.textContent = '';
+        }, 2000);
+      });
+    })();
+  </script>
 </body>
 
