+  <script>
+    (() => {
+      const bar = document.getElementById("favorites-actions");
+      const list = document.getElementById("favorites-list");
+      const status = document.getElementById("favorites-status");
+      if (!bar || !list || !status) return;
+
+      const items = Array.from(bar.querySelectorAll("button"));
+      const viewButtons = Array.from(bar.querySelectorAll("button[data-view]"));
+      const timers = new WeakMap();
+      let lastMessage = "";
+
+      function reportStatus(button, text, ok = true) {
+        clearTimeout(timers.get(button));
+        if (button) {
+          button.removeAttribute("data-copied");
+          button.removeAttribute("data-failed");
+        }
+        let message = text;
+        if (message === lastMessage) message += "\u00A0";
+        lastMessage = message;
+        status.textContent = "";
+        if (button) {
+          void button.offsetWidth;
+          button.setAttribute(ok ? "data-copied" : "data-failed", "");
+        }
+        requestAnimationFrame(() => {
+          status.textContent = message;
+        });
+        timers.set(
+          button,
+          setTimeout(() => {
+            if (button) {
+              button.removeAttribute("data-copied");
+              button.removeAttribute("data-failed");
+            }
+            status.textContent = "";
+          }, 2000)
+        );
+      }
+
+      // Roving tabindex fallback when native focusgroup is unsupported
+      if (!("focusGroup" in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener("focusin", ({ target }) => {
+          const btn = target.closest("button");
+          if (btn && items.includes(btn)) {
+            items.forEach((b) => (b.tabIndex = b === btn ? 0 : -1));
+          }
+        });
+        bar.addEventListener("keydown", (event) => {
+          const current = event.target.closest("button");
+          const index = items.indexOf(current);
+          if (index === -1) return;
+
+          const vertical = bar.getAttribute("aria-orientation") === "vertical";
+          const rtl = getComputedStyle(bar).direction === "rtl";
+          const steps = vertical
+            ? { ArrowDown: 1, ArrowUp: -1 }
+            : { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+
+          let nextIndex = -1;
+          if (event.key in steps) {
+            nextIndex = (index + steps[event.key] + items.length) % items.length;
+          } else if (event.key === "Home") {
+            nextIndex = 0;
+          } else if (event.key === "End") {
+            nextIndex = items.length - 1;
+          }
+
+          if (nextIndex !== -1) {
+            event.preventDefault();
+            items.forEach((b, i) => (b.tabIndex = i === nextIndex ? 0 : -1));
+            items[nextIndex].focus();
+          }
+        });
+      }
+
+      // Upgrade title tooltips only when interest invokers and anchor positioning both work
+      if ("interestForElement" in HTMLButtonElement.prototype && CSS.supports("position-area", "block-end")) {
+        document.querySelectorAll('[role="toolbar"] button[title]').forEach((b, i) => {
+          const tip = Object.assign(document.createElement("div"), { id: `tip-${i}`, textContent: b.title });
+          tip.popover = "hint";
+          b.setAttribute("interestfor", tip.id);
+          b.removeAttribute("title");
+          document.body.append(tip);
+        });
+      }
+
+      // Toolbar button actions
+      bar.addEventListener("click", async (event) => {
+        const button = event.target.closest("button");
+        if (!button || !bar.contains(button)) return;
+        if (button.getAttribute("aria-disabled") === "true") return;
+
+        // Mutually exclusive view mode toggle (grid vs list)
+        if (button.hasAttribute("data-view")) {
+          const selectedView = button.getAttribute("data-view");
+          viewButtons.forEach((b) => {
+            b.setAttribute("aria-pressed", String(b === button));
+          });
+          list.setAttribute("data-view", selectedView);
+          return;
+        }
+
+        const action = button.getAttribute("data-action");
+
+        // Independent toggle: drink details
+        if (action === "toggle-details") {
+          const nextPressed = button.getAttribute("aria-pressed") !== "true";
+          button.setAttribute("aria-pressed", String(nextPressed));
+          if (nextPressed) {
+            list.removeAttribute("data-details");
+          } else {
+            list.setAttribute("data-details", "hidden");
+          }
+          return;
+        }
+
+        // Independent toggle: seasonal specials filter
+        if (action === "toggle-filter") {
+          const nextPressed = button.getAttribute("aria-pressed") !== "true";
+          button.setAttribute("aria-pressed", String(nextPressed));
+          list.querySelectorAll(".card").forEach((card) => {
+            const isSeasonal = card.getAttribute("data-seasonal") === "true";
+            card.hidden = nextPressed && !isSeasonal;
+          });
+          return;
+        }
+
+        // One-shot action: copy featured drinks list
+        if (action === "copy-list") {
+          const visibleCards = Array.from(list.querySelectorAll(".card:not([hidden])"));
+          const text = visibleCards
+            .map((card) => {
+              const title = card.querySelector("h3")?.textContent.trim() || "";
+              const desc = card.querySelector("p")?.textContent.trim() || "";
+              return desc ? `${title}: ${desc}` : title;
+            })
+            .filter(Boolean)
+            .join("\n");
+
+          try {
+            await navigator.clipboard.writeText(text);
+            reportStatus(button, "Drinks list copied", true);
+          } catch {
+            reportStatus(button, "Copy failed", false);
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
