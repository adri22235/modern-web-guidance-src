+              <button type="button" class="card-action-btn move-right-btn" data-action="move-card-right" aria-label="Move ${def.title} right" title="Move right">→</button>
+              <button type="button" class="card-action-btn remove-card-btn" data-action="remove-card" aria-label="Remove ${def.title}" title="Remove card">×</button>
+            </div>
+          </div>
+          <div class="card-media">
+            <img src="${def.image}" alt="${def.title}">
+            <span class="card-serve-pill" data-role="serve-pill">${def.serve}</span>
+            <span class="card-price-pill" data-role="price-pill">$${(def.basePrice + def.items.length * 0.25).toFixed(2)}</span>
+          </div>
+          <h3>${def.title}</h3>
+          <p class="card-desc">${def.desc}</p>
+
+          <div class="card-customizer">
+            <div class="customizer-header">
+              <span>Customize Layers</span>
+              <div class="customizer-mini-actions">
+                <button type="button" class="mini-link-btn" data-action="shuffle-items">Shuffle</button>
+                <button type="button" class="mini-link-btn" data-action="reset-items">Reset</button>
+              </div>
+            </div>
+            <div class="option-row" role="group" aria-label="Temperature and Size">
+              ${serveButtonsHtml}
+            </div>
+            <ul class="custom-items-list"></ul>
+            <div class="add-addons-bar"></div>
+          </div>
+
+          <div class="card-footer">
+            <a href="${def.link}" class="btn">View Details</a>
+          </div>
+        `;
+
+        const listEl = card.querySelector('.custom-items-list');
+        def.items.forEach((item) => {
+          listEl.appendChild(createCustomItemElement(def.id, item));
+        });
+
+        syncCardInternalState(card);
+        return card;
+      }
+
+      // Handle clicks inside the Seasonal Favorites section
+      document.getElementById('seasonal-favorites').addEventListener('click', (event) => {
+        const actionBtn = event.target.closest('[data-action]');
+        if (!actionBtn || actionBtn.disabled) return;
+
+        const action = actionBtn.dataset.action;
+
+        // --- GRID-SCOPED ACTIONS (Reorder / Remove / Add / Shuffle / Restore drink cards) ---
+        if (action === 'move-card-left' || action === 'move-card-right') {
+          const cardEl = actionBtn.closest('.card');
+          if (!cardEl) return;
+          const sibling =
+            action === 'move-card-left' ? cardEl.previousElementSibling : cardEl.nextElementSibling;
+          if (!sibling || !sibling.classList.contains('card')) return;
+
+          runScopedViewTransition(grid, () => {
+            if (action === 'move-card-left') {
+              grid.insertBefore(cardEl, sibling);
+            } else {
+              grid.insertBefore(sibling, cardEl);
+            }
+            syncGridState();
+          });
+          return;
+        }
+
+        if (action === 'remove-card') {
+          const cardEl = actionBtn.closest('.card');
+          if (!cardEl) return;
+          runScopedViewTransition(grid, () => {
+            cardEl.remove();
+            syncGridState();
+          });
+          return;
+        }
+
+        if (action === 'shuffle-cards') {
+          const cards = Array.from(grid.querySelectorAll('.card'));
+          if (cards.length < 2) return;
+          runScopedViewTransition(grid, () => {
+            // Ensure order actually changes
+            const shuffled = [...cards];
+            for (let i = shuffled.length - 1; i > 0; i--) {
+              const j = Math.floor(Math.random() * (i + 1));
+              [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+            }
+            if (shuffled.every((c, idx) => c === cards[idx])) {
+              shuffled.push(shuffled.shift());
+            }
+            shuffled.forEach((c) => grid.appendChild(c));
+            syncGridState();
+          });
+          return;
+        }
+
+        if (action === 'reverse-cards') {
+          const cards = Array.from(grid.querySelectorAll('.card'));
+          if (cards.length < 2) return;
+          runScopedViewTransition(grid, () => {
+            cards.reverse().forEach((c) => grid.appendChild(c));
+            syncGridState();
+          });
+          return;
+        }
+
+        if (action === 'add-card') {
+          const currentIds = new Set(
+            Array.from(grid.querySelectorAll('.card')).map((c) => c.dataset.cardId)
+          );
+          const nextDef = ALL_CATALOG.find((c) => !currentIds.has(c.id));
+          if (!nextDef) return;
+
+          runScopedViewTransition(grid, () => {
+            const newCard = createCardElement(nextDef);
+            grid.appendChild(newCard);
+            syncGridState();
+          });
+          return;
+        }
+
+        if (action === 'reset-cards') {
+          runScopedViewTransition(grid, () => {
+            const existingById = new Map(
+              Array.from(grid.querySelectorAll('.card')).map((c) => [c.dataset.cardId, c])
+            );
+            grid.innerHTML = '';
+            DEFAULT_CARDS.forEach((def) => {
+              const cardEl = existingById.get(def.id) || createCardElement(def);
+              // Reset internal items if card already existed
+              const listEl = cardEl.querySelector('.custom-items-list');
+              if (listEl) {
+                listEl.innerHTML = '';
+                def.items.forEach((item) => {
+                  listEl.appendChild(createCustomItemElement(def.id, item));
+                });
+              }
+              const pills = Array.from(cardEl.querySelectorAll('.option-pill'));
+              pills.forEach((p, i) => p.classList.toggle('active', i === 0));
+              const servePill = cardEl.querySelector('[data-role="serve-pill"]');
+              if (servePill) servePill.textContent = def.serve;
+              grid.appendChild(cardEl);
+            });
+            syncGridState();
+          });
+          return;
+        }
+
+        // --- CARD-SCOPED ACTIONS (Customize / Reorder / Remove / Add items within a single drink card) ---
+        const cardEl = actionBtn.closest('.card');
+        if (!cardEl) return;
+
+        if (action === 'move-item-up' || action === 'move-item-down') {
+          const itemEl = actionBtn.closest('.custom-item');
+          const listEl = cardEl.querySelector('.custom-items-list');
+          if (!itemEl || !listEl) return;
+          const sibling =
+            action === 'move-item-up' ? itemEl.previousElementSibling : itemEl.nextElementSibling;
+          if (!sibling || !sibling.classList.contains('custom-item')) return;
+
+          runScopedViewTransition(cardEl, () => {
+            if (action === 'move-item-up') {
+              listEl.insertBefore(itemEl, sibling);
+            } else {
+              listEl.insertBefore(sibling, itemEl);
+            }
+            syncCardInternalState(cardEl);
+          });
+          return;
+        }
+
+        if (action === 'remove-item') {
+          const itemEl = actionBtn.closest('.custom-item');
+          if (!itemEl) return;
+          runScopedViewTransition(cardEl, () => {
+            itemEl.remove();
+            syncCardInternalState(cardEl);
+          });
+          return;
+        }
+
+        if (action === 'add-item') {
+          const itemId = actionBtn.dataset.itemId;
+          const itemLabel = actionBtn.dataset.itemLabel;
+          const cardId = cardEl.dataset.cardId;
+          const listEl = cardEl.querySelector('.custom-items-list');
+          if (!itemId || !itemLabel || !listEl) return;
+
+          runScopedViewTransition(cardEl, () => {
+            const newItemEl = createCustomItemElement(cardId, { id: itemId, label: itemLabel });
+            listEl.appendChild(newItemEl);
+            syncCardInternalState(cardEl);
+          });
+          return;
+        }
+
+        if (action === 'shuffle-items') {
+          const listEl = cardEl.querySelector('.custom-items-list');
+          const items = Array.from(listEl.querySelectorAll('.custom-item'));
+          if (items.length < 2) return;
+
+          runScopedViewTransition(cardEl, () => {
+            const shuffled = [...items];
+            for (let i = shuffled.length - 1; i > 0; i--) {
+              const j = Math.floor(Math.random() * (i + 1));
+              [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+            }
+            if (shuffled.every((el, idx) => el === items[idx])) {
+              shuffled.push(shuffled.shift());
+            }
+            shuffled.forEach((el) => listEl.appendChild(el));
+            syncCardInternalState(cardEl);
+          });
+          return;
+        }
+
+        if (action === 'reset-items') {
+          const cardId = cardEl.dataset.cardId;
+          const def = getCatalogDefinition(cardId);
+          const listEl = cardEl.querySelector('.custom-items-list');
+          if (!def || !listEl) return;
+
+          runScopedViewTransition(cardEl, () => {
+            listEl.innerHTML = '';
+            def.items.forEach((item) => {
+              listEl.appendChild(createCustomItemElement(cardId, item));
+            });
+            const pills = Array.from(cardEl.querySelectorAll('.option-pill'));
+            pills.forEach((p, i) => p.classList.toggle('active', i === 0));
+            const servePill = cardEl.querySelector('[data-role="serve-pill"]');
+            if (servePill) servePill.textContent = def.serve;
+            syncCardInternalState(cardEl);
+          });
+          return;
+        }
+
+        if (action === 'toggle-serve') {
+          const newServe = actionBtn.dataset.serve;
+          if (!newServe || actionBtn.classList.contains('active')) return;
+
+          runScopedViewTransition(cardEl, () => {
+            cardEl.querySelectorAll('.option-pill').forEach((pill) => {
+              pill.classList.toggle('active', pill === actionBtn);
+            });
+            const servePill = cardEl.querySelector('[data-role="serve-pill"]');
+            if (servePill) servePill.textContent = newServe;
+            syncCardInternalState(cardEl);
+          });
+        }
+      });
+
+      // Initialize state on load
+      syncGridState();
+    })();
+  </script>
+
 </body>
 
 </html>
