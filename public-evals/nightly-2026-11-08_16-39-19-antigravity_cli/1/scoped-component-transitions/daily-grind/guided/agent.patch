+  <script>
+    // Feature detect element-scoped view transitions specifically on Element.prototype
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+    // Feature detect atomic DOM move API
+    const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+    function moveNode(parent, node, referenceNode = null) {
+      if (supportsMoveBefore) {
+        parent.moveBefore(node, referenceNode);
+      } else {
+        parent.insertBefore(node, referenceNode);
+      }
+    }
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      // Avoid unhandled promise rejections when rapid interactions skip an active transition
+      transition.ready.catch(() => {});
+    }
+
+    const seasonalGrid = document.getElementById('seasonal-grid');
+
+    // Keep references to the original card wrapper nodes and their initial customization items
+    // so restoring preserves DOM node identity where possible
+    const initialCards = Array.from(seasonalGrid.querySelectorAll('.card-wrapper')).map((wrapper) => {
+      const card = wrapper.querySelector('.card');
+      const list = card.querySelector('ul');
+      const items = Array.from(list.children);
+      return { wrapper, card, list, items };
+    });
+
+    function reorderItems(listEl, orderedItems) {
+      runScopedTransition(listEl, () => {
+        for (const li of orderedItems) {
+          moveNode(listEl, li, null);
+        }
+      });
+    }
+
+    function removeItem(cardEl, itemEl) {
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('button') ??
+        itemEl.previousElementSibling?.querySelector('button') ??
+        cardEl.querySelector('button');
+
+      runScopedTransition(cardEl, () => {
+        itemEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    function removeCard(gridEl, wrapperEl) {
+      const hadFocus = wrapperEl.contains(document.activeElement);
+      const nextFocusTarget =
+        wrapperEl.nextElementSibling?.querySelector('button') ??
+        wrapperEl.previousElementSibling?.querySelector('button') ??
+        document.getElementById('reset-cards-btn');
+
+      runScopedTransition(gridEl, () => {
+        wrapperEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    seasonalGrid.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+
+      const action = button.dataset.action;
+
+      if (action === 'move-item-up' || action === 'move-item-down') {
+        const itemEl = button.closest('li');
+        const listEl = itemEl?.parentElement;
+        if (!itemEl || !listEl) return;
+
+        const targetSibling =
+          action === 'move-item-up'
+            ? itemEl.previousElementSibling
+            : itemEl.nextElementSibling?.nextElementSibling ?? null;
+
+        if (action === 'move-item-up' && !itemEl.previousElementSibling) return;
+        if (action === 'move-item-down' && !itemEl.nextElementSibling) return;
+
+        runScopedTransition(listEl, () => {
+          moveNode(listEl, itemEl, targetSibling);
+          button.focus();
+        });
+        return;
+      }
+
+      if (action === 'remove-item') {
+        const itemEl = button.closest('li');
+        const cardEl = button.closest('.card');
+        if (!itemEl || !cardEl) return;
+        removeItem(cardEl, itemEl);
+        return;
+      }
+
+      if (action === 'shuffle-items') {
+        const cardEl = button.closest('.card');
+        const listEl = cardEl?.querySelector('ul');
+        if (!listEl || listEl.children.length < 2) return;
+
+        const items = Array.from(listEl.children);
+        for (let i = items.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [items[i], items[j]] = [items[j], items[i]];
+        }
+        // Ensure order actually changes when 2+ items exist
+        if (items.every((el, idx) => el === listEl.children[idx])) {
+          items.reverse();
+        }
+        reorderItems(listEl, items);
+        return;
+      }
+
+      if (action === 'move-card-prev' || action === 'move-card-next') {
+        const wrapperEl = button.closest('.card-wrapper');
+        if (!wrapperEl) return;
+
+        if (action === 'move-card-prev' && !wrapperEl.previousElementSibling) return;
+        if (action === 'move-card-next' && !wrapperEl.nextElementSibling) return;
+
+        const referenceNode =
+          action === 'move-card-prev'
+            ? wrapperEl.previousElementSibling
+            : wrapperEl.nextElementSibling?.nextElementSibling ?? null;
+
+        runScopedTransition(seasonalGrid, () => {
+          moveNode(seasonalGrid, wrapperEl, referenceNode);
+          button.focus();
+        });
+        return;
+      }
+
+      if (action === 'remove-card') {
+        const wrapperEl = button.closest('.card-wrapper');
+        if (!wrapperEl) return;
+        removeCard(seasonalGrid, wrapperEl);
+      }
+    });
+
+    document.getElementById('shuffle-cards-btn').addEventListener('click', () => {
+      const wrappers = Array.from(seasonalGrid.children);
+      if (wrappers.length < 2) return;
+
+      const shuffled = [...wrappers];
+      for (let i = shuffled.length - 1; i > 0; i--) {
+        const j = Math.floor(Math.random() * (i + 1));
+        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+      }
+      if (shuffled.every((el, idx) => el === wrappers[idx])) {
+        shuffled.reverse();
+      }
+
+      runScopedTransition(seasonalGrid, () => {
+        for (const wrapper of shuffled) {
+          moveNode(seasonalGrid, wrapper, null);
+        }
+      });
+    });
+
+    document.getElementById('reverse-cards-btn').addEventListener('click', () => {
+      const wrappers = Array.from(seasonalGrid.children).reverse();
+      if (wrappers.length < 2) return;
+
+      runScopedTransition(seasonalGrid, () => {
+        for (const wrapper of wrappers) {
+          moveNode(seasonalGrid, wrapper, null);
+        }
+      });
+    });
+
+    document.getElementById('reset-cards-btn').addEventListener('click', () => {
+      runScopedTransition(seasonalGrid, () => {
+        for (const { wrapper, list, items } of initialCards) {
+          if (!wrapper.isConnected) {
+            seasonalGrid.appendChild(wrapper);
