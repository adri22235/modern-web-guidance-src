@@ -206,7 +314,85 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-email');
+      const errorMsg = document.getElementById('mailing-email-error');
+      const successMsg = document.getElementById('mailing-email-success');
+
+      let hasTyped = false;
+
+      function showError(message) {
+        errorMsg.textContent = message;
+        errorMsg.classList.add('visible');
+        emailInput.classList.add('touched', 'input-error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        successMsg.classList.remove('visible');
+      }
+
+      function clearError() {
+        errorMsg.classList.remove('visible');
+        emailInput.classList.remove('input-error');
+        emailInput.setAttribute('aria-invalid', 'false');
+      }
+
+      emailInput.addEventListener('blur', function () {
+        const value = emailInput.value.trim();
+        emailInput.classList.add('touched');
+        if (value === '') {
+          showError('Email is required. Please do not leave this field blank.');
+        } else if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+        } else {
+          clearError();
+        }
+      });
+
+      emailInput.addEventListener('input', function () {
+        const value = emailInput.value.trim();
+        successMsg.classList.remove('visible');
+        if (value !== '') {
+          hasTyped = true;
+          if (emailInput.validity.valid || errorMsg.textContent.includes('blank')) {
+            clearError();
+          }
+        } else if (hasTyped) {
+          showError('Email is required. Please do not leave this field blank.');
+        }
+      });
+
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        const value = emailInput.value.trim();
+        if (value === '') {
+          showError('Email is required. Please do not leave this field blank.');
+        } else {
+          showError('Please enter a valid email address.');
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const value = emailInput.value.trim();
+        if (value === '') {
+          showError('Email is required. Please do not leave this field blank.');
+          return;
+        }
+        if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+          return;
+        }
+        clearError();
+        emailInput.classList.remove('touched');
+        hasTyped = false;
+        emailInput.value = '';
+        successMsg.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
