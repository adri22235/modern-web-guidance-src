+  <script>
+    const form = document.getElementById('mailing-list-form');
+    const statusEl = document.getElementById('mailing-status');
+
+    const syncAriaInvalid = (input) => {
+      // Gate on the browser's interaction-aware state (:user-invalid/:user-valid)
+      // so fields that were only tabbed through are not announced as invalid.
+      if (input.matches(':user-invalid')) {
+        input.setAttribute('aria-invalid', 'true');
+      } else if (input.matches(':user-valid')) {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Sync on blur when a user finishes interacting
+    form.addEventListener('blur', (e) => {
+      if (e.target.matches('input[required]')) {
+        syncAriaInvalid(e.target);
+      }
+    }, true);
+
+    // Sync all required fields when submission is attempted
+    form.addEventListener('submit', (e) => {
+      form.querySelectorAll('input[required]').forEach(syncAriaInvalid);
+      if (form.checkValidity()) {
+        e.preventDefault();
+        statusEl.textContent = 'Thanks for subscribing! Check your inbox soon.';
+      }
+    });
+
+    // Remove error state immediately upon correction
+    form.addEventListener('input', (e) => {
+      if (e.target.matches('input[required]') && e.target.checkValidity()) {
+        e.target.removeAttribute('aria-invalid');
+      }
+    });
+  </script>
 </body>
 
