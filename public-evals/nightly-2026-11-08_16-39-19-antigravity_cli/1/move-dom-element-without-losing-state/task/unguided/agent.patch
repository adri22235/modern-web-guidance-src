+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theater-mode-toggle');
+      const heroSection = document.getElementById('hero-section');
+      const videoContainer = document.getElementById('video-player-container');
+      const videoIframe = document.getElementById('roasting-video');
+
+      function movePreservingState(destination, element) {
+        if (typeof destination.moveBefore === 'function') {
+          destination.moveBefore(element, null);
+        } else {
+          destination.insertBefore(element, null);
+        }
+      }
+
+      toggleBtn.addEventListener('click', function () {
+        const isInTheaterMode = heroSection.contains(videoIframe);
+
+        if (!isInTheaterMode) {
+          movePreservingState(heroSection, videoIframe);
+          heroSection.classList.add('theater-mode');
+          toggleBtn.setAttribute('aria-pressed', 'true');
+          toggleBtn.textContent = 'Exit Theater Mode';
+        } else {
+          movePreservingState(videoContainer, videoIframe);
+          heroSection.classList.remove('theater-mode');
+          toggleBtn.setAttribute('aria-pressed', 'false');
+          toggleBtn.textContent = 'Enable Theater Mode';
+        }
+      });
+    })();
+  </script>
+
