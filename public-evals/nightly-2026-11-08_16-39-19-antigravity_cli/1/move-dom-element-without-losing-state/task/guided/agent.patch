+  <script>
+    const heroSection = document.getElementById('hero-section');
+    const videoPlayerSlot = document.getElementById('video-player-slot');
+    const roastingVideo = document.getElementById('roasting-video');
+    const theaterToggleBtn = document.getElementById('theater-toggle-btn');
+    const theaterToggleLabel = document.getElementById('theater-toggle-label');
+    const theaterStatus = document.getElementById('theater-status');
+
+    function moveElementPreservingState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterToggleBtn.addEventListener('click', () => {
+      const isTheaterActive = theaterToggleBtn.getAttribute('aria-pressed') === 'true';
+      const nextState = !isTheaterActive;
+
+      if (nextState) {
+        moveElementPreservingState(heroSection, roastingVideo);
+        heroSection.classList.add('theater-active');
+        theaterToggleBtn.setAttribute('aria-pressed', 'true');
+        theaterToggleLabel.textContent = 'Exit Theater Mode';
+        theaterStatus.textContent = 'Coffee roasting video moved to the hero section in theater mode.';
+      } else {
+        moveElementPreservingState(videoPlayerSlot, roastingVideo);
+        heroSection.classList.remove('theater-active');
+        theaterToggleBtn.setAttribute('aria-pressed', 'false');
+        theaterToggleLabel.textContent = 'Theater Mode';
+        theaterStatus.textContent = 'Coffee roasting video returned to the video player section.';
+      }
+    });
+  </script>
+
