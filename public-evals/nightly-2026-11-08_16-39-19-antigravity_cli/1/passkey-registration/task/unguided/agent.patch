+  <script>
+    (function () {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      const statusEl = document.getElementById('passkey-status');
+
+      function setStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'passkey-status' + (message ? ' visible' : '') + (type ? ' ' + type : '');
+      }
+
+      function base64UrlToUint8Array(base64Url) {
+        if (base64Url instanceof ArrayBuffer) {
+          return new Uint8Array(base64Url);
+        }
+        if (ArrayBuffer.isView(base64Url)) {
+          return new Uint8Array(base64Url.buffer, base64Url.byteOffset, base64Url.byteLength);
+        }
+        const padding = '='.repeat((4 - (base64Url.length % 4)) % 4);
+        const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = window.atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray;
+      }
+
+      function bufferToBase64Url(buffer) {
+        const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseCreationOptions(optionsJSON) {
+        const rawOptions = optionsJSON && optionsJSON.publicKey ? optionsJSON.publicKey : optionsJSON;
+
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof window.PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+        ) {
+          try {
+            return window.PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions);
+          } catch (_) {
+            // Fall back to manual decoding if parseCreationOptionsFromJSON fails
+          }
+        }
+
+        const normalizedOptions = {
+          pubKeyCredParams: [
+            { alg: -7, type: 'public-key' },
+            { alg: -257, type: 'public-key' },
+          ],
+          ...rawOptions,
+        };
+
+        return {
+          ...normalizedOptions,
+          challenge: base64UrlToUint8Array(normalizedOptions.challenge),
+          user: {
+            ...normalizedOptions.user,
+            id: base64UrlToUint8Array(normalizedOptions.user.id),
+          },
+          ...(Array.isArray(normalizedOptions.excludeCredentials)
+            ? {
+                excludeCredentials: normalizedOptions.excludeCredentials.map((cred) => ({
+                  ...cred,
+                  id: base64UrlToUint8Array(cred.id),
+                })),
+              }
+            : {}),
+        };
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+
+        const response = credential.response;
+        const serializedResponse = {
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          attestationObject: bufferToBase64Url(response.attestationObject),
+        };
+
+        if (typeof response.getTransports === 'function') {
+          serializedResponse.transports = response.getTransports();
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          serializedResponse.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (typeof response.getPublicKey === 'function') {
+          const pubKey = response.getPublicKey();
+          if (pubKey) {
+            serializedResponse.publicKey = bufferToBase64Url(pubKey);
+          }
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          const authData = response.getAuthenticatorData();
+          if (authData) {
+            serializedResponse.authenticatorData = bufferToBase64Url(authData);
+          }
+        }
+
+        const result = {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          response: serializedResponse,
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : {},
+        };
+
+        if (credential.authenticatorAttachment) {
+          result.authenticatorAttachment = credential.authenticatorAttachment;
+        }
+
+        return result;
+      }
+
+      async function handleRegisterClick() {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) {
+          setStatus('Passkeys are not supported by this browser.', 'error');
+          return;
+        }
+
+        registerButton.disabled = true;
+        setStatus('Creating your passkey...', '');
+
+        try {
+          const optionsResponse = await fetch('/api/register/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify({ promotion: true }),
+          });
+
+          if (!optionsResponse.ok) {
+            throw new Error('Failed to fetch passkey creation options.');
+          }
+
+          const optionsJSON = await optionsResponse.json();
+          const publicKey = parseCreationOptions(optionsJSON);
+
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential) {
+            throw new Error('Passkey creation did not return a credential.');
+          }
+
+          const credentialJSON = serializeCredential(credential);
+
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify(credentialJSON),
+          });
+
+          if (!verifyResponse.ok) {
+            throw new Error('Failed to verify passkey registration.');
+          }
+
+          setStatus('Passkey created successfully!', 'success');
+        } catch (error) {
+          if (error && error.name === 'InvalidStateError') {
+            setStatus('A passkey is already registered on this device.', 'error');
+          } else if (error && error.name === 'NotAllowedError') {
+            setStatus('Passkey creation was cancelled or not allowed.', 'error');
+          } else {
+            setStatus(
+              (error && error.message) || 'An error occurred while creating your passkey.',
+              'error'
+            );
+          }
+        } finally {
+          registerButton.disabled = false;
+        }
+      }
+
+      if (registerButton) {
+        registerButton.addEventListener('click', handleRegisterClick);
+      }
+    })();
+  </script>
