+  <script type="module">
+    // Progressive enhancement: the button only appears when the browser can show its own install consent UI.
+    const installButton = document.querySelector("#install-app");
+    const installStatus = document.querySelector("#install-status");
+    const supportsWebInstall =
+      typeof Navigator.prototype.install === "function";
+    let deferredInstallPrompt;
+
+    if (supportsWebInstall) {
+      installButton.hidden = false;
+    }
+
+    window.addEventListener("beforeinstallprompt", (event) => {
+      event.preventDefault();
+      deferredInstallPrompt = event;
+
+      // Prefer navigator.install() when both mechanisms are available.
+      if (!supportsWebInstall) {
+        installButton.hidden = false;
+      }
+    });
+
+    window.addEventListener("appinstalled", () => {
+      deferredInstallPrompt = undefined;
+      installButton.hidden = true;
+    });
+
+    installButton.addEventListener("click", async () => {
+      if (installButton.getAttribute("aria-disabled") === "true") {
+        return;
+      }
+      // aria-disabled instead of disabled so activating the button does not drop focus.
+      installButton.setAttribute("aria-disabled", "true");
+
+      try {
+        if (supportsWebInstall) {
+          // Call directly from the click handler to keep transient user activation.
+          await navigator.install();
+          installStatus.textContent = "The Daily Grind app was installed or opened.";
+          installButton.hidden = true;
+        } else if (deferredInstallPrompt) {
+          // The event is single-use: clear it before awaiting the user's choice.
+          const promptEvent = deferredInstallPrompt;
+          deferredInstallPrompt = undefined;
+          await promptEvent.prompt();
+          const { outcome } = await promptEvent.userChoice;
+
+          installStatus.textContent =
+            outcome === "accepted"
+              ? "The Daily Grind app was installed."
+              : "Installation canceled.";
+          if (!deferredInstallPrompt) {
+            installButton.hidden = true;
+          }
+        }
+      } catch (error) {
+        if (error.name === "AbortError") {
+          // Cancellation is an expected choice; keep the button available to retry.
+          installStatus.textContent = "Installation was canceled or could not complete.";
+        } else {
+          installStatus.textContent = "Installation could not start.";
+          console.error(error);
+        }
+      } finally {
+        installButton.removeAttribute("aria-disabled");
+      }
+    });
+  </script>
+
