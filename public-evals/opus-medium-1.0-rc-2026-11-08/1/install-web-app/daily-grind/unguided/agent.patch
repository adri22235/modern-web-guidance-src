     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const installEl = document.getElementById('install-app');
+      const fallbackBtn = document.getElementById('install-fallback');
+      const status = document.getElementById('install-status');
+
+      const isStandalone = window.matchMedia('(display-mode: standalone)').matches ||
+        window.navigator.standalone === true;
+
+      const show = () => { installEl.hidden = false; };
+      const hide = () => { installEl.hidden = true; };
+      const setStatus = (msg) => { status.textContent = msg; };
+      const onInstalled = () => {
+        hide();
+        setStatus('The Daily Grind app is installed. Enjoy!');
+      };
+
+      // Already running as the installed app: nothing to offer.
+      if (isStandalone) return;
+
+      window.addEventListener('appinstalled', onInstalled);
+
+      // 1. Native <install> element: browser-owned button + consent UI.
+      if ('HTMLInstallElement' in window) {
+        installEl.addEventListener('promptaction', onInstalled);
+        installEl.addEventListener('promptdismiss', () => setStatus('Installation cancelled.'));
+        installEl.addEventListener('validationstatuschange', () => {
+          if (installEl.invalidReason) console.warn('Install element invalid:', installEl.invalidReason);
+        });
+        show();
+        return;
+      }
+
+      // 2. Web Install API: navigator.install() opens the browser's install dialog.
+      if ('install' in navigator) {
+        fallbackBtn.addEventListener('click', async () => {
+          try {
+            await navigator.install();
+            onInstalled();
+          } catch (err) {
+            setStatus(err && err.name === 'AbortError'
+              ? 'Installation cancelled.'
+              : 'This app can\'t be installed right now.');
+          }
+        });
+        show();
+        return;
+      }
+
+      // 3. beforeinstallprompt (Chromium): defer the browser's prompt until clicked.
+      let deferredPrompt = null;
+      window.addEventListener('beforeinstallprompt', (event) => {
+        event.preventDefault();
+        deferredPrompt = event;
+        show();
+      });
+      fallbackBtn.addEventListener('click', async () => {
+        if (!deferredPrompt) return;
+        const prompt = deferredPrompt;
+        deferredPrompt = null;
+        prompt.prompt();
+        const { outcome } = await prompt.userChoice;
+        if (outcome === 'accepted') onInstalled();
+        else {
+          hide();
+          setStatus('Installation cancelled.');
+        }
+      });
+    })();
+  </script>
+
