+  <script type="module">
+    const navLinks = document.querySelectorAll('.nav-section-link');
+
+    const setCurrent = (currentLink) => {
+      navLinks.forEach((link) => {
+        link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+      });
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native scrollspy handles the visuals; mirror the state for assistive tech.
+      const syncAriaCurrent = () => setCurrent(document.querySelector('.nav-section-link:target-current'));
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: track whichever section crosses the middle of the viewport.
+      const linkFor = new Map([...navLinks].map((link) => [link.hash.slice(1), link]));
+      const hero = document.querySelector('.hero');
+
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (!entry.isIntersecting) return;
+          const currentLink = entry.target === hero ? null : linkFor.get(entry.target.id);
+          navLinks.forEach((link) => link.classList.toggle('target-current', link === currentLink));
+          setCurrent(currentLink);
+        });
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      observer.observe(hero);
+      linkFor.forEach((_, id) => observer.observe(document.getElementById(id)));
+    }
+  </script>
+
