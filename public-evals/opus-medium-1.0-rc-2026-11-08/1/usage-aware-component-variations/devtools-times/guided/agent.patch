+/*
+ * Contextual teaser presentation.
+ * Sections opt into the featured context by setting --surface; teaser
+ * badges and action buttons react to it without knowing who set it.
+ */
+.surface-featured {
+  --surface: featured;
+}
+
+@layer components {
+  .teaser-badge {
+    /* Default: hidden — only revealed in featured surfaces */
+    display: none;
+    align-self: flex-start;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background: var(--color-amber-400);
+    color: var(--color-gray-900);
+    font-size: var(--text-xs);
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    /* Default: subtle outlined button */
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.25rem 0.75rem;
+    border: 1px solid var(--color-gray-300);
+    border-radius: 0.375rem;
+    background: transparent;
+    color: var(--color-gray-700);
+    font-size: var(--text-sm);
+    font-weight: 600;
+    transition: background-color 150ms, color 150ms, border-color 150ms;
+  }
+
+  .teaser-action:hover {
+    border-color: var(--color-amber-400);
+    color: var(--color-amber-800);
+  }
+
+  /* Selector-based fallback for browsers without style queries */
+  :where(.surface-featured) .teaser-badge {
+    display: inline-block;
+  }
+
+  :where(.surface-featured) .teaser-action {
+    border-color: var(--color-amber-400);
+    background: var(--color-amber-400);
+    color: var(--color-gray-900);
+  }
+
+  :where(.surface-featured) .teaser-action:hover {
+    border-color: var(--color-amber-500);
+    background: var(--color-amber-500);
+  }
+
+  /* Progressive enhancement: semantic context via style queries */
+  @container style(--surface: featured) {
+    .teaser-badge {
+      display: inline-block;
+    }
+
+    .teaser-action {
+      border-color: var(--color-amber-400);
+      background: var(--color-amber-400);
+      color: var(--color-gray-900);
+    }
+
+    .teaser-action:hover {
+      border-color: var(--color-amber-500);
+      background: var(--color-amber-500);
+    }
+  }
+}
