+}
+/*
+ * Teaser context
+ * Sections declare their semantic context via `data-teaser-context`. Teaser
+ * badges and action buttons query the inherited `--teaser-context` with a
+ * container style query, so they adapt to wherever they are placed without
+ * needing any props. Outside a declared context they fall back to "standard".
+ */
+@property --teaser-context {
+  syntax: "featured | standard";
+  inherits: true;
+  initial-value: standard;
+}
+
+[data-teaser-context="featured"] {
+  --teaser-context: featured;
+}
+
+[data-teaser-context="standard"] {
+  --teaser-context: standard;
+}
+
+@layer components {
+  /* Standard (subtle) presentation */
+  .teaser-badge {
+    display: none;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background-color: var(--color-amber-400);
+    color: var(--color-gray-900);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.25rem;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.25rem 0.75rem;
+    border: 1px solid var(--color-gray-300);
+    border-radius: 0.375rem;
+    background-color: transparent;
+    color: var(--color-gray-700);
+    font-size: 0.8125rem;
+    font-weight: 600;
+    white-space: nowrap;
+    transition: background-color 150ms, border-color 150ms, color 150ms;
+  }
+
+  .teaser-action:hover {
+    border-color: var(--color-amber-400);
+    color: var(--color-amber-800);
+  }
+
+  /* Featured (prominent) presentation */
+  @container style(--teaser-context: featured) {
+    .teaser-badge {
+      display: inline-flex;
+    }
+
+    .teaser-action {
+      border-color: var(--color-amber-400);
+      background-color: var(--color-amber-400);
+      color: var(--color-gray-900);
+    }
+
+    .teaser-action:hover {
+      border-color: var(--color-amber-500);
+      background-color: var(--color-amber-500);
+      color: var(--color-gray-900);
+    }
+  }
+}
