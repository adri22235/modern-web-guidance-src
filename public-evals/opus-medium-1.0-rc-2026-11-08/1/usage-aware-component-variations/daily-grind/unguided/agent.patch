+    /* Themed Sections
+       A section declares its context with data-theme; cards inside inherit
+       the theme tokens through the cascade, so no per-card classes are needed. */
+    .themed-section {
+      --theme-surface: white;
+      --theme-surface-alt: white;
+      --theme-heading: var(--primary);
+      --theme-text: var(--text);
+      --theme-accent: var(--accent);
+      --theme-btn: var(--primary);
+      --theme-btn-hover: #3e2723;
+      --theme-btn-text: white;
+      --theme-border: transparent;
+      --theme-shadow: rgba(0, 0, 0, 0.1);
+      --theme-icon: none;
+    }
+
+    .themed-section[data-theme="autumn"] {
+      --theme-surface: #fff8f0;
+      --theme-surface-alt: #fbe3c8;
+      --theme-heading: #8d3b12;
+      --theme-text: #5d3a1a;
+      --theme-accent: #e07a1f;
+      --theme-btn: #b4501c;
+      --theme-btn-hover: #8d3b12;
+      --theme-border: #f0b27a;
+      --theme-shadow: rgba(180, 80, 28, 0.18);
+      --theme-icon: "\1F341";
+    }
+
+    .themed-section[data-theme="winter"] {
+      --theme-surface: #f7fbff;
+      --theme-surface-alt: #dceaf7;
+      --theme-heading: #1f4e79;
+      --theme-text: #2b3e50;
+      --theme-accent: #5aa9e6;
+      --theme-btn: #2f6fa7;
+      --theme-btn-hover: #1f4e79;
+      --theme-border: #a9cbe8;
+      --theme-shadow: rgba(47, 111, 167, 0.18);
+      --theme-icon: "\2744";
+    }
+
+    .themed-section[data-theme="spring"] {
+      --theme-surface: #fbfff7;
+      --theme-surface-alt: #e4f4d8;
+      --theme-heading: #3d6b2a;
+      --theme-text: #3a4a2f;
+      --theme-accent: #e88fb0;
+      --theme-btn: #5b8f3c;
+      --theme-btn-hover: #3d6b2a;
+      --theme-border: #bfdca8;
+      --theme-shadow: rgba(91, 143, 60, 0.18);
+      --theme-icon: "\1F338";
+    }
+
+    .themed-section[data-theme="summer"] {
+      --theme-surface: #fffdf2;
+      --theme-surface-alt: #fff0b8;
+      --theme-heading: #a15c00;
+      --theme-text: #5a4210;
+      --theme-accent: #ffc107;
+      --theme-btn: #e08e00;
+      --theme-btn-hover: #a15c00;
+      --theme-border: #ffd966;
+      --theme-shadow: rgba(224, 142, 0, 0.2);
+      --theme-icon: "\2600";
+    }
+
+    .section-title {
+      text-align: center;
+    }
+
+    .themed-section .section-title {
+      color: var(--theme-heading);
+    }
+
+    .themed-section .section-title::before,
+    .themed-section .section-title::after {
+      content: var(--theme-icon);
+      margin: 0 0.4em;
+    }
+
+    .themed-section .card {
+      position: relative;
+      overflow: hidden;
+      color: var(--theme-text);
+      background: linear-gradient(160deg, var(--theme-surface) 55%, var(--theme-surface-alt));
+      border: 1px solid var(--theme-border);
+      border-top: 4px solid var(--theme-accent);
+      box-shadow: 0 4px 12px var(--theme-shadow);
+      transition: transform 0.3s, box-shadow 0.3s;
+    }
+
+    .themed-section .card:hover {
+      transform: translateY(-4px);
+      box-shadow: 0 10px 22px var(--theme-shadow);
+    }
+
+    .themed-section .card::after {
+      content: var(--theme-icon);
+      position: absolute;
+      right: 10px;
+      bottom: 4px;
+      font-size: 2.5rem;
+      opacity: 0.15;
+      pointer-events: none;
+    }
+
+    .themed-section .card h3 {
+      color: var(--theme-heading);
+    }
+
+    .themed-section .btn {
+      background: var(--theme-btn);
+      color: var(--theme-btn-text);
+    }
+
+    .themed-section .btn:hover,
+    .themed-section .btn:focus-visible {
+      background: var(--theme-btn-hover);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .themed-section .card {
+        transition: none;
+      }
+
+      .themed-section .card:hover {
+        transform: none;
+      }
+    }
+
