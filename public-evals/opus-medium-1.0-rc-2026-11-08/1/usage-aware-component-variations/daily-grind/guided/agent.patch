+    /* Contextual card variations
+       Sections declare a semantic context flag (--surface) plus an optional
+       theme (--season); cards react to it without knowing which element set it. */
+    .seasonal {
+      --surface: seasonal;
+      --season: autumn;
+    }
+
+    /* Hidden by default; revealed only in a seasonal context */
+    .card-badge {
+      display: none;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: var(--season-accent, #e65100);
+      color: white;
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+    }
+
+    /* Selector-based fallback for browsers without container style queries */
+    :where(.seasonal) .card {
+      background: linear-gradient(160deg, #fff8f0, #fbe9d7);
+      border-top: 4px solid var(--season-accent, #e65100);
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.15);
+    }
+
+    :where(.seasonal) .card h3 {
+      color: var(--season-ink, #bf360c);
+    }
+
+    :where(.seasonal) .card .btn {
+      background: var(--season-accent, #e65100);
+    }
+
+    :where(.seasonal) .card-badge {
+      display: inline-block;
+    }
+
+    /* Progressive enhancement: style queries override when supported */
+    @container style(--surface: seasonal) {
+      .card {
+        --season-accent: #e65100;
+        --season-ink: #bf360c;
+        --season-tint: #fbe9d7;
+        background: linear-gradient(160deg, #fff8f0, var(--season-tint));
+        border-top: 4px solid var(--season-accent);
+        box-shadow: 0 4px 12px rgba(78, 52, 46, 0.15);
+        transition: transform 0.3s, box-shadow 0.3s;
+      }
+
+      .card:hover {
+        box-shadow: 0 8px 20px rgba(78, 52, 46, 0.2);
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        .card:hover {
+          transform: translateY(-4px);
+        }
+      }
+
+      .card h3 {
+        color: var(--season-ink);
+      }
+
+      .card .btn {
+        background: var(--season-accent);
+      }
+
+      .card .btn:hover {
+        background: var(--season-ink);
+      }
+
+      .card-badge {
+        display: inline-block;
+      }
+    }
+
+    @container style(--season: winter) {
+      .card {
+        --season-accent: #1565c0;
+        --season-ink: #0d47a1;
+        --season-tint: #e3f2fd;
+      }
+    }
+
+    @container style(--season: spring) {
+      .card {
+        --season-accent: #ad1457;
+        --season-ink: #880e4f;
+        --season-tint: #fce4ec;
+      }
+    }
+
+    @container style(--season: summer) {
+      .card {
+        --season-accent: #00897b;
+        --season-ink: #00695c;
+        --season-tint: #e0f2f1;
+      }
+    }
+
