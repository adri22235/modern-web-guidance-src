     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase Section */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+      align-items: start;
+    }
+
+    /* Padded, rounded card whose children are clipped to its inner curve */
+    .nested-curve-parent {
+      --radius: 24px;
+      --pad: 12px;
+      background: var(--primary);
+      padding: var(--pad);
+      border-radius: var(--radius);
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      /* Fallback: clips at the padding box, so children get an explicit inner radius */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent > :first-child {
+      border-top-left-radius: calc(var(--radius) - var(--pad));
+      border-top-right-radius: calc(var(--radius) - var(--pad));
+    }
+
+    .nested-curve-parent > :last-child {
+      border-bottom-left-radius: calc(var(--radius) - var(--pad));
+      border-bottom-right-radius: calc(var(--radius) - var(--pad));
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--light);
+      padding: 16px 20px;
+    }
+
+    .nested-curve-footer h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* Clip to the content box; its edge follows the card's inner curve */
+        overflow-clip-margin: content-box;
+      }
+
+      .nested-curve-parent > * {
+        border-radius: 0;
+      }
+    }
+
+    /* Promo container: clips overflowing text but lets the button glow bleed */
+    .safety-zone-parent {
+      position: relative;
+      background: linear-gradient(135deg, var(--primary), #6d4c41);
+      color: white;
+      padding: 32px 28px 28px;
+      border-radius: 16px;
+      /* Fallback: clips overflowing text, but also truncates the button glow */
+      overflow: hidden;
+    }
+
+    .promo-watermark {
+      font-size: 5rem;
+      font-weight: 800;
+      line-height: 1;
+      white-space: nowrap;
+      color: rgba(255, 255, 255, 0.08);
+      margin: -12px 0 8px -6px;
+      user-select: none;
+    }
+
+    .safety-zone-parent h3 {
+      font-size: 1.6rem;
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent p {
+      margin-bottom: 20px;
+      opacity: 0.9;
+    }
+
+    .glow-btn {
+      display: block;
+      width: 100%;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      text-align: center;
+      text-decoration: none;
+      padding: 14px 20px;
+      border-radius: 8px;
+      box-shadow: 0 10px 28px 4px rgba(255, 171, 64, 0.75);
+      transition: box-shadow 0.3s;
+    }
+
+    .glow-btn:hover,
+    .glow-btn:focus-visible {
+      box-shadow: 0 12px 36px 8px rgba(255, 171, 64, 0.9);
+    }
+
+    @supports (overflow-clip-margin: 20px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Safety zone so the button glow renders past the edge unclipped */
+        overflow-clip-margin: 20px;
+      }
+    }
+
