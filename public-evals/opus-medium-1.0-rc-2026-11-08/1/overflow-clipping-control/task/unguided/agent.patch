+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+    }
+
+    /* Card whose content is clipped to its padding box edge, following the inner curve */
+    .nested-curve-parent {
+      --outer-radius: 24px;
+      --pad: 12px;
+      background: var(--primary);
+      padding: var(--pad);
+      border-radius: var(--outer-radius);
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent>* {
+      /* Fallback for browsers without overflow-clip-margin visual-box support */
+      border-radius: calc(var(--outer-radius) - var(--pad));
+    }
+
+    .nested-curve-inner {
+      background: white;
+      overflow: hidden;
+    }
+
+    .nested-curve-inner img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-body {
+      padding: 20px;
+    }
+
+    .nested-curve-body h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    /* Promo container: clips overflow but leaves a safety zone for the button glow */
+    .safety-zone-parent {
+      --glow: 24px;
+      position: relative;
+      background: linear-gradient(135deg, var(--primary), #6d4c41);
+      color: white;
+      border-radius: 16px;
+      padding: 30px;
+      max-height: 340px;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      overflow: clip;
+      overflow-clip-margin: var(--glow);
+    }
+
+    .safety-zone-parent h3 {
+      font-size: 1.6rem;
+      margin-bottom: 10px;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    .safety-zone-parent p {
+      display: -webkit-box;
+      -webkit-line-clamp: 3;
+      line-clamp: 3;
+      -webkit-box-orient: vertical;
+      overflow: hidden;
+    }
+
+    .glow-btn {
+      align-self: flex-start;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      box-shadow: 0 0 var(--glow) 6px rgba(255, 171, 64, 0.75);
+    }
+
+    .glow-btn:hover {
+      background: #ffb74d;
+    }
+
