+  <script>
+    (function () {
+      var hero = document.querySelector('.hero');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var heroExit = heroSlot.querySelector('.hero-exit-theater');
+      var sectionSlot = document.getElementById('section-video-slot');
+      var placeholder = sectionSlot.querySelector('.video-slot-placeholder');
+      var frame = document.getElementById('video-frame');
+      var iframe = document.getElementById('roasting-iframe');
+      var mainToggle = document.getElementById('theater-toggle');
+      var toggles = document.querySelectorAll('.theater-toggle');
+      var theater = false;
+
+      // Element.moveBefore() relocates a node without unloading iframes, so
+      // playback continues untouched. Browsers without it reload the iframe on
+      // reparenting; for those we track playback over the YouTube embed
+      // postMessage API and restore position/play state after the move.
+      var canMoveAtomically = typeof Element.prototype.moveBefore === 'function';
+      var YT_ORIGIN = 'https://www.youtube.com';
+      var PLAYING = 1, BUFFERING = 3;
+      var playback = { time: 0, state: -1 };
+      var pendingRestore = null;
+
+      function post(message) {
+        if (iframe.contentWindow) {
+          iframe.contentWindow.postMessage(JSON.stringify(message), YT_ORIGIN);
+        }
+      }
+
+      function command(func, args) {
+        post({ event: 'command', func: func, args: args || [], id: iframe.id, channel: 'widget' });
+      }
+
+      function startListening() {
+        post({ event: 'listening', id: iframe.id, channel: 'widget' });
+      }
+
+      iframe.addEventListener('load', startListening);
+
+      window.addEventListener('message', function (e) {
+        if (e.source !== iframe.contentWindow || !/^https:\/\/www\.youtube(-nocookie)?\.com$/.test(e.origin)) return;
+        var data;
+        try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch (err) { return; }
+        if (!data || !data.event) return;
+
+        if (data.info) {
+          if (typeof data.info.currentTime === 'number') playback.time = data.info.currentTime;
+          if (typeof data.info.playerState === 'number') playback.state = data.info.playerState;
+        }
+
+        if (pendingRestore && (data.event === 'onReady' || data.event === 'initialDelivery')) {
+          var restore = pendingRestore;
+          pendingRestore = null;
+          command('seekTo', [restore.time, true]);
+          command(restore.playing ? 'playVideo' : 'pauseVideo');
+        }
+      });
+
+      function moveFrame(target, before) {
+        if (frame.parentNode === target) return;
+        if (canMoveAtomically) {
+          target.moveBefore(frame, before);
+          return;
+        }
+        var playing = playback.state === PLAYING || playback.state === BUFFERING;
+        if (playback.time > 0 || playing) {
+          pendingRestore = { time: playback.time, playing: playing };
+        }
+        target.insertBefore(frame, before);
+      }
+
+      function setTheater(on) {
+        theater = on;
+        if (on) {
+          moveFrame(heroSlot, heroExit);
+        } else {
+          moveFrame(sectionSlot, placeholder);
+        }
+        hero.classList.toggle('theater', on);
+        sectionSlot.classList.toggle('is-empty', on);
+        toggles.forEach(function (btn) { btn.setAttribute('aria-pressed', String(on)); });
+        mainToggle.textContent = on ? 'Exit Theater Mode' : 'Theater Mode';
+
+        var focusTarget = on ? heroExit : mainToggle;
+        focusTarget.focus({ preventScroll: true });
+        (on ? hero : sectionSlot).scrollIntoView({ behavior: 'smooth', block: on ? 'start' : 'center' });
+      }
+
+      toggles.forEach(function (btn) {
+        btn.addEventListener('click', function () { setTheater(!theater); });
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && theater) setTheater(false);
+      });
+    })();
+  </script>
+
