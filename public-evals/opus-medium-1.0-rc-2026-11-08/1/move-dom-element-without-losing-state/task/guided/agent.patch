+  <script>
+    (() => {
+      const player = document.getElementById('player');
+      const iframe = document.getElementById('roast-video');
+      const toggle = document.getElementById('theater-toggle');
+      const hero = document.querySelector('.hero');
+      const theaterSlot = document.getElementById('theater-slot');
+      const videoHome = document.getElementById('video-home');
+      const placeholder = document.getElementById('theater-placeholder');
+      const status = document.getElementById('theater-status');
+      const canMoveAtomically = 'moveBefore' in Element.prototype;
+
+      // Fallback for browsers without moveBefore() (e.g. Safari): a regular
+      // DOM move reloads the iframe, so track playback via the YouTube
+      // postMessage API and resume from the same spot after the reload.
+      const playback = { time: 0, playing: false };
+      if (!canMoveAtomically) {
+        const listen = () => iframe.contentWindow?.postMessage(
+          JSON.stringify({ event: 'listening', id: iframe.id, channel: 'widget' }), '*');
+        iframe.addEventListener('load', listen);
+        window.addEventListener('message', (e) => {
+          if (e.source !== iframe.contentWindow || typeof e.data !== 'string') return;
+          let data;
+          try { data = JSON.parse(e.data); } catch { return; }
+          const info = data.event === 'infoDelivery' && data.info;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') playback.time = info.currentTime;
+          if (typeof info.playerState === 'number') playback.playing = info.playerState === 1;
+        });
+      }
+
+      function moveInto(parent, ref) {
+        if (canMoveAtomically) {
+          parent.moveBefore(player, ref);
+          return;
+        }
+        const url = new URL(iframe.src);
+        url.searchParams.set('start', Math.floor(playback.time));
+        url.searchParams.set('autoplay', playback.playing ? '1' : '0');
+        iframe.src = url.href;
+        parent.insertBefore(player, ref);
+        toggle.focus();
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+        if (entering) {
+          moveInto(theaterSlot, null);
+          placeholder.hidden = false;
+          hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        } else {
+          moveInto(videoHome, placeholder);
+          placeholder.hidden = true;
+          videoHome.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+        hero.classList.toggle('theater', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        status.textContent = entering
+          ? 'Video moved to theater mode at the top of the page.'
+          : 'Video returned to its section.';
+      });
+    })();
+  </script>
+
