+  <script type="module">
+    // Load polyfills only where native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js').catch(() => {});
+    }
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    // Run the exit transition before removing the element from the top layer
+    // in browsers that can't keep it rendered while display/overlay transition.
+    async function closeTopLayer(element, close) {
+      if (!supportsTopLayerExit()) {
+        if (element.hasAttribute('data-closing')) return;
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+      close();
+    }
+
+    // Logout confirmation dialog
+    const dialog = document.getElementById('logout-dialog');
+    const closeDialog = () => closeTopLayer(dialog, () => dialog.close());
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+
+    // Route Esc and backdrop clicks through the animated close
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDialog();
+    });
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) closeDialog(); });
+    }
+
+    // Floating info notice
+    const notice = document.getElementById('info-notice');
+    const noticeTrigger = document.getElementById('foobar');
+
+    notice.querySelector('.notice-close').addEventListener('click', () => {
+      closeTopLayer(notice, () => {
+        notice.hidePopover();
+        // The close button disappears with the notice, so hand focus back to the trigger
+        if (!document.activeElement || document.activeElement === document.body) {
+          noticeTrigger.focus();
+        }
+      });
+    });
+  </script>
