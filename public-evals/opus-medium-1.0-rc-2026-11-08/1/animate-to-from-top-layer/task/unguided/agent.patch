+  <script>
+    (function () {
+      // Waits for the element's transition to finish, with a timeout fallback
+      // in case transitionend never fires (e.g. reduced motion, hidden tab).
+      function afterTransition(el, cb) {
+        var done = false;
+        function finish(e) {
+          if (done || (e && e.target !== el)) return;
+          done = true;
+          el.removeEventListener('transitionend', finish);
+          cb();
+        }
+        el.addEventListener('transitionend', finish);
+        setTimeout(finish, 400);
+      }
+
+      // Logout confirmation dialog
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+      var closing = false;
+
+      function openDialog() {
+        if (dialog.open) return;
+        closing = false;
+        dialog.showModal();
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () { dialog.classList.add('is-open'); });
+        });
+      }
+
+      function closeDialog() {
+        if (!dialog.open || closing) return;
+        closing = true;
+        dialog.classList.remove('is-open');
+        afterTransition(dialog, function () {
+          if (closing) dialog.close();
+          closing = false;
+        });
+      }
+
+      if (typeof dialog.showModal === 'function') {
+        openBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          openDialog();
+        });
+        closeBtn.addEventListener('click', closeDialog);
+        // Animate Escape-key dismissal instead of closing instantly
+        dialog.addEventListener('cancel', function (e) {
+          e.preventDefault();
+          closeDialog();
+        });
+        // Close when clicking the backdrop
+        dialog.addEventListener('click', function (e) {
+          if (e.target === dialog) closeDialog();
+        });
+      }
+
+      // Floating informational notice
+      var notice = document.getElementById('info-notice');
+      var noticeBtn = document.getElementById('foobar');
+      var noticeClose = document.getElementById('close-notice-btn');
+      var noticeToken = 0;
+
+      function showNotice() {
+        var token = ++noticeToken;
+        notice.hidden = false;
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () {
+            if (token === noticeToken) notice.classList.add('is-visible');
+          });
+        });
+      }
+
+      function hideNotice() {
+        if (notice.hidden) return;
+        var token = ++noticeToken;
+        notice.classList.remove('is-visible');
+        afterTransition(notice, function () {
+          if (token === noticeToken) notice.hidden = true;
+        });
+        noticeBtn.focus();
+      }
+
+      noticeBtn.addEventListener('click', showNotice);
+      noticeClose.addEventListener('click', hideNotice);
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && !dialog.open) hideNotice();
+      });
+    })();
+  </script>
+
