+  <script type="module">
+    // Load the Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const formatDuration = (duration) => {
+      if ('DurationFormat' in Intl) {
+        return new Intl.DurationFormat(undefined, { style: 'long' }).format(duration);
+      }
+      // Fallback for browsers without Intl.DurationFormat.
+      const parts = ['days', 'hours']
+        .filter((unit) => duration[unit] !== 0)
+        .map((unit) => new Intl.NumberFormat(undefined, {
+          style: 'unit',
+          unit: unit.slice(0, -1),
+          unitDisplay: 'long',
+        }).format(duration[unit]));
+      return new Intl.ListFormat(undefined, { type: 'unit' }).format(parts.length ? parts : ['0 hours']);
+    };
+
+    const renderTime = (duration) => {
+      const time = document.createElement('time');
+      time.dateTime = duration.toString();
+      time.textContent = formatDuration(duration);
+      return time;
+    };
+
+    const timer = document.getElementById('maple-promo-timer');
+    const remainingEl = timer.querySelector('.promo-remaining');
+    const elapsedEl = timer.querySelector('.promo-elapsed');
+
+    // Promotion boundaries are midnight in the visitor's own time zone.
+    const now = Temporal.Now.zonedDateTimeISO();
+    const tz = now.timeZoneId;
+    const start = Temporal.PlainDate.from(timer.dataset.start).toZonedDateTime({ timeZone: tz });
+    const end = Temporal.PlainDate.from(timer.dataset.end).toZonedDateTime({ timeZone: tz });
+    const diffOptions = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+
+    const remaining = now.until(end, diffOptions);
+    const elapsed = now.since(start, diffOptions);
+
+    if (elapsed.sign < 0) {
+      timer.dataset.state = 'upcoming';
+      remainingEl.replaceChildren('Offer starts in ', renderTime(now.until(start, diffOptions)), '.');
+    } else if (remaining.sign <= 0) {
+      timer.dataset.state = 'ended';
+      remainingEl.replaceChildren('This offer ended ', renderTime(remaining.negated()), ' ago.');
+      elapsedEl.replaceChildren('Promotion ran for ', renderTime(end.since(start, diffOptions)),
+        '; ', renderTime(elapsed), ' since it started.');
+      elapsedEl.hidden = false;
+    } else {
+      timer.dataset.state = 'active';
+      remainingEl.replaceChildren(renderTime(remaining), ' left until the offer ends.');
+      elapsedEl.replaceChildren(renderTime(elapsed), ' since the promotion started.');
+      elapsedEl.hidden = false;
+    }
+  </script>
+
