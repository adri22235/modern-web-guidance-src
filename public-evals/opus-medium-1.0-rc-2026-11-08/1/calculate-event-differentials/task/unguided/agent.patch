+  <script>
+    (function () {
+      var el = document.getElementById('maple-promo');
+      if (!el) return;
+
+      var remainingEl = el.querySelector('.promo-remaining');
+      var elapsedEl = el.querySelector('.promo-elapsed');
+
+      // Returns { days, hours } between two instants, counting calendar days in the
+      // visitor's time zone (so DST-shortened/lengthened days still count as one day).
+      // Prefers the Temporal API; falls back to Date where it isn't supported yet.
+      var diff;
+      var now, start, end, compare;
+
+      var useTemporal = typeof Temporal !== 'undefined' &&
+        Temporal.Now && typeof Temporal.Now.timeZoneId === 'function';
+
+      if (useTemporal) {
+        try {
+          var tz = Temporal.Now.timeZoneId();
+          var toZoned = function (s) {
+            return Temporal.PlainDateTime.from(s).toZonedDateTime(tz);
+          };
+          now = Temporal.Now.zonedDateTimeISO(tz);
+          start = toZoned(el.dataset.start);
+          end = toZoned(el.dataset.end);
+          compare = Temporal.ZonedDateTime.compare;
+          diff = function (from, to) {
+            var d = from.until(to, { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' });
+            return { days: d.days, hours: d.hours };
+          };
+          diff(start, end); // Exercise the API up front so failures land in the catch.
+        } catch (err) {
+          // Partial or pre-standard Temporal implementations: fall back to Date.
+          useTemporal = false;
+        }
+      }
+
+      if (!useTemporal) {
+        // Parse "YYYY-MM-DDTHH:mm" as local time explicitly; Date string parsing is
+        // inconsistent across engines for offset-less values.
+        var toLocal = function (s) {
+          var p = s.split(/[-T:]/).map(Number);
+          return new Date(p[0], p[1] - 1, p[2], p[3] || 0, p[4] || 0);
+        };
+        now = new Date();
+        start = toLocal(el.dataset.start);
+        end = toLocal(el.dataset.end);
+        compare = function (a, b) { return Math.sign(a - b); };
+        diff = function (from, to) {
+          var cursor = new Date(from);
+          var days = 0;
+          while (true) {
+            var next = new Date(cursor);
+            next.setDate(next.getDate() + 1);
+            if (next > to) break;
+            cursor = next;
+            days++;
+          }
+          return { days: days, hours: Math.floor((to - cursor) / 3600000) };
+        };
+      }
+
+      var formatDuration = (function () {
+        if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+          var df = new Intl.DurationFormat(undefined, { style: 'long' });
+          return function (d) {
+            return d.days || d.hours ? df.format(d) : 'less than an hour';
+          };
+        }
+        var plural = function (n, word) { return n + ' ' + word + (n === 1 ? '' : 's'); };
+        return function (d) {
+          if (!d.days && !d.hours) return 'less than an hour';
+          if (!d.days) return plural(d.hours, 'hour');
+          if (!d.hours) return plural(d.days, 'day');
+          return plural(d.days, 'day') + ', ' + plural(d.hours, 'hour');
+        };
+      })();
+
+      if (compare(now, start) < 0) {
+        remainingEl.textContent = 'Offer starts in ' + formatDuration(diff(now, start)) + '.';
+      } else if (compare(now, end) < 0) {
+        remainingEl.textContent = formatDuration(diff(now, end)) + ' left on this offer!';
+        elapsedEl.textContent = 'Promotion started ' + formatDuration(diff(start, now)) + ' ago.';
+      } else {
+        remainingEl.textContent = 'This offer has ended.';
+        elapsedEl.textContent = 'It ran for ' + formatDuration(diff(start, end)) +
+          ' and ended ' + formatDuration(diff(end, now)) + ' ago.';
+      }
+    })();
+  </script>
