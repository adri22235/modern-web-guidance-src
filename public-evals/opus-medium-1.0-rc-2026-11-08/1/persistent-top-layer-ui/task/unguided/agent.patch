+  <button type="button" class="btn feedback-launcher" id="feedback-open">Give Feedback</button>
+
+  <dialog class="feedback-modal" id="feedback-modal" aria-labelledby="feedback-title">
+    <header>
+      <h2 id="feedback-title">Tell Us How We're Brewing</h2>
+      <button type="button" class="close-x" data-close aria-label="Close feedback">&times;</button>
+    </header>
+    <form id="feedback-form" method="dialog">
+      <p class="location" aria-live="polite">Currently attached to: <strong id="feedback-location"></strong></p>
+      <label>
+        Rating
+        <select name="rating" required>
+          <option value="">Choose one…</option>
+          <option>5 – Perfect pour</option>
+          <option>4 – Pretty great</option>
+          <option>3 – Just okay</option>
+          <option>2 – Needs work</option>
+          <option>1 – Burnt</option>
+        </select>
+      </label>
+      <label>
+        Email (optional)
+        <input type="email" name="email" placeholder="you@example.com" autocomplete="email">
+      </label>
+      <label>
+        Comments
+        <textarea name="comments" placeholder="What did you love? What could be better?"></textarea>
+      </label>
+      <p class="thanks" id="feedback-thanks" hidden>Thanks! Your feedback has been noted.</p>
+      <div class="actions">
+        <button type="button" class="btn btn-secondary" id="feedback-move">Move</button>
+        <button type="button" class="btn" data-close>Cancel</button>
+        <button type="submit" class="btn">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-modal');
+      const form = document.getElementById('feedback-form');
+      const openBtn = document.getElementById('feedback-open');
+      const moveBtn = document.getElementById('feedback-move');
+      const locationLabel = document.getElementById('feedback-location');
+      const thanks = document.getElementById('feedback-thanks');
+      const hosts = Array.from(document.querySelectorAll('.modal-host'));
+      let hostIndex = 0;
+      let suppressedCloses = 0;
+
+      function markHost() {
+        hosts.forEach((h, i) => h.classList.toggle('is-hosting', i === hostIndex));
+        locationLabel.textContent = hosts[hostIndex].dataset.sectionName;
+      }
+
+      // Reparent the dialog without losing its open/modal state, focus or
+      // text selection. Element.moveBefore() performs an atomic, state-preserving
+      // move where supported; otherwise a plain insert drops the dialog out of the
+      // top layer, so we restore modality, focus and selection by hand.
+      function moveDialogTo(host) {
+        const wasModal = dialog.open && dialog.matches(':modal');
+        const active = document.activeElement;
+        const hasSelection = active && typeof active.selectionStart === 'number';
+        const selStart = hasSelection ? active.selectionStart : null;
+        const selEnd = hasSelection ? active.selectionEnd : null;
+        const selDir = hasSelection ? active.selectionDirection : null;
+        const scrollTop = active && active.scrollTop;
+
+        if (typeof host.moveBefore === 'function') {
+          try {
+            host.moveBefore(dialog, null);
+          } catch {
+            host.appendChild(dialog);
+          }
+        } else {
+          host.appendChild(dialog);
+        }
+
+        if (wasModal && !dialog.matches(':modal')) {
+          if (dialog.open) {
+            // close() queues a 'close' event asynchronously; skip it in the handler.
+            suppressedCloses++;
+            dialog.close();
+          }
+          dialog.showModal();
+        }
+
+        if (active && dialog.contains(active) && document.activeElement !== active) {
+          active.focus({ preventScroll: true });
+          if (hasSelection) {
+            try { active.setSelectionRange(selStart, selEnd, selDir); } catch { }
+            active.scrollTop = scrollTop;
+          }
+        }
+      }
+
+      function openModal() {
+        thanks.hidden = true;
+        if (dialog.parentElement !== hosts[hostIndex]) moveDialogTo(hosts[hostIndex]);
+        markHost();
+        if (!dialog.open) dialog.showModal();
+      }
+
+      openBtn.addEventListener('click', openModal);
+
+      moveBtn.addEventListener('click', () => {
+        hostIndex = (hostIndex + 1) % hosts.length;
+        moveDialogTo(hosts[hostIndex]);
+        markHost();
+        moveBtn.focus({ preventScroll: true });
+      });
+
+      dialog.querySelectorAll('[data-close]').forEach(btn =>
+        btn.addEventListener('click', () => dialog.close('cancel'))
+      );
+
+      // Click on the backdrop closes the modal.
+      dialog.addEventListener('click', e => {
+        if (e.target === dialog) dialog.close('cancel');
+      });
+
+      form.addEventListener('submit', e => {
+        e.preventDefault();
+        thanks.hidden = false;
+        form.reset();
+        setTimeout(() => dialog.close('sent'), 1200);
+      });
+
+      dialog.addEventListener('close', () => {
+        // Ignore the transient close that happens while re-establishing modality.
+        if (suppressedCloses > 0) { suppressedCloses--; return; }
+        hosts.forEach(h => h.classList.remove('is-hosting'));
+        openBtn.focus({ preventScroll: true });
+      });
+
+      hosts[hostIndex].appendChild(dialog);
+    })();
+  </script>
+
 </body>
 
