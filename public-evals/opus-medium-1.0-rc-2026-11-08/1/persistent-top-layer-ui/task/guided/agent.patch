+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+    const openBtn = document.getElementById('feedback-open');
+    const moveBtn = document.getElementById('feedback-move');
+    const sectionLabel = document.getElementById('feedback-section');
+    const sections = ['section-hero', 'section-favorites', 'section-footer']
+      .map((id) => document.getElementById(id));
+
+    openBtn.addEventListener('click', () => dialog.showModal());
+
+    moveBtn.addEventListener('click', () => {
+      const current = sections.indexOf(dialog.parentElement);
+      const target = sections[(current + 1) % sections.length];
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: the modal stays open, in the top layer, with focus intact
+        target.moveBefore(dialog, null);
+      } else {
+        // Fallback: a remove + insert closes the dialog, so reopen it and restore focus
+        const wasOpen = dialog.open;
+        target.insertBefore(dialog, null);
+        if (wasOpen && !dialog.open) dialog.showModal();
+        moveBtn.focus();
+      }
+
+      sectionLabel.textContent = target.dataset.sectionName;
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'submit') dialog.querySelector('form').reset();
+      dialog.returnValue = '';
+    });
+  </script>
+
