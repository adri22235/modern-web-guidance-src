+    /* Gallery scroll container */
+    .gallery {
+      margin-top: 60px;
+    }
+
+    .gallery h2 {
+      text-align: center;
+    }
+
+    .gallery-intro {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .scroll-container {
+      position: relative; /* makes card offsetTop relative to the container */
+      height: 520px;
+      max-width: 640px;
+      margin: 0 auto;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      padding: 16px;
+      background: var(--secondary);
+      border-radius: 8px;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    .media-card {
+      flex: 0 0 auto;
+      display: flex;
+      gap: 16px;
+      align-items: center;
+      background: white;
+      border-radius: 8px;
+      padding: 12px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      flex: 0 0 auto;
+      display: block;
+      width: 160px;
+      height: 120px;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: 6px;
+      background: var(--secondary);
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .media-card.target {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .media-card.target h3::after {
+      content: "Featured";
+      margin-left: 8px;
+      font-size: 0.7rem;
+      vertical-align: middle;
+      background: var(--accent);
+      color: var(--text);
+      padding: 2px 6px;
+      border-radius: 4px;
+    }
+
+    @media (max-width: 480px) {
+      .media-card img {
+        width: 100px;
+        height: 75px;
+      }
+    }
+
