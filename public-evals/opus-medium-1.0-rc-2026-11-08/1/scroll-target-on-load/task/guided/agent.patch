+  <script>
+    // Fallback for browsers without scroll-initial-target: position only the
+    // feed container (not the page) instantly, before images load.
+    if (!CSS.supports('scroll-initial-target', 'nearest')) {
+      const feed = document.querySelector('.feed');
+      const target = feed?.querySelector('.target');
+      if (target) {
+        const offset = target.getBoundingClientRect().top - feed.getBoundingClientRect().top;
+        feed.scrollTo({
+          top: feed.scrollTop + offset - (feed.clientHeight - target.offsetHeight) / 2,
+          behavior: 'instant'
+        });
+      }
+    }
+  </script>
