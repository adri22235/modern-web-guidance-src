+  <script type="module">
+    const TRUSTED_CMS_SLOT = 'cms';
+    const slots = [...document.querySelectorAll('#seasonal-favorites [data-trust]')];
+
+    // ---- Fallback sanitizer (only used when Element.setHTML is unavailable) ----
+    const ALLOWED_TAGS = new Set([
+      'A', 'B', 'BLOCKQUOTE', 'BR', 'CITE', 'DIV', 'EM', 'H3', 'H4', 'I',
+      'IMG', 'LI', 'OL', 'P', 'SMALL', 'SPAN', 'STRONG', 'UL',
+    ]);
+    const ALLOWED_ATTRS = new Set(['class', 'href', 'src', 'alt', 'width', 'height', 'loading', 'title']);
+    const SAFE_URL = /^(?:https?:|\/(?!\/)|#|\.{0,2}\/)/i;
+
+    function sanitizeTree(root) {
+      for (const el of [...root.querySelectorAll('*')]) {
+        if (!ALLOWED_TAGS.has(el.tagName)) {
+          // Drop dangerous elements entirely; unwrap the rest, keeping text.
+          if (/^(SCRIPT|STYLE|IFRAME|OBJECT|EMBED|TEMPLATE|NOSCRIPT|SVG|MATH|FORM|LINK|META|BASE)$/i.test(el.tagName)) {
+            el.remove();
+          } else {
+            el.replaceWith(...el.childNodes);
+          }
+          continue;
+        }
+        for (const { name, value } of [...el.attributes]) {
+          const n = name.toLowerCase();
+          if (!ALLOWED_ATTRS.has(n) || ((n === 'href' || n === 'src') && !SAFE_URL.test(value.trim()))) {
+            el.removeAttribute(name);
+          }
+        }
+      }
+      return root;
+    }
+
+    function parseInert(html) {
+      const t = document.createElement('template');
+      t.innerHTML = html; // template content is inert: no scripts run, no resources load
+      return t.content;
+    }
+
+    // Recreate <script> nodes so they execute (scripts inserted via parsing never run).
+    function activateScripts(root) {
+      for (const old of root.querySelectorAll('script')) {
+        const s = document.createElement('script');
+        for (const { name, value } of old.attributes) s.setAttribute(name, value);
+        s.textContent = old.textContent;
+        old.replaceWith(s);
+      }
+    }
+
+    // ---- Insertion, chosen per slot trust level ----
+    function setSlotHTML(slot, html) {
+      if (slot.dataset.trust === TRUSTED_CMS_SLOT) {
+        // Our own CMS: allow its widget script, but only inside this slot.
+        // Parse inertly, then explicitly re-create scripts so they run exactly once.
+        slot.replaceChildren(parseInert(html));
+        activateScripts(slot);
+      } else if ('setHTML' in Element.prototype) {
+        // Built-in Sanitizer API: safe by default, strips scripts & handlers.
+        slot.setHTML(html);
+      } else {
+        slot.replaceChildren(sanitizeTree(parseInert(html)));
+      }
+      slot.setAttribute('aria-busy', 'false');
+    }
+
+    // Stream a server response straight into a slot as it arrives.
+    async function streamIntoSlot(slot, response) {
+      const isCms = slot.dataset.trust === TRUSTED_CMS_SLOT;
+      const streamMethod = isCms ? 'streamHTMLUnsafe' : 'streamHTML';
+      if (response.body && streamMethod in Element.prototype) {
+        const sink = isCms ? slot.streamHTMLUnsafe({ runScripts: true }) : slot.streamHTML();
+        await response.body.pipeThrough(new TextDecoderStream()).pipeTo(sink);
+        slot.setAttribute('aria-busy', 'false');
+      } else {
+        setSlotHTML(slot, await response.text());
+      }
+    }
+
+    // ---- 1. Fallback for declarative <template for> patching ----
+    // Browsers with native support consume these templates during parsing,
+    // so any that are still in the DOM need to be applied manually.
+    for (const tpl of document.querySelectorAll('template[for]')) {
+      const slot = document.getElementById(tpl.getAttribute('for'));
+      if (slot?.dataset.trust) {
+        const html = tpl.innerHTML;
+        tpl.remove();
+        setSlotHTML(slot, html);
+      }
+    }
+    for (const slot of slots) {
+      if (!slot.querySelector('.skeleton')) slot.setAttribute('aria-busy', 'false');
+    }
+
+    // ---- 2. Live refresh whenever the menu changes ----
+    let inFlight;
+    async function refreshSeasonal() {
+      inFlight?.abort();
+      inFlight = new AbortController();
+      const { signal } = inFlight;
+      await Promise.allSettled(slots.map(async (slot) => {
+        slot.setAttribute('aria-busy', 'true');
+        try {
+          const res = await fetch(slot.dataset.src, {
+            signal,
+            headers: { Accept: 'text/html' },
+            credentials: 'same-origin',
+            cache: 'no-store',
+          });
