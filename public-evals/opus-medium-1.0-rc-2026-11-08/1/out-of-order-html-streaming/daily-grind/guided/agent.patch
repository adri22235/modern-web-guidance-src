+  <script type="module">
+    // Load polyfills only where the native features are missing.
+    // Without processing-instruction support, <?marker> parses as a comment node instead.
+    const fragment = document.createRange().createContextualFragment('<?marker name="probe">');
+    const supportsTemplateFor = fragment.firstChild?.nodeType === Node.PROCESSING_INSTRUCTION_NODE;
+    const supportsStreamingSetters = 'streamHTML' in Element.prototype &&
+      'streamHTMLUnsafe' in Element.prototype;
+
+    await Promise.all([
+      supportsTemplateFor || import('https://esm.sh/template-for-polyfill'),
+      supportsStreamingSetters || import('https://esm.sh/html-setters-polyfill'),
+    ]);
+
+    // Module scripts are deferred, so the document is fully parsed at this point.
+    const cards = document.getElementById('seasonal-cards');
+    const reviews = document.getElementById('seasonal-reviews');
+    const promo = document.getElementById('seasonal-promo');
+
+    // Restrict customer reviews to simple formatting on top of the default (XSS-safe) sanitizer.
+    const reviewSanitizer = {
+      elements: ['article', 'blockquote', 'p', 'footer', 'cite', 'strong', 'em', 'b', 'i', 'br'],
+      attributes: ['class'],
+    };
+
+    const inFlight = new WeakMap();
+
+    // Fetch an HTML partial and stream it straight into `el` using the given setter.
+    async function streamInto(el, url, setter, options = {}) {
+      inFlight.get(el)?.abort();
+      const controller = new AbortController();
+      inFlight.set(el, controller);
+      el.setAttribute('aria-busy', 'true');
+      try {
+        const response = await fetch(url, {
+          headers: { Accept: 'text/html' },
+          signal: controller.signal,
+        });
+        if (!response.ok) throw new Error(`${url} responded ${response.status}`);
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(el[setter](options), { signal: controller.signal });
+      } catch (error) {
+        if (error.name !== 'AbortError') console.error(error);
+      } finally {
+        if (inFlight.get(el) === controller) {
+          inFlight.delete(el);
+          el.removeAttribute('aria-busy');
+        }
+      }
+    }
+
+    // Server-rendered cards are first-party but never need scripts, so keep them sanitized.
+    const refreshCards = () => streamInto(cards, '/partials/seasonal-cards', 'streamHTML');
+    const refreshReviews = () => streamInto(reviews, '/partials/seasonal-reviews', 'streamHTML',
+      { sanitizer: reviewSanitizer });
+    // Trusted CMS content only: allow its embedded widget script to execute.
+    const loadPromo = () => streamInto(promo, '/cms/promos/seasonal', 'streamHTMLUnsafe',
+      { runScripts: true });
+
+    refreshReviews();
+    loadPromo();
+
+    // Re-render the cards (and their reviews) whenever the server reports a menu change.
+    const menuEvents = new EventSource('/api/menu/events');
+    menuEvents.addEventListener('menu-changed', () => {
+      refreshCards();
+      refreshReviews();
+    });
+  </script>
 </head>
 
