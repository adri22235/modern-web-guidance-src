+  <script>
+    // Demo: order starts indeterminate (awaiting confirmation), then reports real progress.
+    (() => {
+      const bar = document.getElementById('order-progress');
+      const percent = document.getElementById('order-percent');
+      const status = document.getElementById('order-status');
+      const steps = [
+        [25, 'Order confirmed. Grinding your beans\u2026'],
+        [60, 'Pulling your espresso shot\u2026'],
+        [85, 'Steaming oat milk and adding maple\u2026'],
+        [100, 'Your order is ready for pickup!'],
+      ];
+
+      steps.forEach(([value, message], i) => {
+        setTimeout(() => {
+          bar.value = value;
+          percent.textContent = `${value}%`;
+          status.textContent = message;
+        }, 3000 + i * 2500);
+      });
+    })();
+  </script>
