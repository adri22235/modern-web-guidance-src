+  <script type="module">
+    // Pickup time and anniversary are wall-clock/calendar values, not instants.
+    // They are stored as plain ISO strings ("08:30", "2021-04-15") and handled
+    // with Temporal Plain types so they never shift when the time zone changes.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrindPrefs';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const pickupHint = document.getElementById('pickup-hint');
+    const anniversaryHint = document.getElementById('anniversary-hint');
+    const status = document.getElementById('prefs-status');
+
+    function loadPrefs() {
+      try {
+        return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? {};
+      } catch {
+        return {};
+      }
+    }
+
+    function describePickup(pickupTime) {
+      if (!pickupTime) {
+        pickupHint.textContent = 'Stays at the same clock time wherever you travel.';
+        return;
+      }
+      const time = Temporal.PlainTime.from(pickupTime);
+      const label = time.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      pickupHint.textContent = `We'll remind you every day at ${label} local time, wherever you are.`;
+    }
+
+    function describeAnniversary(anniversaryDate) {
+      if (!anniversaryDate) {
+        anniversaryHint.textContent = 'The day you joined The Daily Grind.';
+        return;
+      }
+      const date = Temporal.PlainDate.from(anniversaryDate);
+      const label = date.toLocaleString(undefined, { dateStyle: 'long' });
+      const today = Temporal.Now.plainDateISO();
+
+      // Recurring annual date: convert PlainMonthDay to a PlainDate for a given
+      // year (constrains Feb 29 to Feb 28 in non-leap years).
+      const monthDay = date.toPlainMonthDay();
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      const daysUntil = today.until(next, { largestUnit: 'days' }).days;
+      const years = next.year - date.year;
+
+      if (Temporal.PlainDate.compare(date, today) > 0) {
+        anniversaryHint.textContent = `Starting ${label}.`;
+      } else if (daysUntil === 0) {
+        anniversaryHint.textContent = `Happy ${years}-year coffee anniversary! (since ${label})`;
+      } else {
+        anniversaryHint.textContent = `Since ${label}. Next anniversary in ${daysUntil} day${daysUntil === 1 ? '' : 's'}.`;
+      }
+    }
+
+    const prefs = loadPrefs();
+    timeInput.value = prefs.pickupTime ?? '';
+    dateInput.value = prefs.anniversaryDate ?? '';
+    describePickup(prefs.pickupTime);
+    describeAnniversary(prefs.anniversaryDate);
+
+    timeInput.addEventListener('change', () => describePickup(timeInput.value));
+    dateInput.addEventListener('change', () => describeAnniversary(dateInput.value));
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Normalize through Temporal and persist the zone-free ISO strings as-is.
+      const next = {
+        pickupTime: timeInput.value
+          ? Temporal.PlainTime.from(timeInput.value).toString({ smallestUnit: 'minute' })
+          : null,
+        anniversaryDate: dateInput.value
+          ? Temporal.PlainDate.from(dateInput.value).toString()
+          : null,
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+      status.textContent = 'Preferences saved.';
+    });
+  </script>
+
