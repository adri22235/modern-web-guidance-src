+  <script>
+    // Both values are stored as "floating" wall-clock strings ("HH:MM" and "YYYY-MM-DD"),
+    // never as timestamps. They're never converted through a Date in the local time zone,
+    // so changing time zones (travel, DST, device settings) can't shift them.
+    (function () {
+      var TIME_KEY = 'dailyGrind.pickupTime';
+      var DATE_KEY = 'dailyGrind.coffeeAnniversary';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('coffee-anniversary');
+      var timeDisplay = document.getElementById('pickup-time-display');
+      var dateDisplay = document.getElementById('coffee-anniversary-display');
+
+      function load(key) {
+        try { return localStorage.getItem(key); } catch (e) { return null; }
+      }
+
+      function save(key, value) {
+        try {
+          if (value) localStorage.setItem(key, value);
+          else localStorage.removeItem(key);
+        } catch (e) { /* storage unavailable; keep the in-page value */ }
+      }
+
+      // Validates "YYYY-MM-DD" as a real calendar date without involving time zones.
+      function parseDate(value) {
+        var m = DATE_RE.exec(value || '');
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        var daysInMonth = new Date(Date.UTC(y, mo, 0)).getUTCDate();
+        if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth) return null;
+        return { year: y, month: mo, day: d };
+      }
+
+      function formatTime(value) {
+        var m = TIME_RE.exec(value || '');
+        if (!m) return '';
+        var h = +m[1];
+        var suffix = h < 12 ? 'AM' : 'PM';
+        var h12 = h % 12 === 0 ? 12 : h % 12;
+        return h12 + ':' + m[2] + ' ' + suffix;
+      }
+
+      function formatDate(value) {
+        var p = parseDate(value);
+        return p ? MONTHS[p.month - 1] + ' ' + p.day + ', ' + p.year : '';
+      }
+
+      // Days until the next anniversary, counted in calendar days relative to today's
+      // date wherever the user currently is. Feb 29 anniversaries fall on Feb 28 in
+      // non-leap years.
+      function daysUntilAnniversary(p) {
+        var now = new Date();
+        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
+        function occurrence(year) {
+          var last = new Date(Date.UTC(year, p.month, 0)).getUTCDate();
+          return Date.UTC(year, p.month - 1, Math.min(p.day, last));
+        }
+        var next = occurrence(now.getFullYear());
+        if (next < today) next = occurrence(now.getFullYear() + 1);
+        return Math.round((next - today) / 86400000);
+      }
+
+      function renderTime() {
+        var value = timeInput.value;
+        timeDisplay.textContent = TIME_RE.test(value)
+          ? 'Reminder set for ' + formatTime(value) + ' every day, local time wherever you are.'
+          : '';
+      }
+
+      function renderDate() {
+        var p = parseDate(dateInput.value);
+        if (!p) { dateDisplay.textContent = ''; return; }
+        var days = daysUntilAnniversary(p);
+        var when = days === 0 ? 'Happy coffee anniversary! ☕'
+          : days === 1 ? 'Your anniversary is tomorrow!'
+          : days + ' days until your next anniversary.';
+        dateDisplay.textContent = formatDate(dateInput.value) + ' · ' + when;
+      }
+
+      var savedTime = load(TIME_KEY);
+      if (TIME_RE.test(savedTime || '')) timeInput.value = savedTime;
+      var savedDate = load(DATE_KEY);
+      if (parseDate(savedDate)) dateInput.value = savedDate;
+
+      timeInput.addEventListener('change', function () {
+        var value = TIME_RE.test(timeInput.value) ? timeInput.value : '';
+        save(TIME_KEY, value);
+        renderTime();
+      });
+
+      dateInput.addEventListener('change', function () {
+        var value = parseDate(dateInput.value) ? dateInput.value : '';
+        save(DATE_KEY, value);
+        renderDate();
+      });
+
+      renderTime();
+      renderDate();
+    })();
+  </script>
+
 </body>
 
