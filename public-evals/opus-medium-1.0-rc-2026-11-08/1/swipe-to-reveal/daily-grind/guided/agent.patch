+  <script>
+    // Tabbing back into a card's content snaps the action strip closed.
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+
+    // Favorite is a toggle; it only runs when tapped, never on swipe.
+    for (const button of document.querySelectorAll('.action-favorite')) {
+      button.addEventListener('click', () => {
+        const pressed = button.getAttribute('aria-pressed') === 'true';
+        button.setAttribute('aria-pressed', String(!pressed));
+      });
+    }
+  </script>
