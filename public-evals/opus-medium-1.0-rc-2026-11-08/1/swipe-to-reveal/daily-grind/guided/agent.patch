+    /* Swipe-to-reveal drink cards */
+    .card.SwipeReveal {
+      padding: 0;
+    }
+
+    .SwipeReveal {
+      /* Column 1: full-width card content. Column 2: auto-sized action strip. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      /* Chain excess scroll to the page without the action strip bouncing. */
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel > * {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      inline-size: 76px;
+      border: 0;
+      color: white;
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel > :focus-visible {
+      outline: 3px solid white;
+      outline-offset: -5px;
+    }
+
+    .SwipeReveal-panel .icon {
+      font-size: 1.3rem;
+      line-height: 1;
+    }
+
+    .action-favorite {
+      background: #8d6e63;
+    }
+
+    .action-favorite[aria-pressed="true"] .icon {
+      color: var(--accent);
+    }
+
+    .action-customize {
+      background: #6d4c41;
+    }
+
+    .action-order {
+      background: var(--primary);
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
