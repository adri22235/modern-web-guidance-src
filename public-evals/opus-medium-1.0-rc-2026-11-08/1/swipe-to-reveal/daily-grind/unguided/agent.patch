+  <script>
+    (function () {
+      const ACTION_WIDTH = 84;
+      const DRAG_THRESHOLD = 10; // px moved before a gesture counts as a swipe
+      const OPEN_RATIO = 0.4; // fraction of tray width needed to snap open
+      const cards = Array.from(document.querySelectorAll('.swipe-card'));
+      const status = document.querySelector('.swipe-status');
+      let openCard = null;
+
+      function trayWidth(card, side) {
+        return card.querySelectorAll('.swipe-actions-' + side + ' .swipe-action').length * ACTION_WIDTH;
+      }
+
+      function setOffset(card, x) {
+        card.querySelector('.swipe-content').style.transform = x ? 'translateX(' + x + 'px)' : '';
+      }
+
+      // Snap a card to a resting state: 'left' tray, 'right' tray, or closed (null).
+      // Revealing a tray never triggers an action; the user must tap a button.
+      function snap(card, side) {
+        const left = card.querySelector('.swipe-actions-left');
+        const right = card.querySelector('.swipe-actions-right');
+        left.inert = side !== 'left';
+        right.inert = side !== 'right';
+        card.dataset.open = side || '';
+        card.querySelector('.swipe-toggle').setAttribute('aria-expanded', side ? 'true' : 'false');
+        setOffset(card, side === 'left' ? trayWidth(card, 'left') : side === 'right' ? -trayWidth(card, 'right') : 0);
+
+        if (side) {
+          if (openCard && openCard !== card) snap(openCard, null);
+          openCard = card;
+        } else if (openCard === card) {
+          openCard = null;
+        }
+      }
+
+      function restingOffset(card) {
+        if (card.dataset.open === 'left') return trayWidth(card, 'left');
+        if (card.dataset.open === 'right') return -trayWidth(card, 'right');
+        return 0;
+      }
+
+      // Past the tray edge, movement is damped so an over-swipe can't feel like it "commits" an action.
+      function clamp(x, min, max) {
+        if (x > max) return max + (x - max) * 0.2;
+        if (x < min) return min + (x - min) * 0.2;
+        return x;
+      }
+
+      cards.forEach(function (card) {
+        const content = card.querySelector('.swipe-content');
+        let startX = 0, startY = 0, baseX = 0, currentX = 0;
+        let pointerId = null, swiping = false, suppressClick = false;
+
+        content.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          suppressClick = false;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseX = currentX = restingOffset(card);
+          swiping = false;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          const dx = e.clientX - startX;
+          const dy = e.clientY - startY;
+
+          if (!swiping) {
+            if (Math.abs(dx) < DRAG_THRESHOLD && Math.abs(dy) < DRAG_THRESHOLD) return;
+            if (Math.abs(dy) > Math.abs(dx)) { pointerId = null; return; } // vertical scroll
+            swiping = true;
+            card.classList.add('dragging');
+            content.setPointerCapture(e.pointerId);
+          }
+
+          currentX = clamp(baseX + dx, -trayWidth(card, 'right'), trayWidth(card, 'left'));
+          setOffset(card, currentX);
+        });
+
+        function endGesture(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (!swiping) return;
+          swiping = false;
+          suppressClick = true;
+          card.classList.remove('dragging');
+
+          const leftW = trayWidth(card, 'left');
+          const rightW = trayWidth(card, 'right');
+          const open = card.dataset.open;
+          if (open === 'left') snap(card, currentX > leftW * (1 - OPEN_RATIO) ? 'left' : null);
+          else if (open === 'right') snap(card, currentX < -rightW * (1 - OPEN_RATIO) ? 'right' : null);
+          else if (currentX > leftW * OPEN_RATIO) snap(card, 'left');
+          else if (currentX < -rightW * OPEN_RATIO) snap(card, 'right');
+          else snap(card, null);
+        }
+
+        content.addEventListener('pointerup', endGesture);
+        content.addEventListener('pointercancel', endGesture);
+
+        // Swallow the click that follows a drag so "View Details" doesn't navigate mid-swipe,
+        // and treat a tap on an open card as "close".
+        content.addEventListener('click', function (e) {
+          if (suppressClick) {
+            suppressClick = false;
+            e.preventDefault();
+            e.stopPropagation();
+            return;
+          }
+          if (card.dataset.open && !e.target.closest('.swipe-toggle')) {
+            e.preventDefault();
+            snap(card, null);
+          }
+        }, true);
+
+        // Keyboard / mouse alternative to swiping.
+        card.querySelector('.swipe-toggle').addEventListener('click', function () {
+          if (card.dataset.open) {
+            snap(card, null);
+          } else {
+            snap(card, 'right');
+            card.querySelector('.swipe-actions-right .swipe-action').focus();
+          }
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.dataset.open) {
+            snap(card, null);
+            card.querySelector('.swipe-toggle').focus();
+          }
+        });
+
+        card.querySelector('[data-action="favorite"]').addEventListener('click', function () {
+          const pressed = this.getAttribute('aria-pressed') !== 'true';
+          this.setAttribute('aria-pressed', String(pressed));
+          this.querySelector('span').innerHTML = pressed ? '&#9829;' : '&#9825;';
+          status.textContent = card.dataset.name + (pressed ? ' added to' : ' removed from') + ' favorites.';
+        });
+
+        card.querySelector('[data-action="share"]').addEventListener('click', function () {
+          const url = new URL(card.querySelector('.btn').getAttribute('href'), location.href).href;
+          const title = card.dataset.name + ' at The Daily Grind';
+          if (navigator.share) {
+            navigator.share({ title: title, url: url }).catch(function () {});
+          } else if (navigator.clipboard) {
+            navigator.clipboard.writeText(url).then(function () {
+              status.textContent = 'Link to ' + card.dataset.name + ' copied.';
+            });
+          }
+        });
+      });
+
+      // Tapping anywhere outside the open card closes it.
+      document.addEventListener('pointerdown', function (e) {
+        if (openCard && !openCard.contains(e.target)) snap(openCard, null);
+      });
+    })();
+  </script>
+
