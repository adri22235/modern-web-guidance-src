+
+    .swipe-action {
+      width: 84px;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      border: none;
+      color: white;
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .swipe-action span[aria-hidden] {
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .swipe-action:focus-visible {
+      outline: 3px solid white;
+      outline-offset: -6px;
+    }
+
+    .swipe-action-favorite {
+      background: #c2185b;
+    }
+
+    .swipe-action-favorite[aria-pressed="true"] {
+      background: #880e4f;
+    }
+
+    .swipe-action-order {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .swipe-action-share {
+      background: #6d4c41;
+    }
+
+    .swipe-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      transition: transform 0.25s ease;
+      user-select: none;
+      -webkit-user-select: none;
+    }
+
+    .swipe-card.dragging .swipe-content {
+      transition: none;
+    }
+
+    .swipe-toggle {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      width: 32px;
+      height: 32px;
+      border: none;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.3rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .swipe-toggle:hover,
+    .swipe-toggle:focus-visible {
+      background: var(--secondary);
+    }
+
+    .swipe-hint {
+      text-align: center;
+      font-size: 0.85rem;
+      color: #8d6e63;
+      margin-top: 5px;
+    }
+
+    .swipe-status {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      white-space: nowrap;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .swipe-content {
+        transition: none;
+      }
+    }
