+  <script>
+    (function () {
+      var KEY = 'vt-direction';
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Keep pagination hrefs in sync with the current ?page= value.
+      var page = parseInt(new URLSearchParams(location.search).get('page'), 10);
+      if (!(page >= 1)) page = 1;
+      var prev = document.getElementById('previous');
+      var next = document.getElementById('next');
+      prev.href = '/?page=' + Math.max(1, page - 1);
+      next.href = '/?page=' + (page + 1);
+      document.getElementById('current-page').textContent = page;
+      if (page === 1) prev.setAttribute('aria-disabled', 'true');
+
+      // Remember which way the user is paging so both documents agree.
+      [prev, next].forEach(function (link) {
+        link.addEventListener('click', function () {
+          try { sessionStorage.setItem(KEY, link.dataset.direction); } catch (e) {}
+        });
+      });
+
+      function directionFor(fromUrl, toUrl, navType) {
+        try {
+          var stored = sessionStorage.getItem(KEY);
+          if (stored && navType !== 'traverse') return stored;
+          var from = parseInt(new URL(fromUrl).searchParams.get('page'), 10) || 1;
+          var to = parseInt(new URL(toUrl).searchParams.get('page'), 10) || 1;
+          if (to > from) return 'forwards';
+          if (to < from) return 'backwards';
+        } catch (e) {}
+        return null;
+      }
+
+      // Outgoing page: tag the transition with its direction.
+      window.addEventListener('pageswap', function (e) {
+        if (!e.viewTransition) return;
+        if (reduceMotion.matches) { e.viewTransition.skipTransition(); return; }
+        var act = e.activation;
+        if (!act || !act.entry) return;
+        var dir = directionFor(location.href, act.entry.url, act.navigationType);
+        if (dir) e.viewTransition.types.add(dir);
+      });
+
+      // Incoming page: apply the same direction, then clear the hint.
+      window.addEventListener('pagereveal', function (e) {
+        if (!e.viewTransition) return;
+        if (reduceMotion.matches) { e.viewTransition.skipTransition(); return; }
+        var act = window.navigation && navigation.activation;
+        if (act && act.from) {
+          var dir = directionFor(act.from.url, location.href, act.navigationType);
+          if (dir) e.viewTransition.types.add(dir);
+        }
+        try { sessionStorage.removeItem(KEY); } catch (e2) {}
+      });
+    })();
+  </script>
+
