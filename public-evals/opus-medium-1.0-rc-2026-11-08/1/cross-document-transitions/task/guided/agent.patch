   </style>
+  <script>
+    // Directional cross-document transitions for the pagination links.
+    (() => {
+      const KEY = 'vt-direction';
+      const directionFor = (url) => {
+        for (const id of ['previous', 'next']) {
+          const link = document.getElementById(id);
+          if (link && link.href === url) return id;
+        }
+        return null;
+      };
+
+      // Outgoing page: tag the transition and remember the direction for the new page.
+      window.addEventListener('pageswap', (e) => {
+        if (!e.viewTransition) return;
+        const url = e.activation?.entry?.url;
+        const direction = url && directionFor(url);
+        if (direction) {
+          e.viewTransition.types.add(direction);
+          sessionStorage.setItem(KEY, direction);
+        } else {
+          sessionStorage.removeItem(KEY);
+        }
+      });
+
+      // Incoming page: apply the same direction (history traversals use entry order).
+      window.addEventListener('pagereveal', (e) => {
+        let direction = sessionStorage.getItem(KEY);
+        sessionStorage.removeItem(KEY);
+        if (!e.viewTransition) return;
+        const activation = window.navigation?.activation;
+        if (activation?.navigationType === 'traverse' && activation.from) {
+          direction = activation.entry.index < activation.from.index ? 'previous' : 'next';
+        }
+        if (direction) e.viewTransition.types.add(direction);
+      });
+    })();
+  </script>
 </head>
 
