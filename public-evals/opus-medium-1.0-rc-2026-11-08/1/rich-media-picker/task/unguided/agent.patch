+      text-transform: uppercase;
+      margin-bottom: 0.5rem;
+    }
+
+    .roast-select {
+      width: 100%;
+      padding: 10px 12px;
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-form .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    /* Rich option content (customizable select, progressive enhancement) */
+    .roast-option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      text-align: left;
+    }
+
+    .roast-icon {
+      display: none;
+      flex-shrink: 0;
+      width: 28px;
+      height: 28px;
+      color: var(--primary);
+    }
+
+    .roast-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-title {
+      font-weight: 600;
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    @supports (appearance: base-select) {
+
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        background: white;
+        border: none;
+        border-radius: 8px;
+        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
+      }
+
+      .roast-select option {
+        padding: 10px 12px;
+        border-radius: 6px;
+        color: var(--text);
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        background: #efebe9;
+      }
+
+      .roast-select option::checkmark {
+        order: 1;
+        margin-left: auto;
+        color: var(--primary);
+      }
+
+      .roast-icon {
+        display: block;
+      }
+
+      .roast-sep {
+        display: none;
+      }
+
+      /* Keep the closed state compact: icon + title only */
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      .roast-select selectedcontent .roast-icon {
+        width: 22px;
+        height: 22px;
+      }
+    }
+
