+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const success = document.getElementById('newsletter-success');
+
+      const syncAria = () => {
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+
+      input.addEventListener('blur', syncAria);
+      input.addEventListener('invalid', syncAria);
+      input.addEventListener('input', () => {
+        if (input.hasAttribute('aria-invalid')) syncAria();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        form.hidden = true;
+        success.hidden = false;
+      });
+    })();
+  </script>
+
 </body>
 
