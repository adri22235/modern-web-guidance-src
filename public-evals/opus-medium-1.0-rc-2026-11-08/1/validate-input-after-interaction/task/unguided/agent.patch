+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var message = document.getElementById('newsletter-message');
+
+      function errorFor(value) {
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(text) {
+        input.classList.add('is-invalid');
+        input.setAttribute('aria-invalid', 'true');
+        message.className = 'newsletter-message error';
+        message.textContent = text;
+      }
+
+      function clearError() {
+        input.classList.remove('is-invalid');
+        input.removeAttribute('aria-invalid');
+        message.className = 'newsletter-message';
+        message.textContent = '';
+      }
+
+      function validate() {
+        var error = errorFor(input.value.trim());
+        if (error) showError(error); else clearError();
+        return !error;
+      }
+
+      // Only validate once the user leaves the field. An empty, untouched
+      // field is left alone so tabbing through the footer doesn't flag it.
+      input.addEventListener('blur', function () {
+        if (input.value.trim()) validate();
+        else clearError();
+      });
+
+      // While typing, never add an error -- only clear one as soon as the
+      // value becomes valid, so fixing a mistake gets immediate feedback.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('is-invalid') && !errorFor(input.value.trim())) {
+          clearError();
+        } else if (message.classList.contains('success')) {
+          clearError();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        message.className = 'newsletter-message success';
+        message.textContent = 'Thanks for signing up! Check your inbox to confirm.';
+        form.reset();
+      });
+    })();
+  </script>
+
 </body>
 
