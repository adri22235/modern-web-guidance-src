+  <script>
+    (function () {
+      const list = document.querySelector('nav ul');
+      const links = Array.from(list.querySelectorAll('.nav-link'));
+      const indicator = list.querySelector('.nav-indicator');
+      let active = null;
+
+      function moveIndicator() {
+        if (!active) {
+          indicator.style.opacity = '0';
+          return;
+        }
+        const listRect = list.getBoundingClientRect();
+        const linkRect = active.getBoundingClientRect();
+        indicator.style.width = linkRect.width + 'px';
+        indicator.style.transform = 'translateX(' + (linkRect.left - listRect.left) + 'px)';
+        indicator.style.opacity = '1';
+      }
+
+      function setActive(link) {
+        if (active) {
+          active.classList.remove('active');
+          active.removeAttribute('aria-current');
+        }
+        active = link;
+        if (active) {
+          active.classList.add('active');
+          active.setAttribute('aria-current', 'page');
+        }
+        moveIndicator();
+      }
+
+      function linkForPath(path) {
+        return links.find(l => path === l.getAttribute('href') ||
+          path.startsWith(l.getAttribute('href') + '/')) || links[0];
+      }
+
+      // Initial position without animating from the left edge
+      setActive(linkForPath(location.pathname));
+      requestAnimationFrame(() => {
+        requestAnimationFrame(() => indicator.classList.remove('no-transition'));
+      });
+
+      links.forEach(link => {
+        link.addEventListener('click', e => {
+          // Let modified clicks (new tab, etc.) behave normally
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          e.preventDefault();
+          if (link === active) return;
+          history.pushState(null, '', link.getAttribute('href'));
+          setActive(link);
+        });
+      });
+
+      window.addEventListener('popstate', () => setActive(linkForPath(location.pathname)));
+
+      // Keep the indicator aligned when layout changes (resize, font load)
+      let resizeFrame;
+      function realign() {
+        indicator.classList.add('no-transition');
+        moveIndicator();
+        cancelAnimationFrame(resizeFrame);
+        resizeFrame = requestAnimationFrame(() => indicator.classList.remove('no-transition'));
+      }
+      window.addEventListener('resize', realign);
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(realign);
+    })();
+  </script>
+
