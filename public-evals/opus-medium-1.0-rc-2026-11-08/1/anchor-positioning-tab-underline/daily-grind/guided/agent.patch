+  <script>
+    (() => {
+      const list = document.querySelector('.nav-links');
+      const items = [...list.querySelectorAll('li[data-nav]')];
+      const supportsAnchor = CSS.supports('position-anchor: auto');
+
+      // Without anchor positioning, feed the indicator's position via custom properties
+      function placeIndicator() {
+        if (supportsAnchor) return;
+        const active = list.querySelector('li.active');
+        if (!active) return;
+        list.style.setProperty('--indicator-top', `${active.offsetTop + active.offsetHeight + 2}px`);
+        list.style.setProperty('--indicator-left', `${active.offsetLeft}px`);
+        list.style.setProperty('--indicator-width', `${active.offsetWidth}px`);
+      }
+
+      function setActive(item) {
+        const hadActive = items.some((li) => li.classList.contains('active'));
+        if (!hadActive) list.classList.add('no-indicator-transition');
+
+        for (const li of items) {
+          const isActive = li === item;
+          li.classList.toggle('active', isActive);
+          const link = li.querySelector('a');
+          if (isActive) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        }
+        placeIndicator();
+
+        if (!hadActive) {
+          list.offsetWidth; // Commit the initial position before re-enabling transitions
+          list.classList.remove('no-indicator-transition');
+        }
+      }
+
+      function itemForPath(path) {
+        return items.find((li) => new URL(li.querySelector('a').href).pathname === path);
+      }
+
+      list.addEventListener('click', (event) => {
+        const item = event.target.closest('li[data-nav]');
+        if (!item || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const { pathname } = new URL(item.querySelector('a').href);
+        if (location.pathname !== pathname) history.pushState(null, '', pathname);
+        setActive(item);
+      });
+
+      window.addEventListener('popstate', () => setActive(itemForPath(location.pathname)));
+      new ResizeObserver(placeIndicator).observe(list);
+
+      const initial = itemForPath(location.pathname);
+      if (initial) setActive(initial);
+    })();
+  </script>
+
