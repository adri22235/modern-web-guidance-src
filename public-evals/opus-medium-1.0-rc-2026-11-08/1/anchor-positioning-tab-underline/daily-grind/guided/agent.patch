+    /* Active nav indicator: a single underline that slides between items */
+    .nav-links {
+      position: relative;
+    }
+
+    .nav-links li.active {
+      anchor-name: --active-nav;
+    }
+
+    .nav-links::before {
+      content: '';
+      position: absolute;
+      pointer-events: none;
+      /* Script fallback for browsers without anchor positioning */
+      inset-block-start: var(--indicator-top, 100%);
+      inset-inline-start: var(--indicator-left, 0);
+      inline-size: var(--indicator-width, 0);
+      /* Border (not background) so it survives forced colors mode */
+      border-block-end: 2px solid var(--accent);
+      opacity: 0;
+    }
+
+    .nav-links:has(li.active)::before {
+      opacity: 1;
+    }
+
+    @supports (position-anchor: auto) {
+      .nav-links::before {
+        position-anchor: --active-nav;
+        inset-block-start: calc(anchor(bottom) + 2px);
+        inset-inline-start: anchor(left);
+        inset-inline-end: anchor(right);
+        inline-size: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .nav-links::before {
+        transition: inset 0.35s ease, inline-size 0.35s ease, opacity 0.2s;
+      }
+    }
+
+    .nav-links.no-indicator-transition::before {
+      transition: none;
+    }
