+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+interface Story {
+  id: string;
+  title: string;
+  date: string;
+}
+
+interface Props {
+  stories: Story[];
+}
+
+type Direction = 'next' | 'prev';
+
+interface SlideState {
+  index: number;
+  // Story that is animating out, if any
+  previous: number | null;
+  direction: Direction;
+  // Bumped on every change so the animation restarts even on rapid clicks
+  step: number;
+}
+
+export default function TopStoriesCarousel({ stories }: Props) {
+  const [state, setState] = useState<SlideState>({ index: 0, previous: null, direction: 'next', step: 0 });
+  const count = stories.length;
+
+  if (count === 0) return null;
+
+  const go = (direction: Direction) => {
+    setState((s) => ({
+      index: (s.index + (direction === 'next' ? 1 : -1) + count) % count,
+      previous: s.index,
+      direction,
+      step: s.step + 1,
+    }));
+  };
+
+  const renderStory = (story: Story) => (
+    <>
+      <a href={`${import.meta.env.BASE_URL}articles/${story.id}`}>
+        <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+      </a>
+      <span className="text-xs text-gray-500">{story.date}</span>
+    </>
+  );
+
+  const current = stories[state.index];
+  const animated = state.step > 0;
+
+  return (
+    <div className="flex items-center gap-4" role="region" aria-roledescription="carousel" aria-label="Top Stories">
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        disabled={count < 2}
+        aria-label="Previous story"
+        className="shrink-0 p-1 rounded-full border border-gray-300 text-gray-600 hover:text-amber-400 hover:border-amber-400 disabled:opacity-40 disabled:pointer-events-none"
+      >
+        <ChevronLeftIcon className="h-5 w-5" />
+      </button>
+
+      <div className="relative flex-1 overflow-hidden" aria-live="polite">
+        {animated && state.previous !== null && (
+          <div
+            key={`out-${state.step}`}
+            aria-hidden="true"
+            className={`absolute inset-0 pointer-events-none ${state.direction === 'next' ? 'carousel-out-left' : 'carousel-out-right'}`}
+            onAnimationEnd={() => setState((s) => (s.previous !== null ? { ...s, previous: null } : s))}
+          >
+            {renderStory(stories[state.previous])}
+          </div>
+        )}
+        <div
+          key={`in-${state.step}`}
+          aria-roledescription="slide"
+          aria-label={`${state.index + 1} of ${count}`}
+          className={animated ? (state.direction === 'next' ? 'carousel-in-right' : 'carousel-in-left') : undefined}
+        >
+          {renderStory(current)}
+        </div>
+      </div>
+
+      <span className="shrink-0 text-xs text-gray-500 tabular-nums">
+        {state.index + 1} / {count}
+      </span>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        disabled={count < 2}
+        aria-label="Next story"
+        className="shrink-0 p-1 rounded-full border border-gray-300 text-gray-600 hover:text-amber-400 hover:border-amber-400 disabled:opacity-40 disabled:pointer-events-none"
+      >
+        <ChevronRightIcon className="h-5 w-5" />
+      </button>
+    </div>
+  );
+}
