diff --git a/src/components/TopStoriesCarousel.astro b/src/components/TopStoriesCarousel.astro
new file mode 100644
index 0000000..98883cc
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,165 @@
+---
+import type { CollectionEntry } from 'astro:content';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+<section
+    class="top-stories bg-white border-b border-gray-300"
+    aria-roledescription="carousel"
+    aria-label="Top stories"
+    data-top-stories
+>
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-4">
+        <h2 class="hidden sm:block shrink-0 text-xs font-semibold tracking-wider text-gray-500 uppercase">Top Stories</h2>
+
+        <div class="top-stories-viewport flex-1 min-w-0 overflow-clip" data-viewport>
+            <div class="top-stories-track" id="top-stories-track" aria-live="polite" data-track>
+                {articles.map((article, index) => (
+                    <div
+                        role="group"
+                        aria-roledescription="slide"
+                        aria-label={`${index + 1} of ${articles.length}`}
+                        hidden={index !== 0}
+                        data-slide
+                    >
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400 truncate">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </div>
+                ))}
+            </div>
+        </div>
+
+        <div class="shrink-0 flex items-center gap-2">
+            <span class="text-xs text-gray-500 tabular-nums" aria-hidden="true" data-counter>1 / {articles.length}</span>
+            <button
+                type="button"
+                class="p-1.5 rounded-full border border-gray-300 text-gray-700 hover:text-amber-400 hover:border-amber-400 focus-visible:outline-2 focus-visible:outline-amber-400"
+                aria-controls="top-stories-track"
+                aria-label="Previous story"
+                data-prev
+            >
+                <ChevronLeftIcon className="w-4 h-4" />
+            </button>
+            <button
+                type="button"
+                class="p-1.5 rounded-full border border-gray-300 text-gray-700 hover:text-amber-400 hover:border-amber-400 focus-visible:outline-2 focus-visible:outline-amber-400"
+                aria-controls="top-stories-track"
+                aria-label="Next story"
+                data-next
+            >
+                <ChevronRightIcon className="w-4 h-4" />
+            </button>
+        </div>
+    </div>
+</section>
+
+<style is:global>
+    @keyframes top-stories-slide-to-left {
+        to { transform: translateX(-100%); }
+    }
+    @keyframes top-stories-slide-from-right {
+        from { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-to-right {
+        to { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-from-left {
+        from { transform: translateX(-100%); }
+    }
+
+    /* Only name the track while a carousel transition runs, so page-level
+       (ClientRouter) transitions don't capture it. */
+    :active-view-transition-type(top-stories-next, top-stories-prev) .top-stories-track {
+        view-transition-name: top-story;
+    }
+
+    /* Keep the sliding snapshots inside the carousel bounds (needed for the
+       document-scoped fallback; scoped transitions clip via the viewport). */
+    ::view-transition-group(top-story) {
+        overflow: clip;
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+    }
+    ::view-transition-old(top-story),
+    ::view-transition-new(top-story) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+    }
+
+    :active-view-transition-type(top-stories-next)::view-transition-old(top-story) {
+        animation-name: top-stories-slide-to-left;
+    }
+    :active-view-transition-type(top-stories-next)::view-transition-new(top-story) {
+        animation-name: top-stories-slide-from-right;
+    }
+    :active-view-transition-type(top-stories-prev)::view-transition-old(top-story) {
+        animation-name: top-stories-slide-to-right;
+    }
+    :active-view-transition-type(top-stories-prev)::view-transition-new(top-story) {
+        animation-name: top-stories-slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(top-story),
+        ::view-transition-old(top-story),
+        ::view-transition-new(top-story) {
+            animation: none !important;
+        }
+    }
+</style>
+
+<script>
+    type Direction = 'top-stories-next' | 'top-stories-prev';
+
+    function initTopStories() {
+        document.querySelectorAll<HTMLElement>('[data-top-stories]').forEach((root) => {
+            if (root.dataset.initialized) return;
+            root.dataset.initialized = 'true';
+
+            const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
+            const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
+            const counter = root.querySelector<HTMLElement>('[data-counter]');
+            let current = 0;
+
+            const show = (index: number) => {
+                slides[current].hidden = true;
+                current = (index + slides.length) % slides.length;
+                slides[current].hidden = false;
+                if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
+            };
+
+            const go = (step: 1 | -1) => {
+                if (slides.length < 2) return;
+                const update = () => show(current + step);
+                const types: Direction[] = [step === 1 ? 'top-stories-next' : 'top-stories-prev'];
+
+                // Prefer an element-scoped transition so the rest of the page stays
+                // interactive; fall back to a document transition, then to no animation.
+                let transition: ViewTransition | undefined;
+                if ('startViewTransition' in Element.prototype) {
+                    transition = (viewport as any).startViewTransition({ update, types });
+                } else if (document.startViewTransition) {
+                    transition = document.startViewTransition({ update, types });
+                } else {
+                    update();
+                    return;
+                }
+                // Rapid clicks skip the running transition and reject `ready`.
+                transition?.ready.catch(() => {});
+            };
+
+            root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
+            root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
+        });
+    }
+
+    document.addEventListener('astro:page-load', initTopStories);
+</script>
