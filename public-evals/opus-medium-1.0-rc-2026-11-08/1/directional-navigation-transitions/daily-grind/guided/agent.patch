+    /* Seasonal Favorites carousel */
+    .carousel {
+      max-width: 480px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      overflow: clip;
+      border-radius: 8px;
+      padding: 4px;
+    }
+
+    .carousel-viewport .card {
+      view-transition-name: seasonal-slide;
+    }
+
+    /* Fallback (document-level transition): clip the slide to the viewport */
+    .carousel-viewport.is-doc-transition {
+      view-transition-name: seasonal-viewport;
+      view-transition-group: contain;
+    }
+
+    ::view-transition-group-children(seasonal-viewport) {
+      overflow: clip;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 16px;
+      margin-top: 16px;
