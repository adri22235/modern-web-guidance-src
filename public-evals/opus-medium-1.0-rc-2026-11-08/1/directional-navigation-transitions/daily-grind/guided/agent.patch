+  <script>
+    (() => {
+      const carousel = document.getElementById('seasonal-carousel');
+      const viewport = carousel.querySelector('.carousel-viewport');
+      const slides = [...viewport.querySelectorAll('.card')];
+      const status = carousel.querySelector('.carousel-status');
+      const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+      let index = 0;
+      let latestDocTransition = null;
+
+      function show(newIndex) {
+        slides[index].hidden = true;
+        index = (newIndex + slides.length) % slides.length;
+        slides[index].hidden = false;
+        status.textContent = `${index + 1} / ${slides.length}`;
+      }
+
+      function step(direction) {
+        const update = () => show(index + (direction === 'forward' ? 1 : -1));
+
+        if (supportsScopedTransition) {
+          // Scope the transition to the carousel so the rest of the page stays interactive
+          const transition = viewport.startViewTransition({ update, types: [direction] });
+          transition.ready.catch(() => {});
+        } else if (document.startViewTransition) {
+          viewport.classList.add('is-doc-transition');
+          const transition = document.startViewTransition({ update, types: [direction] });
+          transition.ready.catch(() => {});
+          transition.finished.finally(() => {
+            // A newer transition may have started; only clean up after the latest one
+            if (transition === latestDocTransition) viewport.classList.remove('is-doc-transition');
+          });
+          latestDocTransition = transition;
+        } else {
+          update();
+        }
+      }
+
+      carousel.addEventListener('click', (event) => {
+        const button = event.target.closest('button[data-direction]');
+        if (button) step(button.dataset.direction);
+      });
+
+      carousel.addEventListener('keydown', (event) => {
+        if (event.key === 'ArrowRight') step('forward');
+        else if (event.key === 'ArrowLeft') step('backward');
+      });
+    })();
+  </script>
