+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); }
+    }
+
+    ::view-transition-group(seasonal-slide) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    ::view-transition-old(seasonal-slide),
+    ::view-transition-new(seasonal-slide) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    :active-view-transition-type(forward)::view-transition-old(seasonal-slide) {
+      animation-name: slide-to-left;
+    }
+
+    :active-view-transition-type(forward)::view-transition-new(seasonal-slide) {
+      animation-name: slide-from-right;
+    }
+
+    :active-view-transition-type(backward)::view-transition-old(seasonal-slide) {
+      animation-name: slide-to-right;
+    }
+
+    :active-view-transition-type(backward)::view-transition-new(seasonal-slide) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
