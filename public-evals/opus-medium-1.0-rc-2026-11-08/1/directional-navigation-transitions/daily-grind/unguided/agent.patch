+  <script>
+    (function () {
+      var carousel = document.getElementById('seasonal-carousel');
+      var cards = Array.prototype.slice.call(carousel.querySelectorAll('.card'));
+      var buttons = carousel.querySelectorAll('.carousel-btn');
+      var status = carousel.querySelector('.carousel-status');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var current = 0;
+      var DURATION = 400;
+      var EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
+
+      function updateStatus() {
+        status.textContent = (current + 1) + ' / ' + cards.length;
+        cards.forEach(function (card, i) {
+          card.setAttribute('aria-label', (i + 1) + ' of ' + cards.length);
+          card.setAttribute('aria-hidden', i === current ? 'false' : 'true');
+        });
+      }
+
+      // dir: 1 = Next (new card enters from the right), -1 = Previous (enters from the left)
+      function go(dir) {
+        var prev = current;
+        current = (current + dir + cards.length) % cards.length;
+        var outgoing = cards[prev];
+        var incoming = cards[current];
+
+        // Settle any in-flight transition so rapid clicks never leave stray cards visible
+        cards.forEach(function (card, i) {
+          if (card.getAnimations) card.getAnimations().forEach(function (a) { a.cancel(); });
+          card.hidden = i !== current && i !== prev;
+        });
+        updateStatus();
+
+        if (reduceMotion.matches || !incoming.animate) {
+          outgoing.hidden = true;
+          return;
+        }
+
+        var opts = { duration: DURATION, easing: EASING };
+        incoming.animate([
+          { transform: 'translateX(' + (dir * 100) + '%)', opacity: 0 },
+          { transform: 'translateX(0)', opacity: 1 }
+        ], opts);
+        var exit = outgoing.animate([
+          { transform: 'translateX(0)', opacity: 1 },
+          { transform: 'translateX(' + (-dir * 100) + '%)', opacity: 0 }
+        ], opts);
+        exit.onfinish = function () { outgoing.hidden = true; };
+      }
+
+      cards.forEach(function (card, i) { card.hidden = i !== current; });
+      updateStatus();
+
+      Array.prototype.forEach.call(buttons, function (btn) {
+        if (cards.length < 2) btn.disabled = true;
+        btn.addEventListener('click', function () { go(Number(btn.dataset.dir)); });
+      });
+
+      carousel.addEventListener('keydown', function (e) {
+        if (cards.length < 2) return;
+        if (e.key === 'ArrowRight') go(1);
+        else if (e.key === 'ArrowLeft') go(-1);
+      });
+    })();
+  </script>
