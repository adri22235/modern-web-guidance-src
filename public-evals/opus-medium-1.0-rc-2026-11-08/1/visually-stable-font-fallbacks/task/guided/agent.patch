+
+      /* Font stacks: web font -> metric-matched local fallback -> generic */
+      --font-body: 'Inter', 'Inter Fallback', Arial, sans-serif;
+      --font-heading: 'Playfair Display', 'Playfair Display Fallback', 'Times New Roman', serif;
     }
 
+    /*
+     * Metric-matched fallbacks: local fonts tuned to the web fonts' size and
+     * vertical metrics so line boxes don't change height when the web font
+     * swaps in (display=swap), avoiding layout shift.
+     */
+    @font-face {
+      font-family: 'Inter Fallback';
+      src: local('Arial'), local('ArialMT'), local('Liberation Sans'), local('Arimo');
+      size-adjust: 107.12%;
+      ascent-override: 90.44%;
+      descent-override: 22.52%;
+      line-gap-override: 0%;
+    }
+
+    @font-face {
+      font-family: 'Playfair Display Fallback';
+      src: local('Times New Roman'), local('TimesNewRomanPSMT'), local('Liberation Serif'), local('Tinos');
+      size-adjust: 111.22%;
+      ascent-override: 97.25%;
+      descent-override: 22.56%;
+      line-gap-override: 0%;
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
     }
 
     body {
-      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-family: var(--font-body);
+      /* Normalize every font in the stack to Inter's x-height so text stays
+         the same visual size and legible before, during and after the swap.
+         An explicit value is used because from-font would read the metrics of
+         whichever font happens to be available (the fallback while loading). */
+      font-size-adjust: 0.545;
       line-height: 1.6;
