+  <script>
+    (function () {
+      'use strict';
+
+      var grid = document.getElementById('seasonal-grid');
+      var status = document.getElementById('layout-status');
+      var toggleButtons = document.querySelectorAll('.layout-toggle button');
+      var LAYOUT_KEY = 'daily-grind:card-layout';
+      var LAYOUTS = { grid: 'Grid', compact: 'Compact', list: 'List' };
+      var activeCard = null;
+
+      function getCards() {
+        // Only cards that are actually rendered can be navigated to.
+        return Array.prototype.filter.call(grid.querySelectorAll('.card'), function (card) {
+          return card.getClientRects().length > 0;
+        });
+      }
+
+      // Roving tabindex: only the active card (and its link) is in the tab order,
+      // so Tab moves into and out of the grid in a single stop.
+      function setActive(card, moveFocus) {
+        if (!card) return;
+        Array.prototype.forEach.call(grid.querySelectorAll('.card'), function (c) {
+          var isActive = c === card;
+          c.tabIndex = isActive ? 0 : -1;
+          c.querySelectorAll('a, button').forEach(function (el) {
+            el.tabIndex = isActive ? 0 : -1;
+          });
+        });
+        activeCard = card;
+        if (moveFocus) {
+          card.focus({ preventScroll: true });
+          card.scrollIntoView({
+            block: 'nearest',
+            inline: 'nearest',
+            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
+          });
+        }
+      }
+
+      function center(rect) {
+        return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
+      }
+
+      // Geometric neighbour search based on the rendered position of each card,
+      // so it adapts to any column count, layout mode, or writing direction.
+      function findSpatialNeighbour(current, cards, direction) {
+        var from = current.getBoundingClientRect();
+        var fromC = center(from);
+        var EPS = 1;
+        var best = null;
+
+        cards.forEach(function (card) {
+          if (card === current) return;
+          var r = card.getBoundingClientRect();
+          var c = center(r);
+          var major, minor, overlap;
+
+          switch (direction) {
+            case 'up':
+              if (c.y >= fromC.y - EPS || r.top >= from.top - EPS) return;
+              major = Math.max(0, from.top - r.bottom);
+              minor = Math.abs(c.x - fromC.x);
+              overlap = r.left < from.right && r.right > from.left;
+              break;
+            case 'down':
+              if (c.y <= fromC.y + EPS || r.bottom <= from.bottom + EPS) return;
+              major = Math.max(0, r.top - from.bottom);
+              minor = Math.abs(c.x - fromC.x);
+              overlap = r.left < from.right && r.right > from.left;
+              break;
+            case 'left':
+              if (c.x >= fromC.x - EPS || r.left >= from.left - EPS) return;
+              major = Math.max(0, from.left - r.right);
+              minor = Math.abs(c.y - fromC.y);
+              overlap = r.top < from.bottom && r.bottom > from.top;
+              break;
+            case 'right':
+              if (c.x <= fromC.x + EPS || r.right <= from.right + EPS) return;
+              major = Math.max(0, r.left - from.right);
+              minor = Math.abs(c.y - fromC.y);
+              overlap = r.top < from.bottom && r.bottom > from.top;
+              break;
+          }
+
+          // Horizontal moves stay within the current row; vertical moves pick the
+          // nearest row/column first, then the most closely aligned card in it
+          // (handles a shorter last row by landing on the nearest card).
+          if ((direction === 'left' || direction === 'right') && !overlap) return;
+
+          var candidate = { card: card, major: major, minor: minor };
+          if (!best ||
+              candidate.major < best.major - EPS ||
+              (Math.abs(candidate.major - best.major) <= EPS && candidate.minor < best.minor)) {
+            best = candidate;
+          }
+        });
+
+        return best ? best.card : null;
+      }
+
+      function isRTL() {
+        return getComputedStyle(grid).direction === 'rtl';
+      }
+
+      function getTarget(current, key, ctrlKey) {
+        var cards = getCards();
+        var index = cards.indexOf(current);
+        if (index === -1) return cards[0] || null;
+
+        switch (key) {
+          case 'ArrowUp':
+          case 'ArrowDown':
+            return findSpatialNeighbour(current, cards, key === 'ArrowUp' ? 'up' : 'down');
+
+          case 'ArrowLeft':
+          case 'ArrowRight': {
+            var dir = key === 'ArrowLeft' ? 'left' : 'right';
+            var spatial = findSpatialNeighbour(current, cards, dir);
+            if (spatial) return spatial;
+            // At the edge of a row (or in single-column list mode), continue in
+            // reading order so every card is reachable with left/right alone.
+            var forward = (dir === 'right') !== isRTL();
+            return cards[index + (forward ? 1 : -1)] || null;
+          }
+
+          case 'Home':
+            return ctrlKey ? cards[0] : rowEdge(current, cards, 'start');
+          case 'End':
+            return ctrlKey ? cards[cards.length - 1] : rowEdge(current, cards, 'end');
+
+          case 'PageUp':
+          case 'PageDown':
+            return pageTarget(current, cards, key === 'PageUp' ? 'up' : 'down');
+        }
+        return null;
+      }
+
+      // Home/End move to the first/last card in the current visual row.
+      // In single-column layouts the "row" is one card, so jump to the ends of the list.
+      function rowEdge(current, cards, edge) {
+        var from = current.getBoundingClientRect();
+        var row = cards.filter(function (card) {
+          var r = card.getBoundingClientRect();
+          return r.top < from.bottom && r.bottom > from.top;
+        });
+        if (row.length <= 1) return edge === 'start' ? cards[0] : cards[cards.length - 1];
+        // Rows are in DOM order regardless of writing direction.
+        return edge === 'start' ? row[0] : row[row.length - 1];
+      }
+
+      // PageUp/PageDown jump up to 3 rows at a time.
+      function pageTarget(current, cards, direction) {
+        var target = current;
+        for (var i = 0; i < 3; i++) {
+          var next = findSpatialNeighbour(target, cards, direction);
+          if (!next) break;
+          target = next;
+        }
+        return target === current ? null : target;
+      }
+
+      grid.addEventListener('keydown', function (event) {
+        var card = event.target.closest('.card');
+        if (!card || event.altKey || event.metaKey) return;
+
+        // Activate the card's primary link with Enter/Space when the card itself has focus.
+        if (event.target === card && (event.key === 'Enter' || event.key === ' ')) {
+          var link = card.querySelector('a[href]');
+          if (link) {
+            event.preventDefault();
+            link.click();
+          }
+          return;
+        }
+
+        var handled = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'];
+        if (handled.indexOf(event.key) === -1) return;
+
+        // Always consume navigation keys so the page doesn't scroll at grid edges.
+        event.preventDefault();
+        var target = getTarget(card, event.key, event.ctrlKey);
+        if (target && target !== card) setActive(target, true);
+      });
+
+      // Keep the roving tabindex in sync with mouse clicks and Tab into inner links.
+      grid.addEventListener('focusin', function (event) {
+        var card = event.target.closest('.card');
+        if (card && card !== activeCard) setActive(card, false);
+      });
+
+      function applyLayout(layout, announce) {
+        if (!LAYOUTS[layout]) layout = 'grid';
+        grid.dataset.layout = layout;
+        toggleButtons.forEach(function (btn) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.layout === layout));
+        });
+        if (announce) status.textContent = LAYOUTS[layout] + ' layout';
+        try { localStorage.setItem(LAYOUT_KEY, layout); } catch (e) { /* storage unavailable */ }
+      }
+
+      toggleButtons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          applyLayout(btn.dataset.layout, true);
+        });
+      });
+
+      var savedLayout = null;
+      try { savedLayout = localStorage.getItem(LAYOUT_KEY); } catch (e) { /* storage unavailable */ }
+      applyLayout(savedLayout || 'grid', false);
+      setActive(getCards()[0], false);
+    })();
+  </script>
