+  <script>
+    // Spatial (2D) arrow-key navigation for composite widgets, based on live layout geometry.
+    const DIRECTIONS = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right' };
+    const TOLERANCE = 1; // px, absorbs sub-pixel rounding
+    const FALLBACK_WEIGHT = 3; // favours aligned candidates when nothing overlaps
+
+    function findCandidate(current, candidates, dir) {
+      const from = current.getBoundingClientRect();
+      const horizontal = dir === 'left' || dir === 'right';
+      const fromCentre = horizontal ? (from.top + from.bottom) / 2 : (from.left + from.right) / 2;
+      let bestAligned = null, bestFallback = null;
+
+      for (const el of candidates) {
+        if (el === current) continue;
+        const r = el.getBoundingClientRect();
+        // Edge-based direction filter
+        let gap;
+        if (dir === 'right') gap = r.left - from.right;
+        else if (dir === 'left') gap = from.left - r.right;
+        else if (dir === 'down') gap = r.top - from.bottom;
+        else gap = from.top - r.bottom;
+        if (gap < -TOLERANCE) continue;
+        gap = Math.max(gap, 0);
+
+        const overlaps = horizontal
+          ? r.top < from.bottom - TOLERANCE && r.bottom > from.top + TOLERANCE
+          : r.left < from.right - TOLERANCE && r.right > from.left + TOLERANCE;
+        const offset = Math.abs((horizontal ? (r.top + r.bottom) / 2 : (r.left + r.right) / 2) - fromCentre);
+
+        if (overlaps) {
+          if (!bestAligned || gap < bestAligned.gap || (gap === bestAligned.gap && offset < bestAligned.offset)) {
+            bestAligned = { el, gap, offset };
+          }
+        } else {
+          const score = gap + FALLBACK_WEIGHT * offset;
+          if (!bestFallback || score < bestFallback.score) bestFallback = { el, score };
+        }
+      }
+      return (bestAligned || bestFallback)?.el ?? null;
+    }
+
+    function initSpatialNavigation(container, itemSelector) {
+      const getItems = () => [...container.querySelectorAll(itemSelector)].filter((el) => el.checkVisibility());
+
+      const setActive = (item) => {
+        for (const el of container.querySelectorAll(itemSelector)) el.tabIndex = el === item ? 0 : -1;
+      };
+
+      // Keep the single tab stop in sync when focus arrives by pointer or programmatically
+      container.addEventListener('focusin', (e) => {
+        if (e.target.matches(itemSelector)) setActive(e.target);
+      });
+
+      container.addEventListener('keydown', (e) => {
+        const dir = DIRECTIONS[e.key];
+        if (!dir || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element) || !target.matches(itemSelector)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+
+        const next = findCandidate(target, getItems(), dir);
+        if (!next) return; // let the browser scroll natively
+
+        e.preventDefault();
+        setActive(next);
+        next.focus({ preventScroll: true });
+        next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+
+      // If the active item becomes hidden (e.g. layout change), move the tab stop to a visible one
+      return () => {
+        const items = getItems();
+        const active = container.querySelector(`${itemSelector}[tabindex="0"]`);
+        if (items.length && !items.includes(active)) setActive(items[0]);
+      };
+    }
+
+    const favorites = document.getElementById('favorites');
+    const syncTabStop = initSpatialNavigation(favorites, '.card .btn');
+
+    document.querySelector('.layout-switch').addEventListener('change', (e) => {
+      favorites.dataset.layout = e.target.value;
+      syncTabStop();
+    });
+  </script>
+
