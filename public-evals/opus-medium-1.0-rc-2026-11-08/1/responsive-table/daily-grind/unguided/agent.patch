+    /* Nutrition & Pricing Table */
+    .nutrition {
+      margin-top: 40px;
+    }
+
+    .nutrition h3 {
+      color: var(--primary);
+      text-align: center;
+      margin-bottom: 5px;
+    }
+
+    .nutrition-note {
+      text-align: center;
+      font-size: 0.9rem;
+      margin-bottom: 15px;
+    }
+
+    .table-scroll {
+      overflow-x: auto;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-scroll:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      min-width: 560px;
+      border-collapse: collapse;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 14px;
+      text-align: right;
+      border-bottom: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    .nutrition-table th[scope="row"],
+    .nutrition-table thead th:first-child {
+      text-align: left;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      background: white;
+      color: var(--primary);
+      box-shadow: 2px 0 0 var(--secondary);
+    }
+
+    .nutrition-table tbody tr:nth-child(even) th,
+    .nutrition-table tbody tr:nth-child(even) td {
+      background: #f5f0ee;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .unit {
+      display: block;
+      font-size: 0.75rem;
+      font-weight: normal;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    @media (max-width: 600px) {
+      .nutrition-table {
+        font-size: 0.85rem;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px;
+      }
+    }
+
