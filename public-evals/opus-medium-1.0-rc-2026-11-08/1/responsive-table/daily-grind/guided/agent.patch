+    /* Nutrition & pricing table */
+    .table-wrapper {
+      overflow: auto;
+      max-inline-size: 100%;
+      max-block-size: min(500px, 80vh);
+      container-type: inline-size;
+      margin-top: 30px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      inline-size: 100%;
+      border-collapse: separate;
+      border-spacing: 0;
+      font-size: 0.95rem;
+      --label-2: "Size";
+      --label-3: "Price";
+      --label-4: "Calories";
+      --label-5: "Fat (g)";
+      --label-6: "Sugar (g)";
+      --label-7: "Caffeine (mg)";
+    }
+
+    .nutrition-table caption {
+      padding: 15px 20px;
+      font-weight: bold;
+      color: var(--primary);
+      text-align: start;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      text-align: start;
+      border-block-end: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .nutrition-table td {
+      font-variant-numeric: tabular-nums;
+    }
+
+    .nutrition-table thead {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+    }
+
+    .nutrition-table tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+      color: var(--primary);
+    }
+
+    .nutrition-table tbody tr:last-child > * {
+      border-block-end: 0;
+    }
+
+    @container (width < 600px) {
+      .nutrition-table,
+      .nutrition-table thead,
+      .nutrition-table tbody,
+      .nutrition-table tr,
+      .nutrition-table th,
+      .nutrition-table td {
+        display: block;
+      }
+
+      .nutrition-table thead {
+        display: none;
+      }
+
+      .nutrition-table tbody {
+        padding: 0 15px;
+      }
+
+      .nutrition-table tr {
+        margin-block-end: 1.25rem;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        overflow: clip;
+      }
+
+      .nutrition-table tbody th {
+        position: sticky;
+        inset-block-start: 0;
+        z-index: 2;
+        background: var(--secondary);
+      }
+
+      .nutrition-table td {
+        display: flex;
+        justify-content: space-between;
+        gap: 1rem;
+        white-space: normal;
+      }
+
+      .nutrition-table td::before {
+        font-weight: 600;
+        color: var(--primary);
+      }
+
+      .nutrition-table tbody tr:last-child > * {
+        border-block-end: 1px solid var(--secondary);
+      }
+
+      .nutrition-table tr > :last-child {
+        border-block-end: 0;
+      }
+
+      .nutrition-table td:nth-child(2)::before { content: var(--label-2) ": "; }
+      .nutrition-table td:nth-child(3)::before { content: var(--label-3) ": "; }
+      .nutrition-table td:nth-child(4)::before { content: var(--label-4) ": "; }
+      .nutrition-table td:nth-child(5)::before { content: var(--label-5) ": "; }
+      .nutrition-table td:nth-child(6)::before { content: var(--label-6) ": "; }
+      .nutrition-table td:nth-child(7)::before { content: var(--label-7) ": "; }
+    }
