+          { model: box.translate(0, -H / 2, 0).rotate(90, 0, 0).scale(W, D, 1), tex: topTex, ambient: 0.45 },
+        ];
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+        gl.enable(gl.CULL_FACE);
+        gl.useProgram(program);
+        gl.bindVertexArray(vao);
+        gl.activeTexture(gl.TEXTURE0);
+        gl.uniform1i(loc.tex, 0);
+
+        for (const face of faces) {
+          gl.bindTexture(gl.TEXTURE_2D, face.tex);
+          gl.uniformMatrix4fv(loc.model, false, face.model.toFloat32Array());
+          gl.uniformMatrix4fv(loc.mvp, false, viewProjection.multiply(face.model).toFloat32Array());
+          gl.uniform1f(loc.ambient, face.ambient);
+          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        }
+
+        // Keep the real form element aligned with the front face for hit testing,
+        // focus rings, and accessibility bounds. Disable it while facing away.
+        const front = faces[0].model;
+        const center = view.multiply(front).transformPoint(new DOMPoint(0, 0, 0));
+        const normal = view.multiply(front).transformPoint(new DOMPoint(0, 0, 1, 0));
+        const facing = normal.x * -center.x + normal.y * -center.y + normal.z * -center.z > 0;
+        if (facing) {
+          canvas.updateElementGeometry(form, {
+            canvasTransform: computeCanvasTransform(canvas, form, viewProjection.multiply(front)),
+          });
+        } else if (formHittable) {
+          canvas.clearElementGeometry(form);
+        }
+        if (facing !== formHittable) {
+          formHittable = facing;
+          form.inert = !facing;
+        }
+      };
+    }
+
+    function createProgram(gl, vsSource, fsSource) {
+      const compile = (type, source) => {
+        const shader = gl.createShader(type);
+        gl.shaderSource(shader, source);
+        gl.compileShader(shader);
+        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader));
+        return shader;
+      };
+      const program = gl.createProgram();
+      gl.attachShader(program, compile(gl.VERTEX_SHADER, vsSource));
+      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fsSource));
+      gl.linkProgram(program);
+      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program));
+      return program;
+    }
+
+    function createCanvasTexture(gl, width, height, draw) {
+      const source = document.createElement('canvas');
+      source.width = width;
+      source.height = height;
+      draw(source.getContext('2d'), width, height);
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, source);
+      gl.generateMipmap(gl.TEXTURE_2D);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      return texture;
+    }
+
+    // Returns the element's size in canvas grid pixels, or null if it has no paint record yet.
+    function getElementImageSize(canvas, element) {
+      let elementImage;
+      try {
+        elementImage = canvas.captureElementImage(element);
+      } catch {
+        canvas.requestPaint();
+        return null;
+      }
+      const width = Math.ceil(elementImage.width);
+      const height = Math.ceil(elementImage.height);
+      elementImage.close();
+      return width > 0 && height > 0 ? { width, height } : null;
+    }
+
+    // Allocates texture storage on first upload, and again only when the size changes.
+    function allocateElementTexture(gl, texture, state, width, height) {
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      if (state.width === width && state.height === height) return;
+      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, width, height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      state.width = width;
+      state.height = height;
+    }
+
+    function uploadElementWebGL(gl, canvas, texture, element, state) {
+      const size = getElementImageSize(canvas, element);
+      if (!size) return false;
+      allocateElementTexture(gl, texture, state, size.width, size.height);
+      gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, element, size);
+      return true;
+    }
+
+    // Maps the element's border box (CSS px) onto the canvas (CSS px) for a unit quad drawn with `mvp`.
+    function computeCanvasTransform(canvas, element, mvp) {
+      const width = element.offsetWidth;
+      const height = element.offsetHeight;
+      const toGLModel = new DOMMatrix()
+        .scale(1 / width, -1 / height, 1 / height)
+        .translate(-width / 2, -height / 2);
+      const clipToCanvas = new DOMMatrix()
+        .translate(canvas.clientWidth / 2, canvas.clientHeight / 2)
+        .scale(canvas.clientWidth / 2, -canvas.clientHeight / 2, canvas.clientHeight / 2);
+      return clipToCanvas.multiply(mvp).multiply(toGLModel);
+    }
+  </script>
