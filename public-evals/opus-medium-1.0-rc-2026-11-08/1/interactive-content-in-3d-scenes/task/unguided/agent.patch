+          case 'ArrowLeft': ry -= step; break;
+          case 'ArrowRight': ry += step; break;
+          case 'ArrowUp': rx = Math.min(80, rx + step); break;
+          case 'ArrowDown': rx = Math.max(-80, rx - step); break;
+          case 'Home': setView('front'); e.preventDefault(); return;
