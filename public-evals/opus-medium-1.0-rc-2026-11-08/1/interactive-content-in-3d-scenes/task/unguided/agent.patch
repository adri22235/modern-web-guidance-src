+        box.style.setProperty('--ry', ry + 'deg');
+      }
+
+      function setView(name) {
+        var v = VIEWS[name];
+        // Rotate along the shortest path from the current angle.
+        var delta = ((v.ry - ry) % 360 + 540) % 360 - 180;
+        ry += delta;
+        rx = v.rx;
+        viewButtons.forEach(function (b) {
+          b.setAttribute('aria-pressed', b.dataset.view === name ? 'true' : 'false');
+        });
+        render();
+      }
+
