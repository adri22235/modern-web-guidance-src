+
+      var scene = document.getElementById('boxScene');
+      var box = document.getElementById('box');
+      var hint = document.getElementById('boxHint');
+      var viewButtons = document.querySelectorAll('.box-controls [data-view]');
+      var front = document.querySelector('.face-front');
+      var VIEWS = {
+        front: { rx: -8, ry: -20 },
+        right: { rx: -8, ry: -100 },
+        back: { rx: -8, ry: -200 },
+        top: { rx: -70, ry: -20 }
