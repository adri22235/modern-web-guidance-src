+        rx = Math.max(-80, Math.min(80, drag.rx - dy * 0.4));
+        render();
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        if (drag.active) scene.classList.remove('dragging');
+        drag = null;
+      }
+      scene.addEventListener('pointerup', endDrag);
+      scene.addEventListener('pointercancel', endDrag);
+
