+  <!-- Polite live region: present on load so screen readers pick up later updates -->
+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var buttons = document.querySelectorAll('.btn[data-loading-text]');
+
+      function setLoading(btn) {
+        var label = btn.querySelector('.btn-label');
+        btn.dataset.originalText = label.textContent;
+        btn.dataset.originalAriaLabel = btn.getAttribute('aria-label') || '';
+        label.textContent = btn.dataset.loadingText;
+
+        var spinner = document.createElement('span');
+        spinner.className = 'spinner';
+        spinner.setAttribute('aria-hidden', 'true');
+        btn.insertBefore(spinner, label);
+
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-label', btn.dataset.loadingAnnounce);
+
+        var region = btn.closest('section, header');
+        if (region) region.setAttribute('aria-busy', 'true');
+
+        status.textContent = btn.dataset.loadingAnnounce;
+      }
+
+      function reset(btn) {
+        if (btn.getAttribute('aria-disabled') !== 'true') return;
+        var spinner = btn.querySelector('.spinner');
+        if (spinner) spinner.remove();
+        btn.querySelector('.btn-label').textContent = btn.dataset.originalText;
+        btn.removeAttribute('aria-disabled');
+        btn.removeAttribute('aria-busy');
+        if (btn.dataset.originalAriaLabel) {
+          btn.setAttribute('aria-label', btn.dataset.originalAriaLabel);
+        } else {
+          btn.removeAttribute('aria-label');
+        }
+        var region = btn.closest('section, header');
+        if (region) region.removeAttribute('aria-busy');
+      }
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          // Let new-tab / new-window clicks behave normally with no busy state.
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (btn.getAttribute('aria-disabled') === 'true') {
+            e.preventDefault(); // ignore repeat clicks while navigating
+            return;
+          }
+          setLoading(btn);
+        });
+      });
+
+      // Restore buttons when returning via the back/forward cache.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted) {
+          buttons.forEach(reset);
+          status.textContent = '';
+        }
+      });
+    })();
+  </script>
+
