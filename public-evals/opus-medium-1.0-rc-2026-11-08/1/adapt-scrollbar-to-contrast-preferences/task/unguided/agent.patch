diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,80 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Scrollbar */
+      --scrollbar-track: #efebe9;
+      --scrollbar-thumb: #8d6e63;
+      --scrollbar-thumb-hover: #6d4c41;
+      --scrollbar-thumb-active: #ff9100;
+      --scrollbar-thumb-border: #efebe9;
+      --scrollbar-size: 12px;
     }
 
+    /* High-contrast scrollbar when the user prefers more contrast */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #1b0f0b;
+        --scrollbar-thumb-hover: #000000;
+        --scrollbar-thumb-active: #000000;
+        --scrollbar-thumb-border: #ffffff;
+        --scrollbar-size: 16px;
+      }
+    }
+
+    /* Scrollbars (standard: Firefox, Chromium 121+) */
+    html {
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+    }
+
+    /* Scrollbars (WebKit / older Chromium) */
+    ::-webkit-scrollbar {
+      width: var(--scrollbar-size);
+      height: var(--scrollbar-size);
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border: 3px solid var(--scrollbar-thumb-border);
+      border-radius: var(--scrollbar-size);
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: var(--scrollbar-thumb-active);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    @media (prefers-contrast: more) {
+      ::-webkit-scrollbar-track {
+        box-shadow: inset 1px 0 0 #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-width: 2px;
+      }
+    }
+
+    /* Defer to system colors in forced-colors modes (e.g. Windows High Contrast) */
+    @media (forced-colors: active) {
+      html {
+        scrollbar-color: auto;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
