+
+    .accordion-item h3 {
+      font-size: 1rem;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      align-items: center;
+      gap: 0.75ch;
+      inline-size: 100%;
+      padding: 16px 20px;
+      background: none;
+      border: none;
+      color: var(--primary);
+      font: inherit;
+      font-weight: bold;
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:hover {
+      background: var(--secondary);
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    /* Chevron next to the label; points toward the inline end when closed */
+    #accordion-toggle::before {
+      content: "";
+      flex-shrink: 0;
+      inline-size: 0.5em;
+      block-size: 0.5em;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      rotate: -45deg;
+      transition: rotate 0.2s;
+    }
+
+    #accordion-toggle:dir(rtl)::before {
+      rotate: 135deg;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::before {
+      rotate: 45deg;
+    }
+
+    .accordion-content {
+      overflow: hidden;
+      block-size: 0;
+      /* Keeps collapsed content out of the accessibility tree and tab order;
+         transitioning visibility keeps it shown until the collapse finishes */
+      visibility: hidden;
+      padding-inline: 20px;
+      transition: block-size 0.4s ease-out, visibility 0.4s;
+    }
+
+    .accordion-content.open {
+      /* Fallback for browsers without calc-size() support */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      visibility: visible;
+    }
+
+    .accordion-content p + p {
+      margin-block-start: 10px;
+    }
+
+    /*
+      Note: transitioning directly between two different intrinsic sizing
+      keywords (e.g. min-content -> max-content, or auto -> fit-content) is
+      not supported. One end of the transition must be a fixed length or
+      percentage (here, block-size: 0 <-> auto / calc-size(auto, ...)).
+    */
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content,
+      #accordion-toggle::before {
+        transition: none;
+      }
+    }
+
