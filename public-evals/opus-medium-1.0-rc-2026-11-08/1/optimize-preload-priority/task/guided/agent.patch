diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,72 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Brand — Watch the film</title>
+
+  <!-- LCP: video posters are fetched late at low priority by default; preload at high priority -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+  <!-- Critical header font (fonts are high priority by default) -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+  <!-- Secondary UI font: start early, but don't compete with the poster or brand font -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <style>
+    @font-face {
+      font-family: "Brand";
+      src: url("brand-font.woff2") format("woff2");
+      font-display: swap;
+    }
+    @font-face {
+      font-family: "Secondary";
+      src: url("secondary-font.woff2") format("woff2");
+      font-display: swap;
+    }
+    * { box-sizing: border-box; }
+    body {
+      margin: 0;
+      min-height: 100svh;
+      display: grid;
+      place-content: center;
+      gap: 1.5rem;
+      padding: 1.5rem;
+      background: #0b0b0c;
+      color: #f5f5f5;
+      font-family: "Secondary", system-ui, sans-serif;
+      font-size-adjust: from-font;
+      text-align: center;
+    }
+    h1 {
+      margin: 0;
+      font-family: "Brand", system-ui, sans-serif;
+      font-size: clamp(2rem, 6vw, 4rem);
+      font-size-adjust: cap-height from-font;
+      line-height: 1.1;
+      text-wrap: balance;
+    }
+    video {
+      display: block;
+      width: min(100%, 1280px);
+      height: auto;
+      aspect-ratio: 16 / 9;
+      background: #1a1a1d;
+    }
+    a {
+      justify-self: center;
+      padding: .75em 1.5em;
+      border-radius: 999px;
+      background: #f5f5f5;
+      color: #0b0b0c;
+      text-decoration: none;
+    }
+  </style>
+</head>
+<body>
+  <h1>Made for what's next</h1>
+  <video controls preload="none" poster="poster.jpg" width="1280" height="720">
+    <source src="video.mp4" type="video/mp4">
+  </video>
+  <a href="#signup">Get early access</a>
+</body>
+</html>
