diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Watch the Film</title>
+<meta name="description" content="A minimal video landing page.">
+
+<!-- LCP element: fetch the poster immediately at the highest priority -->
+<link rel="preload" as="image" href="poster.jpg" fetchpriority="high">
+<!-- Critical font for the header: preload (crossorigin is required for fonts) -->
+<link rel="preload" as="font" type="font/woff2" href="brand-font.woff2" crossorigin>
+<!-- secondary-font.woff2 is intentionally NOT preloaded so it never competes with the LCP image -->
+
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{margin:0;box-sizing:border-box}
+body{background:#000;color:#fff;font:16px/1.5 system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;padding:1rem;text-align:center}
+h1{font:700 clamp(2rem,6vw,4rem)/1.1 Brand,system-ui,sans-serif;margin-bottom:1rem}
+video{display:block;width:100%;max-width:960px;height:auto;aspect-ratio:16/9;background:#111;object-fit:cover}
+p,a{font-family:Secondary,system-ui,sans-serif}
+p{opacity:.8;margin:1rem 0}
+a{display:inline-block;padding:.75rem 1.5rem;background:#fff;color:#000;text-decoration:none;border-radius:999px}
+</style>
+</head>
+<body>
+<main>
+  <h1>Watch the Film</h1>
+  <!-- preload="none": no video bytes are fetched until the user presses play, keeping bandwidth for the poster -->
+  <video controls playsinline preload="none" poster="poster.jpg" width="1280" height="720">
+    <source src="video.mp4" type="video/mp4">
+  </video>
+  <p>Two minutes. One story.</p>
+  <a href="#">Get started</a>
+</main>
+</body>
+</html>
