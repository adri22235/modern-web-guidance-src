+  <script>
+    const ORDER_KEY = 'dailyGrindOrder';
+    const cartCount = document.getElementById('cart-count');
+    const readOrder = () => {
+      try { return JSON.parse(localStorage.getItem(ORDER_KEY)) || []; } catch { return []; }
+    };
+    const renderCount = () => {
+      cartCount.textContent = readOrder().reduce((n, item) => n + item.qty, 0);
+    };
+
+    document.querySelectorAll('.order-form').forEach((form) => {
+      const priceOutput = form.querySelector('output');
+      const status = form.querySelector('.order-status');
+
+      form.addEventListener('change', () => {
+        const selected = form.querySelector('input[name="size"]:checked');
+        priceOutput.value = `$${selected.dataset.price}`;
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const selected = form.querySelector('input[name="size"]:checked');
+        const item = form.dataset.item;
+        const size = selected.value;
+        const order = readOrder();
+        const existing = order.find((line) => line.item === item && line.size === size);
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          order.push({ item, size, price: Number(selected.dataset.price), qty: 1 });
+        }
+        localStorage.setItem(ORDER_KEY, JSON.stringify(order));
+        renderCount();
+        status.textContent = `Added a ${size} ${item} to your order.`;
+      });
+    });
+
+    // If a photo fails to load, drop it so the card uses its text-only layout
+    document.querySelectorAll('.product-card > img').forEach((img) => {
+      if (img.complete && img.naturalWidth === 0) img.remove();
+      else img.addEventListener('error', () => img.remove());
+    });
+
+    renderCount();
+  </script>
+
