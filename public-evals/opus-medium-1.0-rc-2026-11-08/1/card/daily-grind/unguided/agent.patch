+  <script>
+    (function () {
+      var STORAGE_KEY = 'dailyGrindOrder';
+      var countEl = document.querySelector('[data-order-count]');
+
+      function loadOrder() {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch (e) { return []; }
+      }
+
+      function saveOrder(order) {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch (e) { /* storage unavailable */ }
+      }
+
+      function renderCount(order) {
+        var total = order.reduce(function (sum, line) { return sum + line.qty; }, 0);
+        countEl.textContent = total;
+        countEl.hidden = total === 0;
+      }
+
+      renderCount(loadOrder());
+
+      document.querySelectorAll('.order-form').forEach(function (form) {
+        var priceEl = form.closest('.card-body').querySelector('[data-price-display]');
+        var button = form.querySelector('.add-btn');
+        var resetTimer;
+
+        form.addEventListener('change', function (e) {
+          if (e.target.name === 'size') priceEl.textContent = '$' + e.target.dataset.price;
+        });
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var choice = form.querySelector('input[name="size"]:checked');
+          var item = form.elements.item.value;
+          var order = loadOrder();
+          var line = order.find(function (l) { return l.item === item && l.size === choice.value; });
+          if (line) {
+            line.qty += 1;
+          } else {
+            order.push({ item: item, name: form.dataset.item, size: choice.value, price: Number(choice.dataset.price), qty: 1 });
+          }
+          saveOrder(order);
+          renderCount(order);
+
+          button.textContent = 'Added \u2713';
+          button.classList.add('is-added');
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(function () {
+            button.textContent = 'Add to Order';
+            button.classList.remove('is-added');
+          }, 1800);
+        });
+      });
+    })();
+  </script>
+
