 import { defineMiddleware } from 'astro:middleware';
 
+// The only third-party origin the browser needs: account sign-in/sign-up and
+// (opt-in only) analytics. Everything else is served first-party.
+const TIMES_SERVICES_ORIGIN = 'https://us-central1-web-devrel-apps.cloudfunctions.net';
+
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'self'",
+  // Astro emits inline hydration and view-transition scripts.
+  `script-src 'self' 'unsafe-inline' ${TIMES_SERVICES_ORIGIN}`,
+  // Restrict where page scripts may send data.
+  `connect-src 'self' ${TIMES_SERVICES_ORIGIN}`,
+  "img-src 'self' data: https:",
+  "style-src 'self' 'unsafe-inline'",
+  "font-src 'self'",
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'self'",
+  "form-action 'self'",
+  "frame-ancestors 'self'",
+].join('; ');
+
+// Turn off powerful features and ad-targeting APIs the site never uses.
+const PERMISSIONS_POLICY = [
+  'camera=()',
+  'microphone=()',
+  'geolocation=()',
+  'payment=()',
+  'usb=()',
+  'browsing-topics=()',
+].join(', ');
+
+const SENSITIVE_PATHS = /\/(signin|signup)\/?$/;
+
 export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
+  // No session is created up front: readers default to an empty reading list, so a
+  // session cookie is only set once a visitor actually saves an article.
+  const response = await next();
+  const { headers } = response;
+
+  try {
+    headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+    headers.set('Permissions-Policy', PERMISSIONS_POLICY);
+    headers.set('X-Content-Type-Options', 'nosniff');
+    if (import.meta.env.PROD) {
+      // Skipped in dev, where Vite's HMR client needs extra sources.
+      headers.set('Content-Security-Policy', CONTENT_SECURITY_POLICY);
+    }
+
+    if (SENSITIVE_PATHS.test(context.url.pathname)) {
+      // Don't let browsers or shared caches store account pages.
+      headers.set('Cache-Control', 'no-store');
     }
+  } catch {
+    // Some responses (e.g. Response.redirect()) have immutable headers.
   }
-  return next();
+
+  return response;
 });
