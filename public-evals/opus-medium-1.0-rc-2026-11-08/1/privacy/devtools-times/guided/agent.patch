diff --git a/src/components/PrivacyPreferences.astro b/src/components/PrivacyPreferences.astro
new file mode 100644
index 0000000..f75e667
--- /dev/null
+++ b/src/components/PrivacyPreferences.astro
@@ -0,0 +1,142 @@
+---
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<dialog
+  id="privacy-preferences"
+  aria-labelledby="privacy-preferences-title"
+  class="fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-none border-t border-gray-300 bg-white p-0 text-gray-800 shadow-lg z-[60]"
+>
+  <div class="mx-auto max-w-3xl p-5 text-sm">
+    <h2 id="privacy-preferences-title" class="mb-2 text-base font-bold">Your privacy choices</h2>
+    <p class="mb-2">
+      The DevTools Times works without tracking. With your permission, we'd also count which
+      links and buttons get clicked to learn what readers find useful.
+    </p>
+    <p class="mb-2">
+      <strong>What's sent if you allow it:</strong> the label of the link or button you clicked
+      and the time. No name, email, account details or form contents. It goes to our analytics
+      service on Google Cloud (USA). It's never used on sign-in or sign-up pages and never used for ads.
+    </p>
+    <p class="mb-4">
+      This choice is saved in your browser only. You can change it at any time from
+      “Manage Privacy Preferences” at the bottom of every page.
+      <a href={`${baseUrl}legal/privacy`} class="underline">Read our Privacy Policy</a>.
+    </p>
+    <p data-gpc-notice hidden class="mb-4 rounded bg-gray-100 p-3">
+      Your browser is sending a Global Privacy Control signal, so analytics stays off.
+    </p>
+    <form method="dialog" class="flex flex-wrap gap-3">
+      <button
+        value="denied"
+        data-skip-tracking="true"
+        class="rounded border border-gray-900 px-4 py-2 font-semibold hover:bg-gray-100"
+      >
+        No analytics
+      </button>
+      <button
+        value="granted"
+        data-skip-tracking="true"
+        data-consent-allow
+        class="rounded border border-gray-900 px-4 py-2 font-semibold hover:bg-gray-100"
+      >
+        Allow analytics
+      </button>
+    </form>
+  </div>
+</dialog>
+
+<script>
+  const CONSENT_KEY = 'dtt-analytics-consent';
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+  type Consent = 'granted' | 'denied';
+
+  const hasGlobalPrivacyControl = () =>
+    (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
+
+  function readConsent(): Consent | null {
+    try {
+      const value = localStorage.getItem(CONSENT_KEY);
+      return value === 'granted' || value === 'denied' ? value : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function saveConsent(value: Consent) {
+    try {
+      localStorage.setItem(CONSENT_KEY, value);
+    } catch {
+      // Storage unavailable: the choice applies to this page view only.
+    }
+  }
+
+  let analyticsLoaded = false;
+
+  function maybeLoadAnalytics() {
+    if (analyticsLoaded) return;
+    if (hasGlobalPrivacyControl() || readConsent() !== 'granted') return;
+    // Pages handling account credentials opt out entirely.
+    if (document.body.hasAttribute('data-no-analytics')) return;
+
+    const script = document.createElement('script');
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.referrerPolicy = 'no-referrer';
+    document.head.append(script);
+    analyticsLoaded = true;
+  }
+
+  function getDialog() {
+    return document.getElementById('privacy-preferences') as HTMLDialogElement | null;
+  }
+
+  function openPreferences() {
+    const dialog = getDialog();
+    if (!dialog || dialog.open) return;
+    const gpc = hasGlobalPrivacyControl();
+    dialog.querySelector<HTMLElement>('[data-gpc-notice]')!.hidden = !gpc;
+    dialog.querySelector<HTMLButtonElement>('[data-consent-allow]')!.disabled = gpc;
+    dialog.show();
+  }
+
+  function setUpPage() {
+    const dialog = getDialog();
+    if (dialog && !dialog.dataset.bound) {
+      dialog.dataset.bound = 'true';
+      dialog.addEventListener('close', () => {
+        const choice = dialog.returnValue;
+        if (choice !== 'granted' && choice !== 'denied') return;
+        const previous = readConsent();
+        saveConsent(choice);
+        if (choice === 'denied' && analyticsLoaded) {
+          // The tracker can't be unloaded, so reload to stop it immediately.
+          location.reload();
+          return;
+        }
+        if (choice === 'granted' && previous !== 'granted') maybeLoadAnalytics();
+      });
+    }
+
+    // Ask only once, never when the browser already signals an opt-out, and not on
+    // account pages, where analytics never runs and the prompt would cover the form.
+    const shouldAsk =
+      readConsent() === null &&
+      !hasGlobalPrivacyControl() &&
+      !document.body.hasAttribute('data-no-analytics');
+    if (shouldAsk) openPreferences();
+    maybeLoadAnalytics();
+  }
+
+  document.addEventListener('click', (event) => {
+    const trigger = (event.target as Element).closest('[data-open-privacy-preferences]');
+    if (!trigger) return;
+    event.preventDefault();
+    openPreferences();
+  });
+
+  // Runs on first load and after every client-side navigation.
+  document.addEventListener('astro:page-load', setUpPage);
+</script>
