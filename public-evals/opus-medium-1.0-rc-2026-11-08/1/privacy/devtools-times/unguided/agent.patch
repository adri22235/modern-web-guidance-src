-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
+  // Data minimization: no session (and no session cookie) is created up front.
+  // The reading list API only starts a session once a visitor actually bookmarks an article.
+  const response = await next();
+
+  const path = context.url.pathname.replace(/\/$/, '');
+  const isSensitive = SENSITIVE_PATHS.some((p) => path.endsWith(p));
+
+  try {
+    const headers = response.headers;
+    headers.set('Referrer-Policy', isSensitive ? 'no-referrer' : 'strict-origin-when-cross-origin');
+    headers.set('Permissions-Policy', PERMISSIONS_POLICY);
+    headers.set('X-Content-Type-Options', 'nosniff');
+    if (isSensitive) {
+      headers.set('Cache-Control', 'no-store');
+      headers.set('X-Robots-Tag', 'noindex');
