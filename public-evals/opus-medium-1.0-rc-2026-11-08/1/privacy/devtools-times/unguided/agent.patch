 import { defineMiddleware } from 'astro:middleware';
 
+// Pages that handle credentials: never leak them via referrer, never cache them.
+const SENSITIVE_PATHS = ['/signin', '/signup'];
+
+const PERMISSIONS_POLICY = [
+  'browsing-topics=()',
+  'interest-cohort=()',
+  'attribution-reporting=()',
+  'join-ad-interest-group=()',
+  'run-ad-auction=()',
+  'camera=()',
+  'microphone=()',
+  'geolocation=()',
