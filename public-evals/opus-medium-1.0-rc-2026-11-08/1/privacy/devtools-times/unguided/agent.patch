diff --git a/src/components/ConsentBanner.astro b/src/components/ConsentBanner.astro
new file mode 100644
index 0000000..4c58f93
--- /dev/null
+++ b/src/components/ConsentBanner.astro
@@ -0,0 +1,142 @@
+---
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<!--
+  Privacy by design: third-party analytics stay off until the visitor opts in.
+  Browser privacy signals (Global Privacy Control / Do Not Track) are treated as a refusal,
+  and pages marked as sensitive (sign-in / sign-up) never load analytics.
+-->
+<div
+  id="consent-banner"
+  role="dialog"
+  aria-live="polite"
+  aria-labelledby="consent-banner-title"
+  aria-describedby="consent-banner-description"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-50 border-t border-gray-300 bg-white p-4 shadow-lg"
+>
+  <div class="mx-auto flex max-w-6xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
+    <div class="text-sm text-gray-700">
+      <p id="consent-banner-title" class="font-semibold text-gray-900">Your privacy choices</p>
+      <p id="consent-banner-description">
+        With your permission, we use a third-party analytics service to count which links and buttons are clicked
+        (the element type, its visible label and a timestamp). We do not use advertising trackers, and analytics
+        never run on sign-in or sign-up pages. You can change your choice at any time via
+        “Manage Privacy Preferences” in the footer.
+        <a href={`${baseUrl}legal/privacy`} class="underline">Read our Privacy Policy</a>.
+      </p>
+    </div>
+    <div class="flex shrink-0 gap-2">
+      <button
+        type="button"
+        data-consent="denied"
+        data-skip-tracking="true"
+        class="rounded border border-gray-800 px-3 py-2 text-xs font-semibold text-gray-800 hover:bg-gray-100"
+      >
+        Reject analytics
+      </button>
+      <button
+        type="button"
+        data-consent="granted"
+        data-skip-tracking="true"
+        class="rounded border border-gray-800 bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700"
+      >
+        Allow analytics
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = "privacy-consent:analytics";
+  const ANALYTICS_SRC =
+    "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js";
+
+  type Consent = "granted" | "denied";
+
+  function hasPrivacySignal(): boolean {
+    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+    return nav.globalPrivacyControl === true || nav.doNotTrack === "1";
+  }
+
+  function readConsent(): Consent | null {
+    if (hasPrivacySignal()) return "denied";
+    try {
+      const value = localStorage.getItem(STORAGE_KEY);
+      return value === "granted" || value === "denied" ? value : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function writeConsent(value: Consent) {
+    try {
+      localStorage.setItem(STORAGE_KEY, value);
+    } catch {
+      // Storage unavailable: the choice applies to this page view only.
+    }
+  }
+
+  function isSensitivePage(): boolean {
+    return document.documentElement.dataset.analytics === "off";
+  }
+
+  function loadAnalytics() {
+    if (document.getElementById("analytics-client")) return;
+    const script = document.createElement("script");
+    script.id = "analytics-client";
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.referrerPolicy = "no-referrer";
+    document.head.appendChild(script);
+  }
+
+  function setBannerVisible(visible: boolean) {
+    const banner = document.getElementById("consent-banner");
+    if (banner) banner.hidden = !visible;
+  }
+
+  function apply() {
+    if (isSensitivePage() && document.getElementById("analytics-client")) {
+      // Analytics were loaded on a previous page; do a full load so they don't carry over.
+      location.reload();
+      return;
+    }
+    const consent = readConsent();
+    setBannerVisible(consent === null && !isSensitivePage());
+    if (consent === "granted" && !isSensitivePage()) loadAnalytics();
+  }
+
+  function bind() {
+    document.querySelectorAll<HTMLButtonElement>("#consent-banner [data-consent]").forEach((button) => {
+      button.addEventListener("click", () => {
+        const value = button.dataset.consent as Consent;
+        writeConsent(value);
+        setBannerVisible(false);
+        if (value === "granted" && !isSensitivePage()) {
+          loadAnalytics();
+        } else if (value === "denied" && document.getElementById("analytics-client")) {
+          // An already-loaded third-party script cannot be unloaded; reload to fully stop it.
+          location.reload();
+        }
+      });
+    });
+
+    document.querySelectorAll<HTMLElement>("[data-privacy-preferences]").forEach((link) => {
+      link.addEventListener("click", (event) => {
+        event.preventDefault();
+        if (hasPrivacySignal()) {
+          alert("Your browser is sending a Global Privacy Control or Do Not Track signal, so analytics stay disabled.");
+          return;
+        }
+        setBannerVisible(true);
+      });
+    });
+
+    apply();
+  }
+
+  // Re-run after every client-side navigation (Astro view transitions swap the body).
+  document.addEventListener("astro:page-load", bind);
+</script>
