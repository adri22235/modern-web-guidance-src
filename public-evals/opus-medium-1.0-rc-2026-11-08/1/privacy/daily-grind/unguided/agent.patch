@@ -0,0 +1,239 @@
+#!/usr/bin/env node
+// Privacy & third-party audit for The Daily Grind static site. Zero dependencies.
+//
+//   node scripts/privacy-audit.mjs        (or: npm run audit:privacy)
+//
+// Fails (exit 1) when:
+//  - code references a third-party origin that isn't in privacy/third-parties.json
+//  - the CSP (meta fallback or _headers) allows an origin not in the inventory, or misses one
+//  - the meta CSP and the _headers CSP drift apart
+//  - markup contains inline scripts, inline styles or inline event handlers (CSP would block them)
+//  - a known tracker/ad-tech domain is referenced
+//  - required security/privacy headers are missing or weakened
+//  - forms collecting personal data use GET or lack autocomplete hints
+//  - an inventory entry is overdue for review
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join, relative, extname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url));
+const SCANNED_EXT = new Set(['.html', '.htm', '.css', '.js', '.mjs', '.svg', '.json', '.webmanifest']);
+const SKIP_DIRS = new Set(['node_modules', '.git', 'scripts', 'privacy', 'dist']);
+// URLs that are identifiers rather than network requests.
+const NON_REQUEST_ORIGINS = new Set(['http://www.w3.org']);
+
+const KNOWN_TRACKERS = [
+  'google-analytics.com', 'googletagmanager.com', 'doubleclick.net', 'googlesyndication.com',
+  'googleadservices.com', 'facebook.net', 'connect.facebook.com', 'hotjar.com', 'hotjar.io',
+  'segment.com', 'segment.io', 'mixpanel.com', 'amplitude.com', 'fullstory.com', 'clarity.ms',
+  'mouseflow.com', 'crazyegg.com', 'quantserve.com', 'scorecardresearch.com', 'adnxs.com',
+  'criteo.com', 'taboola.com', 'outbrain.com', 'tiktok.com', 'snap.licdn.com', 'ads-twitter.com',
+  'bat.bing.com', 'pinimg.com', 'newrelic.com', 'nr-data.net',
+];
+
+const REQUIRED_HEADERS = {
+  'content-security-policy': (v) => /frame-ancestors 'none'/.test(v) && !/unsafe-(inline|eval)/.test(v),
+  'strict-transport-security': (v) => Number((v.match(/max-age=(\d+)/) || [])[1]) >= 31536000,
+  'referrer-policy': (v) => ['no-referrer', 'same-origin', 'strict-origin', 'strict-origin-when-cross-origin'].includes(v),
+  'permissions-policy': (v) => ['camera=()', 'microphone=()', 'geolocation=()', 'browsing-topics=()'].every((p) => v.includes(p)),
+  'x-content-type-options': (v) => v === 'nosniff',
+  'x-frame-options': (v) => v === 'DENY',
+  'cross-origin-opener-policy': (v) => v === 'same-origin',
+};
+
+const errors = [];
+const warnings = [];
+const fail = (msg) => errors.push(msg);
+const warn = (msg) => warnings.push(msg);
+const read = (p) => readFileSync(join(ROOT, p), 'utf8');
+
+function walk(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    const full = join(dir, name);
+    if (statSync(full).isDirectory()) {
+      if (!SKIP_DIRS.has(name)) walk(full, out);
+    } else if (SCANNED_EXT.has(extname(name)) && name !== 'package.json') {
+      out.push(full);
+    }
+  }
+  return out;
+}
+
+function parseCsp(policy) {
+  const map = new Map();
+  for (const part of policy.split(';').map((s) => s.trim()).filter(Boolean)) {
+    const [name, ...values] = part.split(/\s+/);
+    map.set(name.toLowerCase(), values);
+  }
+  return map;
+}
+
+function cspOrigins(csp) {
+  const result = new Map(); // origin -> Set(directives)
+  for (const [directive, values] of csp) {
+    for (const v of values) {
+      if (/^https?:\/\//.test(v)) {
+        if (!result.has(v)) result.set(v, new Set());
+        result.get(v).add(directive);
+      } else if (v === '*' || v === 'https:' || v === 'http:' || v === 'data:' && directive.startsWith('script')) {
+        fail(`CSP ${directive} uses overly broad source "${v}"`);
+      }
+    }
+  }
+  return result;
+}
+
+function parseHeadersFile(text) {
+  const rules = [];
+  let current = null;
+  for (const line of text.split('\n')) {
+    if (!line.trim() || line.trimStart().startsWith('#')) continue;
+    if (!/^\s/.test(line)) {
+      current = { path: line.trim(), headers: {} };
+      rules.push(current);
+    } else if (current) {
+      const idx = line.indexOf(':');
+      current.headers[line.slice(0, idx).trim().toLowerCase()] = line.slice(idx + 1).trim();
+    }
+  }
+  return rules;
+}
+
+// --- Load inventory --------------------------------------------------------------------------
+const inventory = JSON.parse(read('privacy/third-parties.json'));
+const allowed = new Map(inventory.thirdParties.map((tp) => [tp.origin, tp]));
+const now = Date.now();
+for (const tp of inventory.thirdParties) {
+  for (const field of ['origin', 'vendor', 'purpose', 'category', 'dataShared', 'lastReviewed']) {
+    if (!(field in tp)) fail(`third-parties.json: ${tp.origin || '(entry)'} is missing "${field}"`);
+  }
+  const age = (now - Date.parse(tp.lastReviewed)) / 86400000;
+  if (!(age <= inventory.reviewIntervalDays)) {
+    fail(`third-parties.json: ${tp.origin} last reviewed ${tp.lastReviewed}, overdue (> ${inventory.reviewIntervalDays} days)`);
+  }
+  if (tp.setsCookies) warn(`${tp.origin} sets cookies — make sure it is consent-gated unless strictly necessary`);
+  if (tp.recommendation) warn(`${tp.origin}: ${tp.recommendation}`);
+}
+
+// --- Scan source for external origins & markup hygiene ----------------------------------------
+const files = walk(ROOT);
+const referenced = new Map(); // origin -> Set(file)
+for (const file of files) {
+  const rel = relative(ROOT, file);
+  const text = readFileSync(file, 'utf8');
+  for (const m of text.matchAll(/(?:https?:)?\/\/([a-z0-9.-]+\.[a-z]{2,})(?::\d+)?(?=[/"'\s)?#]|$)/gi)) {
+    if (m[0].startsWith('//') && !/\.(html?|css)$/.test(rel)) continue; // ignore JS comments
+    const origin = `https://${m[1].toLowerCase()}`;
+    if (NON_REQUEST_ORIGINS.has(m[0].replace(/\/$/, '')) || NON_REQUEST_ORIGINS.has(`http://${m[1]}`)) continue;
+    if (!referenced.has(origin)) referenced.set(origin, new Set());
+    referenced.get(origin).add(rel);
+    if (m[0].startsWith('http://')) fail(`${rel}: insecure http:// reference to ${m[1]}`);
+  }
+
+  if (/\.html?$/.test(rel)) {
+    for (const m of text.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+      const attrs = m[1];
+      const isPlaceholder = /type=["']text\/plain["']/i.test(attrs) && /data-consent=/i.test(attrs);
+      if (isPlaceholder) {
+        if (m[2].trim()) fail(`${rel}: consent-gated script placeholders must use data-src, not inline code`);
+        const src = (attrs.match(/data-src=["']([^"']+)/i) || [])[1];
+        const tp = src && allowed.get(new URL(src, 'https://self.invalid').origin);
+        if (src && /^https?:/.test(src) && (!tp || tp.category === 'necessary')) {
+          fail(`${rel}: consent-gated script ${src} must be inventoried with a non-"necessary" category`);
+        }
+      } else if (!/\bsrc=/i.test(attrs) && m[2].trim()) {
+        fail(`${rel}: inline <script> found (blocked by CSP; move to an external file)`);
+      } else if (/\bsrc=["']https?:/i.test(attrs)) {
+        fail(`${rel}: third-party <script src> loads without consent gating`);
+      }
+    }
+    if (/<style\b/i.test(text)) fail(`${rel}: inline <style> block found (blocked by CSP)`);
+    if (/\sstyle=["']/i.test(text)) fail(`${rel}: inline style="" attribute found (blocked by CSP)`);
+    if (/\son[a-z]+=["']/i.test(text)) fail(`${rel}: inline event handler attribute found (blocked by CSP)`);
+
+    for (const form of text.matchAll(/<form\b([^>]*)>([\s\S]*?)<\/form>/gi)) {
+      const method = ((form[1].match(/method=["']?(\w+)/i) || [])[1] || 'get').toLowerCase();
+      const body = form[2];
+      const personal = /type=["']?(password|email|tel)|name=["']?(email|phone|name|address|card|password)/i.test(body);
+      if (personal && method === 'get') fail(`${rel}: form collecting personal data uses GET (data leaks into URLs/logs)`);
+      for (const input of body.matchAll(/<input\b[^>]*type=["']?(password|email|tel)[^>]*>/gi)) {
+        if (!/autocomplete=/i.test(input[0])) warn(`${rel}: ${input[1]} input without an autocomplete hint`);
+      }
+    }
+  }
+}
+
+for (const [origin, where] of referenced) {
+  const tracker = KNOWN_TRACKERS.find((d) => origin === `https://${d}` || origin.endsWith(`.${d}`));
+  if (tracker) fail(`known tracker ${origin} referenced in ${[...where].join(', ')}`);
+  if (!allowed.has(origin)) fail(`undeclared third party ${origin} referenced in ${[...where].join(', ')} — add it to privacy/third-parties.json after review`);
+}
+for (const origin of allowed.keys()) {
+  if (!referenced.has(origin)) warn(`${origin} is inventoried but no longer referenced — remove it from the inventory and CSP`);
+}
+
+// --- CSP consistency -----------------------------------------------------------------------------
+const html = read('index.html');
+const metaCsp = (html.match(/http-equiv=["']Content-Security-Policy["'][\s\S]*?content=(["'])([\s\S]*?)\1/i) || [])[2];
+const headerRules = parseHeadersFile(read('_headers'));
+const globalHeaders = (headerRules.find((r) => r.path === '/*') || { headers: {} }).headers;
+const headerCsp = globalHeaders['content-security-policy'];
+
+if (!metaCsp) fail('index.html: missing <meta http-equiv="Content-Security-Policy"> fallback');
+if (!headerCsp) fail('_headers: missing Content-Security-Policy for /*');
+
+if (metaCsp && headerCsp) {
+  const meta = parseCsp(metaCsp);
+  const header = parseCsp(headerCsp);
+  // frame-ancestors is ignored in <meta>, so it's expected only in the header.
+  const norm = (m) => JSON.stringify([...m].filter(([k]) => k !== 'frame-ancestors').sort());
+  if (norm(meta) !== norm(header)) fail('CSP in index.html <meta> and _headers differ — keep them in sync');
+
+  for (const [origin, directives] of cspOrigins(header)) {
+    const tp = allowed.get(origin);
+    if (!tp) {
+      fail(`CSP allows ${origin} which is not in privacy/third-parties.json`);
+      continue;
+    }
+    for (const d of directives) {
+      if (!(tp.cspDirectives || []).includes(d)) fail(`CSP grants ${origin} "${d}" but inventory only lists ${JSON.stringify(tp.cspDirectives)}`);
+    }
+  }
+  for (const [origin, tp] of allowed) {
+    for (const d of tp.cspDirectives || []) {
+      if (!(header.get(d) || []).includes(origin)) fail(`inventory lists ${origin} under ${d} but the CSP doesn't allow it`);
+    }
+  }
+}
+
+const metaReferrer = (html.match(/<meta\s+name=["']referrer["']\s+content=["']([^"']+)/i) || [])[1];
+if (metaReferrer !== globalHeaders['referrer-policy']) fail('Referrer-Policy in <meta> and _headers differ');
+
+// --- Required headers --------------------------------------------------------------------------
+for (const [name, ok] of Object.entries(REQUIRED_HEADERS)) {
+  const value = globalHeaders[name];
+  if (!value) fail(`_headers: missing ${name} for /*`);
+  else if (!ok(value)) fail(`_headers: ${name} is too weak: "${value}"`);
+}
+const account = headerRules.find((r) => r.path.startsWith('/account'));
+if (!account || !/no-store/.test(account.headers['cache-control'] || '')) {
+  fail('_headers: account pages must be served with Cache-Control: no-store');
+}
+
+// --- GPC support declaration ---------------------------------------------------------------
+try {
+  const gpc = JSON.parse(read('.well-known/gpc.json'));
+  if (gpc.gpc !== true) fail('.well-known/gpc.json must declare "gpc": true');
+} catch {
+  fail('missing or invalid .well-known/gpc.json');
+}
+
+// --- Report ----------------------------------------------------------------------------------
+console.log(`Privacy audit: scanned ${files.length} files, ${referenced.size} third-party origin(s), ${allowed.size} inventoried.`);
+for (const w of warnings) console.log(`  warn  ${w}`);
+for (const e of errors) console.log(`  FAIL  ${e}`);
+if (errors.length) {
+  console.log(`\n${errors.length} problem(s) found.`);
+  process.exit(1);
+}
+console.log('\nAll privacy checks passed.');
