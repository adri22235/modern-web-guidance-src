index 0000000..b5d8db7
--- /dev/null
+++ b/assets/js/privacy.js
@@ -0,0 +1,234 @@
+/*
+ * The Daily Grind — client-side privacy controls.
+ *
+ * Principles:
+ *  - Privacy by default: optional categories are off until the visitor opts in.
+ *  - Respect browser signals: Global Privacy Control (and legacy Do Not Track) force opt-out.
+ *  - Data minimization: we store one small record (choices + day-resolution date) in
+ *    localStorage, no cookies, no identifiers, and it expires so consent is re-confirmed.
+ *  - No third-party code runs unless it is declared as a consent-gated placeholder AND its
+ *    origin is allowed by the Content-Security-Policy.
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'dg_privacy';
+  var SCHEMA_VERSION = 1;
+  var MAX_AGE_DAYS = 180;
+  var CATEGORIES = ['analytics', 'marketing'];
+
+  // Query parameters used for cross-site tracking; they're removed from the address bar so they
+  // don't end up in bookmarks, shared links, screenshots or same-origin Referer headers.
+  var TRACKING_PARAMS = /^(utm_[a-z_]+|fbclid|gclid|gclsrc|dclid|gbraid|wbraid|msclkid|mc_cid|mc_eid|yclid|igshid|twclid|ttclid|li_fat_id|_hsenc|_hsmi|_ga|_gl|mkt_tok|oly_anon_id|oly_enc_id|vero_id|s_cid)$/i;
+
+  // Local keys that belong to a signed-in session and must not outlive it on a shared device.
+  // The consent record is a device-level preference and is intentionally kept.
+  var SESSION_KEY_PREFIX = 'dg_session_';
+
+  function privacySignalEnabled() {
+    var nav = window.navigator;
+    return nav.globalPrivacyControl === true ||
+      nav.doNotTrack === '1' || window.doNotTrack === '1';
+  }
+
+  function today() {
+    // Day resolution is enough to expire consent; a full timestamp would be needless precision.
+    return new Date().toISOString().slice(0, 10);
+  }
+
+  function safeStorage() {
+    try {
+      var probe = '__dg_probe__';
+      window.localStorage.setItem(probe, probe);
+      window.localStorage.removeItem(probe);
+      return window.localStorage;
+    } catch (e) {
+      return null; // Storage disabled or blocked: behave as "no consent".
+    }
+  }
+
+  function denyAll() {
+    var choices = {};
+    CATEGORIES.forEach(function (c) { choices[c] = false; });
+    return choices;
+  }
+
+  function readConsent() {
+    var store = safeStorage();
+    if (!store) return null;
+    var raw = store.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    try {
+      var record = JSON.parse(raw);
+      var ageDays = (Date.parse(today()) - Date.parse(record.date)) / 86400000;
+      if (record.v !== SCHEMA_VERSION || !(ageDays >= 0 && ageDays <= MAX_AGE_DAYS)) {
+        store.removeItem(STORAGE_KEY);
+        return null;
+      }
+      // Only accept known categories with strict booleans; ignore anything else.
+      var choices = denyAll();
+      CATEGORIES.forEach(function (c) { choices[c] = record.choices && record.choices[c] === true; });
+      return choices;
+    } catch (e) {
+      store.removeItem(STORAGE_KEY);
+      return null;
+    }
+  }
+
+  function writeConsent(choices) {
+    var store = safeStorage();
+    if (!store) return;
+    var minimal = {};
+    CATEGORIES.forEach(function (c) { minimal[c] = choices[c] === true; });
+    store.setItem(STORAGE_KEY, JSON.stringify({ v: SCHEMA_VERSION, date: today(), choices: minimal }));
+  }
+
+  function effectiveConsent() {
+    // A browser privacy signal always wins over a stored or default choice.
+    if (privacySignalEnabled()) return denyAll();
+    return readConsent() || denyAll();
+  }
+
+  // Activates <script type="text/plain" data-consent="analytics" data-src="https://...">
+  // placeholders for categories the visitor has opted into. Inline placeholders are not
+  // supported on purpose: the CSP forbids inline script.
+  function loadConsentedScripts(choices) {
+    var placeholders = document.querySelectorAll('script[type="text/plain"][data-consent]');
+    Array.prototype.forEach.call(placeholders, function (placeholder) {
+      var category = placeholder.getAttribute('data-consent');
+      var src = placeholder.getAttribute('data-src');
+      if (!choices[category] || !src || placeholder.hasAttribute('data-loaded')) return;
+      var script = document.createElement('script');
+      script.src = src;
+      script.async = true;
+      script.referrerPolicy = 'no-referrer';
+      if (placeholder.getAttribute('integrity')) {
+        script.integrity = placeholder.getAttribute('integrity');
+        script.crossOrigin = 'anonymous';
+      }
+      placeholder.setAttribute('data-loaded', '');
+      placeholder.parentNode.insertBefore(script, placeholder.nextSibling);
+    });
+  }
+
+  function hasConsentGatedContent() {
+    return document.querySelector('script[type="text/plain"][data-consent]') !== null;
+  }
+
+  function stripTrackingParams() {
+    if (!window.history || !window.history.replaceState || !window.URL) return;
+    var url = new URL(window.location.href);
+    var removed = false;
+    Array.from(url.searchParams.keys()).forEach(function (key) {
+      if (TRACKING_PARAMS.test(key)) {
+        url.searchParams.delete(key);
+        removed = true;
+      }
+    });
+    if (removed) window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
+  }
+
+  // Cross-origin links never get a Referer or window.opener, regardless of how they were authored.
+  function hardenExternalLinks() {
+    Array.prototype.forEach.call(document.querySelectorAll('a[href]'), function (a) {
+      if (a.origin && a.origin !== window.location.origin && /^https?:$/.test(a.protocol)) {
+        var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+        ['noopener', 'noreferrer'].forEach(function (r) { if (rel.indexOf(r) === -1) rel.push(r); });
+        a.setAttribute('rel', rel.join(' '));
+        a.referrerPolicy = 'no-referrer';
+      }
+    });
+  }
+
+  function clearSessionData() {
+    var store = safeStorage();
+    try {
+      if (window.sessionStorage) window.sessionStorage.clear();
+    } catch (e) { /* storage blocked */ }
+    if (!store) return;
+    for (var i = store.length - 1; i >= 0; i--) {
+      var key = store.key(i);
+      if (key && key.indexOf(SESSION_KEY_PREFIX) === 0) store.removeItem(key);
+    }
+  }
+
+  function setupLogout() {
+    Array.prototype.forEach.call(document.querySelectorAll('form[data-clears-local-data]'), function (form) {
+      form.addEventListener('submit', clearSessionData);
+    });
+    // Don't show a signed-in page restored from the back/forward cache after logout.
+    window.addEventListener('pageshow', function (event) {
+      if (event.persisted) window.location.reload();
+    });
+  }
+
+  function setupDialog() {
+    var dialog = document.getElementById('privacy-choices');
+    if (!dialog || typeof dialog.showModal !== 'function') return;
+
+    var signal = privacySignalEnabled();
+    var boxes = dialog.querySelectorAll('[data-consent-category]');
+    var notice = dialog.querySelector('[data-gpc-notice]');
+    if (notice) notice.hidden = !signal;
+
+    function syncForm() {
+      var current = effectiveConsent();
+      Array.prototype.forEach.call(boxes, function (box) {
+        box.checked = current[box.getAttribute('data-consent-category')] === true;
+        box.disabled = signal;
+      });
+    }
+
+    function open() {
+      syncForm();
+      dialog.showModal();
+    }
+
+    dialog.addEventListener('close', function () {
+      var action = dialog.returnValue;
+      // Esc / dismiss records nothing: the visitor stays opted out.
+      if (action !== 'accept' && action !== 'reject' && action !== 'save') return;
+      var choices = denyAll();
+      if (!signal) {
+        Array.prototype.forEach.call(boxes, function (box) {
+          var category = box.getAttribute('data-consent-category');
+          choices[category] = action === 'accept' || (action === 'save' && box.checked);
+        });
+      }
+      // Revoking consent can't unload code that already ran; reload so it's gone.
+      var previously = loadedCategories();
+      writeConsent(choices);
+      loadConsentedScripts(choices);
+      if (CATEGORIES.some(function (c) { return previously[c] && !choices[c]; })) window.location.reload();
+    });
+
+    Array.prototype.forEach.call(document.querySelectorAll('[data-open-privacy-choices]'), function (btn) {
+      btn.addEventListener('click', open);
+    });
+
+    // Only interrupt the visitor when there's actually something to consent to.
+    if (!signal && readConsent() === null && hasConsentGatedContent()) open();
+  }
+
+  function loadedCategories() {
+    var loaded = {};
+    Array.prototype.forEach.call(document.querySelectorAll('script[data-consent][data-loaded]'), function (s) {
+      loaded[s.getAttribute('data-consent')] = true;
+    });
+    return loaded;
+  }
+
+  function init() {
+    stripTrackingParams();
+    hardenExternalLinks();
+    setupLogout();
+    loadConsentedScripts(effectiveConsent());
+    setupDialog();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
