diff --git a/privacy.js b/privacy.js
new file mode 100644
index 0000000..8bfa773
--- /dev/null
+++ b/privacy.js
@@ -0,0 +1,16 @@
+// Privacy-by-design client helpers. This site intentionally ships no
+// analytics, advertising, or third-party scripts; see PRIVACY-AUDIT.md.
+(() => {
+  'use strict';
+
+  // Data minimization: drop campaign/click identifiers from the address bar so
+  // they aren't persisted in history, bookmarks, shared links, or Referer.
+  const TRACKING_PARAMS = /^(utm_\w+|fbclid|gclid|gbraid|wbraid|dclid|msclkid|mc_eid|mc_cid|_hsenc|_hsmi|igshid|yclid|twclid|ttclid|li_fat_id)$/i;
+
+  const url = new URL(window.location.href);
+  const tracked = [...url.searchParams.keys()].filter((key) => TRACKING_PARAMS.test(key));
+  if (tracked.length > 0) {
+    tracked.forEach((key) => url.searchParams.delete(key));
+    window.history.replaceState(window.history.state, '', url);
+  }
+})();
