+  <script>
+    // Keep aria-invalid in sync with the :user-invalid state of the delivery form
+    const addressForm = document.querySelector('.address-form');
+    const syncAria = (el) => {
+      if (!el.matches?.('input, textarea, select')) return;
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+    addressForm.addEventListener('blur', (e) => syncAria(e.target), true);
+    addressForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    addressForm.addEventListener('invalid', (e) => {
+      // Runs after a submit attempt, when :user-invalid starts matching
+      requestAnimationFrame(() => syncAria(e.target));
+    }, true);
+  </script>
+
