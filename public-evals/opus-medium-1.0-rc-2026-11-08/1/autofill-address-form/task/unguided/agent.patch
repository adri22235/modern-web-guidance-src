+
+    .form-field .optional {
+      font-weight: normal;
+      color: #8d6e63;
+      font-size: 0.8rem;
+    }
+
+    .form-field input,
+    .form-field select {
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+    }
+
+    .form-field input:focus,
+    .form-field select:focus {
