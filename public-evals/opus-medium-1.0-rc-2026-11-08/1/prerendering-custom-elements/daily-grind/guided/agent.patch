+  <script type="module">
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    function readFavorites() {
+      try {
+        return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+      } catch {
+        return new Set();
+      }
+    }
+
+    function writeFavorites(favorites) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota); keep in-memory state only.
+      }
+    }
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorite'];
+
+      #button;
+
+      constructor() {
+        super();
+
+        // Reuse the server-rendered declarative shadow root. Only engines without
+        // DSD support reach this branch; build the root from the same inert template.
+        if (!this.shadowRoot) {
+          const template = this.querySelector(':scope > template[shadowrootmode]');
+          if (!template) return;
+          this.attachShadow({ mode: template.getAttribute('shadowrootmode') });
+          this.shadowRoot.append(template.content);
+          template.remove();
+        }
+
+        // Hydrate in place: wire behavior to the existing markup, never re-render it.
+        this.#button = this.shadowRoot.querySelector('.favorite');
+        this.#button?.addEventListener('click', () => this.toggleFavorite());
+      }
+
+      connectedCallback() {
+        const id = this.getAttribute('drink-id');
+        if (id && readFavorites().has(id)) this.favorite = true;
+      }
+
+      attributeChangedCallback() {
+        this.#button?.setAttribute('aria-pressed', String(this.favorite));
+      }
+
+      get favorite() {
+        return this.hasAttribute('favorite');
+      }
+
+      set favorite(value) {
+        this.toggleAttribute('favorite', Boolean(value));
+      }
+
+      toggleFavorite() {
+        this.favorite = !this.favorite;
+
+        const id = this.getAttribute('drink-id');
+        if (id) {
+          const favorites = readFavorites();
+          this.favorite ? favorites.add(id) : favorites.delete(id);
+          writeFavorites(favorites);
+        }
+
+        this.dispatchEvent(new CustomEvent('favorite-change', {
+          bubbles: true,
+          detail: { id, favorite: this.favorite },
+        }));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
