+  <script type="module">
+    // Hydrates server-rendered <drink-card> elements in place. The markup and styles
+    // already exist via declarative shadow DOM, so we only attach behavior here.
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    const loadFavorites = () => {
+      try {
+        return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) || []);
+      } catch {
+        return new Set();
+      }
+    };
+
+    const saveFavorites = (favorites) => {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota); keep in-memory state only.
+      }
+    };
+
+    class DrinkCard extends HTMLElement {
+      connectedCallback() {
+        if (this.button) return;
+
+        let root = this.shadowRoot;
+        if (!root) {
+          // Fallback for browsers without declarative shadow DOM support.
+          const template = this.querySelector(':scope > template[shadowrootmode]');
+          if (!template) return;
+          root = this.attachShadow({ mode: 'open' });
+          root.appendChild(template.content);
+          template.remove();
+        }
+
+        this.button = root.querySelector('.fav');
+        this.name = this.querySelector('[slot="title"]')?.textContent.trim() ?? 'this drink';
+        this.button.addEventListener('click', () => this.toggle());
+        this.render(loadFavorites().has(this.drinkId));
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id');
+      }
+
+      toggle() {
+        const favorites = loadFavorites();
+        const next = !favorites.has(this.drinkId);
+        next ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+        saveFavorites(favorites);
+        this.render(next);
+      }
+
+      // Updates attributes only; the existing DOM is never replaced.
+      render(favorited) {
+        this.toggleAttribute('favorited', favorited);
+        this.button.setAttribute('aria-pressed', String(favorited));
+        this.button.setAttribute('aria-label', `${favorited ? 'Remove' : 'Add'} ${this.name} ${favorited ? 'from' : 'to'} favorites`);
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
