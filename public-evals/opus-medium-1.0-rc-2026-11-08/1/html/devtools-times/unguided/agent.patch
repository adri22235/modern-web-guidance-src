+}
+
+/* Keep the page from scrolling behind an open modal dialog. */
+html:has(dialog[open]:modal) {
+  overflow: hidden;
+}
+
+/* Main navigation flyout: a top-layer popover anchored to the bottom edge of the main nav. */
+.nav-flyout {
+  position: fixed;
+  position-anchor: --main-nav;
+  inset: auto;
+  top: anchor(bottom);
+  left: anchor(left);
+  width: anchor-size(width);
+  margin: 0;
+  padding: 0;
+  overflow: visible;
+}
+
+@supports not (top: anchor(bottom)) {
+  /* Without anchor positioning, BottomNav sets --nav-flyout-* from the nav's geometry. */
+  .nav-flyout {
+    position: absolute;
+    top: var(--nav-flyout-top, 0);
+    left: var(--nav-flyout-left, 0);
+    width: var(--nav-flyout-width, 100%);
+  }
+}
