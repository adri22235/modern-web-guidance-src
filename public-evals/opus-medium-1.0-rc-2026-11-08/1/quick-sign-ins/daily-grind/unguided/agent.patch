+  <script>
+    /*
+     * In-page sign-in. Links marked [data-requires-auth] open this dialog instead of
+     * redirecting to a login page; after sign-in the customer continues to that link.
+     *
+     * Expected endpoints (same origin, cookie-based session):
+     *   GET  /api/auth/session          -> 200 { user } when signed in, 401 otherwise
+     *   POST /api/auth/login            -> { username, password }
+     *   GET  /api/auth/passkey/options  -> WebAuthn PublicKeyCredentialRequestOptions (JSON)
+     *   POST /api/auth/passkey/verify   -> PublicKeyCredential JSON
+     */
+    (() => {
+      const dialog = document.getElementById('signin-dialog');
+      const form = document.getElementById('signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const submitBtn = document.getElementById('signin-submit');
+      const passkeyBtn = document.getElementById('passkey-btn');
+      const passkeyDivider = document.getElementById('passkey-divider');
+      const errorBox = document.getElementById('signin-error');
+      const subtitle = document.getElementById('signin-subtitle');
+      const toast = document.getElementById('toast');
+
+      const DEFAULT_SUBTITLE = subtitle.textContent;
+      const supportsPasskeys = 'PublicKeyCredential' in window && !!navigator.credentials;
+      const supportsPasswordCredential = 'PasswordCredential' in window;
+
+      let signedIn = false;
+      let pendingHref = null;
+      let conditionalAbort = null;
+
+      // ---------- helpers ----------
+
+      const b64urlToBuffer = (value) => {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        return Uint8Array.from(atob(padded), (c) => c.charCodeAt(0)).buffer;
+      };
+
+      const bufferToB64url = (buffer) =>
+        btoa(String.fromCharCode(...new Uint8Array(buffer)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      const toRequestOptions = (json) => {
+        if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) })),
+        };
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') return cred.toJSON();
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment,
+          clientExtensionResults: cred.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null,
+          },
+        };
+      };
+
+      const postJSON = async (url, body) => {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(body),
+        });
+        if (!res.ok) {
+          let message = res.status === 401 ? 'That email and password don’t match our records.' : 'Sign-in failed. Please try again.';
+          try { message = (await res.json()).message || message; } catch (_) { /* non-JSON body */ }
+          throw new Error(message);
+        }
+        return res.json().catch(() => ({}));
+      };
+
+      const showError = (message) => {
+        errorBox.textContent = message;
+        errorBox.hidden = false;
+      };
+
+      const clearError = () => {
+        errorBox.hidden = true;
+        errorBox.textContent = '';
+      };
+
+      const setBusy = (busy) => {
+        submitBtn.disabled = busy;
+        passkeyBtn.disabled = busy;
+        submitBtn.textContent = busy ? 'Signing in…' : 'Sign In';
+      };
+
+      let toastTimer;
+      const showToast = (message) => {
+        toast.textContent = message;
+        toast.hidden = false;
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => { toast.hidden = true; }, 3000);
+      };
+
+      const updateNav = () => {
+        document.querySelectorAll('[data-signin]').forEach((el) => { el.hidden = signedIn; });
+        document.querySelectorAll('[data-logout]').forEach((el) => { el.hidden = !signedIn; });
+      };
+
+      // ---------- session ----------
+
+      const checkSession = async () => {
+        try {
+          const res = await fetch('/api/auth/session', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
+          signedIn = res.ok;
+        } catch (_) {
+          signedIn = false;
+        }
+        updateNav();
+      };
+
+      const onSignedIn = (user) => {
+        signedIn = true;
+        updateNav();
+        const destination = pendingHref;
+        pendingHref = null;
+        dialog.close();
+        const name = user && (user.firstName || user.name);
+        showToast(name ? `Welcome back, ${name}!` : 'Welcome back!');
+        if (destination) window.location.assign(destination);
+      };
+
+      // ---------- passkeys ----------
+
+      const fetchPasskeyOptions = async () => {
+        const res = await fetch('/api/auth/passkey/options', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
+        if (!res.ok) throw new Error('Passkey sign-in is unavailable right now.');
+        const json = await res.json();
+        return toRequestOptions(json.publicKey || json);
+      };
+
+      const verifyPasskey = async (credential) => {
+        const data = await postJSON('/api/auth/passkey/verify', credentialToJSON(credential));
+        onSignedIn(data.user);
+      };
+
+      const abortConditional = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      };
+
+      // Passkey autofill: browser suggests saved passkeys alongside saved passwords in the email field.
+      const startConditionalPasskey = async () => {
+        if (!supportsPasskeys || !PublicKeyCredential.isConditionalMediationAvailable) return;
+        try {
+          if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+          abortConditional();
+          const controller = new AbortController();
+          conditionalAbort = controller;
+          const publicKey = await fetchPasskeyOptions();
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'conditional', signal: controller.signal });
+          if (conditionalAbort === controller) conditionalAbort = null;
+          if (credential) {
+            setBusy(true);
+            try {
+              await verifyPasskey(credential);
+            } finally {
+              setBusy(false);
+            }
+          }
+        } catch (err) {
+          if (err.name !== 'AbortError' && err.name !== 'NotAllowedError') showError(err.message);
+        }
+      };
+
+      passkeyBtn.addEventListener('click', async () => {
+        clearError();
+        abortConditional();
+        setBusy(true);
+        try {
+          const publicKey = await fetchPasskeyOptions();
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'required' });
+          if (credential) await verifyPasskey(credential);
+        } catch (err) {
+          if (err.name === 'NotAllowedError') showError('Passkey sign-in was cancelled. You can try again or use your password.');
+          else if (err.name !== 'AbortError') showError(err.message);
+        } finally {
+          setBusy(false);
+          if (dialog.open && !signedIn) startConditionalPasskey();
+        }
+      });
+
+      // ---------- saved passwords ----------
+
+      // Browsers with the Credential Management API can offer saved passwords without typing.
+      // Throws (with the username prefilled) if a saved password was picked but rejected.
+      const trySavedPassword = async () => {
+        if (!supportsPasswordCredential) return false;
+        let cred;
+        try {
+          cred = await navigator.credentials.get({ password: true, mediation: 'optional' });
+        } catch (_) {
+          return false;
+        }
+        if (!cred || cred.type !== 'password') return false;
+        usernameInput.value = cred.id;
+        const data = await postJSON('/api/auth/login', { username: cred.id, password: cred.password });
+        signedIn = true;
+        updateNav();
+        return data.user || true;
+      };
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        clearError();
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username || !password) {
+          showError('Please enter your email and password.');
+          (username ? passwordInput : usernameInput).focus();
+          return;
+        }
+        abortConditional();
+        setBusy(true);
+        try {
+          const data = await postJSON('/api/auth/login', { username, password });
+          // Ask the browser to save/update this password, since we never did a page navigation.
+          if (supportsPasswordCredential) {
+            try {
+              await navigator.credentials.store(new PasswordCredential({ id: username, password, name: data.user && data.user.name }));
+            } catch (_) { /* saving is best-effort */ }
+          }
+          onSignedIn(data.user);
+        } catch (err) {
+          showError(err.message);
+          passwordInput.select();
+          startConditionalPasskey();
+        } finally {
+          setBusy(false);
+        }
+      });
+
+      // ---------- dialog ----------
+
+      const openSignIn = (href, label) => {
+        pendingHref = href || null;
+        clearError();
+        subtitle.textContent = label ? `Sign in to continue to ${label}.` : DEFAULT_SUBTITLE;
+        passkeyBtn.hidden = passkeyDivider.hidden = !supportsPasskeys;
+        if (!dialog.open) dialog.showModal();
+        (usernameInput.value ? passwordInput : usernameInput).focus();
+        startConditionalPasskey();
+      };
+
+      dialog.addEventListener('close', () => {
+        abortConditional();
+        passwordInput.value = '';
+        setBusy(false);
+        if (!signedIn) pendingHref = null;
+      });
+
+      dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
+
+      // Close when clicking the backdrop.
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) dialog.close();
+      });
+
+      document.querySelectorAll('[data-signin]').forEach((el) =>
+        el.addEventListener('click', () => openSignIn(null))
+      );
+
+      document.addEventListener('click', async (event) => {
+        const link = event.target.closest('a[data-requires-auth]');
+        if (!link || signedIn) return;
+        // Let modified clicks (new tab, etc.) behave normally.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const label = link.textContent.trim();
+        // Offer a one-tap saved password first where supported; otherwise show the dialog.
+        try {
+          if (await trySavedPassword()) {
+            window.location.assign(link.href);
+            return;
+          }
+          openSignIn(link.href, label);
+        } catch (err) {
+          openSignIn(link.href, label);
+          showError(err.message);
+          passwordInput.focus();
+        }
+      });
+
+      document.querySelectorAll('[data-logout]').forEach((el) =>
+        el.addEventListener('click', async (event) => {
+          event.preventDefault();
+          try {
+            await fetch(el.getAttribute('href'), { method: 'POST', credentials: 'same-origin' });
+          } catch (_) { /* fall through */ }
+          if (navigator.credentials && navigator.credentials.preventSilentAccess) {
+            navigator.credentials.preventSilentAccess().catch(() => {});
+          }
+          signedIn = false;
+          updateNav();
+          showToast('You’ve been signed out.');
+        })
+      );
+
+      checkSession();
+    })();
+  </script>
+
 </body>
 
