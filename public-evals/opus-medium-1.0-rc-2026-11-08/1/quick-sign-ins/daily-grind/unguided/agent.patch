+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title">
+    <form id="signin-form" method="post" action="/api/auth/login" novalidate>
+      <div class="signin-header">
+        <h2 id="signin-title">Welcome back</h2>
+        <button type="button" class="signin-close" data-close aria-label="Close sign-in">&times;</button>
+      </div>
+      <p class="signin-subtitle" id="signin-subtitle">Sign in to keep going. You'll stay right where you are.</p>
+
+      <div class="signin-error" id="signin-error" role="alert" hidden></div>
+
+      <button type="button" class="btn btn-passkey" id="passkey-btn" hidden>Sign in with a passkey</button>
+      <div class="signin-divider" id="passkey-divider" hidden>or use your password</div>
+
+      <label class="signin-field">
+        Email
+        <input type="email" name="username" id="signin-username" autocomplete="username webauthn" required
+          inputmode="email" autocapitalize="off" spellcheck="false">
+      </label>
+      <label class="signin-field">
+        Password
+        <input type="password" name="password" id="signin-password" autocomplete="current-password" required>
+      </label>
+
+      <button type="submit" class="btn" id="signin-submit">Sign In</button>
+
+      <p class="signin-footer">
+        <a href="/account/forgot-password">Forgot password?</a> &middot;
+        <a href="/account/register">Create an account</a>
+      </p>
+    </form>
