+      if (!cred) throw new DOMException('No credential returned', 'NotAllowedError');
+      return verifyCredential(cred, publicKey);
+    }
+
+    // Conditional UI: passkeys appear in the email field's autofill while the dialog is open.
+    async function startConditionalAutofill() {
