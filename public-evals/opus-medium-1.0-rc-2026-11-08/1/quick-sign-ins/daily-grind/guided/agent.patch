+  <script type="module">
+    // Load polyfills only where the newer WebAuthn helpers are missing.
+    if (window.PublicKeyCredential &&
+      (!PublicKeyCredential.getClientCapabilities || !PublicKeyCredential.parseRequestOptionsFromJSON)) {
+      try {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      } catch (err) {
+        console.warn('WebAuthn polyfills failed to load:', err);
+      }
+    }
+
+    const dialog = document.getElementById('signin-dialog');
+    const form = document.getElementById('signin-form');
+    const errorEl = document.getElementById('signin-error');
+    const subtitle = document.getElementById('signin-subtitle');
+    const passkeyBtn = document.getElementById('passkey-signin');
+    const passwordInput = document.getElementById('signin-password');
+    const togglePassword = document.getElementById('toggle-password');
+
+    // Where to go once the user is signed in (null = stay on this page).
+    let pendingDestination = null;
+    let isAuthenticating = false;
+    let autofillAbortController = null;
+
+    const isSignedIn = () => document.body.dataset.signedIn === 'true';
+
+    async function getCapabilities() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return {};
+      try {
+        return (await PublicKeyCredential.getClientCapabilities()) ?? {};
+      } catch {
+        return {};
+      }
+    }
+
+    async function fetchRequestOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST' });
+      if (!res.ok) throw new Error('Failed to fetch authentication options');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    // Verifies either a passkey assertion or a saved password with the server.
+    async function verifyCredential(cred, publicKey) {
+      if (cred.type === 'public-key') {
+        const encoded = cred.toJSON();
+        const res = await postJSON('/api/login/verify', encoded);
+        if (res.status === 404) {
+          if (publicKey && PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // server-provided RP ID, never location.hostname
+              credentialId: encoded.id,
+            });
+          }
+          throw new Error('That passkey is no longer recognized. Please sign in another way.');
+        }
+        if (!res.ok) throw new Error('Passkey sign-in failed. Please try again.');
+        return res.json();
+      }
+      if (cred.type === 'password') {
+        const res = await postJSON('/api/login/password', { username: cred.id, password: cred.password });
+        if (!res.ok) throw new Error('Saved password was not accepted. Please sign in manually.');
+        return res.json();
+      }
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    function completeSignIn() {
+      document.body.dataset.signedIn = 'true';
+      stopConditionalAutofill();
+      if (dialog.open) dialog.close('signed-in');
+      const destination = pendingDestination;
+      pendingDestination = null;
+      if (destination) window.location.assign(destination);
+    }
+
+    // Quick sign-in: offers saved passkeys/passwords in place. Throws NotAllowedError
+    // if unsupported or no local credentials exist, so callers can fall back.
+    async function quickSignIn() {
+      const caps = await getCapabilities();
+      if (!caps.immediateGet) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+      stopConditionalAutofill();
+      const publicKey = await fetchRequestOptions();
+      // No signal and no allowCredentials: both are rejected in immediate mode.
