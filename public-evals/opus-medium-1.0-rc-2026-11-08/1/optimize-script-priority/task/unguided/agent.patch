diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,31 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Dashboard</title>
+
+  <!-- Critical interactivity: fetch in parallel, run as soon as it arrives -->
+  <script src="/js/app.js" async></script>
+
+  <!-- Legacy widgets: deferred so it no longer blocks the parser; runs in order after parsing -->
+  <script src="/js/legacy-widgets.js" defer></script>
+
+  <!-- Analytics: independent and non-critical -->
+  <script src="/js/tracker.js" async></script>
+
+  <style>
+    body { font-family: system-ui, sans-serif; margin: 0; padding: 1rem; }
+    main { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
+    section { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; }
+  </style>
+</head>
+<body>
+  <header><h1>Dashboard</h1></header>
+  <main>
+    <section id="summary"><h2>Summary</h2></section>
+    <section id="activity"><h2>Activity</h2></section>
+    <section id="widgets"><h2>Widgets</h2></section>
+  </main>
+</body>
+</html>
