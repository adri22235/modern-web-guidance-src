+  <script>
+    // Summarize the Roaster's Journal with the browser's built-in Summarizer API (on-device AI).
+    (async () => {
+      const button = document.getElementById('summarize-btn');
+      const summaryBox = document.getElementById('journal-summary');
+      const statusEl = document.getElementById('summary-status');
+      const listEl = document.getElementById('summary-list');
+      const journalText = document.getElementById('journal-text');
+
+      if (!('Summarizer' in self)) return;
+
+      const options = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: 'An article from a specialty coffee shop website about how they source their coffee beans.'
+      };
+
+      let availability;
+      try {
+        availability = await Summarizer.availability(options);
+      } catch {
+        return;
+      }
+      if (availability === 'unavailable') return;
+
+      button.hidden = false;
+      let summarizer = null;
+
+      const setStatus = (text) => {
+        statusEl.textContent = text;
+        statusEl.hidden = !text;
+      };
+
+      // Render markdown bullet output as list items using textContent (never innerHTML).
+      const renderBullets = (markdown) => {
+        listEl.replaceChildren();
+        const lines = markdown.split('\n').map((line) => line.trim()).filter(Boolean);
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line.replace(/^([-*•]|\d+\.)\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1');
+          listEl.append(li);
+        }
+      };
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        summaryBox.hidden = false;
+        listEl.replaceChildren();
+
+        try {
+          if (!summarizer) {
+            setStatus('Preparing on-device AI…');
+            summarizer = await Summarizer.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  setStatus(`Downloading AI model… ${Math.round(e.loaded * 100)}%`);
+                });
+              }
+            });
+          }
+
+          setStatus('Summarizing…');
+          const text = journalText.innerText.trim();
+          let result = '';
+          for await (const chunk of summarizer.summarizeStreaming(text)) {
+            result += chunk;
+            setStatus('');
+            renderBullets(result);
+          }
+          if (!result.trim()) setStatus('No summary was generated. Please try again.');
+        } catch (err) {
+          console.error(err);
+          setStatus('Sorry, we couldn\'t summarize this right now.');
+        } finally {
+          button.disabled = false;
+          button.textContent = 'Summarize Again';
+        }
+      });
+    })();
+  </script>
+
