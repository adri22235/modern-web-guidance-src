+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const summary = document.getElementById('summary');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-body');
+
+      const options = {
+        sharedContext: "A coffee roaster's journal entry about how they source their beans",
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+
+      let summarizer = null;
+
+      if (!('Summarizer' in self)) {
+        button.disabled = true;
+        status.textContent = 'On-device summarization is not supported in this browser.';
+        return;
+      }
+
+      Summarizer.availability(options).then((availability) => {
+        if (availability === 'unavailable') {
+          button.disabled = true;
+          status.textContent = 'On-device summarization is not available on this device.';
+        }
+      }).catch(() => {
+        button.disabled = true;
+        status.textContent = 'On-device summarization is not available on this device.';
+      });
+
+      function renderBullets(text) {
+        const items = text
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        list.replaceChildren(...items.map((item) => {
+          const li = document.createElement('li');
+          li.textContent = item;
+          return li;
+        }));
+      }
+
+      async function getSummarizer() {
+        if (summarizer) return summarizer;
+        // Must be called from the click handler: model download requires a user gesture.
+        summarizer = await Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading on-device model… ${Math.round(e.loaded * 100)}%`;
+            });
+          }
+        });
+        return summarizer;
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        status.textContent = 'Preparing summarizer…';
+        try {
+          const s = await getSummarizer();
+          status.textContent = 'Summarizing…';
+          summary.hidden = false;
+          list.replaceChildren();
+          let text = '';
+          for await (const chunk of s.summarizeStreaming(source.innerText.trim())) {
+            text += chunk;
+            renderBullets(text);
+          }
+          status.textContent = 'Summary generated on your device.';
+        } catch (err) {
+          console.error(err);
+          summary.hidden = list.children.length === 0;
+          status.textContent = 'Sorry, the summary could not be generated. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
