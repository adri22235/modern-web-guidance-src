+          description: 'Coarse-ground Colombian beans steeped in cold filtered water for 18 hours for a naturally sweet, low-acid cup.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1040&q=80',
+          alt: 'Iced coffee in a tall glass',
+          meta: ['Served over ice', '10 cal', 'Low acid'],
+          price: '$4.50'
+        }
+      };
+
+      const dialog = document.querySelector('.drink-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') return; // fall back to links
+
+      const closeBtn = dialog.querySelector('.dialog-close');
+      let returnFocusTo = null;
+      let closeFallback = null;
+
+      function fillDialog(drink) {
+        const img = dialog.querySelector('img');
+        img.src = drink.image;
+        img.alt = drink.alt;
+        dialog.querySelector('h3').textContent = drink.name;
+        dialog.querySelector('.description').textContent = drink.description;
+        dialog.querySelector('.price').textContent = drink.price;
+        const meta = dialog.querySelector('.meta');
+        meta.replaceChildren.apply(meta, drink.meta.map(function (text) {
+          const li = document.createElement('li');
+          li.textContent = text;
+          return li;
+        }));
+      }
+
+      function finishClose() {
+        clearTimeout(closeFallback);
+        dialog.removeEventListener('animationend', onCloseAnimationEnd);
+        dialog.classList.remove('is-closing');
+        if (dialog.open) dialog.close();
+        if (returnFocusTo) returnFocusTo.focus();
+        returnFocusTo = null;
+      }
+
+      function onCloseAnimationEnd(event) {
+        if (event.target === dialog && !event.pseudoElement) finishClose();
+      }
+
+      function openDialog(drink, trigger) {
+        if (dialog.classList.contains('is-closing')) finishClose();
+        fillDialog(drink);
+        returnFocusTo = trigger;
+        dialog.showModal();
+        closeBtn.focus();
+      }
+
+      function closeDialog() {
+        if (!dialog.open || dialog.classList.contains('is-closing')) return;
+        dialog.classList.add('is-closing');
+        dialog.addEventListener('animationend', onCloseAnimationEnd);
+        // Safety net in case animationend never fires (e.g. animations disabled)
+        closeFallback = setTimeout(finishClose, 400);
+      }
+
+      document.querySelectorAll('.card .btn').forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          const drink = drinks[btn.closest('.card').dataset.drink];
+          if (!drink) return;
+          event.preventDefault();
+          openDialog(drink, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDialog);
+
+      // Escape: animate out instead of closing instantly
+      dialog.addEventListener('cancel', function (event) {
+        event.preventDefault();
+        closeDialog();
+      });
+
+      // Click on the backdrop (outside the dialog box) closes it
+      dialog.addEventListener('click', function (event) {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        const inside = event.clientX >= rect.left && event.clientX <= rect.right &&
+          event.clientY >= rect.top && event.clientY <= rect.bottom;
+        if (!inside) closeDialog();
+      });
+    })();
+  </script>
+
 </body>
 
