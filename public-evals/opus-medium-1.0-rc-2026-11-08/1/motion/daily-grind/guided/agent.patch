+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    // Firefox/Safari can't keep the dialog in the top layer while it transitions out,
+    // so play the exit transition first and close once it has finished.
+    async function closeDialog() {
