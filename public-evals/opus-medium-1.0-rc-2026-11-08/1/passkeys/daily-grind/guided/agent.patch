diff --git a/js/account.js b/js/account.js
new file mode 100644
index 0000000..9c9a5c8
--- /dev/null
+++ b/js/account.js
@@ -0,0 +1,632 @@
+/*
+ * My Account: passkey sign-up, sign-in, passkey management, profile updates
+ * and reauthentication for The Daily Grind.
+ *
+ * Expected backend contract (same-origin JSON, session cookie). WebAuthn
+ * options are generated and verified server-side with a vetted FIDO2 library
+ * (e.g. SimpleWebAuthn); the browser only calls the native WebAuthn APIs.
+ *
+ *   GET    /api/session                -> 200 { user: { name, displayName } } | 401
+ *   POST   /api/auth/signin/options    -> PublicKeyCredentialRequestOptionsJSON (allowCredentials: [])
+ *   POST   /api/auth/signin/verify     <- assertion JSON  -> 200 { user } | 404 unknown credential
+ *   POST   /api/auth/signin/password   <- { email, password } -> 200 { user }
+ *   POST   /api/auth/signup/options    <- { name, displayName } -> creation options (platform attachment)
+ *   POST   /api/auth/signup/verify     <- attestation JSON -> 200 { user }
+ *   POST   /api/auth/signup/password   <- { name, displayName, password } -> 200 { user }
+ *   POST   /api/auth/signout
+ *   GET    /api/credentials            -> { rpId, userId, credentials: StoredPasskeyCredential[] }
+ *   POST   /api/credentials/options    <- { promotion: false } -> creation options (any attachment)
+ *   POST   /api/credentials/verify     <- attestation JSON
+ *   PUT    /api/credential/:id         <- { name }
+ *   DELETE /api/credential/:id         (requires recent reauth, else 403)
+ *   PUT    /api/user                   <- { name, displayName } -> { name, displayName, rpId, userId }
+ *                                      (requires recent reauth, else 403)
+ *   POST   /api/reauth/options         -> request options with allowCredentials = user's passkeys
+ *   POST   /api/reauth/verify          <- assertion JSON (must belong to the signed-in user)
+ *   POST   /api/reauth/password        <- { password }
+ */
+
+const WEBAUTHN_POLYFILL_URL = 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+// Load webauthn-polyfills only where PublicKeyCredential exists but the
+// JSON helpers or getClientCapabilities() are missing.
+const webauthnReady = (async () => {
+  if (!window.PublicKeyCredential) return;
+  const missing =
+    !PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.prototype.toJSON;
+  if (missing) {
+    try {
+      await import(WEBAUTHN_POLYFILL_URL);
+    } catch (e) {
+      console.warn('WebAuthn polyfill failed to load:', e);
+    }
+  }
+})();
+
+if (!('commandForElement' in HTMLButtonElement.prototype)) {
+  import('https://esm.run/invokers-polyfill');
+}
+
+const $ = (selector) => document.querySelector(selector);
+
+const dialog = $('#account-dialog');
+const signedOutView = $('#account-signed-out');
+const signedInView = $('#account-signed-in');
+const signinForm = $('#signin-form');
+const signupForm = $('#signup-form');
+const profileForm = $('#profile-form');
+const passkeyList = $('#passkey-list');
+const passkeyTemplate = $('#passkey-row');
+const createPasskeyButton = $('#create-passkey');
+const reauthDialog = $('#reauth-dialog');
+const reauthForm = $('#reauth-form');
+const renameDialog = $('#rename-dialog');
+const renameForm = $('#rename-form');
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+let currentUser = null;
+let passkeyState = { rpId: null, userId: null, credentials: [] };
+let autofillAbortController = new AbortController();
+
+/* ---------- helpers ---------- */
+
+function api(path, { method = 'GET', body } = {}) {
+  return fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+async function errorMessage(response, fallback) {
+  try {
+    const data = await response.json();
+    return data.error || fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function setStatus(element, message, isError = false) {
+  element.textContent = message;
+  element.classList.toggle('error', isError);
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value) {
+  return typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function getCapabilities() {
+  await webauthnReady;
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return {};
+  try {
+    return await PublicKeyCredential.getClientCapabilities();
+  } catch {
+    return {};
+  }
+}
+
+async function canCreatePasskey() {
+  const capabilities = await getCapabilities();
+  return Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet);
+}
+
+async function signalUnknownCredential(rpId, credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+async function syncAcceptedCredentials() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const { rpId, userId, credentials } = passkeyState;
+  const credentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL IDs are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Server-provided rpId; never window.location.hostname
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncCurrentUserDetails({ rpId, userId, name, displayName }) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+function abortAutofill() {
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+}
+
+/* ---------- passkey creation (shared by sign-up and management) ---------- */
+
+// Returns the server's verify Response, or null if the user cancelled / it failed client-side.
+async function createPasskey({ optionsPath, optionsBody, verifyPath, statusElement }) {
+  await webauthnReady;
+  abortAutofill();
+
+  const optionsResponse = await api(optionsPath, { method: 'POST', body: optionsBody });
+  if (!optionsResponse.ok) {
+    setStatus(statusElement, await errorMessage(optionsResponse, 'Could not start passkey creation.'), true);
+    return null;
+  }
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      setStatus(statusElement, 'A passkey for this account already exists in this password manager.', true);
+    } else if (err.name === 'SecurityError') {
+      console.error('Passkey configuration error (RP ID or secure context):', err);
+      setStatus(statusElement, 'Passkeys are not available on this connection.', true);
+    } else if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+      setStatus(statusElement, 'Passkey creation was cancelled.');
+    } else {
+      setStatus(statusElement, 'Something went wrong creating your passkey.', true);
+    }
+    return null;
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const response = await api(verifyPath, { method: 'POST', body: encoded });
+    if (!response.ok) {
+      await signalUnknownCredential(publicKey.rp.id, encoded.id);
+      setStatus(statusElement, await errorMessage(response, 'We could not save your passkey.'), true);
+      return null;
+    }
+    return response;
+  } catch (serverErr) {
+    console.error('Passkey verification network failure:', serverErr);
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    setStatus(statusElement, 'Network error while saving your passkey.', true);
+    return null;
+  }
+}
+
+/* ---------- sign-in ---------- */
+
+async function completeSignin(response) {
+  const { user } = await response.json();
+  signinForm.reset();
+  signupForm.reset();
+  await showSignedIn(user);
+}
+
+// Handles an assertion from either the autofill or button flow.
+async function verifySigninAssertion(publicKey, credential, statusElement) {
+  const encoded = credential.toJSON();
+  try {
+    const response = await api('/api/auth/signin/verify', { method: 'POST', body: encoded });
+    if (response.ok) {
+      await completeSignin(response);
+      return;
+    }
+    if (response.status === 404) {
+      // Unauthenticated + credential unknown to the server: let the password manager drop it.
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+      setStatus(statusElement, 'That passkey is no longer registered. Sign in another way.', true);
+    } else {
+      setStatus(statusElement, await errorMessage(response, 'Passkey sign-in failed.'), true);
+    }
+  } catch (err) {
+    console.error('Passkey sign-in verification error:', err);
+    setStatus(statusElement, 'Network error while signing in.', true);
+  }
+  startConditionalSignin();
+}
+
+async function startConditionalSignin() {
+  if (currentUser) return;
+  const capabilities = await getCapabilities();
+  if (capabilities.conditionalGet !== true) return;
+
+  const { signal } = autofillAbortController;
+  let publicKey;
+  try {
+    const optionsResponse = await api('/api/auth/signin/options', { method: 'POST' });
+    if (!optionsResponse.ok) return;
+    publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+  } catch (e) {
+    console.warn('Passkey autofill unavailable:', e);
+    return;
+  }
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal, mediation: 'conditional' });
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes(err.name)) {
+      console.error('Unexpected conditional passkey error:', err);
+    }
+    return;
+  }
+  await verifySigninAssertion(publicKey, credential, $('#signin-status'));
+}
+
+async function signInWithPasskeyButton() {
+  const status = $('#signin-status');
+  await webauthnReady;
+  abortAutofill();
+
+  const optionsResponse = await api('/api/auth/signin/options', { method: 'POST' });
+  if (!optionsResponse.ok) {
+    setStatus(status, await errorMessage(optionsResponse, 'Could not start passkey sign-in.'), true);
+    startConditionalSignin();
+    return;
+  }
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal: autofillAbortController.signal });
+  } catch (err) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+      setStatus(status, 'Passkey sign-in was cancelled.');
+    } else {
+      setStatus(status, 'Passkey sign-in failed.', true);
+    }
+    startConditionalSignin(); // Re-arm autofill after a cancelled button prompt
+    return;
+  }
+  await verifySigninAssertion(publicKey, credential, status);
+}
+
+signinForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const status = $('#signin-status');
+  const data = new FormData(signinForm);
+  setStatus(status, 'Signing in…');
+  const response = await api('/api/auth/signin/password', {
+    method: 'POST',
+    body: { email: data.get('email'), password: data.get('password') },
+  });
+  if (!response.ok) {
+    setStatus(status, await errorMessage(response, 'Incorrect email or password.'), true);
+    return;
+  }
+  abortAutofill();
+  await completeSignin(response);
+});
+
+$('#signin-passkey').addEventListener('click', signInWithPasskeyButton);
+
+/* ---------- sign-up ---------- */
+
+signupForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const status = $('#signup-status');
+  const data = new FormData(signupForm);
+  const name = data.get('email');
+  const displayName = data.get('displayName');
+
+  if (signupForm.dataset.mode === 'password') {
+    const response = await api('/api/auth/signup/password', {
+      method: 'POST',
+      body: { name, displayName, password: data.get('password') },
+    });
+    if (!response.ok) {
+      setStatus(status, await errorMessage(response, 'We could not create your account.'), true);
+      return;
+    }
+    abortAutofill();
+    await completeSignin(response);
+    return;
+  }
+
+  setStatus(status, 'Follow the prompt to create your passkey…');
+  const response = await createPasskey({
+    optionsPath: '/api/auth/signup/options',
+    optionsBody: { name, displayName },
+    verifyPath: '/api/auth/signup/verify',
+    statusElement: status,
+  });
+  if (response) {
+    await completeSignin(response);
+  } else {
+    startConditionalSignin();
+  }
+});
+
+/* ---------- reauthentication ---------- */
+
+function askForPassword() {
+  return new Promise((resolve) => {
+    reauthForm.reset();
+    setStatus($('#reauth-status'), '');
+    reauthDialog.returnValue = '';
+    reauthDialog.addEventListener('close', () => {
+      const confirmed = reauthDialog.returnValue === 'confirm';
+      reauthDialog.returnValue = '';
+      resolve(confirmed ? new FormData(reauthForm).get('password') : null);
+    }, { once: true });
+    reauthDialog.showModal();
+  });
+}
+
+async function reauthWithPassword(statusElement) {
+  const password = await askForPassword();
+  if (!password) {
+    setStatus(statusElement, 'Verification was cancelled.');
+    return false;
+  }
+  const response = await api('/api/reauth/password', { method: 'POST', body: { password } });
+  if (!response.ok) {
+    setStatus(statusElement, await errorMessage(response, 'That password is incorrect.'), true);
+    return false;
+  }
+  return true;
+}
+
+async function reauthWithPasskey(statusElement) {
+  await webauthnReady;
+  const optionsResponse = await api('/api/reauth/options', { method: 'POST' });
+  if (!optionsResponse.ok) {
+    setStatus(statusElement, await errorMessage(optionsResponse, 'Could not start verification.'), true);
+    return false;
+  }
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey });
+  } catch (err) {
+    setStatus(statusElement, err.name === 'NotAllowedError' ? 'Verification was cancelled.' : 'Verification failed.', err.name !== 'NotAllowedError');
+    return false;
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const response = await api('/api/reauth/verify', { method: 'POST', body: encoded });
+    if (response.ok) return true;
+    if (response.status === 404) {
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+    }
+    setStatus(statusElement, await errorMessage(response, 'We could not verify it’s you.'), true);
+  } catch (err) {
+    console.error('Reauthentication verification error:', err);
+    setStatus(statusElement, 'Network error during verification.', true);
+  }
+  return false;
+}
+
+// Confirm the signed-in user's identity before a sensitive change.
+async function reauthenticate(statusElement) {
+  setStatus(statusElement, 'Confirm it’s you to continue…');
+  await webauthnReady;
+  const hasPasskeys = passkeyState.credentials.length > 0;
+  if (hasPasskeys && window.PublicKeyCredential?.parseRequestOptionsFromJSON) {
+    return reauthWithPasskey(statusElement);
+  }
+  return reauthWithPassword(statusElement);
+}
+
+/* ---------- profile ---------- */
+
+function fillProfile(user) {
+  $('#account-greeting').textContent = user.displayName || user.name;
+  profileForm.elements.displayName.value = user.displayName ?? '';
+  profileForm.elements.email.value = user.name ?? '';
+}
+
+profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const status = $('#profile-status');
+  const data = new FormData(profileForm);
+  const name = data.get('email');
+  const displayName = data.get('displayName');
+
+  if (!(await reauthenticate(status))) return;
+
+  const response = await api('/api/user', { method: 'PUT', body: { name, displayName } });
+  if (!response.ok) {
+    setStatus(status, await errorMessage(response, 'We could not update your profile.'), true);
+    return;
+  }
+  const updated = await response.json();
+  currentUser = { name: updated.name, displayName: updated.displayName };
+  fillProfile(currentUser);
+  setStatus(status, 'Profile updated.');
+  await syncCurrentUserDetails({
+    rpId: updated.rpId,
+    userId: updated.userId,
+    name: updated.name,
+    displayName: updated.displayName,
+  });
+});
+
+/* ---------- passkey management ---------- */
+
+function renderPasskeys() {
+  const { credentials } = passkeyState;
+  passkeyList.replaceChildren();
+  $('#passkey-empty').hidden = credentials.length > 0;
+
+  for (const credential of credentials) {
+    const row = passkeyTemplate.content.firstElementChild.cloneNode(true);
+    const icon = row.querySelector('.passkey-icon');
+    if (credential.providerIcon) {
+      icon.src = credential.providerIcon;
+    } else {
+      icon.remove();
+    }
+    row.querySelector('.passkey-name').textContent = credential.name || 'Unknown passkey provider';
+    row.querySelector('.passkey-created').textContent =
+      `Created ${dateFormat.format(new Date(credential.registeredAt))}`;
+    row.querySelector('.passkey-used').textContent = credential.lastUsedAt
+      ? `Last used ${dateFormat.format(new Date(credential.lastUsedAt))}`
+      : 'Never used';
+    if (credential.credentialBackedUp) {
+      row.querySelector('.passkey-synced').hidden = false;
+    }
+
+    const renameButton = row.querySelector('.passkey-rename');
+    const deleteButton = row.querySelector('.passkey-delete');
+    const label = credential.name || 'passkey';
+    renameButton.setAttribute('aria-label', `Rename ${label}`);
+    deleteButton.setAttribute('aria-label', `Delete ${label}`);
+    renameButton.addEventListener('click', () => renamePasskey(credential));
+    deleteButton.addEventListener('click', () => deletePasskey(credential));
+
+    passkeyList.append(row);
+  }
+}
+
+async function loadPasskeys() {
+  const response = await api('/api/credentials');
+  if (!response.ok) {
+    setStatus($('#passkey-status'), 'We could not load your passkeys.', true);
+    return;
+  }
+  passkeyState = await response.json();
+  renderPasskeys();
+}
+
+function askForName(currentName) {
+  return new Promise((resolve) => {
+    renameForm.elements.passkeyName.value = currentName ?? '';
+    renameDialog.returnValue = '';
+    renameDialog.addEventListener('close', () => {
+      const confirmed = renameDialog.returnValue === 'save';
+      renameDialog.returnValue = '';
+      resolve(confirmed ? renameForm.elements.passkeyName.value.trim() : null);
+    }, { once: true });
+    renameDialog.showModal();
+  });
+}
+
+async function renamePasskey(credential) {
+  const status = $('#passkey-status');
+  const name = await askForName(credential.name);
+  if (!name || name === credential.name) return;
+
+  // Nickname is a server-side label only; no Signal API call needed.
+  const response = await api(`/api/credential/${encodeURIComponent(credential.id)}`, {
+    method: 'PUT',
+    body: { name },
+  });
+  if (!response.ok) {
+    setStatus(status, await errorMessage(response, 'We could not rename that passkey.'), true);
+    return;
+  }
+  await loadPasskeys();
+  setStatus(status, `Renamed passkey to “${name}”.`);
+}
+
+async function deletePasskey(credential) {
+  const status = $('#passkey-status');
+  if (!(await reauthenticate(status))) return;
+
+  const response = await api(`/api/credential/${encodeURIComponent(credential.id)}`, { method: 'DELETE' });
+  if (!response.ok) {
+    setStatus(status, await errorMessage(response, 'We could not delete that passkey.'), true);
+    return;
+  }
+  await loadPasskeys();
+  setStatus(status, `Deleted “${credential.name || 'passkey'}”. Also remove it from your password manager if it’s still listed.`);
+  await syncAcceptedCredentials();
+}
+
+createPasskeyButton.addEventListener('click', async () => {
+  const status = $('#passkey-status');
+  setStatus(status, 'Follow the prompt to create your passkey…');
+  const response = await createPasskey({
+    optionsPath: '/api/credentials/options',
+    optionsBody: { promotion: false }, // Management flow: allow security keys too
+    verifyPath: '/api/credentials/verify',
+    statusElement: status,
+  });
+  if (response) {
+    await loadPasskeys();
+    setStatus(status, 'Passkey created.');
+  }
+});
+
+/* ---------- views ---------- */
+
+async function showSignedIn(user) {
+  currentUser = user;
+  signedOutView.hidden = true;
+  signedInView.hidden = false;
+  $('#nav-logout').hidden = false;
+  fillProfile(user);
+
+  createPasskeyButton.hidden = !(await canCreatePasskey());
+  $('#passkey-unsupported').hidden = !createPasskeyButton.hidden;
+
+  await loadPasskeys();
+  await syncAcceptedCredentials();
+}
+
+async function showSignedOut() {
+  currentUser = null;
+  passkeyState = { rpId: null, userId: null, credentials: [] };
+  signedInView.hidden = true;
+  signedOutView.hidden = false;
+  $('#nav-logout').hidden = true;
+
+  // Without passkey support, sign-up falls back to a password.
+  const passkeys = await canCreatePasskey();
+  signupForm.dataset.mode = passkeys ? 'passkey' : 'password';
+  const passwordField = $('#signup-password-field');
+  passwordField.hidden = passkeys;
+  passwordField.querySelector('input').required = !passkeys;
+  $('#signup-submit').textContent = passkeys ? 'Create account with a passkey' : 'Create account';
+  $('#signin-passkey').hidden = !(await getCapabilities()).passkeyPlatformAuthenticator;
+
+  startConditionalSignin();
+}
+
+$('#signout').addEventListener('click', async () => {
+  await api('/api/auth/signout', { method: 'POST' });
+  await showSignedOut();
+});
+
+async function init() {
+  try {
+    const response = await api('/api/session');
+    if (response.ok) {
+      const { user } = await response.json();
+      await showSignedIn(user);
+      return;
+    }
+  } catch (e) {
+    console.warn('Could not load session:', e);
+  }
+  await showSignedOut();
+}
+
+// Deep links such as /#account open the dialog directly.
+if (location.hash === '#account') dialog.showModal();
+
+init();
