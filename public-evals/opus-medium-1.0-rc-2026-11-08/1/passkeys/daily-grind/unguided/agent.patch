diff --git a/css/account.css b/css/account.css
new file mode 100644
index 0000000..6c56e4d
--- /dev/null
+++ b/css/account.css
@@ -0,0 +1,371 @@
+/* My Account dialog & passkey management */
+
+[hidden] {
+  display: none !important;
+}
+
+.hero-greeting {
+  color: var(--accent);
+  font-weight: 600;
+  letter-spacing: 0.5px;
+  margin-bottom: 0.5rem;
+}
+
+dialog {
+  border: none;
+  border-radius: 10px;
+  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+  margin: auto;
+  padding: 24px;
+}
+
+dialog::backdrop {
+  background: rgba(30, 20, 15, 0.6);
+}
+
+.account-dialog {
+  width: min(640px, calc(100vw - 24px));
+  max-height: calc(100vh - 24px);
+}
+
+.small-dialog {
+  width: min(420px, calc(100vw - 24px));
+}
+
+.small-dialog h2,
+.account-dialog h2 {
+  color: var(--primary);
+  font-size: 1.35rem;
+  margin-bottom: 8px;
+}
+
+.account-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 12px;
+}
+
+.icon-btn {
+  background: none;
+  border: none;
+  font-size: 1.8rem;
+  line-height: 1;
+  cursor: pointer;
+  color: var(--text);
+  padding: 0 4px;
+}
+
+dialog label {
+  display: block;
+  font-size: 0.85rem;
+  font-weight: 600;
+  margin: 12px 0 4px;
+}
+
+dialog input {
+  width: 100%;
+  padding: 10px 12px;
+  border: 1px solid #bcaaa4;
+  border-radius: 5px;
+  font: inherit;
+}
+
+dialog input:focus-visible,
+dialog button:focus-visible,
+dialog a:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+dialog .btn {
+  border: none;
+  cursor: pointer;
+  font: inherit;
+}
+
+dialog .btn:disabled,
+.btn-outline:disabled,
+.btn-link:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+
+.btn-block {
+  width: 100%;
+}
+
+.btn-danger {
+  background: #b71c1c;
+}
+
+.btn-danger:hover {
+  background: #8e1414;
+}
+
+.btn-outline {
+  background: none;
+  border: 1px solid var(--primary);
+  color: var(--primary);
+  padding: 9px 18px;
+  border-radius: 5px;
+  font: inherit;
+  cursor: pointer;
+}
+
+.btn-outline:hover:not(:disabled) {
+  background: var(--secondary);
+}
+
+.btn-link {
+  background: none;
+  border: none;
+  color: var(--primary);
+  font: inherit;
+  font-size: 0.85rem;
+  text-decoration: underline;
+  cursor: pointer;
+  padding: 4px;
+}
+
+.btn-link.danger {
+  color: #b71c1c;
+}
+
+[aria-busy="true"] {
+  cursor: progress;
+}
+
+.notice {
+  padding: 10px 14px;
+  border-radius: 6px;
+  margin: 8px 0;
+  font-size: 0.9rem;
+  background: #fff3e0;
+  border-left: 4px solid var(--accent);
+}
+
+.notice[data-type="error"] {
+  background: #ffebee;
+  border-left-color: #c62828;
+  color: #8e1414;
+}
+
+.notice[data-type="success"] {
+  background: #e8f5e9;
+  border-left-color: #2e7d32;
+  color: #1b5e20;
+}
+
+.hint {
+  font-size: 0.8rem;
+  color: #6d4c41;
+  margin: 6px 0;
+}
+
+.tabs {
+  display: flex;
+  border-bottom: 2px solid var(--secondary);
+  margin-bottom: 8px;
+}
+
+.tabs [role="tab"] {
+  flex: 1;
+  background: none;
+  border: none;
+  border-bottom: 3px solid transparent;
+  margin-bottom: -2px;
+  padding: 10px;
+  font: inherit;
+  font-weight: 600;
+  color: #8d6e63;
+  cursor: pointer;
+}
+
+.tabs [role="tab"][aria-selected="true"] {
+  color: var(--primary);
+  border-bottom-color: var(--accent);
+}
+
+.explainer {
+  background: #efebe9;
+  border-radius: 6px;
+  padding: 12px 14px;
+  margin-top: 16px;
+  font-size: 0.85rem;
+}
+
+.switch {
+  text-align: center;
+  font-size: 0.85rem;
+  margin-top: 14px;
+}
+
+.switch a {
+  color: var(--primary);
+  font-weight: 600;
+}
+
+.summary {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 14px;
+  background: #efebe9;
+  border-radius: 8px;
+}
+
+.avatar {
+  flex: none;
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  background: var(--primary);
+  color: white;
+  display: grid;
+  place-items: center;
+  font-weight: bold;
+  font-size: 1.1rem;
+}
+
+.summary-text {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.summary-text small {
+  color: #6d4c41;
+}
+
+.account-section {
+  border-top: 1px solid var(--secondary);
+  margin-top: 20px;
+  padding-top: 16px;
+}
+
+.account-section h3 {
+  color: var(--primary);
+  font-size: 1.05rem;
+}
+
+.section-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.section-head .btn {
+  margin-top: 0;
+}
+
+.count {
+  display: inline-block;
+  background: var(--secondary);
+  border-radius: 10px;
+  padding: 0 8px;
+  font-size: 0.8rem;
+  vertical-align: middle;
+}
+
+.field-row {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0 14px;
+}
+
+.passkey-list {
+  list-style: none;
+  margin-top: 8px;
+}
+
+.passkey {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+  margin-bottom: 8px;
+}
+
+.passkey-icon {
+  flex: none;
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  background: #fff3e0;
+  color: var(--primary);
+  display: grid;
+  place-items: center;
+}
+
+.passkey-info {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  overflow-wrap: anywhere;
+}
+
+.passkey-info small {
+  color: #6d4c41;
+  font-size: 0.78rem;
+}
+
+.passkey-title {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.badge {
+  background: #e8f5e9;
+  color: #1b5e20;
+  border-radius: 10px;
+  padding: 0 8px;
+  font-size: 0.72rem;
+  font-weight: 600;
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 4px;
+  flex: none;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 18px;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+}
+
+@media (max-width: 560px) {
+  .field-row {
+    grid-template-columns: 1fr;
+  }
+
+  .passkey {
+    flex-wrap: wrap;
+  }
+
+  .passkey-actions {
+    width: 100%;
+    justify-content: flex-end;
+  }
+
+  .summary {
+    flex-wrap: wrap;
+  }
+}
