@@ -0,0 +1,180 @@
+// Browser-side WebAuthn helpers: feature detection, JSON <-> binary conversion
+// for ceremony options/results, Signal API wrappers and friendly error messages.
+
+export const b64url = {
+  encode(buf) {
+    const bytes = buf instanceof Uint8Array ? buf : new Uint8Array(buf);
+    let str = '';
+    for (const b of bytes) str += String.fromCharCode(b);
+    return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  decode(str) {
+    const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+    const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+    return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+  },
+};
+
+export function isWebAuthnSupported() {
+  return window.isSecureContext && typeof window.PublicKeyCredential === 'function'
+    && !!navigator.credentials?.create;
+}
+
+export async function getCapabilities() {
+  const caps = { conditionalGet: false, platformAuthenticator: false };
+  if (!isWebAuthnSupported()) return caps;
+  try {
+    if (PublicKeyCredential.getClientCapabilities) {
+      const c = await PublicKeyCredential.getClientCapabilities();
+      caps.conditionalGet = !!c.conditionalGet;
+      caps.platformAuthenticator = !!c.userVerifyingPlatformAuthenticator;
+      return caps;
+    }
+    caps.conditionalGet = !!(await PublicKeyCredential.isConditionalMediationAvailable?.());
+    caps.platformAuthenticator =
+      await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch { /* leave defaults */ }
+  return caps;
+}
+
+function toCreationOptions(json) {
+  if (PublicKeyCredential.parseCreationOptionsFromJSON) {
+    return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+  }
+  return {
+    ...json,
+    challenge: b64url.decode(json.challenge),
+    user: { ...json.user, id: b64url.decode(json.user.id) },
+    excludeCredentials: (json.excludeCredentials || []).map((c) => ({ ...c, id: b64url.decode(c.id) })),
+  };
+}
+
+function toRequestOptions(json) {
+  if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+    return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+  }
+  return {
+    ...json,
+    challenge: b64url.decode(json.challenge),
+    allowCredentials: (json.allowCredentials || []).map((c) => ({ ...c, id: b64url.decode(c.id) })),
+  };
+}
+
+function registrationToJSON(cred) {
+  const r = cred.response;
+  // Build manually rather than relying on toJSON(): we need publicKey and
+  // authenticatorData, which some toJSON() implementations omit.
+  return {
+    id: cred.id,
+    rawId: b64url.encode(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? null,
+    clientExtensionResults: cred.getClientExtensionResults?.() ?? {},
+    response: {
+      clientDataJSON: b64url.encode(r.clientDataJSON),
+      attestationObject: b64url.encode(r.attestationObject),
+      authenticatorData: r.getAuthenticatorData ? b64url.encode(r.getAuthenticatorData()) : null,
+      publicKey: r.getPublicKey?.() ? b64url.encode(r.getPublicKey()) : null,
+      publicKeyAlgorithm: r.getPublicKeyAlgorithm?.() ?? null,
+      transports: r.getTransports?.() ?? [],
+    },
+  };
+}
+
+function assertionToJSON(cred) {
+  const r = cred.response;
+  return {
+    id: cred.id,
+    rawId: b64url.encode(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? null,
+    clientExtensionResults: cred.getClientExtensionResults?.() ?? {},
+    response: {
+      clientDataJSON: b64url.encode(r.clientDataJSON),
+      authenticatorData: b64url.encode(r.authenticatorData),
+      signature: b64url.encode(r.signature),
+      userHandle: r.userHandle ? b64url.encode(r.userHandle) : null,
+    },
+  };
+}
+
+export async function createPasskey(optionsJSON) {
+  const cred = await navigator.credentials.create({ publicKey: toCreationOptions(optionsJSON) });
+  return registrationToJSON(cred);
+}
+
+/**
+ * Run an authentication ceremony. `mediation: 'conditional'` shows passkeys in
+ * the autofill dropdown of an `autocomplete="username webauthn"` field.
+ */
+export async function getPasskey(optionsJSON, { mediation, signal } = {}) {
+  const cred = await navigator.credentials.get({
+    publicKey: toRequestOptions(optionsJSON),
+    ...(mediation ? { mediation } : {}),
+    ...(signal ? { signal } : {}),
+  });
+  return assertionToJSON(cred);
+}
+
+// --- Signal API: keep the user's passkey provider in sync with the server. ---
+// All calls are best-effort and silently skipped where unsupported.
+
+export async function signalUnknownCredential(rpId, credentialId) {
+  try { await PublicKeyCredential.signalUnknownCredential?.({ rpId, credentialId }); } catch { /* ignore */ }
+}
+
+export async function signalAcceptedCredentials(rpId, userId, allAcceptedCredentialIds) {
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials?.({ rpId, userId, allAcceptedCredentialIds });
+  } catch { /* ignore */ }
+}
+
+export async function signalUserDetails(rpId, userId, name, displayName) {
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails?.({ rpId, userId, name, displayName });
+  } catch { /* ignore */ }
+}
+
+/** Returns null for user cancellations (nothing to show), otherwise a message. */
+export function describeWebAuthnError(err, ceremony) {
+  switch (err?.name) {
+    case 'NotAllowedError':
+      return null;
+    case 'AbortError':
+      return null;
+    case 'InvalidStateError':
+      return ceremony === 'create'
+        ? 'This device or password manager already has a passkey for your account.'
+        : 'The authenticator is in an invalid state. Please try again.';
+    case 'SecurityError':
+      return 'Passkeys aren’t available on this domain. Make sure you’re using HTTPS.';
+    case 'NotSupportedError':
+      return 'Your device doesn’t support a compatible passkey type.';
+    default:
+      return err?.message || 'Something went wrong with your passkey. Please try again.';
+  }
+}
+
+// Known passkey provider AAGUIDs (subset of the community passkey-authenticator-aaguids list).
+const PROVIDERS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey',
+};
+
+export function providerName(aaguid) {
+  return PROVIDERS[aaguid] || null;
+}
