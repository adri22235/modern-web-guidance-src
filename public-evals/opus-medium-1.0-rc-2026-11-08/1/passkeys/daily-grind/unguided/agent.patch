+// Mock relying-party backend for The Daily Grind.
+//
+// The site is static, so this module plays the role of the server: it issues
+// WebAuthn challenges, verifies registration and authentication responses with
+// WebCrypto, and keeps accounts, passkeys and sessions in browser storage. Each
+// exported method maps 1:1 to an HTTP endpoint (noted above it) so it can be
+// swapped for `fetch()` calls to a real backend without touching the UI.
+//
+// NOTE: a client-side "server" can be tampered with by the user and is only for
+// demonstration. Real deployments must run these checks server-side.
+
+import { b64url, providerName } from './webauthn.js';
+
+const DB_KEY = 'dg.rp.db.v1';
+const CHALLENGES_KEY = 'dg.rp.challenges.v1';
+const SESSION_KEY = 'dg.rp.session.v1';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const CEREMONY_TIMEOUT_MS = 5 * 60 * 1000;
+const SUPPORTED_ALGS = [-8, -7, -257]; // Ed25519, ES256, RS256
+const MAX_PASSKEY_NAME = 40;
+
+export const rp = {
+  id: location.hostname,
+  name: 'The Daily Grind',
+  origin: location.origin,
+};
+
+export class ApiError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.code = code;
+    this.details = details;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Storage
+// ---------------------------------------------------------------------------
+
+function loadDB() {
+  try {
+    const db = JSON.parse(localStorage.getItem(DB_KEY));
+    if (db?.users && db?.credentials) return db;
+  } catch { /* fall through */ }
+  return { users: {}, credentials: {} };
+}
+
+function saveDB(db) {
+  localStorage.setItem(DB_KEY, JSON.stringify(db));
+}
+
+function loadChallenges() {
+  try {
+    return JSON.parse(sessionStorage.getItem(CHALLENGES_KEY)) || {};
+  } catch {
+    return {};
+  }
+}
+
+function storeChallenge(challenge, record) {
+  const all = loadChallenges();
+  const now = Date.now();
+  for (const [k, v] of Object.entries(all)) if (v.expiresAt < now) delete all[k];
+  all[challenge] = { ...record, expiresAt: now + CHALLENGE_TTL_MS };
+  sessionStorage.setItem(CHALLENGES_KEY, JSON.stringify(all));
+}
+
+/** Challenges are single-use: consuming one removes it whether or not verification succeeds. */
+function consumeChallenge(challenge, purpose) {
+  const all = loadChallenges();
+  const record = all[challenge];
+  delete all[challenge];
+  sessionStorage.setItem(CHALLENGES_KEY, JSON.stringify(all));
+  if (!record || record.purpose !== purpose || record.expiresAt < Date.now()) {
+    throw new ApiError('invalid_challenge', 'This request has expired. Please try again.');
+  }
+  return record;
+}
+
+function randomId(bytes = 32) {
+  return b64url.encode(crypto.getRandomValues(new Uint8Array(bytes)));
+}
+
+// Sessions stand in for an HttpOnly session cookie (shared across tabs).
+function getSession(db) {
+  try {
+    const s = JSON.parse(localStorage.getItem(SESSION_KEY));
+    if (s && db.users[s.userId]) return s;
+  } catch { /* fall through */ }
+  return null;
+}
+
+function setSession(userId, credentialId, authTime = Date.now()) {
+  localStorage.setItem(SESSION_KEY, JSON.stringify({ userId, credentialId, authTime, token: randomId() }));
+}
+
+function requireSession(db) {
+  const s = getSession(db);
+  if (!s) throw new ApiError('unauthenticated', 'Please sign in to continue.');
+  return s;
+}
+
+function requireRecentAuth(session) {
+  if (Date.now() - session.authTime > REAUTH_WINDOW_MS) {
+    throw new ApiError('reauth_required', 'Please confirm it’s you to continue.');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Validation helpers
+// ---------------------------------------------------------------------------
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function normalizeEmail(email) {
+  const e = String(email || '').trim().toLowerCase();
+  if (!EMAIL_RE.test(e) || e.length > 254) {
+    throw new ApiError('invalid_email', 'Please enter a valid email address.');
+  }
+  return e;
+}
+
+function normalizeName(name) {
+  const n = String(name || '').trim().replace(/\s+/g, ' ');
+  if (!n) throw new ApiError('invalid_name', 'Please enter your name.');
+  if (n.length > 64) throw new ApiError('invalid_name', 'Name must be 64 characters or fewer.');
+  return n;
+}
+
+function findUserByEmail(db, email) {
+  return Object.values(db.users).find((u) => u.email === email) || null;
+}
+
+function userCredentials(db, userId) {
+  return Object.values(db.credentials).filter((c) => c.userId === userId);
+}
+
+// ---------------------------------------------------------------------------
+// WebAuthn verification
+// ---------------------------------------------------------------------------
+
+const enc = new TextEncoder();
+
+async function sha256(data) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', data));
+}
+
+function equalBytes(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+function concatBytes(...parts) {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let off = 0;
+  for (const p of parts) { out.set(p, off); off += p.length; }
+  return out;
+}
+
+function formatAaguid(bytes) {
+  const hex = [...bytes].map((b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+function parseAuthenticatorData(bytes) {
+  if (bytes.length < 37) throw new ApiError('invalid_response', 'Malformed authenticator data.');
+  const flagsByte = bytes[32];
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const parsed = {
+    rpIdHash: bytes.slice(0, 32),
+    flags: {
+      up: !!(flagsByte & 0x01),
+      uv: !!(flagsByte & 0x04),
+      be: !!(flagsByte & 0x08),
+      bs: !!(flagsByte & 0x10),
+      at: !!(flagsByte & 0x40),
+    },
+    signCount: view.getUint32(33),
+  };
+  if (parsed.flags.at) {
+    if (bytes.length < 55) throw new ApiError('invalid_response', 'Malformed attested credential data.');
+    parsed.aaguid = formatAaguid(bytes.slice(37, 53));
+    const idLen = view.getUint16(53);
+    parsed.credentialId = bytes.slice(55, 55 + idLen);
+  }
+  return parsed;
+}
+
+function verifyClientData(clientDataBytes, expectedType) {
+  let clientData;
+  try {
+    clientData = JSON.parse(new TextDecoder().decode(clientDataBytes));
+  } catch {
+    throw new ApiError('invalid_response', 'Malformed client data.');
+  }
+  if (clientData.type !== expectedType) {
+    throw new ApiError('invalid_response', 'Unexpected ceremony type.');
+  }
+  if (clientData.origin !== rp.origin || clientData.crossOrigin === true) {
+    throw new ApiError('invalid_response', 'Origin mismatch.');
+  }
+  return clientData;
+}
+
+async function verifyAuthenticatorFlags(authData) {
+  if (!equalBytes(authData.rpIdHash, await sha256(enc.encode(rp.id)))) {
+    throw new ApiError('invalid_response', 'Relying party mismatch.');
+  }
+  if (!authData.flags.up) throw new ApiError('invalid_response', 'User presence was not confirmed.');
+  if (!authData.flags.uv) {
+    throw new ApiError('invalid_response', 'Your device didn’t verify your identity (PIN, fingerprint or face).');
+  }
+  if (authData.flags.bs && !authData.flags.be) {
+    throw new ApiError('invalid_response', 'Inconsistent backup flags.');
+  }
+}
+
+// WebAuthn ECDSA signatures are ASN.1 DER; WebCrypto expects raw r||s.
+function derToRawEcdsa(der, size = 32) {
+  let i = 0;
+  if (der[i++] !== 0x30) throw new Error('bad sig');
+  if (der[i] & 0x80) i += (der[i] & 0x7f) + 1; else i++;
+  const readInt = () => {
+    if (der[i++] !== 0x02) throw new Error('bad sig');
+    const len = der[i++];
+    let int = der.slice(i, i + len);
+    i += len;
+    while (int.length > size && int[0] === 0) int = int.slice(1);
+    if (int.length > size) throw new Error('bad sig');
+    const out = new Uint8Array(size);
+    out.set(int, size - int.length);
+    return out;
+  };
+  return concatBytes(readInt(), readInt());
+}
+
+const ALG_PARAMS = {
+  [-7]: { importParams: { name: 'ECDSA', namedCurve: 'P-256' }, verifyParams: { name: 'ECDSA', hash: 'SHA-256' } },
+  [-257]: { importParams: { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, verifyParams: { name: 'RSASSA-PKCS1-v1_5' } },
+  [-8]: { importParams: { name: 'Ed25519' }, verifyParams: { name: 'Ed25519' } },
+};
+
+async function verifySignature(alg, spki, signature, data) {
+  const params = ALG_PARAMS[alg];
+  if (!params) return false;
+  try {
+    const key = await crypto.subtle.importKey('spki', spki, params.importParams, false, ['verify']);
+    const sig = alg === -7 ? derToRawEcdsa(signature) : signature;
+    return await crypto.subtle.verify(params.verifyParams, key, sig, data);
+  } catch {
+    return false;
+  }
+}
+
+async function verifyRegistration(credential, challengeRecord) {
+  const { response } = credential;
+  if (credential.type !== 'public-key' || !response?.clientDataJSON || !response?.attestationObject) {
+    throw new ApiError('invalid_response', 'Malformed registration response.');
+  }
+  const clientData = verifyClientData(b64url.decode(response.clientDataJSON), 'webauthn.create');
+  if (clientData.challenge !== challengeRecord.challenge) {
+    throw new ApiError('invalid_response', 'Challenge mismatch.');
+  }
+  if (!response.authenticatorData || !response.publicKey) {
+    throw new ApiError('unsupported_browser',
+      'Your browser didn’t share the passkey’s public key. Please update your browser and try again.');
+  }
+  if (!SUPPORTED_ALGS.includes(response.publicKeyAlgorithm)) {
+    throw new ApiError('unsupported_algorithm', 'This passkey uses an unsupported algorithm.');
+  }
+  const authData = parseAuthenticatorData(b64url.decode(response.authenticatorData));
+  await verifyAuthenticatorFlags(authData);
+  if (!authData.flags.at || !authData.credentialId) {
+    throw new ApiError('invalid_response', 'Missing attested credential data.');
+  }
+  if (b64url.encode(authData.credentialId) !== credential.id || credential.id !== credential.rawId) {
+    throw new ApiError('invalid_response', 'Credential ID mismatch.');
+  }
+  // attestation: 'none' was requested, so the attestation statement is not evaluated.
+  return { authData, clientData };
+}
+
+// ---------------------------------------------------------------------------
+// Public view models (never expose public keys / internals to the UI)
+// ---------------------------------------------------------------------------
+
+function publicUser(user) {
+  return { id: user.id, email: user.email, name: user.name, createdAt: user.createdAt };
+}
+
+function publicCredential(c) {
+  return {
+    id: c.id,
+    name: c.name,
+    aaguid: c.aaguid,
+    createdAt: c.createdAt,
+    lastUsedAt: c.lastUsedAt,
+    backupEligible: c.backupEligible,
+    backedUp: c.backedUp,
+    transports: c.transports,
+    authenticatorAttachment: c.authenticatorAttachment,
+  };
+}
+
+function sessionInfo(session) {
+  return { authTime: session.authTime, credentialId: session.credentialId, reauthWindowMs: REAUTH_WINDOW_MS };
+}
+
+function defaultPasskeyName(providerLabel, existing) {
+  const base = providerLabel || 'Passkey';
+  const taken = new Set(existing.map((c) => c.name));
+  if (!taken.has(base)) return base;
+  for (let n = 2; ; n++) if (!taken.has(`${base} (${n})`)) return `${base} (${n})`;
+}
+
+function registrationOptions({ user, exclude }) {
+  const challenge = randomId();
+  return {
+    challenge,
+    rp: { id: rp.id, name: rp.name },
+    user: { id: user.id, name: user.email, displayName: user.name },
+    pubKeyCredParams: SUPPORTED_ALGS.map((alg) => ({ type: 'public-key', alg })),
+    timeout: CEREMONY_TIMEOUT_MS,
+    attestation: 'none',
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+    excludeCredentials: exclude.map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+    extensions: { credProps: true },
+  };
+}
+
+function storeCredential(db, { userId, credential, authData, name }) {
+  const now = Date.now();
+  const record = {
+    id: credential.id,
+    userId,
+    publicKey: credential.response.publicKey,
+    alg: credential.response.publicKeyAlgorithm,
+    signCount: authData.signCount,
+    transports: credential.response.transports || [],
+    authenticatorAttachment: credential.authenticatorAttachment,
+    aaguid: authData.aaguid,
+    backupEligible: authData.flags.be,
+    backedUp: authData.flags.bs,
+    name,
+    createdAt: now,
+    lastUsedAt: now,
+  };
+  db.credentials[record.id] = record;
+  return record;
+}
+
+// ---------------------------------------------------------------------------
+// Endpoints
+// ---------------------------------------------------------------------------
+
+/** GET /api/account — current user, their passkeys and session freshness. */
+export async function getAccount() {
+  const db = loadDB();
+  const session = getSession(db);
+  if (!session) return null;
+  const user = db.users[session.userId];
+  return {
+    user: publicUser(user),
+    passkeys: userCredentials(db, user.id).map(publicCredential).sort((a, b) => b.createdAt - a.createdAt),
+    session: sessionInfo(session),
+  };
+}
+
+/** POST /api/register/options — start creating a new account with a passkey. */
+export async function startRegistration({ email, name }) {
+  const db = loadDB();
+  const normalizedEmail = normalizeEmail(email);
+  const normalizedName = normalizeName(name);
+  if (findUserByEmail(db, normalizedEmail)) {
+    throw new ApiError('email_taken', 'An account with this email already exists. Try signing in instead.');
+  }
+  const pendingUser = { id: randomId(16), email: normalizedEmail, name: normalizedName };
+  const options = registrationOptions({ user: pendingUser, exclude: [] });
+  storeChallenge(options.challenge, { purpose: 'register', challenge: options.challenge, pendingUser });
+  return options;
+}
+
+/** POST /api/register/verify — finish account creation and sign the user in. */
+export async function finishRegistration(credential) {
+  const db = loadDB();
+  const challenge = challengeFromCredential(credential);
+  const record = consumeChallenge(challenge, 'register');
+  const { authData } = await verifyRegistration(credential, record);
+  const { pendingUser } = record;
+
+  if (findUserByEmail(db, pendingUser.email)) {
+    throw new ApiError('email_taken', 'An account with this email already exists. Try signing in instead.');
+  }
+  if (db.credentials[credential.id]) {
+    throw new ApiError('credential_exists', 'This passkey is already registered.');
+  }
+  const user = { ...pendingUser, createdAt: Date.now() };
+  db.users[user.id] = user;
+  storeCredential(db, { userId: user.id, credential, authData, name: defaultPasskeyName(providerName(authData.aaguid), []) });
+  saveDB(db);
+  setSession(user.id, credential.id);
+  return getAccount();
+}
+
+/** POST /api/passkeys/options — add another passkey to the signed-in account (sensitive). */
+export async function startAddPasskey() {
+  const db = loadDB();
+  const session = requireSession(db);
+  requireRecentAuth(session);
+  const user = db.users[session.userId];
+  const options = registrationOptions({ user, exclude: userCredentials(db, user.id) });
+  storeChallenge(options.challenge, { purpose: 'add-passkey', challenge: options.challenge, userId: user.id });
+  return options;
+}
+
+/** POST /api/passkeys/verify */
+export async function finishAddPasskey(credential) {
+  const db = loadDB();
+  const session = requireSession(db);
+  const record = consumeChallenge(challengeFromCredential(credential), 'add-passkey');
+  if (record.userId !== session.userId) throw new ApiError('invalid_challenge', 'Session changed. Please try again.');
+  const { authData } = await verifyRegistration(credential, record);
+  if (db.credentials[credential.id]) {
+    throw new ApiError('credential_exists', 'This passkey is already registered.');
+  }
+  const existing = userCredentials(db, session.userId);
+  const stored = storeCredential(db, {
+    userId: session.userId, credential, authData, name: defaultPasskeyName(providerName(authData.aaguid), existing),
+  });
+  saveDB(db);
+  return publicCredential(stored);
+}
+
+/**
+ * POST /api/auth/options
+ * purpose 'login': discoverable credentials (empty allowCredentials) for
+ * passkey autofill or the "Sign in with a passkey" button.
+ * purpose 'reauth': limited to the signed-in user's passkeys.
+ */
+export async function startAuthentication({ purpose = 'login' } = {}) {
+  const db = loadDB();
+  const challenge = randomId();
+  const options = { challenge, rpId: rp.id, timeout: CEREMONY_TIMEOUT_MS, userVerification: 'required' };
+  const record = { purpose, challenge };
+  if (purpose === 'reauth') {
+    const session = requireSession(db);
+    options.allowCredentials = userCredentials(db, session.userId)
+      .map((c) => ({ type: 'public-key', id: c.id, transports: c.transports }));
+    record.userId = session.userId;
+  } else {
+    options.allowCredentials = [];
+  }
+  storeChallenge(challenge, record);
+  return options;
+}
+
+/** POST /api/auth/verify — verifies an assertion, then signs in or refreshes auth time. */
+export async function finishAuthentication(credential, { purpose = 'login' } = {}) {
+  const db = loadDB();
+  const record = consumeChallenge(challengeFromCredential(credential), purpose);
+  const { response } = credential;
+  if (credential.type !== 'public-key' || !response?.authenticatorData || !response?.signature) {
+    throw new ApiError('invalid_response', 'Malformed authentication response.');
+  }
+
+  const stored = db.credentials[credential.id];
+  if (!stored) {
+    // Lets the client tell the passkey provider to hide this stale passkey.
+    throw new ApiError('unknown_credential',
+      'That passkey isn’t linked to an account here anymore. It may have been removed — try another passkey or create an account.',
+      { credentialId: credential.id });
+  }
+  if (response.userHandle && response.userHandle !== stored.userId) {
+    throw new ApiError('invalid_response', 'Passkey does not belong to this account.');
+  }
+  if (purpose === 'reauth') {
+    const session = requireSession(db);
+    if (stored.userId !== session.userId || record.userId !== session.userId) {
+      throw new ApiError('wrong_account', 'Please use a passkey for the account you’re signed in to.');
+    }
+  }
+
+  const clientDataBytes = b64url.decode(response.clientDataJSON);
+  const clientData = verifyClientData(clientDataBytes, 'webauthn.get');
+  if (clientData.challenge !== record.challenge) throw new ApiError('invalid_response', 'Challenge mismatch.');
+
+  const authDataBytes = b64url.decode(response.authenticatorData);
+  const authData = parseAuthenticatorData(authDataBytes);
+  await verifyAuthenticatorFlags(authData);
+
+  const signedData = concatBytes(authDataBytes, await sha256(clientDataBytes));
+  const valid = await verifySignature(stored.alg, b64url.decode(stored.publicKey), b64url.decode(response.signature), signedData);
+  if (!valid) throw new ApiError('invalid_signature', 'We couldn’t verify that passkey. Please try again.');
+
+  // Counter regression suggests a cloned authenticator. Synced passkeys report 0.
+  if ((authData.signCount !== 0 || stored.signCount !== 0) && authData.signCount <= stored.signCount) {
+    throw new ApiError('counter_regression', 'This passkey failed a security check. Please use a different passkey.');
+  }
+  stored.signCount = authData.signCount;
+  stored.backedUp = authData.flags.bs;
+  stored.lastUsedAt = Date.now();
+  saveDB(db);
+
+  setSession(stored.userId, stored.id);
+  return getAccount();
+}
+
+/** PATCH /api/account — name changes are free; email changes are sensitive. */
+export async function updateProfile({ name, email }) {
+  const db = loadDB();
+  const session = requireSession(db);
+  const user = db.users[session.userId];
+  const nextName = normalizeName(name);
+  const nextEmail = normalizeEmail(email);
+  if (nextEmail !== user.email) {
+    requireRecentAuth(session);
+    const other = findUserByEmail(db, nextEmail);
+    if (other && other.id !== user.id) {
+      throw new ApiError('email_taken', 'That email is already used by another account.');
+    }
+  }
+  user.name = nextName;
+  user.email = nextEmail;
+  saveDB(db);
+  return publicUser(user);
+}
+
+/** PATCH /api/passkeys/:id */
+export async function renamePasskey(id, name) {
+  const db = loadDB();
+  const session = requireSession(db);
+  const cred = db.credentials[id];
+  if (!cred || cred.userId !== session.userId) throw new ApiError('not_found', 'Passkey not found.');
+  const next = String(name || '').trim().replace(/\s+/g, ' ');
+  if (!next) throw new ApiError('invalid_name', 'Passkey name can’t be empty.');
+  if (next.length > MAX_PASSKEY_NAME) {
+    throw new ApiError('invalid_name', `Passkey name must be ${MAX_PASSKEY_NAME} characters or fewer.`);
+  }
+  cred.name = next;
+  saveDB(db);
+  return publicCredential(cred);
+}
+
+/** DELETE /api/passkeys/:id — sensitive; the last passkey can't be removed (it's the only way in). */
+export async function deletePasskey(id) {
+  const db = loadDB();
+  const session = requireSession(db);
+  const cred = db.credentials[id];
+  if (!cred || cred.userId !== session.userId) throw new ApiError('not_found', 'Passkey not found.');
+  if (userCredentials(db, session.userId).length <= 1) {
+    throw new ApiError('last_passkey',
+      'You can’t remove your only passkey — you’d be locked out. Add another passkey first.');
+  }
+  requireRecentAuth(session);
+  delete db.credentials[id];
+  saveDB(db);
+  return { remainingIds: userCredentials(db, session.userId).map((c) => c.id) };
+}
+
+/** POST /api/logout */
+export async function signOut() {
+  localStorage.removeItem(SESSION_KEY);
+}
+
+function challengeFromCredential(credential) {
+  try {
+    return JSON.parse(new TextDecoder().decode(b64url.decode(credential.response.clientDataJSON))).challenge;
+  } catch {
+    throw new ApiError('invalid_response', 'Malformed client data.');
+  }
+}
