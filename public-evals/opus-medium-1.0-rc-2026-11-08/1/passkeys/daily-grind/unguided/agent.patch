diff --git a/js/account.js b/js/account.js
new file mode 100644
index 0000000..f73f35d
--- /dev/null
+++ b/js/account.js
@@ -0,0 +1,588 @@
+// "My Account" dialog: passkey sign-up, sign-in (button + autofill), passkey
+// management, profile updates and reauthentication for sensitive actions.
+
+import * as api from './passkey-server.js';
+import {
+  isWebAuthnSupported, getCapabilities, createPasskey, getPasskey, describeWebAuthnError,
+  signalUnknownCredential, signalAcceptedCredentials, signalUserDetails, providerName,
+} from './webauthn.js';
+
+const $ = (sel, root = document) => root.querySelector(sel);
+
+const els = {
+  dialog: $('#account-dialog'),
+  status: $('#account-status'),
+  unsupported: $('#account-unsupported'),
+  signedOut: $('#view-signed-out'),
+  signedIn: $('#view-signed-in'),
+  tabs: document.querySelectorAll('[data-tab]'),
+  signinPanel: $('#panel-signin'),
+  registerPanel: $('#panel-register'),
+  signinForm: $('#signin-form'),
+  signinEmail: $('#signin-email'),
+  registerForm: $('#register-form'),
+  summaryAvatar: $('#summary-avatar'),
+  summaryName: $('#summary-name'),
+  summaryEmail: $('#summary-email'),
+  summarySince: $('#summary-since'),
+  profileForm: $('#profile-form'),
+  passkeyList: $('#passkey-list'),
+  passkeyCount: $('#passkey-count'),
+  addPasskey: $('#add-passkey'),
+  verifiedAt: $('#verified-at'),
+  signOut: $('#sign-out'),
+  reauthDialog: $('#reauth-dialog'),
+  reauthReason: $('#reauth-reason'),
+  reauthError: $('#reauth-error'),
+  reauthConfirm: $('#reauth-confirm'),
+  renameDialog: $('#rename-dialog'),
+  renameForm: $('#rename-form'),
+  renameInput: $('#rename-input'),
+  renameError: $('#rename-error'),
+  confirmDialog: $('#confirm-dialog'),
+  confirmTitle: $('#confirm-title'),
+  confirmBody: $('#confirm-body'),
+  confirmOk: $('#confirm-ok'),
+  navAuth: document.querySelectorAll('[data-auth-link]'),
+  navOpen: document.querySelectorAll('[data-account-open]'),
+  greeting: $('#hero-greeting'),
+};
+
+const state = {
+  account: null,
+  caps: { conditionalGet: false },
+  conditionalAbort: null,
+};
+
+class Cancelled extends Error {}
+
+// ---------------------------------------------------------------------------
+// Small UI helpers
+// ---------------------------------------------------------------------------
+
+let statusTimer;
+function showStatus(message, type = 'info') {
+  clearTimeout(statusTimer);
+  if (!message) {
+    els.status.hidden = true;
+    return;
+  }
+  els.status.textContent = message;
+  els.status.dataset.type = type;
+  els.status.hidden = false;
+  if (type === 'success') statusTimer = setTimeout(() => { els.status.hidden = true; }, 6000);
+}
+
+function showError(err, ceremony) {
+  if (err instanceof Cancelled) return;
+  if (err instanceof api.ApiError) {
+    showStatus(err.message, 'error');
+    return;
+  }
+  const message = describeWebAuthnError(err, ceremony);
+  if (message) showStatus(message, 'error');
+}
+
+async function busy(button, fn) {
+  const label = button.textContent;
+  button.disabled = true;
+  button.setAttribute('aria-busy', 'true');
+  try {
+    return await fn();
+  } finally {
+    button.disabled = false;
+    button.removeAttribute('aria-busy');
+    button.textContent = label;
+  }
+}
+
+function h(tag, attrs = {}, ...children) {
+  const el = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (k === 'class') el.className = v;
+    else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
+    else if (v !== false && v != null) el.setAttribute(k, v === true ? '' : v);
+  }
+  for (const c of children.flat()) if (c != null && c !== false) el.append(c);
+  return el;
+}
+
+const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+function relativeTime(ts) {
+  const diff = (ts - Date.now()) / 1000;
+  const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
+  for (const [unit, secs] of units) {
+    if (Math.abs(diff) >= secs) return rtf.format(Math.round(diff / secs), unit);
+  }
+  return 'just now';
+}
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+function initials(name) {
+  return name.split(' ').filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join('') || '?';
+}
+
+function openModal(dialog) {
+  if (!dialog.open) dialog.showModal();
+}
+
+// ---------------------------------------------------------------------------
+// Rendering
+// ---------------------------------------------------------------------------
+
+function render() {
+  const { account } = state;
+  const signedIn = !!account;
+  els.signedOut.hidden = signedIn;
+  els.signedIn.hidden = !signedIn;
+
+  els.navAuth.forEach((a) => {
+    a.textContent = signedIn ? 'Logout' : 'Sign in';
+    a.setAttribute('href', signedIn ? '#logout' : '#account');
+  });
+  if (els.greeting) {
+    els.greeting.textContent = signedIn ? `Welcome back, ${account.user.name.split(' ')[0]}!` : '';
+    els.greeting.hidden = !signedIn;
+  }
+  if (!signedIn) return;
+
+  const { user, passkeys, session } = account;
+  els.summaryAvatar.textContent = initials(user.name);
+  els.summaryName.textContent = user.name;
+  els.summaryEmail.textContent = user.email;
+  els.summarySince.textContent = `Member since ${dateFmt.format(user.createdAt)}`;
+
+  const form = els.profileForm;
+  if (!form.contains(document.activeElement)) {
+    form.elements.name.value = user.name;
+    form.elements.email.value = user.email;
+  }
+
+  els.passkeyCount.textContent = String(passkeys.length);
+  els.passkeyList.replaceChildren(...passkeys.map((pk) => renderPasskey(pk, session, passkeys.length)));
+  renderVerifiedAt();
+}
+
+function renderVerifiedAt() {
+  const session = state.account?.session;
+  if (!session) return;
+  const fresh = Date.now() - session.authTime < session.reauthWindowMs;
+  els.verifiedAt.textContent = fresh
+    ? `You verified your identity ${relativeTime(session.authTime)}. Sensitive changes won’t ask again for a few minutes.`
+    : `Last verified ${relativeTime(session.authTime)}. We’ll ask you to confirm it’s you before sensitive changes.`;
+}
+
+function renderPasskey(pk, session, total) {
+  const provider = providerName(pk.aaguid);
+  const synced = pk.backedUp
+    ? 'Synced across your devices'
+    : pk.backupEligible ? 'Not yet synced' : 'Stored on a single device';
+  const isCurrent = pk.id === session.credentialId;
+  const titleId = `pk-${pk.id.slice(0, 12)}`;
+
+  return h('li', { class: 'passkey', 'aria-labelledby': titleId },
+    h('div', { class: 'passkey-icon', 'aria-hidden': 'true' }, keyIcon()),
+    h('div', { class: 'passkey-info' },
+      h('div', { class: 'passkey-title' },
+        h('strong', { id: titleId }, pk.name),
+        isCurrent && h('span', { class: 'badge' }, 'Current session')),
+      h('small', {}, `Created ${dateFmt.format(pk.createdAt)} · Last used ${relativeTime(pk.lastUsedAt)}`),
+      h('small', {}, [synced, provider && pk.name !== provider ? ` · ${provider}` : ''].join(''))),
+    h('div', { class: 'passkey-actions' },
+      h('button', {
+        type: 'button', class: 'btn-link', 'aria-label': `Rename ${pk.name}`,
+        onclick: () => renamePasskey(pk),
+      }, 'Rename'),
+      h('button', {
+        type: 'button',
+        class: 'btn-link danger',
+        'aria-label': `Remove ${pk.name}`,
+        title: total <= 1 ? 'Add another passkey before removing this one' : null,
+        disabled: total <= 1,
+        onclick: () => removePasskey(pk),
+      }, 'Remove')));
+}
+
+function keyIcon() {
+  const ns = 'http://www.w3.org/2000/svg';
+  const svg = document.createElementNS(ns, 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  svg.setAttribute('width', '22');
+  svg.setAttribute('height', '22');
+  const path = document.createElementNS(ns, 'path');
+  path.setAttribute('fill', 'currentColor');
+  path.setAttribute('d', 'M7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm5.65-4A6 6 0 1 0 12.65 14H16v3h3v-3h2v-4h-8.35Z');
+  svg.append(path);
+  return svg;
+}
+
+async function refresh() {
+  state.account = await api.getAccount();
+  render();
+}
+
+// ---------------------------------------------------------------------------
+// Sign in: passkey autofill (conditional mediation) + explicit button
+// ---------------------------------------------------------------------------
+
+function stopConditional() {
+  state.conditionalAbort?.abort(new DOMException('Cancelled', 'AbortError'));
+  state.conditionalAbort = null;
+}
+
+async function startConditional() {
+  if (!state.caps.conditionalGet || state.account || !els.dialog.open || els.signinPanel.hidden) return;
+  stopConditional();
+  const controller = new AbortController();
+  state.conditionalAbort = controller;
+  try {
+    const options = await api.startAuthentication({ purpose: 'login' });
+    if (controller.signal.aborted) return;
+    const credential = await getPasskey(options, { mediation: 'conditional', signal: controller.signal });
+    state.conditionalAbort = null;
+    await completeSignIn(credential);
+  } catch (err) {
+    if (controller.signal.aborted || err?.name === 'AbortError') return;
+    state.conditionalAbort = null;
+    await handleSignInError(err);
+    // Re-arm autofill after a server-side rejection (e.g. a stale passkey), but not
+    // after browser errors, which would likely just repeat.
+    if (err instanceof api.ApiError) startConditional();
+  }
+}
+
+async function completeSignIn(credential) {
+  state.account = await api.finishAuthentication(credential, { purpose: 'login' });
+  render();
+  showStatus(`Signed in as ${state.account.user.name}. Welcome back!`, 'success');
+  els.signinForm.reset();
+  $('#profile-form [name="name"]').focus();
+}
+
+async function handleSignInError(err) {
+  if (err instanceof api.ApiError && err.code === 'unknown_credential') {
+    await signalUnknownCredential(api.rp.id, err.details.credentialId);
+  }
+  showError(err, 'get');
+}
+
+async function signInWithButton(button) {
+  showStatus(null);
+  stopConditional();
+  await busy(button, async () => {
+    button.textContent = 'Waiting for your passkey…';
+    try {
+      const options = await api.startAuthentication({ purpose: 'login' });
+      const credential = await getPasskey(options);
+      await completeSignIn(credential);
+    } catch (err) {
+      await handleSignInError(err);
+    }
+  });
+  startConditional();
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+async function register(form) {
+  showStatus(null);
+  if (!form.reportValidity()) return;
+  stopConditional();
+  const button = form.querySelector('button[type="submit"]');
+  await busy(button, async () => {
+    button.textContent = 'Creating your passkey…';
+    try {
+      const options = await api.startRegistration({
+        name: form.elements.name.value,
+        email: form.elements.email.value,
+      });
+      const credential = await createPasskey(options);
+      state.account = await api.finishRegistration(credential);
+      form.reset();
+      render();
+      showStatus('Your account is ready and your passkey is saved. No password needed next time!', 'success');
+    } catch (err) {
+      showError(err, 'create');
+    }
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Reauthentication
+// ---------------------------------------------------------------------------
+
+/**
+ * Runs `action`; if the server says the session is too old for a sensitive
+ * change, asks the user to verify with a passkey and retries once.
+ */
+async function withReauth(reason, action) {
+  try {
+    return await action({ reauthed: false });
+  } catch (err) {
+    if (!(err instanceof api.ApiError && err.code === 'reauth_required')) throw err;
+  }
+  await reauthenticate(reason);
+  return action({ reauthed: true });
+}
+
+function reauthenticate(reason) {
+  return new Promise((resolve, reject) => {
+    els.reauthReason.textContent = reason;
+    els.reauthError.hidden = true;
+    const dialog = els.reauthDialog;
+    let done = false;
+
+    const onConfirm = async () => {
+      els.reauthError.hidden = true;
+      await busy(els.reauthConfirm, async () => {
+        els.reauthConfirm.textContent = 'Waiting for your passkey…';
+        try {
+          const options = await api.startAuthentication({ purpose: 'reauth' });
+          const credential = await getPasskey(options);
+          state.account = await api.finishAuthentication(credential, { purpose: 'reauth' });
+          done = true;
+          dialog.close('verified');
+          render();
+          resolve();
+        } catch (err) {
+          const message = err instanceof api.ApiError ? err.message : describeWebAuthnError(err, 'get');
+          if (message) {
+            els.reauthError.textContent = message;
+            els.reauthError.hidden = false;
+          }
+        }
+      });
+    };
+
+    const onClose = () => {
+      els.reauthConfirm.removeEventListener('click', onConfirm);
+      dialog.removeEventListener('close', onClose);
+      if (!done) reject(new Cancelled());
+    };
+
+    els.reauthConfirm.addEventListener('click', onConfirm);
+    dialog.addEventListener('close', onClose);
+    openModal(dialog);
+    els.reauthConfirm.focus();
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Passkey management
+// ---------------------------------------------------------------------------
+
+async function addPasskey(button) {
+  showStatus(null);
+  await busy(button, async () => {
+    let reauthed = false;
+    try {
+      const pk = await withReauth('Confirm it’s you before adding a new passkey to your account.', async (ctx) => {
+        reauthed = ctx.reauthed;
+        button.textContent = 'Creating your passkey…';
+        const options = await api.startAddPasskey();
+        const credential = await createPasskey(options);
+        return api.finishAddPasskey(credential);
+      });
+      await refresh();
+      showStatus(`“${pk.name}” was added. You can now sign in with it.`, 'success');
+    } catch (err) {
+      // Some browsers require a fresh tap after the verification prompt.
+      if (reauthed && err?.name === 'NotAllowedError') {
+        showStatus('Identity confirmed. Select “Add a passkey” again to continue.', 'info');
+        return;
+      }
+      showError(err, 'create');
+    }
+  });
+}
+
+function renamePasskey(pk) {
+  els.renameInput.value = pk.name;
+  els.renameError.hidden = true;
+  els.renameForm.dataset.id = pk.id;
+  openModal(els.renameDialog);
+  els.renameInput.select();
+}
+
+async function submitRename(event) {
+  event.preventDefault();
+  const button = event.submitter || els.renameForm.querySelector('[type="submit"]');
+  await busy(button, async () => {
+    try {
+      const pk = await api.renamePasskey(els.renameForm.dataset.id, els.renameInput.value);
+      els.renameDialog.close();
+      await refresh();
+      showStatus(`Passkey renamed to “${pk.name}”.`, 'success');
+    } catch (err) {
+      els.renameError.textContent = err.message;
+      els.renameError.hidden = false;
+    }
+  });
+}
+
+function confirmAction({ title, body, ok }) {
+  return new Promise((resolve) => {
+    els.confirmTitle.textContent = title;
+    els.confirmBody.textContent = body;
+    els.confirmOk.textContent = ok;
+    const dialog = els.confirmDialog;
+    dialog.returnValue = '';
+    dialog.addEventListener('close', () => resolve(dialog.returnValue === 'ok'), { once: true });
+    openModal(dialog);
+  });
+}
+
+async function removePasskey(pk) {
+  showStatus(null);
+  const confirmed = await confirmAction({
+    title: `Remove “${pk.name}”?`,
+    body: 'You won’t be able to sign in to The Daily Grind with this passkey anymore. '
+      + 'You may also want to delete it from your password manager.',
+    ok: 'Remove passkey',
+  });
+  if (!confirmed) return;
+  try {
+    const { remainingIds } = await withReauth(`Confirm it’s you before removing “${pk.name}”.`,
+      () => api.deletePasskey(pk.id));
+    // Ask the passkey provider to hide the removed passkey from future prompts.
+    await signalAcceptedCredentials(api.rp.id, state.account.user.id, remainingIds);
+    await refresh();
+    showStatus(`“${pk.name}” was removed.`, 'success');
+  } catch (err) {
+    showError(err, 'get');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Profile
+// ---------------------------------------------------------------------------
+
+async function saveProfile(form) {
+  showStatus(null);
+  if (!form.reportValidity()) return;
+  const button = form.querySelector('button[type="submit"]');
+  const name = form.elements.name.value;
+  const email = form.elements.email.value;
+  await busy(button, async () => {
+    button.textContent = 'Saving…';
+    try {
+      const user = await withReauth('Confirm it’s you before changing the email address on your account.',
+        () => api.updateProfile({ name, email }));
+      // Update the name shown in the user's passkey manager.
+      await signalUserDetails(api.rp.id, user.id, user.email, user.name);
+      button.blur();
+      await refresh();
+      form.elements.name.value = user.name;
+      form.elements.email.value = user.email;
+      showStatus('Your profile has been updated.', 'success');
+    } catch (err) {
+      showError(err, 'get');
+    }
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Dialog / navigation wiring
+// ---------------------------------------------------------------------------
+
+function selectTab(name) {
+  els.tabs.forEach((tab) => {
+    const selected = tab.dataset.tab === name;
+    tab.setAttribute('aria-selected', String(selected));
+    tab.tabIndex = selected ? 0 : -1;
+  });
+  els.signinPanel.hidden = name !== 'signin';
+  els.registerPanel.hidden = name !== 'register';
+  showStatus(null);
+  if (name === 'signin') startConditional(); else stopConditional();
+}
+
+async function openAccount({ tab } = {}) {
+  await refresh();
+  openModal(els.dialog);
+  if (!state.account) {
+    selectTab(tab || 'signin');
+    (tab === 'register' ? $('#register-name') : els.signinEmail).focus();
+  }
+}
+
+async function signOut() {
+  stopConditional();
+  await api.signOut();
+  state.account = null;
+  render();
+  showStatus('You’ve been signed out.', 'success');
+  if (els.dialog.open) selectTab('signin');
+}
+
+function init() {
+  els.navOpen.forEach((a) => a.addEventListener('click', (e) => {
+    e.preventDefault();
+    openAccount();
+  }));
+  els.navAuth.forEach((a) => a.addEventListener('click', (e) => {
+    e.preventDefault();
+    if (state.account) signOut(); else openAccount({ tab: 'signin' });
+  }));
+
+  els.dialog.addEventListener('close', () => {
+    stopConditional();
+    showStatus(null);
+    if (location.hash === '#account') history.replaceState(null, '', location.pathname + location.search);
+  });
+  document.querySelectorAll('[data-close]').forEach((btn) => btn.addEventListener('click', () => {
+    btn.closest('dialog').close();
+  }));
+
+  els.tabs.forEach((tab) => {
+    tab.addEventListener('click', () => selectTab(tab.dataset.tab));
+    tab.addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const next = tab.dataset.tab === 'signin' ? 'register' : 'signin';
+      selectTab(next);
+      $(`[data-tab="${next}"]`).focus();
+    });
+  });
+  document.querySelectorAll('[data-switch-tab]').forEach((link) => link.addEventListener('click', (e) => {
+    e.preventDefault();
+    selectTab(link.dataset.switchTab);
+  }));
+
+  els.signinForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    signInWithButton(els.signinForm.querySelector('button[type="submit"]'));
+  });
+  els.registerForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    register(els.registerForm);
+  });
+  els.profileForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    saveProfile(els.profileForm);
+  });
+  els.addPasskey.addEventListener('click', () => addPasskey(els.addPasskey));
+  els.renameForm.addEventListener('submit', submitRename);
+  els.signOut.addEventListener('click', signOut);
+
+  // Keep "last used"/"verified" times fresh while the dialog is open.
+  setInterval(() => { if (els.dialog.open && state.account) renderVerifiedAt(); }, 30_000);
+  // Reflect sign-in/out from other tabs.
+  window.addEventListener('storage', (e) => { if (e.key?.startsWith('dg.rp.')) refresh(); });
+
+  if (!isWebAuthnSupported()) {
+    els.unsupported.hidden = false;
+    document.querySelectorAll('[data-requires-webauthn]').forEach((el) => { el.disabled = true; });
+  }
+
+  refresh();
+  getCapabilities().then((caps) => {
+    state.caps = caps;
+    startConditional();
+  });
+  if (location.hash === '#account') openAccount();
+}
+
+init();
