diff --git a/src/lib/auth/aaguid.ts b/src/lib/auth/aaguid.ts
new file mode 100644
index 0000000..8b7cca8
--- /dev/null
+++ b/src/lib/auth/aaguid.ts
@@ -0,0 +1,39 @@
+// Maps an authenticator AAGUID to a provider name and icon for the passkey
+// management UI. AAGUIDs are not attested for platform passkeys, so this is used
+// strictly as a UX hint and never for security decisions.
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+interface RegistryEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+let registry: Promise<Record<string, RegistryEntry>> | null = null;
+
+function loadRegistry(): Promise<Record<string, RegistryEntry>> {
+  registry ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then((response) => {
+      if (!response.ok) throw new Error(`AAGUID registry responded ${response.status}`);
+      return response.json();
+    })
+    .catch((error) => {
+      console.warn('Unable to load AAGUID registry:', error);
+      registry = null; // retry on the next registration
+      return {};
+    });
+  return registry;
+}
+
+export async function lookupProvider(aaguid: string): Promise<{ name: string; icon?: { light?: string; dark?: string } }> {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: 'Passkey' };
+  }
+  const entry = (await loadRegistry())[aaguid];
+  if (!entry) return { name: 'Passkey' };
+  return { name: entry.name, icon: { light: entry.icon_light, dark: entry.icon_dark } };
+}
diff --git a/src/lib/auth/config.ts b/src/lib/auth/config.ts
new file mode 100644
index 0000000..d336a22
--- /dev/null
+++ b/src/lib/auth/config.ts
@@ -0,0 +1,27 @@
+// Relying Party configuration for WebAuthn.
+//
+// PASSKEY_RP_ID should be set to the registrable domain the passkeys are bound to
+// (e.g. "astro-news-pytrpecapa-uc.a.run.app"). The client never derives the RP ID
+// itself; it always reads it from the options/responses returned by these APIs.
+// When unset (local development), the hostname of the incoming request is used.
+
+export const RP_NAME = 'The DevTools Times';
+
+// How long a successful passkey reauthentication unlocks sensitive actions.
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export const EXTERNAL_AUTH_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export function getRpId(url: URL): string {
+  return import.meta.env.PASSKEY_RP_ID || process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+export function getExpectedOrigins(url: URL): string[] {
+  const configured = import.meta.env.PASSKEY_ORIGINS || process.env.PASSKEY_ORIGINS;
+  if (configured) {
+    return configured.split(',').map((origin: string) => origin.trim()).filter(Boolean);
+  }
+  // Behind TLS-terminating proxies the request URL may report http://, so accept
+  // both schemes for the request host. localhost is a secure context over http.
+  return [`https://${url.host}`, `http://${url.host}`];
+}
diff --git a/src/lib/auth/passkeys.ts b/src/lib/auth/passkeys.ts
new file mode 100644
index 0000000..7d219ab
--- /dev/null
+++ b/src/lib/auth/passkeys.ts
@@ -0,0 +1,212 @@
+// Server-side WebAuthn ceremonies, built on SimpleWebAuthn for option
+// generation and signature verification.
+
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import type {
+  AuthenticationResponseJSON,
+  AuthenticatorTransportFuture,
+  RegistrationResponseJSON,
+} from '@simplewebauthn/server';
+import type { AstroSession } from 'astro';
+import { lookupProvider } from './aaguid';
+import { RP_NAME, getExpectedOrigins, getRpId } from './config';
+import { consumeChallenge, json, storeChallenge } from './session';
+import {
+  findCredentialById,
+  findCredentialsByUserId,
+  saveCredential,
+  type StoredPasskeyCredential,
+  type StoredUser,
+} from './store';
+
+type Session = AstroSession | undefined;
+
+export class PasskeyError extends Error {
+  constructor(message: string, readonly status: number) {
+    super(message);
+  }
+}
+
+function descriptors(credentials: StoredPasskeyCredential[]) {
+  return credentials.map((cred) => ({
+    id: cred.id,
+    transports: cred.transports as AuthenticatorTransportFuture[],
+  }));
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+export async function createRegistrationOptions(
+  session: Session,
+  url: URL,
+  user: StoredUser,
+  { promotion = false, conditional = false } = {},
+) {
+  const existing = await findCredentialsByUserId(user.id);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRpId(url),
+    userID: Buffer.from(user.id, 'base64url'),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    supportedAlgorithmIDs: [-7, -257],
+    // Prevent registering a second passkey with the same provider account.
+    excludeCredentials: descriptors(existing),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Promotions target the platform authenticator; the account settings flow
+      // also allows roaming security keys.
+      ...((promotion || conditional) && { authenticatorAttachment: 'platform' as const }),
+    },
+  });
+
+  storeChallenge(session, {
+    challenge: options.challenge,
+    purpose: 'register',
+    userVerification: 'preferred',
+    conditional,
+  });
+  return options;
+}
+
+export async function verifyRegistration(
+  session: Session,
+  url: URL,
+  user: StoredUser,
+  response: RegistrationResponseJSON,
+) {
+  const pending = await consumeChallenge(session, 'register');
+  if (!pending) throw new PasskeyError('Registration challenge expired. Please try again.', 400);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      // "preferred" UV must not reject authenticators without a screen lock.
+      requireUserVerification: pending.userVerification === 'required',
+      // Conditional create happens without an explicit gesture, so UP is relaxed
+      // only for that flow.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (error) {
+    throw new PasskeyError(`Passkey verification failed: ${(error as Error).message}`, 400);
+  }
+
+  const { verified, registrationInfo } = verification;
+  if (!verified || !registrationInfo) throw new PasskeyError('Passkey verification failed.', 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = registrationInfo;
+  if (await findCredentialById(credential.id)) {
+    throw new PasskeyError('This passkey is already registered.', 409);
+  }
+
+  const provider = await lookupProvider(aaguid);
+  const stored: StoredPasskeyCredential = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.icon,
+    name: provider.name,
+    transports: credential.transports ?? response.response.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await saveCredential(stored);
+  return stored;
+}
+
+// ---------------------------------------------------------------------------
+// Authentication (sign-in) and reauthentication
+// ---------------------------------------------------------------------------
+
+export async function createAuthenticationOptions(session: Session, url: URL) {
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    allowCredentials: [], // discoverable credentials
+    userVerification: 'preferred',
+  });
+  storeChallenge(session, { challenge: options.challenge, purpose: 'login', userVerification: 'preferred' });
+  return options;
+}
+
+export async function createReauthenticationOptions(session: Session, url: URL, user: StoredUser) {
+  const credentials = await findCredentialsByUserId(user.id);
+  if (credentials.length === 0) throw new PasskeyError('No passkeys are registered for this account.', 400);
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    // Restrict the prompt to the signed-in user's own passkeys.
+    allowCredentials: descriptors(credentials),
+    userVerification: 'required',
+  });
+  storeChallenge(session, { challenge: options.challenge, purpose: 'reauth', userVerification: 'required' });
+  return options;
+}
+
+export async function verifyAuthentication(
+  session: Session,
+  url: URL,
+  response: AuthenticationResponseJSON,
+  purpose: 'login' | 'reauth',
+) {
+  const pending = await consumeChallenge(session, purpose);
+  if (!pending) throw new PasskeyError('Sign-in challenge expired. Please try again.', 400);
+
+  const stored = await findCredentialById(response.id);
+  // 404 lets the client signal the password manager that this passkey is gone.
+  if (!stored) throw new PasskeyError('This passkey is not registered with The DevTools Times.', 404);
+
+  if (response.response.userHandle && response.response.userHandle !== stored.passkeyUserId) {
+    throw new PasskeyError('Passkey does not belong to this account.', 400);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      requireUserVerification: pending.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as AuthenticatorTransportFuture[],
+      },
+    });
+  } catch (error) {
+    throw new PasskeyError(`Passkey verification failed: ${(error as Error).message}`, 400);
+  }
+  if (!verification.verified) throw new PasskeyError('Passkey verification failed.', 400);
+
+  stored.counter = verification.authenticationInfo.newCounter;
+  stored.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+  stored.lastUsedAt = Date.now();
+  await saveCredential(stored);
+  return stored;
+}
+
+export function errorResponse(error: unknown): Response {
+  if (error instanceof PasskeyError) {
+    return json({ error: error.message }, error.status);
+  }
+  console.error('Unexpected passkey error:', error);
+  return json({ error: 'Something went wrong. Please try again.' }, 500);
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..d144503
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,82 @@
+import type { AstroSession } from 'astro';
+import { REAUTH_WINDOW_MS } from './config';
+import { findUserById, type StoredPasskeyCredential, type StoredUser } from './store';
+
+type Session = AstroSession | undefined;
+
+export type ChallengePurpose = 'register' | 'login' | 'reauth';
+
+interface PendingChallenge {
+  challenge: string;
+  purpose: ChallengePurpose;
+  userVerification: 'required' | 'preferred';
+  conditional?: boolean;
+  createdAt: number;
+}
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export async function getCurrentUser(session: Session): Promise<StoredUser | undefined> {
+  const userId = await session?.get('userId');
+  return userId ? findUserById(userId) : undefined;
+}
+
+export async function signIn(session: Session, user: StoredUser, method: 'password' | 'passkey'): Promise<void> {
+  if (!session) throw new Error('Sessions are not configured.');
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await session.regenerate();
+  session.set('userId', user.id);
+  session.set('authMethod', method);
+  // A fresh passkey sign-in also counts as a recent identity verification.
+  if (method === 'passkey') {
+    session.set('reauthAt', Date.now());
+  } else {
+    session.delete('reauthAt');
+  }
+}
+
+export function signOut(session: Session): void {
+  session?.destroy();
+}
+
+export async function markReauthenticated(session: Session): Promise<void> {
+  session?.set('reauthAt', Date.now());
+}
+
+export async function isRecentlyReauthenticated(session: Session): Promise<boolean> {
+  const reauthAt = await session?.get('reauthAt');
+  return typeof reauthAt === 'number' && Date.now() - reauthAt < REAUTH_WINDOW_MS;
+}
+
+export function storeChallenge(session: Session, pending: Omit<PendingChallenge, 'createdAt'>): void {
+  session?.set('passkeyChallenge', { ...pending, createdAt: Date.now() });
+}
+
+// Challenges are single use: read and clear in one step.
+export async function consumeChallenge(session: Session, purpose: ChallengePurpose): Promise<PendingChallenge | undefined> {
+  const pending = (await session?.get('passkeyChallenge')) as PendingChallenge | undefined;
+  session?.delete('passkeyChallenge');
+  if (!pending || pending.purpose !== purpose) return undefined;
+  if (Date.now() - pending.createdAt > CHALLENGE_TTL_MS) return undefined;
+  return pending;
+}
+
+// Shape of a passkey exposed to the browser (no key material or counters).
+export function toPublicCredential(cred: StoredPasskeyCredential) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    providerIcon: cred.providerIcon,
+    registeredAt: cred.registeredAt,
+    lastUsedAt: cred.lastUsedAt,
+    backedUp: cred.credentialBackedUp,
+    deviceType: cred.credentialDeviceType,
+  };
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..5756d3b
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,117 @@
+// Minimal file-backed store for user profiles and passkey credentials.
+// Passwords stay with the upstream auth API; this store only holds the data the
+// app needs to register, verify, and manage passkeys.
+
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface StoredUser {
+  id: string; // Base64URL WebAuthn user handle (passkeyUserId)
+  username: string;
+  displayName: string;
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface StoreData {
+  users: Record<string, StoredUser>; // keyed by user id
+  credentials: Record<string, StoredPasskeyCredential>; // keyed by credential id
+}
+
+const DATA_DIR = process.env.AUTH_DATA_DIR || path.join(process.cwd(), '.data');
+const DATA_FILE = path.join(DATA_DIR, 'auth-store.json');
+
+let cache: StoreData | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as StoreData;
+  } catch {
+    cache = { users: {}, credentials: {} };
+  }
+  return cache;
+}
+
+function persist(): Promise<void> {
+  // Serialize writes so concurrent requests never interleave partial files.
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(DATA_DIR, { recursive: true });
+    const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(cache, null, 2));
+    await rename(tmp, DATA_FILE);
+  });
+  return writeQueue;
+}
+
+export async function findUserById(id: string): Promise<StoredUser | undefined> {
+  return (await load()).users[id];
+}
+
+export async function findUserByUsername(username: string): Promise<StoredUser | undefined> {
+  const normalized = username.trim().toLowerCase();
+  return Object.values((await load()).users).find((user) => user.username.toLowerCase() === normalized);
+}
+
+export async function findOrCreateUser(username: string): Promise<StoredUser> {
+  const existing = await findUserByUsername(username);
+  if (existing) return existing;
+  const data = await load();
+  const user: StoredUser = {
+    id: randomBytes(32).toString('base64url'),
+    username: username.trim(),
+    displayName: username.trim(),
+    createdAt: Date.now(),
+  };
+  data.users[user.id] = user;
+  await persist();
+  return user;
+}
+
+export async function updateUser(id: string, changes: Pick<StoredUser, 'displayName'>): Promise<StoredUser | undefined> {
+  const data = await load();
+  const user = data.users[id];
+  if (!user) return undefined;
+  user.displayName = changes.displayName;
+  await persist();
+  return user;
+}
+
+export async function findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+  return (await load()).credentials[id];
+}
+
+export async function findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+  return Object.values((await load()).credentials)
+    .filter((cred) => cred.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export async function saveCredential(credential: StoredPasskeyCredential): Promise<void> {
+  const data = await load();
+  data.credentials[credential.id] = credential;
+  await persist();
+}
+
+export async function deleteCredential(id: string): Promise<void> {
+  const data = await load();
+  delete data.credentials[id];
+  await persist();
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..075ccfa
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,310 @@
+// Browser-side passkey helpers. All WebAuthn calls use the native APIs; the RP ID
+// passed to Signal API methods always comes from server responses, never from
+// window.location.hostname.
+
+const API = `${import.meta.env.BASE_URL}api/auth`;
+
+export type ClientCapabilities = Partial<Record<
+  'conditionalCreate' | 'conditionalGet' | 'passkeyPlatformAuthenticator' | 'hybridTransport' | 'userVerifyingPlatformAuthenticator',
+  boolean
+>>;
+
+export class PasskeyApiError extends Error {
+  constructor(message: string, readonly status: number, readonly code?: string) {
+    super(message);
+  }
+}
+
+// Typed view of PublicKeyCredential statics; some (Signal API, getClientCapabilities)
+// are newer than the TypeScript DOM lib and must be feature-detected.
+interface PasskeyStatics {
+  getClientCapabilities(): Promise<ClientCapabilities>;
+  parseCreationOptionsFromJSON(options: unknown): PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON(options: unknown): PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?(options: { rpId: string; credentialId: string }): Promise<void>;
+  signalAllAcceptedCredentials?(options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }): Promise<void>;
+  signalCurrentUserDetails?(options: { rpId: string; userId: string; name: string; displayName: string }): Promise<void>;
+}
+
+const pkc = () => window.PublicKeyCredential as unknown as PasskeyStatics;
+
+// Serializes a credential (native or polyfilled toJSON) for the verify endpoints.
+const encode = (credential: Credential) => (credential as unknown as { toJSON(): { id: string } }).toJSON();
+
+let polyfillsLoaded: Promise<unknown> | null = null;
+
+// Loads webauthn-polyfills so getClientCapabilities(), parse*OptionsFromJSON()
+// and toJSON() are available in browsers that support WebAuthn but predate them.
+function ensurePolyfills(): Promise<unknown> {
+  polyfillsLoaded ??= import('webauthn-polyfills').catch((error) => {
+    console.warn('Failed to load WebAuthn polyfills:', error);
+  });
+  return polyfillsLoaded;
+}
+
+export function isWebAuthnAvailable(): boolean {
+  return typeof window !== 'undefined' && typeof window.PublicKeyCredential === 'function';
+}
+
+export async function getCapabilities(): Promise<ClientCapabilities> {
+  if (!isWebAuthnAvailable()) return {};
+  await ensurePolyfills();
+  try {
+    return (await pkc().getClientCapabilities());
+  } catch {
+    return {};
+  }
+}
+
+async function api<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${API}${path}`, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new PasskeyApiError(data.error || `Request failed (${response.status})`, response.status, data.code);
+  }
+  return data as T;
+}
+
+function post<T>(path: string, body?: unknown): Promise<T> {
+  return api<T>(path, { method: 'POST', body: body === undefined ? undefined : JSON.stringify(body) });
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1.
+function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function signalUnknownCredential(rpId: string | undefined, credentialId: string) {
+  const statics = pkc();
+  if (!rpId || !statics.signalUnknownCredential) return;
+  try {
+    await statics.signalUnknownCredential({ rpId, credentialId });
+  } catch (error) {
+    console.warn('signalUnknownCredential sync warning:', error);
+  }
+}
+
+export async function signalAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  if (!isWebAuthnAvailable()) return;
+  const statics = pkc();
+  if (!statics.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId, or credential IDs.');
+    return;
+  }
+  try {
+    await statics.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (error) {
+    console.warn('signalAllAcceptedCredentials sync warning:', error);
+  }
+}
+
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  if (!isWebAuthnAvailable()) return;
+  const statics = pkc();
+  if (!statics.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await statics.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (error) {
+    console.warn('signalCurrentUserDetails sync warning:', error);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+export type RegisterResult =
+  | { status: 'created'; credential: PasskeySummary }
+  | { status: 'cancelled' }
+  | { status: 'error'; message: string };
+
+export async function registerPasskey({ promotion = false } = {}): Promise<RegisterResult> {
+  await ensurePolyfills();
+  let publicKey: PublicKeyCredentialCreationOptions;
+  try {
+    const optionsJSON = await post<unknown>('/passkeys/register-options', { promotion });
+    publicKey = pkc().parseCreationOptionsFromJSON(optionsJSON);
+  } catch (error) {
+    return { status: 'error', message: (error as Error).message };
+  }
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (error) {
+    switch ((error as DOMException).name) {
+      case 'InvalidStateError':
+        return { status: 'error', message: 'A passkey for this account already exists in this password manager.' };
+      case 'NotAllowedError':
+      case 'AbortError':
+        return { status: 'cancelled' };
+      case 'SecurityError':
+        return { status: 'error', message: 'Passkeys are not available on this site configuration.' };
+      default:
+        return { status: 'error', message: 'Could not create a passkey. Please try again.' };
+    }
+  }
+
+  if (!credential) return { status: 'cancelled' };
+  const encoded = encode(credential);
+  try {
+    const { credential: saved } = await post<{ credential: PasskeySummary }>('/passkeys/register-verify', encoded);
+    return { status: 'created', credential: saved };
+  } catch (error) {
+    // The provider stored a passkey the server rejected; ask it to remove the orphan.
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    return { status: 'error', message: (error as Error).message };
+  }
+}
+
+// Silently offers to save a passkey right after a password sign-in. Never shows errors.
+export async function conditionalCreatePasskey(): Promise<boolean> {
+  const capabilities = await getCapabilities();
+  if (capabilities.conditionalCreate !== true) return false;
+
+  let publicKey: PublicKeyCredentialCreationOptions;
+  try {
+    const optionsJSON = await post<unknown>('/passkeys/register-options', { conditional: true });
+    publicKey = pkc().parseCreationOptionsFromJSON(optionsJSON);
+  } catch {
+    return false;
+  }
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      mediation: 'conditional',
+    } as CredentialCreationOptions);
+  } catch (error) {
+    if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes((error as DOMException).name)) {
+      console.warn('Unexpected conditional create error:', error);
+    }
+    return false;
+  }
+  if (!credential) return false;
+
+  const encoded = encode(credential);
+  try {
+    await post('/passkeys/register-verify', encoded);
+    return true;
+  } catch {
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    return false;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Authentication
+// ---------------------------------------------------------------------------
+
+export interface SignedInUser {
+  username: string;
+  displayName: string;
+}
+
+export type AuthResult =
+  | { status: 'signed-in'; user: SignedInUser }
+  | { status: 'cancelled' }
+  | { status: 'error'; message: string };
+
+async function getAssertion(
+  optionsPath: string,
+  verifyPath: string,
+  { signal, conditional = false }: { signal?: AbortSignal; conditional?: boolean },
+): Promise<{ status: 'ok'; data: unknown } | { status: 'cancelled' } | { status: 'error'; message: string }> {
+  await ensurePolyfills();
+  let publicKey: PublicKeyCredentialRequestOptions;
+  try {
+    const optionsJSON = await post<unknown>(optionsPath);
+    publicKey = pkc().parseRequestOptionsFromJSON(optionsJSON);
+  } catch (error) {
+    return { status: 'error', message: (error as Error).message };
+  }
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      signal,
+      ...(conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    });
+  } catch (error) {
+    const name = (error as DOMException).name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    return { status: 'error', message: 'Passkey sign-in failed. Please try again.' };
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = encode(credential);
+  try {
+    return { status: 'ok', data: await post(verifyPath, encoded) };
+  } catch (error) {
+    // Only a 404 means the server has no record of this passkey.
+    if (error instanceof PasskeyApiError && error.status === 404) {
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+    }
+    return { status: 'error', message: (error as Error).message };
+  }
+}
+
+export async function signInWithPasskey(options: { signal?: AbortSignal; conditional?: boolean } = {}): Promise<AuthResult> {
+  const result = await getAssertion('/passkeys/login-options', '/passkeys/login-verify', options);
+  if (result.status !== 'ok') return result;
+  return { status: 'signed-in', user: result.data as SignedInUser };
+}
+
+export type ReauthResult = { status: 'verified' } | { status: 'cancelled' } | { status: 'error'; message: string };
+
+// Step-up verification restricted to the signed-in user's own passkeys.
+export async function reauthenticateWithPasskey(signal?: AbortSignal): Promise<ReauthResult> {
+  const result = await getAssertion('/passkeys/reauth-options', '/passkeys/reauth-verify', { signal });
+  if (result.status !== 'ok') return result;
+  return { status: 'verified' };
+}
+
+// ---------------------------------------------------------------------------
+// Account APIs
+// ---------------------------------------------------------------------------
+
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  providerIcon?: { light?: string; dark?: string };
+  registeredAt: number;
+  lastUsedAt?: number;
+  backedUp: boolean;
+  deviceType: 'singleDevice' | 'multiDevice';
+}
+
+export interface PasskeyList {
+  rpId: string;
+  userId: string;
+  user: SignedInUser;
+  reauthenticated: boolean;
+  credentials: PasskeySummary[];
+}
+
+export const accountApi = {
+  passwordSignIn: (username: string, password: string) =>
+    post<SignedInUser & { hasPasskey: boolean }>('/login', { username, password }),
+  passwordSignUp: (username: string, password: string) => post<SignedInUser>('/register', { username, password }),
+  signOut: () => api('/session', { method: 'DELETE' }),
+  listPasskeys: () => api<PasskeyList>('/passkeys'),
+  renamePasskey: (id: string, name: string) =>
+    api<{ credential: PasskeySummary }>(`/passkeys/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ name }) }),
+  deletePasskey: (id: string) => api(`/passkeys/${encodeURIComponent(id)}`, { method: 'DELETE' }),
+  updateProfile: (displayName: string) =>
+    api<{ name: string; displayName: string; rpId: string; userId: string }>('/user', {
+      method: 'PUT',
+      body: JSON.stringify({ displayName }),
+    }),
+};
