diff --git a/src/components/PasskeyPromotion.tsx b/src/components/PasskeyPromotion.tsx
new file mode 100644
index 0000000..e2b1cf1
--- /dev/null
+++ b/src/components/PasskeyPromotion.tsx
@@ -0,0 +1,86 @@
+import { useState } from 'react';
+import { FingerPrintIcon } from '@heroicons/react/24/outline';
+import { registerPasskey } from '../lib/passkeys-client';
+
+interface Props {
+  title: string;
+  intro?: string;
+  onDone: (created: boolean) => void;
+}
+
+// Offers a platform passkey right after password sign-in or sign-up.
+// Only render this when getClientCapabilities() reports platform passkey support.
+export default function PasskeyPromotion({ title, intro, onDone }: Props) {
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [created, setCreated] = useState(false);
+
+  const handleCreate = async () => {
+    setError(null);
+    setLoading(true);
+    const result = await registerPasskey({ promotion: true });
+    setLoading(false);
+    if (result.status === 'created') {
+      setCreated(true);
+    } else if (result.status === 'error') {
+      setError(result.message);
+    }
+  };
+
+  return (
+    <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+      <FingerPrintIcon className="h-12 w-12 mx-auto text-gray-800" aria-hidden="true" />
+      <h2 className="text-2xl font-bold mt-4 mb-2 text-gray-800">{created ? 'Passkey created' : title}</h2>
+
+      {intro && !created && <p className="mb-2 text-sm text-gray-600">{intro}</p>}
+
+      {created ? (
+        <p className="mb-6 text-sm text-gray-600" role="status">
+          Next time, sign in with your fingerprint, face, or screen lock. You can manage passkeys in your account
+          settings.
+        </p>
+      ) : (
+        <p className="mb-6 text-sm text-gray-600">
+          Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password. They're
+          phishing-resistant and sync across your devices.
+        </p>
+      )}
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg text-left" role="alert">
+          {error}
+        </div>
+      )}
+
+      {created ? (
+        <button
+          type="button"
+          onClick={() => onDone(true)}
+          className="w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+        >
+          Continue
+        </button>
+      ) : (
+        <div className="space-y-3">
+          <button
+            type="button"
+            onClick={handleCreate}
+            disabled={loading}
+            className={`w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+              loading ? 'opacity-75 cursor-not-allowed' : ''
+            }`}
+          >
+            {loading ? 'Creating passkey...' : 'Create a passkey'}
+          </button>
+          <button
+            type="button"
+            onClick={() => onDone(false)}
+            className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900"
+          >
+            Not now
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
