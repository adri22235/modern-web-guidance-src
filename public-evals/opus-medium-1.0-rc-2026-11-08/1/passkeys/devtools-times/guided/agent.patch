+import type { APIRoute } from 'astro';
+import { REAUTH_WINDOW_MS } from '../../../../lib/auth/config';
+import { errorResponse, verifyAuthentication } from '../../../../lib/auth/passkeys';
+import { getCurrentUser, json, markReauthenticated } from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  try {
+    const credential = await verifyAuthentication(session, url, await request.json(), 'reauth');
+    // A valid passkey for a different account must never unlock this session.
+    if (credential.passkeyUserId !== user.id) {
+      return json({ error: 'That passkey belongs to a different account.' }, 403);
+    }
+    await markReauthenticated(session);
+    return json({ success: true, expiresIn: REAUTH_WINDOW_MS });
+  } catch (error) {
+    return errorResponse(error);
+  }
+};
