@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { EXTERNAL_AUTH_API } from '../../../lib/auth/config';
+import { json, signIn } from '../../../lib/auth/session';
+import { findOrCreateUser } from '../../../lib/auth/store';
+
+// Account creation. The upstream API owns the password; once it accepts the new
+// account the user is signed in so they can immediately add a passkey.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(`${EXTERNAL_AUTH_API}/register`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'The registration service is unavailable. Please try again later.' }, 502);
+  }
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data.error || 'Unknown error' }, upstream.status);
+  }
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user, 'password');
+  return json({ username: user.username, displayName: user.displayName });
+};
