diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..a7bff22
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { EXTERNAL_AUTH_API } from '../../../lib/auth/config';
+import { json, signIn } from '../../../lib/auth/session';
+import { findCredentialsByUserId, findOrCreateUser } from '../../../lib/auth/store';
+
+// Password sign-in. Credentials are verified by the upstream auth API; on success
+// a server session is established so passkeys can be attached to the account.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(`${EXTERNAL_AUTH_API}/login`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'The sign-in service is unavailable. Please try again later.' }, 502);
+  }
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data.error || 'Unknown error' }, upstream.status);
+  }
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user, 'password');
+  const passkeys = await findCredentialsByUserId(user.id);
+  return json({ username: user.username, displayName: user.displayName, hasPasskey: passkeys.length > 0 });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
new file mode 100644
index 0000000..8d29e29
--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { getCurrentUser, isRecentlyReauthenticated, json, toPublicCredential } from '../../../../lib/auth/session';
+import { deleteCredential, findCredentialById, saveCredential } from '../../../../lib/auth/store';
+
+async function ownedCredential(session: Parameters<APIRoute>[0]['session'], id: string | undefined) {
+  const user = await getCurrentUser(session);
+  if (!user) return { error: json({ error: 'Not signed in.' }, 401) };
+  const credential = id ? await findCredentialById(id) : undefined;
+  if (!credential || credential.passkeyUserId !== user.id) {
+    return { error: json({ error: 'Passkey not found.' }, 404) };
+  }
+  return { credential };
+}
+
+// Rename a passkey (server-side label only).
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const { credential, error } = await ownedCredential(session, params.id);
+  if (error) return error;
+  const { name } = await request.json().catch(() => ({}));
+  if (typeof name !== 'string' || !name.trim() || name.length > 64) {
+    return json({ error: 'Name must be between 1 and 64 characters.' }, 400);
+  }
+  credential.name = name.trim();
+  await saveCredential(credential);
+  return json({ credential: toPublicCredential(credential) });
+};
+
+// Deleting a sign-in method is sensitive and requires a recent passkey reauthentication.
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const { credential, error } = await ownedCredential(session, params.id);
+  if (error) return error;
+  if (!(await isRecentlyReauthenticated(session))) {
+    return json({ error: 'Please verify your identity first.', code: 'REAUTH_REQUIRED' }, 403);
+  }
+  await deleteCredential(credential.id);
+  return json({ success: true });
+};
