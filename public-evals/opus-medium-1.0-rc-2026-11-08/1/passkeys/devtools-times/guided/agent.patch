+import type { APIRoute } from 'astro';
+import { getRpId } from '../../../lib/auth/config';
+import { getCurrentUser, json } from '../../../lib/auth/session';
+import { updateUser } from '../../../lib/auth/store';
+
+// Update the signed-in user's display name. The response includes the RP ID and
+// WebAuthn user handle so the client can sync the change to password managers.
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+
+  const { displayName } = await request.json().catch(() => ({}));
+  if (typeof displayName !== 'string' || !displayName.trim() || displayName.length > 64) {
+    return json({ error: 'Display name must be between 1 and 64 characters.' }, 400);
+  }
+
+  const updated = await updateUser(user.id, { displayName: displayName.trim() });
+  return json({
+    name: updated!.username,
+    displayName: updated!.displayName,
+    rpId: getRpId(url),
+    userId: updated!.id,
+  });
+};
