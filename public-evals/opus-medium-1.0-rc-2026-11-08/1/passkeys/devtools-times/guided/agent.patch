+import type { APIRoute } from 'astro';
+import { getRpId } from '../../../../lib/auth/config';
+import { getCurrentUser, isRecentlyReauthenticated, json, toPublicCredential } from '../../../../lib/auth/session';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+
+// Lists the signed-in user's passkeys together with the server RP ID and the
+// Base64URL user handle needed for Signal API synchronization.
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  const credentials = await findCredentialsByUserId(user.id);
+  return json({
+    rpId: getRpId(url),
+    userId: user.id,
+    user: { username: user.username, displayName: user.displayName },
+    reauthenticated: await isRecentlyReauthenticated(session),
+    credentials: credentials.map(toPublicCredential),
+  });
+};
