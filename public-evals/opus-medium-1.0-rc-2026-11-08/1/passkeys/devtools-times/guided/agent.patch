index 0000000..62829cc
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,386 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { CheckBadgeIcon, CloudIcon, KeyIcon, PencilSquareIcon, ShieldCheckIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  accountApi,
+  getCapabilities,
+  PasskeyApiError,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalUserDetails,
+  type PasskeyList,
+  type PasskeySummary,
+} from '../lib/passkeys-client';
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const formatDate = (epoch: number) => dateFormat.format(new Date(epoch));
+
+type Notice = { kind: 'success' | 'error'; text: string } | null;
+
+export default function AccountSettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [canCreate, setCanCreate] = useState<boolean | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [verifying, setVerifying] = useState(false);
+  const [displayName, setDisplayName] = useState('');
+  const [savingProfile, setSavingProfile] = useState(false);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [pendingDelete, setPendingDelete] = useState<PasskeySummary | null>(null);
+  const deleteDialog = useRef<HTMLDialogElement>(null);
+
+  // Reload the list and keep password managers in sync with the server's view.
+  const refresh = async () => {
+    const list = await accountApi.listPasskeys();
+    setData(list);
+    await signalAcceptedCredentials(list.rpId, list.userId, list.credentials.map((c) => c.id));
+    return list;
+  };
+
+  useEffect(() => {
+    refresh()
+      .then((list) => setDisplayName(list.user.displayName))
+      .catch((error) => {
+        if (error instanceof PasskeyApiError && error.status === 401) {
+          window.location.assign(`${import.meta.env.BASE_URL}signin`);
+          return;
+        }
+        setLoadError((error as Error).message);
+      });
+    getCapabilities().then((capabilities) => setCanCreate(Boolean(capabilities.passkeyPlatformAuthenticator)));
+  }, []);
+
+  const handleCreate = async () => {
+    setNotice(null);
+    setCreating(true);
+    // Account settings allow both platform passkeys and roaming security keys.
+    const result = await registerPasskey();
+    setCreating(false);
+    if (result.status === 'created') {
+      setNotice({ kind: 'success', text: `Passkey "${result.credential.name}" created.` });
+      await refresh();
+    } else if (result.status === 'error') {
+      setNotice({ kind: 'error', text: result.message });
+    }
+  };
+
+  const verifyIdentity = async (): Promise<boolean> => {
+    setVerifying(true);
+    const result = await reauthenticateWithPasskey();
+    setVerifying(false);
+    if (result.status === 'verified') {
+      setData((current) => (current ? { ...current, reauthenticated: true } : current));
+      return true;
+    }
+    if (result.status === 'error') setNotice({ kind: 'error', text: result.message });
+    return false;
+  };
+
+  const handleProfileSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!data) return;
+    setNotice(null);
+    setSavingProfile(true);
+    try {
+      const updated = await accountApi.updateProfile(displayName);
+      setData({ ...data, user: { username: updated.name, displayName: updated.displayName } });
+      setNotice({ kind: 'success', text: 'Display name updated.' });
+      await signalUserDetails(updated.rpId, updated.userId, updated.name, updated.displayName);
+    } catch (error) {
+      setNotice({ kind: 'error', text: (error as Error).message });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  const startRename = (credential: PasskeySummary) => {
+    setRenamingId(credential.id);
+    setRenameValue(credential.name);
+  };
+
+  const handleRenameSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!renamingId) return;
+    setNotice(null);
+    try {
+      // Nicknames are server-side labels only; no Signal API call is needed.
+      await accountApi.renamePasskey(renamingId, renameValue);
+      setRenamingId(null);
+      await refresh();
+    } catch (error) {
+      setNotice({ kind: 'error', text: (error as Error).message });
+    }
+  };
+
+  const requestDelete = (credential: PasskeySummary) => {
+    setPendingDelete(credential);
+    deleteDialog.current?.showModal();
+  };
+
+  const performDelete = async (credential: PasskeySummary) => {
+    setNotice(null);
+    // Removing a sign-in method is sensitive: require a fresh passkey verification.
+    if (!data?.reauthenticated && !(await verifyIdentity())) return;
+    try {
+      await accountApi.deletePasskey(credential.id);
+    } catch (error) {
+      if (error instanceof PasskeyApiError && error.code === 'REAUTH_REQUIRED') {
+        // The verification window expired between steps; verify again and retry once.
+        if (!(await verifyIdentity())) return;
+        try {
+          await accountApi.deletePasskey(credential.id);
+        } catch (retryError) {
+          setNotice({ kind: 'error', text: (retryError as Error).message });
+          return;
+        }
+      } else {
+        setNotice({ kind: 'error', text: (error as Error).message });
+        return;
+      }
+    }
+    setNotice({ kind: 'success', text: `Passkey "${credential.name}" deleted.` });
+    await refresh();
+  };
+
+  const handleDeleteDialogClose = () => {
+    const dialog = deleteDialog.current!;
+    const confirmed = dialog.returnValue === 'delete';
+    dialog.returnValue = '';
+    const credential = pendingDelete;
+    setPendingDelete(null);
+    if (confirmed && credential) performDelete(credential);
+  };
+
+  const handleSignOut = async () => {
+    await accountApi.signOut().catch(() => {});
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  if (loadError) {
+    return (
+      <div className="max-w-2xl mx-auto mt-10 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+        {loadError}
+      </div>
+    );
+  }
+
+  if (!data) {
+    return <p className="max-w-2xl mx-auto mt-10 text-sm text-gray-500">Loading your account…</p>;
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-center justify-between">
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="text-sm font-medium text-gray-700 underline hover:text-gray-900"
+        >
+          Sign out
+        </button>
+      </div>
+
+      {notice && (
+        <div
+          className={`p-3 text-sm rounded-lg ${notice.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'}`}
+          role={notice.kind === 'error' ? 'alert' : 'status'}
+        >
+          {notice.text}
+        </div>
+      )}
+
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-800 mb-4">Profile</h2>
+        <form onSubmit={handleProfileSubmit} className="space-y-4">
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+            <input
+              id="account-username"
+              type="text"
+              value={data.user.username}
+              readOnly
+              autoComplete="username"
+              className="w-full px-3 py-2 border border-gray-200 rounded-md bg-gray-50 text-gray-600"
+            />
+          </div>
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              autoComplete="name"
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <p className="text-xs text-gray-500 mt-1">Shown in your password manager next to your passkeys.</p>
+          </div>
+          <button
+            type="submit"
+            disabled={savingProfile || displayName.trim() === data.user.displayName}
+            className="py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+          >
+            {savingProfile ? 'Saving…' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-2">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">Passkeys</h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Sign in with your fingerprint, face, screen lock, or a security key instead of a password.
+            </p>
+          </div>
+          {canCreate && (
+            <button
+              type="button"
+              onClick={handleCreate}
+              disabled={creating}
+              className="flex items-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+            >
+              <KeyIcon className="h-5 w-5" aria-hidden="true" />
+              {creating ? 'Creating…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {canCreate === false && (
+          <p className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser or device doesn't support passkeys. You can keep signing in with your password, or add a
+            passkey from a supported device.
+          </p>
+        )}
+
+        {data.credentials.length > 0 && (
+          <div className="mt-4 flex flex-wrap items-center gap-3 text-sm">
+            {data.reauthenticated ? (
+              <span className="flex items-center gap-1 text-green-700">
+                <CheckBadgeIcon className="h-5 w-5" aria-hidden="true" />
+                Identity verified. You can make sensitive changes for a few minutes.
+              </span>
+            ) : (
+              <>
+                <span className="text-gray-600">Deleting a passkey requires verifying it's you.</span>
+                <button
+                  type="button"
+                  onClick={verifyIdentity}
+                  disabled={verifying}
+                  className="flex items-center gap-1 font-medium text-gray-900 underline disabled:opacity-75"
+                >
+                  <ShieldCheckIcon className="h-5 w-5" aria-hidden="true" />
+                  {verifying ? 'Verifying…' : 'Verify with passkey'}
+                </button>
+              </>
+            )}
+          </div>
+        )}
+
+        {data.credentials.length === 0 ? (
+          <p className="mt-6 text-sm text-gray-500">No passkeys yet.</p>
+        ) : (
+          <ul className="mt-4 divide-y divide-gray-200">
+            {data.credentials.map((credential) => (
+              <li key={credential.id} className="py-4 flex items-start gap-4">
+                {credential.providerIcon?.light ? (
+                  <img src={credential.providerIcon.light} alt="" width={32} height={32} className="h-8 w-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="h-8 w-8 shrink-0 text-gray-500" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-0">
+                  {renamingId === credential.id ? (
+                    <form onSubmit={handleRenameSubmit} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${credential.id}`} className="sr-only">Passkey name</label>
+                      <input
+                        id={`rename-${credential.id}`}
+                        type="text"
+                        value={renameValue}
+                        onChange={(e) => setRenameValue(e.target.value)}
+                        required
+                        maxLength={64}
+                        autoFocus
+                        className="flex-1 min-w-40 px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button type="submit" className="px-3 py-1 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800">
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setRenamingId(null)}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-900 truncate">{credential.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-1">
+                    Created {formatDate(credential.registeredAt)}
+                    {' · '}
+                    {credential.lastUsedAt ? `Last used ${formatDate(credential.lastUsedAt)}` : 'Never used'}
+                  </p>
+                  {credential.backedUp && (
+                    <p className="text-xs text-gray-500 mt-1 flex items-center gap-1">
+                      <CloudIcon className="h-4 w-4" aria-hidden="true" />
+                      Synced across your devices
+                    </p>
+                  )}
+                </div>
+
+                {renamingId !== credential.id && (
+                  <div className="flex shrink-0 gap-1">
+                    <button
+                      type="button"
+                      onClick={() => startRename(credential)}
+                      className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900"
+                      aria-label={`Rename ${credential.name}`}
+                    >
+                      <PencilSquareIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => requestDelete(credential)}
+                      className="p-2 rounded-md text-gray-600 hover:bg-red-50 hover:text-red-700"
+                      aria-label={`Delete ${credential.name}`}
+                    >
+                      <TrashIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={deleteDialog}
+        onClose={handleDeleteDialogClose}
+        aria-labelledby="delete-passkey-title"
+        className="passkey-dialog m-auto max-w-sm w-full p-6 rounded-lg shadow-lg backdrop:bg-black/40"
+      >
+        <h2 id="delete-passkey-title" className="text-lg font-bold text-gray-900">Delete this passkey?</h2>
+        <p className="mt-2 text-sm text-gray-600">
+          You won't be able to sign in with “{pendingDelete?.name}” anymore. Your password manager may also remove it.
+          {!data.reauthenticated && ' You will be asked to verify your identity with a passkey first.'}
+        </p>
+        <form method="dialog" className="mt-6 flex justify-end gap-2">
+          <button value="cancel" autoFocus className="px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100">
+            Cancel
+          </button>
+          <button value="delete" className="px-4 py-2 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800">
+            Delete
+          </button>
+        </form>
+      </dialog>
+    </div>
+  );
+}
