+/**
+ * Minimal CBOR (RFC 8949) decoder covering the subset of types used by
+ * WebAuthn attestation objects and COSE public keys.
+ */
+
+export type CborValue =
+  | number
+  | bigint
+  | string
+  | boolean
+  | null
+  | undefined
+  | Uint8Array
+  | CborValue[]
+  | Map<CborValue, CborValue>;
+
+export function decodeCbor(data: Uint8Array): CborValue {
+  const { value, offset } = decodeCborItem(data, 0);
+  if (offset !== data.length) {
+    throw new Error('CBOR: unexpected trailing bytes');
+  }
+  return value;
+}
+
+/**
+ * Decodes a single CBOR item starting at `start` and returns the value along
+ * with the offset of the first byte after it. Useful for data that has CBOR
+ * embedded in the middle of a binary structure (e.g. authenticator data).
+ */
+export function decodeCborItem(data: Uint8Array, start: number): { value: CborValue; offset: number } {
+  const view = new DataView(data.buffer, data.byteOffset, data.byteLength);
+  let offset = start;
+
+  const need = (n: number) => {
+    if (offset + n > data.length) throw new Error('CBOR: unexpected end of data');
+  };
+
+  const readLength = (additional: number): number => {
+    if (additional < 24) return additional;
+    if (additional === 24) {
+      need(1);
+      return data[offset++];
+    }
+    if (additional === 25) {
+      need(2);
+      const v = view.getUint16(offset);
+      offset += 2;
+      return v;
+    }
+    if (additional === 26) {
+      need(4);
+      const v = view.getUint32(offset);
+      offset += 4;
+      return v;
+    }
+    if (additional === 27) {
+      need(8);
+      const v = view.getBigUint64(offset);
+      offset += 8;
+      if (v > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error('CBOR: length too large');
+      return Number(v);
+    }
+    throw new Error('CBOR: indefinite lengths are not supported');
+  };
+
+  const readItem = (depth: number): CborValue => {
+    if (depth > 32) throw new Error('CBOR: nesting too deep');
+    need(1);
+    const initial = data[offset++];
+    const major = initial >> 5;
+    const additional = initial & 0x1f;
+
+    switch (major) {
+      case 0:
+        return readLength(additional);
+      case 1:
+        return -1 - readLength(additional);
+      case 2: {
+        const len = readLength(additional);
+        need(len);
+        const bytes = data.slice(offset, offset + len);
+        offset += len;
+        return bytes;
+      }
+      case 3: {
+        const len = readLength(additional);
+        need(len);
+        const text = new TextDecoder('utf-8', { fatal: true }).decode(data.subarray(offset, offset + len));
+        offset += len;
+        return text;
+      }
+      case 4: {
+        const len = readLength(additional);
+        const arr: CborValue[] = [];
+        for (let i = 0; i < len; i++) arr.push(readItem(depth + 1));
+        return arr;
+      }
+      case 5: {
+        const len = readLength(additional);
+        const map = new Map<CborValue, CborValue>();
+        for (let i = 0; i < len; i++) {
+          const key = readItem(depth + 1);
+          map.set(key, readItem(depth + 1));
+        }
+        return map;
+      }
+      case 6:
+        // Tags carry no meaning for our purposes; return the tagged item.
+        readLength(additional);
+        return readItem(depth + 1);
+      case 7: {
+        if (additional === 20) return false;
+        if (additional === 21) return true;
+        if (additional === 22) return null;
+        if (additional === 23) return undefined;
+        if (additional === 25) {
+          need(2);
+          const half = view.getUint16(offset);
+          offset += 2;
+          const exp = (half >> 10) & 0x1f;
+          const mant = half & 0x3ff;
+          const sign = half & 0x8000 ? -1 : 1;
+          if (exp === 0) return sign * mant * 2 ** -24;
+          if (exp === 31) return mant ? NaN : sign * Infinity;
+          return sign * (1 + mant / 1024) * 2 ** (exp - 15);
+        }
+        if (additional === 26) {
+          need(4);
+          const v = view.getFloat32(offset);
+          offset += 4;
+          return v;
+        }
+        if (additional === 27) {
+          need(8);
+          const v = view.getFloat64(offset);
+          offset += 8;
+          return v;
+        }
+        throw new Error('CBOR: unsupported simple value');
+      }
+      default:
+        throw new Error('CBOR: unknown major type');
+    }
+  };
+
+  const value = readItem(0);
+  return { value, offset };
+}
