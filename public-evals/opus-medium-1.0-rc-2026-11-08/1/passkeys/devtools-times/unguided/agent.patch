 - **[React](https://react.dev/)**: Used for UI components.
 - **[Tailwind CSS](https://tailwindcss.com/)**: For styling the application.
 - **[Astro DB](https://docs.astro.build/en/guides/database/)**: Powers the comments feature, using a libSQL-compatible database.
+
+## Passkeys
+
+Readers can sign up, sign in and reauthenticate with passkeys (WebAuthn), and manage them on the `/account` page.
+
+- Usernames and passwords stay in the external Times auth service; password sign-in/sign-up are proxied through `/api/auth/*` so the server can establish a session.
+- Passkey verification is implemented in `src/lib/auth/webauthn.ts` using `node:crypto` (ES256, EdDSA, RS256; attestation `none`).
+- Passkeys are stored in a JSON file, `.data/passkeys.json` by default (override with `PASSKEY_DATA_FILE`). Use persistent storage in production.
+- The relying party ID and allowed origins default to the request's hostname/origin; override with `PASSKEY_RP_ID` and `PASSKEY_ORIGINS` (comma-separated) when running behind a proxy.
+- Adding or deleting a passkey requires a sign-in or reauthentication within the last 5 minutes.
diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..4cd139c
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,352 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { CloudIcon, DevicePhoneMobileIcon, FingerPrintIcon, KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import ReauthDialog from './ReauthDialog';
+import {
+  ApiError,
+  PasskeyCancelledError,
+  api,
+  errorMessage,
+  formatDate,
+  isWebAuthnSupported,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalUserDetails,
+} from '../lib/passkeys-client';
+
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  provider: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  transports: string[];
+}
+
+interface AccountSettingsProps {
+  username: string;
+  hasPassword: boolean;
+  signInMethod: 'password' | 'passkey';
+  rpId: string;
+  userId: string;
+  initialPasskeys: PasskeySummary[];
+}
+
+export default function AccountSettings({ username, hasPassword, signInMethod, rpId, userId, initialPasskeys }: AccountSettingsProps) {
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [supported, setSupported] = useState(true);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const reauthResolver = useRef<((ok: boolean) => void) | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL;
+
+  useEffect(() => {
+    setSupported(isWebAuthnSupported());
+    if (!isWebAuthnSupported()) return;
+    // Keep the user's passkey providers in sync with the server: hide deleted
+    // passkeys and make sure the displayed account name is current.
+    signalAcceptedCredentials({ rpId, userId, credentialIds: initialPasskeys.map((p) => p.id) });
+    signalUserDetails({ rpId, userId, name: username, displayName: username });
+  }, []);
+
+  const notify = (message: string) => {
+    setError(null);
+    setSuccess(message);
+  };
+
+  const requestReauth = () =>
+    new Promise<boolean>((resolve) => {
+      reauthResolver.current = resolve;
+      setReauthOpen(true);
+    });
+
+  const closeReauth = (ok: boolean) => {
+    setReauthOpen(false);
+    reauthResolver.current?.(ok);
+    reauthResolver.current = null;
+  };
+
+  /** Runs a sensitive action, prompting for reauthentication if the server asks for it. */
+  const withReauth = async <T,>(action: () => Promise<T>): Promise<T | null> => {
+    try {
+      return await action();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'reauth_required') {
+        if (!(await requestReauth())) return null;
+        return await action();
+      }
+      throw err;
+    }
+  };
+
+  const handleAdd = async () => {
+    setError(null);
+    setSuccess(null);
+    setAdding(true);
+    try {
+      const result = await withReauth(() => registerPasskey({ purpose: 'add' }));
+      if (result) {
+        setPasskeys(result.passkeys);
+        notify(`Passkey “${result.passkey.name}” created.`);
+      }
+    } catch (err) {
+      if (!(err instanceof PasskeyCancelledError)) setError(errorMessage(err));
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const startRename = (passkey: PasskeySummary) => {
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    setBusyId(id);
+    try {
+      const result = await api(`/passkeys/${encodeURIComponent(id)}`, { method: 'PATCH', body: { name: editName } });
+      setPasskeys((list) => list.map((p) => (p.id === id ? result.passkey : p)));
+      setEditingId(null);
+      notify('Passkey renamed.');
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleDelete = async (passkey: PasskeySummary) => {
+    setError(null);
+    setSuccess(null);
+    setBusyId(passkey.id);
+    try {
+      const result = await withReauth(() => api(`/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE', body: {} }));
+      if (result) {
+        setPasskeys(result.passkeys);
+        setConfirmDeleteId(null);
+        notify(`Passkey “${passkey.name}” deleted. You may also want to remove it from ${passkey.provider ?? 'your password manager'}.`);
+        await signalAcceptedCredentials(result.signals);
+      }
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleSignOut = async () => {
+    try {
+      await api('/logout', { body: {} });
+    } finally {
+      window.location.assign(baseUrl);
+    }
+  };
+
+  const isLastSignInMethod = !hasPassword && passkeys.length === 1;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div>
+        <h2 className="text-3xl font-bold text-gray-800">Account settings</h2>
+        <p className="text-sm text-gray-600 mt-1">Manage how you sign in to The DevTools Times.</p>
+      </div>
+
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      {success && (
+        <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {success}
+        </div>
+      )}
+
+      {/* Profile */}
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="profile-heading">
+        <h3 id="profile-heading" className="text-lg font-bold text-gray-800 mb-4">
+          Profile
+        </h3>
+        <dl className="grid grid-cols-1 sm:grid-cols-3 gap-y-3 text-sm">
+          <dt className="text-gray-500">Username</dt>
+          <dd className="sm:col-span-2 font-medium text-gray-900">{username}</dd>
+          <dt className="text-gray-500">Password</dt>
+          <dd className="sm:col-span-2 text-gray-900">{hasPassword ? 'Set' : 'Not set — this account uses passkeys only'}</dd>
+          <dt className="text-gray-500">Current session</dt>
+          <dd className="sm:col-span-2 text-gray-900">Signed in with {signInMethod === 'passkey' ? 'a passkey' : 'a password'}</dd>
+        </dl>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="mt-6 py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
+        >
+          Sign out
+        </button>
+      </section>
+
+      {/* Passkeys */}
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-2">
+          <div>
+            <h3 id="passkeys-heading" className="text-lg font-bold text-gray-800">
+              Passkeys
+            </h3>
+            <p className="text-sm text-gray-600 mt-1 max-w-md">
+              Passkeys let you sign in securely with your fingerprint, face or screen lock — no password to remember, and
+              nothing to phish.
+            </p>
+          </div>
+          {supported && (
+            <button
+              type="button"
+              onClick={handleAdd}
+              disabled={adding}
+              className="flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+            >
+              <FingerPrintIcon className="w-5 h-5" aria-hidden="true" />
+              {adding ? 'Creating...' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!supported && (
+          <p className="mt-4 p-3 text-sm text-yellow-800 bg-yellow-50 rounded-lg">
+            This browser doesn’t support passkeys. Try a recent version of Chrome, Edge, Safari or Firefox.
+          </p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <div className="mt-6 flex items-center gap-3 p-4 bg-gray-50 rounded-lg text-sm text-gray-700">
+            <KeyIcon className="w-6 h-6 shrink-0 text-gray-500" aria-hidden="true" />
+            You haven’t created any passkeys yet.
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {passkeys.map((passkey) => {
+              const SyncIcon = passkey.backedUp ? CloudIcon : DevicePhoneMobileIcon;
+              const busy = busyId === passkey.id;
+              return (
+                <li key={passkey.id} className="py-4">
+                  <div className="flex flex-wrap items-start justify-between gap-3">
+                    <div className="flex items-start gap-3 min-w-0">
+                      <KeyIcon className="w-6 h-6 mt-0.5 shrink-0 text-gray-700" aria-hidden="true" />
+                      <div className="min-w-0">
+                        {editingId === passkey.id ? (
+                          <form onSubmit={(e) => handleRename(e, passkey.id)} className="flex flex-wrap items-center gap-2">
+                            <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                              Passkey name
+                            </label>
+                            <input
+                              id={`rename-${passkey.id}`}
+                              value={editName}
+                              onChange={(e) => setEditName(e.target.value)}
+                              maxLength={64}
+                              required
+                              autoFocus
+                              className="px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                            />
+                            <button type="submit" disabled={busy} className="text-sm font-medium text-gray-900 underline">
+                              Save
+                            </button>
+                            <button type="button" onClick={() => setEditingId(null)} className="text-sm text-gray-600 underline">
+                              Cancel
+                            </button>
+                          </form>
+                        ) : (
+                          <p className="font-medium text-gray-900 truncate">{passkey.name}</p>
+                        )}
+                        <p className="text-xs text-gray-500 mt-1">
+                          Created {formatDate(passkey.createdAt)} · Last used {formatDate(passkey.lastUsedAt)}
+                        </p>
+                        <p className="text-xs text-gray-500 mt-1 flex items-center gap-1">
+                          <SyncIcon className="w-4 h-4" aria-hidden="true" />
+                          {passkey.backedUp ? 'Synced across your devices' : 'Stored on a single device'}
+                          {passkey.provider && passkey.provider !== passkey.name ? ` · ${passkey.provider}` : ''}
+                        </p>
+                      </div>
+                    </div>
+
+                    {editingId !== passkey.id && confirmDeleteId !== passkey.id && (
+                      <div className="flex items-center gap-1">
+                        <button
+                          type="button"
+                          onClick={() => startRename(passkey)}
+                          className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900"
+                          aria-label={`Rename ${passkey.name}`}
+                          title="Rename"
+                        >
+                          <PencilSquareIcon className="w-5 h-5" aria-hidden="true" />
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            setEditingId(null);
+                            setConfirmDeleteId(passkey.id);
+                          }}
+                          className="p-2 rounded-md text-gray-600 hover:bg-red-50 hover:text-red-700"
+                          aria-label={`Delete ${passkey.name}`}
+                          title="Delete"
+                        >
+                          <TrashIcon className="w-5 h-5" aria-hidden="true" />
+                        </button>
+                      </div>
+                    )}
+                  </div>
+
+                  {confirmDeleteId === passkey.id && (
+                    <div className="mt-3 p-3 bg-red-50 rounded-lg text-sm" role="alertdialog" aria-label="Confirm passkey deletion">
+                      {isLastSignInMethod ? (
+                        <p className="text-red-800">
+                          This is the only way to sign in to your account. Create another passkey before deleting this one.
+                        </p>
+                      ) : (
+                        <p className="text-red-800">
+                          Delete “{passkey.name}”? You won’t be able to sign in with it anymore.
+                        </p>
+                      )}
+                      <div className="mt-2 flex gap-3">
+                        {!isLastSignInMethod && (
+                          <button
+                            type="button"
+                            onClick={() => handleDelete(passkey)}
+                            disabled={busy}
+                            className="py-1 px-3 rounded-md text-white bg-red-700 hover:bg-red-800 disabled:opacity-75"
+                          >
+                            {busy ? 'Deleting...' : 'Delete passkey'}
+                          </button>
+                        )}
+                        <button type="button" onClick={() => setConfirmDeleteId(null)} className="py-1 px-3 text-gray-700 underline">
+                          Cancel
+                        </button>
+                      </div>
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </section>
+
+      {reauthOpen && (
+        <ReauthDialog
+          username={username}
+          hasPassword={hasPassword}
+          hasPasskeys={passkeys.length > 0 && supported}
+          onSuccess={() => closeReauth(true)}
+          onCancel={() => closeReauth(false)}
+        />
+      )}
+    </div>
+  );
+}
