@@ -0,0 +1,37 @@
+import { getRelyingParty, handler, HttpError, json, readJson, requireUser, saveChallenge } from '../../../../lib/auth/server.ts';
+import { listPasskeys } from '../../../../lib/auth/store.ts';
+import { buildAuthenticationOptions, generateChallenge } from '../../../../lib/auth/webauthn.ts';
+
+/**
+ * Starts a passkey assertion.
+ * - purpose "signin": discoverable credentials (also used for autofill / conditional UI).
+ * - purpose "reauth": limited to the signed-in user's passkeys.
+ */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ purpose?: unknown }>(context);
+  const rp = getRelyingParty(context);
+  const challenge = generateChallenge();
+
+  if (body.purpose === 'reauth') {
+    const { user } = await requireUser(context);
+    const passkeys = await listPasskeys(user.id);
+    if (passkeys.length === 0) {
+      throw new HttpError(400, 'no_passkeys', 'This account has no passkeys yet.');
+    }
+    saveChallenge(context, { challenge, ceremony: 'authentication', purpose: 'reauth', userId: user.id });
+    return json(
+      buildAuthenticationOptions({
+        rp,
+        challenge,
+        allowCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+      }),
+    );
+  }
+
+  if (body.purpose === 'signin') {
+    saveChallenge(context, { challenge, ceremony: 'authentication', purpose: 'signin' });
+    return json(buildAuthenticationOptions({ rp, challenge, allowCredentials: [] }));
+  }
+
+  throw new HttpError(400, 'invalid_purpose', 'Unknown authentication purpose.');
+});
