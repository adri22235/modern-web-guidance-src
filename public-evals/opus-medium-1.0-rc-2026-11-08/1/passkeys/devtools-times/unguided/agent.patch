@@ -0,0 +1,46 @@
+/**
+ * Client for the external Times account service that owns usernames/passwords.
+ * Calls are made server-side so that a successful response can be trusted when
+ * establishing a session.
+ */
+import { randomBytes } from 'node:crypto';
+
+const AUTH_API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface ExternalResult {
+  ok: boolean;
+  status: number;
+  data: Record<string, unknown>;
+}
+
+async function call(path: 'login' | 'register', username: string, password: string): Promise<ExternalResult> {
+  const response = await fetch(`${AUTH_API_BASE}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+    signal: AbortSignal.timeout(10_000),
+  });
+  let data: Record<string, unknown> = {};
+  try {
+    data = await response.json();
+  } catch {
+    // Non-JSON error bodies are reported with an empty payload.
+  }
+  return { ok: response.ok, status: response.status, data };
+}
+
+export function externalLogin(username: string, password: string) {
+  return call('login', username, password);
+}
+
+export function externalRegister(username: string, password: string) {
+  return call('register', username, password);
+}
+
+/**
+ * Generates a strong random password for passkey-only accounts, so the username
+ * is reserved in the external service without the user ever needing a password.
+ */
+export function generateUnusablePassword() {
+  return `pk-${randomBytes(24).toString('base64url')}-${randomBytes(2).readUInt16BE(0)}`;
+}
diff --git a/src/lib/auth/server.ts b/src/lib/auth/server.ts
new file mode 100644
index 0000000..cdca5f0
--- /dev/null
+++ b/src/lib/auth/server.ts
@@ -0,0 +1,227 @@
+/**
+ * Shared helpers for the auth API routes: JSON responses, CSRF checks,
+ * session state, pending WebAuthn challenges and recent-authentication checks.
+ */
+import type { APIContext, APIRoute } from 'astro';
+import { providerName } from './aaguid.ts';
+import { findUserById, type StoredPasskey, type StoredUser } from './store.ts';
+import { CEREMONY_TIMEOUT_MS, WebAuthnError, type RelyingParty } from './webauthn.ts';
+
+/** Sensitive account changes require a sign-in or reauthentication within this window. */
+export const REAUTH_MAX_AGE_MS = 5 * 60 * 1000;
+
+export const RP_NAME = 'The DevTools Times';
+
+export interface AuthState {
+  userId: string;
+  username: string;
+  method: 'password' | 'passkey';
+  /** Epoch ms of the last sign-in or reauthentication. */
+  authenticatedAt: number;
+}
+
+export interface PendingChallenge {
+  challenge: string;
+  ceremony: 'registration' | 'authentication';
+  purpose: 'signup' | 'add' | 'signin' | 'reauth';
+  /** For registration: the user handle the credential is being created for. */
+  userId?: string;
+  username?: string;
+  expiresAt: number;
+}
+
+export class HttpError extends Error {
+  status: number;
+  code: string;
+  extra?: Record<string, unknown>;
+  constructor(status: number, code: string, message: string, extra?: Record<string, unknown>) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.extra = extra;
+  }
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+/** Wraps a route so thrown HttpError/WebAuthnError instances become JSON error responses. */
+export function handler(fn: (context: APIContext) => Promise<Response>): APIRoute {
+  return async (context) => {
+    try {
+      if (!context.session) {
+        throw new HttpError(500, 'sessions_unavailable', 'Sessions are not configured on this server.');
+      }
+      return await fn(context);
+    } catch (err) {
+      if (err instanceof HttpError) {
+        return json({ error: err.code, message: err.message, ...err.extra }, err.status);
+      }
+      if (err instanceof WebAuthnError) {
+        return json({ error: err.code, message: err.message }, 400);
+      }
+      console.error('[auth] Unexpected error', err);
+      return json({ error: 'server_error', message: 'An unexpected error occurred. Please try again later.' }, 500);
+    }
+  };
+}
+
+/**
+ * Parses a JSON request body. Requiring application/json (which cannot be sent
+ * cross-site without a CORS preflight) plus an Origin check protects the
+ * cookie-authenticated endpoints against CSRF.
+ */
+export async function readJson<T = Record<string, unknown>>(context: APIContext): Promise<T> {
+  assertSameOrigin(context);
+  const contentType = context.request.headers.get('content-type') ?? '';
+  if (!contentType.toLowerCase().startsWith('application/json')) {
+    throw new HttpError(415, 'unsupported_media_type', 'Expected a JSON request body.');
+  }
+  try {
+    const body = await context.request.json();
+    if (!body || typeof body !== 'object') throw new Error('not an object');
+    return body as T;
+  } catch {
+    throw new HttpError(400, 'invalid_json', 'Request body is not valid JSON.');
+  }
+}
+
+export function assertSameOrigin(context: APIContext) {
+  const origin = context.request.headers.get('origin');
+  if (origin && !getRelyingParty(context).origins.includes(origin)) {
+    throw new HttpError(403, 'invalid_origin', 'Cross-origin requests are not allowed.');
+  }
+}
+
+export function getRelyingParty(context: { url: URL }): RelyingParty {
+  const id = process.env.PASSKEY_RP_ID || context.url.hostname;
+  const origins = process.env.PASSKEY_ORIGINS
+    ? process.env.PASSKEY_ORIGINS.split(',').map((o) => o.trim()).filter(Boolean)
+    : [context.url.origin];
+  return { id, name: RP_NAME, origins };
+}
+
+// ---------------------------------------------------------------------------
+// Session state
+// ---------------------------------------------------------------------------
+
+export async function getAuth(context: APIContext | { session?: APIContext['session'] }): Promise<AuthState | null> {
+  const auth = (await context.session?.get('auth')) as AuthState | undefined;
+  return auth ?? null;
+}
+
+/** Returns the signed-in user, or null. Clears stale sessions whose user no longer exists. */
+export async function getCurrentUser(context: APIContext | { session?: APIContext['session'] }) {
+  const auth = await getAuth(context);
+  if (!auth) return null;
+  const user = await findUserById(auth.userId);
+  if (!user) {
+    context.session?.delete('auth');
+    return null;
+  }
+  return { user, auth };
+}
+
+export async function requireUser(context: APIContext) {
+  const current = await getCurrentUser(context);
+  if (!current) throw new HttpError(401, 'not_signed_in', 'Please sign in to continue.');
+  return current;
+}
+
+export function isRecentlyAuthenticated(auth: AuthState) {
+  return Date.now() - auth.authenticatedAt < REAUTH_MAX_AGE_MS;
+}
+
+/** Throws a `reauth_required` error unless the user signed in or reauthenticated recently. */
+export async function requireRecentAuth(context: APIContext) {
+  const current = await requireUser(context);
+  if (!isRecentlyAuthenticated(current.auth)) {
+    throw new HttpError(403, 'reauth_required', 'Please confirm it’s you to continue.');
+  }
+  return current;
+}
+
+export async function startSession(context: APIContext, user: StoredUser, method: AuthState['method']) {
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await context.session!.regenerate();
+  const auth: AuthState = { userId: user.id, username: user.username, method, authenticatedAt: Date.now() };
+  context.session!.set('auth', auth);
+  return auth;
+}
+
+export async function markReauthenticated(context: APIContext, auth: AuthState, method: AuthState['method']) {
+  const updated: AuthState = { ...auth, method, authenticatedAt: Date.now() };
+  context.session!.set('auth', updated);
+  return updated;
+}
+
+export async function endSession(context: APIContext) {
+  context.session!.delete('auth');
+  context.session!.delete('passkeyChallenge');
+  await context.session!.regenerate();
+}
+
+export function authSummary(user: StoredUser, auth: AuthState) {
+  return {
+    username: user.username,
+    hasPassword: user.hasPassword,
+    authenticatedAt: auth.authenticatedAt,
+    reauthExpiresAt: auth.authenticatedAt + REAUTH_MAX_AGE_MS,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Pending WebAuthn challenges (one at a time per session, single use)
+// ---------------------------------------------------------------------------
+
+export function saveChallenge(context: APIContext, pending: Omit<PendingChallenge, 'expiresAt'>) {
+  context.session!.set('passkeyChallenge', { ...pending, expiresAt: Date.now() + CEREMONY_TIMEOUT_MS });
+}
+
+export async function consumeChallenge(context: APIContext, ceremony: PendingChallenge['ceremony']) {
+  const pending = (await context.session!.get('passkeyChallenge')) as PendingChallenge | undefined;
+  context.session!.delete('passkeyChallenge');
+  if (!pending || pending.ceremony !== ceremony || pending.expiresAt < Date.now()) {
+    throw new HttpError(400, 'challenge_expired', 'This passkey request has expired. Please try again.');
+  }
+  return pending;
+}
+
+// ---------------------------------------------------------------------------
+// Serialization
+// ---------------------------------------------------------------------------
+
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  provider: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  deviceType: StoredPasskey['deviceType'];
+  backedUp: boolean;
+  transports: string[];
+}
+
+export function serializePasskey(passkey: StoredPasskey): PasskeySummary {
+  return {
+    id: passkey.id,
+    name: passkey.name,
+    provider: providerName(passkey.aaguid),
+    createdAt: passkey.createdAt,
+    lastUsedAt: passkey.lastUsedAt,
+    deviceType: passkey.deviceType,
+    backedUp: passkey.backedUp,
+    transports: passkey.transports,
+  };
+}
+
+export function validateUsername(value: unknown): string {
+  const username = typeof value === 'string' ? value.trim() : '';
+  if (!username) throw new HttpError(400, 'invalid_username', 'Please enter a username.');
+  if (username.length > 64) throw new HttpError(400, 'invalid_username', 'Usernames must be 64 characters or fewer.');
+  return username;
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..d6d2634
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,153 @@
+/**
+ * Tiny JSON-file backed store for local accounts and their passkeys.
+ *
+ * Usernames and passwords live in the external Times auth service; this store
+ * only keeps what is needed for passkeys (WebAuthn user handles and public keys).
+ * The location can be overridden with the PASSKEY_DATA_FILE environment variable.
+ */
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import type { JsonWebKey } from 'node:crypto';
+import { generateUserHandle, type AuthenticatorTransport } from './webauthn.ts';
+
+export interface StoredUser {
+  /** Random WebAuthn user handle (base64url), also used as the local user ID. */
+  id: string;
+  username: string;
+  /** False for accounts created with a passkey only (no known password). */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface StoredPasskey {
+  id: string;
+  userId: string;
+  name: string;
+  publicKey: JsonWebKey;
+  algorithm: number;
+  counter: number;
+  transports: AuthenticatorTransport[];
+  aaguid: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Database {
+  users: StoredUser[];
+  passkeys: StoredPasskey[];
+}
+
+const DATA_FILE = resolve(process.env.PASSKEY_DATA_FILE ?? '.data/passkeys.json');
+
+let cache: Database | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    const parsed = JSON.parse(await readFile(DATA_FILE, 'utf8'));
+    cache = { users: parsed.users ?? [], passkeys: parsed.passkeys ?? [] };
+  } catch (err) {
+    if ((err as { code?: string }).code !== 'ENOENT') throw err;
+    cache = { users: [], passkeys: [] };
+  }
+  return cache;
+}
+
+async function persist(db: Database) {
+  await mkdir(dirname(DATA_FILE), { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(db, null, 2), 'utf8');
+  await rename(tmp, DATA_FILE);
+}
+
+/** Serializes all access so read-modify-write cycles never interleave. */
+function withDb<T>(fn: (db: Database) => T | Promise<T>, write = false): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    if (write) await persist(db);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+export function findUserById(id: string) {
+  return withDb((db) => db.users.find((u) => u.id === id) ?? null);
+}
+
+export function findUserByUsername(username: string) {
+  return withDb((db) => db.users.find((u) => u.username === username) ?? null);
+}
+
+/** Returns the local record for an externally authenticated user, creating it if needed. */
+export function ensureUser(username: string, hasPassword: boolean) {
+  return withDb((db) => {
+    let user = db.users.find((u) => u.username === username);
+    if (!user) {
+      user = { id: generateUserHandle(), username, hasPassword, createdAt: new Date().toISOString() };
+      db.users.push(user);
+    } else if (hasPassword && !user.hasPassword) {
+      user.hasPassword = true;
+    }
+    return { ...user };
+  }, true);
+}
+
+/** Creates a passkey-only account with a pre-generated user handle; fails if the username is taken. */
+export function createUser(id: string, username: string, hasPassword: boolean) {
+  return withDb((db) => {
+    if (db.users.some((u) => u.username === username || u.id === id)) {
+      throw new Error('User already exists');
+    }
+    const user: StoredUser = { id, username, hasPassword, createdAt: new Date().toISOString() };
+    db.users.push(user);
+    return { ...user };
+  }, true);
+}
+
+export function listPasskeys(userId: string) {
+  return withDb((db) =>
+    db.passkeys
+      .filter((p) => p.userId === userId)
+      .sort((a, b) => a.createdAt.localeCompare(b.createdAt))
+      .map((p) => ({ ...p })),
+  );
+}
+
+export function findPasskey(id: string) {
+  return withDb((db) => {
+    const passkey = db.passkeys.find((p) => p.id === id);
+    return passkey ? { ...passkey } : null;
+  });
+}
+
+export function addPasskey(passkey: StoredPasskey) {
+  return withDb((db) => {
+    if (db.passkeys.some((p) => p.id === passkey.id)) {
+      throw new Error('Passkey already registered');
+    }
+    db.passkeys.push(passkey);
+    return { ...passkey };
+  }, true);
+}
+
+export function updatePasskey(id: string, userId: string, changes: Partial<Pick<StoredPasskey, 'name' | 'counter' | 'backedUp' | 'deviceType' | 'lastUsedAt'>>) {
+  return withDb((db) => {
+    const passkey = db.passkeys.find((p) => p.id === id && p.userId === userId);
+    if (!passkey) return null;
+    Object.assign(passkey, changes);
+    return { ...passkey };
+  }, true);
+}
+
+export function deletePasskey(id: string, userId: string) {
+  return withDb((db) => {
+    const before = db.passkeys.length;
+    db.passkeys = db.passkeys.filter((p) => !(p.id === id && p.userId === userId));
+    return db.passkeys.length !== before;
+  }, true);
+}
diff --git a/src/lib/auth/webauthn.ts b/src/lib/auth/webauthn.ts
new file mode 100644
index 0000000..e5cf5a8
--- /dev/null
+++ b/src/lib/auth/webauthn.ts
@@ -0,0 +1,392 @@
+/**
+ * Server-side WebAuthn (passkey) ceremony helpers built on node:crypto.
+ *
+ * Attestation is requested as "none", so attestation statements are not
+ * verified; the authenticator data, client data and signatures are.
+ */
+import { createHash, createPublicKey, randomBytes, verify as cryptoVerify, type JsonWebKey } from 'node:crypto';
+import { decodeCbor, decodeCborItem, type CborValue } from './cbor.ts';
+
+export const SUPPORTED_ALGORITHMS = [-8, -7, -257] as const; // EdDSA, ES256, RS256
+export const CEREMONY_TIMEOUT_MS = 5 * 60 * 1000;
+
+export type AuthenticatorTransport = 'ble' | 'cable' | 'hybrid' | 'internal' | 'nfc' | 'smart-card' | 'usb';
+
+export interface RegistrationResponseJSON {
+  id: string;
+  rawId: string;
+  type: 'public-key';
+  response: {
+    clientDataJSON: string;
+    attestationObject: string;
+    transports?: string[];
+  };
+  authenticatorAttachment?: string | null;
+  clientExtensionResults?: Record<string, unknown>;
+}
+
+export interface AuthenticationResponseJSON {
+  id: string;
+  rawId: string;
+  type: 'public-key';
+  response: {
+    clientDataJSON: string;
+    authenticatorData: string;
+    signature: string;
+    userHandle?: string | null;
+  };
+  authenticatorAttachment?: string | null;
+  clientExtensionResults?: Record<string, unknown>;
+}
+
+export interface RelyingParty {
+  id: string;
+  name: string;
+  origins: string[];
+}
+
+export class WebAuthnError extends Error {
+  code: string;
+  constructor(code: string, message: string) {
+    super(message);
+    this.code = code;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------
+
+export function toBase64Url(bytes: Uint8Array): string {
+  return Buffer.from(bytes).toString('base64url');
+}
+
+export function fromBase64Url(value: string): Uint8Array {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9_-]*={0,2}$/.test(value)) {
+    throw new WebAuthnError('invalid_encoding', 'Value is not valid base64url');
+  }
+  return new Uint8Array(Buffer.from(value, 'base64url'));
+}
+
+export function generateChallenge(): string {
+  return toBase64Url(randomBytes(32));
+}
+
+export function generateUserHandle(): string {
+  return toBase64Url(randomBytes(32));
+}
+
+function sha256(data: Uint8Array | string): Uint8Array {
+  return new Uint8Array(createHash('sha256').update(data).digest());
+}
+
+function bytesEqual(a: Uint8Array, b: Uint8Array): boolean {
+  return a.length === b.length && Buffer.from(a).equals(Buffer.from(b));
+}
+
+function formatAaguid(bytes: Uint8Array): string {
+  const hex = Buffer.from(bytes).toString('hex');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+// ---------------------------------------------------------------------------
+// Option generation
+// ---------------------------------------------------------------------------
+
+export function buildRegistrationOptions(params: {
+  rp: RelyingParty;
+  challenge: string;
+  user: { id: string; name: string; displayName: string };
+  excludeCredentials: { id: string; transports?: string[] }[];
+}) {
+  return {
+    rp: { id: params.rp.id, name: params.rp.name },
+    user: params.user,
+    challenge: params.challenge,
+    pubKeyCredParams: SUPPORTED_ALGORITHMS.map((alg) => ({ type: 'public-key' as const, alg })),
+    timeout: CEREMONY_TIMEOUT_MS,
+    attestation: 'none' as const,
+    excludeCredentials: params.excludeCredentials.map((c) => ({
+      type: 'public-key' as const,
+      id: c.id,
+      transports: c.transports,
+    })),
+    authenticatorSelection: {
+      residentKey: 'required' as const,
+      requireResidentKey: true,
+      userVerification: 'required' as const,
+    },
+    extensions: { credProps: true },
+  };
+}
+
+export function buildAuthenticationOptions(params: {
+  rp: RelyingParty;
+  challenge: string;
+  allowCredentials: { id: string; transports?: string[] }[];
+}) {
+  return {
+    rpId: params.rp.id,
+    challenge: params.challenge,
+    timeout: CEREMONY_TIMEOUT_MS,
+    userVerification: 'required' as const,
+    allowCredentials: params.allowCredentials.map((c) => ({
+      type: 'public-key' as const,
+      id: c.id,
+      transports: c.transports,
+    })),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Parsing
+// ---------------------------------------------------------------------------
+
+const FLAG_UP = 0x01;
+const FLAG_UV = 0x04;
+const FLAG_BE = 0x08;
+const FLAG_BS = 0x10;
+const FLAG_AT = 0x40;
+
+interface ParsedAuthenticatorData {
+  rpIdHash: Uint8Array;
+  flags: { up: boolean; uv: boolean; be: boolean; bs: boolean; at: boolean };
+  signCount: number;
+  attested?: {
+    aaguid: string;
+    credentialId: Uint8Array;
+    publicKey: Map<CborValue, CborValue>;
+  };
+}
+
+function parseAuthenticatorData(data: Uint8Array): ParsedAuthenticatorData {
+  if (data.length < 37) throw new WebAuthnError('invalid_authenticator_data', 'Authenticator data is too short');
+  const view = new DataView(data.buffer, data.byteOffset, data.byteLength);
+  const flagsByte = data[32];
+  const flags = {
+    up: !!(flagsByte & FLAG_UP),
+    uv: !!(flagsByte & FLAG_UV),
+    be: !!(flagsByte & FLAG_BE),
+    bs: !!(flagsByte & FLAG_BS),
+    at: !!(flagsByte & FLAG_AT),
+  };
+  const result: ParsedAuthenticatorData = {
+    rpIdHash: data.slice(0, 32),
+    flags,
+    signCount: view.getUint32(33),
+  };
+
+  if (flags.at) {
+    let offset = 37;
+    if (data.length < offset + 18) throw new WebAuthnError('invalid_authenticator_data', 'Attested credential data is truncated');
+    const aaguid = formatAaguid(data.slice(offset, offset + 16));
+    offset += 16;
+    const idLength = view.getUint16(offset);
+    offset += 2;
+    if (data.length < offset + idLength) throw new WebAuthnError('invalid_authenticator_data', 'Credential ID is truncated');
+    const credentialId = data.slice(offset, offset + idLength);
+    offset += idLength;
+    const { value } = decodeCborItem(data, offset);
+    if (!(value instanceof Map)) throw new WebAuthnError('invalid_public_key', 'Credential public key is malformed');
+    result.attested = { aaguid, credentialId, publicKey: value };
+  }
+
+  return result;
+}
+
+function parseClientData(encoded: string, expectedType: 'webauthn.create' | 'webauthn.get', expectedChallenge: string, rp: RelyingParty) {
+  let clientData: { type?: string; challenge?: string; origin?: string; crossOrigin?: boolean };
+  const raw = fromBase64Url(encoded);
+  try {
+    clientData = JSON.parse(new TextDecoder().decode(raw));
+  } catch {
+    throw new WebAuthnError('invalid_client_data', 'Client data is not valid JSON');
+  }
+  if (clientData.type !== expectedType) {
+    throw new WebAuthnError('invalid_client_data', `Unexpected ceremony type "${clientData.type}"`);
+  }
+  if (!clientData.challenge || !bytesEqual(fromBase64Url(clientData.challenge), fromBase64Url(expectedChallenge))) {
+    throw new WebAuthnError('challenge_mismatch', 'The challenge does not match. Please try again.');
+  }
+  if (!clientData.origin || !rp.origins.includes(clientData.origin)) {
+    throw new WebAuthnError('origin_mismatch', `Unexpected origin "${clientData.origin}"`);
+  }
+  if (clientData.crossOrigin === true) {
+    throw new WebAuthnError('origin_mismatch', 'Cross-origin ceremonies are not allowed');
+  }
+  return raw;
+}
+
+function coseToJwk(cose: Map<CborValue, CborValue>): { jwk: JsonWebKey; alg: number } {
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  const b64 = (v: CborValue) => {
+    if (!(v instanceof Uint8Array)) throw new WebAuthnError('invalid_public_key', 'Public key parameter is missing');
+    return toBase64Url(v);
+  };
+
+  if (typeof alg !== 'number' || !(SUPPORTED_ALGORITHMS as readonly number[]).includes(alg)) {
+    throw new WebAuthnError('unsupported_algorithm', `Unsupported public key algorithm ${String(alg)}`);
+  }
+
+  if (kty === 2 && alg === -7) {
+    if (cose.get(-1) !== 1) throw new WebAuthnError('invalid_public_key', 'ES256 keys must use P-256');
+    return { alg, jwk: { kty: 'EC', crv: 'P-256', x: b64(cose.get(-2)), y: b64(cose.get(-3)) } };
+  }
+  if (kty === 1 && alg === -8) {
+    if (cose.get(-1) !== 6) throw new WebAuthnError('invalid_public_key', 'EdDSA keys must use Ed25519');
+    return { alg, jwk: { kty: 'OKP', crv: 'Ed25519', x: b64(cose.get(-2)) } };
+  }
+  if (kty === 3 && alg === -257) {
+    return { alg, jwk: { kty: 'RSA', n: b64(cose.get(-1)), e: b64(cose.get(-2)) } };
+  }
+  throw new WebAuthnError('invalid_public_key', 'Public key type does not match its algorithm');
+}
+
+function verifySignature(jwk: JsonWebKey, alg: number, data: Uint8Array, signature: Uint8Array): boolean {
+  try {
+    const key = createPublicKey({ key: jwk, format: 'jwk' });
+    if (alg === -8) return cryptoVerify(null, data, key, signature);
+    if (alg === -7) return cryptoVerify('sha256', data, { key, dsaEncoding: 'der' }, signature);
+    if (alg === -257) return cryptoVerify('sha256', data, key, signature);
+  } catch {
+    return false;
+  }
+  return false;
+}
+
+function checkRpAndFlags(authData: ParsedAuthenticatorData, rp: RelyingParty) {
+  if (!bytesEqual(authData.rpIdHash, sha256(rp.id))) {
+    throw new WebAuthnError('rp_id_mismatch', 'The passkey was created for a different website');
+  }
+  if (!authData.flags.up) {
+    throw new WebAuthnError('user_not_present', 'User presence was not confirmed');
+  }
+  if (!authData.flags.uv) {
+    throw new WebAuthnError('user_not_verified', 'Your device did not verify your identity (PIN, fingerprint or face). Please try again.');
+  }
+  if (!authData.flags.be && authData.flags.bs) {
+    throw new WebAuthnError('invalid_authenticator_data', 'Invalid backup flags');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Verification
+// ---------------------------------------------------------------------------
+
+export interface VerifiedRegistration {
+  credentialId: string;
+  publicKey: JsonWebKey;
+  algorithm: number;
+  counter: number;
+  transports: AuthenticatorTransport[];
+  aaguid: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  authenticatorAttachment: string | null;
+}
+
+const KNOWN_TRANSPORTS: readonly string[] = ['ble', 'cable', 'hybrid', 'internal', 'nfc', 'smart-card', 'usb'];
+
+export function verifyRegistrationResponse(params: {
+  response: RegistrationResponseJSON;
+  expectedChallenge: string;
+  rp: RelyingParty;
+}): VerifiedRegistration {
+  const { response, expectedChallenge, rp } = params;
+  if (!response || response.type !== 'public-key' || !response.response) {
+    throw new WebAuthnError('invalid_response', 'Malformed registration response');
+  }
+
+  parseClientData(response.response.clientDataJSON, 'webauthn.create', expectedChallenge, rp);
+
+  let attestation: CborValue;
+  try {
+    attestation = decodeCbor(fromBase64Url(response.response.attestationObject));
+  } catch {
+    throw new WebAuthnError('invalid_attestation', 'Attestation object is malformed');
+  }
+  if (!(attestation instanceof Map)) throw new WebAuthnError('invalid_attestation', 'Attestation object is malformed');
+  const authDataBytes = attestation.get('authData');
+  if (!(authDataBytes instanceof Uint8Array)) throw new WebAuthnError('invalid_attestation', 'Authenticator data is missing');
+
+  const authData = parseAuthenticatorData(authDataBytes);
+  checkRpAndFlags(authData, rp);
+  if (!authData.attested) {
+    throw new WebAuthnError('invalid_attestation', 'No credential data was returned');
+  }
+
+  const credentialId = toBase64Url(authData.attested.credentialId);
+  if (credentialId !== response.id || toBase64Url(fromBase64Url(response.rawId)) !== credentialId) {
+    throw new WebAuthnError('invalid_response', 'Credential ID mismatch');
+  }
+
+  const { jwk, alg } = coseToJwk(authData.attested.publicKey);
+  // Make sure the key can actually be imported before storing it.
+  try {
+    createPublicKey({ key: jwk, format: 'jwk' });
+  } catch {
+    throw new WebAuthnError('invalid_public_key', 'Credential public key could not be imported');
+  }
+
+  return {
+    credentialId,
+    publicKey: jwk,
+    algorithm: alg,
+    counter: authData.signCount,
+    transports: (response.response.transports ?? []).filter((t): t is AuthenticatorTransport => KNOWN_TRANSPORTS.includes(t)),
+    aaguid: authData.attested.aaguid,
+    deviceType: authData.flags.be ? 'multiDevice' : 'singleDevice',
+    backedUp: authData.flags.bs,
+    authenticatorAttachment: response.authenticatorAttachment ?? null,
+  };
+}
+
+export interface VerifiedAuthentication {
+  newCounter: number;
+  backedUp: boolean;
+  deviceType: 'singleDevice' | 'multiDevice';
+}
+
+export function verifyAuthenticationResponse(params: {
+  response: AuthenticationResponseJSON;
+  expectedChallenge: string;
+  rp: RelyingParty;
+  credential: { id: string; publicKey: JsonWebKey; algorithm: number; counter: number; userHandle: string };
+}): VerifiedAuthentication {
+  const { response, expectedChallenge, rp, credential } = params;
+  if (!response || response.type !== 'public-key' || !response.response) {
+    throw new WebAuthnError('invalid_response', 'Malformed authentication response');
+  }
+  if (response.id !== credential.id) {
+    throw new WebAuthnError('invalid_response', 'Credential ID mismatch');
+  }
+
+  const clientDataBytes = parseClientData(response.response.clientDataJSON, 'webauthn.get', expectedChallenge, rp);
+  const authDataBytes = fromBase64Url(response.response.authenticatorData);
+  const authData = parseAuthenticatorData(authDataBytes);
+  checkRpAndFlags(authData, rp);
+
+  if (response.response.userHandle && response.response.userHandle !== credential.userHandle) {
+    throw new WebAuthnError('user_handle_mismatch', 'This passkey belongs to a different account');
+  }
+
+  const signedData = new Uint8Array(authDataBytes.length + 32);
+  signedData.set(authDataBytes, 0);
+  signedData.set(sha256(clientDataBytes), authDataBytes.length);
+  const signature = fromBase64Url(response.response.signature);
+  if (!verifySignature(credential.publicKey, credential.algorithm, signedData, signature)) {
+    throw new WebAuthnError('invalid_signature', 'Passkey signature could not be verified');
+  }
+
+  // A non-increasing counter (when the authenticator implements one) indicates a cloned authenticator.
+  if ((authData.signCount > 0 || credential.counter > 0) && authData.signCount <= credential.counter) {
+    throw new WebAuthnError('counter_error', 'This passkey may have been cloned. Please contact support.');
+  }
+
+  return {
+    newCounter: authData.signCount,
+    backedUp: authData.flags.bs,
+    deviceType: authData.flags.be ? 'multiDevice' : 'singleDevice',
+  };
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..d827a8c
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,290 @@
+/**
+ * Browser helpers for passkey ceremonies and the auth API.
+ */
+
+const API_BASE = `${import.meta.env.BASE_URL}api/auth`;
+
+export class ApiError extends Error {
+  status: number;
+  code: string;
+  data: Record<string, any>;
+  constructor(status: number, code: string, message: string, data: Record<string, any>) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.data = data;
+  }
+}
+
+/** Thrown when the user dismisses the browser's passkey dialog. Usually shown quietly or not at all. */
+export class PasskeyCancelledError extends Error {}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const method = init.method ?? (init.body === undefined ? 'GET' : 'POST');
+  const response = await fetch(`${API_BASE}${path}`, {
+    method,
+    headers: method === 'GET' ? undefined : { 'Content-Type': 'application/json' },
+    body: method === 'GET' ? undefined : JSON.stringify(init.body ?? {}),
+    credentials: 'same-origin',
+  });
+  let data: Record<string, any> = {};
+  try {
+    data = await response.json();
+  } catch {
+    // Ignore non-JSON bodies.
+  }
+  if (!response.ok) {
+    const code = typeof data.error === 'string' ? data.error : 'unknown_error';
+    throw new ApiError(response.status, code, data.message ?? code, data);
+  }
+  return data as T;
+}
+
+// ---------------------------------------------------------------------------
+// Feature detection
+// ---------------------------------------------------------------------------
+
+type ClientCapabilities = Record<string, boolean>;
+
+export function isWebAuthnSupported() {
+  return typeof window !== 'undefined' && typeof window.PublicKeyCredential === 'function' && !!navigator.credentials;
+}
+
+export async function getClientCapabilities(): Promise<ClientCapabilities> {
+  if (!isWebAuthnSupported()) return {};
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.getClientCapabilities === 'function') {
+    try {
+      return await PKC.getClientCapabilities();
+    } catch {
+      // Fall through to individual checks.
+    }
+  }
+  const caps: ClientCapabilities = {};
+  try {
+    caps.conditionalGet = (await PKC.isConditionalMediationAvailable?.()) ?? false;
+    caps.passkeyPlatformAuthenticator = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch {
+    // Leave capabilities unset.
+  }
+  return caps;
+}
+
+// ---------------------------------------------------------------------------
+// JSON <-> WebAuthn conversions (native where available)
+// ---------------------------------------------------------------------------
+
+function b64urlToBuffer(value: string): ArrayBuffer {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+}
+
+function bufferToB64url(buffer: ArrayBuffer | ArrayBufferView): string {
+  const bytes = buffer instanceof ArrayBuffer ? new Uint8Array(buffer) : new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function parseCreationOptions(json: any): PublicKeyCredentialCreationOptions {
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.parseCreationOptionsFromJSON === 'function') return PKC.parseCreationOptionsFromJSON(json);
+  return {
+    ...json,
+    challenge: b64urlToBuffer(json.challenge),
+    user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+    excludeCredentials: (json.excludeCredentials ?? []).map((c: any) => ({ ...c, id: b64urlToBuffer(c.id) })),
+  };
+}
+
+function parseRequestOptions(json: any): PublicKeyCredentialRequestOptions {
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.parseRequestOptionsFromJSON === 'function') return PKC.parseRequestOptionsFromJSON(json);
+  return {
+    ...json,
+    challenge: b64urlToBuffer(json.challenge),
+    allowCredentials: (json.allowCredentials ?? []).map((c: any) => ({ ...c, id: b64urlToBuffer(c.id) })),
+  };
+}
+
+function credentialToJSON(credential: PublicKeyCredential): any {
+  const anyCred = credential as any;
+  if (typeof anyCred.toJSON === 'function') {
+    try {
+      return anyCred.toJSON();
+    } catch {
+      // Some password-manager extensions return objects whose toJSON throws; fall back below.
+    }
+  }
+  const response = credential.response as any;
+  const base = {
+    id: credential.id,
+    rawId: bufferToB64url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment ?? null,
+    clientExtensionResults: credential.getClientExtensionResults(),
+  };
+  if ('attestationObject' in response) {
+    return {
+      ...base,
+      response: {
+        clientDataJSON: bufferToB64url(response.clientDataJSON),
+        attestationObject: bufferToB64url(response.attestationObject),
+        transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+      },
+    };
+  }
+  return {
+    ...base,
+    response: {
+      clientDataJSON: bufferToB64url(response.clientDataJSON),
+      authenticatorData: bufferToB64url(response.authenticatorData),
+      signature: bufferToB64url(response.signature),
+      userHandle: response.userHandle ? bufferToB64url(response.userHandle) : null,
+    },
+  };
+}
+
+function translateDomError(err: unknown): never {
+  if (err instanceof DOMException) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+      throw new PasskeyCancelledError('The passkey request was cancelled or timed out.');
+    }
+    if (err.name === 'InvalidStateError') {
+      throw new Error('You already have a passkey for this account in this password manager or device.');
+    }
+    if (err.name === 'SecurityError') {
+      throw new Error('Passkeys aren’t available on this domain.');
+    }
+    if (err.name === 'NotSupportedError') {
+      throw new Error('This browser or device doesn’t support the required passkey features.');
+    }
+  }
+  throw err instanceof Error ? err : new Error('Something went wrong with the passkey request.');
+}
+
+// ---------------------------------------------------------------------------
+// Signal API (keeps passkey providers in sync with the server)
+// ---------------------------------------------------------------------------
+
+export async function signalUnknownCredential(rpId: string, credentialId: string) {
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.signalUnknownCredential !== 'function') return;
+  try {
+    await PKC.signalUnknownCredential({ rpId, credentialId });
+  } catch {
+    // Best effort only.
+  }
+}
+
+export async function signalAcceptedCredentials(signals: { rpId: string; userId: string; credentialIds: string[] }) {
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.signalAllAcceptedCredentials !== 'function') return;
+  try {
+    await PKC.signalAllAcceptedCredentials({ rpId: signals.rpId, userId: signals.userId, allAcceptedCredentialIds: signals.credentialIds });
+  } catch {
+    // Best effort only.
+  }
+}
+
+export async function signalUserDetails(params: { rpId: string; userId: string; name: string; displayName: string }) {
+  const PKC = PublicKeyCredential as any;
+  if (typeof PKC.signalCurrentUserDetails !== 'function') return;
+  try {
+    await PKC.signalCurrentUserDetails(params);
+  } catch {
+    // Best effort only.
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Ceremonies
+// ---------------------------------------------------------------------------
+
+export type RegistrationPurpose = { purpose: 'signup'; username: string } | { purpose: 'add' };
+
+/**
+ * Creates a passkey. With `conditional: true` the browser may silently create
+ * one for the password the user just used (no modal UI) — it rejects if not.
+ */
+export async function registerPasskey(params: RegistrationPurpose & { name?: string; conditional?: boolean; signal?: AbortSignal }) {
+  const { name, conditional, signal, ...purpose } = params;
+  const optionsJSON = await api('/passkeys/registration-options', { body: purpose });
+  const publicKey = parseCreationOptions(optionsJSON);
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      signal,
+      ...(conditional ? { mediation: 'conditional' as CredentialMediationRequirement } : {}),
+    })) as PublicKeyCredential;
+  } catch (err) {
+    translateDomError(err);
+  }
+  if (!credential) throw new PasskeyCancelledError('No passkey was created.');
+
+  try {
+    return await api('/passkeys/registration-verify', { body: { credential: credentialToJSON(credential), name } });
+  } catch (err) {
+    // The passkey exists in the provider but not on the server; ask the provider to remove it.
+    await signalUnknownCredential(optionsJSON.rp.id, credential.id);
+    throw err;
+  }
+}
+
+/**
+ * Signs in (or reauthenticates) with a passkey. With `conditional: true` the
+ * request waits for the user to pick a passkey from the username field's autofill.
+ */
+export async function authenticateWithPasskey(params: { purpose: 'signin' | 'reauth'; conditional?: boolean; signal?: AbortSignal }) {
+  const optionsJSON = await api('/passkeys/authentication-options', { body: { purpose: params.purpose } });
+  const publicKey = parseRequestOptions(optionsJSON);
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.get({
+      publicKey,
+      signal: params.signal,
+      ...(params.conditional ? { mediation: 'conditional' as CredentialMediationRequirement } : {}),
+    })) as PublicKeyCredential;
+  } catch (err) {
+    translateDomError(err);
+  }
+  if (!credential) throw new PasskeyCancelledError('No passkey was selected.');
+
+  try {
+    const result = await api('/passkeys/authentication-verify', { body: { credential: credentialToJSON(credential) } });
+    if (result.signals) await signalAcceptedCredentials(result.signals);
+    return result;
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'unknown_credential') {
+      await signalUnknownCredential(optionsJSON.rpId, credential.id);
+    }
+    throw err;
+  }
+}
+
+export function errorMessage(err: unknown, fallback = 'An unexpected error occurred. Please try again later.') {
+  if (err instanceof ApiError || err instanceof Error) return err.message || fallback;
+  return fallback;
+}
+
+// ---------------------------------------------------------------------------
+// Formatting
+// ---------------------------------------------------------------------------
+
+export function formatDate(iso: string | null) {
+  if (!iso) return 'Never';
+  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+export function safeNextPath(next: string | null) {
+  const base = import.meta.env.BASE_URL;
+  // Only allow same-site relative paths under the app's base to avoid open redirects.
+  if (next && next.startsWith(base) && !next.startsWith('//') && !next.includes('\\')) return next;
+  return `${base}account`;
+}
diff --git a/src/pages/account.astro b/src/pages/account.astro
new file mode 100644
index 0000000..76aa6b8
--- /dev/null
+++ b/src/pages/account.astro
@@ -0,0 +1,29 @@
+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { getCurrentUser, getRelyingParty, serializePasskey } from '../lib/auth/server.ts';
+import { listPasskeys } from '../lib/auth/store.ts';
+
+const baseUrl = import.meta.env.BASE_URL;
+const current = await getCurrentUser(Astro);
+if (!current) {
+  return Astro.redirect(`${baseUrl}signin?next=${encodeURIComponent(`${baseUrl}account`)}`);
+}
+
+const passkeys = (await listPasskeys(current.user.id)).map(serializePasskey);
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+
+<Layout title="Account | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings
+      client:load
+      username={current.user.username}
+      hasPassword={current.user.hasPassword}
+      signInMethod={current.auth.method}
+      rpId={getRelyingParty(Astro).id}
+      userId={current.user.id}
+      initialPasskeys={passkeys}
+    />
+  </div>
+</Layout>
diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..8e9eb53
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,23 @@
+import { externalLogin } from '../../../lib/auth/external.ts';
+import { authSummary, handler, HttpError, json, readJson, startSession, validateUsername } from '../../../lib/auth/server.ts';
+import { ensureUser, listPasskeys } from '../../../lib/auth/store.ts';
+
+/** Password sign-in, verified against the external account service. */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ username?: unknown; password?: unknown }>(context);
+  const username = validateUsername(body.username);
+  if (typeof body.password !== 'string' || !body.password) {
+    throw new HttpError(400, 'invalid_password', 'Please enter your password.');
+  }
+
+  const result = await externalLogin(username, body.password);
+  if (!result.ok) {
+    // Pass the service's error code (e.g. APP_ERR_2001) through unchanged.
+    return json({ error: result.data.error ?? 'Unknown error' }, result.status);
+  }
+
+  const user = await ensureUser(username, true);
+  const auth = await startSession(context, user, 'password');
+  const passkeys = await listPasskeys(user.id);
+  return json({ user: authSummary(user, auth), passkeyCount: passkeys.length });
+});
