diff --git a/src/pages/api/auth/passkeys/registration-options.ts b/src/pages/api/auth/passkeys/registration-options.ts
new file mode 100644
index 0000000..74c565b
--- /dev/null
+++ b/src/pages/api/auth/passkeys/registration-options.ts
@@ -0,0 +1,60 @@
+import {
+  getCurrentUser,
+  getRelyingParty,
+  handler,
+  HttpError,
+  json,
+  readJson,
+  requireRecentAuth,
+  saveChallenge,
+  validateUsername,
+} from '../../../../lib/auth/server.ts';
+import { findUserByUsername, listPasskeys } from '../../../../lib/auth/store.ts';
+import { buildRegistrationOptions, generateChallenge, generateUserHandle } from '../../../../lib/auth/webauthn.ts';
+
+/**
+ * Starts passkey registration.
+ * - purpose "signup": creates a new passkey-only account for `username`.
+ * - purpose "add": adds a passkey to the signed-in account (requires recent authentication).
+ */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ purpose?: unknown; username?: unknown }>(context);
+  const rp = getRelyingParty(context);
+  const challenge = generateChallenge();
+
+  if (body.purpose === 'add') {
+    const { user } = await requireRecentAuth(context);
+    const passkeys = await listPasskeys(user.id);
+    saveChallenge(context, { challenge, ceremony: 'registration', purpose: 'add', userId: user.id, username: user.username });
+    return json(
+      buildRegistrationOptions({
+        rp,
+        challenge,
+        user: { id: user.id, name: user.username, displayName: user.username },
+        excludeCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+      }),
+    );
+  }
+
+  if (body.purpose === 'signup') {
+    if (await getCurrentUser(context)) {
+      throw new HttpError(400, 'already_signed_in', 'You are already signed in. Sign out to create a new account.');
+    }
+    const username = validateUsername(body.username);
+    if (await findUserByUsername(username)) {
+      throw new HttpError(409, 'username_taken', 'That username is already taken. Sign in instead, or pick another username.');
+    }
+    const userId = generateUserHandle();
+    saveChallenge(context, { challenge, ceremony: 'registration', purpose: 'signup', userId, username });
+    return json(
+      buildRegistrationOptions({
+        rp,
+        challenge,
+        user: { id: userId, name: username, displayName: username },
+        excludeCredentials: [],
+      }),
+    );
+  }
+
+  throw new HttpError(400, 'invalid_purpose', 'Unknown registration purpose.');
+});
diff --git a/src/pages/api/auth/passkeys/registration-verify.ts b/src/pages/api/auth/passkeys/registration-verify.ts
new file mode 100644
index 0000000..872d883
--- /dev/null
+++ b/src/pages/api/auth/passkeys/registration-verify.ts
@@ -0,0 +1,84 @@
+import { providerName } from '../../../../lib/auth/aaguid.ts';
+import { externalRegister, generateUnusablePassword } from '../../../../lib/auth/external.ts';
+import {
+  authSummary,
+  consumeChallenge,
+  getRelyingParty,
+  handler,
+  HttpError,
+  json,
+  readJson,
+  requireUser,
+  serializePasskey,
+  startSession,
+} from '../../../../lib/auth/server.ts';
+import { addPasskey, createUser, findPasskey, listPasskeys, type StoredUser } from '../../../../lib/auth/store.ts';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '../../../../lib/auth/webauthn.ts';
+
+function passkeyName(requested: unknown, aaguid: string) {
+  const name = typeof requested === 'string' ? requested.trim().slice(0, 64) : '';
+  return name || providerName(aaguid) || 'Passkey';
+}
+
+/** Completes passkey registration started by registration-options. */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ credential?: RegistrationResponseJSON; name?: unknown }>(context);
+  const pending = await consumeChallenge(context, 'registration');
+  if (!pending.userId || !pending.username) throw new HttpError(400, 'challenge_expired', 'Please try again.');
+
+  const verified = verifyRegistrationResponse({
+    response: body.credential as RegistrationResponseJSON,
+    expectedChallenge: pending.challenge,
+    rp: getRelyingParty(context),
+  });
+
+  if (await findPasskey(verified.credentialId)) {
+    throw new HttpError(409, 'passkey_exists', 'This passkey is already registered.');
+  }
+
+  let user: StoredUser;
+  if (pending.purpose === 'add') {
+    const current = await requireUser(context);
+    if (current.user.id !== pending.userId) {
+      throw new HttpError(403, 'user_mismatch', 'You were signed out while creating the passkey. Please try again.');
+    }
+    user = current.user;
+  } else {
+    // Reserve the username in the external account service. The password is
+    // random and discarded: this account signs in with passkeys only.
+    const result = await externalRegister(pending.username, generateUnusablePassword());
+    if (!result.ok) {
+      throw new HttpError(result.status >= 500 ? 502 : 409, 'registration_failed', `Registration failed: ${result.data.error ?? 'Unknown error'}`);
+    }
+    try {
+      user = await createUser(pending.userId, pending.username, false);
+    } catch {
+      throw new HttpError(409, 'username_taken', 'That username is already taken.');
+    }
+  }
+
+  const now = new Date().toISOString();
+  const passkey = await addPasskey({
+    id: verified.credentialId,
+    userId: user.id,
+    name: passkeyName(body.name, verified.aaguid),
+    publicKey: verified.publicKey,
+    algorithm: verified.algorithm,
+    counter: verified.counter,
+    transports: verified.transports,
+    aaguid: verified.aaguid,
+    deviceType: verified.deviceType,
+    backedUp: verified.backedUp,
+    createdAt: now,
+    lastUsedAt: pending.purpose === 'signup' ? now : null,
+  });
+
+  const auth = pending.purpose === 'signup' ? await startSession(context, user, 'passkey') : (await requireUser(context)).auth;
+  const passkeys = await listPasskeys(user.id);
+
+  return json({
+    user: authSummary(user, auth),
+    passkey: serializePasskey(passkey),
+    passkeys: passkeys.map(serializePasskey),
+  });
+});
diff --git a/src/pages/api/auth/reauth/password.ts b/src/pages/api/auth/reauth/password.ts
new file mode 100644
index 0000000..1d78dfe
--- /dev/null
+++ b/src/pages/api/auth/reauth/password.ts
@@ -0,0 +1,22 @@
+import { externalLogin } from '../../../../lib/auth/external.ts';
+import { authSummary, handler, HttpError, json, markReauthenticated, readJson, requireUser } from '../../../../lib/auth/server.ts';
+
+/** Confirms the signed-in user's identity with their password before a sensitive action. */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ password?: unknown }>(context);
+  const { user, auth } = await requireUser(context);
+  if (!user.hasPassword) {
+    throw new HttpError(400, 'no_password', 'This account doesn’t have a password. Use a passkey instead.');
+  }
+  if (typeof body.password !== 'string' || !body.password) {
+    throw new HttpError(400, 'invalid_password', 'Please enter your password.');
+  }
+
+  const result = await externalLogin(user.username, body.password);
+  if (!result.ok) {
+    return json({ error: result.data.error ?? 'Unknown error', message: 'That password is incorrect.' }, result.status);
+  }
+
+  const updated = await markReauthenticated(context, auth, 'password');
+  return json({ user: authSummary(user, updated) });
+});
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
new file mode 100644
index 0000000..aac96ef
--- /dev/null
+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,22 @@
+import { externalRegister } from '../../../lib/auth/external.ts';
+import { authSummary, handler, HttpError, json, readJson, startSession, validateUsername } from '../../../lib/auth/server.ts';
+import { ensureUser } from '../../../lib/auth/store.ts';
+
+/** Password sign-up via the external account service; signs the new user in. */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ username?: unknown; password?: unknown }>(context);
+  const username = validateUsername(body.username);
+  if (typeof body.password !== 'string' || !body.password) {
+    throw new HttpError(400, 'invalid_password', 'Please choose a password.');
+  }
+
+  const result = await externalRegister(username, body.password);
+  if (!result.ok) {
+    // Pass the service's error code (e.g. APP_ERR_1001) through unchanged.
+    return json({ error: result.data.error ?? 'Unknown error' }, result.status);
+  }
+
+  const user = await ensureUser(username, true);
+  const auth = await startSession(context, user, 'password');
+  return json({ user: authSummary(user, auth) });
+});
