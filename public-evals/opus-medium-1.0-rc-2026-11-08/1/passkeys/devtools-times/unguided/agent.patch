diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
new file mode 100644
index 0000000..caea63d
--- /dev/null
+++ b/src/components/ReauthDialog.tsx
@@ -0,0 +1,136 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { FingerPrintIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { PasskeyCancelledError, api, authenticateWithPasskey, errorMessage } from '../lib/passkeys-client';
+
+interface ReauthDialogProps {
+  username: string;
+  hasPassword: boolean;
+  hasPasskeys: boolean;
+  onSuccess: () => void;
+  onCancel: () => void;
+}
+
+/** Asks the signed-in user to confirm their identity before a sensitive change. */
+export default function ReauthDialog({ username, hasPassword, hasPasskeys, onSuccess, onCancel }: ReauthDialogProps) {
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState<'passkey' | 'password' | null>(null);
+  const dialogRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    dialogRef.current?.querySelector<HTMLElement>('button, input')?.focus();
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') onCancel();
+    };
+    document.addEventListener('keydown', onKeyDown);
+    return () => document.removeEventListener('keydown', onKeyDown);
+  }, []);
+
+  const handlePasskey = async () => {
+    setError(null);
+    setLoading('passkey');
+    try {
+      await authenticateWithPasskey({ purpose: 'reauth' });
+      onSuccess();
+    } catch (err) {
+      if (!(err instanceof PasskeyCancelledError)) setError(errorMessage(err));
+    } finally {
+      setLoading(null);
+    }
+  };
+
+  const handlePassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading('password');
+    try {
+      await api('/reauth/password', { body: { password } });
+      onSuccess();
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setLoading(null);
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/50 p-4" onClick={onCancel}>
+      <div
+        ref={dialogRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="reauth-title"
+        className="w-full max-w-sm rounded-lg bg-white p-6 shadow-xl"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-center gap-2 mb-2">
+          <ShieldCheckIcon className="w-6 h-6 text-gray-800" aria-hidden="true" />
+          <h3 id="reauth-title" className="text-lg font-bold text-gray-800">
+            Confirm it’s you
+          </h3>
+        </div>
+        <p className="text-sm text-gray-600 mb-4">
+          To protect your account, please verify your identity before making this change.
+        </p>
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {hasPasskeys && (
+          <button
+            type="button"
+            onClick={handlePasskey}
+            disabled={loading !== null}
+            className="w-full flex items-center justify-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+          >
+            <FingerPrintIcon className="w-5 h-5" aria-hidden="true" />
+            {loading === 'passkey' ? 'Waiting for passkey...' : 'Use your passkey'}
+          </button>
+        )}
+
+        {hasPasskeys && hasPassword && (
+          <div className="flex items-center my-4" aria-hidden="true">
+            <div className="flex-grow border-t border-gray-200" />
+            <span className="mx-3 text-xs uppercase tracking-wider text-gray-500">or</span>
+            <div className="flex-grow border-t border-gray-200" />
+          </div>
+        )}
+
+        {hasPassword && (
+          <form onSubmit={handlePassword} className="space-y-3">
+            {/* Hidden username helps password managers fill the right credential. */}
+            <input type="text" name="username" autoComplete="username" value={username} readOnly hidden />
+            <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">
+              Password
+            </label>
+            <input
+              type="password"
+              id="reauth-password"
+              autoComplete="current-password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button
+              type="submit"
+              disabled={loading !== null}
+              className={`w-full py-2 px-4 rounded-md text-sm font-medium disabled:opacity-75 ${
+                hasPasskeys ? 'border border-gray-900 text-gray-900 bg-white hover:bg-gray-50' : 'text-white bg-gray-900 hover:bg-gray-800'
+              }`}
+            >
+              {loading === 'password' ? 'Verifying...' : 'Continue with password'}
+            </button>
+          </form>
+        )}
+
+        <button type="button" onClick={onCancel} className="mt-4 w-full text-sm text-gray-600 hover:text-gray-900 underline">
+          Cancel
+        </button>
+      </div>
+    </div>
+  );
+}
