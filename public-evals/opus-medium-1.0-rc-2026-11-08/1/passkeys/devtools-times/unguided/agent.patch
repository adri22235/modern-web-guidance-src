--- /dev/null
+++ b/src/pages/api/auth/passkeys/authentication-verify.ts
@@ -0,0 +1,70 @@
+import {
+  authSummary,
+  consumeChallenge,
+  getRelyingParty,
+  handler,
+  HttpError,
+  json,
+  markReauthenticated,
+  readJson,
+  requireUser,
+  serializePasskey,
+  startSession,
+} from '../../../../lib/auth/server.ts';
+import { findPasskey, findUserById, listPasskeys, updatePasskey } from '../../../../lib/auth/store.ts';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '../../../../lib/auth/webauthn.ts';
+
+/** Completes a passkey sign-in or reauthentication. */
+export const POST = handler(async (context) => {
+  const body = await readJson<{ credential?: AuthenticationResponseJSON }>(context);
+  const pending = await consumeChallenge(context, 'authentication');
+  const credential = body.credential;
+  if (!credential || typeof credential.id !== 'string') {
+    throw new HttpError(400, 'invalid_response', 'Malformed passkey response.');
+  }
+
+  const passkey = await findPasskey(credential.id);
+  const owner = passkey ? await findUserById(passkey.userId) : null;
+  if (!passkey || !owner) {
+    // The client uses this to tell the passkey provider to hide the stale passkey.
+    throw new HttpError(404, 'unknown_credential', 'This passkey isn’t registered with The DevTools Times. It may have been deleted.', {
+      credentialId: credential.id,
+    });
+  }
+
+  let reauthOf: Awaited<ReturnType<typeof requireUser>> | null = null;
+  if (pending.purpose === 'reauth') {
+    reauthOf = await requireUser(context);
+    if (reauthOf.user.id !== owner.id || pending.userId !== owner.id) {
+      throw new HttpError(403, 'wrong_account', 'That passkey belongs to a different account.');
+    }
+  }
+
+  const rp = getRelyingParty(context);
+  const verified = verifyAuthenticationResponse({
+    response: credential,
+    expectedChallenge: pending.challenge,
+    rp,
+    credential: { ...passkey, userHandle: owner.id },
+  });
+
+  const updated = await updatePasskey(passkey.id, owner.id, {
+    counter: verified.newCounter,
+    backedUp: verified.backedUp,
+    deviceType: verified.deviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  const auth = reauthOf
+    ? await markReauthenticated(context, reauthOf.auth, 'passkey')
+    : await startSession(context, owner, 'passkey');
+  const passkeys = await listPasskeys(owner.id);
+
+  return json({
+    user: authSummary(owner, auth),
+    passkey: updated ? serializePasskey(updated) : null,
+    passkeys: passkeys.map(serializePasskey),
+    // Lets the client sync the passkey provider's view of this account.
+    signals: { rpId: rp.id, userId: owner.id, credentialIds: passkeys.map((p) => p.id) },
+  });
+});
