@@ -0,0 +1,34 @@
+import { getRelyingParty, handler, HttpError, json, readJson, requireRecentAuth, requireUser, serializePasskey } from '../../../../lib/auth/server.ts';
+import { deletePasskey, listPasskeys, updatePasskey } from '../../../../lib/auth/store.ts';
+
+/** Renames a passkey. */
+export const PATCH = handler(async (context) => {
+  const body = await readJson<{ name?: unknown }>(context);
+  const { user } = await requireUser(context);
+  const name = typeof body.name === 'string' ? body.name.trim() : '';
+  if (!name) throw new HttpError(400, 'invalid_name', 'Please enter a name for this passkey.');
+  if (name.length > 64) throw new HttpError(400, 'invalid_name', 'Passkey names must be 64 characters or fewer.');
+
+  const updated = await updatePasskey(context.params.id ?? '', user.id, { name });
+  if (!updated) throw new HttpError(404, 'not_found', 'Passkey not found.');
+  return json({ passkey: serializePasskey(updated) });
+});
+
+/** Deletes a passkey. Requires recent authentication. */
+export const DELETE = handler(async (context) => {
+  await readJson(context);
+  const { user } = await requireRecentAuth(context);
+  const id = context.params.id ?? '';
+  const passkeys = await listPasskeys(user.id);
+  if (!passkeys.some((p) => p.id === id)) throw new HttpError(404, 'not_found', 'Passkey not found.');
+  if (!user.hasPassword && passkeys.length === 1) {
+    throw new HttpError(400, 'last_passkey', 'This is the only way to sign in to your account. Add another passkey before deleting this one.');
+  }
+
+  await deletePasskey(id, user.id);
+  const remaining = await listPasskeys(user.id);
+  return json({
+    passkeys: remaining.map(serializePasskey),
+    signals: { rpId: getRelyingParty(context).id, userId: user.id, credentialIds: remaining.map((p) => p.id) },
+  });
+});
