diff --git a/components/drink-card.js b/components/drink-card.js
new file mode 100644
index 0000000..fb4a39c
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,160 @@
+// <drink-card> — reusable menu card with encapsulated layout and styles.
+//
+// Usage:
+//   <drink-card href="/menu/cold-brew" limited>
+//     <span slot="title">Cold Brew</span>
+//     Steeped for 18 hours for maximum smoothness.
+//   </drink-card>
+//
+// Attributes (reflected as properties):
+//   href          Destination of the action link. The link is hidden when absent.
+//   action-label  Text of the action link (default "View Details").
+//   limited       Boolean. Shows the "Limited" badge when present.
+//   badge-label   Text of the badge (default "Limited").
+//
+// Theming hooks (inherited custom properties): --card-bg, --card-fg,
+// --card-accent, --card-badge-bg, --card-badge-fg, --card-radius.
+// Parts: card, badge, title, description, action.
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: block;
+    --_bg: var(--card-bg, white);
+    --_fg: var(--card-fg, var(--text, #3e2723));
+    --_accent: var(--card-accent, var(--primary, #4e342e));
+    --_badge-bg: var(--card-badge-bg, var(--accent, #ffab40));
+    --_badge-fg: var(--card-badge-fg, #3e2723);
+    --_radius: var(--card-radius, 8px);
+  }
+
+  :host([hidden]) { display: none; }
+
+  *, *::before, *::after { box-sizing: border-box; }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    height: 100%;
+    margin: 0;
+    padding: 20px;
+    background: var(--_bg);
+    color: var(--_fg);
+    border-radius: var(--_radius);
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+    text-align: center;
+    font: inherit;
+    line-height: 1.6;
+  }
+
+  .badge {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: var(--_badge-bg);
+    color: var(--_badge-fg);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+
+  .badge[hidden] { display: none; }
+
+  h3 {
+    margin: 0 0 10px;
+    color: var(--_accent);
+    font-size: 1.17em;
+    line-height: 1.3;
+  }
+
+  p { margin: 0; }
+
+  .action {
+    display: inline-block;
+    padding: 10px 20px;
+    background: var(--_accent);
+    color: white;
+    border-radius: 5px;
+    text-decoration: none;
+    transition: background 0.3s;
+  }
+
+  /* Keeps at least 15px above the link and pins it to the bottom of equal-height cards. */
+  .spacer { flex: 1 0 15px; }
+
+  .action:hover { background: #3e2723; }
+
+  .action:focus-visible {
+    outline: 2px solid var(--_badge-bg);
+    outline-offset: 2px;
+  }
+
+  .action[hidden] { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden></span>
+    <h3 part="title"><slot name="title"></slot></h3>
+    <p part="description"><slot></slot></p>
+    <span class="spacer"></span>
+    <a class="action" part="action" hidden></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href', 'action-label', 'limited', 'badge-label'];
+
+  #badge;
+  #action;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+    this.#badge = this.shadowRoot.querySelector('.badge');
+    this.#action = this.shadowRoot.querySelector('.action');
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#render();
+  }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { v ? this.setAttribute('href', v) : this.removeAttribute('href'); }
+
+  get actionLabel() { return this.getAttribute('action-label') || 'View Details'; }
+  set actionLabel(v) { v ? this.setAttribute('action-label', v) : this.removeAttribute('action-label'); }
+
+  get limited() { return this.hasAttribute('limited'); }
+  set limited(on) { this.toggleAttribute('limited', !!on); }
+
+  get badgeLabel() { return this.getAttribute('badge-label') || 'Limited'; }
+  set badgeLabel(v) { v ? this.setAttribute('badge-label', v) : this.removeAttribute('badge-label'); }
+
+  #render() {
+    this.#badge.textContent = this.badgeLabel;
+    this.#badge.hidden = !this.limited;
+
+    const href = this.href;
+    this.#action.textContent = this.actionLabel;
+    this.#action.hidden = !href;
+    if (href) this.#action.setAttribute('href', href);
+    else this.#action.removeAttribute('href');
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
