@@ -0,0 +1,140 @@
+/**
+ * <drink-card> — reusable menu card with Shadow DOM-isolated layout and styles.
+ *
+ * Attributes:
+ *   heading       Drink name (required)
+ *   description   Short blurb
+ *   href          Action link URL
+ *   action-label  Action link text (default: "View Details")
+ *   limited       Boolean; when present, shows a "Limited" badge.
+ *                 Can be toggled at runtime (el.limited = true / removeAttribute('limited')).
+ *
+ * Theme tokens (--primary, --text, --accent) are inherited from the page if
+ * defined, with built-in fallbacks; no other global CSS reaches inside.
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    .card {
+      position: relative;
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text, #3e2723);
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      font-size: 1.17em;
+      color: var(--primary, #4e342e);
+    }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      right: 12px;
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .badge[hidden],
+    .btn[hidden] {
+      display: none;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+  </style>
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden>Limited</span>
+    <h3 part="heading"></h3>
+    <p part="description"></p>
+    <a class="btn" part="action"></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'description', 'href', 'action-label', 'limited'];
+  }
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this._badge = root.querySelector('.badge');
+    this._heading = root.querySelector('h3');
+    this._description = root.querySelector('p');
+    this._action = root.querySelector('.btn');
+  }
+
+  connectedCallback() {
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  get limited() {
+    return this.hasAttribute('limited');
+  }
+
+  set limited(value) {
+    this.toggleAttribute('limited', Boolean(value));
+  }
+
+  _render() {
+    this._heading.textContent = this.getAttribute('heading') ?? '';
+    this._description.textContent = this.getAttribute('description') ?? '';
+
+    const href = this.getAttribute('href');
+    this._action.hidden = !href;
+    if (href) this._action.setAttribute('href', href);
+    else this._action.removeAttribute('href');
+    this._action.textContent = this.getAttribute('action-label') || 'View Details';
+
+    this._badge.hidden = !this.limited;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
