+  <script>
+    (() => {
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const navLinks = document.querySelectorAll('nav a[href^="#"], nav [data-scroll-target]');
+      let currentScrollId = 0;
+
+      function getTargetId(trigger) {
+        if (trigger.dataset.scrollTarget) return trigger.dataset.scrollTarget;
+        const href = trigger.getAttribute('href');
+        return href && href.startsWith('#') ? decodeURIComponent(href.slice(1)) : null;
+      }
+
+      // Resolves once the scroll has settled. Uses the Promise returned by
+      // scrollIntoView() where supported, otherwise waits for scrollend with an
+      // idle timeout (scrollend never fires if the target is already in view).
+      function scrollIntoViewAsync(element, options, scroller = window) {
+        const result = element.scrollIntoView(options);
+        if (result instanceof Promise) return result;
+
+        return new Promise((resolve) => {
+          let timeoutId;
+
+          const finish = () => {
+            clearTimeout(timeoutId);
+            scroller.removeEventListener('scrollend', finish);
+            scroller.removeEventListener('scroll', onScroll);
+            resolve();
+          };
+
+          const onScroll = () => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(finish, 100);
+          };
+
+          scroller.addEventListener('scrollend', finish, { once: true });
+          scroller.addEventListener('scroll', onScroll, { passive: true });
+          timeoutId = setTimeout(finish, 100);
+        });
+      }
+
+      function setCurrentLink(id) {
+        navLinks.forEach((link) => {
+          if (getTargetId(link) === id) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      async function scrollToSection(target) {
+        const scrollId = ++currentScrollId;
+        document.querySelectorAll('.page-section.is-arrived')
+          .forEach((section) => section.classList.remove('is-arrived'));
+
+        await scrollIntoViewAsync(target, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        // A newer navigation superseded this one; skip its effects
+        if (scrollId !== currentScrollId) return;
+
+        const focusTarget = target.querySelector('h2[tabindex="-1"]') || target;
+        if (focusTarget === target && !target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+        focusTarget.focus({ preventScroll: true });
+
+        // Force a reflow so the animation restarts on repeat visits
+        void target.offsetWidth;
+        target.classList.add('is-arrived');
+      }
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('a[href^="#"], [data-scroll-target]');
+        if (!trigger || event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        const id = getTargetId(trigger);
+        const target = id && document.getElementById(id);
+        if (!target) return;
+
+        event.preventDefault();
+        if (location.hash !== `#${id}`) history.pushState(null, '', `#${id}`);
+        setCurrentLink(id);
+        scrollToSection(target);
+      });
+
+      document.addEventListener('animationend', (event) => {
+        if (event.animationName === 'section-arrive') {
+          event.target.classList.remove('is-arrived');
+        }
+      });
+
+      // Back/forward between hashes
+      window.addEventListener('popstate', () => {
+        const id = decodeURIComponent(location.hash.slice(1));
+        const target = id && document.getElementById(id);
+        setCurrentLink(id);
+        if (target) scrollToSection(target);
+      });
+    })();
+  </script>
+
