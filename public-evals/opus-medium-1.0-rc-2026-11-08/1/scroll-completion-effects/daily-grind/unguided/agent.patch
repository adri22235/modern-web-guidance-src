+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var supportsScrollEnd = 'onscrollend' in window;
+      var activeScroll = 0; // token used to cancel stale scrolls when a new one starts
+
+      function navHeight() {
+        return nav ? nav.getBoundingClientRect().height : 0;
+      }
+
+      function syncNavHeight() {
+        document.documentElement.style.setProperty('--nav-height', navHeight() + 'px');
+      }
+
+      function getTargetId(link) {
+        var explicit = link.getAttribute('data-scroll-target');
+        if (explicit) return explicit.replace(/^#/, '');
+        var href = link.getAttribute('href') || '';
+        return href.charAt(0) === '#' && href.length > 1 ? href.slice(1) : null;
+      }
+
+      function targetScrollTop(el) {
+        var top = el.getBoundingClientRect().top + window.scrollY - navHeight();
+        var max = document.documentElement.scrollHeight - window.innerHeight;
+        return Math.max(0, Math.min(top, max));
+      }
+
+      // Resolves once scrolling has come to rest: uses the native `scrollend`
+      // event where available, otherwise waits for the position to stop changing.
+      function waitForScrollEnd(destination) {
+        return new Promise(function (resolve) {
+          if (Math.abs(window.scrollY - destination) < 1) {
+            resolve();
+            return;
+          }
+
+          var done = false;
+          var lastY = window.scrollY;
+          var stableFrames = 0;
+          var timeout = setTimeout(finish, 2000); // safety net
+
+          function finish() {
+            if (done) return;
+            done = true;
+            clearTimeout(timeout);
+            window.removeEventListener('scrollend', finish);
+            resolve();
+          }
+
+          if (supportsScrollEnd) {
+            window.addEventListener('scrollend', finish, { once: true });
+            return;
+          }
+
+          (function poll() {
+            if (done) return;
+            var y = window.scrollY;
+            stableFrames = Math.abs(y - lastY) < 0.5 ? stableFrames + 1 : 0;
+            lastY = y;
+            if (stableFrames >= 6) finish();
+            else requestAnimationFrame(poll);
+          })();
+        });
+      }
+
+      function setActiveLink(id) {
+        document.querySelectorAll('nav a').forEach(function (a) {
+          var isActive = getTargetId(a) === id;
+          a.classList.toggle('active', isActive);
+          if (isActive) a.setAttribute('aria-current', 'location');
+          else a.removeAttribute('aria-current');
+        });
+      }
+
+      function onArrive(target) {
+        // Restart the animation even if the same section is selected again.
+        target.classList.remove('is-arrived');
+        void target.offsetWidth;
+        target.classList.add('is-arrived');
+        target.addEventListener('animationend', function handler(e) {
+          if (e.target !== target) return;
+          target.classList.remove('is-arrived');
+          target.removeEventListener('animationend', handler);
+        });
+
+        target.focus({ preventScroll: true });
+        setActiveLink(target.id);
+      }
+
+      function scrollToSection(id, updateHistory) {
+        var target = document.getElementById(id);
+        if (!target) return false;
+
+        var token = ++activeScroll;
+        var destination = targetScrollTop(target);
+
+        window.scrollTo({ top: destination, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+
+        waitForScrollEnd(destination).then(function () {
+          if (token !== activeScroll) return; // superseded by a newer navigation
+          if (updateHistory && location.hash !== '#' + id) {
+            history.pushState(null, '', '#' + id);
+          }
+          onArrive(target);
+        });
+        return true;
+      }
+
+      document.addEventListener('click', function (e) {
