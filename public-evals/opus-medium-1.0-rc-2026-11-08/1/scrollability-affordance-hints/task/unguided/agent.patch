+  <script>
+    (function () {
+      var scroller = document.getElementById('reviews-scroll');
+      var wrapper = scroller.parentElement;
+      var topHint = wrapper.querySelector('.scroll-hint-top');
+      var bottomHint = wrapper.querySelector('.scroll-hint-bottom');
+
+      function updateHints() {
+        var maxScroll = scroller.scrollHeight - scroller.clientHeight;
+        topHint.classList.toggle('visible', scroller.scrollTop > 1);
+        bottomHint.classList.toggle('visible', scroller.scrollTop < maxScroll - 1);
+      }
+
+      scroller.addEventListener('scroll', updateHints, { passive: true });
+      window.addEventListener('resize', updateHints);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(updateHints).observe(scroller);
+      }
+      updateHints();
+    })();
+  </script>
