+
+    .reviews-scroller {
+      --surface: white;
+      --hint-size: .75rem;
+      max-width: 700px;
+      height: 360px;
+      margin: 20px auto 0;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      container-type: scroll-state;
+      background: var(--surface);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .reviews-scroller:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .review-list {
+      list-style: none;
+      padding: 0 20px;
+    }
+
+    .review {
+      padding: 18px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .review:last-child {
+      border-bottom: none;
+    }
+
+    .review-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 10px;
+      margin-bottom: 4px;
+    }
+
+    .review-author {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .review-rating {
+      color: var(--accent);
+      letter-spacing: 2px;
+      white-space: nowrap;
+    }
+
+    .review time {
+      display: block;
+      font-size: 0.8rem;
+      color: #8d6e63;
+      margin-bottom: 6px;
+    }
+
+    /* Scrollability hints: sticky pseudo-elements pinned to the scrollport edges */
+    .reviews-scroller::before,
+    .reviews-scroller::after {
+      content: "";
+      display: block;
+      position: sticky;
+      block-size: var(--hint-size);
+      z-index: 1;
+      /* Let clicks through to the reviews underneath */
+      pointer-events: none;
+      opacity: 0;
+      transition: opacity .2s;
+    }
+
+    .reviews-scroller::before {
+      inset-block-start: 0;
+      margin-block-end: calc(var(--hint-size) * -1);
+      background: radial-gradient(farthest-side at 50% 0, rgb(0 0 0 / .18), transparent);
+    }
+
+    .reviews-scroller::after {
+      inset-block-end: 0;
+      margin-block-start: calc(var(--hint-size) * -1);
+      background: radial-gradient(farthest-side at 50% 100%, rgb(0 0 0 / .18), transparent);
+    }
+
+    /* Top hint only once scrolled down; bottom hint only while more content remains below */
+    @container scroll-state(scrollable: block-start) {
+      .reviews-scroller::before {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: block-end) {
+      .reviews-scroller::after {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback: scroll-driven animations where scroll-state queries are unsupported */
+    @supports not (container-type: scroll-state) {
+      .reviews-scroller::before,
+      .reviews-scroller::after {
+        animation: show-scroll-hint linear both;
+        animation-timeline: scroll();
+      }
+
+      .reviews-scroller::before {
+        animation-range: 0 2rem;
+      }
+
+      .reviews-scroller::after {
+        animation-direction: reverse;
+        animation-range: calc(100% - 2rem) 100%;
+      }
+    }
+
+    @keyframes show-scroll-hint {
+      to {
+        opacity: 1;
+      }
+    }
+
+    /* Last resort: background-attachment shadows on the solid surface */
+    @supports not ((container-type: scroll-state) or (animation-timeline: scroll())) {
+      .reviews-scroller {
+        background:
+          linear-gradient(var(--surface) 30%, transparent) top / 100% 2.5rem no-repeat local,
+          linear-gradient(transparent, var(--surface) 70%) bottom / 100% 2.5rem no-repeat local,
+          radial-gradient(farthest-side at 50% 0, rgb(0 0 0 / .18), transparent) top / 100% var(--hint-size) no-repeat,
+          radial-gradient(farthest-side at 50% 100%, rgb(0 0 0 / .18), transparent) bottom / 100% var(--hint-size) no-repeat,
+          var(--surface);
+      }
+    }
+
