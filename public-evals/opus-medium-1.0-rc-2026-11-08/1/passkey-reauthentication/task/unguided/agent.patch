+  <script>
+    (function () {
+      'use strict';
+
+      var button = document.getElementById('reauth-button');
+      var statusEl = document.getElementById('reauth-status');
+      if (!button) return;
+
+      function setStatus(message, kind) {
+        statusEl.textContent = message;
+        statusEl.className = 'reauth-status' + (kind ? ' ' + kind : '');
+      }
+
+      function base64urlToBuffer(value) {
+        var base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        var padded = base64 + '==='.slice((base64.length + 3) % 4);
+        var binary = atob(padded);
+        var bytes = new Uint8Array(binary.length);
+        for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToBase64url(buffer) {
+        var bytes = new Uint8Array(buffer);
+        var binary = '';
+        for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      // Convert the server's JSON request options into the binary form
+      // navigator.credentials.get() expects.
+      function toRequestOptions(json) {
+        if (!json || typeof json.challenge !== 'string' || !json.challenge) {
+          throw new Error('Server did not return a valid challenge.');
+        }
+        // Re-authentication must be bound to the signed-in user's own
+        // pre-registered credentials; refuse an unscoped (discoverable) request.
+        if (!Array.isArray(json.allowCredentials) || json.allowCredentials.length === 0) {
+          throw new Error('No registered passkeys or security keys were found for your account.');
+        }
+
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          var parsed = PublicKeyCredential.parseRequestOptionsFromJSON(json);
+          parsed.userVerification = json.userVerification || 'required';
+          return parsed;
+        }
+
+        var options = {
+          challenge: base64urlToBuffer(json.challenge),
+          allowCredentials: json.allowCredentials.map(function (cred) {
+            var descriptor = { type: cred.type || 'public-key', id: base64urlToBuffer(cred.id) };
+            if (cred.transports) descriptor.transports = cred.transports;
+            return descriptor;
+          }),
+          userVerification: json.userVerification || 'required'
+        };
+        if (json.rpId) options.rpId = json.rpId;
+        if (typeof json.timeout === 'number') options.timeout = json.timeout;
+        if (json.extensions) options.extensions = json.extensions;
+        if (json.hints) options.hints = json.hints;
+        return options;
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (e) { /* fall through */ }
+        }
+        var response = credential.response;
+        return {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null
+          }
+        };
+      }
+
+      async function postJSON(url, body) {
+        var res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body || {})
+        });
+        var data = null;
+        try { data = await res.json(); } catch (e) { /* non-JSON body */ }
+        if (!res.ok) {
+          var msg = (data && (data.error || data.message)) || ('Request failed (' + res.status + ').');
+          throw new Error(msg);
+        }
+        return data;
+      }
+
+      var inFlight = null;
+
+      async function reauthenticate() {
+        if (inFlight) return;
+        if (!window.PublicKeyCredential || !navigator.credentials || !window.isSecureContext) {
+          setStatus('Your browser does not support passkeys or security keys on this page.', 'error');
+          return;
+        }
+
+        inFlight = new AbortController();
+        button.disabled = true;
+        setStatus('Requesting a challenge…');
+
+        try {
+          var optionsJSON = await postJSON('/api/reauth/options', {});
+          // Accept either the bare options or a { publicKey: {...} } wrapper.
+          var publicKeyJSON = optionsJSON && optionsJSON.publicKey ? optionsJSON.publicKey : optionsJSON;
+          var publicKey = toRequestOptions(publicKeyJSON);
+
+          setStatus('Follow the prompt from your browser to verify with your passkey or security key…');
+          var credential = await navigator.credentials.get({
+            publicKey: publicKey,
+            mediation: 'required',
+            signal: inFlight.signal
+          });
+          if (!credential) throw new Error('No credential was returned.');
+
+          setStatus('Verifying…');
+          var result = await postJSON('/api/reauth/verify', credentialToJSON(credential));
+          if (result && (result.verified === false || result.success === false)) {
+            throw new Error(result.error || result.message || 'Verification failed.');
+          }
+
+          setStatus('Identity confirmed. You can now make changes to your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success', { detail: result }));
+        } catch (err) {
+          var message;
+          if (err && err.name === 'NotAllowedError') {
+            message = 'Verification was cancelled or timed out. Please try again.';
+          } else if (err && err.name === 'AbortError') {
+            message = 'Verification was cancelled.';
+          } else if (err && err.name === 'SecurityError') {
+            message = 'This site is not allowed to use your passkey.';
+          } else {
+            message = (err && err.message) || 'Verification failed. Please try again.';
+          }
+          setStatus(message, 'error');
+          document.dispatchEvent(new CustomEvent('reauth:failure', { detail: { error: err } }));
+        } finally {
+          inFlight = null;
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', reauthenticate);
+    })();
+  </script>
