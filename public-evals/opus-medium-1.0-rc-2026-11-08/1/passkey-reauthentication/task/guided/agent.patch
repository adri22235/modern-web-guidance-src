+  <script type="module">
+    // Base64URL helpers used only when the native WebAuthn JSON helpers are missing.
+    const fromB64Url = (str) => {
+      const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+      return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+    };
+    const toB64Url = (buf) => {
+      const bytes = new Uint8Array(buf instanceof ArrayBuffer ? buf : buf.buffer);
+      let bin = '';
+      for (const b of bytes) bin += String.fromCharCode(b);
+      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    };
+
+    function parseRequestOptions(json) {
+      if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: fromB64Url(json.challenge),
+        allowCredentials: (json.allowCredentials ?? []).map((cred) => ({ ...cred, id: fromB64Url(cred.id) })),
+      };
+    }
+
+    function credentialToJSON(cred) {
+      if (typeof cred.toJSON === 'function') return cred.toJSON();
+      const r = cred.response;
+      return {
+        id: cred.id,
+        rawId: toB64Url(cred.rawId),
+        type: cred.type,
+        authenticatorAttachment: cred.authenticatorAttachment ?? undefined,
+        clientExtensionResults: cred.getClientExtensionResults(),
+        response: {
+          clientDataJSON: toB64Url(r.clientDataJSON),
+          authenticatorData: toB64Url(r.authenticatorData),
+          signature: toB64Url(r.signature),
+          userHandle: r.userHandle ? toB64Url(r.userHandle) : undefined,
+        },
+      };
+    }
+
+    const button = document.getElementById('reauth-btn');
+    const status = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    const setStatus = (message, state = '') => {
+      status.textContent = message;
+      status.dataset.state = state;
+    };
+
+    async function triggerButtonReauth() {
+      if (!window.PublicKeyCredential || !window.isSecureContext) {
+        setStatus('Your browser does not support passkey verification.', 'error');
+        return;
+      }
+
+      // Abort any in-flight ceremony so passkey prompts don't collide.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      try {
+        // The server scopes allowCredentials to the signed-in user's registered passkeys.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) throw new Error(`options request failed (${optionsResponse.status})`);
+        const optionsJSON = await optionsResponse.json();
+        const publicKey = parseRequestOptions(optionsJSON.publicKey ?? optionsJSON);
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) throw new Error('no credential returned');
+
+        const encodedCredential = credentialToJSON(credential);
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now update your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+          return;
+        }
+
+        if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          // Tell the password manager this passkey no longer exists on the server.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId, // Always the server-provided rpId, never location.hostname.
+            credentialId: encodedCredential.id,
+          }).catch(() => {});
+        }
+        setStatus('We could not verify your identity. Please try again.', 'error');
+      } catch (err) {
+        if (err.name === 'AbortError') return;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled.', 'error');
+        } else {
+          console.error('Reauthentication failed:', err);
+          setStatus('Something went wrong while verifying your identity.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerButtonReauth);
+  </script>
+
