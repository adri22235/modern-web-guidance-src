+  <script>
+    // Log whether this tab was opened in the background during initial load.
+    (() => {
+      const FALLBACK_NOTE =
+        'VisibilityStateEntry is unsupported; fell back to document.visibilityState, ' +
+        'which is unreliable for async scripts (the tab may have been foregrounded ' +
+        'before this script ran) and has imprecise timestamps.';
+
+      if ('VisibilityStateEntry' in window) {
+        // The performance timeline records visibility changes from navigation start,
+        // regardless of when this script executes.
+        const entries = performance.getEntriesByType('visibility-state');
+        const firstHidden = entries.find((entry) => entry.name === 'hidden');
+        console.log({
+          backgrounded: entries.length > 0 && entries[0].name === 'hidden',
+          // Milliseconds since navigation start when the page was first hidden.
+          timestamp: firstHidden ? firstHidden.startTime : null,
+        });
+        return;
+      }
+
+      const backgrounded = document.visibilityState === 'hidden';
+      console.log({
+        backgrounded,
+        // Approximated: assume hidden from navigation start (0 ms) if hidden now.
+        timestamp: backgrounded ? 0 : null,
+        note: FALLBACK_NOTE,
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
