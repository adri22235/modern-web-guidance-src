diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,44 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+  <script>
+    // Detect whether the tab was opened in the background during initial page load.
+    (function () {
+      var result = {
+        backgrounded: false,
+        timestamp: Date.now(),
+        note: null
+      };
+
+      var entries = [];
+      try {
+        // Visibility State Entry API: records the initial visibility state at time 0,
+        // so it stays accurate no matter when (or how asynchronously) this script runs.
+        if (window.PerformanceObserver &&
+          PerformanceObserver.supportedEntryTypes &&
+          PerformanceObserver.supportedEntryTypes.indexOf('visibility-state') !== -1) {
+          entries = performance.getEntriesByType('visibility-state');
+        }
+      } catch (e) {
+        entries = [];
+      }
+
+      if (entries.length > 0) {
+        result.backgrounded = entries[0].name === 'hidden';
+      } else {
+        // Fallback: only reflects the state when this script executes. That's fine for this
+        // inline, parser-blocking script, but the tab may already have changed visibility
+        // by the time an async/deferred script runs.
+        result.backgrounded = document.visibilityState === 'hidden';
+        result.note = 'Visibility State Entry API unavailable; fell back to document.visibilityState, ' +
+          'which is unreliable for async scripts because visibility may change before they execute.';
+      }
+
+      console.log(result);
+    })();
+  </script>
 </head>
 
