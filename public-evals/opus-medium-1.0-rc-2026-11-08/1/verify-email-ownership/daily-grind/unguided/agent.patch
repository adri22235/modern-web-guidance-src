+// Server-side verification for the browser Email Verification Protocol (EVP).
+//
+// Flow: the browser asks the user's email provider (the "issuer") for an
+// SD-JWT asserting the email address, binds it to our nonce with a KB-JWT, and
+// hands the combined presentation token to the page. We verify it here:
+//
+//   1. Split `<issuer-jwt>~[<disclosure>~...]<kb-jwt>`.
+//   2. Find the issuer authorised for the email domain via DNS
+//      (`_email-verification.<domain>  TXT  "iss=<issuer>"`).
+//   3. Fetch `https://<issuer>/.well-known/email-verification` -> jwks_uri -> keys.
+//   4. Verify the issuer signature, claims (iss, iat, email, email_verified, cnf).
+//   5. Verify the KB-JWT with the key in `cnf.jwk` and check aud, nonce, iat, sd_hash.
+//
+// No email is ever sent: control of the address is attested by the provider.
+
+import { createHash, createPublicKey, verify as cryptoVerify } from 'node:crypto';
+import { promises as dns } from 'node:dns';
+import https from 'node:https';
+import net from 'node:net';
+
+export class EvpError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.code = code;
+  }
+}
+
+const fail = (code, message) => {
+  throw new EvpError(code, message);
+};
+
+const ALGS = {
+  ES256: { kty: 'EC', crv: 'P-256', hash: 'sha256', dsaEncoding: 'ieee-p1363' },
+  ES384: { kty: 'EC', crv: 'P-384', hash: 'sha384', dsaEncoding: 'ieee-p1363' },
+  EdDSA: { kty: 'OKP', crv: 'Ed25519', hash: null },
+  Ed25519: { kty: 'OKP', crv: 'Ed25519', hash: null },
+  RS256: { kty: 'RSA', hash: 'sha256' },
+};
+
+const ISSUER_TYPES = new Set(['evp+sd-jwt', 'sd-jwt', 'dc+sd-jwt', 'vc+sd-jwt']);
+const KB_TYPE = 'kb+jwt';
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const CLOCK_SKEW = 60;
+const MAX_ISSUER_TOKEN_AGE = 5 * 60;
+const MAX_KB_AGE = 5 * 60;
+
+const B64URL = /^[A-Za-z0-9_-]+$/;
+const HOSTNAME = /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$/;
+
+const b64urlDecode = (s, what) => {
+  if (typeof s !== 'string' || !B64URL.test(s)) fail('malformed_token', `Invalid base64url in ${what}`);
+  return Buffer.from(s, 'base64url');
+};
+
+const parseJsonPart = (s, what) => {
+  try {
+    const value = JSON.parse(b64urlDecode(s, what).toString('utf8'));
+    return value;
+  } catch (err) {
+    if (err instanceof EvpError) throw err;
+    fail('malformed_token', `Invalid JSON in ${what}`);
+  }
+};
+
+const sha256b64url = (s) => createHash('sha256').update(s, 'ascii').digest('base64url');
+
+const isPlainObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
+
+/** Normalise a hostname (IDN -> punycode, lowercase). Returns null if not a public DNS name. */
+export function normalizeHostname(input) {
+  if (typeof input !== 'string' || input.length === 0 || input.length > 253) return null;
+  if (/[\/\\?#@:\s]/.test(input)) return null;
+  let host;
+  try {
+    host = new URL(`https://${input}`).hostname;
+  } catch {
+    return null;
+  }
+  host = host.replace(/\.$/, '').toLowerCase();
+  if (net.isIP(host) || !HOSTNAME.test(host)) return null;
+  return host;
+}
+
+/** Issuer identifiers may be written as a bare host or an https origin. */
+function normalizeIssuer(iss) {
+  if (typeof iss !== 'string') return null;
+  if (iss.startsWith('https://')) {
+    let url;
+    try {
+      url = new URL(iss);
+    } catch {
+      return null;
+    }
+    if (url.port || url.username || url.password || url.search || url.hash) return null;
+    if (url.pathname !== '/' && url.pathname !== '') return null;
+    return normalizeHostname(url.hostname);
+  }
+  return normalizeHostname(iss);
+}
+
+/** Split an address into local part and normalised domain. */
+export function parseEmail(email) {
+  if (typeof email !== 'string' || email.length > 254) return null;
+  const at = email.lastIndexOf('@');
+  if (at < 1 || at === email.length - 1) return null;
+  const local = email.slice(0, at);
+  if (local.length > 64 || /[\s<>()\[\],;:\\"]/.test(local)) return null;
+  const domain = normalizeHostname(email.slice(at + 1));
+  if (!domain) return null;
+  return { local, domain, address: `${local}@${domain}` };
+}
+
+function publicKeyFromJwk(jwk, alg) {
+  const spec = ALGS[alg];
+  if (!spec) fail('unsupported_alg', `Unsupported algorithm ${alg}`);
+  if (!isPlainObject(jwk)) fail('bad_key', 'Key is not a JWK object');
+  if (jwk.kty !== spec.kty) fail('bad_key', 'Key type does not match algorithm');
+  if (spec.crv && jwk.crv !== spec.crv) fail('bad_key', 'Key curve does not match algorithm');
+  if (jwk.alg !== undefined && jwk.alg !== alg) fail('bad_key', 'Key alg does not match token alg');
+  if (jwk.use !== undefined && jwk.use !== 'sig') fail('bad_key', 'Key is not a signing key');
+  if ('d' in jwk || 'p' in jwk || 'q' in jwk || 'k' in jwk) fail('bad_key', 'Private key material supplied');
+
+  // Only pass the public members through to the key importer.
+  const pub =
+    spec.kty === 'EC' ? { kty: 'EC', crv: jwk.crv, x: jwk.x, y: jwk.y }
+    : spec.kty === 'OKP' ? { kty: 'OKP', crv: jwk.crv, x: jwk.x }
+    : { kty: 'RSA', n: jwk.n, e: jwk.e };
+
+  let key;
+  try {
+    key = createPublicKey({ key: pub, format: 'jwk' });
+  } catch {
+    fail('bad_key', 'Could not import key');
+  }
+  if (spec.kty === 'RSA' && (key.asymmetricKeyDetails?.modulusLength ?? 0) < 2048) {
+    fail('bad_key', 'RSA key too small');
+  }
+  return key;
+}
+
+/** Decode a compact JWS without verifying it. */
+function decodeJws(jws, what) {
+  if (typeof jws !== 'string') fail('malformed_token', `Missing ${what}`);
+  const parts = jws.split('.');
+  if (parts.length !== 3) fail('malformed_token', `${what} is not a compact JWS`);
+  const header = parseJsonPart(parts[0], `${what} header`);
+  const payload = parseJsonPart(parts[1], `${what} payload`);
+  if (!isPlainObject(header) || !isPlainObject(payload)) fail('malformed_token', `${what} is not a JSON object`);
+  const signature = b64urlDecode(parts[2], `${what} signature`);
+  if (!Object.hasOwn(ALGS, header.alg)) fail('unsupported_alg', `${what} uses unsupported alg`);
+  if (header.crit !== undefined) fail('malformed_token', `${what} has unsupported critical headers`);
+  return { header, payload, signature, signingInput: `${parts[0]}.${parts[1]}` };
+}
+
+function verifyJwsSignature(decoded, key, what) {
+  const spec = ALGS[decoded.header.alg];
+  const opts = spec.dsaEncoding ? { key, dsaEncoding: spec.dsaEncoding } : key;
+  let ok = false;
+  try {
+    ok = cryptoVerify(spec.hash, Buffer.from(decoded.signingInput, 'ascii'), opts, decoded.signature);
+  } catch {
+    ok = false;
+  }
+  if (!ok) fail('bad_signature', `${what} signature is invalid`);
+}
+
+/** Apply top-level SD-JWT disclosures to the issuer payload. */
+function applyDisclosures(payload, disclosures) {
+  const claims = { ...payload };
+  const sdAlg = claims._sd_alg ?? 'sha-256';
+  if (sdAlg !== 'sha-256') fail('malformed_token', 'Unsupported _sd_alg');
+  const digests = claims._sd ?? [];
+  if (!Array.isArray(digests) || digests.some((d) => typeof d !== 'string')) fail('malformed_token', 'Invalid _sd');
+  if (new Set(digests).size !== digests.length) fail('malformed_token', 'Duplicate _sd digests');
+  delete claims._sd;
+  delete claims._sd_alg;
+
+  const byDigest = new Map();
+  for (const disclosure of disclosures) {
+    const digest = sha256b64url(disclosure);
+    if (byDigest.has(digest)) fail('malformed_token', 'Duplicate disclosure');
+    byDigest.set(digest, disclosure);
+  }
+
+  for (const digest of digests) {
+    const disclosure = byDigest.get(digest);
+    if (!disclosure) continue; // Undisclosed claim (or decoy digest).
+    byDigest.delete(digest);
+    let arr;
+    try {
+      arr = JSON.parse(b64urlDecode(disclosure, 'disclosure').toString('utf8'));
+    } catch (err) {
+      if (err instanceof EvpError) throw err;
+      fail('malformed_token', 'Invalid disclosure');
+    }
+    if (!Array.isArray(arr) || arr.length !== 3 || typeof arr[1] !== 'string') {
+      fail('malformed_token', 'Unsupported disclosure shape');
+    }
+    const [, name, value] = arr;
+    if (name === '_sd' || name === '...' || Object.hasOwn(claims, name)) {
+      fail('malformed_token', 'Disclosure overwrites an existing claim');
+    }
+    claims[name] = value;
+  }
+  if (byDigest.size > 0) fail('malformed_token', 'Disclosure not referenced by issuer');
+  return claims;
+}
+
+// ---------------------------------------------------------------------------
+// Network helpers (DNS + SSRF-safe HTTPS fetch)
+// ---------------------------------------------------------------------------
+
+const blocked = new net.BlockList();
+for (const [addr, prefix] of [
+  ['0.0.0.0', 8], ['10.0.0.0', 8], ['100.64.0.0', 10], ['127.0.0.0', 8], ['169.254.0.0', 16],
+  ['172.16.0.0', 12], ['192.0.0.0', 24], ['192.0.2.0', 24], ['192.168.0.0', 16], ['198.18.0.0', 15],
+  ['198.51.100.0', 24], ['203.0.113.0', 24], ['224.0.0.0', 4], ['240.0.0.0', 4],
+]) blocked.addSubnet(addr, prefix, 'ipv4');
+for (const [addr, prefix] of [
+  ['::', 128], ['::1', 128], ['64:ff9b::', 96], ['100::', 64], ['2001:db8::', 32],
+  ['fc00::', 7], ['fe80::', 10], ['ff00::', 8],
+]) blocked.addSubnet(addr, prefix, 'ipv6');
+
+export function isPublicAddress(address, family) {
+  const type = family === 6 || family === 'IPv6' ? 'ipv6' : 'ipv4';
+  return !blocked.check(address, type);
+}
+
+/** DNS lookup that refuses to connect to private / loopback / link-local addresses. */
+function safeLookup(hostname, options, callback) {
+  dns
+    .lookup(hostname, { all: true })
+    .then((addrs) => {
+      const ok = addrs.filter((a) => isPublicAddress(a.address, a.family));
+      if (ok.length === 0 || ok.length !== addrs.length) {
+        throw new Error(`Refusing to connect to non-public address for ${hostname}`);
+      }
+      if (options && options.all) callback(null, ok);
+      else callback(null, ok[0].address, ok[0].family);
+    })
+    .catch((err) => callback(err));
+}
+
+const MAX_BODY = 256 * 1024;
+
+export function fetchJsonHttps(url, { timeoutMs = 5000 } = {}) {
+  return new Promise((resolve, reject) => {
+    const u = new URL(url);
+    if (u.protocol !== 'https:') return reject(new Error('Only https URLs are allowed'));
+    const req = https.get(
+      u,
+      { lookup: safeLookup, headers: { accept: 'application/json' }, timeout: timeoutMs },
+      (res) => {
+        if (res.statusCode !== 200) {
+          res.resume();
+          return reject(new Error(`HTTP ${res.statusCode} from ${u.host}`));
+        }
+        const chunks = [];
+        let size = 0;
+        res.on('data', (c) => {
+          size += c.length;
+          if (size > MAX_BODY) {
+            req.destroy(new Error('Response too large'));
+          } else chunks.push(c);
+        });
+        res.on('end', () => {
+          try {
+            resolve(JSON.parse(Buffer.concat(chunks).toString('utf8')));
+          } catch {
+            reject(new Error(`Invalid JSON from ${u.host}`));
+          }
+        });
+        res.on('error', reject);
+      },
+    );
+    req.on('timeout', () => req.destroy(new Error('Request timed out')));
+    req.on('error', reject);
+  });
+}
+
+function cached(fn, ttlMs, maxEntries = 500) {
+  const cache = new Map();
+  return async (key) => {
+    const hit = cache.get(key);
+    if (hit && hit.expires > Date.now()) return hit.value;
+    const value = await fn(key);
+    if (cache.size >= maxEntries) cache.delete(cache.keys().next().value);
+    cache.set(key, { value, expires: Date.now() + ttlMs });
+    return value;
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Verifier
+// ---------------------------------------------------------------------------
+
+/**
+ * @param {object} opts
+ * @param {string} opts.audience          Our origin, e.g. "https://dailygrind.example". Must equal KB-JWT `aud`.
+ * @param {(name: string) => Promise<string[][]>} [opts.resolveTxt]
+ * @param {(url: string) => Promise<any>} [opts.fetchJson]
+ * @param {() => number} [opts.now]       Current time in seconds.
+ */
+export function createEmailVerifier({
+  audience,
+  resolveTxt = (name) => dns.resolveTxt(name),
+  fetchJson = fetchJsonHttps,
+  now = () => Math.floor(Date.now() / 1000),
+  cacheTtlMs = 5 * 60 * 1000,
+} = {}) {
+  if (!audience) throw new Error('audience is required');
+  const fetchCached = cached(fetchJson, cacheTtlMs);
+
+  async function issuerForDomain(domain) {
+    let records;
+    try {
+      records = await resolveTxt(`_email-verification.${domain}`);
+    } catch {
+      fail('no_issuer', `Email provider for ${domain} does not support browser verification`);
+    }
+    const issuers = records
+      .map((chunks) => chunks.join(''))
+      .filter((txt) => txt.startsWith('iss='))
+      .map((txt) => normalizeIssuer(txt.slice(4).trim()));
+    if (issuers.length !== 1 || !issuers[0]) {
+      fail('no_issuer', `Email provider for ${domain} does not support browser verification`);
+    }
+    return issuers[0];
+  }
+
+  async function issuerKey(issuer, header) {
+    let metadata;
+    try {
+      metadata = await fetchCached(`https://${issuer}/.well-known/email-verification`);
+    } catch {
+      fail('issuer_unreachable', 'Could not load email provider metadata');
+    }
+    if (!isPlainObject(metadata) || typeof metadata.jwks_uri !== 'string') {
+      fail('issuer_metadata', 'Email provider metadata is invalid');
+    }
+    let jwksUrl;
+    try {
+      jwksUrl = new URL(metadata.jwks_uri);
+    } catch {
+      fail('issuer_metadata', 'Email provider jwks_uri is invalid');
+    }
+    const jwksHost = jwksUrl.hostname.toLowerCase();
+    if (jwksUrl.protocol !== 'https:' || (jwksHost !== issuer && !jwksHost.endsWith(`.${issuer}`))) {
+      fail('issuer_metadata', 'Email provider jwks_uri must be https on the issuer domain');
+    }
+    const supported = metadata.signing_alg_values_supported;
+    if (Array.isArray(supported) && !supported.includes(header.alg)) {
+      fail('unsupported_alg', 'Token alg not advertised by issuer');
+    }
+
+    let jwks;
+    try {
+      jwks = await fetchCached(jwksUrl.href);
+    } catch {
+      fail('issuer_unreachable', 'Could not load email provider keys');
+    }
+    const keys = Array.isArray(jwks?.keys) ? jwks.keys.filter(isPlainObject) : [];
+    let jwk;
+    if (typeof header.kid === 'string') jwk = keys.find((k) => k.kid === header.kid);
+    else if (keys.length === 1) jwk = keys[0];
+    if (!jwk) fail('bad_key', 'Signing key not found at issuer');
+    return publicKeyFromJwk(jwk, header.alg);
+  }
+
+  /**
+   * Verify a presentation token. Resolves to `{ email, issuer }` or throws EvpError.
+   * @param {string} token
+   * @param {{ nonce: string }} expected
+   */
+  async function verify(token, { nonce }) {
+    if (typeof token !== 'string' || token.length === 0 || token.length > MAX_TOKEN_LENGTH) {
+      fail('malformed_token', 'Missing or oversized token');
+    }
+    if (typeof nonce !== 'string' || nonce.length < 16) fail('bad_nonce', 'No verification nonce');
+
+    const parts = token.split('~');
+    if (parts.length < 2) fail('malformed_token', 'Token is not an SD-JWT+KB');
+    const kbJwt = parts.pop();
+    const [issuerJwt, ...disclosures] = parts;
+    if (!kbJwt) fail('malformed_token', 'Key binding JWT missing');
+    if (disclosures.some((d) => d.length === 0)) fail('malformed_token', 'Empty disclosure');
+
+    // --- Issuer-signed JWT --------------------------------------------------
+    const sd = decodeJws(issuerJwt, 'issuer token');
+    if (!ISSUER_TYPES.has(sd.header.typ)) fail('malformed_token', 'Unexpected issuer token type');
+    const claims = applyDisclosures(sd.payload, disclosures);
+
+    const t = now();
+    if (typeof claims.iat !== 'number') fail('bad_claims', 'Issuer token missing iat');
+    if (claims.iat > t + CLOCK_SKEW || claims.iat < t - MAX_ISSUER_TOKEN_AGE) {
+      fail('expired', 'Issuer token is not fresh');
+    }
+    if (claims.exp !== undefined && (typeof claims.exp !== 'number' || claims.exp < t - CLOCK_SKEW)) {
+      fail('expired', 'Issuer token expired');
+    }
+    if (claims.nbf !== undefined && (typeof claims.nbf !== 'number' || claims.nbf > t + CLOCK_SKEW)) {
+      fail('expired', 'Issuer token not yet valid');
+    }
+    if (claims.email_verified !== true) fail('bad_claims', 'Email is not verified by provider');
+    const email = parseEmail(claims.email);
+    if (!email) fail('bad_claims', 'Issuer token has invalid email');
+
+    const issuer = await issuerForDomain(email.domain);
+    if (normalizeIssuer(claims.iss) !== issuer) fail('wrong_issuer', 'Token issuer is not authorised for this email domain');
+
+    const key = await issuerKey(issuer, sd.header);
+    verifyJwsSignature(sd, key, 'issuer token');
+
+    // --- Key-binding JWT ----------------------------------------------------
+    if (!isPlainObject(claims.cnf) || !isPlainObject(claims.cnf.jwk)) fail('bad_claims', 'Issuer token missing cnf.jwk');
+    const kb = decodeJws(kbJwt, 'key binding token');
+    if (kb.header.typ !== KB_TYPE) fail('malformed_token', 'Unexpected key binding token type');
+    const holderKey = publicKeyFromJwk(claims.cnf.jwk, kb.header.alg);
+    verifyJwsSignature(kb, holderKey, 'key binding token');
+
+    const kbc = kb.payload;
+    if (kbc.aud !== audience) fail('wrong_audience', 'Token was issued for a different site');
+    if (kbc.nonce !== nonce) fail('bad_nonce', 'Token nonce does not match');
+    if (typeof kbc.iat !== 'number' || kbc.iat > t + CLOCK_SKEW || kbc.iat < t - MAX_KB_AGE) {
+      fail('expired', 'Key binding token is not fresh');
+    }
+    const presented = token.slice(0, token.length - kbJwt.length); // ends with "~"
+    if (kbc.sd_hash !== sha256b64url(presented)) fail('bad_claims', 'sd_hash does not match presentation');
+
+    return { email: email.address, issuer };
+  }
+
+  return { verify };
+}
