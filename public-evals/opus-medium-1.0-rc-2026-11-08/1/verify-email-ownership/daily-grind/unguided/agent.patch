diff --git a/public/rewards-signup.js b/public/rewards-signup.js
new file mode 100644
index 0000000..cb9dc40
--- /dev/null
+++ b/public/rewards-signup.js
@@ -0,0 +1,132 @@
+// Rewards sign-up: verifies the customer's email through the browser's Email
+// Verification Protocol instead of a one-time passcode or magic link.
+//
+// The page puts a server-issued nonce on the email input. When the customer picks
+// an address from browser autofill, a supporting browser obtains a signed token
+// from their email provider and fires an `emailverified` event carrying
+// `presentationToken`, which we send to the server to verify.
+
+(() => {
+  const form = document.getElementById('rewards-form');
+  if (!form) return;
+  const emailInput = form.querySelector('#rewards-email');
+  const status = form.querySelector('#rewards-email-status');
+  const changeBtn = form.querySelector('#rewards-email-change');
+  const submitBtn = form.querySelector('#rewards-submit');
+  const formMsg = form.querySelector('#rewards-form-message');
+  const success = document.getElementById('rewards-success');
+
+  let verifiedEmail = null;
+  let verifying = false;
+
+  function setStatus(text, kind) {
+    status.textContent = text;
+    status.dataset.kind = kind || '';
+  }
+
+  function updateSubmit() {
+    submitBtn.disabled = !verifiedEmail || verifying;
+  }
+
+  async function api(path, body) {
+    const res = await fetch(path, {
+      method: body ? 'POST' : 'GET',
+      credentials: 'same-origin',
+      headers: body ? { 'Content-Type': 'application/json' } : {},
+      body: body ? JSON.stringify(body) : undefined,
+    });
+    const data = await res.json().catch(() => ({}));
+    if (!res.ok) throw Object.assign(new Error(data.message || 'Request failed'), { code: data.error });
+    return data;
+  }
+
+  async function refreshNonce() {
+    try {
+      const { nonce } = await api('/api/rewards/nonce');
+      emailInput.setAttribute('nonce', nonce);
+      emailInput.nonce = nonce;
+    } catch {
+      setStatus('Could not start email verification. Please reload the page.', 'error');
+    }
+  }
+
+  function resetVerification() {
+    verifiedEmail = null;
+    emailInput.readOnly = false;
+    changeBtn.hidden = true;
+    setStatus('Choose your email from your browser’s autofill suggestions to verify it instantly.', '');
+    updateSubmit();
+  }
+
+  emailInput.addEventListener('emailverified', async (event) => {
+    const token = event.presentationToken;
+    if (!token) return;
+    verifying = true;
+    updateSubmit();
+    setStatus('Confirming your email with your provider…', 'pending');
+    try {
+      const { email, issuer } = await api('/api/rewards/verify-email', { presentationToken: token });
+      verifiedEmail = email;
+      emailInput.value = email;
+      emailInput.readOnly = true;
+      changeBtn.hidden = false;
+      setStatus(`✓ Email verified by ${issuer}`, 'ok');
+    } catch (err) {
+      resetVerification();
+      setStatus(err.message || 'We couldn’t verify that email. Please try again.', 'error');
+      refreshNonce();
+    } finally {
+      verifying = false;
+      updateSubmit();
+    }
+  });
+
+  changeBtn.addEventListener('click', () => {
+    resetVerification();
+    emailInput.value = '';
+    emailInput.focus();
+    refreshNonce();
+  });
+
+  emailInput.addEventListener('input', () => {
+    if (!verifiedEmail) {
+      setStatus('Choose your email from your browser’s autofill suggestions to verify it instantly. ' +
+        'Your browser must support email verification — no codes or links are sent.', '');
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    formMsg.textContent = '';
+    if (!verifiedEmail) {
+      formMsg.textContent = 'Please verify your email address first.';
+      return;
+    }
+    if (!form.reportValidity()) return;
+    const data = new FormData(form);
+    submitBtn.disabled = true;
+    try {
+      const result = await api('/api/rewards/signup', {
+        name: data.get('name'),
+        email: verifiedEmail,
+        birthday: data.get('birthday') || '',
+        marketing: data.get('marketing') === 'on',
+      });
+      form.hidden = true;
+      success.querySelector('[data-name]').textContent = result.name;
+      success.querySelector('[data-points]').textContent = result.points;
+      success.hidden = false;
+      success.focus();
+    } catch (err) {
+      formMsg.textContent = err.message;
+      if (err.code === 'email_not_verified') {
+        resetVerification();
+        refreshNonce();
+      }
+      updateSubmit();
+    }
+  });
+
+  resetVerification();
+  refreshNonce();
+})();
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..c75229a
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,296 @@
+// The Daily Grind web server: serves the homepage and the rewards sign-up API.
+//
+//   GET  /api/rewards/nonce          -> { nonce }   (fresh nonce bound to the session cookie)
+//   POST /api/rewards/verify-email   { presentationToken } -> { email, issuer }
+//   POST /api/rewards/signup         { name, email, birthday?, marketing? } -> { ok, name, points }
+//
+// Environment:
+//   PORT           Listen port (default 11222)
+//   PUBLIC_ORIGIN  Origin the site is served from, e.g. https://dailygrind.example.
+//                  Used as the expected `aud` of verification tokens and for CSRF checks.
+//   DATA_DIR       Where accounts.json is stored (default ./data)
+
+import http from 'node:http';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { readFile, writeFile, rename, mkdir } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createEmailVerifier, EvpError, parseEmail } from './lib/evp-verify.mjs';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const ORIGIN = (process.env.PUBLIC_ORIGIN || `http://localhost:${PORT}`).replace(/\/$/, '');
+const SECURE_COOKIE = ORIGIN.startsWith('https://');
+const DATA_DIR = process.env.DATA_DIR || path.join(ROOT, 'data');
+const ACCOUNTS_FILE = path.join(DATA_DIR, 'accounts.json');
+
+const WELCOME_POINTS = 50;
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const VERIFIED_TTL_MS = 15 * 60 * 1000;
+const MAX_SESSIONS = 50_000;
+const MAX_JSON_BODY = 32 * 1024;
+
+const verifier = createEmailVerifier({ audience: ORIGIN });
+
+// ---------------------------------------------------------------------------
+// Static files (explicit allowlist, no filesystem path mapping)
+// ---------------------------------------------------------------------------
+
+const STATIC = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/rewards-signup.js': { file: 'public/rewards-signup.js', type: 'text/javascript; charset=utf-8' },
+};
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy':
+    "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; " +
+    "img-src 'self' https://images.unsplash.com; connect-src 'self'; form-action 'self'; " +
+    "frame-ancestors 'none'; base-uri 'none'; object-src 'none'",
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+};
+
+// ---------------------------------------------------------------------------
+// Sessions (in memory; short-lived, only hold verification state)
+// ---------------------------------------------------------------------------
+
+const sessions = new Map();
+
+function getSession(req) {
+  const match = /(?:^|;\s*)dg_sid=([A-Za-z0-9_-]{43})(?:;|$)/.exec(req.headers.cookie || '');
+  if (!match) return null;
+  const s = sessions.get(match[1]);
+  if (!s || s.expires < Date.now()) {
+    sessions.delete(match[1]);
+    return null;
+  }
+  s.expires = Date.now() + SESSION_TTL_MS;
+  return s;
+}
+
+function createSession(res) {
+  if (sessions.size >= MAX_SESSIONS) sweepSessions();
+  if (sessions.size >= MAX_SESSIONS) sessions.delete(sessions.keys().next().value);
+  const id = randomBytes(32).toString('base64url');
+  const s = { id, expires: Date.now() + SESSION_TTL_MS, nonce: null, verified: null };
+  sessions.set(id, s);
+  res.setHeader(
+    'Set-Cookie',
+    `dg_sid=${id}; Path=/api/rewards; HttpOnly; SameSite=Strict; Max-Age=${SESSION_TTL_MS / 1000}` +
+      (SECURE_COOKIE ? '; Secure' : ''),
+  );
+  return s;
+}
+
+function sweepSessions() {
+  const t = Date.now();
+  for (const [id, s] of sessions) if (s.expires < t) sessions.delete(id);
+}
+setInterval(sweepSessions, 60_000).unref();
+
+// ---------------------------------------------------------------------------
+// Simple fixed-window rate limiter per client IP
+// ---------------------------------------------------------------------------
+
+const buckets = new Map();
+function rateLimited(req, name, limit, windowMs = 60_000) {
+  const key = `${name}:${req.socket.remoteAddress}`;
+  const t = Date.now();
+  let b = buckets.get(key);
+  if (!b || b.reset < t) {
+    if (buckets.size > 100_000) buckets.clear();
+    b = { count: 0, reset: t + windowMs };
+    buckets.set(key, b);
+  }
+  return ++b.count > limit;
+}
+
+// ---------------------------------------------------------------------------
+// Account storage (JSON file, writes serialised and atomic)
+// ---------------------------------------------------------------------------
+
+let accounts = null;
+let writeChain = Promise.resolve();
+
+async function loadAccounts() {
+  if (accounts) return accounts;
+  try {
+    accounts = JSON.parse(await readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+    accounts = {};
+  }
+  return accounts;
+}
+
+function saveAccounts() {
+  writeChain = writeChain.then(async () => {
+    await mkdir(DATA_DIR, { recursive: true });
+    const tmp = `${ACCOUNTS_FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(accounts, null, 2), { mode: 0o600 });
+    await rename(tmp, ACCOUNTS_FILE);
+  });
+  return writeChain;
+}
+
+// ---------------------------------------------------------------------------
+// HTTP helpers
+// ---------------------------------------------------------------------------
+
+function send(res, status, body, headers = {}) {
+  const isJson = typeof body !== 'string' && !Buffer.isBuffer(body);
+  res.writeHead(status, {
+    ...SECURITY_HEADERS,
+    ...(isJson ? { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' } : {}),
+    ...headers,
+  });
+  res.end(isJson ? JSON.stringify(body) : body);
+}
+
+const sendError = (res, status, code, message) => send(res, status, { error: code, message });
+
+function readJson(req) {
+  return new Promise((resolve, reject) => {
+    const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+    if (type !== 'application/json') return reject(Object.assign(new Error('Expected JSON'), { status: 415 }));
+    const chunks = [];
+    let size = 0;
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > MAX_JSON_BODY) {
+        reject(Object.assign(new Error('Request too large'), { status: 413 }));
+        req.destroy();
+      } else chunks.push(c);
+    });
+    req.on('end', () => {
+      try {
+        const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        if (body === null || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+        resolve(body);
+      } catch {
+        reject(Object.assign(new Error('Invalid JSON'), { status: 400 }));
+      }
+    });
+    req.on('error', reject);
+  });
+}
+
+/** CSRF defence for state-changing requests: require a same-origin Origin header. */
+const sameOrigin = (req) => req.headers.origin === ORIGIN;
+
+// ---------------------------------------------------------------------------
+// API handlers
+// ---------------------------------------------------------------------------
+
+function handleNonce(req, res) {
+  if (rateLimited(req, 'nonce', 60)) return sendError(res, 429, 'rate_limited', 'Too many requests');
+  const session = getSession(req) || createSession(res);
+  session.nonce = { value: randomBytes(24).toString('base64url'), expires: Date.now() + NONCE_TTL_MS };
+  send(res, 200, { nonce: session.nonce.value });
+}
+
+async function handleVerifyEmail(req, res) {
+  if (!sameOrigin(req)) return sendError(res, 403, 'bad_origin', 'Cross-origin request rejected');
+  if (rateLimited(req, 'verify', 20)) return sendError(res, 429, 'rate_limited', 'Too many attempts, try again shortly');
+  const body = await readJson(req);
+  const session = getSession(req);
+  const nonce = session?.nonce;
+  if (!nonce || nonce.expires < Date.now()) {
+    return sendError(res, 400, 'bad_nonce', 'Verification session expired. Please reload and try again.');
+  }
+  // Nonces are single use, whether or not verification succeeds.
+  session.nonce = null;
+  session.verified = null;
+
+  try {
+    const { email, issuer } = await verifier.verify(body.presentationToken, { nonce: nonce.value });
+    session.verified = { email, issuer, expires: Date.now() + VERIFIED_TTL_MS };
+    send(res, 200, { email, issuer });
+  } catch (err) {
+    if (err instanceof EvpError) return sendError(res, 400, err.code, err.message);
+    throw err;
+  }
+}
+
+const clean = (v, max) => (typeof v === 'string' ? v.trim().slice(0, max) : '');
+
+async function handleSignup(req, res) {
+  if (!sameOrigin(req)) return sendError(res, 403, 'bad_origin', 'Cross-origin request rejected');
+  if (rateLimited(req, 'signup', 10)) return sendError(res, 429, 'rate_limited', 'Too many attempts, try again shortly');
+  const body = await readJson(req);
+
+  const name = clean(body.name, 80);
+  const email = parseEmail(clean(body.email, 254));
+  const birthday = clean(body.birthday, 5); // "MM-DD", optional – for a birthday drink
+  const marketing = body.marketing === true;
+
+  if (!name) return sendError(res, 400, 'invalid_name', 'Please enter your name.');
+  if (!email) return sendError(res, 400, 'invalid_email', 'Please enter a valid email address.');
+  if (birthday && !/^(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/.test(birthday)) {
+    return sendError(res, 400, 'invalid_birthday', 'Birthday must be MM-DD.');
+  }
+
+  const session = getSession(req);
+  const verified = session?.verified;
+  if (!verified || verified.expires < Date.now() || verified.email.toLowerCase() !== email.address.toLowerCase()) {
+    return sendError(res, 403, 'email_not_verified', 'Please verify your email address before joining.');
+  }
+
+  const all = await loadAccounts();
+  const key = verified.email.toLowerCase();
+  if (Object.hasOwn(all, key)) {
+    session.verified = null;
+    return sendError(res, 409, 'already_registered', 'This email already has a rewards account.');
+  }
+  all[key] = {
+    id: randomUUID(),
+    name,
+    email: verified.email,
+    emailVerified: true,
+    emailVerifiedBy: verified.issuer,
+    emailVerifiedAt: new Date().toISOString(),
+    birthday: birthday || null,
+    marketing,
+    points: WELCOME_POINTS,
+    createdAt: new Date().toISOString(),
+  };
+  session.verified = null;
+  await saveAccounts();
+  send(res, 201, { ok: true, name, points: WELCOME_POINTS });
+}
+
+const ROUTES = {
+  'GET /api/rewards/nonce': handleNonce,
+  'POST /api/rewards/verify-email': handleVerifyEmail,
+  'POST /api/rewards/signup': handleSignup,
+};
+
+// ---------------------------------------------------------------------------
+// Server
+// ---------------------------------------------------------------------------
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+    const handler = ROUTES[`${req.method} ${pathname}`];
+    if (handler) return await handler(req, res);
+    if (pathname.startsWith('/api/')) return sendError(res, 404, 'not_found', 'Not found');
+
+    const asset = STATIC[pathname];
+    if (asset && (req.method === 'GET' || req.method === 'HEAD')) {
+      const content = await readFile(path.join(ROOT, asset.file));
+      return send(res, 200, req.method === 'HEAD' ? '' : content, { 'Content-Type': asset.type });
+    }
+    send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  } catch (err) {
+    if (res.headersSent) return res.destroy();
+    if (err.status) return sendError(res, err.status, 'bad_request', err.message);
+    console.error(err);
+    sendError(res, 500, 'server_error', 'Something went wrong. Please try again.');
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind listening on ${ORIGIN} (port ${PORT})`));
diff --git a/test/evp-verify.test.mjs b/test/evp-verify.test.mjs
new file mode 100644
index 0000000..8223eae
--- /dev/null
+++ b/test/evp-verify.test.mjs
@@ -0,0 +1,130 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, sign } from 'node:crypto';
+import { createEmailVerifier, isPublicAddress, parseEmail } from '../lib/evp-verify.mjs';
+
+const AUD = 'https://dailygrind.example';
+const NONCE = 'n-0123456789abcdefghij';
+const NOW = 1_800_000_000;
+
+const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+const sha = (s) => createHash('sha256').update(s).digest('base64url');
+
+function jws(header, payload, privateKey) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  const sig = header.alg === 'ES256'
+    ? sign('sha256', Buffer.from(input), { key: privateKey, dsaEncoding: 'ieee-p1363' })
+    : sign(null, Buffer.from(input), privateKey);
+  return `${input}.${sig.toString('base64url')}`;
+}
+
+const issuerKeys = generateKeyPairSync('ed25519');
+const holderKeys = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', use: 'sig' };
+const holderJwk = holderKeys.publicKey.export({ format: 'jwk' });
+
+function makeToken({ claims = {}, kb = {}, issuerKey = issuerKeys.privateKey, header = {}, disclosures = [] } = {}) {
+  const sdJwt = jws(
+    { alg: 'EdDSA', kid: 'k1', typ: 'evp+sd-jwt', ...header },
+    { iss: 'issuer.example', iat: NOW - 5, cnf: { jwk: holderJwk }, email: 'Jane@Mail.Example', email_verified: true, ...claims },
+    issuerKey,
+  );
+  const presented = [sdJwt, ...disclosures].join('~') + '~';
+  const kbJwt = jws(
+    { alg: 'ES256', typ: 'kb+jwt' },
+    { aud: AUD, nonce: NONCE, iat: NOW, sd_hash: sha(presented), ...kb },
+    holderKeys.privateKey,
+  );
+  return presented + kbJwt;
+}
+
+function verifier(overrides = {}) {
+  const fetched = [];
+  const v = createEmailVerifier({
+    audience: AUD,
+    now: () => NOW,
+    resolveTxt: async (name) => {
+      if (name === '_email-verification.mail.example') return [['v=1'], ['iss=', 'issuer.example']];
+      throw Object.assign(new Error('ENOTFOUND'), { code: 'ENOTFOUND' });
+    },
+    fetchJson: async (url) => {
+      fetched.push(url);
+      if (url === 'https://issuer.example/.well-known/email-verification') {
+        return { issuance_endpoint: 'https://issuer.example/issue', jwks_uri: 'https://keys.issuer.example/jwks', signing_alg_values_supported: ['EdDSA'] };
+      }
+      if (url === 'https://keys.issuer.example/jwks') return { keys: [issuerJwk] };
+      throw new Error('404');
+    },
+    ...overrides,
+  });
+  return Object.assign(v, { fetched });
+}
+
+const rejects = (p, code) => assert.rejects(p, (e) => e.code === code);
+
+test('accepts a valid presentation and normalises the domain', async () => {
+  const result = await verifier().verify(makeToken(), { nonce: NONCE });
+  assert.deepEqual(result, { email: 'Jane@mail.example', issuer: 'issuer.example' });
+});
+
+test('accepts claims supplied as selective disclosures', async () => {
+  const d = Buffer.from(JSON.stringify(['salt123', 'email', 'jane@mail.example'])).toString('base64url');
+  const token = makeToken({ claims: { email: undefined, _sd: [sha(d), sha('decoy')], _sd_alg: 'sha-256' }, disclosures: [d] });
+  assert.equal((await verifier().verify(token, { nonce: NONCE })).email, 'jane@mail.example');
+});
+
+test('rejects wrong nonce, audience, stale tokens and bad sd_hash', async () => {
+  const v = verifier();
+  await rejects(v.verify(makeToken(), { nonce: 'other-nonce-123456789' }), 'bad_nonce');
+  await rejects(v.verify(makeToken({ kb: { aud: 'https://evil.example' } }), { nonce: NONCE }), 'wrong_audience');
+  await rejects(v.verify(makeToken({ kb: { iat: NOW - 3600 } }), { nonce: NONCE }), 'expired');
+  await rejects(v.verify(makeToken({ claims: { iat: NOW - 3600 } }), { nonce: NONCE }), 'expired');
+  await rejects(v.verify(makeToken({ kb: { sd_hash: 'nope' } }), { nonce: NONCE }), 'bad_claims');
+});
+
+test('rejects tokens signed by an untrusted issuer key', async () => {
+  const rogue = generateKeyPairSync('ed25519').privateKey;
+  await rejects(verifier().verify(makeToken({ issuerKey: rogue }), { nonce: NONCE }), 'bad_signature');
+});
+
+test('rejects issuers not authorised by the email domain DNS record', async () => {
+  const v = verifier();
+  await rejects(v.verify(makeToken({ claims: { iss: 'evil.example' } }), { nonce: NONCE }), 'wrong_issuer');
+  await rejects(v.verify(makeToken({ claims: { email: 'jane@other.example' } }), { nonce: NONCE }), 'no_issuer');
+});
+
+test('rejects unverified email and missing holder key', async () => {
+  const v = verifier();
+  await rejects(v.verify(makeToken({ claims: { email_verified: false } }), { nonce: NONCE }), 'bad_claims');
+  await rejects(v.verify(makeToken({ claims: { cnf: undefined } }), { nonce: NONCE }), 'bad_claims');
+});
+
+test('rejects alg confusion and tampered key binding', async () => {
+  const v = verifier();
+  await rejects(v.verify(makeToken({ header: { alg: 'none' } }), { nonce: NONCE }), 'unsupported_alg');
+  await rejects(v.verify(makeToken({ header: { alg: 'HS256' } }), { nonce: NONCE }), 'unsupported_alg');
+  const token = makeToken();
+  const kb = token.split('~').pop();
+  const [h, , s] = kb.split('.');
+  const forged = token.slice(0, -kb.length) + `${h}.${b64({ aud: AUD, nonce: 'x'.repeat(20), iat: NOW })}.${s}`;
+  await rejects(v.verify(forged, { nonce: 'x'.repeat(20) }), 'bad_signature');
+});
+
+test('rejects jwks hosted off the issuer domain', async () => {
+  const v = verifier({
+    fetchJson: async () => ({ jwks_uri: 'https://attacker.example/jwks' }),
+  });
+  await rejects(v.verify(makeToken(), { nonce: NONCE }), 'issuer_metadata');
+});
+
+test('helpers', () => {
+  assert.equal(parseEmail('a@127.0.0.1'), null);
+  assert.equal(parseEmail('no-at-sign'), null);
+  assert.equal(parseEmail('x@Bücher.example').domain, 'xn--bcher-kva.example');
+  assert.equal(isPublicAddress('10.1.2.3', 4), false);
+  assert.equal(isPublicAddress('169.254.169.254', 4), false);
+  assert.equal(isPublicAddress('::1', 6), false);
+  assert.equal(isPublicAddress('::ffff:10.0.0.1', 6), false);
+  assert.equal(isPublicAddress('8.8.8.8', 4), true);
+  assert.equal(isPublicAddress('2606:4700::1111', 6), true);
+});
