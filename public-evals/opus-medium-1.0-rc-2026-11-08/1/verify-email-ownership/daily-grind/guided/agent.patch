diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..eea7614
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,264 @@
+// The Daily Grind web server.
+//
+// Serves the homepage with a fresh per-render Email Verification nonce and
+// handles rewards sign-ups at POST /api/rewards/signup.
+//
+// Environment:
+//   PORT                 Port to listen on (default 11222)
+//   RP_ORIGIN            Public origin of this site, used as the KB-JWT audience
+//                        (default http://localhost:$PORT)
+//   ORIGIN_TRIAL_TOKEN   Chrome Email Verification origin trial token
+
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, randomUUID, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './lib/email-verification.mjs';
+
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+
+const SESSION_COOKIE = 'dg_sid';
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const MAX_BODY_BYTES = 16 * 1024;
+
+const scryptAsync = promisify(scrypt);
+const indexTemplate = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+
+// ---------------------------------------------------------------------------
+// Server-side session state. Replace with a shared store (e.g. Redis) when
+// running more than one instance; nonce consumption must stay atomic.
+// ---------------------------------------------------------------------------
+
+const sessions = new Map(); // sid -> { nonce, flash, expiresAt }
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, session] of sessions) {
+    if (session.expiresAt < now) sessions.delete(sid);
+  }
+}, 60 * 1000).unref();
+
+function parseCookies(header = '') {
+  const cookies = {};
+  for (const part of header.split(';')) {
+    const idx = part.indexOf('=');
+    if (idx > 0) cookies[part.slice(0, idx).trim()] = decodeURIComponent(part.slice(idx + 1).trim());
+  }
+  return cookies;
+}
+
+function getSession(req, res) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  let session = sid && sessions.get(sid);
+  if (session && session.expiresAt >= Date.now()) {
+    session.expiresAt = Date.now() + SESSION_TTL_MS;
+    return session;
+  }
+  const newSid = randomBytes(32).toString('base64url');
+  session = { nonce: null, flash: null, expiresAt: Date.now() + SESSION_TTL_MS };
+  sessions.set(newSid, session);
+  res.setHeader(
+    'Set-Cookie',
+    `${SESSION_COOKIE}=${newSid}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${SESSION_TTL_MS / 1000}`,
+  );
+  return session;
+}
+
+// Read-and-delete in a single synchronous step so a nonce can only be used once.
+function consumeNonce(session) {
+  const nonce = session.nonce;
+  session.nonce = null;
+  return nonce;
+}
+
+// ---------------------------------------------------------------------------
+// Accounts. In-memory for now; swap for the real customer database.
+// ---------------------------------------------------------------------------
+
+const accounts = new Map(); // lower-cased email -> account
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const hash = await scryptAsync(password, salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${hash.toString('base64url')}`;
+}
+
+async function sendTraditionalVerificationEmail(account) {
+  // Hook up the transactional email provider here.
+  console.log(`[rewards] Sending verification link to ${account.email} (account ${account.id})`);
+}
+
+// ---------------------------------------------------------------------------
+// HTTP helpers
+// ---------------------------------------------------------------------------
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8', ...headers });
+  res.end(body);
+}
+
+function redirectWithFlash(res, session, flash) {
+  session.flash = flash;
+  res.writeHead(303, { Location: '/#join', 'Cache-Control': 'no-store' });
+  res.end();
+}
+
+// ---------------------------------------------------------------------------
+// Routes
+// ---------------------------------------------------------------------------
+
+function renderStatus(flash) {
+  if (!flash) return '';
+  return `<p class="signup-status signup-status--${flash.type}">${escapeHtml(flash.message)}</p>`;
+}
+
+function handleHome(req, res) {
+  const session = getSession(req, res);
+  // Fresh nonce per render (at least 128 bits), kept only server-side.
+  session.nonce = randomBytes(32).toString('base64url');
+  const flash = session.flash;
+  session.flash = null;
+
+  const html = indexTemplate
+    .replace('{{EVP_NONCE}}', session.nonce)
+    .replace('{{SIGNUP_STATUS}}', renderStatus(flash));
+
+  const headers = {
+    'Content-Type': 'text/html; charset=utf-8',
+    // Back/forward navigation must not reuse an already-consumed nonce.
+    'Cache-Control': 'no-store',
+  };
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(req.method === 'HEAD' ? undefined : html);
+}
+
+const NAME_MAX = 100;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const PASSWORD_RE = /^(?=.*\d)(?=.*\p{Ll})(?=.*\p{Lu}).{8,128}$/u;
+
+async function handleSignup(req, res) {
+  // Basic CSRF protection on top of SameSite=Lax cookies.
+  const origin = req.headers.origin;
+  if (origin && origin !== RP_ORIGIN) return send(res, 403, 'Forbidden');
+  if (!String(req.headers['content-type'] || '').startsWith('application/x-www-form-urlencoded')) {
+    return send(res, 415, 'Unsupported Media Type');
+  }
+
+  const session = getSession(req, res);
+  // Consume the nonce before anything else so a token can never be replayed.
+  const expectedNonce = consumeNonce(session);
+
+  const form = new URLSearchParams(await readBody(req));
+  const name = String(form.get('name') || '').trim();
+  const email = String(form.get('email') || '').trim();
+  const password = String(form.get('new-password') || '');
+  const rawToken = String(form.get('email-verification-token') || '').trim();
+
+  if (!name || name.length > NAME_MAX || !EMAIL_RE.test(email) || email.length > 254 || !PASSWORD_RE.test(password)) {
+    return redirectWithFlash(res, session, {
+      type: 'error',
+      message: 'Please check your details: enter your name, a valid email, and a password that meets the requirements.',
+    });
+  }
+
+  const key = email.toLowerCase();
+  if (accounts.has(key)) {
+    return redirectWithFlash(res, session, {
+      type: 'error',
+      message: 'There is already a rewards account for that email. Try signing in instead.',
+    });
+  }
+
+  let emailVerified = false;
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: email,
+        expectedNonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      emailVerified = true;
+    } catch (err) {
+      console.error('[rewards] Email verification token check failed:', err?.message || err);
+    }
+  }
+
+  const account = {
+    id: randomUUID(),
+    name,
+    email,
+    passwordHash: await hashPassword(password),
+    emailVerified,
+    createdAt: new Date().toISOString(),
+  };
+  // Re-check after the async work above in case of a concurrent sign-up.
+  if (accounts.has(key)) {
+    return redirectWithFlash(res, session, {
+      type: 'error',
+      message: 'There is already a rewards account for that email. Try signing in instead.',
+    });
+  }
+  accounts.set(key, account);
+
+  if (emailVerified) {
+    return redirectWithFlash(res, session, {
+      type: 'success',
+      message: `Welcome to Daily Grind Rewards, ${name}! Your email is confirmed and your first free drink is waiting.`,
+    });
+  }
+
+  // Fallback: no token (unsupported browser, non-participating provider) or
+  // verification failed. Never block sign-up; send the usual email instead.
+  await sendTraditionalVerificationEmail(account);
+  return redirectWithFlash(res, session, {
+    type: 'pending',
+    message: `Almost there, ${name}! We sent a confirmation link to ${email}. Open it to activate your rewards.`,
+  });
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+    if (pathname === '/' || pathname === '/index.html') {
+      if (req.method === 'GET' || req.method === 'HEAD') return handleHome(req, res);
+      return send(res, 405, 'Method Not Allowed', { Allow: 'GET, HEAD' });
+    }
+    if (pathname === '/api/rewards/signup') {
+      if (req.method === 'POST') return await handleSignup(req, res);
+      return send(res, 405, 'Method Not Allowed', { Allow: 'POST' });
+    }
+    send(res, 404, 'Not Found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) send(res, err.status || 500, err.status === 413 ? 'Payload Too Large' : 'Internal Server Error');
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on ${RP_ORIGIN}`);
+});
