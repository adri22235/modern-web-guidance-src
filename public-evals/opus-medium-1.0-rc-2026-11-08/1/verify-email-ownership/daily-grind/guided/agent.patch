diff --git a/lib/email-verification.mjs b/lib/email-verification.mjs
new file mode 100644
index 0000000..64d0df1
--- /dev/null
+++ b/lib/email-verification.mjs
@@ -0,0 +1,150 @@
+// Server-side verification of Email Verification Protocol (EVP) tokens.
+//
+// The browser submits `EVT~KB-JWT` (an SD-JWT presentation) in the hidden
+// `autocomplete="email-verification-token"` field. Everything here must pass
+// before we treat the submitted email address as verified; any failure throws
+// and the caller falls back to a traditional verification email.
+
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const NETWORK_TIMEOUT_MS = 5000;
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Cache JWKS fetchers per issuer so key sets are reused between sign-ups.
+const jwksCache = new Map();
+
+async function loadIssuerJwks(iss, submittedEmail) {
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  if (!domain) throw new Error('Submitted email has no domain.');
+
+  // The email domain must delegate authority to this exact issuer via DNS
+  // before we make any network request to `iss`.
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  const delegated = txtRecords.some(
+    (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss,
+  );
+  if (!delegated) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const cached = jwksCache.get(iss);
+  if (cached) return cached;
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') throw new Error('Issuer must use HTTPS.');
+  const res = await fetch(discoveryUrl, {
+    redirect: 'error',
+    signal: AbortSignal.timeout(NETWORK_TIMEOUT_MS),
+  });
+  if (!res.ok) throw new Error(`Issuer metadata request failed (${res.status}).`);
+  const metadata = await res.json();
+  if (metadata.issuer !== iss || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const jwks = createRemoteJWKSet(new URL(metadata.jwks_uri), { timeoutDuration: NETWORK_TIMEOUT_MS });
+  jwksCache.set(iss, jwks);
+  return jwks;
+}
+
+/**
+ * Verifies an `EVT~KB-JWT` presentation. Resolves with the verified email
+ * claim, or throws if any check fails.
+ */
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }) {
+  if (!expectedNonce) throw new Error('No unconsumed nonce for this session.');
+
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload ?? {};
+  const iss = evtPayload.iss;
+  if (!decoded.kbJwt || typeof iss !== 'string' || !iss) {
+    throw new Error('Missing KB-JWT or issuer claim.');
+  }
+
+  const issuerJwks = await loadIssuerJwks(iss, submittedEmail);
+
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // Some issuers (e.g. Gmail) omit `kid`; when several JWKS keys match,
+        // jose throws an error that iterates over each candidate key.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header?.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  // Passing keyBindingNonce makes @sd-jwt/core run kbVerifier and check the
+  // KB-JWT nonce, aud, iat and sd_hash.
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  // Check against the verified claims (including any selectively disclosed
+  // ones) rather than the raw, pre-verification payload.
+  const claims = verified.payload ?? {};
+  if (claims.email_verified !== true) throw new Error('email_verified is not true.');
+  if (typeof claims.email !== 'string' || claims.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+  return claims.email;
+}
