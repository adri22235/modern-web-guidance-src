diff --git a/flavor-worker.js b/flavor-worker.js
new file mode 100644
--- a/flavor-worker.js
+++ b/flavor-worker.js
@@ -0,0 +1,151 @@
+// Coffee flavor profile simulation worker.
+// Runs off the main thread so the page stays responsive while a large batch
+// of recipe blends is generated and scored.
+
+const ATTRIBUTES = ['acidity', 'sweetness', 'body', 'bitterness', 'fruity', 'nutty', 'chocolate', 'floral'];
+
+// Baseline flavor vectors (0-10) per origin, in ATTRIBUTES order.
+const ORIGINS = [
+  { name: 'Ethiopia Yirgacheffe', profile: [8.5, 6.5, 4.0, 3.0, 8.5, 2.5, 3.0, 9.0] },
+  { name: 'Colombia Huila', profile: [6.5, 7.0, 6.0, 4.0, 6.0, 5.5, 6.0, 4.0] },
+  { name: 'Brazil Cerrado', profile: [3.5, 7.0, 7.0, 4.5, 3.0, 8.5, 8.0, 2.0] },
+  { name: 'Sumatra Mandheling', profile: [2.5, 5.0, 9.0, 6.0, 2.5, 5.0, 6.5, 1.5] },
+  { name: 'Kenya AA', profile: [9.0, 6.0, 5.5, 3.5, 9.0, 2.5, 3.5, 6.5] },
+  { name: 'Guatemala Antigua', profile: [6.0, 6.5, 6.5, 4.5, 5.0, 6.0, 7.5, 3.5] },
+  { name: 'Costa Rica Tarrazú', profile: [7.5, 7.0, 5.5, 3.5, 6.5, 4.5, 5.0, 5.0] },
+  { name: 'Panama Geisha', profile: [8.0, 8.0, 4.0, 2.5, 8.0, 2.0, 2.5, 9.5] }
+];
+
+// Additive shifts per roast level.
+const ROASTS = {
+  light: [1.5, -0.5, -1.0, -1.0, 1.0, -0.5, -1.0, 1.5],
+  medium: [0, 0.5, 0.5, 0, 0, 0.5, 0.5, 0],
+  dark: [-2.0, -0.5, 1.5, 2.5, -1.5, 1.0, 1.5, -2.0]
+};
+
+// Multiplicative extraction factors per brew method.
+const BREWS = {
+  espresso: [1.1, 1.0, 1.4, 1.2, 1.0, 1.0, 1.1, 0.8],
+  pourover: [1.15, 1.0, 0.8, 0.9, 1.15, 0.95, 0.9, 1.2],
+  frenchpress: [0.85, 1.0, 1.3, 1.05, 0.9, 1.1, 1.15, 0.85],
+  coldbrew: [0.6, 1.2, 1.0, 0.7, 0.9, 1.05, 1.15, 0.8]
+};
+
+const TOP_N = 5;
+const HISTOGRAM_BINS = 10;
+
+// Small seeded PRNG so a given seed reproduces the same batch.
+function mulberry32(seed) {
+  let a = seed >>> 0;
+  return function () {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function clamp(v) {
+  return v < 0 ? 0 : v > 10 ? 10 : v;
+}
+
+// Balance score (0-100): rewards sweetness and complexity, penalizes harsh
+// bitterness and attributes that are far from the target profile.
+function scoreProfile(p, target) {
+  let distance = 0;
+  for (let i = 0; i < p.length; i++) {
+    const d = p[i] - target[i];
+    distance += d * d;
+  }
+  distance = Math.sqrt(distance);
+  const harshness = Math.max(0, p[3] - 6) * 2;
+  const raw = 100 - distance * 10 - harshness + (p[1] - 5) * 2;
+  return raw < 0 ? 0 : raw > 100 ? 100 : raw;
+}
+
+function simulate({ count, roast, brew, seed, target }) {
+  const rand = mulberry32(seed);
+  const roastShift = ROASTS[roast];
+  const brewFactor = BREWS[brew];
+  const nAttr = ATTRIBUTES.length;
+
+  const sums = new Float64Array(nAttr);
+  const histogram = new Array(HISTOGRAM_BINS).fill(0);
+  let top = [];
+  let scoreSum = 0;
+  const profile = new Float64Array(nAttr);
+  const progressEvery = Math.max(1, Math.floor(count / 100));
+  const startedAt = performance.now();
+
+  for (let n = 0; n < count; n++) {
+    // Pick 2-4 distinct origins with random ratios.
+    const k = 2 + Math.floor(rand() * 3);
+    const picks = [];
+    while (picks.length < k) {
+      const idx = Math.floor(rand() * ORIGINS.length);
+      if (picks.indexOf(idx) === -1) picks.push(idx);
+    }
+    const weights = picks.map(() => 0.1 + rand());
+    const total = weights.reduce((a, b) => a + b, 0);
+
+    profile.fill(0);
+    for (let j = 0; j < k; j++) {
+      const w = weights[j] / total;
+      const base = ORIGINS[picks[j]].profile;
+      for (let i = 0; i < nAttr; i++) profile[i] += base[i] * w;
+    }
+
+    // Roast, brew, and per-batch variability (bean lot, grind, water).
+    for (let i = 0; i < nAttr; i++) {
+      const noise = (rand() - 0.5) * 1.2;
+      profile[i] = clamp((profile[i] + roastShift[i]) * brewFactor[i] + noise);
+      sums[i] += profile[i];
+    }
+
+    const score = scoreProfile(profile, target);
+    scoreSum += score;
+    histogram[Math.min(HISTOGRAM_BINS - 1, Math.floor(score / (100 / HISTOGRAM_BINS)))]++;
+
+    if (top.length < TOP_N || score > top[top.length - 1].score) {
+      top.push({
+        id: n + 1,
+        score,
+        components: picks.map((idx, j) => ({
+          origin: ORIGINS[idx].name,
+          pct: Math.round((weights[j] / total) * 100)
+        })).sort((a, b) => b.pct - a.pct),
+        profile: Array.from(profile, (v) => Math.round(v * 10) / 10)
+      });
+      top.sort((a, b) => b.score - a.score);
+      if (top.length > TOP_N) top.length = TOP_N;
+    }
+
+    if ((n + 1) % progressEvery === 0 || n + 1 === count) {
+      self.postMessage({ type: 'progress', done: n + 1, total: count });
+    }
+  }
+
+  const averages = {};
+  ATTRIBUTES.forEach((a, i) => { averages[a] = sums[i] / count; });
+
+  return {
+    count,
+    averages,
+    averageScore: scoreSum / count,
+    histogram,
+    top,
+    elapsedMs: performance.now() - startedAt
+  };
+}
+
+self.onmessage = (e) => {
+  const msg = e.data;
+  if (msg.type !== 'start') return;
+  try {
+    const result = simulate(msg.options);
+    self.postMessage({ type: 'done', result });
+  } catch (err) {
+    self.postMessage({ type: 'error', message: err && err.message ? err.message : String(err) });
+  }
+};
