+
+    /* Decorative text lines
+       Each .deco element draws a real text decoration (underline, overline or
+       line-through) that starts hidden and is "revealed" by transitioning its
+       color, vertical offset and horizontal end insets. Ink skipping keeps the
+       line from cutting through descenders (p, g, y...). Components tune the
+       look through the --deco-* custom properties. */
+    .deco {
+      --deco-line: underline;
+      --deco-style: solid;
+      --deco-color: var(--accent);
+      --deco-thickness: 2px;
+      --deco-offset: 0.25em;
+      --deco-offset-hidden: 0.6em;
+      --deco-inset: 0.1em;
+      --deco-inset-hidden: 1.25em;
+      --deco-duration: 0.4s;
+      --deco-ease: cubic-bezier(0.22, 1, 0.36, 1);
+
+      text-decoration-line: var(--deco-line);
+      text-decoration-style: var(--deco-style);
+      text-decoration-thickness: var(--deco-thickness);
+      text-decoration-color: transparent;
+      text-decoration-skip-ink: auto;
+      text-underline-offset: var(--deco-offset-hidden);
+      text-decoration-inset: var(--deco-inset-hidden);
+      transition:
+        color 0.3s,
+        text-decoration-color var(--deco-duration) var(--deco-ease),
+        text-underline-offset var(--deco-duration) var(--deco-ease),
+        text-decoration-inset var(--deco-duration) var(--deco-ease);
+    }
+
+    .deco:hover,
+    .deco:focus-visible,
+    .deco.is-revealed {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: var(--deco-offset);
+      text-decoration-inset: var(--deco-inset);
+    }
+
+    @keyframes deco-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-underline-offset: var(--deco-offset-hidden);
+        text-decoration-inset: var(--deco-inset-hidden);
+      }
+
+      to {
+        text-decoration-color: var(--deco-color);
+        text-underline-offset: var(--deco-offset);
+        text-decoration-inset: var(--deco-inset);
+      }
+    }
+
+    /* Nav: underline that rises into place */
+    nav a.deco {
+      --deco-offset: 0.3em;
+      --deco-offset-hidden: 0.75em;
+      --deco-inset: 0.05em;
+      --deco-inset-hidden: 1em;
+    }
+
+    nav a.deco:hover,
+    nav a.deco:focus-visible {
+      color: var(--accent);
+    }
+
+    /* Logout: strikethrough that grows from the center */
+    nav a.logout-link.deco {
+      --deco-line: line-through;
+      --deco-color: var(--light);
+      --deco-thickness: 1.5px;
+      --deco-inset: 0.15em;
+      --deco-inset-hidden: 2em;
+    }
+
+    /* Section heading: thick underline revealed on page load */
+    .section-title.deco {
+      --deco-thickness: 0.12em;
+      --deco-offset: 0.15em;
+      --deco-offset-hidden: 0.55em;
+      --deco-inset: 0.2em;
+      --deco-inset-hidden: 4em;
+      --deco-duration: 0.9s;
+      animation: deco-reveal var(--deco-duration) var(--deco-ease) 0.3s both;
+    }
+
+    /* Card titles: underline revealed when the card is hovered or focused */
+    .card h3.deco {
+      --deco-thickness: 3px;
+      --deco-offset: 0.2em;
+      --deco-offset-hidden: 0.65em;
+      --deco-inset: 0.3em;
+      --deco-inset-hidden: 2.5em;
+      --deco-duration: 0.5s;
+    }
+
+    .card:hover h3.deco,
+    .card:focus-within h3.deco {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: var(--deco-offset);
+      text-decoration-inset: var(--deco-inset);
+    }
+
+    /* Footer: dotted overline + underline pair that closes in on the text */
+    .footer-links a.deco {
+      --deco-line: underline overline;
+      --deco-style: dotted;
+      --deco-color: var(--primary);
+      --deco-thickness: 1.5px;
+      --deco-offset: 0.2em;
+      --deco-offset-hidden: 0.5em;
+      --deco-inset: 0;
+      --deco-inset-hidden: 1.5em;
+    }
+
+    .footer-links a.deco:hover,
+    .footer-links a.deco:focus-visible {
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .deco {
+        transition: color 0.3s, text-decoration-color 0.2s linear;
+      }
+
+      .section-title.deco {
+        animation: none;
+        text-decoration-color: var(--deco-color);
+        text-underline-offset: var(--deco-offset);
+        text-decoration-inset: var(--deco-inset);
+      }
+    }
   </style>
