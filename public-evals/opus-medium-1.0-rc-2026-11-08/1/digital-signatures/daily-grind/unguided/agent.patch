--- /dev/null
+++ b/js/signing.js
@@ -0,0 +1,424 @@
+// Browser-side signing primitives for Daily Grind receipts and gift vouchers.
+//
+// Supported algorithms:
+//   - ECDSA P-256 / SHA-256 (WebCrypto, classical)
+//   - Ed25519               (WebCrypto, classical; feature-detected)
+//   - ML-DSA-65             (FIPS 204, quantum-resistant; @noble/post-quantum, loaded on demand)
+//
+// A signed document ("envelope") embeds the signer's public key and a key id
+// (SHA-256 fingerprint). A valid signature proves integrity; authenticity is only
+// established when the key id is in the verifier's trusted key list.
+
+const ML_DSA_MODULE_URL = 'https://esm.sh/@noble/post-quantum@0.2.1/ml-dsa';
+const DOMAIN_TAG = 'DailyGrind-Signed-Document-v1\n';
+export const TOKEN_PREFIX = 'DGSIG1.';
+export const ENVELOPE_VERSION = 1;
+export const DOCUMENT_TYPES = ['receipt', 'voucher'];
+
+export const ALGORITHMS = {
+  'ECDSA-P256': { label: 'ECDSA P-256 (classical)', family: 'classical', sigLen: 64 },
+  'Ed25519': { label: 'Ed25519 (classical)', family: 'classical', sigLen: 64 },
+  'ML-DSA-65': { label: 'ML-DSA-65 (quantum-resistant, FIPS 204)', family: 'post-quantum', sigLen: 3309 },
+};
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+// ---------- encoding helpers ----------
+
+export function toB64url(bytes) {
+  let bin = '';
+  const chunk = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunk) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function fromB64url(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url data');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+const toHex = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+// Deterministic JSON: sorted object keys, no whitespace, integers only.
+export function canonicalJSON(value) {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isSafeInteger(value)) throw new Error('Only safe integers may be signed');
+    return String(value);
+  }
+  if (Array.isArray(value)) return '[' + value.map(canonicalJSON).join(',') + ']';
+  if (typeof value === 'object') {
+    return '{' + Object.keys(value).sort()
+      .filter((k) => value[k] !== undefined)
+      .map((k) => JSON.stringify(k) + ':' + canonicalJSON(value[k]))
+      .join(',') + '}';
+  }
+  throw new Error('Unsupported value in signed document');
+}
+
+// ---------- algorithm backends ----------
+
+let mlDsaPromise = null;
+function loadMlDsa() {
+  if (!mlDsaPromise) {
+    mlDsaPromise = import(ML_DSA_MODULE_URL)
+      .then((m) => m.ml_dsa65)
+      .catch((err) => {
+        mlDsaPromise = null;
+        throw new Error('Could not load the ML-DSA library: ' + err.message);
+      });
+  }
+  return mlDsaPromise;
+}
+
+let ed25519Support = null;
+async function hasEd25519() {
+  if (ed25519Support === null) {
+    try {
+      await crypto.subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+      ed25519Support = true;
+    } catch {
+      ed25519Support = false;
+    }
+  }
+  return ed25519Support;
+}
+
+export async function isSupported(alg) {
+  if (!globalThis.crypto?.subtle) return false;
+  if (alg === 'Ed25519') return hasEd25519();
+  return alg in ALGORITHMS;
+}
+
+const ECDSA_GEN = { name: 'ECDSA', namedCurve: 'P-256' };
+const ECDSA_SIGN = { name: 'ECDSA', hash: 'SHA-256' };
+
+// Returns { alg, publicKey: Uint8Array, privateKey: CryptoKey | Uint8Array }.
+// WebCrypto private keys are generated non-extractable.
+export async function generateKeyPair(alg) {
+  if (alg === 'ECDSA-P256') {
+    const kp = await crypto.subtle.generateKey(ECDSA_GEN, false, ['sign', 'verify']);
+    const spki = new Uint8Array(await crypto.subtle.exportKey('spki', kp.publicKey));
+    return { alg, publicKey: spki, privateKey: kp.privateKey };
+  }
+  if (alg === 'Ed25519') {
+    if (!(await hasEd25519())) throw new Error('Ed25519 is not supported by this browser');
+    const kp = await crypto.subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+    const raw = new Uint8Array(await crypto.subtle.exportKey('raw', kp.publicKey));
+    return { alg, publicKey: raw, privateKey: kp.privateKey };
+  }
+  if (alg === 'ML-DSA-65') {
+    const mlDsa = await loadMlDsa();
+    const seed = crypto.getRandomValues(new Uint8Array(32));
+    const { publicKey, secretKey } = mlDsa.keygen(seed);
+    seed.fill(0);
+    return { alg, publicKey, privateKey: secretKey };
+  }
+  throw new Error('Unknown algorithm: ' + alg);
+}
+
+async function signBytes(alg, privateKey, data) {
+  if (alg === 'ECDSA-P256') {
+    return new Uint8Array(await crypto.subtle.sign(ECDSA_SIGN, privateKey, data));
+  }
+  if (alg === 'Ed25519') {
+    return new Uint8Array(await crypto.subtle.sign({ name: 'Ed25519' }, privateKey, data));
+  }
+  if (alg === 'ML-DSA-65') {
+    const mlDsa = await loadMlDsa();
+    return mlDsa.sign(privateKey, data);
+  }
+  throw new Error('Unknown algorithm: ' + alg);
+}
+
+async function verifyBytes(alg, publicKey, data, signature) {
+  if (signature.length !== ALGORITHMS[alg].sigLen) return false;
+  try {
+    if (alg === 'ECDSA-P256') {
+      const key = await crypto.subtle.importKey('spki', publicKey, ECDSA_GEN, false, ['verify']);
+      return await crypto.subtle.verify(ECDSA_SIGN, key, signature, data);
+    }
+    if (alg === 'Ed25519') {
+      if (!(await hasEd25519())) throw new Error('Ed25519 is not supported by this browser');
+      const key = await crypto.subtle.importKey('raw', publicKey, { name: 'Ed25519' }, false, ['verify']);
+      return await crypto.subtle.verify({ name: 'Ed25519' }, key, signature, data);
+    }
+    if (alg === 'ML-DSA-65') {
+      const mlDsa = await loadMlDsa();
+      return mlDsa.verify(publicKey, data, signature);
+    }
+  } catch (err) {
+    if (/not supported|load the ML-DSA/.test(err.message)) throw err;
+    return false; // malformed key or signature
+  }
+  return false;
+}
+
+// Key id: first 16 bytes of SHA-256(alg || 0x00 || publicKey), hex-encoded.
+export async function keyId(alg, publicKey) {
+  const algBytes = enc.encode(alg);
+  const buf = new Uint8Array(algBytes.length + 1 + publicKey.length);
+  buf.set(algBytes, 0);
+  buf.set(publicKey, algBytes.length + 1);
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', buf));
+  return toHex(digest.subarray(0, 16));
+}
+
+export const formatKeyId = (kid) => kid.match(/.{1,4}/g).join(' ').toUpperCase();
+
+// ---------- envelopes ----------
+
+function signedBytes({ v, type, alg, kid, publicKey, payload }) {
+  return enc.encode(DOMAIN_TAG + canonicalJSON({ v, type, alg, kid, publicKey, payload }));
+}
+
+export async function signDocument(key, type, payload) {
+  if (!DOCUMENT_TYPES.includes(type)) throw new Error('Unknown document type');
+  const body = {
+    v: ENVELOPE_VERSION,
+    type,
+    alg: key.alg,
+    kid: key.kid,
+    publicKey: toB64url(key.publicKey),
+    payload,
+  };
+  const signature = await signBytes(key.alg, key.privateKey, signedBytes(body));
+  return { ...body, signature: toB64url(signature) };
+}
+
+export function encodeToken(envelope) {
+  return TOKEN_PREFIX + toB64url(enc.encode(JSON.stringify(envelope)));
+}
+
+// Accepts a DGSIG1 token or the raw envelope JSON.
+export function decodeToken(text) {
+  const trimmed = String(text || '').trim();
+  if (!trimmed) throw new Error('Nothing to verify — paste a token or load a file.');
+  if (trimmed.length > 100000) throw new Error('Input is too large.');
+  let json;
+  if (trimmed.startsWith('{')) {
+    json = trimmed;
+  } else if (trimmed.startsWith(TOKEN_PREFIX)) {
+    json = dec.decode(fromB64url(trimmed.slice(TOKEN_PREFIX.length).replace(/\s+/g, '')));
+  } else {
+    throw new Error('Unrecognised format — expected a token starting with ' + TOKEN_PREFIX);
+  }
+  try {
+    return JSON.parse(json);
+  } catch {
+    throw new Error('Document is not valid JSON.');
+  }
+}
+
+function isPlainObject(x) {
+  return x !== null && typeof x === 'object' && !Array.isArray(x);
+}
+
+// Verifies an envelope. `trustedKids` is a Set of key ids considered authentic.
+// Returns { status: 'authentic' | 'untrusted' | 'invalid', reasons: string[], envelope, warnings: string[] }.
+export async function verifyDocument(envelope, trustedKids) {
+  const fail = (reason) => ({ status: 'invalid', reasons: [reason], warnings: [], envelope });
+
+  if (!isPlainObject(envelope)) return fail('Document is not an object.');
+  const { v, type, alg, kid, publicKey, payload, signature } = envelope;
+  const allowed = ['v', 'type', 'alg', 'kid', 'publicKey', 'payload', 'signature'];
+  if (Object.keys(envelope).some((k) => !allowed.includes(k))) return fail('Document contains unexpected fields.');
+  if (v !== ENVELOPE_VERSION) return fail('Unsupported document version.');
+  if (!DOCUMENT_TYPES.includes(type)) return fail('Unknown document type.');
+  if (!Object.prototype.hasOwnProperty.call(ALGORITHMS, alg)) return fail('Unknown signature algorithm.');
+  if (typeof kid !== 'string' || typeof publicKey !== 'string' || typeof signature !== 'string') {
+    return fail('Missing key or signature fields.');
+  }
+  if (!isPlainObject(payload) || payload.kind !== type) return fail('Payload does not match document type.');
+
+  let pkBytes, sigBytes;
+  try {
+    pkBytes = fromB64url(publicKey);
+    sigBytes = fromB64url(signature);
+  } catch {
+    return fail('Public key or signature is not valid base64url.');
+  }
+
+  if ((await keyId(alg, pkBytes)) !== kid) return fail('Key id does not match the embedded public key.');
+
+  let data;
+  try {
+    data = signedBytes({ v, type, alg, kid, publicKey, payload });
+  } catch (err) {
+    return fail('Payload cannot be canonicalised: ' + err.message);
+  }
+
+  const ok = await verifyBytes(alg, pkBytes, data, sigBytes);
+  if (!ok) return fail('Signature does not match — the document was altered or signed with a different key.');
+
+  const warnings = checkPayload(type, payload);
+  if (!trustedKids.has(kid)) {
+    return {
+      status: 'untrusted',
+      reasons: ['Signature is mathematically valid, but the signing key is not in your trusted key list.'],
+      warnings,
+      envelope,
+    };
+  }
+  return { status: 'authentic', reasons: ['Signature is valid and was made by a trusted Daily Grind key.'], warnings, envelope };
+}
+
+// Business-rule checks that don't affect cryptographic validity.
+function checkPayload(type, p) {
+  const warnings = [];
+  if (type === 'receipt') {
+    const items = Array.isArray(p.items) ? p.items : [];
+    const subtotal = items.reduce((s, it) => s + (it.qty | 0) * (it.unitCents | 0), 0);
+    if (subtotal !== p.subtotalCents) warnings.push('Item lines do not add up to the subtotal.');
+    if (p.subtotalCents + p.taxCents !== p.totalCents) warnings.push('Subtotal plus tax does not equal the total.');
+  } else if (type === 'voucher') {
+    const exp = Date.parse(p.expiresAt);
+    if (Number.isNaN(exp)) warnings.push('Voucher has no valid expiry date.');
+    else if (exp < Date.now()) warnings.push('Voucher has expired.');
+  }
+  const issued = Date.parse(p.issuedAt);
+  if (!Number.isNaN(issued) && issued > Date.now() + 5 * 60 * 1000) warnings.push('Issue date is in the future.');
+  return warnings;
+}
+
+// ---------- persistent key storage (IndexedDB) ----------
+//
+// WebCrypto private keys are stored as non-extractable CryptoKey objects.
+// ML-DSA secret keys are raw bytes, so they are encrypted at rest with a
+// non-extractable AES-GCM wrapping key that also lives in IndexedDB.
+
+const DB_NAME = 'daily-grind-signing';
+const DB_STORE = 'keys';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(DB_STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function dbOp(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(DB_STORE, mode);
+      const req = fn(tx.objectStore(DB_STORE));
+      tx.oncomplete = () => resolve(req?.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+const dbGet = (k) => dbOp('readonly', (s) => s.get(k));
+const dbPut = (k, v) => dbOp('readwrite', (s) => s.put(v, k));
+const dbDelete = (k) => dbOp('readwrite', (s) => s.delete(k));
+
+async function getWrappingKey() {
+  let wk = await dbGet('wrapping-key');
+  if (!wk) {
+    wk = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+    await dbPut('wrapping-key', wk);
+  }
+  return wk;
+}
+
+export async function saveSigningKey(key) {
+  const record = { alg: key.alg, kid: key.kid, publicKey: key.publicKey, createdAt: key.createdAt };
+  if (key.privateKey instanceof Uint8Array) {
+    const wk = await getWrappingKey();
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, wk, key.privateKey);
+    record.wrappedPrivateKey = { iv, ct: new Uint8Array(ct) };
+  } else {
+    record.privateKey = key.privateKey;
+  }
+  await dbPut('active-signing-key', record);
+}
+
+export async function loadSigningKey() {
+  const record = await dbGet('active-signing-key');
+  if (!record) return null;
+  let privateKey = record.privateKey;
+  if (record.wrappedPrivateKey) {
+    const wk = await getWrappingKey();
+    const { iv, ct } = record.wrappedPrivateKey;
+    privateKey = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, wk, ct));
+  }
+  return { alg: record.alg, kid: record.kid, publicKey: record.publicKey, createdAt: record.createdAt, privateKey };
+}
+
+export const deleteSigningKey = () => dbDelete('active-signing-key');
+
+export async function createSigningKey(alg) {
+  const kp = await generateKeyPair(alg);
+  return { ...kp, kid: await keyId(alg, kp.publicKey), createdAt: new Date().toISOString() };
+}
+
+// ---------- trusted public keys (public data only; localStorage) ----------
+
+const TRUST_KEY = 'dailyGrind.trustedKeys.v1';
+
+export function loadTrustedKeys() {
+  try {
+    const list = JSON.parse(localStorage.getItem(TRUST_KEY) || '[]');
+    return Array.isArray(list) ? list.filter((k) => k && typeof k.kid === 'string') : [];
+  } catch {
+    return [];
+  }
+}
+
+function saveTrustedKeys(list) {
+  localStorage.setItem(TRUST_KEY, JSON.stringify(list));
+}
+
+export function addTrustedKey(entry) {
+  const list = loadTrustedKeys().filter((k) => k.kid !== entry.kid);
+  list.push(entry);
+  saveTrustedKeys(list);
+}
+
+export function removeTrustedKey(kid) {
+  saveTrustedKeys(loadTrustedKeys().filter((k) => k.kid !== kid));
+}
+
+// Public key export format: JSON { format, alg, kid, publicKey }.
+export function exportPublicKey(key, label) {
+  return JSON.stringify({
+    format: 'daily-grind-public-key-v1',
+    alg: key.alg,
+    kid: key.kid,
+    publicKey: toB64url(key.publicKey),
+    label: label || 'The Daily Grind',
+  }, null, 2);
+}
+
+export async function parsePublicKey(text) {
+  let obj;
+  try {
+    obj = JSON.parse(String(text).trim());
+  } catch {
+    throw new Error('Public key must be the JSON exported by "Export public key".');
+  }
+  if (!isPlainObject(obj) || obj.format !== 'daily-grind-public-key-v1') throw new Error('Unrecognised public key format.');
+  if (!Object.prototype.hasOwnProperty.call(ALGORITHMS, obj.alg)) throw new Error('Unknown algorithm in public key.');
+  const pk = fromB64url(obj.publicKey);
+  const kid = await keyId(obj.alg, pk);
+  if (obj.kid && obj.kid !== kid) throw new Error('Key id does not match the public key.');
+  return { alg: obj.alg, kid, publicKey: obj.publicKey, label: String(obj.label || 'Imported key').slice(0, 80) };
+}
