diff --git a/js/receipts.js b/js/receipts.js
new file mode 100644
index 0000000..0ace001
--- /dev/null
+++ b/js/receipts.js
@@ -0,0 +1,374 @@
+import {
+  ALGORITHMS, isSupported, createSigningKey, saveSigningKey, loadSigningKey, deleteSigningKey,
+  signDocument, encodeToken, decodeToken, verifyDocument, formatKeyId,
+  loadTrustedKeys, addTrustedKey, removeTrustedKey, exportPublicKey, parsePublicKey, toB64url,
+} from './signing.js';
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitCents: 575 },
+  { name: 'Dark Roast Espresso', unitCents: 350 },
+  { name: 'Cold Brew', unitCents: 495 },
+];
+const TAX_RATE = 0.08;
+
+const $ = (sel) => document.querySelector(sel);
+const money = (cents) => '$' + (cents / 100).toFixed(2);
+
+let signingKey = null;
+
+function setStatus(el, text, kind = '') {
+  el.textContent = text;
+  el.className = 'sig-status' + (kind ? ' sig-status--' + kind : '');
+}
+
+function randomCode(len, alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789') {
+  const bytes = crypto.getRandomValues(new Uint8Array(len));
+  return Array.from(bytes, (b) => alphabet[b % alphabet.length]).join('');
+}
+
+function download(filename, text) {
+  const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+  const a = Object.assign(document.createElement('a'), { href: url, download: filename });
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  URL.revokeObjectURL(url);
+}
+
+async function copy(text, statusEl) {
+  try {
+    await navigator.clipboard.writeText(text);
+    setStatus(statusEl, 'Copied to clipboard.', 'ok');
+  } catch {
+    setStatus(statusEl, 'Clipboard unavailable — select the text and copy manually.', 'warn');
+  }
+}
+
+// ---------- key management ----------
+
+async function initAlgorithmSelect() {
+  const select = $('#sig-alg');
+  for (const [id, meta] of Object.entries(ALGORITHMS)) {
+    const opt = new Option(meta.label, id);
+    if (!(await isSupported(id))) {
+      opt.disabled = true;
+      opt.textContent += ' — not supported in this browser';
+    }
+    select.add(opt);
+  }
+  select.value = 'ML-DSA-65';
+}
+
+function renderKey() {
+  const info = $('#sig-key-info');
+  const hasKey = Boolean(signingKey);
+  $('#sig-export-key').disabled = !hasKey;
+  $('#sig-delete-key').disabled = !hasKey;
+  $('#sig-sign-receipt').disabled = !hasKey;
+  $('#sig-sign-voucher').disabled = !hasKey;
+  if (!hasKey) {
+    info.textContent = 'No signing key yet. Choose an algorithm and generate one.';
+    return;
+  }
+  info.replaceChildren();
+  const rows = [
+    ['Algorithm', ALGORITHMS[signingKey.alg].label],
+    ['Key ID', formatKeyId(signingKey.kid)],
+    ['Public key size', signingKey.publicKey.length + ' bytes'],
+    ['Created', new Date(signingKey.createdAt).toLocaleString()],
+  ];
+  const dl = document.createElement('dl');
+  for (const [k, v] of rows) {
+    dl.append(Object.assign(document.createElement('dt'), { textContent: k }));
+    dl.append(Object.assign(document.createElement('dd'), { textContent: v }));
+  }
+  info.append(dl);
+}
+
+function renderTrusted() {
+  const list = $('#sig-trusted-list');
+  list.replaceChildren();
+  const keys = loadTrustedKeys();
+  if (!keys.length) {
+    list.append(Object.assign(document.createElement('li'), { textContent: 'No trusted keys.' }));
+    return;
+  }
+  for (const k of keys) {
+    const li = document.createElement('li');
+    const label = document.createElement('span');
+    const current = signingKey && signingKey.kid === k.kid ? ' (current)' : '';
+    label.textContent = `${k.label}${current} · ${k.alg} · ${formatKeyId(k.kid)}`;
+    const btn = Object.assign(document.createElement('button'), {
+      type: 'button', className: 'sig-link', textContent: 'Remove',
+    });
+    btn.addEventListener('click', () => {
+      if (confirm('Stop trusting this key? Documents it signed will show as unverified.')) {
+        removeTrustedKey(k.kid);
+        renderTrusted();
+      }
+    });
+    li.append(label, btn);
+    list.append(li);
+  }
+}
+
+async function generateKey() {
+  const status = $('#sig-key-status');
+  const alg = $('#sig-alg').value;
+  if (signingKey && !confirm('Replace the current signing key? Its public key stays trusted so existing documents still verify.')) return;
+  setStatus(status, alg === 'ML-DSA-65' ? 'Loading post-quantum library and generating key…' : 'Generating key…');
+  try {
+    const key = await createSigningKey(alg);
+    await saveSigningKey(key);
+    signingKey = key;
+    addTrustedKey({ alg, kid: key.kid, publicKey: toB64url(key.publicKey), label: 'The Daily Grind' });
+    setStatus(status, 'New signing key generated and stored in this browser.', 'ok');
+  } catch (err) {
+    setStatus(status, err.message, 'error');
+  }
+  renderKey();
+  renderTrusted();
+}
+
+async function deleteKey() {
+  if (!confirm('Delete the private signing key from this browser? You will not be able to sign until you generate a new one.')) return;
+  await deleteSigningKey();
+  signingKey = null;
+  setStatus($('#sig-key-status'), 'Private key deleted. Its public key remains trusted for verification.', 'ok');
+  renderKey();
+  renderTrusted();
+}
+
+async function importTrusted() {
+  const status = $('#sig-key-status');
+  const text = prompt('Paste a Daily Grind public key (JSON from "Export public key"):');
+  if (!text) return;
+  try {
+    const entry = await parsePublicKey(text);
+    addTrustedKey(entry);
+    setStatus(status, `Trusted key ${formatKeyId(entry.kid)} added.`, 'ok');
+    renderTrusted();
+  } catch (err) {
+    setStatus(status, err.message, 'error');
+  }
+}
+
+// ---------- document creation ----------
+
+function initReceiptForm() {
+  const tbody = $('#sig-receipt-items');
+  MENU.forEach((item, i) => {
+    const tr = document.createElement('tr');
+    const qty = Object.assign(document.createElement('input'), {
+      type: 'number', min: '0', max: '20', value: i === 0 ? '1' : '0', id: 'sig-qty-' + i,
+    });
+    qty.setAttribute('aria-label', item.name + ' quantity');
+    qty.addEventListener('input', updateReceiptTotal);
+    const cells = [item.name, money(item.unitCents)].map((t) => Object.assign(document.createElement('td'), { textContent: t }));
+    const qtyCell = document.createElement('td');
+    qtyCell.append(qty);
+    tr.append(cells[0], cells[1], qtyCell);
+    tbody.append(tr);
+  });
+  updateReceiptTotal();
+}
+
+function buildReceipt() {
+  const items = MENU.map((m, i) => ({
+    name: m.name,
+    qty: Math.max(0, Math.min(20, parseInt($('#sig-qty-' + i).value, 10) || 0)),
+    unitCents: m.unitCents,
+  })).filter((it) => it.qty > 0);
+  const subtotalCents = items.reduce((s, it) => s + it.qty * it.unitCents, 0);
+  const taxCents = Math.round(subtotalCents * TAX_RATE);
+  return {
+    kind: 'receipt',
+    orderId: 'DG-' + randomCode(10),
+    issuedAt: new Date().toISOString(),
+    merchant: 'The Daily Grind Coffee Co.',
+    currency: 'USD',
+    items,
+    subtotalCents,
+    taxCents,
+    totalCents: subtotalCents + taxCents,
+  };
+}
+
+function updateReceiptTotal() {
+  const r = buildReceipt();
+  $('#sig-receipt-total').textContent = `Subtotal ${money(r.subtotalCents)} · Tax ${money(r.taxCents)} · Total ${money(r.totalCents)}`;
+}
+
+function buildVoucher() {
+  const dollars = Number($('#sig-voucher-amount').value);
+  const days = parseInt($('#sig-voucher-days').value, 10);
+  if (!Number.isFinite(dollars) || dollars < 1 || dollars > 500) throw new Error('Voucher amount must be between $1 and $500.');
+  if (!Number.isInteger(days) || days < 1 || days > 1095) throw new Error('Validity must be between 1 and 1095 days.');
+  const issued = new Date();
+  return {
+    kind: 'voucher',
+    code: 'GIFT-' + randomCode(4) + '-' + randomCode(4) + '-' + randomCode(4),
+    issuedAt: issued.toISOString(),
+    expiresAt: new Date(issued.getTime() + days * 86400000).toISOString(),
+    merchant: 'The Daily Grind Coffee Co.',
+    currency: 'USD',
+    valueCents: Math.round(dollars * 100),
+    recipient: $('#sig-voucher-recipient').value.trim().slice(0, 80),
+    message: $('#sig-voucher-message').value.trim().slice(0, 200),
+  };
+}
+
+let lastToken = '';
+let lastEnvelope = null;
+
+async function sign(type) {
+  const status = $('#sig-create-status');
+  try {
+    const payload = type === 'receipt' ? buildReceipt() : buildVoucher();
+    if (type === 'receipt' && payload.items.length === 0) throw new Error('Add at least one item to the order.');
+    setStatus(status, 'Signing…');
+    lastEnvelope = await signDocument(signingKey, type, payload);
+    lastToken = encodeToken(lastEnvelope);
+    $('#sig-output').value = lastToken;
+    $('#sig-output-actions').hidden = false;
+    const ref = type === 'receipt' ? payload.orderId : payload.code;
+    setStatus(status, `Signed ${type} ${ref} (${lastToken.length.toLocaleString()} characters).`, 'ok');
+    if (type === 'receipt') updateReceiptTotal();
+  } catch (err) {
+    setStatus(status, err.message, 'error');
+  }
+}
+
+// Demonstrates integrity protection: alter a value without re-signing.
+function tamper() {
+  if (!lastEnvelope) return;
+  const forged = structuredClone(lastEnvelope);
+  if (forged.type === 'receipt') forged.payload.totalCents += 100;
+  else forged.payload.valueCents *= 10;
+  $('#sig-verify-input').value = encodeToken(forged);
+  verify();
+  $('#sig-verify-input').scrollIntoView({ behavior: 'smooth', block: 'center' });
+}
+
+// ---------- verification ----------
+
+function renderDocument(container, env) {
+  const p = env.payload;
+  const rows = [];
+  if (env.type === 'receipt') {
+    rows.push(['Order', String(p.orderId)], ['Issued', String(p.issuedAt)]);
+    for (const it of Array.isArray(p.items) ? p.items : []) {
+      rows.push([`${it.qty} × ${it.name}`, money((it.qty | 0) * (it.unitCents | 0))]);
+    }
+    rows.push(['Subtotal', money(p.subtotalCents | 0)], ['Tax', money(p.taxCents | 0)], ['Total', money(p.totalCents | 0)]);
+  } else {
+    rows.push(
+      ['Voucher code', String(p.code)],
+      ['Value', money(p.valueCents | 0)],
+      ['Recipient', String(p.recipient || '—')],
+      ['Message', String(p.message || '—')],
+      ['Issued', String(p.issuedAt)],
+      ['Expires', String(p.expiresAt)],
+    );
+  }
+  rows.push(['Algorithm', ALGORITHMS[env.alg].label], ['Signer key ID', formatKeyId(env.kid)]);
+  const dl = document.createElement('dl');
+  for (const [k, v] of rows) {
+    dl.append(Object.assign(document.createElement('dt'), { textContent: k }));
+    dl.append(Object.assign(document.createElement('dd'), { textContent: v }));
+  }
+  container.append(dl);
+}
+
+async function verify() {
+  const out = $('#sig-verify-result');
+  out.replaceChildren();
+  out.className = 'sig-result';
+  const heading = document.createElement('strong');
+  out.append(heading);
+  heading.textContent = 'Verifying…';
+  out.hidden = false;
+
+  let result;
+  try {
+    const envelope = decodeToken($('#sig-verify-input').value);
+    const trusted = new Set(loadTrustedKeys().map((k) => k.kid));
+    result = await verifyDocument(envelope, trusted);
+  } catch (err) {
+    result = { status: 'invalid', reasons: [err.message], warnings: [] };
+  }
+
+  const titles = {
+    authentic: '✔ Authentic and unaltered',
+    untrusted: '⚠ Valid signature from an unknown signer',
+    invalid: '✘ Verification failed',
+  };
+  heading.textContent = titles[result.status];
+  out.classList.add('sig-result--' + result.status);
+  for (const msg of [...result.reasons, ...result.warnings.map((w) => 'Warning: ' + w)]) {
+    out.append(Object.assign(document.createElement('p'), { textContent: msg }));
+  }
+  if (result.status !== 'invalid' && result.envelope) renderDocument(out, result.envelope);
+}
+
+function loadFile(file) {
+  if (!file) return;
+  if (file.size > 100000) {
+    setStatus($('#sig-create-status'), 'File is too large.', 'error');
+    return;
+  }
+  file.text().then((text) => {
+    $('#sig-verify-input').value = text;
+    verify();
+  });
+}
+
+// ---------- wiring ----------
+
+async function init() {
+  if (!globalThis.crypto?.subtle || !globalThis.indexedDB) {
+    setStatus($('#sig-key-status'), 'Signing requires a secure (HTTPS) context with WebCrypto and IndexedDB.', 'error');
+    return;
+  }
+  await initAlgorithmSelect();
+  initReceiptForm();
+  try {
+    signingKey = await loadSigningKey();
+    if (signingKey) $('#sig-alg').value = signingKey.alg;
+  } catch (err) {
+    setStatus($('#sig-key-status'), 'Could not load stored key: ' + err.message, 'error');
+  }
+  renderKey();
+  renderTrusted();
+
+  $('#sig-generate-key').addEventListener('click', generateKey);
+  $('#sig-delete-key').addEventListener('click', deleteKey);
+  $('#sig-import-key').addEventListener('click', importTrusted);
+  $('#sig-export-key').addEventListener('click', () => download(`daily-grind-public-key-${signingKey.kid.slice(0, 8)}.json`, exportPublicKey(signingKey)));
+  $('#sig-sign-receipt').addEventListener('click', () => sign('receipt'));
+  $('#sig-sign-voucher').addEventListener('click', () => sign('voucher'));
+  $('#sig-copy').addEventListener('click', () => copy(lastToken, $('#sig-create-status')));
+  $('#sig-download').addEventListener('click', () => {
+    const ref = lastEnvelope.type === 'receipt' ? lastEnvelope.payload.orderId : lastEnvelope.payload.code;
+    download(`daily-grind-${lastEnvelope.type}-${ref}.json`, JSON.stringify(lastEnvelope, null, 2));
+  });
+  $('#sig-send-to-verify').addEventListener('click', () => {
+    $('#sig-verify-input').value = lastToken;
+    verify();
+  });
+  $('#sig-tamper').addEventListener('click', tamper);
+  $('#sig-verify').addEventListener('click', verify);
+  $('#sig-verify-file').addEventListener('change', (e) => loadFile(e.target.files[0]));
+
+  for (const tab of document.querySelectorAll('[data-sig-tab]')) {
+    tab.addEventListener('click', () => {
+      for (const t of document.querySelectorAll('[data-sig-tab]')) {
+        const active = t === tab;
+        t.setAttribute('aria-selected', String(active));
+        $('#' + t.dataset.sigTab).hidden = !active;
+      }
+    });
+  }
+}
+
+init();
