diff --git a/js/receipts.js b/js/receipts.js
new file mode 100644
index 0000000..878b1d7
--- /dev/null
+++ b/js/receipts.js
@@ -0,0 +1,262 @@
+import {
+  SUITES,
+  getSupportedSuites,
+  getSigningKey,
+  rotateSigningKey,
+  signDocument,
+  verifyDocument,
+} from './signatures.js';
+
+const MENU = {
+  'maple-oat-latte': { name: 'Maple Oat Latte', price: 5.75 },
+  'dark-roast-espresso': { name: 'Dark Roast Espresso', price: 3.5 },
+  'cold-brew': { name: 'Cold Brew', price: 4.25 },
+};
+
+const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' });
+
+const $ = (sel) => document.querySelector(sel);
+const issueForm = $('#issue-form');
+const verifyForm = $('#verify-form');
+const suiteSelect = $('#sign-suite');
+const keyInfo = $('#key-info');
+const issued = $('#issued');
+const issuedJson = $('#issued-json');
+const issueStatus = $('#issue-status');
+const verifyInput = $('#verify-input');
+const verifyResult = $('#verify-result');
+
+function voucherCode() {
+  const bytes = crypto.getRandomValues(new Uint8Array(6));
+  return Array.from(bytes, (b) => b.toString(36).padStart(2, '0')).join('').toUpperCase()
+    .match(/.{4}/g).join('-');
+}
+
+function el(tag, props = {}, ...children) {
+  const node = Object.assign(document.createElement(tag), props);
+  node.append(...children);
+  return node;
+}
+
+function describePayload(type, p) {
+  const rows = type === 'receipt'
+    ? [
+        ['Receipt #', p.id],
+        ['Customer', p.customer],
+        ['Items', p.items.map((i) => `${i.qty} × ${i.name}`).join(', ')],
+        ['Total', money.format(p.total)],
+        ['Issued', dateFmt.format(new Date(p.issuedAt))],
+      ]
+    : [
+        ['Voucher code', p.code],
+        ['For', p.recipient],
+        ['Value', money.format(p.amount)],
+        ...(p.message ? [['Message', p.message]] : []),
+        ['Issued', dateFmt.format(new Date(p.issuedAt))],
+        ['Expires', dateFmt.format(new Date(p.expiresAt))],
+      ];
+  return el('dl', { className: 'doc-details' },
+    ...rows.flatMap(([k, v]) => [el('dt', {}, k), el('dd', {}, String(v ?? '—'))]));
+}
+
+// --- Issuing ---------------------------------------------------------------
+
+async function refreshKeyInfo() {
+  keyInfo.textContent = 'Preparing signing key…';
+  try {
+    const key = await getSigningKey(suiteSelect.value);
+    keyInfo.replaceChildren(
+      'Issuer key ',
+      el('code', {}, key.fingerprint),
+      ` · ${SUITES[key.suite].postQuantum ? 'quantum-resistant' : 'classical'}`,
+      ` · created ${dateFmt.format(new Date(key.createdAt))}`,
+    );
+  } catch (err) {
+    keyInfo.textContent = `Signing unavailable: ${err.message}`;
+  }
+}
+
+async function initSuites() {
+  const supported = await getSupportedSuites();
+  suiteSelect.replaceChildren(...Object.entries(SUITES).map(([id, suite]) =>
+    el('option', {
+      value: id,
+      textContent: supported.includes(id) ? suite.label : `${suite.label} — not supported`,
+      disabled: !supported.includes(id),
+    })));
+  if (!supported.length) {
+    issueForm.querySelector('button[type="submit"]').disabled = true;
+    keyInfo.textContent = 'This browser does not support WebCrypto digital signatures.';
+    return;
+  }
+  suiteSelect.value = supported[0];
+  await refreshKeyInfo();
+}
+
+function syncDocType() {
+  const type = issueForm.elements.docType.value;
+  for (const fs of issueForm.querySelectorAll('[data-doc-fields]')) {
+    const active = fs.dataset.docFields === type;
+    fs.hidden = !active;
+    fs.disabled = !active; // Disabled fieldsets skip constraint validation.
+  }
+}
+
+function buildPayload(form) {
+  const f = form.elements;
+  const issuedAt = new Date().toISOString();
+  if (f.docType.value === 'receipt') {
+    const item = MENU[f.item.value];
+    const qty = Number(f.qty.value);
+    return {
+      id: crypto.randomUUID(),
+      customer: f.customer.value.trim(),
+      items: [{ sku: f.item.value, name: item.name, qty, unitPrice: item.price }],
+      total: Math.round(item.price * qty * 100) / 100,
+      currency: 'USD',
+      issuedAt,
+    };
+  }
+  return {
+    code: voucherCode(),
+    recipient: f.recipient.value.trim(),
+    amount: Number(f.amount.value),
+    currency: 'USD',
+    message: f.message.value.trim() || undefined,
+    issuedAt,
+    expiresAt: new Date(`${f.expires.value}T23:59:59`).toISOString(),
+  };
+}
+
+issueForm.addEventListener('change', (e) => {
+  if (e.target.name === 'docType') syncDocType();
+  if (e.target === suiteSelect) refreshKeyInfo();
+});
+
+issueForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const submit = e.submitter ?? issueForm.querySelector('button[type="submit"]');
+  submit.disabled = true;
+  issueStatus.textContent = 'Signing…';
+  try {
+    const type = issueForm.elements.docType.value;
+    const signed = await signDocument(type, buildPayload(issueForm), suiteSelect.value);
+    issuedJson.value = JSON.stringify(signed, null, 2);
+    $('#issued-summary').replaceChildren(describePayload(type, signed.payload));
+    issued.hidden = false;
+    issueStatus.textContent = `${type === 'receipt' ? 'Receipt' : 'Gift voucher'} signed with ${signed.alg}.`;
+  } catch (err) {
+    issueStatus.textContent = `Could not sign: ${err.message}`;
+  } finally {
+    submit.disabled = false;
+  }
+});
+
+$('#rotate-key').addEventListener('click', async () => {
+  await rotateSigningKey(suiteSelect.value);
+  await refreshKeyInfo();
+  issueStatus.textContent = 'New issuer key generated. Documents signed with the old key will no longer be recognised as trusted.';
+});
+
+$('#copy-signed').addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(issuedJson.value);
+    issueStatus.textContent = 'Signed document copied to clipboard.';
+  } catch {
+    issuedJson.select();
+    issueStatus.textContent = 'Copy failed — the document is selected so you can copy it manually.';
+  }
+});
+
+$('#download-signed').addEventListener('click', () => {
+  const doc = JSON.parse(issuedJson.value);
+  const name = doc.type === 'receipt' ? `receipt-${doc.payload.id}` : `voucher-${doc.payload.code}`;
+  const url = URL.createObjectURL(new Blob([issuedJson.value], { type: 'application/json' }));
+  el('a', { href: url, download: `${name}.json` }).click();
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+});
+
+$('#send-to-verify').addEventListener('click', () => {
+  verifyInput.value = issuedJson.value;
+  verifyInput.focus();
+  verifyForm.requestSubmit();
+});
+
+// --- Verifying -------------------------------------------------------------
+
+function renderResult(result) {
+  verifyResult.className = 'verify-result';
+  if (!result.valid) {
+    verifyResult.classList.add('is-invalid');
+    verifyResult.replaceChildren(
+      el('strong', {}, '✗ Not authentic'),
+      el('p', {}, result.reason),
+    );
+    return;
+  }
+
+  const notes = [];
+  const expired = result.type === 'voucher' && new Date(result.payload.expiresAt) < new Date();
+  if (!result.trusted) notes.push('Signature is valid, but the signing key is not a Daily Grind issuer key known to this browser.');
+  if (expired) notes.push('This voucher has expired.');
+
+  verifyResult.classList.add(result.trusted && !expired ? 'is-valid' : 'is-warning');
+  verifyResult.replaceChildren(
+    el('strong', {}, result.trusted ? '✓ Authentic Daily Grind ' : '⚠ Valid signature, unknown issuer — ',
+      result.type === 'receipt' ? 'receipt' : 'gift voucher'),
+    el('p', {}, `Signed with ${result.alg}${result.postQuantum ? ' (quantum-resistant)' : ''} · key `,
+      el('code', {}, result.fingerprint)),
+    ...notes.map((n) => el('p', { className: 'note' }, n)),
+    describePayload(result.type, result.payload),
+  );
+}
+
+verifyForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  verifyResult.className = 'verify-result';
+  verifyResult.textContent = 'Verifying…';
+  let envelope;
+  try {
+    envelope = JSON.parse(verifyInput.value);
+  } catch {
+    renderResult({ valid: false, reason: 'The pasted text is not valid JSON.' });
+    return;
+  }
+  try {
+    renderResult(await verifyDocument(envelope));
+  } catch (err) {
+    renderResult({ valid: false, reason: `Verification failed: ${err.message}` });
+  }
+});
+
+$('#verify-file').addEventListener('change', async (e) => {
+  const [file] = e.target.files;
+  if (!file) return;
+  verifyInput.value = await file.text();
+  verifyForm.requestSubmit();
+});
+
+// Demonstrates integrity protection: bump the value and re-verify.
+$('#tamper').addEventListener('click', () => {
+  try {
+    const doc = JSON.parse(verifyInput.value);
+    if (doc.payload?.amount !== undefined) doc.payload.amount += 100;
+    else if (doc.payload?.total !== undefined) doc.payload.total = 0;
+    else throw new Error();
+    verifyInput.value = JSON.stringify(doc, null, 2);
+    verifyForm.requestSubmit();
+  } catch {
+    renderResult({ valid: false, reason: 'Paste a signed receipt or voucher first.' });
+  }
+});
+
+// --- Init ------------------------------------------------------------------
+
+const defaultExpiry = new Date();
+defaultExpiry.setFullYear(defaultExpiry.getFullYear() + 1);
+// 'en-CA' formats local dates as YYYY-MM-DD, the value format of <input type=date>.
+issueForm.elements.expires.value = defaultExpiry.toLocaleDateString('en-CA');
+issueForm.elements.expires.min = new Date().toLocaleDateString('en-CA');
+syncDocType();
+initSuites();
