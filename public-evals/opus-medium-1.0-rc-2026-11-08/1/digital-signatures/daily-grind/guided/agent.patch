+++ b/js/signatures.js
@@ -0,0 +1,351 @@
+// Digital signatures for Daily Grind receipts and gift vouchers.
+//
+// Uses WebCrypto (`crypto.subtle`) with a post-quantum suite (ML-DSA-65, FIPS 204)
+// when available, falling back to classical Ed25519 and then ECDSA P-256.
+// Private keys are generated non-extractable and persisted in IndexedDB, so the
+// raw key material never leaves the browser's crypto implementation.
+
+const encoder = new TextEncoder();
+
+export const ENVELOPE_VERSION = 1;
+
+export const DOCUMENT_TYPES = {
+  receipt: 'daily-grind/receipt/v1',
+  voucher: 'daily-grind/voucher/v1',
+};
+
+export const SUITES = {
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 (post-quantum, FIPS 204)',
+    postQuantum: true,
+    keyFormat: 'raw-public',
+    generate: { name: 'ML-DSA-65' },
+    import: { name: 'ML-DSA-65' },
+    sign: (context) => ({ name: 'ML-DSA-65', context }),
+    nativeContext: true,
+  },
+  Ed25519: {
+    label: 'Ed25519 (classical)',
+    postQuantum: false,
+    keyFormat: 'raw',
+    generate: { name: 'Ed25519' },
+    import: { name: 'Ed25519' },
+    sign: () => ({ name: 'Ed25519' }),
+    nativeContext: false,
+  },
+  'ECDSA-P256': {
+    label: 'ECDSA P-256 / SHA-256 (classical)',
+    postQuantum: false,
+    keyFormat: 'raw',
+    generate: { name: 'ECDSA', namedCurve: 'P-256' },
+    import: { name: 'ECDSA', namedCurve: 'P-256' },
+    sign: () => ({ name: 'ECDSA', hash: 'SHA-256' }),
+    nativeContext: false,
+  },
+};
+
+// ---------------------------------------------------------------------------
+// Feature detection
+// ---------------------------------------------------------------------------
+
+const supportCache = new Map();
+
+async function probeSuite(suiteId) {
+  const suite = SUITES[suiteId];
+  // Static method on the constructor; `crypto.subtle.supports` does not exist.
+  if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+    return SubtleCrypto.supports('generateKey', suite.generate)
+      && SubtleCrypto.supports('sign', suite.sign(new Uint8Array(0)));
+  }
+  // Older browsers: ML-DSA is never available without `supports()`, but
+  // Ed25519 / ECDSA can be probed by attempting key generation.
+  if (suite.postQuantum) return false;
+  try {
+    await crypto.subtle.generateKey(suite.generate, false, ['sign', 'verify']);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export async function isSuiteSupported(suiteId) {
+  if (!globalThis.crypto?.subtle || !SUITES[suiteId]) return false;
+  if (!supportCache.has(suiteId)) supportCache.set(suiteId, probeSuite(suiteId));
+  return supportCache.get(suiteId);
+}
+
+export async function getSupportedSuites() {
+  const ids = Object.keys(SUITES);
+  const results = await Promise.all(ids.map(isSuiteSupported));
+  return ids.filter((_, i) => results[i]);
+}
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------
+
+export function toBase64Url(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64({ alphabet: 'base64url', omitPadding: true });
+  }
+  let binary = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function fromBase64Url(text) {
+  if (typeof text !== 'string' || !/^[A-Za-z0-9_-]*$/.test(text)) {
+    throw new TypeError('Invalid base64url data');
+  }
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(text, { alphabet: 'base64url' });
+  }
+  const b64 = text.replace(/-/g, '+').replace(/_/g, '/');
+  const binary = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  return Uint8Array.from(binary, (c) => c.charCodeAt(0));
+}
+
+// Deterministic JSON (recursively sorted keys) so the signed bytes don't depend
+// on property order after a document is re-serialized or pretty-printed.
+export function canonicalJson(value) {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value).sort()
+      .filter((k) => value[k] !== undefined)
+      .map((k) => `${JSON.stringify(k)}:${canonicalJson(value[k])}`)
+      .join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+export async function fingerprint(publicKeyBytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKeyBytes));
+  return Array.from(digest.subarray(0, 8), (b) => b.toString(16).padStart(2, '0'))
+    .join('')
+    .match(/.{4}/g)
+    .join(':');
+}
+
+// Classical algorithms ignore a `context` member, so emulate ML-DSA's domain
+// separation by prefixing a length-framed context to the message.
+function frameWithContext(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+// ---------------------------------------------------------------------------
+// Key storage (IndexedDB keeps non-extractable CryptoKeys via structured clone)
+// ---------------------------------------------------------------------------
+
+const DB_NAME = 'daily-grind-signing';
+const STORE = 'keys';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function dbRequest(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+async function loadKeyPair(suiteId) {
+  try {
+    return await dbRequest('readonly', (store) => store.get(suiteId));
+  } catch {
+    return undefined;
+  }
+}
+
+async function saveKeyPair(suiteId, record) {
+  try {
+    await dbRequest('readwrite', (store) => store.put(record, suiteId));
+  } catch {
+    // Private browsing or storage disabled: key lives for this session only.
+  }
+}
+
+async function deleteKeyPair(suiteId) {
+  try {
+    await dbRequest('readwrite', (store) => store.delete(suiteId));
+  } catch {
+    // Ignore.
+  }
+}
+
+const sessionKeys = new Map();
+
+async function createKeyPair(suiteId) {
+  const suite = SUITES[suiteId];
+  const keyPair = await crypto.subtle.generateKey(suite.generate, false, ['sign', 'verify']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey(suite.keyFormat, keyPair.publicKey),
+  );
+  const record = {
+    suite: suiteId,
+    privateKey: keyPair.privateKey,
+    publicKeyBytes,
+    createdAt: new Date().toISOString(),
+  };
+  await saveKeyPair(suiteId, record);
+  return record;
+}
+
+export async function getSigningKey(suiteId) {
+  if (!(await isSuiteSupported(suiteId))) {
+    throw new DOMException(`${suiteId} is not supported in this browser`, 'NotSupportedError');
+  }
+  if (!sessionKeys.has(suiteId)) {
+    sessionKeys.set(suiteId, (async () => (await loadKeyPair(suiteId)) ?? createKeyPair(suiteId))());
+  }
+  try {
+    const record = await sessionKeys.get(suiteId);
+    return { ...record, fingerprint: await fingerprint(record.publicKeyBytes) };
+  } catch (err) {
+    sessionKeys.delete(suiteId);
+    throw err;
+  }
+}
+
+export async function rotateSigningKey(suiteId) {
+  sessionKeys.delete(suiteId);
+  await deleteKeyPair(suiteId);
+  return getSigningKey(suiteId);
+}
+
+// Public keys of every issuer key this browser holds, used to flag whether a
+// verified document was signed by a trusted (local) issuer or an unknown key.
+export async function getTrustedPublicKeys() {
+  const trusted = [];
+  for (const suiteId of await getSupportedSuites()) {
+    const record = (await sessionKeys.get(suiteId)?.catch(() => undefined))
+      ?? (await loadKeyPair(suiteId));
+    if (record) trusted.push({ suite: suiteId, publicKey: toBase64Url(record.publicKeyBytes) });
+  }
+  return trusted;
+}
+
+// ---------------------------------------------------------------------------
+// Signing and verification
+// ---------------------------------------------------------------------------
+
+// The signature covers the envelope version, document type, algorithm, signer
+// public key, and payload — so none of them can be swapped independently.
+function signedBytes({ v, type, alg, publicKey, payload }) {
+  return encoder.encode(canonicalJson({ v, type, alg, publicKey, payload }));
+}
+
+export async function signDocument(type, payload, suiteId) {
+  const context = DOCUMENT_TYPES[type];
+  if (!context) throw new TypeError(`Unknown document type: ${type}`);
+
+  const key = await getSigningKey(suiteId);
+  const suite = SUITES[suiteId];
+  const envelope = {
+    v: ENVELOPE_VERSION,
+    type,
+    alg: suiteId,
+    publicKey: toBase64Url(key.publicKeyBytes),
+    payload,
+  };
+
+  const message = signedBytes(envelope);
+  const contextBytes = encoder.encode(context);
+  const signature = await crypto.subtle.sign(
+    suite.sign(contextBytes),
+    key.privateKey,
+    suite.nativeContext ? message : frameWithContext(message, contextBytes),
+  );
+
+  return { ...envelope, signature: toBase64Url(new Uint8Array(signature)) };
+}
+
+export async function verifyDocument(envelope, expectedType) {
+  if (!envelope || typeof envelope !== 'object') {
+    return { valid: false, reason: 'Not a signed Daily Grind document.' };
+  }
+  const { v, type, alg, publicKey, payload, signature } = envelope;
+  if (v !== ENVELOPE_VERSION) {
+    return { valid: false, reason: `Unsupported document version: ${v}.` };
+  }
+  if (!DOCUMENT_TYPES[type]) {
+    return { valid: false, reason: `Unknown document type: ${type}.` };
+  }
+  if (expectedType && type !== expectedType) {
+    return { valid: false, reason: `Expected a ${expectedType}, got a ${type}.` };
+  }
+  const suite = SUITES[alg];
+  if (!suite) {
+    return { valid: false, reason: `Unsupported signature algorithm: ${alg}.` };
+  }
+  if (!(await isSuiteSupported(alg))) {
+    return { valid: false, reason: `This browser cannot verify ${alg} signatures.` };
+  }
+  if (payload === null || typeof payload !== 'object') {
+    return { valid: false, reason: 'Document has no payload.' };
+  }
+
+  let publicKeyBytes;
+  let signatureBytes;
+  let verifyKey;
+  try {
+    publicKeyBytes = fromBase64Url(publicKey);
+    signatureBytes = fromBase64Url(signature);
+    verifyKey = await crypto.subtle.importKey(
+      suite.keyFormat, publicKeyBytes, suite.import, true, ['verify'],
+    );
+  } catch {
+    return { valid: false, reason: 'Malformed public key or signature.' };
+  }
+
+  const message = signedBytes(envelope);
+  const contextBytes = encoder.encode(DOCUMENT_TYPES[type]);
+  let valid = false;
+  try {
+    valid = await crypto.subtle.verify(
+      suite.sign(contextBytes),
+      verifyKey,
+      signatureBytes,
+      suite.nativeContext ? message : frameWithContext(message, contextBytes),
+    );
+  } catch {
+    valid = false;
+  }
+
+  const trusted = (await getTrustedPublicKeys())
+    .some((k) => k.suite === alg && k.publicKey === publicKey);
+
+  return {
+    valid,
+    trusted,
+    type,
+    alg,
+    postQuantum: suite.postQuantum,
+    payload,
+    fingerprint: await fingerprint(publicKeyBytes),
+    reason: valid ? undefined : 'Signature does not match — the document was altered or signed by a different key.',
+  };
+}
