   </footer>
 
+  <!-- Field INP monitoring: reports the page's INP interaction with subpart
+       and Long Animation Frame attribution (scripts, style, layout). -->
+  <script type="module">
+    import { onINP } from 'https://unpkg.com/web-vitals@5/dist/web-vitals.attribution.js?module';
+
+    const ANALYTICS_ENDPOINT = '/analytics';
+
+    function sendToAnalytics(payload) {
+      const body = JSON.stringify(payload);
+      // sendBeacon survives page unload; fall back to a keepalive fetch.
+      if (!(navigator.sendBeacon && navigator.sendBeacon(ANALYTICS_ENDPOINT, body))) {
+        fetch(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          body,
+          keepalive: true,
+          headers: { 'Content-Type': 'application/json' },
+        }).catch(() => {});
+      }
+    }
+
+    // Trim a LoAF script entry down to the fields useful for attribution.
+    function summarizeScript(script) {
+      return {
+        invoker: script.invoker,
+        invokerType: script.invokerType,
+        sourceURL: script.sourceURL,
+        sourceFunctionName: script.sourceFunctionName,
+        sourceCharPosition: script.sourceCharPosition,
+        duration: Math.round(script.duration),
+        forcedStyleDuration: script.forcedStyleDuration,
+        forcedLayoutDuration: script.forcedLayoutDuration,
+        forcedStyleAndLayoutDuration: script.forcedStyleAndLayoutDuration,
+      };
+    }
+
+    onINP((metric) => {
+      const { attribution } = metric;
+      const longestScript = attribution.longestScript;
+
+      // Sum rendering-phase style and layout across all LoAF entries that
+      // intersect the interaction (primarily explains presentation delay),
+      // and collect the slowest scripts that ran during those frames.
+      let renderStyleDuration = 0;
+      let renderLayoutDuration = 0;
+      const scripts = [];
+      for (const entry of attribution.longAnimationFrameEntries) {
+        renderStyleDuration += entry.styleDuration ?? 0;
+        renderLayoutDuration += entry.layoutDuration ?? 0;
+        scripts.push(...entry.scripts);
+      }
+      const topScripts = scripts
+        .sort((a, b) => b.duration - a.duration)
+        .slice(0, 5)
+        .map(summarizeScript);
+
+      sendToAnalytics({
+        name: metric.name,
+        id: metric.id,
+        value: metric.value,
+        rating: metric.rating,
+        navigationType: metric.navigationType,
+        page: location.pathname,
+        // Interaction details
+        interactionTarget: attribution.interactionTarget,
+        interactionType: attribution.interactionType,
+        interactionTime: attribution.interactionTime,
+        loadState: attribution.loadState,
+        // INP subparts: other JS already running, the interaction's own
+        // handlers, and rendering the next frame.
+        inputDelay: attribution.inputDelay,
+        processingDuration: attribution.processingDuration,
+        presentationDelay: attribution.presentationDelay,
+        // The script that contributed most to the interaction, and which
+        // subpart it overlapped with most.
+        longestScript: longestScript && {
+          ...summarizeScript(longestScript.entry),
+          subpart: longestScript.subpart,
+          intersectingDuration: longestScript.intersectingDuration,
+        },
+        totalScriptDuration: attribution.totalScriptDuration,
+        totalPaintDuration: attribution.totalPaintDuration,
+        totalUnattributedDuration: attribution.totalUnattributedDuration,
+        // Rendering-phase style vs. layout (with combined fallback for
+        // browsers lacking the split properties).
+        renderStyleDuration,
+        renderLayoutDuration,
+        totalStyleAndLayoutDuration: attribution.totalStyleAndLayoutDuration,
+        topScripts,
+      });
+    });
+  </script>
+
 </body>
 
 </html>
