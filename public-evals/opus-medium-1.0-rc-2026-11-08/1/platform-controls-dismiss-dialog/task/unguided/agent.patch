+          href: '/menu/cold-brew'
+        }
+      };
+
+      var dialog = document.getElementById('coffee-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') return;
+
+      var el = function (id) { return document.getElementById('coffee-dialog-' + id); };
+      var opener = null;
+      var historyEntryPushed = false; // our history entry is on top of the stack
+      var awaitingBack = false;       // we called history.back() and are waiting for popstate
+      var queuedCoffee = null;
+
+      function fill(coffee) {
+        el('title').textContent = coffee.name;
+        el('price').textContent = coffee.price;
+        el('desc').textContent = coffee.description;
+        el('notes').textContent = coffee.notes;
+        el('origin').textContent = coffee.origin;
+        el('sizes').textContent = coffee.sizes;
+        el('link').href = coffee.href;
+        var img = el('img');
+        img.hidden = false;
+        img.src = coffee.image;
+        img.alt = coffee.alt;
+      }
+
+      el('img').addEventListener('error', function () { this.hidden = true; });
+
+      function open(id, trigger) {
+        var coffee = COFFEES[id];
+        if (!coffee) return;
+        if (awaitingBack) {
+          // Let the pending history traversal finish before pushing a new entry.
+          queuedCoffee = { id: id, trigger: trigger };
+          return;
+        }
+        opener = trigger || document.activeElement;
+        fill(coffee);
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+        // Add a history entry so the mobile back gesture/button dismisses the dialog
+        // instead of navigating away from the page.
+        history.pushState({ coffeeDialog: id }, '');
+        historyEntryPushed = true;
+      }
+
+      // Fires for every dismissal path: Escape (native cancel), close buttons,
+      // backdrop click, back gesture (popstate or the browser's own close watcher).
+      dialog.addEventListener('close', function () {
+        document.body.classList.remove('dialog-open');
+        if (historyEntryPushed) {
+          historyEntryPushed = false;
+          awaitingBack = true;
+          history.back();
+        }
+        if (opener && typeof opener.focus === 'function') opener.focus();
+        opener = null;
+      });
+
+      window.addEventListener('popstate', function () {
+        if (awaitingBack) {
+          awaitingBack = false;
+          if (queuedCoffee) {
+            var q = queuedCoffee;
+            queuedCoffee = null;
+            open(q.id, q.trigger);
+          }
+          return;
+        }
+        if (dialog.open) {
+          // User pressed back: the history entry is already gone, just close.
+          historyEntryPushed = false;
+          dialog.close();
+        }
+      });
+
+      dialog.addEventListener('click', function (event) {
+        if (event.target.closest('[data-close]')) {
+          dialog.close();
+          return;
+        }
+        // Click on the backdrop (outside the dialog box) dismisses it.
+        if (event.target === dialog) {
+          var r = dialog.getBoundingClientRect();
+          var inside = event.clientX >= r.left && event.clientX <= r.right &&
+            event.clientY >= r.top && event.clientY <= r.bottom;
+          if (!inside) dialog.close();
+        }
+      });
+
+      document.querySelectorAll('[data-coffee]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          open(btn.getAttribute('data-coffee'), btn);
+        });
+      });
+    })();
+  </script>
