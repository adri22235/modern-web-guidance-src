+  <script>
+    (() => {
+      const PRIORITIES = {
+        urgent: { rank: 0, label: 'Urgent', native: 'user-blocking' },
+        standard: { rank: 1, label: 'Standard', native: 'user-visible' },
+        background: { rank: 2, label: 'Background', native: 'background' }
+      };
+
+      const TEMPLATES = {
+        urgent: { names: ['Checkout #', 'Payment auth #', 'Mobile order #'], chunks: 8 },
+        standard: { names: ['Menu update: Maple Oat Latte', 'Menu update: Cold Brew pricing', 'Menu update: Pastry case'], chunks: 20 },
+        background: { names: ['Telemetry: page views', 'Telemetry: grinder sensors', 'Telemetry: POS metrics'], chunks: 40 }
+      };
+
+      const CHUNK_BUDGET_MS = 8; // max time a single chunk may block the main thread
+
+      const hasScheduler = typeof window.scheduler !== 'undefined';
+      const hasYield = hasScheduler && typeof scheduler.yield === 'function';
+
+      const els = {
+        queue: document.getElementById('ops-queue'),
+        log: document.getElementById('ops-log'),
+        queued: document.getElementById('ops-queued'),
+        completed: document.getElementById('ops-completed'),
+        gap: document.getElementById('ops-gap'),
+        mode: document.getElementById('ops-mode')
+      };
+      els.mode.textContent = hasYield ? 'scheduler.yield()' : hasScheduler ? 'scheduler.postTask()' : 'setTimeout fallback';
+
+      const queue = [];
+      let seq = 0;
+      let completed = 0;
+      let running = false;
+      let maxGap = 0;
+      const queueItems = new Map();
+
+      // Yield control back to the browser so input and rendering can happen.
+      function yieldToMain(priority) {
+        if (hasYield) return scheduler.yield();
+        if (hasScheduler) return scheduler.postTask(() => {}, { priority: PRIORITIES[priority].native });
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      // Simulated CPU-bound work for up to `ms` milliseconds.
+      function busyWork(ms) {
+        const end = performance.now() + ms;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(Math.random());
+        return x;
+      }
+
+      function createTask(priority) {
+        const tpl = TEMPLATES[priority];
+        seq += 1;
+        let name = tpl.names[seq % tpl.names.length];
+        if (name.endsWith('#')) name += 1000 + seq;
+        return { id: seq, priority, name, total: tpl.chunks, done: 0, started: false };
+      }
+
+      // Stable priority ordering: lower rank first, then FIFO by id.
+      function compareTasks(a, b) {
+        return PRIORITIES[a.priority].rank - PRIORITIES[b.priority].rank || a.id - b.id;
+      }
+
+      function enqueue(tasks) {
+        tasks.forEach(task => {
+          queue.push(task);
+          log(`Queued ${PRIORITIES[task.priority].label.toLowerCase()} task: ${task.name}`, task.priority);
+        });
+        queue.sort(compareTasks);
+        renderQueue();
+        run();
+      }
+
+      async function run() {
+        if (running) return;
+        running = true;
+        while (queue.length) {
+          // Always re-pick the highest-priority task so new urgent work preempts long tasks.
+          const task = queue[0];
+          if (!task.started) {
+            task.started = true;
+            log(`Started: ${task.name}`, task.priority);
+          }
+          busyWork(CHUNK_BUDGET_MS);
+          task.done += 1;
+          updateProgress(task);
+          if (task.done >= task.total) {
+            queue.shift();
+            completed += 1;
+            log(`Completed: ${task.name}`, task.priority);
+            renderQueue();
+          }
+          await yieldToMain(task.priority);
+        }
+        running = false;
+      }
+
+      function renderQueue() {
+        els.queue.textContent = '';
+        queueItems.clear();
+        if (!queue.length) {
+          const li = document.createElement('li');
+          li.className = 'empty';
+          li.textContent = 'Queue is empty';
+          els.queue.appendChild(li);
+        }
+        queue.forEach(task => {
+          const li = document.createElement('li');
+          li.className = task.priority;
+          const head = document.createElement('div');
+          head.className = 'ops-task-head';
+          const name = document.createElement('span');
+          name.textContent = task.name;
+          const badge = document.createElement('span');
+          badge.className = 'ops-badge';
+          badge.textContent = PRIORITIES[task.priority].label;
+          head.append(name, badge);
+          const progress = document.createElement('div');
+          progress.className = 'ops-progress';
+          const bar = document.createElement('span');
+          progress.appendChild(bar);
+          li.append(head, progress);
+          els.queue.appendChild(li);
+          queueItems.set(task.id, bar);
+          updateProgress(task);
+        });
+        els.queued.textContent = queue.length;
+        els.completed.textContent = completed;
+      }
+
+      function updateProgress(task) {
+        const bar = queueItems.get(task.id);
+        if (bar) bar.style.width = `${Math.round((task.done / task.total) * 100)}%`;
+      }
+
+      function log(message, priority) {
+        const li = document.createElement('li');
+        if (priority) li.className = priority;
+        const time = document.createElement('time');
+        time.textContent = new Date().toLocaleTimeString();
+        li.append(time, document.createTextNode(message));
+        els.log.prepend(li);
+        while (els.log.children.length > 100) els.log.lastChild.remove();
+      }
+
+      // Measure responsiveness: track the largest gap between animation frames.
+      let lastFrame = performance.now();
+      function frame(now) {
+        const gap = now - lastFrame;
+        lastFrame = now;
+        if (gap > maxGap && running) {
+          maxGap = gap;
+          els.gap.textContent = Math.round(maxGap);
+        }
+        requestAnimationFrame(frame);
+      }
+      requestAnimationFrame(frame);
+
+      document.querySelectorAll('[data-ops-add]').forEach(btn => {
+        btn.addEventListener('click', () => enqueue([createTask(btn.dataset.opsAdd)]));
+      });
+
+      document.getElementById('ops-batch').addEventListener('click', () => {
+        // Submitted deliberately out of order; the scheduler executes them by priority.
+        const mix = ['background', 'standard', 'urgent', 'background', 'standard', 'urgent', 'background'];
+        log('Batch submitted: 7 mixed tasks');
+        enqueue(mix.map(createTask));
+      });
+
+      document.getElementById('ops-clear').addEventListener('click', () => {
+        queue.length = 0;
+        completed = 0;
+        maxGap = 0;
+        els.gap.textContent = '0';
+        els.log.textContent = '';
+        renderQueue();
+        log('Queue and log cleared');
+      });
+
+      renderQueue();
+      log('Simulator ready');
+    })();
+  </script>
+
 </body>
 
