+  <script>
+    (() => {
+      // Load the Prioritized Task Scheduling polyfill only where scheduler.postTask is missing.
+      const schedulerReady = new Promise((resolve) => {
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          resolve();
+          return;
+        }
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = resolve;
+        script.onerror = resolve; // Fall back to runTask's setTimeout path below.
+        document.head.appendChild(script);
+      });
+
+      const TASKS = {
+        checkout: { label: 'Checkout payment authorization', priority: 'user-blocking', items: 400 },
+        menu: { label: 'Menu price & availability sync', priority: 'user-visible', items: 900 },
+        telemetry: { label: 'Telemetry event flush', priority: 'background', items: 1500 }
+      };
+
+      const logEl = document.getElementById('ops-log');
+      const pendingEl = document.getElementById('ops-pending');
+      const doneEl = document.getElementById('ops-done');
+      let pending = 0;
+      let done = 0;
+      let sequence = 0;
+
+      function log(priority, message) {
+        const li = document.createElement('li');
+        const tag = document.createElement('span');
+        tag.className = 'ops-tag';
+        tag.dataset.priority = priority;
+        tag.textContent = priority;
+        li.append(tag, `${new Date().toLocaleTimeString()} — ${message}`);
+        logEl.append(li);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      function updateCounts() {
+        pendingEl.textContent = pending;
+        doneEl.textContent = done;
+      }
+
+      function yieldToMain() {
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          // Inside postTask, the continuation inherits the task's priority.
+          return scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      // Simulates ~1ms of CPU-bound work per item (e.g. hashing, serialization).
+      function processItem() {
+        const end = performance.now() + 1;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(Math.random());
+        return x;
+      }
+
+      async function work(task, id) {
+        log(task.priority, `#${id} ${task.label} started (${task.items} items)`);
+        const start = performance.now();
+        let deadline = start + 50;
+        for (let i = 0; i < task.items; i++) {
+          processItem();
+          if (performance.now() >= deadline) {
+            await yieldToMain();
+            deadline = performance.now() + 50;
+          }
+        }
+        const secs = ((performance.now() - start) / 1000).toFixed(2);
+        log(task.priority, `#${id} ${task.label} finished in ${secs}s`);
+      }
+
+      async function enqueue(type) {
+        const task = TASKS[type];
+        const id = ++sequence;
+        pending++;
+        updateCounts();
+        log(task.priority, `#${id} ${task.label} queued`);
+        await schedulerReady;
+        const run = () => work(task, id);
+        try {
+          if ('scheduler' in window && 'postTask' in window.scheduler) {
+            await scheduler.postTask(run, { priority: task.priority });
+          } else {
+            await new Promise((resolve) => setTimeout(resolve, 0)).then(run);
+          }
+        } finally {
+          pending--;
+          done++;
+          updateCounts();
+        }
+      }
+
+      document.querySelectorAll('.ops-controls [data-task]').forEach((button) => {
+        button.addEventListener('click', () => enqueue(button.dataset.task));
+      });
+
+      // Queue tasks deliberately out of order; the scheduler runs them by priority.
+      document.getElementById('ops-batch').addEventListener('click', () => {
+        log('user-visible', 'Batch submitted: telemetry, menu, checkout, telemetry, menu, checkout');
+        ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout'].forEach(enqueue);
+      });
+
+      document.getElementById('ops-clear').addEventListener('click', () => {
+        logEl.replaceChildren();
+      });
+
+      // Main-thread heartbeat: stalls visibly if a task ever blocks the UI.
+      const heartbeat = document.getElementById('ops-heartbeat');
+      (function beat(t) {
+        heartbeat.style.transform = `translateX(${((t / 5) % 600) - 100}%)`;
+        requestAnimationFrame(beat);
+      })(0);
+    })();
+  </script>
+
 </body>
 
