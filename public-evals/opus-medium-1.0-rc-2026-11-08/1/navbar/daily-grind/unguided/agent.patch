+  <script>
+    (function () {
+      var nav = document.querySelector('.site-nav');
+      var toggle = nav.querySelector('.nav-toggle');
+      var links = nav.querySelectorAll('a[href]');
+      var mobileQuery = window.matchMedia('(max-width: 720px)');
+
+      // Highlight the link for the page currently being viewed.
+      var normalize = function (path) {
+        return path.replace(/\/index\.html$/, '/').replace(/(.)\/$/, '$1');
+      };
+      var current = normalize(window.location.pathname);
+      var best = null;
+      links.forEach(function (link) {
+        link.removeAttribute('aria-current');
+        var target = normalize(new URL(link.href).pathname);
+        var matches = target === '/'
+          ? current === '/'
+          : current === target || current.indexOf(target + '/') === 0;
+        if (matches && (!best || target.length > best.target.length)) {
+          best = { link: link, target: target };
+        }
+      });
+      if (best) best.link.setAttribute('aria-current', 'page');
+
+      // Mobile menu toggle.
+      var setOpen = function (open) {
+        nav.classList.toggle('is-open', open);
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
+      };
+
+      toggle.addEventListener('click', function () {
+        setOpen(!nav.classList.contains('is-open'));
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
+          setOpen(false);
+          toggle.focus();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (nav.classList.contains('is-open') && !nav.contains(e.target)) {
+          setOpen(false);
+        }
+      });
+
+      mobileQuery.addEventListener('change', function (e) {
+        if (!e.matches) setOpen(false);
+      });
+    })();
+  </script>
+
 </body>
 
