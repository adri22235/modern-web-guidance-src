+  <script>
+    // Load the popover polyfill only where native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    (() => {
+      const header = document.querySelector(".site-header");
+      const inner = header.querySelector(".header-inner");
+      const menu = document.getElementById("site-menu");
+
+      // Mark the link for the current page (also matches sub-pages, e.g. /menu/seasonal -> Menu)
+      const normalize = (path) => path.replace(/\/index\.html$/, "/").replace(/(.)\/+$/, "$1");
+      const current = normalize(location.pathname);
+      for (const link of header.querySelectorAll("a[href]")) {
+        const target = normalize(new URL(link.href).pathname);
+        const isCurrent = target === "/" ? current === "/" : current === target || current.startsWith(target + "/");
+        if (isCurrent) link.setAttribute("aria-current", "page");
+      }
+
+      // Collapse into the popover only when the inline row doesn't fit
+      let lastWidth = 0;
+      const isOpen = () => menu.matches(":is(:popover-open, .\\:popover-open)");
+
+      function updateLayout() {
+        const width = header.clientWidth;
+        const grew = width > lastWidth;
+        lastWidth = width;
+        // While collapsed, only remeasure when the header got wider
+        if (!header.classList.contains("is-wide") && !grew) return;
+
+        // An open popover sits in the top layer, out of flow, so close it to measure the row
+        const wasOpen = menu.hasAttribute("popover") && isOpen();
+        if (wasOpen) menu.hidePopover();
+        header.classList.add("is-measuring", "is-wide");
+        const wide = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle("is-wide", wide);
+
+        if (wide) {
+          menu.removeAttribute("popover");
+        } else {
+          if (!menu.hasAttribute("popover")) menu.setAttribute("popover", "auto");
+          if (wasOpen) menu.showPopover();
+        }
+        requestAnimationFrame(() => header.classList.remove("is-measuring"));
+      }
+
+      const observer = new ResizeObserver(updateLayout);
+      observer.observe(header);
+      observer.observe(menu);
+    })();
+  </script>
+
