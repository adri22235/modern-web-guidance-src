   </footer>
 
+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      var ctx = canvas.getContext('2d');
+
+      var MIN_TEMP = 200;
+      var MAX_TEMP = 440;
+      var temp = MIN_TEMP;
+      var rafId = null;
+      var intervalId = null;
+      var lastTime = 0;
+      var angle = 0;
+      var inView = false;
+
+      // Beans positioned in polar coordinates inside the drum
+      var beans = [];
+      for (var i = 0; i < 60; i++) {
+        beans.push({
+          offset: Math.random() * Math.PI * 1.2 - 0.6,
+          radius: 0.35 + Math.random() * 0.55,
+          rot: Math.random() * Math.PI * 2,
+          spin: (Math.random() - 0.5) * 4,
+          size: 0.8 + Math.random() * 0.4
+        });
+      }
+
+      function stageFor(t) {
+        if (t < 300) return 'Drying';
+        if (t < 385) return 'Maillard Browning';
+        if (t < 410) return 'First Crack';
+        if (t < 435) return 'Development';
+        return 'Second Crack';
+      }
+
+      // Interpolate bean color from green through cinnamon to dark roast
+      var palette = [[120, 140, 70], [200, 170, 90], [150, 90, 45], [90, 50, 25], [45, 25, 15]];
+      function beanColor(t) {
+        var p = Math.min(Math.max((t - MIN_TEMP) / (MAX_TEMP - MIN_TEMP), 0), 1) * (palette.length - 1);
+        var i = Math.min(Math.floor(p), palette.length - 2);
+        var f = p - i;
+        var a = palette[i], b = palette[i + 1];
+        return 'rgb(' + [0, 1, 2].map(function (k) { return Math.round(a[k] + (b[k] - a[k]) * f); }).join(',') + ')';
+      }
+
+      function resize() {
+        var dpr = window.devicePixelRatio || 1;
+        var w = canvas.clientWidth, h = canvas.clientHeight;
+        if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
+          canvas.width = Math.round(w * dpr);
+          canvas.height = Math.round(h * dpr);
+        }
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        return { w: w, h: h };
+      }
+
+      function draw(dt) {
+        var size = resize();
+        var cx = size.w / 2, cy = size.h / 2;
+        var drumR = Math.min(size.w, size.h) * 0.42;
+
+        ctx.clearRect(0, 0, size.w, size.h);
+
+        // Heat glow under the drum intensifies with temperature
+        var heat = (temp - MIN_TEMP) / (MAX_TEMP - MIN_TEMP);
+        var glow = ctx.createRadialGradient(cx, cy + drumR, 0, cx, cy + drumR, drumR * 1.6);
+        glow.addColorStop(0, 'rgba(255, 120, 30, ' + (0.15 + heat * 0.45) + ')');
+        glow.addColorStop(1, 'rgba(255, 120, 30, 0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, size.w, size.h);
+
+        // Drum
+        ctx.beginPath();
+        ctx.arc(cx, cy, drumR, 0, Math.PI * 2);
+        ctx.fillStyle = '#3a2620';
+        ctx.fill();
+        ctx.lineWidth = 6;
+        ctx.strokeStyle = '#8d6e63';
+        ctx.stroke();
+
+        // Rotating vanes
+        angle += dt * 1.2;
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.5)';
+        ctx.lineWidth = 3;
+        for (var v = 0; v < 4; v++) {
+          var va = angle + v * Math.PI / 2;
+          ctx.beginPath();
+          ctx.moveTo(cx, cy);
+          ctx.lineTo(cx + Math.cos(va) * drumR, cy + Math.sin(va) * drumR);
+          ctx.stroke();
+        }
+
+        // Beans tumble in the lower part of the drum, lifted by rotation
+        var color = beanColor(temp);
+        var beanLen = drumR * 0.09;
+        beans.forEach(function (b, idx) {
+          b.rot += b.spin * dt;
+          var wobble = Math.sin(angle * 2 + idx) * 0.25;
+          var a = Math.PI / 2 - 0.5 + b.offset + wobble;
+          var r = drumR * b.radius * 0.92;
+          var x = cx + Math.cos(a) * r;
+          var y = cy + Math.sin(a) * r;
+          ctx.save();
+          ctx.translate(x, y);
+          ctx.rotate(b.rot);
+          ctx.beginPath();
+          ctx.ellipse(0, 0, beanLen * b.size, beanLen * 0.65 * b.size, 0, 0, Math.PI * 2);
+          ctx.fillStyle = color;
+          ctx.fill();
+          // Center crease
+          ctx.beginPath();
+          ctx.moveTo(-beanLen * 0.8 * b.size, 0);
+          ctx.quadraticCurveTo(0, beanLen * 0.2, beanLen * 0.8 * b.size, 0);
+          ctx.strokeStyle = 'rgba(0, 0, 0, 0.45)';
+          ctx.lineWidth = 1.2;
+          ctx.stroke();
+          ctx.restore();
+        });
+      }
+
+      function frame(now) {
+        var dt = lastTime ? Math.min((now - lastTime) / 1000, 0.1) : 0;
+        lastTime = now;
+        draw(dt);
+        rafId = requestAnimationFrame(frame);
+      }
+
+      function tick() {
+        // Climb faster early in the roast, slow near the end, then start a new batch
+        temp += Math.max(1.5, (MAX_TEMP - temp) * 0.04) + (Math.random() - 0.5);
+        if (temp >= MAX_TEMP) temp = MIN_TEMP;
+        tempEl.textContent = Math.round(temp);
+        stageEl.textContent = stageFor(temp);
+      }
+
+      function start() {
+        if (rafId === null) {
+          lastTime = 0;
+          rafId = requestAnimationFrame(frame);
+        }
+        if (intervalId === null) {
+          intervalId = setInterval(tick, 1000);
+        }
+      }
+
+      function stop() {
+        if (rafId !== null) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (intervalId !== null) {
+          clearInterval(intervalId);
+          intervalId = null;
+        }
+      }
+
+      function setInView(visible) {
+        inView = visible;
+        if (visible && !document.hidden) start(); else stop();
+      }
+
+      // Also pause while the tab is hidden (intervals keep running in background tabs)
+      document.addEventListener('visibilitychange', function () {
+        setInView(inView);
+      });
+
+      if ('ContentVisibilityAutoStateChangeEvent' in window) {
+        // Native: tied to the browser's rendering lifecycle for content-visibility: auto
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          setInView(!event.skipped);
+        });
+      } else if ('IntersectionObserver' in window) {
+        // Fallback for browsers without the rendering state change event
+        new IntersectionObserver(function (entries) {
+          setInView(entries[entries.length - 1].isIntersecting);
+        }, { rootMargin: '200px 0px' }).observe(widget);
+      } else {
+        // Last resort: approximate visibility using scroll/resize position checks
+        var pending = false;
+        var check = function () {
+          pending = false;
+          var rect = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          setInView(rect.bottom > -200 && rect.top < vh + 200);
+        };
+        var schedule = function () {
+          if (!pending) {
+            pending = true;
+            setTimeout(check, 100);
+          }
+        };
+        window.addEventListener('scroll', schedule, { passive: true });
+        window.addEventListener('resize', schedule);
+        check();
+      }
+    })();
+  </script>
+
 </body>
 
