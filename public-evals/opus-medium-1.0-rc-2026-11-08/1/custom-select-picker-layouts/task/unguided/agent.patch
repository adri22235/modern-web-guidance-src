+    /* Roast picker */
+    .order-form {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      margin-top: 1.5rem;
+    }
+
+    .order-form label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      margin-bottom: 0.4rem;
+    }
+
+    .order-form .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select {
+      min-width: 220px;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    /* Customizable select (progressive enhancement): render the options
+       menu as a 3-column grid of image tiles. Unsupported browsers fall
+       back to the native dropdown list. */
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 10px;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent img {
+        width: 28px;
+        height: 28px;
+        border-radius: 50%;
+        object-fit: cover;
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      .roast-select::picker(select) {
+        display: grid;
+        grid-template-columns: repeat(3, 1fr);
+        gap: 10px;
+        width: min(480px, 92vw);
+        padding: 10px;
+        margin-top: 6px;
+        background: white;
+        border: none;
+        border-radius: 10px;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
+        position-area: bottom;
+        position-try-fallbacks: flip-block;
+      }
+
+      .roast-select option {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 6px;
+        padding: 8px;
+        border: 2px solid transparent;
+        border-radius: 8px;
+        text-align: center;
+        color: var(--text);
+        cursor: pointer;
+        transition: border-color 0.2s, background 0.2s;
+      }
+
+      .roast-select option::checkmark {
+        display: none;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        border-color: var(--accent);
+        background: #fff3e0;
+      }
+
+      .roast-select option img {
+        width: 100%;
+        aspect-ratio: 1;
+        object-fit: cover;
+        border-radius: 6px;
+      }
+
+      .roast-select option .roast-name {
+        font-weight: bold;
+      }
+
+      .roast-select option .roast-desc {
+        font-size: 0.75rem;
+        line-height: 1.3;
+        color: #6d4c41;
+      }
+    }
+
