+  <script>
+    // The native picker only navigates Up/Down; map Left/Right to the adjacent card in the 3-column row.
+    document.querySelector('.roast-select').addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const current = document.activeElement;
+      if (!(current instanceof HTMLOptionElement)) return;
+      const rtl = getComputedStyle(current).direction === 'rtl';
+      const forward = (e.key === 'ArrowRight') !== rtl;
+      const next = forward ? current.nextElementSibling : current.previousElementSibling;
+      if (next instanceof HTMLOptionElement) {
+        e.preventDefault();
+        next.focus();
+      }
+    });
+  </script>
+
