+  <script>
+    (function () {
+      const steps = Array.from(document.querySelectorAll('#tracked section'));
+      const visuals = Array.from(document.querySelectorAll('#animated section'));
+      if (!steps.length || steps.length !== visuals.length) return;
+
+      let ticking = false;
+
+      function update() {
+        ticking = false;
+        const viewportCenter = window.innerHeight / 2;
+        let activeIndex = 0;
+
+        steps.forEach((step, i) => {
+          const rect = step.getBoundingClientRect();
+          // Progress of this text step crossing the viewport center: 0 at its top, 1 at its bottom
+          const progress = Math.min(1, Math.max(0, (viewportCenter - rect.top) / rect.height));
+          if (rect.top <= viewportCenter) activeIndex = i;
+          visuals[i].style.setProperty('--progress', progress.toFixed(3));
+        });
+
+        steps.forEach((step, i) => {
+          const isActive = i === activeIndex;
+          step.classList.toggle('is-active', isActive);
+          visuals[i].style.setProperty('--visibility', isActive ? 1 : 0);
+        });
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      update();
+    })();
+  </script>
