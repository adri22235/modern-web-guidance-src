+  <script>
+    (function () {
+      var form = document.getElementById('contact-form');
+      var status = document.getElementById('contact-status');
+      var fields = form.querySelectorAll('input, textarea');
+      var labels = { name: 'your name', email: 'your email', message: 'a message' };
+
+      function getMessage(field) {
+        var v = field.validity;
+        if (v.valueMissing) return 'Please enter ' + labels[field.name] + '.';
+        if (v.typeMismatch) return 'Please enter a valid email address (e.g. name@example.com).';
+        if (v.tooShort) return 'Please use at least ' + field.minLength + ' characters.';
+        return '';
+      }
+
+      function validate(field) {
+        // Treat whitespace-only input as blank
+        field.setCustomValidity('');
+        if (field.required && field.value.length && !field.value.trim()) {
+          field.setCustomValidity('Please enter ' + labels[field.name] + '.');
+        }
+        var wrapper = field.closest('.form-field');
+        var error = wrapper.querySelector('.field-error');
+        var invalid = !field.checkValidity();
+        wrapper.classList.toggle('has-error', invalid);
+        field.setAttribute('aria-invalid', invalid ? 'true' : 'false');
+        error.textContent = invalid ? (field.validity.customError ? field.validationMessage : getMessage(field)) : '';
+        return !invalid;
+      }
+
+      fields.forEach(function (field) {
+        // Only validate after the customer has interacted with the field
+        field.addEventListener('blur', function () {
+          field.dataset.touched = 'true';
+          validate(field);
+        });
+        field.addEventListener('input', function () {
+          status.hidden = true;
+          if (field.dataset.touched) validate(field);
+        });
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var firstInvalid = null;
+        fields.forEach(function (field) {
+          field.dataset.touched = 'true';
+          if (!validate(field) && !firstInvalid) firstInvalid = field;
+        });
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+        status.textContent = 'Thanks! Your message has been sent. We\'ll get back to you soon.';
+        status.hidden = false;
+        form.reset();
+        fields.forEach(function (field) {
+          delete field.dataset.touched;
+          field.removeAttribute('aria-invalid');
+        });
+      });
+    })();
+  </script>
+
 </body>
 
