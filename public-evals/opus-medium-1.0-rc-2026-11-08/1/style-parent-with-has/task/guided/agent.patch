+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const contactForm = document.getElementById('contact-form');
+
+    const syncAriaInvalid = (event) => {
+      const control = event.target;
+      if (!control.matches?.('input, textarea')) return;
+      if (control.matches(':user-invalid')) {
+        control.setAttribute('aria-invalid', 'true');
+      } else {
+        control.removeAttribute('aria-invalid');
+      }
+    };
+
+    contactForm.addEventListener('blur', syncAriaInvalid, true);
+    contactForm.addEventListener('invalid', syncAriaInvalid, true);
+    contactForm.addEventListener('input', (event) => {
+      if (event.target.getAttribute('aria-invalid') === 'true') syncAriaInvalid(event);
+    });
+  </script>
+
 </body>
 
