+  <script>
+    (function () {
+      var trigger = document.getElementById('trigger-btn');
+      var panel = document.getElementById('action-panel');
+      var GAP = 6;      // space between trigger and panel
+      var MARGIN = 8;   // minimum distance from viewport edges
+      var supportsPopover = typeof panel.showPopover === 'function';
+
+      function isOpen() {
+        return supportsPopover ? panel.matches(':popover-open') : panel.classList.contains('is-open');
+      }
+
+      // Anchor below the trigger, left-aligned; flip vertically/horizontally on collision,
+      // then clamp so the panel is never cut off.
+      function position() {
+        var vw = document.documentElement.clientWidth;
+        var vh = document.documentElement.clientHeight;
+        var t = trigger.getBoundingClientRect();
+        var w = panel.offsetWidth;
+        var h = panel.offsetHeight;
+
+        var vertical = 'bottom';
+        var top = t.bottom + GAP;
+        if (top + h > vh - MARGIN) {
+          var spaceBelow = vh - t.bottom - GAP - MARGIN;
+          var spaceAbove = t.top - GAP - MARGIN;
+          if (spaceAbove >= h || spaceAbove > spaceBelow) {
+            vertical = 'top';
+            top = t.top - GAP - h;
+          }
+        }
+
+        var horizontal = 'start';
+        var left = t.left;
+        if (left + w > vw - MARGIN) {
+          var flipped = t.right - w; // align right edges instead
+          if (flipped >= MARGIN || flipped > vw - MARGIN - w) {
+            horizontal = 'end';
+            left = flipped;
+          }
+        }
+
+        left = Math.max(MARGIN, Math.min(left, vw - MARGIN - w));
+        top = Math.max(MARGIN, Math.min(top, vh - MARGIN - h));
+
+        panel.style.left = Math.round(left) + 'px';
+        panel.style.top = Math.round(top) + 'px';
+        panel.dataset.placement = vertical + '-' + horizontal;
+      }
+
+      function onViewportChange() {
+        if (isOpen()) position();
+      }
+
+      function handleOpened() {
+        position();
+        trigger.setAttribute('aria-expanded', 'true');
+        window.addEventListener('resize', onViewportChange);
+        window.addEventListener('scroll', onViewportChange, true);
+        var first = panel.querySelector('[role="menuitem"]');
+        if (first) first.focus({ preventScroll: true });
+      }
+
+      function handleClosed() {
+        delete panel.dataset.placement;
+        trigger.setAttribute('aria-expanded', 'false');
+        window.removeEventListener('resize', onViewportChange);
+        window.removeEventListener('scroll', onViewportChange, true);
+      }
+
+      function close(returnFocus) {
+        if (!isOpen()) return;
+        if (supportsPopover) {
+          panel.hidePopover();
+        } else {
+          panel.classList.remove('is-open');
+          handleClosed();
+        }
+        if (returnFocus) trigger.focus();
+      }
+
+      if (supportsPopover) {
+        // popovertarget handles toggling, light-dismiss and Escape natively
+        panel.addEventListener('toggle', function (e) {
+          if (e.newState === 'open') handleOpened();
+          else handleClosed();
+        });
+      } else {
+        trigger.addEventListener('click', function () {
+          if (isOpen()) return close(false);
+          panel.classList.add('is-open');
+          handleOpened();
+        });
+        document.addEventListener('click', function (e) {
+          if (!panel.contains(e.target) && !trigger.contains(e.target)) close(false);
+        });
+      }
+
+      // Keyboard navigation inside the menu
+      panel.addEventListener('keydown', function (e) {
+        var items = Array.prototype.slice.call(panel.querySelectorAll('[role="menuitem"]'));
+        var i = items.indexOf(document.activeElement);
+        if (e.key === 'ArrowDown') {
+          e.preventDefault();
+          items[(i + 1) % items.length].focus();
+        } else if (e.key === 'ArrowUp') {
+          e.preventDefault();
+          items[(i - 1 + items.length) % items.length].focus();
+        } else if (e.key === 'Home') {
+          e.preventDefault();
+          items[0].focus();
+        } else if (e.key === 'End') {
+          e.preventDefault();
+          items[items.length - 1].focus();
+        } else if (e.key === 'Escape') {
+          e.preventDefault();
+          close(true);
+        } else if (e.key === 'Tab') {
+          close(false);
+        }
+      });
+
+      panel.addEventListener('click', function (e) {
+        var item = e.target.closest('[role="menuitem"]');
+        if (!item) return;
+        close(false);
+        if (item.dataset.href) window.location.href = item.dataset.href;
+      });
+    })();
+  </script>
+
