       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Options dropdown */
+    .options-trigger {
+      /* Explicit anchor so the polyfill (no implicit anchor support) can tether the panel */
+      anchor-name: --options-trigger;
+      background: none;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      border-radius: 4px;
+      padding: 5px 12px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger::after {
+      content: " \25BE";
+    }
+
+    /* Popover lives in the top layer, so no ancestor overflow or z-index can clip it */
+    .action-panel {
+      position-anchor: --options-trigger;
+      /* Directly below the trigger, aligned to its left edge */
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 6px 0 0;
+      /* Flip vertically, horizontally, or both when the panel would overflow the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      background: none;
+      border: 0;
+      border-radius: 4px;
+      padding: 8px 12px;
+      text-align: start;
+      font: inherit;
+      font-size: 0.9rem;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+      color: var(--primary);
+    }
   </style>
