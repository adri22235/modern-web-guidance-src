+  <script>
+    (() => {
+      'use strict';
+
+      const $ = (id) => document.getElementById(id);
+
+      // Same options must be passed to availability() and create() so the
+      // browser checks for (and downloads) the right model capabilities.
+      const MODEL_OPTIONS = {
+        expectedInputs: [{ type: 'text', languages: ['en'] }],
+        expectedOutputs: [{ type: 'text', languages: ['en'] }],
+      };
+
+      const MENU_FACTS = `Menu facts (only answer about these two drinks):
+- Maple Oat Latte: espresso with steamed creamy oat milk and real Vermont maple syrup. Dairy-free as made (oat milk). Seasonal. Available hot or iced. Sizes 12oz, 16oz, 20oz. Contains oats; made in a shop that handles dairy and nuts.
+- Cold Brew: coarse-ground beans steeped in cold water for 18 hours for maximum smoothness and low acidity. Served over ice, black by default; milk or syrups can be added. Higher caffeine than drip coffee. Sizes 16oz and 24oz.`;
+
+      // Every live session is tracked here so it can be released on page exit.
+      const liveSessions = new Set();
+
+      function track(session) {
+        liveSessions.add(session);
+        return session;
+      }
+
+      function release(session) {
+        if (!session) return;
+        liveSessions.delete(session);
+        try { session.destroy(); } catch { /* already destroyed */ }
+      }
+
+      // Context-usage accessors: newer Chrome uses contextUsage/contextWindow,
+      // earlier versions used inputUsage/inputQuota.
+      const usageOf = (s) => s.contextUsage ?? s.inputUsage ?? 0;
+      const windowOf = (s) => s.contextWindow ?? s.inputQuota ?? 0;
+
+      function onOverflow(session, handler) {
+        session.addEventListener('contextoverflow', handler);
+        session.addEventListener('quotaoverflow', handler);
+      }
+
+      /**
+       * Checks model availability and reports it in the given status element.
+       * Returns the availability string, or 'unsupported' if the API is missing.
+       */
+      async function checkAvailability(statusEl) {
+        if (!('LanguageModel' in self)) {
+          statusEl.textContent = 'Built-in AI is not supported in this browser. Try a recent version of Chrome with the Prompt API enabled.';
+          return 'unsupported';
+        }
+        const availability = await LanguageModel.availability(MODEL_OPTIONS);
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'The on-device model is unavailable on this device.';
+        }
+        return availability;
+      }
+
+      /**
+       * Creates a session with download progress monitoring. Must be called from a
+       * user gesture when the model is 'downloadable' or 'downloading'.
+       */
+      async function createSession(statusEl, options = {}) {
+        const availability = await checkAvailability(statusEl);
+        if (availability === 'unsupported' || availability === 'unavailable') return null;
+
+        let progressEl = null;
+        if (availability !== 'available') {
+          statusEl.textContent = 'Downloading the on-device model…';
+          progressEl = document.createElement('progress');
+          progressEl.max = 1;
+          progressEl.value = 0;
+          statusEl.append(progressEl);
+        }
+
+        const session = await LanguageModel.create({
+          ...MODEL_OPTIONS,
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (!progressEl) return;
+              progressEl.value = e.loaded;
+              if (e.loaded >= 1) statusEl.textContent = 'Model downloaded. Preparing…';
+            });
+          },
+        });
+        statusEl.textContent = '';
+        return track(session);
+      }
+
+      const isAbort = (err) => err?.name === 'AbortError';
+
+      /* ---------------- Ask the Barista (streaming) ---------------- */
+      {
+        const askBtn = $('ask-the-barista');
+        const stopBtn = $('barista-stop');
+        const questionEl = $('barista-question');
+        const answerEl = $('barista-answer');
+        const statusEl = $('barista-status');
+
+        let baseSession = null; // holds the system prompt; cloned per question
+        let controller = null;
+
+        async function getBaseSession() {
+          if (!baseSession) {
+            baseSession = await createSession(statusEl, {
+              initialPrompts: [{
+                role: 'system',
+                content: `You are a friendly barista at The Daily Grind coffee shop. Answer briefly (2-4 sentences). ${MENU_FACTS}
+If asked about anything other than the Maple Oat Latte or Cold Brew, politely say you can only help with those two drinks.`,
+              }],
+            });
+          }
+          return baseSession;
+        }
+
+        askBtn.addEventListener('click', async () => {
+          const question = questionEl.value.trim();
+          if (!question) {
+            statusEl.textContent = 'Please type a question first.';
+            return;
+          }
+
+          controller?.abort();
+          controller = new AbortController();
+          const { signal } = controller;
+
+          askBtn.disabled = true;
+          stopBtn.disabled = false;
+          answerEl.textContent = '';
+
+          let session = null;
+          try {
+            const base = await getBaseSession();
+            if (!base) return;
+            // Clone so each question starts fresh from the system prompt without
+            // accumulating context from earlier questions.
+            session = track(await base.clone({ signal }));
+            statusEl.textContent = 'Brewing an answer…';
+
+            const stream = session.promptStreaming(question, { signal });
+            for await (const chunk of stream) {
+              answerEl.append(chunk);
+            }
+            statusEl.textContent = '';
+          } catch (err) {
+            statusEl.textContent = isAbort(err) ? 'Stopped.' : `Sorry, something went wrong: ${err.message}`;
+          } finally {
+            release(session);
+            askBtn.disabled = false;
+            stopBtn.disabled = true;
+          }
+        });
+
+        stopBtn.addEventListener('click', () => controller?.abort());
+      }
+
+      /* ---------------- Customer Feedback Analyzer (structured output) ---------------- */
+      {
+        const btn = $('sentiment-btn');
+        const inputEl = $('feedback-input');
+        const outputEl = $('sentiment-output');
+        const statusEl = $('sentiment-status');
+
+        const SENTIMENT_SCHEMA = {
+          type: 'object',
+          properties: {
+            score: { type: 'number', minimum: -1, maximum: 1 },
+            category: { type: 'string', enum: ['positive', 'neutral', 'negative', 'mixed'] },
+          },
+          required: ['score', 'category'],
+          additionalProperties: false,
+        };
+
+        let baseSession = null;
+
+        btn.addEventListener('click', async () => {
+          const feedback = inputEl.value.trim();
+          if (!feedback) {
+            statusEl.textContent = 'Please paste some feedback first.';
+            return;
+          }
+
+          btn.disabled = true;
+          outputEl.textContent = '';
+          let session = null;
+          try {
+            if (!baseSession) {
+              baseSession = await createSession(statusEl, {
+                initialPrompts: [{
+                  role: 'system',
+                  content: 'You analyze coffee shop customer feedback. Return a sentiment score from -1 (very negative) to 1 (very positive) and a category: positive, neutral, negative, or mixed.',
+                }],
+              });
+              if (!baseSession) return;
+            }
+            // Each analysis is independent, so use a throwaway clone.
+            session = track(await baseSession.clone());
+            statusEl.textContent = 'Analyzing…';
+
+            const raw = await session.prompt(`Feedback: """${feedback}"""`, {
+              responseConstraint: SENTIMENT_SCHEMA,
+              omitResponseConstraintInput: true,
+            });
+            const result = JSON.parse(raw);
+            outputEl.textContent = JSON.stringify(result, null, 2);
+            statusEl.textContent = '';
+          } catch (err) {
+            statusEl.textContent = `Analysis failed: ${err.message}`;
+          } finally {
+            release(session);
+            btn.disabled = false;
+          }
+        });
+      }
+
+      /* ---------------- Conversation Branching (clone + context tracking) ---------------- */
+      {
+        const MAX_BRANCHES = 4;
+
+        const sendBtn = $('branch-send');
+        const cloneBtn = $('clone-btn');
+        const inputEl = $('branch-input');
+        const listEl = $('branch-list');
+        const outputEl = $('branch-output');
+        const statusEl = $('branch-status');
+
+        /** @type {{id:number, name:string, session:any, transcript:string, lastUsed:number}[]} */
+        let branches = [];
+        let activeId = null;
+        let nextId = 1;
+        let busy = false;
+
+        const active = () => branches.find((b) => b.id === activeId);
+
+        function setBusy(value) {
+          busy = value;
+          sendBtn.disabled = value;
+          cloneBtn.disabled = value;
+          listEl.querySelectorAll('button').forEach((b) => { b.disabled = value; });
+        }
+
+        function addBranch(session, name, transcript = '') {
+          const branch = { id: nextId++, name, session, transcript, lastUsed: Date.now() };
+          onOverflow(session, () => {
+            statusEl.textContent = `"${branch.name}" exceeded its context window; the oldest messages were dropped.`;
+          });
+          branches.push(branch);
+          activeId = branch.id;
+          return branch;
+        }
+
+        function removeBranch(id) {
+          const branch = branches.find((b) => b.id === id);
+          if (!branch) return;
+          release(branch.session);
+          branches = branches.filter((b) => b.id !== id);
+          if (activeId === id) activeId = branches.at(-1)?.id ?? null;
+        }
+
+        // Keep resource usage bounded: drop the least-recently-used idle branches.
+        function pruneBranches() {
+          const pruned = [];
+          while (branches.length > MAX_BRANCHES) {
+            const victim = branches
+              .filter((b) => b.id !== activeId)
+              .sort((a, b) => a.lastUsed - b.lastUsed)[0];
+            if (!victim) break;
+            pruned.push(victim.name);
+            removeBranch(victim.id);
+          }
+          if (pruned.length) statusEl.textContent = `Cleaned up idle branch(es): ${pruned.join(', ')}.`;
+        }
+
+        function render() {
+          listEl.replaceChildren(...branches.map((b) => {
+            const li = document.createElement('li');
+            li.classList.toggle('active', b.id === activeId);
+
+            const label = document.createElement('span');
+            label.textContent = b.name + (b.id === activeId ? ' (active)' : '');
+
+            const used = usageOf(b.session);
+            const max = windowOf(b.session);
+            const meter = document.createElement('meter');
+            meter.min = 0;
+            meter.max = max || 1;
+            meter.value = used;
+            meter.high = (max || 1) * 0.8;
+            meter.title = `${used} / ${max} tokens`;
+
+            const usage = document.createElement('span');
+            usage.textContent = `${used}/${max} tokens`;
+
+            const switchBtn = document.createElement('button');
+            switchBtn.type = 'button';
+            switchBtn.textContent = 'Switch';
+            switchBtn.disabled = busy || b.id === activeId;
+            switchBtn.addEventListener('click', () => {
+              activeId = b.id;
+              b.lastUsed = Date.now();
+              outputEl.textContent = b.transcript;
+              render();
+            });
+
+            const closeBtn = document.createElement('button');
+            closeBtn.type = 'button';
+            closeBtn.className = 'secondary';
+            closeBtn.textContent = 'Close';
+            closeBtn.disabled = busy;
+            closeBtn.addEventListener('click', () => {
+              removeBranch(b.id);
+              outputEl.textContent = active()?.transcript ?? '';
+              render();
+            });
+
+            li.append(label, meter, usage, switchBtn, closeBtn);
+            return li;
+          }));
+        }
+
+        async function ensureRoot() {
+          if (active()) return active();
+          const session = await createSession(statusEl, {
+            initialPrompts: [{
+              role: 'system',
+              content: `You are a friendly barista at The Daily Grind. Keep replies under 80 words. ${MENU_FACTS}`,
+            }],
+          });
+          if (!session) return null;
+          const branch = addBranch(session, 'Main');
+          render();
+          return branch;
+        }
+
+        sendBtn.addEventListener('click', async () => {
+          const message = inputEl.value.trim();
+          if (!message) {
+            statusEl.textContent = 'Type a message first.';
+            return;
+          }
+          setBusy(true);
+          try {
+            const branch = await ensureRoot();
+            if (!branch) return;
+
+            // Warn before overflowing the context window.
+            const measure = branch.session.measureContextUsage ?? branch.session.measureInputUsage;
+            if (measure) {
+              const needed = await measure.call(branch.session, message);
+              if (usageOf(branch.session) + needed > windowOf(branch.session)) {
+                statusEl.textContent = 'This message will push older context out of the window. Consider cloning a fresh branch.';
+              }
+            }
+
+            branch.transcript += `You: ${message}\nBarista: `;
+            outputEl.textContent = branch.transcript;
+            inputEl.value = '';
+
+            for await (const chunk of branch.session.promptStreaming(message)) {
+              branch.transcript += chunk;
+              if (branch.id === activeId) outputEl.textContent = branch.transcript;
+            }
+            branch.transcript += '\n\n';
+            branch.lastUsed = Date.now();
+          } catch (err) {
+            statusEl.textContent = `Error: ${err.message}`;
+          } finally {
+            setBusy(false);
+            render();
+          }
+        });
+
+        cloneBtn.addEventListener('click', async () => {
+          setBusy(true);
+          try {
+            const source = await ensureRoot();
+            if (!source) return;
+            // clone() copies the full conversation state, so the new branch can
+            // diverge from this point without re-processing the history.
+            const copy = track(await source.session.clone());
+            const branch = addBranch(copy, `Branch ${nextId}`, source.transcript);
+            source.lastUsed = Date.now();
+            outputEl.textContent = branch.transcript;
+            statusEl.textContent = `Cloned "${source.name}" into "${branch.name}".`;
+            pruneBranches();
+          } catch (err) {
+            statusEl.textContent = `Clone failed: ${err.message}`;
+          } finally {
+            setBusy(false);
+            render();
+          }
+        });
+      }
+
+      // Free on-device model memory when the page goes away.
+      window.addEventListener('pagehide', () => {
+        for (const session of [...liveSessions]) release(session);
+      });
+      // Sessions were destroyed on pagehide; start clean if restored from bfcache.
+      window.addEventListener('pageshow', (e) => {
+        if (e.persisted) location.reload();
+      });
+    })();
+  </script>
+
