+  <script>
+    const FAVORITES = [
+      {
+        id: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1400&q=80',
+        alt: 'A latte with leaf-shaped latte art in a white cup',
+        meta: '12 oz · $5.25 · Seasonal',
+        desc: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso and finished with a dusting of cinnamon.'
+      },
+      {
+        id: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1400&q=80',
+        alt: 'Espresso pouring from a machine into a small glass',
+        meta: 'Double shot · $3.50 · Bold',
+        desc: 'Bold, smokey, and perfect for a morning boost. Our dark roast is slow-roasted in small batches for notes of cocoa, molasses and toasted walnut.'
+      },
+      {
+        id: 'cold-brew',
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1400&q=80',
+        alt: 'A glass of iced coffee on a table',
+        meta: '16 oz · $4.75 · Served over ice',
+        desc: 'Steeped for 18 hours for maximum smoothness. Low in acidity with a naturally sweet, chocolatey finish — great black or with a splash of cream.'
+      }
+    ];
+
+    const SITE_TITLE = document.title;
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const list = document.getElementById('thumbnail-list');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const announcer = document.getElementById('announcer');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentId = null;
+    let listScrollY = 0;
+
+    list.innerHTML = FAVORITES.map(item => `
+      <li>
+        <a class="thumbnail" href="#${item.id}" data-id="${item.id}">
+          <img src="${item.image.replace('w=1400', 'w=700')}" alt="" loading="lazy">
+          <h2 class="title">${item.title}</h2>
+        </a>
+      </li>`).join('');
+
+    const cardFor = id => list.querySelector(`.thumbnail[data-id="${id}"]`);
+
+    function nameCard(card, on) {
+      if (!card) return;
+      card.style.viewTransitionName = on ? 'hero' : '';
+      card.querySelector('.title').style.viewTransitionName = on ? 'title' : '';
+    }
+
+    function renderDetail(item) {
+      hero.src = item.image;
+      hero.alt = item.alt;
+      title.textContent = item.title;
+      document.getElementById('detail-meta').textContent = item.meta;
+      document.getElementById('detail-desc').textContent = item.desc;
+      document.getElementById('detail-order').href = `/order-online?item=${item.id}`;
+    }
+
+    function show(item, prevId) {
+      if (item) {
+        listScrollY = currentId ? listScrollY : window.scrollY;
+        renderDetail(item);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+        document.title = `${item.title} | The Daily Grind`;
+        title.focus({ preventScroll: true });
+        announcer.textContent = `${item.title} details`;
+      } else {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        window.scrollTo(0, listScrollY);
+        document.title = SITE_TITLE;
+        const card = cardFor(prevId);
+        if (card) card.focus({ preventScroll: true });
+        announcer.textContent = 'Seasonal Favorites';
+      }
+      currentId = item ? item.id : null;
+    }
+
+    function route({ animate = true } = {}) {
+      const id = decodeURIComponent(location.hash.slice(1));
+      const item = FAVORITES.find(f => f.id === id) || null;
+      // In-page anchors (e.g. the skip link) aren't routes.
+      if (!item && id && document.getElementById(id)) return;
+      const prevId = currentId;
+      if ((item && item.id) === prevId) return;
+
+      // Only morph between the list and a detail page, never detail → detail.
+      const card = cardFor(item ? item.id : prevId);
+      const canMorph = animate && document.startViewTransition &&
+        !reducedMotion.matches && card && (item ? !prevId : true);
+
+      if (!canMorph) {
+        show(item, prevId);
+        return;
+      }
+
+      // The card owns the "hero"/"title" names only while it's the morph source/target.
+      nameCard(card, true);
+      const transition = document.startViewTransition(() => show(item, prevId));
+      transition.finished.finally(() => nameCard(card, false));
+    }
+
+    list.addEventListener('click', e => {
+      const card = e.target.closest('.thumbnail');
+      if (!card || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState({ fromList: true }, '', `#${card.dataset.id}`);
+      route();
+    });
+
+    document.getElementById('back-btn').addEventListener('click', () => {
+      // Go back in history if we arrived from the list; otherwise just return to it.
+      if (history.state && history.state.fromList) {
+        history.back();
+      } else {
+        history.pushState(null, '', location.pathname + location.search);
+        route();
+      }
+    });
+
+    window.addEventListener('popstate', () => route());
+    route({ animate: false });
+  </script>
+
 </body>
 
