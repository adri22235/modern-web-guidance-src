+  <script>
+    const favorites = {
+      'maple-oat-latte': {
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1400&q=80',
+        alt: 'A latte with leaf-shaped latte art in a white cup',
+        description: 'Our house espresso pulled over steamed oat milk and finished with pure Vermont maple syrup. Velvety, gently sweet, and warming on a crisp autumn morning.',
+        price: '$5.75',
+      },
+      'dark-roast-espresso': {
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1400&q=80',
+        alt: 'A double shot of espresso with a thick golden crema',
+        description: 'A double shot of our darkest roast, with notes of cacao, toasted walnut, and a whisper of smoke. Bold, syrupy, and exactly what a slow morning needs.',
+        price: '$3.50',
+      },
+      'cold-brew': {
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1400&q=80',
+        alt: 'A glass of iced cold brew coffee',
+        description: 'Coarse-ground beans steeped in cold water for 18 hours, then served over ice. Naturally sweet, low in acidity, and remarkably smooth.',
+        price: '$4.95',
+      },
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const baseTitle = document.title;
+
+    let currentId = null;
+    let listScrollY = 0;
+    let navigatedFromList = false;
+    let activeTransition = null;
+
+    const thumbnailFor = (id) => document.querySelector(`.thumbnail[data-id="${CSS.escape(id)}"]`);
+
+    function idFromHash() {
+      const id = decodeURIComponent(location.hash.slice(1));
+      return Object.hasOwn(favorites, id) ? id : null;
+    }
+
+    function fillDetail(id) {
+      const item = favorites[id];
+      hero.src = item.image;
+      hero.alt = item.alt;
+      title.textContent = thumbnailFor(id).querySelector('.title').textContent;
+      document.getElementById('detail-description').textContent = item.description;
+      document.getElementById('detail-price').textContent = item.price;
+      document.title = `${title.textContent} | ${baseTitle}`;
+    }
+
+    async function showDetail(id) {
+      fillDetail(id);
+      // Let the hero load (briefly) so the new snapshot isn't blank
+      await Promise.race([hero.decode().catch(() => {}), new Promise((r) => setTimeout(r, 800))]);
+
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      detailPage.scrollIntoView({ block: 'start' });
+      title.focus({ preventScroll: true });
+    }
+
+    function showList(fromId) {
+      document.title = baseTitle;
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      window.scrollTo(0, listScrollY);
+      // Return focus to the card the user came from
+      const card = fromId && thumbnailFor(fromId);
+      (card || document.getElementById('list-heading')).focus({ preventScroll: true });
+    }
+
+    function render() {
+      const nextId = idFromHash();
+      const prevId = currentId;
+      if (nextId === prevId) return;
+      currentId = nextId;
+
+      if (nextId && !prevId) listScrollY = window.scrollY;
+
+      const update = () => (nextId ? showDetail(nextId) : showList(prevId));
+
+      // Only morph list <-> detail; detail -> detail just swaps
+      const morphId = nextId && prevId ? null : nextId || prevId;
+
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+
+      if (!document.startViewTransition) {
+        update();
+        return;
+      }
+
+      // Name the clicked card before the transition so it pairs with #hero / #title
+      if (morphId) thumbnailFor(morphId).classList.add('selected');
+
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+      transition.finished.finally(() => {
+        // A newer transition may have started; leave its names alone
+        if (activeTransition !== transition) return;
+        activeTransition = null;
+        document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+      });
+    }
+
+    document.querySelector('.thumbnail-list').addEventListener('click', (event) => {
+      const card = event.target.closest('.thumbnail');
+      if (!card || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+      navigatedFromList = true;
+    });
+
+    document.getElementById('back').addEventListener('click', () => {
+      if (navigatedFromList) {
+        navigatedFromList = false;
+        history.back();
+      } else {
+        // Arrived directly on a detail URL: go to the list without leaving the site
+        history.pushState(null, '', location.pathname + location.search);
+        render();
+      }
+    });
+
+    window.addEventListener('hashchange', render);
+    window.addEventListener('popstate', render);
+
+    // Initial state (deep link to a detail view) without animation
+    currentId = idFromHash();
+    if (currentId) {
+      fillDetail(currentId);
+      listPage.hidden = true;
+      detailPage.hidden = false;
+    }
+  </script>
+
 </body>
 
