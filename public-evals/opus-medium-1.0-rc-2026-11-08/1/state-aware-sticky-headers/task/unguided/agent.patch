+  <script>
+    // Fallback for browsers that don't support CSS scroll-state container queries.
+    if (!CSS.supports('container-type: scroll-state')) {
+      const containers = document.querySelectorAll('.sticky-container');
+      const update = () => {
+        const navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height'));
+        containers.forEach((el) => {
+          const section = el.parentElement.getBoundingClientRect();
+          const top = el.getBoundingClientRect().top;
+          el.classList.toggle('is-stuck', top <= navHeight + 0.5 && section.top < navHeight);
+        });
+      };
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    }
+  </script>
