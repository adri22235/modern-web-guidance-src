     }
 
+    /* Sticky section headers */
+    .menu-section {
+      /* Stuck state changes padding; prevent scroll-anchoring oscillation */
+      overflow-anchor: none;
+      margin-bottom: 48px;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the site nav */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so it can't collide with other containers */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      font-size: 1.5rem;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s, border-radius 0.3s;
+    }
+
+    .sticky-header small {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: normal;
+      opacity: 0.8;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        box-shadow: 0 4px 12px rgb(0 0 0 / 0.25);
+        padding: 0.5rem 1.5rem;
+        border-radius: 0 0 8px 8px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .sticky-header {
+        transition: none;
+      }
+    }
+
     .card {
