+  <script>
+    (function () {
+      var accordion = document.querySelector('#coffee-faq .accordion');
+      if (!accordion) return;
+      var items = accordion.querySelectorAll('.accordion-item');
+
+      function setOpen(item, open) {
+        item.classList.toggle('is-open', open);
+        item.querySelector('.accordion-trigger').setAttribute('aria-expanded', String(open));
+      }
+
+      accordion.addEventListener('click', function (event) {
+        var trigger = event.target.closest('.accordion-trigger');
+        if (!trigger) return;
+        var current = trigger.closest('.accordion-item');
+        var willOpen = !current.classList.contains('is-open');
+        items.forEach(function (item) {
+          setOpen(item, item === current && willOpen);
+        });
+      });
+    })();
+  </script>
