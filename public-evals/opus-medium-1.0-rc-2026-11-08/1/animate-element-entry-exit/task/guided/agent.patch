+  <script>
+    const promoContainer = document.getElementById('domContainer');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+
+    const promos = [
+      { title: 'Buy One, Get One', text: 'Bring a friend: second drink free on Fridays.', img: 'photo-1442512595331-e89e73853f31', alt: 'Two cups of coffee on a table' },
+      { title: 'Pastry Pairing', text: 'Add any pastry to a coffee for just $2.', img: 'photo-1517433670267-08bbd4be890f', alt: 'Coffee with a croissant' },
+      { title: 'Double Rewards', text: 'Earn 2x stars on every cold brew this week.', img: 'photo-1461023058943-07fcbe16d735', alt: 'Iced coffee in a glass' },
+      { title: 'Bean Bundle', text: 'Save 20% on any two bags of whole beans.', img: 'photo-1447933601403-0c6688de566e', alt: 'Roasted coffee beans' }
+    ];
+    let promoCount = 0;
+
+    // Firefox parses allow-discrete but doesn't transition display (bug 1882408), so probe for real support
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000))
+        ]);
+      }
+
+      // Skipped if showElement() cancelled the close mid-animation
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      el.dataset.removing = '';
+      await hideElement(el);
+      el.remove();
+    }
+
+    function createPromoCard() {
+      const promo = promos[promoCount % promos.length];
+      promoCount++;
+
+      const card = document.createElement('article');
+      card.className = 'card promo-card';
+
+      const img = document.createElement('img');
+      img.src = `https://images.unsplash.com/${promo.img}?auto=format&fit=crop&w=600&q=80`;
+      img.alt = promo.alt;
+      img.loading = 'lazy';
+
+      const body = document.createElement('div');
+      body.className = 'promo-body';
+
+      const tag = document.createElement('span');
+      tag.className = 'promo-tag';
+      tag.textContent = `Promo #${promoCount}`;
+
+      const title = document.createElement('h3');
+      title.textContent = promo.title;
+
+      const text = document.createElement('p');
+      text.textContent = promo.text;
+
+      body.append(tag, title, text);
+      card.append(img, body);
+      return card;
+    }
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      promoContainer.appendChild(createPromoCard());
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      // The featured card is managed by the toggle button, and cards already exiting are skipped
+      const cards = promoContainer.querySelectorAll('.card:not(#toggleCard):not([data-removing])');
+      const last = cards[cards.length - 1];
+      if (last) removeElement(last);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const isShown = !toggleCard.hidden && !toggleCard.hasAttribute('data-closing');
+      if (isShown) {
+        hideElement(toggleCard);
+      } else {
+        showElement(toggleCard);
+      }
+      toggleBtn.setAttribute('aria-expanded', String(!isShown));
+      toggleBtn.textContent = isShown ? 'Show Featured Promo' : 'Hide Featured Promo';
+    });
+  </script>
+
