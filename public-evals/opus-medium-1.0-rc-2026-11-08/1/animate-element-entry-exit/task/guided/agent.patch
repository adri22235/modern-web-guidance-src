+
+    /* Entry: transition FROM these values when first rendered or un-hidden */
+    @starting-style {
+      .promo-card {
+        opacity: 0;
+        scale: 0.8;
+      }
+    }
+
+    /* Exit: transition TO these values before hiding/removal */
+    .promo-card:where([hidden], [data-closing]) {
