+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var toggleCard = document.getElementById('toggleCard');
+      var TRANSITION_MS = 350;
+
+      var promos = [
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink.', img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80', alt: 'Fresh croissants' },
+        { title: 'Cold Brew Combo', text: 'Two cold brews for $8 all week long.', img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Iced coffee in a glass' },
+        { title: 'Double Rewards Points', text: 'Earn 2x points on every espresso drink.', img: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80', alt: 'Espresso shot being pulled' },
+        { title: 'Beans to Go', text: '15% off any bag of house-roasted beans.', img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' }
+      ];
+      var promoIndex = 0;
+
+      // Run cb once the card's transition finishes (with a timeout fallback).
+      function afterTransition(card, cb) {
+        var done = false;
+        function finish(e) {
+          if (done || (e && (e.target !== card || e.propertyName !== 'opacity'))) return;
+          done = true;
+          card.removeEventListener('transitionend', finish);
+          clearTimeout(timer);
+          cb();
+        }
+        var timer = setTimeout(finish, TRANSITION_MS + 100);
+        card.addEventListener('transitionend', finish);
+        return function cancel() {
+          done = true;
+          card.removeEventListener('transitionend', finish);
+          clearTimeout(timer);
+        };
+      }
+
+      function enter(card) {
+        if (card._cancelExit) { card._cancelExit(); card._cancelExit = null; }
+        card.classList.remove('is-leaving');
+        card.hidden = false;
+        card.classList.add('is-entering');
+        void card.offsetWidth; // force reflow so the transition runs
+        card.classList.remove('is-entering');
+      }
+
+      function exit(card, onDone) {
+        if (card.classList.contains('is-leaving')) return;
+        card.classList.add('is-leaving');
+        card._cancelExit = afterTransition(card, function () {
+          card._cancelExit = null;
+          onDone();
+        });
+      }
+
+      function removableCards() {
+        return Array.prototype.filter.call(container.querySelectorAll('.card'), function (c) {
+          return c !== toggleCard && !c.classList.contains('is-leaving');
+        });
+      }
+
+      function updateButtons() {
+        removeBtn.disabled = removableCards().length === 0;
+        var shown = !toggleCard.hidden && !toggleCard.classList.contains('is-leaving');
+        toggleBtn.textContent = shown ? 'Hide Featured Promo' : 'Show Featured Promo';
+        toggleBtn.setAttribute('aria-expanded', String(shown));
+      }
+
+      addBtn.addEventListener('click', function () {
+        var p = promos[promoIndex++ % promos.length];
+        var card = document.createElement('div');
+        card.className = 'card';
+        var img = document.createElement('img');
+        img.src = p.img;
+        img.alt = p.alt;
+        img.loading = 'lazy';
+        var h3 = document.createElement('h3');
+        h3.textContent = p.title;
+        var text = document.createElement('p');
+        text.textContent = p.text;
+        card.append(img, h3, text);
+        container.appendChild(card);
+        enter(card);
+        updateButtons();
+      });
+
+      removeBtn.addEventListener('click', function () {
+        var cards = removableCards();
+        var last = cards[cards.length - 1];
+        if (!last) return;
+        exit(last, function () { last.remove(); });
+        updateButtons();
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        if (toggleCard.hidden || toggleCard.classList.contains('is-leaving')) {
+          enter(toggleCard);
+        } else {
+          exit(toggleCard, function () {
+            toggleCard.hidden = true;
+            toggleCard.classList.remove('is-leaving');
+          });
+        }
+        updateButtons();
+      });
+
+      updateButtons();
+    })();
+  </script>
