--- a/index.html
+++ b/index.html
@@ -152,6 +152,83 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* ------------------------------------------------------------
+       Progressive enhancements
+       Everything below is gated on newer CSS @-rules. Browsers that
+       don't support them keep the base styles above unchanged.
+       ------------------------------------------------------------ */
+
+    /* Navigation: compact bar once it sticks (scroll-state container queries).
+       at-rule() can't detect query types, so test the matching container-type. */
+    @supports (container-type: scroll-state) {
+      nav {
+        container-type: scroll-state;
+      }
+
+      .logo,
+      nav a {
+        transition: font-size 0.3s, letter-spacing 0.3s, color 0.3s;
+      }
+
+      @container scroll-state(stuck: top) {
+        .logo {
+          font-size: 1.2rem;
+          letter-spacing: 3px;
+        }
+
+        nav a {
+          font-size: 0.85rem;
+        }
+      }
+    }
+
+    /* Hero: fade/slide the headline in on first render (@starting-style).
+       Browsers without @starting-style ignore the block and show the text immediately. */
+    @media (prefers-reduced-motion: no-preference) {
+      .hero > * {
+        transition: opacity 0.8s ease-out, translate 0.8s ease-out;
+
+        @starting-style {
+          opacity: 0;
+          translate: 0 1rem;
+        }
+      }
+
+      .hero p {
+        transition-delay: 0.15s;
+      }
+
+      .hero .btn {
+        transition-delay: 0.3s, 0.3s, 0s;
+        transition-property: opacity, translate, background;
+      }
+    }
+
+    /* Seasonal favorite cards: tinted accent + hover lift via a custom @function.
+       Custom-function calls are invalid at computed-value time where unsupported,
+       so the declarations must be gated rather than left to the cascade. */
+    @function --tint(--color <color>, --amount <percentage>: 85%) returns <color> {
+      result: color-mix(in oklab, var(--color), white var(--amount));
+    }
+
+    @supports (color: --tint(red)) {
+      .card {
+        border-top: 4px solid var(--accent);
+        background: linear-gradient(to bottom, --tint(var(--accent)), white 40%);
+        transition: translate 0.3s, box-shadow 0.3s;
+
+        &:hover,
+        &:focus-within {
+          translate: 0 -4px;
+          box-shadow: 0 8px 20px --tint(var(--primary), 60%);
+        }
+
+        .btn:hover {
+          background: --tint(var(--primary), 15%);
+        }
+      }
+    }
   </style>
 </head>
 
