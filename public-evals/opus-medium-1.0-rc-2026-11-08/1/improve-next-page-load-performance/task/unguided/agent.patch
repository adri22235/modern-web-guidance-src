+
+  <!--
+    Prefetch same-origin links so the next page loads faster.
+    Excluded: logout (state-changing), anything marked rel="nofollow"/"external",
+    links with data-no-prefetch, and non-GET-safe or download links.
+  -->
+  <script type="speculationrules">
+  {
+    "prefetch": [
+      {
+        "where": {
+          "and": [
+            { "href_matches": "/*" },
+            { "not": { "href_matches": "/logout" } },
+            { "not": { "href_matches": "/logout/*" } },
+            { "not": { "href_matches": "/*?*logout*" } },
+            { "not": { "selector_matches": ".logout-link" } },
+            { "not": { "selector_matches": "[data-no-prefetch]" } },
+            { "not": { "selector_matches": "[download]" } },
+            { "not": { "selector_matches": "[rel~=nofollow]" } },
+            { "not": { "selector_matches": "[target=_blank]" } }
+          ]
+        },
+        "eagerness": "moderate"
+      }
+    ]
+  }
+  </script>
+  <script>
+    // Fallback for browsers without Speculation Rules support:
+    // add <link rel="prefetch"> when the user shows intent (hover/focus/touch).
+    (function () {
+      if (HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) return;
+      var conn = navigator.connection;
+      if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
+
+      var prefetched = new Set();
+      var EXCLUDE = /^\/logout(\/|$)/i;
+
+      function shouldPrefetch(a) {
+        if (!a || !a.href) return false;
+        if (a.matches('.logout-link, [data-no-prefetch], [download], [rel~="nofollow"], [target="_blank"]')) return false;
+        var url;
+        try { url = new URL(a.href, location.href); } catch (e) { return false; }
+        if (url.origin !== location.origin) return false;
+        if (!/^https?:$/.test(url.protocol)) return false;
+        if (EXCLUDE.test(url.pathname) || /logout/i.test(url.search)) return false;
+        if (url.pathname === location.pathname && url.search === location.search) return false;
+        return !prefetched.has(url.href);
+      }
+
+      function prefetch(a) {
+        if (!shouldPrefetch(a)) return;
+        var href = new URL(a.href, location.href).href;
+        prefetched.add(href);
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = href;
+        document.head.appendChild(link);
+      }
+
+      var timer;
+      function onIntent(e) {
+        var a = e.target.closest && e.target.closest('a[href]');
+        if (!a) return;
+        clearTimeout(timer);
+        if (e.type === 'mouseover') {
+          timer = setTimeout(function () { prefetch(a); }, 65);
+        } else {
+          prefetch(a);
+        }
+      }
+
+      document.addEventListener('mouseover', onIntent, { passive: true });
+      document.addEventListener('mouseout', function () { clearTimeout(timer); }, { passive: true });
+      document.addEventListener('touchstart', onIntent, { passive: true });
+      document.addEventListener('focusin', onIntent);
+    })();
+  </script>
