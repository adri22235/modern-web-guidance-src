+  <script>
+    (function () {
+      // Site hierarchy: each path maps to its label and (optionally) a parent path.
+      var pages = {
+        '/': { label: 'Home' },
+        '/menu': { label: 'Menu', parent: '/' },
+        '/menu/seasonal-favorites': { label: 'Seasonal Favorites', parent: '/menu', href: '/#seasonal-favorites' },
+        '/menu/seasonal': { label: 'Maple Oat Latte', parent: '/menu/seasonal-favorites' },
+        '/menu/espresso': { label: 'Dark Roast Espresso', parent: '/menu/seasonal-favorites' },
+        '/menu/cold-brew': { label: 'Cold Brew', parent: '/menu/seasonal-favorites' },
+        '/locations': { label: 'Locations', parent: '/' },
+        '/rewards': { label: 'Rewards', parent: '/' },
+        '/account': { label: 'My Account', parent: '/' },
+        '/order-online': { label: 'Order Online', parent: '/' },
+        '/about': { label: 'Our Story', parent: '/' },
+        '/careers': { label: 'Join the Team', parent: '/' },
+        '/contact': { label: 'Contact Us', parent: '/' },
+        '/privacy-policy': { label: 'Privacy', parent: '/' }
+      };
+
+      function titleCase(slug) {
+        return decodeURIComponent(slug).replace(/[-_]+/g, ' ').replace(/\b\w/g, function (c) {
+          return c.toUpperCase();
+        });
+      }
+
+      // Fallback for unknown paths: derive the trail from URL segments.
+      function resolve(path) {
+        if (pages[path]) return pages[path];
+        var idx = path.lastIndexOf('/');
+        return { label: titleCase(path.slice(idx + 1)), parent: path.slice(0, idx) || '/' };
+      }
+
+      var path = window.location.pathname.replace(/\/index\.html?$/, '').replace(/\/+$/, '') || '/';
+      var trail = [];
+      for (var p = path; p; p = resolve(p).parent) {
+        trail.unshift({ path: p, page: resolve(p) });
+        if (p === '/') break;
+      }
+
+      var list = document.getElementById('breadcrumb-list');
+      list.innerHTML = '';
+      trail.forEach(function (item, i) {
+        var li = document.createElement('li');
+        var el;
+        if (i === trail.length - 1) {
+          el = document.createElement('span');
+          el.setAttribute('aria-current', 'page');
+        } else {
+          el = document.createElement('a');
+          el.href = item.page.href || item.path;
+        }
+        el.textContent = item.page.label;
+        li.appendChild(el);
+        list.appendChild(li);
+      });
+    })();
+  </script>
+
 </body>
 
