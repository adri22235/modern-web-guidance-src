diff --git a/js/drink-card.js b/js/drink-card.js
new file mode 100644
index 0000000..b4ec932
--- /dev/null
+++ b/js/drink-card.js
@@ -0,0 +1,247 @@
+/**
+ * <drink-card> — encapsulated menu card for The Daily Grind.
+ *
+ * Theme:   Reads the page's coffee palette (--primary, --secondary, --accent,
+ *          --text, --light) through the shadow boundary via inherited custom
+ *          properties. Per-card overrides: --drink-card-bg, --drink-card-accent,
+ *          --drink-card-radius, --drink-card-shadow, --drink-card-padding.
+ * Variants: variant="classic" (default) | "featured" | "limited"
+ * Slots:   media, title, (default) description, meta, action
+ * Parts:   card, media, body, badge, title, description, meta, actions
+ * Attrs:   badge="Text" renders a ribbon exposed as ::part(badge)
+ */
+(() => {
+  const css = /* css */ `
+    /* Priority tiers, lowest to highest. Unlayered page styles (::part,
+       ::slotted targets, host selectors) always win over everything here. */
+    @layer reset, tokens, base, layout, variants, states;
+
+    @layer reset {
+      *, *::before, *::after { box-sizing: border-box; }
+      [hidden] { display: none !important; }
+    }
+
+    @layer tokens {
+      :host {
+        /* Private tokens: public override -> site theme -> hard fallback */
+        --_primary: var(--drink-card-primary, var(--primary, #4e342e));
+        --_secondary: var(--secondary, #d7ccc8);
+        --_accent: var(--drink-card-accent, var(--accent, #ffab40));
+        --_text: var(--text, #3e2723);
+        --_bg: var(--drink-card-bg, #fff);
+        --_radius: var(--drink-card-radius, 8px);
+        --_shadow: var(--drink-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+        --_pad: var(--drink-card-padding, 20px);
+        --_border: 1px solid transparent;
+      }
+    }
+
+    @layer base {
+      :host {
+        display: block;
+        /* Each card is its own size container, so the layout reacts to the
+           card's width — not the viewport. */
+        container: drink-card / inline-size;
+        color: var(--_text);
+        text-align: center;
+      }
+      :host([hidden]) { display: none; }
+
+      .card {
+        position: relative;
+        height: 100%;
+        overflow: hidden;
+        background: var(--_bg);
+        border: var(--_border);
+        border-radius: var(--_radius);
+        box-shadow: var(--_shadow);
+        transition: transform 0.25s ease, box-shadow 0.25s ease;
+      }
+
+      .media {
+        aspect-ratio: 16 / 10;
+        background: var(--_secondary);
+        overflow: hidden;
+      }
+      .card:not(.has-media) .media { display: none; }
+
+      ::slotted([slot="media"]) {
+        display: block;
+        width: 100%;
+        height: 100%;
+        object-fit: cover;
+      }
+
+      .body {
+        padding: var(--_pad);
+        display: flex;
+        flex-direction: column;
+        gap: 10px;
+      }
+
+      .badge {
+        position: absolute;
+        top: 12px;
+        inset-inline-start: 12px;
+        z-index: 1;
+        padding: 2px 10px;
+        border-radius: 999px;
+        background: var(--_accent);
+        color: var(--_primary);
+        font-size: 0.75rem;
+        font-weight: 700;
+        letter-spacing: 0.05em;
+        text-transform: uppercase;
+      }
+
+      /* Defaults for projected content — the page can override any of these */
+      ::slotted([slot="title"]) {
+        margin: 0;
+        color: var(--_primary);
+        font-size: 1.2rem;
+        line-height: 1.3;
+      }
+      ::slotted(:not([slot])) { margin: 0; }
+      .meta { font-size: 0.8rem; opacity: 0.75; }
+      .meta:not(.has-content) { display: none; }
+      .actions { margin-top: auto; }
+    }
+
+    @layer layout {
+      /* Wide cards (e.g. a featured card spanning the grid) go side-by-side */
+      @container drink-card (min-width: 520px) {
+        .card.has-media {
+          display: grid;
+          grid-template-columns: minmax(200px, 2fr) 3fr;
+        }
+        .card.has-media .media { aspect-ratio: auto; min-height: 100%; }
+        .body {
+          justify-content: center;
+          text-align: start;
+          padding: calc(var(--_pad) * 1.5);
+        }
+        ::slotted([slot="title"]) { font-size: 1.6rem; }
+      }
+
+      /* Very narrow cards tighten up */
+      @container drink-card (max-width: 260px) {
+        .body { padding: calc(var(--_pad) * 0.7); gap: 6px; }
+        ::slotted([slot="title"]) { font-size: 1.05rem; }
+        .media { aspect-ratio: 4 / 3; }
+      }
+    }
+
+    @layer variants {
+      :host([variant="featured"]) {
+        --_bg: var(--drink-card-bg, linear-gradient(160deg, #fff 55%, color-mix(in srgb, var(--_accent) 18%, #fff)));
+        --_border: 2px solid var(--_accent);
+        --_shadow: var(--drink-card-shadow, 0 8px 24px rgb(0 0 0 / 0.15));
+      }
+
+      :host([variant="limited"]) {
+        --_bg: var(--drink-card-bg, var(--_primary));
+        --_text: var(--light, #fafafa);
+        --_border: 1px dashed var(--_accent);
+      }
+      :host([variant="limited"]) ::slotted([slot="title"]) { color: var(--_accent); }
+      :host([variant="limited"]) .badge { background: var(--light, #fafafa); }
+
+      :host([variant="classic"]),
+      :host(:not([variant])) {
+        --_border: 1px solid color-mix(in srgb, var(--_secondary) 60%, transparent);
+      }
+    }
+
+    @layer states {
+      :host(:hover) .card,
+      :host(:focus-within) .card {
+        transform: translateY(-3px);
+        box-shadow: 0 10px 24px rgb(0 0 0 / 0.18);
+      }
+      :host(:focus-within) .card {
+        outline: 3px solid var(--_accent);
+        outline-offset: 2px;
+      }
+      @media (prefers-reduced-motion: reduce) {
+        .card { transition: none; }
+        :host(:hover) .card,
+        :host(:focus-within) .card { transform: none; }
+      }
+    }
+  `;
+
+  const template = document.createElement('template');
+  template.innerHTML = `
+    <article class="card" part="card">
+      <span class="badge" part="badge" hidden></span>
+      <div class="media" part="media"><slot name="media"></slot></div>
+      <div class="body" part="body">
+        <div class="title" part="title"><slot name="title"></slot></div>
+        <div class="description" part="description"><slot></slot></div>
+        <div class="meta" part="meta"><slot name="meta"></slot></div>
+        <div class="actions" part="actions"><slot name="action"></slot></div>
+      </div>
+    </article>
+  `;
+
+  // One parsed stylesheet shared by every instance when supported.
+  let sharedSheet = null;
+  try {
+    sharedSheet = new CSSStyleSheet();
+    sharedSheet.replaceSync(css);
+  } catch {
+    sharedSheet = null;
+  }
+
+  class DrinkCard extends HTMLElement {
+    static observedAttributes = ['badge'];
+
+    constructor() {
+      super();
+      const root = this.attachShadow({ mode: 'open' });
+      if (sharedSheet && 'adoptedStyleSheets' in root) {
+        root.adoptedStyleSheets = [sharedSheet];
+      } else {
+        const style = document.createElement('style');
+        style.textContent = css;
+        root.append(style);
+      }
+      root.append(template.content.cloneNode(true));
+
+      this._card = root.querySelector('.card');
+      this._badge = root.querySelector('.badge');
+      this._meta = root.querySelector('.meta');
+
+      const mediaSlot = root.querySelector('slot[name="media"]');
+      const metaSlot = root.querySelector('slot[name="meta"]');
+      mediaSlot.addEventListener('slotchange', () => this._syncMedia(mediaSlot));
+      metaSlot.addEventListener('slotchange', () => {
+        this._meta.classList.toggle('has-content', metaSlot.assignedNodes().length > 0);
+      });
+    }
+
+    attributeChangedCallback(name, _old, value) {
+      if (name === 'badge') {
+        this._badge.textContent = value ?? '';
+        this._badge.hidden = !value;
+      }
+    }
+
+    _syncMedia(slot) {
+      const nodes = slot.assignedElements();
+      const update = () => {
+        const ok = nodes.some((el) => !(el instanceof HTMLImageElement) || !el.complete || el.naturalWidth > 0);
+        this._card.classList.toggle('has-media', ok);
+      };
+      // Collapse the media area if a stock photo fails to load.
+      nodes.forEach((el) => {
+        if (el instanceof HTMLImageElement) el.addEventListener('error', update, { once: true });
+      });
+      update();
+    }
+  }
+
+  if (!customElements.get('drink-card')) {
+    customElements.define('drink-card', DrinkCard);
+  }
+})();
