+  <script type="module">
+    // <drink-card>: encapsulated Seasonal Favorites card.
+    // Theme: reads the page tokens (--primary, --secondary, --accent, --text, --light) and
+    //   per-card overrides (--card-bg, --card-fg, --card-accent, --card-radius, --card-shadow)
+    //   through inherited custom properties.
+    // Slots: media, title, (default) description, price, action.
+    // Parts: card, media, badge, body, footer, price.
+    // Variants: variant="featured" | "limited" (default otherwise).
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      @layer reset, tokens, base, layout, variants, states;
+
+      @layer reset {
+        *, *::before, *::after { box-sizing: border-box; margin: 0; }
+      }
+
+      @layer tokens {
+        :host {
+          /* Private aliases: public props stay unset so they inherit from anywhere up the tree */
+          --_brand: var(--card-brand, var(--primary, #4e342e));
+          --_accent: var(--card-accent, var(--accent, #ffab40));
+          --_bg: var(--card-bg, white);
+          --_fg: var(--card-fg, var(--text, #3e2723));
+          --_muted: var(--card-muted, var(--secondary, #d7ccc8));
+          --_radius: var(--card-radius, 8px);
+          --_shadow: var(--card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+          --_pad: var(--card-padding, 20px);
+        }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          container: drink-card / inline-size;
+          background: var(--_bg);
+          color: var(--_fg);
+          border-radius: var(--_radius);
+          box-shadow: var(--_shadow);
+          overflow: clip;
+          transition: box-shadow 0.3s, translate 0.3s;
+        }
+
+        :host([hidden]) { display: none; }
+
+        .card { position: relative; height: 100%; }
+
+        .media { aspect-ratio: 4 / 3; background: var(--_muted); overflow: clip; }
+
+        ::slotted(img) {
+          display: block;
+          width: 100%;
+          height: 100%;
+          object-fit: cover;
+        }
+
+        .badge {
+          position: absolute;
+          inset-block-start: 12px;
+          inset-inline-start: 12px;
+          padding: 2px 10px;
+          border-radius: 999px;
+          background: var(--_accent);
+          color: var(--_brand);
+          font-size: 0.75rem;
+          font-weight: 700;
+        }
+
+        .badge:empty { display: none; }
+
+        .body { padding: var(--_pad); text-align: center; }
+
+        .title { color: var(--_brand); margin-block-end: 10px; }
+
+        .footer {
+          display: flex;
+          flex-wrap: wrap;
+          align-items: center;
+          justify-content: center;
+          gap: 4px 16px;
+        }
+
+        .price { color: var(--_brand); font-weight: 700; margin-block-start: 15px; }
+
+        ::slotted([slot="title"]) { margin: 0; }
+      }
+
+      @layer layout {
+        /* Narrow cards: tighten everything */
+        @container drink-card (max-width: 260px) {
+          .body { padding: calc(var(--_pad) * 0.75); }
+          .footer { flex-direction: column; gap: 0; }
+        }
+
+        /* Wide cards: media beside the content */
+        @container drink-card (min-width: 560px) {
+          .card {
+            display: grid;
+            grid-template-columns: minmax(200px, 2fr) 3fr;
+          }
+          .media { aspect-ratio: auto; min-height: 100%; }
+          .body {
+            display: flex;
+            flex-direction: column;
+            justify-content: center;
+            text-align: start;
+            padding: calc(var(--_pad) * 1.5);
+          }
+          .footer { justify-content: flex-start; }
+        }
+
+        @container drink-card (min-width: 800px) {
+          .card { grid-template-columns: 1fr 1fr; }
+          .body { padding: calc(var(--_pad) * 2.5); }
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          box-shadow: 0 0 0 2px var(--_accent), var(--_shadow);
+        }
+
+        :host([variant="limited"]) {
+          --_bg: var(--card-bg, var(--primary, #4e342e));
+          --_fg: var(--card-fg, var(--light, #fafafa));
+          --_brand: var(--card-brand, var(--light, #fafafa));
+          --_muted: var(--card-muted, var(--text, #3e2723));
+        }
+
+        :host([variant="limited"]) .price { color: var(--_accent); }
+      }
+
+      @layer states {
+        :host(:hover), :host(:focus-within) {
+          box-shadow: 0 8px 20px rgb(0 0 0 / 0.15);
+          translate: 0 -2px;
+        }
+
+        :host([variant="featured"]:hover), :host([variant="featured"]:focus-within) {
+          box-shadow: 0 0 0 2px var(--_accent), 0 8px 20px rgb(0 0 0 / 0.15);
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          :host { transition: none; }
+          :host(:hover), :host(:focus-within) { translate: none; }
+        }
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div class="media" part="media"><slot name="media"></slot></div>
+        <span class="badge" part="badge"></span>
+        <div class="body" part="body">
+          <div class="title"><slot name="title"></slot></div>
+          <slot></slot>
+          <div class="footer" part="footer">
+            <span class="price" part="price"><slot name="price"></slot></span>
+            <slot name="action"></slot>
+          </div>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['badge'];
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+        this.#badge = this.shadowRoot.querySelector('.badge');
+        this.#media = this.shadowRoot.querySelector('.media');
+        this.#price = this.shadowRoot.querySelector('.price');
+
+        // Collapse optional wrappers when nothing is projected into them
+        this.#media.firstElementChild.addEventListener('slotchange', (e) => {
+          this.#media.hidden = e.target.assignedElements().length === 0;
+        });
+        this.#price.firstElementChild.addEventListener('slotchange', (e) => {
+          this.#price.hidden = e.target.assignedNodes().length === 0;
+        });
+        this.#media.hidden = true;
+        this.#price.hidden = true;
+      }
+
+      #badge;
+      #media;
+      #price;
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (name === 'badge') this.#badge.textContent = newValue ?? '';
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </head>
 
