+      justify-content: center;
+      gap: 30px;
+    }
+
+    .barista-feature .bio {
+      max-width: 420px;
+    }
+
+    .barista-feature h3 {
+      color: var(--primary);
+    }
+
+    .shaped-avatar {
+      width: 240px;
+      aspect-ratio: 1;
+      height: auto;
+      object-fit: cover;
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .promo-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 30px;
+      justify-content: center;
+      align-items: stretch;
+      margin-top: 50px;
+    }
+
+    .unified-card {
+      display: flex;
+      width: min(100%, 460px);
+      /* Shadow on the parent silhouettes the body + masked accent as one shape */
+      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.3));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 24px;
+      border-top-left-radius: 16px;
+      border-bottom-left-radius: 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-accent {
+      width: 70px;
+      /* Same background as .card-body so the two merge without a seam */
+      background-color: var(--primary);
+      border-top-right-radius: 16px;
+      border-bottom-right-radius: 16px;
+      -webkit-mask-image: url(#accent-stencil);
+      mask-image: url(#accent-stencil);
+    }
+
+    .gradient-masked-card {
+      width: min(100%, 320px);
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: var(--text);
+      /* Extra top padding keeps content clear of the notch */
+      padding: 48px 24px 24px;
+      border-radius: 16px;
+      text-align: center;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+    }
+
+    .gradient-masked-card h3 {
+      margin-bottom: 8px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
