+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .barista-feature {
+      display: flex;
+      flex-wrap: wrap;
