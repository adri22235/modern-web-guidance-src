+  <script type="module">
+    // Customer reviews may contain rich HTML from untrusted users. All review
+    // markup goes through the browser's Sanitizer API (setHTML), with a
+    // lazily loaded DOMPurify fallback for browsers without native support.
+    const ALLOWED_ELEMENTS = ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'ul', 'ol', 'li', 'blockquote', 'a'];
+    const ALLOWED_ATTRIBUTES = ['href'];
+    const STORAGE_KEY = 'daily-grind-reviews';
+
+    const SEED_REVIEWS = [
+      {
+        drink: 'Maple Oat Latte',
+        name: 'Priya',
+        body: '<p><strong>Autumn in a cup!</strong> The maple is subtle, not too sweet.</p>',
+        date: '2026-10-28'
+      },
+      {
+        drink: 'Dark Roast Espresso',
+        name: 'Marcus',
+        body: '<p>Exactly what I need before work:</p><ul><li>Rich crema</li><li>Smokey finish</li></ul>',
+        date: '2026-11-02'
+      },
+      {
+        drink: 'Cold Brew',
+        name: 'Elena',
+        body: '<blockquote>Smoothest cold brew in town.</blockquote><p>Try it with a splash of oat milk. <em>Trust me.</em></p>',
+        date: '2026-11-05'
+      }
+    ];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      // Only downloaded in browsers that lack the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES } });
+      } else {
+        try {
+          const DOMPurify = await loadDOMPurify();
+          el.innerHTML = DOMPurify.sanitize(html, {
+            ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+            ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false
+          });
+        } catch {
+          // Sanitizer unavailable: never render markup, show it as plain text.
+          el.textContent = html;
+          return;
+        }
+      }
+
+      // User-submitted links should never pass referrer/opener or SEO credit.
+      for (const link of el.querySelectorAll('a[href]')) {
+        link.rel = 'nofollow ugc noopener noreferrer';
+        link.target = '_blank';
+      }
+    }
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (Array.isArray(stored)) return stored;
+      } catch { /* fall through to seed data */ }
+      return [...SEED_REVIEWS];
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch { /* storage full or disabled; keep in memory only */ }
+    }
+
+    const reviews = loadReviews();
+    const list = document.getElementById('review-list');
+    const form = document.getElementById('review-form');
+    const status = document.getElementById('review-status');
+    const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+    async function createReviewItem(review) {
+      const item = document.createElement('li');
+      item.className = 'review';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const drink = document.createElement('span');
+      drink.className = 'review-drink';
+      drink.textContent = review.drink;
+
+      const byline = document.createElement('span');
+      const time = document.createElement('time');
+      time.dateTime = review.date;
+      time.textContent = dateFormat.format(new Date(`${review.date}T00:00:00`));
+      byline.append(`${review.name} · `, time);
+
+      meta.append(drink, byline);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, review.body);
+
+      item.append(meta, body);
+      return item;
+    }
+
+    function updateCounts() {
+      for (const el of document.querySelectorAll('[data-review-count]')) {
+        const count = reviews.filter((r) => r.drink === el.dataset.reviewCount).length;
+        el.textContent = `${count} review${count === 1 ? '' : 's'}`;
+      }
+    }
+
+    async function renderReviews() {
+      const items = await Promise.all([...reviews].reverse().map(createReviewItem));
+      list.replaceChildren(...items);
+      updateCounts();
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const review = {
+        drink: data.get('drink'),
+        name: data.get('name').trim(),
+        body: data.get('review').trim(),
+        date: new Date().toISOString().slice(0, 10)
+      };
+
+      reviews.push(review);
+      saveReviews(reviews);
+      list.prepend(await createReviewItem(review));
+      updateCounts();
+
+      form.reset();
+      status.textContent = `Thanks, ${review.name}! Your review of the ${review.drink} was posted.`;
+    });
+
+    renderReviews();
+  </script>
+
