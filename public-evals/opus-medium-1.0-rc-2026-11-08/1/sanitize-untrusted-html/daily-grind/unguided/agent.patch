@@ -0,0 +1,355 @@
+/*
+ * Customer reviews for the Seasonal Favorites section.
+ *
+ * Reviews may contain a small subset of rich HTML (bold, italics, lists,
+ * links, ...). All review markup is treated as untrusted: it is parsed into an
+ * inert document with DOMParser (no scripts run, no resources load), then
+ * walked against a strict allowlist and rebuilt node-by-node in the live
+ * document. Markup is never written back via innerHTML, so there is no
+ * serialize/re-parse round trip for mutation-XSS to exploit.
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'dailyGrind.reviews.v1';
+  var MAX_BODY_LENGTH = 2000;
+  var MAX_NAME_LENGTH = 60;
+  var MAX_DEPTH = 16;
+
+  var DRINKS = {
+    'maple-oat-latte': 'Maple Oat Latte',
+    'dark-roast-espresso': 'Dark Roast Espresso',
+    'cold-brew': 'Cold Brew'
+  };
+
+  // Elements that are kept (with their children). Attributes are dropped
+  // unless listed in ALLOWED_ATTRS for that tag.
+  var ALLOWED_TAGS = {
+    B: true, STRONG: true, I: true, EM: true, U: true, S: true, MARK: true,
+    SMALL: true, SUB: true, SUP: true, P: true, BR: true, UL: true, OL: true,
+    LI: true, BLOCKQUOTE: true, CODE: true, PRE: true, A: true, SPAN: true
+  };
+
+  var ALLOWED_ATTRS = {
+    A: { href: true, title: true }
+  };
+
+  // Elements removed together with all of their content. Anything that is
+  // neither allowed nor listed here is "unwrapped": the tag is discarded but
+  // its (sanitized) children are kept.
+  var DROP_WITH_CONTENT = {
+    SCRIPT: true, STYLE: true, IFRAME: true, FRAME: true, FRAMESET: true,
+    OBJECT: true, EMBED: true, APPLET: true, TEMPLATE: true, NOSCRIPT: true,
+    NOEMBED: true, NOFRAMES: true, SVG: true, MATH: true, FORM: true,
+    INPUT: true, BUTTON: true, SELECT: true, TEXTAREA: true, OPTION: true,
+    LINK: true, META: true, BASE: true, TITLE: true, HEAD: true, IMG: true,
+    VIDEO: true, AUDIO: true, SOURCE: true, TRACK: true, PICTURE: true,
+    CANVAS: true, DIALOG: true, PORTAL: true, XMP: true, PLAINTEXT: true
+  };
+
+  var SAFE_URL_PROTOCOLS = { 'http:': true, 'https:': true, 'mailto:': true };
+
+  function safeUrl(value) {
+    // Strip control characters and whitespace that browsers ignore inside
+    // schemes (e.g. "java\tscript:").
+    var cleaned = String(value).replace(/[\u0000- \u007f-\u009f]/g, '');
+    if (!cleaned) return null;
+    try {
+      var url = new URL(cleaned, window.location.href);
+      return SAFE_URL_PROTOCOLS[url.protocol] ? url.href : null;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  function sanitizeChildren(sourceParent, targetParent, depth) {
+    var child = sourceParent.firstChild;
+    while (child) {
+      sanitizeNode(child, targetParent, depth);
+      child = child.nextSibling;
+    }
+  }
+
+  function sanitizeNode(node, targetParent, depth) {
+    if (node.nodeType === Node.TEXT_NODE) {
+      targetParent.appendChild(document.createTextNode(node.nodeValue));
+      return;
+    }
+    // Comments, processing instructions, CDATA, etc. are discarded.
+    if (node.nodeType !== Node.ELEMENT_NODE) return;
+
+    // Only HTML-namespace elements are considered; foreign content is dropped.
+    if (node.namespaceURI !== 'http://www.w3.org/1999/xhtml') return;
+
+    var tag = node.tagName.toUpperCase();
+    if (DROP_WITH_CONTENT[tag]) return;
+
+    if (depth >= MAX_DEPTH) {
+      // Excessively nested markup: keep only the text.
+      targetParent.appendChild(document.createTextNode(node.textContent || ''));
+      return;
+    }
+
+    if (!ALLOWED_TAGS[tag]) {
+      sanitizeChildren(node, targetParent, depth + 1);
+      return;
+    }
+
+    // Build a fresh element in the live document rather than importing the
+    // parsed node, so nothing but allowlisted attributes can carry over.
+    var clean = document.createElement(tag.toLowerCase());
+    var allowedAttrs = ALLOWED_ATTRS[tag] || {};
+
+    for (var i = 0; i < node.attributes.length; i++) {
+      var attr = node.attributes[i];
+      var name = attr.name.toLowerCase();
+      if (!allowedAttrs[name]) continue;
+
+      if (name === 'href') {
+        var href = safeUrl(attr.value);
+        if (href) clean.setAttribute('href', href);
+      } else {
+        clean.setAttribute(name, attr.value);
+      }
+    }
+
+    if (tag === 'A') {
+      if (clean.hasAttribute('href')) {
+        clean.setAttribute('target', '_blank');
+        clean.setAttribute('rel', 'noopener noreferrer nofollow ugc');
+      }
+    }
+
+    sanitizeChildren(node, clean, depth + 1);
+    targetParent.appendChild(clean);
+  }
+
+  /**
+   * Parse untrusted HTML and return a DocumentFragment that contains only
+   * allowlisted elements and attributes.
+   */
+  function sanitizeHtml(untrusted) {
+    var fragment = document.createDocumentFragment();
+    var parsed = new DOMParser().parseFromString(
+      '<!DOCTYPE html><html><body>' + String(untrusted || ''),
+      'text/html'
+    );
+    if (parsed.body) sanitizeChildren(parsed.body, fragment, 0);
+    return fragment;
+  }
+
+  // ---- Storage -------------------------------------------------------------
+
+  var SEED_REVIEWS = [
+    {
+      drink: 'maple-oat-latte',
+      name: 'Priya',
+      rating: 5,
+      body: '<p>Tastes like <strong>autumn in a cup</strong>. The maple is subtle, not syrupy.</p>',
+      date: '2026-10-28T09:12:00Z'
+    },
+    {
+      drink: 'dark-roast-espresso',
+      name: 'Marcus',
+      rating: 4,
+      body: '<p>Bold and smoky. My go-to for:</p><ul><li>Early shifts</li><li><em>Very</em> early shifts</li></ul>',
+      date: '2026-10-30T07:45:00Z'
+    },
+    {
+      drink: 'cold-brew',
+      name: 'Jo',
+      rating: 5,
+      body: '<p>Silky smooth, zero bitterness. <u>Worth the 18 hours.</u></p>',
+      date: '2026-11-02T14:20:00Z'
+    }
+  ];
+
+  function isValidReview(r) {
+    return r && typeof r === 'object' &&
+      Object.prototype.hasOwnProperty.call(DRINKS, r.drink) &&
+      typeof r.name === 'string' && typeof r.body === 'string' &&
+      typeof r.rating === 'number' && r.rating >= 1 && r.rating <= 5;
+  }
+
+  function loadReviews() {
+    try {
+      var raw = window.localStorage.getItem(STORAGE_KEY);
+      if (raw === null) return SEED_REVIEWS.slice();
+      var data = JSON.parse(raw);
+      return Array.isArray(data) ? data.filter(isValidReview) : SEED_REVIEWS.slice();
+    } catch (e) {
+      return SEED_REVIEWS.slice();
+    }
+  }
+
+  function saveReviews(reviews) {
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+    } catch (e) {
+      /* storage unavailable (private mode, quota) - keep in memory only */
+    }
+  }
+
+  // ---- Rendering -----------------------------------------------------------
+
+  function stars(rating) {
+    var n = Math.max(1, Math.min(5, Math.round(rating)));
+    return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
+  }
+
+  function formatDate(iso) {
+    var d = new Date(iso);
+    return isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, {
+      year: 'numeric', month: 'short', day: 'numeric'
+    });
+  }
+
+  function renderReview(review) {
+    var article = document.createElement('article');
+    article.className = 'review';
+
+    var header = document.createElement('header');
+    header.className = 'review-header';
+
+    var who = document.createElement('strong');
+    who.textContent = review.name || 'Anonymous';
+
+    var drink = document.createElement('span');
+    drink.className = 'review-drink';
+    drink.textContent = DRINKS[review.drink];
+
+    var rating = document.createElement('span');
+    rating.className = 'review-rating';
+    rating.textContent = stars(review.rating);
+    rating.setAttribute('aria-label', review.rating + ' out of 5 stars');
+
+    var date = document.createElement('time');
+    date.className = 'review-date';
+    date.textContent = formatDate(review.date);
+    if (review.date) date.setAttribute('datetime', review.date);
+
+    header.appendChild(who);
+    header.appendChild(drink);
+    header.appendChild(rating);
+    header.appendChild(date);
+
+    var body = document.createElement('div');
+    body.className = 'review-body';
+    body.appendChild(sanitizeHtml(review.body));
+
+    article.appendChild(header);
+    article.appendChild(body);
+    return article;
+  }
+
+  function init() {
+    var list = document.getElementById('review-list');
+    var form = document.getElementById('review-form');
+    var filter = document.getElementById('review-filter');
+    var bodyInput = document.getElementById('review-body');
+    var preview = document.getElementById('review-preview');
+    var counter = document.getElementById('review-char-count');
+    var status = document.getElementById('review-status');
+    if (!list || !form) return;
+
+    var reviews = loadReviews();
+
+    function updateCardSummaries() {
+      Object.keys(DRINKS).forEach(function (key) {
+        var el = document.querySelector('[data-review-summary="' + key + '"]');
+        if (!el) return;
+        var mine = reviews.filter(function (r) { return r.drink === key; });
+        if (!mine.length) {
+          el.textContent = 'No reviews yet';
+          return;
+        }
+        var avg = mine.reduce(function (s, r) { return s + r.rating; }, 0) / mine.length;
+        el.textContent = stars(avg) + ' ' + avg.toFixed(1) + ' (' + mine.length +
+          (mine.length === 1 ? ' review)' : ' reviews)');
+      });
+    }
+
+    function renderList() {
+      var selected = filter.value;
+      var visible = reviews
+        .filter(function (r) { return selected === 'all' || r.drink === selected; })
+        .sort(function (a, b) { return String(b.date).localeCompare(String(a.date)); });
+
+      list.replaceChildren();
+      if (!visible.length) {
+        var empty = document.createElement('p');
+        empty.className = 'review-empty';
+        empty.textContent = 'No reviews yet. Be the first!';
+        list.appendChild(empty);
+      } else {
+        visible.forEach(function (r) { list.appendChild(renderReview(r)); });
+      }
+      updateCardSummaries();
+    }
+
+    function updatePreview() {
+      counter.textContent = bodyInput.value.length + ' / ' + MAX_BODY_LENGTH;
+      preview.replaceChildren(sanitizeHtml(bodyInput.value));
+    }
+
+    bodyInput.setAttribute('maxlength', String(MAX_BODY_LENGTH));
+    bodyInput.addEventListener('input', updatePreview);
+    filter.addEventListener('change', renderList);
+
+    document.querySelectorAll('[data-review-drink]').forEach(function (link) {
+      link.addEventListener('click', function () {
+        var key = link.getAttribute('data-review-drink');
+        filter.value = key;
+        form.elements.drink.value = key;
+        renderList();
+      });
+    });
+
+    form.addEventListener('submit', function (event) {
+      event.preventDefault();
+      var drink = form.elements.drink.value;
+      var name = form.elements.name.value.trim().slice(0, MAX_NAME_LENGTH);
+      var rating = parseInt(form.elements.rating.value, 10);
+      var body = bodyInput.value.trim().slice(0, MAX_BODY_LENGTH);
+
+      // Reject reviews with no visible text once sanitized.
+      if (!sanitizeHtml(body).textContent.trim()) {
+        status.textContent = 'Please write a few words about your drink.';
+        return;
+      }
+
+      var review = {
+        drink: drink,
+        name: name || 'Anonymous',
+        rating: rating,
+        // The raw markup is stored; it is sanitized every time it is
+        // rendered so tightening the allowlist also protects old reviews.
+        body: body,
+        date: new Date().toISOString()
+      };
+      if (!isValidReview(review)) {
+        status.textContent = 'Please complete all fields.';
+        return;
+      }
+
+      reviews.push(review);
+      saveReviews(reviews);
+      form.reset();
+      updatePreview();
+      filter.value = drink;
+      renderList();
+      status.textContent = 'Thanks! Your review of ' + DRINKS[drink] + ' has been posted.';
+    });
+
+    updatePreview();
+    renderList();
+  }
+
+  window.DailyGrindReviews = { sanitizeHtml: sanitizeHtml };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
