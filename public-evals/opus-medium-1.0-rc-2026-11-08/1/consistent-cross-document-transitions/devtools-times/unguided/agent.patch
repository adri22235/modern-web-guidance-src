+}
+
+/* ---------- Page transitions (cross-document view transitions) ---------- */
+
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition {
+    navigation: auto;
+  }
+}
+
+/*
+ * Names are only applied while a transition is running (see Layout.astro),
+ * so they never create stacking contexts that would trap header flyouts.
+ */
+.vt-active #site-header {
+  view-transition-name: site-header;
+}
+.vt-active #page-content {
+  view-transition-name: page-content;
+}
+
+/* Everything outside header/content: quick crossfade. */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 200ms;
+}
+
+/* The masthead is shared by every page: keep it rock steady. */
+::view-transition-group(site-header) {
+  animation: none;
+}
+::view-transition-old(site-header) {
+  display: none;
+}
+::view-transition-new(site-header) {
+  animation: none;
+}
+
+/* Page content: fade + subtle slide, direction depends on navigation depth. */
+::view-transition-group(page-content) {
+  animation-duration: 340ms;
+  animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
+}
+::view-transition-old(page-content) {
+  animation: 160ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+::view-transition-new(page-content) {
+  animation: 340ms cubic-bezier(0, 0, 0.2, 1) 60ms both vt-fade-in;
+}
+
+html[data-vt-direction="forward"]::view-transition-old(page-content) {
+  animation-name: vt-fade-out, vt-slide-to-left;
+}
+html[data-vt-direction="forward"]::view-transition-new(page-content) {
+  animation-name: vt-fade-in, vt-slide-from-right;
+}
+html[data-vt-direction="backward"]::view-transition-old(page-content) {
+  animation-name: vt-fade-out, vt-slide-to-right;
+}
+html[data-vt-direction="backward"]::view-transition-new(page-content) {
+  animation-name: vt-fade-in, vt-slide-from-left;
+}
+html[data-vt-direction="lateral"]::view-transition-new(page-content) {
+  animation-name: vt-fade-in, vt-rise;
+}
+
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+@keyframes vt-fade-in {
+  from { opacity: 0; }
+}
+@keyframes vt-slide-to-left {
+  to { transform: translateX(-32px); }
+}
+@keyframes vt-slide-from-right {
+  from { transform: translateX(32px); }
+}
+@keyframes vt-slide-to-right {
+  to { transform: translateX(32px); }
+}
+@keyframes vt-slide-from-left {
+  from { transform: translateX(-32px); }
+}
+@keyframes vt-rise {
+  from { transform: translateY(12px); }
+}
