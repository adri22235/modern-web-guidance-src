+}
+/* ---------------------------------------------------------------------------
+ * Cross-document page transitions
+ * Pages opt in here; Layout.astro holds the first render with
+ * <link rel="expect" blocking="render"> until above-the-fold content is parsed.
+ * Unsupported browsers simply navigate as usual.
+ * ------------------------------------------------------------------------- */
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition {
+    navigation: auto;
+  }
+}
+
+/* The masthead is identical on every page: keep it in place while the page
+ * content beneath it transitions. The name is only applied while a transition
+ * is running, because view-transition-name creates a stacking context and
+ * backdrop root that would trap the header's flyouts and blur overlays. */
+:root:active-view-transition #site-header {
+  view-transition-name: site-header;
+}
+
+::view-transition-group(site-header) {
+  animation-duration: 0s;
+}
+
+::view-transition-old(root) {
+  animation: 180ms ease-in both page-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 320ms cubic-bezier(0.2, 0, 0, 1) 80ms both page-fade-in;
+}
+
+@keyframes page-fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes page-fade-in {
+  from {
+    opacity: 0;
+    translate: 0 12px;
+  }
+}
