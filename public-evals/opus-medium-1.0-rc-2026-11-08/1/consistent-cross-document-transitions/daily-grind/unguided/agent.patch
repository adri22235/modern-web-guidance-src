+  <!--
+    Hold the first render (and therefore the incoming view transition) until the
+    parser has reached the end of the "Seasonal Favorites" section. The header,
+    hero and seasonal cards are guaranteed to be in place, while the footer is
+    not waited on. Styles and scripts in <head> are render-blocking already.
+  -->
+  <link rel="expect" href="#above-the-fold-end" blocking="render">
   <style>
+    /* Cross-document view transitions (same-origin navigations) */
+    @view-transition {
+      navigation: auto;
+    }
+
+    nav {
+      view-transition-name: site-nav;
+    }
+
+    .hero {
+      view-transition-name: hero;
+    }
+
+    ::view-transition-group(site-nav) {
+      animation: none;
+    }
+
+    ::view-transition-old(root) {
+      animation: 250ms ease-in both page-fade-out;
+    }
+
+    ::view-transition-new(root) {
+      animation: 300ms ease-out 50ms both page-fade-in;
+    }
+
+    @keyframes page-fade-out {
+      to {
+        opacity: 0;
+        transform: translateY(-8px);
+      }
+    }
+
+    @keyframes page-fade-in {
+      from {
+        opacity: 0;
+        transform: translateY(8px);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
+
