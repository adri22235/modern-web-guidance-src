+  <script>
+    (function () {
+      // Mutual exclusivity fallback for browsers without <details name> support.
+      var tabs = document.querySelectorAll('.wholesale-tab');
+      tabs.forEach(function (tab) {
+        tab.addEventListener('toggle', function () {
+          if (!tab.open) return;
+          tabs.forEach(function (other) {
+            if (other !== tab) other.open = false;
+          });
+        });
+      });
+
+      // Coupon reveal: panel uses hidden="until-found" so find-in-page can match and reveal it.
+      var btn = document.getElementById('coupon-btn');
+      var panel = document.getElementById('coupon-panel');
+      function markRevealed() {
+        btn.setAttribute('aria-expanded', 'true');
+        btn.textContent = 'Coupon Revealed';
+      }
+      btn.addEventListener('click', function () {
+        panel.hidden = false;
+        markRevealed();
+      });
+      // Fired when browser search reveals the panel.
+      panel.addEventListener('beforematch', markRevealed);
+    })();
+  </script>
+
