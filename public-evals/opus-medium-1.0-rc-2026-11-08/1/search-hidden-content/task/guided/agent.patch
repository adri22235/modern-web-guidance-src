+  <script type="module">
+    // Wholesale & Catering tabs
+    const tabs = [...document.querySelectorAll('.wholesale-tab')];
+    const panelFor = (tab) => document.querySelector(`[role="tabpanel"][aria-labelledby="${tab.id}"]`);
+
+    function selectTab(selected) {
+      for (const tab of tabs) {
+        const isSelected = tab === selected;
+        const panel = panelFor(tab);
+        tab.ariaSelected = String(isSelected);
+        tab.toggleAttribute('focusgroupstart', isSelected);
+        panel.hidden = isSelected ? false : 'until-found';
+        if (isSelected) panel.tabIndex = 0;
+        else panel.removeAttribute('tabindex');
+      }
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }
+
+    for (const tab of tabs) {
+      // Selection follows focus (arrow keys move focus via focusgroup)
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('focus', () => selectTab(tab));
+    }
+
+    // Find-in-page matched text inside a hidden panel: make its tab the selected one
+    document.querySelector('.tab-panels').addEventListener('beforematch', (e) => {
+      const panel = e.target.closest('[role="tabpanel"]');
+      const tab = tabs.find((t) => panelFor(t) === panel);
+      if (tab) selectTab(tab);
+    });
+
+    // Coupon reveal
+    const couponButton = document.getElementById('coupon-button');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function revealCoupon() {
+      couponPanel.hidden = false;
+      couponButton.ariaExpanded = 'true';
+      couponButton.textContent = 'Coupon Revealed';
+    }
+
+    couponButton.addEventListener('click', revealCoupon);
+    couponPanel.addEventListener('beforematch', revealCoupon);
+
+    // Without hidden="until-found" support the coupon would be unsearchable, so show it up front
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      revealCoupon();
+    }
+
+    // Arrow-key navigation for browsers without native focusgroup
+    if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
+      const { polyfill } = await import('https://esm.sh/@microsoft/focusgroup-polyfill');
+      polyfill();
+    }
+  </script>
+
