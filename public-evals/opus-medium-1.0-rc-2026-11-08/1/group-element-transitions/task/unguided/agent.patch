+  <script>
+    (() => {
+      const img = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=160&h=160&q=70`;
+
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral · Citrus', price: 18.5, img: img('1559056199-641a0ac8b55e') },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel · Red apple', price: 16.0, img: img('1447933601403-0c6688de566e') },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy · Cocoa', price: 17.0, img: img('1511537190424-bbbab87ac5eb') },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Spice · Chocolate', price: 16.5, img: img('1442512595331-e89e73853f31') },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant · Bright', price: 19.0, img: img('1514432324607-a09d9b4aefdd') },
+        { id: 'house', name: 'House Espresso Blend', notes: 'Bold · Smokey', price: 15.0, img: img('1495474472287-4d71bcdd2085') },
+      ];
+
+      const board = document.getElementById('bean-board');
+      const catalog = document.getElementById('bean-catalog');
+      const selectionList = document.getElementById('bean-selection');
+      const empty = document.getElementById('bean-empty');
+      const total = document.getElementById('bean-total');
+      const catalogCount = document.getElementById('catalog-count');
+      const selectionCount = document.getElementById('selection-count');
+      const checkout = document.getElementById('bean-checkout');
+
+      const selected = new Set(['ethiopia']);
+      const items = new Map();
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Build each item once and move the same node between lists, so focus
+      // and identity are preserved and the transition can track it.
+      for (const bean of BEANS) {
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.id = bean.id;
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.innerHTML = `
+          <div class="bean-thumb"><img src="${bean.img}" alt="" loading="lazy"></div>
+          <div class="bean-info">
+            <strong>${bean.name}</strong>
+            <span class="bean-meta">${bean.notes} · ${currency.format(bean.price)}</span>
+          </div>
+          <button type="button" class="bean-toggle"></button>`;
+        li.querySelector('img').addEventListener('error', (e) => e.target.remove());
+        items.set(bean.id, li);
+      }
+
+      function render() {
+        let sum = 0;
+        for (const bean of BEANS) {
+          const li = items.get(bean.id);
+          const isSelected = selected.has(bean.id);
+          const btn = li.querySelector('.bean-toggle');
+          btn.textContent = isSelected ? '−' : '+';
+          btn.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+          (isSelected ? selectionList : catalog).appendChild(li);
+          if (isSelected) sum += bean.price;
+        }
+        const n = selected.size;
+        empty.hidden = n > 0;
+        total.textContent = currency.format(sum);
+        catalogCount.textContent = `${BEANS.length - n} available`;
+        selectionCount.textContent = `${n} ${n === 1 ? 'bag' : 'bags'}`;
+        checkout.disabled = n === 0;
+      }
+
+      // FLIP fallback for browsers without element-scoped view transitions.
+      // Uses the Web Animations API, which never blocks page input.
+      function flip(update) {
+        const nodes = [...items.values(), empty];
+        const before = new Map(nodes.map((el) => [el, el.getBoundingClientRect()]));
+        update();
+        for (const el of nodes) {
+          const a = before.get(el);
+          const b = el.getBoundingClientRect();
+          if (!b.width) continue;
+          if (!a.width) {
+            el.animate([{ opacity: 0, transform: 'scale(0.96)' }, { opacity: 1, transform: 'none' }],
+              { duration: 300, easing: 'ease-out' });
+            continue;
+          }
+          const dx = a.left - b.left;
+          const dy = a.top - b.top;
+          const sx = a.width / b.width;
+          const sy = a.height / b.height;
+          if (!dx && !dy && sx === 1 && sy === 1) continue;
+          el.animate(
+            [
+              { transformOrigin: 'top left', transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
+              { transformOrigin: 'top left', transform: 'none' },
+            ],
+            { duration: 450, easing: 'cubic-bezier(0.2, 0, 0, 1)' }
+          );
+        }
+      }
+
+      function transition(update) {
+        if (reduceMotion.matches) return update();
+        // Element-scoped view transition: only the board is captured, so
+        // the nav, hero and other sections remain fully interactive while
+        // every bean animates to its new position at the same time.
+        if (typeof board.startViewTransition === 'function') {
+          board.startViewTransition(update);
+        } else {
+          flip(update);
+        }
+      }
+
+      board.addEventListener('click', (e) => {
+        const btn = e.target.closest('.bean-toggle');
+        if (!btn) return;
+        const id = btn.closest('.bean-item').dataset.id;
+        transition(() => {
+          selected.has(id) ? selected.delete(id) : selected.add(id);
+          render();
+          btn.focus({ preventScroll: true });
+        });
+      });
+
+      checkout.addEventListener('click', () => {
+        const ids = [...selected].join(',');
+        window.location.href = `/order-online?beans=${encodeURIComponent(ids)}`;
+      });
+
+      render();
+    })();
+  </script>
+
