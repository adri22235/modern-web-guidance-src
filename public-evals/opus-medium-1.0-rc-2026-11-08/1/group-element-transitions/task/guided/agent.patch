+  <template id="bean-template">
+    <li class="bean">
+      <span class="bean-swatch" aria-hidden="true"></span>
+      <div>
+        <div class="bean-name"></div>
+        <div class="bean-meta"></div>
+      </div>
+      <button type="button" class="bean-action"></button>
+    </li>
+  </template>
+
+  <script>
+    (() => {
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', roast: 'Light', notes: 'Jasmine, lemon', price: 18, color: '#b07a4f' },
+        { id: 'kenya', name: 'Kenya AA', roast: 'Light', notes: 'Blackcurrant, grapefruit', price: 19, color: '#a8724a' },
+        { id: 'colombia', name: 'Colombia Huila', roast: 'Medium', notes: 'Caramel, red apple', price: 16, color: '#8a5a36' },
+        { id: 'guatemala', name: 'Guatemala Antigua', roast: 'Medium', notes: 'Cocoa, toffee', price: 16, color: '#7f522f' },
+        { id: 'brazil', name: 'Brazil Santos', roast: 'Medium-Dark', notes: 'Hazelnut, milk chocolate', price: 14, color: '#6b4226' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', roast: 'Dark', notes: 'Cedar, dark chocolate', price: 17, color: '#4a2c1a' },
+        { id: 'espresso', name: 'House Espresso Blend', roast: 'Dark', notes: 'Molasses, smoke', price: 15, color: '#3b2314' },
+      ];
+
+      const picker = document.getElementById('bean-picker');
+      const available = document.getElementById('available-beans');
+      const selected = document.getElementById('selected-beans');
+      const empty = document.getElementById('bean-empty');
+      const availableCount = document.getElementById('available-count');
+      const selectedCount = document.getElementById('selected-count');
+      const total = document.getElementById('bean-total');
+      const checkout = document.getElementById('bean-checkout');
+      const template = document.getElementById('bean-template');
+      const byId = new Map(BEANS.map((bean, index) => [bean.id, { ...bean, index }]));
+
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+      const supportsDocument = 'startViewTransition' in document;
+
+      // Prefer a transition scoped to the picker so the rest of the page is
+      // untouched; fall back to a document transition, then to no animation.
+      function withTransition(update) {
+        let transition;
+        if (supportsScoped) {
+          transition = picker.startViewTransition(update);
+        } else if (supportsDocument) {
+          transition = document.startViewTransition(update);
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the running transition; ignore that rejection.
+        transition.ready.catch(() => {});
+      }
+
+      // moveBefore() keeps focus on the moved button; insertBefore() is the fallback.
+      function move(parent, node, before = null) {
+        if (parent.moveBefore) parent.moveBefore(node, before);
+        else parent.insertBefore(node, before);
+      }
+
+      function setAction(item, isSelected) {
+        const { name } = byId.get(item.dataset.id);
+        const button = item.querySelector('.bean-action');
+        button.textContent = isSelected ? 'Remove' : 'Add';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${name}`);
+      }
+
+      function updateSummary() {
+        const items = [...selected.children];
+        const sum = items.reduce((acc, item) => acc + byId.get(item.dataset.id).price, 0);
+        empty.hidden = items.length > 0;
+        availableCount.textContent = `${available.children.length} left`;
+        selectedCount.textContent = `${items.length} selected`;
+        total.textContent = `Total: $${sum.toFixed(2)}`;
+        checkout.setAttribute('aria-disabled', String(items.length === 0));
+      }
+
+      function toggle(item) {
+        const isSelected = item.parentElement === selected;
+        const button = item.querySelector('.bean-action');
+        const hadFocus = item.contains(document.activeElement);
+        // Keep keyboard users in the list they're working through.
+        const nextFocus =
+          item.nextElementSibling?.querySelector('.bean-action') ??
+          item.previousElementSibling?.querySelector('.bean-action') ??
+          button;
+
+        withTransition(() => {
+          if (isSelected) {
+            const index = byId.get(item.dataset.id).index;
+            const before = [...available.children].find(
+              (other) => byId.get(other.dataset.id).index > index
+            );
+            move(available, item, before ?? null);
+          } else {
+            move(selected, item);
+          }
+          setAction(item, !isSelected);
+          updateSummary();
+          if (hadFocus) nextFocus.focus();
+        });
+      }
+
+      for (const bean of BEANS) {
+        const item = template.content.firstElementChild.cloneNode(true);
+        item.dataset.id = bean.id;
+        item.style.viewTransitionName = `bean-${bean.id}`;
+        item.querySelector('.bean-swatch').style.setProperty('--roast', bean.color);
+        item.querySelector('.bean-name').textContent = bean.name;
+        item.querySelector('.bean-meta').textContent = `${bean.roast} roast · ${bean.notes} · $${bean.price}`;
+        setAction(item, false);
+        available.append(item);
+      }
+      updateSummary();
+
+      picker.addEventListener('click', (event) => {
+        const button = event.target.closest('.bean-action');
+        if (button) toggle(button.closest('.bean'));
+      });
+
+      checkout.addEventListener('click', (event) => {
+        if (checkout.getAttribute('aria-disabled') === 'true') event.preventDefault();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
