@@ -0,0 +1,64 @@
+// Minimal client-side view switching for links marked with `data-route`.
+import { noteViewSwitch } from './perf-monitor.js';
+
+const VIEWS = {
+  '/menu': ['Menu', 'Espresso classics, pour-overs, teas, and fresh pastries baked every morning.'],
+  '/locations': ['Locations', 'Find a Daily Grind cafe near you, open 6am to 8pm every day.'],
+  '/rewards': ['Rewards', 'Earn a bean for every dollar spent and redeem them for free drinks.'],
+  '/account': ['My Account', 'Manage your profile, saved orders, and payment methods.'],
+  '/order-online': ['Order Online', 'Pick your drink, customize it, and skip the line at pickup.'],
+  '/menu/seasonal': ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup. Available through winter.'],
+  '/menu/espresso': ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost. Pulled as a double shot.'],
+  '/menu/cold-brew': ['Cold Brew', 'Steeped for 18 hours for maximum smoothness. Served over ice.'],
+};
+
+const HOME_TITLE = document.title;
+const homeView = document.getElementById('home-view');
+const routeView = document.getElementById('route-view');
+
+function render(path, triggerEvent) {
+  if (path === '/') {
+    homeView.hidden = false;
+    routeView.hidden = true;
+    document.title = HOME_TITLE;
+  } else {
+    const [title, body] = VIEWS[path] ?? ['Page Not Found', "We couldn't find that page."];
+    const heading = document.createElement('h1');
+    heading.textContent = title;
+    heading.tabIndex = -1;
+    const text = document.createElement('p');
+    text.textContent = body;
+    const back = document.createElement('a');
+    back.href = '/';
+    back.className = 'btn';
+    back.dataset.route = '';
+    back.textContent = 'Back to Home';
+
+    routeView.replaceChildren(heading, text, back);
+    homeView.hidden = true;
+    routeView.hidden = false;
+    document.title = `${title} | The Daily Grind`;
+    heading.focus({ preventScroll: true });
+  }
+  window.scrollTo(0, 0);
+  if (triggerEvent) noteViewSwitch(location.href, triggerEvent);
+}
+
+document.addEventListener('click', (event) => {
+  const link = event.target.closest('a[data-route]');
+  if (
+    !link ||
+    event.defaultPrevented ||
+    event.button !== 0 ||
+    event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
+  ) return;
+
+  event.preventDefault();
+  const url = new URL(link.href);
+  if (url.pathname !== location.pathname) history.pushState(null, '', url);
+  render(url.pathname, event);
+});
+
+window.addEventListener('popstate', (event) => render(location.pathname, event));
+
+if (location.pathname !== '/' && location.pathname !== '/index.html') render(location.pathname);
