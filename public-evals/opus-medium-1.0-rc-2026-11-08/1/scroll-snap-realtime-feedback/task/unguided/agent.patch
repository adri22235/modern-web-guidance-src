+  <script>
+    (function () {
+      var gallery = document.getElementById('gallery');
+      if (!gallery) return;
+      var slides = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-item'));
+      var thumbs = Array.prototype.slice.call(document.querySelectorAll('.gallery-thumb'));
+      var activeIndex = 0;
+      var pendingIndex = -1;
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        pendingIndex = index;
+        thumbs.forEach(function (t, i) {
+          t.classList.toggle('pending', i === index && index !== activeIndex);
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0) return;
+        activeIndex = index;
+        pendingIndex = -1;
+        thumbs.forEach(function (t, i) {
+          var on = i === index;
+          t.classList.toggle('active', on);
+          t.classList.remove('pending');
+          if (on) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      // Fallback: nearest slide to the scroller's center.
+      function nearestIndex() {
+        var center = gallery.scrollLeft + gallery.clientWidth / 2;
+        var best = 0, bestDist = Infinity;
+        slides.forEach(function (s, i) {
+          var d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - center);
+          if (d < bestDist) { bestDist = d; best = i; }
+        });
+        return best;
+      }
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          setPending(i);
+          var left = slides[i].offsetLeft;
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          gallery.scrollTo({ left: left, behavior: reduce ? 'auto' : 'smooth' });
+        });
+      });
+
+      var supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+      var supportsSnapChange = 'onscrollsnapchange' in gallery;
+      var supportsScrollEnd = 'onscrollend' in gallery;
+
+      if (supportsSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          var i = slides.indexOf(e.snapTargetInline);
+          if (i >= 0) setPending(i);
+        });
+      }
+
+      if (supportsSnapChange) {
+        gallery.addEventListener('scrollsnapchange', function (e) {
+          setActive(slides.indexOf(e.snapTargetInline));
+        });
+      }
+
+      // Fallback detection for browsers lacking either snap event.
+      if (!supportsSnapChanging || !supportsSnapChange) {
+        var settleTimer;
+        var settle = function () {
+          if (!supportsSnapChange) setActive(nearestIndex());
+        };
+        gallery.addEventListener('scroll', function () {
+          if (!supportsSnapChanging) setPending(nearestIndex());
+          if (!supportsScrollEnd) {
+            clearTimeout(settleTimer);
+            settleTimer = setTimeout(settle, 150);
+          }
+        }, { passive: true });
+        if (supportsScrollEnd) gallery.addEventListener('scrollend', settle);
+      }
+
+      // Keep the active slide in view if the layout width changes.
+      window.addEventListener('resize', function () {
+        gallery.scrollTo({ left: slides[activeIndex].offsetLeft, behavior: 'auto' });
+      });
+
+      setActive(nearestIndex());
+    })();
+  </script>
