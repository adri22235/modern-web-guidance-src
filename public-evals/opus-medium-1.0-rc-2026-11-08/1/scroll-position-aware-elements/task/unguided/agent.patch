+    <div class="back-to-top-dock">
+      <button type="button" class="back-to-top" aria-label="Back to top" inert>
+        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true" focusable="false">
+          <path d="M12 19V5M5 12l7-7 7 7" />
+        </svg>
+      </button>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroll-sentinel');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setVisible(visible) {
+        button.classList.toggle('is-visible', visible);
+        // inert removes the hidden button from tab order and the accessibility tree
+        button.toggleAttribute('inert', !visible);
+      }
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          setVisible(!entries[entries.length - 1].isIntersecting);
+        }, { root: scroller }).observe(sentinel);
+      } else {
+        setVisible(true);
+      }
+
+      button.addEventListener('click', function () {
+        scroller.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
+        // The button becomes inert at the top, so move focus to the start of the page
+        scroller.focus({ preventScroll: true });
+      });
+    })();
+  </script>
+
 </body>
 
