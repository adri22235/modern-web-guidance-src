diff --git a/index.html b/index.html
index 1bacf96..1a72f57 100644
--- a/index.html
+++ b/index.html
@@ -14,6 +14,45 @@
       --light: #fafafa;
     }
 
+    /*
+     * Auto-contrast text colors.
+     * Each themed surface sets --surface to its background color and gets
+     * --on-surface: white on dark backgrounds, black on light ones.
+     * The value is recomputed on the element itself, so changing --primary /
+     * --secondary (on :root or any ancestor, at runtime or in a stylesheet)
+     * keeps the text readable automatically.
+     */
+    nav,
+    .btn,
+    footer {
+      /* Fallback for browsers without relative color support */
+      --on-surface: white;
+      color: var(--on-surface);
+    }
+
+    footer {
+      --on-surface: var(--text);
+    }
+
+    @supports (color: oklch(from red l c h)) {
+
+      nav,
+      .btn,
+      footer {
+        /* Perceptual lightness (OKLCH L) below 0.6 => white text, otherwise black */
+        --on-surface: oklch(from var(--surface) clamp(0, (0.6 - l) * 1000, 1) 0 0);
+      }
+    }
+
+    @supports (color: contrast-color(red)) {
+
+      nav,
+      .btn,
+      footer {
+        --on-surface: contrast-color(var(--surface));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
@@ -29,8 +68,8 @@
 
     /* Navigation */
     nav {
-      background: var(--primary);
-      color: white;
+      --surface: var(--primary);
+      background: var(--surface);
       padding: 1rem 5%;
       display: flex;
       justify-content: space-between;
@@ -56,14 +95,18 @@
     }
 
     nav a {
-      color: white;
+      color: inherit;
       text-decoration: none;
+      text-underline-offset: 4px;
+      text-decoration-thickness: 2px;
       font-size: 0.9rem;
-      transition: color 0.3s;
     }
 
-    nav a:hover {
-      color: var(--accent);
+    /* Accent is used for decoration only so the text keeps its contrast */
+    nav a:hover,
+    nav a:focus-visible {
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
     }
 
     .logout-link {
@@ -121,8 +164,9 @@
     }
 
     .btn {
+      --surface: var(--primary);
       display: inline-block;
-      background: var(--primary);
+      background: var(--surface);
       padding: 10px 20px;
       text-decoration: none;
       border-radius: 5px;
@@ -130,12 +174,15 @@
       transition: background 0.3s;
     }
 
-    .btn:hover {
-      background: #3e2723;
+    .btn:hover,
+    .btn:focus-visible {
+      /* Darken the theme color; text contrast is recalculated for the new shade */
+      --surface: color-mix(in oklch, var(--primary), black 20%);
     }
 
     footer {
-      background: var(--secondary);
+      --surface: var(--secondary);
+      background: var(--surface);
       text-align: center;
       padding: 40px 20px;
       margin-top: 40px;
@@ -147,7 +194,7 @@
 
     .footer-links a {
       margin: 0 10px;
-      color: var(--text);
+      color: inherit;
       text-decoration: none;
       font-size: 0.85rem;
     }
