diff --git a/index.html b/index.html
index 1bacf96..a69675e 100644
--- a/index.html
+++ b/index.html
@@ -14,6 +14,36 @@
       --light: #fafafa;
     }
 
+    /*
+     * Auto-contrast text: any element that sets --surface as its background
+     * gets black or white text, whichever contrasts best. Changing --primary
+     * or --secondary updates the text color automatically.
+     */
+    nav,
+    .btn,
+    footer {
+      background-color: var(--surface);
+    }
+
+    @supports (color: oklch(from red l c h)) {
+      nav,
+      .btn,
+      footer {
+        /* Highest threshold that passes WCAG. Higher values may be more legible. */
+        --threshold: 0.623;
+        --l: max(0, sign(var(--threshold) - l));
+        color: oklch(from var(--surface) var(--l) 0 h);
+      }
+    }
+
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
@@ -29,7 +59,7 @@
 
     /* Navigation */
     nav {
-      background: var(--primary);
+      --surface: var(--primary);
       color: white;
       padding: 1rem 5%;
       display: flex;
@@ -56,14 +86,17 @@
     }
 
     nav a {
-      color: white;
+      color: inherit;
       text-decoration: none;
       font-size: 0.9rem;
-      transition: color 0.3s;
     }
 
+    /* Underline instead of an accent color so hover text keeps its contrast */
     nav a:hover {
-      color: var(--accent);
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 2px;
+      text-underline-offset: 4px;
     }
 
     .logout-link {
@@ -121,8 +154,9 @@
     }
 
     .btn {
+      --surface: var(--primary);
       display: inline-block;
-      background: var(--primary);
+      color: white;
       padding: 10px 20px;
       text-decoration: none;
       border-radius: 5px;
@@ -130,12 +164,14 @@
       transition: background 0.3s;
     }
 
+    /* Derive hover from --primary so the text color is recomputed for it too */
     .btn:hover {
-      background: #3e2723;
+      --surface: color-mix(in oklch, var(--primary), black 20%);
     }
 
     footer {
-      background: var(--secondary);
+      --surface: var(--secondary);
+      color: var(--text);
       text-align: center;
       padding: 40px 20px;
       margin-top: 40px;
@@ -147,7 +183,7 @@
 
     .footer-links a {
       margin: 0 10px;
-      color: var(--text);
+      color: inherit;
       text-decoration: none;
       font-size: 0.85rem;
     }
