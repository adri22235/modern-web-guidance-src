       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Seasonal cards: "Make it iced" toggle restyles the whole card via :has() */
+    .seasonal-card {
+      --card-bg: white;
+      --card-border: transparent;
+      --card-heading: var(--primary);
+      --card-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+
+      position: relative;
+      background: var(--card-bg);
+      border: 2px solid var(--card-border);
+      box-shadow: var(--card-shadow);
+      transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
+    }
+
+    .seasonal-card h3 {
+      color: var(--card-heading);
+      transition: color 0.3s;
+    }
+
+    .seasonal-card:has(.iced-toggle input:checked) {
+      --card-bg: linear-gradient(160deg, #e3f2fd, #f5fbff);
+      --card-border: #64b5f6;
+      --card-heading: #0d47a1;
+      --card-shadow: 0 4px 14px rgba(33, 150, 243, 0.25);
+    }
+
+    .seasonal-card::after {
+      content: "\2744  Iced";
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      padding: 2px 8px;
+      border-radius: 999px;
+      background: #1565c0;
+      color: white;
+      font-size: 0.75rem;
+      font-weight: bold;
+      opacity: 0;
+      scale: 0.8;
+      transition: opacity 0.3s, scale 0.3s;
+    }
+
+    .seasonal-card:has(.iced-toggle input:checked)::after {
+      opacity: 1;
+      scale: 1;
+    }
+
+    .iced-toggle {
+      display: flex;
+      width: fit-content;
+      align-items: center;
+      gap: 8px;
+      margin: 12px auto 0;
+      cursor: pointer;
+      font-size: 0.9rem;
+      font-weight: 600;
+      accent-color: #1565c0;
+    }
+
+    .iced-toggle input {
+      width: 1.1rem;
+      height: 1.1rem;
+      cursor: pointer;
+    }
+
+    /* Branded checkbox fallback where accent-color isn't supported */
+    @supports not (accent-color: #1565c0) {
+      .iced-toggle {
+        position: relative;
+      }
+
+      .iced-toggle input {
+        position: absolute;
+        clip-path: inset(50%);
+        overflow: hidden;
+        width: 1px;
+        height: 1px;
+        margin: -1px;
+        white-space: nowrap;
+      }
+
+      .iced-toggle span::before {
+        content: "";
+        display: inline-block;
+        vertical-align: -0.2em;
+        width: 1.1rem;
+        height: 1.1rem;
+        margin-right: 8px;
+        border: 2px solid #90a4ae;
+        border-radius: 4px;
+        background: white;
+        color: white;
+        font-size: 0.8rem;
+        line-height: 0.95rem;
+        text-align: center;
+      }
+
+      .iced-toggle input:focus-visible + span::before {
+        outline: 2px solid #000;
+        outline-offset: 2px;
+      }
+
+      .iced-toggle input:checked + span::before {
+        content: "\2713";
+        background: #1565c0;
+        border-color: #1565c0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .seasonal-card,
+      .seasonal-card h3,
+      .seasonal-card::after {
+        transition: none;
+      }
+    }
   </style>
 </head>
 
