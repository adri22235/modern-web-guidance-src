+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill');
+    }
+
+    const STORAGE_KEY = 'pref-oat-milk';
+    const toggle = document.getElementById('pref-oat-milk');
+    toggle.checked = localStorage.getItem(STORAGE_KEY) === 'on';
+    toggle.addEventListener('change', () => {
+      localStorage.setItem(STORAGE_KEY, toggle.checked ? 'on' : 'off');
+    });
+  </script>
