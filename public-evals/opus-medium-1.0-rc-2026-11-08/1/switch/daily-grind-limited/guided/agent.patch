+  <script>
+    const prefKey = "pref-seasonal-emails";
+    const prefSwitch = document.getElementById("pref-seasonal-emails");
+
+    try {
+      prefSwitch.checked = localStorage.getItem(prefKey) === "on";
+    } catch {}
+
+    prefSwitch.addEventListener("change", () => {
+      try {
+        localStorage.setItem(prefKey, prefSwitch.checked ? "on" : "off");
+      } catch {}
+    });
+
+    window.addEventListener("storage", (event) => {
+      if (event.key === prefKey) prefSwitch.checked = event.newValue === "on";
+    });
+  </script>
