diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000..d505add
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,109 @@
+// The page is served with Connection-Allowlist + CSP headers (see server.js) that only
+// permit requests to this origin and images.unsplash.com. Anything else is blocked by
+// the browser and surfaces here as a rejected fetch (TypeError), so every request must
+// handle failure and tell the customer what happened.
+
+const HERO_PHOTO =
+  'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+
+const form = document.getElementById('newsletter-form');
+const email = document.getElementById('newsletter-email');
+const fieldError = document.getElementById('newsletter-error');
+const statusEl = document.getElementById('newsletter-status');
+const submitBtn = form.querySelector('button[type="submit"]');
+
+function setStatus(state, message) {
+  statusEl.dataset.state = state;
+  statusEl.textContent = message;
+}
+
+function showFieldError(message) {
+  email.setAttribute('aria-invalid', 'true');
+  fieldError.textContent = message;
+}
+
+function clearFieldError() {
+  email.removeAttribute('aria-invalid');
+  fieldError.textContent = '';
+}
+
+function validateEmail() {
+  if (email.validity.valueMissing) {
+    showFieldError('Please enter your email address.');
+    return false;
+  }
+  if (email.validity.typeMismatch || email.validity.tooLong) {
+    showFieldError('Please enter a valid email address, like name@example.com.');
+    return false;
+  }
+  clearFieldError();
+  return true;
+}
+
+email.addEventListener('input', () => {
+  if (email.getAttribute('aria-invalid') === 'true' && email.validity.valid) clearFieldError();
+});
+
+email.addEventListener('blur', () => {
+  if (email.value) validateEmail();
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!validateEmail()) {
+    email.focus();
+    return;
+  }
+
+  submitBtn.disabled = true;
+  setStatus('pending', 'Signing you up…');
+
+  let response;
+  try {
+    response = await fetch(form.action, {
+      method: 'POST',
+      headers: { Accept: 'application/json' },
+      body: new URLSearchParams(new FormData(form)),
+      signal: AbortSignal.timeout(15000),
+    });
+  } catch (error) {
+    // Network failure, timeout, or the request was blocked by the page's connection policy.
+    const timedOut = error?.name === 'TimeoutError';
+    setStatus(
+      'error',
+      timedOut
+        ? 'Our server is taking too long to respond. Please try again in a moment.'
+        : "We couldn't reach our server, so you haven't been signed up yet. Check your connection and try again.",
+    );
+    submitBtn.disabled = false;
+    return;
+  }
+
+  let result = {};
+  try {
+    result = await response.json();
+  } catch {
+    // Non-JSON response; fall through to the generic messages below.
+  }
+
+  if (response.ok) {
+    setStatus('success', result.message || "Thanks! You're on the list.");
+    form.reset();
+  } else if (response.status === 400 && result.field === 'email') {
+    setStatus('', '');
+    showFieldError(result.message || 'Please enter a valid email address.');
+    email.focus();
+  } else if (response.status === 429) {
+    setStatus('error', 'Too many sign-up attempts. Please wait a minute and try again.');
+  } else {
+    setStatus('error', result.message || 'Something went wrong on our end. Please try again later.');
+  }
+  submitBtn.disabled = false;
+});
+
+// Fall back to a solid hero background if the Unsplash photo can't be loaded.
+const heroProbe = new Image();
+heroProbe.addEventListener('error', () => {
+  document.querySelector('.hero')?.classList.add('photo-unavailable');
+});
+heroProbe.src = HERO_PHOTO;
