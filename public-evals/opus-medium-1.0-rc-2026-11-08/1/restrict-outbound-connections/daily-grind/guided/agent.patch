+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="stylesheet" href="/styles.css">
+  <script src="/app.js" defer></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section class="newsletter" aria-labelledby="newsletter-title">
+      <h2 id="newsletter-title">Get the Daily Grind Newsletter</h2>
+      <p>New roasts, seasonal drinks, and member-only offers. No spam, unsubscribe anytime.</p>
+      <form id="newsletter-form" class="newsletter-form" action="/api/newsletter" method="POST"
+        aria-labelledby="newsletter-title" novalidate>
+        <div class="field">
+          <label for="newsletter-email">Email address <span aria-hidden="true">*</span></label>
+          <div class="newsletter-row">
+            <input type="email" id="newsletter-email" name="email" autocomplete="email" required maxlength="254"
+              autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="send"
+              aria-describedby="newsletter-error">
+            <button type="submit" class="btn">Subscribe</button>
+          </div>
+          <span id="newsletter-error" class="field-error"></span>
+        </div>
+        <div class="hp-field" aria-hidden="true">
+          <label for="newsletter-website">Leave this field empty</label>
+          <input type="text" id="newsletter-website" name="website" tabindex="-1" autocomplete="off">
+        </div>
+        <p id="newsletter-status" class="form-status" role="status" aria-live="polite"></p>
+      </form>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..fd2fff7
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,265 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-top: 40px;
+  padding: 30px 20px;
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+}
+
+.newsletter-form {
+  max-width: 520px;
+  margin: 20px auto 0;
+  text-align: start;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+}
+
+.newsletter-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+
+.newsletter-row input {
+  flex: 1 1 240px;
+  font: inherit;
+  font-size: max(1rem, 1em);
+  min-height: 48px;
+  padding: 0.75rem;
+  border: 1px solid #767676;
+  border-radius: 5px;
+}
+
+.newsletter-row input:user-invalid,
+.newsletter-row input[aria-invalid="true"] {
+  border-color: #b3261e;
+}
+
+.newsletter-row .btn {
+  margin-top: 0;
+  min-height: 48px;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-row .btn:disabled {
+  opacity: 0.7;
+  cursor: progress;
+}
+
+.newsletter input:focus-visible,
+.newsletter .btn:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.field-error:not(:empty)::before,
+.form-status[data-state="error"]::before {
+  content: "⚠ ";
+}
+
+.field-error {
+  color: #b3261e;
+  font-size: 0.9rem;
+}
+
+.form-status:empty {
+  display: none;
+}
+
+.form-status {
+  margin-top: 15px;
+  padding: 10px 14px;
+  border-radius: 5px;
+}
+
+.form-status[data-state="success"] {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.form-status[data-state="success"]::before {
+  content: "✓ ";
+}
+
+.form-status[data-state="error"] {
+  background: #fdecea;
+  color: #8c1d18;
+}
+
+.hp-field {
+  position: absolute;
+  clip-path: inset(50%);
+  overflow: hidden;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  white-space: nowrap;
+}
+
+/* Shown by app.js if the hero photo can't be loaded */
+.hero.photo-unavailable {
+  background: var(--primary);
+}
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..ee1735b
--- /dev/null
+++ b/server.js
@@ -0,0 +1,233 @@
+// Minimal dependency-free server for the Daily Grind homepage.
+//
+// Restricts every page to talking only to our own origin and the Unsplash photo host:
+//   - Connection-Allowlist: network-layer allowlist covering fetch, subresources,
+//     navigations, beacons, resource hints, WebSockets and WebRTC (Chrome/Edge 152+).
+//   - Content-Security-Policy: fallback for browsers without Connection-Allowlist.
+// Both policies report violations to /api/security-reports.
+
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PUBLIC_DIR = path.join(ROOT, 'public');
+const DATA_DIR = path.join(ROOT, 'data');
+const PORT = Number(process.env.PORT) || 11222;
+const MAX_BODY_BYTES = 16 * 1024;
+
+const PHOTO_HOST = 'https://images.unsplash.com';
+const REPORT_ENDPOINT = 'security';
+const REPORT_PATH = '/api/security-reports';
+
+const CONNECTION_ALLOWLIST = `(response-origin "${PHOTO_HOST}"); report-to=${REPORT_ENDPOINT}`;
+
+const CSP = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${PHOTO_HOST}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "form-action 'self'",
+  "worker-src 'self'",
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  `report-uri ${REPORT_PATH}`,
+  `report-to ${REPORT_ENDPOINT}`,
+].join('; ');
+
+// Connection-Allowlist is only honored on document and worker responses.
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+// Only these files are served; nothing else on disk is reachable.
+const STATIC_FILES = new Map([
+  ['/', { file: 'index.html', type: 'text/html; charset=utf-8' }],
+  ['/index.html', { file: 'index.html', type: 'text/html; charset=utf-8' }],
+  ['/styles.css', { file: 'styles.css', type: 'text/css; charset=utf-8' }],
+  ['/app.js', { file: 'app.js', type: 'text/javascript; charset=utf-8' }],
+]);
+
+function setSecurityHeaders(req, res) {
+  res.setHeader('Vary', 'Sec-Fetch-Dest');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Content-Security-Policy', CSP);
+  res.setHeader('Reporting-Endpoints', `${REPORT_ENDPOINT}="${REPORT_PATH}"`);
+
+  // Browsers that don't send Sec-Fetch-Dest get the allowlist too (harmless if ignored).
+  const dest = req.headers['sec-fetch-dest'];
+  if (!dest || ALLOWLIST_DESTS.has(dest.toLowerCase())) {
+    res.setHeader('Connection-Allowlist', CONNECTION_ALLOWLIST);
+  }
+}
+
+function send(res, status, body, type) {
+  res.writeHead(status, { 'Content-Type': type, 'Content-Length': Buffer.byteLength(body) });
+  res.end(body);
+}
+
+function sendJson(res, status, payload) {
+  send(res, status, JSON.stringify(payload), 'application/json; charset=utf-8');
+}
+
+function escapeHtml(text) {
+  return text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+// Result page for submissions without JavaScript. Rendered directly (no redirect),
+// because Connection-Allowlist blocks 3xx redirects by default.
+function sendResultPage(res, status, message) {
+  const html = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Newsletter | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container">
+    <section class="newsletter">
+      <h1>${status < 400 ? 'Thanks!' : 'Sorry'}</h1>
+      <p>${escapeHtml(message)}</p>
+      <a href="/" class="btn">Back to the homepage</a>
+    </section>
+  </main>
+</body>
+</html>`;
+  send(res, status, html, 'text/html; charset=utf-8');
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+// Simple per-IP fixed-window rate limit for signups.
+const RATE_WINDOW_MS = 60_000;
+const RATE_LIMIT = 5;
+const signupAttempts = new Map();
+
+function isRateLimited(ip) {
+  const now = Date.now();
+  const entry = signupAttempts.get(ip);
+  if (!entry || now - entry.start > RATE_WINDOW_MS) {
+    signupAttempts.set(ip, { start: now, count: 1 });
+    return false;
+  }
+  entry.count += 1;
+  return entry.count > RATE_LIMIT;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [ip, entry] of signupAttempts) {
+    if (now - entry.start > RATE_WINDOW_MS) signupAttempts.delete(ip);
+  }
+}, RATE_WINDOW_MS).unref();
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+async function handleNewsletter(req, res) {
+  const wantsJson = (req.headers.accept || '').includes('application/json');
+  const reply = (status, payload) =>
+    wantsJson ? sendJson(res, status, payload) : sendResultPage(res, status, payload.message);
+
+  // Reject cross-site form posts.
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') {
+    return reply(403, { message: 'This request was not allowed.' });
+  }
+
+  if (isRateLimited(req.socket.remoteAddress)) {
+    return reply(429, { message: 'Too many sign-up attempts. Please wait a minute and try again.' });
+  }
+
+  const params = new URLSearchParams(await readBody(req));
+  // Honeypot: bots fill hidden fields. Pretend success.
+  if (params.get('website')) {
+    return reply(200, { message: "Thanks! You're on the list." });
+  }
+
+  const email = (params.get('email') || '').trim().toLowerCase();
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(400, { field: 'email', message: 'Please enter a valid email address, like name@example.com.' });
+  }
+
+  await mkdir(DATA_DIR, { recursive: true });
+  await appendFile(
+    path.join(DATA_DIR, 'subscribers.jsonl'),
+    JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n',
+  );
+  return reply(200, { message: "Thanks! You're on the list. Watch your inbox for our next issue." });
+}
+
+async function handleSecurityReport(req, res) {
+  const body = await readBody(req);
+  console.warn('[security-report]', body);
+  res.writeHead(204);
+  res.end();
+}
+
+async function handleRequest(req, res) {
+  setSecurityHeaders(req, res);
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      res.setHeader('Allow', 'POST');
+      return sendJson(res, 405, { message: 'Method not allowed.' });
+    }
+    return handleNewsletter(req, res);
+  }
+
+  if (pathname === REPORT_PATH) {
+    if (req.method !== 'POST') {
+      res.setHeader('Allow', 'POST');
+      return sendJson(res, 405, { message: 'Method not allowed.' });
+    }
+    return handleSecurityReport(req, res);
+  }
+
+  const asset = STATIC_FILES.get(pathname);
+  if (!asset || (req.method !== 'GET' && req.method !== 'HEAD')) {
+    return send(res, 404, 'Not found', 'text/plain; charset=utf-8');
+  }
+  const content = await readFile(path.join(PUBLIC_DIR, asset.file));
+  res.writeHead(200, {
+    'Content-Type': asset.type,
+    'Content-Length': content.length,
+    'Cache-Control': 'no-cache',
+  });
+  res.end(req.method === 'HEAD' ? undefined : content);
+}
+
+createServer((req, res) => {
+  handleRequest(req, res).catch((error) => {
+    console.error(error);
+    if (res.headersSent) return res.destroy();
+    const status = error.status || 500;
+    sendJson(res, status, {
+      message: status === 413 ? 'That request was too large.' : 'Something went wrong on our end. Please try again later.',
+    });
+  });
+}).listen(PORT, () => {
+  console.log(`The Daily Grind is running on http://localhost:${PORT}`);
+});
