+  <script>
+    (function () {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const result = document.getElementById('detect-result');
+      const displayNames = typeof Intl.DisplayNames === 'function'
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      // Languages identified by their unique writing system.
+      const SCRIPTS = [
+        ['ja', /[぀-ヿ]/g],
+        ['ko', /[가-힯ᄀ-ᇿ]/g],
+        ['zh', /[一-鿿]/g],
+        ['ar', /[؀-ۿ]/g],
+        ['he', /[֐-׿]/g],
+        ['el', /[Ͱ-Ͽ]/g],
+        ['hi', /[ऀ-ॿ]/g],
+        ['th', /[฀-๿]/g],
+        ['ru', /[Ѐ-ӿ]/g]
+      ];
+
+      // Common function words for Latin-script languages.
+      const STOPWORDS = {
+        en: 'the and is it to of was i you that this with for my but not very have are',
+        es: 'el la de que y en los es un una por con para muy pero no mi lo las fue',
+        fr: 'le la les de et est un une que pour pas je très mais avec dans mon ce était',
+        de: 'der die das und ist nicht ich ein eine zu mit sehr aber war mein es den auf',
+        it: 'il di che e la non un una per sono molto ma con mi è era questo lo gli',
+        pt: 'o a de que e não um uma para com muito mas meu é foi os as eu está',
+        nl: 'de het een en is niet ik van dat met voor zeer maar was mijn zijn op',
+        sv: 'och att det är en jag inte med för var mycket men på som till av',
+        pl: 'i nie w się na jest to że z do bardzo ale jak było mój ten',
+        tr: 've bir bu çok için ile ama değil ben de da mı gibi daha',
+        id: 'dan yang ini itu tidak saya di dengan untuk sangat tapi ada dari'
+      };
+      const STOPWORD_SETS = Object.fromEntries(
+        Object.entries(STOPWORDS).map(([lang, words]) => [lang, new Set(words.split(' '))])
+      );
+
+      function heuristicDetect(text) {
+        const letters = (text.match(/\p{L}/gu) || []).length;
+        if (!letters) return null;
+
+        let best = null;
+        for (const [lang, re] of SCRIPTS) {
+          const count = (text.match(re) || []).length;
+          if (count / letters > 0.3 && (!best || count > best.count)) best = { lang, count };
+        }
+        // Japanese text mixes kana with kanji, so any kana means Japanese.
+        if (best) return best.lang === 'zh' && /[぀-ヿ]/.test(text) ? 'ja' : best.lang;
+
+        const words = text.toLowerCase().match(/\p{L}+/gu) || [];
+        let topLang = null;
+        let topScore = 0;
+        for (const [lang, set] of Object.entries(STOPWORD_SETS)) {
+          const score = words.reduce((n, w) => n + (set.has(w) ? 1 : 0), 0);
+          if (score > topScore) { topLang = lang; topScore = score; }
+        }
+        return topLang;
+      }
+
+      async function builtInDetect(text) {
+        if (!('LanguageDetector' in self)) return null;
+        try {
+          if ((await LanguageDetector.availability()) === 'unavailable') return null;
+          const detector = await LanguageDetector.create();
+          const [top] = await detector.detect(text);
+          return top && top.detectedLanguage !== 'und' ? top.detectedLanguage : null;
+        } catch (err) {
+          return null;
+        }
+      }
+
+      function languageName(code) {
+        try {
+          return (displayNames && displayNames.of(code)) || code;
+        } catch (err) {
+          return code;
+        }
+      }
+
+      form.addEventListener('submit', async function (event) {
+        event.preventDefault();
+        const text = textarea.value.trim();
+        result.classList.remove('error');
+
+        if (!text) {
+          result.classList.add('error');
+          result.textContent = 'Please enter a message first.';
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        result.textContent = 'Detecting…';
+        const code = (await builtInDetect(text)) || heuristicDetect(text);
+        button.disabled = false;
+
+        if (code) {
+          result.textContent = 'Detected language: ' + languageName(code);
+        } else {
+          result.classList.add('error');
+          result.textContent = "Sorry, we couldn't identify the language. Try writing a bit more.";
+        }
+      });
+    })();
+  </script>
+
