     </section>
+
+    <section class="feedback" aria-labelledby="feedback-heading">
+      <h2 id="feedback-heading">Customer Feedback</h2>
+      <p>Tell us about your visit — in any language you like.</p>
+      <form id="feedback-form">
+        <label for="feedback-message">Your message</label>
+        <textarea id="feedback-message" name="message" required
+          placeholder="Write your feedback here..."></textarea>
+        <button type="submit" class="btn" id="detect-btn">Detect</button>
+        <p class="feedback-result" id="feedback-result" role="status" aria-live="polite"></p>
+      </form>
+    </section>
   </main>
 
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-btn');
+    const result = document.getElementById('feedback-result');
+    const languageNames = new Intl.DisplayNames([navigator.language, 'en'], { type: 'language' });
+
+    let detectorPromise;
+
+    function unsupported(text) {
+      button.disabled = true;
+      result.textContent = text;
+    }
+
+    if (!('LanguageDetector' in self)) {
+      unsupported('Language detection is not supported in this browser.');
+    } else if (await LanguageDetector.availability() === 'unavailable') {
+      unsupported('Language detection is currently unavailable on this device.');
+    }
+
+    function getDetector() {
+      // Must be first called from a user gesture so the model can download.
+      detectorPromise ??= LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            result.textContent = `Downloading language model… ${Math.round(e.loaded * 100)}%`;
+          });
+        },
+      }).catch((err) => {
+        detectorPromise = undefined;
+        throw err;
+      });
+      return detectorPromise;
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = message.value.trim();
+      if (!text) {
+        result.textContent = 'Please enter a message first.';
+        return;
+      }
+
+      button.disabled = true;
+      result.textContent = 'Detecting…';
+      try {
+        const detector = await getDetector();
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          result.textContent = 'Could not determine the language. Try writing a bit more.';
+        } else {
+          const name = languageNames.of(top.detectedLanguage) ?? top.detectedLanguage;
+          const confidence = Math.round(top.confidence * 100);
+          result.textContent = `Detected language: ${name} (${confidence}% confidence)`;
+        }
+      } catch (err) {
+        console.error(err);
+        result.textContent = 'Sorry, language detection failed. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
