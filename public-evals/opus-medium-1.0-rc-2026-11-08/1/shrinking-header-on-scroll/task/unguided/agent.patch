+  <script>
+    // Fallback for browsers without scroll-driven animations: map scroll
+    // position to --nav-progress so the CSS calc() rules interpolate the nav.
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll()');
+      if (supportsScrollTimeline) return;
+
+      var SHRINK_DISTANCE = 150;
+      var nav = document.querySelector('nav');
+      var ticking = false;
+
+      function update() {
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(y / SHRINK_DISTANCE, 0), 1);
+        nav.style.setProperty('--nav-progress', progress.toFixed(3));
+        ticking = false;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
+
