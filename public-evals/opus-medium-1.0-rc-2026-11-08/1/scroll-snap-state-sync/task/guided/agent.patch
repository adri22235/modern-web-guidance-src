+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    const setActive = (id) => {
+      for (const link of tocLinks) {
+        const isActive = link.hash === `#${id}`;
+        link.classList.toggle('is-active', isActive);
+        if (isActive) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      }
+    };
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      // Fires only once the scroller settles on a new snap target
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) setActive(section.id);
+      });
+    } else {
+      // Fallback: track the top-most visible section header while scrolling
+      const headers = sections.map((section) => section.querySelector('header'));
+      const observer = new IntersectionObserver(() => {
+        const panelTop = panel.getBoundingClientRect().top;
+        const top = headers.reduce((current, header) => {
+          const { bottom } = header.getBoundingClientRect();
+          if (bottom < panelTop) return current;
+          if (!current) return header;
+          return bottom < current.getBoundingClientRect().bottom ? header : current;
+        }, undefined);
+        if (top) setActive(top.closest('.drink-section').id);
+      }, { root: panel, threshold: [0, 1] });
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Scroll only the panel (not the page) to the section, then move focus there
+    for (const link of tocLinks) {
+      link.addEventListener('click', (event) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (!section) return;
+        event.preventDefault();
+        const header = section.querySelector('header');
+        const offset = header.getBoundingClientRect().top - panel.getBoundingClientRect().top
+          - parseFloat(getComputedStyle(header).scrollMarginTop);
+        panel.scrollTo({
+          top: panel.scrollTop + offset,
+          behavior: reduceMotion.matches ? 'auto' : 'smooth',
+        });
+        section.focus({ preventScroll: true });
+        history.replaceState(null, '', link.hash);
+      });
+    }
+  </script>
