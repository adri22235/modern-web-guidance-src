+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeId = null;
+
+      function setActive(id) {
+        if (!id || id === activeId) return;
+        activeId = id;
+        links.forEach(function (link) {
+          var isActive = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('is-active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        sections.forEach(function (section) {
+          section.classList.toggle('is-active', section.id === id);
+        });
+      }
+
+      // The section whose top edge sits closest to the panel's snap position.
+      function currentSection() {
+        var panelTop = panel.getBoundingClientRect().top;
+        var best = sections[0];
+        var bestDistance = Infinity;
+        sections.forEach(function (section) {
+          var distance = Math.abs(section.getBoundingClientRect().top - panelTop);
+          if (distance < bestDistance) {
+            bestDistance = distance;
+            best = section;
+          }
+        });
+        return best;
+      }
+
+      function onSettle() {
+        var section = currentSection();
+        if (section) setActive(section.id);
+      }
+
+      // Highlight only once scrolling (including snap) has settled.
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', onSettle);
+      } else {
+        var settleTimer;
+        panel.addEventListener('scroll', function () {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(onSettle, 120);
+        }, { passive: true });
+      }
+
+      function scrollToSection(section, smooth) {
+        var offset = section.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+        panel.scrollTo({ top: offset, behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
+        // If already in place no scroll event fires, so settle immediately.
+        if (Math.abs(panel.scrollTop - offset) < 1) onSettle();
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var id = link.getAttribute('href').slice(1);
+          var section = document.getElementById(id);
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          scrollToSection(section, true);
+          // Move focus to the section for keyboard/screen reader users without a jump.
+          section.focus({ preventScroll: true });
+          if (history.replaceState) history.replaceState(null, '', '#' + id);
+        });
+      });
+
+      var initial = location.hash && document.getElementById(location.hash.slice(1));
+      if (initial && panel.contains(initial)) {
+        scrollToSection(initial, false);
+      }
+      onSettle();
+    })();
+  </script>
+
