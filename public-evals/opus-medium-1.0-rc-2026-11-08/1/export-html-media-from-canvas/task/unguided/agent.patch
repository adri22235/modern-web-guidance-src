+  <script>
+    (function () {
+      const card = document.getElementById('export_element');
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const EXPORT_WIDTH = 1200;
+
+      const inputs = {
+        name: document.getElementById('gc_name_input'),
+        message: document.getElementById('gc_message_input'),
+        from: document.getElementById('gc_from_input'),
+        amount: document.getElementById('gc_amount_input'),
+        custom: document.getElementById('gc_custom_color')
+      };
+      const messageCount = document.getElementById('gc_message_count');
+      let bgColor = '#4e342e';
+
+      // Pick a readable foreground for the chosen background
+      function contrastColor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const [r, g, b] = [n >> 16, (n >> 8) & 255, n & 255].map(v => {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.4 ? '#3e2723' : '#fafafa';
+      }
+
+      function updateCard() {
+        const fg = contrastColor(bgColor);
+        card.style.setProperty('--card-bg', bgColor);
+        card.style.setProperty('--card-fg', fg);
+        // Accent name color must stay legible on light backgrounds
+        card.querySelector('.gc-name').style.color = fg === '#fafafa' ? '#ffab40' : '#bf360c';
+
+        document.getElementById('gc_name').textContent = inputs.name.value.trim() || 'Someone Special';
+        document.getElementById('gc_message').textContent = inputs.message.value.trim();
+        const from = inputs.from.value.trim();
+        document.getElementById('gc_from').textContent = from ? 'From: ' + from : '';
+        document.getElementById('gc_amount').textContent = inputs.amount.value;
+        messageCount.textContent = inputs.message.value.length + ' / ' + inputs.message.maxLength;
+
+        renderToCanvas();
+      }
+
+      function roundRectPath(x, y, w, h, r) {
+        r = Math.min(r, w / 2, h / 2);
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      function wrapLines(text, maxWidth) {
+        const lines = [];
+        text.split('\n').forEach(paragraph => {
+          let line = '';
+          paragraph.split(/\s+/).filter(Boolean).forEach(word => {
+            const test = line ? line + ' ' + word : word;
+            if (line && ctx.measureText(test).width > maxWidth) {
+              lines.push(line);
+              line = word;
+            } else {
+              line = test;
+            }
+          });
+          if (line) lines.push(line);
+        });
+        return lines;
+      }
+
+      // Draws the HTML card's elements into the canvas using their live layout and computed styles
+      function renderToCanvas() {
+        const cardRect = card.getBoundingClientRect();
+        if (!cardRect.width) return;
+        const scale = EXPORT_WIDTH / cardRect.width;
+        const height = Math.round(cardRect.height * scale);
+        if (canvas.width !== EXPORT_WIDTH) canvas.width = EXPORT_WIDTH;
+        if (canvas.height !== height) canvas.height = height;
+
+        const cardStyle = getComputedStyle(card);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.save();
+        roundRectPath(0, 0, canvas.width, canvas.height, parseFloat(cardStyle.borderTopLeftRadius) * scale);
+        ctx.fillStyle = cardStyle.backgroundColor;
+        ctx.fill();
+        ctx.clip();
+
+        card.querySelectorAll('[data-canvas-shape]').forEach(el => {
+          const s = getComputedStyle(el);
+          const r = el.getBoundingClientRect();
+          const bw = parseFloat(s.borderTopWidth) * scale;
+          if (!bw) return;
+          ctx.save();
+          ctx.globalAlpha = parseFloat(s.opacity);
+          ctx.strokeStyle = s.borderTopColor;
+          ctx.lineWidth = bw;
+          if (s.borderTopStyle === 'dashed') ctx.setLineDash([bw * 4, bw * 3]);
+          roundRectPath((r.left - cardRect.left) * scale + bw / 2, (r.top - cardRect.top) * scale + bw / 2,
+            r.width * scale - bw, r.height * scale - bw, parseFloat(s.borderTopLeftRadius) * scale);
+          ctx.stroke();
+          ctx.restore();
+        });
+
+        card.querySelectorAll('[data-canvas-text]').forEach(el => {
+          const text = el.textContent;
+          if (!text.trim()) return;
+          const s = getComputedStyle(el);
+          const r = el.getBoundingClientRect();
+          const fontSize = parseFloat(s.fontSize) * scale;
+          const lineHeight = (parseFloat(s.lineHeight) || parseFloat(s.fontSize) * 1.6) * scale;
+          const x = (r.left - cardRect.left) * scale;
+          const y = (r.top - cardRect.top) * scale;
+          const w = r.width * scale;
+
+          ctx.save();
+          ctx.globalAlpha = parseFloat(s.opacity);
+          ctx.fillStyle = s.color;
+          ctx.font = `${s.fontStyle} ${s.fontWeight} ${fontSize}px ${s.fontFamily}`;
+          if ('letterSpacing' in ctx) {
+            const ls = parseFloat(s.letterSpacing);
+            ctx.letterSpacing = (isNaN(ls) ? 0 : ls * scale) + 'px';
+          }
+          ctx.textBaseline = 'middle';
+          const align = s.textAlign === 'center' ? 'center' : (s.textAlign === 'right' || s.textAlign === 'end') ? 'right' : 'left';
+          ctx.textAlign = align;
+          const tx = align === 'center' ? x + w / 2 : align === 'right' ? x + w : x;
+          const content = s.textTransform === 'uppercase' ? text.toUpperCase() : text;
+
+          wrapLines(content, w + 1).forEach((line, i) => {
+            ctx.fillText(line, tx, y + lineHeight * (i + 0.5));
+          });
+          ctx.restore();
+        });
+
+        ctx.restore();
+      }
+
+      function exportCard() {
+        renderToCanvas();
+        const safeName = (inputs.name.value.trim() || 'gift').replace(/[^a-z0-9]+/gi, '-').toLowerCase();
+        const filename = `daily-grind-gift-card-${safeName}.png`;
+        const download = url => {
+          const a = document.createElement('a');
+          a.href = url;
+          a.download = filename;
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+        };
+        if (canvas.toBlob) {
+          canvas.toBlob(blob => {
+            const url = URL.createObjectURL(blob);
+            download(url);
+            setTimeout(() => URL.revokeObjectURL(url), 1000);
+          }, 'image/png');
+        } else {
+          download(canvas.toDataURL('image/png'));
+        }
+      }
+
+      [inputs.name, inputs.message, inputs.from].forEach(el => el.addEventListener('input', updateCard));
+      inputs.amount.addEventListener('change', updateCard);
+      document.querySelectorAll('input[name="gc_color"]').forEach(radio => {
+        radio.addEventListener('change', () => { bgColor = radio.value; updateCard(); });
+      });
+      inputs.custom.addEventListener('input', () => {
+        document.querySelectorAll('input[name="gc_color"]').forEach(r => { r.checked = false; });
+        bgColor = inputs.custom.value;
+        updateCard();
+      });
+      document.getElementById('gc_export_btn').addEventListener('click', exportCard);
+      window.addEventListener('resize', renderToCanvas);
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(renderToCanvas);
+
+      updateCard();
+    })();
+  </script>
+
 </body>
 
