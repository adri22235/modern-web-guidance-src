+  <script>
+    (() => {
+      const form = document.getElementById('gift_form');
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const card = document.getElementById('export_element');
+      const nameOut = document.getElementById('gc_name');
+      const messageOut = document.getElementById('gc_message');
+      const exportBtn = document.getElementById('gift_export');
+      const status = document.getElementById('gift_status');
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      function readState() {
+        const color = form.querySelector('input[name="color"]:checked');
+        return {
+          name: form.elements.namedItem('name').value.trim() || 'Someone Special',
+          message: form.elements.namedItem('message').value.trim(),
+          bg: color.value,
+          ink: color.dataset.ink,
+        };
+      }
+
+      // Keep the HTML card in sync with the form controls.
+      function updateCard() {
+        const state = readState();
+        nameOut.textContent = state.name;
+        messageOut.textContent = state.message;
+        card.style.setProperty('--card-bg', state.bg);
+        card.style.setProperty('--card-ink', state.ink);
+        render();
+      }
+
+      function render() {
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint();
+        } else {
+          drawFallback(readState());
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+        };
+      }
+
+      // Without HTML-in-Canvas support, redraw the same card design with the 2D API.
+      function wrapText(text, maxWidth) {
+        const lines = [];
+        let line = '';
+        for (const word of text.split(/\s+/).filter(Boolean)) {
+          const test = line ? line + ' ' + word : word;
+          if (line && ctx.measureText(test).width > maxWidth) {
+            lines.push(line);
+            line = word;
+          } else {
+            line = test;
+          }
+        }
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      function drawFallback(state) {
+        const w = canvas.clientWidth;
+        const h = canvas.clientHeight;
+        if (!w || !h) return;
+        const pad = w * 0.07;
+        const font = getComputedStyle(document.body).fontFamily;
+
+        ctx.setTransform(canvas.width / w, 0, 0, canvas.height / h, 0, 0);
+        ctx.clearRect(0, 0, w, h);
+        ctx.beginPath();
+        ctx.roundRect(0, 0, w, h, 14);
+        ctx.fillStyle = state.bg;
+        ctx.fill();
+
+        ctx.fillStyle = state.ink;
+        ctx.textBaseline = 'top';
+        ctx.letterSpacing = '2px';
+        ctx.font = `bold 13px ${font}`;
+        ctx.textAlign = 'left';
+        ctx.fillText('THE DAILY GRIND', pad, pad);
+        ctx.font = `13px ${font}`;
+        ctx.textAlign = 'right';
+        ctx.fillText('GIFT CARD', w - pad, pad);
+        ctx.letterSpacing = '0px';
+        ctx.textAlign = 'left';
+
+        ctx.font = `bold 26px ${font}`;
+        const nameLines = wrapText(state.name, w - pad * 2).slice(0, 2);
+        ctx.font = `italic 16px ${font}`;
+        const msgLines = wrapText(state.message, w - pad * 2).slice(0, 3);
+        const blockHeight = nameLines.length * 31 + (msgLines.length ? 6 + msgLines.length * 24 : 0);
+        let y = (h - blockHeight) / 2;
+
+        ctx.font = `bold 26px ${font}`;
+        for (const line of nameLines) {
+          ctx.fillText(line, pad, y);
+          y += 31;
+        }
+        y += 6;
+        ctx.font = `italic 16px ${font}`;
+        for (const line of msgLines) {
+          ctx.fillText(line, pad, y);
+          y += 24;
+        }
+
+        ctx.globalAlpha = 0.85;
+        ctx.font = `12px ${font}`;
+        ctx.textBaseline = 'bottom';
+        ctx.fillText('\u2615 Redeemable at any Daily Grind location', pad, h - pad);
+        ctx.globalAlpha = 1;
+      }
+
+      // Match the canvas grid to device pixels so the exported image stays crisp.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        render();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      form.addEventListener('input', updateCard);
+      form.addEventListener('submit', (event) => event.preventDefault());
+
+      exportBtn.addEventListener('click', () => {
+        canvas.toBlob((blob) => {
+          if (!blob) {
+            status.textContent = 'Sorry, the card could not be exported.';
+            return;
+          }
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          const slug = readState().name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+          link.href = url;
+          link.download = `daily-grind-gift-card${slug ? '-' + slug : ''}.png`;
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Your gift card has been downloaded.';
+        }, 'image/png');
+      });
+
+      updateCard();
+    })();
+  </script>
+
 </body>
 
