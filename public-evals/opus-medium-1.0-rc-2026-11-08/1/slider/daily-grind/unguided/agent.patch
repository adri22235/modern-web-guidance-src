+  <script>
+    (function () {
+      var strengths = [
+        { name: 'Mild', desc: 'Light and bright with delicate floral notes.' },
+        { name: 'Medium', desc: 'Balanced and smooth with gentle chocolate notes.' },
+        { name: 'Bold', desc: 'Full-bodied and rich with a caramelized finish.' },
+        { name: 'Extra Bold', desc: 'Intense, smoky, and unapologetically strong.' }
+      ];
+      var range = document.getElementById('strength-range');
+      var control = document.getElementById('strength-control');
+      var nameEl = document.getElementById('strength-name');
+      var descEl = document.getElementById('strength-desc');
+      var ticks = control.querySelectorAll('.strength-ticks button');
+
+      function update() {
+        var i = Number(range.value);
+        var pct = (i - range.min) / (range.max - range.min) * 100;
+        // Offset by thumb radius so the fill ends at the thumb's center
+        control.style.setProperty('--fill',
+          'calc(' + pct + '% + var(--thumb) * ' + (0.5 - pct / 100) + ')');
+        nameEl.textContent = strengths[i].name;
+        descEl.textContent = strengths[i].desc;
+        range.setAttribute('aria-valuetext', strengths[i].name);
+        ticks.forEach(function (btn) {
+          btn.setAttribute('aria-pressed', Number(btn.dataset.value) === i ? 'true' : 'false');
+        });
+      }
+
+      range.addEventListener('input', update);
+      ticks.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          range.value = btn.dataset.value;
+          update();
+          range.focus();
+        });
+      });
+      update();
+    })();
+  </script>
+
