+  <script>
+    (() => {
+      const strengths = [
+        { name: 'Mild', description: 'Light and bright, with delicate citrus and floral notes.' },
+        { name: 'Medium', description: 'Balanced and smooth, with notes of caramel and toasted nuts.' },
+        { name: 'Bold', description: 'Rich and full-bodied, with deep chocolate undertones.' },
+        { name: 'Extra Bold', description: 'Intense and smoky, for when you really need to wake up.' }
+      ];
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-output');
+      const description = document.getElementById('brew-strength-description');
+      const ticks = document.querySelectorAll('.strength-ticks li');
+
+      function syncSlider() {
+        const index = Number(slider.value);
+        const { name, description: text } = strengths[index];
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+        slider.setAttribute('aria-valuetext', name);
+        output.textContent = name;
+        description.textContent = text;
+        ticks.forEach((tick, i) => tick.classList.toggle('is-active', i === index));
+      }
+
+      syncSlider();
+      slider.addEventListener('input', syncSlider);
+    })();
+  </script>
+
