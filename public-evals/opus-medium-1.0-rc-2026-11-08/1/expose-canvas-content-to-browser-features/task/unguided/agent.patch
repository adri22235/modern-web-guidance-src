+  <script>
+    (function () {
+      const W = 640, H = 540; // logical drawing size, in CSS pixels
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('cup-stage');
+      const ctx = canvas.getContext('2d');
+      const fields = Array.from(canvas.querySelectorAll('.cup-field'));
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('cup-milk');
+      const syrupSelect = document.getElementById('cup-syrup');
+      const summaryEl = document.getElementById('cup-summary');
+
+      const MILKS = {
+        none: { label: 'no milk', coffee: '#3b2314', foam: null },
+        whole: { label: 'whole milk', coffee: '#c69c6d', foam: '#f3e5d0' },
+        oat: { label: 'oat milk', coffee: '#b88a5a', foam: '#ead9bd' },
+        almond: { label: 'almond milk', coffee: '#c4a07a', foam: '#f1e4d2' },
+        soy: { label: 'soy milk', coffee: '#b9906a', foam: '#efe2cc' }
+      };
+      const SYRUPS = {
+        none: { label: 'no syrup', color: null },
+        vanilla: { label: 'vanilla', color: '#e8c96a' },
+        caramel: { label: 'caramel', color: '#c77c2b' },
+        maple: { label: 'maple', color: '#a0522d' },
+        hazelnut: { label: 'hazelnut', color: '#8b5a2b' },
+        mocha: { label: 'mocha', color: '#4a2c1d' }
+      };
+
+      // Cup geometry (logical px)
+      const CX = 320, TOP = 150, BOTTOM = 440, TOP_HW = 125, BOTTOM_HW = 92, RIM_RY = 28;
+      const halfWidthAt = (y) => TOP_HW - (TOP_HW - BOTTOM_HW) * (y - TOP) / (BOTTOM - TOP);
+
+      // HTML-in-canvas (WICG proposal): children of <canvas layoutsubtree> are laid out and can be
+      // drawn into the bitmap; the returned transform keeps hit testing aligned with the drawing.
+      const proto = window.CanvasRenderingContext2D && CanvasRenderingContext2D.prototype;
+      const drawElementFn = proto && (proto.drawElementImage || proto.drawElement);
+      const htmlInCanvas = !!drawElementFn;
+
+      let overlay = null;
+      if (!htmlInCanvas) {
+        // Fallback: position the same controls in a scaled overlay sharing the canvas coordinate space.
+        canvas.removeAttribute('layoutsubtree');
+        overlay = document.createElement('div');
+        overlay.className = 'cup-overlay';
+        fields.forEach((f) => {
+          f.style.left = f.dataset.x + 'px';
+          f.style.top = f.dataset.y + 'px';
+          overlay.appendChild(f);
+        });
+        stage.appendChild(overlay);
+      }
+
+      function roundRect(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      function cupPath() {
+        ctx.beginPath();
+        ctx.moveTo(CX - TOP_HW, TOP);
+        ctx.lineTo(CX - BOTTOM_HW, BOTTOM - 12);
+        ctx.quadraticCurveTo(CX - BOTTOM_HW + 2, BOTTOM, CX - BOTTOM_HW + 16, BOTTOM);
+        ctx.lineTo(CX + BOTTOM_HW - 16, BOTTOM);
+        ctx.quadraticCurveTo(CX + BOTTOM_HW - 2, BOTTOM, CX + BOTTOM_HW, BOTTOM - 12);
+        ctx.lineTo(CX + TOP_HW, TOP);
+        ctx.closePath();
+      }
+
+      function drawSteam() {
+        ctx.save();
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 5;
+        ctx.lineCap = 'round';
+        [-45, 0, 45].forEach((dx, i) => {
+          const x = CX + dx;
+          ctx.beginPath();
+          ctx.moveTo(x, 118);
+          ctx.bezierCurveTo(x - 18, 100, x + 18, 84, x, 66 - i % 2 * 8);
+          ctx.bezierCurveTo(x - 14, 52, x + 10, 40, x, 30);
+          ctx.stroke();
+        });
+        ctx.restore();
+      }
+
+      function drawSaucerAndShadow() {
+        ctx.save();
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.12)';
+        ctx.beginPath();
+        ctx.ellipse(CX, BOTTOM + 18, 196, 30, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const g = ctx.createLinearGradient(0, BOTTOM - 10, 0, BOTTOM + 30);
+        g.addColorStop(0, '#ffffff');
+        g.addColorStop(1, '#d7ccc8');
+        ctx.fillStyle = g;
+        ctx.beginPath();
+        ctx.ellipse(CX, BOTTOM + 8, 186, 26, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      function drawHandle() {
+        ctx.save();
+        ctx.strokeStyle = '#efebe9';
+        ctx.lineWidth = 22;
+        ctx.beginPath();
+        ctx.moveTo(CX + halfWidthAt(215) - 6, 215);
+        ctx.bezierCurveTo(CX + 190, 205, CX + 190, 345, CX + halfWidthAt(355) - 6, 355);
+        ctx.stroke();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      function drawCupBody() {
+        ctx.save();
+        cupPath();
+        const g = ctx.createLinearGradient(CX - TOP_HW, 0, CX + TOP_HW, 0);
+        g.addColorStop(0, '#d7ccc8');
+        g.addColorStop(0.35, '#ffffff');
+        g.addColorStop(1, '#cfc2bd');
+        ctx.fillStyle = g;
+        ctx.fill();
+        ctx.strokeStyle = '#a1887f';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Sleeve band holding the cup name field
+        ctx.clip();
+        const sTop = 282, sBottom = 362;
+        ctx.beginPath();
+        ctx.moveTo(CX - halfWidthAt(sTop) - 2, sTop);
+        ctx.lineTo(CX + halfWidthAt(sTop) + 2, sTop);
+        ctx.lineTo(CX + halfWidthAt(sBottom) + 2, sBottom);
+        ctx.lineTo(CX - halfWidthAt(sBottom) - 2, sBottom);
+        ctx.closePath();
+        ctx.fillStyle = '#4e342e';
+        ctx.fill();
+        ctx.strokeStyle = '#ffab40';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        ctx.moveTo(CX - TOP_HW, sTop + 4);
+        ctx.lineTo(CX + TOP_HW, sTop + 4);
+        ctx.moveTo(CX - TOP_HW, sBottom - 4);
+        ctx.lineTo(CX + TOP_HW, sBottom - 4);
+        ctx.stroke();
+        ctx.restore();
+
+        // Brand mark under the sleeve
+        ctx.save();
+        ctx.fillStyle = '#8d6e63';
+        ctx.font = 'bold 13px "Segoe UI", Tahoma, sans-serif';
+        ctx.textAlign = 'center';
+        ctx.fillText('THE DAILY GRIND', CX, 400);
+        ctx.restore();
+      }
+
+      function drawContents(milk, syrup) {
+        // Rim
+        ctx.save();
+        ctx.fillStyle = '#ffffff';
+        ctx.strokeStyle = '#a1887f';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.ellipse(CX, TOP, TOP_HW, RIM_RY, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+
+        // Coffee surface
+        ctx.beginPath();
+        ctx.ellipse(CX, TOP + 2, TOP_HW - 12, RIM_RY - 7, 0, 0, Math.PI * 2);
+        ctx.fillStyle = milk.coffee;
+        ctx.fill();
+        ctx.clip();
+
+        if (milk.foam) {
+          // Latte-art heart
+          ctx.fillStyle = milk.foam;
+          ctx.beginPath();
+          ctx.moveTo(CX, TOP + 16);
+          ctx.bezierCurveTo(CX - 70, TOP - 2, CX - 40, TOP - 22, CX, TOP - 8);
+          ctx.bezierCurveTo(CX + 40, TOP - 22, CX + 70, TOP - 2, CX, TOP + 16);
+          ctx.fill();
+        }
+
+        if (syrup.color) {
+          ctx.strokeStyle = syrup.color;
+          ctx.lineWidth = 3;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          for (let i = 0; i <= 10; i++) {
+            const x = CX - 100 + i * 20;
+            const y = TOP + (i % 2 ? 12 : -12);
+            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
+          }
+          ctx.stroke();
+        }
+        ctx.restore();
+      }
+
+      function drawConnectors() {
+        ctx.save();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.setLineDash([5, 5]);
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(176, 150);
+        ctx.quadraticCurveTo(200, 150, CX - 70, TOP + 2);
+        ctx.moveTo(464, 150);
+        ctx.quadraticCurveTo(440, 150, CX + 70, TOP + 2);
+        ctx.stroke();
+        ctx.setLineDash([]);
+        ctx.fillStyle = '#ffab40';
+        [[CX - 70, TOP + 2], [CX + 70, TOP + 2]].forEach(([x, y]) => {
+          ctx.beginPath();
+          ctx.arc(x, y, 4, 0, Math.PI * 2);
+          ctx.fill();
+        });
+        ctx.restore();
+      }
+
+      function drawPanels() {
+        // Card backdrops behind the side controls
+        ctx.save();
+        ctx.fillStyle = '#fafafa';
+        ctx.strokeStyle = '#d7ccc8';
+        ctx.lineWidth = 1.5;
+        fields.filter((f) => f.classList.contains('side-field')).forEach((f) => {
+          roundRect(+f.dataset.x - 10, +f.dataset.y - 10, 170, 80, 10);
+          ctx.fill();
+          ctx.stroke();
+        });
+        ctx.restore();
+      }
+
+      function describe() {
+        const milk = MILKS[milkSelect.value] || MILKS.none;
+        const syrup = SYRUPS[syrupSelect.value] || SYRUPS.none;
+        const name = nameInput.value.trim() || 'Your Cup';
+        const drink = milkSelect.value === 'none' ? 'Americano' : 'Latte';
+        const extra = syrup.color ? ' with ' + syrup.label : '';
+        const milkText = milk.foam ? ' ' + milk.label.replace(' milk', '') : '';
+        return { milk, syrup, name, line: (milkText ? milkText.trim().replace(/^./, (c) => c.toUpperCase()) + ' ' : '') + drink + extra };
+      }
+
+      function drawSummary(d) {
+        ctx.save();
+        ctx.textAlign = 'center';
+        ctx.fillStyle = '#4e342e';
+        ctx.font = 'bold 20px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('“' + d.name + '”', CX, 500);
+        ctx.fillStyle = '#6d4c41';
+        ctx.font = '15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(d.line, CX, 522);
+        ctx.restore();
+      }
+
+      function draw() {
+        const scale = canvas.width / W;
+        if (!scale) return;
+        const d = describe();
+
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+
+        drawSteam();
+        drawSaucerAndShadow();
+        drawHandle();
+        drawCupBody();
+        drawContents(d.milk, d.syrup);
+        drawPanels();
+        drawConnectors();
+        drawSummary(d);
+
+        if (htmlInCanvas) {
+          fields.forEach((f) => {
+            const t = drawElementFn.call(ctx, f, +f.dataset.x, +f.dataset.y);
+            if (t && typeof t.toString === 'function') f.style.transform = t.toString();
+          });
+        }
+
+        summaryEl.textContent = d.name + ': ' + d.line + '.';
+      }
+
+      function requestDraw() {
+        if (htmlInCanvas && typeof canvas.requestPaint === 'function') canvas.requestPaint();
+        else draw();
+      }
+
+      // Size the backing store in device pixels for crisp rendering on high-DPI displays.
+      function resize(entry) {
+        let w, h;
+        const box = entry && entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0];
+        if (box) {
+          w = box.inlineSize;
+          h = box.blockSize;
+        } else {
+          const rect = canvas.getBoundingClientRect();
+          const dpr = window.devicePixelRatio || 1;
+          w = Math.round(rect.width * dpr);
+          h = Math.round(rect.height * dpr);
+        }
+        if (w && h && (canvas.width !== w || canvas.height !== h)) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+        if (overlay) overlay.style.transform = 'scale(' + canvas.clientWidth / W + ')';
+        draw();
+      }
+
+      if ('ResizeObserver' in window) {
+        const ro = new ResizeObserver((entries) => resize(entries[0]));
+        try {
+          ro.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch (e) {
+          ro.observe(canvas);
+        }
+      } else {
+        window.addEventListener('resize', () => resize());
+        resize();
+      }
+
+      if (htmlInCanvas) canvas.addEventListener('paint', draw);
+      [nameInput, milkSelect, syrupSelect].forEach((el) => {
+        el.addEventListener('input', requestDraw);
+        el.addEventListener('change', requestDraw);
+      });
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(requestDraw);
+    })();
+  </script>
+
 </body>
 
