+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const panel = document.getElementById('cup-panel');
+      const ctx = canvas.getContext('2d');
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      const MILK = {
+        none: { coffee: '#3b2418', foam: '#5d3a24', label: 'black coffee' },
+        whole: { coffee: '#8d5b3e', foam: '#e8d5c0', label: 'whole milk latte' },
+        oat: { coffee: '#a47551', foam: '#efe0c8', label: 'oat latte' },
+        almond: { coffee: '#9c6b4a', foam: '#ead8c3', label: 'almond latte' },
+        soy: { coffee: '#94654a', foam: '#e6d3bd', label: 'soy latte' }
+      };
+      const SYRUP = {
+        none: null,
+        vanilla: '#f3e2a9',
+        caramel: '#c68e17',
+        hazelnut: '#8b5a2b',
+        maple: '#bb6528'
+      };
+
+      // Without HTML-in-Canvas, the panel's DOM children aren't rendered, so
+      // overlay it on the canvas and position it where the cup is drawn.
+      if (!supportsHtmlInCanvas) stage.append(panel);
+
+      // Cup geometry in CSS pixels, derived from the canvas's CSS size.
+      function geometry() {
+        const w = canvas.clientWidth;
+        const h = canvas.clientHeight;
+        const cx = w * 0.46;
+        const top = h * 0.2;
+        const bottom = h * 0.86;
+        const topW = w * 0.64;
+        const bottomW = w * 0.5;
+        const rimRy = h * 0.035;
+        const pad = w * 0.035;
+        const panelW = bottomW - pad * 2;
+        return { w, h, cx, top, bottom, topW, bottomW, rimRy, panelW, panelX: cx - panelW / 2 };
+      }
+
+      function panelY(g) {
+        const bodyTop = g.top + g.rimRy;
+        return bodyTop + Math.max(0, (g.bottom - bodyTop - panel.offsetHeight) / 2);
+      }
+
+      function drawCup(g) {
+        const { w, h, cx, top, bottom, topW, bottomW, rimRy } = g;
+        const milk = MILK[panel.milk.value];
+        const syrup = SYRUP[panel.syrup.value];
+
+        // Background
+        const bg = ctx.createLinearGradient(0, 0, 0, h);
+        bg.addColorStop(0, '#fff3e0');
+        bg.addColorStop(1, '#d7ccc8');
+        ctx.fillStyle = bg;
+        ctx.fillRect(0, 0, w, h);
+
+        // Steam
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
+        ctx.lineWidth = Math.max(2, w * 0.012);
+        ctx.lineCap = 'round';
+        for (const dx of [-0.12, 0, 0.12]) {
+          const x = cx + dx * w;
+          ctx.beginPath();
+          ctx.moveTo(x, top - h * 0.03);
+          ctx.bezierCurveTo(x - w * 0.04, top - h * 0.07, x + w * 0.04, top - h * 0.1, x, top - h * 0.15);
+          ctx.stroke();
+        }
+
+        // Saucer
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.15)';
+        ctx.beginPath();
+        ctx.ellipse(cx, bottom + h * 0.035, w * 0.42, h * 0.05, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#fafafa';
+        ctx.beginPath();
+        ctx.ellipse(cx, bottom + h * 0.02, w * 0.4, h * 0.045, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#efebe9';
+        ctx.lineWidth = w * 0.04;
+        ctx.beginPath();
+        ctx.ellipse(cx + topW * 0.47, top + (bottom - top) * 0.42, w * 0.12, h * 0.15, 0, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+
+        // Cup body
+        const body = ctx.createLinearGradient(cx - topW / 2, 0, cx + topW / 2, 0);
+        body.addColorStop(0, '#d7ccc8');
+        body.addColorStop(0.35, '#ffffff');
+        body.addColorStop(1, '#bcaaa4');
+        ctx.fillStyle = body;
+        ctx.beginPath();
+        ctx.moveTo(cx - topW / 2, top);
+        ctx.lineTo(cx + topW / 2, top);
+        ctx.lineTo(cx + bottomW / 2, bottom - rimRy);
+        ctx.quadraticCurveTo(cx + bottomW / 2, bottom, cx + bottomW / 2 - rimRy, bottom);
+        ctx.lineTo(cx - bottomW / 2 + rimRy, bottom);
+        ctx.quadraticCurveTo(cx - bottomW / 2, bottom, cx - bottomW / 2, bottom - rimRy);
+        ctx.closePath();
+        ctx.fill();
+
+        // Rim and coffee surface
+        ctx.fillStyle = '#efebe9';
+        ctx.beginPath();
+        ctx.ellipse(cx, top, topW / 2, rimRy, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const surface = ctx.createRadialGradient(cx, top, 0, cx, top, topW / 2);
+        surface.addColorStop(0, milk.foam);
+        surface.addColorStop(1, milk.coffee);
+        ctx.fillStyle = surface;
+        ctx.beginPath();
+        ctx.ellipse(cx, top, topW / 2 - w * 0.015, rimRy * 0.75, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Syrup drizzle on top
+        if (syrup) {
+          ctx.save();
+          ctx.clip();
+          ctx.strokeStyle = syrup;
+          ctx.lineWidth = Math.max(1.5, w * 0.006);
+          ctx.beginPath();
+          const span = topW * 0.38;
+          for (let i = 0; i <= 8; i++) {
+            const x = cx - span + (span * 2 * i) / 8;
+            const y = top + (i % 2 ? rimRy * 0.4 : -rimRy * 0.4);
+            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
+          }
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      function updateSummary() {
+        const name = panel.cupName.value.trim();
+        const milk = MILK[panel.milk.value].label;
+        const syrup = panel.syrup.value === 'none' ? '' : ` with ${panel.syrup.value}`;
+        panel.summary.value = `${name ? `${name}'s` : 'Your'} ${milk}${syrup}`;
+      }
+
+      function render() {
+        const g = geometry();
+        const scale = canvas.width / g.w;
+        ctx.reset?.();
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+        drawCup(g);
+        if (supportsHtmlInCanvas) {
+          // drawElementImage syncs hit testing and accessibility bounds with the drawn position.
+          ctx.drawElementImage(panel, g.panelX, panelY(g), panel.offsetWidth, panel.offsetHeight);
+        } else {
+          panel.style.left = `${g.panelX}px`;
+          panel.style.top = `${panelY(g)}px`;
+        }
+      }
+
+      const requestRender = () => supportsHtmlInCanvas ? canvas.requestPaint() : render();
+
+      if (supportsHtmlInCanvas) canvas.onpaint = render;
+
+      panel.addEventListener('input', () => {
+        updateSummary();
+        requestRender();
+      });
+      panel.addEventListener('submit', (event) => event.preventDefault());
+
+      // Match the canvas backing store to device pixels for crisp high-DPI rendering.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        panel.style.width = `${geometry().panelW}px`;
+        requestRender();
+      });
+      const supportsDevicePixelContentBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      updateSummary();
+    })();
+  </script>
+
