diff --git a/js/star-rating.js b/js/star-rating.js
new file mode 100644
index 0000000..822bd26
--- /dev/null
+++ b/js/star-rating.js
@@ -0,0 +1,326 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Attributes:
+ *   name      Form field name.
+ *   value     Default (initial) rating; the form resets to this.
+ *   max       Number of stars (default 5).
+ *   required  Requires a rating of at least 1 star.
+ *   disabled  Disables the control (also disabled by an ancestor <fieldset disabled>).
+ *   readonly  Prevents user changes; value is still submitted.
+ *
+ * Fires `input` and `change` when the user changes the rating.
+ */
+const STAR_PATH =
+  'M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      --star-size: 2rem;
+      --star-color: #ffab40;
+      --star-empty: #d7ccc8;
+      --star-focus: #4e342e;
+      display: inline-flex;
+      gap: 0.15rem;
+      border-radius: 6px;
+      padding: 2px;
+      cursor: pointer;
+      outline: none;
+      -webkit-tap-highlight-color: transparent;
+      touch-action: manipulation;
+    }
+    :host(:focus-visible) {
+      box-shadow: 0 0 0 3px var(--star-focus);
+    }
+    :host([readonly]) { cursor: default; }
+    :host([data-disabled]) {
+      cursor: not-allowed;
+      opacity: 0.45;
+    }
+    .star {
+      width: var(--star-size);
+      height: var(--star-size);
+      display: block;
+      fill: var(--star-empty);
+      transition: fill 0.15s, transform 0.15s;
+    }
+    .star.on { fill: var(--star-color); }
+    :host(:not([data-disabled]):not([readonly])) .star:hover { transform: scale(1.12); }
+    svg { pointer-events: none; }
+    @media (prefers-reduced-motion: reduce) {
+      .star { transition: none; }
+    }
+  </style>
+  <div class="stars" part="stars" style="display:contents"></div>
+`;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'max', 'required', 'disabled', 'readonly'];
+
+  #internals = this.attachInternals();
+  #value = 0;
+  #dirty = false; // true once the user/script sets value; stops tracking the attribute
+  #formDisabled = false; // disabled via ancestor fieldset/form
+  #hover = 0;
+  #customError = '';
+  #starsEl;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#starsEl = root.querySelector('.stars');
+    this.#internals.role = 'slider';
+    this.#internals.ariaValueMin = '0';
+
+    this.addEventListener('click', this.#onClick);
+    this.addEventListener('keydown', this.#onKeyDown);
+    this.addEventListener('pointermove', this.#onPointerMove);
+    this.addEventListener('pointerleave', this.#onPointerLeave);
+  }
+
+  connectedCallback() {
+    this.#value = this.#dirty ? this.#value : this.defaultValue;
+    this.#renderStars();
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    switch (name) {
+      case 'value':
+        if (!this.#dirty) this.#value = this.defaultValue;
+        break;
+      case 'max':
+        this.#value = this.#clamp(this.#value);
+        this.#renderStars();
+        break;
+    }
+    this.#update();
+  }
+
+  // --- Form-associated lifecycle ---------------------------------------
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.defaultValue;
+    this.#update();
+  }
+
+  formDisabledCallback(disabled) {
+    this.#formDisabled = disabled;
+    this.#update();
+  }
+
+  formStateRestoreCallback(state) {
+    // `state` is what we passed as the second argument to setFormValue.
+    const n = Number.parseInt(state, 10);
+    if (Number.isNaN(n)) return;
+    this.#dirty = true;
+    this.#value = this.#clamp(n);
+    this.#update();
+  }
+
+  // --- Public API (mirrors native form controls) -----------------------
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#value = this.#clamp(Number(v) || 0);
+    this.#update();
+  }
+
+  get defaultValue() { return this.#clamp(Number.parseInt(this.getAttribute('value'), 10) || 0); }
+  set defaultValue(v) { this.setAttribute('value', String(v)); }
+
+  get max() {
+    const m = Number.parseInt(this.getAttribute('max'), 10);
+    return m > 0 ? Math.min(m, 10) : 5;
+  }
+  set max(v) { this.setAttribute('max', String(v)); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get readOnly() { return this.hasAttribute('readonly'); }
+  set readOnly(v) { this.toggleAttribute('readonly', Boolean(v)); }
+
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get type() { return this.localName; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(message) {
+    this.#customError = String(message ?? '');
+    this.#updateValidity();
+  }
+
+  // --- Internals -------------------------------------------------------
+
+  get #isDisabled() { return this.disabled || this.#formDisabled; }
+  get #isInteractive() { return !this.#isDisabled && !this.readOnly; }
+
+  #clamp(n) { return Math.max(0, Math.min(this.max, Math.round(n))); }
+
+  #renderStars() {
+    const max = this.max;
+    if (this.#starsEl.childElementCount === max) return;
+    this.#starsEl.replaceChildren();
+    for (let i = 1; i <= max; i++) {
+      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+      svg.setAttribute('viewBox', '0 0 24 24');
+      svg.setAttribute('aria-hidden', 'true');
+      svg.setAttribute('class', 'star');
+      svg.setAttribute('part', 'star');
+      svg.dataset.value = String(i);
+      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
+      path.setAttribute('d', STAR_PATH);
+      svg.append(path);
+      this.#starsEl.append(svg);
+    }
+  }
+
+  #update() {
+    if (!this.#starsEl) return;
+    const shown = this.#hover || this.#value;
+    for (const star of this.#starsEl.children) {
+      const on = Number(star.dataset.value) <= shown;
+      star.classList.toggle('on', on);
+      star.setAttribute('part', on ? 'star star-on' : 'star');
+    }
+
+    const disabled = this.#isDisabled;
+    if (disabled) {
+      this.removeAttribute('tabindex');
+    } else if (!this.hasAttribute('tabindex')) {
+      this.setAttribute('tabindex', '0');
+    }
+    this.#setState('disabled', disabled);
+    this.#setState('rated', this.#value > 0);
+
+    const i = this.#internals;
+    i.ariaValueMax = String(this.max);
+    i.ariaValueNow = String(this.#value);
+    i.ariaValueText = this.#value
+      ? `${this.#value} of ${this.max} stars`
+      : 'Not rated';
+    i.ariaRequired = String(this.required);
+    i.ariaDisabled = String(disabled);
+    i.ariaReadOnly = String(this.readOnly);
+
+    // Submit nothing when unrated, like an unchecked radio group.
+    const v = this.#value ? String(this.#value) : null;
+    i.setFormValue(v, String(this.#value));
+    this.#updateValidity();
+  }
+
+  #updateValidity() {
+    const i = this.#internals;
+    if (this.#customError) {
+      i.setValidity({ customError: true }, this.#customError);
+    } else if (this.required && this.#value === 0) {
+      i.setValidity({ valueMissing: true }, 'Please select a star rating.');
+    } else {
+      i.setValidity({});
+    }
+  }
+
+  #setState(state, on) {
+    // Expose as :state(x) where supported, with a data-attribute fallback for styling.
+    try {
+      on ? this.#internals.states.add(state) : this.#internals.states.delete(state);
+    } catch { /* CustomStateSet unsupported */ }
+    this.toggleAttribute(`data-${state}`, on);
+  }
+
+  #commit(next) {
+    next = this.#clamp(next);
+    if (next === this.#value) return;
+    this.#dirty = true;
+    this.#value = next;
+    this.#update();
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #starFromEvent(e) {
+    const stars = [...this.#starsEl.children];
+    if (!stars.length) return 0;
+    // Resolve by horizontal position so gaps between stars still count.
+    const x = e.clientX;
+    for (const star of stars) {
+      const r = star.getBoundingClientRect();
+      if (x <= r.right) return Number(star.dataset.value);
+    }
+    return stars.length;
+  }
+
+  #onClick = (e) => {
+    if (!this.#isInteractive) return;
+    // Clicks forwarded from a <label> have no meaningful coordinates.
+    if (e.detail === 0 && e.clientX === 0 && e.clientY === 0) {
+      this.focus();
+      return;
+    }
+    this.#commit(this.#starFromEvent(e));
+  };
+
+  #onPointerMove = (e) => {
+    if (!this.#isInteractive || e.pointerType === 'touch') return;
+    const h = this.#starFromEvent(e);
+    if (h !== this.#hover) {
+      this.#hover = h;
+      this.#update();
+    }
+  };
+
+  #onPointerLeave = () => {
+    if (this.#hover) {
+      this.#hover = 0;
+      this.#update();
+    }
+  };
+
+  #onKeyDown = (e) => {
+    if (!this.#isInteractive || e.altKey || e.ctrlKey || e.metaKey) return;
+    let next;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = this.#value + 1; break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = this.#value - 1; break;
+      case 'Home': next = this.required ? 1 : 0; break;
+      case 'End': next = this.max; break;
+      case 'Backspace':
+      case 'Delete': next = 0; break;
+      default:
+        if (/^[0-9]$/.test(e.key)) next = Number(e.key);
+        else if (e.key === 'Enter') {
+          this.form?.requestSubmit();
+          e.preventDefault();
+          return;
+        } else return;
+    }
+    e.preventDefault();
+    this.#commit(next);
+  };
+}
+
+if (!customElements.get('star-rating')) {
+  customElements.define('star-rating', StarRating);
+}
+
+export { StarRating };
