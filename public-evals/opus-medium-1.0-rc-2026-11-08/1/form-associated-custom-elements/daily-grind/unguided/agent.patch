+  <script type="module" src="/js/star-rating.js"></script>
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const inStore = document.getElementById('fb-instore');
+    const inStoreFieldset = document.getElementById('fb-instore-fieldset');
+    const thanks = document.getElementById('fb-thanks');
+
+    const errorFor = (el) => document.getElementById(el.getAttribute('aria-describedby'));
+
+    const showError = (el) => {
+      const msg = errorFor(el);
+      if (!msg) return;
+      msg.textContent = el.validationMessage;
+      msg.hidden = false;
+    };
+
+    const clearError = (el) => {
+      const msg = errorFor(el);
+      if (msg) msg.hidden = true;
+    };
+
+    // Disabled fieldsets exclude their controls (including <star-rating>) from
+    // validation and submission, so required in-store ratings only apply when checked.
+    const syncInStore = () => {
+      inStoreFieldset.disabled = !inStore.checked;
+      if (inStoreFieldset.disabled) inStoreFieldset.querySelectorAll('star-rating').forEach(clearError);
+    };
+    inStore.addEventListener('change', syncInStore);
+    syncInStore(); // checkbox state may have been restored by the browser
+    window.addEventListener('pageshow', syncInStore);
+
+    // `invalid` doesn't bubble; capture it to render inline messages.
+    form.addEventListener('invalid', (e) => {
+      form.classList.add('was-validated');
+      if (e.target.localName === 'star-rating') showError(e.target);
+    }, true);
+
+    form.addEventListener('change', (e) => {
+      if (e.target.localName === 'star-rating' && e.target.validity.valid) clearError(e.target);
+    });
+
+    form.addEventListener('submit', (e) => {
+      // Only fires once native constraint validation (including <star-rating required>) passes.
+      e.preventDefault();
+
+      const data = new FormData(form);
+      const overall = Number(data.get('overall'));
+      thanks.textContent = `Thanks! You gave us ${overall} star${overall === 1 ? '' : 's'}` +
+        ` — your feedback is on its way to the roastery.`;
+      // A real deployment would POST here, e.g. fetch(form.action, { method: 'POST', body: data }).
+      console.info('Feedback submitted', Object.fromEntries(data));
+
+      form.reset();
+      thanks.hidden = false;
+    });
+
+    form.addEventListener('reset', () => {
+      form.classList.remove('was-validated');
+      form.querySelectorAll('star-rating').forEach(clearError);
+      thanks.hidden = true;
+      // Reset updates the checkbox after this event fires.
+      setTimeout(syncInStore);
+    });
+  </script>
+
