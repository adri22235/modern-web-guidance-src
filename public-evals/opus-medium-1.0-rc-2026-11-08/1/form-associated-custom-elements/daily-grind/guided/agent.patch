+  <script type="module" src="./star-rating.js"></script>
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const fieldset = document.getElementById('feedback-fieldset');
+    const status = document.getElementById('feedback-status');
+    const again = document.getElementById('feedback-again');
+    const nativeFields = 'select[required], input[required], textarea[required]';
+
+    // Mirror :user-invalid into aria-invalid for native fields
+    // (<star-rating> manages its own via ElementInternals).
+    const syncAriaInvalid = (field) => {
+      if (field.matches(':user-invalid')) field.setAttribute('aria-invalid', 'true');
+      else if (field.matches(':user-valid')) field.removeAttribute('aria-invalid');
+    };
+    form.addEventListener('blur', (e) => {
+      if (e.target.matches(nativeFields)) syncAriaInvalid(e.target);
+    }, true);
+    form.addEventListener('change', (e) => {
+      if (e.target.matches(nativeFields)) syncAriaInvalid(e.target);
+    });
+    form.addEventListener('invalid', (e) => {
+      if (e.target.matches(nativeFields)) e.target.setAttribute('aria-invalid', 'true');
+    }, true);
+
+    // Only fires once every control, including <star-rating>, is valid.
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const data = new FormData(form);
+      fieldset.disabled = true;
+      status.textContent = 'Sending your feedback…';
+
+      // No backend on this static site; simulate the request.
+      await new Promise((resolve) => setTimeout(resolve, 800));
+
+      const name = data.get('name')?.trim();
+      const rating = Number(data.get('rating'));
+      status.textContent = `Thanks${name ? `, ${name}` : ''}! You gave your ${data.get('drink')} `
+        + `${rating} ${rating === 1 ? 'star' : 'stars'}.`;
+      again.hidden = false;
+      again.focus();
+    });
+
+    form.addEventListener('reset', () => {
+      const wasSubmitted = !again.hidden;
+      fieldset.disabled = false;
+      status.textContent = '';
+      again.hidden = true;
+      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
+      // The focused "Leave another review" button is about to be hidden.
+      if (wasSubmitted) form.elements.drink.focus();
+    });
+  </script>
+
