diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..51cb4d7
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,319 @@
+// <star-rating> — a form-associated custom element.
+// Submits its own value via ElementInternals, takes part in constraint
+// validation, and reacts to form reset, <fieldset disabled>, and
+// back/forward state restoration just like a native control.
+
+const STAR_PATH =
+  'M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      --star-size: 2.25rem;
+      --star-fill: #ffab40;
+      --star-empty: #efebe9;
+      --star-stroke: #8d6e63;
+      display: inline-block;
+    }
+
+    :host(:disabled) {
+      opacity: 0.5;
+    }
+
+    .stars {
+      display: inline-flex;
+      gap: 0.25rem;
+    }
+
+    label {
+      position: relative;
+      display: grid;
+      cursor: pointer;
+      border-radius: 4px;
+    }
+
+    :host(:disabled) label {
+      cursor: not-allowed;
+    }
+
+    /* The real (visually hidden) radio sits over the star so clicks land on it. */
+    input {
+      position: absolute;
+      inset: 0;
+      margin: 0;
+      opacity: 0;
+      cursor: inherit;
+    }
+
+    svg {
+      width: var(--star-size);
+      height: var(--star-size);
+      fill: var(--star-empty);
+      stroke: var(--star-stroke);
+      stroke-width: 1;
+      stroke-linejoin: round;
+    }
+
+    label:has(input:focus-visible) {
+      outline: 3px solid var(--star-stroke);
+      outline-offset: 2px;
+    }
+
+    /* Fill the checked star and every star before it. */
+    label:has(input:checked) svg,
+    label:has(~ label input:checked) svg {
+      fill: var(--star-fill);
+    }
+
+    /* Hover preview: clear, then fill up to the hovered star. */
+    :host(:not(:disabled)) .stars:hover label svg {
+      fill: var(--star-empty);
+    }
+
+    :host(:not(:disabled)) .stars:hover label:hover svg,
+    :host(:not(:disabled)) .stars:hover label:has(~ label:hover) svg {
+      fill: var(--star-fill);
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      svg {
+        transition: fill 0.15s, transform 0.15s;
+      }
+
+      :host(:not(:disabled)) label:hover svg {
+        transform: scale(1.15);
+      }
+    }
+
+    @media (forced-colors: active) {
+      svg {
+        fill: Canvas;
+        stroke: CanvasText;
+      }
+
+      label:has(input:checked) svg,
+      label:has(~ label input:checked) svg {
+        fill: Highlight;
+      }
+
+      :host(:disabled) svg {
+        stroke: GrayText;
+      }
+    }
+  </style>
+  <div class="stars" part="stars"></div>
+`;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['max', 'required', 'value'];
+
+  #internals;
+  #group;
+  #value = '';
+  #dirty = false; // true once the user (or restore) has changed the value
+  #interacted = false; // gates the user-invalid state, like :user-invalid
+  #disabled = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    shadow.append(template.content.cloneNode(true));
+    this.#group = shadow.querySelector('.stars');
+
+    // The inner radios' composed `input` event would leak out retargeted to
+    // the host; swallow it and dispatch our own alongside `change`.
+    shadow.addEventListener('input', (event) => event.stopPropagation());
+    shadow.addEventListener('change', (event) => {
+      event.stopPropagation();
+      this.#dirty = true;
+      this.#interacted = true;
+      this.#setValue(event.target.value);
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+
+    // A failed submit / reportValidity() counts as interaction.
+    this.addEventListener('invalid', () => {
+      this.#interacted = true;
+      this.#syncUserInvalid();
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#group.childElementCount) this.#render();
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'max') {
+      this.#render();
+      if (Number(this.#value) > this.max) this.#value = '';
+    } else if (name === 'value' && !this.#dirty) {
+      // Like <input value>, the attribute is the default until the user edits.
+      this.#value = this.#normalize(this.defaultValue);
+    }
+    this.#update();
+  }
+
+  // --- Form lifecycle callbacks ---
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#interacted = false;
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable the inner radios rather than the host, so a re-enabled
+    // <fieldset> can re-enable this element too.
+    this.#disabled = disabled;
+    for (const input of this.#inputs) input.disabled = disabled;
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#setValue(state ?? '');
+  }
+
+  // --- Public API mirroring native controls ---
+
+  get value() {
+    return this.#value;
+  }
+
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get defaultValue() {
+    return this.getAttribute('value') ?? '';
+  }
+
+  set defaultValue(v) {
+    this.setAttribute('value', v);
+  }
+
+  get max() {
+    const max = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(max) ? Math.min(Math.max(max, 1), 10) : 5;
+  }
+
+  set max(v) {
+    this.setAttribute('max', v);
+  }
+
+  get required() {
+    return this.hasAttribute('required');
+  }
+
+  set required(v) {
+    this.toggleAttribute('required', Boolean(v));
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+
+  get type() {
+    return this.localName;
+  }
+
+  get form() {
+    return this.#internals.form;
+  }
+
+  get labels() {
+    return this.#internals.labels;
+  }
+
+  get validity() {
+    return this.#internals.validity;
+  }
+
+  get validationMessage() {
+    return this.#internals.validationMessage;
+  }
+
+  get willValidate() {
+    return this.#internals.willValidate;
+  }
+
+  checkValidity() {
+    return this.#internals.checkValidity();
+  }
+
+  reportValidity() {
+    return this.#internals.reportValidity();
+  }
+
+  // --- Internals ---
+
+  get #inputs() {
+    return this.#group.querySelectorAll('input');
+  }
+
+  #normalize(v) {
+    const n = Number(v);
+    return Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+  }
+
+  #setValue(v) {
+    this.#value = this.#normalize(v);
+    this.#update();
+  }
+
+  #render() {
+    const max = this.max;
+    const labels = [];
+    for (let i = 1; i <= max; i++) {
+      const label = document.createElement('label');
+      label.innerHTML = `
+        <input type="radio" name="star" value="${i}"
+               aria-label="${i} ${i === 1 ? 'star' : 'stars'}">
+        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="${STAR_PATH}"/></svg>`;
+      label.firstElementChild.disabled = this.#disabled;
+      labels.push(label);
+    }
+    this.#group.replaceChildren(...labels);
+  }
+
+  #update() {
+    let checked = null;
+    for (const input of this.#inputs) {
+      input.checked = input.value === this.#value;
+      if (input.checked) checked = input;
+    }
+
+    // `null` omits the entry from FormData, like an unchecked radio group.
+    // The state argument is what the browser hands back on restore.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.ariaRequired = String(this.required);
+
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        checked ?? this.#inputs[0],
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+    this.#syncUserInvalid();
+  }
+
+  #syncUserInvalid() {
+    const show = this.#interacted && !this.#internals.validity.valid;
+    this.#internals.ariaInvalid = show ? 'true' : null;
+    // Exposed to page CSS as star-rating:state(user-invalid).
+    if (show) this.#internals.states?.add('user-invalid');
+    else this.#internals.states?.delete('user-invalid');
+  }
+}
+
+customElements.define('star-rating', StarRating);
