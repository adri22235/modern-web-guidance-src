+++ b/src/pages/api/phone/send-code.ts
@@ -0,0 +1,54 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_TTL_MS,
+  RESEND_COOLDOWN_MS,
+  buildOtpMessage,
+  generateOtp,
+  hashOtp,
+  normalizePhone,
+  sendSms,
+  type PendingPhoneVerification,
+} from '../../../utils/phoneVerification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are unavailable' }, 500);
+
+  const { phone: rawPhone } = await request.json().catch(() => ({}));
+  const phone = normalizePhone(rawPhone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including the country code, for example +1 555 123 4567.' }, 400);
+  }
+
+  const now = Date.now();
+  const previous = (await session.get('phoneVerification')) as PendingPhoneVerification | undefined;
+  if (previous && previous.phone === phone && now - previous.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - previous.sentAt)) / 1000);
+    return json({ error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter }, 429);
+  }
+
+  const code = generateOtp();
+  // Host only (no scheme/port/path), as required by the origin-bound SMS format.
+  const host = process.env.OTP_SMS_DOMAIN || url.hostname;
+
+  try {
+    await sendSms(phone, buildOtpMessage(code, host));
+  } catch (err) {
+    console.error('Failed to send verification SMS:', err);
+    return json({ error: 'We could not send a text message right now. Please try again later.' }, 503);
+  }
+
+  const pending: PendingPhoneVerification = {
+    phone,
+    codeHash: hashOtp(phone, code),
+    expiresAt: now + OTP_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  };
+  await session.set('phoneVerification', pending);
+  session.delete('verifiedPhone');
+
+  return json({ phone, expiresIn: OTP_TTL_MS / 1000, resendIn: RESEND_COOLDOWN_MS / 1000 });
+};
