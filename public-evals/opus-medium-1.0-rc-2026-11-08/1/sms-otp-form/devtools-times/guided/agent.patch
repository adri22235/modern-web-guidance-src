--- /dev/null
+++ b/src/utils/phoneVerification.ts
@@ -0,0 +1,68 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const OTP_LENGTH = 6;
+export const OTP_TTL_MS = 5 * 60 * 1000;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+export const MAX_VERIFY_ATTEMPTS = 5;
+
+export interface PendingPhoneVerification {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+/** Normalizes user input to E.164 (`+15551234567`), or returns null if it isn't a plausible number. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const cleaned = input.trim().replace(/^00/, '+').replace(/[\s\-().]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(cleaned) ? cleaned : null;
+}
+
+export function generateOtp(): string {
+  return randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+}
+
+export function hashOtp(phone: string, code: string): string {
+  return createHash('sha256').update(`${phone}:${code}`).digest('hex');
+}
+
+export function otpMatches(pending: PendingPhoneVerification, code: string): boolean {
+  const expected = Buffer.from(pending.codeHash, 'hex');
+  const actual = Buffer.from(hashOtp(pending.phone, code), 'hex');
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+/**
+ * Builds an origin-bound SMS body. The last line must be `@<host> #<code>` so that
+ * the WebOTP API and `autocomplete="one-time-code"` only offer the code on our domain.
+ */
+export function buildOtpMessage(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+/**
+ * Delivers an SMS. Set SMS_WEBHOOK_URL to forward messages to your SMS provider
+ * (receives `{ to, body }` as JSON). In development, messages are logged instead.
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const webhook = process.env.SMS_WEBHOOK_URL;
+  if (webhook) {
+    const response = await fetch(webhook, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        ...(process.env.SMS_WEBHOOK_TOKEN && { Authorization: `Bearer ${process.env.SMS_WEBHOOK_TOKEN}` }),
+      },
+      body: JSON.stringify({ to, body }),
+    });
+    if (!response.ok) throw new Error(`SMS provider responded with ${response.status}`);
+    return;
+  }
+  if (import.meta.env.DEV) {
+    console.info(`[sms] to ${to}:\n${body}`);
+    return;
+  }
+  throw new Error('No SMS provider configured (set SMS_WEBHOOK_URL)');
+}
