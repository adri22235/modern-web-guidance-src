@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import {
+  MAX_VERIFY_ATTEMPTS,
+  OTP_LENGTH,
+  otpMatches,
+  type PendingPhoneVerification,
+} from '../../../utils/phoneVerification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are unavailable' }, 500);
+
+  const { code } = await request.json().catch(() => ({}));
+  if (typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code from the text message.` }, 400);
+  }
+
+  const pending = (await session.get('phoneVerification')) as PendingPhoneVerification | undefined;
+  if (!pending) {
+    return json({ error: 'No verification is in progress. Request a new code.' }, 400);
+  }
+  if (Date.now() > pending.expiresAt) {
+    session.delete('phoneVerification');
+    return json({ error: 'This code has expired. Request a new code.', expired: true }, 410);
+  }
+  if (pending.attempts >= MAX_VERIFY_ATTEMPTS) {
+    session.delete('phoneVerification');
+    return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 429);
+  }
+
+  if (!otpMatches(pending, code)) {
+    pending.attempts += 1;
+    await session.set('phoneVerification', pending);
+    const remaining = MAX_VERIFY_ATTEMPTS - pending.attempts;
+    return json({ error: `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} left.` }, 400);
+  }
+
+  session.delete('phoneVerification');
+  await session.set('verifiedPhone', pending.phone);
+  return json({ verified: true, phone: pending.phone });
+};
diff --git a/src/utils/phoneVerification.ts b/src/utils/phoneVerification.ts
