+import type { APIRoute } from 'astro';
+import {
+  CODE_TTL_MS,
+  RESEND_COOLDOWN_MS,
+  buildSmsBody,
+  generateCode,
+  hashCode,
+  json,
+  normalizePhone,
+  sendSms,
+  type PendingVerification,
+} from '../../../utils/phone-verification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const phone = normalizePhone(body?.phone);
+  if (!phone) {
+    return json({ error: 'Please enter a valid phone number, including country code.' }, 400);
+  }
+
+  const now = Date.now();
+  const existing = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  if (existing && existing.phone === phone && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return json({ error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter }, 429);
+  }
+
+  const code = generateCode();
+  try {
+    await sendSms(phone, buildSmsBody(code, url.host));
+  } catch (err) {
+    console.error('[sms] failed to send verification code', err);
+    return json({ error: 'We could not send a text message to that number. Please try again.' }, 502);
+  }
+
+  const pending: PendingVerification = {
+    phone,
+    codeHash: hashCode(phone, code),
+    expiresAt: now + CODE_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  };
+  await session.set('phoneVerification', pending);
+  session.delete('verifiedPhone');
+
+  return json({
+    phone,
+    expiresIn: CODE_TTL_MS / 1000,
+    resendIn: RESEND_COOLDOWN_MS / 1000,
+  });
+};
