+import type { APIRoute } from 'astro';
+import {
+  CODE_LENGTH,
+  MAX_ATTEMPTS,
+  codeMatches,
+  json,
+  normalizePhone,
+  type PendingVerification,
+} from '../../../utils/phone-verification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const phone = normalizePhone(body?.phone);
+  const code = typeof body?.code === 'string' ? body.code.replace(/\D/g, '') : '';
+
+  if (!phone || code.length !== CODE_LENGTH) {
+    return json({ error: `Enter the ${CODE_LENGTH}-digit code we sent you.` }, 400);
+  }
+
+  const pending = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  if (!pending || pending.phone !== phone) {
+    return json({ error: 'No code was requested for this number. Please request a new code.' }, 400);
+  }
+
+  if (Date.now() > pending.expiresAt) {
+    session.delete('phoneVerification');
+    return json({ error: 'This code has expired. Please request a new one.', expired: true }, 410);
+  }
+
+  if (pending.attempts >= MAX_ATTEMPTS) {
+    session.delete('phoneVerification');
+    return json({ error: 'Too many incorrect attempts. Please request a new code.', expired: true }, 429);
+  }
+
+  if (!codeMatches(pending, code)) {
+    pending.attempts += 1;
+    const remaining = MAX_ATTEMPTS - pending.attempts;
+    if (remaining <= 0) {
+      session.delete('phoneVerification');
+      return json({ error: 'Too many incorrect attempts. Please request a new code.', expired: true }, 429);
+    }
+    await session.set('phoneVerification', pending);
+    return json({
+      error: `That code is incorrect. ${remaining} ${remaining === 1 ? 'attempt' : 'attempts'} remaining.`,
+      remaining,
+    }, 400);
+  }
+
+  session.delete('phoneVerification');
+  await session.set('verifiedPhone', phone);
+  return json({ verified: true, phone });
+};
