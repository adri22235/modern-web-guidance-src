+  <script>
+    (function () {
+      const CODE_LENGTH = 6;
+      const RESEND_SECONDS = 30;
+
+      const phoneForm = document.getElementById('phone-form');
+      const otpForm = document.getElementById('otp-form');
+      const phoneInput = document.getElementById('phone');
+      const phoneError = document.getElementById('phone-error');
+      const codeInput = document.getElementById('otp-code');
+      const codeError = document.getElementById('otp-error');
+      const verifyBtn = document.getElementById('verify-btn');
+      const resendBtn = document.getElementById('resend-btn');
+      const changeBtn = document.getElementById('change-phone');
+      const status = document.getElementById('verify-status');
+
+      let webOtpAbort = null;
+      let resendTimer = null;
+      let submitting = false;
+
+      function announce(message, type) {
+        status.textContent = message;
+        status.className = 'status' + (type ? ' ' + type : '');
+      }
+
+      function setError(input, errorEl, message) {
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+          errorEl.textContent = message;
+          errorEl.hidden = false;
+        } else {
+          input.removeAttribute('aria-invalid');
+          errorEl.textContent = '';
+          errorEl.hidden = true;
+        }
+      }
+
+      function normalizePhone(value) {
+        const digits = value.replace(/\D/g, '');
+        if (digits.length === 10) return '+1' + digits;
+        if (digits.length === 11 && digits[0] === '1') return '+' + digits;
+        return null;
+      }
+
+      function maskPhone(e164) {
+        return '(•••) •••-' + e164.slice(-4);
+      }
+
+      async function post(url, data) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(data),
+          credentials: 'same-origin'
+        });
+        if (!res.ok) {
+          const body = await res.json().catch(() => ({}));
+          throw new Error(body.message || 'Request failed');
+        }
+        return res.json().catch(() => ({}));
+      }
+
+      function startResendCountdown() {
+        let remaining = RESEND_SECONDS;
+        resendBtn.disabled = true;
+        resendBtn.textContent = 'Resend code in ' + remaining + 's';
+        clearInterval(resendTimer);
+        resendTimer = setInterval(() => {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(resendTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+          } else {
+            resendBtn.textContent = 'Resend code in ' + remaining + 's';
+          }
+        }, 1000);
+      }
+
+      // WebOTP API: reads the code from an SMS ending in "@<host> #<code>"
+      // (e.g. "Your Daily Grind code is 123456\n\n@dailygrind.com #123456").
+      // Browsers without support fall back to autocomplete="one-time-code".
+      function listenForSmsCode() {
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        if (webOtpAbort) webOtpAbort.abort();
+        webOtpAbort = new AbortController();
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: webOtpAbort.signal
+        }).then((otp) => {
+          if (!otp || !otp.code) return;
+          codeInput.value = otp.code.replace(/\D/g, '').slice(0, CODE_LENGTH);
+          announce('Code received from text message. Verifying…');
+          submitCode();
+        }).catch(() => {
+          // Aborted, denied, or timed out: the user can still type the code.
+        });
+      }
+
+      function stopListening() {
+        if (webOtpAbort) {
+          webOtpAbort.abort();
+          webOtpAbort = null;
+        }
+      }
+
+      async function sendCode() {
+        const phone = normalizePhone(phoneInput.value);
+        if (!phone) {
+          setError(phoneInput, phoneError, 'Enter a valid 10-digit US mobile number.');
+          phoneInput.focus();
+          return false;
+        }
+        setError(phoneInput, phoneError, '');
+
+        const purpose = phoneForm.elements.purpose.value;
+        document.getElementById('otp-phone').value = phone;
+        document.getElementById('otp-purpose').value = purpose;
+        document.getElementById('otp-sent-to').textContent = maskPhone(phone);
+
+        announce('Sending code…');
+        try {
+          await post(phoneForm.action, { phone, purpose });
+        } catch (err) {
+          announce('We couldn\u2019t send a code right now. Please try again.', 'error');
+          return false;
+        }
+        announce('Code sent to ' + maskPhone(phone) + '.');
+        startResendCountdown();
+        listenForSmsCode();
+        return true;
+      }
+
+      async function submitCode() {
+        if (submitting) return;
+        const code = codeInput.value.replace(/\D/g, '');
+        if (code.length !== CODE_LENGTH) {
+          setError(codeInput, codeError, 'Enter all 6 digits of the code.');
+          codeInput.focus();
+          return;
+        }
+        setError(codeInput, codeError, '');
+        submitting = true;
+        verifyBtn.disabled = true;
+        announce('Verifying…');
+
+        const purpose = document.getElementById('otp-purpose').value;
+        try {
+          await post(otpForm.action, {
+            phone: document.getElementById('otp-phone').value,
+            purpose,
+            code
+          });
+          stopListening();
+          clearInterval(resendTimer);
+          announce('Verified! Redirecting…', 'success');
+          window.location.href = purpose === 'order' ? '/order-online' : '/rewards';
+        } catch (err) {
+          setError(codeInput, codeError, 'That code is incorrect or expired. Check the text and try again.');
+          announce('Verification failed.', 'error');
+          codeInput.select();
+          codeInput.focus();
+        } finally {
+          submitting = false;
+          verifyBtn.disabled = false;
+        }
+      }
+
+      phoneForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const button = phoneForm.querySelector('button[type="submit"]');
+        button.disabled = true;
+        const ok = await sendCode();
+        button.disabled = false;
+        if (ok) {
+          phoneForm.hidden = true;
+          otpForm.hidden = false;
+          codeInput.value = '';
+          codeInput.focus();
+        }
+      });
+
+      otpForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        submitCode();
+      });
+
+      // Keep only digits (handles pasted text like "123 456" or a full SMS)
+      // and auto-submit once the full code is present.
+      codeInput.addEventListener('input', () => {
+        const digits = codeInput.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (codeInput.value !== digits) codeInput.value = digits;
+        if (codeInput.getAttribute('aria-invalid')) setError(codeInput, codeError, '');
+        if (digits.length === CODE_LENGTH) submitCode();
+      });
+
+      codeInput.addEventListener('paste', (e) => {
+        const text = (e.clipboardData || window.clipboardData).getData('text');
+        const match = text.match(/\b\d{6}\b/) || [text.replace(/\D/g, '')];
+        e.preventDefault();
+        codeInput.value = match[0].slice(0, CODE_LENGTH);
+        codeInput.dispatchEvent(new Event('input'));
+      });
+
+      phoneInput.addEventListener('input', () => {
+        if (phoneInput.getAttribute('aria-invalid')) setError(phoneInput, phoneError, '');
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        codeInput.value = '';
+        setError(codeInput, codeError, '');
+        await sendCode();
+        codeInput.focus();
+      });
+
+      changeBtn.addEventListener('click', () => {
+        stopListening();
+        clearInterval(resendTimer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        announce('');
+        phoneInput.focus();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
