+  <script>
+    (() => {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneError = document.getElementById('phone-error');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpError = document.getElementById('otp-error');
+      const otpHeading = document.getElementById('otp-heading');
+      const resendBtn = document.getElementById('resend-btn');
+      const changePhoneBtn = document.getElementById('change-phone-btn');
+      const status = document.getElementById('verify-status');
+
+      const PHONE_MESSAGE = 'Enter a valid mobile number with area code, e.g. (555) 123-4567.';
+      const OTP_MESSAGE = 'Enter the 6-digit code from your text message.';
+
+      let otpAbortController = null;
+
+      // Field errors: shown on blur/submit, cleared as soon as the user fixes the value
+      function setFieldError(input, errorEl, message) {
+        input.setCustomValidity(message);
+        input.setAttribute('aria-invalid', String(Boolean(message)));
+        errorEl.textContent = message;
+      }
+
+      function digitsOnly(value) {
+        return value.replace(/\D/g, '');
+      }
+
+      function validatePhone() {
+        const digits = digitsOnly(phoneInput.value);
+        const valid = digits.length >= 10 && digits.length <= 15;
+        setFieldError(phoneInput, phoneError, valid ? '' : PHONE_MESSAGE);
+        return valid;
+      }
+
+      function validateOtp() {
+        const valid = /^\d{6}$/.test(otpInput.value);
+        setFieldError(otpInput, otpError, valid ? '' : OTP_MESSAGE);
+        return valid;
+      }
+
+      async function post(form, data) {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          headers: { Accept: 'application/json' },
+          body: data,
+        });
+        if (!response.ok) {
+          const body = await response.json().catch(() => ({}));
+          throw new Error(body.message || 'Something went wrong. Please try again.');
+        }
+        return response.json().catch(() => ({}));
+      }
+
+      // WebOTP: listen for an origin-bound SMS ("@domain #123456") while the code step is active
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return;
+
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          setFieldError(otpInput, otpError, '');
+          otpForm.requestSubmit();
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP verification error:', err);
+        }
+      }
+
+      async function sendCode(button) {
+        const data = new FormData(phoneForm);
+        button.disabled = true;
+        status.textContent = 'Sending your code…';
+        try {
+          await post(phoneForm, data);
+          return true;
+        } catch (err) {
+          status.textContent = err.message;
+          return false;
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      function showOtpStep() {
+        const data = new FormData(phoneForm);
+        document.getElementById('otp-phone').value = data.get('phone');
+        document.getElementById('otp-purpose').value = data.get('purpose');
+        document.getElementById('otp-phone-display').textContent = data.get('phone');
+
+        otpInput.value = '';
+        setFieldError(otpInput, otpError, '');
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        status.textContent = 'Code sent. It may take a minute to arrive.';
+        otpHeading.focus();
+        startSmsOtpListener();
+      }
+
+      function showPhoneStep() {
+        stopSmsOtpListener();
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        status.textContent = '';
+        phoneInput.focus();
+      }
+
+      // Native constraint validation fires "invalid" before "submit"; mirror it inline
+      phoneInput.addEventListener('invalid', validatePhone);
+      otpInput.addEventListener('invalid', validateOtp);
+
+      // Step 1
+      phoneInput.addEventListener('input', () => {
+        if (phoneInput.getAttribute('aria-invalid') === 'true') validatePhone();
+      });
+      phoneInput.addEventListener('blur', () => {
+        if (phoneInput.value) validatePhone();
+      });
+
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (!validatePhone()) {
+          phoneInput.focus();
+          return;
+        }
+        if (await sendCode(event.submitter || phoneForm.querySelector('[type="submit"]'))) {
+          showOtpStep();
+        }
+      });
+
+      // Step 2
+      otpInput.addEventListener('input', () => {
+        // Strip spaces/dashes from pasted codes like "123 456"
+        const cleaned = digitsOnly(otpInput.value).slice(0, 6);
+        if (cleaned !== otpInput.value) otpInput.value = cleaned;
+        if (otpInput.getAttribute('aria-invalid') === 'true') validateOtp();
+      });
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value) validateOtp();
+      });
+
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        stopSmsOtpListener();
+
+        if (!validateOtp()) {
+          otpInput.focus();
+          return;
+        }
+
+        const button = otpForm.querySelector('[type="submit"]');
+        const purpose = document.getElementById('otp-purpose').value;
+        button.disabled = true;
+        status.textContent = 'Verifying…';
+
+        try {
+          const result = await post(otpForm, new FormData(otpForm));
+          status.textContent = 'You’re verified! Redirecting…';
+          window.location.assign(result.redirect || (purpose === 'order' ? '/order-online' : '/rewards'));
+        } catch (err) {
+          status.textContent = '';
+          setFieldError(otpInput, otpError, err.message);
+          otpInput.focus();
+          startSmsOtpListener();
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        stopSmsOtpListener();
+        if (await sendCode(resendBtn)) {
+          otpInput.value = '';
+          setFieldError(otpInput, otpError, '');
+          status.textContent = 'A new code is on its way.';
+          otpInput.focus();
+        }
+        startSmsOtpListener();
+      });
+
+      changePhoneBtn.addEventListener('click', showPhoneStep);
+
+      window.addEventListener('pagehide', stopSmsOtpListener);
+    })();
+  </script>
+
 </body>
 
