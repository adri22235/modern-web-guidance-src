+    /* Main layout: Seasonal Favorites alongside Loyalty Rewards */
+    .main-layout {
+      display: grid;
+      gap: 30px;
+      align-items: start;
+    }
+
+    @media (min-width: 900px) {
+      .main-layout {
+        grid-template-columns: 2fr 1fr;
+      }
+    }
+
+    /* Loyalty Rewards */
+    .rewards-card {
+      margin-top: 20px;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 15px;
+    }
+
+    .rewards-card .btn {
+      margin-top: 5px;
+    }
+
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+    }
+
+    progress.progress-ring {
+      --size: 180px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      --max: attr(max type(<number>));
+      appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      background: conic-gradient(var(--fill-color) calc(var(--value) / var(--max) * 100%),
+          var(--track-color) 0);
+      background-clip: border-area;
+      background-origin: border-box;
+      border: var(--thickness) solid transparent;
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.6s;
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        mask-image: radial-gradient(transparent calc(50% - var(--thickness)),
+            black calc(50% - var(--thickness) + 0.5px));
+        border: 0;
+      }
+    }
+
+    /* Reward earned: switch the fill to the brand's deep roast */
+    progress.progress-ring[value="10"] {
+      --fill-color: var(--primary);
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::slider-fill {
+      display: none;
+      background: none;
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      line-height: 1.2;
+      color: var(--primary);
+    }
+
+    .progress-ring-count {
+      font-size: 2.25rem;
+      font-weight: bold;
+    }
+
+    .progress-ring-count small {
+      font-size: 1rem;
+      font-weight: normal;
+      color: var(--text);
+    }
+
+    .progress-ring-label {
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+    }
+
