+  <script>
+    document.querySelectorAll('.progress-ring').forEach(function (ring) {
+      var goal = parseInt(ring.dataset.goal, 10) || 10;
+      var stamps = Math.min(Math.max(parseInt(ring.dataset.stamps, 10) || 0, 0), goal);
+      var fill = ring.querySelector('.progress-ring-fill');
+      var circumference = 2 * Math.PI * fill.r.baseVal.value;
+      var remaining = goal - stamps;
+
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-valuenow', stamps);
+      ring.querySelector('.progress-ring-current').textContent = stamps;
+      ring.querySelector('.progress-ring-goal').textContent = goal;
+
+      var remainingEl = ring.parentElement.querySelector('.rewards-remaining');
+      if (remainingEl) {
+        remainingEl.textContent = remaining + ' more drink' + (remaining === 1 ? '' : 's');
+      }
+      if (remaining === 0) {
+        var details = ring.parentElement.querySelector('.rewards-details');
+        details.querySelector('h3').textContent = 'Your free drink is ready!';
+        details.querySelector('p').textContent = 'Redeem it on your next visit or online order.';
+      }
+
+      fill.style.strokeDasharray = circumference;
+      fill.style.strokeDashoffset = circumference;
+      requestAnimationFrame(function () {
+        requestAnimationFrame(function () {
+          fill.style.strokeDashoffset = circumference * (1 - stamps / goal);
+        });
+      });
+    });
+  </script>
