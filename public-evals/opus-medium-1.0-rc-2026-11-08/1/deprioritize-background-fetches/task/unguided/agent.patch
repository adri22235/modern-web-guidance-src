diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,36 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Fetch</title>
+</head>
+<body>
+  <button id="go">Load</button>
+  <pre id="out"></pre>
+  <script>
+    const out = document.getElementById('out');
+
+    document.getElementById('go').addEventListener('click', () => {
+      // Mission-critical: hint the browser to prioritize this request.
+      fetch('/api/data', { priority: 'high' })
+        .then(r => {
+          if (!r.ok) throw new Error(`HTTP ${r.status}`);
+          return r.text();
+        })
+        .then(text => { out.textContent = text; })
+        .catch(err => { out.textContent = `Error: ${err.message}`; });
+
+      // Analytics: low priority so it doesn't compete with /api/data;
+      // keepalive lets it finish even if the page unloads.
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true
+      }).catch(() => {});
+    });
+  </script>
+</body>
+</html>
