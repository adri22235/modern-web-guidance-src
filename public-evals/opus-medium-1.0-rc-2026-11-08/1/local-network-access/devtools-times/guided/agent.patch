--- /dev/null
+++ b/src/components/DiagnosticsConnectWidget.tsx
@@ -0,0 +1,388 @@
+import React, { useEffect, useId, useState } from 'react';
+
+/**
+ * Developer diagnostics widget that connects from the browser to:
+ *  - a hardware test device on the reader's private LAN (Local Network Access: 'local-network')
+ *  - a companion CLI running on the reader's own machine (Local Network Access: 'loopback-network')
+ *
+ * Requests are only ever sent from an explicit button click (never on load), and each
+ * fetch declares `targetAddressSpace` so the browser can exempt http:// endpoints from
+ * Mixed Content blocking and verify the resolved IP really is local/loopback.
+ */
+
+type PermissionName = 'local-network' | 'loopback-network';
+type AddressSpace = 'local' | 'loopback';
+type PermissionState = 'granted' | 'prompt' | 'denied' | 'unsupported';
+
+type ConnectionStatus =
+  | { kind: 'idle' }
+  | { kind: 'connecting' }
+  | { kind: 'connected'; httpStatus: number; elapsedMs: number; body: string }
+  | { kind: 'error'; message: string };
+
+interface TargetConfig {
+  key: string;
+  title: string;
+  description: string;
+  permission: PermissionName;
+  addressSpace: AddressSpace;
+  defaultUrl: string;
+  urlHint: string;
+  validate: (url: URL) => string | null;
+  troubleshooting: string[];
+}
+
+const REQUEST_TIMEOUT_MS = 5000;
+const MAX_BODY_CHARS = 4000;
+
+function stripBrackets(hostname: string) {
+  return hostname.replace(/^\[|\]$/g, '').toLowerCase();
+}
+
+function parseIPv4(host: string): number[] | null {
+  const parts = host.split('.');
+  if (parts.length !== 4) return null;
+  const octets = parts.map((p) => (/^\d{1,3}$/.test(p) ? Number(p) : NaN));
+  return octets.every((o) => o >= 0 && o <= 255) ? octets : null;
+}
+
+function isPrivateLanHost(hostname: string) {
+  const host = stripBrackets(hostname);
+  if (host.endsWith('.local')) return true;
+
+  const ip = parseIPv4(host);
+  if (ip) {
+    const [a, b] = ip;
+    return (
+      a === 10 ||
+      (a === 172 && b >= 16 && b <= 31) ||
+      (a === 192 && b === 168) ||
+      (a === 169 && b === 254)
+    );
+  }
+
+  // IPv6 Unique Local (fc00::/7) and link-local (fe80::/10)
+  return /^f[cd][0-9a-f]{0,2}:/.test(host) || /^fe[89ab][0-9a-f]?:/.test(host);
+}
+
+function isLoopbackHost(hostname: string) {
+  const host = stripBrackets(hostname);
+  if (host === 'localhost' || host.endsWith('.localhost') || host === '::1') return true;
+  const ip = parseIPv4(host);
+  return ip !== null && ip[0] === 127;
+}
+
+function requireHttp(url: URL) {
+  return url.protocol === 'http:' || url.protocol === 'https:'
+    ? null
+    : 'Only http:// and https:// endpoints are supported.';
+}
+
+const TARGETS: TargetConfig[] = [
+  {
+    key: 'device',
+    title: 'Hardware test device (LAN)',
+    description:
+      'Reach a test device on your private Wi-Fi network, such as a dev board or test rig at 192.168.1.x.',
+    permission: 'local-network',
+    addressSpace: 'local',
+    defaultUrl: 'http://192.168.1.50:8080/api/status',
+    urlHint: 'Private IP (10.x, 172.16–31.x, 192.168.x, 169.254.x), IPv6 ULA/link-local, or a .local hostname.',
+    validate: (url) =>
+      requireHttp(url) ??
+      (isPrivateLanHost(url.hostname)
+        ? null
+        : 'Use a private LAN address (e.g. 192.168.1.50) or a .local hostname.'),
+    troubleshooting: [
+      'Make sure the device is powered on and on the same Wi-Fi network as this computer.',
+      'Check that the device serves CORS headers allowing this site (Access-Control-Allow-Origin).',
+      'Some guest or corporate networks isolate clients from each other.',
+    ],
+  },
+  {
+    key: 'cli',
+    title: 'Companion CLI (this machine)',
+    description:
+      'Reach the DevTools Times companion CLI running locally on your machine via the loopback interface.',
+    permission: 'loopback-network',
+    addressSpace: 'loopback',
+    defaultUrl: 'http://127.0.0.1:45678/health',
+    urlHint: '127.0.0.1 (or any 127.x address), [::1], or localhost.',
+    validate: (url) =>
+      requireHttp(url) ??
+      (isLoopbackHost(url.hostname)
+        ? null
+        : 'Use a loopback address: 127.0.0.1, [::1], or localhost.'),
+    troubleshooting: [
+      'Start the companion CLI and confirm the port it is listening on.',
+      'Check that the CLI responds with CORS headers allowing this site (Access-Control-Allow-Origin).',
+    ],
+  },
+];
+
+/**
+ * Queries a granular Local Network Access permission. Never falls back to the legacy
+ * 'local-network-access' name, which can crash older Chrome renderers.
+ */
+function usePermissionState(name: PermissionName) {
+  const [state, setState] = useState<PermissionState>('prompt');
+
+  useEffect(() => {
+    if (!navigator.permissions?.query) {
+      setState('unsupported');
+      return;
+    }
+
+    let status: PermissionStatus | null = null;
+    let cancelled = false;
+    const onChange = () => status && setState(status.state);
+
+    navigator.permissions
+      .query({ name: name as unknown as globalThis.PermissionName })
+      .then((result) => {
+        if (cancelled) return;
+        status = result;
+        setState(result.state);
+        result.addEventListener('change', onChange);
+      })
+      .catch(() => {
+        // Unrecognized permission name: the browser doesn't support LNA permissions.
+        // Requests still run from an explicit click.
+        if (!cancelled) setState('unsupported');
+      });
+
+    return () => {
+      cancelled = true;
+      status?.removeEventListener('change', onChange);
+    };
+  }, [name]);
+
+  return state;
+}
+
+function loadSavedUrl(key: string, fallback: string) {
+  try {
+    return localStorage.getItem(`diagnostics:${key}:url`) ?? fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function saveUrl(key: string, url: string) {
+  try {
+    localStorage.setItem(`diagnostics:${key}:url`, url);
+  } catch {
+    // Storage unavailable; ignore.
+  }
+}
+
+const PERMISSION_BADGE: Record<PermissionState, { label: string; className: string }> = {
+  granted: { label: 'Allowed', className: 'bg-green-100 text-green-800' },
+  prompt: { label: 'Will ask', className: 'bg-yellow-100 text-yellow-800' },
+  denied: { label: 'Blocked', className: 'bg-red-100 text-red-800' },
+  unsupported: { label: 'No browser prompt', className: 'bg-gray-100 text-gray-700' },
+};
+
+function TargetPanel({ target }: { target: TargetConfig }) {
+  const id = useId();
+  const permission = usePermissionState(target.permission);
+  const [url, setUrl] = useState(target.defaultUrl);
+  const [validationError, setValidationError] = useState<string | null>(null);
+  const [status, setStatus] = useState<ConnectionStatus>({ kind: 'idle' });
+
+  useEffect(() => {
+    setUrl(loadSavedUrl(target.key, target.defaultUrl));
+  }, [target.key, target.defaultUrl]);
+
+  const handleConnect = async (e: React.FormEvent) => {
+    e.preventDefault();
+
+    let parsed: URL;
+    try {
+      parsed = new URL(url.trim());
+    } catch {
+      setValidationError('Enter a full URL, e.g. ' + target.defaultUrl);
+      return;
+    }
+    const error = target.validate(parsed);
+    setValidationError(error);
+    if (error) return;
+
+    saveUrl(target.key, parsed.href);
+    setStatus({ kind: 'connecting' });
+    const started = performance.now();
+
+    try {
+      const response = await fetch(parsed.href, {
+        method: 'GET',
+        mode: 'cors',
+        credentials: 'omit',
+        cache: 'no-store',
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+        // Declares the expected address space: exempts http:// from Mixed Content once
+        // permission is granted, and aborts if the host resolves somewhere unexpected.
+        targetAddressSpace: target.addressSpace,
+      } as RequestInit & { targetAddressSpace: AddressSpace });
+
+      const text = await response.text();
+      let body = text;
+      try {
+        body = JSON.stringify(JSON.parse(text), null, 2);
+      } catch {
+        // Not JSON; show as plain text.
+      }
+      if (body.length > MAX_BODY_CHARS) body = body.slice(0, MAX_BODY_CHARS) + '\n…(truncated)';
+
+      const elapsedMs = Math.round(performance.now() - started);
+      if (!response.ok) {
+        setStatus({ kind: 'error', message: `Endpoint responded with HTTP ${response.status}.` });
+      } else {
+        setStatus({ kind: 'connected', httpStatus: response.status, elapsedMs, body });
+      }
+    } catch (err) {
+      const name = err instanceof DOMException ? err.name : '';
+      setStatus({
+        kind: 'error',
+        message:
+          name === 'TimeoutError'
+            ? `No response within ${REQUEST_TIMEOUT_MS / 1000} seconds.`
+            : 'Could not connect. The endpoint may be unreachable, blocked by browser permissions, or missing CORS headers.',
+      });
+    }
+  };
+
+  const badge = PERMISSION_BADGE[permission];
+  const busy = status.kind === 'connecting';
+  const urlId = `${id}-url`;
+  const hintId = `${id}-hint`;
+  const errorId = `${id}-error`;
+
+  return (
+    <section
+      aria-labelledby={`${id}-title`}
+      className="flex flex-col p-5 bg-white border border-gray-200 rounded-lg shadow-sm"
+    >
+      <div className="flex items-start justify-between gap-3 mb-2">
+        <h2 id={`${id}-title`} className="text-lg font-bold text-gray-900">
+          {target.title}
+        </h2>
+        <span
+          className={`shrink-0 px-2 py-0.5 text-xs font-semibold rounded-full ${badge.className}`}
+          title={`Browser permission: ${target.permission}`}
+        >
+          {badge.label}
+        </span>
+      </div>
+      <p className="text-sm text-gray-600 mb-4">{target.description}</p>
+
+      {permission === 'denied' && (
+        <div className="mb-4 p-3 text-sm text-red-800 bg-red-50 border border-red-200 rounded-md">
+          <p className="font-semibold mb-1">
+            {target.addressSpace === 'local' ? 'Local network' : 'Loopback network'} access is blocked
+          </p>
+          <p>
+            Click the site controls icon next to the address bar, open <strong>Site settings</strong>, and set{' '}
+            <strong>{target.addressSpace === 'local' ? 'Local network' : 'Loopback network'}</strong> to{' '}
+            <em>Allow</em>. Then reload this page.
+          </p>
+        </div>
+      )}
+
+      {permission === 'prompt' && (
+        <p className="mb-4 text-xs text-gray-500">
+          Your browser will ask for permission the first time you connect. We only contact the address you enter
+          below, and only when you click Connect.
+        </p>
+      )}
+
+      <form onSubmit={handleConnect} noValidate className="space-y-3">
+        <div>
+          <label htmlFor={urlId} className="block text-sm font-medium text-gray-700 mb-1">
+            Endpoint URL
+          </label>
+          <input
+            id={urlId}
+            type="url"
+            inputMode="url"
+            autoComplete="off"
+            spellCheck={false}
+            value={url}
+            onChange={(e) => {
+              setUrl(e.target.value);
+              setValidationError(null);
+            }}
+            aria-invalid={validationError ? true : undefined}
+            aria-describedby={validationError ? `${errorId} ${hintId}` : hintId}
+            className="w-full px-3 py-2 font-mono text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 aria-invalid:border-red-500"
+          />
+          {validationError && (
+            <p id={errorId} className="mt-1 text-sm text-red-700">
+              {validationError}
+            </p>
+          )}
+          <p id={hintId} className="mt-1 text-xs text-gray-500">
+            {target.urlHint}
+          </p>
+        </div>
+
+        <button
+          type="submit"
+          disabled={busy}
+          className="w-full px-4 py-2 font-semibold text-white bg-gray-900 rounded-md hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-wait"
+        >
+          {busy ? 'Connecting…' : 'Connect'}
+        </button>
+      </form>
+
+      <div aria-live="polite" className="mt-4">
+        {status.kind === 'connected' && (
+          <div className="text-sm">
+            <p className="mb-2 font-semibold text-green-800">
+              Connected · HTTP {status.httpStatus} · {status.elapsedMs} ms
+            </p>
+            {status.body && (
+              <pre className="p-3 overflow-auto text-xs text-gray-100 bg-gray-900 rounded-md max-h-64">
+                {status.body}
+              </pre>
+            )}
+          </div>
+        )}
+        {status.kind === 'error' && (
+          <div className="p-3 text-sm text-red-800 bg-red-50 border border-red-200 rounded-md" role="alert">
+            <p className="font-semibold mb-1">{status.message}</p>
+            <ul className="pl-5 space-y-1 list-disc">
+              {target.troubleshooting.map((tip) => (
+                <li key={tip}>{tip}</li>
+              ))}
+            </ul>
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
+
+export default function DiagnosticsConnectWidget() {
+  const [insecure, setInsecure] = useState(false);
+
+  useEffect(() => {
+    // Local Network Access permissions are auto-denied in non-secure top-level contexts.
+    setInsecure(!window.isSecureContext);
+  }, []);
+
+  return (
+    <div>
+      {insecure && (
+        <div className="mb-6 p-3 text-sm text-yellow-900 bg-yellow-50 border border-yellow-200 rounded-md" role="status">
+          This page isn't loaded over HTTPS, so your browser may block connections to local devices. Open the
+          site via <code>https://</code> to use these diagnostics.
+        </div>
+      )}
+      <div className="grid gap-6 md:grid-cols-2">
+        {TARGETS.map((target) => (
+          <TargetPanel key={target.key} target={target} />
+        ))}
+      </div>
+    </div>
+  );
+}
