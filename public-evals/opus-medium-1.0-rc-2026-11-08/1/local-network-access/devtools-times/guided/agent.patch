+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnectWidget from '../components/DiagnosticsConnectWidget.tsx';
+---
+<Layout title="Developer Diagnostics">
+    <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 pb-2 border-b-2">Developer Diagnostics</h1>
+        <p class="text-gray-700 mb-8 max-w-3xl">
+            Connect this page to a hardware test device on your private Wi-Fi network or to the
+            companion CLI running on your own computer. Connections go straight from your browser to
+            the address you enter. Nothing is relayed through our servers, and nothing is sent until you click
+            <strong>Connect</strong>.
+        </p>
+        <DiagnosticsConnectWidget client:only="react" />
+    </div>
+</Layout>
