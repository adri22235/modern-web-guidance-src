@@ -0,0 +1,39 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Developer Diagnostics</h1>
+    <p class="text-gray-600 mb-8">
+      Connect this page to a hardware test device on your private network and to the companion CLI running
+      on your own machine. All requests go directly from your browser to the address you enter — nothing is
+      sent to or relayed through our servers.
+    </p>
+
+    <DiagnosticsConnect client:only="react" />
+
+    <section class="prose max-w-none mt-10">
+      <h2>Setting up your targets</h2>
+      <p>
+        Both the device and the CLI must expose <code>GET /diagnostics/status</code> and answer with CORS headers
+        that allow this site, for example:
+      </p>
+      <pre><code>Access-Control-Allow-Origin: {Astro.url.origin}
+Access-Control-Allow-Headers: Authorization, Accept
+Access-Control-Allow-Private-Network: true</code></pre>
+      <p>
+        Targets should check the <code>Origin</code> header and, ideally, require the one-time pairing token they
+        display, so that no other website can talk to them.
+      </p>
+      <h2>Browser permission</h2>
+      <p>
+        Modern browsers protect your local network from websites. The first time you click
+        <strong>Connect</strong>, your browser may ask whether The DevTools Times may access devices on your
+        local network. Only addresses in private ranges (10.x, 172.16–31.x, 192.168.x, 169.254.x) and loopback
+        (127.0.0.1) are accepted, and requests are only made when you click Connect.
+      </p>
+    </section>
+  </div>
+</Layout>
