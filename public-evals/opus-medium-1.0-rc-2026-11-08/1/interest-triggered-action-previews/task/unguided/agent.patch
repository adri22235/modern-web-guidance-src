+  <script>
+    // The "View Details" links declare their preview target via the
+    // interestfor attribute (Interest Invokers), so the browser handles
+    // hover, focus and long-press and fires interest/loseinterest on the
+    // preview box itself — no per-button listeners required.
+    (function () {
+      var preview = document.getElementById('seasonal-preview');
+      var text = preview.querySelector('.preview-text');
+      var DEFAULT_TEXT = 'Select a drink to preview';
+
+      function show(source) {
+        if (!source || !source.dataset.drink) return;
+        text.textContent = 'Previewing: ' + source.dataset.drink;
+        preview.style.setProperty('--preview-accent', source.dataset.accent || '');
+        preview.dataset.state = 'active';
+      }
+
+      function reset() {
+        text.textContent = DEFAULT_TEXT;
+        preview.style.removeProperty('--preview-accent');
+        preview.dataset.state = 'idle';
+      }
+
+      preview.addEventListener('interest', function (event) { show(event.source); });
+      preview.addEventListener('loseinterest', reset);
+
+      // Fallback for browsers without Interest Invokers: a single delegated
+      // listener set on the section, keyed off the same interestfor markup.
+      if (!('interestForElement' in HTMLAnchorElement.prototype)) {
+        var section = preview.closest('section');
+        var selector = '[interestfor="seasonal-preview"]';
+        var pressTimer;
+
+        section.addEventListener('pointerover', function (e) { show(e.target.closest(selector)); });
+        section.addEventListener('pointerout', function (e) {
+          var from = e.target.closest(selector);
+          if (from && !from.contains(e.relatedTarget)) reset();
+        });
+        section.addEventListener('focusin', function (e) { show(e.target.closest(selector)); });
+        section.addEventListener('focusout', function (e) {
+          if (e.target.closest(selector)) reset();
+        });
+        section.addEventListener('touchstart', function (e) {
+          var trigger = e.target.closest(selector);
+          if (trigger) pressTimer = setTimeout(function () { show(trigger); }, 500);
+        }, { passive: true });
+        section.addEventListener('touchend', function () { clearTimeout(pressTimer); });
+        section.addEventListener('touchcancel', function () { clearTimeout(pressTimer); reset(); });
+      }
+    })();
+  </script>
+
