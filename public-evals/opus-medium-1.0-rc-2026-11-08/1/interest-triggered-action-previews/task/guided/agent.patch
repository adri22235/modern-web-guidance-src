+  <script type="module">
+    // Load the interest invokers polyfill only when native support is missing.
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    // The links declare their relationship via `interestfor`; only the preview listens.
+    const preview = document.getElementById("seasonal-preview");
+    const drinkLabel = preview.querySelector(".preview-drink");
+    const accentLabel = preview.querySelector(".preview-accent");
+
+    preview.addEventListener("interest", (event) => {
+      const { drink, accent } = event.source.dataset;
+      preview.dataset.drink = drink;
+      preview.style.setProperty("--preview-accent", accent);
+      drinkLabel.textContent = drink;
+      accentLabel.textContent = `Accent color: ${accent}`;
+    });
+
+    preview.addEventListener("loseinterest", () => {
+      delete preview.dataset.drink;
+      preview.style.removeProperty("--preview-accent");
+      drinkLabel.textContent = "Select a drink to preview";
+      accentLabel.textContent = "";
+    });
+  </script>
+
