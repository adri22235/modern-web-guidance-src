+  <script>
+    // Fit each lockup line to the heading width by scaling its font-size
+    // (letter-spacing is in em, so spacing scales with the glyphs rather than stretching).
+    (function () {
+      var lockups = document.querySelectorAll('.lockup');
+      var REF = 100;
+
+      function fit(lockup) {
+        var target = lockup.clientWidth;
+        if (!target) return;
+        lockup.querySelectorAll('.line').forEach(function (line) {
+          line.style.fontSize = REF + 'px';
+          var w = line.getBoundingClientRect().width;
+          if (w) line.style.fontSize = (REF * target / w) + 'px';
+        });
+      }
+
+      function fitAll() { lockups.forEach(fit); }
+
+      fitAll();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
+      if ('ResizeObserver' in window) {
+        var ro = new ResizeObserver(fitAll);
+        lockups.forEach(function (l) { ro.observe(l); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+    })();
+  </script>
+
