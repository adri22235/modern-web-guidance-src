diff --git a/components/shared-styles.js b/components/shared-styles.js
new file mode 100644
index 0000000..0997245
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,67 @@
+// Shared constructable stylesheets adopted by every Daily Grind component.
+// Design tokens are CSS custom properties, which inherit through shadow roots,
+// so pages can theme components by overriding --dg-* on :root or any ancestor.
+
+const sheet = (css) => {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+};
+
+export const baseStyles = sheet(`
+  :host {
+    box-sizing: border-box;
+    font-family: var(--dg-font, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif);
+    color: var(--dg-color-text, #3e2723);
+  }
+  :host([hidden]) { display: none !important; }
+  *, *::before, *::after { box-sizing: inherit; }
+
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition-duration: 0.01ms !important;
+      animation-duration: 0.01ms !important;
+    }
+  }
+`);
+
+// Button look shared by shadow-DOM links and slotted light-DOM links.
+const buttonRules = `
+  display: inline-block;
+  background: var(--dg-color-primary, #4e342e);
+  color: var(--dg-color-on-primary, #fff);
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  font-weight: 600;
+  transition: background 0.3s, box-shadow 0.3s;
+`;
+const buttonHover = `background: var(--dg-color-primary-dark, #3e2723);`;
+const focusRing = `
+  outline: 3px solid var(--dg-color-accent, #ffab40);
+  outline-offset: 3px;
+`;
+
+export const buttonStyles = sheet(`
+  .btn { ${buttonRules} }
+  .btn:hover { ${buttonHover} }
+  .btn:focus-visible { ${focusRing} }
+
+  ::slotted(a[data-variant="button"]) { ${buttonRules} }
+  ::slotted(a[data-variant="button"]:hover) { ${buttonHover} }
+  ::slotted(a[data-variant="button"]:focus-visible) { ${focusRing} }
+`);
+
+export const focusRingRules = focusRing;
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..cc46235
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,205 @@
+import { baseStyles, focusRingRules } from './shared-styles.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+      background: var(--dg-color-primary, #4e342e);
+      color: var(--dg-color-on-primary, #fff);
+    }
+    nav {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      padding: 1rem 5%;
+    }
+    ::slotted([slot="brand"]) {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      color: inherit;
+      text-decoration: none;
+    }
+    .menu {
+      display: flex;
+      align-items: center;
+      gap: 20px;
+    }
+    ::slotted(a) {
+      color: inherit;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+    ::slotted(a:hover) { color: var(--dg-color-accent, #ffab40); }
+    ::slotted(a:focus-visible),
+    ::slotted([slot="brand"]:focus-visible) { ${focusRingRules} }
+    ::slotted(a[aria-current="page"]) {
+      color: var(--dg-color-accent, #ffab40);
+    }
+    ::slotted([slot="action"]) {
+      border: 1px solid var(--dg-color-accent, #ffab40);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    .toggle {
+      display: none;
+      align-items: center;
+      gap: 8px;
+      background: transparent;
+      color: inherit;
+      border: 1px solid currentColor;
+      border-radius: 4px;
+      padding: 6px 10px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+    .toggle:focus-visible { ${focusRingRules} }
+    .bars,
+    .bars::before,
+    .bars::after {
+      display: block;
+      width: 18px;
+      height: 2px;
+      background: currentColor;
+      transition: transform 0.25s, opacity 0.25s;
+    }
+    .bars { position: relative; }
+    .bars::before,
+    .bars::after {
+      content: '';
+      position: absolute;
+      left: 0;
+    }
+    .bars::before { top: -6px; }
+    .bars::after { top: 6px; }
+    :host([open]) .bars { background: transparent; }
+    :host([open]) .bars::before { transform: translateY(6px) rotate(45deg); }
+    :host([open]) .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+    @media (max-width: 720px) {
+      .toggle { display: inline-flex; }
+      .menu {
+        display: none;
+        flex-basis: 100%;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 14px;
+        padding-top: 1rem;
+      }
+      :host([open]) .menu { display: flex; }
+    }
+  </style>
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <span class="bars" aria-hidden="true"></span>
+      <span class="toggle-label">Menu</span>
+    </button>
+    <div class="menu" id="menu" part="menu">
+      <slot></slot>
+      <slot name="action"></slot>
+    </div>
+  </nav>
+`;
+
+/**
+ * <site-nav> — sticky primary navigation with a responsive disclosure menu.
+ *
+ * Slots:
+ *   brand   — logo / site name (ideally a link home)
+ *   default — navigation links (<a> elements)
+ *   action  — emphasised link, e.g. Logout
+ *
+ * Attributes:
+ *   label — accessible name for the navigation landmark (default "Main")
+ *   open  — reflects whether the mobile menu is expanded
+ *
+ * Behaviour: on narrow screens the links collapse behind a toggle button
+ * (aria-expanded). Escape closes the menu and returns focus to the toggle;
+ * choosing a link or widening the viewport also closes it. Links matching the
+ * current path get aria-current="page".
+ */
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['open', 'label'];
+
+  #root;
+  #nav;
+  #toggle;
+  #mql = window.matchMedia('(max-width: 720px)');
+
+  constructor() {
+    super();
+    this.#root = this.attachShadow({ mode: 'open' });
+    this.#root.adoptedStyleSheets = [baseStyles];
+    this.#root.append(template.content.cloneNode(true));
+    this.#nav = this.#root.querySelector('nav');
+    this.#toggle = this.#root.querySelector('.toggle');
+
+    this.#toggle.addEventListener('click', () => this.toggle());
+  }
+
+  connectedCallback() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onLinkClick);
+    this.#mql.addEventListener('change', this.#onViewportChange);
+    this.#markCurrent();
+  }
+
+  disconnectedCallback() {
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.removeEventListener('click', this.#onLinkClick);
+    this.#mql.removeEventListener('change', this.#onViewportChange);
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'label') {
+      this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+    } else if (name === 'open') {
+      this.#toggle.setAttribute('aria-expanded', String(this.open));
+    }
+  }
+
+  get open() { return this.hasAttribute('open'); }
+  set open(value) { this.toggleAttribute('open', Boolean(value)); }
+
+  toggle(force) {
+    this.open = force ?? !this.open;
+  }
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.open) {
+      this.open = false;
+      this.#toggle.focus();
+    }
+  };
+
+  #onLinkClick = (event) => {
+    if (this.open && event.target.closest('a')) this.open = false;
+  };
+
+  #onViewportChange = (event) => {
+    if (!event.matches) this.open = false;
+  };
+
+  #markCurrent() {
+    const here = window.location.pathname.replace(/\/$/, '') || '/';
+    for (const link of this.querySelectorAll('a[href]')) {
+      if (link.hasAttribute('aria-current')) continue;
+      const path = new URL(link.href, window.location.href).pathname.replace(/\/$/, '') || '/';
+      if (path === here && link.slot !== 'brand') link.setAttribute('aria-current', 'page');
+    }
+  }
+}
+
+if (!customElements.get('site-nav')) {
+  customElements.define('site-nav', SiteNav);
+}
