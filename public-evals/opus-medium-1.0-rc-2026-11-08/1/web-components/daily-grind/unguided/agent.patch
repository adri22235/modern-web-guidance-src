diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..bd93a8a
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,170 @@
+import { baseStyles, buttonStyles } from './shared-styles.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      height: 100%;
+    }
+    article {
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      background: var(--dg-color-surface, #fff);
+      border-radius: var(--dg-radius, 8px);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+      text-align: center;
+      transition: transform 0.25s ease, box-shadow 0.25s ease;
+    }
+    article:hover,
+    article:focus-within {
+      transform: translateY(-4px);
+      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
+    }
+    .media {
+      aspect-ratio: 4 / 3;
+      background: var(--dg-color-secondary, #d7ccc8);
+    }
+    .media[hidden] { display: none; }
+    img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+    .body {
+      display: flex;
+      flex-direction: column;
+      flex: 1;
+      padding: 20px;
+    }
+    ::slotted([slot="title"]) {
+      margin: 0 0 10px;
+      font-size: 1.25rem;
+      color: var(--dg-color-primary, #4e342e);
+    }
+    ::slotted(:not([slot])) {
+      margin: 0;
+      line-height: 1.6;
+    }
+    .price {
+      margin: 10px 0 0;
+      font-weight: 700;
+      color: var(--dg-color-primary, #4e342e);
+    }
+    .price:empty { display: none; }
+    .actions {
+      margin-top: auto;
+      padding-top: 15px;
+    }
+    .btn[hidden] { display: none; }
+  </style>
+  <article part="card">
+    <div class="media" part="media" hidden>
+      <img alt="" loading="lazy" decoding="async" width="400" height="300">
+    </div>
+    <div class="body">
+      <slot name="title"></slot>
+      <slot></slot>
+      <p class="price" part="price"></p>
+      <div class="actions">
+        <a class="btn" part="button" hidden>
+          <span class="label"></span><span class="visually-hidden context"></span>
+        </a>
+      </div>
+    </div>
+  </article>
+`;
+
+/**
+ * <coffee-card> — a menu item card.
+ *
+ * Slots:
+ *   title   — the item heading (use a real heading element, e.g. <h3 slot="title">)
+ *   default — description content
+ *
+ * Attributes:
+ *   href        — destination for the call-to-action link (omit to hide it)
+ *   cta-label   — visible link text (default "View Details")
+ *   image       — optional image URL
+ *   image-alt   — alt text for the image (defaults to "" — decorative, since the title names the item)
+ *   price       — optional price text
+ *
+ * The CTA link gets visually-hidden context from the title ("View Details
+ * about Maple Oat Latte") so repeated links are distinguishable to screen readers.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'cta-label', 'image', 'image-alt', 'price'];
+
+  #root;
+  #link;
+  #label;
+  #context;
+  #media;
+  #img;
+  #price;
+  #titleSlot;
+
+  constructor() {
+    super();
+    this.#root = this.attachShadow({ mode: 'open' });
+    this.#root.adoptedStyleSheets = [baseStyles, buttonStyles];
+    this.#root.append(template.content.cloneNode(true));
+
+    this.#link = this.#root.querySelector('.btn');
+    this.#label = this.#root.querySelector('.label');
+    this.#context = this.#root.querySelector('.context');
+    this.#media = this.#root.querySelector('.media');
+    this.#img = this.#root.querySelector('img');
+    this.#price = this.#root.querySelector('.price');
+    this.#titleSlot = this.#root.querySelector('slot[name="title"]');
+
+    this.#titleSlot.addEventListener('slotchange', () => this.#updateContext());
+    this.#img.addEventListener('error', () => { this.#media.hidden = true; });
+  }
+
+  connectedCallback() {
+    this.#render();
+    this.#updateContext();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  get href() { return this.getAttribute('href'); }
+  set href(value) { this.setAttribute('href', value); }
+
+  #render() {
+    const href = this.getAttribute('href');
+    this.#link.hidden = !href;
+    if (href) this.#link.setAttribute('href', href);
+    else this.#link.removeAttribute('href');
+    this.#label.textContent = this.getAttribute('cta-label') || 'View Details';
+
+    const image = this.getAttribute('image');
+    this.#media.hidden = !image;
+    if (image) {
+      this.#img.src = image;
+      this.#img.alt = this.getAttribute('image-alt') ?? '';
+    } else {
+      this.#img.removeAttribute('src');
+    }
+
+    this.#price.textContent = this.getAttribute('price') || '';
+  }
+
+  #updateContext() {
+    const title = this.#titleSlot
+      .assignedElements()
+      .map((el) => el.textContent.trim())
+      .join(' ');
+    this.#context.textContent = title ? ` about ${title}` : '';
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
diff --git a/components/hero-banner.js b/components/hero-banner.js
new file mode 100644
index 0000000..4e3fc49
--- /dev/null
+++ b/components/hero-banner.js
@@ -0,0 +1,77 @@
+import { baseStyles, buttonStyles } from './shared-styles.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      min-height: var(--dg-hero-height, 60vh);
+      padding: 2rem 20px;
+      text-align: center;
+      color: #fff;
+      background-color: var(--dg-color-primary-dark, #3e2723);
+      background-image:
+        linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        var(--_hero-image, none);
+      background-size: cover;
+      background-position: center;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0 0 1rem;
+      font-size: clamp(2rem, 6vw, 3rem);
+      line-height: 1.2;
+    }
+    ::slotted(:not([slot])) {
+      margin: 0;
+      font-size: 1.1rem;
+      max-width: 40rem;
+    }
+    .actions {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 12px;
+      margin-top: 15px;
+    }
+  </style>
+  <slot name="heading"></slot>
+  <slot></slot>
+  <div class="actions" part="actions">
+    <slot name="actions"></slot>
+  </div>
+`;
+
+/**
+ * <hero-banner> — full-width introductory banner.
+ *
+ * Slots:
+ *   heading — page heading (e.g. <h1 slot="heading">)
+ *   default — supporting copy
+ *   actions — call-to-action links; add data-variant="button" for button styling
+ *
+ * Attributes:
+ *   image — background image URL (purely decorative; keep meaning in the text)
+ */
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, buttonStyles];
+    root.append(template.content.cloneNode(true));
+  }
+
+  attributeChangedCallback() {
+    const image = this.getAttribute('image');
+    if (image) this.style.setProperty('--_hero-image', `url("${CSS.escape(image)}")`);
+    else this.style.removeProperty('--_hero-image');
+  }
+}
+
+if (!customElements.get('hero-banner')) {
+  customElements.define('hero-banner', HeroBanner);
+}
