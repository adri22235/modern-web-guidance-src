+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && menu.classList.contains('is-open')) {
+          setOpen(false);
+          toggle.focus();
+        }
+      });
+
+      menu.addEventListener('click', function (e) {
+        if (e.target.closest('a')) setOpen(false);
