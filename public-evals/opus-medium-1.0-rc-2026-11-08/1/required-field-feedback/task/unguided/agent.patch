+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var field = document.getElementById('newsletter-field');
+      var error = document.getElementById('newsletter-email-error');
+      var success = document.getElementById('newsletter-success');
+      var touched = false;
+
+      function getError() {
+        if (input.validity.valueMissing || !input.value.trim()) return 'Please enter your email address.';
+        if (input.validity.typeMismatch) return 'Please enter a valid email address (e.g. you@example.com).';
+        return '';
+      }
+
+      function render() {
+        var message = touched ? getError() : '';
+        field.classList.toggle('has-error', !!message);
+        error.textContent = message;
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+        return !getError();
+      }
+
+      // Mark as touched only once the user leaves the field.
+      input.addEventListener('blur', function () {
+        touched = true;
+        render();
+      });
+
+      // After interaction, update live so errors clear as soon as they're fixed.
+      input.addEventListener('input', function () {
+        success.hidden = true;
+        if (touched) render();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        touched = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        success.textContent = 'Thanks! ' + input.value.trim() + ' is now subscribed.';
+        success.hidden = false;
+        form.reset();
+        touched = false;
+        render();
+      });
+    })();
+  </script>
+
 </body>
 
