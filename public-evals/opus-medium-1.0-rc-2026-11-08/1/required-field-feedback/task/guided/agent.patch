+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const errorText = form.querySelector('.error-text');
+      const status = form.querySelector('.success-msg');
+
+      // Mirror the browser's interaction-aware :user-invalid state for assistive tech
+      const sync = () => {
+        if (email.matches(':user-invalid')) {
+          errorText.textContent = email.validity.valueMissing
+            ? 'Please enter your email address.'
+            : 'Please enter a valid email address, like you@example.com.';
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+      };
+
+      email.addEventListener('blur', sync);
+      email.addEventListener('invalid', sync);
+      email.addEventListener('input', () => {
+        status.textContent = '';
+        if (email.hasAttribute('aria-invalid')) sync();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        // Resetting clears the interaction flag, so the field returns to neutral
+        form.reset();
+        email.removeAttribute('aria-invalid');
+        status.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+      });
+    })();
+  </script>
+
 </body>
 
