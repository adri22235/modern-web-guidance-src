+    /* Drink Cards */
+    .drink-card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .drink-card .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    /* Customization Checkboxes */
+    .customize {
+      border: none;
+      margin: 18px 0 20px;
+      padding: 14px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+    }
+
+    .customize legend {
+      display: flex;
+      align-items: center;
+      gap: 6px;
+      margin: 0 auto;
+      padding: 0 10px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1.5px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .customize legend svg {
+      width: 14px;
+      height: 14px;
+      color: var(--accent);
+    }
+
+    .options {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 8px;
+      list-style: none;
+      margin-top: 8px;
+    }
+
+    .option {
+      position: relative;
+      display: block;
+    }
+
+    /* The native checkbox stays in the DOM, focusable and clickable;
+       it is transparent and stretched over the custom face so pointer,
+       keyboard, label and screen reader behavior are all native. */
+    .option-input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .option-face {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      min-height: 44px;
+      padding: 8px 10px;
+      border: 1.5px solid var(--secondary);
+      border-radius: 22px;
+      background: var(--light);
+      color: var(--text);
+      font-size: 0.85rem;
+      line-height: 1.2;
+      transition: background-color 0.25s, border-color 0.25s, color 0.25s,
+        box-shadow 0.25s, transform 0.15s;
+    }
+
+    .option-icon {
+      flex: none;
+      width: 20px;
+      height: 20px;
+      color: var(--primary);
+      transition: color 0.25s, transform 0.3s;
+    }
+
+    .option-label {
+      flex: 1;
+    }
+
+    .option-box {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 20px;
+      height: 20px;
+      border: 2px solid #a1887f;
+      border-radius: 6px;
+      background: white;
+      transition: background-color 0.25s, border-color 0.25s, transform 0.2s;
+    }
+
+    .option-box svg {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .option-box path {
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.2s ease-in;
+    }
+
+    /* Hover */
+    .option-input:hover + .option-face {
+      border-color: #a1887f;
+      background: white;
+    }
+
+    .option-input:active + .option-face {
+      transform: scale(0.97);
+    }
+
+    /* Checked */
+    .option-input:checked + .option-face {
+      background: var(--primary);
+      border-color: var(--primary);
+      color: white;
+      box-shadow: 0 3px 8px rgba(78, 52, 46, 0.3);
+    }
+
+    .option-input:checked + .option-face .option-icon {
+      color: var(--accent);
+      animation: icon-wiggle 0.45s ease-out;
+    }
+
+    .option-input:checked + .option-face .option-box {
+      background: var(--accent);
+      border-color: var(--accent);
+      animation: box-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-input:checked + .option-face .option-box path {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.3s 0.1s ease-out;
+    }
+
+    /* Keyboard focus */
+    .option-input:focus-visible + .option-face {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+      box-shadow: 0 0 0 2px var(--accent);
+    }
+
+    /* Disabled */
+    .option-input:disabled {
+      cursor: not-allowed;
+    }
+
+    .option-input:disabled + .option-face {
+      opacity: 0.5;
+    }
+
+    @keyframes box-pop {
+      0% { transform: scale(0.6); }
+      100% { transform: scale(1); }
+    }
+
+    @keyframes icon-wiggle {
+      0%, 100% { transform: rotate(0); }
+      25% { transform: rotate(-14deg) scale(1.15); }
+      60% { transform: rotate(10deg) scale(1.1); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option-face,
+      .option-icon,
+      .option-box,
+      .option-box path,
+      .option-input:checked + .option-face .option-box path {
+        transition: none;
+      }
+
+      .option-input:checked + .option-face .option-icon,
+      .option-input:checked + .option-face .option-box {
+        animation: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .option-face,
+      .option-box {
+        border-color: CanvasText;
+      }
+
+      .option-input:checked + .option-face {
+        border-color: Highlight;
+        border-width: 3px;
+      }
+
+      .option-input:checked + .option-face .option-box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option-box svg {
+        stroke: HighlightText;
+      }
+
+      .option-input:focus-visible + .option-face {
+        outline-color: Highlight;
+      }
+    }
+
+    @media (max-width: 340px) {
+      .options {
+        grid-template-columns: 1fr;
+      }
+    }
+
     footer {
