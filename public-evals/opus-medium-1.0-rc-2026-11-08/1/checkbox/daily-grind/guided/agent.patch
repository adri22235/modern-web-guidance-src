+
+    .customize {
+      border: 1px dashed var(--secondary);
+      border-radius: 8px;
+      padding: 8px 12px 10px;
+      margin-top: 15px;
+      text-align: left;
+    }
+
+    .customize legend {
+      padding: 0 6px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .option {
+      --option-bg: transparent;
+      --option-icon: #8d6e63;
+
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+      min-block-size: 44px;
+      padding: 0 8px;
+      border-radius: 6px;
+      background: var(--option-bg);
+      cursor: pointer;
+      transition: background-color 0.2s;
+    }
+
+    .option:hover {
+      --option-bg: #efebe9;
+    }
+
+    .option:has(.checkbox:checked) {
+      --option-bg: #fff3e0;
+      --option-icon: var(--primary);
+      font-weight: 600;
+    }
+
+    .option-icon {
+      flex: none;
+      inline-size: 1.25em;
+      aspect-ratio: 1;
+      background-color: var(--option-icon);
+      mask: var(--icon) no-repeat center / contain;
+      transition: background-color 0.2s;
+    }
+
+    .icon-bean { --icon: var(--icon-bean); }
+    .icon-drop { --icon: var(--icon-drop); }
+    .icon-cream { --icon: var(--icon-cream); }
+    .icon-cup { --icon: var(--icon-cup); }
+    .icon-cube { --icon: var(--icon-cube); }
+    .icon-snow { --icon: var(--icon-snow); }
+
+    .option-price {
+      margin-left: auto;
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .checkbox {
+      --checkbox-size: 1.25em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      flex: none;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid #8d6e63;
+      border-radius: 6px;
+      background-color: white;
+      color: var(--accent);
+      cursor: pointer;
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon) no-repeat center / contain;
+        scale: 0;
+        rotate: -45deg;
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+      }
+
+      &:is(:checked, :indeterminate) {
+        border-color: var(--primary);
+        background-color: var(--primary);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        scale: 1;
+        rotate: 0deg;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 0.2s, border-color 0.2s, scale 0.15s;
+
+        &::before {
+          transition: scale 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), rotate 0.25s ease-out;
+        }
+
+        &:active {
+          scale: 0.85;
+        }
+
+        &:checked {
+          animation: checkbox-pop 0.3s ease-out;
+        }
+      }
+    }
+
+    @keyframes checkbox-pop {
+      50% {
+        box-shadow: 0 0 0 6px rgba(255, 171, 64, 0.35);
+      }
+    }
+
+    .option:has(.checkbox:disabled) {
+      cursor: not-allowed;
+    }
+
