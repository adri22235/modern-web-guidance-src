+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('cc-number');
+      const name = document.getElementById('cc-name');
+      const exp = document.getElementById('cc-exp');
+      const csc = document.getElementById('cc-csc');
+
+      // Format card number into groups of 4 digits as the user types
+      number.addEventListener('input', () => {
+        const digits = number.value.replace(/\D/g, '').slice(0, 19);
+        number.value = digits.replace(/(.{4})/g, '$1 ').trim();
+      });
+
+      // Auto-insert the slash in MM/YY
+      exp.addEventListener('input', (e) => {
+        let digits = exp.value.replace(/\D/g, '').slice(0, 4);
+        if (digits.length > 2 || (digits.length === 2 && e.inputType !== 'deleteContentBackward')) {
+          digits = digits.slice(0, 2) + '/' + digits.slice(2);
+        }
+        exp.value = digits;
+      });
+
+      csc.addEventListener('input', () => {
+        csc.value = csc.value.replace(/\D/g, '').slice(0, 4);
+      });
+
+      function luhn(digits) {
+        let sum = 0;
+        for (let i = 0; i < digits.length; i++) {
+          let d = Number(digits[digits.length - 1 - i]);
+          if (i % 2 === 1) {
+            d *= 2;
+            if (d > 9) d -= 9;
+          }
+          sum += d;
+        }
+        return sum % 10 === 0;
+      }
+
+      const validators = {
+        'cc-number': () => {
+          const digits = number.value.replace(/\D/g, '');
+          if (!digits) return 'Card number is required.';
+          if (digits.length < 12 || digits.length > 19 || !luhn(digits)) return 'Enter a valid card number.';
+          return '';
+        },
+        'cc-name': () => (name.value.trim() ? '' : 'Name on card is required.'),
+        'cc-exp': () => {
+          const match = /^(\d{2})\/(\d{2})$/.exec(exp.value);
+          if (!match) return 'Enter expiry as MM/YY.';
+          const month = Number(match[1]);
+          const year = 2000 + Number(match[2]);
+          if (month < 1 || month > 12) return 'Enter a valid month.';
+          const now = new Date();
+          if (year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth() + 1)) {
+            return 'This card has expired.';
+          }
+          return '';
+        },
+        'cc-csc': () => (/^\d{3,4}$/.test(csc.value) ? '' : 'Enter a 3 or 4 digit security code.'),
+      };
+
+      function validate(input) {
+        const message = validators[input.id]();
+        document.getElementById(input.id + '-error').textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        return !message;
+      }
+
+      [number, name, exp, csc].forEach((input) => {
+        input.addEventListener('blur', () => validate(input));
+      });
+
+      form.addEventListener('submit', (e) => {
+        const results = [number, name, exp, csc].map(validate);
+        const firstInvalid = [number, name, exp, csc].find((_, i) => !results[i]);
+        if (firstInvalid) {
+          e.preventDefault();
+          firstInvalid.focus();
+        }
+      });
+    })();
+  </script>
+
