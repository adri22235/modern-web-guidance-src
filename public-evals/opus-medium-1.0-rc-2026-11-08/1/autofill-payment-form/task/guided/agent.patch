+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const updateAriaState = (event) => {
+      const input = event.target;
+      if (!input.matches?.('.payment input')) return;
+      if (input.matches(':user-invalid')) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    document.addEventListener('blur', updateAriaState, true);
+    document.addEventListener('invalid', updateAriaState, true);
+    document.addEventListener('input', (event) => {
+      if (event.target.getAttribute?.('aria-invalid') === 'true') updateAriaState(event);
+    });
+
+    // Insert the slash in the expiry date as the user types (MMYY -> MM/YY)
+    const expInput = document.getElementById('cc-exp');
+    expInput.addEventListener('input', (event) => {
+      if (event.inputType?.startsWith('delete')) return;
+      const digits = expInput.value.replace(/\D/g, '').slice(0, 4);
+      expInput.value = digits.length > 2 ? `${digits.slice(0, 2)}/${digits.slice(2)}` : digits;
+    });
+  </script>
+
