@@ -0,0 +1,256 @@
+/**
+ * <coffee-card> — autonomous custom element for a menu item.
+ *
+ * Attributes (reflected to same-named camelCase properties):
+ *   name         string   Drink name (heading)
+ *   description  string   Short description
+ *   href         string   Link target for the "View Details" button
+ *   price        number   Price in USD; omitted or non-numeric hides the price
+ *   featured     boolean  Highlights the card with a badge
+ *   sold-out     boolean  Dims the card and disables the link
+ *
+ * Events:
+ *   coffee-card-select  Fired (bubbles, composed) when the details link is
+ *                       activated. Cancelable: preventDefault() stops navigation.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      position: relative;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      transition: box-shadow 0.3s, opacity 0.3s;
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    :host([featured]) {
+      box-shadow: 0 0 0 2px var(--accent, #ffab40), 0 4px 10px rgba(0, 0, 0, 0.15);
+    }
+
+    :host([sold-out]) {
+      opacity: 0.6;
+    }
+
+    .badge {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.7rem;
+      font-weight: bold;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      padding: 2px 8px;
+      border-radius: 10px;
+    }
+
+    .badge[hidden],
+    .price[hidden] {
+      display: none;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+    }
+
+    p {
+      margin: 0;
+    }
+
+    .price {
+      margin-top: 8px;
+      font-weight: bold;
+      color: var(--primary, #4e342e);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .btn[aria-disabled="true"] {
+      background: #9e9e9e;
+      cursor: not-allowed;
+      pointer-events: none;
+    }
+  </style>
+  <span class="badge" part="badge" hidden>Featured</span>
+  <h3 part="name"></h3>
+  <p part="description"></p>
+  <p class="price" part="price" hidden></p>
+  <a class="btn" part="button">View Details</a>
+`;
+
+const priceFormat = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+const STRING_ATTRS = ['name', 'description', 'href'];
+const NUMBER_ATTRS = ['price'];
+const BOOLEAN_ATTRS = ['featured', 'sold-out'];
+
+const toProp = (attr) => attr.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
+
+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [...STRING_ATTRS, ...NUMBER_ATTRS, ...BOOLEAN_ATTRS];
+  }
+
+  #abort = null;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this.$ = {
+      badge: root.querySelector('.badge'),
+      name: root.querySelector('h3'),
+      description: root.querySelector('p'),
+      price: root.querySelector('.price'),
+      link: root.querySelector('a'),
+    };
+  }
+
+  connectedCallback() {
+    // Properties assigned before the element was upgraded shadow the
+    // prototype accessors; re-run them through the setters.
+    for (const attr of CoffeeCard.observedAttributes) this.#upgradeProperty(toProp(attr));
+
+    if (!this.hasAttribute('role')) this.setAttribute('role', 'article');
+
+    this.#abort = new AbortController();
+    this.$.link.addEventListener('click', (e) => this.#onSelect(e), { signal: this.#abort.signal });
+
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#abort?.abort();
+    this.#abort = null;
+  }
+
+  adoptedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(_name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this.#render();
+  }
+
+  // String properties
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.#setString('name', v); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(v) { this.#setString('description', v); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { this.#setString('href', v); }
+
+  // Numeric property: null when absent or not a finite number
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const n = Number(raw);
+    return Number.isFinite(n) ? n : null;
+  }
+  set price(v) {
+    if (v === null || v === undefined || v === '') {
+      this.removeAttribute('price');
+      return;
+    }
+    const n = Number(v);
+    if (Number.isFinite(n)) this.setAttribute('price', String(n));
+    else this.removeAttribute('price');
+  }
+
+  // Boolean properties
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(v) { this.toggleAttribute('featured', Boolean(v)); }
+
+  get soldOut() { return this.hasAttribute('sold-out'); }
+  set soldOut(v) { this.toggleAttribute('sold-out', Boolean(v)); }
+
+  #setString(attr, v) {
+    if (v === null || v === undefined) this.removeAttribute(attr);
+    else this.setAttribute(attr, String(v));
+  }
+
+  #upgradeProperty(prop) {
+    if (Object.prototype.hasOwnProperty.call(this, prop)) {
+      const value = this[prop];
+      delete this[prop];
+      this[prop] = value;
+    }
+  }
+
+  #onSelect(event) {
+    if (this.soldOut) {
+      event.preventDefault();
+      return;
+    }
+    const proceed = this.dispatchEvent(new CustomEvent('coffee-card-select', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: { name: this.name, href: this.href, price: this.price },
+    }));
+    if (!proceed) event.preventDefault();
+  }
+
+  #render() {
+    // Skip work until connected; connectedCallback renders the full state.
+    if (!this.isConnected) return;
+
+    const { badge, name, description, price, link } = this.$;
+
+    name.textContent = this.name;
+    description.textContent = this.description;
+
+    const p = this.price;
+    price.hidden = p === null;
+    price.textContent = p === null ? '' : priceFormat.format(p);
+
+    badge.hidden = !this.featured;
+
+    const soldOut = this.soldOut;
+    link.textContent = soldOut ? 'Sold Out' : 'View Details';
+    if (soldOut || !this.href) {
+      link.removeAttribute('href');
+      link.setAttribute('aria-disabled', 'true');
+      link.tabIndex = -1;
+    } else {
+      link.href = this.href;
+      link.removeAttribute('aria-disabled');
+      link.removeAttribute('tabindex');
+    }
+    const drink = this.name || 'this drink';
+    link.setAttribute('aria-label', soldOut ? `${drink} is sold out` : `View details for ${drink}`);
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+
+export { CoffeeCard };
