diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..d1d5f32
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,223 @@
+// <coffee-card> — an autonomous custom element for menu items.
+//
+// Attributes (reflected to same-named camelCase properties):
+//   name        string   Drink name, rendered as the card heading.
+//   href        string   Link target for "View Details".
+//   price       number   Price in USD; omitted/invalid hides the price.
+//   strength    number   Roast strength, clamped to 0–5.
+//   seasonal    boolean  Shows a "Seasonal" badge.
+//   sold-out    boolean  Marks the item unavailable and disables the link.
+//   favorite    boolean  Toggled by the heart button; fires "favorite-change".
+//
+// The description is light-DOM content projected into the default slot, so it
+// stays readable even if this script never loads.
+
+const priceFormat = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      position: relative;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    :host([hidden]) { display: none; }
+    :host([sold-out]) { opacity: 0.7; }
+
+    h3 { margin: 0 0 10px; color: var(--primary, #4e342e); }
+
+    .meta {
+      display: flex;
+      gap: 12px;
+      justify-content: center;
+      align-items: center;
+      margin-bottom: 8px;
+      font-size: 0.9rem;
+    }
+    .price { font-weight: bold; }
+    .strength { color: var(--primary, #4e342e); letter-spacing: 2px; }
+    .price:empty, .strength:empty { display: none; }
+
+    .badge {
+      position: absolute;
+      top: 10px;
+      left: 10px;
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.7rem;
+      font-weight: bold;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+    .badge[hidden] { display: none; }
+
+    .favorite {
+      position: absolute;
+      top: 6px;
+      right: 6px;
+      border: 0;
+      background: none;
+      font-size: 1.3rem;
+      line-height: 1;
+      padding: 4px;
+      cursor: pointer;
+      color: var(--primary, #4e342e);
+    }
+    .favorite:focus-visible { outline: 2px solid var(--accent, #ffab40); border-radius: 4px; }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: auto;
+      transition: background 0.3s;
+    }
+    .body { margin-bottom: 15px; }
+    .btn:hover { background: #3e2723; }
+    .btn:not([href]) { background: #9e9e9e; cursor: not-allowed; }
+  </style>
+  <span class="badge" part="badge" hidden>Seasonal</span>
+  <button class="favorite" part="favorite" type="button" aria-pressed="false"></button>
+  <h3 part="name"></h3>
+  <div class="meta">
+    <span class="price" part="price"></span>
+    <span class="strength" part="strength" role="img"></span>
+  </div>
+  <div class="body"><slot></slot></div>
+  <a class="btn" part="link">View Details</a>
+`;
+
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'href', 'price', 'strength', 'seasonal', 'sold-out', 'favorite'];
+
+  #els;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#els = {
+      badge: root.querySelector('.badge'),
+      favorite: root.querySelector('.favorite'),
+      name: root.querySelector('h3'),
+      price: root.querySelector('.price'),
+      strength: root.querySelector('.strength'),
+      link: root.querySelector('.btn'),
+    };
+  }
+
+  connectedCallback() {
+    // Properties set before the element upgraded live as own instance fields
+    // and would shadow the class accessors; re-run them through the setters.
+    for (const prop of ['name', 'href', 'price', 'strength', 'seasonal', 'soldOut', 'favorite']) {
+      if (Object.hasOwn(this, prop)) {
+        const value = this[prop];
+        delete this[prop];
+        this[prop] = value;
+      }
+    }
+    // Idempotent: connectedCallback runs on every insertion.
+    this.#els.favorite.addEventListener('click', this.#onFavoriteClick);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#els.favorite.removeEventListener('click', this.#onFavoriteClick);
+  }
+
+  // Moving via moveBefore() keeps listeners and state; nothing to redo.
+  connectedMoveCallback() {}
+
+  attributeChangedCallback(_name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#render();
+  }
+
+  // --- String attributes ---
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { v ? this.setAttribute('name', v) : this.removeAttribute('name'); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { v ? this.setAttribute('href', v) : this.removeAttribute('href'); }
+
+  // --- Numeric attributes ---
+  get price() {
+    const n = Number.parseFloat(this.getAttribute('price'));
+    return Number.isFinite(n) && n >= 0 ? n : null;
+  }
+  set price(v) {
+    const n = Number(v);
+    v == null || v === '' || !Number.isFinite(n)
+      ? this.removeAttribute('price')
+      : this.setAttribute('price', String(n));
+  }
+
+  get strength() {
+    const n = Math.round(Number(this.getAttribute('strength')));
+    return Number.isFinite(n) ? Math.min(5, Math.max(0, n)) : 0;
+  }
+  set strength(v) { this.setAttribute('strength', String(Number(v) || 0)); }
+
+  // --- Boolean attributes (presence = true; never set to "false") ---
+  get seasonal() { return this.hasAttribute('seasonal'); }
+  set seasonal(on) { this.toggleAttribute('seasonal', Boolean(on)); }
+
+  get soldOut() { return this.hasAttribute('sold-out'); }
+  set soldOut(on) { this.toggleAttribute('sold-out', Boolean(on)); }
+
+  get favorite() { return this.hasAttribute('favorite'); }
+  set favorite(on) { this.toggleAttribute('favorite', Boolean(on)); }
+
+  #onFavoriteClick = () => {
+    this.favorite = !this.favorite;
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { name: this.name, favorite: this.favorite },
+    }));
+  };
+
+  #render() {
+    const { badge, favorite, name, price, strength, link } = this.#els;
+    const drink = this.name;
+
+    name.textContent = drink;
+    badge.hidden = !this.seasonal;
+
+    price.textContent = this.price === null ? '' : priceFormat.format(this.price);
+
+    const level = this.strength;
+    strength.textContent = level ? '●'.repeat(level) + '○'.repeat(5 - level) : '';
+    strength.setAttribute('aria-label', `Strength ${level} of 5`);
+
+    favorite.textContent = this.favorite ? '♥' : '♡';
+    favorite.setAttribute('aria-pressed', String(this.favorite));
+    favorite.setAttribute('aria-label', drink ? `Favorite ${drink}` : 'Favorite');
+
+    if (this.soldOut || !this.href) {
+      link.removeAttribute('href');
+      link.setAttribute('aria-disabled', 'true');
+      link.textContent = this.soldOut ? 'Sold Out' : 'View Details';
+    } else {
+      link.href = this.href;
+      link.removeAttribute('aria-disabled');
+      link.textContent = 'View Details';
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+
+export { CoffeeCard };
