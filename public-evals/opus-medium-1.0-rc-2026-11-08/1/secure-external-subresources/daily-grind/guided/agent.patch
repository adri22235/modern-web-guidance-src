@@ -0,0 +1,84 @@
+#!/usr/bin/env node
+// Build-time Subresource Integrity generator for index.html.
+//
+// Finds every external subresource that declares an integrity value, either an
+// HTML `integrity="..."` attribute on <script>/<link>, or a CSS
+// `url("..." ... integrity("..."))` request modifier. It fetches the pinned URL,
+// computes a sha384 digest, and writes it back. Run this whenever a pinned URL changes.
+//
+//   node scripts/sri.mjs          rewrite digests in place
+//   node scripts/sri.mjs --check  exit 1 if any digest is missing or stale
+
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+
+const FILE = new URL('../index.html', import.meta.url);
+const check = process.argv.includes('--check');
+
+const html = await readFile(FILE, 'utf8');
+const digests = new Map();
+const problems = [];
+
+async function digestFor(url) {
+  if (!digests.has(url)) {
+    digests.set(url, (async () => {
+      if (!url.startsWith('https://')) throw new Error(`${url}: integrity requires an https:// URL`);
+      const res = await fetch(url, { headers: { Origin: 'https://example.com' } }).catch((err) => {
+        throw new Error(`${url}: ${err.cause?.code || err.cause?.message || err.message}`);
+      });
+      if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`);
+      // Browsers can only hash-verify CORS-readable responses.
+      if (res.headers.get('access-control-allow-origin') !== '*') {
+        throw new Error(`${url}: missing "Access-Control-Allow-Origin: *", so the browser can't verify it`);
+      }
+      const bytes = Buffer.from(await res.arrayBuffer());
+      return `sha384-${createHash('sha384').update(bytes).digest('base64')}`;
+    })());
+  }
+  return digests.get(url);
+}
+
+// Collect the match locations, then replace from the end so earlier offsets stay valid.
+const edits = [];
+
+// <script src integrity> and <link href integrity>
+for (const tag of html.matchAll(/<(?:script|link)\b[^>]*>/g)) {
+  const url = tag[0].match(/\b(?:src|href)="([^"]+)"/)?.[1];
+  const attr = /\bintegrity="([^"]*)"/.exec(tag[0]);
+  if (!url || !attr) continue;
+  const start = tag.index + attr.index + 'integrity="'.length;
+  edits.push({ url, start, end: start + attr[1].length, current: attr[1] });
+}
+
+// CSS url("..." cross-origin(...) referrer-policy(...) integrity("..."))
+for (const m of html.matchAll(/url\(\s*"([^"]+)"((?:\s+[a-z-]+\([^)]*\))+)\s*\)/g)) {
+  const integrity = /integrity\("([^"]*)"\)/.exec(m[2]);
+  if (!integrity) continue;
+  const start = m.index + m[0].indexOf(m[2]) + integrity.index + 'integrity("'.length;
+  edits.push({ url: m[1], start, end: start + integrity[1].length, current: integrity[1] });
+}
+
+let out = html;
+for (const edit of edits.sort((a, b) => b.start - a.start)) {
+  try {
+    const expected = await digestFor(edit.url.replaceAll('&amp;', '&'));
+    if (edit.current !== expected) {
+      problems.push(`${check ? 'stale' : 'updated'}: ${edit.url}`);
+      out = out.slice(0, edit.start) + expected + out.slice(edit.end);
+    }
+  } catch (err) {
+    problems.push(`error: ${err.message}`);
+  }
+}
+
+const errors = problems.filter((p) => p.startsWith('error'));
+for (const p of problems) console[p.startsWith('error') ? 'error' : 'log'](p);
+
+if (check) {
+  if (problems.length) process.exit(1);
+  console.log(`All ${edits.length} integrity digests are current.`);
+} else {
+  if (errors.length) process.exit(1); // don't write a partially-updated file
+  if (out !== html) await writeFile(FILE, out);
+  console.log(`Checked ${edits.length} integrity digests.`);
+}
