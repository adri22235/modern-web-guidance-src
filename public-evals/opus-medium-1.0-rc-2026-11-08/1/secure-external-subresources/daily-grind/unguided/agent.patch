+++ b/scripts/sri.mjs
@@ -0,0 +1,63 @@
+#!/usr/bin/env node
+// Computes Subresource Integrity hashes for every third-party resource in
+// index.html and writes them back in place.
+//
+//   node scripts/sri.mjs          update integrity / data-integrity attributes
+//   node scripts/sri.mjs --check  exit non-zero if any hash is stale (for CI)
+//
+// Handles <link>/<script> tags with href/src + integrity, and elements using
+// data-verified-src / data-verified-bg + data-integrity (images verified in the
+// browser via fetch()). The hash algorithm already present in each attribute
+// is preserved (sha256/sha384/sha512).
+
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const file = fileURLToPath(new URL('../index.html', import.meta.url));
+const check = process.argv.includes('--check');
+
+const TAG_RE = /<[a-z]+\b[^>]*?\b(?:data-)?integrity="[^"]*"[^>]*>/gis;
+const URL_RE = /\b(?:href|src|data-verified-src|data-verified-bg)="([^"]+)"/i;
+const INTEGRITY_RE = /\b((?:data-)?integrity)="(sha256|sha384|sha512)-[^"]*"/i;
+
+const decode = (s) => s.replace(/&amp;/g, '&');
+
+const hashOf = async (url, algorithm) => {
+  // No cookies or referrer, matching the browser requests.
+  const res = await fetch(url, { credentials: 'omit', referrerPolicy: 'no-referrer' });
+  if (!res.ok) throw new Error(`HTTP ${res.status} for ${url}`);
+  const body = Buffer.from(await res.arrayBuffer());
+  return `${algorithm}-${createHash(algorithm).update(body).digest('base64')}`;
+};
+
+const html = await readFile(file, 'utf8');
+const tags = html.match(TAG_RE) ?? [];
+let output = html;
+let stale = 0;
+
+for (const tag of tags) {
+  const url = tag.match(URL_RE)?.[1];
+  const integrity = tag.match(INTEGRITY_RE);
+  if (!url || !integrity) continue;
+
+  const [current, attr, algorithm] = integrity;
+  const expected = `${attr}="${await hashOf(decode(url), algorithm)}"`;
+  if (current === expected) {
+    console.log(`ok     ${url}`);
+    continue;
+  }
+  stale++;
+  console.log(`${check ? 'STALE ' : 'update'} ${url}`);
+  output = output.replace(tag, tag.replace(current, expected));
+}
+
+if (check) {
+  if (stale) {
+    console.error(`\n${stale} integrity hash(es) out of date. Run \`npm run sri\`.`);
+    process.exit(1);
+  }
+} else if (output !== html) {
+  await writeFile(file, output);
+  console.log(`\nUpdated ${stale} hash(es) in index.html.`);
+}
