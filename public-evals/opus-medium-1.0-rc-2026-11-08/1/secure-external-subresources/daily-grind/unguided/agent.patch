+  <script>
+    // <img> and CSS backgrounds don't support the integrity attribute, so
+    // images are fetched with SRI via fetch() and displayed from blob: URLs.
+    // If verification fails the image is simply not shown (fail closed).
+    (() => {
+      const loadVerified = async (url, integrity) => {
+        const res = await fetch(url, {
+          integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer',
+        });
+        if (!res.ok) throw new Error(`HTTP ${res.status} for ${url}`);
+        return URL.createObjectURL(await res.blob());
+      };
+
+      const report = (url, err) => console.warn('Integrity-verified image not loaded:', url, err);
+
+      document.querySelectorAll('[data-verified-bg]').forEach((el) => {
+        const url = el.dataset.verifiedBg;
+        loadVerified(url, el.dataset.integrity)
+          .then((blobUrl) => el.style.setProperty('--hero-image', `url("${blobUrl}")`))
+          .catch((err) => report(url, err));
+      });
+
+      document.querySelectorAll('img[data-verified-src]').forEach((img) => {
+        const url = img.dataset.verifiedSrc;
+        loadVerified(url, img.dataset.integrity)
+          .then((blobUrl) => {
+            img.addEventListener('load', () => URL.revokeObjectURL(blobUrl), { once: true });
+            img.src = blobUrl;
+          })
+          .catch((err) => report(url, err));
+      });
+    })();
+  </script>
+
