+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('menu-grid');
+      const HIGHLIGHT_NAME = 'menu-search';
+      const supportsHighlights = 'highlights' in CSS && typeof Highlight === 'function';
+
+      function getTextNodes() {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: (node) => node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
+        });
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      }
+
+      // Menu content is static, so the text nodes can be collected once.
+      const textNodes = supportsHighlights ? getTextNodes() : null;
+
+      function findMatches(text, term) {
+        const lower = text.toLowerCase();
+        const positions = [];
+        let pos = lower.indexOf(term);
+        while (pos !== -1) {
+          positions.push(pos);
+          pos = lower.indexOf(term, pos + term.length);
+        }
+        return positions;
+      }
+
+      function highlightWithApi(term) {
+        CSS.highlights.delete(HIGHLIGHT_NAME);
+        if (!term) return;
+        const ranges = [];
+        for (const node of textNodes) {
+          for (const start of findMatches(node.nodeValue, term)) {
+            const range = new Range();
+            range.setStart(node, start);
+            range.setEnd(node, start + term.length);
+            ranges.push(range);
+          }
+        }
+        if (ranges.length) CSS.highlights.set(HIGHLIGHT_NAME, new Highlight(...ranges));
+      }
+
+      function highlightWithMarks(term) {
+        // Unwrap previous marks and merge the split text nodes back together.
+        grid.querySelectorAll('mark.search-match').forEach((mark) => mark.replaceWith(mark.textContent));
+        grid.normalize();
+        if (!term) return;
+        for (const node of getTextNodes()) {
+          const text = node.nodeValue;
+          const positions = findMatches(text, term);
+          if (!positions.length) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (const start of positions) {
+            frag.append(text.slice(last, start));
+            const mark = document.createElement('mark');
+            mark.className = 'search-match';
+            mark.textContent = text.slice(start, start + term.length);
+            frag.append(mark);
+            last = start + term.length;
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      }
+
+      input.addEventListener('input', () => {
+        const term = input.value.trim().toLowerCase();
+        if (supportsHighlights) highlightWithApi(term);
+        else highlightWithMarks(term);
+      });
+    })();
+  </script>
+
 </body>
 
