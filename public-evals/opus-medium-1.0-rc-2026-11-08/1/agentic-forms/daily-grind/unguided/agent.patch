+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const totalEl = document.getElementById('order-total');
+      const confirmationEl = document.getElementById('order-confirmation');
+      const SHOT_PRICE = 0.75;
+
+      const STORE_NAMES = {
+        downtown: 'Downtown (120 Main St)',
+        riverside: 'Riverside (45 Water Ave)',
+        university: 'University (9 College Rd)',
+        northgate: 'Northgate (300 Oak Blvd)'
+      };
+
+      function clampInt(value, min, max, fallback) {
+        const n = parseInt(value, 10);
+        if (Number.isNaN(n)) return fallback;
+        return Math.min(max, Math.max(min, n));
+      }
+
+      function calculateTotal() {
+        const drinkOption = form.drink.selectedOptions[0];
+        const base = parseFloat(drinkOption && drinkOption.dataset.price) || 0;
+        if (!base) return 0;
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const size = parseFloat(sizeInput && sizeInput.dataset.upcharge) || 0;
+        const milk = parseFloat(form.milk.selectedOptions[0].dataset.upcharge) || 0;
+        const shots = clampInt(form.extraShots.value, 0, 4, 0) * SHOT_PRICE;
+        const qty = clampInt(form.quantity.value, 1, 10, 1);
+        return (base + size + milk + shots) * qty;
+      }
+
+      function updateTotal() {
+        totalEl.textContent = '$' + calculateTotal().toFixed(2);
+      }
+
+      function validate() {
+        const errors = [];
+        if (!form.drink.value) errors.push('Please choose a drink.');
+        if (!form.querySelector('input[name="size"]:checked')) errors.push('Please choose a size.');
+        if (!form.location.value) errors.push('Please choose a pickup location.');
+        if (!form.customerName.value.trim()) errors.push('Please enter a name for the order.');
+        const qty = parseInt(form.quantity.value, 10);
+        if (Number.isNaN(qty) || qty < 1 || qty > 10) errors.push('Quantity must be between 1 and 10.');
+        const shots = parseInt(form.extraShots.value || '0', 10);
+        if (Number.isNaN(shots) || shots < 0 || shots > 4) errors.push('Extra shots must be between 0 and 4.');
+        return errors;
+      }
+
+      function showMessage(html, isError) {
+        confirmationEl.innerHTML = html;
+        confirmationEl.classList.toggle('error', !!isError);
+        confirmationEl.classList.add('visible');
+      }
+
+      function escapeHtml(str) {
+        return String(str).replace(/[&<>"']/g, c => ({
+          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
+        })[c]);
+      }
+
+      function placeOrder() {
+        const errors = validate();
+        if (errors.length) {
+          showMessage('<strong>We couldn\'t place your order:</strong><br>' +
+            errors.map(escapeHtml).join('<br>'), true);
+          return { ok: false, errors };
+        }
+
+        const data = new FormData(form);
+        const qty = clampInt(data.get('quantity'), 1, 10, 1);
+        const shots = clampInt(data.get('extraShots'), 0, 4, 0);
+        const drinkLabel = form.drink.selectedOptions[0].textContent.split(' — ')[0];
+        const pickup = data.get('pickupTime') === 'asap'
+          ? 'in about 10 minutes'
+          : 'in ' + data.get('pickupTime') + ' minutes';
+        const order = {
+          orderNumber: 'DG-' + Math.floor(1000 + Math.random() * 9000),
+          drink: drinkLabel,
+          size: data.get('size'),
+          milk: data.get('milk'),
+          extraShots: shots,
+          sweetener: data.get('sweetener'),
+          quantity: qty,
+          location: STORE_NAMES[data.get('location')],
+          pickup,
+          name: data.get('customerName').trim(),
+          notes: (data.get('notes') || '').trim(),
+          total: '$' + calculateTotal().toFixed(2)
+        };
+
+        showMessage(
+          '<strong>Order ' + order.orderNumber + ' confirmed!</strong><br>' +
+          escapeHtml(order.quantity + ' × ' + order.size + ' ' + order.drink) +
+          ' — ' + escapeHtml(order.total) + '<br>' +
+          'Ready for <strong>' + escapeHtml(order.name) + '</strong> at ' +
+          escapeHtml(order.location) + ' ' + escapeHtml(order.pickup) + '. Pay at pickup.'
+        );
+        return { ok: true, order };
+      }
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const result = placeOrder();
+
+        // When submitted by an AI agent through the declarative WebMCP tool,
+        // return a structured result to the agent instead of navigating.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result.ok
+            ? 'Order placed successfully: ' + JSON.stringify(result.order)
+            : 'Order failed: ' + result.errors.join(' ')));
+        }
+
+        if (result.ok) {
+          form.reset();
+          updateTotal();
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
 </html>
