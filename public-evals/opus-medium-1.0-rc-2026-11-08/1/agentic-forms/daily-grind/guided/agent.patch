+        notes: 'Bold, smokey, and perfect for a morning boost.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Cold Brew', roast: 'medium', temperature: 'iced', milk: 'none', decaf: false, price: 4.50,
+        notes: 'Steeped for 18 hours for maximum smoothness, with chocolate undertones.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Ethiopian Pour-Over', roast: 'light', temperature: 'hot', milk: 'none', decaf: false, price: 4.75,
+        notes: 'Bright and floral with blueberry and citrus notes.',
+        image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Classic Cappuccino', roast: 'dark', temperature: 'hot', milk: 'dairy', decaf: false, price: 4.25,
+        notes: 'Rich espresso under a thick cap of velvety foam with a dusting of cocoa.',
+        image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Iced Vanilla Almond Latte', roast: 'medium', temperature: 'iced', milk: 'almond', decaf: false, price: 5.50,
+        notes: 'Smooth espresso, almond milk, and Madagascar vanilla over ice.',
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Decaf Mocha', roast: 'dark', temperature: 'hot', milk: 'dairy', decaf: true, price: 5.25,
+        notes: 'Swiss Water decaf with dark chocolate and steamed milk.',
+        image: 'https://images.unsplash.com/photo-1578314675249-a6910f80cc4e?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Decaf Honey Oat Flat White', roast: 'light', temperature: 'hot', milk: 'oat', decaf: true, price: 5.00,
+        notes: 'Silky oat milk, wildflower honey, and a light, caramel-sweet decaf.',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Nitro Cold Brew', roast: 'dark', temperature: 'iced', milk: 'none', decaf: false, price: 5.25,
+        notes: 'Nitrogen-infused cold brew with a creamy, stout-like head and cocoa finish.',
+        image: 'https://images.unsplash.com/photo-1592663527359-cf6642f54cff?auto=format&fit=crop&w=600&q=70' },
+      { name: 'Café au Lait', roast: 'medium', temperature: 'hot', milk: 'dairy', decaf: false, price: 3.75,
+        notes: 'Equal parts drip coffee and steamed milk, nutty and comforting.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=70' },
+    ];
+
+    const finderForm = document.getElementById('coffee-finder');
+    const finderStatus = document.getElementById('finder-status');
+    const finderResults = document.getElementById('finder-results');
+    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function findCoffee(data) {
+      const roast = data.get('roast') || 'any';
+      const temperature = data.get('temperature') || 'any';
+      const milk = data.get('milk') || 'any';
+      const maxPrice = data.get('max_price') ? Number(data.get('max_price')) : Infinity;
+      const flavor = (data.get('flavor') || '').trim().toLowerCase();
+      const decafOnly = data.get('decaf') === 'true';
+
+      return MENU.filter((drink) =>
+        (roast === 'any' || drink.roast === roast) &&
+        (temperature === 'any' || drink.temperature === temperature) &&
+        (milk === 'any' || drink.milk === milk) &&
+        drink.price <= maxPrice &&
+        (!decafOnly || drink.decaf) &&
+        (!flavor || `${drink.name} ${drink.notes}`.toLowerCase().includes(flavor))
+      );
+    }
+
+    function renderResults(matches) {
+      finderResults.replaceChildren(...matches.map((drink) => {
+        const item = document.createElement('li');
+        item.className = 'card';
+
+        const img = document.createElement('img');
+        img.src = drink.image;
+        img.alt = '';
+        img.width = 600;
+        img.height = 400;
+        img.loading = 'lazy';
+        img.decoding = 'async';
+
+        const body = document.createElement('div');
+        body.className = 'card-body';
+        const title = document.createElement('h3');
+        title.textContent = drink.name;
+        const notes = document.createElement('p');
+        notes.textContent = drink.notes;
+        const meta = document.createElement('p');
+        meta.className = 'meta';
+        meta.textContent = `${drink.roast} roast · ${drink.temperature} · ${drink.milk === 'none' ? 'no milk' : `${drink.milk} milk`}${drink.decaf ? ' · decaf' : ''}`;
+        const price = document.createElement('p');
+        price.className = 'price';
+        price.textContent = usd.format(drink.price);
+
+        body.append(title, notes, meta, price);
+        item.append(img, body);
+        return item;
+      }));
+
+      finderStatus.textContent = matches.length
+        ? `We found ${matches.length} drink${matches.length === 1 ? '' : 's'} for you.`
+        : 'No drinks match those preferences. Try loosening a filter.';
+    }
+
+    // Keep aria-invalid in sync with the visual :user-invalid state.
+    const syncAria = (el) => {
+      if (el.willValidate) el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+    finderForm.addEventListener('focusout', (e) => syncAria(e.target));
+    finderForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const invalid = [...finderForm.elements].filter((el) => el.willValidate && !el.checkValidity());
+      if (invalid.length) {
+        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
+        if (event.agentInvoked) {
+          const errors = invalid.map((el) => `${el.name} (${el.validationMessage})`).join(', ');
+          event.respondWith(Promise.resolve(`Validation failed: ${errors}`));
+        } else {
+          finderForm.reportValidity();
+        }
+        return;
+      }
+
+      const matches = findCoffee(new FormData(finderForm));
+      renderResults(matches);
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(JSON.stringify({
+          count: matches.length,
+          drinks: matches.map(({ name, roast, temperature, milk, decaf, price, notes }) =>
+            ({ name, roast, temperature, milk, decaf, price_usd: price, notes })),
+        })));
+      }
+    });
+
+    finderForm.addEventListener('reset', () => {
+      finderResults.replaceChildren();
+      finderStatus.textContent = '';
+      finderForm.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
+    });
+  </script>
+
 </body>
 
