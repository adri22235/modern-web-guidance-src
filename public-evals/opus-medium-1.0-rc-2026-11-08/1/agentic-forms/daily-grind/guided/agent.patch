+  <script>
+    const MENU = [
+      { name: 'Maple Oat Latte', roast: 'medium', temperature: 'hot', milk: 'oat', decaf: false, price: 5.75,
+        notes: 'Creamy oat milk with a hint of Vermont maple syrup.',
