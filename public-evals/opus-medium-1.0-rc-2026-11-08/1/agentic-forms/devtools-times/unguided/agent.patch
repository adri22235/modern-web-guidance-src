diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..1fa54f2
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,66 @@
+import { useEffect, useRef } from 'react';
+
+// Minimal typings for the WebMCP API (https://github.com/webmachinelearning/webmcp),
+// which lets pages expose client-side functionality as tools to AI agents.
+export interface ToolResult {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+}
+
+export interface ModelContextTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: any) => Promise<ToolResult> | ToolResult;
+}
+
+interface ModelContext {
+  registerTool: (tool: ModelContextTool, options?: { signal?: AbortSignal }) => unknown;
+  unregisterTool?: (name: string) => void;
+}
+
+declare global {
+  interface Navigator {
+    modelContext?: ModelContext;
+  }
+}
+
+export const textResult = (text: string, isError = false): ToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError ? { isError } : {}),
+});
+
+/**
+ * Registers a WebMCP tool for the lifetime of the calling component.
+ * The latest `execute` is always used, so it may close over component state.
+ */
+export function useWebMcpTool(tool: ModelContextTool) {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = navigator.modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const controller = new AbortController();
+    try {
+      modelContext.registerTool(
+        { ...tool, execute: (input) => executeRef.current(input) },
+        { signal: controller.signal },
+      );
+    } catch (err) {
+      console.warn(`Failed to register WebMCP tool "${tool.name}":`, err);
+      return;
+    }
+
+    return () => {
+      controller.abort();
+      try {
+        modelContext.unregisterTool?.(tool.name);
+      } catch {
+        // Already unregistered via the abort signal.
+      }
+    };
+  }, [tool.name]);
+}
