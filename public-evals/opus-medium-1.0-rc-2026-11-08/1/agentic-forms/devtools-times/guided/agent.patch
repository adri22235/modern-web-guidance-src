diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..a37b8f4
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,6 @@
+// WebMCP extends SubmitEvent when a form tool is invoked by an AI agent.
+// Browsers without WebMCP leave these fields undefined.
+export interface AgentSubmitEvent extends SubmitEvent {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+}
