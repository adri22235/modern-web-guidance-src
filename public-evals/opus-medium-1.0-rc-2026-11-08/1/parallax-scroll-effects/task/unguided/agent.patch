+      z-index: -3;
+    }
+
+    .parallax-layer--mid {
+      z-index: -2;
+      opacity: 0.35;
+    }
+
+    .parallax-layer--front {
+      z-index: -1;
+      opacity: 0.85;
+    }
+
+    .bean {
