+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      min-height: 75vh;
+      overflow: hidden;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 80px 20px;
+      color: white;
+      background: #2b1d18; /* fallback while the photo loads */
+      isolation: isolate;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+      transform: translate3d(0, var(--parallax-y, 0px), 0);
+    }
+
+    .parallax.is-active .parallax-layer {
+      will-change: transform;
+    }
+
+    /* Over-sized so the moving photo never reveals an edge */
+    .parallax-layer--back {
+      inset: -40% 0;
+      background:
