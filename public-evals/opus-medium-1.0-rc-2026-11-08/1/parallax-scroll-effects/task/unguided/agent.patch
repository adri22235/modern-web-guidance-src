+  <script>
+    (function () {
+      var section = document.querySelector('[data-parallax]');
+      if (!section) return;
+
+      var layers = Array.prototype.slice.call(section.querySelectorAll('[data-speed]'));
+      var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var isVisible = false;
+      var ticking = false;
+
+      function reset() {
+        layers.forEach(function (layer) {
+          layer.style.removeProperty('--parallax-y');
+        });
+      }
+
+      function update() {
+        ticking = false;
+        if (!isVisible || motionQuery.matches) return;
+
+        // Distance between section centre and viewport centre: 0 when centred
+        var rect = section.getBoundingClientRect();
+        var offset = (rect.top + rect.height / 2) - window.innerHeight / 2;
+
+        layers.forEach(function (layer) {
+          var speed = parseFloat(layer.dataset.speed) || 0;
+          layer.style.setProperty('--parallax-y', (-offset * speed).toFixed(1) + 'px');
+        });
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      function bind() {
+        window.addEventListener('scroll', requestUpdate, { passive: true });
+        window.addEventListener('resize', requestUpdate, { passive: true });
+        requestUpdate();
+      }
+
+      function unbind() {
+        window.removeEventListener('scroll', requestUpdate);
+        window.removeEventListener('resize', requestUpdate);
+      }
+
+      // Only do work while the section is on screen
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          isVisible = entries[0].isIntersecting;
+          section.classList.toggle('is-active', isVisible && !motionQuery.matches);
+          if (isVisible) requestUpdate();
+        }, { rootMargin: '100px 0px' }).observe(section);
+      } else {
+        isVisible = true;
+      }
+
+      function applyMotionPreference() {
+        if (motionQuery.matches) {
+          unbind();
+          reset();
+          section.classList.remove('is-active');
+        } else {
+          bind();
+        }
+      }
+
+      if (motionQuery.addEventListener) {
+        motionQuery.addEventListener('change', applyMotionPreference);
+      } else if (motionQuery.addListener) {
+        motionQuery.addListener(applyMotionPreference);
+      }
+      applyMotionPreference();
+    })();
+  </script>
+
