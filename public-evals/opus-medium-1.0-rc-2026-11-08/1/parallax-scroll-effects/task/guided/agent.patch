+  <script>
+    // Fallback for browsers without scroll-driven animations. Like the CSS, it
+    // skips users who prefer reduced motion and only listens while in view.
+    if (!CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
+      const wrapper = document.querySelector('.parallax');
+      const layers = [...wrapper.querySelectorAll('.parallax-layer')];
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let offsets = [];
+      let ticking = false;
+
+      const update = () => {
+        ticking = false;
+        const { top, height } = wrapper.getBoundingClientRect();
+        const viewport = innerHeight;
+        // 0 when the section enters at the bottom, 1 when it leaves at the top (matches view-timeline "cover")
+        const progress = Math.min(Math.max((viewport - top) / (viewport + height), 0), 1);
+        layers.forEach((layer, i) => {
+          layer.style.transform = `translateY(${offsets[i] * (1 - 2 * progress)}px)`;
+        });
+      };
+
+      const onScroll = () => {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      };
+
+      const observer = new IntersectionObserver(([entry]) => {
+        if (entry.isIntersecting) {
+          addEventListener('scroll', onScroll, { passive: true });
+          addEventListener('resize', onScroll, { passive: true });
+          onScroll();
+        } else {
+          removeEventListener('scroll', onScroll);
+          removeEventListener('resize', onScroll);
+        }
+      });
+
+      const toggle = () => {
+        if (reducedMotion.matches) {
+          observer.disconnect();
+          removeEventListener('scroll', onScroll);
+          removeEventListener('resize', onScroll);
+          layers.forEach((layer) => layer.style.removeProperty('transform'));
+        } else {
+          offsets = layers.map((layer) => parseFloat(getComputedStyle(layer).getPropertyValue('--offset')) || 0);
+          observer.observe(wrapper);
+        }
+      };
+
+      reducedMotion.addEventListener('change', toggle);
+      toggle();
+    }
+  </script>
