+    }
+
+    .parallax-content .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .parallax-content .btn:hover {
+      background: #ffc570;
+    }
+
+    @keyframes parallax {
+      from {
+        transform: translateY(var(--offset));
+      }
+
+      to {
+        transform: translateY(calc(-1 * var(--offset)));
+      }
