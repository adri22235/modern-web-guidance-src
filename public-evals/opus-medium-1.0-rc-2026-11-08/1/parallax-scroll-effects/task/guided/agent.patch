+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      height: 70vh;
+      min-height: 420px;
+      overflow: clip;
+      display: grid;
+      place-items: center;
+      background: var(--primary);
+      color: white;
+      view-timeline: --parallax;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Oversize the photo so translating it never exposes the edges */
+    .parallax-bg {
+      inset: -90px 0;
+      background: linear-gradient(rgba(62, 39, 35, 0.55), rgba(62, 39, 35, 0.75)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=70') center / cover;
+    }
+
+    .parallax-bean {
+      position: absolute;
+      width: var(--size);
+      aspect-ratio: 3 / 4;
+      color: var(--secondary);
+      opacity: 0.85;
+      filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
+    }
+
+    .parallax-mid .parallax-bean {
+      --size: 48px;
+      opacity: 0.55;
+    }
+
+    .parallax-front .parallax-bean {
+      --size: 84px;
+      color: var(--accent);
+    }
+
+    /* Negative travel lags behind the scroll (far away), positive overtakes it (close up) */
+    .parallax-bg { --offset: -90px; }
+    .parallax-mid { --offset: 120px; }
+    .parallax-front { --offset: 260px; }
+
+    .parallax-content {
