+  <script>
+    document.getElementById('signup-form').addEventListener('submit', function (e) {
+      e.preventDefault();
+      var form = e.target;
+      var error = document.getElementById('signup-error');
+      var name = form.name.value.trim();
+      var email = form.email.value.trim();
+      var password = form.password.value;
+
+      if (!name) {
+        error.textContent = 'Please enter your name.';
+      } else if (!form.email.checkValidity() || !email) {
+        error.textContent = 'Please enter a valid email address.';
+      } else if (password.length < 8) {
+        error.textContent = 'Password must be at least 8 characters.';
+      } else if (password !== form.confirm_password.value) {
+        error.textContent = 'Passwords do not match.';
+      } else if (!form.terms.checked) {
+        error.textContent = 'Please accept the terms to continue.';
+      } else {
+        error.textContent = '';
+        var success = document.getElementById('signup-success');
+        success.textContent = 'Welcome, ' + name + '! Check ' + email + ' to confirm your account.';
+        success.hidden = false;
+        form.hidden = true;
+      }
+    });
+  </script>
