+  <script>
+    const signupForm = document.getElementById('signup-form');
+    const passwordInput = document.getElementById('new-password');
+    const togglePassword = signupForm.querySelector('.toggle-password');
+
+    togglePassword.addEventListener('click', () => {
+      const show = passwordInput.type === 'password';
+      passwordInput.type = show ? 'text' : 'password';
+      togglePassword.setAttribute('aria-pressed', String(show));
+      togglePassword.textContent = show ? 'Hide' : 'Show';
+    });
+
+    // Keep aria-invalid in sync with the :user-invalid visual state
+    const syncAria = (el) => {
+      if (!el.matches?.('input')) return;
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+    signupForm.addEventListener('focusout', (e) => syncAria(e.target));
+    signupForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    signupForm.addEventListener('invalid', (e) => e.target.setAttribute('aria-invalid', 'true'), true);
+
+    // Prevent double submission once the form is valid
+    signupForm.addEventListener('submit', () => {
+      signupForm.querySelector('button[type="submit"]').disabled = true;
+    });
+  </script>
+
