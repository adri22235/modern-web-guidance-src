+  <script>
+    (function () {
+      var form = document.getElementById('subscribe-form');
+      var progress = document.getElementById('sub-progress');
+      var progressText = document.getElementById('sub-progress-text');
+      var name = document.getElementById('sub-name');
+      var email = document.getElementById('sub-email');
+      var roast = document.getElementById('sub-roast');
+      var roastOutput = document.getElementById('sub-roast-output');
+      var roastLabels = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      var roastTouched = false;
+
+      function updateRoast() {
+        var value = Number(roast.value);
+        var label = roastLabels[value - 1];
+        roastOutput.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        roast.style.setProperty('--fill', ((value - roast.min) / (roast.max - roast.min)) * 100 + '%');
+      }
+
+      function updateProgress() {
+        var steps = [
+          name.value.trim() !== '',
+          email.value.trim() !== '' && email.validity.valid,
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastTouched
+        ];
+        var done = steps.filter(Boolean).length;
+        progress.value = done;
+        progress.textContent = done + ' of ' + steps.length;
+        progressText.textContent = done + ' of ' + steps.length + ' steps complete';
+      }
+
+      roast.addEventListener('input', function () {
+        roastTouched = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
