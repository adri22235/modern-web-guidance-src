+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const progress = document.getElementById('setup-progress');
+      const status = document.getElementById('setup-status');
+      const roast = document.getElementById('sub-roast');
+      const roastValue = document.getElementById('roast-value');
+      const roastLevels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastConfirmed = false;
+
+      const updateRoast = () => {
+        const label = roastLevels[roast.value - 1];
+        roastValue.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        // Drives the track fill in the no-accent-color fallback
+        roast.style.setProperty('--fill', `${((roast.value - roast.min) / (roast.max - roast.min)) * 100}%`);
+      };
+
+      const updateProgress = () => {
+        const steps = [
+          form.elements.name.validity.valid,
+          form.elements.email.validity.valid,
+          form.elements.frequency.value !== '',
+          roastConfirmed,
+        ];
+        const done = steps.filter(Boolean).length;
+        const text = `${done} of ${steps.length} steps complete`;
+        progress.value = done;
+        progress.textContent = text;
+        if (status.textContent !== text) status.textContent = text;
+      };
+
+      roast.addEventListener('input', () => {
+        roastConfirmed = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
