+  <script>
+    // Let users dismiss an open tooltip with Escape without moving pointer or focus
+    (function () {
+      var wraps = document.querySelectorAll('.tip-wrap');
+      for (var i = 0; i < wraps.length; i++) {
+        (function (wrap) {
+          function reset() {
+            wrap.className = wrap.className.replace(/\s*tip-dismissed/g, '');
+          }
+          wrap.addEventListener('mouseleave', reset);
+          wrap.addEventListener('focusout', reset);
+        })(wraps[i]);
+      }
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape' && e.key !== 'Esc' && e.keyCode !== 27) return;
+        for (var j = 0; j < wraps.length; j++) {
+          if (!/\btip-dismissed\b/.test(wraps[j].className)) {
+            wraps[j].className += ' tip-dismissed';
+          }
+        }
+      });
+    })();
+  </script>
