diff --git a/app-migration.js b/app-migration.js
new file mode 100644
index 0000000..ee0a057
--- /dev/null
+++ b/app-migration.js
@@ -0,0 +1,144 @@
+/*
+ * Origin migration for the installed web app.
+ *
+ * The same build is deployed to both origins:
+ *   - OLD_ORIGIN serves legacy.webmanifest (`migrate_to`) so the browser moves
+ *     the existing installation — window, OS shortcuts, dock/start-menu pins,
+ *     permissions — over to the new app.
+ *   - NEW_ORIGIN serves manifest.webmanifest (`migrate_from`), claiming it.
+ *
+ * Browsers never move origin-bound storage, so user configuration kept in
+ * localStorage is handed over here: the old origin serialises it into the URL
+ * fragment (never sent to a server) and the new origin imports it once.
+ * Only keys using the app's `dg:` prefix are carried over.
+ *
+ * Loaded synchronously in <head> so imported settings exist before any other
+ * script reads them.
+ */
+(() => {
+  const OLD_ORIGIN = 'https://app.dailygrind.example';
+  const NEW_ORIGIN = 'https://www.thedailygrind.example';
+
+  const HASH_PARAM = 'dg-migrate';
+  const IMPORTED_FLAG = 'dg-internal:migration-imported';
+  const KEY_PATTERN = /^dg:/;
+  const MAX_PAYLOAD_CHARS = 64 * 1024;
+  const STANDALONE_REDIRECT_DELAY_MS = 4000;
+
+  const here = location.origin;
+  const isOldOrigin = here === OLD_ORIGIN;
+
+  // 1. Advertise the manifest that matches this origin.
+  const manifest = document.createElement('link');
+  manifest.rel = 'manifest';
+  manifest.href = isOldOrigin ? '/legacy.webmanifest' : '/manifest.webmanifest';
+  document.head.appendChild(manifest);
+
+  const toBase64Url = (text) => {
+    const bytes = new TextEncoder().encode(text);
+    let bin = '';
+    bytes.forEach((b) => { bin += String.fromCharCode(b); });
+    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  };
+
+  const fromBase64Url = (encoded) => {
+    const bin = atob(encoded.replace(/-/g, '+').replace(/_/g, '/'));
+    return new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
+  };
+
+  const readHashParam = () => new URLSearchParams(location.hash.slice(1)).get(HASH_PARAM);
+
+  const stripHashParam = () => {
+    const params = new URLSearchParams(location.hash.slice(1));
+    params.delete(HASH_PARAM);
+    const rest = params.toString();
+    history.replaceState(history.state, '', location.pathname + location.search + (rest ? `#${rest}` : ''));
+  };
+
+  // 2. New origin: import settings handed over from the old origin.
+  const importSettings = () => {
+    const payload = readHashParam();
+    if (payload === null) return;
+    stripHashParam();
+
+    if (localStorage.getItem(IMPORTED_FLAG)) return;
+    // Only accept handoffs that genuinely came from the old origin.
+    if (!document.referrer || new URL(document.referrer).origin !== OLD_ORIGIN) return;
+    if (payload.length > MAX_PAYLOAD_CHARS) return;
+
+    try {
+      const data = JSON.parse(fromBase64Url(payload));
+      if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+      Object.entries(data).forEach(([key, value]) => {
+        // Never clobber anything the user has already set on the new origin.
+        if (KEY_PATTERN.test(key) && typeof value === 'string' && localStorage.getItem(key) === null) {
+          localStorage.setItem(key, value);
+        }
+      });
+      localStorage.setItem(IMPORTED_FLAG, new Date().toISOString());
+    } catch (err) {
+      console.warn('[migration] Could not import settings from previous address', err);
+    }
+  };
+
+  // 3. Old origin: forward the user (and their settings) to the new origin.
+  const buildHandoffUrl = () => {
+    const settings = {};
+    for (let i = 0; i < localStorage.length; i += 1) {
+      const key = localStorage.key(i);
+      if (KEY_PATTERN.test(key)) settings[key] = localStorage.getItem(key);
+    }
+    const target = new URL(location.pathname + location.search, NEW_ORIGIN);
+    const params = new URLSearchParams(location.hash.slice(1));
+    const encoded = toBase64Url(JSON.stringify(settings));
+    if (Object.keys(settings).length && encoded.length <= MAX_PAYLOAD_CHARS) {
+      params.set(HASH_PARAM, encoded);
+    }
+    const hash = params.toString();
+    return target.href + (hash ? `#${hash}` : '');
+  };
+
+  const showMovedBanner = (go) => {
+    const banner = document.createElement('div');
+    banner.setAttribute('role', 'status');
+    banner.style.cssText = 'position:fixed;inset:auto 0 0 0;z-index:2000;display:flex;gap:12px;'
+      + 'justify-content:center;align-items:center;flex-wrap:wrap;padding:14px 20px;'
+      + 'background:#3e2723;color:#fff;font:15px/1.4 system-ui,sans-serif;';
+    banner.textContent = 'The Daily Grind has moved to a new address. Your settings and shortcuts come with you.';
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.textContent = 'Continue';
+    button.style.cssText = 'background:#ffab40;color:#3e2723;border:0;border-radius:4px;'
+      + 'padding:6px 14px;font:inherit;font-weight:600;cursor:pointer;';
+    button.addEventListener('click', go);
+    banner.appendChild(button);
+    document.body.appendChild(banner);
+  };
+
+  const forwardFromOldOrigin = () => {
+    const go = () => location.replace(buildHandoffUrl());
+    const standalone = matchMedia('(display-mode: standalone)').matches
+      || matchMedia('(display-mode: window-controls-overlay)').matches
+      || navigator.standalone === true;
+
+    if (!standalone) {
+      go();
+      return;
+    }
+    // Inside the installed app, let the page (and legacy manifest) load first so
+    // the browser picks up `migrate_to` before we navigate away.
+    const start = () => {
+      showMovedBanner(go);
+      setTimeout(go, STANDALONE_REDIRECT_DELAY_MS);
+    };
+    if (document.readyState === 'complete') start();
+    else addEventListener('load', start, { once: true });
+  };
+
+  try {
+    if (here === NEW_ORIGIN) importSettings();
+    else if (isOldOrigin) forwardFromOldOrigin();
+  } catch (err) {
+    console.warn('[migration] Origin migration step failed', err);
+  }
+})();
