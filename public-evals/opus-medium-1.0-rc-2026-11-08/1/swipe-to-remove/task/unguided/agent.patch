+  <script>
+    (function () {
+      var THRESHOLD_RATIO = 0.35; // fraction of item width needed to trigger removal
+      var DRAG_SLOP = 8; // px of movement before deciding swipe vs. scroll
+
+      var cart = document.querySelector('.cart');
+      var list = cart.querySelector('.SwipeableList');
+      var emptyMessage = cart.querySelector('.cart-empty');
+      var totalAmount = cart.querySelector('.cart-total-amount');
+      var totalRow = cart.querySelector('.cart-total');
+
+      function updateCart() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (item) {
+          total += parseFloat(item.dataset.price) || 0;
+        });
+        totalAmount.textContent = '$' + total.toFixed(2);
+        emptyMessage.hidden = items.length > 0;
+        totalRow.hidden = items.length === 0;
+      }
+
+      function collapse(item) {
+        // Pin the current height so it can transition to 0.
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow
+        item.classList.add('is-collapsing');
+        item.style.height = '0px';
+        item.style.marginBottom = '0px';
+        item.style.opacity = '0';
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 500); // fallback if transitionend never fires
+      }
+
+      function removeItem(item, direction) {
+        if (item.classList.contains('is-removing')) return;
+        var content = item.querySelector('.SwipeableList-content');
+        item.classList.add('is-removing', 'is-settling');
+        item.classList.toggle('is-swiping-right', direction > 0);
+        updateCart();
+
+        // Slide the content fully off, then collapse the row.
+        content.style.transform = 'translateX(' + (direction > 0 ? 100 : -100) + '%)';
+        var collapsed = false;
+        function startCollapse() {
+          if (collapsed) return;
+          collapsed = true;
+          collapse(item);
+        }
+        content.addEventListener('transitionend', function (e) {
+          if (e.target === content && e.propertyName === 'transform') startCollapse();
+        });
+        setTimeout(startCollapse, 350);
+      }
+
+      function initItem(item) {
+        if (item.classList.contains('is-initialized')) return;
+
+        var content = item.querySelector('.SwipeableList-content');
+        var removeButton = item.querySelector('.cart-item-remove');
+        var pointerId = null;
+        var startX = 0;
+        var startY = 0;
+        var deltaX = 0;
+        var dragging = false;
+
+        function reset() {
+          pointerId = null;
+          dragging = false;
+          deltaX = 0;
+          item.classList.remove('is-dragging');
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (item.classList.contains('is-removing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          if (e.target.closest('button, a')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          deltaX = 0;
+          dragging = false;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+
+          if (!dragging) {
+            if (Math.abs(dx) < DRAG_SLOP && Math.abs(dy) < DRAG_SLOP) return;
+            if (Math.abs(dy) > Math.abs(dx)) {
+              reset(); // vertical scroll intent; let the page scroll
+              return;
+            }
+            dragging = true;
+            content.setPointerCapture(pointerId);
+            item.classList.remove('is-settling');
+            item.classList.add('is-dragging');
+          }
+
+          deltaX = dx;
+          content.style.transform = 'translateX(' + deltaX + 'px)';
+          item.classList.toggle('is-swiping-right', deltaX > 0);
+          item.classList.toggle(
+            'is-past-threshold',
+            Math.abs(deltaX) > item.offsetWidth * THRESHOLD_RATIO
+          );
+        });
+
+        function onRelease(e) {
+          if (e.pointerId !== pointerId) return;
+          var wasDragging = dragging;
+          var finalDelta = deltaX;
+          reset();
+          if (!wasDragging) return;
+
+          if (Math.abs(finalDelta) > item.offsetWidth * THRESHOLD_RATIO && e.type === 'pointerup') {
+            removeItem(item, finalDelta > 0 ? 1 : -1);
+          } else {
+            item.classList.add('is-settling');
+            item.classList.remove('is-past-threshold');
+            content.style.transform = '';
+          }
+        }
+
+        content.addEventListener('pointerup', onRelease);
+        content.addEventListener('pointercancel', onRelease);
+
+        removeButton.addEventListener('click', function () {
+          removeItem(item, -1);
+        });
+
+        item.classList.add('is-initialized');
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(initItem);
+      updateCart();
+    })();
+  </script>
+
