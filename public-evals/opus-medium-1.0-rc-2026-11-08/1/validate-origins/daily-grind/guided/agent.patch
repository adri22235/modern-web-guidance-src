+    // Extracts an Origin from a URL string, URL, <a>, or MessageEvent. Synthetic
+    // MessageEvents (e.g. in tests) lack an internal origin, so fall back to event.origin.
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (candidate instanceof MessageEvent) return Origin.from(candidate.origin);
+        throw err;
+      }
+    }
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (candidate instanceof MessageEvent) return candidate.origin;
+      return candidate?.href ?? '';
+    }
+
+    // Exact (scheme, host, port) match against the trusted ordering origin.
+    function isTrustedOrderingOrigin(candidate) {
+      try {
+        if (hasOriginApi) {
+          return extractOrigin(candidate).isSameOrigin(Origin.from(ORDERING_ORIGIN));
+        }
+        const origin = new URL(extractUrlString(candidate)).origin;
+        return origin !== 'null' && origin === new URL(ORDERING_ORIGIN).origin;
+      } catch {
+        return false;
+      }
+    }
