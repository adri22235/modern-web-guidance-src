+  <script>
+    (() => {
+      const STATUSES = ['queued', 'brewing', 'ready'];
+      const LABELS = { queued: 'Queued', brewing: 'Brewing', ready: 'Ready' };
+      const STORAGE_KEY = 'daily-grind-orders';
+      const board = document.getElementById('order-board');
+      const live = document.getElementById('board-status');
+      const columns = Object.fromEntries(
+        STATUSES.map((s) => [s, board.querySelector(`.board-column[data-status="${s}"]`)])
+      );
+
+      const defaults = [
+        { id: 101, drink: 'Maple Oat Latte', customer: 'Sam', status: 'queued' },
+        { id: 102, drink: 'Cold Brew', customer: 'Priya', status: 'queued' },
+        { id: 103, drink: 'Dark Roast Espresso', customer: 'Alex', status: 'brewing' },
+        { id: 104, drink: 'Flat White', customer: 'Jordan', status: 'ready' },
+      ];
+
+      let orders;
+      try {
+        orders = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaults;
+      } catch {
+        orders = defaults;
+      }
+      let nextId = Math.max(100, ...orders.map((o) => o.id)) + 1;
+
+      const save = () => {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(orders)); } catch { }
+      };
+
+      const announce = (msg) => { live.textContent = msg; };
+
+      function createCard(order) {
+        const li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.tabIndex = 0;
+        li.dataset.id = order.id;
+
+        const top = document.createElement('div');
+        top.className = 'card-top';
+        const h4 = document.createElement('h4');
+        h4.textContent = order.drink;
+        const id = document.createElement('span');
+        id.className = 'order-id';
+        id.textContent = `#${order.id}`;
+        top.append(h4, id);
+
+        const meta = document.createElement('p');
+        meta.className = 'order-meta';
+        meta.textContent = `For ${order.customer}`;
+
+        const actions = document.createElement('div');
+        actions.className = 'card-actions';
+        const back = document.createElement('button');
+        back.type = 'button';
+        back.dataset.move = '-1';
+        back.textContent = '←';
+        const fwd = document.createElement('button');
+        fwd.type = 'button';
+        fwd.dataset.move = '1';
+        fwd.textContent = '→';
+        actions.append(back, fwd);
+
+        li.append(top, meta, actions);
+        updateCardControls(li, order);
+        return li;
+      }
+
+      function updateCardControls(li, order) {
+        const idx = STATUSES.indexOf(order.status);
+        const [back, fwd] = li.querySelectorAll('[data-move]');
+        back.disabled = idx === 0;
+        fwd.disabled = idx === STATUSES.length - 1;
+        back.setAttribute('aria-label', idx > 0 ? `Move order ${order.id} to ${LABELS[STATUSES[idx - 1]]}` : 'Move back');
+        fwd.setAttribute('aria-label', idx < STATUSES.length - 1 ? `Move order ${order.id} to ${LABELS[STATUSES[idx + 1]]}` : 'Move forward');
+        li.setAttribute('aria-label', `Order ${order.id}: ${order.drink} for ${order.customer}, ${LABELS[order.status]}`);
+      }
+
+      // Only touch the columns that actually changed so each column renders independently.
+      function updateCount(status) {
+        const col = columns[status];
+        col.querySelector('.column-count').textContent = col.querySelector('.column-cards').children.length;
+      }
+
+      function render() {
+        for (const s of STATUSES) columns[s].querySelector('.column-cards').replaceChildren();
+        for (const o of orders) columns[o.status].querySelector('.column-cards').append(createCard(o));
+        STATUSES.forEach(updateCount);
+      }
+
+      function moveOrder(id, status, beforeEl = null, keepFocus = false) {
+        const order = orders.find((o) => o.id === id);
+        const card = board.querySelector(`.card[data-id="${id}"]`);
+        if (!order || !card) return;
+        const from = order.status;
+        const list = columns[status].querySelector('.column-cards');
+        if (beforeEl === card) return;
+
+        order.status = status;
+        list.insertBefore(card, beforeEl);
+        updateCardControls(card, order);
+
+        // Keep array order in sync with DOM order for persistence.
+        orders.sort((a, b) => {
+          const ca = board.querySelector(`.card[data-id="${a.id}"]`);
+          const cb = board.querySelector(`.card[data-id="${b.id}"]`);
+          return ca.compareDocumentPosition(cb) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
+        });
+
+        updateCount(from);
+        if (from !== status) updateCount(status);
+        save();
+        if (keepFocus) card.focus();
+        if (from !== status) announce(`Order ${id} moved to ${LABELS[status]}`);
+      }
+
+      function shift(card, delta) {
+        const id = Number(card.dataset.id);
+        const order = orders.find((o) => o.id === id);
+        const idx = STATUSES.indexOf(order.status) + delta;
+        if (idx < 0 || idx >= STATUSES.length) return;
+        moveOrder(id, STATUSES[idx], null, true);
+      }
+
+      // Drag and drop
+      let dragged = null;
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        dragged = card;
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', card.dataset.id);
+        requestAnimationFrame(() => card.classList.add('dragging'));
+      });
+
+      board.addEventListener('dragend', () => {
+        dragged?.classList.remove('dragging');
+        dragged = null;
+        for (const col of Object.values(columns)) col.classList.remove('drag-over');
+      });
+
+      function cardAfter(list, y) {
+        const cards = [...list.querySelectorAll('.card:not(.dragging)')];
+        return cards.find((c) => {
+          const r = c.getBoundingClientRect();
+          return y < r.top + r.height / 2;
+        }) || null;
+      }
+
+      for (const col of Object.values(columns)) {
+        col.addEventListener('dragover', (e) => {
+          if (!dragged) return;
+          e.preventDefault();
+          e.dataTransfer.dropEffect = 'move';
+          col.classList.add('drag-over');
+        });
+        col.addEventListener('dragleave', (e) => {
+          if (!col.contains(e.relatedTarget)) col.classList.remove('drag-over');
+        });
+        col.addEventListener('drop', (e) => {
+          e.preventDefault();
+          col.classList.remove('drag-over');
+          const id = Number(e.dataTransfer.getData('text/plain'));
+          if (!id) return;
+          const list = col.querySelector('.column-cards');
+          moveOrder(id, col.dataset.status, cardAfter(list, e.clientY));
+        });
+      }
+
+      // Button + keyboard moves
+      board.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-move]');
+        if (!btn) return;
+        shift(btn.closest('.card'), Number(btn.dataset.move));
+      });
+
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.target !== card) return;
+        if (e.key === 'ArrowRight') { e.preventDefault(); shift(card, 1); }
+        if (e.key === 'ArrowLeft') { e.preventDefault(); shift(card, -1); }
+      });
+
+      // New orders
+      document.getElementById('order-form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        const form = e.currentTarget;
+        const data = new FormData(form);
+        const customer = String(data.get('customer')).trim();
+        if (!customer) return;
+        const order = { id: nextId++, drink: String(data.get('drink')), customer, status: 'queued' };
+        orders.push(order);
+        columns.queued.querySelector('.column-cards').append(createCard(order));
+        updateCount('queued');
+        save();
+        form.reset();
+        announce(`Order ${order.id} added to Queued`);
+      });
+
+      render();
+    })();
+  </script>
 </body>
 
 </html>
