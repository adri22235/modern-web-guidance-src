diff --git a/board.css b/board.css
new file mode 100644
--- a/board.css
+++ b/board.css
@@ -0,0 +1,209 @@
+/* Barista order board */
+.board-section {
+  margin-bottom: 60px;
+}
+
+.board-header {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: flex-end;
+  gap: 16px;
+  margin-bottom: 20px;
+}
+
+.board-subtitle {
+  font-size: 0.9rem;
+  color: #6d4c41;
+}
+
+.new-order-form {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.new-order-form input,
+.new-order-form select {
+  padding: 8px 10px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  font: inherit;
+  font-size: 0.9rem;
+}
+
+.board-btn {
+  background: var(--primary);
+  color: white;
+  border: none;
+  padding: 8px 16px;
+  border-radius: 5px;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: background 0.3s;
+}
+
+.board-btn:hover,
+.board-btn:focus-visible {
+  background: var(--text);
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.board {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 20px;
+}
+
+@media (max-width: 760px) {
+  .board {
+    grid-template-columns: 1fr;
+  }
+}
+
+.board-column {
+  background: #efebe9;
+  border-radius: 10px;
+  padding: 14px;
+  min-height: 320px;
+  display: flex;
+  flex-direction: column;
+  border-top: 5px solid var(--col-color, var(--primary));
+  transition: background 0.2s, box-shadow 0.2s;
+}
+
+.board-column[data-status="queued"] { --col-color: #8d6e63; }
+.board-column[data-status="brewing"] { --col-color: var(--accent); }
+.board-column[data-status="ready"] { --col-color: #66bb6a; }
+
+.board-column.drag-over {
+  background: #e0d6d2;
+  box-shadow: inset 0 0 0 2px var(--col-color);
+}
+
+.column-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 12px;
+}
+
+.column-header h3 {
+  font-size: 1rem;
+  text-transform: uppercase;
+  letter-spacing: 1px;
+  color: var(--primary);
+}
+
+.column-count {
+  background: var(--col-color);
+  color: white;
+  font-size: 0.8rem;
+  font-weight: bold;
+  border-radius: 999px;
+  min-width: 26px;
+  padding: 1px 8px;
+  text-align: center;
+}
+
+.card-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  flex: 1;
+}
+
+.column-empty {
+  color: #a1887f;
+  font-size: 0.85rem;
+  font-style: italic;
+  text-align: center;
+  padding: 24px 0;
+  border: 2px dashed #d7ccc8;
+  border-radius: 8px;
+}
+
+.card {
+  background: white;
+  border-radius: 8px;
+  padding: 12px 14px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  border-left: 4px solid var(--col-color);
+  cursor: grab;
+  user-select: none;
+  transition: box-shadow 0.2s, opacity 0.2s, transform 0.2s;
+}
+
+.card:hover {
+  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+}
+
+.card:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.card.dragging {
+  opacity: 0.4;
+  cursor: grabbing;
+}
+
+.card.drop-before {
+  box-shadow: 0 -3px 0 var(--col-color), 0 2px 5px rgba(0, 0, 0, 0.1);
+}
+
+.card-top {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.card-drink {
+  font-weight: bold;
+  color: var(--primary);
+}
+
+.card-id {
+  font-size: 0.75rem;
+  color: #a1887f;
+  font-family: monospace;
+}
+
+.card-meta {
+  font-size: 0.85rem;
+  color: #6d4c41;
+}
+
+.card-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 6px;
+  margin-top: 8px;
+}
+
+.card-actions button {
+  background: none;
+  border: 1px solid var(--secondary);
+  border-radius: 4px;
+  padding: 2px 8px;
+  font-size: 0.75rem;
+  color: var(--text);
+  cursor: pointer;
+}
+
+.card-actions button:hover,
+.card-actions button:focus-visible {
+  border-color: var(--primary);
+  background: #fbe9e7;
+}
