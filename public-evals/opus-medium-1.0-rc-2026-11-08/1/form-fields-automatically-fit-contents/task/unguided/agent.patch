+  <script>
+    // Fallback for browsers without `field-sizing: content` support
+    if (!CSS.supports('field-sizing', 'content')) {
+      const measurer = document.createElement('span');
+      measurer.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
+      document.body.appendChild(measurer);
+
+      const textWidth = (el, text) => {
+        measurer.style.font = getComputedStyle(el).font;
+        measurer.textContent = text;
+        return measurer.getBoundingClientRect().width;
+      };
+
+      const chromeWidth = (el) => {
+        const cs = getComputedStyle(el);
+        return ['paddingLeft', 'paddingRight', 'borderLeftWidth', 'borderRightWidth']
+          .reduce((sum, prop) => sum + parseFloat(cs[prop]), 0);
+      };
+
+      const resize = (el) => {
+        if (el.tagName === 'SELECT') {
+          const text = el.options[el.selectedIndex]?.text || '';
+          // Extra room for the dropdown arrow
+          el.style.width = `${textWidth(el, text) + chromeWidth(el) + 28}px`;
+        } else if (el.tagName === 'TEXTAREA') {
+          const lines = (el.value || el.placeholder).split('\n');
+          const widest = Math.max(...lines.map((line) => textWidth(el, line || ' ')));
+          el.style.width = `${widest + chromeWidth(el) + 2}px`;
+          el.style.height = 'auto';
+          el.style.height = `${el.scrollHeight + el.offsetHeight - el.clientHeight}px`;
+        } else {
+          el.style.width = `${textWidth(el, el.value || el.placeholder || ' ') + chromeWidth(el) + 2}px`;
+        }
+      };
+
+      document.querySelectorAll('.auto-size').forEach((el) => {
+        el.style.boxSizing = 'border-box';
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => resize(el));
+        resize(el);
+      });
+    }
+  </script>
