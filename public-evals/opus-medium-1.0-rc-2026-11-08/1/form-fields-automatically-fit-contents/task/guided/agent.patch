+
+    /* Order Form */
+    .order-form-section {
+      margin-top: 60px;
+    }
+
+    .order-form {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      max-width: 640px;
+      margin: 20px auto 0;
+    }
+
+    .order-form .field {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.25rem;
+      margin-bottom: 1.5rem;
+    }
+
+    .order-form label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .order-form .hint {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .order-form input,
+    .order-form textarea,
+    .order-form select {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--text);
+      background: white;
+      padding: 0.6rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #767676;
+      border-radius: 5px;
+      /* Size each control to its content instead of a fixed box */
+      field-sizing: content;
+    }
+
+    .order-form input {
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 100%;
+    }
+
+    .order-form textarea {
+      /* Stable width; height grows with content */
+      width: 100%;
+      height: auto;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+      resize: vertical;
+    }
+
+    .order-form select {
+      max-inline-size: 100%;
+    }
+
+    .order-form input:focus-visible,
+    .order-form textarea:focus-visible,
+    .order-form select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .order-form button {
+      font: inherit;
+      border: none;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
