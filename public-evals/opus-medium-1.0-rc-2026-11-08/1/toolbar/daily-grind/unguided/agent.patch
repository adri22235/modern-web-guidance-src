+  <script>
+    (function () {
+      var toolbar = document.getElementById('favorites-actions');
+      var grid = document.getElementById('favorites-grid');
+      var filters = document.getElementById('favorites-filters');
+      var status = document.getElementById('favorites-status');
+      var buttons = Array.prototype.slice.call(toolbar.querySelectorAll('.icon-btn'));
+      var copyTimer;
+
+      function announce(message) {
+        status.textContent = '';
+        // Defer so repeated identical messages are still announced
+        setTimeout(function () { status.textContent = message; }, 50);
+      }
+
+      // Roving tabindex: the toolbar is a single tab stop, arrow keys move between buttons
+      function focusButton(index) {
+        buttons.forEach(function (btn, i) { btn.tabIndex = i === index ? 0 : -1; });
+        buttons[index].focus();
+      }
+
+      toolbar.addEventListener('keydown', function (e) {
+        var current = buttons.indexOf(document.activeElement);
+        if (current === -1) return;
+        var next;
+        switch (e.key) {
+          case 'ArrowRight': next = (current + 1) % buttons.length; break;
+          case 'ArrowLeft': next = (current - 1 + buttons.length) % buttons.length; break;
+          case 'Home': next = 0; break;
+          case 'End': next = buttons.length - 1; break;
+          default: return;
+        }
+        e.preventDefault();
+        focusButton(next);
+      });
+
+      toolbar.addEventListener('focusin', function (e) {
+        var index = buttons.indexOf(e.target);
+        if (index !== -1) buttons.forEach(function (btn, i) { btn.tabIndex = i === index ? 0 : -1; });
+      });
+
+      function setView(view) {
+        grid.classList.toggle('is-list', view === 'list');
+        toolbar.querySelectorAll('[data-action="view"]').forEach(function (btn) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.view === view));
+        });
+        announce(view === 'list' ? 'Showing drinks as a list' : 'Showing drinks as a grid');
+      }
+
+      function toggleDetails(btn) {
+        var on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(on));
+        grid.classList.toggle('hide-details', !on);
+        announce(on ? 'Drink details shown' : 'Drink details hidden');
+      }
+
+      function toggleFilters(btn) {
+        var on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(on));
+        btn.setAttribute('aria-expanded', String(on));
+        filters.hidden = !on;
+        if (!on) applyFilter('all', true);
+        announce(on ? 'Filters shown' : 'Filters hidden, showing all drinks');
+      }
+
+      function applyFilter(value, silent) {
+        var cards = grid.querySelectorAll('.card');
+        var visible = 0;
+        cards.forEach(function (card) {
+          var show = value === 'all' || card.dataset.temp === value;
+          card.hidden = !show;
+          if (show) visible++;
+        });
+        if (silent) {
+          filters.querySelector('input[value="all"]').checked = true;
+        } else {
+          announce(visible + (visible === 1 ? ' drink' : ' drinks') + ' shown');
+        }
+      }
+
+      function fallbackCopy(text) {
+        var area = document.createElement('textarea');
+        area.value = text;
+        area.setAttribute('readonly', '');
+        area.style.position = 'fixed';
+        area.style.opacity = '0';
+        document.body.appendChild(area);
+        area.select();
+        var ok = false;
+        try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
+        document.body.removeChild(area);
+        return ok ? Promise.resolve() : Promise.reject();
+      }
+
+      function copyList(btn) {
+        var lines = Array.prototype.map.call(grid.querySelectorAll('.card'), function (card) {
+          var title = card.querySelector('h3').textContent.trim();
+          var desc = card.querySelector('p').textContent.trim();
+          return '- ' + title + ': ' + desc;
+        });
+        var text = 'The Daily Grind \u2013 Seasonal Favorites\n' + lines.join('\n');
+        var attempt = navigator.clipboard && window.isSecureContext
+          ? navigator.clipboard.writeText(text).catch(function () { return fallbackCopy(text); })
+          : fallbackCopy(text);
+
+        attempt.then(function () {
+          btn.classList.add('is-copied');
+          btn.dataset.tooltip = 'Copied!';
+          announce('Featured drinks list copied to clipboard');
+          clearTimeout(copyTimer);
+          copyTimer = setTimeout(function () {
+            btn.classList.remove('is-copied');
+            btn.dataset.tooltip = 'Copy list';
+          }, 2000);
+        }, function () {
+          announce('Unable to copy the drinks list');
+        });
+      }
+
+      toolbar.addEventListener('click', function (e) {
+        var btn = e.target.closest('.icon-btn');
+        if (!btn) return;
+        switch (btn.dataset.action) {
+          case 'view': setView(btn.dataset.view); break;
+          case 'details': toggleDetails(btn); break;
+          case 'filters': toggleFilters(btn); break;
+          case 'copy': copyList(btn); break;
+        }
+      });
+
+      filters.addEventListener('change', function (e) {
+        if (e.target.name === 'favorites-temp') applyFilter(e.target.value);
+      });
+    })();
+  </script>
+
 </body>
 
