+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const filters = document.getElementById('favorites-filters');
+      const status = document.querySelector('.favorites-status');
+      const items = [...bar.querySelectorAll('button')];
+      const viewButtons = items.filter((b) => b.dataset.view);
+
+      // Layout: mutually exclusive grid/list toggles
+      viewButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
+          grid.dataset.view = button.dataset.view;
+        });
+      });
+
+      // Display: independent on/off toggles for details and filters
+      const applyFilter = (value) => {
+        grid.querySelectorAll('.card').forEach((card) => {
+          card.hidden = value !== 'all' && card.dataset.temp !== value;
+        });
+      };
+
+      filters.addEventListener('change', (event) => applyFilter(event.target.value));
+
+      bar.querySelectorAll('[data-toggle]').forEach((button) => {
+        button.addEventListener('click', () => {
+          const on = button.getAttribute('aria-pressed') !== 'true';
+          button.setAttribute('aria-pressed', String(on));
+          if (button.dataset.toggle === 'details') {
+            grid.dataset.details = on ? 'on' : 'off';
+          } else {
+            filters.hidden = !on;
+            // Hiding the filters clears them so no drinks stay hidden unexpectedly
+            if (!on) {
+              filters.querySelector('[value="all"]').checked = true;
+              applyFilter('all');
+            }
+          }
+        });
+      });
+
+      // Share: copy the featured drinks list
+      let timer;
+      let lastMessage = '';
+
+      const report = (button, ok) => {
+        clearTimeout(timer);
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        let message = ok ? 'List copied' : 'Copy failed';
+        // VoiceOver skips a repeated identical message
+        if (message === lastMessage) message += '\u00A0';
+        lastMessage = message;
+        status.textContent = '';
+        requestAnimationFrame(() => (status.textContent = message));
+        timer = setTimeout(() => {
+          button.removeAttribute('data-copied');
+          button.removeAttribute('data-failed');
+          status.textContent = '';
+        }, 2000);
+      };
+
+      const copy = async (button, target) => {
+        const text = [...target.querySelectorAll('.card')]
+          .map((card) => `${card.querySelector('h3').innerText.trim()} - ${card.querySelector('p').textContent.trim()}`)
+          .join('\n');
+        try {
+          await navigator.clipboard.writeText(`The Daily Grind - Seasonal Favorites\n${text}`);
+          report(button, true);
+        } catch {
+          report(button, false);
+        }
+      };
+
+      if ('CommandEvent' in window) {
+        // `command` events do not bubble: listen in the capture phase
+        document.addEventListener('command', (event) => {
+          if (event.command === '--copy' && bar.contains(event.source)) copy(event.source, event.target);
+        }, true);
+      } else {
+        bar.addEventListener('click', (event) => {
+          const button = event.target.closest('button[command="--copy"]');
+          if (button) copy(button, document.getElementById(button.getAttribute('commandfor')));
+        });
+      }
+
+      // Roving tabindex fallback where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (event) => {
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          const current = items.indexOf(document.activeElement);
+          let next;
+          if (event.key in steps) next = (current + steps[event.key] + items.length) % items.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = items.length - 1;
+          else return;
+          event.preventDefault();
+          items[next].focus();
+        });
+      }
+
+      // Upgrade title tooltips to hint popovers where interest invokers and anchor positioning work
+      if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+        items.forEach((b, i) => {
+          const tip = Object.assign(document.createElement('div'), { id: `favorites-tip-${i}`, textContent: b.title });
+          tip.popover = 'hint';
+          b.setAttribute('interestfor', tip.id);
+          b.removeAttribute('title');
+          document.body.append(tip);
+        });
+      }
+    })();
+  </script>
+
 </body>
 
