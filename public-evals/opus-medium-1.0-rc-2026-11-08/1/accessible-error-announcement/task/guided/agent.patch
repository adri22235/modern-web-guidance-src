+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const status = form.querySelector('.newsletter-status');
+
+      const messageFor = (el) =>
+        el.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.';
+
+      // Mirror the visual :user-invalid state into aria-invalid and the live
+      // region, so screen readers hear the error only when it becomes visible
+      // and it is cleared the moment the email becomes valid.
+      const syncError = () => {
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+          const text = messageFor(input);
+          // Only touch the live region when the message changes to avoid repeat announcements
+          if (error.textContent !== text) error.textContent = text;
+        } else {
+          input.removeAttribute('aria-invalid');
+          error.textContent = '';
+        }
+      };
+
+      input.addEventListener('blur', syncError);
+      input.addEventListener('change', syncError);
+      input.addEventListener('input', () => {
+        status.textContent = '';
+        // While an error is showing, re-check on every keystroke so it clears immediately
+        if (input.getAttribute('aria-invalid') === 'true') syncError();
+      });
+
+      // Submitting with an invalid value marks the field user-invalid. Suppress the
+      // native bubble (our inline message replaces it) and move focus to the field.
+      input.addEventListener('invalid', (event) => {
+        event.preventDefault();
+        syncError();
+        input.focus();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        syncError();
+      });
+    })();
+  </script>
