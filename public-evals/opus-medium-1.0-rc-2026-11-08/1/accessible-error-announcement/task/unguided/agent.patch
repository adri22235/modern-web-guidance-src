+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var status = document.getElementById('newsletter-status');
+      // Errors are only shown after the user has interacted (blurred a
+      // non-empty field or attempted to submit).
+      var touched = false;
+
+      function getError() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: visual error text, aria-invalid,
+      // aria-describedby and the live-region announcement all change together.
+      function render() {
+        var message = touched ? getError() : '';
+        // Only touch the live region when the message actually changes so
+        // repeated keystrokes don't trigger repeated announcements.
+        if (error.textContent !== message) error.textContent = message;
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+          input.setAttribute('aria-describedby', error.id);
+        } else {
+          input.setAttribute('aria-invalid', 'false');
+          input.removeAttribute('aria-describedby');
+        }
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        if (input.value.trim()) touched = true;
+        render();
+      });
+
+      input.addEventListener('input', function () {
+        status.textContent = '';
+        render();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        // No backend is wired up for this static page; confirm and reset.
+        status.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        touched = false;
+        render();
+      });
+    })();
+  </script>
+
