+  <script>
+    // WebMCP: expose a client-side tool so in-browser AI assistants can look up menu items.
+    (function () {
+      const MENU_ITEMS = [
+        {
+          name: 'Maple Oat Latte',
+          aliases: ['maple latte', 'oat latte'],
+          category: 'Seasonal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          ingredients: ['Espresso', 'Oat milk', 'Vermont maple syrup'],
+          sizes: { small: 4.75, medium: 5.25, large: 5.75 },
+          caffeine: 'Medium (double shot)',
+          dietary: ['Dairy-free', 'Vegan'],
+          temperature: ['Hot', 'Iced'],
+          url: '/menu/seasonal'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          aliases: ['espresso', 'dark roast'],
+          category: 'Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          ingredients: ['Dark roast espresso beans'],
+          sizes: { single: 2.75, double: 3.5 },
+          caffeine: 'High',
+          dietary: ['Dairy-free', 'Vegan', 'Sugar-free'],
+          temperature: ['Hot'],
+          url: '/menu/espresso'
+        },
+        {
+          name: 'Cold Brew',
+          aliases: ['coldbrew', 'cold brew coffee'],
+          category: 'Cold Drinks',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          ingredients: ['Coarse-ground coffee', 'Filtered water'],
+          sizes: { small: 4.0, medium: 4.5, large: 5.0 },
+          caffeine: 'High',
+          dietary: ['Dairy-free', 'Vegan', 'Sugar-free'],
+          temperature: ['Iced'],
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      const TOOL_NAME = 'get_menu_item_details';
+
+      const normalize = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+      function findMenuItem(query) {
+        const q = normalize(query);
+        if (!q) return null;
+        const keys = (item) => [item.name, ...item.aliases].map(normalize);
+        return (
+          MENU_ITEMS.find((item) => keys(item).includes(q)) ||
+          MENU_ITEMS.find((item) => keys(item).some((k) => k.includes(q) || q.includes(k))) ||
+          null
+        );
+      }
+
+      const textResult = (data, isError = false) => ({
+        content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+        ...(isError && { isError: true })
+      });
+
+      const tool = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item at The Daily Grind coffee shop by its name. ' +
+          'Returns the item\'s category, description, ingredients, size options with prices (USD), ' +
+          'caffeine level, dietary info, available temperatures, and a link to its menu page. ' +
+          'Matching is case-insensitive and tolerates partial names (e.g. "cold brew", "espresso"). ' +
+          'Available items: ' + MENU_ITEMS.map((i) => i.name).join(', ') + '.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up, e.g. "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew".'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        async execute({ name } = {}) {
+          if (typeof name !== 'string' || !name.trim()) {
+            return textResult('Please provide the name of a menu item to look up.', true);
+          }
+          const item = findMenuItem(name);
+          if (!item) {
+            return textResult(
+              `No menu item found matching "${name}". Available items: ` +
+                MENU_ITEMS.map((i) => i.name).join(', ') + '.',
+              true
+            );
+          }
+          const { aliases, url, ...details } = item;
+          return textResult({ ...details, url: new URL(url, location.origin).href });
+        }
+      };
+
+      let controller = null;
+      let registration = null;
+
+      function registerTool() {
+        const modelContext = navigator.modelContext;
+        if (!modelContext || typeof modelContext.registerTool !== 'function' || controller) return;
+        controller = new AbortController();
+        try {
+          // Newer spec unregisters via AbortSignal; older drafts return a handle with unregister().
+          registration = modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (err) {
+          controller = null;
+          console.warn(`Failed to register WebMCP tool "${TOOL_NAME}":`, err);
+        }
+      }
+
+      function unregisterTool() {
+        if (!controller) return;
+        controller.abort();
+        try {
+          if (registration && typeof registration.unregister === 'function') {
+            registration.unregister();
+          } else if (typeof navigator.modelContext?.unregisterTool === 'function') {
+            navigator.modelContext.unregisterTool(TOOL_NAME);
+          }
+        } catch (_) {
+          // Already unregistered (e.g. via the abort signal).
+        }
+        controller = null;
+        registration = null;
+      }
+
+      registerTool();
+      // pagehide fires reliably on unload and when entering the back/forward cache;
+      // pageshow re-registers if the page is restored from that cache.
+      window.addEventListener('pagehide', unregisterTool);
+      window.addEventListener('pageshow', (e) => { if (e.persisted) registerTool(); });
+    })();
+  </script>
+
 </body>
 
 </html>
