+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <strong class="toast-title"></strong>
+      <span class="toast-message"></span>
+      <button type="button" class="toast-close" popovertargetaction="hide" aria-label="Dismiss notification">&times;</button>
+    </div>
+  </template>
+
+  <div id="toast-announcer" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script type="module">
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const TOAST_DURATION = 5000;
+    const TOAST_GAP = 12;
+    const MAX_TOASTS = 4;
+    const LEAVE_MS = 300;
+
+    const template = document.getElementById("toast-template");
+    const announcer = document.getElementById("toast-announcer");
+    const toasts = [];
+    let toastId = 0;
+
+    // Newest toast sits at the bottom; older ones are pushed upward.
+    function restack() {
+      let offset = 0;
+      for (let i = toasts.length - 1; i >= 0; i--) {
+        toasts[i].el.style.setProperty("--toast-offset", `${offset}px`);
+        offset += toasts[i].el.offsetHeight + TOAST_GAP;
+      }
+    }
+
+    function startTimer(toast) {
+      clearTimeout(toast.timer);
+      toast.timer = setTimeout(() => dismiss(toast), TOAST_DURATION);
+    }
+
+    function dismiss(toast) {
+      if (toast.leaving) return;
+      toast.leaving = true;
+      clearTimeout(toast.timer);
+      toasts.splice(toasts.indexOf(toast), 1);
+      restack();
+      toast.el.classList.add("is-leaving");
+      setTimeout(() => {
+        if (toast.el.matches(":is(:popover-open, .\\:popover-open)")) toast.el.hidePopover();
+        toast.el.remove();
+      }, LEAVE_MS);
+    }
+
+    function showToast({ title = "", message = "", type = "info" }) {
+      const el = template.content.firstElementChild.cloneNode(true);
+      const id = `toast-${++toastId}`;
+      el.id = id;
+      el.dataset.type = type;
+      el.querySelector(".toast-title").textContent = title;
+      el.querySelector(".toast-message").textContent = message;
+      if (!title) el.querySelector(".toast-title").remove();
+
+      const close = el.querySelector(".toast-close");
+      close.setAttribute("popovertarget", id);
+
+      const toast = { el, timer: 0, leaving: false };
+
+      // Animate out instead of the instant native hide.
+      close.addEventListener("click", (event) => {
+        event.preventDefault();
+        dismiss(toast);
+      });
+
+      // Pause auto-dismiss while the user is hovering or focused on the toast.
+      el.addEventListener("pointerenter", () => clearTimeout(toast.timer));
+      el.addEventListener("pointerleave", () => !toast.leaving && startTimer(toast));
+      el.addEventListener("focusin", () => clearTimeout(toast.timer));
+      el.addEventListener("focusout", () => !toast.leaving && startTimer(toast));
+
+      document.body.append(el);
+      el.showPopover();
+      toasts.push(toast);
+      restack();
+      startTimer(toast);
+
+      announcer.textContent = "";
+      requestAnimationFrame(() => {
+        announcer.textContent = [title, message].filter(Boolean).join(": ");
+      });
+
+      while (toasts.length > MAX_TOASTS) dismiss(toasts[0]);
+      return toast;
+    }
+
+    document.addEventListener("click", (event) => {
+      const trigger = event.target.closest(".toast-trigger");
+      if (!trigger) return;
+      const { toastTitle, toastMessage, toastType } = trigger.dataset;
+      showToast({ title: toastTitle, message: toastMessage, type: toastType });
+    });
+
+    window.addEventListener("resize", restack);
+    window.showToast = showToast;
+  </script>
+
