+  <div class="toast-region" aria-live="polite" aria-atomic="false"></div>
+
+  <script>
+    (function () {
+      var region = document.querySelector('.toast-region');
+      var MAX_TOASTS = 4;
+      var DEFAULT_DURATION = 4000;
+
+      function dismiss(toast) {
+        if (toast.classList.contains('is-leaving')) return;
+        clearTimeout(toast._timer);
+        toast.classList.add('is-leaving');
+        toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
+      }
+
+      function startTimer(toast) {
+        clearTimeout(toast._timer);
+        toast._started = Date.now();
+        toast._timer = setTimeout(function () { dismiss(toast); }, toast._remaining);
+      }
+
+      function pauseTimer(toast) {
+        clearTimeout(toast._timer);
+        toast._remaining -= Date.now() - toast._started;
+      }
+
+      function showToast(opts) {
+        var duration = opts.duration || DEFAULT_DURATION;
+        var toast = document.createElement('div');
+        toast.className = 'toast' + (opts.type ? ' toast-' + opts.type : '');
+        toast.setAttribute('role', opts.type === 'warning' ? 'alert' : 'status');
+
+        var body = document.createElement('div');
+        body.className = 'toast-body';
+        if (opts.title) {
+          var title = document.createElement('strong');
+          title.className = 'toast-title';
+          title.textContent = opts.title;
+          body.appendChild(title);
+        }
+        body.appendChild(document.createTextNode(opts.message || ''));
+
+        var close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Dismiss notification');
+        close.innerHTML = '&times;';
+        close.addEventListener('click', function () { dismiss(toast); });
+
+        var progress = document.createElement('div');
+        progress.className = 'toast-progress';
+        progress.style.animationDuration = duration + 'ms';
+
+        toast.append(body, close, progress);
+
+        toast._remaining = duration;
+        toast.addEventListener('mouseenter', function () { pauseTimer(toast); });
+        toast.addEventListener('mouseleave', function () { startTimer(toast); });
+        toast.addEventListener('focusin', function () { pauseTimer(toast); });
+        toast.addEventListener('focusout', function (e) {
+          if (!toast.contains(e.relatedTarget)) startTimer(toast);
+        });
+
+        region.appendChild(toast);
+
+        // Keep the stack bounded: drop the oldest toasts first
+        var active = region.querySelectorAll('.toast:not(.is-leaving)');
+        for (var i = 0; i < active.length - MAX_TOASTS; i++) dismiss(active[i]);
+
+        startTimer(toast);
+        return toast;
+      }
+
+      document.addEventListener('click', function (e) {
+        var trigger = e.target.closest('.toast-trigger');
+        if (!trigger) return;
+        showToast({
+          title: trigger.dataset.toastTitle,
+          message: trigger.dataset.toastMessage || trigger.textContent.trim(),
+          type: trigger.dataset.toastType,
+          duration: parseInt(trigger.dataset.toastDuration, 10) || undefined
+        });
+      });
+
+      window.showToast = showToast;
+    })();
+  </script>
+
