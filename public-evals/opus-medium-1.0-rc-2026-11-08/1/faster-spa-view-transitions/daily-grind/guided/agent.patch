+  <script>
+    (() => {
+      const viewsRoot = document.getElementById('views');
+      // route -> view element; views stay in the DOM once created (small, fixed set of routes)
+      const views = new Map([['/', document.getElementById('view-home')]]);
+      const scrollPositions = new Map();
+      const templates = new Map(
+        [...document.querySelectorAll('template[data-route]')].map(t => [t.dataset.route, t])
+      );
+      const navLinks = document.querySelectorAll('a[data-view-link]');
+      let current = null;
+
+      const normalize = path => (path.length > 1 ? path.replace(/\/+$/, '') : path);
+
+      function getView(route) {
+        if (views.has(route)) return views.get(route);
+        const tpl = templates.get(route);
+        if (!tpl) return null;
+        const view = document.createElement('div');
+        view.className = 'spa-view inactive';
+        view.id = `view-${route.slice(1)}`;
+        view.tabIndex = -1;
+        view.dataset.route = route;
+        view.dataset.title = tpl.dataset.title;
+        view.setAttribute('aria-hidden', 'true');
+        view.inert = true;
+        view.append(tpl.content.cloneNode(true));
+        viewsRoot.append(view);
+        initView[route]?.(view);
+        views.set(route, view);
+        return view;
+      }
+
+      function show(route, { focus = true, restoreScroll = false } = {}) {
+        const target = getView(route) ?? views.get('/');
+        if (target === current) return;
+
+        if (current) {
+          scrollPositions.set(current.dataset.route, window.scrollY);
+          current.classList.add('inactive');
+          current.setAttribute('aria-hidden', 'true');
+          current.inert = true;
+        }
+
+        target.classList.remove('inactive');
+        target.setAttribute('aria-hidden', 'false');
+        target.inert = false;
+        current = target;
+
+        document.title = target.dataset.title;
+        navLinks.forEach(link => {
+          if (normalize(new URL(link.href).pathname) === target.dataset.route) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        window.scrollTo(0, restoreScroll ? scrollPositions.get(target.dataset.route) ?? 0 : 0);
+        if (focus) target.focus({ preventScroll: true });
+      }
+
+      document.addEventListener('click', event => {
+        const link = event.target.closest('a[data-view-link]');
+        if (!link || event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        const route = normalize(new URL(link.href).pathname);
+        if (!views.has(route) && !templates.has(route)) return;
+        event.preventDefault();
+        if (route !== normalize(location.pathname)) history.pushState({ route }, '', route);
+        show(route);
+      });
+
+      window.addEventListener('popstate', () => {
+        show(normalize(location.pathname), { restoreScroll: true });
+      });
+
+      history.scrollRestoration = 'manual';
+
+      // Per-view behavior, wired up once when the view is first created
+      const initView = {
+        '/menu'(view) {
+          const buttons = view.querySelectorAll('[data-filter]');
+          view.querySelector('.filters').addEventListener('click', event => {
+            const button = event.target.closest('[data-filter]');
+            if (!button) return;
+            const filter = button.dataset.filter;
+            buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
+            view.querySelectorAll('[data-category]').forEach(card => {
+              card.hidden = filter !== 'all' && card.dataset.category !== filter;
+            });
+          });
+        },
+        '/locations'(view) {
+          view.querySelector('#location-search').addEventListener('input', event => {
+            const query = event.target.value.trim().toLowerCase();
+            view.querySelectorAll('[data-location]').forEach(card => {
+              card.hidden = query !== '' && !card.dataset.location.includes(query);
+            });
+          });
+        },
+        '/rewards'(view) {
+          let beans = 140;
+          const count = view.querySelector('[data-beans]');
+          const progress = view.querySelector('[data-beans-progress]');
+          const status = view.querySelector('[data-rewards-status]');
+          view.addEventListener('click', event => {
+            const button = event.target.closest('[data-redeem]');
+            if (!button) return;
+            const cost = Number(button.dataset.redeem);
+            if (beans < cost) {
+              status.textContent = `You need ${cost - beans} more beans for that reward.`;
+              return;
+            }
+            beans -= cost;
+            count.textContent = beans;
+            progress.value = beans;
+            status.textContent = `Redeemed! Show this screen at the counter. ${beans} beans remaining.`;
+          });
+        },
+        '/account'(view) {
+          const status = view.querySelector('[data-account-status]');
+          view.querySelector('[data-account-form]').addEventListener('submit', event => {
+            event.preventDefault();
+            status.textContent = 'Your changes have been saved.';
+          });
+        },
+      };
+
+      show(normalize(location.pathname), { focus: false });
+      history.replaceState({ route: current.dataset.route }, '', location.href);
+    })();
+  </script>
 </body>
 
