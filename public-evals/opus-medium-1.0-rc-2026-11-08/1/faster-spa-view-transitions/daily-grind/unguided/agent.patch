+            </select>
+          </label>
+          <button class="btn" type="submit">Save Changes</button>
+          <p class="status" role="status" data-profile-status></p>
+        </form>
+        <div class="card left">
+          <h3>Recent Orders</h3>
+          <table>
+            <thead><tr><th>Date</th><th>Items</th><th>Total</th></tr></thead>
+            <tbody>
+              <tr><td>Nov 7</td><td>Maple Oat Latte, Croissant</td><td>$9.25</td></tr>
+              <tr><td>Nov 4</td><td>Cold Brew</td><td>$4.75</td></tr>
+              <tr><td>Oct 30</td><td>Dark Roast Espresso ×2</td><td>$7.00</td></tr>
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </main>
