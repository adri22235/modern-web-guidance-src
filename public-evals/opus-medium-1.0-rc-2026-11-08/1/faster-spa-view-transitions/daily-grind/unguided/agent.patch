+
+  <script>
+    (function () {
+      const app = document.getElementById('app');
+      const BASE_TITLE = 'The Daily Grind';
+
+      // Route table. `init` runs once when a view is first mounted; the
+      // resulting DOM is then kept alive for the rest of the session.
+      const routes = {
+        home: { title: BASE_TITLE + ' | Artisanal Coffee' },
+        menu: { title: 'Menu | ' + BASE_TITLE, template: 'tpl-menu', init: initMenu },
+        locations: { title: 'Locations | ' + BASE_TITLE, template: 'tpl-locations', init: initLocations },
+        rewards: { title: 'Rewards | ' + BASE_TITLE, template: 'tpl-rewards', init: initRewards },
+        account: { title: 'My Account | ' + BASE_TITLE, template: 'tpl-account', init: initAccount }
+      };
+
+      const mounted = new Map([['home', document.getElementById('view-home')]]);
+      const scrollPositions = new Map();
+      let current = null;
+
+      function getView(name) {
+        let view = mounted.get(name);
+        if (view) return view;
+        const route = routes[name];
+        view = document.createElement('div');
+        view.className = 'view';
+        view.id = 'view-' + name;
+        view.dataset.view = name;
+        view.tabIndex = -1;
+        view.appendChild(document.getElementById(route.template).content.cloneNode(true));
+        app.appendChild(view);
+        route.init(view);
+        mounted.set(name, view);
+        return view;
+      }
+
+      function routeFromHash() {
+        const name = location.hash.replace(/^#\/?/, '').split(/[/?]/)[0];
+        return routes[name] ? name : 'home';
+      }
+
+      function show(name) {
+        if (name === current) return;
+        if (current) scrollPositions.set(current, window.scrollY);
+
+        const next = getView(name);
+        mounted.forEach((view, key) => {
+          const active = key === name;
+          view.toggleAttribute('data-inactive', !active);
+          view.inert = !active;
+        });
+
+        document.querySelectorAll('nav a[data-route]').forEach(a => {
+          const active = a.dataset.route === name;
+          a.classList.toggle('active', active && a.dataset.route !== 'home');
+          if (active) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        document.title = routes[name].title;
+        const isFirstRoute = current === null;
+        current = name;
+
+        if (!isFirstRoute) {
+          window.scrollTo(0, scrollPositions.get(name) || 0);
+          next.focus({ preventScroll: true });
+        }
+      }
+
+      // Hash-based routing keeps deep links working on a plain static server.
+      window.addEventListener('hashchange', () => show(routeFromHash()));
+      show(routeFromHash());
+
+      // Prefetch: mount remaining views during idle time so even the first
+      // visit is a cheap visibility toggle.
+      const idle = window.requestIdleCallback || (cb => setTimeout(cb, 200));
+      idle(() => Object.keys(routes).forEach(name => {
+        if (!mounted.has(name)) {
+          getView(name).toggleAttribute('data-inactive', true);
+          mounted.get(name).inert = true;
+        }
+      }));
+
+      // ---- View initializers ----
+
+      function initMenu(view) {
+        const items = [
+          { name: 'Maple Oat Latte', cat: 'espresso', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', price: 5.75 },
+          { name: 'Dark Roast Espresso', cat: 'espresso', desc: 'Bold, smokey, and perfect for a morning boost.', price: 3.50 },
+          { name: 'Flat White', cat: 'espresso', desc: 'Velvety microfoam over a double ristretto.', price: 4.75 },
+          { name: 'Cold Brew', cat: 'cold', desc: 'Steeped for 18 hours for maximum smoothness.', price: 4.75 },
+          { name: 'Iced Mocha', cat: 'cold', desc: 'Espresso, dark chocolate, and cold milk over ice.', price: 5.50 },
+          { name: 'Matcha Latte', cat: 'tea', desc: 'Ceremonial-grade matcha whisked with steamed milk.', price: 5.25 },
+          { name: 'Chai Latte', cat: 'tea', desc: 'House-spiced black tea concentrate.', price: 4.95 },
+          { name: 'Butter Croissant', cat: 'bakery', desc: 'Flaky, golden, baked fresh every morning.', price: 3.50 },
+          { name: 'Blueberry Muffin', cat: 'bakery', desc: 'Bursting with wild Maine blueberries.', price: 3.25 }
+        ];
+        const grid = view.querySelector('[data-menu-grid]');
+        grid.innerHTML = items.map(i => `
+          <div class="card" data-cat="${i.cat}">
+            <h3>${i.name}</h3>
+            <p>${i.desc}</p>
+            <p class="price">$${i.price.toFixed(2)}</p>
+          </div>`).join('');
+
+        view.querySelector('.tabs').addEventListener('click', e => {
+          const tab = e.target.closest('[data-filter]');
+          if (!tab) return;
+          const filter = tab.dataset.filter;
+          view.querySelectorAll('[data-filter]').forEach(t => t.setAttribute('aria-pressed', String(t === tab)));
+          grid.querySelectorAll('.card').forEach(c => { c.hidden = filter !== 'all' && c.dataset.cat !== filter; });
+        });
+      }
+
+      function initLocations(view) {
+        const locations = [
+          { name: 'Downtown Flagship', address: '120 Main St', hours: 'Mon–Sun 6am–9pm' },
+          { name: 'Riverside', address: '45 River Rd', hours: 'Mon–Fri 6am–6pm' },
+          { name: 'University District', address: '800 College Ave', hours: 'Mon–Sun 7am–11pm' },
+          { name: 'Old Town', address: '12 Market Square', hours: 'Mon–Sat 7am–7pm' },
+          { name: 'Airport Terminal B', address: 'Gate B14', hours: 'Daily 5am–10pm' },
+          { name: 'Westside Mall', address: '3300 West Blvd', hours: 'Mon–Sun 9am–9pm' }
+        ];
+        const grid = view.querySelector('[data-location-grid]');
+        const empty = view.querySelector('[data-location-empty]');
+        grid.innerHTML = locations.map(l => `
+          <div class="card" data-search="${(l.name + ' ' + l.address).toLowerCase()}">
+            <h3>${l.name}</h3>
+            <p>${l.address}</p>
+            <p class="muted">${l.hours}</p>
+          </div>`).join('');
+
+        view.querySelector('[data-location-search]').addEventListener('input', e => {
+          const q = e.target.value.trim().toLowerCase();
+          let visible = 0;
+          grid.querySelectorAll('.card').forEach(c => {
+            c.hidden = !c.dataset.search.includes(q);
+            if (!c.hidden) visible++;
+          });
+          empty.hidden = visible > 0;
+        });
+      }
+
+      function initRewards(view) {
+        let stars = 340;
+        const rewards = [
+          { name: 'Extra Shot or Syrup', cost: 50 },
+          { name: 'Bakery Item', cost: 150 },
+          { name: 'Any Handcrafted Drink', cost: 250 },
+          { name: 'Bag of Whole Beans', cost: 500 }
+        ];
+        const grid = view.querySelector('[data-reward-grid]');
+        const status = view.querySelector('[data-reward-status]');
+        grid.innerHTML = rewards.map((r, i) => `
+          <div class="card">
+            <h3>${r.name}</h3>
+            <p class="muted">${r.cost} stars</p>
+            <button class="btn" type="button" data-reward="${i}">Redeem</button>
+          </div>`).join('');
+
+        function render() {
+          view.querySelector('[data-stars]').textContent = stars;
+          const next = rewards.find(r => r.cost > stars);
+          view.querySelector('[data-progress]').style.width = next ? (stars / next.cost * 100) + '%' : '100%';
+          view.querySelector('[data-next-reward]').textContent = next
+            ? `${next.cost - stars} stars until ${next.name}`
+            : 'You can redeem any reward!';
+          grid.querySelectorAll('[data-reward]').forEach(b => { b.disabled = rewards[b.dataset.reward].cost > stars; });
+        }
+
+        grid.addEventListener('click', e => {
+          const btn = e.target.closest('[data-reward]');
+          if (!btn) return;
+          const reward = rewards[btn.dataset.reward];
+          if (reward.cost > stars) return;
+          stars -= reward.cost;
+          status.textContent = `Redeemed: ${reward.name}. Show this at the counter!`;
+          render();
+        });
+        render();
+      }
+
+      function initAccount(view) {
+        const form = view.querySelector('[data-profile-form]');
+        const status = view.querySelector('[data-profile-status]');
+        form.addEventListener('input', () => { status.textContent = 'Unsaved changes'; });
+        form.addEventListener('submit', e => {
+          e.preventDefault();
+          status.textContent = 'Profile saved.';
+        });
+      }
+    })();
+  </script>
+
 </body>
 
