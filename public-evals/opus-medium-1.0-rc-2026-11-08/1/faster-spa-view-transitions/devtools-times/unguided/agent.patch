+import { getCollection, type CollectionEntry, type RenderResult } from 'astro:content';
+
+// Article slices shared by the Top News, World and Politics views.
+export async function getSectionArticles() {
+    const articles = await getCollection('articles');
+    articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
