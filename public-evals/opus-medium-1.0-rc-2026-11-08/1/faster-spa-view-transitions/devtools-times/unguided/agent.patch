+---
+import { getSection, type SectionId } from '../../utils/sections';
+import TopNewsView from './TopNewsView.astro';
+import WorldView from './WorldView.astro';
+import PoliticsView from './PoliticsView.astro';
+import MultimediaView from './MultimediaView.astro';
+import ReportsView from './ReportsView.astro';
+
+export interface Props {
+    id: SectionId;
+}
+
+const { id } = Astro.props;
+const section = getSection(id)!;
+---
+<div
+    data-section-view={section.id}
+    data-section-title={section.title}
+    role="tabpanel"
+    id={`section-view-${section.id}`}
+    aria-labelledby={`section-tab-${section.id}`}
+>
+    {id === 'top-news' && <TopNewsView />}
+    {id === 'world' && <WorldView />}
+    {id === 'politics' && <PoliticsView />}
+    {id === 'multimedia' && <MultimediaView />}
+    {id === 'reports' && <ReportsView />}
+</div>
