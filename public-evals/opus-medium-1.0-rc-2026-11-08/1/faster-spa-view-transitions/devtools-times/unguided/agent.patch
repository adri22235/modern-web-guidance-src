diff --git a/src/components/sections/SectionPage.astro b/src/components/sections/SectionPage.astro
new file mode 100644
index 0000000..b429f25
--- /dev/null
+++ b/src/components/sections/SectionPage.astro
@@ -0,0 +1,55 @@
+---
+import Layout from '../../layouts/Layout.astro';
+import SectionView from './SectionView.astro';
+import { SECTIONS, getSection, type SectionId } from '../../utils/sections';
+
+export interface Props {
+    active: SectionId;
+}
+
+const { active } = Astro.props;
+const section = getSection(active)!;
+const baseUrl = import.meta.env.BASE_URL;
+---
+<Layout title={section.title}>
+    <div data-section-shell data-base-url={baseUrl}>
+        <nav
+            class="sticky top-0 z-20 bg-white border-b border-gray-300"
+            aria-label="Sections"
+        >
+            <ul
+                role="tablist"
+                class="max-w-6xl mx-auto px-4 flex justify-center items-center gap-x-6 h-11 text-sm font-semibold overflow-x-auto"
+            >
+                {SECTIONS.map(item => (
+                    <li role="presentation">
+                        <a
+                            href={`${baseUrl}${item.path}`}
+                            role="tab"
+                            id={`section-tab-${item.id}`}
+                            aria-controls={`section-view-${item.id}`}
+                            aria-selected={item.id === active ? 'true' : 'false'}
+                            aria-current={item.id === active ? 'page' : undefined}
+                            data-section-link={item.id}
+                            data-astro-reload
+                            class="block py-2 whitespace-nowrap border-b-2 border-transparent hover:text-gray-600 aria-[current=page]:border-amber-400 aria-[current=page]:text-amber-700"
+                        >
+                            {item.label}
+                        </a>
+                    </li>
+                ))}
+            </ul>
+        </nav>
+
+        <!-- Visited views stay mounted here (hidden when inactive) so switching back is instant. -->
+        <div data-section-views>
+            <SectionView id={active} />
+        </div>
+    </div>
+</Layout>
+
+<script>
+    import { initSectionViews } from '../../scripts/section-views';
+
+    initSectionViews();
+</script>
