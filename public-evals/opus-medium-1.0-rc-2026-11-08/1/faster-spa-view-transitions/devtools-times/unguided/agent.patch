diff --git a/src/scripts/section-views.ts b/src/scripts/section-views.ts
new file mode 100644
index 0000000..512a754
--- /dev/null
+++ b/src/scripts/section-views.ts
@@ -0,0 +1,215 @@
+// Client-side router for the main section views (Top News, World, Politics,
+// Multimedia, Reports).
+//
+// Instead of letting Astro's <ClientRouter /> fetch and swap the whole page on
+// every section switch, the views are managed as SPA views inside
+// <SectionPage />: a view is fetched once as an HTML fragment (/views/<id>),
+// and afterwards stays mounted offscreen (hidden + inert) so returning to it is
+// instant and keeps its DOM state (hydrated islands, bookmarks, scroll offset).
+//
+// Navigations to anything that isn't a section view are left to Astro.
+
+import { SECTIONS, getSection, type SectionId } from '../utils/sections';
+
+interface ShellState {
+    root: HTMLElement;
+    container: HTMLElement;
+    baseUrl: string;
+    active: SectionId;
+    views: Map<SectionId, HTMLElement>;
+    pending: Map<SectionId, Promise<HTMLElement>>;
+    scrollPositions: Map<SectionId, number>;
+    navigationId: number;
+}
+
+let shell: ShellState | null = null;
+let initialized = false;
+
+export function initSectionViews() {
+    if (initialized) return;
+    initialized = true;
+
+    // Capture phase so we run before Astro's ClientRouter listeners and can
+    // take over section navigations.
+    document.addEventListener('click', onClick, true);
+    window.addEventListener('popstate', onPopState, true);
+    document.addEventListener('astro:page-load', setupShell);
+    setupShell();
+}
+
+function setupShell() {
+    const root = document.querySelector<HTMLElement>('[data-section-shell]');
+    if (!root) {
+        shell = null;
+        return;
+    }
+    if (shell?.root === root) return;
+
+    const container = root.querySelector<HTMLElement>('[data-section-views]')!;
+    const initialView = container.querySelector<HTMLElement>('[data-section-view]')!;
+    const active = initialView.dataset.sectionView as SectionId;
+
+    shell = {
+        root,
+        container,
+        baseUrl: root.dataset.baseUrl || '/',
+        active,
+        views: new Map([[active, initialView]]),
+        pending: new Map(),
+        scrollPositions: new Map(),
+        navigationId: 0,
+    };
+
+    // Warm up a view as soon as the user shows intent to open it.
+    const prefetch = (event: Event) => {
+        const link = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-section-link]') : null;
+        const id = link?.dataset.sectionLink;
+        if (shell && id && getSection(id)) {
+            loadView(shell, id as SectionId).catch(() => {});
+        }
+    };
+    root.addEventListener('pointerover', prefetch);
+    root.addEventListener('focusin', prefetch);
+    root.addEventListener('touchstart', prefetch, { passive: true });
+}
+
+function getActiveShell() {
+    if (shell && !shell.root.isConnected) shell = null;
+    return shell;
+}
+
+function sectionFromUrl(url: URL, baseUrl: string): SectionId | null {
+    if (url.origin !== location.origin || url.search) return null;
+
+    const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+    const pathname = url.pathname.endsWith('/') ? url.pathname : `${url.pathname}/`;
+    if (!pathname.startsWith(base)) return null;
+
+    const path = pathname.slice(base.length).replace(/\/$/, '');
+    return SECTIONS.find(section => section.path === path)?.id ?? null;
+}
+
+function sectionUrl(state: ShellState, id: SectionId) {
+    return `${state.baseUrl}${getSection(id)!.path}`;
+}
+
+function onClick(event: MouseEvent) {
+    const state = getActiveShell();
+    if (!state) return;
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+    const target = event.composedPath()[0];
+    const link = target instanceof Element ? target.closest('a') : null;
+    if (!link || !link.href || link.hash || link.hasAttribute('download')) return;
+    if (link.target && link.target !== '_self') return;
+
+    const id = sectionFromUrl(new URL(link.href), state.baseUrl);
+    if (!id) return;
+
+    event.preventDefault();
+    if (id === state.active) {
+        window.scrollTo({ top: 0 });
+        return;
+    }
+    showView(state, id, true);
+}
+
+function onPopState(event: PopStateEvent) {
+    const state = getActiveShell();
+    if (!state) return;
+
+    const id = sectionFromUrl(new URL(location.href), state.baseUrl);
+    if (!id) return;
+
+    // Handle it ourselves; otherwise ClientRouter would refetch and swap the page.
+    event.stopImmediatePropagation();
+    if (id !== state.active) showView(state, id, false);
+}
+
+function loadView(state: ShellState, id: SectionId): Promise<HTMLElement> {
+    const existing = state.views.get(id);
+    if (existing) return Promise.resolve(existing);
+
+    let pending = state.pending.get(id);
+    if (!pending) {
+        pending = fetch(`${state.baseUrl}views/${id}`, { credentials: 'same-origin', headers: { Accept: 'text/html' } })
+            .then(response => {
+                if (!response.ok) throw new Error(`Failed to load section view "${id}": ${response.status}`);
+                return response.text();
+            })
+            .then(html => {
+                // Unlike innerHTML, scripts in a contextual fragment execute once the
+                // view is inserted, so island hydration scripts in the fragment run.
+                const fragment = document.createRange().createContextualFragment(html);
+                const view = fragment.querySelector<HTMLElement>(`[data-section-view="${id}"]`);
+                if (!view) throw new Error(`Section view "${id}" missing in response`);
+                fragment.querySelectorAll('script').forEach(script => {
+                    if (!view.contains(script)) view.prepend(script);
+                });
+                view.hidden = true;
+                view.inert = true;
+                return view;
+            });
+        pending.catch(() => state.pending.delete(id));
+        state.pending.set(id, pending);
+    }
+    return pending;
+}
+
+async function showView(state: ShellState, id: SectionId, push: boolean) {
+    const navigationId = ++state.navigationId;
+    const previous = state.active;
+    const url = sectionUrl(state, id);
+
+    state.scrollPositions.set(previous, window.scrollY);
+    if (push) {
+        history.pushState({ ...history.state, index: (history.state?.index ?? 0) + 1, scrollX: 0, scrollY: 0 }, '', url);
+    }
+    updateNav(state, id);
+
+    let view: HTMLElement;
+    try {
+        if (!state.views.has(id)) state.container.setAttribute('aria-busy', 'true');
+        view = await loadView(state, id);
+    } catch (error) {
+        console.error(error);
+        location.assign(url);
+        return;
+    } finally {
+        if (navigationId === state.navigationId) state.container.removeAttribute('aria-busy');
+    }
+    // A newer navigation started while this view was loading.
+    if (navigationId !== state.navigationId || !state.root.isConnected) return;
+
+    if (!view.isConnected) {
+        state.container.append(view);
+        state.views.set(id, view);
+        state.pending.delete(id);
+    }
+
+    for (const [viewId, element] of state.views) {
+        const isActive = viewId === id;
+        element.hidden = !isActive;
+        element.inert = !isActive;
+    }
+    state.active = id;
+    document.title = view.dataset.sectionTitle || document.title;
+
+    const savedScroll = state.scrollPositions.get(id);
+    if (savedScroll !== undefined) {
+        window.scrollTo({ top: savedScroll });
+    } else {
+        // First visit: keep the section nav in view, but don't jump up further.
+        const navTop = state.root.getBoundingClientRect().top + window.scrollY;
+        if (window.scrollY > navTop) window.scrollTo({ top: navTop });
+    }
+}
+
+function updateNav(state: ShellState, id: SectionId) {
+    state.root.querySelectorAll<HTMLElement>('[data-section-link]').forEach(link => {
+        const isActive = link.dataset.sectionLink === id;
+        link.setAttribute('aria-selected', String(isActive));
+        if (isActive) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+    });
+}
