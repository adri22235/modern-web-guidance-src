+// Shared (server + client) definition of the main section views.
+// Each section is rendered as a client-side SPA view inside <SectionPage />.
+
+export const SECTIONS = [
+    { id: 'top-news', label: 'Top News', path: '', title: 'The DevTools Times' },
+    { id: 'world', label: 'World', path: 'world', title: 'World | The DevTools Times' },
+    { id: 'politics', label: 'Politics', path: 'politics', title: 'Politics | The DevTools Times' },
+    { id: 'multimedia', label: 'Multimedia', path: 'multimedia', title: 'Multimedia | The DevTools Times' },
+    { id: 'reports', label: 'Reports', path: 'reports', title: 'Reports | The DevTools Times' },
+] as const;
+
+export type SectionId = (typeof SECTIONS)[number]['id'];
+
+export function getSection(id: string) {
+    return SECTIONS.find(section => section.id === id);
+}
+
+export function isSectionId(id: string | undefined): id is SectionId {
+    return !!id && SECTIONS.some(section => section.id === id);
+}
