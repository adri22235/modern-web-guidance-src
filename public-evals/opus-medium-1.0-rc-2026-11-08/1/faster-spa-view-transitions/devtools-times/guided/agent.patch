+++ b/src/components/SectionViews.astro
@@ -0,0 +1,152 @@
+---
+import ArticleTeaser from './ArticleTeaser.astro';
+import TopStoryTeaserGrid from './TopStoryTeaserGrid.astro';
+import SimpleTeaserGrid from './SimpleTeaserGrid.astro';
+import SectionView from './SectionView.astro';
+import Ad from './AdSlotBanner';
+import { getCollection } from 'astro:content';
+import type { RenderResult } from 'astro:content';
+import { sections, sectionHref, type SectionId } from '../utils/sections';
+
+export interface Props {
+    active: SectionId;
+}
+
+const { active } = Astro.props;
+
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+const multimedia = await getCollection('multimedia');
+const reports = await getCollection('reports');
+
+// Slicing articles for different sections
+const topArticle = articles[0];
+const topStories = articles.slice(1, 4);
+const topNewsArticles = articles.slice(4, 8);      // 4 articles for the new grid
+const worldNewsArticles = articles.slice(8, 11);    // 3 articles for the old grid
+const politicsArticles = articles.slice(11, 15);   // 4 articles for the new grid
+
+// Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+politicsArticles[2] = {
+    id: 'public-transit-overhaul',
+    data: {
+      title: 'What\'s new in DevTools',
+      summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+      author: 'Chrome DevTools Team',
+      date: new Date('2025-09-16T00:00:00.000Z'),
+      category: 'Web Development',
+      image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+      image_caption: '',
+      readingTime: 3
+    },
+    body: '',
+    collection: 'articles',
+    slug: 'public-transit-overhaul',
+    render: async () => '' as unknown as RenderResult,
+  };
+---
+
+<!-- Section Navigation -->
+<nav aria-label="Sections" class="border-b border-gray-300">
+    <ul class="flex justify-center items-center gap-6 h-11 px-4 overflow-x-auto text-sm font-semibold">
+        {sections.map(section => (
+            <li>
+                <a
+                    href={sectionHref(section)}
+                    data-section-link={section.id}
+                    aria-current={section.id === active ? 'page' : undefined}
+                    class="block py-2 border-b-2 border-transparent whitespace-nowrap hover:text-gray-600 aria-[current=page]:border-amber-400 aria-[current=page]:text-amber-700"
+                >
+                    {section.label}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<div class="section-views" data-section-views>
+    <SectionView id="top-news" active={active}>
+        <!-- Top Stories Bar -->
+        <div class="bg-white border-b border-gray-300">
+            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+                    {topStories.map(article => (
+                        <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+                            <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                            </a>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </div>
+                    ))}
+                </div>
+            </div>
+        </div>
+
+        <!-- Main Content Area -->
+        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+            <ArticleTeaser article={topArticle} large={true} />
+        </div>
+
+        <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+            <section class="p-4 md:p-6 text-center">
+                <Ad client:visible />
+            </section>
+
+            <!-- "Top News" section with the new grid variant -->
+            <TopStoryTeaserGrid title="Top News" articles={topNewsArticles} />
+
+            <section class="p-4 md:p-6 text-center">
+                <Ad client:visible />
+            </section>
+        </div>
+    </SectionView>
+
+    <SectionView id="world" active={active}>
+        <div class="max-w-6xl mx-auto">
+            <SimpleTeaserGrid title="World" articles={worldNewsArticles} />
+        </div>
+    </SectionView>
+
+    <SectionView id="politics" active={active}>
+        <div class="max-w-6xl mx-auto">
+            <!-- "Politics" section with the new grid variant -->
+            <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />
+        </div>
+    </SectionView>
+
+    <SectionView id="multimedia" active={active}>
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Multimedia</h2>
+            <div class="prose max-w-none">
+                <p>Watch our latest multimedia content.</p>
+                <ul>
+                    {multimedia.map(item => (
+                        <li>
+                            <a href={`/multimedia/${item.slug}`}>{item.data.title}</a>
+                        </li>
+                    ))}
+                </ul>
+            </div>
+        </div>
+    </SectionView>
+
+    <SectionView id="reports" active={active}>
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Reports</h2>
+            <div class="prose max-w-none">
+                <p>Read our latest reports.</p>
+                <ul>
+                    {reports.map(report => (
+                        <li>
+                            <a href={`/reports/${report.slug}`}>{report.data.title}</a>
+                        </li>
+                    ))}
+                </ul>
+            </div>
+        </div>
+    </SectionView>
+</div>
+
+<script>
+    import '../scripts/section-router';
+</script>
