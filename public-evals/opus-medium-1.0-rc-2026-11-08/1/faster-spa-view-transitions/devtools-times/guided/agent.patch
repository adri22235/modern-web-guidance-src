diff --git a/src/components/SectionView.astro b/src/components/SectionView.astro
new file mode 100644
index 0000000..3397126
--- /dev/null
+++ b/src/components/SectionView.astro
@@ -0,0 +1,25 @@
+---
+import { getSection, sectionHref, type SectionId } from '../utils/sections';
+
+export interface Props {
+    id: SectionId;
+    active: SectionId;
+}
+
+const { id, active } = Astro.props;
+const section = getSection(id);
+const isActive = id === active;
+---
+<section
+    id={`view-${id}`}
+    class:list={['spa-view', { inactive: !isActive }]}
+    data-view={id}
+    data-path={sectionHref(section)}
+    data-title={section.title}
+    aria-label={section.label}
+    aria-hidden={isActive ? undefined : 'true'}
+    inert={!isActive}
+    tabindex="-1"
+>
+    <slot />
+</section>
diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..0eca7a5
