+}
+/* Cross-document transitions for regular page navigations */
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition {
+    navigation: auto;
+  }
+}
+
+/* Main section SPA views (see src/scripts/section-router.ts) */
+.section-views {
+  position: relative;
+}
+
+.spa-view.inactive {
+  /* Keep the cached rendering state of inactive views instead of tearing them down */
+  content-visibility: hidden;
+  position: absolute;
+  inset-inline: 0;
+  inset-block-start: 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
+
+/* Views receive programmatic focus on navigation; they are not interactive themselves */
+.spa-view:focus {
+  outline: none;
+}
diff --git a/src/utils/sections.ts b/src/utils/sections.ts
new file mode 100644
index 0000000..1843fac
--- /dev/null
+++ b/src/utils/sections.ts
@@ -0,0 +1,16 @@
+// Main sections of the front page. Each one is a client-side SPA view that is
+// also server-rendered at its own URL, so deep links and reloads still work.
+export const sections = [
+  { id: 'top-news', label: 'Top News', path: '', title: 'The DevTools Times' },
+  { id: 'world', label: 'World', path: 'world', title: 'World | The DevTools Times' },
+  { id: 'politics', label: 'Politics', path: 'politics', title: 'Politics | The DevTools Times' },
+  { id: 'multimedia', label: 'Multimedia', path: 'multimedia', title: 'Multimedia | The DevTools Times' },
+  { id: 'reports', label: 'Reports', path: 'reports', title: 'Reports | The DevTools Times' },
+] as const;
+
+export type Section = (typeof sections)[number];
+export type SectionId = Section['id'];
+
+export const getSection = (id: SectionId): Section => sections.find((section) => section.id === id)!;
+
+export const sectionHref = (section: Section) => `${import.meta.env.BASE_URL}${section.path}`;
