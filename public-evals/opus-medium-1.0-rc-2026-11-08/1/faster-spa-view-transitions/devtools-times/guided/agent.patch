diff --git a/src/scripts/section-router.ts b/src/scripts/section-router.ts
new file mode 100644
index 0000000..d114d72
--- /dev/null
+++ b/src/scripts/section-router.ts
@@ -0,0 +1,88 @@
+// Client-side router for the main section views (Top News, World, ...).
+//
+// All views live in the DOM. Inactive ones get `content-visibility: hidden`,
+// so the browser skips their layout and paint but keeps their rendering state,
+// DOM and hydrated islands. Switching back to a visited view is just a class
+// toggle instead of a fetch and rebuild.
+
+const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
+
+function initSectionRouter(root: HTMLElement) {
+    const views = new Map<string, HTMLElement>();
+    for (const view of root.querySelectorAll<HTMLElement>('[data-view]')) {
+        views.set(normalizePath(view.dataset.path!), view);
+    }
+
+    let current = [...views.values()].find((view) => !view.classList.contains('inactive'));
+    if (!current) return;
+
+    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
+    const scrollPositions = new WeakMap<HTMLElement, number>();
+
+    // Scroll is restored per view by hand. Switch back to 'auto' when leaving
+    // the page so reloads and cross-document back/forward behave normally.
+    history.scrollRestoration = 'manual';
+    window.addEventListener('pagehide', () => (history.scrollRestoration = 'auto'));
+    window.addEventListener('pageshow', () => (history.scrollRestoration = 'manual'));
+
+    function activate(view: HTMLElement) {
+        if (!current || view === current) return;
+
+        scrollPositions.set(current, window.scrollY);
+        const viewsTop = root.getBoundingClientRect().top + window.scrollY;
+
+        current.classList.add('inactive');
+        current.setAttribute('aria-hidden', 'true');
+        current.inert = true;
+
+        view.classList.remove('inactive');
+        view.removeAttribute('aria-hidden');
+        view.inert = false;
+        current = view;
+
+        for (const link of navLinks) {
+            if (link.dataset.sectionLink === view.dataset.view) {
+                link.setAttribute('aria-current', 'page');
+            } else {
+                link.removeAttribute('aria-current');
+            }
+        }
+        document.title = view.dataset.title ?? document.title;
+
+        // Return to where the user left a visited view; otherwise show the
+        // top of the new view without jumping above the section nav.
+        window.scrollTo(0, scrollPositions.get(view) ?? Math.min(window.scrollY, viewsTop));
+        view.focus({ preventScroll: true });
+    }
+
+    document.addEventListener('click', (event) => {
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+            return;
+        }
+        const link = (event.target as Element | null)?.closest?.('a[href]');
+        if (!(link instanceof HTMLAnchorElement)) return;
+        if ((link.target && link.target !== '_self') || link.hasAttribute('download') || link.origin !== location.origin || link.hash) {
+            return;
+        }
+
+        const view = views.get(normalizePath(link.pathname));
+        if (!view) return;
+
+        event.preventDefault();
+        if (view === current) return;
+        history.pushState({ sectionView: view.dataset.view }, '', link.href);
+        activate(view);
+    });
+
+    window.addEventListener('popstate', () => {
+        const view = views.get(normalizePath(location.pathname));
+        if (view) {
+            activate(view);
+        } else {
+            location.reload();
+        }
+    });
+}
+
+const root = document.querySelector<HTMLElement>('[data-section-views]');
+if (root) initSectionRouter(root);
