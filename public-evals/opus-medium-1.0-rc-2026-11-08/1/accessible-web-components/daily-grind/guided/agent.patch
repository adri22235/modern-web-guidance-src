index 0000000..9f0c8f5
--- /dev/null
+++ b/favorite-toggle.js
@@ -0,0 +1,182 @@
+/**
+ * <favorite-toggle> — a reusable on/off switch for marking an item as a favorite.
+ *
+ * Usage:
+ *   <favorite-toggle drink="Maple Oat Latte"></favorite-toggle>
+ *
+ * Attributes:
+ *   drink    Name of the item; used for the accessible label and as the storage key.
+ *   checked  Boolean; present when the item is a favorite.
+ *
+ * Events:
+ *   change   Fired (bubbles) when the user toggles the switch. Read `event.target.checked`.
+ *
+ * The state persists in localStorage so favorites survive a reload.
+ */
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorite(name, on) {
+  const favorites = readFavorites();
+  on ? favorites.add(name) : favorites.delete(name);
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+  } catch {
+    // Storage unavailable (private mode, quota) — state still works for this page view.
+  }
+}
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      cursor: pointer;
+      user-select: none;
+      font-size: 0.9rem;
+      color: var(--favorite-text, #3e2723);
+      border-radius: 999px;
+      -webkit-tap-highlight-color: transparent;
+    }
+
+    :host(:focus-visible) {
+      outline: 3px solid var(--favorite-focus, #ffab40);
+      outline-offset: 4px;
+    }
+
+    .track {
+      position: relative;
+      inline-size: 2.75rem;
+      block-size: 1.5rem;
+      border-radius: 999px;
+      background: var(--favorite-track-off, #bcaaa4);
+      transition: background-color 0.2s;
+      flex: none;
+    }
+
+    .thumb {
+      position: absolute;
+      inset-block-start: 0.125rem;
+      inset-inline-start: 0.125rem;
+      display: grid;
+      place-items: center;
+      inline-size: 1.25rem;
+      block-size: 1.25rem;
+      border-radius: 50%;
+      background: #fff;
+      box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
+      transition: translate 0.2s;
+    }
+
+    .thumb svg {
+      inline-size: 0.8rem;
+      block-size: 0.8rem;
+      fill: none;
+      stroke: var(--favorite-track-off, #8d6e63);
+      stroke-width: 2.5;
+    }
+
+    :host(:state(checked)) .track {
+      background: var(--favorite-track-on, #4e342e);
+    }
+
+    :host(:state(checked)) .thumb {
+      translate: 1.25rem 0;
+    }
+
+    :host(:dir(rtl):state(checked)) .thumb {
+      translate: -1.25rem 0;
+    }
+
+    :host(:state(checked)) .thumb svg {
+      fill: var(--favorite-heart, #e53935);
+      stroke: var(--favorite-heart, #e53935);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .track, .thumb { transition: none; }
+    }
+
+    @media (forced-colors: active) {
+      .track { border: 1px solid CanvasText; }
+      :host(:state(checked)) .track { background: Highlight; }
+    }
+  </style>
+  <span class="track" aria-hidden="true">
+    <span class="thumb">
+      <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.5 3 4.5 6.9 4.5c2.2 0 3.9 1.3 5.1 3 1.2-1.7 2.9-3 5.1-3 3.9 0 6 4 4.5 7.3C19.5 16.4 12 21 12 21z"/></svg>
+    </span>
+  </span>
+  <span class="label" aria-hidden="true"><slot>Favorite</slot></span>
+`;
+
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['checked', 'drink'];
+
+  #internals;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'switch';
+    this.#internals.ariaChecked = 'false';
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+
+    this.addEventListener('click', () => this.#userToggle());
+    this.addEventListener('keydown', (event) => {
+      if (event.key === ' ' || event.key === 'Enter') {
+        event.preventDefault();
+        if (!event.repeat) this.#userToggle();
+      }
+    });
+  }
+
+  connectedCallback() {
+    // Put the host in the tab order on connect (setting tabIndex in the constructor throws on createElement).
+    if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+    // Restore persisted state, unless markup already marked it as a favorite.
+    if (this.drink && readFavorites().has(this.drink)) this.checked = true;
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#sync();
+  }
+
+  get drink() { return this.getAttribute('drink') ?? ''; }
+  set drink(v) {
+    v ? this.setAttribute('drink', v) : this.removeAttribute('drink');
+  }
+
+  get checked() { return this.hasAttribute('checked'); }
+  set checked(on) { this.toggleAttribute('checked', !!on); }
+
+  toggle(force = !this.checked) {
+    this.checked = force;
+    if (this.drink) writeFavorite(this.drink, this.checked);
+    return this.checked;
+  }
+
+  #userToggle() {
+    this.toggle();
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #sync() {
+    const on = this.checked;
+    this.#internals.ariaChecked = String(on);
+    on ? this.#internals.states.add('checked') : this.#internals.states.delete('checked');
+    this.#internals.ariaLabel = this.drink ? `Favorite ${this.drink}` : 'Favorite';
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
