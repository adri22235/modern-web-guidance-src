diff --git a/hero-ripple.js b/hero-ripple.js
new file mode 100644
--- a/hero-ripple.js
+++ b/hero-ripple.js
@@ -0,0 +1,375 @@
+/*
+ * GPU ripple distortion for the hero content.
+ *
+ * The hero's HTML (heading, tagline, "Order Now" button) is rasterised into a
+ * 2D canvas at the exact positions the browser laid it out, uploaded as a WebGL
+ * texture, and redrawn every frame through a ripple shader on a canvas overlay.
+ * The overlay has `pointer-events: none` and the real DOM stays underneath
+ * (painted transparent), so text remains selectable and the button clickable,
+ * focusable and readable by assistive tech.
+ *
+ * Falls back to the plain HTML when WebGL is unavailable, the context is lost,
+ * or the user prefers reduced motion.
+ */
+(function () {
+  'use strict';
+
+  var hero = document.getElementById('hero');
+  if (!hero) return;
+  var canvas = hero.querySelector('.hero-fx');
+  var content = hero.querySelector('.hero-content');
+  var button = content.querySelector('.btn');
+
+  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+  var MAX_RIPPLES = 8;
+
+  var VERT = [
+    'attribute vec2 a_pos;',
+    'varying vec2 v_uv;',
+    'void main() {',
+    '  v_uv = a_pos * 0.5 + 0.5;',
+    '  gl_Position = vec4(a_pos, 0.0, 1.0);',
+    '}'
+  ].join('\n');
+
+  var FRAG = [
+    'precision mediump float;',
+    'uniform sampler2D u_tex;',
+    'uniform vec2 u_res;',
+    'uniform float u_time;',
+    'uniform float u_scale;',
+    // xy = centre in device px (y up), z = start time, w = strength
+    'uniform vec4 u_ripples[' + MAX_RIPPLES + '];',
+    'varying vec2 v_uv;',
+    '',
+    'void main() {',
+    '  vec2 px = v_uv * u_res;',
+    '  vec2 off = vec2(0.0);',
+    '',
+    '  for (int i = 0; i < ' + MAX_RIPPLES + '; i++) {',
+    '    vec4 r = u_ripples[i];',
+    '    float age = u_time - r.z;',
+    '    if (r.w <= 0.0 || age < 0.0 || age > 3.0) continue;',
+    '    vec2 d = px - r.xy;',
+    '    float dist = length(d);',
+    '    float ring = dist - age * 320.0 * u_scale;',
+    '    float width = 70.0 * u_scale;',
+    '    float env = exp(-(ring * ring) / (width * width)) * exp(-age * 1.4) * r.w;',
+    '    float wave = sin(ring / (11.0 * u_scale));',
+    '    off += (d / max(dist, 1.0)) * wave * env * 9.0 * u_scale;',
+    '  }',
+    '',
+    // gentle ambient liquid wobble so the effect is alive without interaction
+    '  off += vec2(',
+    '    sin(px.y / (38.0 * u_scale) + u_time * 1.6),',
+    '    cos(px.x / (52.0 * u_scale) + u_time * 1.3)',
+    '  ) * 1.1 * u_scale;',
+    '',
+    '  vec2 uv = (px - off) / u_res;',
+    '  vec2 ca = off * 0.18 / u_res;',
+    '  vec4 c = texture2D(u_tex, uv);',
+    '  vec4 cr = texture2D(u_tex, uv + ca);',
+    '  vec4 cb = texture2D(u_tex, uv - ca);',
+    // premultiplied alpha: each channel <= its own alpha <= max alpha
+    '  gl_FragColor = vec4(cr.r, c.g, cb.b, max(c.a, max(cr.a, cb.a)));',
+    '}'
+  ].join('\n');
+
+  var gl, program, texture, uniforms;
+  var raster = document.createElement('canvas');
+  var rctx = raster.getContext('2d');
+  var dpr = 1;
+  var width = 0;
+  var height = 0;
+  var ripples = new Float32Array(MAX_RIPPLES * 4);
+  var rippleIndex = 0;
+  var lastRipple = null;
+  var startTime = performance.now();
+  var rafId = 0;
+  var visible = true;
+  var running = false;
+  var hoverTarget = 0;
+  var hoverAmount = 0;
+  var textureDirty = true;
+
+  function now() {
+    return (performance.now() - startTime) / 1000;
+  }
+
+  function compile(type, src) {
+    var sh = gl.createShader(type);
+    gl.shaderSource(sh, src);
+    gl.compileShader(sh);
+    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
+      console.warn('Hero ripple shader error:', gl.getShaderInfoLog(sh));
+      return null;
+    }
+    return sh;
+  }
+
+  function initGL() {
+    gl = canvas.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
+    if (!gl) return false;
+
+    var vs = compile(gl.VERTEX_SHADER, VERT);
+    var fs = compile(gl.FRAGMENT_SHADER, FRAG);
+    if (!vs || !fs) return false;
+
+    program = gl.createProgram();
+    gl.attachShader(program, vs);
+    gl.attachShader(program, fs);
+    gl.linkProgram(program);
+    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return false;
+    gl.useProgram(program);
+
+    // Single oversized triangle covering the viewport
+    var buf = gl.createBuffer();
+    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
+    var loc = gl.getAttribLocation(program, 'a_pos');
+    gl.enableVertexAttribArray(loc);
+    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+    texture = gl.createTexture();
+    gl.bindTexture(gl.TEXTURE_2D, texture);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
+    gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
+
+    uniforms = {
+      tex: gl.getUniformLocation(program, 'u_tex'),
+      res: gl.getUniformLocation(program, 'u_res'),
+      time: gl.getUniformLocation(program, 'u_time'),
+      scale: gl.getUniformLocation(program, 'u_scale'),
+      ripples: gl.getUniformLocation(program, 'u_ripples')
+    };
+    gl.uniform1i(uniforms.tex, 0);
+    return true;
+  }
+
+  function fontOf(cs) {
+    return cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
+  }
+
+  function parseColor(value) {
+    rctx.fillStyle = '#000';
+    rctx.fillStyle = value.trim();
+    return rctx.fillStyle;
+  }
+
+  function mixColor(a, b, t) {
+    // Both come back from the 2D context as #rrggbb (opaque) or rgba(...)
+    function rgb(c) {
+      if (c.charAt(0) === '#') {
+        return [parseInt(c.substr(1, 2), 16), parseInt(c.substr(3, 2), 16), parseInt(c.substr(5, 2), 16)];
+      }
+      return c.match(/[\d.]+/g).slice(0, 3).map(Number);
+    }
+    var ca = rgb(a);
+    var cb = rgb(b);
+    return 'rgb(' + ca.map(function (v, i) { return Math.round(v + (cb[i] - v) * t); }).join(',') + ')';
+  }
+
+  function roundRect(ctx, x, y, w, h, r) {
+    r = Math.min(r, w / 2, h / 2);
+    ctx.beginPath();
+    ctx.moveTo(x + r, y);
+    ctx.arcTo(x + w, y, x + w, y + h, r);
+    ctx.arcTo(x + w, y + h, x, y + h, r);
+    ctx.arcTo(x, y + h, x, y, r);
+    ctx.arcTo(x, y, x + w, y, r);
+    ctx.closePath();
+  }
+
+  // Draw every word of every text node at the exact box the browser laid it out in.
+  function drawText(root, origin, color) {
+    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    var range = document.createRange();
+    var node;
+    rctx.fillStyle = color;
+    rctx.textBaseline = 'alphabetic';
+    rctx.textAlign = 'left';
+    while ((node = walker.nextNode())) {
+      var cs = getComputedStyle(node.parentElement);
+      rctx.font = fontOf(cs);
+      if ('letterSpacing' in rctx) rctx.letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
+      var text = node.nodeValue;
+      var re = /\S+/g;
+      var m;
+      while ((m = re.exec(text))) {
+        range.setStart(node, m.index);
+        range.setEnd(node, m.index + m[0].length);
+        var rect = range.getClientRects()[0];
+        if (!rect) continue;
+        var metrics = rctx.measureText(m[0]);
+        var asc = metrics.fontBoundingBoxAscent || metrics.actualBoundingBoxAscent;
+        var desc = metrics.fontBoundingBoxDescent || metrics.actualBoundingBoxDescent;
+        var y = rect.top - origin.top + (rect.height - (asc + desc)) / 2 + asc;
+        rctx.fillText(m[0], rect.left - origin.left, y);
+      }
+    }
+  }
+
+  function rasterize() {
+    var origin = hero.getBoundingClientRect();
+    rctx.setTransform(1, 0, 0, 1, 0, 0);
+    rctx.clearRect(0, 0, raster.width, raster.height);
+    rctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+    var heroStyle = getComputedStyle(hero);
+    var fg = parseColor(heroStyle.getPropertyValue('--hero-fg') || '#fff');
+
+    // Button chrome (its real background is transparent while the effect runs)
+    var bs = getComputedStyle(button);
+    var br = button.getBoundingClientRect();
+    var bg = mixColor(
+      parseColor(bs.getPropertyValue('--btn-bg')),
+      parseColor(bs.getPropertyValue('--btn-bg-hover')),
+      hoverAmount
+    );
+    rctx.fillStyle = bg;
+    roundRect(rctx, br.left - origin.left, br.top - origin.top, br.width, br.height, parseFloat(bs.borderTopLeftRadius) || 0);
+    rctx.fill();
+
+    drawText(content, origin, fg);
+
+    gl.bindTexture(gl.TEXTURE_2D, texture);
+    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, raster);
+    textureDirty = false;
+  }
+
+  function resize() {
+    var rect = hero.getBoundingClientRect();
+    dpr = Math.min(window.devicePixelRatio || 1, 2);
+    width = Math.max(1, Math.round(rect.width * dpr));
+    height = Math.max(1, Math.round(rect.height * dpr));
+    canvas.width = raster.width = width;
+    canvas.height = raster.height = height;
+    gl.viewport(0, 0, width, height);
+    textureDirty = true;
+  }
+
+  function frame() {
+    rafId = 0;
+    if (!running || !visible) return;
+
+    var prevHover = hoverAmount;
+    hoverAmount += (hoverTarget - hoverAmount) * 0.2;
+    if (Math.abs(hoverTarget - hoverAmount) < 0.01) hoverAmount = hoverTarget;
+    if (hoverAmount !== prevHover) textureDirty = true;
+    if (textureDirty) rasterize();
+
+    gl.clearColor(0, 0, 0, 0);
+    gl.clear(gl.COLOR_BUFFER_BIT);
+    gl.uniform2f(uniforms.res, width, height);
+    gl.uniform1f(uniforms.time, now());
+    gl.uniform1f(uniforms.scale, dpr);
+    gl.uniform4fv(uniforms.ripples, ripples);
+    gl.drawArrays(gl.TRIANGLES, 0, 3);
+
+    schedule();
+  }
+
+  function schedule() {
+    if (!rafId && running && visible) rafId = requestAnimationFrame(frame);
+  }
+
+  function addRipple(clientX, clientY, strength) {
+    var rect = hero.getBoundingClientRect();
+    var x = (clientX - rect.left) * dpr;
+    var y = (rect.bottom - clientY) * dpr; // GL y axis points up
+    var i = rippleIndex * 4;
+    ripples[i] = x;
+    ripples[i + 1] = y;
+    ripples[i + 2] = now();
+    ripples[i + 3] = strength;
+    rippleIndex = (rippleIndex + 1) % MAX_RIPPLES;
+  }
+
+  function onPointerMove(e) {
+    if (!running) return;
+    if (lastRipple) {
+      var dx = e.clientX - lastRipple.x;
+      var dy = e.clientY - lastRipple.y;
+      if (dx * dx + dy * dy < 70 * 70) return;
+    }
+    lastRipple = { x: e.clientX, y: e.clientY };
+    addRipple(e.clientX, e.clientY, 0.45);
+  }
+
+  function onPointerDown(e) {
+    if (!running) return;
+    addRipple(e.clientX, e.clientY, 1.0);
+  }
+
+  function start() {
+    if (!initGL()) return stop();
+    resize();
+    rasterize();
+    running = true;
+    hero.classList.add('fx-on');
+    schedule();
+  }
+
+  function stop() {
+    running = false;
+    hero.classList.remove('fx-on');
+    if (rafId) cancelAnimationFrame(rafId);
+    rafId = 0;
+  }
+
+  // Input never targets the canvas; listen on the hero so the DOM keeps all events.
+  hero.addEventListener('pointermove', onPointerMove, { passive: true });
+  hero.addEventListener('pointerdown', onPointerDown, { passive: true });
+
+  function setHover(on) {
+    hoverTarget = on ? 1 : 0;
+  }
+  button.addEventListener('pointerenter', function () { setHover(true); });
+  button.addEventListener('pointerleave', function () { setHover(false); });
+  button.addEventListener('focus', function () {
+    setHover(true);
+    var r = button.getBoundingClientRect();
+    if (running) addRipple(r.left + r.width / 2, r.top + r.height / 2, 0.7);
+  });
+  button.addEventListener('blur', function () { setHover(false); });
+
+  if ('ResizeObserver' in window) {
+    new ResizeObserver(function () {
+      if (running) { resize(); schedule(); }
+    }).observe(hero);
+  } else {
+    window.addEventListener('resize', function () {
+      if (running) { resize(); schedule(); }
+    });
+  }
+
+  if ('IntersectionObserver' in window) {
+    new IntersectionObserver(function (entries) {
+      visible = entries[0].isIntersecting;
+      schedule();
+    }).observe(hero);
+  }
+
+  if (document.fonts && document.fonts.ready) {
+    document.fonts.ready.then(function () { textureDirty = true; });
+  }
+
+  canvas.addEventListener('webglcontextlost', function (e) {
+    e.preventDefault();
+    stop();
+  });
+  canvas.addEventListener('webglcontextrestored', start);
+
+  var onMotionChange = function () {
+    if (reducedMotion.matches) stop();
+    else if (!running) start();
+  };
+  if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', onMotionChange);
+
+  if (!reducedMotion.matches) start();
+})();
