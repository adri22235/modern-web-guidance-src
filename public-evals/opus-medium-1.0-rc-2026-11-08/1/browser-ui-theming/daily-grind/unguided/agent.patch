+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var sweetness = document.getElementById('sweetness');
+      var sweetnessValue = document.getElementById('sweetness-value');
+      var shots = document.getElementById('shots');
+      var strength = document.getElementById('strength');
+      var pickupDate = document.getElementById('pickup-date');
+
+      function localDate(d) {
+        return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+      }
+
+      var today = new Date();
+      var maxDate = new Date();
+      maxDate.setDate(today.getDate() + 14);
+      pickupDate.min = localDate(today);
+      pickupDate.max = localDate(maxDate);
+      pickupDate.value = pickupDate.min;
+
+      function sync() {
+        sweetnessValue.value = sweetness.value;
+        var n = Math.min(Math.max(Number(shots.value) || 0, 0), 6);
+        strength.value = n;
+        strength.textContent = n + ' of 6 shots';
+      }
+
+      sweetness.addEventListener('input', sync);
+      shots.addEventListener('input', sync);
+      // Reset restores defaults after the event, so sync on the next tick
+      form.addEventListener('reset', function () {
+        setTimeout(function () {
+          pickupDate.value = pickupDate.min;
+          sync();
+        });
+      });
+      sync();
+    })();
+  </script>
+
