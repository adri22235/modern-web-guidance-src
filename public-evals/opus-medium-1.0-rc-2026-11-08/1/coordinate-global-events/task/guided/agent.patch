+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const ZONES = [
+      { city: 'Los Angeles', tz: 'America/Los_Angeles' },
+      { city: 'New York', tz: 'America/New_York' },
+      { city: 'São Paulo', tz: 'America/Sao_Paulo' },
+      { city: 'London', tz: 'Europe/London' },
+      { city: 'Paris', tz: 'Europe/Paris' },
+      { city: 'Addis Ababa', tz: 'Africa/Addis_Ababa' },
+      { city: 'Kolkata', tz: 'Asia/Kolkata' },
+      { city: 'Jakarta', tz: 'Asia/Jakarta' },
+      { city: 'Tokyo', tz: 'Asia/Tokyo' },
+      { city: 'Sydney', tz: 'Australia/Sydney' },
+      { city: 'Auckland', tz: 'Pacific/Auckland' },
+    ];
+
+    const form = document.getElementById('eventForm');
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const statusEl = document.getElementById('status');
+    const grid = document.getElementById('grid');
+
+    const timeFmt = { hour: 'numeric', minute: '2-digit' };
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+    // Populate the host select; preselect the visitor's zone if we list it.
+    const localTz = Temporal.Now.timeZoneId();
+    if (!ZONES.some((z) => z.tz === localTz)) {
+      ZONES.unshift({ city: localTz.split('/').pop().replaceAll('_', ' '), tz: localTz });
+    }
+    for (const { city, tz } of ZONES) {
+      hostTzSelect.add(new Option(`${city} (${tz})`, tz, false, tz === localTz));
+    }
+
+    // Default: next Saturday at 10:00 in the host zone.
+    const today = Temporal.Now.plainDateISO(localTz);
+    dateInput.value = today.add({ days: ((6 - today.dayOfWeek) + 7) % 7 || 7 }).toString();
+    timeInput.value = '10:00';
+
+    function zoneLabel(zdt) {
+      return zdt.toLocaleString('en-US', { timeZoneName: 'short' }).split(' ').pop();
+    }
+
+    // A zone observes DST on a date if its offset exceeds its standard (lowest) offset that year.
+    function isDst(zdt) {
+      const standard = Math.min(
+        ...[1, 7].map((month) =>
+          Temporal.PlainDate.from({ year: zdt.year, month, day: 1 })
+            .toZonedDateTime(zdt.timeZoneId).offsetNanoseconds)
+      );
+      return zdt.offsetNanoseconds > standard;
+    }
+
+    function showError(message) {
+      statusEl.textContent = message;
+      statusEl.className = 'status error';
+      timeInput.setAttribute('aria-invalid', 'true');
+      grid.replaceChildren();
+    }
+
+    function resolveHostTime(date, time, tz) {
+      const pdt = Temporal.PlainDateTime.from(`${date}T${time}`);
+      try {
+        return { zdt: pdt.toZonedDateTime(tz, { disambiguation: 'reject' }) };
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+        const earlier = pdt.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = pdt.toZonedDateTime(tz, { disambiguation: 'later' });
+        const hhmm = (z) => z.toLocaleString('en-US', timeFmt);
+        if (earlier.toPlainDateTime().equals(pdt)) {
+          // Wall-clock time occurs twice (clocks fall back).
+          return {
+            error: `${hhmm(earlier)} happens twice on ${pdt.toPlainDate().toLocaleString('en-US', dateFmt)} in ${tz} ` +
+              `because clocks fall back (${earlier.offset} → ${later.offset}). Pick a time outside the repeated hour ` +
+              `so every guest gets one unambiguous start time.`,
+          };
+        }
+        // Wall-clock time is skipped (clocks spring forward).
+        const transition = earlier.getTimeZoneTransition('next');
+        const gap = Temporal.Duration.from({ nanoseconds: later.offsetNanoseconds - earlier.offsetNanoseconds });
+        const gapStart = transition.toPlainDateTime().subtract(gap);
+        return {
+          error: `${hhmm(pdt)} doesn't exist on ${pdt.toPlainDate().toLocaleString('en-US', dateFmt)} in ${tz}: ` +
+            `clocks spring forward from ${hhmm(gapStart)} straight to ${hhmm(transition)}. ` +
+            `Choose ${hhmm(transition)} or later, or a time before ${hhmm(gapStart)}.`,
+        };
+      }
+    }
+
+    function render() {
+      timeInput.removeAttribute('aria-invalid');
+      dateInput.removeAttribute('aria-invalid');
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const hostTz = hostTzSelect.value;
+
+      if (!date) {
+        dateInput.setAttribute('aria-invalid', 'true');
+        showError('Please choose a valid date.');
+        return;
+      }
+      if (!time) {
+        showError('Please choose a valid start time.');
+        return;
+      }
+
+      let result;
+      try {
+        result = resolveHostTime(date, time, hostTz);
+      } catch {
+        showError('That date or time could not be understood. Please check your entries.');
+        return;
+      }
+      if (result.error) {
+        showError(result.error);
+        return;
+      }
+
+      const host = result.zdt;
+      const hostDate = host.toPlainDate();
+      statusEl.className = 'status';
+      statusEl.textContent =
+        `Tasting starts ${host.toLocaleString('en-US', { ...dateFmt, ...timeFmt })} ${zoneLabel(host)} ` +
+        `(${host.toInstant().toLocaleString('en-US', { ...timeFmt, timeZone: 'UTC' })} UTC).`;
+
+      const cards = ZONES.map(({ city, tz }) => {
+        const local = host.withTimeZone(tz);
+        const dayDiff = Temporal.PlainDate.compare(local.toPlainDate(), hostDate);
+
+        const card = document.createElement('article');
+        card.className = 'card' + (tz === hostTz ? ' host' : '');
+
+        const h3 = document.createElement('h3');
+        h3.textContent = city + (tz === hostTz ? ' (host)' : '');
+
+        const timeEl = document.createElement('time');
+        timeEl.className = 'local-time';
+        timeEl.dateTime = local.toString({ timeZoneName: 'never' });
+        timeEl.textContent = local.toLocaleString('en-US', timeFmt);
+
+        const dateEl = document.createElement('p');
+        dateEl.className = 'local-date';
+        dateEl.textContent = local.toLocaleString('en-US', dateFmt);
+
+        const meta = document.createElement('p');
+        meta.className = 'meta';
+        meta.textContent = `${tz} · ${zoneLabel(local)} · UTC${local.offset}`;
+
+        const badges = document.createElement('div');
+        const badge = (text, cls) => {
+          const b = document.createElement('span');
+          b.className = `badge ${cls}`;
+          b.textContent = text;
+          badges.append(b);
+        };
+        badge(isDst(local) ? 'Daylight time' : 'Standard time', isDst(local) ? 'dst' : 'std');
+        if (dayDiff !== 0) badge(dayDiff > 0 ? 'Next day' : 'Previous day', 'day-shift');
+        if (local.hour < 7 || local.hour >= 22) badge('Outside café hours', 'off-hours');
+
+        card.append(h3, timeEl, dateEl, meta, badges);
+        return card;
+      });
+      grid.replaceChildren(...cards);
+    }
+
+    form.addEventListener('input', render);
+    form.addEventListener('submit', (e) => { e.preventDefault(); render(); });
+    render();
+  </script>
+
 </body>
 
