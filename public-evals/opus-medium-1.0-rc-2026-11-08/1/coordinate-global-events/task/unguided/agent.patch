+
+  <script>
+    (function () {
+      'use strict';
+
+      // Zones offered for hosting and shown as cards.
+      var ZONES = [
+        { tz: 'America/Los_Angeles', city: 'Los Angeles' },
+        { tz: 'America/Denver', city: 'Denver' },
+        { tz: 'America/Chicago', city: 'Chicago' },
+        { tz: 'America/New_York', city: 'New York' },
+        { tz: 'America/Sao_Paulo', city: 'São Paulo' },
+        { tz: 'UTC', city: 'UTC' },
+        { tz: 'Europe/London', city: 'London' },
+        { tz: 'Europe/Paris', city: 'Paris' },
+        { tz: 'Africa/Addis_Ababa', city: 'Addis Ababa' },
+        { tz: 'Asia/Kolkata', city: 'Mumbai' },
+        { tz: 'Asia/Jakarta', city: 'Jakarta' },
+        { tz: 'Asia/Tokyo', city: 'Tokyo' },
+        { tz: 'Australia/Sydney', city: 'Sydney' },
+        { tz: 'Pacific/Auckland', city: 'Auckland' }
+      ];
+
+      var HOUR = 3600000;
+      var DAY = 24 * HOUR;
+
+      var dateInput = document.getElementById('dateInput');
+      var timeInput = document.getElementById('timeInput');
+      var hostTzSelect = document.getElementById('hostTzSelect');
+      var form = document.getElementById('eventForm');
+      var grid = document.getElementById('grid');
+      var statusMsg = document.getElementById('statusMsg');
+
+      var partsFormatters = {};
+
+      function getPartsFormatter(tz) {
+        if (!partsFormatters[tz]) {
+          partsFormatters[tz] = new Intl.DateTimeFormat('en-US', {
+            timeZone: tz,
+            hourCycle: 'h23',
+            year: 'numeric', month: '2-digit', day: '2-digit',
+            hour: '2-digit', minute: '2-digit', second: '2-digit'
+          });
+        }
+        return partsFormatters[tz];
+      }
+
+      function isValidTimeZone(tz) {
+        try {
+          new Intl.DateTimeFormat('en-US', { timeZone: tz });
+          return true;
+        } catch (e) {
+          return false;
+        }
+      }
+
+      // Wall-clock fields of a UTC instant in the given zone.
+      function wallFields(ms, tz) {
+        var out = {};
+        getPartsFormatter(tz).formatToParts(new Date(ms)).forEach(function (p) {
+          if (p.type !== 'literal') out[p.type] = parseInt(p.value, 10);
+        });
+        if (out.hour === 24) out.hour = 0; // guard against older engines
+        return out;
+      }
+
+      // Offset of the zone from UTC (ms) at the given instant.
+      function offsetAt(ms, tz) {
+        var f = wallFields(ms, tz);
+        var asUtc = Date.UTC(f.year, f.month - 1, f.day, f.hour, f.minute, f.second);
+        return asUtc - Math.floor(ms / 1000) * 1000;
+      }
+
+      /*
+       * Resolve a wall-clock time in a zone to UTC instants.
+       * Returns [] when the time doesn't exist (spring-forward gap),
+       * one instant normally, or two when ambiguous (fall-back overlap).
+       */
+      function wallTimeToInstants(y, mo, d, h, mi, tz) {
+        var naive = Date.UTC(y, mo - 1, d, h, mi);
+        var offsets = [offsetAt(naive - DAY, tz), offsetAt(naive, tz), offsetAt(naive + DAY, tz)];
+        var seen = {};
+        var result = [];
+        offsets.forEach(function (o) {
+          var candidate = naive - o;
+          if (seen[candidate]) return;
+          seen[candidate] = true;
+          var f = wallFields(candidate, tz);
+          if (f.year === y && f.month === mo && f.day === d && f.hour === h && f.minute === mi) {
+            result.push(candidate);
+          }
+        });
+        return result.sort(function (a, b) { return a - b; });
+      }
+
+      function isDstAt(ms, tz) {
+        var year = wallFields(ms, tz).year;
+        var jan = offsetAt(Date.UTC(year, 0, 1), tz);
+        var jul = offsetAt(Date.UTC(year, 6, 1), tz);
+        if (jan === jul) return false;
+        return offsetAt(ms, tz) > Math.min(jan, jul);
+      }
+
+      function formatOffset(ms) {
+        var mins = Math.round(ms / 60000);
+        var sign = mins < 0 ? '-' : '+';
+        mins = Math.abs(mins);
+        var h = Math.floor(mins / 60);
+        var m = mins % 60;
+        return 'UTC' + sign + h + (m ? ':' + String(m).padStart(2, '0') : '');
+      }
+
+      function zoneLabel(tz) {
+        for (var i = 0; i < ZONES.length; i++) {
+          if (ZONES[i].tz === tz) return ZONES[i].city;
+        }
+        return tz.replace(/_/g, ' ');
+      }
+
+      function populateHostSelect() {
+        var browserTz = '';
+        try { browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { }
+        var zones = ZONES.filter(function (z) { return isValidTimeZone(z.tz); });
+        if (browserTz && isValidTimeZone(browserTz) &&
+          !zones.some(function (z) { return z.tz === browserTz; })) {
+          zones.unshift({ tz: browserTz, city: browserTz.replace(/_/g, ' ') + ' (your zone)' });
+        }
+        var now = Date.now();
+        zones.forEach(function (z) {
+          var opt = document.createElement('option');
+          opt.value = z.tz;
+          opt.textContent = z.city + ' (' + formatOffset(offsetAt(now, z.tz)) + ')';
+          hostTzSelect.appendChild(opt);
+        });
+        hostTzSelect.value = browserTz && zones.some(function (z) { return z.tz === browserTz; })
+          ? browserTz : 'America/New_York';
+      }
+
+      function setDefaults() {
+        // Default: next Saturday at 10:00 in the host zone's calendar.
+        var today = wallFields(Date.now(), hostTzSelect.value);
+        var base = new Date(Date.UTC(today.year, today.month - 1, today.day));
+        var add = (6 - base.getUTCDay() + 7) % 7 || 7;
+        base.setUTCDate(base.getUTCDate() + add);
+        dateInput.value = base.toISOString().slice(0, 10);
+        timeInput.value = '10:00';
+      }
+
+      function setStatus(kind, text) {
+        statusMsg.className = 'status' + (kind ? ' ' + kind : '');
+        statusMsg.textContent = text || '';
+      }
+
+      function parseDate(value) {
+        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || '');
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (y < 1900 || y > 2100 || mo < 1 || mo > 12) return null;
+        var check = new Date(Date.UTC(y, mo - 1, d));
+        if (check.getUTCMonth() !== mo - 1 || check.getUTCDate() !== d) return null;
+        return { y: y, mo: mo, d: d };
+      }
+
+      function parseTime(value) {
+        var m = /^(\d{2}):(\d{2})(?::(\d{2}))?$/.exec(value || '');
+        if (!m) return null;
+        var h = +m[1], mi = +m[2];
+        if (h > 23 || mi > 59) return null;
+        return { h: h, mi: mi };
+      }
+
+      function dayDiff(a, b) {
+        return Math.round((Date.UTC(a.year, a.month - 1, a.day) - Date.UTC(b.year, b.month - 1, b.day)) / DAY);
+      }
+
+      function el(tag, className, text) {
+        var node = document.createElement(tag);
+        if (className) node.className = className;
+        if (text != null) node.textContent = text;
+        return node;
+      }
+
+      function buildCard(zone, instant, hostTz, hostWall) {
+        var tz = zone.tz;
+        var wall = wallFields(instant, tz);
+        var offset = offsetAt(instant, tz);
+        var date = new Date(instant);
+
+        var card = el('article', 'card tz-card' + (tz === hostTz ? ' host' : ''));
+        card.setAttribute('data-tz', tz);
+        card.appendChild(el('h3', 'city', zone.city));
+        card.appendChild(el('div', 'zone', tz));
+        card.appendChild(el('div', 'time', new Intl.DateTimeFormat(undefined, {
+          timeZone: tz, hour: 'numeric', minute: '2-digit'
+        }).format(date)));
+        card.appendChild(el('div', 'date', new Intl.DateTimeFormat(undefined, {
+          timeZone: tz, weekday: 'long', month: 'short', day: 'numeric', year: 'numeric'
+        }).format(date)));
+
+        var badges = el('div', 'badges');
+        if (tz === hostTz) badges.appendChild(el('span', 'badge host', 'Host'));
+        badges.appendChild(el('span', 'badge', formatOffset(offset)));
+        var dst = isDstAt(instant, tz);
+        badges.appendChild(el('span', 'badge' + (dst ? ' dst' : ''), dst ? 'DST in effect' : 'Standard time'));
+
+        var diff = dayDiff(wall, hostWall);
+        if (diff !== 0) {
+          badges.appendChild(el('span', 'badge day',
+            (diff > 0 ? '+' : '') + diff + ' day' + (Math.abs(diff) === 1 ? '' : 's')));
+        }
+
+        var friendly = wall.hour >= 7 && wall.hour < 22;
+        badges.appendChild(el('span', 'badge ' + (friendly ? 'good' : 'bad'),
+          friendly ? '☕ Good hour to sip' : '🌙 Late night'));
+        card.appendChild(badges);
+        return card;
+      }
+
+      function render() {
+        grid.textContent = '';
+        var hostTz = hostTzSelect.value;
+
+        if (!dateInput.value || !timeInput.value) {
+          setStatus('error', 'Please choose both a date and a start time.');
+          return false;
+        }
+        var date = parseDate(dateInput.value);
+        if (!date) {
+          setStatus('error', 'That date is not valid. Use a real calendar date between 1900 and 2100.');
+          return false;
+        }
+        var time = parseTime(timeInput.value);
+        if (!time) {
+          setStatus('error', 'That time is not valid. Use a 24-hour HH:MM time.');
+          return false;
+        }
+        if (!hostTz || !isValidTimeZone(hostTz)) {
+          setStatus('error', 'Please choose a valid host time zone.');
+          return false;
+        }
+
+        var instants = wallTimeToInstants(date.y, date.mo, date.d, time.h, time.mi, hostTz);
+        var label = zoneLabel(hostTz);
+
+        if (instants.length === 0) {
+          setStatus('error', timeInput.value + ' on ' + dateInput.value + ' does not exist in ' + label +
+            ' — clocks spring forward for daylight saving time and skip that hour. Please pick a different time.');
+          timeInput.setAttribute('aria-invalid', 'true');
+          return false;
+        }
+        timeInput.removeAttribute('aria-invalid');
+
+        var instant = instants[0];
+        if (instants.length > 1) {
+          setStatus('warning', timeInput.value + ' occurs twice in ' + label +
+            ' on this date because clocks fall back. Showing the first occurrence (' +
+            formatOffset(offsetAt(instants[0], hostTz)) + '); consider choosing an unambiguous time.');
+        } else {
+          setStatus('ok', 'Tasting starts ' + timeInput.value + ' ' + label + ' time (' +
+            formatOffset(offsetAt(instant, hostTz)) + ') — ' + new Date(instant).toISOString().replace('.000', '') + '.');
+        }
+
+        var hostWall = wallFields(instant, hostTz);
+        var zones = ZONES.filter(function (z) { return isValidTimeZone(z.tz); });
+        if (!zones.some(function (z) { return z.tz === hostTz; })) {
+          zones.unshift({ tz: hostTz, city: label });
+        }
+        // Host first, then everyone else in chronological wall-clock order.
+        zones.sort(function (a, b) {
+          if (a.tz === hostTz) return -1;
+          if (b.tz === hostTz) return 1;
+          return offsetAt(instant, a.tz) - offsetAt(instant, b.tz);
+        });
+
+        var frag = document.createDocumentFragment();
+        zones.forEach(function (z) { frag.appendChild(buildCard(z, instant, hostTz, hostWall)); });
+        grid.appendChild(frag);
+        return true;
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        render();
+      });
+      [dateInput, timeInput, hostTzSelect].forEach(function (input) {
+        input.addEventListener('change', render);
+        input.addEventListener('input', render);
+      });
+
+      populateHostSelect();
+      setDefaults();
+      render();
+
+      // Exposed for testing/debugging.
+      window.TastingTz = { wallTimeToInstants: wallTimeToInstants, offsetAt: offsetAt, isDstAt: isDstAt, render: render };
+    })();
+  </script>
 </body>
 
