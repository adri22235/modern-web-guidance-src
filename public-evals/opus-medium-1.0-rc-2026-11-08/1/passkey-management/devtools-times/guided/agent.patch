@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { json, sanitizeName, signIn, signOut } from '../../../lib/account';
+
+// Establishes a local session after the reader signs in with the auth service.
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+  const { username } = await request.json().catch(() => ({}));
+  const name = sanitizeName(username);
+  if (!name) return json({ error: 'A valid username is required.' }, 400);
+
+  const user = await signIn(session, name);
+  return json({ name: user.name, displayName: user.displayName });
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  if (session) signOut(session);
+  return json({ success: true });
+};
