+---
+import Layout from '../layouts/Layout.astro';
+import ProfileSettings from '../components/ProfileSettings';
+import PasskeyManager from '../components/PasskeyManager';
+import { getCurrentUser } from '../lib/account';
+
+const user = await getCurrentUser(Astro.session);
+if (!user) {
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin`);
+}
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <div class="max-w-2xl mx-auto space-y-8">
+      <div class="flex flex-wrap items-end justify-between gap-4">
+        <div>
+          <h1 class="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p class="mt-1 text-sm text-gray-600">Signed in as <strong>{user.name}</strong></p>
+        </div>
+        <button
+          type="button"
+          id="sign-out"
+          class="text-sm font-semibold py-2 px-3 rounded border border-gray-300 bg-white hover:bg-gray-50"
+        >
+          Sign out
+        </button>
+      </div>
+
+      <ProfileSettings client:load name={user.name} displayName={user.displayName} />
+      <PasskeyManager client:load />
+    </div>
+  </div>
+</Layout>
+
+<script>
+  document.addEventListener('astro:page-load', () => {
+    document.getElementById('sign-out')?.addEventListener('click', async () => {
+      await fetch(`${import.meta.env.BASE_URL}api/account/session`, { method: 'DELETE' });
+      window.location.assign(import.meta.env.BASE_URL);
+    });
+  });
+</script>
diff --git a/src/pages/api/account/passkeys/[id].ts b/src/pages/api/account/passkeys/[id].ts
new file mode 100644
index 0000000..bc67743
--- /dev/null
+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { getCurrentUser, getPasskeys, json, sanitizeName, savePasskeys, unauthorized } from '../../../../lib/account';
+
+// Renames a passkey. This is a server-side label only, so no Signal API call is needed.
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!session || !user) return unauthorized();
+
+  const { name } = await request.json().catch(() => ({}));
+  const nickname = sanitizeName(name);
+  if (!nickname) return json({ error: 'Enter a name between 1 and 64 characters.' }, 400);
+
+  const passkeys = await getPasskeys(session);
+  const credential = passkeys.find((passkey) => passkey.id === params.id);
+  if (!credential) return json({ error: 'Passkey not found.' }, 404);
+
+  credential.name = nickname;
+  savePasskeys(session, passkeys);
+  return json(credential);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getCurrentUser(session);
+  if (!session || !user) return unauthorized();
+
+  const passkeys = await getPasskeys(session);
+  const remaining = passkeys.filter((passkey) => passkey.id !== params.id);
+  if (remaining.length === passkeys.length) return json({ error: 'Passkey not found.' }, 404);
+
+  savePasskeys(session, remaining);
+  return json({ success: true });
+};
