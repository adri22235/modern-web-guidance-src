diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..10fbfa2
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,287 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { getProviderName } from '../lib/aaguids';
+import { signalAcceptedCredentials } from '../lib/passkey-signals';
+
+interface Passkey {
+  id: string;
+  name?: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface PasskeyList {
+  rpId: string;
+  userId: string;
+  credentials: Passkey[];
+}
+
+const API_BASE = `${import.meta.env.BASE_URL}api/account/passkeys`;
+const MAX_NAME_LENGTH = 64;
+
+const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+function passkeyLabel(passkey: Passkey) {
+  return passkey.name || getProviderName(passkey.aaguid);
+}
+
+async function fetchPasskeys(): Promise<PasskeyList> {
+  const response = await fetch(API_BASE, { headers: { Accept: 'application/json' } });
+  if (!response.ok) throw new Error(`Failed to load passkeys (${response.status})`);
+  return response.json();
+}
+
+export default function PasskeyManager() {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState('');
+  const [selected, setSelected] = useState<Passkey | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [renameError, setRenameError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const renameDialogRef = useRef<HTMLDialogElement>(null);
+  const deleteDialogRef = useRef<HTMLDialogElement>(null);
+  const renameInputRef = useRef<HTMLInputElement>(null);
+
+  // Reload from the server and tell the passkey provider which credentials remain valid.
+  const refresh = useCallback(async () => {
+    const { rpId, userId, credentials } = await fetchPasskeys();
+    setPasskeys(credentials);
+    await signalAcceptedCredentials(rpId, userId, credentials.map((c) => c.id));
+  }, []);
+
+  useEffect(() => {
+    refresh().catch(() => setError('We couldn’t load your passkeys. Please reload the page to try again.'));
+  }, [refresh]);
+
+  const openRename = (passkey: Passkey) => {
+    setSelected(passkey);
+    setRenameValue(passkeyLabel(passkey));
+    setRenameError(null);
+    renameDialogRef.current?.showModal();
+    // showModal() focuses the first field; select its text so it's easy to replace.
+    requestAnimationFrame(() => renameInputRef.current?.select());
+  };
+
+  const openDelete = (passkey: Passkey) => {
+    setSelected(passkey);
+    deleteDialogRef.current?.showModal();
+  };
+
+  const handleRename = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (!selected) return;
+    const name = renameValue.trim();
+    if (!name) {
+      setRenameError('Enter a name for this passkey.');
+      return;
+    }
+
+    setBusy(true);
+    setRenameError(null);
+    try {
+      const response = await fetch(`${API_BASE}/${encodeURIComponent(selected.id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) {
+        const data = await response.json().catch(() => ({}));
+        setRenameError(data.error || 'Couldn’t rename this passkey. Please try again.');
+        return;
+      }
+      // Renaming is a server-side label only; it doesn't change anything the provider stores.
+      const updated: Passkey = await response.json();
+      setPasskeys((current) => current?.map((p) => (p.id === updated.id ? updated : p)) ?? null);
+      setStatus(`Passkey renamed to “${updated.name}”.`);
+      renameDialogRef.current?.close();
+    } catch {
+      setRenameError('Couldn’t rename this passkey. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleDeleteClose = async () => {
+    const dialog = deleteDialogRef.current;
+    if (!dialog || !selected) return;
+    const choice = dialog.returnValue;
+    dialog.returnValue = '';
+    if (choice !== 'delete') return;
+
+    const label = passkeyLabel(selected);
+    setBusy(true);
+    setError(null);
+    try {
+      const response = await fetch(`${API_BASE}/${encodeURIComponent(selected.id)}`, { method: 'DELETE' });
+      if (!response.ok) throw new Error(`Delete failed (${response.status})`);
+      await refresh();
+      setStatus(`Passkey “${label}” removed.`);
+    } catch {
+      setError(`Couldn’t remove “${label}”. Please try again.`);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+      <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+        Passkeys
+      </h2>
+      <p className="mt-1 text-sm text-gray-600">
+        Passkeys let you sign in with your fingerprint, face, screen lock or security key. Remove any you no longer
+        use. We’ll ask your password manager to forget them too, where supported.
+      </p>
+
+      <p className="sr-only" role="status" aria-live="polite">
+        {status}
+      </p>
+      {status && (
+        <div className="mt-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" aria-hidden="true">
+          {status}
+        </div>
+      )}
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {passkeys === null && !error && <p className="mt-6 text-sm text-gray-500">Loading your passkeys…</p>}
+
+      {passkeys?.length === 0 && (
+        <p className="mt-6 text-sm text-gray-500">No passkeys found. You haven’t registered any passkeys yet.</p>
+      )}
+
+      {passkeys && passkeys.length > 0 && (
+        <ul className="mt-6 divide-y divide-gray-200 border-y border-gray-200">
+          {passkeys.map((passkey) => {
+            const label = passkeyLabel(passkey);
+            const provider = getProviderName(passkey.aaguid);
+            return (
+              <li key={passkey.id} className="flex flex-wrap items-center gap-4 py-4">
+                <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
+                  <KeyIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+                </span>
+                <div className="min-w-0 flex-1">
+                  <p className="font-semibold text-gray-900 break-words">{label}</p>
+                  {passkey.name && passkey.name !== provider && <p className="text-sm text-gray-600">{provider}</p>}
+                  <p className="text-xs text-gray-500">
+                    Created {dateFormatter.format(passkey.registeredAt)}
+                    {' · '}
+                    {passkey.lastUsedAt ? `Last used ${dateFormatter.format(passkey.lastUsedAt)}` : 'Never used'}
+                  </p>
+                </div>
+                <div className="flex items-center gap-2">
+                  <button
+                    type="button"
+                    onClick={() => openRename(passkey)}
+                    disabled={busy}
+                    className="inline-flex items-center gap-1 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-50"
+                  >
+                    <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                    Rename<span className="sr-only"> {label}</span>
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => openDelete(passkey)}
+                    disabled={busy}
+                    className="inline-flex items-center gap-1 rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-600 disabled:opacity-50"
+                  >
+                    <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                    Remove<span className="sr-only"> {label}</span>
+                  </button>
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      <dialog
+        ref={renameDialogRef}
+        aria-labelledby="rename-passkey-title"
+        className="account-dialog m-auto w-full max-w-md rounded-lg p-6 shadow-xl"
+      >
+        <h3 id="rename-passkey-title" className="text-lg font-bold text-gray-900">
+          Rename passkey
+        </h3>
+        <form onSubmit={handleRename} className="mt-4 space-y-4" noValidate>
+          <div>
+            <label htmlFor="rename-passkey-input" className="block text-sm font-medium text-gray-700 mb-1">
+              Passkey name
+            </label>
+            <input
+              ref={renameInputRef}
+              id="rename-passkey-input"
+              type="text"
+              value={renameValue}
+              onChange={(e) => setRenameValue(e.target.value)}
+              maxLength={MAX_NAME_LENGTH}
+              required
+              autoComplete="off"
+              aria-invalid={renameError ? true : undefined}
+              aria-describedby={renameError ? 'rename-passkey-error' : undefined}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            {renameError && (
+              <p id="rename-passkey-error" className="mt-1 text-sm text-red-700">
+                {renameError}
+              </p>
+            )}
+          </div>
+          <div className="flex justify-end gap-2">
+            <button
+              type="button"
+              onClick={() => renameDialogRef.current?.close()}
+              className="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={busy}
+              className="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-75"
+            >
+              {busy ? 'Saving…' : 'Save'}
+            </button>
+          </div>
+        </form>
+      </dialog>
+
+      <dialog
+        ref={deleteDialogRef}
+        onClose={handleDeleteClose}
+        aria-labelledby="delete-passkey-title"
+        aria-describedby="delete-passkey-description"
+        className="account-dialog m-auto w-full max-w-md rounded-lg p-6 shadow-xl"
+      >
+        <h3 id="delete-passkey-title" className="text-lg font-bold text-gray-900">
+          Remove “{selected ? passkeyLabel(selected) : ''}”?
+        </h3>
+        <p id="delete-passkey-description" className="mt-2 text-sm text-gray-600">
+          You won’t be able to sign in to The DevTools Times with this passkey anymore. If your browser supports it,
+          we’ll also ask your password manager to remove it.
+        </p>
+        {/* "Keep passkey" comes first so showModal() focuses the safe action. */}
+        <form method="dialog" className="mt-6 flex justify-end gap-2">
+          <button
+            value="cancel"
+            className="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
+          >
+            Keep passkey
+          </button>
+          <button
+            value="delete"
+            className="rounded-md bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-600"
+          >
+            Remove
+          </button>
+        </form>
+      </dialog>
+    </section>
+  );
+}
