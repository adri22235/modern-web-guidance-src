+import type { APIRoute } from 'astro';
+import { getCurrentUser, getRpId, json, sanitizeName, unauthorized, updateUser } from '../../../lib/account';
+
+// Updates the reader's username and display name. The client mirrors the change
+// to their passkey provider with PublicKeyCredential.signalCurrentUserDetails().
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!session || !user) return unauthorized();
+
+  const body = await request.json().catch(() => ({}));
+  const name = sanitizeName(body.name);
+  const displayName = sanitizeName(body.displayName);
+  if (!name || !displayName) return json({ error: 'Enter a username and display name between 1 and 64 characters.' }, 400);
+
+  const updated = { ...user, name, displayName };
+  await updateUser(session, updated);
+  return json({ name, displayName, rpId: getRpId(url), userId: updated.passkeyUserId });
+};
diff --git a/src/pages/api/account/session.ts b/src/pages/api/account/session.ts
