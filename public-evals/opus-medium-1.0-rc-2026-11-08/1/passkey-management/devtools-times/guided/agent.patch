+import type { APIRoute } from 'astro';
+import { getCurrentUser, getPasskeys, getRpId, json, unauthorized } from '../../../../lib/account';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!session || !user) return unauthorized();
+
+  return json({
+    rpId: getRpId(url),
+    userId: user.passkeyUserId,
+    credentials: await getPasskeys(session),
+  });
+};
