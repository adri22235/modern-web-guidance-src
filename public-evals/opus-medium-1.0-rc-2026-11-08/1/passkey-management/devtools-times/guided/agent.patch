@@ -0,0 +1,112 @@
+import React, { useState } from 'react';
+import { signalUserDetails } from '../lib/passkey-signals';
+
+interface ProfileSettingsProps {
+  name: string;
+  displayName: string;
+}
+
+const MAX_NAME_LENGTH = 64;
+
+export default function ProfileSettings(props: ProfileSettingsProps) {
+  const [name, setName] = useState(props.name);
+  const [displayName, setDisplayName] = useState(props.displayName);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setSuccess(null);
+    setLoading(true);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/account/profile`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: name.trim(), displayName: displayName.trim() }),
+      });
+      const data = await response.json();
+
+      if (!response.ok) {
+        setError(data.error || 'Couldn’t save your profile. Please try again.');
+        return;
+      }
+
+      setName(data.name);
+      setDisplayName(data.displayName);
+      setSuccess('Profile saved.');
+      // Keep the account name shown by the reader's password manager up to date.
+      await signalUserDetails(data.rpId, data.userId, data.name, data.displayName);
+    } catch {
+      setError('An unexpected error occurred. Please try again later.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <section aria-labelledby="profile-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+      <h2 id="profile-heading" className="text-xl font-bold text-gray-800">
+        Profile
+      </h2>
+      <p className="mt-1 text-sm text-gray-600">
+        These names also appear in your password manager next to your passkeys.
+      </p>
+
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      {success && (
+        <div className="mt-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {success}
+        </div>
+      )}
+
+      <form onSubmit={handleSubmit} className="mt-4 space-y-4">
+        <div>
+          <label htmlFor="profile-username" className="block text-sm font-medium text-gray-700 mb-1">
+            Username
+          </label>
+          <input
+            type="text"
+            id="profile-username"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            required
+            maxLength={MAX_NAME_LENGTH}
+            autoComplete="username"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+        <div>
+          <label htmlFor="profile-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            type="text"
+            id="profile-display-name"
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            required
+            maxLength={MAX_NAME_LENGTH}
+            autoComplete="name"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+        <button
+          type="submit"
+          disabled={loading}
+          className={`py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            loading ? 'opacity-75 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Saving...' : 'Save profile'}
+        </button>
+      </form>
+    </section>
+  );
+}
