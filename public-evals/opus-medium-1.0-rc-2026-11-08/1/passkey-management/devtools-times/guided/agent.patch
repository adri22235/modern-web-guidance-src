diff --git a/src/lib/aaguids.ts b/src/lib/aaguids.ts
new file mode 100644
index 0000000..d44e5d3
--- /dev/null
+++ b/src/lib/aaguids.ts
@@ -0,0 +1,25 @@
+// A small subset of the community AAGUID registry
+// (https://github.com/passkeydeveloper/passkey-authenticator-aaguids).
+// AAGUIDs are only UX hints for showing which provider holds a passkey.
+// Never use them for security decisions.
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+const providers: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+};
+
+export function getProviderName(aaguid: string): string {
+  if (aaguid === ZERO_AAGUID) return 'Unknown passkey provider';
+  return providers[aaguid] ?? 'Unknown passkey provider';
+}
diff --git a/src/lib/account.ts b/src/lib/account.ts
new file mode 100644
index 0000000..0379d90
--- /dev/null
+++ b/src/lib/account.ts
@@ -0,0 +1,133 @@
+import type { AstroSession } from 'astro';
+
+export interface AccountUser {
+  /** Username (WebAuthn `user.name`). */
+  name: string;
+  /** Human-friendly name (WebAuthn `user.displayName`). */
+  displayName: string;
+  /** WebAuthn user handle, stored as an unpadded Base64URL string. */
+  passkeyUserId: string;
+}
+
+export interface StoredPasskeyCredential {
+  /** Credential ID, stored as an unpadded Base64URL string. */
+  id: string;
+  /** Optional reader-provided nickname. Falls back to the provider name. */
+  name?: string;
+  aaguid: string;
+  /** Epoch milliseconds. */
+  registeredAt: number;
+  /** Epoch milliseconds. */
+  lastUsedAt?: number;
+}
+
+export interface PasskeyListResponse {
+  rpId: string;
+  userId: string;
+  credentials: StoredPasskeyCredential[];
+}
+
+export const MAX_NAME_LENGTH = 64;
+
+const DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * The RP ID must match the `rp.id` used when the passkeys were registered.
+ * Configure it with PASSKEY_RP_ID in production; otherwise fall back to the
+ * host the request was served from.
+ */
+export function getRpId(url: URL): string {
+  return process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+function randomBase64Url(bytes: number): string {
+  return Buffer.from(crypto.getRandomValues(new Uint8Array(bytes))).toString('base64url');
+}
+
+export function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+/** Trims and validates a user-supplied name. Returns null when invalid. */
+export function sanitizeName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  if (!trimmed || trimmed.length > MAX_NAME_LENGTH) return null;
+  return trimmed;
+}
+
+/**
+ * Demo seed data: a few passkeys from common providers so the management UI
+ * has something to show until registration is wired up to a real backend.
+ */
+function seedPasskeys(): StoredPasskeyCredential[] {
+  const now = Date.now();
+  return [
+    {
+      id: randomBase64Url(32),
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: now - 180 * DAY,
+      lastUsedAt: now - 2 * DAY,
+    },
+    {
+      id: randomBase64Url(32),
+      name: 'Work laptop',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      registeredAt: now - 64 * DAY,
+      lastUsedAt: now - 9 * DAY,
+    },
+    {
+      id: randomBase64Url(32),
+      aaguid: '00000000-0000-0000-0000-000000000000',
+      registeredAt: now - 21 * DAY,
+    },
+  ];
+}
+
+export async function getCurrentUser(session: AstroSession | undefined): Promise<AccountUser | null> {
+  return (await session?.get('accountUser')) ?? null;
+}
+
+export async function signIn(session: AstroSession, username: string): Promise<AccountUser> {
+  const existing = await getCurrentUser(session);
+  if (existing && existing.name === username) return existing;
+
+  const user: AccountUser = {
+    name: username,
+    displayName: username,
+    passkeyUserId: randomBase64Url(16),
+  };
+  session.regenerate();
+  session.set('accountUser', user);
+  session.set('passkeys', seedPasskeys());
+  return user;
+}
+
+export function signOut(session: AstroSession) {
+  session.delete('accountUser');
+  session.delete('passkeys');
+}
+
+export async function updateUser(session: AstroSession, user: AccountUser) {
+  session.set('accountUser', user);
+}
+
+export async function getPasskeys(session: AstroSession): Promise<StoredPasskeyCredential[]> {
+  return (await session.get('passkeys')) ?? [];
+}
+
+export function savePasskeys(session: AstroSession, passkeys: StoredPasskeyCredential[]) {
+  session.set('passkeys', passkeys);
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function unauthorized(): Response {
+  return json({ error: 'You need to be signed in.' }, 401);
+}
+
diff --git a/src/lib/passkey-signals.ts b/src/lib/passkey-signals.ts
new file mode 100644
index 0000000..a6b93f9
--- /dev/null
+++ b/src/lib/passkey-signals.ts
@@ -0,0 +1,59 @@
+// Client-side helpers for the WebAuthn Signal API. These keep the reader's
+// password manager in sync with the passkeys stored on our server. Calls are
+// best-effort: unsupported browsers skip them, and failures only warn.
+
+type SignalCapablePublicKeyCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+};
+
+function getPublicKeyCredential(): SignalCapablePublicKeyCredential | undefined {
+  return typeof window !== 'undefined' && window.PublicKeyCredential
+    ? (window.PublicKeyCredential as SignalCapablePublicKeyCredential)
+    : undefined;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+/** Tells the passkey provider which credentials are still valid for this account. */
+export async function signalAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  const pkc = getPublicKeyCredential();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  // Always use the server-provided rpId, never window.location.hostname.
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL IDs are required.');
+    return;
+  }
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+/** Tells the passkey provider about an updated username or display name. */
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  const pkc = getPublicKeyCredential();
+  if (!pkc?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and a valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
