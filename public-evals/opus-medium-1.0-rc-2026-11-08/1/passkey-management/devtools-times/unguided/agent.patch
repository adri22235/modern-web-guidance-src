@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { json } from '../../../lib/auth';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Proxies sign-in to the auth service and, on success, records the reader in the server session.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let response: Response;
+  let data: any;
+  try {
+    response = await fetch(LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+    data = await response.json().catch(() => ({}));
+  } catch {
+    return json({ error: 'Authentication service unavailable' }, 502);
+  }
+
+  if (!response.ok) {
+    return json({ error: data.error || 'Unknown error' }, response.status);
+  }
+
+  // Fresh session ID on privilege change to prevent session fixation.
+  await session?.regenerate();
+  session?.set('user', { username: username.trim() });
+  return json({ username: username.trim() });
+};
