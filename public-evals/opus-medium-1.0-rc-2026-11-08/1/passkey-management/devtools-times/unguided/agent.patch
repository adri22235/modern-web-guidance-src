+import type { APIRoute } from 'astro';
+import { getSessionUser, json } from '../../../lib/auth';
+import { MAX_NAME_LENGTH, getAccount, normalizeName, toPublic } from '../../../lib/passkeys';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const passkey = getAccount(user.username).passkeys.find((p) => p.id === params.id);
+  if (!passkey) return json({ error: 'Passkey not found' }, 404);
+
+  const body = await request.json().catch(() => ({}));
+  const name = normalizeName(body?.name);
+  if (!name) return json({ error: `Name must be 1–${MAX_NAME_LENGTH} characters` }, 400);
+
+  passkey.name = name;
+  return json({ passkey: toPublic(passkey) });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const account = getAccount(user.username);
+  const index = account.passkeys.findIndex((p) => p.id === params.id);
+  if (index === -1) return json({ error: 'Passkey not found' }, 404);
+
+  account.passkeys.splice(index, 1);
+  return json({ acceptedCredentialIds: account.passkeys.map((p) => p.id) });
+};
