diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..67013b6
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,385 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon, PlusIcon, CloudIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  provider: string | null;
+  transports: string[];
+  backupEligible: boolean;
+  backedUp: boolean;
+  createdAt: string;
+}
+
+interface PasskeyUser {
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+// WebAuthn Signal API (Chrome 132+). Not yet in TypeScript's DOM lib.
+type SignalCapablePKC = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+const API = `${import.meta.env.BASE_URL}api/passkeys`;
+const MAX_NAME_LENGTH = 64;
+
+const toBase64url = (buffer: ArrayBuffer) =>
+  btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+const fromBase64url = (value: string) => {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const binary = atob(base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '='));
+  return Uint8Array.from(binary, (c) => c.charCodeAt(0));
+};
+
+function parseCreationOptions(json: any): PublicKeyCredentialCreationOptions {
+  return {
+    ...json,
+    challenge: fromBase64url(json.challenge),
+    user: { ...json.user, id: fromBase64url(json.user.id) },
+    excludeCredentials: json.excludeCredentials.map((c: any) => ({ ...c, id: fromBase64url(c.id) })),
+  };
+}
+
+function serializeRegistration(credential: PublicKeyCredential) {
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const publicKey = response.getPublicKey?.();
+  return {
+    id: credential.id,
+    rawId: toBase64url(credential.rawId),
+    type: credential.type,
+    response: {
+      clientDataJSON: toBase64url(response.clientDataJSON),
+      authenticatorData: toBase64url(response.getAuthenticatorData()),
+      publicKey: publicKey ? toBase64url(publicKey) : undefined,
+      publicKeyAlgorithm: response.getPublicKeyAlgorithm?.(),
+      transports: response.getTransports?.() ?? [],
+    },
+  };
+}
+
+function getSignalApi(): SignalCapablePKC | null {
+  return typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as SignalCapablePKC)
+    : null;
+}
+
+// Tell the browser's passkey provider which credentials the server still accepts, so removed
+// passkeys disappear from autofill / the provider's UI, and the account name stays current.
+async function syncAuthenticator(user: PasskeyUser, acceptedIds: string[]) {
+  const pkc = getSignalApi();
+  if (!pkc) return;
+  const rpId = window.location.hostname;
+  try {
+    await pkc.signalAllAcceptedCredentials?.({ rpId, userId: user.id, allAcceptedCredentialIds: acceptedIds });
+    await pkc.signalCurrentUserDetails?.({ rpId, userId: user.id, name: user.name, displayName: user.displayName });
+  } catch (err) {
+    // Signals are best-effort; the server remains the source of truth.
+    console.warn('Passkey signal failed', err);
+  }
+}
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
+  return data;
+}
+
+const formatDate = (iso: string) =>
+  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function PasskeyManager() {
+  const [user, setUser] = useState<PasskeyUser | null>(null);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [supported, setSupported] = useState(true);
+  const [signalSupported, setSignalSupported] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [newName, setNewName] = useState('');
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      const data = await request<{ user: PasskeyUser; passkeys: Passkey[] }>(API);
+      setUser(data.user);
+      setPasskeys(data.passkeys);
+      // Only signal after a successful fetch: the list is then authoritative.
+      await syncAuthenticator(data.user, data.passkeys.map((p) => p.id));
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    const pkc = getSignalApi();
+    setSupported(Boolean(pkc && navigator.credentials?.create));
+    setSignalSupported(Boolean(pkc?.signalAllAcceptedCredentials));
+    load();
+  }, [load]);
+
+  const clearMessages = () => {
+    setError(null);
+    setNotice(null);
+  };
+
+  const handleCreate = async (e: React.FormEvent) => {
+    e.preventDefault();
+    clearMessages();
+    setCreating(true);
+    try {
+      const options = await request<any>(`${API}/register-options`, { method: 'POST' });
+      const credential = (await navigator.credentials.create({
+        publicKey: parseCreationOptions(options),
+      })) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created');
+
+      const { passkey } = await request<{ passkey: Passkey }>(`${API}/register`, {
+        method: 'POST',
+        body: JSON.stringify({ name: newName, credential: serializeRegistration(credential) }),
+      });
+      const next = [...passkeys, passkey];
+      setPasskeys(next);
+      setNewName('');
+      setNotice(`“${passkey.name}” was added.`);
+      if (user) await syncAuthenticator(user, next.map((p) => p.id));
+    } catch (err) {
+      const { name, message } = err as Error;
+      if (name === 'NotAllowedError') setError('Passkey creation was cancelled.');
+      else if (name === 'InvalidStateError') setError('This device already has a passkey for your account.');
+      else setError(message);
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const startEditing = (passkey: Passkey) => {
+    clearMessages();
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    clearMessages();
+    setBusyId(id);
+    try {
+      const { passkey } = await request<{ passkey: Passkey }>(`${API}/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        body: JSON.stringify({ name: editName }),
+      });
+      setPasskeys((list) => list.map((p) => (p.id === id ? passkey : p)));
+      setEditingId(null);
+      setNotice('Passkey name updated.');
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleDelete = async (passkey: Passkey) => {
+    clearMessages();
+    setBusyId(passkey.id);
+    try {
+      const { acceptedCredentialIds } = await request<{ acceptedCredentialIds: string[] }>(
+        `${API}/${encodeURIComponent(passkey.id)}`,
+        { method: 'DELETE' },
+      );
+      setPasskeys((list) => list.filter((p) => p.id !== passkey.id));
+      setConfirmDeleteId(null);
+      if (user) await syncAuthenticator(user, acceptedCredentialIds);
+      setNotice(
+        signalSupported
+          ? `“${passkey.name}” was removed and your browser was asked to forget it.`
+          : `“${passkey.name}” was removed. You may also want to delete it from your password manager.`,
+      );
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="p-6 border-b border-gray-200">
+        <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800 flex items-center gap-2">
+          <KeyIcon className="h-6 w-6" aria-hidden="true" />
+          Passkeys
+        </h2>
+        <p className="mt-1 text-sm text-gray-600">
+          Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.
+          {signalSupported && ' Changes here are automatically synced to your browser’s passkey provider.'}
+        </p>
+      </div>
+
+      <div className="p-6 space-y-4">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && (
+          <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            {notice}
+          </div>
+        )}
+
+        {loading ? (
+          <p className="text-sm text-gray-500">Loading passkeys…</p>
+        ) : passkeys.length === 0 ? (
+          <p className="text-sm text-gray-500">You haven’t registered any passkeys yet.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {passkeys.map((passkey) => {
+              const busy = busyId === passkey.id;
+              const SyncIcon = passkey.backupEligible ? CloudIcon : DevicePhoneMobileIcon;
+              return (
+                <li key={passkey.id} className="p-4 flex flex-col sm:flex-row sm:items-center gap-3">
+                  <SyncIcon className="h-6 w-6 text-gray-500 shrink-0" aria-hidden="true" />
+                  <div className="flex-1 min-w-0">
+                    {editingId === passkey.id ? (
+                      <form onSubmit={(e) => handleRename(e, passkey.id)} className="flex flex-wrap gap-2">
+                        <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                          Passkey name
+                        </label>
+                        <input
+                          id={`rename-${passkey.id}`}
+                          type="text"
+                          value={editName}
+                          onChange={(e) => setEditName(e.target.value)}
+                          maxLength={MAX_NAME_LENGTH}
+                          required
+                          autoFocus
+                          className="flex-1 min-w-0 px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                        />
+                        <button
+                          type="submit"
+                          disabled={busy || !editName.trim()}
+                          className="px-3 py-1.5 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800 disabled:opacity-60"
+                        >
+                          {busy ? 'Saving…' : 'Save'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setEditingId(null)}
+                          className="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50"
+                        >
+                          Cancel
+                        </button>
+                      </form>
+                    ) : (
+                      <>
+                        <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                        <p className="text-xs text-gray-500">
+                          {[
+                            passkey.provider,
+                            passkey.backupEligible ? 'Synced passkey' : 'Device-bound passkey',
+                            `Added ${formatDate(passkey.createdAt)}`,
+                          ]
+                            .filter(Boolean)
+                            .join(' · ')}
+                        </p>
+                      </>
+                    )}
+                  </div>
+
+                  {editingId !== passkey.id && (
+                    <div className="flex gap-2 shrink-0">
+                      {confirmDeleteId === passkey.id ? (
+                        <>
+                          <span className="self-center text-sm text-gray-700">Remove?</span>
+                          <button
+                            type="button"
+                            onClick={() => handleDelete(passkey)}
+                            disabled={busy}
+                            className="px-3 py-1.5 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 disabled:opacity-60"
+                          >
+                            {busy ? 'Removing…' : 'Remove'}
+                          </button>
+                          <button
+                            type="button"
+                            onClick={() => setConfirmDeleteId(null)}
+                            className="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50"
+                          >
+                            Cancel
+                          </button>
+                        </>
+                      ) : (
+                        <>
+                          <button
+                            type="button"
+                            onClick={() => startEditing(passkey)}
+                            className="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50"
+                            aria-label={`Rename ${passkey.name}`}
+                          >
+                            <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                            Rename
+                          </button>
+                          <button
+                            type="button"
+                            onClick={() => {
+                              clearMessages();
+                              setConfirmDeleteId(passkey.id);
+                            }}
+                            className="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-red-700 border border-red-200 rounded-md hover:bg-red-50"
+                            aria-label={`Remove ${passkey.name}`}
+                          >
+                            <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                            Remove
+                          </button>
+                        </>
+                      )}
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        )}
+
+        {supported ? (
+          <form onSubmit={handleCreate} className="flex flex-col sm:flex-row gap-2 pt-2">
+            <label htmlFor="new-passkey-name" className="sr-only">
+              Name for new passkey (optional)
+            </label>
+            <input
+              id="new-passkey-name"
+              type="text"
+              value={newName}
+              onChange={(e) => setNewName(e.target.value)}
+              maxLength={MAX_NAME_LENGTH}
+              placeholder="Name (optional), e.g. Work laptop"
+              className="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button
+              type="submit"
+              disabled={creating || loading || !user}
+              className="inline-flex items-center justify-center gap-1 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+            >
+              <PlusIcon className="h-4 w-4" aria-hidden="true" />
+              {creating ? 'Waiting for authenticator…' : 'Add a passkey'}
+            </button>
+          </form>
+        ) : (
+          <p className="text-sm text-gray-500">This browser doesn’t support passkeys.</p>
+        )}
+      </div>
+    </section>
+  );
+}
