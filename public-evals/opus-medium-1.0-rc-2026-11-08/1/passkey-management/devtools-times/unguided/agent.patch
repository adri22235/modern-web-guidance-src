+import type { APIRoute } from 'astro';
+import { getSessionUser, json } from '../../../lib/auth';
+import { MAX_PASSKEYS, getAccount, newChallenge } from '../../../lib/passkeys';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export const POST: APIRoute = async ({ session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const account = getAccount(user.username);
+  if (account.passkeys.length >= MAX_PASSKEYS) {
+    return json({ error: `You can register up to ${MAX_PASSKEYS} passkeys` }, 409);
+  }
+
+  const challenge = newChallenge();
+  session?.set('passkeyChallenge', { value: challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+
+  // PublicKeyCredentialCreationOptionsJSON; rp.id is omitted so the browser uses the current host.
+  return json({
+    challenge,
+    rp: { name: 'The DevTools Times' },
+    user: { id: account.userId, name: user.username, displayName: user.username },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -8 },
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 },
+    ],
+    excludeCredentials: account.passkeys.map((p) => ({ type: 'public-key', id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+    attestation: 'none',
+    timeout: CHALLENGE_TTL_MS,
+  });
+};
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..6993f7f
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,86 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json } from '../../../lib/auth';
+import {
+  MAX_PASSKEYS,
+  getAccount,
+  normalizeName,
+  parseAuthenticatorData,
+  providerName,
+  sha256,
+  toPublic,
+  type StoredPasskey,
+} from '../../../lib/passkeys';
+
+const b64url = (value: unknown) => (typeof value === 'string' ? Buffer.from(value, 'base64url') : null);
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const expected = await session?.get('passkeyChallenge');
+  session?.delete('passkeyChallenge');
+  if (!expected || expected.expiresAt < Date.now()) {
+    return json({ error: 'Registration expired, please try again' }, 400);
+  }
+
+  const body = await request.json().catch(() => null);
+  const credential = body?.credential;
+  const clientDataBytes = b64url(credential?.response?.clientDataJSON);
+  const authDataBytes = b64url(credential?.response?.authenticatorData);
+  const rawId = b64url(credential?.rawId);
+  if (!clientDataBytes || !authDataBytes || !rawId || credential.type !== 'public-key') {
+    return json({ error: 'Malformed credential' }, 400);
+  }
+
+  let clientData: any;
+  try {
+    clientData = JSON.parse(clientDataBytes.toString('utf8'));
+  } catch {
+    return json({ error: 'Malformed client data' }, 400);
+  }
+
+  const expectedOrigin = request.headers.get('origin') ?? url.origin;
+  if (clientData.type !== 'webauthn.create' || clientData.challenge !== expected.value) {
+    return json({ error: 'Challenge mismatch' }, 400);
+  }
+  if (clientData.origin !== expectedOrigin) {
+    return json({ error: 'Origin mismatch' }, 400);
+  }
+
+  const rpId = new URL(clientData.origin).hostname;
+  const authData = parseAuthenticatorData(authDataBytes);
+  if (!authData || !authData.rpIdHash.equals(sha256(rpId)) || !authData.userPresent) {
+    return json({ error: 'Invalid authenticator data' }, 400);
+  }
+  if (!authData.credentialId.equals(rawId)) {
+    return json({ error: 'Credential ID mismatch' }, 400);
+  }
+
+  const account = getAccount(user.username);
+  const id = rawId.toString('base64url');
+  if (account.passkeys.some((p) => p.id === id)) {
+    return json({ error: 'This passkey is already registered' }, 409);
+  }
+  if (account.passkeys.length >= MAX_PASSKEYS) {
+    return json({ error: `You can register up to ${MAX_PASSKEYS} passkeys` }, 409);
+  }
+
+  const transports = Array.isArray(credential.response.transports)
+    ? credential.response.transports.filter((t: unknown) => typeof t === 'string')
+    : [];
+  const passkey: StoredPasskey = {
+    id,
+    name: normalizeName(body.name) ?? providerName(authData.aaguid) ?? `Passkey ${account.passkeys.length + 1}`,
+    publicKey: typeof credential.response.publicKey === 'string' ? credential.response.publicKey : null,
+    algorithm: typeof credential.response.publicKeyAlgorithm === 'number' ? credential.response.publicKeyAlgorithm : null,
+    transports,
+    aaguid: authData.aaguid,
+    backupEligible: authData.backupEligible,
+    backedUp: authData.backedUp,
+    rpId,
+    createdAt: new Date().toISOString(),
+  };
+  account.passkeys.push(passkey);
+
+  return json({ passkey: toPublic(passkey) }, 201);
+};
