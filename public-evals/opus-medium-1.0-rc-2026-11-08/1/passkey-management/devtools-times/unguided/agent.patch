--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,17 @@
+export interface SessionUser {
+  username: string;
+}
+
+type SessionLike = { get: (key: string) => Promise<any> } | undefined;
+
+export async function getSessionUser(session: SessionLike): Promise<SessionUser | null> {
+  const user = await session?.get('user');
+  return user && typeof user.username === 'string' ? user : null;
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..3a5b240
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,110 @@
+import { createHash, randomBytes } from 'node:crypto';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  name: string;
+  publicKey: string | null; // base64url SPKI, when the browser exposes it
+  algorithm: number | null;
+  transports: string[];
+  aaguid: string;
+  backupEligible: boolean;
+  backedUp: boolean;
+  rpId: string;
+  createdAt: string;
+}
+
+export interface PasskeyAccount {
+  // WebAuthn user handle (base64url). Random per account so it never leaks the username.
+  userId: string;
+  passkeys: StoredPasskey[];
+}
+
+export type PublicPasskey = Omit<StoredPasskey, 'publicKey'> & { provider: string | null };
+
+export const MAX_PASSKEYS = 20;
+export const MAX_NAME_LENGTH = 64;
+
+// There is no database in this app, so passkeys live in process memory keyed by username.
+// Kept on globalThis so dev-server reloads don't wipe registrations.
+const globalStore = globalThis as typeof globalThis & { __passkeyStore?: Map<string, PasskeyAccount> };
+const store = (globalStore.__passkeyStore ??= new Map<string, PasskeyAccount>());
+
+export function getAccount(username: string): PasskeyAccount {
+  let account = store.get(username);
+  if (!account) {
+    account = { userId: randomBytes(16).toString('base64url'), passkeys: [] };
+    store.set(username, account);
+  }
+  return account;
+}
+
+// Well-known authenticator AAGUIDs, used to label passkeys with their provider.
+const KNOWN_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+};
+
+export function providerName(aaguid: string): string | null {
+  return KNOWN_PROVIDERS[aaguid] ?? null;
+}
+
+export function toPublic(passkey: StoredPasskey): PublicPasskey {
+  const { publicKey: _publicKey, ...rest } = passkey;
+  return { ...rest, provider: providerName(passkey.aaguid) };
+}
+
+export function normalizeName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const name = value.replace(/\s+/g, ' ').trim();
+  if (!name || name.length > MAX_NAME_LENGTH) return null;
+  return name;
+}
+
+export function sha256(value: string | Buffer): Buffer {
+  return createHash('sha256').update(value).digest();
+}
+
+export function newChallenge(): string {
+  return randomBytes(32).toString('base64url');
+}
+
+const FLAG_UP = 0x01;
+const FLAG_BE = 0x08;
+const FLAG_BS = 0x10;
+const FLAG_AT = 0x40;
+
+export interface ParsedAuthData {
+  rpIdHash: Buffer;
+  userPresent: boolean;
+  backupEligible: boolean;
+  backedUp: boolean;
+  aaguid: string;
+  credentialId: Buffer;
+}
+
+// Parses the fixed-layout prefix of WebAuthn authenticator data plus attested credential data.
+export function parseAuthenticatorData(data: Buffer): ParsedAuthData | null {
+  if (data.length < 37) return null;
+  const flags = data[32];
+  if (!(flags & FLAG_AT) || data.length < 55) return null;
+  const hex = data.subarray(37, 53).toString('hex');
+  const aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+  const idLength = data.readUInt16BE(53);
+  if (data.length < 55 + idLength) return null;
+  return {
+    rpIdHash: data.subarray(0, 32),
+    userPresent: Boolean(flags & FLAG_UP),
+    backupEligible: Boolean(flags & FLAG_BE),
+    backedUp: Boolean(flags & FLAG_BS),
+    aaguid,
+    credentialId: data.subarray(55, 55 + idLength),
+  };
+}
