+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --danger: #b71c1c;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    .logo a {
+      color: white;
+      text-decoration: none;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover,
+    nav a[aria-current="page"] {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Page header */
+    .page-header {
+      height: 28vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+        url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .page-header h1 {
+      font-size: 2.4rem;
+    }
+
+    /* Content */
+    .container {
+      max-width: 860px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .panel {
+      background: white;
+      padding: 28px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .panel h2 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .panel-intro {
+      font-size: 0.95rem;
+      margin-bottom: 20px;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 8px 16px;
+      border: none;
+      border-radius: 5px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      text-decoration: none;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .btn:disabled {
+      opacity: 0.6;
+      cursor: not-allowed;
+    }
+
+    .btn-secondary {
+      background: var(--secondary);
+      color: var(--text);
+    }
+
+    .btn-secondary:hover {
+      background: #bcaaa4;
+    }
+
+    .btn-danger {
+      background: var(--danger);
+    }
+
+    .btn-danger:hover {
+      background: #8e0000;
+    }
+
+    .status {
+      padding: 10px 14px;
+      border-radius: 5px;
+      margin-bottom: 16px;
+      font-size: 0.9rem;
+    }
+
+    .status[hidden] {
+      display: none;
+    }
+
+    .status.info {
+      background: #efebe9;
+    }
+
+    .status.success {
+      background: #e8f5e9;
+      color: #1b5e20;
+    }
+
+    .status.error {
+      background: #ffebee;
+      color: var(--danger);
+    }
+
+    .passkey-list {
+      list-style: none;
+    }
+
+    .passkey {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 16px;
+      padding: 16px 0;
+      border-top: 1px solid #eee;
+    }
+
+    .passkey:first-child {
+      border-top: none;
+    }
+
+    .passkey-info {
+      flex: 1;
+      min-width: 0;
+    }
+
+    .passkey-name {
+      font-weight: 600;
+      color: var(--primary);
+      word-break: break-word;
+    }
+
+    .passkey-meta {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .passkey-actions {
+      display: flex;
+      gap: 8px;
+      flex-shrink: 0;
+    }
+
+    .rename-form {
+      display: flex;
+      gap: 8px;
+      flex-wrap: wrap;
+    }
+
+    .rename-form input {
+      flex: 1;
+      min-width: 160px;
+      padding: 7px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      font: inherit;
+    }
+
+    .rename-form input:focus {
+      outline: 2px solid var(--accent);
+      border-color: transparent;
+    }
+
+    .empty {
+      text-align: center;
+      padding: 20px 0;
+      color: #6d4c41;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+
+    @media (max-width: 600px) {
+      .passkey {
+        flex-direction: column;
+        align-items: stretch;
+      }
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="page-header">
+    <h1>My Account</h1>
+    <p id="greeting">Manage how you sign in to The Daily Grind.</p>
+  </header>
+
+  <main class="container">
+    <section class="panel" aria-labelledby="passkeys-heading">
+      <h2 id="passkeys-heading">Passkeys</h2>
+      <p class="panel-intro">
+        Passkeys let you sign in with your fingerprint, face, or device PIN instead of a password.
+        Rename them so you can tell them apart, and remove any you no longer use.
+      </p>
+
+      <div id="status" class="status info" role="status" aria-live="polite">Loading your passkeys…</div>
+
+      <ul id="passkey-list" class="passkey-list"></ul>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    (function () {
+      'use strict';
+
+      // Backend contract (same-origin, session cookie auth):
+      //   GET    /api/account              -> { userId, username, displayName, rpId? }
+      //                                       userId is the WebAuthn user handle, base64url encoded.
+      //   GET    /api/account/passkeys     -> [{ id, name, createdAt, lastUsedAt? }]
+      //                                       id is the credential ID, base64url encoded.
+      //   PATCH  /api/account/passkeys/:id { name } -> updated passkey
+      //   DELETE /api/account/passkeys/:id
+      var API = '/api/account';
+      var MAX_NAME_LENGTH = 64;
+
+      var listEl = document.getElementById('passkey-list');
+      var statusEl = document.getElementById('status');
+      var greetingEl = document.getElementById('greeting');
+
+      var account = null;
+      var passkeys = [];
+
+      function setStatus(message, type) {
+        if (!message) {
+          statusEl.hidden = true;
+          return;
+        }
+        statusEl.hidden = false;
+        statusEl.className = 'status ' + (type || 'info');
+        statusEl.textContent = message;
+      }
+
+      function csrfToken() {
+        var meta = document.querySelector('meta[name="csrf-token"]');
+        if (meta) return meta.content;
+        var match = document.cookie.match(/(?:^|;\s*)(?:XSRF-TOKEN|csrf_token)=([^;]+)/);
+        return match ? decodeURIComponent(match[1]) : null;
+      }
+
+      function api(path, options) {
+        options = options || {};
+        var headers = { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+        if (options.body !== undefined) headers['Content-Type'] = 'application/json';
+        var token = csrfToken();
+        if (token) headers['X-CSRF-Token'] = token;
+
+        return fetch(API + path, {
+          method: options.method || 'GET',
+          credentials: 'same-origin',
+          headers: headers,
+          body: options.body !== undefined ? JSON.stringify(options.body) : undefined
+        }).then(function (res) {
+          if (res.status === 401) {
+            window.location.href = '/login?next=' + encodeURIComponent('/account');
+            throw new Error('Your session has expired. Please sign in again.');
+          }
+          if (!res.ok) {
+            return res.json().catch(function () { return {}; }).then(function (data) {
+              var err = new Error(data.message || data.error || 'Request failed (' + res.status + ').');
+              err.status = res.status;
+              throw err;
+            });
+          }
+          if (res.status === 204) return null;
+          return res.json().catch(function () { return null; });
+        });
+      }
+
+      function formatDate(value) {
+        if (!value) return null;
+        var d = new Date(value);
+        if (isNaN(d.getTime())) return null;
+        return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+      }
+
+      // --- Browser authenticator sync (WebAuthn Signal API) ---------------------
+      // Tells the user's password manager / platform authenticator which passkeys
+      // the server still accepts, so deleted ones disappear from the sign-in
+      // prompt, and keeps the stored account name up to date. Silently skipped in
+      // browsers that don't support it.
+
+      function rpId() {
+        return (account && account.rpId) || window.location.hostname;
+      }
+
+      function signalSupported(method) {
+        return typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof window.PublicKeyCredential[method] === 'function';
+      }
+
+      function syncAcceptedCredentials() {
+        // Only send a list we know is authoritative — an incomplete list would make
+        // the authenticator hide passkeys that are still valid.
+        if (!account || !account.userId || !signalSupported('signalAllAcceptedCredentials')) {
+          return Promise.resolve();
+        }
+        return PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId: rpId(),
+          userId: account.userId,
+          allAcceptedCredentialIds: passkeys.map(function (p) { return p.id; })
+        }).catch(function (err) {
+          console.warn('Could not sync accepted passkeys with authenticator:', err);
+        });
+      }
+
+      function signalRemovedCredential(credentialId) {
+        if (!signalSupported('signalUnknownCredential')) return Promise.resolve();
+        return PublicKeyCredential.signalUnknownCredential({
+          rpId: rpId(),
+          credentialId: credentialId
+        }).catch(function (err) {
+          console.warn('Could not signal removed passkey to authenticator:', err);
+        });
+      }
+
+      function syncUserDetails() {
+        if (!account || !account.userId || !account.username ||
+          !signalSupported('signalCurrentUserDetails')) {
+          return Promise.resolve();
+        }
+        return PublicKeyCredential.signalCurrentUserDetails({
+          rpId: rpId(),
+          userId: account.userId,
+          name: account.username,
+          displayName: account.displayName || account.username
+        }).catch(function (err) {
+          console.warn('Could not sync account details with authenticator:', err);
+        });
+      }
+
+      // --- Rendering ------------------------------------------------------------
+
+      function el(tag, className, text) {
+        var node = document.createElement(tag);
+        if (className) node.className = className;
+        if (text !== undefined) node.textContent = text;
+        return node;
+      }
+
+      function button(label, className, onClick) {
+        var b = el('button', 'btn' + (className ? ' ' + className : ''), label);
+        b.type = 'button';
+        b.addEventListener('click', onClick);
+        return b;
+      }
+
+      function render() {
+        listEl.textContent = '';
+
+        if (passkeys.length === 0) {
+          listEl.appendChild(el('li', 'empty', 'You have no passkeys registered on this account.'));
+          return;
+        }
+
+        passkeys.forEach(function (passkey) {
+          listEl.appendChild(renderPasskey(passkey));
+        });
+      }
+
+      function renderPasskey(passkey) {
+        var item = el('li', 'passkey');
+        item.dataset.id = passkey.id;
+
+        var info = el('div', 'passkey-info');
+        info.appendChild(el('div', 'passkey-name', passkey.name || 'Unnamed passkey'));
+
+        var meta = [];
+        var created = formatDate(passkey.createdAt);
+        var used = formatDate(passkey.lastUsedAt);
+        if (created) meta.push('Added ' + created);
+        meta.push(used ? 'Last used ' + used : 'Never used');
+        info.appendChild(el('div', 'passkey-meta', meta.join(' · ')));
+
+        var actions = el('div', 'passkey-actions');
+        actions.appendChild(button('Rename', 'btn-secondary', function () {
+          showRenameForm(item, passkey);
+        }));
+        actions.appendChild(button('Delete', 'btn-danger', function (e) {
+          deletePasskey(passkey, e.currentTarget);
+        }));
+
+        item.appendChild(info);
+        item.appendChild(actions);
+        return item;
+      }
+
+      function showRenameForm(item, passkey) {
+        var form = el('form', 'rename-form');
+        var input = document.createElement('input');
+        input.type = 'text';
+        input.value = passkey.name || '';
+        input.maxLength = MAX_NAME_LENGTH;
+        input.required = true;
+        input.setAttribute('aria-label', 'Passkey name');
+
+        var save = el('button', 'btn', 'Save');
+        save.type = 'submit';
+        var cancel = button('Cancel', 'btn-secondary', function () {
+          item.replaceWith(renderPasskey(passkey));
+        });
+
+        form.appendChild(input);
+        form.appendChild(save);
+        form.appendChild(cancel);
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var name = input.value.trim();
+          if (!name) {
+            setStatus('Please enter a name for this passkey.', 'error');
+            input.focus();
+            return;
+          }
+          if (name === passkey.name) {
+            item.replaceWith(renderPasskey(passkey));
+            return;
+          }
+          save.disabled = cancel.disabled = input.disabled = true;
+          api('/passkeys/' + encodeURIComponent(passkey.id), { method: 'PATCH', body: { name: name } })
+            .then(function (updated) {
+              passkey.name = (updated && updated.name) || name;
+              item.replaceWith(renderPasskey(passkey));
+              setStatus('Passkey renamed to "' + passkey.name + '".', 'success');
+            })
+            .catch(function (err) {
+              save.disabled = cancel.disabled = input.disabled = false;
+              setStatus('Could not rename passkey: ' + err.message, 'error');
+            });
+        });
+
+        item.textContent = '';
+        item.appendChild(form);
+        input.focus();
+        input.select();
+      }
+
+      function deletePasskey(passkey, trigger) {
+        var label = passkey.name || 'this passkey';
+        var warning = passkeys.length === 1
+          ? '\n\nThis is your only passkey. Make sure you have another way to sign in.'
+          : '';
+        if (!window.confirm('Delete "' + label + '"? You will no longer be able to sign in with it.' + warning)) {
+          return;
+        }
+
+        trigger.disabled = true;
+        api('/passkeys/' + encodeURIComponent(passkey.id), { method: 'DELETE' })
+          .then(function () {
+            passkeys = passkeys.filter(function (p) { return p.id !== passkey.id; });
+            render();
+            setStatus('"' + label + '" was deleted.', 'success');
+            return signalRemovedCredential(passkey.id).then(syncAcceptedCredentials);
+          })
+          .catch(function (err) {
+            trigger.disabled = false;
+            setStatus('Could not delete passkey: ' + err.message, 'error');
+          });
+      }
+
+      // --- Init -----------------------------------------------------------------
+
+      Promise.all([api(''), api('/passkeys')])
+        .then(function (results) {
+          account = results[0] || {};
+          var list = results[1];
+          passkeys = Array.isArray(list) ? list : (list && Array.isArray(list.passkeys) ? list.passkeys : []);
+
+          if (account.displayName || account.username) {
+            greetingEl.textContent = 'Welcome back, ' + (account.displayName || account.username) + '.';
+          }
+
+          setStatus(null);
+          render();
+
+          // Only sync when we received a real list from the server.
+          if (Array.isArray(list) || (list && Array.isArray(list.passkeys))) {
+            syncAcceptedCredentials();
+          }
+          syncUserDetails();
+        })
+        .catch(function (err) {
+          setStatus('We couldn\'t load your passkeys. ' + err.message, 'error');
+        });
+    })();
+  </script>
+
+</body>
+
+</html>
