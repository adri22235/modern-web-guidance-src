diff --git a/account/passkeys.js b/account/passkeys.js
new file mode 100644
index 0000000..9cbcb14
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,213 @@
+import { listCredentials, renameCredential, deleteCredential } from './api.js';
+
+// Small local subset of the community AAGUID registry
+// (github.com/passkeydeveloper/passkey-authenticator-aaguids). Used for UX hints only.
+const AAGUID_PROVIDERS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager', color: '#1a73e8' },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': { name: 'Chrome on Mac', color: '#1a73e8' },
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'iCloud Keychain', color: '#555555' },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': { name: 'iCloud Keychain (Managed)', color: '#555555' },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello', color: '#0078d4' },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': { name: 'Windows Hello', color: '#0078d4' },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': { name: 'Windows Hello', color: '#0078d4' },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password', color: '#0572ec' },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': { name: 'Bitwarden', color: '#175ddc' },
+  '53414d53-554e-4700-0000-000000011111': { name: 'Samsung Pass', color: '#1428a0' },
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': { name: 'YubiKey 5 Series', color: '#2e7d32' },
+};
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const relativeFormat = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+const list = document.getElementById('passkey-list');
+const template = document.getElementById('passkey-row');
+const status = document.getElementById('passkey-status');
+const renameDialog = document.getElementById('rename-dialog');
+const renameInput = document.getElementById('rename-input');
+const deleteDialog = document.getElementById('delete-dialog');
+const deleteName = document.getElementById('delete-name');
+const deleteLastWarning = document.getElementById('delete-last-warning');
+
+let credentials = [];
+let activeCredentialId = null;
+
+// ---- Signal API sync -------------------------------------------------------
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value) {
+  return typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+// Tell the user's passkey provider which credentials the server still accepts, so
+// passkeys deleted here (or elsewhere) disappear from the browser/OS autofill too.
+async function syncAcceptedCredentials(rpId, userId, currentCredentials) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = currentCredentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL IDs are required.');
+    return;
+  }
+  try {
+    // Always the server-provided rpId; never window.location.hostname.
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (error) {
+    // Passive background sync: never break the UI or log as an error.
+    console.warn('signalAllAcceptedCredentials sync warning:', error);
+  }
+}
+
+// ---- Rendering -------------------------------------------------------------
+
+function providerFor(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return null;
+  return AAGUID_PROVIDERS[aaguid.toLowerCase()] ?? null;
+}
+
+function displayName(cred) {
+  return cred.name || providerFor(cred.aaguid)?.name || 'Unknown passkey provider';
+}
+
+function providerIcon(provider) {
+  const letter = provider ? provider.name[0] : '?';
+  const fill = provider ? provider.color : '#8d6e63';
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">` +
+    `<rect width="40" height="40" rx="10" fill="${fill}"/>` +
+    `<text x="20" y="27" font-family="Segoe UI,sans-serif" font-size="20" font-weight="700" ` +
+    `fill="#fff" text-anchor="middle">${letter}</text></svg>`;
+  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
+}
+
+function formatLastUsed(timestamp) {
+  if (!timestamp) return 'Never used';
+  const diffDays = Math.round((timestamp - Date.now()) / (24 * 60 * 60 * 1000));
+  if (diffDays > -7) return `Last used ${relativeFormat.format(diffDays, 'day')}`;
+  return `Last used ${dateFormat.format(timestamp)}`;
+}
+
+function render() {
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+
+  if (credentials.length === 0) {
+    const empty = document.createElement('li');
+    empty.className = 'passkey-empty';
+    empty.textContent = 'No passkeys found. You can add one the next time you sign in.';
+    list.append(empty);
+    return;
+  }
+
+  for (const cred of credentials) {
+    const row = template.content.firstElementChild.cloneNode(true);
+    const provider = providerFor(cred.aaguid);
+    const name = displayName(cred);
+
+    row.dataset.id = cred.id;
+    row.querySelector('.passkey-icon').src = providerIcon(provider);
+    row.querySelector('.passkey-name').textContent = name;
+    row.querySelector('.passkey-provider').textContent =
+      cred.name && provider ? provider.name : '';
+    const registered = row.querySelector('.passkey-registered');
+    registered.textContent = `Added ${dateFormat.format(cred.registeredAt)}`;
+    row.querySelector('.passkey-last-used').textContent = formatLastUsed(cred.lastUsedAt);
+
+    row.querySelector('[data-action="rename"]').setAttribute('aria-label', `Rename ${name}`);
+    row.querySelector('[data-action="delete"]').setAttribute('aria-label', `Delete ${name}`);
+    list.append(row);
+  }
+}
+
+function announce(message, isError = false) {
+  status.textContent = message;
+  status.classList.toggle('is-error', isError);
+}
+
+// ---- Actions ---------------------------------------------------------------
+
+async function load() {
+  try {
+    const { rpId, userId, credentials: fetched } = await listCredentials();
+    credentials = fetched;
+    render();
+    // Sync on every page load so the provider drops passkeys removed on other devices.
+    await syncAcceptedCredentials(rpId, userId, credentials);
+  } catch (error) {
+    list.setAttribute('aria-busy', 'false');
+    list.replaceChildren();
+    announce(`We couldn't load your passkeys. ${error.message}`, true);
+  }
+}
+
+async function performRename(id, name) {
+  try {
+    await renameCredential(id, name);
+    // Re-fetch so the list reflects the server's source of truth. Renaming a
+    // passkey is a server-side label only; it does not need a Signal API call.
+    ({ credentials } = await listCredentials());
+    render();
+    announce(`Passkey renamed to “${name}”.`);
+  } catch (error) {
+    announce(`Couldn't rename passkey. ${error.message}`, true);
+  }
+}
+
+async function performDelete(id) {
+  const name = displayName(credentials.find((c) => c.id === id) ?? {});
+  try {
+    await deleteCredential(id);
+    const { rpId, userId, credentials: remaining } = await listCredentials();
+    credentials = remaining;
+    render();
+    announce(`“${name}” was deleted.`);
+    list.closest('section').querySelector('h2').focus();
+    // Remove the deleted passkey from the browser/OS authenticator as well.
+    await syncAcceptedCredentials(rpId, userId, credentials);
+  } catch (error) {
+    announce(`Couldn't delete passkey. ${error.message}`, true);
+  }
+}
+
+list.addEventListener('click', (event) => {
+  const button = event.target.closest('button[data-action]');
+  if (!button) return;
+  activeCredentialId = button.closest('[data-id]').dataset.id;
+  const cred = credentials.find((c) => c.id === activeCredentialId);
+  if (!cred) return;
+
+  if (button.dataset.action === 'rename') {
+    renameInput.value = displayName(cred);
+    renameInput.setCustomValidity('');
+    renameDialog.showModal();
+    renameInput.select();
+  } else {
+    deleteName.textContent = displayName(cred);
+    deleteLastWarning.hidden = credentials.length > 1;
+    deleteDialog.showModal();
+  }
+});
+
+renameDialog.addEventListener('close', () => {
+  const choice = renameDialog.returnValue;
+  renameDialog.returnValue = '';
+  const name = renameInput.value.trim();
+  const cred = credentials.find((c) => c.id === activeCredentialId);
+  if (choice === 'save' && cred && name && name !== displayName(cred)) {
+    performRename(activeCredentialId, name);
+  }
+});
+
+// Reject whitespace-only names before the dialog form submits.
+renameInput.addEventListener('input', () => {
+  renameInput.setCustomValidity(renameInput.value.trim() ? '' : 'Please enter a name.');
+});
+
+deleteDialog.addEventListener('close', () => {
+  const choice = deleteDialog.returnValue;
+  deleteDialog.returnValue = '';
+  if (choice === 'delete' && activeCredentialId) performDelete(activeCredentialId);
+});
+
+load();
