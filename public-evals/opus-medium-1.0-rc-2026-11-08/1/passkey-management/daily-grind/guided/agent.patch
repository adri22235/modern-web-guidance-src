diff --git a/account/api.js b/account/api.js
new file mode 100644
index 0000000..094ecb2
--- /dev/null
+++ b/account/api.js
@@ -0,0 +1,134 @@
+// Passkey management API client.
+//
+// Talks to the account backend:
+//   GET    /api/credentials      -> { rpId, userId, credentials: [...] }
+//   PUT    /api/credential/:id   -> updated credential   (body: { name })
+//   DELETE /api/credential/:id   -> { success: true }
+//
+// The marketing site is currently served statically, so when those endpoints
+// are unavailable (404 / network error) we fall back to a localStorage-backed
+// mock that mimics the same contract. Credential IDs and the user ID are always
+// unpadded Base64URL strings, as the WebAuthn Signal API requires.
+
+const MOCK_STORAGE_KEY = 'dg-mock-passkeys';
+// Stand-in for the server-configured RP ID. A real backend returns the rp.id it
+// used at registration; the client never derives it from location.hostname.
+const MOCK_RP_ID = 'localhost';
+const MOCK_USER_ID = 'ZGFpbHktZ3JpbmQtdXNlci0xMDI0'; // base64url("daily-grind-user-1024")
+
+const DAY = 24 * 60 * 60 * 1000;
+
+function seedCredentials() {
+  const now = Date.now();
+  return [
+    {
+      id: 'dGVzdC1jcmVkLTE', // base64url("test-cred-1")
+      name: null,
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: now - 210 * DAY,
+      lastUsedAt: now - 2 * 60 * 60 * 1000,
+    },
+    {
+      id: 'dGVzdC1jcmVkLTI', // base64url("test-cred-2")
+      name: 'Work MacBook',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      registeredAt: now - 95 * DAY,
+      lastUsedAt: now - 6 * DAY,
+    },
+    {
+      id: 'dGVzdC1jcmVkLTM', // base64url("test-cred-3")
+      name: null,
+      aaguid: 'cb69481e-8ff7-4039-93ec-0a2729a154a8',
+      registeredAt: now - 400 * DAY,
+      lastUsedAt: null,
+    },
+  ];
+}
+
+const mock = {
+  read() {
+    try {
+      const stored = JSON.parse(localStorage.getItem(MOCK_STORAGE_KEY));
+      if (Array.isArray(stored)) return stored;
+    } catch { /* fall through to seed */ }
+    const seeded = seedCredentials();
+    this.write(seeded);
+    return seeded;
+  },
+  write(credentials) {
+    localStorage.setItem(MOCK_STORAGE_KEY, JSON.stringify(credentials));
+  },
+  list() {
+    return { rpId: MOCK_RP_ID, userId: MOCK_USER_ID, credentials: this.read() };
+  },
+  rename(id, name) {
+    const credentials = this.read();
+    const cred = credentials.find((c) => c.id === id);
+    if (!cred) throw new ApiError('Passkey not found.', 404);
+    cred.name = name;
+    this.write(credentials);
+    return cred;
+  },
+  remove(id) {
+    const credentials = this.read();
+    const remaining = credentials.filter((c) => c.id !== id);
+    if (remaining.length === credentials.length) throw new ApiError('Passkey not found.', 404);
+    this.write(remaining);
+    return { success: true };
+  },
+};
+
+export class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+let useMock = false;
+
+async function request(method, path, body) {
+  const response = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (!response.ok) {
+    let message = `Request failed (${response.status}).`;
+    try {
+      message = (await response.json()).error || message;
+    } catch { /* non-JSON error body */ }
+    throw new ApiError(message, response.status);
+  }
+  return response.json();
+}
+
+function isBackendMissing(error) {
+  // TypeError: network failure; 404/405: endpoint not deployed; SyntaxError: static HTML fallback.
+  return error instanceof TypeError ||
+    error instanceof SyntaxError ||
+    (error instanceof ApiError && (error.status === 404 || error.status === 405));
+}
+
+export async function listCredentials() {
+  if (useMock) return mock.list();
+  try {
+    return await request('GET', '/api/credentials');
+  } catch (error) {
+    if (!isBackendMissing(error)) throw error;
+    console.info('Passkey API unavailable; using local demo data.');
+    useMock = true;
+    return mock.list();
+  }
+}
+
+export async function renameCredential(id, name) {
+  if (useMock) return mock.rename(id, name);
+  return request('PUT', `/api/credential/${encodeURIComponent(id)}`, { name });
+}
+
+export async function deleteCredential(id) {
+  if (useMock) return mock.remove(id);
+  return request('DELETE', `/api/credential/${encodeURIComponent(id)}`);
+}
