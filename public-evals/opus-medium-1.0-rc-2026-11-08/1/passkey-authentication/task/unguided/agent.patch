+  <script>
+    (() => {
+      const form = document.getElementById('signin-form');
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbort = null;
+
+      const setStatus = (text, kind) => {
+        statusEl.textContent = text;
+        statusEl.classList.remove('success', 'error');
+        if (kind) statusEl.classList.add(kind);
+      };
+
+      // --- base64url helpers ---
+      const b64urlToBuffer = (value) => {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
+        const bin = atob(padded);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      };
+
+      const bufferToB64url = (buffer) => {
+        const bytes = new Uint8Array(buffer);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const parseRequestOptions = (json) => {
+        const opts = json && json.publicKey ? json.publicKey : json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(opts);
+        }
+        return {
+          ...opts,
+          challenge: b64urlToBuffer(opts.challenge),
+          allowCredentials: (opts.allowCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') {
+          try {
+            return cred.toJSON();
+          } catch (_) { /* fall through to manual encoding */ }
+        }
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || undefined,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : undefined,
+          },
+        };
+      };
+
+      // --- server calls ---
+      const fetchOptions = async (username) => {
+        const res = await fetch('/api/login/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(username ? { username } : {}),
+        });
+        if (!res.ok) throw new Error(`Could not get sign-in options (${res.status})`);
+        return parseRequestOptions(await res.json());
+      };
+
+      const verifyCredential = async (credential) => {
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(credentialToJSON(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body */ }
+        if (!res.ok || data.verified === false || data.success === false) {
+          throw new Error(data.error || data.message || 'Passkey verification failed');
+        }
+        return data;
+      };
+
+      const onSignedIn = (data) => {
+        const name = data.username || (data.user && (data.user.name || data.user.username)) || usernameField.value.trim();
+        setStatus(name ? `Signed in as ${name}` : 'Signed in', 'success');
+        form.hidden = true;
+      };
+
+      const abortConditional = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort(new DOMException('Superseded by explicit sign-in', 'AbortError'));
+          conditionalAbort = null;
+        }
+      };
+
+      // --- autofill (conditional mediation) ---
+      const startConditional = async () => {
+        if (conditionalAbort || form.hidden) return;
+        if (!window.PublicKeyCredential ||
+            typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function' ||
+            !(await PublicKeyCredential.isConditionalMediationAvailable())) {
+          return;
+        }
+        if (conditionalAbort) return;
+        const controller = new AbortController();
+        conditionalAbort = controller;
+        try {
+          const publicKey = await fetchOptions();
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: 'conditional',
+            signal: controller.signal,
+          });
+          if (!credential) return;
+          setStatus('Verifying passkey…');
+          onSignedIn(await verifyCredential(credential));
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error(err);
+          setStatus(err.message || 'Sign-in failed', 'error');
+        } finally {
+          if (conditionalAbort === controller) conditionalAbort = null;
+        }
+      };
+
+      // --- explicit button (modal biometric prompt) ---
+      const startModal = async () => {
+        if (!window.PublicKeyCredential) {
+          setStatus('Passkeys are not supported in this browser', 'error');
+          return;
+        }
+        abortConditional();
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+        try {
+          const publicKey = await fetchOptions(usernameField.value.trim());
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'required' });
+          if (!credential) throw new Error('No passkey was selected');
+          setStatus('Verifying passkey…');
+          onSignedIn(await verifyCredential(credential));
+        } catch (err) {
+          console.error(err);
+          setStatus(err.name === 'NotAllowedError'
+            ? 'Sign-in was cancelled or timed out'
+            : (err.message || 'Sign-in failed'), 'error');
+          startConditional();
+        } finally {
+          authButton.disabled = false;
+        }
+      };
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        startModal();
+      });
+
+      // Arm autofill as early as possible so suggestions appear on focus,
+      // and re-arm on focus if a previous request has ended.
+      usernameField.addEventListener('focus', startConditional);
+      startConditional();
+    })();
+  </script>
 </body>
 
