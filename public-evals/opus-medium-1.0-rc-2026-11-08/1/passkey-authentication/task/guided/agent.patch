+  <script type="module">
+    const usernameField = document.getElementById('username');
+    const authButton = document.getElementById('auth-button');
+    const authStatus = document.getElementById('auth-status');
+    const form = document.getElementById('signin-form');
+
+    // Lightweight fallbacks for the WebAuthn JSON helpers / capability detection
+    // in browsers that support WebAuthn but not these newer static methods.
+    const b64urlToBuffer = (value) => {
+      const b64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+      return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+    };
+    const bufferToB64url = (buffer) =>
+      btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+    function parseRequestOptions(json) {
+      if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+        return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: b64urlToBuffer(json.challenge),
+        allowCredentials: (json.allowCredentials ?? []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) })),
+      };
+    }
+
+    function credentialToJSON(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      const r = credential.response;
+      return {
+        id: credential.id,
+        rawId: bufferToB64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+        clientExtensionResults: credential.getClientExtensionResults(),
+        response: {
+          clientDataJSON: bufferToB64url(r.clientDataJSON),
+          authenticatorData: bufferToB64url(r.authenticatorData),
+          signature: bufferToB64url(r.signature),
+          userHandle: r.userHandle ? bufferToB64url(r.userHandle) : undefined,
+        },
+      };
+    }
+
+    async function supportsConditionalGet() {
+      if (!window.PublicKeyCredential) return false;
+      if (PublicKeyCredential.getClientCapabilities) {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return capabilities.conditionalGet === true;
+      }
+      return (await PublicKeyCredential.isConditionalMediationAvailable?.()) === true;
+    }
+
+    async function fetchLoginOptions() {
+      const response = await fetch('/api/login/options', {
+        method: 'POST',
+        headers: { Accept: 'application/json' },
+        credentials: 'same-origin',
+      });
+      if (!response.ok) throw new Error(`Failed to load sign-in options (${response.status})`);
+      return parseRequestOptions(await response.json());
+    }
+
+    async function verifyCredential(credential, publicKey) {
+      const encoded = credentialToJSON(credential);
+      let response;
+      try {
+        response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        authStatus.textContent = 'Could not reach the server. Please try again.';
+        return;
+      }
+
+      if (response.ok) {
+        const result = await response.json().catch(() => ({}));
+        const name = result.username ?? result.user?.username ?? result.user?.name;
+        authStatus.textContent = name ? `Signed in as ${name}.` : 'Signed in successfully.';
+        authStatus.dataset.state = 'success';
+        return;
+      }
+
+      if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+        // Passkey no longer exists on the server; let the provider hide it.
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId,
+          credentialId: encoded.id,
+        }).catch(() => {});
+      }
+      authStatus.textContent = response.status === 404
+        ? 'This passkey is not recognized. Please use another sign-in method.'
+        : 'Sign-in failed. Please try again.';
+      authStatus.dataset.state = 'error';
+    }
+
+    let autofillAbortController = new AbortController();
+
+    // Conditional UI: registers passkeys as autofill suggestions on the username field.
+    async function initializeConditionalAutofill() {
+      if (!(await supportsConditionalGet())) return;
+      autofillAbortController = new AbortController();
+      const { signal } = autofillAbortController;
+      try {
+        const publicKey = await fetchLoginOptions();
+        const credential = await navigator.credentials.get({ publicKey, signal, mediation: 'conditional' });
+        await verifyCredential(credential, publicKey);
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    // Explicit button: abort autofill request and prompt for the passkey right away.
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        authStatus.textContent = 'Passkeys are not supported in this browser.';
+        return;
+      }
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+      const { signal } = autofillAbortController;
+
+      authButton.disabled = true;
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchLoginOptions();
+        credential = await navigator.credentials.get({ publicKey, signal });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          authStatus.textContent = 'Passkey sign-in was cancelled.';
+        } else if (err.name !== 'AbortError') {
+          console.error(err);
+          authStatus.textContent = 'Sign-in failed. Please try again.';
+        }
+        authButton.disabled = false;
+        initializeConditionalAutofill(); // Re-arm autofill suggestions
+        return;
+      }
+
+      await verifyCredential(credential, publicKey);
+      authButton.disabled = false;
+    }
+
+    authButton.addEventListener('click', triggerButtonAuthentication);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      triggerButtonAuthentication();
+    });
+
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
