+  <script>
+    (() => {
+      const section = document.querySelector('.seasonal');
+      const grid = section.querySelector('[data-drink-grid]');
+      const restoreBtn = section.querySelector('[data-action="restore"]');
+      const emptyMsg = section.querySelector('[data-empty]');
+      const status = section.querySelector('[data-status]');
+      const ADDONS = ['Oat milk', 'Maple syrup', 'Double shot', 'Extra ice', 'Vanilla sweet cream', 'Cinnamon', 'Caramel drizzle', 'Whipped cream'];
+      const originalOrder = Array.from(grid.children, (slot) => slot.dataset.id);
+      const removedSlots = new Map();
+      const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+      // Scope each transition to its component so the sticky nav and the rest of
+      // the page stay interactive and separate cards can animate concurrently.
+      function runScopedTransition(scopeEl, updateDOM) {
+        if (!supportsScopedTransition) {
+          updateDOM();
+          return;
+        }
+        const transition = scopeEl.startViewTransition(updateDOM);
+        transition.ready.catch(() => {});
+      }
+
+      // moveBefore() keeps focus and state on the moved node; insertBefore() is the fallback.
+      function moveNode(parent, node, before) {
+        if (parent.moveBefore && node.isConnected) parent.moveBefore(node, before);
+        else parent.insertBefore(node, before);
+      }
+
+      function announce(message) {
+        status.textContent = message;
+      }
+
+      const drinkName = (slot) => slot.querySelector('h3').textContent;
+
+      function syncGridState() {
+        const slots = Array.from(grid.children);
+        slots.forEach((slot, i) => {
+          slot.querySelector('[data-action="move-prev"]').disabled = i === 0;
+          slot.querySelector('[data-action="move-next"]').disabled = i === slots.length - 1;
+        });
+        restoreBtn.hidden = removedSlots.size === 0;
+        emptyMsg.hidden = slots.length > 0;
+      }
+
+      function syncAddonOptions(card) {
+        const form = card.querySelector('.addon-form');
+        const select = form.querySelector('select');
+        const chosen = new Set(Array.from(card.querySelectorAll('.addon'), (li) => li.dataset.addon));
+        const available = ADDONS.filter((name) => !chosen.has(name));
+        select.replaceChildren(...available.map((name) => new Option(name, name)));
+        form.toggleAttribute('data-full', available.length === 0);
+      }
+
+      function createAddon(name) {
+        const li = document.createElement('li');
+        li.className = 'addon';
+        li.dataset.addon = name;
+        const label = document.createElement('span');
+        label.textContent = name;
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.className = 'addon-remove';
+        btn.dataset.action = 'remove-addon';
+        btn.setAttribute('aria-label', `Remove ${name}`);
+        btn.textContent = '\u00d7';
+        li.append(label, btn);
+        return li;
+      }
+
+      function moveDrink(slot, direction) {
+        const target = direction < 0 ? slot.previousElementSibling : slot.nextElementSibling?.nextElementSibling ?? null;
+        if (direction > 0 && !slot.nextElementSibling) return;
+        if (direction < 0 && !target) return;
+        const focused = document.activeElement;
+        runScopedTransition(grid, () => {
+          moveNode(grid, slot, target);
+          syncGridState();
+          if (focused && document.activeElement !== focused) {
+            (focused.disabled ? slot.querySelector('.drink-controls button:not(:disabled)') : focused)?.focus();
+          }
+          announce(`${drinkName(slot)} moved to position ${Array.from(grid.children).indexOf(slot) + 1}`);
+        });
+      }
+
+      function removeDrink(slot) {
+        const hadFocus = slot.contains(document.activeElement);
+        const nextFocus =
+          slot.nextElementSibling?.querySelector('.drink-remove') ??
+          slot.previousElementSibling?.querySelector('.drink-remove') ??
+          restoreBtn;
+        runScopedTransition(grid, () => {
+          slot.remove();
+          removedSlots.set(slot.dataset.id, slot);
+          syncGridState();
+          if (hadFocus) nextFocus.focus();
+        });
+        announce(`${drinkName(slot)} removed`);
+      }
+
+      function restoreDrinks() {
+        runScopedTransition(grid, () => {
+          for (const id of originalOrder) {
+            const slot = removedSlots.get(id);
+            if (!slot) continue;
+            // Re-insert before the next original sibling that is still present
+            const laterIds = originalOrder.slice(originalOrder.indexOf(id) + 1);
+            const before = Array.from(grid.children).find((el) => laterIds.includes(el.dataset.id)) ?? null;
+            grid.insertBefore(slot, before);
+          }
+          removedSlots.clear();
+          syncGridState();
+          grid.querySelector('.drink-remove')?.focus();
+        });
+        announce('Removed drinks restored');
+      }
+
+      function removeAddon(card, item) {
+        const hadFocus = item.contains(document.activeElement);
+        const nextFocus =
+          item.nextElementSibling?.querySelector('button') ??
+          item.previousElementSibling?.querySelector('button') ??
+          card.querySelector('.addon-form select');
+        runScopedTransition(card, () => {
+          item.remove();
+          syncAddonOptions(card);
+          if (hadFocus) nextFocus?.focus();
+        });
+        announce(`${item.dataset.addon} removed from ${card.querySelector('h3').textContent}`);
+      }
+
+      function addAddon(card, name) {
+        if (!name) return;
+        runScopedTransition(card, () => {
+          card.querySelector('.addon-list').append(createAddon(name));
+          syncAddonOptions(card);
+          // Keep focus inside the card if the form hides itself once every add-on is chosen
+          if (card.querySelector('.addon-form').hasAttribute('data-full')) {
+            card.querySelector('.addon:last-child button').focus();
+          }
+        });
+        announce(`${name} added to ${card.querySelector('h3').textContent}`);
+      }
+
+      section.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-action]');
+        if (!btn) return;
+        const slot = btn.closest('.drink-slot');
+        switch (btn.dataset.action) {
+          case 'move-prev': return moveDrink(slot, -1);
+          case 'move-next': return moveDrink(slot, 1);
+          case 'remove-drink': return removeDrink(slot);
+          case 'remove-addon': return removeAddon(btn.closest('.drink-card'), btn.closest('.addon'));
+          case 'restore': return restoreDrinks();
+        }
+      });
+
+      section.addEventListener('submit', (event) => {
+        const form = event.target.closest('form[data-action="add-addon"]');
+        if (!form) return;
+        event.preventDefault();
+        addAddon(form.closest('.drink-card'), form.elements.addon.value);
+      });
+
+      grid.querySelectorAll('.drink-card').forEach(syncAddonOptions);
+      syncGridState();
+    })();
+  </script>
+
 </body>
 
