+          const ids = Object.keys(DRINKS);
+          if (!saved || !Array.isArray(saved.order) || !Array.isArray(saved.removed)) return defaultState();
+          const order = saved.order.filter((id) => ids.includes(id));
+          const removed = saved.removed.filter((id) => ids.includes(id) && !order.includes(id));
