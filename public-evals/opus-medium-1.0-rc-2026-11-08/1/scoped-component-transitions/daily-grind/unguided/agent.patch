+          const cards = Object.fromEntries(ids.map((id) => {
+            const c = saved.cards && saved.cards[id];
+            if (!c) return [id, fresh.cards[id]];
+            return [id, {
+              size: SIZES.some((s) => s.key === c.size) ? c.size : 'M',
+              opts: Array.isArray(c.opts) ? [...new Set(c.opts.filter((k) => k in EXTRAS))] : fresh.cards[id].opts,
