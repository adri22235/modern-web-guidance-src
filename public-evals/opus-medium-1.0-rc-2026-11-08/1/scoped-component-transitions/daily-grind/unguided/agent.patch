+      const nestedBusy = (scope) => {
+        for (const el of running.keys()) {
+          if (el !== scope && (el.contains(scope) || scope.contains(el))) return true;
+        }
+        return false;
+      };
+
+      const nameParts = (els) => els.forEach((el) => {
+        el.style.viewTransitionName = 'sf-' + el.dataset.vt;
+        el.style.viewTransitionClass = el.dataset.vtClass || 'part';
