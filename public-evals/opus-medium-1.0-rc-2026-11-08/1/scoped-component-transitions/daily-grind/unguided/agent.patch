+          }
+          case 'size': {
+            const size = btn.dataset.size;
+            if (state.cards[id].size === size) return;
+            commitCard(card, () => { state.cards[id].size = size; });
+            announce(`${name} size set to ${SIZES.find((s) => s.key === size).label}.`);
+            break;
+          }
+          case 'unopt': {
+            const li = btn.closest('.opt');
+            const key = li.dataset.key;
+            const keys = state.cards[id].opts;
+            const pos = keys.indexOf(key);
+            const neighbor = keys[pos + 1] || keys[pos - 1];
+            commitCard(card, () => { state.cards[id].opts = keys.filter((k) => k !== key); }, () => (neighbor
+              ? card.querySelector(`.opt[data-key="${neighbor}"] [data-action="unopt"]`)
+              : card.querySelector('select')));
+            announce(`${EXTRAS[key].label} removed from ${name}.`);
+            break;
+          }
+        }
+      });
+
+      grid.addEventListener('change', (e) => {
+        const select = e.target.closest('select[data-action="add"]');
+        if (!select || !select.value) return;
+        const card = select.closest('.card[data-id]');
+        const id = card.dataset.id;
+        const key = select.value;
+        if (!(key in EXTRAS) || state.cards[id].opts.includes(key)) return;
+        commitCard(card, () => { state.cards[id].opts.push(key); });
+        announce(`${EXTRAS[key].label} added to ${DRINKS[id].name}.`);
+      });
+
+      const firstCardControl = () => grid.querySelector('.card [data-action="remove"]');
+
+      document.getElementById('seasonal-restore').addEventListener('click', () => {
+        const n = state.removed.length;
+        if (!n) return;
+        commitGrid(() => {
+          state.order.push(...state.removed);
+          state.removed = [];
+        }, { focus: firstCardControl });
+        announce(`${n} drink${n > 1 ? 's' : ''} restored.`);
+      });
+
+      document.getElementById('seasonal-reset').addEventListener('click', () => {
+        commitGrid(() => { state = defaultState(); }, { focus: firstCardControl });
+        announce('Seasonal favorites reset.');
+      });
+
+      grid.replaceChildren();
+      renderGrid();
+    })();
+  </script>
 </body>
 
 </html>
