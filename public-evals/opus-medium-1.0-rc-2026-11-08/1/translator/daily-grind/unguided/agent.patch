+  <script>
+    (() => {
+      // Bundled fallback for browsers without the on-device Translator API.
+      const FALLBACK = {
+        es: {
+          seasonal: 'Favoritos de temporada',
+          maple: 'Cremosa leche de avena con un toque de jarabe de arce de Vermont.',
+          espresso: 'Intenso, ahumado y perfecto para un impulso matutino.',
+          coldbrew: 'Infusionado durante 18 horas para una suavidad máxima.',
+          storyTitle: 'Nuestra historia',
+          story1: 'The Daily Grind comenzó en 2012 como un solo carrito frente a una estación de tren, impulsado por un tostador prestado y el amor por el buen café.',
+          story2: 'Hoy trabajamos directamente con pequeñas fincas para obtener nuestros granos, los tostamos en pequeños lotes cada mañana y servimos cada taza como si fuera la primera.'
+        },
+        fr: {
+          seasonal: 'Favoris de saison',
+          maple: "Lait d'avoine onctueux avec une touche de sirop d'érable du Vermont.",
+          espresso: 'Corsé, fumé et parfait pour un coup de fouet matinal.',
+          coldbrew: 'Infusé pendant 18 heures pour une douceur maximale.',
+          storyTitle: 'Notre histoire',
+          story1: "The Daily Grind a commencé en 2012 avec un simple chariot devant une gare, porté par un torréfacteur emprunté et l'amour du bon café.",
+          story2: "Aujourd'hui, nous travaillons directement avec de petites exploitations pour nous approvisionner en grains, que nous torréfions en petites quantités chaque matin, et nous servons chaque tasse comme si c'était la première."
+        },
+        de: {
+          seasonal: 'Saisonale Favoriten',
+          maple: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+          espresso: 'Kräftig, rauchig und perfekt für den morgendlichen Energieschub.',
+          coldbrew: '18 Stunden lang gezogen für maximale Milde.',
+          storyTitle: 'Unsere Geschichte',
+          story1: 'The Daily Grind begann 2012 als einzelner Wagen vor einem Bahnhof, angetrieben von einer geliehenen Röstmaschine und der Liebe zu gutem Kaffee.',
+          story2: 'Heute arbeiten wir direkt mit kleinen Farmen zusammen, rösten unsere Bohnen jeden Morgen in kleinen Chargen und servieren jede Tasse, als wäre es unsere erste.'
+        },
+        ja: {
+          seasonal: '季節のおすすめ',
+          maple: 'クリーミーなオーツミルクに、バーモント産メープルシロップをほんのりと。',
+          espresso: '力強くスモーキー。朝の目覚めにぴったりです。',
+          coldbrew: '18時間かけて抽出し、極上のなめらかさに。',
+          storyTitle: '私たちの物語',
+          story1: 'The Daily Grindは2012年、駅前の小さな屋台から始まりました。借り物の焙煎機と、おいしいコーヒーへの愛情が原動力でした。',
+          story2: '現在は小規模農園と直接取引して豆を仕入れ、毎朝少量ずつ焙煎し、一杯一杯を初めての一杯のように心を込めてお届けしています。'
+        }
+      };
+
+      const SOURCE_LANG = 'en';
+      const STORAGE_KEY = 'dailygrind-lang';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = [...document.querySelectorAll('[data-i18n]')];
+      const originals = new Map(nodes.map(el => [el, el.textContent.trim()]));
+      const hasTranslatorAPI = 'Translator' in self;
+      const translators = new Map();
+      let requestId = 0;
+
+      const setStatus = msg => { status.textContent = msg; };
+
+      async function getTranslator(lang) {
+        if (!hasTranslatorAPI) return null;
+        if (translators.has(lang)) return translators.get(lang);
+        const opts = { sourceLanguage: SOURCE_LANG, targetLanguage: lang };
+        const availability = await Translator.availability(opts);
+        if (availability === 'unavailable') return null;
+        if (availability !== 'available') setStatus('Downloading language pack…');
+        const promise = Translator.create({
+          ...opts,
+          monitor(m) {
+            m.addEventListener('downloadprogress', e => {
+              setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+            });
+          }
+        });
+        translators.set(lang, promise);
+        promise.catch(() => translators.delete(lang));
+        return promise;
+      }
+
+      function apply(lang, texts) {
+        nodes.forEach(el => {
+          el.textContent = texts.get(el);
+          el.lang = lang;
+          el.classList.remove('translating');
+        });
+        document.documentElement.lang = lang;
+      }
+
+      async function translateTo(lang) {
+        const id = ++requestId;
+        if (lang === SOURCE_LANG) {
+          apply(lang, originals);
+          setStatus('');
+          return;
+        }
+
+        nodes.forEach(el => el.classList.add('translating'));
+        setStatus('Translating on your device…');
+        let texts = null;
+
+        try {
+          const translator = await getTranslator(lang);
+          if (translator) {
+            const results = await Promise.all(nodes.map(el => translator.translate(originals.get(el))));
+            texts = new Map(nodes.map((el, i) => [el, results[i]]));
+          }
+        } catch (err) {
+          console.warn('On-device translation failed, using bundled text if available.', err);
+        }
+
+        if (!texts && FALLBACK[lang]) {
+          texts = new Map(nodes.map(el => [el, FALLBACK[lang][el.dataset.i18n] ?? originals.get(el)]));
+        }
+
+        if (id !== requestId) return; // a newer selection superseded this one
+
+        if (texts) {
+          apply(lang, texts);
+          setStatus('');
+        } else {
+          nodes.forEach(el => el.classList.remove('translating'));
+          setStatus('Sorry, that language isn’t available on this device.');
+          select.value = document.documentElement.lang;
+        }
+      }
+
+      // Without the on-device API, only languages with bundled text are usable.
+      if (!hasTranslatorAPI) {
+        [...select.options].forEach(opt => {
+          if (opt.value !== SOURCE_LANG && !FALLBACK[opt.value]) opt.disabled = true;
+        });
+      }
+
+      select.addEventListener('change', () => {
+        localStorage.setItem(STORAGE_KEY, select.value);
+        translateTo(select.value);
+      });
+
+      const saved = localStorage.getItem(STORAGE_KEY);
+      const savedOption = saved && [...select.options].find(o => o.value === saved && !o.disabled);
+      if (savedOption && saved !== SOURCE_LANG) {
+        select.value = saved;
+        translateTo(saved);
+      }
+    })();
+  </script>
