diff --git a/src/components/TranslateButton.tsx b/src/components/TranslateButton.tsx
new file mode 100644
index 0000000..ed55339
--- /dev/null
+++ b/src/components/TranslateButton.tsx
@@ -0,0 +1,324 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+// Languages supported by the built-in Translator API.
+const LANGUAGES: Record<string, string> = {
+  ar: 'Arabic', bg: 'Bulgarian', bn: 'Bengali', cs: 'Czech', da: 'Danish',
+  de: 'German', el: 'Greek', en: 'English', es: 'Spanish', fi: 'Finnish',
+  fr: 'French', hi: 'Hindi', hr: 'Croatian', hu: 'Hungarian', id: 'Indonesian',
+  it: 'Italian', he: 'Hebrew', ja: 'Japanese', kn: 'Kannada', ko: 'Korean',
+  lt: 'Lithuanian', mr: 'Marathi', nl: 'Dutch', no: 'Norwegian', pl: 'Polish',
+  pt: 'Portuguese', ro: 'Romanian', ru: 'Russian', sk: 'Slovak', sl: 'Slovenian',
+  sv: 'Swedish', ta: 'Tamil', te: 'Telugu', th: 'Thai', tr: 'Turkish',
+  uk: 'Ukrainian', vi: 'Vietnamese', zh: 'Chinese', 'zh-Hant': 'Chinese (Traditional)',
+};
+
+const AUTO = 'auto';
+const STORAGE_KEY = 'translate-target-language';
+const TRANSLATABLE_SELECTOR = '[data-translatable]';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'working'; message: string; progress?: number }
+  | { kind: 'translated'; target: string }
+  | { kind: 'error'; message: string };
+
+// Original text per text node, so translations can always start from (and restore to) the source.
+const originals = new Map<Text, string>();
+const originalLangs = new Map<HTMLElement, string | null>();
+
+function collectTextNodes(): Text[] {
+  const nodes: Text[] = [];
+  for (const root of document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR)) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode: (node) =>
+        node.nodeValue?.trim() && !node.parentElement?.closest('script, style, code, pre')
+          ? NodeFilter.FILTER_ACCEPT
+          : NodeFilter.FILTER_REJECT,
+    });
+    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  }
+  return nodes;
+}
+
+function restoreOriginals() {
+  for (const [node, text] of originals) node.nodeValue = text;
+  originals.clear();
+  for (const [el, lang] of originalLangs) {
+    if (lang === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', lang);
+  }
+  originalLangs.clear();
+}
+
+function setElementsLang(lang: string) {
+  for (const el of document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR)) {
+    if (!originalLangs.has(el)) originalLangs.set(el, el.getAttribute('lang'));
+    el.setAttribute('lang', lang);
+  }
+}
+
+function defaultTarget(): string {
+  const saved = localStorage.getItem(STORAGE_KEY);
+  if (saved && saved in LANGUAGES) return saved;
+  const browser = navigator.language;
+  if (browser in LANGUAGES) return browser;
+  const base = browser.split('-')[0];
+  return base in LANGUAGES && base !== 'en' ? base : 'es';
+}
+
+const monitor = (onProgress: (loaded: number) => void) => (m: AICreateMonitor) => {
+  m.addEventListener('downloadprogress', (e) => onProgress(e.loaded));
+};
+
+export default function TranslateButton() {
+  const popoverId = useId();
+  const sourceId = useId();
+  const targetId = useId();
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [source, setSource] = useState(AUTO);
+  const [target, setTarget] = useState('es');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const abortRef = useRef<AbortController | null>(null);
+
+  async function translatePage(sourceLanguage: string, targetLanguage: string, signal: AbortSignal) {
+    // Always translate from the original text, not a previous translation.
+    restoreOriginals();
+    const nodes = collectTextNodes();
+    if (nodes.length === 0) {
+      setStatus({ kind: 'error', message: 'Nothing to translate on this page.' });
+      return;
+    }
+
+    let from = sourceLanguage;
+    if (from === AUTO) {
+      from = await detectLanguage(nodes, signal);
+    }
+    if (from === targetLanguage) {
+      setStatus({ kind: 'error', message: `This page is already in ${LANGUAGES[targetLanguage] ?? targetLanguage}.` });
+      return;
+    }
+
+    const options = { sourceLanguage: from, targetLanguage };
+    const availability = await Translator.availability(options);
+    if (availability === 'unavailable') {
+      setStatus({
+        kind: 'error',
+        message: `Translating ${LANGUAGES[from] ?? from} to ${LANGUAGES[targetLanguage]} isn't available on this device.`,
+      });
+      return;
+    }
+
+    setStatus({ kind: 'working', message: availability === 'available' ? 'Preparing…' : 'Downloading language pack…', progress: 0 });
+    const translator = await Translator.create({
+      ...options,
+      signal,
+      monitor: monitor((loaded) =>
+        setStatus({ kind: 'working', message: 'Downloading language pack…', progress: loaded }),
+      ),
+    });
+
+    try {
+      setElementsLang(targetLanguage);
+      let done = 0;
+      for (const node of nodes) {
+        signal.throwIfAborted();
+        const text = node.nodeValue ?? '';
+        originals.set(node, text);
+        const [, leading, core, trailing] = text.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+        const translated = await translator.translate(core, { signal });
+        node.nodeValue = leading + translated + trailing;
+        done++;
+        setStatus({ kind: 'working', message: 'Translating…', progress: done / nodes.length });
+      }
+      setStatus({ kind: 'translated', target: targetLanguage });
+    } finally {
+      translator.destroy();
+    }
+  }
+
+  async function detectLanguage(nodes: Text[], signal: AbortSignal): Promise<string> {
+    const fallback = document.documentElement.lang || 'en';
+    if (!('LanguageDetector' in self)) return fallback;
+    if ((await LanguageDetector.availability()) === 'unavailable') return fallback;
+
+    setStatus({ kind: 'working', message: 'Detecting language…' });
+    const detector = await LanguageDetector.create({
+      signal,
+      monitor: monitor((loaded) =>
+        setStatus({ kind: 'working', message: 'Downloading language detector…', progress: loaded }),
+      ),
+    });
+    try {
+      // Detection is unreliable on short snippets, so sample a good chunk of text.
+      const sample = nodes.map((n) => n.nodeValue).join(' ').slice(0, 2000);
+      const [best] = await detector.detect(sample, { signal });
+      if (!best || best.confidence < 0.5 || best.detectedLanguage === 'und') return fallback;
+      const lang = best.detectedLanguage;
+      return lang in LANGUAGES ? lang : lang.split('-')[0];
+    } finally {
+      detector.destroy();
+    }
+  }
+
+  async function run(sourceLanguage: string, targetLanguage: string) {
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+    try {
+      await translatePage(sourceLanguage, targetLanguage, controller.signal);
+    } catch (error) {
+      if (controller.signal.aborted) return;
+      console.error('Translation failed:', error);
+      restoreOriginals();
+      setStatus({
+        kind: 'error',
+        message:
+          error instanceof DOMException && error.name === 'NotAllowedError'
+            ? 'Please click "Translate" again to download the language pack.'
+            : 'Translation failed. Please try again.',
+      });
+    }
+  }
+
+  const handleTranslate = () => {
+    localStorage.setItem(STORAGE_KEY, target);
+    run(source, target);
+  };
+
+  const handleRestore = () => {
+    abortRef.current?.abort();
+    restoreOriginals();
+    localStorage.removeItem(STORAGE_KEY);
+    setStatus({ kind: 'idle' });
+  };
+
+  useEffect(() => {
+    const isSupported = 'Translator' in self;
+    setSupported(isSupported);
+    setTarget(defaultTarget());
+    if (!isSupported) return;
+
+    // Keep translating while the reader browses, but only when no download (and thus
+    // no user gesture) is needed.
+    const saved = localStorage.getItem(STORAGE_KEY);
+    if (saved && saved in LANGUAGES) {
+      const from = document.documentElement.lang || 'en';
+      Translator.availability({ sourceLanguage: from, targetLanguage: saved })
+        .then((availability) => {
+          if (availability === 'available' && from !== saved) run(from, saved);
+        })
+        .catch(() => {});
+    }
+
+    return () => {
+      abortRef.current?.abort();
+      originals.clear();
+      originalLangs.clear();
+    };
+  }, []);
+
+  const working = status.kind === 'working';
+  const isTranslated = status.kind === 'translated';
+
+  return (
+    <>
+      <button
+        popoverTarget={popoverId}
+        className={`w-6 h-6 flex items-center justify-center hover:text-amber-400 ${isTranslated ? 'text-amber-500' : 'text-gray-700'}`}
+        aria-label="Translate articles"
+        title="Translate articles"
+      >
+        <LanguageIcon className="h-6 w-6" />
+      </button>
+
+      <div
+        id={popoverId}
+        popover="auto"
+        className="w-80 max-w-[calc(100vw-2rem)] rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-800 shadow-lg"
+      >
+        <h2 className="font-brand text-xl mb-1">Translate articles</h2>
+        <p className="text-xs text-gray-500 mb-3">
+          Runs on your device. Article text never leaves your browser.
+        </p>
+
+        {supported === false ? (
+          <p role="status" className="rounded bg-gray-100 p-3 text-gray-700">
+            On-device translation isn't supported in this browser. Try a recent desktop version of Chrome or Edge.
+          </p>
+        ) : (
+          <form
+            onSubmit={(e) => {
+              e.preventDefault();
+              handleTranslate();
+            }}
+          >
+            <div className="grid grid-cols-2 gap-3 mb-3">
+              <label htmlFor={sourceId} className="flex flex-col gap-1">
+                <span className="text-xs font-semibold text-gray-600">From</span>
+                <select
+                  id={sourceId}
+                  value={source}
+                  onChange={(e) => setSource(e.target.value)}
+                  disabled={working}
+                  className="rounded border border-gray-300 px-2 py-1"
+                >
+                  <option value={AUTO}>Detect language</option>
+                  {Object.entries(LANGUAGES).map(([code, name]) => (
+                    <option key={code} value={code}>{name}</option>
+                  ))}
+                </select>
+              </label>
+              <label htmlFor={targetId} className="flex flex-col gap-1">
+                <span className="text-xs font-semibold text-gray-600">To</span>
+                <select
+                  id={targetId}
+                  value={target}
+                  onChange={(e) => setTarget(e.target.value)}
+                  disabled={working}
+                  className="rounded border border-gray-300 px-2 py-1"
+                >
+                  {Object.entries(LANGUAGES).map(([code, name]) => (
+                    <option key={code} value={code}>{name}</option>
+                  ))}
+                </select>
+              </label>
+            </div>
+
+            <div className="flex gap-2">
+              <button
+                type="submit"
+                disabled={working || supported === null}
+                className="flex-1 rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700 disabled:opacity-50"
+              >
+                {working ? 'Translating…' : 'Translate'}
+              </button>
+              {(isTranslated || working) && (
+                <button
+                  type="button"
+                  onClick={handleRestore}
+                  className="rounded bg-gray-200 px-3 py-2 text-xs font-semibold text-gray-800 hover:bg-gray-300"
+                >
+                  {working ? 'Cancel' : 'Show original'}
+                </button>
+              )}
+            </div>
+
+            <div role="status" aria-live="polite" className="mt-3 min-h-5 text-xs text-gray-600">
+              {working && (
+                <>
+                  <span>{status.message}</span>
+                  {status.progress !== undefined && (
+                    <progress className="mt-1 block w-full accent-amber-400" value={status.progress} max={1} />
+                  )}
+                </>
+              )}
+              {isTranslated && <span>Translated to {LANGUAGES[status.target]}.</span>}
+              {status.kind === 'error' && <span className="text-red-700">{status.message}</span>}
+            </div>
+          </form>
+        )}
+      </div>
+    </>
+  );
+}
