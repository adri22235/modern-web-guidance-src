index 0000000..e23b5b1
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,158 @@
+// On-device translation of page content via Chrome's built-in Translator API.
+// Elements opting in are marked with the `data-translatable` attribute; their
+// text nodes are translated in place so links and inline formatting survive.
+
+export const TRANSLATABLE_SELECTOR = '[data-translatable]';
+export const STORAGE_KEY = 'devtools-times:translate-language';
+
+export const TARGET_LANGUAGES = [
+  'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'tr',
+  'ru', 'uk', 'ar', 'hi', 'bn', 'ja', 'ko', 'zh', 'zh-Hant', 'vi',
+];
+
+const originalText = new WeakMap<Text, string>();
+const originalLang = new WeakMap<Element, string | null>();
+
+export function isTranslationSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && !!self.Translator;
+}
+
+export function languageLabel(code: string, displayIn = 'en'): string {
+  try {
+    return new Intl.DisplayNames([displayIn], { type: 'language' }).of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+function translatableRoots(): HTMLElement[] {
+  // Skip roots nested inside another root so text isn't processed twice.
+  return Array.from(document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR))
+    .filter((el) => !el.parentElement?.closest(TRANSLATABLE_SELECTOR));
+}
+
+function collectTextNodes(root: HTMLElement): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest('script, style, code, pre, [translate="no"]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return node.nodeValue?.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+/** Detects the language of the translatable content, falling back to <html lang>. */
+export async function detectSourceLanguage(): Promise<string> {
+  const fallback = (document.documentElement.lang || 'en').split('-')[0];
+  if (!('LanguageDetector' in self) || !self.LanguageDetector) return fallback;
+  try {
+    // Don't trigger a model download without a user gesture; fall back instead.
+    if ((await self.LanguageDetector.availability()) !== 'available') return fallback;
+    const detector = await self.LanguageDetector.create();
+    try {
+      const sample = translatableRoots().map(originalTextOf).join(' ').replace(/\s+/g, ' ').slice(0, 2000);
+      const [best] = await detector.detect(sample);
+      return best && best.detectedLanguage !== 'und' && best.confidence > 0.5 ? best.detectedLanguage : fallback;
+    } finally {
+      detector.destroy();
+    }
+  } catch {
+    return fallback;
+  }
+}
+
+// Returns the root's original (untranslated) text without mutating the DOM.
+function originalTextOf(root: HTMLElement): string {
+  return collectTextNodes(root).map((node) => originalText.get(node) ?? node.nodeValue ?? '').join(' ');
+}
+
+/** Puts every translated text node back to its original content. */
+export function restoreOriginal(): void {
+  for (const root of translatableRoots()) {
+    for (const node of collectTextNodes(root)) {
+      const original = originalText.get(node);
+      if (original !== undefined) node.nodeValue = original;
+    }
+    if (originalLang.has(root)) {
+      const lang = originalLang.get(root);
+      if (lang == null) root.removeAttribute('lang');
+      else root.setAttribute('lang', lang);
+      originalLang.delete(root);
+    }
+    delete root.dataset.translated;
+  }
+}
+
+export interface TranslateOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+  signal?: AbortSignal;
+  onDownloadProgress?: (fraction: number) => void;
+  onProgress?: (done: number, total: number) => void;
+}
+
+/** Translates all `data-translatable` content on the page on-device. */
+export async function translatePage({
+  sourceLanguage,
+  targetLanguage,
+  signal,
+  onDownloadProgress,
+  onProgress,
+}: TranslateOptions): Promise<void> {
+  if (!self.Translator) throw new Error('On-device translation is not supported in this browser.');
+
+  const availability = await self.Translator.availability({ sourceLanguage, targetLanguage });
+  if (availability === 'unavailable') {
+    throw new Error(
+      `Translation from ${languageLabel(sourceLanguage)} to ${languageLabel(targetLanguage)} is not available on this device.`,
+    );
+  }
+
+  const translator = await self.Translator.create({
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => onDownloadProgress?.(e.loaded));
+    },
+  });
+
+  try {
+    const roots = translatableRoots();
+    const nodes = roots.flatMap(collectTextNodes);
+    // Identical strings (e.g. repeated category labels) are translated only once.
+    const cache = new Map<string, Promise<string>>();
+    let done = 0;
+    onProgress?.(0, nodes.length);
+
+    for (const node of nodes) {
+      signal?.throwIfAborted();
+      if (!originalText.has(node)) originalText.set(node, node.nodeValue ?? '');
+      const original = originalText.get(node)!;
+      const [, leading, text, trailing] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+
+      let pending = cache.get(text);
+      if (!pending) {
+        pending = translator.translate(text, { signal });
+        cache.set(text, pending);
+      }
+      const translated = await pending;
+      signal?.throwIfAborted();
+      node.nodeValue = leading + translated + trailing;
+      onProgress?.(++done, nodes.length);
+    }
+
+    for (const root of roots) {
+      if (!originalLang.has(root)) originalLang.set(root, root.getAttribute('lang'));
+      root.setAttribute('lang', targetLanguage);
+      root.dataset.translated = targetLanguage;
+    }
+  } finally {
+    translator.destroy();
+  }
+}
