diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..5d91694
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,131 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  STORAGE_KEY,
+  TARGET_LANGUAGES,
+  detectSourceLanguage,
+  isTranslationSupported,
+  languageLabel,
+  restoreOriginal,
+  translatePage,
+} from '../utils/translation';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'downloading'; progress: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'error'; message: string };
+
+// Native name first so readers can find their language, e.g. "Deutsch (German)".
+function optionLabel(code: string): string {
+  const native = languageLabel(code, code);
+  const english = languageLabel(code);
+  return native === english ? english : `${native} (${english})`;
+}
+
+export default function TranslateControl() {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [sourceLanguage, setSourceLanguage] = useState('en');
+  const [targetLanguage, setTargetLanguage] = useState('');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const abortRef = useRef<AbortController | null>(null);
+
+  const applyLanguage = async (target: string, source: string) => {
+    abortRef.current?.abort();
+    setTargetLanguage(target);
+
+    if (!target || target === source) {
+      restoreOriginal();
+      localStorage.removeItem(STORAGE_KEY);
+      setStatus({ kind: 'idle' });
+      return;
+    }
+
+    const controller = new AbortController();
+    abortRef.current = controller;
+    try {
+      await translatePage({
+        sourceLanguage: source,
+        targetLanguage: target,
+        signal: controller.signal,
+        onDownloadProgress: (progress) => setStatus({ kind: 'downloading', progress }),
+        onProgress: (done, total) => setStatus({ kind: 'translating', done, total }),
+      });
+      localStorage.setItem(STORAGE_KEY, target);
+      setStatus({ kind: 'idle' });
+    } catch (error) {
+      if (controller.signal.aborted) return;
+      restoreOriginal();
+      setTargetLanguage('');
+      setStatus({ kind: 'error', message: error instanceof Error ? error.message : 'Translation failed.' });
+    }
+  };
+
+  useEffect(() => {
+    const isSupported = isTranslationSupported();
+    setSupported(isSupported);
+    if (!isSupported) return;
+
+    let cancelled = false;
+    (async () => {
+      const source = await detectSourceLanguage();
+      if (cancelled) return;
+      setSourceLanguage(source);
+
+      // Re-apply the reader's preferred language on navigation, but only if the
+      // model is already on the device (downloads require a user gesture).
+      const preferred = localStorage.getItem(STORAGE_KEY);
+      if (!preferred || preferred === source) return;
+      const availability = await self.Translator!.availability({ sourceLanguage: source, targetLanguage: preferred });
+      if (!cancelled && availability === 'available') applyLanguage(preferred, source);
+    })();
+
+    return () => {
+      cancelled = true;
+      abortRef.current?.abort();
+    };
+  }, []);
+
+  const busy = status.kind === 'downloading' || status.kind === 'translating';
+  const statusText =
+    status.kind === 'downloading'
+      ? `Downloading language model… ${Math.round(status.progress * 100)}%`
+      : status.kind === 'translating'
+        ? `Translating… ${status.done}/${status.total}`
+        : status.kind === 'error'
+          ? status.message
+          : '';
+
+  const unsupportedHint = 'On-device translation requires a browser with the built-in Translator API (e.g. Chrome 138+ on desktop).';
+
+  return (
+    <div className="relative flex items-center" translate="no">
+      <label className="flex items-center gap-1 text-gray-600" title={supported === false ? unsupportedHint : 'Translate articles on your device'}>
+        <LanguageIcon className={`w-6 h-6 ${targetLanguage ? 'text-amber-500' : ''} ${busy ? 'animate-pulse' : ''}`} aria-hidden="true" />
+        <span className="sr-only">Translate articles</span>
+        <select
+          className="text-xs font-semibold bg-transparent border border-gray-300 rounded py-1 pl-1 pr-1 hover:border-amber-400 focus:outline-none focus:border-amber-400 disabled:opacity-50 disabled:cursor-not-allowed max-w-[9rem]"
+          value={targetLanguage}
+          disabled={!supported}
+          onChange={(e) => applyLanguage(e.target.value, sourceLanguage)}
+        >
+          <option value="">{`Original (${languageLabel(sourceLanguage)})`}</option>
+          {TARGET_LANGUAGES.filter((code) => code !== sourceLanguage).map((code) => (
+            <option key={code} value={code}>
+              {optionLabel(code)}
+            </option>
+          ))}
+        </select>
+      </label>
+      <span
+        role="status"
+        aria-live="polite"
+        className={`absolute left-0 top-full mt-1 z-20 whitespace-nowrap text-[11px] px-2 py-0.5 rounded shadow-sm ${
+          statusText ? '' : 'sr-only'
+        } ${status.kind === 'error' ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-800'}`}
+      >
+        {statusText}
+      </span>
+    </div>
+  );
+}
