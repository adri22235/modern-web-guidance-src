+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* ------------------------------------------------------------------
+       Decorative icons & flourishes
+       All icons below are generated with CSS pseudo-elements so they never
+       enter the DOM. Where a glyph is used as content, the CSS alt-text
+       syntax (`content: "x" / ""`) gives it an empty accessible name so
+       screen readers skip it. The first `content` declaration is a fallback
+       for older browsers that don't understand the alt syntax; it uses an
+       empty string or a CSS-drawn shape wherever possible so nothing is
+       announced even there.
+       ------------------------------------------------------------------ */
+
+    /* Screen-reader-only text (gives ambiguous links context) */
+    .visually-hidden {
+      position: absolute !important;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    /* "Seasonal Favorites" section heading: coffee beans on either side */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.75rem;
+      text-align: center;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      content: "";
+      flex: 0 1 80px;
+      height: 14px;
+      /* CSS-drawn bean at the inner end of a fading rule */
+      background:
+        radial-gradient(ellipse 7px 5px at var(--bean-x) 50%, var(--primary) 95%, transparent 100%),
+        linear-gradient(var(--line-dir), transparent, var(--accent)) 0 50% / calc(100% - 18px) 2px no-repeat;
+    }
+
+    .section-title::before {
+      --bean-x: calc(100% - 7px);
+      --line-dir: to right;
+    }
+
+    .section-title::after {
+      --bean-x: 7px;
+      --line-dir: to left;
+      background-position: 0 0, 100% 50%;
+    }
+
+    /* Drink headings: per-drink icon + underline flourish */
+    .drink-title {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.35rem;
+    }
+
+    .drink-title::before {
+      content: "";
+      display: grid;
+      place-items: center;
+      width: 2.75rem;
+      height: 2.75rem;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, #fff8e1, var(--secondary));
+      box-shadow: inset 0 0 0 2px rgba(78, 52, 46, 0.15);
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .drink-title[data-icon="maple"]::before {
+      content: "\1F341";
+      content: "\1F341" / "";
+    }
+
+    .drink-title[data-icon="ice"]::before {
+      content: "\1F9CA";
+      content: "\1F9CA" / "";
+    }
+
+    /* Espresso: a coffee bean drawn entirely with gradients (no glyph) */
+    .drink-title[data-icon="bean"]::before {
+      background:
+        linear-gradient(100deg, transparent 46%, #a1887f 47% 53%, transparent 54%) center / 1rem 1.4rem no-repeat,
+        radial-gradient(ellipse 0.5rem 0.7rem at center, var(--primary) 96%, transparent 100%),
+        radial-gradient(circle at 30% 30%, #fff8e1, var(--secondary));
+    }
+
+    .drink-title::after {
+      content: "";
+      width: 3rem;
+      height: 3px;
+      border-radius: 3px;
+      background: linear-gradient(to right, transparent, var(--accent), transparent);
+      transition: width 0.3s ease;
+    }
+
+    .card:hover .drink-title::after,
+    .card:focus-within .drink-title::after {
+      width: 5rem;
+    }
+
+    /* Buttons */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      position: relative;
+    }
+
+    /* "Order Now": steaming cup before, chevron after */
+    .btn-order::before {
+      content: "\2615";
+      content: "\2615" / "";
+      font-size: 1.1em;
+      line-height: 1;
+    }
+
+    .btn-order {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .btn-order:hover {
+      background: #ffc570;
+    }
+
+    /* Chevron for all arrow-style buttons, drawn with borders (no glyph) */
+    .btn-order::after,
+    .btn-details::after {
+      content: "";
+      width: 0.45em;
+      height: 0.45em;
+      background: none;
+      border-top: 2px solid currentColor;
+      border-right: 2px solid currentColor;
+      transform: rotate(45deg);
+      transition: transform 0.3s ease;
+    }
+
+    .btn-order:hover::after,
+    .btn-order:focus-visible::after,
+    .btn-details:hover::after,
+    .btn-details:focus-visible::after {
+      transform: translateX(4px) rotate(45deg);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .drink-title::after,
+      .btn::after,
+      .btn {
+        transition: none;
+      }
+
+      .btn-order:hover::after,
+      .btn-order:focus-visible::after,
+      .btn-details:hover::after,
+      .btn-details:focus-visible::after {
+        transform: rotate(45deg);
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep shapes visible */
+    @media (forced-colors: active) {
+      .drink-title::before {
+        forced-color-adjust: none;
+      }
+
+      .drink-title::after,
+      .section-title::before,
+      .section-title::after {
+        background: CanvasText;
+      }
+
+      .section-title::before,
+      .section-title::after {
+        height: 2px;
+      }
+    }
+
