+
+        var common = 0;
+        while (common < stack.length && common < routes.length && stack[common].route.path === routes[common].path) {
+          common++;
+        }
+        if (common === stack.length && common === routes.length) {
+          layout();
+          return;
+        }
+
+        var previousTop = top();
+        var removed = stack.splice(common);
+        var activeEl = document.activeElement;
+        routes.slice(common).forEach(function (route) {
