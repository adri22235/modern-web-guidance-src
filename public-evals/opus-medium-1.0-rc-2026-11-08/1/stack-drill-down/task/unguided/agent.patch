+      function focusScreen(entry, preferReturn) {
+        var rf = entry.returnFocus;
+        var target = preferReturn && rf && rf !== document.body && rf.isConnected ? rf : null;
+        if (!target) target = entry.el.querySelector('h1');
+        if (target) target.focus({ preventScroll: true });
