+        document.title = top().route.type === 'home'
+          ? 'The Daily Grind | Artisanal Coffee'
+          : top().route.title + (top().route.type === 'brew' ? ' — ' + ITEMS[top().route.id].name : '') + ' | The Daily Grind';
