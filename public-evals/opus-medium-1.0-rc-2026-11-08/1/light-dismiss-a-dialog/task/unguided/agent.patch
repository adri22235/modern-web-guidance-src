+  <script>
+    (function () {
+      var trigger = document.querySelector('.test-dialog-trigger');
+      var dialog = document.getElementById('logout-dialog');
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      // Close when clicking the backdrop. The dialog has no padding and all
+      // visible content lives in an inner wrapper, so a click whose target is
+      // the dialog element itself can only come from the backdrop area.
+      dialog.addEventListener('click', function (event) {
+        if (event.target === dialog) {
+          dialog.close();
+        }
+      });
+    })();
+  </script>
