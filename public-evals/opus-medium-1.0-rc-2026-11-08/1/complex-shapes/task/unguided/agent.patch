+      isolation: isolate;
     }
 
+    /* Hero content sits above the decorative shape */
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative organic shape: absolutely positioned with a fixed
+       aspect ratio so it never affects hero layout or causes shifts */
+    .shaped-element {
+      position: absolute;
+      right: -4%;
+      bottom: -8%;
+      width: clamp(160px, 28vw, 380px);
+      aspect-ratio: 1 / 1;
+      z-index: 0;
+      pointer-events: none;
+      opacity: 0.85;
+      background: var(--accent);
+      /* Fallback silhouette for browsers without SVG clip-path support */
+      border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%;
+      clip-path: url(#hero-organic-shape);
+      transform: rotate(-8deg);
+    }
+
+    .shaped-element img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      mix-blend-mode: multiply;
+    }
+
+    @media (max-width: 600px) {
+      .shaped-element {
+        width: 140px;
+        right: -12%;
+        bottom: -6%;
+        opacity: 0.5;
+      }
+    }
+
     .hero h1 {
       font-size: 3rem;
       margin-bottom: 1rem;
     }
