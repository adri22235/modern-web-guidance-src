@@ -0,0 +1,207 @@
+<!doctype html>
+<html lang="en" class="exp-pending">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>Lumen — Ship faster with confidence</title>
+  <meta name="description" content="Lumen helps product teams ship faster with confidence." />
+
+  <!-- Open the connection to the experiment CDN as early as possible. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="preload" href="https://cdn.example.com/experiment-sdk.js" as="script" crossorigin />
+  <link rel="preconnect" href="https://images.unsplash.com" />
+
+  <!--
+    Anti-flicker guard. This must be inlined in <head> BEFORE any content renders.
+    While <html> has the `exp-pending` class, every element the experiment can
+    change (marked with [data-experiment]) is hidden, so the original content is
+    never painted. The rest of the page renders normally.
+  -->
+  <style>
+    .exp-pending [data-experiment] { visibility: hidden !important; }
+  </style>
+  <noscript>
+    <!-- Without JS the experiment can't run, so never hide anything. -->
+    <style>.exp-pending [data-experiment] { visibility: visible !important; }</style>
+  </noscript>
+
+  <script>
+    (function () {
+      var SDK_URL = 'https://cdn.example.com/experiment-sdk.js';
+      // Upper bound on how long content may stay hidden. If the SDK is slow,
+      // blocked, or broken, we fall back to the original (control) content
+      // rather than leaving the user with a blank hero.
+      var TIMEOUT_MS = 2000;
+      var root = document.documentElement;
+      var revealed = false;
+
+      function reveal(reason) {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(timer);
+        root.classList.remove('exp-pending');
+        root.setAttribute('data-exp-state', reason);
+      }
+      window.__revealExperiment = reveal;
+
+      var timer = setTimeout(function () { reveal('timeout'); }, TIMEOUT_MS);
+
+      // Preferred signal: the SDK dispatches this event once variants are applied.
+      document.addEventListener('experiment:applied', function () { reveal('applied'); });
+
+      function onSdkLoaded() {
+        var sdk = window.ExperimentSDK || window.experimentSDK;
+        if (!sdk) {
+          // SDK applied its changes synchronously on execution (or exposes no API).
+          // Wait for the DOM to be parsed so it could act on it, then reveal.
+          whenDomReady(function () { reveal('loaded'); });
+          return;
+        }
+        try {
+          var ready =
+            typeof sdk.ready === 'function' ? sdk.ready() :
+            sdk.ready && typeof sdk.ready.then === 'function' ? sdk.ready :
+            null;
+          if (ready && typeof ready.then === 'function') {
+            ready.then(function () { reveal('applied'); }, function () { reveal('error'); });
+          } else if (typeof sdk.onReady === 'function') {
+            sdk.onReady(function () { reveal('applied'); });
+          } else {
+            whenDomReady(function () { reveal('loaded'); });
+          }
+        } catch (e) {
+          reveal('error');
+        }
+      }
+
+      function whenDomReady(cb) {
+        if (document.readyState !== 'loading') cb();
+        else document.addEventListener('DOMContentLoaded', cb, { once: true });
+      }
+
+      var s = document.createElement('script');
+      s.src = SDK_URL;
+      s.async = true;
+      s.crossOrigin = 'anonymous';
+      s.onload = onSdkLoaded;
+      s.onerror = function () { reveal('error'); };
+      document.head.appendChild(s);
+    })();
+  </script>
+
+  <style>
+    :root {
+      --bg: #0b1020;
+      --fg: #f5f7fb;
+      --muted: #aab3c5;
+      --accent: #6c5ce7;
+      --accent-hover: #5a4bd6;
+      --radius: 12px;
+    }
+    * { box-sizing: border-box; }
+    html, body { margin: 0; }
+    body {
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+      -webkit-font-smoothing: antialiased;
+    }
+    a { color: inherit; }
+
+    .nav {
+      position: absolute; inset: 0 0 auto 0; z-index: 2;
+      display: flex; align-items: center; justify-content: space-between;
+      max-width: 1200px; margin: 0 auto; padding: 1.25rem 1.5rem;
+    }
+    .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; text-decoration: none; }
+    .nav a.link { color: var(--muted); text-decoration: none; margin-left: 1.5rem; font-size: .95rem; }
+    .nav a.link:hover { color: var(--fg); }
+
+    .hero {
+      position: relative;
+      min-height: 100vh;
+      display: grid; place-items: center;
+      padding: 7rem 1.5rem 4rem;
+      overflow: hidden;
+      isolation: isolate;
+    }
+    .hero::before {
+      content: ""; position: absolute; inset: 0; z-index: -2;
+      background: url("https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=2000&q=70") center / cover no-repeat;
+    }
+    .hero::after {
+      content: ""; position: absolute; inset: 0; z-index: -1;
+      background: linear-gradient(180deg, rgba(11,16,32,.75) 0%, rgba(11,16,32,.88) 60%, var(--bg) 100%);
+    }
+    .hero-inner { max-width: 760px; text-align: center; }
+    .eyebrow {
+      display: inline-block; padding: .35rem .8rem; border-radius: 999px;
+      background: rgba(108,92,231,.18); color: #c9c2ff; font-size: .85rem; font-weight: 600;
+      margin-bottom: 1.25rem;
+    }
+    .hero h1 {
+      font-size: clamp(2.25rem, 6vw, 4rem); line-height: 1.08; letter-spacing: -0.03em;
+      margin: 0 0 1.25rem;
+    }
+    .hero p.sub { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--muted); margin: 0 auto 2.25rem; max-width: 600px; }
+
+    .cta-row { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
+    .btn {
+      display: inline-flex; align-items: center; gap: .5rem;
+      padding: .95rem 1.75rem; border-radius: var(--radius);
+      font-size: 1.05rem; font-weight: 600; text-decoration: none; cursor: pointer;
+      border: 1px solid transparent; transition: background .15s, transform .15s, box-shadow .15s;
+    }
+    .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 10px 30px -10px rgba(108,92,231,.8); }
+    .btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .btn-primary:focus-visible { outline: 3px solid #c9c2ff; outline-offset: 3px; }
+    .btn-ghost { color: var(--fg); border-color: rgba(255,255,255,.25); background: transparent; }
+    .btn-ghost:hover { background: rgba(255,255,255,.08); }
+    .fineprint { margin-top: 1rem; font-size: .85rem; color: var(--muted); }
+
+    footer { text-align: center; color: var(--muted); font-size: .85rem; padding: 2rem 1.5rem; }
+
+    @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
+  </style>
+</head>
+<body>
+  <header class="nav">
+    <a class="logo" href="/">Lumen</a>
+    <nav>
+      <a class="link" href="#features">Features</a>
+      <a class="link" href="#pricing">Pricing</a>
+      <a class="link" href="#login">Log in</a>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-title">
+      <!--
+        Elements marked [data-experiment] are the experiment's targets. They stay
+        hidden until the SDK has applied the user's variant (or the timeout fires).
+      -->
+      <div class="hero-inner" data-experiment="hero">
+        <span class="eyebrow" data-exp-id="hero-eyebrow">New: Real-time insights</span>
+        <h1 id="hero-title" data-exp-id="hero-headline">Ship faster with confidence</h1>
+        <p class="sub" data-exp-id="hero-subheadline">
+          Lumen gives your product team the data to make every release count —
+          without the guesswork.
+        </p>
+        <div class="cta-row">
+          <a class="btn btn-primary" href="#signup" id="cta-primary" data-exp-id="hero-cta">
+            Start free trial
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
+            </svg>
+          </a>
+          <a class="btn btn-ghost" href="#demo">Book a demo</a>
+        </div>
+        <p class="fineprint">No credit card required · 14-day free trial</p>
+      </div>
+    </section>
+  </main>
+
+  <footer>&copy; 2026 Lumen, Inc.</footer>
+</body>
+</html>
