diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,230 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Northwind — Ship faster with less friction</title>
+  <meta name="description" content="Northwind helps product teams plan, build, and launch in one place.">
+
+  <link rel="preconnect" href="https://cdn.example.com">
+  <link rel="preconnect" href="https://images.unsplash.com">
+
+  <!--
+    Anti-flicker fallback for browsers without `blocking="render"` support
+    (e.g. Firefox). Runs before the SDK tag so the page is hidden before the
+    async SDK could possibly execute. Browsers that support `blocking="render"`
+    skip this entirely and rely on native render blocking.
+  -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      window.__revealExperiment = function () {
+        root.classList.remove('ab-loading');
+      };
+      if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+        root.classList.add('ab-loading');
+        // Never leave the page blank if the SDK is slow or unreachable.
+        setTimeout(window.__revealExperiment, 4000);
+      }
+    })();
+  </script>
+
+  <!--
+    Experiment SDK:
+    - `async` keeps HTML parsing going while the SDK downloads.
+    - `blocking="render"` holds first paint until the SDK has executed and
+      applied its variant, so the original content never flashes.
+    - `onload` fires after the script executes; `onerror` covers CDN failures.
+      Both reveal the page in the fallback path (no-op otherwise).
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onload="window.__revealExperiment()"
+    onerror="window.__revealExperiment()"
+  ></script>
+
+  <style>
+    .ab-loading {
+      opacity: 0 !important;
+    }
+
+    :root {
+      color-scheme: light dark;
+      --bg: light-dark(#f8fafc, #0b1120);
+      --fg: light-dark(#0f172a, #e2e8f0);
+      --muted: light-dark(#475569, #94a3b8);
+      --accent: #4f46e5;
+      --accent-hover: #4338ca;
+      --radius: 0.75rem;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+    }
+
+    *, *::before, *::after { box-sizing: border-box; }
+
+    body {
+      margin: 0;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+
+    .site-header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: 1.25rem 1.5rem;
+    }
+
+    .logo {
+      font-weight: 800;
+      font-size: 1.25rem;
+      color: inherit;
+      text-decoration: none;
+    }
+
+    .site-header nav a {
+      color: var(--muted);
+      text-decoration: none;
+      margin-inline-start: 1.5rem;
+    }
+    .site-header nav a:hover { color: var(--fg); }
+
+    .hero {
+      display: grid;
+      gap: 3rem;
+      align-items: center;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: 3rem 1.5rem 5rem;
+    }
+
+    @media (min-width: 900px) {
+      .hero { grid-template-columns: 1.1fr 1fr; padding-block: 5rem 7rem; }
+    }
+
+    .eyebrow {
+      display: inline-block;
+      font-size: 0.875rem;
+      font-weight: 600;
+      color: var(--accent);
+      background: color-mix(in srgb, var(--accent) 12%, transparent);
+      padding: 0.25rem 0.75rem;
+      border-radius: 999px;
+      margin: 0 0 1rem;
+    }
+
+    .hero h1 {
+      font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
+      line-height: 1.1;
+      letter-spacing: -0.02em;
+      margin: 0 0 1.25rem;
+      text-wrap: balance;
+    }
+
+    .hero p.lead {
+      font-size: 1.25rem;
+      color: var(--muted);
+      max-width: 36rem;
+      margin: 0 0 2rem;
+      text-wrap: pretty;
+    }
+
+    .cta-group {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 1rem;
+      align-items: center;
+    }
+
+    .cta-button {
+      display: inline-block;
+      background: var(--accent);
+      color: #fff;
+      font-weight: 600;
+      font-size: 1.125rem;
+      padding: 0.9rem 1.75rem;
+      border-radius: var(--radius);
+      text-decoration: none;
+      box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--accent) 60%, transparent);
+      transition: background-color 0.15s, transform 0.15s;
+    }
+    .cta-button:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .cta-button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+
+    .cta-secondary {
+      color: var(--fg);
+      font-weight: 600;
+      text-decoration: none;
+    }
+    .cta-secondary:hover { text-decoration: underline; }
+
+    .cta-note {
+      font-size: 0.875rem;
+      color: var(--muted);
+      margin-top: 1rem;
+    }
+
+    .hero-media img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: calc(var(--radius) * 2);
+      box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .cta-button { transition: none; }
+      .cta-button:hover { transform: none; }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a class="logo" href="/">Northwind</a>
+    <nav aria-label="Primary">
+      <a href="#features">Features</a>
+      <a href="#pricing">Pricing</a>
+    </nav>
+  </header>
+
+  <main>
+    <!-- data-experiment hooks give the SDK stable targets for variant changes. -->
+    <section class="hero" data-experiment="hero">
+      <div class="hero-copy">
+        <p class="eyebrow">New: Workflows 2.0</p>
+        <h1 data-experiment="hero-headline">Ship faster with less friction</h1>
+        <p class="lead" data-experiment="hero-subhead">
+          Northwind brings planning, building, and launching into one place so
+          your team can spend less time coordinating and more time creating.
+        </p>
+        <div class="cta-group">
+          <a class="cta-button" href="/signup" data-experiment="hero-cta">Start free trial</a>
+          <a class="cta-secondary" href="#demo">Watch the demo →</a>
+        </div>
+        <p class="cta-note">No credit card required · Cancel anytime</p>
+      </div>
+
+      <div class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80 1200w
+          "
+          sizes="(min-width: 900px) 34rem, 100vw"
+          width="1200"
+          height="900"
+          alt="A team collaborating around laptops at a shared table"
+          fetchpriority="high"
+        >
+      </div>
+    </section>
+  </main>
+</body>
+</html>
