     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <dialog class="confirm-dialog" id="confirm-order" aria-labelledby="confirm-heading">
+    <h2 id="confirm-heading">Confirm your order</h2>
+    <ul class="order-items" id="confirm-items"></ul>
+    <p class="order-total"><span>Total</span><span id="confirm-total"></span></p>
+    <form method="dialog" class="actions" style="margin-top: 20px;">
+      <button type="submit" class="btn btn-secondary" value="cancel">Keep Browsing</button>
+      <button type="submit" class="btn" value="confirm" autofocus>Place Order</button>
+    </form>
+  </dialog>
+
+  <script>
+    const MENU = {
+      'maple-oat-latte': { name: 'Maple Oat Latte', prices: { small: 5.25, medium: 5.95, large: 6.65 } },
+      'dark-roast-espresso': { name: 'Dark Roast Espresso', prices: { small: 3.25, medium: 3.95, large: 4.65 } },
+      'cold-brew': { name: 'Cold Brew', prices: { small: 4.50, medium: 5.20, large: 5.90 } },
+    };
+    const SIZES = ['small', 'medium', 'large'];
+    const MAX_QUANTITY = 10;
+
+    const order = [];
+    let nextItemId = 1;
+
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+    const itemsList = document.querySelector('.order-summary .order-items');
+    const emptyMessage = document.querySelector('.order-empty');
+    const totalRow = document.querySelector('.order-summary .order-total');
+    const totalOutput = document.getElementById('order-total');
+    const placeOrderButton = document.getElementById('place-order');
+    const statusMessage = document.querySelector('.order-status');
+    const confirmDialog = document.getElementById('confirm-order');
+
+    const capitalize = (text) => text[0].toUpperCase() + text.slice(1);
+    const lineTotal = (item) => MENU[item.drink].prices[item.size] * item.quantity;
+    const orderTotal = () => order.reduce((sum, item) => sum + lineTotal(item), 0);
+    const describeItem = (item) => `${item.quantity} × ${capitalize(item.size)} ${MENU[item.drink].name}`;
+
+    function orderSnapshot() {
+      return {
+        items: order.map((item) => ({
+          itemId: item.id,
+          drink: MENU[item.drink].name,
+          size: item.size,
+          quantity: item.quantity,
+          price: currency.format(lineTotal(item)),
+        })),
+        total: currency.format(orderTotal()),
+      };
+    }
+
+    function renderItems(list) {
+      list.replaceChildren(...order.map((item) => {
+        const li = document.createElement('li');
+        const label = document.createElement('span');
+        label.textContent = describeItem(item);
+        const price = document.createElement('span');
+        price.textContent = currency.format(lineTotal(item));
+        li.append(label, price);
+        return li;
+      }));
+    }
+
+    function render() {
+      renderItems(itemsList);
+      itemsList.querySelectorAll('li').forEach((li, index) => {
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove';
+        remove.dataset.itemId = order[index].id;
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${describeItem(order[index])}`);
+        li.append(remove);
+      });
+      emptyMessage.hidden = order.length > 0;
+      totalRow.hidden = order.length === 0;
+      totalOutput.textContent = currency.format(orderTotal());
+      placeOrderButton.disabled = order.length === 0;
+    }
+
+    function addToOrder(drink, size = 'medium', quantity = 1) {
+      if (!MENU[drink]) {
+        return { error: `Unknown drink "${drink}".`, availableDrinks: Object.keys(MENU) };
+      }
+      if (!SIZES.includes(size)) {
+        return { error: `Unsupported size "${size}".`, availableSizes: SIZES };
+      }
+      if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) {
+        return { error: `Quantity must be a whole number from 1 to ${MAX_QUANTITY}.` };
+      }
+
+      const existing = order.find((item) => item.drink === drink && item.size === size);
+      if (existing) {
+        existing.quantity = Math.min(existing.quantity + quantity, MAX_QUANTITY);
+      } else {
+        order.push({ id: nextItemId++, drink, size, quantity });
+      }
+      render();
+      statusMessage.textContent = `Added ${quantity} × ${capitalize(size)} ${MENU[drink].name} to your order.`;
+      return { message: statusMessage.textContent, order: orderSnapshot() };
+    }
+
+    function removeFromOrder(itemId) {
+      const index = order.findIndex((item) => item.id === itemId);
+      if (index === -1) {
+        return { error: `No order item with ID ${itemId}.`, order: orderSnapshot() };
+      }
+      const [removed] = order.splice(index, 1);
+      render();
+      statusMessage.textContent = `Removed ${describeItem(removed)} from your order.`;
+      return { message: statusMessage.textContent, order: orderSnapshot() };
+    }
+
+    // The customer always confirms in a modal dialog before an order is placed,
+    // whether the request came from the page or from an AI agent.
+    function confirmAndPlaceOrder(signal) {
+      if (order.length === 0) {
+        return Promise.resolve({ error: 'The order is empty. Add drinks before placing the order.' });
+      }
+      if (confirmDialog.open) {
+        return Promise.resolve({ error: 'The customer is already reviewing the order confirmation.' });
+      }
+
+      renderItems(document.getElementById('confirm-items'));
+      document.getElementById('confirm-total').textContent = currency.format(orderTotal());
+      confirmDialog.returnValue = '';
+      confirmDialog.showModal();
+
+      return new Promise((resolve, reject) => {
+        const onAbort = () => {
+          confirmDialog.removeEventListener('close', onClose);
+          confirmDialog.close('cancel');
+          reject(signal.reason);
+        };
+        const onClose = () => {
+          signal?.removeEventListener('abort', onAbort);
+          if (confirmDialog.returnValue !== 'confirm') {
+            statusMessage.textContent = 'Order not placed. You can keep editing it.';
+            resolve({ placed: false, message: 'The customer declined to place the order.' });
+            return;
+          }
+          const receipt = { placed: true, orderNumber: `DG-${Math.floor(1000 + Math.random() * 9000)}`, ...orderSnapshot() };
+          order.length = 0;
+          render();
+          statusMessage.textContent = `Order ${receipt.orderNumber} placed! It will be ready for pickup in about 10 minutes.`;
+          resolve({ ...receipt, message: statusMessage.textContent });
+        };
+        confirmDialog.addEventListener('close', onClose, { once: true });
+        signal?.addEventListener('abort', onAbort, { once: true });
+      });
+    }
+
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        const result = addToOrder(form.dataset.drink, data.get('size') ?? 'medium', Number(data.get('quantity')));
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+    });
+
+    itemsList.addEventListener('click', (event) => {
+      const button = event.target.closest('button.remove');
+      if (button) removeFromOrder(Number(button.dataset.itemId));
+    });
+
+    placeOrderButton.addEventListener('click', () => confirmAndPlaceOrder());
+
+    // WebMCP: expose ordering actions to browser AI agents. The per-drink
+    // "add to order" tools are declared on the card forms above.
+    if ('modelContext' in document) {
+      const tools = new AbortController();
+      addEventListener('pagehide', (event) => {
+        if (!event.persisted) tools.abort();
+      });
+
+      const registrations = [
+        {
+          name: 'get-seasonal-menu',
+          description: 'Lists the seasonal coffee drinks with their prices for each cup size. Use to answer menu or price questions.',
+          inputSchema: { type: 'object', properties: {} },
+          execute() {
+            return Object.entries(MENU).map(([id, drink]) => ({
+              id,
+              name: drink.name,
+              prices: Object.fromEntries(SIZES.map((size) => [size, currency.format(drink.prices[size])])),
+            }));
+          },
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: 'view-order',
+          description: "Shows the drinks in the customer's current order, their item IDs, and the total.",
+          inputSchema: { type: 'object', properties: {} },
+          execute: orderSnapshot,
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: 'remove-order-item',
+          description: "Removes a line item from the customer's current order.",
+          inputSchema: {
+            type: 'object',
+            properties: {
+              itemId: { type: 'integer', description: 'The itemId of the line item, as returned by view-order.' },
+            },
+            required: ['itemId'],
+          },
+          execute({ itemId }) {
+            return removeFromOrder(Number(itemId));
+          },
+        },
+        {
+          name: 'place-order',
+          description: "Submits the customer's current order for pickup. The customer is asked to confirm on the page before the order is placed.",
+          inputSchema: { type: 'object', properties: {} },
+          execute(_input, { signal } = {}) {
+            return confirmAndPlaceOrder(signal);
+          },
+          annotations: { readOnlyHint: false, consequentialHint: true },
+        },
+      ];
+
+      for (const tool of registrations) {
+        Promise.resolve(document.modelContext.registerTool(tool, { signal: tools.signal }))
+          .catch((error) => console.warn(`Could not register WebMCP tool "${tool.name}":`, error));
+      }
+    }
+  </script>
+
 </body>
 
 </html>
