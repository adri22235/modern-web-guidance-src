+  <script>
+    (() => {
+      const MENU = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', prices: { small: 4.75, medium: 5.25, large: 5.75 } },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', prices: { single: 2.75, double: 3.50 } },
+        'cold-brew': { name: 'Cold Brew', prices: { small: 4.25, medium: 4.75, large: 5.25 } }
+      };
+      const MAX_QTY = 10;
+      const STORAGE_KEY = 'dailyGrindOrder';
+
+      let order = loadOrder();
+      let nextLineId = order.reduce((max, line) => Math.max(max, line.lineId), 0) + 1;
+
+      const $items = document.getElementById('order-items');
+      const $empty = document.getElementById('order-empty');
+      const $total = document.getElementById('order-total');
+      const $placeBtn = document.getElementById('place-order-btn');
+      const $status = document.getElementById('order-status');
+
+      const fmt = (n) => `$${n.toFixed(2)}`;
+      const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
+
+      function loadOrder() {
+        try {
+          const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+          return Array.isArray(saved) ? saved.filter((l) => MENU[l.drinkId]?.prices[l.size]) : [];
+        } catch {
+          return [];
+        }
+      }
+
+      function saveOrder() {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+        } catch { /* storage unavailable; keep in memory */ }
+      }
+
+      function orderTotal() {
+        return order.reduce((sum, l) => sum + MENU[l.drinkId].prices[l.size] * l.quantity, 0);
+      }
+
+      function setStatus(message, type = '') {
+        $status.textContent = message;
+        $status.className = `order-status ${type}`;
+      }
+
+      function describeOrder() {
+        return {
+          items: order.map((l) => ({
+            lineId: l.lineId,
+            drinkId: l.drinkId,
+            name: MENU[l.drinkId].name,
+            size: l.size,
+            quantity: l.quantity,
+            unitPrice: MENU[l.drinkId].prices[l.size],
+            lineTotal: +(MENU[l.drinkId].prices[l.size] * l.quantity).toFixed(2)
+          })),
+          total: +orderTotal().toFixed(2),
+          currency: 'USD'
+        };
+      }
+
+      function render() {
+        $items.innerHTML = '';
+        for (const line of order) {
+          const drink = MENU[line.drinkId];
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${line.quantity} × ${drink.name} (${cap(line.size)})`;
+          const price = document.createElement('span');
+          price.textContent = fmt(drink.prices[line.size] * line.quantity);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'remove-btn';
+          remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${drink.name}`);
+          remove.addEventListener('click', () => removeFromOrder(line.lineId));
+          const right = document.createElement('span');
+          right.append(price, ' ', remove);
+          li.append(label, right);
+          $items.appendChild(li);
+        }
+        $empty.hidden = order.length > 0;
+        $total.textContent = fmt(orderTotal());
+        $placeBtn.disabled = order.length === 0;
+      }
+
+      // --- Core ordering actions (shared by the UI and agent tools) ---
+
+      function addToOrder(drinkId, size, quantity = 1) {
+        const drink = MENU[drinkId];
+        if (!drink) throw new Error(`Unknown drink "${drinkId}". Valid ids: ${Object.keys(MENU).join(', ')}.`);
+        if (!(size in drink.prices)) {
+          throw new Error(`Invalid size "${size}" for ${drink.name}. Valid sizes: ${Object.keys(drink.prices).join(', ')}.`);
+        }
+        quantity = Number(quantity);
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QTY) {
+          throw new Error(`Quantity must be a whole number between 1 and ${MAX_QTY}.`);
+        }
+        const existing = order.find((l) => l.drinkId === drinkId && l.size === size);
+        if (existing) {
+          if (existing.quantity + quantity > MAX_QTY) {
+            throw new Error(`Cannot have more than ${MAX_QTY} of the same drink and size in one order.`);
+          }
+          existing.quantity += quantity;
+        } else {
+          order.push({ lineId: nextLineId++, drinkId, size, quantity });
+        }
+        saveOrder();
+        render();
+        setStatus(`Added ${quantity} × ${drink.name} (${cap(size)}).`, 'success');
+        return describeOrder();
+      }
+
+      function removeFromOrder(lineId) {
+        const idx = order.findIndex((l) => l.lineId === Number(lineId));
+        if (idx === -1) throw new Error(`No order line with id ${lineId}.`);
+        const [removed] = order.splice(idx, 1);
+        saveOrder();
+        render();
+        setStatus(`Removed ${MENU[removed.drinkId].name}.`);
+        return describeOrder();
+      }
+
+      function clearOrder() {
+        order = [];
+        saveOrder();
+        render();
+        return describeOrder();
+      }
+
+      function placeOrder() {
+        if (order.length === 0) throw new Error('Your order is empty.');
+        const summary = describeOrder();
+        const confirmation = `DG-${Date.now().toString(36).toUpperCase()}`;
+        clearOrder();
+        setStatus(`Order ${confirmation} placed! Total ${fmt(summary.total)}. We'll have it ready shortly.`, 'success');
+        return { confirmation, ...summary };
+      }
+
+      // --- Wire up card UI ---
+
+      document.querySelectorAll('[data-drink-id]').forEach((card) => {
+        const drinkId = card.dataset.drinkId;
+        const drink = MENU[drinkId];
+        const select = card.querySelector('select[name="size"]');
+        const prices = Object.entries(drink.prices);
+        for (const [size, price] of prices) {
+          select.add(new Option(`${cap(size)} – ${fmt(price)}`, size));
+        }
+        const values = prices.map(([, p]) => p);
+        card.querySelector('[data-price]').textContent =
+          `${fmt(Math.min(...values))} – ${fmt(Math.max(...values))}`;
+
+        card.querySelector('form').addEventListener('submit', (e) => {
+          e.preventDefault();
+          const data = new FormData(e.target);
+          try {
+            addToOrder(drinkId, data.get('size'), data.get('quantity'));
+            e.target.reset();
+          } catch (err) {
+            setStatus(err.message, 'error');
+          }
+        });
+      });
+
+      $placeBtn.addEventListener('click', () => {
+        try {
+          placeOrder();
+        } catch (err) {
+          setStatus(err.message, 'error');
+        }
+      });
+
+      render();
+
+      // --- Expose ordering actions to browser AI agents (WebMCP) ---
+
+      const textResult = (data) => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+      const errorResult = (err) => ({ content: [{ type: 'text', text: `Error: ${err.message}` }], isError: true });
+      const wrap = (fn) => async (args, client) => {
+        try {
+          return textResult(await fn(args || {}, client));
+        } catch (err) {
+          return errorResult(err);
+        }
+      };
+
+      const tools = [
+        {
+          name: 'list_seasonal_drinks',
+          description: 'List the Seasonal Favorites drinks available to order, with their ids, sizes, and prices in USD.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: wrap(() => Object.entries(MENU).map(([id, d]) => ({ drinkId: id, name: d.name, prices: d.prices })))
+        },
+        {
+          name: 'add_drink_to_order',
+          description: 'Add a Seasonal Favorites drink to the current order. Adding the same drink and size again increases its quantity.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drinkId: { type: 'string', enum: Object.keys(MENU), description: 'Drink id from list_seasonal_drinks.' },
+              size: {
+                type: 'string',
+                enum: [...new Set(Object.values(MENU).flatMap((d) => Object.keys(d.prices)))],
+                description: 'Size. Maple Oat Latte and Cold Brew: small, medium, large. Dark Roast Espresso: single, double.'
+              },
+              quantity: { type: 'integer', minimum: 1, maximum: MAX_QTY, default: 1 }
+            },
+            required: ['drinkId', 'size']
+          },
+          execute: wrap(({ drinkId, size, quantity }) => addToOrder(drinkId, size, quantity ?? 1))
+        },
+        {
+          name: 'view_order',
+          description: 'Show the items currently in the order and the running total.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: wrap(() => describeOrder())
+        },
+        {
+          name: 'remove_from_order',
+          description: 'Remove a line item from the current order by its lineId (from view_order).',
+          inputSchema: {
+            type: 'object',
+            properties: { lineId: { type: 'integer', description: 'lineId of the item to remove.' } },
+            required: ['lineId']
+          },
+          execute: wrap(({ lineId }) => removeFromOrder(lineId))
+        },
+        {
+          name: 'clear_order',
+          description: 'Remove all items from the current order.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: wrap(() => clearOrder())
+        },
+        {
+          name: 'place_order',
+          description: 'Submit the current order for pickup. The user is asked to confirm before the order is placed.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: wrap(async (_args, client) => {
+            if (order.length === 0) throw new Error('Your order is empty.');
+            const total = fmt(orderTotal());
+            const ask = () => window.confirm(`Place your order for ${total}?`);
+            const ok = client?.requestUserInteraction ? await client.requestUserInteraction(async () => ask()) : ask();
+            if (!ok) throw new Error('The user declined to place the order.');
+            return placeOrder();
+          })
+        }
+      ];
+
+      const mc = navigator.modelContext;
+      if (mc) {
+        if (typeof mc.provideContext === 'function') {
+          mc.provideContext({ tools });
+        } else if (typeof mc.registerTool === 'function') {
+          tools.forEach((tool) => mc.registerTool(tool));
+        }
+      }
+
+      // Also available to page scripts / tests without WebMCP support.
+      window.dailyGrindOrdering = { addToOrder, removeFromOrder, clearOrder, placeOrder, viewOrder: describeOrder, menu: MENU };
+    })();
+  </script>
+
 </body>
 
