@@ -0,0 +1,55 @@
+// Client-side helpers for the article and reading-list API routes.
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+const base = import.meta.env.BASE_URL;
+
+export const articleUrl = (slug: string) => `${base}articles/${slug}`;
+
+export async function fetchArticles(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${base}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Loading articles failed with status ${response.status}`);
+  return response.json();
+}
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${base}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Loading the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList;
+}
+
+// The API toggles the slug: it is added if missing and removed if present.
+export async function toggleReadingList(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${base}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Updating the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList;
+}
+
+export function searchArticles(articles: ArticleSummary[], term: string) {
+  const needle = term.trim().toLowerCase();
+  if (!needle) return [];
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(needle) ||
+    article.summary.toLowerCase().includes(needle)
+  );
+}
+
+// Fields shared by declarative form submit events when WebMCP is available.
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export const errorMessage = (error: unknown) => error instanceof Error ? error.message : String(error);
