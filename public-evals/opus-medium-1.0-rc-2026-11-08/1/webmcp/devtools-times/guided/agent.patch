@@ -0,0 +1,66 @@
+import { navigate } from 'astro:transitions/client';
+import { articleUrl, errorMessage, fetchArticles, fetchReadingList } from '../utils/articleApi';
+import { useWebMCP } from '../utils/useWebMCP';
+
+// Site-wide WebMCP tools. Renders nothing; it only registers tools while mounted.
+export default function SiteTools() {
+  useWebMCP({
+    name: 'list-articles',
+    description: 'Lists every article published on The DevTools Times with its slug, headline and summary. Use to browse what is available or to look up an article slug.',
+    async execute(_input, { signal }) {
+      try {
+        const articles = await fetchArticles(signal);
+        return articles.map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) }));
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get-reading-list',
+    description: 'Returns the articles the user has saved to their reading list.',
+    async execute(_input, { signal }) {
+      try {
+        const [articles, readingList] = await Promise.all([fetchArticles(signal), fetchReadingList(signal)]);
+        return articles
+          .filter(article => readingList.includes(article.slug))
+          .map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) }));
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ slug?: unknown }>({
+    name: 'open-article',
+    description: 'Navigates the browser tab to an article so the user can read it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Article slug, as returned by list-articles or search-articles, e.g. "coffee-alchemy".' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal }) {
+      try {
+        const articles = await fetchArticles(signal);
+        const article = articles.find(entry => entry.slug === slug);
+        if (!article) {
+          return { error: `No article has the slug "${String(slug)}".`, availableSlugs: articles.map(entry => entry.slug) };
+        }
+        await navigate(articleUrl(article.slug));
+        return `Opened "${article.title}".`;
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+  });
+
+  return null;
+}
