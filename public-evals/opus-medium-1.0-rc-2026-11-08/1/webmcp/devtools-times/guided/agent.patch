+import { useEffect, useRef } from 'react';
+
+// Minimal stand-in for `useWebMCP` from the `use-webmcp-tool` package, which
+// couldn't be installed in this environment. It keeps the same tool shape, so
+// switching to the package later only means changing the import.
+
+export interface WebMCPTool<Input = any> {
+  name: string;
+  description: string;
+  inputSchema?: Record<string, unknown>;
+  execute: (input: Input, options: { signal: AbortSignal }) => unknown;
+  annotations?: {
+    readOnlyHint?: boolean;
+    consequentialHint?: boolean;
+    untrustedContentHint?: boolean;
+  };
+}
+
+interface ModelContext {
+  registerTool: (tool: WebMCPTool, options?: { signal?: AbortSignal }) => unknown;
+}
+
+export function useWebMCP<Input = any>(tool: WebMCPTool<Input> & { enabled?: boolean }) {
+  // Always call the latest `execute` so it sees current props/state without re-registering.
+  const toolRef = useRef(tool);
+  toolRef.current = tool;
+  const { name, enabled = true } = tool;
+
+  useEffect(() => {
+    const modelContext = (document as Document & { modelContext?: ModelContext }).modelContext;
+    if (!enabled || !modelContext) return;
+
+    const controller = new AbortController();
+    const { description, inputSchema = { type: 'object', properties: {} }, annotations } = toolRef.current;
+
+    Promise.resolve(
+      modelContext.registerTool(
+        {
+          name,
+          description,
+          inputSchema,
+          execute: (input, options) => toolRef.current.execute(input ?? {}, options),
+          annotations,
+        },
+        { signal: controller.signal },
+      ),
+    ).catch((error) => console.warn(`WebMCP: failed to register "${name}"`, error));
+
+    return () => controller.abort();
+  }, [name, enabled]);
+}
