@@ -0,0 +1,71 @@
+import { articleUrl } from '../utils/articleApi';
+import { useWebMCP } from '../utils/useWebMCP';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  date: string;
+  readingTime?: number;
+}
+
+const WORDS_PER_MINUTE = 200;
+
+const articleBody = () => document.querySelector<HTMLElement>('[data-article-body]');
+
+const paragraphs = () =>
+  Array.from(articleBody()?.querySelectorAll<HTMLElement>('p, li, blockquote') ?? []);
+
+// WebMCP tools for the article currently open in the tab. Renders nothing.
+export default function ArticleTools({ slug, title, summary, author, category, date, readingTime }: Props) {
+  useWebMCP({
+    name: 'get-current-article',
+    description: 'Returns the article open in this tab: headline, byline, publish date and full text. Use to summarize, quote or answer questions about the story the user is reading.',
+    execute() {
+      const text = articleBody()?.innerText.trim() ?? '';
+      const wordCount = text ? text.split(/\s+/).length : 0;
+      return {
+        slug,
+        url: articleUrl(slug),
+        title,
+        summary,
+        author,
+        category,
+        publishedOn: date,
+        wordCount,
+        readingTimeMinutes: readingTime ?? Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        text,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ text?: unknown }>({
+    name: 'find-in-article',
+    description: 'Finds the passages of the open article that mention a word or phrase and scrolls the first one into view so the user can read it in context.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        text: { type: 'string', description: 'Word or phrase to look for, e.g. "Maillard reaction".' },
+      },
+      required: ['text'],
+    },
+    execute({ text }) {
+      if (typeof text !== 'string' || !text.trim()) {
+        return { error: 'Pass the word or phrase to find in the article.' };
+      }
+      const needle = text.trim().toLowerCase();
+      const matches = paragraphs().filter(element => element.innerText.toLowerCase().includes(needle));
+      if (matches.length === 0) {
+        return { error: `The article does not mention "${text}".` };
+      }
+      matches[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
+      return { matchCount: matches.length, passages: matches.map(element => element.innerText.trim()) };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
