diff --git a/src/components/ArticleAgentTools.tsx b/src/components/ArticleAgentTools.tsx
new file mode 100644
index 0000000..d4921c8
--- /dev/null
+++ b/src/components/ArticleAgentTools.tsx
@@ -0,0 +1,167 @@
+import { useEffect } from 'react';
+import { articleUrl, errorResult, registerTools, setReadingListMembership, textResult } from '../utils/webmcp';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  tags?: string[];
+}
+
+const WORDS_PER_MINUTE = 230;
+
+const getBody = () => document.querySelector<HTMLElement>('[data-article-body]');
+
+const getBodyText = () => getBody()?.innerText.trim() ?? '';
+
+const getHeadings = () =>
+  Array.from(getBody()?.querySelectorAll<HTMLHeadingElement>('h1, h2, h3, h4, h5, h6') ?? []);
+
+const countWords = (text: string) => text.split(/\s+/).filter(Boolean).length;
+
+function buildTools(article: Props): WebMCPTool[] {
+  const url = articleUrl(article.slug);
+
+  return [
+    {
+      name: 'get_current_article',
+      description:
+        'Get metadata for the article currently open in the browser: slug, title, summary, author, publish date, category, tags, URL, word count and estimated reading time.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        const wordCount = countWords(getBodyText());
+        return textResult({
+          ...article,
+          url,
+          wordCount,
+          readingTimeMinutes: Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        });
+      },
+    },
+    {
+      name: 'get_article_text',
+      description: 'Return the plain-text body of the article currently open in the browser.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          maxCharacters: {
+            type: 'number',
+            description: 'Truncate the text to this many characters. Omit to return the full body.',
+            minimum: 1,
+          },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      execute({ maxCharacters }: { maxCharacters?: number } = {}) {
+        const text = getBodyText();
+        if (!text) return errorResult('Article body not found on this page.');
+        return textResult(maxCharacters && text.length > maxCharacters ? `${text.slice(0, maxCharacters)}…` : text);
+      },
+    },
+    {
+      name: 'get_article_outline',
+      description: 'List the section headings of the article currently open in the browser, in reading order.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        const outline = getHeadings().map((heading, index) => ({
+          index,
+          level: Number(heading.tagName.slice(1)),
+          text: heading.innerText.trim(),
+        }));
+        return outline.length ? textResult(outline) : textResult('This article has no section headings.');
+      },
+    },
+    {
+      name: 'scroll_to_article_section',
+      description:
+        'Scroll the article to a section heading so the reader can see it. Match by heading text (case-insensitive, partial match) or by index from get_article_outline.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          heading: { type: 'string', description: 'Text of the heading to scroll to.' },
+          index: { type: 'number', description: 'Index of the heading as returned by get_article_outline.' },
+        },
+      },
+      execute({ heading, index }: { heading?: string; index?: number } = {}) {
+        const headings = getHeadings();
+        const target =
+          typeof index === 'number'
+            ? headings[index]
+            : heading
+              ? headings.find((h) => h.innerText.toLowerCase().includes(heading.trim().toLowerCase()))
+              : undefined;
+        if (!target) return errorResult('No matching section heading found. Use get_article_outline to list headings.');
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        return textResult(`Scrolled to "${target.innerText.trim()}".`);
+      },
+    },
+    {
+      name: 'find_in_article',
+      description:
+        'Find a word or phrase in the article currently open in the browser. Returns the number of matches and the paragraphs that contain it.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: { type: 'string', description: 'Word or phrase to look for (case-insensitive).' },
+        },
+        required: ['query'],
+      },
+      annotations: { readOnlyHint: true },
+      execute({ query }: { query: string }) {
+        const term = query?.trim().toLowerCase();
+        if (!term) return errorResult('Query must not be empty.');
+        const blocks = Array.from(getBody()?.querySelectorAll<HTMLElement>('p, li, h1, h2, h3, h4, h5, h6, blockquote') ?? []);
+        const matches = blocks.map((block) => block.innerText.trim()).filter((text) => text.toLowerCase().includes(term));
+        const occurrences = getBodyText().toLowerCase().split(term).length - 1;
+        return textResult({ query, occurrences, passages: matches });
+      },
+    },
+    {
+      name: 'get_article_share_links',
+      description: 'Get ready-to-use share links (Facebook, X, WhatsApp, email) for the article currently open in the browser.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        const encodedUrl = encodeURIComponent(url);
+        const encodedTitle = encodeURIComponent(article.title);
+        return textResult({
+          url,
+          facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
+          x: `https://x.com/intent/post?url=${encodedUrl}&text=${encodedTitle}`,
+          whatsapp: `https://wa.me/?text=${encodeURIComponent(`${article.title} ${url}`)}`,
+          email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
+        });
+      },
+    },
+    {
+      name: 'bookmark_current_article',
+      description:
+        "Save the article currently open in the browser to the reader's reading list, or remove it with saved=false.",
+      inputSchema: {
+        type: 'object',
+        properties: {
+          saved: { type: 'boolean', description: 'true to save the article (default), false to remove it.' },
+        },
+      },
+      async execute({ saved = true }: { saved?: boolean } = {}) {
+        try {
+          const readingList = await setReadingListMembership(article.slug, saved);
+          return textResult({ slug: article.slug, saved, readingList });
+        } catch (error) {
+          return errorResult((error as Error).message);
+        }
+      },
+    },
+  ];
+}
+
+/** Registers WebMCP tools for the article page it is rendered on. Renders nothing. */
+export default function ArticleAgentTools(props: Props) {
+  useEffect(() => registerTools(buildTools(props)), [props.slug]);
+  return null;
+}
