diff --git a/src/components/SiteAgentTools.tsx b/src/components/SiteAgentTools.tsx
new file mode 100644
index 0000000..647db8c
--- /dev/null
+++ b/src/components/SiteAgentTools.tsx
@@ -0,0 +1,132 @@
+import { useEffect } from 'react';
+import { navigate } from 'astro:transitions/client';
+import {
+  articleUrl,
+  errorResult,
+  fetchArticles,
+  OPEN_READING_LIST_EVENT,
+  OPEN_SEARCH_EVENT,
+  getReadingListArticles,
+  registerTools,
+  searchArticles,
+  setReadingListMembership,
+  textResult,
+} from '../utils/webmcp';
+
+const slugSchema = {
+  type: 'object',
+  properties: {
+    slug: {
+      type: 'string',
+      description: 'Article slug, as returned by search_articles or get_reading_list (e.g. "urban-cycling").',
+    },
+  },
+  required: ['slug'],
+};
+
+const tools: WebMCPTool[] = [
+  {
+    name: 'search_articles',
+    description:
+      'Search The DevTools Times articles by keyword. Matches against article titles and summaries and returns slug, title, summary and URL for each hit.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Keywords to search for, e.g. "cycling" or "housing".' },
+        limit: { type: 'number', description: 'Maximum number of results to return (default 10).', minimum: 1, maximum: 50 },
+      },
+      required: ['query'],
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ query, limit }: { query: string; limit?: number }) {
+      const results = await searchArticles(query ?? '', limit ?? 10);
+      return results.length ? textResult(results) : textResult(`No articles found for "${query}".`);
+    },
+  },
+  {
+    name: 'list_articles',
+    description: 'List every article published on The DevTools Times with its slug, title, summary and URL.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const articles = await fetchArticles();
+      return textResult(articles.map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) })));
+    },
+  },
+  {
+    name: 'get_reading_list',
+    description: "Return the articles currently saved in the reader's reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const articles = await getReadingListArticles();
+      return articles.length ? textResult(articles) : textResult('The reading list is empty.');
+    },
+  },
+  {
+    name: 'add_to_reading_list',
+    description: "Save an article to the reader's reading list. Does nothing if it is already saved.",
+    inputSchema: slugSchema,
+    async execute({ slug }: { slug: string }) {
+      try {
+        const readingList = await setReadingListMembership(slug, true);
+        return textResult({ added: slug, readingList });
+      } catch (error) {
+        return errorResult((error as Error).message);
+      }
+    },
+  },
+  {
+    name: 'remove_from_reading_list',
+    description: "Remove an article from the reader's reading list. Does nothing if it is not saved.",
+    inputSchema: slugSchema,
+    async execute({ slug }: { slug: string }) {
+      try {
+        const readingList = await setReadingListMembership(slug, false);
+        return textResult({ removed: slug, readingList });
+      } catch (error) {
+        return errorResult((error as Error).message);
+      }
+    },
+  },
+  {
+    name: 'open_article',
+    description: 'Navigate the browser to an article page.',
+    inputSchema: slugSchema,
+    async execute({ slug }: { slug: string }) {
+      const articles = await fetchArticles();
+      if (!articles.some((article) => article.slug === slug)) {
+        return errorResult(`Unknown article slug "${slug}".`);
+      }
+      const url = articleUrl(slug);
+      navigate(url);
+      return textResult(`Navigating to ${url}`);
+    },
+  },
+  {
+    name: 'open_search',
+    description:
+      'Open the search panel so the reader can see it. Once open, the "search_articles_form" form tool becomes available.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_SEARCH_EVENT));
+      return textResult('Search panel opened.');
+    },
+  },
+  {
+    name: 'open_reading_list',
+    description:
+      'Open the reading list panel so the reader can see it. Once open, the "update_reading_list_form" form tool becomes available.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_READING_LIST_EVENT));
+      return textResult('Reading list panel opened.');
+    },
+  },
+];
+
+/** Registers site-wide WebMCP tools. Renders nothing. */
+export default function SiteAgentTools() {
+  useEffect(() => registerTools(tools), []);
+  return null;
+}
