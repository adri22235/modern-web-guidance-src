+// Helpers for exposing client-side tools to in-browser AI agents via WebMCP
+// (`navigator.modelContext`). Everything here is a no-op in browsers that
+// don't implement the API.
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const READING_LIST_CHANGE_EVENT = 'reading-list-change';
+export const OPEN_SEARCH_EVENT = 'open-search-flyout';
+export const OPEN_READING_LIST_EVENT = 'open-reading-list-flyout';
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+export const articleUrl = (slug: string) =>
+  new URL(`${BASE_URL}articles/${slug}`, window.location.origin).toString();
+
+export const textResult = (data: unknown): WebMCPToolResult => ({
+  content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+});
+
+export const errorResult = (message: string): WebMCPToolResult => ({
+  content: [{ type: 'text', text: message }],
+  isError: true,
+});
+
+/**
+ * Registers the given tools with the browser's model context and returns a
+ * cleanup function that unregisters them again (e.g. on component unmount or
+ * Astro client-side navigation).
+ */
+export function registerTools(tools: WebMCPTool[]): () => void {
+  const modelContext = typeof navigator !== 'undefined' ? navigator.modelContext : undefined;
+  if (!modelContext?.registerTool) {
+    return () => {};
+  }
+
+  const controller = new AbortController();
+  const registered: string[] = [];
+
+  for (const tool of tools) {
+    try {
+      // Drop a stale registration with the same name (e.g. after a transition).
+      modelContext.unregisterTool?.(tool.name);
+    } catch {
+      // Not registered yet.
+    }
+    try {
+      modelContext.registerTool(tool, { signal: controller.signal });
+      registered.push(tool.name);
+    } catch (error) {
+      console.warn(`[webmcp] Failed to register tool "${tool.name}":`, error);
+    }
+  }
+
+  return () => {
+    controller.abort();
+    for (const name of registered) {
+      try {
+        modelContext.unregisterTool?.(name);
+      } catch {
+        // Already removed via the abort signal.
+      }
+    }
+  };
+}
+
+let articlesPromise: Promise<ArticleSummary[]> | null = null;
+
+export function fetchArticles(): Promise<ArticleSummary[]> {
+  articlesPromise ??= fetch(`${BASE_URL}api/articles.json`)
+    .then((response) => {
+      if (!response.ok) throw new Error(`Failed to load articles (${response.status})`);
+      return response.json() as Promise<ArticleSummary[]>;
+    })
+    .catch((error) => {
+      articlesPromise = null;
+      throw error;
+    });
+  return articlesPromise;
+}
+
+export async function searchArticles(query: string, limit = 10) {
+  const term = query.trim().toLowerCase();
+  if (!term) return [];
+  const articles = await fetchArticles();
+  return articles
+    .filter(
+      (article) =>
+        article.title.toLowerCase().includes(term) ||
+        article.summary.toLowerCase().includes(term),
+    )
+    .slice(0, limit)
+    .map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) }));
+}
+
+export async function getReadingList(): Promise<string[]> {
+  const response = await fetch(`${BASE_URL}api/reading-list.json`);
+  if (!response.ok) throw new Error(`Failed to load reading list (${response.status})`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+export async function getReadingListArticles() {
+  const [readingList, articles] = await Promise.all([getReadingList(), fetchArticles()]);
+  return articles
+    .filter((article) => readingList.includes(article.slug))
+    .map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) }));
+}
+
+/**
+ * Adds or removes an article from the reading list. The API only exposes a
+ * toggle, so the current state is checked first to make this idempotent.
+ */
+export async function setReadingListMembership(slug: string, saved: boolean): Promise<string[]> {
+  const articles = await fetchArticles();
+  if (!articles.some((article) => article.slug === slug)) {
+    throw new Error(`Unknown article slug "${slug}".`);
+  }
+
+  let readingList = await getReadingList();
+  if (readingList.includes(slug) !== saved) {
+    const response = await fetch(`${BASE_URL}api/reading-list.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug }),
+    });
+    if (!response.ok) throw new Error(`Failed to update reading list (${response.status})`);
+    readingList = (await response.json()).readingList ?? [];
+  }
+
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGE_EVENT, { detail: { readingList } }));
+  return readingList;
+}
