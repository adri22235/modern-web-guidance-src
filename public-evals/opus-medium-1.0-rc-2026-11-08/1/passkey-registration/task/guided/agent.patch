+  <script type="module">
+    const registerButton = document.getElementById('register-button');
+    const statusEl = document.getElementById('passkey-status');
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    // Minimal fallbacks for browsers that support WebAuthn but not the JSON helpers.
+    function base64urlToBuffer(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
+      return Uint8Array.from(atob(padded), (c) => c.charCodeAt(0)).buffer;
+    }
+
+    function bufferToBase64url(buffer) {
+      const bytes = new Uint8Array(buffer);
+      let binary = '';
+      for (const byte of bytes) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseCreationOptions(json) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: base64urlToBuffer(json.challenge),
+        user: { ...json.user, id: base64urlToBuffer(json.user.id) },
+        excludeCredentials: (json.excludeCredentials ?? []).map((cred) => ({
+          ...cred,
+          id: base64urlToBuffer(cred.id),
+        })),
+      };
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') {
+        return credential.toJSON();
+      }
+      const { response } = credential;
+      return {
+        id: credential.id,
+        rawId: bufferToBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+        clientExtensionResults: credential.getClientExtensionResults(),
+        response: {
+          clientDataJSON: bufferToBase64url(response.clientDataJSON),
+          attestationObject: bufferToBase64url(response.attestationObject),
+          transports: response.getTransports?.() ?? [],
+        },
+      };
+    }
+
+    async function isPasskeySupported() {
+      if (!window.PublicKeyCredential || !window.isSecureContext) return false;
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet);
+      }
+      const [platform, conditional] = await Promise.all([
+        PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.() ?? false,
+        PublicKeyCredential.isConditionalMediationAvailable?.() ?? false,
+      ]);
+      return Boolean(platform && conditional);
+    }
+
+    async function signalUnknown(rpId, credentialId) {
+      if (!rpId || typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function registerPasskey() {
+      registerButton.disabled = true;
+      setStatus('Preparing passkey creation…');
+
+      try {
+        let creationOptionsJSON;
+        try {
+          const optionsResponse = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ promotion: true }),
+          });
+          if (!optionsResponse.ok) throw new Error(`HTTP ${optionsResponse.status}`);
+          creationOptionsJSON = await optionsResponse.json();
+        } catch (err) {
+          console.error('Failed to fetch passkey creation options:', err);
+          setStatus('Could not start passkey creation. Please try again later.', 'error');
+          return;
+        }
+
+        const publicKey = parseCreationOptions(creationOptionsJSON);
+
+        let credential;
+        try {
+          setStatus('Follow the prompt from your device to create a passkey.');
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (err) {
+          // Standard WebAuthn errors: do not signal unknown credentials here.
+          switch (err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey already exists for this account on this device.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled.');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.');
+              break;
+            case 'SecurityError':
+              console.error('Passkey RP ID or secure context configuration error:', err);
+              setStatus('Passkeys are unavailable on this site right now.', 'error');
+              break;
+            default:
+              console.error('Passkey creation failed:', err);
+              setStatus('Something went wrong while creating your passkey.', 'error');
+          }
+          return;
+        }
+
+        if (!credential) {
+          setStatus('Passkey creation was cancelled.');
+          return;
+        }
+
+        const encodedCredential = serializeCredential(credential);
+        // Always use the server-provided RP ID, never window.location.hostname.
+        const rpId = publicKey.rp?.id;
+
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedCredential),
+          });
+          if (!verifyResponse.ok) {
+            await signalUnknown(rpId, encodedCredential.id);
+            setStatus('We could not verify your new passkey. Please try again.', 'error');
+            return;
+          }
+        } catch (err) {
+          console.error('Passkey verification network failure:', err);
+          await signalUnknown(rpId, encodedCredential.id);
+          setStatus('We could not verify your new passkey. Please try again.', 'error');
+          return;
+        }
+
+        setStatus('Your passkey was created. You can now use it to sign in.', 'success');
+      } finally {
+        registerButton.disabled = false;
+      }
+    }
+
+    registerButton.addEventListener('click', registerPasskey);
+
+    isPasskeySupported()
+      .then((supported) => {
+        registerButton.disabled = !supported;
+        if (!supported) {
+          setStatus('Passkeys aren’t supported on this device. Keep signing in with your password.');
+        }
+      })
+      .catch((err) => {
+        console.error('Could not determine passkey support:', err);
+        setStatus('Passkeys aren’t available right now. Keep signing in with your password.');
+      });
+  </script>
+
