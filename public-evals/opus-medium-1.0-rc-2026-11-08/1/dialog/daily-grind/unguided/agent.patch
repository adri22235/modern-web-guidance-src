+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          info: 'Double shot of our house espresso, steamed oat milk, and real maple syrup. Served hot.',
+          price: 5.25,
+          defaultMilk: 'oat',
+          image: 'https://images.unsplash.com/photo-1561882468-9110e03e0f78?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Latte with leaf latte art in a ceramic cup'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          info: 'A rich double shot pulled from our dark roast blend with notes of cocoa and toasted oak.',
+          price: 3.50,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Espresso shot in a small cup'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          info: 'Coarse-ground beans slow-steeped in cold water, served over ice. Naturally low in acidity.',
+          price: 4.75,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Iced coffee in a glass'
+        }
+      };
+      const SIZE_UPCHARGE = { small: 0, medium: 0.5, large: 1 };
+      const MILK_UPCHARGE = { oat: 0.6, almond: 0.6 };
+      const EXTRA_SHOT = 0.75;
+
+      const dialog = document.getElementById('order-dialog');
+      const form = document.getElementById('order-form');
+      const drinkSelect = document.getElementById('order-drink');
+      const quantityInput = document.getElementById('order-quantity');
+      const discardConfirm = document.getElementById('discard-confirm');
+      const footer = document.getElementById('dialog-footer');
+      const keepEditingBtn = document.getElementById('keep-editing');
+      const discardBtn = document.getElementById('discard-changes');
+      const toast = document.getElementById('order-toast');
+      const image = document.getElementById('order-dialog-image');
+
+      // Bypass flag so programmatic closes (confirm / discard) aren't intercepted.
+      let allowClose = false;
+      let initialState = '';
+      let toastTimer;
+
+      Object.entries(DRINKS).forEach(([key, drink]) => {
+        drinkSelect.add(new Option(drink.name, key));
+      });
+
+      const money = (n) => '$' + n.toFixed(2);
+
+      function serialize() {
+        return new URLSearchParams(new FormData(form)).toString();
+      }
+
+      function isDirty() {
+        return dialog.open && serialize() !== initialState;
+      }
+
+      function getQuantity() {
+        const q = parseInt(quantityInput.value, 10);
+        return Number.isFinite(q) ? Math.min(10, Math.max(1, q)) : 1;
+      }
+
+      function unitPrice() {
+        const data = new FormData(form);
+        const drink = DRINKS[data.get('drink')];
+        return drink.price +
+          (SIZE_UPCHARGE[data.get('size')] || 0) +
+          (MILK_UPCHARGE[data.get('milk')] || 0) +
+          (data.get('extraShot') ? EXTRA_SHOT : 0);
+      }
+
+      function renderDrink() {
+        const drink = DRINKS[drinkSelect.value];
+        document.getElementById('order-dialog-title').textContent = drink.name;
+        document.getElementById('order-dialog-price').textContent = 'From ' + money(drink.price);
+        document.getElementById('order-dialog-description').textContent = drink.description;
+        document.getElementById('order-dialog-info').textContent = drink.info;
+        image.hidden = false;
+        image.src = drink.image;
+        image.alt = drink.imageAlt;
+        renderTotal();
+      }
+
+      function renderTotal() {
+        document.getElementById('order-total').textContent = money(unitPrice() * getQuantity());
+      }
+
+      function showDiscardConfirm() {
+        discardConfirm.hidden = false;
+        footer.hidden = true;
+        keepEditingBtn.focus();
+      }
+
+      function hideDiscardConfirm() {
+        discardConfirm.hidden = true;
+        footer.hidden = false;
+      }
+
+      function closeDialog() {
+        allowClose = true;
+        dialog.close();
+      }
+
+      // Every user-initiated dismissal goes through here.
+      function requestClose() {
+        if (isDirty()) {
+          showDiscardConfirm();
+        } else {
+          closeDialog();
+        }
+      }
+
+      function openDialog(drinkKey) {
+        form.reset();
+        drinkSelect.value = DRINKS[drinkKey] ? drinkKey : Object.keys(DRINKS)[0];
+        form.elements.size.value = 'medium';
+        form.elements.milk.value = DRINKS[drinkSelect.value].defaultMilk;
+        hideDiscardConfirm();
+        renderDrink();
+        initialState = serialize();
+        dialog.showModal();
+        form.querySelector('.dialog-body').scrollTop = 0;
+      }
+
+      function showToast(message) {
+        toast.textContent = message;
+        toast.hidden = false;
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => { toast.hidden = true; }, 4000);
+      }
+
+      document.querySelectorAll('[data-order-drink]').forEach((link) => {
+        link.addEventListener('click', (event) => {
+          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          event.preventDefault();
+          openDialog(link.dataset.orderDrink);
+        });
+      });
+
+      image.addEventListener('error', () => { image.hidden = true; });
+
+      drinkSelect.addEventListener('change', renderDrink);
+      form.addEventListener('input', () => {
+        renderTotal();
+        // Reverting edits back to the original options removes the need to confirm.
+        if (!discardConfirm.hidden && !isDirty()) hideDiscardConfirm();
+      });
+      form.addEventListener('change', renderTotal);
+      quantityInput.addEventListener('blur', () => {
+        quantityInput.value = getQuantity();
+        renderTotal();
+      });
+
+      form.querySelectorAll('[data-dismiss]').forEach((btn) => {
+        btn.addEventListener('click', requestClose);
+      });
+
+      keepEditingBtn.addEventListener('click', () => {
+        hideDiscardConfirm();
+        drinkSelect.focus();
+      });
+
+      discardBtn.addEventListener('click', closeDialog);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        quantityInput.value = getQuantity();
+        const data = new FormData(form);
+        const drink = DRINKS[data.get('drink')];
+        const qty = getQuantity();
+        const size = data.get('size');
+        const total = money(unitPrice() * qty);
+        closeDialog();
+        showToast(`Added ${qty} × ${size.charAt(0).toUpperCase() + size.slice(1)} ${drink.name} to your order (${total}).`);
+      });
+
+      // Escape key: handle ourselves so the browser never closes the dialog directly.
+      dialog.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          if (!discardConfirm.hidden) {
+            hideDiscardConfirm();
+            drinkSelect.focus();
+          } else {
+            requestClose();
+          }
+        }
+      });
+
+      // Other close requests (e.g. Android back gesture).
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        requestClose();
+      });
+
+      // Backdrop click. Track where the press started so a text selection drag
+      // that ends on the backdrop doesn't count as a dismissal.
+      let pressStartedOnBackdrop = false;
+      dialog.addEventListener('pointerdown', (event) => {
+        pressStartedOnBackdrop = event.target === dialog;
+      });
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog && pressStartedOnBackdrop) requestClose();
+        pressStartedOnBackdrop = false;
+      });
+
+      // Safety net: if the browser closes the dialog anyway (some browsers don't
+      // allow repeated close requests to be cancelled), reopen it with the
+      // user's edits intact and ask for confirmation.
+      // The close event is dispatched asynchronously, so reset the flag here.
+      dialog.addEventListener('close', () => {
+        const intended = allowClose;
+        allowClose = false;
+        if (!intended && serialize() !== initialState) {
+          dialog.showModal();
+          showDiscardConfirm();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
