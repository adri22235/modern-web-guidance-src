+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        notes: 'Tasting notes: toasted oats, caramel, warm maple.',
+        price: 5.25,
+        milk: 'oat',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1000&q=80',
+        alt: 'A latte with leaf-shaped foam art in a ceramic cup',
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        notes: 'Tasting notes: dark chocolate, smoke, molasses.',
+        price: 3.25,
+        milk: 'none',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1000&q=80',
+        alt: 'A shot of espresso with rich crema in a small cup',
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        notes: 'Tasting notes: cocoa, stone fruit, low acidity.',
+        price: 4.5,
+        milk: 'none',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1000&q=80',
+        alt: 'A glass of iced cold brew coffee',
+      },
+    };
+    const SIZE_UPCHARGE = { small: -0.5, medium: 0, large: 0.75 };
+    const EXTRA_SHOT = 0.75;
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-form');
+    const drinkSelect = document.getElementById('order-drink');
+    const discardBtn = document.getElementById('discard-btn');
+    const cancelBtn = document.getElementById('cancel-btn');
+    const status = document.getElementById('order-status');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    for (const [id, drink] of Object.entries(DRINKS)) {
+      drinkSelect.add(new Option(drink.name, id));
+    }
+
+    let initialState = '';
+    const serialize = () => new URLSearchParams(new FormData(form)).toString();
+    const isDirty = () => serialize() !== initialState;
+
+    function renderDrink() {
+      const drink = DRINKS[drinkSelect.value];
+      document.getElementById('drink-name').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      document.getElementById('drink-notes').textContent = drink.notes;
+      document.getElementById('drink-price').textContent = `from ${currency.format(drink.price + SIZE_UPCHARGE.small)}`;
+      const img = document.getElementById('drink-image');
+      img.src = drink.image;
+      img.alt = drink.alt;
+    }
+
+    function orderTotal() {
+      const data = new FormData(form);
+      const unit = DRINKS[data.get('drink')].price
+        + SIZE_UPCHARGE[data.get('size')]
+        + (data.get('extraShot') ? EXTRA_SHOT : 0);
+      return unit * Math.max(1, Number(data.get('quantity')) || 1);
+    }
+
+    function setConfirmingDiscard(on) {
+      dialog.classList.toggle('confirming-discard', on);
+    }
+
+    function updateState() {
+      document.getElementById('order-total').textContent = `Total: ${currency.format(orderTotal())}`;
+      const dirty = isDirty();
+      // Once the order is edited, only explicit buttons may close the dialog
+      dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+      if (!dirty) setConfirmingDiscard(false);
+    }
+
+    function openFor(drinkId) {
+      form.reset();
+      drinkSelect.value = drinkId in DRINKS ? drinkId : drinkSelect.options[0].value;
+      form.elements.milk.value = DRINKS[drinkSelect.value].milk;
+      renderDrink();
+      initialState = serialize();
+      dialog.returnValue = '';
+      setConfirmingDiscard(false);
+      updateState();
+    }
+
+    // Prompt for confirmation instead of closing when there are unsaved changes
+    function blockDismissal() {
+      setConfirmingDiscard(true);
+      discardBtn.focus();
+    }
+
+    function attemptDismiss() {
+      if (isDirty()) blockDismissal();
+      else dialog.close();
+    }
+
+    // The command event fires on the dialog before it opens; source is the invoking button
+    dialog.addEventListener('command', (event) => {
+      if (event.command === 'show-modal') openFor(event.source?.dataset.drink);
+    });
+
+    drinkSelect.addEventListener('change', () => {
+      form.elements.milk.value = DRINKS[drinkSelect.value].milk;
+      renderDrink();
+    });
+    form.addEventListener('input', updateState);
+    form.addEventListener('change', updateState);
+
+    // Esc, back gesture and light dismiss all fire cancel; guard here too for browsers without closedby
+    dialog.addEventListener('cancel', (event) => {
+      if (isDirty()) {
+        event.preventDefault();
+        blockDismissal();
+      }
+    });
+
+    cancelBtn.addEventListener('click', attemptDismiss);
+
+    discardBtn.addEventListener('click', () => {
+      initialState = serialize();
+      dialog.close();
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'confirm') {
+        const data = new FormData(form);
+        const qty = Number(data.get('quantity')) || 1;
+        const size = data.get('size');
+        status.textContent = `Added ${qty} × ${size} ${DRINKS[data.get('drink')].name} to your order (${currency.format(orderTotal())}).`;
+      }
+      dialog.returnValue = '';
+      setConfirmingDiscard(false);
+      dialog.setAttribute('closedby', 'any');
+    });
+
+    // Light-dismiss fallback where closedby is unsupported (Safari)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e)) attemptDismiss();
+      });
+    }
+  </script>
+
 </body>
 
