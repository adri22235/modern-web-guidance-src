+    /* Seasonal Favorites Carousel */
+    .carousel {
+      display: flex;
+      gap: 20px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: contain;
+      /* Room for the scaled-up snapped card, and inline padding so the first/last items can center */
+      padding: 40px calc(50% - 130px);
+      margin-top: 20px;
+    }
+
+    .carousel-item {
+      flex: 0 0 260px;
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel-item .card {
+      height: 100%;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    .carousel-item .card h3 {
+      transition: color 0.4s;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+
+        .card h3 {
+          color: white;
+        }
+      }
+
+      /* JS fallback for browsers without scroll-state container queries */
+      .carousel-item.is-snapped .card {
+        background: #007bff;
+        color: white;
+        scale: 1.15;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel-item .card,
+      .carousel-item .card h3 {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
