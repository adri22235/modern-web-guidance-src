+  <script>
+    // Highlight whichever carousel item is currently snapped.
+    document.querySelectorAll('.carousel').forEach((carousel) => {
+      const items = Array.from(carousel.querySelectorAll('.carousel-item'));
+      if (!items.length) return;
+
+      const setSnapped = (target) => {
+        items.forEach((item) => item.classList.toggle('is-snapped', item === target));
+      };
+
+      // Fallback: pick the item whose center is closest to the carousel's center.
+      const findClosest = () => {
+        const center = carousel.getBoundingClientRect().left + carousel.clientWidth / 2;
+        let closest = items[0];
+        let minDist = Infinity;
+        items.forEach((item) => {
+          const rect = item.getBoundingClientRect();
+          const dist = Math.abs(rect.left + rect.width / 2 - center);
+          if (dist < minDist) {
+            minDist = dist;
+            closest = item;
+          }
+        });
+        return closest;
+      };
+
+      if ('onscrollsnapchange' in window) {
+        carousel.addEventListener('scrollsnapchange', (e) => {
+          const target = e.snapTargetInline && e.snapTargetInline.closest('.carousel-item');
+          setSnapped(target || findClosest());
+        });
+      } else {
+        let timer;
+        const update = () => setSnapped(findClosest());
+        if ('onscrollend' in window) {
+          carousel.addEventListener('scrollend', update);
+        } else {
+          carousel.addEventListener('scroll', () => {
+            clearTimeout(timer);
+            timer = setTimeout(update, 100);
+          }, { passive: true });
+        }
+      }
+
+      window.addEventListener('resize', () => setSnapped(findClosest()));
+      requestAnimationFrame(() => setSnapped(findClosest()));
+    });
+  </script>
+
