diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,41 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: cards grow from half size as they enter the
+       viewport and shrink back as they leave. Progressive enhancement only:
+       browsers without support, or users who prefer reduced motion, get the
+       static full-size cards. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        @keyframes card-grow {
+          from {
+            scale: 0.5;
+          }
+        }
+
+        @keyframes card-shrink {
+          to {
+            scale: 0.5;
+          }
+        }
+
+        .card {
+          animation:
+            card-grow auto linear backwards,
+            card-shrink auto linear forwards;
+          animation-timeline: view();
+          animation-range: entry, exit;
+        }
+
+        /* Keep keyboard-focused cards at full size so their content stays legible */
+        .card:focus-within {
+          animation: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
