diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,46 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: cards grow from half size as they enter the
+       viewport and shrink back as they leave. Pure CSS, only applied when the
+       browser supports scroll timelines and the user hasn't asked for reduced
+       motion; otherwise cards simply render at full size. */
+    @keyframes card-reveal {
+      entry 0% {
+        scale: 0.5;
+      }
+
+      entry 100% {
+        scale: 1;
+      }
+
+      exit 0% {
+        scale: 1;
+      }
+
+      exit 100% {
+        scale: 0.5;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+          animation-range: entry 0% exit 100%;
+        }
+
+        /* Keep keyboard-focused cards at full size so focus is never on a
+           shrunken, hard-to-read element. */
+        .card:focus-within {
+          animation: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
