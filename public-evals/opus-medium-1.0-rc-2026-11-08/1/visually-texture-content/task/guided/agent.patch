+      filter: sepia(0.35) contrast(1.05);
+
+      -webkit-mask-image: var(--grunge-texture);
+      -webkit-mask-repeat: repeat;
+      -webkit-mask-size: 400px;
+      mask-image: var(--grunge-texture);
+      mask-repeat: repeat;
+      mask-size: 400px;
+    }
+
+    .weathered-bg h1,
+    .weathered-bg p {
+      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
