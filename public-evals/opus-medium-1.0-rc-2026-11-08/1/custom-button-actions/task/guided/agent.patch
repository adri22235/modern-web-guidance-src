+  <script>
+    // Load the Invoker Commands polyfill only where commandfor/command isn't supported
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      (async () => {
+        try {
+          await import('https://esm.run/invokers-polyfill');
+        } catch (err) {
+          console.error('Error loading invokers polyfill:', err);
+        }
+      })();
+    }
+
+    const toggleCommands = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    const actionTarget = document.getElementById('action-target');
+
+    // The command event doesn't bubble, so listen on the target itself
+    actionTarget.addEventListener('command', (event) => {
+      const target = event.target;
+
+      if (event.command === '--reset') {
+        target.classList.remove(...Object.values(toggleCommands));
+        document.querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`)
+          .forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+        return;
+      }
+
+      const className = toggleCommands[event.command];
+      if (!className) return;
+
+      const isOn = target.classList.toggle(className);
+      // Custom commands have no built-in semantics, so sync aria-pressed manually
+      event.source?.setAttribute('aria-pressed', String(isOn));
+    });
+  </script>
+
