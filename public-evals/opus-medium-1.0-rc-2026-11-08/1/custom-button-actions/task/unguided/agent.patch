+  <script>
+    (function () {
+      var target = document.getElementById('action-target');
+      var toggles = document.querySelectorAll('[data-toggle-class]');
+
+      toggles.forEach(function (button) {
+        button.addEventListener('click', function () {
+          var active = target.classList.toggle(button.dataset.toggleClass);
+          button.setAttribute('aria-pressed', String(active));
+        });
+      });
+
+      document.getElementById('reset-all').addEventListener('click', function () {
+        target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+        toggles.forEach(function (button) {
+          button.setAttribute('aria-pressed', 'false');
+        });
+      });
+    })();
+  </script>
