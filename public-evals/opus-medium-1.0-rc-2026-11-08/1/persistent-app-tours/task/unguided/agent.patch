     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title">
+    <h4 id="tour-step-title">Earn points with Rewards</h4>
+    <p>Earn points with every purchase and redeem them for free drinks and treats.</p>
+    <button type="button" id="tour-step-close">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      const link = document.getElementById('feature');
+      const tour = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('tour-step-close');
+      const supportsAnchor = CSS.supports('anchor-name: --a');
+      let rafId = null;
+
+      // Fallback positioning: follow the link every frame while the tour is open.
+      function track() {
+        const r = link.getBoundingClientRect();
+        tour.style.setProperty('--tour-top', r.bottom + 'px');
+        tour.style.setProperty('--tour-left', (r.left + r.width / 2) + 'px');
+        rafId = requestAnimationFrame(track);
+      }
+
+      // Keep the user on the page while the tour is showing.
+      link.addEventListener('click', function (e) {
+        if (tour.matches(':popover-open')) e.preventDefault();
+      });
+
+      closeBtn.addEventListener('click', function () {
+        tour.hidePopover();
+      });
+
+      tour.addEventListener('toggle', function (e) {
+        if (e.newState === 'closed' && rafId !== null) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+      });
+
+      if (!supportsAnchor) {
+        tour.classList.add('js-positioned');
+        track();
+      }
+      tour.showPopover();
+    })();
+  </script>
+
 </body>
 
 </html>
