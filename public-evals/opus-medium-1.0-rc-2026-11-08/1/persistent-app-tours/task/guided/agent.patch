+  <script type="module">
+    // Load polyfills only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const tourStep = document.getElementById("tour-step");
+    const rewardsLink = document.getElementById("feature");
+    let tourOpen = false;
+
+    tourStep.addEventListener("toggle", (event) => {
+      tourOpen = event.newState === "open";
+    });
+
+    // Keep the user on the page while the tour step is showing.
+    rewardsLink.addEventListener("click", (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+
+    // Return focus to the related control when the tour step is dismissed.
+    tourStep.querySelector("button").addEventListener("click", () => {
+      rewardsLink.focus();
+    });
+
+    tourStep.showPopover();
+    tourOpen = true;
+  </script>
+
