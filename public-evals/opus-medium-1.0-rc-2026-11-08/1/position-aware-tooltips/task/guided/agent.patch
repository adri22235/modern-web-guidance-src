+    @supports (anchor-name: --a) {
+      .tooltip {
+        inset: auto;
+        margin: unset;
+        position-area: block-start center;
+        position-try-fallbacks: flip-block;
+        /* Enable anchored container queries for arrow orientation */
+        container-type: anchored;
+      }
+    }
+
+    .tooltip-content {
+      position: relative;
+      max-width: 260px;
+      margin-block: var(--arrow-size);
+      padding: 12px 14px;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
