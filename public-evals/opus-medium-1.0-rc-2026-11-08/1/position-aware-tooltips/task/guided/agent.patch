+    }
+
+    .tooltip-content strong {
+      color: var(--accent);
+    }
+
+    /* Arrow: shown only where it can follow the active fallback */
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        content: "";
+        position: absolute;
+        left: 50%;
+        width: var(--arrow-size);
+        height: var(--arrow-size);
+        background: inherit;
+        /* Default: tooltip above anchor, arrow points down */
+        inset-block-end: 0;
+        transform: translate(-50%, 50%) rotate(45deg);
+      }
+
+      /* Flipped below the anchor: arrow moves to the top, points up */
+      @container anchored(fallback: flip-block) {
+        .tooltip-content::before {
+          inset-block-start: 0;
+          inset-block-end: auto;
+          transform: translate(-50%, -50%) rotate(45deg);
+        }
+      }
+    }
