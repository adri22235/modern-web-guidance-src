+  <div id="maple-tooltip" class="tooltip" role="tooltip" data-placement="top">
+    <strong>Seasonal pick:</strong> 12&nbsp;oz &middot; 180&nbsp;cal &middot; dairy-free.
+    Sweetened with Grade&nbsp;A Vermont maple syrup. Available through February.
+    <span class="tooltip-arrow" aria-hidden="true"></span>
+  </div>
+
+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('maple-tooltip');
+      const arrow = tooltip.querySelector('.tooltip-arrow');
+      const nav = document.querySelector('nav');
+
+      const GAP = 12;       // distance between anchor and tooltip
+      const PADDING = 8;    // min distance from viewport edges
+      const ARROW_EDGE = 8; // keep arrow away from rounded corners
+      const OPPOSITE = { top: 'bottom', bottom: 'top', left: 'right', right: 'left' };
+      const PREFERRED = 'top';
+
+      let pinned = false;
+
+      function viewportBounds() {
+        // The sticky nav covers the top of the viewport, so treat its bottom as the top edge.
+        const navBottom = nav ? Math.max(0, nav.getBoundingClientRect().bottom) : 0;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+        return { top: navBottom + PADDING, left: PADDING, right: vw - PADDING, bottom: vh - PADDING };
+      }
+
+      function coordsFor(placement, a, t) {
+        switch (placement) {
+          case 'top': return { x: a.left + a.width / 2 - t.width / 2, y: a.top - t.height - GAP };
+          case 'bottom': return { x: a.left + a.width / 2 - t.width / 2, y: a.bottom + GAP };
+          case 'left': return { x: a.left - t.width - GAP, y: a.top + a.height / 2 - t.height / 2 };
+          case 'right': return { x: a.right + GAP, y: a.top + a.height / 2 - t.height / 2 };
+        }
+      }
+
+      function fitsMainAxis(placement, c, t, b) {
+        switch (placement) {
+          case 'top': return c.y >= b.top;
+          case 'bottom': return c.y + t.height <= b.bottom;
+          case 'left': return c.x >= b.left;
+          case 'right': return c.x + t.width <= b.right;
+        }
+      }
+
+      function clamp(v, min, max) {
+        return Math.max(min, Math.min(v, Math.max(min, max)));
+      }
+
+      function position() {
+        const a = anchor.getBoundingClientRect();
+        const t = tooltip.getBoundingClientRect();
+        const b = viewportBounds();
+
+        // Try preferred side, then flip to the opposite, then the cross-axis sides.
+        const order = PREFERRED === 'top' || PREFERRED === 'bottom'
+          ? [PREFERRED, OPPOSITE[PREFERRED], 'right', 'left']
+          : [PREFERRED, OPPOSITE[PREFERRED], 'top', 'bottom'];
+
+        let placement = order.find(p => fitsMainAxis(p, coordsFor(p, a, t), t, b));
+        if (!placement) {
+          // Nothing fits cleanly: pick the side with the most room.
+          const space = { top: a.top - b.top, bottom: b.bottom - a.bottom, left: a.left - b.left, right: b.right - a.right };
+          placement = order.reduce((best, p) => (space[p] > space[best] ? p : best), order[0]);
+        }
+
+        const c = coordsFor(placement, a, t);
+        const vertical = placement === 'top' || placement === 'bottom';
+
+        // Shift along the cross axis so the tooltip stays within the viewport.
+        if (vertical) c.x = clamp(c.x, b.left, b.right - t.width);
+        else c.y = clamp(c.y, b.top, b.bottom - t.height);
+
+        tooltip.dataset.placement = placement;
+        tooltip.style.transform = `translate(${Math.round(c.x)}px, ${Math.round(c.y)}px)`;
+
+        // Point the arrow at the anchor's center, even after shifting.
+        const arrowSize = arrow.offsetWidth;
+        arrow.style.left = arrow.style.top = '';
+        if (vertical) {
+          const ax = a.left + a.width / 2 - c.x - arrowSize / 2;
+          arrow.style.left = clamp(ax, ARROW_EDGE, t.width - arrowSize - ARROW_EDGE) + 'px';
+        } else {
+          const ay = a.top + a.height / 2 - c.y - arrowSize / 2;
+          arrow.style.top = clamp(ay, ARROW_EDGE, t.height - arrowSize - ARROW_EDGE) + 'px';
+        }
+      }
+
+      function show() {
+        position();
+        tooltip.classList.add('is-visible');
+        anchor.setAttribute('aria-expanded', 'true');
+        window.addEventListener('scroll', position, { passive: true, capture: true });
+        window.addEventListener('resize', position);
+      }
+
+      function hide() {
+        if (pinned) return;
+        tooltip.classList.remove('is-visible');
+        anchor.setAttribute('aria-expanded', 'false');
+        window.removeEventListener('scroll', position, { capture: true });
+        window.removeEventListener('resize', position);
+      }
+
+      function forceHide() {
+        pinned = false;
+        hide();
+      }
+
+      anchor.addEventListener('mouseenter', show);
+      anchor.addEventListener('mouseleave', hide);
+      anchor.addEventListener('focus', show);
+      anchor.addEventListener('blur', forceHide);
+      anchor.addEventListener('click', () => {
+        pinned = !pinned;
+        pinned ? show() : hide();
+      });
+
+      tooltip.addEventListener('mouseenter', show);
+      tooltip.addEventListener('mouseleave', hide);
+
+      document.addEventListener('keydown', e => {
+        if (e.key === 'Escape' && tooltip.classList.contains('is-visible')) forceHide();
+      });
+      document.addEventListener('pointerdown', e => {
+        if (!anchor.contains(e.target) && !tooltip.contains(e.target)) forceHide();
+      });
+    })();
+  </script>
+
