+  <script>
+    // Lazy-load offscreen media. Poster/preload live in data-* attributes so that no browser fetches
+    // them during parsing; we restore them here.
+    (() => {
+      const lazyMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+
+      function restore(media) {
+        if (media.dataset.poster) {
+          media.poster = media.dataset.poster;
+          delete media.dataset.poster;
+        }
+        if (media.dataset.preload) {
+          media.preload = media.dataset.preload;
+          delete media.dataset.preload;
+        }
+      }
+
+      if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+        // Native support: loading="lazy" defers the poster and preload until the player nears the viewport.
+        lazyMedia.forEach(restore);
+        return;
+      }
+
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          restore(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '200px 0px' });
+
+      lazyMedia.forEach((media) => observer.observe(media));
+    })();
+
+    // Hero background video: let visitors pause it, and don't autoplay for reduced-motion users.
+    (() => {
+      const video = document.querySelector('.hero-video');
+      const toggle = document.querySelector('.hero-video-toggle');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setPlaying(playing) {
+        if (playing) {
+          video.play().catch(() => {});
+        } else {
+          video.pause();
+        }
+        toggle.setAttribute('aria-pressed', String(!playing));
+        toggle.textContent = playing ? 'Pause background video' : 'Play background video';
+      }
+
+      toggle.addEventListener('click', () => setPlaying(video.paused));
+
+      if (reducedMotion.matches) {
+        video.removeAttribute('autoplay');
+        setPlaying(false);
+      }
+      reducedMotion.addEventListener('change', (event) => setPlaying(!event.matches));
+    })();
+  </script>
+
