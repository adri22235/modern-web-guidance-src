+  <script>
+    (function () {
+      var mediaEls = document.querySelectorAll('.lazy-media');
+
+      function loadMedia(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          delete el.dataset.poster;
+        }
+        if (el.dataset.src) {
+          el.src = el.dataset.src;
+          delete el.dataset.src;
+        }
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+          delete source.dataset.src;
+        });
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        mediaEls.forEach(loadMedia);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            loadMedia(entry.target);
+            observer.unobserve(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      mediaEls.forEach(function (el) {
+        observer.observe(el);
+      });
+    })();
+
+    // Respect reduced-motion preferences by stopping the hero loop.
+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      var heroVideo = document.querySelector('.hero-video');
+      if (heroVideo) heroVideo.pause();
+    }
+  </script>
