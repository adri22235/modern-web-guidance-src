+  <script type="module">
+    // Temporal isn't in Safari yet; load the polyfill only when needed.
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+      }
+    }
+
+    function formatInterval(duration) {
+      if (duration.blank) return '0 ns (simultaneous)';
+      try {
+        return duration.toLocaleString(undefined, { style: 'narrow' });
+      } catch {
+        // No Intl.DurationFormat: fall back to the ISO 8601 duration string.
+        return duration.toString();
+      }
+    }
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('timeline-status');
+    const output = document.getElementById('timeline-output');
+    const tbody = document.getElementById('timeline-body');
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Loading order events…';
+      try {
+        const [response] = await Promise.all([fetch('order-events.json'), ensureTemporal()]);
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        const rawEvents = await response.json();
+
+        // Parse with Temporal.Instant (not Date, which truncates to milliseconds).
+        const sorted = rawEvents
+          .map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }))
+          .sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+        tbody.replaceChildren(...sorted.map((evt, i) => {
+          const prev = sorted[i - 1];
+          const row = document.createElement('tr');
+          if (prev && evt.instant.equals(prev.instant)) row.classList.add('tie');
+          const cells = [
+            String(i + 1),
+            evt.instant.toString(),
+            evt.service,
+            evt.event,
+            prev
+              ? formatInterval(evt.instant.since(prev.instant, { largestUnit: 'hour' }))
+              : '—',
+          ];
+          cells.forEach((text, col) => {
+            const td = document.createElement('td');
+            td.textContent = text;
+            if (col === 1 || col === 4) td.className = 'mono';
+            row.append(td);
+          });
+          return row;
+        }));
+
+        const total = sorted.at(-1).instant.since(sorted[0].instant, { largestUnit: 'hour' });
+        output.hidden = false;
+        status.textContent = `Sorted ${sorted.length} events spanning ${formatInterval(total)}.`;
+      } catch (err) {
+        status.textContent = `Couldn't load order events: ${err.message}`;
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
