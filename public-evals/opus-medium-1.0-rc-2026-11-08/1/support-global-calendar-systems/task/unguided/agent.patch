+  <script type="module">
+    // Use native Temporal when available, otherwise load a polyfill.
+    let Temporal = globalThis.Temporal;
+    if (!Temporal) {
+      try {
+        ({ Temporal } = await import('https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/+esm'));
+      } catch {
+        const errorEl = document.getElementById('converter-error');
+        errorEl.textContent = 'The calendar converter could not be loaded. Please try again later.';
+        errorEl.hidden = false;
+        throw new Error('Temporal unavailable');
+      }
+    }
+
+    const CALENDARS = {
+      'islamic-umalqura': { nativeLocale: 'ar-SA' },
+      'hebrew': { nativeLocale: 'he-IL' },
+      'japanese': { nativeLocale: 'ja-JP' },
+    };
+
+    const input = document.getElementById('converter-date');
+    const todayBtn = document.getElementById('converter-today');
+    const errorEl = document.getElementById('converter-error');
+
+    // Build a UTC Date for Intl formatting (setUTCFullYear avoids the 0-99 => 19xx quirk).
+    function toUtcDate(plainDate) {
+      const iso = plainDate.withCalendar('iso8601');
+      const d = new Date(Date.UTC(2000, 0, 1, 12));
+      d.setUTCFullYear(iso.year, iso.month - 1, iso.day);
+      return d;
+    }
+
+    function format(plainDate, locale, calendar, options) {
+      return new Intl.DateTimeFormat(`${locale}-u-ca-${calendar}`, { timeZone: 'UTC', ...options })
+        .format(toUtcDate(plainDate));
+    }
+
+    function el(tag, props = {}, children = []) {
+      const node = document.createElement(tag);
+      Object.assign(node, props);
+      for (const child of children) node.append(child);
+      return node;
+    }
+
+    function statusOf(isoDate) {
+      const cmp = Temporal.PlainDate.compare(isoDate, Temporal.Now.plainDateISO());
+      return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+    }
+
+    function renderCard(card, isoDate) {
+      const calendar = card.dataset.calendar;
+      const { nativeLocale } = CALENDARS[calendar];
+      const date = isoDate.withCalendar(calendar);
+      const status = statusOf(isoDate);
+      const fullOpts = { dateStyle: 'full' };
+
+      const title = card.querySelector('h3');
+      card.replaceChildren(title);
+
+      card.append(
+        el('p', { className: 'cal-localized', lang: nativeLocale, dir: 'auto',
+          textContent: format(date, nativeLocale, calendar, fullOpts) }),
+        el('p', { className: 'cal-localized-en',
+          textContent: format(date, 'en', calendar, fullOpts) }),
+      );
+
+      const rows = [
+        ['Year', date.year, 'cal-year'],
+      ];
+      if (calendar === 'japanese') {
+        const eraName = new Intl.DateTimeFormat(`en-u-ca-${calendar}`, { timeZone: 'UTC', era: 'long', year: 'numeric' })
+          .formatToParts(toUtcDate(date)).find(part => part.type === 'era')?.value ?? date.era;
+        rows.push(['Era', eraName, 'cal-era']);
+        rows.push(['Era year', date.eraYear, 'cal-era-year']);
+      }
+      rows.push(
+        ['Month', date.month, 'cal-month'],
+        ['Month code', date.monthCode, 'cal-month-code'],
+        ['Day', date.day, 'cal-day'],
+        ['Months in year', date.monthsInYear, 'cal-months-in-year'],
+      );
+
+      const dl = el('dl', { className: 'cal-details' });
+      for (const [label, value, cls] of rows) {
+        dl.append(el('dt', { textContent: label }), el('dd', { className: cls, textContent: String(value) }));
+      }
+      dl.append(
+        el('dt', { textContent: 'Status' }),
+        el('dd', {}, [el('span', { className: 'cal-status', textContent: status })]),
+      );
+      dl.querySelector('.cal-status').dataset.status = status;
+      card.append(dl);
+
+      const tbody = el('tbody');
+      const firstOfYear = date.with({ month: 1, day: 1 });
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = firstOfYear.with({ month: m });
+        const tr = el('tr', {}, [
+          el('td', { textContent: String(m) }),
+          el('td', { textContent: format(monthStart, 'en', calendar, { month: 'long' }) }),
+          el('td', { className: 'month-code', textContent: monthStart.monthCode }),
+          el('td', { className: 'month-days', textContent: String(monthStart.daysInMonth) }),
+        ]);
+        tr.dataset.monthCode = monthStart.monthCode;
+        if (m === date.month) tr.classList.add('current-month');
+        tbody.append(tr);
+      }
+      card.append(el('table', { className: 'cal-months' }, [
+        el('caption', { textContent: `Months of year ${date.year}` }),
+        el('thead', {}, [el('tr', {}, ['#', 'Month', 'Code', 'Days'].map(h => el('th', { scope: 'col', textContent: h })))]),
+        tbody,
+      ]));
+    }
+
+    function render() {
+      errorEl.hidden = true;
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        errorEl.textContent = 'Please pick a valid date.';
+        errorEl.hidden = false;
+        return;
+      }
+      for (const card of document.querySelectorAll('.calendar-card')) {
+        try {
+          renderCard(card, isoDate);
+        } catch (err) {
+          card.replaceChildren(card.querySelector('h3'),
+            el('p', { textContent: 'This date cannot be shown in this calendar.' }));
+        }
+      }
+    }
+
+    function setToday() {
+      input.value = Temporal.Now.plainDateISO().toString();
+      render();
+    }
+
+    input.addEventListener('input', render);
+    input.addEventListener('change', render);
+    todayBtn.addEventListener('click', setToday);
+    setToday();
+  </script>
+
 </body>
 
