+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const input = document.getElementById('calendar-date');
+    const errorEl = document.getElementById('calendar-error');
+    const cards = document.querySelectorAll('.calendar-card');
+    const supported = Intl.supportedValuesOf?.('calendar') ?? [];
+
+    // Pick the first calendar id from the card's list that this environment supports.
+    function resolveCalendar(ids) {
+      for (const id of ids) {
+        if (supported.length && !supported.includes(id)) continue;
+        try {
+          Temporal.Now.plainDateISO().withCalendar(id);
+          return id;
+        } catch {
+          // try the next candidate
+        }
+      }
+      return null;
+    }
+
+    function el(tag, text, attrs = {}) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
+      return node;
+    }
+
+    function renderCard(card, isoDate, today) {
+      const title = card.dataset.title;
+      const calendarId = card.calendarId ??= resolveCalendar(card.dataset.calendars.split(' '));
+      card.replaceChildren(el('h3', `${title} Calendar`));
+
+      if (!calendarId) {
+        card.append(el('p', `The ${title} calendar is not supported in this browser.`));
+        return;
+      }
+
+      const date = isoDate.withCalendar(calendarId);
+      const locale = `en-u-ca-${calendarId}`;
+      const comparison = Temporal.PlainDate.compare(isoDate, today);
+      const timeline = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      card.append(el('p', date.toLocaleString(locale, {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric',
+        era: 'long'
+      }), { class: 'localized' }));
+
+      const details = [
+        ['Year', date.era ? `${date.year} (${date.era} ${date.eraYear})` : String(date.year)],
+        ['Month', String(date.month)],
+        ['Month code', date.monthCode],
+        ['Months in year', String(date.monthsInYear)],
+        ['Timeline', el('span', timeline, { class: 'timeline', 'data-timeline': timeline })]
+      ];
+      const dl = el('dl');
+      for (const [term, value] of details) {
+        const dd = el('dd');
+        dd.append(value);
+        dl.append(el('dt', term), dd);
+      }
+      card.append(dl);
+
+      const table = el('table');
+      const head = el('tr');
+      for (const label of ['#', 'Month', 'Code', 'Days']) head.append(el('th', label, { scope: 'col' }));
+      const thead = el('thead');
+      thead.append(head);
+      table.append(thead);
+      const body = el('tbody');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = date.with({ month: m, day: 1 });
+        const row = el('tr', undefined, m === date.month ? { class: 'current', 'aria-current': 'date' } : {});
+        row.append(
+          el('td', String(m)),
+          el('td', monthStart.toLocaleString(locale, { month: 'long' })),
+          el('td', monthStart.monthCode),
+          el('td', String(monthStart.daysInMonth))
+        );
+        body.append(row);
+      }
+      table.append(body);
+
+      const breakdown = el('details');
+      breakdown.append(el('summary', 'Months in this year'), table);
+      card.append(breakdown);
+    }
+
+    function update() {
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        errorEl.textContent = 'Please choose a valid date.';
+        errorEl.hidden = false;
+        return;
+      }
+      errorEl.hidden = true;
+      const today = Temporal.Now.plainDateISO();
+      for (const card of cards) renderCard(card, isoDate, today);
+    }
+
+    input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', update);
+    update();
+  </script>
+
