+  <script type="module">
+    const tablist = document.querySelector('#coffee-menu [role="tablist"]');
+    const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+    const panelFor = tab => document.querySelector(`[role="tabpanel"][aria-labelledby="${tab.id}"]`);
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    function select(selected) {
+      if (selected.ariaSelected === 'true') return;
+      for (const tab of tabs) {
+        const isSelected = tab === selected;
+        tab.ariaSelected = isSelected;
+        tab.toggleAttribute('focusgroupstart', isSelected);
+        if (tablist.dataset.roving) tab.tabIndex = isSelected ? 0 : -1;
+        const panel = panelFor(tab);
+        if (isSelected) panel.removeAttribute('hidden');
+        else panel.hidden = 'until-found';
+      }
+      // Keep the selected tab (and a peek of its neighbor) visible in the scrolling tab bar
+      selected.scrollIntoView({
+        block: 'nearest',
+        inline: 'nearest',
+        container: 'nearest',
+        behavior: reduceMotion.matches ? 'auto' : 'smooth',
+      });
+    }
+
+    // Selection follows focus
+    tablist.addEventListener('focusin', e => {
+      if (tabs.includes(e.target)) select(e.target);
+    });
+    // Safari does not focus buttons on click
+    tablist.addEventListener('click', e => {
+      const tab = e.target.closest('[role="tab"]');
+      if (tab) select(tab);
+    });
+    // Find-in-page revealed a hidden panel: select its tab
+    for (const tab of tabs) {
+      panelFor(tab).addEventListener('beforematch', () => select(tab));
+    }
+
+    // Arrow-key navigation: native focusgroup, else polyfill, else a minimal roving tabindex
+    if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
+      try {
+        const { polyfill } = await import('https://esm.sh/@microsoft/focusgroup-polyfill');
+        polyfill();
+      } catch {
+        tablist.dataset.roving = 'true';
+        for (const tab of tabs) tab.tabIndex = tab.ariaSelected === 'true' ? 0 : -1;
+        tablist.addEventListener('keydown', e => {
+          const i = tabs.indexOf(document.activeElement);
+          if (i < 0) return;
+          const rtl = getComputedStyle(tablist).direction === 'rtl';
+          const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
+          let next;
+          if (step) next = tabs[(i + step + tabs.length) % tabs.length];
+          else if (e.key === 'Home') next = tabs[0];
+          else if (e.key === 'End') next = tabs.at(-1);
+          if (!next) return;
+          e.preventDefault();
+          next.focus();
+        });
+      }
+    }
+
+    // Edge fades without scroll-driven animations
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      tablist.classList.add('fade-fallback');
+      const [first, last] = [tabs[0], tabs.at(-1)];
+      const observer = new IntersectionObserver(entries => {
+        for (const { target, intersectionRatio } of entries) {
+          tablist.classList.toggle(target === first ? 'more-start' : 'more-end', intersectionRatio < 1);
+        }
+      }, { root: tablist, threshold: 1, rootMargin: '1px' });
+      observer.observe(first);
+      observer.observe(last);
+    }
+  </script>
