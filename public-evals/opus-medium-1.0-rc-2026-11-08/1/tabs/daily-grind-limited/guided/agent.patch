+
+    .menu-intro {
+      text-align: center;
+      color: #6d4c41;
+      margin-top: 4px;
+    }
+
+    .tablist {
+      display: flex;
+      gap: 4px;
+      margin-top: 24px;
+      border-bottom: 1px solid var(--secondary);
+      overflow-x: auto;
+      scrollbar-width: none;
+      scroll-snap-type: inline proximity;
+      --fade-size: 3rem;
+      --fade-dir: right;
+      scroll-padding-inline: var(--fade-size);
+      mask-image: linear-gradient(to var(--fade-dir), transparent, black var(--fade-start),
+          black calc(100% - var(--fade-end)), transparent);
+      animation: reveal-fade-start linear both, hide-fade-end linear both;
+      animation-timeline: scroll(self inline);
+      animation-range: 0 var(--fade-size), calc(100% - var(--fade-size)) 100%;
+    }
+
+    .tablist:dir(rtl) {
+      --fade-dir: left;
+    }
+
+    @keyframes reveal-fade-start {
+      to {
+        --fade-start: var(--fade-size);
+      }
+    }
+
+    @keyframes hide-fade-end {
+      from {
+        --fade-end: var(--fade-size);
+      }
+    }
+
+    .tablist button {
+      position: relative;
+      flex: none;
+      scroll-snap-align: start;
+      background: none;
+      border: none;
+      padding: 12px 18px;
+      font: inherit;
+      font-size: 0.95rem;
+      color: var(--text);
+      white-space: nowrap;
+      cursor: pointer;
+      transition: color 0.3s;
+    }
+
+    .tablist button:hover {
+      color: var(--primary);
+      background: #f3ece9;
+    }
+
+    .tablist button:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: -2px;
+    }
+
+    .tablist [aria-selected="true"] {
+      color: var(--primary);
+    }
+
+    .tablist [aria-selected="true"]::after {
+      content: "";
+      position: absolute;
+      inset: auto 0 0;
+      border-bottom: 3px solid var(--accent);
+    }
+
+    .tab-panels {
+      display: grid;
+    }
+
+    .tab-panels > [role="tabpanel"] {
+      grid-area: 1 / 1;
+    }
+
+    .card .price {
+      display: block;
+      font-weight: bold;
+      color: var(--primary);
+      margin-top: 8px;
+    }
