+  <script>
+    const tablist = document.querySelector('#coffee-menu .tablist');
+    const tabs = [...tablist.querySelectorAll('button')];
+    const panels = tabs.map(tab => document.querySelector(`[aria-labelledby="${tab.id}"]`));
+
+    function select(selected) {
+      for (const [i, tab] of tabs.entries()) {
+        const isSelected = tab === selected;
+        tab.ariaSelected = isSelected;
+        tab.toggleAttribute('focusgroupstart', isSelected);
+        if (isSelected) panels[i].removeAttribute('hidden');
+        else panels[i].hidden = 'until-found';
+      }
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }
+
+    for (const [i, tab] of tabs.entries()) {
+      // Selection follows focus: arrow keys (via focusgroup) and clicks both select
+      tab.addEventListener('focus', () => select(tab));
+      tab.addEventListener('click', () => select(tab));
+      // Find-in-page revealed a hidden panel: make its tab the selected one
+      panels[i].addEventListener('beforematch', () => select(tab));
+    }
+  </script>
