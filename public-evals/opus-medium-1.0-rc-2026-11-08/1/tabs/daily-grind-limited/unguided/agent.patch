+        if (history.replaceState) {
+          history.replaceState(null, '', '#' + tab.id.replace(/^tab-/, 'menu-'));
+        }
+      }
+
+      tabs.forEach(function (tab, i) {
+        tab.addEventListener('click', function () { selectTab(tab, false); });
+        tab.addEventListener('focus', function () { revealTab(tab); });
+        tab.addEventListener('keydown', function (e) {
+          var next = null;
+          switch (e.key) {
+            case 'ArrowRight': next = tabs[(i + 1) % tabs.length]; break;
+            case 'ArrowLeft': next = tabs[(i - 1 + tabs.length) % tabs.length]; break;
+            case 'Home': next = tabs[0]; break;
+            case 'End': next = tabs[tabs.length - 1]; break;
+            default: return;
+          }
+          e.preventDefault();
+          selectTab(next, true);
+        });
+      });
+
+      function page(direction) {
+        var amount = Math.max(tabList.clientWidth * 0.7, 120) * direction;
+        tabList.scrollBy({ left: amount, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+      }
+      prevBtn.addEventListener('click', function () { page(-1); });
+      nextBtn.addEventListener('click', function () { page(1); });
+
+      // Let vertical mouse-wheel scroll the tab bar horizontally when it overflows.
+      tabList.addEventListener('wheel', function (e) {
+        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
+        var max = tabList.scrollWidth - tabList.clientWidth;
+        if (max <= 0) return;
+        var atStart = tabList.scrollLeft <= 0 && e.deltaY < 0;
+        var atEnd = tabList.scrollLeft >= max - 1 && e.deltaY > 0;
+        if (atStart || atEnd) return; // let the page scroll
+        e.preventDefault();
+        tabList.scrollLeft += e.deltaY;
+      }, { passive: false });
+
+      var ticking = false;
+      tabList.addEventListener('scroll', function () {
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(function () { ticking = false; updateOverflow(); });
+      }, { passive: true });
+
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(function () {
+          updateOverflow();
+          var active = tabList.querySelector('[aria-selected="true"]');
+          if (active) revealTab(active);
+        }).observe(tabList);
+      } else {
+        window.addEventListener('resize', updateOverflow);
+      }
+
+      // Deep-link support: #menu-espresso opens the Espresso tab.
+      var initial = location.hash && document.getElementById(location.hash.slice(1).replace(/^menu-/, 'tab-'));
+      if (initial && tabs.indexOf(initial) !== -1) {
+        selectTab(initial, false);
+      }
+      updateOverflow();
+    })();
+  </script>
+
