diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,88 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Font Size Adjust Demo</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+      font-family: Georgia, "Times New Roman", serif;
+      line-height: 1.6;
+    }
+
+    body {
+      max-width: 48rem;
+      margin: 0 auto;
+      padding: 2rem 1.5rem;
+    }
+
+    section {
+      margin-block: 2rem;
+      padding: 1.5rem;
+      border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
+      border-radius: 0.75rem;
+    }
+
+    h2 {
+      margin-top: 0;
+    }
+
+    code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /*
+     * Automatic normalization: `from-font` reads the x-height ratio of the
+     * first available font in the inherited font-family (the serif body font)
+     * and applies that same ratio to every fallback/nested font, so inline
+     * code renders with a matching visual x-height.
+     */
+    #mixed-fonts-container {
+      font-size-adjust: from-font;
+    }
+
+    /*
+     * Independent theme: its own font stack, with an explicit numeric
+     * x-height ratio that locks its visual proportions regardless of
+     * which font in the stack actually loads.
+     */
+    #independent-theme-container {
+      font-family: Verdana, "Trebuchet MS", system-ui, sans-serif;
+      font-size-adjust: ex-height 0.5;
+      background: color-mix(in srgb, steelblue 12%, transparent);
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, monospace;
+    }
+  </style>
+</head>
+<body>
+  <h1>Normalizing Mixed Fonts with <code>font-size-adjust</code></h1>
+
+  <section id="mixed-fonts-container">
+    <h2>Mixed Fonts</h2>
+    <p>
+      This paragraph mixes a serif body font with inline code such as
+      <code>const answer = 42;</code> and <code>Array.prototype.map()</code>.
+      Thanks to <code>font-size-adjust: from-font</code>, the monospace text
+      matches the x-height of the surrounding prose instead of looking
+      noticeably smaller or larger.
+    </p>
+  </section>
+
+  <section id="independent-theme-container">
+    <h2>Independent Theme</h2>
+    <p>
+      This container uses its own sans-serif font stack and locks its visual
+      proportions with <code>font-size-adjust: ex-height 0.5</code>. Whichever
+      font in the stack ends up rendering, its x-height is held at half the
+      font size.
+    </p>
+  </section>
+</body>
+</html>
