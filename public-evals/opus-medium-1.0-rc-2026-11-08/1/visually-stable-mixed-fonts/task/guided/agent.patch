diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,98 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Mixed Fonts &amp; Independent Themes</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem;
+      max-width: 70ch;
+      margin-inline: auto;
+      font-family: system-ui, sans-serif;
+      line-height: 1.6;
+    }
+
+    section {
+      margin-block: 2rem;
+      padding: 1.5rem;
+      border: 1px solid color-mix(in oklab, currentColor 25%, transparent);
+      border-radius: 0.5rem;
+    }
+
+    h2 {
+      margin-block-start: 0;
+      text-wrap: balance;
+    }
+
+    /* Mixed fonts: inline code inherits the x-height ratio of the body font,
+       so monospace glyphs line up visually with the surrounding text. */
+    #mixed-fonts-container {
+      font-family: Verdana, Geneva, sans-serif;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, monospace;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in oklab, currentColor 10%, transparent);
+    }
+
+    /* Independent theme: not nested in the primary font's context, so lock its
+       proportions with an explicit x-height / font-size aspect ratio. */
+    #independent-theme-container {
+      font-family: "Times New Roman", Times, serif;
+      font-size-adjust: 0.545;
+      background: color-mix(in oklab, Canvas 92%, #c08a3e);
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, monospace;
+    }
+
+    @supports not (font-size-adjust: from-font) {
+      /* Without font-size-adjust, Courier/Times render visually smaller than
+         Verdana; compensate manually. */
+      #mixed-fonts-container code {
+        font-size: 1.15em;
+        line-height: 1;
+      }
+
+      #independent-theme-container {
+        font-size: 1.15rem;
+        line-height: 1.65;
+      }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Visually Stable Typography</h1>
+
+    <section id="mixed-fonts-container">
+      <h2>Mixed font families</h2>
+      <p>
+        To read a value from local storage, call <code>localStorage.getItem("key")</code>
+        and parse the result with <code>JSON.parse()</code>. Inline code uses a monospace
+        family, yet its lowercase letters match the height of the surrounding text
+        thanks to <code>font-size-adjust: from-font</code>.
+      </p>
+    </section>
+
+    <section id="independent-theme-container">
+      <h2>Independent theme</h2>
+      <p>
+        This container uses its own serif theme. Its visual proportions are locked to an
+        x-height ratio of <code>0.545</code>, so it reads at the same apparent size as the
+        rest of the page regardless of which serif font ends up being used.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
