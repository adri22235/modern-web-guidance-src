+  <script>
+    // FAQ accordion
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    faqTrigger.addEventListener('click', () => {
+      faqContent.hidden = faqContent.hidden ? false : 'until-found';
+      faqTrigger.setAttribute('aria-expanded', !faqContent.hidden);
+    });
+
+    // Find-in-page reveals the content directly, so mirror that into the trigger
+    faqContent.addEventListener('beforematch', () => {
+      faqTrigger.setAttribute('aria-expanded', 'true');
+    });
+
+    // Dismissible promo alert
+    const promoAlert = document.getElementById('promo-alert');
+
+    document.getElementById('alert-dismiss').addEventListener('click', async () => {
+      promoAlert.classList.add('is-dismissed');
+      // Keep focus from being lost along with the removed button
+      document.querySelector('main').focus({ preventScroll: true });
+      // Wait for the collapse (if any, e.g. reduced motion skips it), then remove from the a11y tree
+      await Promise.allSettled(promoAlert.getAnimations().map(a => a.finished));
+      promoAlert.hidden = true;
+    });
+  </script>
