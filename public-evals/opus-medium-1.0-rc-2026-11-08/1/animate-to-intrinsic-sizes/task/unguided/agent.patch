+  <script>
+    (function () {
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Animate an element between height 0 and its natural content height.
+      // Interruptions start from the current rendered height, so rapid toggles stay smooth.
+      function animateHeight(el, open, onDone) {
+        var startHeight = el.getBoundingClientRect().height;
+
+        if (el._finish) {
+          el.removeEventListener('transitionend', el._finish);
+          clearTimeout(el._timer);
+        }
+
+        el.hidden = false;
+        el.style.height = startHeight + 'px';
+        el.classList.toggle('is-collapsed', !open);
+        el.style.opacity = open ? '1' : '0';
+
+        var endHeight = open ? el.scrollHeight : 0;
+
+        function finish(e) {
+          if (e && (e.target !== el || e.propertyName !== 'height')) return;
+          el.removeEventListener('transitionend', finish);
+          clearTimeout(el._timer);
+          el._finish = null;
+          el.style.height = '';
+          el.style.opacity = '';
+          if (!open) el.hidden = true;
+          if (onDone) onDone();
+        }
+
+        if (reduceMotion.matches || startHeight === endHeight) {
+          finish();
+          return;
+        }
+
+        el._finish = finish;
+        el.addEventListener('transitionend', finish);
+        el._timer = setTimeout(finish, 500); // fallback if transitionend never fires
+
+        el.offsetHeight; // force reflow so the start height is committed
+        el.style.height = endHeight + 'px';
+      }
+
+      // FAQ accordion
+      var trigger = document.getElementById('faq-trigger');
+      var content = document.getElementById('faq-content');
+      if (trigger && content) {
+        trigger.addEventListener('click', function () {
+          var open = trigger.getAttribute('aria-expanded') !== 'true';
+          trigger.setAttribute('aria-expanded', String(open));
+          animateHeight(content, open);
+        });
+      }
+
+      // Dismissible promo alert
+      var alertEl = document.getElementById('promo-alert');
+      var dismiss = document.getElementById('alert-dismiss');
+      if (alertEl && dismiss) {
+        dismiss.addEventListener('click', function () {
+          dismiss.disabled = true;
+          animateHeight(alertEl, false, function () {
+            alertEl.remove();
+          });
+        });
+      }
+    })();
+  </script>
