+        <span id="quick-cart-title">&#9749; Quick Order</span>
+        <span class="cart-badge" data-cart-count aria-label="0 items in cart">0</span>
+      </div>
+      <button type="button" class="icon-btn" data-cart-toggle aria-expanded="true" aria-controls="quick-cart-body"
+        aria-label="Minimize quick order">&minus;</button>
+    </div>
+
+    <div class="quick-cart-body" id="quick-cart-body">
+      <fieldset class="size-picker">
+        <legend>Cup size</legend>
+        <label><input type="radio" name="cart-size" value="0" checked> Small</label>
+        <label><input type="radio" name="cart-size" value="0.5"> Medium</label>
+        <label><input type="radio" name="cart-size" value="1"> Large</label>
+      </fieldset>
+
+      <ul class="cart-items">
