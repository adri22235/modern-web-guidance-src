+
+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const grip = panel.querySelector('.quick-cart-grip');
+      const STEP = 15;
+      const INTERACTIVE = 'button, input, select, textarea, a';
+
+      /* ---------- Dragging ---------- */
+      panel.classList.add('is-draggable');
+      grip.tabIndex = 0;
+      grip.setAttribute('role', 'button');
+      grip.setAttribute('aria-roledescription', 'draggable panel handle');
+      grip.setAttribute('aria-label', 'Quick order panel. Use arrow keys to move.');
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let dragging = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      function reclamp() {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest(INTERACTIVE)) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        dragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
+          dragging = true;
+          handle.classList.add('dragging');
+          panel.classList.add('is-dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        dragging = false;
+        handle.classList.remove('dragging');
+        panel.classList.remove('is-dragging');
+      });
+
+      grip.addEventListener('keydown', (event) => {
+        const delta = {
+          ArrowLeft: [-STEP, 0],
+          ArrowRight: [STEP, 0],
+          ArrowUp: [0, -STEP],
+          ArrowDown: [0, STEP],
+        }[event.key];
+        if (!delta) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+
+      // Keep the panel reachable when the viewport or panel size changes
+      // (only once it has been moved; the default right/bottom anchor is already safe).
+      const keepInView = () => {
+        if (panel.style.left) reclamp();
+      };
+      window.addEventListener('resize', keepInView);
+      new ResizeObserver(keepInView).observe(panel);
+
+      /* ---------- Minimize ---------- */
+      const toggle = panel.querySelector('[data-cart-toggle]');
+      const body = panel.querySelector('.quick-cart-body');
+      toggle.addEventListener('click', () => {
+        const expanded = toggle.getAttribute('aria-expanded') === 'true';
+        toggle.setAttribute('aria-expanded', String(!expanded));
+        toggle.setAttribute('aria-label', expanded ? 'Expand quick order' : 'Minimize quick order');
+        toggle.textContent = expanded ? '+' : '\u2212';
+        body.hidden = expanded;
+      });
+
+      /* ---------- Cart ---------- */
+      const items = [...panel.querySelectorAll('[data-item]')];
+      const countBadge = panel.querySelector('[data-cart-count]');
+      const totalOut = panel.querySelector('[data-cart-total]');
+      const checkout = panel.querySelector('[data-cart-checkout]');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const qty = new Map(items.map((item) => [item, 0]));
+
+      const sizeUpcharge = () =>
+        Number(panel.querySelector('input[name="cart-size"]:checked').value);
+
+      function render() {
+        const upcharge = sizeUpcharge();
+        let count = 0;
+        let total = 0;
+        for (const item of items) {
+          const n = qty.get(item);
+          const unit = Number(item.dataset.price) + upcharge;
+          item.querySelector('[data-qty]').value = n;
+          item.querySelector('[data-unit-price]').textContent = money.format(unit);
+          item.querySelector('[data-dec]').disabled = n === 0;
+          count += n;
+          total += n * unit;
+        }
+        countBadge.textContent = count;
+        countBadge.setAttribute('aria-label', `${count} ${count === 1 ? 'item' : 'items'} in cart`);
+        totalOut.value = money.format(total);
+        checkout.setAttribute('aria-disabled', String(count === 0));
+        if (count === 0) checkout.setAttribute('tabindex', '-1');
+        else checkout.removeAttribute('tabindex');
+      }
+
+      for (const item of items) {
+        item.querySelector('[data-inc]').addEventListener('click', () => {
+          qty.set(item, Math.min(qty.get(item) + 1, 20));
+          render();
+        });
+        item.querySelector('[data-dec]').addEventListener('click', () => {
+          qty.set(item, Math.max(qty.get(item) - 1, 0));
+          render();
+        });
+      }
+
+      panel.querySelectorAll('input[name="cart-size"]').forEach((input) =>
+        input.addEventListener('change', render));
+
+      panel.querySelector('[data-cart-clear]').addEventListener('click', () => {
+        for (const item of items) qty.set(item, 0);
+        render();
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
