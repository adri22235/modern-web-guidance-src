+          <span class="qty">
+            <button type="button" data-dec aria-label="Remove one Maple Oat Latte" disabled>&minus;</button>
+            <output data-qty aria-label="Maple Oat Latte quantity">0</output>
+            <button type="button" data-inc aria-label="Add one Maple Oat Latte">+</button>
+          </span>
+        </li>
+        <li class="cart-item" data-item data-price="3.25">
+          <span class="cart-item-name">Dark Roast Espresso<span class="cart-item-price" data-unit-price>$3.25</span></span>
+          <span class="qty">
+            <button type="button" data-dec aria-label="Remove one Dark Roast Espresso" disabled>&minus;</button>
+            <output data-qty aria-label="Dark Roast Espresso quantity">0</output>
+            <button type="button" data-inc aria-label="Add one Dark Roast Espresso">+</button>
+          </span>
+        </li>
+        <li class="cart-item" data-item data-price="4.75">
+          <span class="cart-item-name">Cold Brew<span class="cart-item-price" data-unit-price>$4.75</span></span>
+          <span class="qty">
+            <button type="button" data-dec aria-label="Remove one Cold Brew" disabled>&minus;</button>
+            <output data-qty aria-label="Cold Brew quantity">0</output>
+            <button type="button" data-inc aria-label="Add one Cold Brew">+</button>
+          </span>
+        </li>
+      </ul>
+
+      <div class="cart-total">
+        <span>Total</span>
+        <output data-cart-total aria-live="polite">$0.00</output>
+      </div>
+
+      <div class="cart-actions">
+        <button type="button" class="btn btn-secondary" data-cart-clear>Clear</button>
+        <a href="/order-online" class="btn" data-cart-checkout aria-disabled="true">Checkout</a>
+      </div>
+    </div>
