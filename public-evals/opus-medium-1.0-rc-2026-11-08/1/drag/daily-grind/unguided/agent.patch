+  <aside class="quick-order" id="quick-order" data-draggable aria-labelledby="qo-title">
+    <div class="qo-header" data-drag-handle tabindex="0" role="group"
+      aria-label="Quick order panel. Drag, or use arrow keys, to move." aria-describedby="qo-title">
+      <span class="qo-title" id="qo-title">
+        <span class="qo-grip" aria-hidden="true">&#8942;&#8942;</span>
+        &#9749; Quick Order
+        <span class="qo-badge" id="qo-badge" aria-label="items in cart">0</span>
+      </span>
+      <button type="button" class="qo-toggle" id="qo-toggle" aria-expanded="true" aria-controls="qo-body"
+        aria-label="Collapse quick order panel">&minus;</button>
+    </div>
+
+    <div class="qo-body" id="qo-body">
+      <form id="qo-form">
+        <div class="qo-field">
+          <label for="qo-drink">Drink</label>
+          <select id="qo-drink" name="drink">
+            <option value="Maple Oat Latte" data-price="5.25">Maple Oat Latte — $5.25</option>
+            <option value="Dark Roast Espresso" data-price="3.50">Dark Roast Espresso — $3.50</option>
+            <option value="Cold Brew" data-price="4.75">Cold Brew — $4.75</option>
+            <option value="Cappuccino" data-price="4.50">Cappuccino — $4.50</option>
+            <option value="Drip Coffee" data-price="2.75">Drip Coffee — $2.75</option>
+          </select>
+        </div>
+
+        <div class="qo-field">
+          <span class="qo-label" id="qo-size-label">Size</span>
+          <div class="qo-sizes" role="radiogroup" aria-labelledby="qo-size-label">
+            <label><input type="radio" name="size" value="Small" data-extra="0"><span>S</span></label>
+            <label><input type="radio" name="size" value="Medium" data-extra="0.50" checked><span>M</span></label>
+            <label><input type="radio" name="size" value="Large" data-extra="1.00"><span>L</span></label>
+          </div>
+        </div>
+
+        <div class="qo-field qo-row">
+          <label class="qo-check"><input type="checkbox" id="qo-shot" name="shot"> Extra shot (+$0.75)</label>
+          <div class="qo-stepper">
+            <button type="button" id="qo-minus" aria-label="Decrease quantity">&minus;</button>
+            <output id="qo-qty" aria-live="polite" aria-label="Quantity">1</output>
+            <button type="button" id="qo-plus" aria-label="Increase quantity">+</button>
+          </div>
+        </div>
+
+        <button type="submit" class="qo-add">Add to Cart</button>
+      </form>
+
+      <div class="qo-cart">
+        <p class="qo-empty" id="qo-empty">Your cart is empty.</p>
+        <ul id="qo-items"></ul>
+        <p class="qo-total">Total: <span id="qo-total">$0.00</span></p>
+        <button type="button" class="qo-checkout" id="qo-checkout" disabled>Checkout</button>
+        <p class="qo-status" id="qo-status" role="status"></p>
+      </div>
+    </div>
+  </aside>
+
+  <script>
+    (function () {
+      var panel = document.querySelector('[data-draggable]');
+      if (!panel) return;
+      var handle = panel.querySelector('[data-drag-handle]') || panel;
+      var STORAGE_KEY = 'dg-quick-order-pos';
+      var MARGIN = 8;
+
+      /* ---------- Dragging ---------- */
+      var drag = null;
+
+      function clamp(x, y) {
+        var maxX = window.innerWidth - panel.offsetWidth - MARGIN;
+        var maxY = window.innerHeight - handle.offsetHeight - MARGIN;
+        return {
+          x: Math.min(Math.max(MARGIN, x), Math.max(MARGIN, maxX)),
+          y: Math.min(Math.max(MARGIN, y), Math.max(MARGIN, maxY))
+        };
+      }
+
+      function moveTo(x, y) {
+        var p = clamp(x, y);
+        panel.style.left = p.x + 'px';
+        panel.style.top = p.y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        return p;
+      }
+
+      function savePos() {
+        try {
+          var r = panel.getBoundingClientRect();
+          localStorage.setItem(STORAGE_KEY, JSON.stringify({ x: r.left, y: r.top }));
+        } catch (e) { /* storage unavailable */ }
+      }
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.button !== 0 || e.target.closest('button, input, select, a')) return;
+        var r = panel.getBoundingClientRect();
+        drag = { id: e.pointerId, dx: e.clientX - r.left, dy: e.clientY - r.top };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('is-dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        moveTo(e.clientX - drag.dx, e.clientY - drag.dy);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('is-dragging');
+        if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+        savePos();
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', endDrag);
+
+      // Keyboard: arrow keys move the panel (Shift for bigger steps)
+      handle.addEventListener('keydown', function (e) {
+        if (e.target !== handle) return;
+        var step = e.shiftKey ? 50 : 10;
+        var d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
+        if (!d) return;
+        e.preventDefault();
+        var r = panel.getBoundingClientRect();
+        moveTo(r.left + d[0], r.top + d[1]);
+        savePos();
+      });
+
+      // Keep the panel on-screen when the viewport changes
+      window.addEventListener('resize', function () {
+        if (!panel.style.left) return;
+        var r = panel.getBoundingClientRect();
+        moveTo(r.left, r.top);
+      });
+
+      // Restore last position
+      try {
+        var saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (saved && isFinite(saved.x) && isFinite(saved.y)) moveTo(saved.x, saved.y);
+      } catch (e) { /* ignore */ }
+
+      /* ---------- Collapse ---------- */
+      var toggle = document.getElementById('qo-toggle');
+      toggle.addEventListener('click', function () {
+        var collapsed = panel.classList.toggle('is-collapsed');
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Expand' : 'Collapse') + ' quick order panel');
+        toggle.innerHTML = collapsed ? '+' : '&minus;';
+      });
+
+      /* ---------- Order controls ---------- */
+      var form = document.getElementById('qo-form');
+      var qtyEl = document.getElementById('qo-qty');
+      var itemsEl = document.getElementById('qo-items');
+      var emptyEl = document.getElementById('qo-empty');
+      var totalEl = document.getElementById('qo-total');
+      var badgeEl = document.getElementById('qo-badge');
+      var checkoutBtn = document.getElementById('qo-checkout');
+      var statusEl = document.getElementById('qo-status');
+      var qty = 1;
+      var cart = [];
+
+      function setQty(n) {
+        qty = Math.min(10, Math.max(1, n));
+        qtyEl.textContent = qty;
+      }
+      document.getElementById('qo-minus').addEventListener('click', function () { setQty(qty - 1); });
+      document.getElementById('qo-plus').addEventListener('click', function () { setQty(qty + 1); });
+
+      function money(n) { return '$' + n.toFixed(2); }
+
+      function render() {
+        itemsEl.innerHTML = '';
+        var total = 0, count = 0;
+        cart.forEach(function (item, i) {
+          total += item.unit * item.qty;
+          count += item.qty;
+          var li = document.createElement('li');
+          var info = document.createElement('div');
+          info.textContent = item.qty + '× ' + item.drink;
+          var meta = document.createElement('small');
+          meta.textContent = item.size + (item.shot ? ', extra shot' : '') + ' · ' + money(item.unit * item.qty);
+          info.appendChild(meta);
+          var rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'qo-remove';
+          rm.setAttribute('aria-label', 'Remove ' + item.drink);
+          rm.innerHTML = '&times;';
+          rm.addEventListener('click', function () { cart.splice(i, 1); render(); });
+          li.appendChild(info);
+          li.appendChild(rm);
+          itemsEl.appendChild(li);
+        });
+        emptyEl.hidden = cart.length > 0;
+        totalEl.textContent = money(total);
+        badgeEl.textContent = count;
+        checkoutBtn.disabled = cart.length === 0;
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var opt = form.drink.options[form.drink.selectedIndex];
+        var size = form.querySelector('input[name="size"]:checked');
+        var shot = form.shot.checked;
+        var unit = parseFloat(opt.dataset.price) + parseFloat(size.dataset.extra) + (shot ? 0.75 : 0);
+        var existing = cart.find(function (c) {
+          return c.drink === opt.value && c.size === size.value && c.shot === shot;
+        });
+        if (existing) existing.qty += qty;
+        else cart.push({ drink: opt.value, size: size.value, shot: shot, unit: unit, qty: qty });
+        statusEl.textContent = 'Added ' + qty + '× ' + opt.value + '.';
+        setQty(1);
+        render();
+      });
+
+      checkoutBtn.addEventListener('click', function () {
+        if (!cart.length) return;
+        statusEl.textContent = 'Thanks! Your order of ' + badgeEl.textContent + ' item(s) (' +
+          totalEl.textContent + ') will be ready for pickup in ~10 minutes.';
+        cart = [];
+        render();
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
 </html>
