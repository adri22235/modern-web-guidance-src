+  <script>
+    (function () {
+      var body = document.body;
+      var toggle = document.getElementById('menu-toggle');
+      var drawer = document.getElementById('nav-drawer');
+      var backdrop = document.getElementById('drawer-backdrop');
+      var closeBtn = document.getElementById('drawer-close');
+
+      function isOpen() {
+        return body.classList.contains('drawer-open');
+      }
+
+      function openDrawer() {
+        if (isOpen()) return;
+        drawer.removeAttribute('inert');
+        body.classList.add('drawer-open');
+        toggle.setAttribute('aria-expanded', 'true');
+        closeBtn.focus();
+      }
+
+      function closeDrawer() {
+        if (!isOpen()) return;
+        body.classList.remove('drawer-open');
+        drawer.setAttribute('inert', '');
+        toggle.setAttribute('aria-expanded', 'false');
+        toggle.focus();
+      }
+
+      toggle.addEventListener('click', openDrawer);
+      closeBtn.addEventListener('click', closeDrawer);
+      backdrop.addEventListener('click', closeDrawer);
+
+      document.addEventListener('keydown', function (e) {
+        if (!isOpen()) return;
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeDrawer();
+        } else if (e.key === 'Tab') {
+          // Keep focus inside the drawer while it is open.
+          var focusable = drawer.querySelectorAll('a[href], button:not([disabled])');
+          var first = focusable[0];
+          var last = focusable[focusable.length - 1];
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+
+      // Swipe to close: drag the drawer toward the right edge.
+      var DRAG_START_THRESHOLD = 10; // px before we decide it's a horizontal swipe
+      var startX = 0;
+      var startY = 0;
+      var startTime = 0;
+      var offset = 0;
+      var pointerId = null;
+      var dragging = false;
+      var suppressClick = false;
+
+      function setOffset(px) {
+        offset = Math.max(0, px);
+        drawer.style.transform = 'translateX(' + offset + 'px)';
+        backdrop.style.opacity = String(1 - offset / drawer.offsetWidth);
+      }
+
+      function resetDragStyles() {
+        drawer.classList.remove('dragging');
+        backdrop.classList.remove('dragging');
+        drawer.style.transform = '';
+        backdrop.style.opacity = '';
+      }
+
+      drawer.addEventListener('pointerdown', function (e) {
+        if (!isOpen() || pointerId !== null) return;
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        pointerId = e.pointerId;
+        startX = e.clientX;
+        startY = e.clientY;
+        startTime = e.timeStamp;
+        dragging = false;
+        offset = 0;
+      });
+
+      drawer.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== pointerId) return;
+        var dx = e.clientX - startX;
+        var dy = e.clientY - startY;
+        if (!dragging) {
+          if (Math.abs(dx) < DRAG_START_THRESHOLD && Math.abs(dy) < DRAG_START_THRESHOLD) return;
+          if (Math.abs(dx) <= Math.abs(dy) || dx < 0) {
+            // Vertical scroll or leftward movement: not a close swipe.
+            pointerId = null;
+            return;
+          }
+          dragging = true;
+          drawer.classList.add('dragging');
+          backdrop.classList.add('dragging');
+          try { drawer.setPointerCapture(e.pointerId); } catch (err) { }
+        }
+        e.preventDefault();
+        setOffset(dx);
+      });
+
+      function endDrag(e) {
+        if (e.pointerId !== pointerId) return;
+        pointerId = null;
+        if (!dragging) return;
+        dragging = false;
+        suppressClick = true;
+        var elapsed = Math.max(1, e.timeStamp - startTime);
+        var velocity = offset / elapsed; // px per ms
+        var shouldClose = e.type !== 'pointercancel' &&
+          (offset > drawer.offsetWidth * 0.3 || velocity > 0.5);
+        resetDragStyles();
+        if (shouldClose) closeDrawer();
+      }
+
+      drawer.addEventListener('pointerup', endDrag);
+      drawer.addEventListener('pointercancel', endDrag);
+
+      // Don't follow a link if the gesture was a swipe.
+      drawer.addEventListener('click', function (e) {
+        if (suppressClick) {
+          suppressClick = false;
+          e.preventDefault();
+          e.stopPropagation();
+        }
+      }, true);
+      drawer.addEventListener('pointerdown', function () {
+        suppressClick = false;
+      }, true);
+    })();
+  </script>
