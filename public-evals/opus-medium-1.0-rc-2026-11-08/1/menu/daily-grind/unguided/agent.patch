+              menu.classList.add('stack');
+              return;
+            }
+          }
+          if (isSub && rect.bottom > window.innerHeight - margin) {
+            const shift = Math.min(rect.bottom - window.innerHeight + margin, rect.top - margin);
+            if (shift > 0) menu.style.top = `${parseFloat(getComputedStyle(menu).top) - shift}px`;
+          }
+        }
+
+        onButtonKey(e) {
+          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+            e.preventDefault();
+            this.open(e.key === 'ArrowUp' ? 'last' : 'first');
+          } else if (e.key === 'Escape' && this.isOpen) {
+            e.preventDefault();
+            this.close(true);
+          }
+        }
+
+        onMenuKey(e) {
+          const item = e.target.closest(ITEM);
+          if (!item) return;
+          const menu = item.closest('[role="menu"]');
+          const items = itemsOf(menu);
+          const i = items.indexOf(item);
+          const parent = parentItemOf(menu);
+          let handled = true;
+
+          switch (e.key) {
+            case 'ArrowDown':
+              items[(i + 1) % items.length].focus();
+              break;
+            case 'ArrowUp':
+              items[(i - 1 + items.length) % items.length].focus();
+              break;
+            case 'Home':
+            case 'PageUp':
+              items[0].focus();
+              break;
+            case 'End':
+            case 'PageDown':
+              items[items.length - 1].focus();
+              break;
+            case 'ArrowRight':
+              if (submenuOf(item)) this.openSub(item, 'first');
+              break;
+            case 'ArrowLeft':
+              if (parent) {
+                this.closeSub(parent);
+                parent.focus();
+              }
+              break;
+            case 'Escape':
+              if (parent) {
+                this.closeSub(parent);
+                parent.focus();
+              } else {
+                this.close(true);
+              }
+              break;
+            case 'Enter':
+            case ' ':
+              this.activate(item, 'key');
+              break;
+            case 'Tab':
+              // Hand focus back to the button so Tab continues from there.
+              this.close(true);
+              handled = false;
+              break;
+            default:
+              if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                this.typeahead(e.key, items, i);
+              } else {
+                handled = false;
+              }
+          }
+
+          if (handled) {
+            e.preventDefault();
+            e.stopPropagation();
+          }
+        }
+
+        onMenuClick(e) {
+          const item = e.target.closest(ITEM);
+          if (!item) return;
+          if (isDisabled(item)) {
+            e.preventDefault();
+            return;
+          }
+          if (submenuOf(item)) {
+            e.preventDefault();
+            if (item.getAttribute('aria-expanded') === 'true') this.closeSub(item);
+            else this.openSub(item, null);
+            item.focus();
+            return;
+          }
+          if (item.tagName !== 'A') e.preventDefault();
+          this.activate(item, 'click');
+        }
+
+        onPointerOver(e) {
+          if (e.pointerType !== 'mouse') return;
+          const item = e.target.closest(ITEM);
+          if (!item || item === this.hovered) return;
+          this.hovered = item;
+          item.focus({ preventScroll: true });
+          clearTimeout(this.hoverTimer);
+          this.hoverTimer = setTimeout(() => {
+            if (submenuOf(item)) this.openSub(item, null);
+            else this.closeSiblings(item);
+          }, 150);
+        }
+
+        activate(item, source) {
+          if (isDisabled(item)) return;
+          if (submenuOf(item)) {
+            this.openSub(item, 'first');
+            return;
+          }
+
+          const role = item.getAttribute('role');
+          if (role === 'menuitemcheckbox') {
+            item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+            this.emit('menu:change', item);
+            return;
+          }
+          if (role === 'menuitemradio') {
+            const menu = item.closest('[role="menu"]');
+            const group = item.closest('[role="group"]');
+            const scope = group && menu.contains(group) ? group : menu;
+            scope.querySelectorAll('[role="menuitemradio"]').forEach((radio) => {
+              if (radio.closest('[role="menu"]') === menu) radio.setAttribute('aria-checked', String(radio === item));
+            });
+            this.emit('menu:change', item);
+            return;
+          }
+
+          this.close(true);
+          if (item.tagName === 'A') {
+            // Clicks navigate natively; keyboard activation needs a nudge.
+            if (source === 'key') window.location.assign(item.href);
+            return;
+          }
+          this.emit('menu:select', item);
+        }
+
+        typeahead(ch, items, index) {
+          clearTimeout(this.typeTimer);
+          this.typed += ch.toLowerCase();
+          this.typeTimer = setTimeout(() => (this.typed = ''), 500);
+          const str = this.typed;
+          const start = str.length === 1 ? index + 1 : index;
+          const ordered = items.slice(start).concat(items.slice(0, start));
+          const label = (el) => el.textContent.trim().toLowerCase();
+          const repeated = [...str].every((c) => c === str[0]);
+          const match =
+            ordered.find((el) => label(el).startsWith(str)) ||
+            (repeated ? ordered.find((el) => label(el).startsWith(str[0])) : null);
+          if (match) match.focus();
+        }
+
+        emit(name, item) {
+          this.wrap.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { item } }));
+        }
+      }
+
+      // ---- Feedback helpers --------------------------------------------------
+
+      const toastEl = document.getElementById('toast');
+      const announcer = document.getElementById('announcer');
+      let toastTimer;
+
+      function notify(message) {
+        toastEl.textContent = message;
+        toastEl.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2800);
+        announcer.textContent = '';
+        setTimeout(() => (announcer.textContent = message), 50);
+      }
+
+      // ---- Order customization data -----------------------------------------
+
+      // [value, label, price delta vs. medium/plain, short summary label]
+      const OPTIONS = {
+        size: {
+          label: 'Size',
+          options: [
+            ['small', 'Small (12 oz)', -0.5, 'Small'],
+            ['medium', 'Medium (16 oz)', 0, 'Medium'],
+            ['large', 'Large (20 oz)', 0.75, 'Large'],
+          ],
+        },
+        milk: {
+          label: 'Milk',
+          options: [
+            ['none', 'No milk', 0],
+            ['whole', 'Whole milk', 0],
+            ['skim', 'Skim milk', 0],
+            ['oat', 'Oat milk', 0.7],
+            ['almond', 'Almond milk', 0.7],
+            ['soy', 'Soy milk', 0.7],
+          ],
+        },
+        temp: {
+          label: 'Temperature',
+          options: [
+            ['hot', 'Hot', 0],
+            ['extra-hot', 'Extra hot', 0],
+            ['iced', 'Iced', 0],
+          ],
+        },
+        syrup: {
+          label: 'Syrup',
+          options: [
+            ['none', 'No syrup', 0],
+            ['maple', 'Maple', 0.5, 'Maple syrup'],
+            ['vanilla', 'Vanilla', 0.5, 'Vanilla syrup'],
+            ['caramel', 'Caramel', 0.5, 'Caramel syrup'],
+            ['hazelnut', 'Hazelnut', 0.5, 'Hazelnut syrup'],
+          ],
+        },
+        sweetness: {
+          label: 'Sweetness',
+          options: [
+            ['none', 'Unsweetened', 0],
+            ['light', 'Lightly sweet', 0],
+            ['regular', 'Regular', 0],
+            ['extra', 'Extra sweet', 0],
+          ],
+        },
+      };
+
+      const TOGGLES = [
+        ['extraShot', 'Extra espresso shot', 0.75],
+        ['decaf', 'Make it decaf', 0],
+        ['whip', 'Whipped cream', 0.5],
+      ];
+
+      const DRINKS = {
+        maple: {
+          name: 'Maple Oat Latte',
+          base: 5.25,
+          href: '/menu/seasonal',
+          groups: ['size', 'milk', 'temp'],
+          defaults: { size: 'medium', milk: 'oat', temp: 'hot', syrup: 'maple', sweetness: 'regular' },
+        },
+        espresso: {
+          name: 'Dark Roast Espresso',
+          base: 3.25,
+          href: '/menu/espresso',
+          groups: ['size', 'milk', 'temp'],
+          defaults: { size: 'small', milk: 'none', temp: 'hot', syrup: 'none', sweetness: 'none' },
+        },
+        coldbrew: {
+          name: 'Cold Brew',
+          base: 4.5,
+          href: '/menu/cold-brew',
+          groups: ['size', 'milk'],
+          defaults: { size: 'medium', milk: 'none', temp: 'iced', syrup: 'none', sweetness: 'none' },
+        },
+      };
+
+      const money = (n) => `$${Math.abs(n).toFixed(2)}`;
+      const priceTag = (d) => (d ? `<span class="price">${d > 0 ? '+' : '−'}${money(d)}</span>` : '');
+      const option = (group, value) => OPTIONS[group].options.find((o) => o[0] === value);
+      const optionPrice = (group, value) => option(group, value)[2];
+      const shortLabel = (group, value) => {
+        const o = option(group, value);
+        return o[3] || o[1];
+      };
+
+      function priceOf(drink, state) {
+        let total = drink.base;
+        Object.keys(OPTIONS).forEach((g) => {
+          total += optionPrice(g, state[g]) - optionPrice(g, drink.defaults[g]);
+        });
+        TOGGLES.forEach(([key, , price]) => state[key] && (total += price));
+        return total;
+      }
+
+      function summaryOf(drink, state) {
+        const parts = [shortLabel('size', state.size)];
+        if (state.milk !== 'none') parts.push(shortLabel('milk', state.milk));
+        if (drink.groups.includes('temp')) parts.push(shortLabel('temp', state.temp));
+        if (state.syrup !== 'none') parts.push(shortLabel('syrup', state.syrup));
+        if (state.sweetness !== drink.defaults.sweetness) parts.push(shortLabel('sweetness', state.sweetness));
+        TOGGLES.forEach(([key, label]) => state[key] && parts.push(label));
+        return parts.join(' · ');
+      }
+
+      function buildCardMenu(key, drink) {
+        const radios = (group) =>
+          OPTIONS[group].options
+            .map(([value, label, price]) => {
+              const delta = price - optionPrice(group, drink.defaults[group]);
+              return `<li role="none"><div role="menuitemradio" tabindex="-1" aria-checked="false" data-group="${group}" data-value="${value}">${label}${priceTag(delta)}</div></li>`;
+            })
+            .join('');
+        const submenu = (label, inner, hint) =>
+          `<li role="none"><div role="menuitem" tabindex="-1" aria-haspopup="menu" aria-expanded="false">${label}${hint ? `<span class="hint" data-hint="${hint}"></span>` : ''}</div><ul role="menu" class="menu" aria-label="${label}" hidden>${inner}</ul></li>`;
+        const toggles = TOGGLES.map(
+          ([toggle, label, price]) =>
+            `<li role="none"><div role="menuitemcheckbox" tabindex="-1" aria-checked="false" data-toggle="${toggle}">${label}${priceTag(price)}</div></li>`
+        ).join('');
+
+        return `
+          <button type="button" class="btn" id="${key}-btn" aria-haspopup="menu" aria-expanded="false"
+            aria-controls="${key}-menu" aria-describedby="${key}-summary">Customize &amp; Order</button>
+          <ul role="menu" class="menu" id="${key}-menu" aria-label="Customize ${drink.name}" hidden>
+            ${drink.groups.map((g) => submenu(OPTIONS[g].label, radios(g), g)).join('')}
+            ${submenu('Sweetener', submenu('Syrup', radios('syrup'), 'syrup') + submenu('Sweetness', radios('sweetness'), 'sweetness'))}
+            <li role="separator"></li>
+            <li role="presentation" class="menu-heading" aria-hidden="true">Add-ons</li>
+            <li role="none"><ul role="group" aria-label="Add-ons">${toggles}</ul></li>
+            <li role="separator"></li>
+            <li role="none"><div role="menuitemcheckbox" tabindex="-1" aria-checked="false" data-toggle="favorite">Save to favorites</div></li>
+            <li role="none"><div role="menuitem" tabindex="-1" data-action="reset">Reset to default</div></li>
+            <li role="none"><a role="menuitem" tabindex="-1" href="${drink.href}">View details</a></li>
+            <li role="separator"></li>
+            <li role="none"><div role="menuitem" tabindex="-1" class="menu-primary" data-action="add">Add to order<span class="price" data-total></span></div></li>
+          </ul>`;
+      }
+
+      // ---- Wire up -----------------------------------------------------------
+
+      const cart = [];
+      const cartCount = document.getElementById('cart-count');
+
+      document.querySelectorAll('.card[data-drink]').forEach((card) => {
+        const key = card.dataset.drink;
+        const drink = DRINKS[key];
+        const wrap = card.querySelector('.menu-wrap');
+        const summary = card.querySelector('.order-summary');
+        const fresh = () => ({ ...drink.defaults, ...Object.fromEntries(TOGGLES.map(([k]) => [k, false])) });
+        let state = fresh();
+        let favorite = false;
+
+        wrap.innerHTML = buildCardMenu(key, drink);
+        const menuEl = wrap.querySelector('[role="menu"]');
+        new MenuButton(wrap);
+
+        function render() {
+          menuEl.querySelectorAll('[data-group]').forEach((el) =>
+            el.setAttribute('aria-checked', String(state[el.dataset.group] === el.dataset.value))
+          );
+          menuEl.querySelectorAll('[data-toggle]').forEach((el) => {
+            const on = el.dataset.toggle === 'favorite' ? favorite : state[el.dataset.toggle];
+            el.setAttribute('aria-checked', String(on));
+          });
+          menuEl.querySelectorAll('[data-hint]').forEach((el) => {
+            const g = el.dataset.hint;
+            el.textContent = option(g, state[g])[1];
+          });
+          const total = money(priceOf(drink, state));
+          menuEl.querySelector('[data-total]').textContent = total;
+          summary.innerHTML = `${summaryOf(drink, state)}<strong>${total}</strong>`;
+        }
+
+        wrap.addEventListener('menu:change', (e) => {
+          const el = e.detail.item;
+          if (el.dataset.group) {
+            state[el.dataset.group] = el.dataset.value;
+          } else if (el.dataset.toggle === 'favorite') {
+            favorite = el.getAttribute('aria-checked') === 'true';
+            notify(favorite ? `${drink.name} saved to favorites` : `${drink.name} removed from favorites`);
+          } else if (el.dataset.toggle) {
+            state[el.dataset.toggle] = el.getAttribute('aria-checked') === 'true';
+          }
+          render();
+        });
+
+        wrap.addEventListener('menu:select', (e) => {
+          const action = e.detail.item.dataset.action;
+          if (action === 'reset') {
+            state = fresh();
+            render();
+            notify(`${drink.name} reset to default`);
+          } else if (action === 'add') {
+            cart.push({ drink: key, ...state, price: priceOf(drink, state) });
+            cartCount.textContent = cart.length;
+            notify(`Added ${drink.name} (${summaryOf(drink, state)}) to your order — ${cart.length} item${cart.length === 1 ? '' : 's'}`);
+          }
+        });
+
+        render();
+      });
+
+      document.querySelectorAll('nav .menu-wrap').forEach((wrap) => new MenuButton(wrap));
+
+      document.getElementById('account-menu').parentElement.addEventListener('menu:change', (e) => {
+        const el = e.detail.item;
+        if (el.dataset.pref === 'pickup') notify(`Pickup preference: ${el.textContent.trim()}`);
+        if (el.dataset.pref === 'offers') {
+          notify(el.getAttribute('aria-checked') === 'true' ? 'Subscribed to special offers' : 'Unsubscribed from special offers');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
