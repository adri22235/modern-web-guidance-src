+
+    @supports (position-area: block-end) {
+      /* Top-level menus sit below their trigger (implicit anchor from the invoker). */
+      .menu {
+        inset: auto;
+        margin: 6px 0 0;
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-inline, flip-block;
+      }
+
+      /* A menu nested in another menu is a submenu: beside its parent item. */
+      .menu .menu {
+        margin: -0.4rem 0 0 2px;
+        position-area: inline-end span-block-end;
+        position-try-fallbacks: flip-inline, flip-block, --below;
+      }
+    }
+
+    @position-try --below {
+      position-area: block-end span-inline-end;
+      margin: 0 0 0 1rem;
+      min-inline-size: 0;
+      max-inline-size: calc(100% - 1rem);
+    }
+
+    /* Without anchor positioning, script places the menu with left/top. */
