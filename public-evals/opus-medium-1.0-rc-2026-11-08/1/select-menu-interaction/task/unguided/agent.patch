+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var select = document.getElementById('shop');
+      var group = document.getElementById('shop-group');
+      var error = document.getElementById('shop-error');
+
+      // Errors stay hidden until the user has interacted with the menu or tried to submit.
+      function showValidity() {
+        group.classList.add('touched');
+        if (select.validity.valid) {
+          error.hidden = true;
+          error.textContent = '';
+          select.removeAttribute('aria-invalid');
+        } else {
+          error.textContent = 'Please select a local shop.';
+          error.hidden = false;
+          select.setAttribute('aria-invalid', 'true');
+        }
+        return select.validity.valid;
+      }
+
+      select.addEventListener('blur', showValidity);
+      select.addEventListener('change', showValidity);
+
+      form.addEventListener('submit', function (event) {
+        if (!showValidity()) {
+          event.preventDefault();
+          select.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
