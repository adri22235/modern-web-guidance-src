+  <script>
+    // Script performance monitor: uses the Long Animation Frames API to detect
+    // scripts that delay rendering, and keeps a history of past occurrences in
+    // localStorage. Inspect from the console via `window.scriptPerf`.
+    (() => {
+      if (!PerformanceObserver.supportedEntryTypes?.includes('long-animation-frame')) return;
+
+      const STORAGE_KEY = 'scriptPerf:history';
+      const MAX_RECORDS = 200;
+      const SLOW_SCRIPT_MS = 20; // Ignore tiny scripts inside a long frame.
+      const round = (n) => Math.round(n * 10) / 10;
+
+      const load = () => {
+        try {
+          return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? [];
+        } catch {
+          return [];
+        }
+      };
+
+      const save = (records) => {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(records.slice(-MAX_RECORDS)));
+        } catch {
+          // Storage full or unavailable; keep monitoring in memory only.
+        }
+      };
+
+      let history = load();
+      // performance.timeOrigin anchors entry timestamps to wall-clock time, so
+      // buffered entries observed late still record when they actually happened.
+      const toDate = (t) => new Date(performance.timeOrigin + t).toISOString();
+
+      const observer = new PerformanceObserver((list) => {
+        const records = list.getEntries().flatMap((frame) => {
+          const scripts = frame.scripts
+            .filter((s) => s.duration >= SLOW_SCRIPT_MS)
+            .map((s) => ({
+              sourceURL: s.sourceURL || '(inline)',
+              sourceFunctionName: s.sourceFunctionName || '',
+              invoker: s.invoker,
+              invokerType: s.invokerType,
+              duration: round(s.duration),
+              forcedStyleAndLayoutDuration: round(s.forcedStyleAndLayoutDuration),
+            }));
+          if (!scripts.length) return [];
+          return [{
+            time: toDate(frame.startTime),
+            page: location.pathname,
+            frameDuration: round(frame.duration),
+            blockingDuration: round(frame.blockingDuration),
+            scripts,
+          }];
+        });
+
+        if (!records.length) return;
+        history = [...history, ...records].slice(-MAX_RECORDS);
+        save(history);
+        records.forEach((r) => {
+          console.warn(`[scriptPerf] Slow script(s) delayed a frame by ${r.frameDuration}ms`, r);
+        });
+      });
+
+      // buffered: true also reports long frames from before this observer ran.
+      observer.observe({ type: 'long-animation-frame', buffered: true });
+
+      window.scriptPerf = {
+        // All recorded occurrences, oldest first.
+        history: () => [...history],
+        // Scripts ranked by total time spent in long frames.
+        summary() {
+          const bySource = new Map();
+          for (const record of history) {
+            for (const s of record.scripts) {
+              const key = `${s.sourceURL} ${s.invoker}`;
+              const agg = bySource.get(key) ?? { sourceURL: s.sourceURL, invoker: s.invoker, count: 0, totalDuration: 0, maxDuration: 0 };
+              agg.count++;
+              agg.totalDuration = round(agg.totalDuration + s.duration);
+              agg.maxDuration = Math.max(agg.maxDuration, s.duration);
+              bySource.set(key, agg);
+            }
+          }
+          const rows = [...bySource.values()].sort((a, b) => b.totalDuration - a.totalDuration);
+          console.table(rows);
+          return rows;
+        },
+        clear() {
+          history = [];
+          try { localStorage.removeItem(STORAGE_KEY); } catch {}
+        },
+      };
+    })();
+  </script>
+
 </body>
 
