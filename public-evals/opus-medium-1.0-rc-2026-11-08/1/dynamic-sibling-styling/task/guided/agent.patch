+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count():
+    // inject 1-based index and count, and keep them in sync as items change.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const update = (parent) => {
+        const items = [...parent.children];
+        items.forEach((item, i) => {
+          item.style.setProperty('--sibling-index', i + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      };
+      const parents = () => new Set([...document.querySelectorAll(selector)].map((el) => el.parentElement));
+      parents().forEach(update);
+      new MutationObserver(() => parents().forEach(update))
+        .observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
+
