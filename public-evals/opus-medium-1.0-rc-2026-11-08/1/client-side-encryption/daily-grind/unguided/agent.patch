+++ b/js/delivery-notes.js
@@ -0,0 +1,207 @@
+// Homepage wiring for encrypted delivery notes.
+import {
+  SUITES, MAX_NOTE_LENGTH, detectSupport, generateRecipientKeys, parsePublicBundle,
+  fingerprint, encryptNote, decryptNote, b64u,
+} from './delivery-notes-crypto.js';
+
+const KEY_URL = '/.well-known/delivery-notes-keys.json';
+const PENDING_KEY = 'dg.pendingDeliveryNote';
+
+const $ = (sel) => document.querySelector(sel);
+const form = $('#dn-form');
+const noteEl = $('#dn-note');
+const orderEl = $('#dn-order');
+const counterEl = $('#dn-counter');
+const suitesEl = $('#dn-suites');
+const submitBtn = $('#dn-submit');
+const statusEl = $('#dn-status');
+const keyInfoEl = $('#dn-keyinfo');
+const resultEl = $('#dn-result');
+const summaryEl = $('#dn-summary');
+const envelopeEl = $('#dn-envelope');
+const verifyOut = $('#dn-verify-out');
+
+let support;
+let desk; // { publicBundle, privateKeys? , source }
+let lastEnvelope;
+
+function setStatus(msg, kind = 'info') {
+  statusEl.textContent = msg;
+  statusEl.dataset.kind = kind;
+}
+
+function renderSuites() {
+  suitesEl.replaceChildren();
+  let firstAvailable;
+  for (const [key, suite] of Object.entries(SUITES)) {
+    const available = support.suites[key] && suite.kems.every((k) => desk.publicBundle.keys[k]);
+    const label = document.createElement('label');
+    label.className = 'dn-suite';
+    const input = Object.assign(document.createElement('input'), {
+      type: 'radio', name: 'suite', value: key, disabled: !available,
+    });
+    if (available && !firstAvailable) {
+      firstAvailable = key;
+      input.checked = true;
+    }
+    const body = document.createElement('span');
+    const title = document.createElement('strong');
+    title.textContent = suite.name;
+    if (key === 'hybrid') {
+      const badge = document.createElement('em');
+      badge.className = 'dn-badge';
+      badge.textContent = 'Recommended';
+      title.append(' ', badge);
+    }
+    const desc = document.createElement('small');
+    desc.textContent = available ? suite.summary : 'Not supported by this browser.';
+    body.append(title, desc);
+    label.append(input, body);
+    suitesEl.append(label);
+  }
+  submitBtn.disabled = !firstAvailable;
+}
+
+async function loadDeskKey() {
+  try {
+    const res = await fetch(KEY_URL, { headers: { Accept: 'application/json' }, cache: 'no-cache' });
+    if (!res.ok) throw new Error(String(res.status));
+    const bundle = await res.json();
+    parsePublicBundle(bundle);
+    return { publicBundle: bundle, source: 'published' };
+  } catch {
+    // No published key (e.g. static preview): spin up a session-only demo desk.
+    const demo = await generateRecipientKeys(support);
+    return { ...demo, source: 'demo' };
+  }
+}
+
+async function renderKeyInfo() {
+  const fp = await fingerprint(desk.publicBundle);
+  keyInfoEl.replaceChildren();
+  const strong = document.createElement('strong');
+  strong.textContent = desk.source === 'published' ? 'Delivery desk key' : 'Demo delivery desk key';
+  const code = document.createElement('code');
+  code.textContent = fp;
+  keyInfoEl.append(strong, ' · fingerprint ', code);
+  if (desk.source === 'demo') {
+    const note = document.createElement('small');
+    note.textContent = ' (generated in this tab for preview; private half never leaves memory)';
+    keyInfoEl.append(note);
+  }
+  $('#dn-verify').hidden = !desk.privateKeys;
+  $('#dn-tamper').hidden = !desk.privateKeys;
+}
+
+function updateCounter() {
+  const n = noteEl.value.length;
+  counterEl.textContent = `${n} / ${MAX_NOTE_LENGTH}`;
+  counterEl.dataset.over = String(n > MAX_NOTE_LENGTH);
+}
+
+function showEnvelope(env) {
+  const suiteKey = Object.keys(SUITES).find((k) => SUITES[k].id === env.suite);
+  const rows = [
+    ['Suite', SUITES[suiteKey].name],
+    ['Key establishment', SUITES[suiteKey].kems.map((k) => ({
+      mlkem768: `ML-KEM-768 ciphertext (${b64u.decode(env.enc[k]).length} B, ${support.mlkemImplementation})`,
+      x25519: 'X25519 ephemeral key (32 B)',
+      p256: 'P-256 ephemeral key (65 B)',
+    })[k]).join(' + ')],
+    ['Key derivation', 'HKDF-SHA256 over transcript-bound shared secret(s)'],
+    ['Encryption', `AES-256-GCM, 96-bit nonce, ${b64u.decode(env.ct).length} B incl. 128-bit tag`],
+    ['Bound to order', env.orderRef || '(none)'],
+    ['Envelope size', `${JSON.stringify(env).length} bytes`],
+  ];
+  summaryEl.replaceChildren(...rows.flatMap(([k, v]) => {
+    const dt = document.createElement('dt');
+    dt.textContent = k;
+    const dd = document.createElement('dd');
+    dd.textContent = v;
+    return [dt, dd];
+  }));
+  envelopeEl.textContent = JSON.stringify(env, null, 2);
+  verifyOut.textContent = '';
+  verifyOut.dataset.kind = '';
+  resultEl.hidden = false;
+  $('#dn-placeholder').hidden = true;
+}
+
+form.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const suite = new FormData(form).get('suite');
+  submitBtn.disabled = true;
+  setStatus('Establishing shared secret and encrypting…');
+  try {
+    lastEnvelope = await encryptNote({
+      note: noteEl.value,
+      orderRef: orderEl.value.trim(),
+      suite,
+      recipient: desk.publicBundle,
+    });
+    noteEl.value = '';
+    updateCounter();
+    showEnvelope(lastEnvelope);
+    setStatus('Sealed. The plaintext has been cleared from this form.', 'ok');
+  } catch (err) {
+    setStatus(err.message, 'error');
+  } finally {
+    submitBtn.disabled = false;
+  }
+});
+
+$('#dn-copy').addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(JSON.stringify(lastEnvelope));
+    setStatus('Encrypted envelope copied to clipboard.', 'ok');
+  } catch {
+    setStatus('Clipboard unavailable; select the envelope text to copy it.', 'error');
+  }
+});
+
+$('#dn-attach').addEventListener('click', () => {
+  // Only ciphertext is persisted; checkout picks it up and sends it with the order.
+  localStorage.setItem(PENDING_KEY, JSON.stringify(lastEnvelope));
+  setStatus('Encrypted note attached to your next order.', 'ok');
+});
+
+async function verify(envelope, label) {
+  try {
+    const { note } = await decryptNote(envelope, desk);
+    verifyOut.textContent = `${label}: decrypted “${note}”`;
+    verifyOut.dataset.kind = 'ok';
+  } catch (err) {
+    verifyOut.textContent = `${label}: ${err.message}`;
+    verifyOut.dataset.kind = 'error';
+  }
+}
+
+$('#dn-verify').addEventListener('click', () => verify(lastEnvelope, 'Delivery desk'));
+
+$('#dn-tamper').addEventListener('click', () => {
+  const tampered = structuredClone(lastEnvelope);
+  const ct = b64u.decode(tampered.ct);
+  ct[0] ^= 0x01;
+  tampered.ct = b64u.encode(ct);
+  verify(tampered, 'Tampered copy');
+});
+
+noteEl.maxLength = MAX_NOTE_LENGTH;
+noteEl.addEventListener('input', updateCounter);
+updateCounter();
+
+(async () => {
+  if (!globalThis.isSecureContext || !crypto?.subtle) {
+    setStatus('Encrypted notes need a secure (HTTPS) connection.', 'error');
+    return;
+  }
+  try {
+    support = await detectSupport();
+    desk = await loadDeskKey();
+    renderSuites();
+    await renderKeyInfo();
+    setStatus('Ready. Your note is encrypted on this device before it is sent.');
+  } catch (err) {
+    setStatus(`Encrypted notes unavailable: ${err.message}`, 'error');
+  }
+})();
