diff --git a/js/crypto/mlkem768.js b/js/crypto/mlkem768.js
new file mode 100644
index 0000000..5eca90e
--- /dev/null
+++ b/js/crypto/mlkem768.js
@@ -0,0 +1,290 @@
+// Dependency-free ML-KEM-768 (FIPS 203). Exposes the same seed/key formats as
+// other FIPS 203 implementations: 64-byte seed (d || z), 1184-byte encapsulation
+// key, 2400-byte decapsulation key, 1088-byte ciphertext, 32-byte shared secret.
+//
+// JavaScript offers no constant-time guarantees; secret-dependent branches are
+// avoided where practical, but prefer a native implementation when available.
+
+import { sha3_256, sha3_512, shake256, shake128Xof } from './sha3.js';
+
+const Q = 3329;
+const N = 256;
+const K = 3;
+const ETA1 = 2;
+const ETA2 = 2;
+const DU = 10;
+const DV = 4;
+
+export const PUBLIC_KEY_BYTES = 384 * K + 32; // 1184
+export const SECRET_KEY_BYTES = 768 * K + 96; // 2400
+export const CIPHERTEXT_BYTES = 32 * (DU * K + DV); // 1088
+export const SEED_BYTES = 64;
+
+const mod = (a) => ((a % Q) + Q) % Q;
+
+const bitRev7 = (i) => {
+  let r = 0;
+  for (let b = 0; b < 7; b++) r |= ((i >> b) & 1) << (6 - b);
+  return r;
+};
+const powMod = (base, exp) => {
+  let r = 1;
+  for (let i = 0; i < exp; i++) r = (r * base) % Q;
+  return r;
+};
+const ZETAS = Array.from({ length: 128 }, (_, i) => powMod(17, bitRev7(i)));
+const GAMMAS = Array.from({ length: 128 }, (_, i) => powMod(17, 2 * bitRev7(i) + 1));
+
+function ntt(f) {
+  const a = f.slice();
+  let i = 1;
+  for (let len = 128; len >= 2; len >>= 1) {
+    for (let start = 0; start < N; start += 2 * len) {
+      const zeta = ZETAS[i++];
+      for (let j = start; j < start + len; j++) {
+        const t = (zeta * a[j + len]) % Q;
+        a[j + len] = mod(a[j] - t);
+        a[j] = (a[j] + t) % Q;
+      }
+    }
+  }
+  return a;
+}
+
+function invNtt(f) {
+  const a = f.slice();
+  let i = 127;
+  for (let len = 2; len <= 128; len <<= 1) {
+    for (let start = 0; start < N; start += 2 * len) {
+      const zeta = ZETAS[i--];
+      for (let j = start; j < start + len; j++) {
+        const t = a[j];
+        a[j] = (t + a[j + len]) % Q;
+        a[j + len] = (zeta * mod(a[j + len] - t)) % Q;
+      }
+    }
+  }
+  for (let j = 0; j < N; j++) a[j] = (a[j] * 3303) % Q;
+  return a;
+}
+
+function multiplyNtts(f, g) {
+  const h = new Int32Array(N);
+  for (let i = 0; i < 128; i++) {
+    const a0 = f[2 * i], a1 = f[2 * i + 1], b0 = g[2 * i], b1 = g[2 * i + 1];
+    h[2 * i] = (a0 * b0 + ((a1 * b1) % Q) * GAMMAS[i]) % Q;
+    h[2 * i + 1] = (a0 * b1 + a1 * b0) % Q;
+  }
+  return h;
+}
+
+const polyAdd = (f, g) => {
+  const h = new Int32Array(N);
+  for (let i = 0; i < N; i++) h[i] = (f[i] + g[i]) % Q;
+  return h;
+};
+const polySub = (f, g) => {
+  const h = new Int32Array(N);
+  for (let i = 0; i < N; i++) h[i] = mod(f[i] - g[i]);
+  return h;
+};
+
+function byteEncode(f, d) {
+  const out = new Uint8Array(32 * d);
+  let acc = 0, bits = 0, o = 0;
+  for (let i = 0; i < N; i++) {
+    acc |= f[i] << bits;
+    bits += d;
+    while (bits >= 8) {
+      out[o++] = acc & 0xff;
+      acc >>>= 8;
+      bits -= 8;
+    }
+  }
+  return out;
+}
+
+function byteDecode(bytes, d) {
+  const f = new Int32Array(N);
+  const mask = (1 << d) - 1;
+  let acc = 0, bits = 0, o = 0;
+  for (let i = 0; i < N; i++) {
+    while (bits < d) {
+      acc |= bytes[o++] << bits;
+      bits += 8;
+    }
+    f[i] = acc & mask;
+    acc >>>= d;
+    bits -= d;
+  }
+  if (d === 12) for (let i = 0; i < N; i++) f[i] %= Q;
+  return f;
+}
+
+const compress = (f, d) => f.map((x) => Math.floor(((x << d) + 1664) / Q) & ((1 << d) - 1));
+const decompress = (f, d) => f.map((y) => (y * Q + (1 << (d - 1))) >> d);
+
+function sampleNtt(rho, j, i) {
+  const xof = shake128Xof(rho, Uint8Array.of(j, i));
+  const a = new Int32Array(N);
+  let n = 0;
+  while (n < N) {
+    const c = xof.read(3);
+    const d1 = c[0] + 256 * (c[1] & 0x0f);
+    const d2 = (c[1] >> 4) + 16 * c[2];
+    if (d1 < Q) a[n++] = d1;
+    if (d2 < Q && n < N) a[n++] = d2;
+  }
+  return a;
+}
+
+function samplePolyCbd(bytes, eta) {
+  const f = new Int32Array(N);
+  const bit = (k) => (bytes[k >> 3] >> (k & 7)) & 1;
+  for (let i = 0; i < N; i++) {
+    let x = 0, y = 0;
+    for (let j = 0; j < eta; j++) {
+      x += bit(2 * i * eta + j);
+      y += bit(2 * i * eta + eta + j);
+    }
+    f[i] = mod(x - y);
+  }
+  return f;
+}
+
+const prf = (eta, s, b) => shake256(64 * eta, s, Uint8Array.of(b));
+
+const concat = (...parts) => {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let o = 0;
+  for (const p of parts) { out.set(p, o); o += p.length; }
+  return out;
+};
+
+function expandMatrix(rho) {
+  const A = [];
+  for (let i = 0; i < K; i++) {
+    A.push([]);
+    for (let j = 0; j < K; j++) A[i].push(sampleNtt(rho, j, i));
+  }
+  return A;
+}
+
+function pkeKeyGen(d) {
+  const g = sha3_512(d, Uint8Array.of(K));
+  const rho = g.subarray(0, 32), sigma = g.subarray(32);
+  const A = expandMatrix(rho);
+  let nonce = 0;
+  const s = [], e = [];
+  for (let i = 0; i < K; i++) s.push(ntt(samplePolyCbd(prf(ETA1, sigma, nonce++), ETA1)));
+  for (let i = 0; i < K; i++) e.push(ntt(samplePolyCbd(prf(ETA1, sigma, nonce++), ETA1)));
+  const t = [];
+  for (let i = 0; i < K; i++) {
+    let acc = e[i];
+    for (let j = 0; j < K; j++) acc = polyAdd(acc, multiplyNtts(A[i][j], s[j]));
+    t.push(acc);
+  }
+  const ek = concat(...t.map((p) => byteEncode(p, 12)), rho);
+  const dk = concat(...s.map((p) => byteEncode(p, 12)));
+  return { ek, dk };
+}
+
+function pkeEncrypt(ek, m, r) {
+  const t = [];
+  for (let i = 0; i < K; i++) t.push(byteDecode(ek.subarray(384 * i, 384 * (i + 1)), 12));
+  const rho = ek.subarray(384 * K);
+  const A = expandMatrix(rho);
+  let nonce = 0;
+  const y = [], e1 = [];
+  for (let i = 0; i < K; i++) y.push(ntt(samplePolyCbd(prf(ETA1, r, nonce++), ETA1)));
+  for (let i = 0; i < K; i++) e1.push(samplePolyCbd(prf(ETA2, r, nonce++), ETA2));
+  const e2 = samplePolyCbd(prf(ETA2, r, nonce++), ETA2);
+  const u = [];
+  for (let i = 0; i < K; i++) {
+    let acc = new Int32Array(N);
+    for (let j = 0; j < K; j++) acc = polyAdd(acc, multiplyNtts(A[j][i], y[j]));
+    u.push(polyAdd(invNtt(acc), e1[i]));
+  }
+  const mu = decompress(byteDecode(m, 1), 1);
+  let vAcc = new Int32Array(N);
+  for (let i = 0; i < K; i++) vAcc = polyAdd(vAcc, multiplyNtts(t[i], y[i]));
+  const v = polyAdd(polyAdd(invNtt(vAcc), e2), mu);
+  return concat(...u.map((p) => byteEncode(compress(p, DU), DU)), byteEncode(compress(v, DV), DV));
+}
+
+function pkeDecrypt(dk, c) {
+  const u = [];
+  for (let i = 0; i < K; i++) {
+    u.push(decompress(byteDecode(c.subarray(32 * DU * i, 32 * DU * (i + 1)), DU), DU));
+  }
+  const v = decompress(byteDecode(c.subarray(32 * DU * K), DV), DV);
+  let acc = new Int32Array(N);
+  for (let i = 0; i < K; i++) {
+    const s = byteDecode(dk.subarray(384 * i, 384 * (i + 1)), 12);
+    acc = polyAdd(acc, multiplyNtts(s, ntt(u[i])));
+  }
+  return byteEncode(compress(polySub(v, invNtt(acc)), 1), 1);
+}
+
+const ctEqual = (a, b) => {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+};
+
+const randomBytes = (n) => crypto.getRandomValues(new Uint8Array(n));
+
+const asBytes = (x, len, name) => {
+  const b = x instanceof Uint8Array ? x : new Uint8Array(x);
+  if (b.length !== len) throw new Error(`ML-KEM-768: ${name} must be ${len} bytes`);
+  return b;
+};
+
+function checkEncapsulationKey(ek) {
+  // FIPS 203 §7.2 modulus check: every coefficient must already be reduced.
+  for (let i = 0; i < K; i++) {
+    const chunk = ek.subarray(384 * i, 384 * (i + 1));
+    if (!ctEqual(byteEncode(byteDecode(chunk, 12), 12), chunk)) {
+      throw new Error('ML-KEM-768: invalid encapsulation key');
+    }
+  }
+}
+
+/** Derives a key pair from a 64-byte seed (d || z), or a fresh random seed. */
+export function keygen(seed = randomBytes(SEED_BYTES)) {
+  seed = asBytes(seed, SEED_BYTES, 'seed');
+  const d = seed.subarray(0, 32), z = seed.subarray(32);
+  const { ek, dk: dkPke } = pkeKeyGen(d);
+  const dk = concat(dkPke, ek, sha3_256(ek), z);
+  return { publicKey: ek, secretKey: dk, seed: seed.slice() };
+}
+
+/** Returns { cipherText, sharedSecret } for the given encapsulation key. */
+export function encapsulate(publicKey, m = randomBytes(32)) {
+  const ek = asBytes(publicKey, PUBLIC_KEY_BYTES, 'public key');
+  checkEncapsulationKey(ek);
+  const g = sha3_512(asBytes(m, 32, 'message'), sha3_256(ek));
+  const sharedSecret = g.slice(0, 32);
+  const cipherText = pkeEncrypt(ek, m, g.subarray(32));
+  return { cipherText, sharedSecret };
+}
+
+/** Recovers the shared secret; returns an implicit-rejection key on tampering. */
+export function decapsulate(cipherText, secretKey) {
+  const c = asBytes(cipherText, CIPHERTEXT_BYTES, 'ciphertext');
+  const dk = asBytes(secretKey, SECRET_KEY_BYTES, 'secret key');
+  const dkPke = dk.subarray(0, 384 * K);
+  const ek = dk.subarray(384 * K, 768 * K + 32);
+  const h = dk.subarray(768 * K + 32, 768 * K + 64);
+  const z = dk.subarray(768 * K + 64);
+  if (!ctEqual(sha3_256(ek), h)) throw new Error('ML-KEM-768: invalid decapsulation key');
+  const m = pkeDecrypt(dkPke, c);
+  const g = sha3_512(m, h);
+  const kBar = shake256(32, z, c);
+  const cPrime = pkeEncrypt(ek, m, g.subarray(32));
+  const mask = ctEqual(c, cPrime) ? 0xff : 0x00;
+  const out = new Uint8Array(32);
+  for (let i = 0; i < 32; i++) out[i] = (g[i] & mask) | (kBar[i] & ~mask);
+  return out;
+}
