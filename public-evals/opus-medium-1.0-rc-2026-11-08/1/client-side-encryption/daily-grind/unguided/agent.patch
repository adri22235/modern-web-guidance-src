index 0000000..ef45b9e
--- /dev/null
+++ b/js/crypto/sha3.js
@@ -0,0 +1,128 @@
+// Minimal, dependency-free SHA-3 / SHAKE (FIPS 202) used by ML-KEM.
+// Keccak-f[1600] state is kept as 25 lanes split into 32-bit hi/lo halves.
+
+const RC_HI = new Uint32Array(24);
+const RC_LO = new Uint32Array(24);
+(() => {
+  // Round constants generated with the LFSR from FIPS 202 §3.2.5.
+  let r = 1;
+  for (let i = 0; i < 24; i++) {
+    let hi = 0, lo = 0;
+    for (let j = 0; j < 7; j++) {
+      if (r & 1) {
+        const bit = (1 << j) - 1;
+        if (bit < 32) lo ^= 1 << bit;
+        else hi ^= 1 << (bit - 32);
+      }
+      r = ((r << 1) ^ ((r >> 7) * 0x71)) & 0xff;
+    }
+    RC_HI[i] = hi >>> 0;
+    RC_LO[i] = lo >>> 0;
+  }
+})();
+
+const ROT = [
+  0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14,
+];
+
+function keccakF(s) {
+  const C = new Uint32Array(10);
+  const B = new Uint32Array(50);
+  for (let round = 0; round < 24; round++) {
+    // θ
+    for (let x = 0; x < 5; x++) {
+      C[2 * x] = s[2 * x] ^ s[2 * x + 10] ^ s[2 * x + 20] ^ s[2 * x + 30] ^ s[2 * x + 40];
+      C[2 * x + 1] = s[2 * x + 1] ^ s[2 * x + 11] ^ s[2 * x + 21] ^ s[2 * x + 31] ^ s[2 * x + 41];
+    }
+    for (let x = 0; x < 5; x++) {
+      const x1 = (x + 1) % 5, x4 = (x + 4) % 5;
+      const lo1 = C[2 * x1], hi1 = C[2 * x1 + 1];
+      const dLo = C[2 * x4] ^ ((lo1 << 1) | (hi1 >>> 31));
+      const dHi = C[2 * x4 + 1] ^ ((hi1 << 1) | (lo1 >>> 31));
+      for (let y = 0; y < 25; y += 5) {
+        s[2 * (x + y)] ^= dLo;
+        s[2 * (x + y) + 1] ^= dHi;
+      }
+    }
+    // ρ and π
+    for (let x = 0; x < 5; x++) {
+      for (let y = 0; y < 5; y++) {
+        const i = x + 5 * y;
+        const lo = s[2 * i], hi = s[2 * i + 1];
+        const r = ROT[i];
+        let nLo, nHi;
+        if (r === 0) { nLo = lo; nHi = hi; }
+        else if (r < 32) { nLo = (lo << r) | (hi >>> (32 - r)); nHi = (hi << r) | (lo >>> (32 - r)); }
+        else if (r === 32) { nLo = hi; nHi = lo; }
+        else { const k = r - 32; nLo = (hi << k) | (lo >>> (32 - k)); nHi = (lo << k) | (hi >>> (32 - k)); }
+        const j = y + 5 * ((2 * x + 3 * y) % 5);
+        B[2 * j] = nLo;
+        B[2 * j + 1] = nHi;
+      }
+    }
+    // χ
+    for (let y = 0; y < 25; y += 5) {
+      for (let x = 0; x < 5; x++) {
+        const a = 2 * (y + x), b = 2 * (y + ((x + 1) % 5)), c = 2 * (y + ((x + 2) % 5));
+        s[a] = B[a] ^ (~B[b] & B[c]);
+        s[a + 1] = B[a + 1] ^ (~B[b + 1] & B[c + 1]);
+      }
+    }
+    // ι
+    s[0] ^= RC_LO[round];
+    s[1] ^= RC_HI[round];
+  }
+}
+
+// Sponge with byte-oriented absorb/squeeze; `rate` in bytes, `dsb` = domain separator byte.
+class Keccak {
+  constructor(rate, dsb) {
+    this.rate = rate;
+    this.dsb = dsb;
+    this.state = new Uint32Array(50);
+    this.bytes = new Uint8Array(this.state.buffer);
+    this.pos = 0;
+    this.squeezing = false;
+    if (new Uint8Array(new Uint32Array([1]).buffer)[0] !== 1) {
+      throw new Error('sha3: big-endian platforms are not supported');
+    }
+  }
+  update(data) {
+    if (this.squeezing) throw new Error('sha3: update after digest');
+    for (let i = 0; i < data.length; i++) {
+      this.bytes[this.pos++] ^= data[i];
+      if (this.pos === this.rate) { keccakF(this.state); this.pos = 0; }
+    }
+    return this;
+  }
+  finish() {
+    if (this.squeezing) return;
+    this.bytes[this.pos] ^= this.dsb;
+    this.bytes[this.rate - 1] ^= 0x80;
+    keccakF(this.state);
+    this.pos = 0;
+    this.squeezing = true;
+  }
+  read(n) {
+    this.finish();
+    const out = new Uint8Array(n);
+    for (let i = 0; i < n; i++) {
+      if (this.pos === this.rate) { keccakF(this.state); this.pos = 0; }
+      out[i] = this.bytes[this.pos++];
+    }
+    return out;
+  }
+}
+
+const concat = (parts) => {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let o = 0;
+  for (const p of parts) { out.set(p, o); o += p.length; }
+  return out;
+};
+
+export const sha3_256 = (...parts) => new Keccak(136, 0x06).update(concat(parts)).read(32);
+export const sha3_512 = (...parts) => new Keccak(72, 0x06).update(concat(parts)).read(64);
+export const shake256 = (outLen, ...parts) => new Keccak(136, 0x1f).update(concat(parts)).read(outLen);
+// Incremental XOF, used for ML-KEM matrix sampling.
+export const shake128Xof = (...parts) => new Keccak(168, 0x1f).update(concat(parts));
