+++ b/js/delivery-notes-crypto.js
@@ -0,0 +1,304 @@
+// Encrypted delivery notes: establishes a per-note shared secret with the
+// store's delivery desk via key encapsulation / key agreement, then seals the
+// note with AES-256-GCM. Everything runs in the browser; plaintext never leaves it.
+//
+// Suites:
+//   hybrid  - X25519 ECDH + ML-KEM-768 (classical + post-quantum, recommended)
+//   pq      - ML-KEM-768 only (post-quantum)
+//   x25519  - X25519 ECDH (classical)
+//   p256    - ECDH P-256 (classical, broadest browser support)
+//
+// Shared secrets are combined with HKDF-SHA256 over a transcript that binds the
+// suite, key id, ephemeral/encapsulated values and recipient public keys, so a
+// hybrid secret stays safe as long as either component remains unbroken.
+
+import * as mlkemJs from './crypto/mlkem768.js';
+
+const subtle = globalThis.crypto.subtle;
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+export const VERSION = 1;
+const LABEL = 'DailyGrind-DeliveryNotes-v1';
+
+export const SUITES = {
+  hybrid: {
+    id: 'X25519MLKEM768-HKDF-SHA256-A256GCM',
+    name: 'Hybrid X25519 + ML-KEM-768',
+    kems: ['x25519', 'mlkem768'],
+    summary: 'Classical and post-quantum together; secure if either holds.',
+  },
+  pq: {
+    id: 'MLKEM768-HKDF-SHA256-A256GCM',
+    name: 'ML-KEM-768 (post-quantum)',
+    kems: ['mlkem768'],
+    summary: 'NIST FIPS 203 lattice-based key encapsulation.',
+  },
+  x25519: {
+    id: 'X25519-HKDF-SHA256-A256GCM',
+    name: 'X25519 key agreement',
+    kems: ['x25519'],
+    summary: 'Ephemeral-static elliptic-curve Diffie-Hellman.',
+  },
+  p256: {
+    id: 'P256-HKDF-SHA256-A256GCM',
+    name: 'ECDH P-256 key agreement',
+    kems: ['p256'],
+    summary: 'NIST curve ECDH with the widest browser support.',
+  },
+};
+
+const suiteById = (id) => Object.entries(SUITES).find(([, s]) => s.id === id)?.[0];
+
+// ---------- encoding helpers ----------
+
+export const b64u = {
+  encode(bytes) {
+    let s = '';
+    const b = new Uint8Array(bytes);
+    for (let i = 0; i < b.length; i += 0x8000) s += String.fromCharCode(...b.subarray(i, i + 0x8000));
+    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  decode(str) {
+    if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) throw new Error('Invalid base64url');
+    const s = atob(str.replace(/-/g, '+').replace(/_/g, '/'));
+    return Uint8Array.from(s, (c) => c.charCodeAt(0));
+  },
+};
+
+const concat = (...parts) => {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let o = 0;
+  for (const p of parts) { out.set(p, o); o += p.length; }
+  return out;
+};
+
+// Length-prefixed framing keeps transcript fields unambiguous.
+const frame = (...parts) =>
+  concat(...parts.flatMap((p) => {
+    const b = typeof p === 'string' ? enc.encode(p) : p;
+    const len = new Uint8Array(4);
+    new DataView(len.buffer).setUint32(0, b.length);
+    return [len, b];
+  }));
+
+const sha256 = async (data) => new Uint8Array(await subtle.digest('SHA-256', data));
+
+// ---------- primitive adapters ----------
+
+const ECDH = {
+  x25519: { alg: { name: 'X25519' }, pubLen: 32 },
+  p256: { alg: { name: 'ECDH', namedCurve: 'P-256' }, pubLen: 65 },
+};
+
+async function ecdhGenerate(kind) {
+  const kp = await subtle.generateKey(ECDH[kind].alg, true, ['deriveBits']);
+  const pub = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+  return { privateKey: kp.privateKey, publicKey: pub };
+}
+
+async function ecdhImportPublic(kind, raw) {
+  if (raw.length !== ECDH[kind].pubLen) throw new Error(`Invalid ${kind} public key`);
+  return subtle.importKey('raw', raw, ECDH[kind].alg, false, []);
+}
+
+async function ecdhDerive(kind, privateKey, peerRaw) {
+  const pub = await ecdhImportPublic(kind, peerRaw);
+  const bits = new Uint8Array(await subtle.deriveBits({ ...ECDH[kind].alg, public: pub }, privateKey, 256));
+  // Reject all-zero X25519 outputs (small-order peer points).
+  if (bits.every((b) => b === 0)) throw new Error('Degenerate key agreement result');
+  return bits;
+}
+
+// ML-KEM-768: prefer native WebCrypto (Modern Algorithms proposal), else the bundled module.
+const MLKEM_ALG = { name: 'ML-KEM-768' };
+let nativeMlkem;
+async function hasNativeMlkem() {
+  if (nativeMlkem !== undefined) return nativeMlkem;
+  try {
+    if (typeof subtle.encapsulateBits !== 'function') throw new Error('unsupported');
+    const { publicKey } = mlkemJs.keygen();
+    const key = await subtle.importKey('raw-public', publicKey, MLKEM_ALG, false, ['encapsulateBits']);
+    await subtle.encapsulateBits(MLKEM_ALG, key);
+    nativeMlkem = true;
+  } catch {
+    nativeMlkem = false;
+  }
+  return nativeMlkem;
+}
+
+const mlkem = {
+  keygen: () => mlkemJs.keygen(),
+  async encapsulate(publicKey) {
+    if (await hasNativeMlkem()) {
+      const key = await subtle.importKey('raw-public', publicKey, MLKEM_ALG, false, ['encapsulateBits']);
+      const r = await subtle.encapsulateBits(MLKEM_ALG, key);
+      return { cipherText: new Uint8Array(r.ciphertext), sharedSecret: new Uint8Array(r.sharedKey) };
+    }
+    return mlkemJs.encapsulate(publicKey);
+  },
+  async decapsulate(cipherText, seed) {
+    if (cipherText.length !== mlkemJs.CIPHERTEXT_BYTES) throw new Error('Invalid ML-KEM ciphertext');
+    if (await hasNativeMlkem()) {
+      const key = await subtle.importKey('raw-seed', seed, MLKEM_ALG, false, ['decapsulateBits']);
+      return new Uint8Array(await subtle.decapsulateBits(MLKEM_ALG, key, cipherText));
+    }
+    return mlkemJs.decapsulate(cipherText, mlkemJs.keygen(seed).secretKey);
+  },
+};
+
+/** Reports which suites this browser can run, and whether ML-KEM is native. */
+export async function detectSupport() {
+  const ecdhOk = async (kind) => {
+    try { await ecdhGenerate(kind); return true; } catch { return false; }
+  };
+  const [x25519, p256, native] = await Promise.all([ecdhOk('x25519'), ecdhOk('p256'), hasNativeMlkem()]);
+  return {
+    suites: { hybrid: x25519, pq: true, x25519, p256 },
+    mlkemImplementation: native ? 'native WebCrypto' : 'bundled FIPS 203 module',
+  };
+}
+
+// ---------- recipient (delivery desk) keys ----------
+
+/**
+ * Generates a delivery-desk key set. In production the store publishes only the
+ * public bundle and keeps the private half server-side; the homepage uses this
+ * to create an in-memory demo desk when no published key is available.
+ */
+export async function generateRecipientKeys(support) {
+  const kid = b64u.encode(crypto.getRandomValues(new Uint8Array(8)));
+  const publicBundle = { v: VERSION, kid, keys: {} };
+  const privateKeys = {};
+  const mk = mlkem.keygen();
+  publicBundle.keys.mlkem768 = b64u.encode(mk.publicKey);
+  privateKeys.mlkem768 = mk.seed;
+  for (const kind of ['x25519', 'p256']) {
+    if (support && support.suites[kind] === false) continue;
+    const kp = await ecdhGenerate(kind);
+    publicBundle.keys[kind] = b64u.encode(kp.publicKey);
+    privateKeys[kind] = kp.privateKey;
+  }
+  return { publicBundle, privateKeys };
+}
+
+/** Validates and decodes a published public key bundle. */
+export function parsePublicBundle(bundle) {
+  if (!bundle || bundle.v !== VERSION || typeof bundle.kid !== 'string' || typeof bundle.keys !== 'object') {
+    throw new Error('Unsupported delivery key bundle');
+  }
+  const lens = { x25519: 32, p256: 65, mlkem768: mlkemJs.PUBLIC_KEY_BYTES };
+  const keys = {};
+  for (const [kind, len] of Object.entries(lens)) {
+    if (bundle.keys[kind] === undefined) continue;
+    const raw = b64u.decode(bundle.keys[kind]);
+    if (raw.length !== len) throw new Error(`Invalid ${kind} key length`);
+    keys[kind] = raw;
+  }
+  return { kid: bundle.kid, keys };
+}
+
+/** Short human-checkable fingerprint of a public bundle. */
+export async function fingerprint(bundle) {
+  const { kid, keys } = parsePublicBundle(bundle);
+  const h = await sha256(frame(LABEL, kid, ...Object.keys(keys).sort().flatMap((k) => [k, keys[k]])));
+  return Array.from(h.subarray(0, 10), (b) => b.toString(16).padStart(2, '0')).join('').match(/.{4}/g).join(' ');
+}
+
+// ---------- key schedule ----------
+
+function header(suiteKey, kid, orderRef, encapsulated) {
+  // Fixed field order so sender and recipient serialise identically.
+  const encOut = {};
+  for (const k of SUITES[suiteKey].kems) encOut[k] = encapsulated[k];
+  return { v: VERSION, suite: SUITES[suiteKey].id, kid, orderRef, enc: encOut };
+}
+
+async function deriveNoteKey(suiteKey, hdr, recipientKeys, secrets) {
+  const kems = SUITES[suiteKey].kems;
+  // Post-quantum secret first, then classical (mirrors X-Wing / TLS hybrid ordering).
+  const order = ['mlkem768', 'x25519', 'p256'].filter((k) => kems.includes(k));
+  const ikm = concat(...order.map((k) => secrets[k]));
+  const transcript = frame(
+    LABEL, hdr.suite, hdr.kid, hdr.orderRef,
+    ...order.flatMap((k) => [k, b64u.decode(hdr.enc[k]), recipientKeys[k]]),
+  );
+  const salt = await sha256(transcript);
+  const base = await subtle.importKey('raw', ikm, 'HKDF', false, ['deriveKey']);
+  ikm.fill(0);
+  for (const k of order) secrets[k].fill(0);
+  return subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt, info: enc.encode(`${LABEL} note key ${hdr.suite}`) },
+    base,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+const aadOf = (hdr) => enc.encode(JSON.stringify(hdr));
+
+export const MAX_NOTE_LENGTH = 1000;
+
+/**
+ * Encrypts a note for the delivery desk. Returns a JSON-serialisable envelope.
+ * `orderRef` is authenticated (not encrypted) so a note cannot be moved to another order.
+ */
+export async function encryptNote({ note, orderRef = '', suite = 'hybrid', recipient }) {
+  if (!SUITES[suite]) throw new Error('Unknown suite');
+  if (typeof note !== 'string' || !note.trim()) throw new Error('Note is empty');
+  if (note.length > MAX_NOTE_LENGTH) throw new Error(`Note exceeds ${MAX_NOTE_LENGTH} characters`);
+  const { kid, keys } = parsePublicBundle(recipient);
+  const secrets = {};
+  const encapsulated = {};
+  for (const kind of SUITES[suite].kems) {
+    if (!keys[kind]) throw new Error(`Delivery desk has no ${kind} key`);
+    if (kind === 'mlkem768') {
+      const r = await mlkem.encapsulate(keys.mlkem768);
+      secrets.mlkem768 = r.sharedSecret;
+      encapsulated.mlkem768 = b64u.encode(r.cipherText);
+    } else {
+      const eph = await ecdhGenerate(kind);
+      secrets[kind] = await ecdhDerive(kind, eph.privateKey, keys[kind]);
+      encapsulated[kind] = b64u.encode(eph.publicKey);
+    }
+  }
+  const hdr = header(suite, kid, String(orderRef), encapsulated);
+  const key = await deriveNoteKey(suite, hdr, keys, secrets);
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ct = await subtle.encrypt({ name: 'AES-GCM', iv, additionalData: aadOf(hdr) }, key, enc.encode(note));
+  return { ...hdr, iv: b64u.encode(iv), ct: b64u.encode(ct) };
+}
+
+/** Decrypts an envelope with the delivery desk's private keys. Throws on any tampering. */
+export async function decryptNote(envelope, { publicBundle, privateKeys }) {
+  if (!envelope || envelope.v !== VERSION) throw new Error('Unsupported envelope version');
+  const suite = suiteById(envelope.suite);
+  if (!suite) throw new Error('Unknown suite');
+  const { kid, keys } = parsePublicBundle(publicBundle);
+  if (envelope.kid !== kid) throw new Error('Envelope was sealed for a different key');
+  if (typeof envelope.orderRef !== 'string' || typeof envelope.enc !== 'object' || !envelope.enc) {
+    throw new Error('Malformed envelope');
+  }
+  const encapsulated = {};
+  const secrets = {};
+  for (const kind of SUITES[suite].kems) {
+    const raw = b64u.decode(envelope.enc[kind] ?? '');
+    encapsulated[kind] = envelope.enc[kind];
+    secrets[kind] = kind === 'mlkem768'
+      ? await mlkem.decapsulate(raw, privateKeys.mlkem768)
+      : await ecdhDerive(kind, privateKeys[kind], raw);
+  }
+  const hdr = header(suite, kid, envelope.orderRef, encapsulated);
+  const key = await deriveNoteKey(suite, hdr, keys, secrets);
+  try {
+    const pt = await subtle.decrypt(
+      { name: 'AES-GCM', iv: b64u.decode(envelope.iv), additionalData: aadOf(hdr) },
+      key,
+      b64u.decode(envelope.ct),
+    );
+    return { note: dec.decode(pt), orderRef: envelope.orderRef, suite };
+  } catch {
+    throw new Error('Authentication failed: note was altered or sealed for another key');
+  }
+}
