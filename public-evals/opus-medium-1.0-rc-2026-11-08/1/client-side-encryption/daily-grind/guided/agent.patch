@@ -0,0 +1,351 @@
+// Encrypted delivery notes.
+//
+// Notes are sealed in the browser to the café's dispatch key, so only the
+// courier app holding the private key can read them. The preferred suite is
+// hybrid post-quantum ML-KEM-768 + X25519 key encapsulation with
+// ChaCha20-Poly1305; browsers without Modern WebCrypto fall back to
+// ephemeral-static X25519 (or P-256 ECDH) key agreement + HKDF + AES-GCM.
+//
+// In production the dispatch public key would be served by the backend and the
+// private key would live only on courier devices. For this demo the recipient
+// key pair is generated once (non-extractable) and kept in IndexedDB so the
+// "Decrypt as courier" round trip can be shown on the same page.
+
+const PROTOCOL_VERSION = 1;
+const HKDF_INFO = new TextEncoder().encode('daily-grind/delivery-note/v1');
+
+const SUITES = {
+  HYBRID_PQ: 'MLKEM768-X25519+ChaCha20-Poly1305',
+  X25519: 'X25519+HKDF-SHA256+AES-GCM',
+  P256: 'ECDH-P256+HKDF-SHA256+AES-GCM',
+};
+
+const SUITE_LABELS = {
+  [SUITES.HYBRID_PQ]: 'Hybrid post-quantum (ML-KEM-768 + X25519, ChaCha20-Poly1305)',
+  [SUITES.X25519]: 'Classical (X25519 key agreement, AES-256-GCM)',
+  [SUITES.P256]: 'Classical (P-256 ECDH key agreement, AES-256-GCM)',
+};
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------
+
+function toBase64(bytes) {
+  if (typeof bytes.toBase64 === 'function') return bytes.toBase64();
+  let binary = '';
+  for (const b of bytes) binary += String.fromCharCode(b);
+  return btoa(binary);
+}
+
+function fromBase64(str) {
+  if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(str);
+  return Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+}
+
+// Bind the unencrypted envelope metadata to the AEAD tag so swapping the order
+// reference or suite makes decryption fail.
+function associatedData({ v, suite, orderRef }) {
+  return new TextEncoder().encode(JSON.stringify({ v, suite, orderRef }));
+}
+
+// ---------------------------------------------------------------------------
+// Capability detection
+// ---------------------------------------------------------------------------
+
+function supportsPostQuantumEnvelope() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') &&
+    SubtleCrypto.supports('decapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+  );
+}
+
+async function supportsX25519() {
+  try {
+    await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function pickSuite() {
+  if (supportsPostQuantumEnvelope()) return SUITES.HYBRID_PQ;
+  if (await supportsX25519()) return SUITES.X25519;
+  return SUITES.P256;
+}
+
+function agreementAlgorithm(suite) {
+  return suite === SUITES.X25519 ? { name: 'X25519' } : { name: 'ECDH', namedCurve: 'P-256' };
+}
+
+// ---------------------------------------------------------------------------
+// Recipient (dispatch) key storage in IndexedDB
+// ---------------------------------------------------------------------------
+
+const DB_NAME = 'daily-grind-keys';
+const STORE = 'keys';
+const RECIPIENT_KEY_ID = 'dispatch-recipient';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function idb(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+async function generateRecipient(suite) {
+  if (suite === SUITES.HYBRID_PQ) {
+    const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, [
+      'encapsulateKey',
+      'decapsulateKey',
+    ]);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return { suite, keyPair, publicKeyBytes };
+  }
+
+  const keyPair = await crypto.subtle.generateKey(agreementAlgorithm(suite), false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+  return { suite, keyPair, publicKeyBytes };
+}
+
+async function loadOrCreateRecipient() {
+  const suite = await pickSuite();
+  const stored = await idb('readonly', (s) => s.get(RECIPIENT_KEY_ID)).catch(() => undefined);
+  if (stored?.suite === suite && stored.keyPair?.privateKey instanceof CryptoKey) return stored;
+
+  const recipient = await generateRecipient(suite);
+  // Non-extractable CryptoKeys are structured-cloned; the private key bytes never leave WebCrypto.
+  await idb('readwrite', (s) => s.put(recipient, RECIPIENT_KEY_ID)).catch(() => {});
+  return recipient;
+}
+
+// ---------------------------------------------------------------------------
+// Key establishment
+// ---------------------------------------------------------------------------
+
+async function deriveAgreementAesKey(suite, privateKey, peerPublicKey, salt) {
+  const sharedBits = await crypto.subtle.deriveBits(
+    { ...agreementAlgorithm(suite), public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedBits, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt, info: HKDF_INFO },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+async function encapsulate(suite, recipientPublicKeyBytes) {
+  if (suite === SUITES.HYBRID_PQ) {
+    const publicKey = await crypto.subtle.importKey(
+      'raw-public',
+      recipientPublicKeyBytes,
+      'MLKEM768-X25519',
+      true,
+      ['encapsulateKey'],
+    );
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      'MLKEM768-X25519',
+      publicKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt'],
+    );
+    return { sharedKey, capsule: new Uint8Array(ciphertext) };
+  }
+
+  // Ephemeral-static key agreement: the ephemeral public key acts as the capsule.
+  const algorithm = agreementAlgorithm(suite);
+  const recipientPublicKey = await crypto.subtle.importKey(
+    'raw',
+    recipientPublicKeyBytes,
+    algorithm,
+    true,
+    [],
+  );
+  const ephemeral = await crypto.subtle.generateKey(algorithm, false, ['deriveBits']);
+  const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveAgreementAesKey(
+    suite,
+    ephemeral.privateKey,
+    recipientPublicKey,
+    capsule,
+  );
+  return { sharedKey, capsule };
+}
+
+async function decapsulate(suite, recipientPrivateKey, capsule) {
+  if (suite === SUITES.HYBRID_PQ) {
+    return crypto.subtle.decapsulateKey(
+      'MLKEM768-X25519',
+      recipientPrivateKey,
+      capsule,
+      'ChaCha20-Poly1305',
+      false,
+      ['decrypt'],
+    );
+  }
+
+  const ephemeralPublicKey = await crypto.subtle.importKey(
+    'raw',
+    capsule,
+    agreementAlgorithm(suite),
+    true,
+    [],
+  );
+  return deriveAgreementAesKey(suite, recipientPrivateKey, ephemeralPublicKey, capsule);
+}
+
+// ---------------------------------------------------------------------------
+// Envelope seal / open
+// ---------------------------------------------------------------------------
+
+async function sealNote(recipient, orderRef, note) {
+  const header = { v: PROTOCOL_VERSION, suite: recipient.suite, orderRef };
+  const { sharedKey, capsule } = await encapsulate(recipient.suite, recipient.publicKeyBytes);
+
+  // Fresh 96-bit IV per message; every note also gets a fresh one-time key.
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = new Uint8Array(
+    await crypto.subtle.encrypt(
+      { name: sharedKey.algorithm.name, iv, additionalData: associatedData(header) },
+      sharedKey,
+      new TextEncoder().encode(note),
+    ),
+  );
+
+  return {
+    ...header,
+    capsule: toBase64(capsule),
+    iv: toBase64(iv),
+    ciphertext: toBase64(ciphertext),
+  };
+}
+
+async function openNote(recipient, envelope) {
+  if (envelope.v !== PROTOCOL_VERSION || envelope.suite !== recipient.suite) {
+    throw new Error('Unsupported envelope version or suite.');
+  }
+  const key = await decapsulate(
+    envelope.suite,
+    recipient.keyPair.privateKey,
+    fromBase64(envelope.capsule),
+  );
+  const plaintext = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv: fromBase64(envelope.iv),
+      additionalData: associatedData(envelope),
+    },
+    key,
+    fromBase64(envelope.ciphertext),
+  );
+  return new TextDecoder().decode(plaintext);
+}
+
+// ---------------------------------------------------------------------------
+// UI wiring
+// ---------------------------------------------------------------------------
+
+async function init() {
+  const section = document.getElementById('delivery-notes');
+  if (!section || !globalThis.isSecureContext || !globalThis.crypto?.subtle) return;
+
+  const form = section.querySelector('#delivery-notes-form');
+  const orderInput = form.elements.namedItem('order_ref');
+  const noteInput = form.elements.namedItem('note');
+  const submitBtn = form.querySelector('button[type="submit"]');
+  const status = section.querySelector('#delivery-notes-status');
+  const suiteEl = section.querySelector('#delivery-notes-suite');
+  const result = section.querySelector('#delivery-notes-result');
+  const envelopeEl = section.querySelector('#delivery-notes-envelope');
+  const decryptBtn = section.querySelector('#delivery-notes-decrypt');
+  const decryptedEl = section.querySelector('#delivery-notes-decrypted');
+
+  let recipient;
+  try {
+    recipient = await loadOrCreateRecipient();
+  } catch (err) {
+    console.error(err);
+    return; // Leave the section hidden rather than offer a plaintext path.
+  }
+
+  suiteEl.textContent = SUITE_LABELS[recipient.suite];
+  section.dataset.suite = recipient.suite === SUITES.HYBRID_PQ ? 'pq' : 'classical';
+  section.hidden = false;
+
+  let lastEnvelope = null;
+
+  for (const input of [orderInput, noteInput]) {
+    input.addEventListener('input', () => input.removeAttribute('aria-invalid'));
+  }
+
+  form.addEventListener(
+    'invalid',
+    (e) => e.target.setAttribute('aria-invalid', 'true'),
+    true,
+  );
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    if (!form.checkValidity()) {
+      form.querySelector(':invalid')?.focus();
+      return;
+    }
+
+    submitBtn.disabled = true;
+    status.textContent = 'Encrypting…';
+    try {
+      lastEnvelope = await sealNote(recipient, orderInput.value.trim(), noteInput.value);
+      // Drop the plaintext from the page as soon as it is sealed.
+      noteInput.value = '';
+      envelopeEl.textContent = JSON.stringify(lastEnvelope, null, 2);
+      decryptedEl.textContent = '';
+      result.hidden = false;
+      status.textContent = `Note for order ${lastEnvelope.orderRef} encrypted. Only our courier team can read it.`;
+    } catch (err) {
+      console.error(err);
+      status.textContent = 'Sorry, we couldn’t encrypt your note. Please try again.';
+    } finally {
+      submitBtn.disabled = false;
+    }
+  });
+
+  decryptBtn.addEventListener('click', async () => {
+    if (!lastEnvelope) return;
+    try {
+      decryptedEl.textContent = await openNote(recipient, lastEnvelope);
+      status.textContent = 'Courier view: note decrypted and authenticated.';
+    } catch (err) {
+      console.error(err);
+      decryptedEl.textContent = '';
+      status.textContent = 'Decryption failed: the note was tampered with or the key does not match.';
+    }
+  });
+}
+
+init();
