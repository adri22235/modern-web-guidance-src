+  <script>
+    // Center the map on Downtown initially
+    const mapViewport = document.querySelector('.map-viewport');
+    mapViewport.scrollLeft = (mapViewport.scrollWidth - mapViewport.clientWidth) / 2;
+    mapViewport.scrollTop = (mapViewport.scrollHeight - mapViewport.clientHeight) / 3;
+
+    // Fallback for browsers without scroll-axis-lock: apply raw 2D deltas ourselves
+    if (!CSS.supports('scroll-axis-lock', 'none')) {
+      const DRAG_THRESHOLD = 4;
+      let pointerStart = null;
+      let lastPointer = null;
+      let didPan = false;
+
+      mapViewport.addEventListener('wheel', (e) => {
+        if (e.ctrlKey) return; // Ctrl+wheel and trackpad pinch zoom the page
+        e.preventDefault();
+        mapViewport.scrollLeft += e.deltaX;
+        mapViewport.scrollTop += e.deltaY;
+      }, { passive: false });
+
+      mapViewport.addEventListener('pointerdown', (e) => {
+        // Ignore non-primary buttons and presses on native scrollbars
+        const rect = mapViewport.getBoundingClientRect();
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - mapViewport.clientLeft >= mapViewport.clientWidth ||
+          e.clientY - rect.top - mapViewport.clientTop >= mapViewport.clientHeight
+        ) {
+          return;
+        }
+        pointerStart = { x: e.clientX, y: e.clientY, id: e.pointerId };
+        lastPointer = { x: e.clientX, y: e.clientY };
+        didPan = false;
+      });
+
+      mapViewport.addEventListener('pointermove', (e) => {
+        if (!pointerStart || e.pointerId !== pointerStart.id) return;
+        if (!didPan) {
+          // Wait for real movement so taps on location pins still click through
+          if (Math.hypot(e.clientX - pointerStart.x, e.clientY - pointerStart.y) < DRAG_THRESHOLD) return;
+          didPan = true;
+          mapViewport.setPointerCapture(e.pointerId);
+          mapViewport.classList.add('is-panning');
+        }
+        mapViewport.scrollLeft -= e.clientX - lastPointer.x;
+        mapViewport.scrollTop -= e.clientY - lastPointer.y;
+        lastPointer = { x: e.clientX, y: e.clientY };
+      });
+
+      const endPointerPan = () => {
+        pointerStart = null;
+        lastPointer = null;
+        mapViewport.classList.remove('is-panning');
+      };
+      mapViewport.addEventListener('pointerup', endPointerPan);
+      mapViewport.addEventListener('pointercancel', endPointerPan);
+
+      // Don't follow a pin link when the gesture was a drag
+      mapViewport.addEventListener('click', (e) => {
+        if (didPan) {
+          e.preventDefault();
+          didPan = false;
+        }
+      }, true);
+
+      // Prevent native link/image dragging from hijacking the pan
+      mapViewport.addEventListener('dragstart', (e) => e.preventDefault());
+    }
+  </script>
