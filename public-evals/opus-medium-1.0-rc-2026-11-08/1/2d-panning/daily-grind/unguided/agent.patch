+  <script>
+    (function () {
+      var viewport = document.getElementById('cafe-map');
+      if (!viewport) return;
+
+      var info = document.getElementById('map-info');
+      var DRAG_THRESHOLD = 5;
+      var drag = null;
+      var velocity = { x: 0, y: 0 };
+      var inertiaFrame = null;
+      var suppressClick = false;
+
+      function stopInertia() {
+        if (inertiaFrame) cancelAnimationFrame(inertiaFrame);
+        inertiaFrame = null;
+      }
+
+      // Move both axes in a single update so diagonal motion is never axis-locked.
+      function panBy(dx, dy) {
+        viewport.scrollLeft += dx;
+        viewport.scrollTop += dy;
+      }
+
+      function startInertia() {
+        function step() {
+          velocity.x *= 0.92;
+          velocity.y *= 0.92;
+          if (Math.abs(velocity.x) < 0.3 && Math.abs(velocity.y) < 0.3) {
+            inertiaFrame = null;
+            return;
+          }
+          panBy(velocity.x, velocity.y);
+          inertiaFrame = requestAnimationFrame(step);
+        }
+        inertiaFrame = requestAnimationFrame(step);
+      }
+
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        if (e.target.closest('.map-info')) return;
+        stopInertia();
+        drag = {
+          id: e.pointerId,
+          startX: e.clientX,
+          startY: e.clientY,
+          lastX: e.clientX,
+          lastY: e.clientY,
+          lastTime: performance.now(),
+          moved: false
+        };
+        velocity.x = velocity.y = 0;
+      });
+
+      viewport.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+
+        if (!drag.moved) {
+          if (Math.hypot(e.clientX - drag.startX, e.clientY - drag.startY) < DRAG_THRESHOLD) return;
+          drag.moved = true;
+          viewport.classList.add('is-panning');
+          viewport.setPointerCapture(e.pointerId);
+        }
+
+        var dx = drag.lastX - e.clientX;
+        var dy = drag.lastY - e.clientY;
+        var now = performance.now();
+        var dt = Math.max(now - drag.lastTime, 1);
+        panBy(dx, dy);
+
+        // Frame-normalized velocity (~16ms) so direction changes mid-gesture are tracked live.
+        velocity.x = (dx / dt) * 16;
+        velocity.y = (dy / dt) * 16;
+        drag.lastX = e.clientX;
+        drag.lastY = e.clientY;
+        drag.lastTime = now;
+        e.preventDefault();
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        var moved = drag.moved;
+        var idle = performance.now() - drag.lastTime;
+        drag = null;
+        viewport.classList.remove('is-panning');
+        if (viewport.hasPointerCapture(e.pointerId)) viewport.releasePointerCapture(e.pointerId);
+        if (moved) {
+          suppressClick = true;
+          setTimeout(function () { suppressClick = false; }, 0);
+          if (e.type === 'pointerup' && idle < 80) startInertia();
+        }
+      }
+
+      viewport.addEventListener('pointerup', endDrag);
+      viewport.addEventListener('pointercancel', endDrag);
+
+      // Trackpads and wheels report deltaX and deltaY together; apply both at once.
+      viewport.addEventListener('wheel', function (e) {
+        if (e.ctrlKey) return; // leave pinch-zoom to the browser
+        stopInertia();
+        var scale = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+        var dx = e.deltaX * scale;
+        var dy = e.deltaY * scale;
+        if (e.shiftKey && !dx) { dx = dy; dy = 0; }
+        panBy(dx, dy);
+        e.preventDefault();
+      }, { passive: false });
+
+      // Keyboard: held arrow keys combine, so Up+Right pans diagonally.
+      var keys = {};
+      var keyFrame = null;
+      var KEY_SPEED = 12;
+      var KEY_MAP = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+
+      function keyStep() {
+        var dx = 0, dy = 0;
+        Object.keys(keys).forEach(function (k) {
+          dx += KEY_MAP[k][0];
+          dy += KEY_MAP[k][1];
+        });
+        if (!dx && !dy) { keyFrame = null; return; }
+        panBy(dx * KEY_SPEED, dy * KEY_SPEED);
+        keyFrame = requestAnimationFrame(keyStep);
+      }
+
+      viewport.addEventListener('keydown', function (e) {
+        if (!KEY_MAP[e.key] || e.target !== viewport) return;
+        e.preventDefault();
+        stopInertia();
+        keys[e.key] = true;
+        if (!keyFrame) keyFrame = requestAnimationFrame(keyStep);
+      });
+
+      viewport.addEventListener('keyup', function (e) {
+        delete keys[e.key];
+      });
+
+      viewport.addEventListener('blur', function () {
+        keys = {};
+      });
+
+      // Location pins
+      var activePin = null;
+
+      function closeInfo() {
+        info.hidden = true;
+        if (activePin) activePin.classList.remove('is-active');
+        activePin = null;
+      }
+
+      viewport.addEventListener('click', function (e) {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+          return;
+        }
+        if (e.target.closest('.map-info-close')) { closeInfo(); return; }
+        if (e.target.closest('.map-info')) return;
+
+        var pin = e.target.closest('.map-pin');
+        if (!pin) { closeInfo(); return; }
+
+        if (activePin) activePin.classList.remove('is-active');
+        activePin = pin;
+        pin.classList.add('is-active');
+        document.getElementById('map-info-name').textContent = pin.dataset.name;
+        document.getElementById('map-info-address').textContent = pin.dataset.address;
+        document.getElementById('map-info-hours').textContent = pin.dataset.hours;
+        info.style.left = pin.style.left;
+        info.style.top = pin.style.top;
+        info.hidden = false;
+      }, true);
+
+      viewport.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') closeInfo();
+      });
+
+      // Start centered on the map.
+      viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
+      viewport.scrollTop = (viewport.scrollHeight - viewport.clientHeight) / 2;
+    })();
+  </script>
+
