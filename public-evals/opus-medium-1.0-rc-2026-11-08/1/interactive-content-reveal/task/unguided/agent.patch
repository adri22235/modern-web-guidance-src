+
+  <script>
+    (() => {
+      const INNER = 90;
+      const OUTER = 140;
+
+      document.querySelectorAll('.product-card').forEach((card) => {
+        let hovered = false;
+
+        const setSize = (on) => {
+          card.style.setProperty('--inner-size', on ? `${INNER}px` : '0px');
+          card.style.setProperty('--outer-size', on ? `${OUTER}px` : '0px');
+        };
+
+        const setPosition = (x, y) => {
+          card.style.setProperty('--mouse-x', `${x}px`);
+          card.style.setProperty('--mouse-y', `${y}px`);
+        };
+
+        const trackPointer = (event) => {
+          const rect = card.getBoundingClientRect();
+          setPosition(event.clientX - rect.left, event.clientY - rect.top);
+        };
+
+        card.addEventListener('pointerenter', (event) => {
+          hovered = true;
+          trackPointer(event);
+          setSize(true);
+        });
+
+        card.addEventListener('pointermove', trackPointer);
+
+        card.addEventListener('pointerleave', () => {
+          hovered = false;
+          if (!card.matches(':focus-within')) setSize(false);
+        });
+
+        // Keyboard users get the spotlight centred on the details band
+        card.addEventListener('focusin', () => {
+          if (!hovered) setPosition(card.clientWidth / 2, 60);
+          setSize(true);
+        });
+
+        card.addEventListener('focusout', (event) => {
+          if (!hovered && !card.contains(event.relatedTarget)) setSize(false);
+        });
+      });
+    })();
+  </script>
