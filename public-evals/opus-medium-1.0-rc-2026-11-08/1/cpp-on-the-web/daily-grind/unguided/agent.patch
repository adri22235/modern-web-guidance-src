+#!/bin/sh
+# Builds smallpt.wasm from wasm/smallpt.cpp with emscripten. If emcc is not
+# installed, falls back to assembling the equivalent hand-written
+# wasm/smallpt.wat (verified pixel-identical by tools/check.mjs).
+set -e
+cd "$(dirname "$0")"
+if command -v emcc >/dev/null 2>&1; then
+  emcc -O3 wasm/smallpt.cpp -o smallpt.wasm \
+    --no-entry -sSTANDALONE_WASM -sINITIAL_MEMORY=16MB \
+    -sEXPORTED_FUNCTIONS=_init,_set_color,_get_passes,_render_pass,_get_rgba
+  echo "Built smallpt.wasm with emcc"
+else
+  echo "emcc not found; assembling wasm/smallpt.wat instead" >&2
+  node tools/wat2wasm.mjs wasm/smallpt.wat smallpt.wasm
+fi
