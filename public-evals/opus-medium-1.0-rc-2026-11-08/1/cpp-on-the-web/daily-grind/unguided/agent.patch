@@ -0,0 +1,56 @@
+#!/usr/bin/env node
+// Cross-checks smallpt.wasm against a native (g++) build of wasm/smallpt.cpp:
+// renders the same scene with the same seeds and colors and compares pixels.
+//
+// Usage: node tools/check.mjs [width height passes]
+import { execFileSync } from 'node:child_process';
+import { readFileSync, writeFileSync, mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const [w, h, passes] = (process.argv.length > 4 ? process.argv.slice(2, 5) : [80, 60, 3]).map(Number);
+const colors = [[6, 0.9, 0.3, 0.1], [7, 0.2, 0.8, 0.95], [0, 0.1, 0.6, 0.3]];
+const seed = (p) => (p + 1) * 2654435761 >>> 0;
+
+// Native build
+const dir = mkdtempSync(join(tmpdir(), 'smallpt-'));
+writeFileSync(join(dir, 'main.cpp'), `
+#include <stdio.h>
+#include "${join(root, 'wasm/smallpt.cpp')}"
+int main() {
+  init(${w}, ${h});
+  ${colors.map(([i, r, g, b]) => `set_color(${i}, ${r}, ${g}, ${b});`).join('\n  ')}
+  for (int p = 0; p < ${passes}; p++) render_pass((unsigned)((p + 1) * 2654435761u));
+  fwrite(get_rgba(), 1, ${w * h * 4}, stdout);
+}
+`);
+execFileSync('g++', ['-O2', '-ffp-contract=off', '-o', join(dir, 'smallpt'), join(dir, 'main.cpp')]);
+const native = execFileSync(join(dir, 'smallpt'), { maxBuffer: 1 << 26 });
+
+// Wasm build
+const { instance } = await WebAssembly.instantiate(readFileSync(join(root, 'smallpt.wasm')), {
+  env: { cos: Math.cos, sin: Math.sin, pow: Math.pow },
+});
+const ex = instance.exports;
+ex.init(w, h);
+for (const [i, r, g, b] of colors) ex.set_color(i, r, g, b);
+const t0 = performance.now();
+for (let p = 0; p < passes; p++) ex.render_pass(seed(p));
+const ms = performance.now() - t0;
+const wasm = new Uint8Array(ex.memory.buffer, ex.get_rgba(), w * h * 4);
+
+let diffPixels = 0, maxDiff = 0, sum = 0;
+for (let i = 0; i < w * h; i++) {
+  let d = 0;
+  for (let c = 0; c < 3; c++) d = Math.max(d, Math.abs(native[i * 4 + c] - wasm[i * 4 + c]));
+  if (d) diffPixels++;
+  maxDiff = Math.max(maxDiff, d);
+  sum += wasm[i * 4] + wasm[i * 4 + 1] + wasm[i * 4 + 2];
+}
+console.log(`${w}x${h}, ${passes} passes: wasm render ${ms.toFixed(0)} ms, mean value ${(sum / (w * h * 3)).toFixed(1)}`);
+console.log(`pixels differing from native: ${diffPixels}/${w * h} (max channel diff ${maxDiff})`);
+// Math.cos/sin in JS may differ from libm in the last bit, which can send an
+// occasional path a different way; anything more than that is a porting bug.
+if (diffPixels > w * h * 0.01) process.exit(1);
