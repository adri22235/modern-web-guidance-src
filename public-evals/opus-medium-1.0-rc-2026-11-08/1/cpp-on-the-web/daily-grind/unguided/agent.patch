diff --git a/smallpt-worker.js b/smallpt-worker.js
new file mode 100644
index 0000000..80adfb6
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,62 @@
+// Runs smallpt.wasm off the main thread and streams progressively refined frames.
+//
+// Message in:  { id, width, height, passes, colors: [[sphereIndex, r, g, b], ...] }
+// Messages out: { id, type: 'frame', pixels, width, height, passes, ms }
+//               { id, type: 'done' } | { id, type: 'error', message }
+
+const wasm = (async () => {
+  const response = await fetch(new URL('smallpt.wasm', self.location.href));
+  if (!response.ok) throw new Error(`Failed to load smallpt.wasm (${response.status})`);
+  const module = await WebAssembly.compile(await response.arrayBuffer());
+
+  // The module needs cos/sin/pow from the host (the emcc build links its own
+  // libm instead). Anything else an emcc build imports (e.g. WASI) is stubbed.
+  const math = { cos: Math.cos, sin: Math.sin, pow: Math.pow };
+  const imports = {};
+  for (const { module: mod, name, kind } of WebAssembly.Module.imports(module)) {
+    if (kind !== 'function') continue;
+    imports[mod] ??= {};
+    imports[mod][name] = (mod === 'env' && math[name]) || (() => 0);
+  }
+  const instance = await WebAssembly.instantiate(module, imports);
+  instance.exports._initialize?.(); // emcc reactor builds run static constructors here
+  return instance.exports;
+})();
+
+let current = 0;
+
+self.onmessage = async ({ data: job }) => {
+  current = job.id;
+  let smallpt;
+  try {
+    smallpt = await wasm;
+  } catch (err) {
+    self.postMessage({ id: job.id, type: 'error', message: err.message });
+    return;
+  }
+  if (job.id !== current) return;
+
+  smallpt.init(job.width, job.height);
+  for (const [i, r, g, b] of job.colors) smallpt.set_color(i, r, g, b);
+
+  const start = performance.now();
+  for (let pass = 0; pass < job.passes; pass++) {
+    smallpt.render_pass((Math.random() * 0xffffffff) >>> 0);
+    const ptr = smallpt.get_rgba();
+    const pixels = new Uint8ClampedArray(smallpt.memory.buffer, ptr, job.width * job.height * 4).slice();
+    self.postMessage({
+      id: job.id,
+      type: 'frame',
+      pixels,
+      width: job.width,
+      height: job.height,
+      passes: smallpt.get_passes(),
+      ms: performance.now() - start,
+    }, [pixels.buffer]);
+
+    // Yield so a newer job can preempt this one between passes.
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    if (job.id !== current) return;
+  }
+  self.postMessage({ id: job.id, type: 'done' });
+};
