--- /dev/null
+++ b/wasm/smallpt.wat
@@ -0,0 +1,495 @@
+;; smallpt (Kevin Beason, MIT license) as hand-written WebAssembly.
+;;
+;; This is an operation-for-operation port of wasm/smallpt.cpp: same scene,
+;; same xorshift RNG call order and the same floating point evaluation order,
+;; so it produces the same image as the C++ code. tools/check.mjs verifies this
+;; against a native build of smallpt.cpp. It exists so the .wasm can be rebuilt
+;; without emscripten (tools/wat2wasm.mjs); build.sh uses emcc when available.
+;;
+;; Exports match the emcc build: init, set_color, get_passes, render_pass, get_rgba, memory.
+;;
+;; Memory layout:
+;;   0       sphere table, 9 x 88 bytes:
+;;           rad, p.xyz, e.xyz, c.xyz, refl (f64; 0 = DIFF, 1 = SPEC, 2 = REFR)
+;;   1024    accumulation buffer, 640*480 x 3 f64
+;;   7373824 RGBA8 output, 640*480 x 4 bytes
+(module
+  (import "env" "cos" (func $cos (param f64) (result f64)))
+  (import "env" "sin" (func $sin (param f64) (result f64)))
+  (import "env" "pow" (func $pow (param f64 f64) (result f64)))
+
+  (memory (export "memory") 132)
+
+  (global $W (mut i32) (i32.const 0))
+  (global $H (mut i32) (i32.const 0))
+  (global $passes (mut i32) (i32.const 0))
+  (global $rng (mut i32) (i32.const 1))
+
+  (func $sphere (param $i i32) (param $rad f64) (param $px f64) (param $py f64) (param $pz f64)
+                (param $e f64) (param $cx f64) (param $cy f64) (param $cz f64) (param $refl f64)
+    (local $a i32)
+    (local.set $a (i32.mul (local.get $i) (i32.const 88)))
+    (f64.store offset=0 (local.get $a) (local.get $rad))
+    (f64.store offset=8 (local.get $a) (local.get $px))
+    (f64.store offset=16 (local.get $a) (local.get $py))
+    (f64.store offset=24 (local.get $a) (local.get $pz))
+    (f64.store offset=32 (local.get $a) (local.get $e))
+    (f64.store offset=40 (local.get $a) (local.get $e))
+    (f64.store offset=48 (local.get $a) (local.get $e))
+    (f64.store offset=56 (local.get $a) (local.get $cx))
+    (f64.store offset=64 (local.get $a) (local.get $cy))
+    (f64.store offset=72 (local.get $a) (local.get $cz))
+    (f64.store offset=80 (local.get $a) (local.get $refl)))
+
+  (func $setup_scene
+    ;;           i   rad          p.x                 p.y                p.z                   e                 c.x                c.y                c.z               refl
+    (call $sphere (i32.const 0) (f64.const 1e5) (f64.const 100001) (f64.const 40.8) (f64.const 81.6) (f64.const 0) (f64.const 0.75) (f64.const 0.25) (f64.const 0.25) (f64.const 0)) ;; Left
+    (call $sphere (i32.const 1) (f64.const 1e5) (f64.const -99901) (f64.const 40.8) (f64.const 81.6) (f64.const 0) (f64.const 0.25) (f64.const 0.25) (f64.const 0.75) (f64.const 0)) ;; Rght
+    (call $sphere (i32.const 2) (f64.const 1e5) (f64.const 50) (f64.const 40.8) (f64.const 1e5) (f64.const 0) (f64.const 0.75) (f64.const 0.75) (f64.const 0.75) (f64.const 0)) ;; Back
+    (call $sphere (i32.const 3) (f64.const 1e5) (f64.const 50) (f64.const 40.8) (f64.const -99830) (f64.const 0) (f64.const 0) (f64.const 0) (f64.const 0) (f64.const 0)) ;; Frnt
+    (call $sphere (i32.const 4) (f64.const 1e5) (f64.const 50) (f64.const 1e5) (f64.const 81.6) (f64.const 0) (f64.const 0.75) (f64.const 0.75) (f64.const 0.75) (f64.const 0)) ;; Botm
+    (call $sphere (i32.const 5) (f64.const 1e5) (f64.const 50) (f64.const -99918.4) (f64.const 81.6) (f64.const 0) (f64.const 0.75) (f64.const 0.75) (f64.const 0.75) (f64.const 0)) ;; Top
+    (call $sphere (i32.const 6) (f64.const 16.5) (f64.const 27) (f64.const 16.5) (f64.const 47) (f64.const 0) (f64.const 0.999) (f64.const 0.999) (f64.const 0.999) (f64.const 1)) ;; Mirr
+    (call $sphere (i32.const 7) (f64.const 16.5) (f64.const 73) (f64.const 16.5) (f64.const 78) (f64.const 0) (f64.const 0.999) (f64.const 0.999) (f64.const 0.999) (f64.const 2)) ;; Glas
+    (call $sphere (i32.const 8) (f64.const 600) (f64.const 50) (f64.const 681.33) (f64.const 81.6) (f64.const 12) (f64.const 0) (f64.const 0) (f64.const 0) (f64.const 0))) ;; Lite
+  (start $setup_scene)
+
+  ;; xorshift32 -> [0, 1)
+  (func $rnd (result f64)
+    (local $x i32)
+    (local.set $x (global.get $rng))
+    (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 13))))
+    (local.set $x (i32.xor (local.get $x) (i32.shr_u (local.get $x) (i32.const 17))))
+    (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 5))))
+    (global.set $rng (local.get $x))
+    (f64.mul (f64.convert_i32_u (local.get $x)) (f64.const 2.3283064365386963e-10)))
+
+  (func $clamp (param $x f64) (result f64)
+    (if (result f64) (f64.lt (local.get $x) (f64.const 0))
+      (then (f64.const 0))
+      (else (if (result f64) (f64.gt (local.get $x) (f64.const 1))
+        (then (f64.const 1))
+        (else (local.get $x))))))
+
+  ;; Sphere::intersect: distance along the ray, 0 if no hit.
+  (func $sphere_hit (param $i i32) (param $ox f64) (param $oy f64) (param $oz f64)
+                    (param $dx f64) (param $dy f64) (param $dz f64) (result f64)
+    (local $a i32) (local $opx f64) (local $opy f64) (local $opz f64)
+    (local $b f64) (local $det f64) (local $rad f64) (local $t f64)
+    (local.set $a (i32.mul (local.get $i) (i32.const 88)))
+    (local.set $rad (f64.load offset=0 (local.get $a)))
+    (local.set $opx (f64.sub (f64.load offset=8 (local.get $a)) (local.get $ox)))
+    (local.set $opy (f64.sub (f64.load offset=16 (local.get $a)) (local.get $oy)))
+    (local.set $opz (f64.sub (f64.load offset=24 (local.get $a)) (local.get $oz)))
+    (local.set $b (f64.add (f64.add (f64.mul (local.get $opx) (local.get $dx))
+                                    (f64.mul (local.get $opy) (local.get $dy)))
+                           (f64.mul (local.get $opz) (local.get $dz))))
+    (local.set $det
+      (f64.add
+        (f64.sub (f64.mul (local.get $b) (local.get $b))
+                 (f64.add (f64.add (f64.mul (local.get $opx) (local.get $opx))
+                                   (f64.mul (local.get $opy) (local.get $opy)))
+                          (f64.mul (local.get $opz) (local.get $opz))))
+        (f64.mul (local.get $rad) (local.get $rad))))
+    (if (f64.lt (local.get $det) (f64.const 0)) (then (return (f64.const 0))))
+    (local.set $det (f64.sqrt (local.get $det)))
+    (local.set $t (f64.sub (local.get $b) (local.get $det)))
+    (if (f64.gt (local.get $t) (f64.const 1e-4)) (then (return (local.get $t))))
+    (local.set $t (f64.add (local.get $b) (local.get $det)))
+    (if (f64.gt (local.get $t) (f64.const 1e-4)) (then (return (local.get $t))))
+    (f64.const 0))
+
+  ;; Nearest hit: (t, sphere index) with index -1 on miss.
+  (func $intersect (param $ox f64) (param $oy f64) (param $oz f64)
+                   (param $dx f64) (param $dy f64) (param $dz f64) (result f64 i32)
+    (local $t f64) (local $id i32) (local $i i32) (local $dist f64)
+    (local.set $t (f64.const 1e20))
+    (local.set $id (i32.const -1))
+    (loop $spheres
+      (local.set $dist (call $sphere_hit (local.get $i) (local.get $ox) (local.get $oy) (local.get $oz)
+                                         (local.get $dx) (local.get $dy) (local.get $dz)))
+      (if (f64.ne (local.get $dist) (f64.const 0))
+        (then (if (f64.lt (local.get $dist) (local.get $t))
+          (then (local.set $t (local.get $dist))
+                (local.set $id (local.get $i))))))
+      (local.set $i (i32.add (local.get $i) (i32.const 1)))
+      (br_if $spheres (i32.lt_s (local.get $i) (i32.const 9))))
+    (local.get $t)
+    (local.get $id))
+
+  (func $radiance (param $ox f64) (param $oy f64) (param $oz f64)
+                  (param $dx f64) (param $dy f64) (param $dz f64) (result f64 f64 f64)
+    (local $ax f64) (local $ay f64) (local $az f64)   ;; accumulated radiance
+    (local $tx f64) (local $ty f64) (local $tz f64)   ;; path throughput
+    (local $depth i32) (local $t f64) (local $id i32) (local $a i32)
+    (local $xx f64) (local $xy f64) (local $xz f64)   ;; hit point
+    (local $nx f64) (local $ny f64) (local $nz f64)   ;; surface normal
+    (local $lx f64) (local $ly f64) (local $lz f64)   ;; normal facing the ray
+    (local $fx f64) (local $fy f64) (local $fz f64)   ;; surface color
+    (local $p f64) (local $refl f64) (local $inv f64) (local $k f64)
+    (local $r1 f64) (local $r2 f64) (local $r2s f64)
+    (local $ux f64) (local $uy f64) (local $uz f64)
+    (local $vx f64) (local $vy f64) (local $vz f64)
+    (local $c f64) (local $s f64) (local $q f64)
+    (local $rx f64) (local $ry f64) (local $rz f64)   ;; mirror direction
+    (local $into i32) (local $nnt f64) (local $ddn f64) (local $cos2t f64)
+    (local $gx f64) (local $gy f64) (local $gz f64)   ;; refracted direction
+    (local $re f64) (local $pp f64)
+
+    (local.set $tx (f64.const 1))
+    (local.set $ty (f64.const 1))
+    (local.set $tz (f64.const 1))
+    (loop $bounce
+      (call $intersect (local.get $ox) (local.get $oy) (local.get $oz)
+                       (local.get $dx) (local.get $dy) (local.get $dz))
+      local.set $id
+      local.set $t
+      (if (i32.lt_s (local.get $id) (i32.const 0))
+        (then (return (local.get $ax) (local.get $ay) (local.get $az))))
+      (local.set $a (i32.mul (local.get $id) (i32.const 88)))
+
+      ;; x = o + d*t
+      (local.set $xx (f64.add (local.get $ox) (f64.mul (local.get $dx) (local.get $t))))
+      (local.set $xy (f64.add (local.get $oy) (f64.mul (local.get $dy) (local.get $t))))
+      (local.set $xz (f64.add (local.get $oz) (f64.mul (local.get $dz) (local.get $t))))
+      ;; n = (x - obj.p).norm()
+      (local.set $nx (f64.sub (local.get $xx) (f64.load offset=8 (local.get $a))))
+      (local.set $ny (f64.sub (local.get $xy) (f64.load offset=16 (local.get $a))))
+      (local.set $nz (f64.sub (local.get $xz) (f64.load offset=24 (local.get $a))))
+      (local.set $inv (f64.div (f64.const 1) (f64.sqrt
+        (f64.add (f64.add (f64.mul (local.get $nx) (local.get $nx))
+                          (f64.mul (local.get $ny) (local.get $ny)))
+                 (f64.mul (local.get $nz) (local.get $nz))))))
+      (local.set $nx (f64.mul (local.get $nx) (local.get $inv)))
+      (local.set $ny (f64.mul (local.get $ny) (local.get $inv)))
+      (local.set $nz (f64.mul (local.get $nz) (local.get $inv)))
+      ;; nl = n.dot(d) < 0 ? n : n * -1
+      (if (f64.lt (f64.add (f64.add (f64.mul (local.get $nx) (local.get $dx))
+                                    (f64.mul (local.get $ny) (local.get $dy)))
+                           (f64.mul (local.get $nz) (local.get $dz)))
+                  (f64.const 0))
+        (then (local.set $lx (local.get $nx))
+              (local.set $ly (local.get $ny))
+              (local.set $lz (local.get $nz)))
+        (else (local.set $lx (f64.mul (local.get $nx) (f64.const -1)))
+              (local.set $ly (f64.mul (local.get $ny) (f64.const -1)))
+              (local.set $lz (f64.mul (local.get $nz) (f64.const -1)))))
+      (local.set $fx (f64.load offset=56 (local.get $a)))
+      (local.set $fy (f64.load offset=64 (local.get $a)))
+      (local.set $fz (f64.load offset=72 (local.get $a)))
+      ;; p = max reflectance
+      (local.set $p
+        (if (result f64) (i32.and (f64.gt (local.get $fx) (local.get $fy))
+                                  (f64.gt (local.get $fx) (local.get $fz)))
+          (then (local.get $fx))
+          (else (if (result f64) (f64.gt (local.get $fy) (local.get $fz))
+            (then (local.get $fy))
+            (else (local.get $fz))))))
+      ;; acc = acc + thr.mult(obj.e)
+      (local.set $ax (f64.add (local.get $ax) (f64.mul (local.get $tx) (f64.load offset=32 (local.get $a)))))
+      (local.set $ay (f64.add (local.get $ay) (f64.mul (local.get $ty) (f64.load offset=40 (local.get $a)))))
+      (local.set $az (f64.add (local.get $az) (f64.mul (local.get $tz) (f64.load offset=48 (local.get $a)))))
+      ;; Russian roulette
+      (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
+      (if (i32.gt_s (local.get $depth) (i32.const 5))
+        (then
+          (if (i32.gt_s (local.get $depth) (i32.const 128))
+            (then (return (local.get $ax) (local.get $ay) (local.get $az))))
+          (if (i32.eqz (f64.lt (call $rnd) (local.get $p)))
+            (then (return (local.get $ax) (local.get $ay) (local.get $az))))
+          (local.set $inv (f64.div (f64.const 1) (local.get $p)))
+          (local.set $fx (f64.mul (local.get $fx) (local.get $inv)))
+          (local.set $fy (f64.mul (local.get $fy) (local.get $inv)))
+          (local.set $fz (f64.mul (local.get $fz) (local.get $inv)))))
+      (local.set $tx (f64.mul (local.get $tx) (local.get $fx)))
+      (local.set $ty (f64.mul (local.get $ty) (local.get $fy)))
+      (local.set $tz (f64.mul (local.get $tz) (local.get $fz)))
+      (local.set $ox (local.get $xx))
+      (local.set $oy (local.get $xy))
+      (local.set $oz (local.get $xz))
+      (local.set $refl (f64.load offset=80 (local.get $a)))
+
+      ;; Ideal DIFFUSE reflection
+      (if (f64.eq (local.get $refl) (f64.const 0))
+        (then
+          (local.set $r1 (f64.mul (f64.const 6.283185307179586) (call $rnd)))
+          (local.set $r2 (call $rnd))
+          (local.set $r2s (f64.sqrt (local.get $r2)))
+          ;; u = ((|w.x| > .1 ? (0,1,0) : (1,0,0)) % w).norm(), with w = nl
+          (if (f64.gt (f64.abs (local.get $lx)) (f64.const 0.1))
+            (then (local.set $ux (f64.sub (f64.mul (f64.const 1) (local.get $lz)) (f64.mul (f64.const 0) (local.get $ly))))
+                  (local.set $uy (f64.sub (f64.mul (f64.const 0) (local.get $lx)) (f64.mul (f64.const 0) (local.get $lz))))
+                  (local.set $uz (f64.sub (f64.mul (f64.const 0) (local.get $ly)) (f64.mul (f64.const 1) (local.get $lx)))))
+            (else (local.set $ux (f64.sub (f64.mul (f64.const 0) (local.get $lz)) (f64.mul (f64.const 0) (local.get $ly))))
+                  (local.set $uy (f64.sub (f64.mul (f64.const 0) (local.get $lx)) (f64.mul (f64.const 1) (local.get $lz))))
+                  (local.set $uz (f64.sub (f64.mul (f64.const 1) (local.get $ly)) (f64.mul (f64.const 0) (local.get $lx))))))
+          (local.set $inv (f64.div (f64.const 1) (f64.sqrt
+            (f64.add (f64.add (f64.mul (local.get $ux) (local.get $ux))
+                              (f64.mul (local.get $uy) (local.get $uy)))
+                     (f64.mul (local.get $uz) (local.get $uz))))))
+          (local.set $ux (f64.mul (local.get $ux) (local.get $inv)))
+          (local.set $uy (f64.mul (local.get $uy) (local.get $inv)))
+          (local.set $uz (f64.mul (local.get $uz) (local.get $inv)))
+          ;; v = w % u
+          (local.set $vx (f64.sub (f64.mul (local.get $ly) (local.get $uz)) (f64.mul (local.get $lz) (local.get $uy))))
+          (local.set $vy (f64.sub (f64.mul (local.get $lz) (local.get $ux)) (f64.mul (local.get $lx) (local.get $uz))))
+          (local.set $vz (f64.sub (f64.mul (local.get $lx) (local.get $uy)) (f64.mul (local.get $ly) (local.get $ux))))
+          (local.set $c (f64.mul (call $cos (local.get $r1)) (local.get $r2s)))
+          (local.set $s (f64.mul (call $sin (local.get $r1)) (local.get $r2s)))
+          (local.set $q (f64.sqrt (f64.sub (f64.const 1) (local.get $r2))))
+          ;; d = (u*c + v*s + w*q).norm()
+          (local.set $dx (f64.add (f64.add (f64.mul (local.get $ux) (local.get $c)) (f64.mul (local.get $vx) (local.get $s)))
+                                  (f64.mul (local.get $lx) (local.get $q))))
+          (local.set $dy (f64.add (f64.add (f64.mul (local.get $uy) (local.get $c)) (f64.mul (local.get $vy) (local.get $s)))
+                                  (f64.mul (local.get $ly) (local.get $q))))
+          (local.set $dz (f64.add (f64.add (f64.mul (local.get $uz) (local.get $c)) (f64.mul (local.get $vz) (local.get $s)))
+                                  (f64.mul (local.get $lz) (local.get $q))))
+          (local.set $inv (f64.div (f64.const 1) (f64.sqrt
+            (f64.add (f64.add (f64.mul (local.get $dx) (local.get $dx))
+                              (f64.mul (local.get $dy) (local.get $dy)))
+                     (f64.mul (local.get $dz) (local.get $dz))))))
+          (local.set $dx (f64.mul (local.get $dx) (local.get $inv)))
+          (local.set $dy (f64.mul (local.get $dy) (local.get $inv)))
+          (local.set $dz (f64.mul (local.get $dz) (local.get $inv)))
+          (br $bounce)))
+
+      ;; rdir = d - n * (2 * n.dot(d))
+      (local.set $k (f64.mul (f64.const 2)
+        (f64.add (f64.add (f64.mul (local.get $nx) (local.get $dx))
+                          (f64.mul (local.get $ny) (local.get $dy)))
+                 (f64.mul (local.get $nz) (local.get $dz)))))
+      (local.set $rx (f64.sub (local.get $dx) (f64.mul (local.get $nx) (local.get $k))))
+      (local.set $ry (f64.sub (local.get $dy) (f64.mul (local.get $ny) (local.get $k))))
+      (local.set $rz (f64.sub (local.get $dz) (f64.mul (local.get $nz) (local.get $k))))
+
+      ;; Ideal SPECULAR reflection
+      (if (f64.eq (local.get $refl) (f64.const 1))
+        (then
+          (local.set $dx (local.get $rx))
+          (local.set $dy (local.get $ry))
+          (local.set $dz (local.get $rz))
+          (br $bounce)))
+
+      ;; Ideal dielectric REFRACTION
+      (local.set $into (f64.gt
+        (f64.add (f64.add (f64.mul (local.get $nx) (local.get $lx))
+                          (f64.mul (local.get $ny) (local.get $ly)))
+                 (f64.mul (local.get $nz) (local.get $lz)))
+        (f64.const 0)))
+      (local.set $nnt (if (result f64) (local.get $into)
+        (then (f64.const 0.6666666666666666))
+        (else (f64.const 1.5))))
+      (local.set $ddn
+        (f64.add (f64.add (f64.mul (local.get $dx) (local.get $lx))
+                          (f64.mul (local.get $dy) (local.get $ly)))
+                 (f64.mul (local.get $dz) (local.get $lz))))
+      (local.set $cos2t (f64.sub (f64.const 1)
+        (f64.mul (f64.mul (local.get $nnt) (local.get $nnt))
+                 (f64.sub (f64.const 1) (f64.mul (local.get $ddn) (local.get $ddn))))))
+      (if (f64.lt (local.get $cos2t) (f64.const 0))   ;; total internal reflection
+        (then
+          (local.set $dx (local.get $rx))
+          (local.set $dy (local.get $ry))
+          (local.set $dz (local.get $rz))
+          (br $bounce)))
+      ;; tdir = (d*nnt - n*((into ? 1 : -1) * (ddn*nnt + sqrt(cos2t)))).norm()
+      (local.set $k (f64.mul
+        (if (result f64) (local.get $into) (then (f64.const 1)) (else (f64.const -1)))
+        (f64.add (f64.mul (local.get $ddn) (local.get $nnt)) (f64.sqrt (local.get $cos2t)))))
+      (local.set $gx (f64.sub (f64.mul (local.get $dx) (local.get $nnt)) (f64.mul (local.get $nx) (local.get $k))))
+      (local.set $gy (f64.sub (f64.mul (local.get $dy) (local.get $nnt)) (f64.mul (local.get $ny) (local.get $k))))
+      (local.set $gz (f64.sub (f64.mul (local.get $dz) (local.get $nnt)) (f64.mul (local.get $nz) (local.get $k))))
+      (local.set $inv (f64.div (f64.const 1) (f64.sqrt
+        (f64.add (f64.add (f64.mul (local.get $gx) (local.get $gx))
+                          (f64.mul (local.get $gy) (local.get $gy)))
+                 (f64.mul (local.get $gz) (local.get $gz))))))
+      (local.set $gx (f64.mul (local.get $gx) (local.get $inv)))
+      (local.set $gy (f64.mul (local.get $gy) (local.get $inv)))
+      (local.set $gz (f64.mul (local.get $gz) (local.get $inv)))
+      ;; c = 1 - (into ? -ddn : tdir.dot(n))
+      (local.set $c (f64.sub (f64.const 1)
+        (if (result f64) (local.get $into)
+          (then (f64.neg (local.get $ddn)))
+          (else (f64.add (f64.add (f64.mul (local.get $gx) (local.get $nx))
+                                  (f64.mul (local.get $gy) (local.get $ny)))
+                         (f64.mul (local.get $gz) (local.get $nz)))))))
+      ;; Re = R0 + (1-R0)*c^5 with R0 = .04; P = .25 + .5*Re
+      (local.set $re (f64.add (f64.const 0.04)
+        (f64.mul (f64.mul (f64.mul (f64.mul (f64.mul (f64.const 0.96) (local.get $c))
+                                            (local.get $c)) (local.get $c)) (local.get $c)) (local.get $c))))
+      (local.set $pp (f64.add (f64.const 0.25) (f64.mul (f64.const 0.5) (local.get $re))))
+      (if (f64.lt (call $rnd) (local.get $pp))
+        (then   ;; reflect, weight RP = Re/P
+          (local.set $k (f64.div (local.get $re) (local.get $pp)))
+          (local.set $dx (local.get $rx))
+          (local.set $dy (local.get $ry))
+          (local.set $dz (local.get $rz)))
+        (else   ;; refract, weight TP = Tr/(1-P)
+          (local.set $k (f64.div (f64.sub (f64.const 1) (local.get $re))
+                                 (f64.sub (f64.const 1) (local.get $pp))))
+          (local.set $dx (local.get $gx))
+          (local.set $dy (local.get $gy))
+          (local.set $dz (local.get $gz))))
+      (local.set $tx (f64.mul (local.get $tx) (local.get $k)))
+      (local.set $ty (f64.mul (local.get $ty) (local.get $k)))
+      (local.set $tz (f64.mul (local.get $tz) (local.get $k)))
+      (br $bounce))
+    unreachable)
+
+  ;; Set the image size (max 640x480) and clear the accumulation buffer.
+  (func (export "init") (param $w i32) (param $h i32)
+    (local $i i32) (local $end i32)
+    (global.set $W (if (result i32) (i32.lt_s (local.get $w) (i32.const 1)) (then (i32.const 1))
+      (else (if (result i32) (i32.gt_s (local.get $w) (i32.const 640)) (then (i32.const 640)) (else (local.get $w))))))
+    (global.set $H (if (result i32) (i32.lt_s (local.get $h) (i32.const 1)) (then (i32.const 1))
+      (else (if (result i32) (i32.gt_s (local.get $h) (i32.const 480)) (then (i32.const 480)) (else (local.get $h))))))
+    (local.set $i (i32.const 1024))
+    (local.set $end (i32.add (i32.const 1024)
+      (i32.mul (i32.mul (global.get $W) (global.get $H)) (i32.const 24))))
+    (block $done
+      (loop $clear
+        (br_if $done (i32.ge_u (local.get $i) (local.get $end)))
+        (f64.store (local.get $i) (f64.const 0))
+        (local.set $i (i32.add (local.get $i) (i32.const 8)))
+        (br $clear)))
+    (global.set $passes (i32.const 0)))
+
+  (func (export "set_color") (param $i i32) (param $r f64) (param $g f64) (param $b f64)
+    (local $a i32)
+    (if (i32.and (i32.ge_s (local.get $i) (i32.const 0)) (i32.lt_s (local.get $i) (i32.const 9)))
+      (then
+        (local.set $a (i32.mul (local.get $i) (i32.const 88)))
+        (f64.store offset=56 (local.get $a) (local.get $r))
+        (f64.store offset=64 (local.get $a) (local.get $g))
+        (f64.store offset=72 (local.get $a) (local.get $b)))))
+
+  (func (export "get_passes") (result i32)
+    (global.get $passes))
+
+  ;; Add one sample per 2x2 sub-pixel to every pixel.
+  (func (export "render_pass") (param $seed i32)
+    (local $x i32) (local $y i32) (local $sx i32) (local $sy i32) (local $acc i32)
+    (local $fw f64) (local $fh f64) (local $inv f64)
+    (local $cdx f64) (local $cdy f64) (local $cdz f64)   ;; camera direction
+    (local $cxx f64) (local $cxy f64) (local $cxz f64)   ;; image plane x axis
+    (local $cyx f64) (local $cyy f64) (local $cyz f64)   ;; image plane y axis
+    (local $r1 f64) (local $r2 f64) (local $ddx f64) (local $ddy f64)
+    (local $u f64) (local $v f64) (local $dx f64) (local $dy f64) (local $dz f64)
+    (local $rx f64) (local $ry f64) (local $rz f64)
