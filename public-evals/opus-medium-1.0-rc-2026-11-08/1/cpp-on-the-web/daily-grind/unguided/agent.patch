+#!/usr/bin/env node
+// Minimal WebAssembly text -> binary assembler. Supports the subset of WAT used by
+// wasm/smallpt.wat: imports, memory, globals, functions (named params/locals,
+// multi-value results), exports, start, folded and flat instructions, and
+// structured control flow (block / loop / if-then-else).
+//
+// Usage: node tools/wat2wasm.mjs input.wat output.wasm
+import { readFileSync, writeFileSync } from 'node:fs';
+
+// ---------- s-expression parser ----------
+function parse(src) {
+  const tokens = [];
+  const re = /\s+|;;[^\n]*|\(;[\s\S]*?;\)|(\()|(\))|("(?:[^"\\]|\\.)*")|([^\s()";]+)/gy;
+  let m;
+  while (re.lastIndex < src.length) {
+    const at = re.lastIndex;
+    if (!(m = re.exec(src))) throw new Error(`Unexpected input at ${at}: ${src.slice(at, at + 20)}`);
+    if (m[1]) tokens.push('(');
+    else if (m[2]) tokens.push(')');
+    else if (m[3]) tokens.push({ str: JSON.parse(m[3]) });
+    else if (m[4]) tokens.push(m[4]);
+  }
+  let i = 0;
+  const read = () => {
+    const t = tokens[i++];
+    if (t !== '(') return t;
+    const list = [];
+    while (tokens[i] !== ')') {
+      if (i >= tokens.length) throw new Error('Unbalanced parentheses');
+      list.push(read());
+    }
+    i++;
+    return list;
+  };
+  return read();
+}
+
+// ---------- binary encoding helpers ----------
+const uleb = (n) => {
+  const out = [];
+  do {
+    let b = n & 0x7f;
+    n >>>= 7;
+    if (n) b |= 0x80;
+    out.push(b);
+  } while (n);
+  return out;
+};
+const sleb = (n) => {
+  const out = [];
+  n |= 0;
+  for (;;) {
+    const b = n & 0x7f;
+    n >>= 7;
+    if ((n === 0 && !(b & 0x40)) || (n === -1 && b & 0x40)) { out.push(b); return out; }
+    out.push(b | 0x80);
+  }
+};
+const f64 = (x) => [...new Uint8Array(new Float64Array([x]).buffer)];
+const str = (s) => { const b = [...Buffer.from(s, 'utf8')]; return [...uleb(b.length), ...b]; };
+const vec = (items) => [...uleb(items.length), ...items.flat()];
+const section = (id, bytes) => (bytes ? [id, ...uleb(bytes.length), ...bytes] : []);
+
+const VALTYPE = { i32: 0x7f, i64: 0x7e, f32: 0x7d, f64: 0x7c };
+
+// op name -> [opcode bytes, immediate kind]
+const OPS = {
+  unreachable: [[0x00]], nop: [[0x01]], return: [[0x0f]], drop: [[0x1a]], select: [[0x1b]],
+  br: [[0x0c], 'label'], br_if: [[0x0d], 'label'], call: [[0x10], 'func'],
+  'local.get': [[0x20], 'local'], 'local.set': [[0x21], 'local'], 'local.tee': [[0x22], 'local'],
+  'global.get': [[0x23], 'global'], 'global.set': [[0x24], 'global'],
+  'i32.load': [[0x28], 'mem2'], 'f64.load': [[0x2b], 'mem3'], 'i32.load8_u': [[0x2d], 'mem0'],
+  'i32.store': [[0x36], 'mem2'], 'f64.store': [[0x39], 'mem3'], 'i32.store8': [[0x3a], 'mem0'],
+  'i32.const': [[0x41], 'i32'], 'f64.const': [[0x44], 'f64'],
+  'i32.eqz': [[0x45]], 'i32.eq': [[0x46]], 'i32.ne': [[0x47]], 'i32.lt_s': [[0x48]], 'i32.lt_u': [[0x49]],
+  'i32.gt_s': [[0x4a]], 'i32.gt_u': [[0x4b]], 'i32.le_s': [[0x4c]], 'i32.le_u': [[0x4d]],
+  'i32.ge_s': [[0x4e]], 'i32.ge_u': [[0x4f]],
+  'f64.eq': [[0x61]], 'f64.ne': [[0x62]], 'f64.lt': [[0x63]], 'f64.gt': [[0x64]], 'f64.le': [[0x65]], 'f64.ge': [[0x66]],
+  'i32.add': [[0x6a]], 'i32.sub': [[0x6b]], 'i32.mul': [[0x6c]], 'i32.div_s': [[0x6d]], 'i32.div_u': [[0x6e]],
+  'i32.rem_s': [[0x6f]], 'i32.rem_u': [[0x70]], 'i32.and': [[0x71]], 'i32.or': [[0x72]], 'i32.xor': [[0x73]],
+  'i32.shl': [[0x74]], 'i32.shr_s': [[0x75]], 'i32.shr_u': [[0x76]],
+  'f64.abs': [[0x99]], 'f64.neg': [[0x9a]], 'f64.ceil': [[0x9b]], 'f64.floor': [[0x9c]], 'f64.trunc': [[0x9d]],
+  'f64.nearest': [[0x9e]], 'f64.sqrt': [[0x9f]], 'f64.add': [[0xa0]], 'f64.sub': [[0xa1]], 'f64.mul': [[0xa2]],
+  'f64.div': [[0xa3]], 'f64.min': [[0xa4]], 'f64.max': [[0xa5]],
+  'i32.trunc_f64_s': [[0xaa]], 'i32.trunc_f64_u': [[0xab]],
+  'f64.convert_i32_s': [[0xb7]], 'f64.convert_i32_u': [[0xb8]],
+};
+
+const isName = (x) => typeof x === 'string' && x[0] === '$';
+const head = (x) => (Array.isArray(x) ? x[0] : undefined);
+
+function parseI32(s) {
+  const n = Number(s.replace(/_/g, ''));
+  if (!Number.isInteger(n) || n < -0x80000000 || n > 0xffffffff) throw new Error(`Bad i32 literal ${s}`);
+  return n | 0;
+}
+
+function assemble(mod) {
+  if (head(mod) !== 'module') throw new Error('Expected (module ...)');
+  const fields = mod.slice(1);
+
+  const types = [];          // encoded func types (as strings for dedupe)
+  const typeIndex = (params, results) => {
+    const key = JSON.stringify([params, results]);
+    let i = types.findIndex((t) => t.key === key);
+    if (i < 0) { i = types.length; types.push({ key, params, results }); }
+    return i;
+  };
+  const funcNames = new Map();
+  const globalNames = new Map();
+  const imports = [];
+  const funcs = [];
+  const globals = [];
+  const exports = [];
+  let memory = null;
+  let start = null;
+
+  const parseSig = (items) => {
+    const params = [], paramNames = [], results = [];
+    let rest = 0;
+    for (const it of items) {
+      if (head(it) === 'param') {
+        if (isName(it[1])) { paramNames.push(it[1]); params.push(it[2]); }
+        else for (const t of it.slice(1)) { paramNames.push(null); params.push(t); }
+      } else if (head(it) === 'result') results.push(...it.slice(1));
+      else break;
+      rest++;
+    }
+    return { params, paramNames, results, rest };
+  };
+
+  // Pass 1: collect declarations so that names resolve regardless of order.
+  for (const f of fields) {
+    const kind = head(f);
+    if (kind === 'import') {
+      const [, modName, name, desc] = f;
+      if (head(desc) !== 'func') throw new Error('Only function imports are supported');
+      let rest = desc.slice(1);
+      const id = isName(rest[0]) ? rest.shift() : null;
+      const sig = parseSig(rest);
+      if (id) funcNames.set(id, imports.length);
+      imports.push({ mod: modName.str, name: name.str, type: typeIndex(sig.params, sig.results) });
+    }
+  }
+  for (const f of fields) {
+    const kind = head(f);
+    if (kind === 'func') {
+      let rest = f.slice(1);
+      const id = isName(rest[0]) ? rest.shift() : null;
+      const exportNames = [];
+      while (head(rest[0]) === 'export') exportNames.push(rest.shift()[1].str);
+      const sig = parseSig(rest);
+      rest = rest.slice(sig.rest);
+      const localNames = [...sig.paramNames], localTypes = [];
+      while (head(rest[0]) === 'local') {
+        const l = rest.shift();
+        if (isName(l[1])) { localNames.push(l[1]); localTypes.push(l[2]); }
+        else for (const t of l.slice(1)) { localNames.push(null); localTypes.push(t); }
+      }
+      const index = imports.length + funcs.length;
+      if (id) funcNames.set(id, index);
+      for (const e of exportNames) exports.push({ name: e, kind: 0, index });
+      funcs.push({ id, type: typeIndex(sig.params, sig.results), sig, localNames, localTypes, body: rest });
+    } else if (kind === 'global') {
+      let rest = f.slice(1);
+      const id = isName(rest[0]) ? rest.shift() : null;
+      const exportNames = [];
+      while (head(rest[0]) === 'export') exportNames.push(rest.shift()[1].str);
+      const t = rest.shift();
+      const mutable = head(t) === 'mut';
+      const index = globals.length;
+      if (id) globalNames.set(id, index);
+      for (const e of exportNames) exports.push({ name: e, kind: 3, index });
+      globals.push({ type: mutable ? t[1] : t, mutable, init: rest });
+    } else if (kind === 'memory') {
+      let rest = f.slice(1);
+      if (isName(rest[0])) rest.shift();
+      while (head(rest[0]) === 'export') exports.push({ name: rest.shift()[1].str, kind: 2, index: 0 });
+      memory = rest.map(Number);
+    } else if (kind === 'export') {
+      const [, name, [k, ref]] = f;
+      if (k !== 'func') throw new Error('Only func exports supported in (export ...)');
+      exports.push({ name: name.str, kind: 0, ref });
+    } else if (kind === 'start') {
+      start = f[1];
+    } else if (kind !== 'import') {
+      throw new Error(`Unsupported module field ${kind}`);
+    }
+  }
+
+  const resolve = (map, ref, what) => {
+    if (isName(ref)) {
+      if (!map.has(ref)) throw new Error(`Unknown ${what} ${ref}`);
+      return map.get(ref);
+    }
+    return parseI32(ref);
+  };
+
+  // Pass 2: encode function bodies.
+  function compileBody(fn) {
+    const out = [];
+    const labels = []; // innermost last
+    const localIndex = (ref) => {
+      if (isName(ref)) {
+        const i = fn.localNames.indexOf(ref);
+        if (i < 0) throw new Error(`Unknown local ${ref} in ${fn.id}`);
+        return i;
+      }
+      return parseI32(ref);
+    };
+    const labelDepth = (ref) => {
+      if (isName(ref)) {
+        const i = labels.lastIndexOf(ref);
+        if (i < 0) throw new Error(`Unknown label ${ref} in ${fn.id}`);
+        return labels.length - 1 - i;
+      }
+      return parseI32(ref);
+    };
+    const blockType = (items) => {
+      if (head(items[0]) === 'result') {
+        const r = items.shift().slice(1);
+        if (r.length === 1) return [VALTYPE[r[0]]];
+        if (r.length === 0) return [0x40];
+        return sleb(typeIndex([], r));
+      }
+      return [0x40];
+    };
+    const immediate = (kind, args) => {
+      switch (kind) {
+        case 'label': return uleb(labelDepth(args.shift()));
+        case 'func': return uleb(resolve(funcNames, args.shift(), 'function'));
+        case 'local': return uleb(localIndex(args.shift()));
+        case 'global': return uleb(resolve(globalNames, args.shift(), 'global'));
+        case 'i32': return sleb(parseI32(args.shift()));
+        case 'f64': return f64(parseFloat(args.shift()));
+        case 'mem0': case 'mem2': case 'mem3': {
+          let align = Number(kind[3]), offset = 0;
+          while (typeof args[0] === 'string' && /^(offset|align)=/.test(args[0])) {
+            const [k, v] = args.shift().split('=');
+            if (k === 'offset') offset = Number(v);
+            else align = Math.log2(Number(v));
+          }
+          return [...uleb(align), ...uleb(offset)];
+        }
+        default: return [];
+      }
+    };
+
+    // Compile a sequence of instructions (atoms = flat, lists = folded).
+    const seq = (items) => {
+      items = [...items];
+      while (items.length) {
+        const it = items.shift();
+        if (Array.isArray(it)) { folded(it); continue; }
+        if (it === 'block' || it === 'loop' || it === 'if' || it === 'else' || it === 'end') {
+          throw new Error(`Flat structured instruction '${it}' not supported; use folded form`);
+        }
+        const op = OPS[it];
+        if (!op) throw new Error(`Unknown instruction ${it} in ${fn.id}`);
+        out.push(...op[0], ...immediate(op[1], items));
+      }
+    };
+    const folded = (expr) => {
+      const [op, ...rest] = expr;
+      if (op === 'block' || op === 'loop') {
+        const label = isName(rest[0]) ? rest.shift() : null;
+        const bt = blockType(rest);
+        out.push(op === 'block' ? 0x02 : 0x03, ...bt);
+        labels.push(label);
+        seq(rest);
+        labels.pop();
+        out.push(0x0b);
+        return;
+      }
+      if (op === 'if') {
+        const label = isName(rest[0]) ? rest.shift() : null;
+        const bt = blockType(rest);
+        const thenIdx = rest.findIndex((x) => head(x) === 'then');
+        if (thenIdx < 0) throw new Error(`(if) without (then) in ${fn.id}`);
+        seq(rest.slice(0, thenIdx));
+        out.push(0x04, ...bt);
+        labels.push(label);
+        seq(rest[thenIdx].slice(1));
+        const els = rest[thenIdx + 1];
+        if (els) {
+          if (head(els) !== 'else') throw new Error(`Expected (else) in ${fn.id}`);
+          out.push(0x05);
+          seq(els.slice(1));
+        }
+        labels.pop();
+        out.push(0x0b);
+        return;
+      }
+      const def = OPS[op];
+      if (!def) throw new Error(`Unknown instruction ${op} in ${fn.id}`);
+      const args = [...rest];
+      const imm = immediate(def[1], args);
+      seq(args.filter(Array.isArray));
+      if (args.some((a) => !Array.isArray(a))) throw new Error(`Unexpected operand in (${op} ...) in ${fn.id}`);
+      out.push(...def[0], ...imm);
+    };
+
+    seq(fn.body);
+    out.push(0x0b);
+
+    // Run-length encode local declarations.
+    const decls = [];
+    for (const t of fn.localTypes) {
+      const last = decls[decls.length - 1];
+      if (last && last[1] === t) last[0]++;
+      else decls.push([1, t]);
+    }
+    const body = [...vec(decls.map(([n, t]) => [...uleb(n), VALTYPE[t]])), ...out];
+    return [...uleb(body.length), ...body];
+  }
+
+  const constExpr = (init) => {
+    const [op, val] = init[0];
+    if (op === 'i32.const') return [0x41, ...sleb(parseI32(val)), 0x0b];
+    if (op === 'f64.const') return [0x44, ...f64(parseFloat(val)), 0x0b];
+    throw new Error(`Unsupported global initializer ${op}`);
+  };
+
+  const code = funcs.map(compileBody); // may add multi-value block types
+  for (const e of exports) if (e.ref !== undefined) e.index = resolve(funcNames, e.ref, 'function');
+
+  const bytes = [
+    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
+    ...section(1, vec(types.map((t) => [0x60, ...vec(t.params.map((p) => [VALTYPE[p]])), ...vec(t.results.map((r) => [VALTYPE[r]]))]))),
+    ...section(2, imports.length && vec(imports.map((im) => [...str(im.mod), ...str(im.name), 0x00, ...uleb(im.type)]))),
+    ...section(3, funcs.length && vec(funcs.map((f) => uleb(f.type)))),
+    ...section(5, memory && vec([memory.length > 1 ? [0x01, ...uleb(memory[0]), ...uleb(memory[1])] : [0x00, ...uleb(memory[0])]])),
+    ...section(6, globals.length && vec(globals.map((g) => [VALTYPE[g.type], g.mutable ? 1 : 0, ...constExpr(g.init)]))),
+    ...section(7, exports.length && vec(exports.map((e) => [...str(e.name), e.kind, ...uleb(e.index)]))),
+    ...section(8, start && uleb(resolve(funcNames, start, 'function'))),
+    ...section(10, vec(code)),
+  ];
+  return new Uint8Array(bytes);
+}
+
+const [, , input, output] = process.argv;
+if (!input || !output) {
+  console.error('Usage: node tools/wat2wasm.mjs input.wat output.wasm');
+  process.exit(1);
+}
+const wasm = assemble(parse(readFileSync(input, 'utf8')));
+if (!WebAssembly.validate(wasm)) {
+  // Compile anyway to surface the engine's error message.
+  new WebAssembly.Module(wasm);
+}
+writeFileSync(output, wasm);
+console.log(`Wrote ${output} (${wasm.length} bytes)`);
diff --git a/wasm/smallpt.cpp b/wasm/smallpt.cpp
new file mode 100644
index 0000000..8db179f
--- /dev/null
+++ b/wasm/smallpt.cpp
@@ -0,0 +1,175 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008 (http://www.kevinbeason.com/smallpt/)
+// MIT licensed. Adapted for WebAssembly:
+//  - no stdio / stdlib / OpenMP; output is an RGBA buffer in linear memory
+//  - progressive rendering: each render_pass() adds one sample per sub-pixel
+//    (4 per pixel) to an accumulation buffer; the running average is clamped
+//    and gamma-corrected by get_rgba()
+//  - radiance() is iterative (Russian roulette picks reflection vs refraction
+//    for glass at every depth), so it needs no deep native stack
+//  - erand48 replaced by a 32-bit xorshift so results are reproducible
+//  - sphere colors can be changed from JavaScript via set_color()
+//
+// Build: see build.sh (emcc -O3 -sSTANDALONE_WASM --no-entry ...)
+#include <math.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#define EXPORT extern "C" EMSCRIPTEN_KEEPALIVE
+#else
+#define EXPORT extern "C"
+#endif
+
+struct Vec {
+  double x, y, z;
+  Vec operator+(const Vec &b) const { return Vec{x + b.x, y + b.y, z + b.z}; }
+  Vec operator-(const Vec &b) const { return Vec{x - b.x, y - b.y, z - b.z}; }
+  Vec operator*(double b) const { return Vec{x * b, y * b, z * b}; }
+  Vec mult(const Vec &b) const { return Vec{x * b.x, y * b.y, z * b.z}; }
+  Vec norm() const { return *this * (1 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const { return Vec{y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x}; }
+};
+enum Refl_t { DIFF, SPEC, REFR };
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  double intersect(const Vec &o, const Vec &d) const {
+    Vec op = p - o;
+    double t, eps = 1e-4, b = op.dot(d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static const int NUM_SPHERES = 9;
+static Sphere spheres[NUM_SPHERES] = {
+  {1e5,  {1e5 + 1, 40.8, 81.6},    {},           {.75, .25, .25}, DIFF}, // Left
+  {1e5,  {-1e5 + 99, 40.8, 81.6},  {},           {.25, .25, .75}, DIFF}, // Rght
+  {1e5,  {50, 40.8, 1e5},          {},           {.75, .75, .75}, DIFF}, // Back
+  {1e5,  {50, 40.8, -1e5 + 170},   {},           {},              DIFF}, // Frnt
+  {1e5,  {50, 1e5, 81.6},          {},           {.75, .75, .75}, DIFF}, // Botm
+  {1e5,  {50, -1e5 + 81.6, 81.6},  {},           {.75, .75, .75}, DIFF}, // Top
+  {16.5, {27, 16.5, 47},           {},           {.999, .999, .999}, SPEC}, // Mirr
+  {16.5, {73, 16.5, 78},           {},           {.999, .999, .999}, REFR}, // Glas
+  {600,  {50, 681.6 - .27, 81.6},  {12, 12, 12}, {},              DIFF}, // Lite
+};
+
+static unsigned rng = 1;
+static inline double rnd() {
+  unsigned x = rng;
+  x ^= x << 13;
+  x ^= x >> 17;
+  x ^= x << 5;
+  rng = x;
+  return x * (1.0 / 4294967296.0);
+}
+
+static inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+
+static inline int intersect(const Vec &o, const Vec &d, double &t) {
+  double inf = t = 1e20;
+  int id = -1;
+  for (int i = 0; i < NUM_SPHERES; i++) {
+    double dist = spheres[i].intersect(o, d);
+    if (dist != 0 && dist < t) { t = dist; id = i; }
+  }
+  return t < inf ? id : -1;
+}
+
+static Vec radiance(Vec o, Vec d) {
+  Vec acc{0, 0, 0}, thr{1, 1, 1};
+  int depth = 0;
+  for (;;) {
+    double t;
+    int id = intersect(o, d, t);
+    if (id < 0) return acc;                    // if miss, return black
+    const Sphere &obj = spheres[id];           // the hit object
+    Vec x = o + d * t, n = (x - obj.p).norm(), nl = n.dot(d) < 0 ? n : n * -1, f = obj.c;
+    double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z; // max refl
+    acc = acc + thr.mult(obj.e);
+    if (++depth > 5) {
+      if (depth > 128 || !(rnd() < p)) return acc; // R.R.
+      f = f * (1 / p);
+    }
+    thr = thr.mult(f);
+    o = x;
+    if (obj.refl == DIFF) {                    // Ideal DIFFUSE reflection
+      double r1 = 2 * M_PI * rnd(), r2 = rnd(), r2s = sqrt(r2);
+      Vec w = nl, u = ((fabs(w.x) > .1 ? Vec{0, 1, 0} : Vec{1, 0, 0}) % w).norm(), v = w % u;
+      double c = cos(r1) * r2s, s = sin(r1) * r2s, q = sqrt(1 - r2);
+      d = (u * c + v * s + w * q).norm();
+      continue;
+    }
+    Vec rdir = d - n * (2 * n.dot(d));
+    if (obj.refl == SPEC) {                    // Ideal SPECULAR reflection
+      d = rdir;
+      continue;
+    }
+    bool into = n.dot(nl) > 0;                 // Ray from outside going in?
+    double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = d.dot(nl), cos2t;
+    if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0) { // Total internal reflection
+      d = rdir;
+      continue;
+    }
+    Vec tdir = (d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1 - P);
+    if (rnd() < P) { thr = thr * RP; d = rdir; }
+    else           { thr = thr * TP; d = tdir; }
+  }
+}
+
+static const int MAX_W = 640, MAX_H = 480;
+static Vec accum[MAX_W * MAX_H];
+static unsigned char rgba[MAX_W * MAX_H * 4];
+static int W = 0, H = 0, passes = 0;
+
+// Set the image size and clear the accumulation buffer.
+EXPORT void init(int w, int h) {
+  W = w < 1 ? 1 : w > MAX_W ? MAX_W : w;
+  H = h < 1 ? 1 : h > MAX_H ? MAX_H : h;
+  for (int i = 0; i < W * H; i++) accum[i] = Vec{0, 0, 0};
+  passes = 0;
+}
+
+EXPORT void set_color(int i, double r, double g, double b) {
+  if (i >= 0 && i < NUM_SPHERES) spheres[i].c = Vec{r, g, b};
+}
+
+EXPORT int get_passes() { return passes; }
+
+// Add one sample per 2x2 sub-pixel to every pixel.
+EXPORT void render_pass(unsigned seed) {
+  rng = seed ? seed : 1;
+  Vec camo{50, 52, 295.6}, camd = Vec{0, -0.042612, -1}.norm();
+  Vec cx{W * .5135 / H, 0, 0}, cy = (cx % camd).norm() * .5135;
+  for (int y = 0; y < H; y++) {
+    for (int x = 0; x < W; x++) {
+      int i = (H - y - 1) * W + x;
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          double r1 = 2 * rnd(), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+          double r2 = 2 * rnd(), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+          Vec d = cx * (((sx + .5 + dx) / 2 + x) / W - .5) + cy * (((sy + .5 + dy) / 2 + y) / H - .5) + camd;
+          Vec r = radiance(camo + d * 140, d.norm());
+          accum[i] = accum[i] + r * .25; // clamped when displayed, not per sample
+        }
+      }
+    }
+  }
+  passes++;
+}
+
+// Gamma-correct the running average into an RGBA8 buffer (top row first).
+EXPORT unsigned char *get_rgba() {
+  double s = 1.0 / (passes ? passes : 1);
+  for (int i = 0; i < W * H; i++) {
+    rgba[i * 4 + 0] = (int)(pow(clamp(accum[i].x * s), 1 / 2.2) * 255 + .5);
+    rgba[i * 4 + 1] = (int)(pow(clamp(accum[i].y * s), 1 / 2.2) * 255 + .5);
+    rgba[i * 4 + 2] = (int)(pow(clamp(accum[i].z * s), 1 / 2.2) * 255 + .5);
+    rgba[i * 4 + 3] = 255;
+  }
+  return rgba;
+}
