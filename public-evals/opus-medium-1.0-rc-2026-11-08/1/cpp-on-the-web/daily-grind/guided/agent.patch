index 0000000..3022a01
--- /dev/null
+++ b/wasm/gen-smallpt-wasm.mjs
@@ -0,0 +1,391 @@
+// Emits smallpt.wasm without an Emscripten toolchain: a direct, line-by-line
+// translation of wasm/smallpt.cpp into WebAssembly bytecode. It exposes the
+// same exports as the em++ build (see wasm/build.sh), so either artifact works
+// with smallpt-worker.js.
+//
+// Usage: node wasm/gen-smallpt-wasm.mjs [out.wasm]
+import { writeFileSync } from 'node:fs';
+
+// ---------------------------------------------------------------------------
+// Binary encoding helpers
+const uleb = (n) => {
+  const out = [];
+  do {
+    let b = n & 0x7f;
+    n >>>= 7;
+    if (n) b |= 0x80;
+    out.push(b);
+  } while (n);
+  return out;
+};
+const sleb = (value) => {
+  let v = BigInt(value);
+  const out = [];
+  for (;;) {
+    const b = Number(v & 0x7fn);
+    v >>= 7n;
+    if ((v === 0n && !(b & 0x40)) || (v === -1n && b & 0x40)) {
+      out.push(b);
+      return out;
+    }
+    out.push(b | 0x80);
+  }
+};
+const c = (...parts) => parts.flat(Infinity);
+const name = (s) => [...uleb(s.length), ...Buffer.from(s, 'utf8')];
+const vec = (items) => [...uleb(items.length), ...items.flat(Infinity)];
+const section = (id, bytes) => [id, ...uleb(bytes.length), ...bytes];
+
+const T = { i32: 0x7f, i64: 0x7e, f64: 0x7c };
+
+// ---------------------------------------------------------------------------
+// Instructions (each helper returns a flat byte array)
+const f64 = (v) => {
+  const b = Buffer.alloc(8);
+  b.writeDoubleLE(v);
+  return [0x44, ...b];
+};
+const i32 = (v) => [0x41, ...sleb(v)];
+const i64 = (v) => [0x42, ...sleb(v)];
+const op = (...code) => (...args) => c(...args, ...code);
+
+const add = op(0xa0), sub = op(0xa1), mul = op(0xa2), div = op(0xa3);
+const sqrt = op(0x9f), abs = op(0x99), neg = op(0x9a);
+const eq = op(0x61), ne = op(0x62), lt = op(0x63), gt = op(0x64), ge = op(0x66);
+const iadd = op(0x6a), isub = op(0x6b), imul = op(0x6c), iand = op(0x71);
+const ilt = op(0x48), igt = op(0x4a), ige_u = op(0x4f), band = op(0x71);
+const ladd = op(0x7c), lmul = op(0x7e), land = op(0x83), lshl = op(0x86);
+const i64FromU32 = op(0xad), f64FromI32 = op(0xb7), f64FromU64 = op(0xba);
+const i32TruncSat = op(0xfc, 0x02);
+
+const load = (addr, offset) => c(addr, 0x2b, 0x03, uleb(offset));
+const store = (addr, offset, value) => c(addr, value, 0x39, 0x03, uleb(offset));
+const store8 = (addr, offset, value) => c(addr, value, 0x3a, 0x00, uleb(offset));
+const gget = (idx) => [0x23, ...uleb(idx)];
+const gset = (idx, value) => c(value, 0x24, uleb(idx));
+const ret = (...values) => c(...values, 0x0f);
+const if_ = (cond, then, els) => c(cond, 0x04, 0x40, then, els ? [0x05, els] : [], 0x0b);
+const ternary = (cond, a, b) => c(cond, 0x04, T.f64, a, 0x05, b, 0x0b);
+// while (cond) { body; step; }
+const loop = (cond, body, step = []) =>
+  c(0x02, 0x40, 0x03, 0x40, cond, 0x45, 0x0d, 1, body, step, 0x0c, 0, 0x0b, 0x0b);
+
+// Vector math on [x, y, z] triples of f64 expressions. Scalar operands are
+// re-evaluated per component, so only pass local reads / constants.
+const vadd = (a, b) => a.map((e, i) => add(e, b[i]));
+const vsub = (a, b) => a.map((e, i) => sub(e, b[i]));
+const vmult = (a, b) => a.map((e, i) => mul(e, b[i]));
+const vscale = (a, s) => a.map((e) => mul(e, s));
+const dot = (a, b) => add(add(mul(a[0], b[0]), mul(a[1], b[1])), mul(a[2], b[2]));
+const cross = (a, b) => [
+  sub(mul(a[1], b[2]), mul(a[2], b[1])),
+  sub(mul(a[2], b[0]), mul(a[0], b[2])),
+  sub(mul(a[0], b[1]), mul(a[1], b[0])),
+];
+const vconst = (x, y, z) => [f64(x), f64(y), f64(z)];
+const ZERO = vconst(0, 0, 0);
+
+// ---------------------------------------------------------------------------
+// Module layout
+const SPHERE_STRIDE = 88; // rad, p.xyz, e.xyz, c.xyz, refl (all f64)
+const OFF = { rad: 0, p: 8, e: 32, c: 56, refl: 80 };
+const SPHERES = 0;
+const DEFAULT_SPHERES = 1024;
+const IMAGE = 2048;
+const MAX_W = 640, MAX_H = 480;
+const PAGES = Math.ceil((IMAGE + MAX_W * MAX_H * 4) / 65536);
+
+const DIFF = 0, SPEC = 1, REFR = 2;
+const scene = [ // radius, position, emission, color, material
+  [1e5, [1e5 + 1, 40.8, 81.6], [0, 0, 0], [0.75, 0.25, 0.25], DIFF], // Left
+  [1e5, [-1e5 + 99, 40.8, 81.6], [0, 0, 0], [0.25, 0.25, 0.75], DIFF], // Rght
+  [1e5, [50, 40.8, 1e5], [0, 0, 0], [0.75, 0.75, 0.75], DIFF], // Back
+  [1e5, [50, 40.8, -1e5 + 170], [0, 0, 0], [0, 0, 0], DIFF], // Frnt
+  [1e5, [50, 1e5, 81.6], [0, 0, 0], [0.75, 0.75, 0.75], DIFF], // Botm
+  [1e5, [50, -1e5 + 81.6, 81.6], [0, 0, 0], [0.75, 0.75, 0.75], DIFF], // Top
+  [16.5, [27, 16.5, 47], [0, 0, 0], [0.999, 0.999, 0.999], SPEC], // Mirr
+  [16.5, [73, 16.5, 78], [0, 0, 0], [0.999, 0.999, 0.999], REFR], // Glas
+  [600, [50, 681.6 - 0.27, 81.6], [12, 12, 12], [0, 0, 0], DIFF], // Lite
+];
+const sceneBytes = Buffer.alloc(scene.length * SPHERE_STRIDE);
+scene.forEach(([rad, p, e, col, refl], i) => {
+  [rad, ...p, ...e, ...col, refl].forEach((v, j) => sceneBytes.writeDoubleLE(v, i * SPHERE_STRIDE + j * 8));
+});
+
+const G_SEED = 0, G_HIT = 1;
+
+// Function index space: imports first, then defined functions in this order.
+const imports = [['sin', ['f64'], ['f64']], ['cos', ['f64'], ['f64']], ['pow', ['f64', 'f64'], ['f64']]];
+const order = ['rand', 'sphere_intersect', 'intersect', 'radiance', 'render_rows', 'set_sphere_color', 'reset_scene', 'image_ptr'];
+const fnIndex = (n) => {
+  const imp = imports.findIndex(([m]) => m === n);
+  if (imp >= 0) return imp;
+  const i = order.indexOf(n);
+  if (i < 0) throw new Error(`unknown function ${n}`);
+  return imports.length + i;
+};
+const call = (fn, ...args) => c(...args, 0x10, uleb(fnIndex(fn)));
+
+const types = [];
+const typeIndex = (params, results) => {
+  const key = `${params}|${results}`;
+  let i = types.findIndex((t) => t.key === key);
+  if (i < 0) i = types.push({ key, params, results }) - 1;
+  return i;
+};
+
+const funcs = [];
+// params/locals: { name: type }; a name of 'v' with type 'vec' expands to v.x/v.y/v.z f64.
+function defineFunc(fname, params, results, locals, build, exported = true) {
+  const slots = new Map();
+  const paramTypes = [];
+  const localTypes = [];
+  const declare = (list, decls) => {
+    for (const [n, t] of Object.entries(decls)) {
+      for (const [sn, st] of t === 'vec' ? ['x', 'y', 'z'].map((k) => [`${n}.${k}`, 'f64']) : [[n, t]]) {
+        if (slots.has(sn)) throw new Error(`duplicate local ${sn} in ${fname}`);
+        slots.set(sn, paramTypes.length + localTypes.length);
+        list.push(st);
+      }
+    }
+  };
+  declare(paramTypes, params);
+  declare(localTypes, locals);
+  const slot = (n) => {
+    if (!slots.has(n)) throw new Error(`unknown local ${n} in ${fname}`);
+    return uleb(slots.get(n));
+  };
+  const g = (n) => [0x20, ...slot(n)];
+  const s = (n, value) => c(value, 0x21, slot(n));
+  const V = (n) => [g(`${n}.x`), g(`${n}.y`), g(`${n}.z`)];
+  // Evaluate all three components before assigning, so `v = f(v)` is safe.
+  const vset = (n, [x, y, z]) => c(x, y, z, 0x21, slot(`${n}.z`), 0x21, slot(`${n}.y`), 0x21, slot(`${n}.x`));
+  const vnorm = (n, v) => c(vset(n, v), vset(n, vscale(V(n), div(f64(1), sqrt(dot(V(n), V(n)))))));
+  // Store a multi-value (f64, f64, f64) call result.
+  const vcall = (n, fn, ...args) => c(call(fn, ...args), 0x21, slot(`${n}.z`), 0x21, slot(`${n}.y`), 0x21, slot(`${n}.x`));
+  const forRange = (n, from, to, body) => c(s(n, from), loop(ilt(g(n), to), body, s(n, iadd(g(n), i32(1)))));
+  const body = build({ g, s, V, vset, vnorm, vcall, forRange });
+  funcs[order.indexOf(fname)] = {
+    fname,
+    exported,
+    type: typeIndex(paramTypes, results),
+    localTypes,
+    code: c(body, 0x0b),
+  };
+}
+
+const sphereVec = (base, field) => [0, 8, 16].map((o) => load(base, OFF[field] + o));
+
+// erand48(): x = (0x5DEECE66D * x + 0xB) mod 2^48, returned as x / 2^48.
+defineFunc('rand', {}, ['f64'], {}, () => c(
+  gset(G_SEED, land(ladd(lmul(gget(G_SEED), i64(0x5deece66d)), i64(0xb)), i64(0xffffffffffff))),
+  mul(f64FromU64(gget(G_SEED)), f64(1 / 281474976710656)),
+), false);
+
+// Sphere::intersect
+defineFunc('sphere_intersect', { i: 'i32', o: 'vec', d: 'vec' }, ['f64'],
+  { base: 'i32', op: 'vec', b: 'f64', det: 'f64', t: 'f64' },
+  ({ g, s, V, vset }) => c(
+    s('base', imul(g('i'), i32(SPHERE_STRIDE))),
+    vset('op', vsub(sphereVec(g('base'), 'p'), V('o'))),
+    s('b', dot(V('op'), V('d'))),
+    s('det', add(sub(mul(g('b'), g('b')), dot(V('op'), V('op'))),
+      mul(load(g('base'), OFF.rad), load(g('base'), OFF.rad)))),
+    if_(lt(g('det'), f64(0)), ret(f64(0))),
+    s('det', sqrt(g('det'))),
+    s('t', sub(g('b'), g('det'))),
+    if_(gt(g('t'), f64(1e-4)), ret(g('t'))),
+    s('t', add(g('b'), g('det'))),
+    if_(gt(g('t'), f64(1e-4)), ret(g('t'))),
+    f64(0),
+  ), false);
+
+// intersect(): returns t (1e20 on miss) and sets the hit-id global.
+defineFunc('intersect', { o: 'vec', d: 'vec' }, ['f64'], { t: 'f64', i: 'i32', dist: 'f64' },
+  ({ g, s, V }) => c(
+    s('t', f64(1e20)),
+    s('i', i32(scene.length)),
+    loop(g('i'), c(
