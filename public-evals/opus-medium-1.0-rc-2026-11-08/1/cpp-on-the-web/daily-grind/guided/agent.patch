@@ -0,0 +1,21 @@
+#!/bin/sh
+# Builds smallpt.wasm from wasm/smallpt.cpp with Emscripten when em++ is on the
+# PATH. Otherwise falls back to wasm/gen-smallpt-wasm.mjs, a toolchain-free
+# translation of the same source that exports the same ABI (verified
+# pixel-identical against a native build of smallpt.cpp).
+set -eu
+cd "$(dirname "$0")/.."
+
+if command -v em++ >/dev/null 2>&1; then
+  em++ -c wasm/smallpt.cpp -o wasm/smallpt.o -O3 -flto -Wall -Werror
+  em++ wasm/smallpt.o -o smallpt.wasm \
+    -O3 -flto \
+    -sSTRICT \
+    -sSTANDALONE_WASM --no-entry \
+    -sSTACK_SIZE=1MB \
+    -sEXPORTED_FUNCTIONS=_render_rows,_set_sphere_color,_reset_scene,_image_ptr
+  rm wasm/smallpt.o
+else
+  echo "em++ not found; generating smallpt.wasm with wasm/gen-smallpt-wasm.mjs" >&2
+  node wasm/gen-smallpt-wasm.mjs
+fi
diff --git a/wasm/gen-smallpt-wasm.mjs b/wasm/gen-smallpt-wasm.mjs
