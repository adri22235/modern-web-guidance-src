+    );
+
+    let renderId = 0;
+
+    function render(colors) {
+      const id = ++renderId;
+      // Scanline 0 is the bottom of the image; queue from the top down.
+      const jobs = [];
+      for (let y1 = HEIGHT; y1 > 0; y1 -= BAND) jobs.push([Math.max(0, y1 - BAND), y1]);
+      const total = jobs.length;
+      let done = 0;
+      progress.value = 0;
+
+      return new Promise((resolve, reject) => {
+        const next = (worker) => {
+          const job = jobs.shift();
+          if (job) worker.postMessage({ id, w: WIDTH, h: HEIGHT, samps: SAMPLES, y0: job[0], y1: job[1], colors });
+        };
+        for (const worker of workers) {
+          worker.onmessage = ({ data }) => {
+            if (data.id !== id) return;
+            if (data.error) return reject(new Error(data.error));
+            ctx.putImageData(new ImageData(data.pixels, WIDTH, data.rows), 0, data.top);
+            progress.value = ++done / total;
+            if (done === total) resolve();
+            else next(worker);
+          };
