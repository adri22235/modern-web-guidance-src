+
+const R0 = (0.5 * 0.5) / (2.5 * 2.5); // a=nt-nc, b=nt+nc, R0=a*a/(b*b)
+defineFunc('radiance', { o: 'vec', d: 'vec', depth: 'i32' }, ['f64', 'f64', 'f64'], {
