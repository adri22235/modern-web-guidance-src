new file mode 100644
index 0000000..c56d9ea
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,31 @@
+// Runs smallpt.wasm off the main thread. Each message renders a band of
+// scanlines and posts the RGBA pixels back (transferred, not copied).
+const ready = (async () => {
+  const module = await WebAssembly.compileStreaming(fetch(new URL('./smallpt.wasm', import.meta.url)));
+  // The generated module imports sin/cos/pow from `env`; an em++ standalone
+  // build may import WASI stubs instead, which the renderer never calls.
+  const imports = {};
+  for (const { module: mod, name, kind } of WebAssembly.Module.imports(module)) {
+    if (kind !== 'function') continue;
+    (imports[mod] ??= {})[name] = typeof Math[name] === 'function' ? Math[name] : () => 0;
+  }
+  const { exports } = await WebAssembly.instantiate(module, imports);
+  exports._initialize?.();
+  return exports;
+})();
+
+self.onmessage = async ({ data: { id, w, h, samps, y0, y1, colors } }) => {
+  try {
+    const wasm = await ready;
+    wasm.reset_scene();
+    for (const [i, r, g, b] of colors ?? []) wasm.set_sphere_color(i, r, g, b);
+    wasm.render_rows(w, h, samps, y0, y1);
+    // Scanline y (0 = bottom) is written to image row h-y-1.
+    const top = h - y1;
+    const rows = y1 - y0;
+    const pixels = new Uint8ClampedArray(wasm.memory.buffer, wasm.image_ptr() + top * w * 4, rows * w * 4).slice();
+    self.postMessage({ id, top, rows, pixels }, [pixels.buffer]);
+  } catch (error) {
+    self.postMessage({ id, error: String(error) });
+  }
+};
