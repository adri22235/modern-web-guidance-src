+        return li;
+      }));
+    }
+
+    async function run(spheres) {
+      button.disabled = true;
+      showSwatches(spheres);
+      status.textContent = `Rendering ${WIDTH}×${HEIGHT} at ${SAMPLES * 4} samples/pixel on ${workers.length} threads…`;
+      const start = performance.now();
+      try {
+        await render(spheres.map(({ index, color }) => [index, ...color]));
+        status.textContent = `Rendered in ${((performance.now() - start) / 1000).toFixed(1)} s.`;
+      } catch (error) {
+        status.textContent = `Render failed: ${error.message}`;
+      } finally {
+        button.disabled = false;
+      }
+    }
