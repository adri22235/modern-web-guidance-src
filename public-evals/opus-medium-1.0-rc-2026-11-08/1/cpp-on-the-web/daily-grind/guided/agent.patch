+  <script type="module">
+    const WIDTH = 320, HEIGHT = 240;
+    const SAMPLES = 25; // per 2x2 subpixel, i.e. 100 samples per pixel
+    const BAND = 8;     // scanlines per worker job
+
+    // Scene sphere indices in wasm/smallpt.cpp (the black front wall and the light keep their colors).
+    const SPHERES = [
