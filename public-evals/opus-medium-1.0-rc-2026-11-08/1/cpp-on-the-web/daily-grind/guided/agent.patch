+      { index: 1, name: 'Right wall', color: [0.25, 0.25, 0.75] },
+      { index: 2, name: 'Back wall', color: [0.75, 0.75, 0.75] },
+      { index: 4, name: 'Floor', color: [0.75, 0.75, 0.75] },
+      { index: 5, name: 'Ceiling', color: [0.75, 0.75, 0.75] },
+      { index: 6, name: 'Mirror ball', color: [0.999, 0.999, 0.999], shiny: true },
+      { index: 7, name: 'Glass ball', color: [0.999, 0.999, 0.999], shiny: true },
+    ];
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const progress = document.getElementById('render-progress');
+    const status = document.getElementById('render-status');
+    const button = document.getElementById('render-button');
+    const swatches = document.getElementById('render-swatches');
+
+    const workers = Array.from(
+      { length: Math.min(navigator.hardwareConcurrency || 4, 8) },
