+});
+
+defineFunc('set_sphere_color', { i: 'i32', r: 'f64', g: 'f64', b: 'f64' }, [], { base: 'i32' },
+  ({ g, s }) => c(
+    if_(ige_u(g('i'), i32(scene.length)), ret()),
+    s('base', iadd(i32(SPHERES), imul(g('i'), i32(SPHERE_STRIDE)))),
