+})();
+
+defineFunc('render_rows', { w: 'i32', h: 'i32', samps: 'i32', y0: 'i32', y1: 'i32' }, [], {
+  x: 'i32', y: 'i32', sx: 'i32', sy: 'i32', smp: 'i32', px: 'i32', inv: 'f64',
+  r1: 'f64', r2: 'f64', dx: 'f64', dy: 'f64', a: 'f64', b: 'f64',
