+          s('k', div(g('Re'), g('P'))), vset('rr', vscale(V('rr'), g('k')))),
+        c(vcall('rr', 'radiance', ...V('x'), ...V('tdir'), g('depth')),
+          s('k', div(g('Tr'), sub(f64(1), g('P')))), vset('rr', vscale(V('rr'), g('k'))))),
+      c(vcall('rr', 'radiance', ...V('x'), ...V('rd'), g('depth')),
