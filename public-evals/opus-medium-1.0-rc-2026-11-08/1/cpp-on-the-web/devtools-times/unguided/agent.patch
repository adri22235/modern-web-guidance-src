diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..70f8e34
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,144 @@
+---
+// Client-side path tracing with smallpt (http://www.kevinbeason.com/smallpt/)
+// compiled to WebAssembly. Sources: wasm/smallpt.cpp, built by wasm/build.sh.
+const WIDTH = 320;
+const HEIGHT = 240;
+const PASSES = 32; // each pass = 4 samples per pixel
+---
+<section class="p-4 md:p-6" data-smallpt data-width={WIDTH} data-height={HEIGHT} data-passes={PASSES}>
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        Rendered in Your Browser
+    </h2>
+
+    <div class="grid md:grid-cols-3 gap-6 items-start">
+        <canvas
+            width={WIDTH}
+            height={HEIGHT}
+            class="md:col-span-2 w-full aspect-[4/3] bg-black"
+            aria-label="Path-traced Cornell box scene rendered by smallpt"
+            data-canvas
+        ></canvas>
+
+        <div>
+            <h3 class="text-xl font-bold mb-2">Global illumination in 99 lines of C++</h3>
+            <p class="text-gray-700 mb-4">
+                This image is being path traced right now on your device by
+                <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>,
+                Kevin Beason's tiny open-source renderer, compiled to WebAssembly and
+                running in a Web Worker. It refines progressively as more samples arrive.
+            </p>
+
+            <button
+                type="button"
+                class="w-full bg-gray-900 text-white font-bold py-2 px-4 hover:bg-amber-400 hover:text-gray-900 transition-colors"
+                data-randomize
+            >
+                Re-render with random colors
+            </button>
+
+            <div class="flex gap-1 mt-3" data-swatches aria-hidden="true"></div>
+
+            <p class="text-sm text-gray-500 mt-3" data-status aria-live="polite">Loading renderer…</p>
+        </div>
+    </div>
+</section>
+
+<script>
+    type Color = [number, number, number];
+
+    // Sphere indices in smallpt's scene that have a visible color
+    // (the front wall is behind the camera and index 8 is the light).
+    const SPHERES = [
+        { index: 0, name: 'Left wall' },
+        { index: 1, name: 'Right wall' },
+        { index: 2, name: 'Back wall' },
+        { index: 4, name: 'Floor' },
+        { index: 5, name: 'Ceiling' },
+        { index: 6, name: 'Mirror sphere', tint: true },
+        { index: 7, name: 'Glass sphere', tint: true },
+    ];
+    const DEFAULT_COLORS: Color[] = [
+        [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [.75, .75, .75],
+        [.75, .75, .75], [.999, .999, .999], [.999, .999, .999],
+    ];
+
+    const workerUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}wasm/smallpt-worker.js`;
+    let worker: Worker | null = null;
+
+    function hslToRgb(h: number, s: number, l: number): Color {
+        const k = (n: number) => (n + h * 12) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+        return [f(0), f(8), f(4)];
+    }
+
+    function randomColors(): Color[] {
+        // Mirror/glass get light tints so they stay reflective/transparent.
+        return SPHERES.map(({ tint }) => tint
+            ? hslToRgb(Math.random(), 0.4 + Math.random() * 0.6, 0.65 + Math.random() * 0.25)
+            : hslToRgb(Math.random(), 0.35 + Math.random() * 0.6, 0.3 + Math.random() * 0.4));
+    }
+
+    function stopRender() {
+        worker?.terminate();
+        worker = null;
+    }
+
+    function setup() {
+        const root = document.querySelector<HTMLElement>('[data-smallpt]');
+        if (!root) return;
+        const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
+        const button = root.querySelector<HTMLButtonElement>('[data-randomize]')!;
+        const status = root.querySelector<HTMLElement>('[data-status]')!;
+        const swatches = root.querySelector<HTMLElement>('[data-swatches]')!;
+        const ctx = canvas.getContext('2d')!;
+        const width = Number(root.dataset.width);
+        const height = Number(root.dataset.height);
+        const passes = Number(root.dataset.passes);
+
+        const render = (colors: Color[]) => {
+            stopRender();
+            swatches.replaceChildren(...colors.map((c, i) => {
+                const el = document.createElement('span');
+                el.className = 'h-5 flex-1 border border-gray-300';
+                el.style.backgroundColor = `rgb(${c.map(v => Math.round(v * 255)).join(',')})`;
+                el.title = SPHERES[i].name;
+                return el;
+            }));
+            status.textContent = 'Loading renderer…';
+
+            const w = new Worker(workerUrl, { type: 'module' });
+            worker = w;
+            w.onmessage = ({ data }) => {
+                if (worker !== w) return;
+                if (data.type === 'pass') {
+                    ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+                    status.textContent = `Rendering… ${data.pass * 4} / ${data.passes * 4} samples per pixel`;
+                } else if (data.type === 'done') {
+                    status.textContent = `Done: ${data.passes * 4} samples per pixel in ${(data.ms / 1000).toFixed(1)} s.`;
+                    stopRender();
+                } else if (data.type === 'error') {
+                    status.textContent = `Renderer error: ${data.message}`;
+                    stopRender();
+                }
+            };
+            w.onerror = () => {
+                if (worker !== w) return;
+                status.textContent = 'Could not start the WebAssembly renderer in this browser.';
+                stopRender();
+            };
+            w.postMessage({
+                width, height, passes,
+                colors: colors.map((c, i) => [SPHERES[i].index, ...c]),
+            });
+        };
+
+        button.addEventListener('click', () => render(randomColors()));
+        render(DEFAULT_COLORS);
+    }
+
+    // Layout uses Astro's ClientRouter, so (re)initialize on every navigation
+    // and stop any running render when leaving the page.
+    document.addEventListener('astro:page-load', setup);
+    document.addEventListener('astro:before-swap', stopRender);
+</script>
