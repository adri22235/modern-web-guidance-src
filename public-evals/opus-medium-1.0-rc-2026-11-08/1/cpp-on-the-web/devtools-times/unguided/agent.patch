+++ b/wasm/build.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Compiles smallpt.cpp to WebAssembly with Emscripten (em++ must be on PATH,
+# e.g. after `source /path/to/emsdk/emsdk_env.sh`). Output goes to
+# public/wasm/ and is committed so the site build doesn't need Emscripten.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ wasm/smallpt.cpp -O3 -o public/wasm/smallpt.mjs \
+  -sMODULARIZE -sEXPORT_ES6 -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_init,_render_pass,_pixels,_pass_count,_sphere_count,_set_sphere_color \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
