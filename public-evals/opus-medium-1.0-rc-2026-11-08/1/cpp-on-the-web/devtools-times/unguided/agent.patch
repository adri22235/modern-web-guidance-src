new file mode 100644
index 0000000..fabd074
--- /dev/null
+++ b/public/wasm/smallpt-worker.js
@@ -0,0 +1,27 @@
+// Runs the smallpt WebAssembly module off the main thread.
+// Message in:  { width, height, passes, colors: [[sphereIndex, r, g, b], ...] }
+// Messages out: { type: 'pass', pass, passes, pixels: ArrayBuffer (RGBA), ms }
+//               { type: 'done', passes, ms } | { type: 'error', message }
+// To cancel a render, the page terminates the worker.
+import createSmallpt from './smallpt.mjs';
+
+const modulePromise = createSmallpt();
+
+self.onmessage = async ({ data }) => {
+  try {
+    const m = await modulePromise;
+    const { width, height, passes, colors = [] } = data;
+    for (const [i, r, g, b] of colors) m._set_sphere_color(i, r, g, b);
+    m._init(width, height);
+    const start = performance.now();
+    for (let p = 1; p <= passes; p++) {
+      m._render_pass();
+      const ptr = m._pixels();
+      const pixels = m.HEAPU8.slice(ptr, ptr + width * height * 4).buffer;
+      self.postMessage({ type: 'pass', pass: p, passes, pixels, ms: performance.now() - start }, [pixels]);
+    }
+    self.postMessage({ type: 'done', passes, ms: performance.now() - start });
+  } catch (err) {
+    self.postMessage({ type: 'error', message: String(err && err.message || err) });
+  }
+};
