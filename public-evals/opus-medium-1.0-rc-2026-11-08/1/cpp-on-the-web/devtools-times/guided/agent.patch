diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..181e76a
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,170 @@
+---
+// Live smallpt path tracer, compiled to WebAssembly (see wasm/smallpt.cpp).
+const WIDTH = 400;
+const HEIGHT = 300;
+const SPP = 256;
+---
+<section class="p-4 md:p-6">
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        Lab: Path Tracing in Your Browser
+    </h2>
+
+    <smallpt-render
+        class="grid md:grid-cols-3 gap-6 items-start"
+        data-width={WIDTH}
+        data-height={HEIGHT}
+        data-spp={SPP}
+    >
+        <figure class="md:col-span-2">
+            <canvas
+                width={WIDTH}
+                height={HEIGHT}
+                class="w-full h-auto aspect-[4/3] bg-gray-900"
+                role="img"
+                aria-label="Path-traced render of a Cornell box with a mirror sphere and a glass sphere"
+            ></canvas>
+            <figcaption class="mt-2 text-xs text-gray-500 flex items-center gap-3">
+                <progress class="w-32 accent-amber-400" max={SPP} value="0"></progress>
+                <span data-status>Waiting to render…</span>
+            </figcaption>
+        </figure>
+
+        <div class="space-y-4">
+            <p class="text-gray-700">
+                This image is being computed right now, on your device. It comes from
+                <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+                Kevin Beason's 99-line C++ global illumination renderer. We compiled it to WebAssembly
+                and run it in a background worker. The image starts out noisy and sharpens as more light paths are traced.
+            </p>
+
+            <ul class="grid grid-cols-2 gap-2 text-sm text-gray-700" data-swatches></ul>
+
+            <button
+                type="button"
+                class="w-full bg-gray-900 text-white font-bold py-2 px-4 hover:bg-amber-400 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 transition-colors"
+                data-randomize
+            >
+                Render again with random colors
+            </button>
+        </div>
+    </smallpt-render>
+</section>
+
+<script>
+    import type { FrameMessage, RenderRequest, RGB } from '../wasm/smallpt.worker';
+
+    // Sphere indices in smallpt's scene array, with the classic colors.
+    const SPHERES: { index: number; label: string; color: RGB; tint?: boolean }[] = [
+        { index: 0, label: 'Left wall', color: [0.75, 0.25, 0.25] },
+        { index: 1, label: 'Right wall', color: [0.25, 0.25, 0.75] },
+        { index: 2, label: 'Back wall', color: [0.75, 0.75, 0.75] },
+        { index: 4, label: 'Floor', color: [0.75, 0.75, 0.75] },
+        { index: 5, label: 'Ceiling', color: [0.75, 0.75, 0.75] },
+        { index: 6, label: 'Mirror ball', color: [0.999, 0.999, 0.999], tint: true },
+        { index: 7, label: 'Glass ball', color: [0.999, 0.999, 0.999], tint: true },
+    ];
+
+    function hslToRgb(h: number, s: number, l: number): RGB {
+        const k = (n: number) => (n + h * 12) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+        return [f(0), f(8), f(4)];
+    }
+
+    // Reflectance must stay below 1 for smallpt's Russian roulette to terminate.
+    function randomColor(tint: boolean): RGB {
+        const rgb = hslToRgb(Math.random(), 0.4 + Math.random() * 0.6, 0.3 + Math.random() * 0.4);
+        return tint
+            ? (rgb.map((c) => 0.999 * (0.55 + 0.45 * c)) as RGB) // keep balls bright
+            : (rgb.map((c) => 0.05 + 0.85 * c) as RGB);
+    }
+
+    // smallpt outputs gamma 2.2 colors; match that for the swatches.
+    const toCss = (rgb: RGB) =>
+        `rgb(${rgb.map((c) => Math.round(Math.pow(c, 1 / 2.2) * 255)).join(' ')})`;
+
+    class SmallptRender extends HTMLElement {
+        #worker?: Worker;
+        #observer?: IntersectionObserver;
+        #jobId = 0;
+        #colors = new Map(SPHERES.map((s) => [s.index, s.color]));
+
+        connectedCallback() {
+            const canvas = this.querySelector('canvas')!;
+            const ctx = canvas.getContext('2d')!;
+            const progress = this.querySelector('progress')!;
+            const status = this.querySelector<HTMLElement>('[data-status]')!;
+            const button = this.querySelector<HTMLButtonElement>('[data-randomize]')!;
+            const width = Number(this.dataset.width);
+            const height = Number(this.dataset.height);
+            const spp = Number(this.dataset.spp);
+
+            this.#worker = new Worker(new URL('../wasm/smallpt.worker.ts', import.meta.url), {
+                type: 'module',
+            });
+            this.#worker.onmessage = ({ data }: MessageEvent<FrameMessage>) => {
+                if (data.id !== this.#jobId) return;
+                ctx.putImageData(new ImageData(data.pixels, width, height), 0, 0);
+                progress.value = data.spp;
+                const seconds = (data.ms / 1000).toFixed(1);
+                status.textContent = data.done
+                    ? `Done: ${data.spp} samples per pixel in ${seconds}s`
+                    : `Rendering… ${data.spp} / ${spp} samples per pixel`;
+            };
+            this.#worker.onerror = () => {
+                status.textContent = 'Could not start the WebAssembly renderer.';
+            };
+
+            const render = () => {
+                const request: RenderRequest = {
+                    id: ++this.#jobId,
+                    width,
+                    height,
+                    spp,
+                    colors: Object.fromEntries(this.#colors),
+                };
+                progress.value = 0;
+                status.textContent = 'Starting render…';
+                this.#renderSwatches();
+                this.#worker!.postMessage(request);
+            };
+
+            button.addEventListener('click', () => {
+                for (const s of SPHERES) this.#colors.set(s.index, randomColor(!!s.tint));
+                render();
+            });
+
+            // Don't spend CPU until the reader actually scrolls the lab into view.
+            this.#observer = new IntersectionObserver((entries) => {
+                if (entries.some((e) => e.isIntersecting)) {
+                    this.#observer!.disconnect();
+                    render();
+                }
+            });
+            this.#observer.observe(this);
+            this.#renderSwatches();
+        }
+
+        disconnectedCallback() {
+            this.#observer?.disconnect();
+            this.#worker?.terminate();
+        }
+
+        #renderSwatches() {
+            const list = this.querySelector('[data-swatches]')!;
+            list.replaceChildren(
+                ...SPHERES.map((s) => {
+                    const item = document.createElement('li');
+                    item.className = 'flex items-center gap-2';
+                    const chip = document.createElement('span');
+                    chip.className = 'inline-block size-4 border border-gray-300 shrink-0';
+                    chip.style.background = toCss(this.#colors.get(s.index)!);
+                    item.append(chip, s.label);
+                    return item;
+                }),
+            );
+        }
+    }
+
+    customElements.define('smallpt-render', SmallptRender);
+</script>
