diff --git a/src/wasm/smallpt.worker.ts b/src/wasm/smallpt.worker.ts
new file mode 100644
index 0000000..c638024
--- /dev/null
+++ b/src/wasm/smallpt.worker.ts
@@ -0,0 +1,66 @@
+// Runs the smallpt WebAssembly module off the main thread and streams
+// progressively refined frames back to the page.
+import createSmallpt from './smallpt.js';
+
+export type RGB = [number, number, number];
+
+export interface RenderRequest {
+  id: number;
+  width: number;
+  height: number;
+  spp: number;
+  // Sphere index -> diffuse/specular color (0..1 per channel).
+  colors: Record<number, RGB>;
+}
+
+export interface FrameMessage {
+  id: number;
+  spp: number;
+  done: boolean;
+  ms: number;
+  pixels: Uint8ClampedArray<ArrayBuffer>;
+}
+
+// The project is type-checked against the DOM lib, so describe the worker's
+// postMessage signature here instead of pulling in the conflicting webworker lib.
+const scope = self as unknown as {
+  postMessage(message: FrameMessage, transfer: Transferable[]): void;
+};
+
+const ready = createSmallpt();
+let currentId = 0;
+
+const nextTask = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+self.onmessage = async ({ data }: MessageEvent<RenderRequest>) => {
+  const { id, width, height, spp: targetSpp, colors } = data;
+  currentId = id;
+  const wasm = await ready;
+  if (id !== currentId) return;
+
+  for (const [index, [r, g, b]] of Object.entries(colors)) {
+    wasm._set_sphere_color(Number(index), r, g, b);
+  }
+  wasm._reset(width, height);
+
+  const byteLength = width * height * 4;
+  const ptr = wasm._malloc(byteLength);
+  const start = performance.now();
+  try {
+    let spp = 0;
+    while (spp < targetSpp) {
+      spp = wasm._render_pass(ptr);
+      // Re-read HEAPU8 after the call: memory growth replaces the buffer.
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, ptr, byteLength).slice();
+      const frame: FrameMessage = {
+        id, spp, pixels, done: spp >= targetSpp, ms: performance.now() - start,
+      };
+      scope.postMessage(frame, [pixels.buffer]);
+      // Yield so a newer render request can arrive and cancel this one.
+      await nextTask();
+      if (id !== currentId) return;
+    }
+  } finally {
+    wasm._free(ptr);
+  }
+};
diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..84c5af5
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Compiles smallpt.cpp to an ES6 WebAssembly module used by the homepage.
+# Requires Emscripten (emcc/em++) on PATH, e.g. via `source emsdk_env.sh`.
+# The generated files in src/wasm/ are committed so the site builds without it.
+set -euo pipefail
+cd "$(dirname "$0")"
+mkdir -p build ../src/wasm
+
+em++ -c smallpt.cpp -o build/smallpt.o -O3 -flto -Wall -Werror
+
+em++ build/smallpt.o -o ../src/wasm/smallpt.js \
+  -O3 -flto \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_reset,_render_pass,_set_sphere_color,_sphere_count,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
diff --git a/wasm/smallpt.cpp b/wasm/smallpt.cpp
new file mode 100644
index 0000000..f009326
--- /dev/null
+++ b/wasm/smallpt.cpp
@@ -0,0 +1,140 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008 (MIT License)
+// http://www.kevinbeason.com/smallpt/
+//
+// Adapted for WebAssembly: main() is replaced by exported functions that
+// render progressively into an RGBA buffer, and sphere colors can be changed
+// from JavaScript. The tracing code itself is unchanged apart from the small
+// const / brace / cast fixes needed to compile cleanly with -Wall -Werror.
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {        // position, also color (r,g,b)
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(const Vec&b) const {return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+const int numSpheres = sizeof(spheres)/sizeof(Sphere);
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=numSpheres, d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int sphere_count(){ return numSpheres; }
+
+EMSCRIPTEN_KEEPALIVE void set_sphere_color(int i, double r, double g, double b){
+  if (i>=0 && i<numSpheres) spheres[i].c = Vec(r,g,b);
+}
+
+// Progressive rendering. smallpt's main() traces `samps` samples for each
+// of the 2x2 subpixels, clamps each subpixel's mean radiance, and averages the
+// four. Here every call to render_pass() adds one more sample per subpixel to
+// a running sum, so after N passes the image equals smallpt run with 4*N spp,
+// but the browser can show intermediate results while it converges.
+static int W, H, passes;
+static Vec *accum;                  // radiance sums, 4 subpixels per pixel
+static unsigned short (*seeds)[3];  // erand48 state, one per row as in main()
+
+EMSCRIPTEN_KEEPALIVE void reset(int w, int h){
+  free(accum); free(seeds);
+  W=w; H=h; passes=0;
+  accum = (Vec*)calloc((size_t)w*h*4, sizeof(Vec));
+  seeds = (unsigned short(*)[3])malloc((size_t)h*sizeof(*seeds));
+  for (int y=0; y<h; y++){ seeds[y][0]=0; seeds[y][1]=0; seeds[y][2]=(unsigned short)(y*y*y); }
+}
+
+// Traces one more sample per subpixel (4 spp) and writes the current
+// estimate into `out`, an RGBA buffer of W*H*4 bytes. Returns total spp.
+EMSCRIPTEN_KEEPALIVE int render_pass(uint8_t *out){
+  int w=W, h=H; passes++;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    unsigned short *Xi = seeds[y];
+    for (int x=0; x<w; x++){                     // Loop cols
+      int i=(h-y-1)*w+x;                         // smallpt's y axis points up
+      Vec c, *sub = accum + i*4;
+      for (int sy=0; sy<2; sy++)                    // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++){                 // 2x2 subpixel cols
+          double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(r1);
+          double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(r2);
+          Vec d = cx*(((sx+.5 + dx)/2 + x)/w - .5) +
+                  cy*(((sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+          Vec &r = sub[sy*2+sx];
+          r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+          Vec m = r*(1./passes);
+          c = c + Vec(clamp(m.x),clamp(m.y),clamp(m.z))*.25;
+        }
+      uint8_t *px = out + i*4;
+      px[0]=toInt(c.x); px[1]=toInt(c.y); px[2]=toInt(c.z); px[3]=255;
+    }
+  }
+  return passes*4;
+}
+
+}
