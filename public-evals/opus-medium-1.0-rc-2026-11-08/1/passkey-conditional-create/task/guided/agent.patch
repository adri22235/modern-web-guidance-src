+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+    const submitButton = form.querySelector('[data-testid="signin-button"]');
+    const passwordInput = document.getElementById('current-password');
+
+    document.getElementById('show-password').addEventListener('change', (event) => {
+      passwordInput.type = event.target.checked ? 'text' : 'password';
+    });
+
+    function setStatus(message, isError = false) {
+      status.textContent = message;
+      status.classList.toggle('error', isError);
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      submitButton.disabled = true;
+      setStatus('Signing in…');
+
+      try {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            email: form.email.value.trim(),
+            password: form.password.value,
+          }),
+        });
+
+        if (!response.ok) {
+          setStatus('Incorrect email or password. Please try again.', true);
+          return;
+        }
+
+        const result = await response.json().catch(() => ({}));
+        // Only promote passkeys once the full password sign-in (incl. any MFA) has succeeded.
+        if (result.mfaRequired) {
+          setStatus('Additional verification required.');
+          return;
+        }
+
+        setStatus('Signed in. Welcome back!');
+        form.reset();
+        passwordInput.type = 'password';
+
+        // Fire-and-forget: never surface passkey errors to the user.
+        registerPasskeySilently().catch(() => {});
+      } catch {
+        setStatus('Unable to reach the server. Please try again.', true);
+      } finally {
+        submitButton.disabled = false;
+      }
+    });
+
+    async function ensureWebAuthnHelpers() {
+      if (
+        typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+    }
+
+    async function signalUnknown(rpId, credentialId) {
+      if (rpId && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        } catch {
+          // Best effort cleanup only.
+        }
+      }
+    }
+
+    async function registerPasskeySilently() {
+      if (!window.PublicKeyCredential || !navigator.credentials?.create) return;
+
+      try {
+        await ensureWebAuthnHelpers();
+      } catch {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) return;
+
+      // Server options must include rp.id and excludeCredentials for the user's existing passkeys.
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsResponse.ok) return;
+
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+      } catch (error) {
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(error.name)) {
+          console.error('Unexpected conditional create error:', error);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      // Always use the server-provided RP ID, never window.location.hostname.
+      const rpId = publicKey.rp.id;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+        if (!verifyResponse.ok) {
+          await signalUnknown(rpId, encodedResponse.id);
+        }
+      } catch (error) {
+        console.error('Passkey verification network failure:', error);
+        await signalUnknown(rpId, encodedResponse.id);
+      }
+    }
+  </script>
+
