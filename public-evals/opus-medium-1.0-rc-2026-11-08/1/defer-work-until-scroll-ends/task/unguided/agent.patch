+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var STOP_DELAY = 150;
+      var stopTimer = null;
+      var scrolling = false;
+
+      // Bean whose center is closest to the scroller's center.
+      function visibleBean() {
+        var box = scroller.getBoundingClientRect();
+        var center = box.left + box.width / 2;
+        var best = null;
+        var bestDist = Infinity;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = beans[i];
+          }
+        }
+        return best;
+      }
+
+      function onStop() {
+        clearTimeout(stopTimer);
+        stopTimer = null;
+        if (!scrolling) return;
+        scrolling = false;
+        var bean = visibleBean();
+        status.classList.remove('is-scrolling');
+        status.textContent = 'Showing: ' + (bean ? bean.dataset.bean : '—');
+      }
+
+      // Keep the scroll handler cheap: no layout reads, and only touch
+      // the DOM once when scrolling begins.
+      function onScroll() {
+        if (!scrolling) {
+          scrolling = true;
+          status.classList.add('is-scrolling');
+          status.textContent = 'Scrolling…';
+        }
+        clearTimeout(stopTimer);
+        stopTimer = setTimeout(onStop, STOP_DELAY);
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      // Native scrollend fires as soon as scrolling (incl. snapping) settles;
+      // the debounce timer above is the fallback for browsers without it.
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', onStop);
+      }
+
+      status.textContent = 'Showing: ' + visibleBean().dataset.bean;
+    })();
+  </script>
+
