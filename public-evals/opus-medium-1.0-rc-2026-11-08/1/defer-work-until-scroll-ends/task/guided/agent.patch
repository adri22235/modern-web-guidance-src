+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = [...scroller.querySelectorAll('.bean')];
+    let scrolling = false;
+
+    // Bean whose center is closest to the scroller's center.
+    function visibleBean() {
+      const center = scroller.scrollLeft + scroller.clientWidth / 2;
+      let best = beans[0];
+      let bestDist = Infinity;
+      for (const bean of beans) {
+        const dist = Math.abs(bean.offsetLeft + bean.offsetWidth / 2 - center);
+        if (dist < bestDist) {
+          best = bean;
+          bestDist = dist;
+        }
+      }
+      return best;
+    }
+
+    // Keep the scroll handler cheap: touch the DOM only once per gesture.
+    scroller.addEventListener('scroll', () => {
+      if (scrolling) return;
+      scrolling = true;
+      status.dataset.scrolling = '';
+      status.textContent = 'Scrolling…';
+    }, { passive: true });
+
+    function showVisibleBean() {
+      scrolling = false;
+      delete status.dataset.scrolling;
+      status.textContent = `Showing: ${visibleBean().dataset.bean}`;
+    }
+
+    scroller.addEventListener('scrollend', showVisibleBean);
+    showVisibleBean();
+
+    // Fallback for browsers without scrollend: debounce scroll.
+    if (!('onscrollend' in window)) {
+      let timer;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 150);
+      }, { passive: true });
+    }
+  </script>
