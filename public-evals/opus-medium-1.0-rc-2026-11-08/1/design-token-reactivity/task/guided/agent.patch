@@ -151,8 +151,55 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Card density: cards react to the --card-density token on their container
+       via container style queries, so no per-card JS is needed. */
+    #target-container {
+      --card-density: comfortable;
+    }
+
+    .seasonal:has(#toggle-spacious:checked) #target-container {
+      --card-density: spacious;
+    }
+
+    .grid .card {
+      transition: padding 0.3s;
+    }
+
+    @container style(--card-density: compact) {
+      .card {
+        padding: 12px;
+      }
+    }
+
+    @container style(--card-density: spacious) {
+      .card {
+        padding: 40px;
+      }
+    }
+
+    .density-toggle {
+      display: none;
+      justify-content: center;
+      align-items: center;
+      gap: 8px;
+      margin-top: 10px;
+      font-size: 0.9rem;
+    }
+
+    .density-toggle input {
+      accent-color: var(--primary);
+      inline-size: 1.1rem;
+      block-size: 1.1rem;
+    }
+
+    /* Always-true style query: only matches where container style queries are supported */
+    @container style(--sq: 1) or (not (style(--sq: 1))) {
+      .density-toggle {
+        display: flex;
+      }
+    }
   </style>
 </head>
 
