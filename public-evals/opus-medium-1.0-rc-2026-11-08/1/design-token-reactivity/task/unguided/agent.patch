@@ -114,8 +114,49 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Layout density: cards react to --card-density on their container via
+       container style queries, so toggling only touches the parent. */
+    #target-container {
+      --card-density: comfortable;
+    }
+
+    @container style(--card-density: spacious) {
+      .card {
+        padding: 40px 32px;
+      }
+    }
+
+    .density-controls {
+      --style-queries-probe: 1;
+      text-align: center;
+      margin-top: 10px;
+    }
+
+    /* Hidden unless the browser supports container style queries */
+    .density-toggle {
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      padding: 6px 14px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .density-toggle[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-queries-probe: 1) {
+      .density-toggle {
+        display: inline-block;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
