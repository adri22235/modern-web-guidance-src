+  <script>
+    document.getElementById('toggle-spacious').addEventListener('click', (event) => {
+      const button = event.currentTarget;
+      const spacious = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(spacious));
+      document.getElementById('target-container').style
