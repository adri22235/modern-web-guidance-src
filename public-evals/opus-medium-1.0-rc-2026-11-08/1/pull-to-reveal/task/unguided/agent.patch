 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+  <div class="search-bar" id="search-bar" role="search">
+    <form action="/search" method="get">
+      <input type="search" id="site-search" name="q" placeholder="Search drinks, locations, rewards..."
+        aria-label="Search the site" autocomplete="off">
+      <button type="submit">Search</button>
+    </form>
+    <p class="search-hint">Press <kbd>/</kbd> to search anytime</p>
