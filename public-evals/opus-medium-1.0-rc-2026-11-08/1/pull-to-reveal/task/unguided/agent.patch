+    body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Scroll container: the search bar sits above the page and is scrolled
+       out of view on load. Snap points let a partial pull settle either fully
+       open (search bar) or closed (navigation). */
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      overflow-anchor: none;
+      scroll-snap-type: y proximity;
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .page {
+      /* At least one full viewport tall so the search bar can always be
+         scrolled completely off-screen, even on short pages. */
+      min-height: 100%;
+      scroll-snap-align: start;
+    }
+
+    /* Pull-down search bar */
+    .search-bar {
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 8px;
+      max-width: 700px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      min-width: 0;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      border: 1px solid #bcaaa4;
+      border-radius: 5px;
+      background: white;
+    }
+
+    .search-bar input:focus {
+      outline: 2px solid var(--accent);
