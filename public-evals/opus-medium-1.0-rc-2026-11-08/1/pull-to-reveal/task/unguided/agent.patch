@@ -205,8 +293,47 @@
       <a href="/privacy-policy">Privacy</a>
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
+  </div>
+  </div>
 
+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var searchBar = document.getElementById('search-bar');
+      var input = document.getElementById('site-search');
+
+      function hiddenOffset() {
+        return searchBar.offsetHeight;
+      }
+
+      // Runs synchronously during parsing, before first paint, so the page
+      // opens with the nav at the top and no visible jump.
+      var initialOffset = hiddenOffset();
+      scroller.scrollTop = initialOffset;
+
+      // Keep the bar hidden if fonts/layout change its height before the user scrolls.
+      window.addEventListener('load', function () {
+        if (scroller.scrollTop === initialOffset) scroller.scrollTop = hiddenOffset();
+      });
+
+      // "/" reveals and focuses the search; Escape hides it again.
+      document.addEventListener('keydown', function (e) {
+        var tag = (e.target.tagName || '').toLowerCase();
+        if (e.key === '/' && tag !== 'input' && tag !== 'textarea' && !e.target.isContentEditable) {
+          e.preventDefault();
+          scroller.scrollTo({ top: 0, behavior: 'smooth' });
+          input.focus({ preventScroll: true });
+        } else if (e.key === 'Escape' && e.target === input) {
+          input.blur();
+          if (scroller.scrollTop < hiddenOffset()) {
+            scroller.scrollTo({ top: hiddenOffset(), behavior: 'smooth' });
+          }
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
