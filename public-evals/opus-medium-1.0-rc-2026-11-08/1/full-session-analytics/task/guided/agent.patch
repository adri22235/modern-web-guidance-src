+
+  <!-- Core Web Vitals monitoring -->
+  <script type="module">
+    import { onCLS, onINP, onLCP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@5?module';
+
+    const ANALYTICS_ENDPOINT = '/path/to/analytics/endpoint';
+
+    // Minimal fetchLater() polyfill for browsers without native support.
+    // Delivers the latest queued payload when the page becomes hidden.
+    globalThis.fetchLater ??= function fetchLater(url, init = {}) {
+      let timeoutHandle;
+      let activated = false;
+
+      function sendNow() {
+        if (!(init.signal && init.signal.aborted)) {
+          if (
+            'keepalive' in Request.prototype ||
+            init.method !== 'POST' ||
+            init.headers
+          ) {
+            fetch(url, Object.assign({}, init, { keepalive: true }));
+            activated = true;
+          } else {
+            activated = navigator.sendBeacon(url, init.body);
+          }
+        }
+        destroy();
+      }
+
+      function destroy() {
+        document.removeEventListener('visibilitychange', sendNow);
+        clearTimeout(timeoutHandle);
+      }
+
+      if (document.visibilityState === 'hidden') {
+        queueMicrotask(sendNow);
+      } else {
+        document.addEventListener('visibilitychange', sendNow);
+        if (typeof init.activateAfter === 'number' && init.activateAfter >= 0) {
+          timeoutHandle = setTimeout(sendNow, init.activateAfter);
+        }
+      }
+
+      if (init.signal) {
+        init.signal.addEventListener('abort', destroy);
+      }
+
+      return {
+        get activated() {
+          return activated;
+        },
+      };
+    };
+
+    const sessionData = {
+      id: crypto.randomUUID(),
+      page: location.pathname,
+      metrics: {},
+    };
+
+    let fetchLaterController = null;
+
+    // Replace any pending beacon with one containing the latest snapshot of
+    // all metrics. The browser sends it when the user leaves the page.
+    function queueBeacon() {
+      fetchLaterController?.abort();
+      fetchLaterController = new AbortController();
+
+      try {
+        fetchLater(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json' },
+          body: JSON.stringify(sessionData),
+          signal: fetchLaterController.signal,
+        });
+      } catch (error) {
+        // Ignore quota or other scheduling errors.
+      }
+    }
+
+    function handleMetric({ name, value, rating, delta, id, navigationType }) {
+      sessionData.metrics[name] = { value, rating, delta, id, navigationType };
+      queueBeacon();
+    }
+
+    // reportAllChanges keeps the queued payload current as values evolve
+    // (e.g. CLS and INP), so the beacon sent on exit holds final values.
+    const opts = { reportAllChanges: true };
+    onCLS(handleMetric, opts);
+    onINP(handleMetric, opts);
+    onLCP(handleMetric, opts);
+    onFCP(handleMetric, opts);
+    onTTFB(handleMetric, opts);
+  </script>
