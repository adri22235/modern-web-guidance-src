   </script>
+
+  <!-- Core Web Vitals monitoring -->
+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'https://unpkg.com/web-vitals@5?module';
+
+    const ANALYTICS_ENDPOINT = '/path/to/analytics/endpoint';
+
+    // Metrics are queued and only sent when the page is hidden (tab closed,
+    // navigated away, app switched, etc.), so values are as final as possible.
+    // Keyed by metric name so each batch holds only the latest value per metric.
+    const queue = new Map();
+
+    function addToQueue(metric) {
+      queue.set(metric.name, metric);
+    }
+
+    function flushQueue() {
+      if (queue.size === 0) return;
+
+      const body = JSON.stringify({
+        page: location.href,
+        metrics: [...queue.values()].map(({ name, value, rating, delta, id, navigationType }) => ({
+          name, value, rating, delta, id, navigationType,
+        })),
+      });
+      queue.clear();
+
+      // sendBeacon survives page unload; fall back to a keepalive fetch.
+      const queued = navigator.sendBeacon &&
+        navigator.sendBeacon(ANALYTICS_ENDPOINT, new Blob([body], { type: 'application/json' }));
+      if (!queued) {
+        fetch(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          body,
+          headers: { 'Content-Type': 'application/json' },
+          keepalive: true,
+        }).catch(() => {});
+      }
+    }
+
+    // Register the web-vitals listeners first so their own visibilitychange
+    // handlers (which finalize CLS/INP/LCP) run before our flush handler.
+    onCLS(addToQueue);
+    onINP(addToQueue);
+    onLCP(addToQueue);
+
+    // `visibilitychange` -> hidden is the last event reliably fired on all
+    // platforms (incl. mobile) and, unlike `unload`/`beforeunload`, doesn't
+    // block the back/forward cache. If the page is later restored from bfcache,
+    // web-vitals reports fresh metrics, which get flushed on the next hide.
+    addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'hidden') flushQueue();
+    });
+  </script>
 </body>
 
 </html>
