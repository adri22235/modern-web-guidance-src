+    /* Scroll Progress Indicator */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform: scaleX(0);
+      transform-origin: 0 50%;
+      z-index: 1001;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    @keyframes scroll-progress-grow {
+      from {
+        transform: scaleX(0);
+      }
+
+      to {
+        transform: scaleX(1);
+      }
+    }
+
+    /* Native scroll-driven animation where supported; JS fallback otherwise */
+    @supports (animation-timeline: scroll()) {
+      .scroll-progress {
+        animation: scroll-progress-grow linear both;
+        animation-timeline: scroll(root block);
+      }
+    }
