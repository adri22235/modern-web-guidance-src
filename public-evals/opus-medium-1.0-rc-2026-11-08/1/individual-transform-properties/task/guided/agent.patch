+    /* Featured promo badge */
+    .promo-badge-wrap {
+      display: flex;
+      justify-content: center;
+      margin-top: 20px;
+    }
+
+    .target {
+      display: inline-grid;
+      place-items: center;
+      width: 110px;
+      aspect-ratio: 1;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: bold;
+      font-size: 0.85rem;
+      line-height: 1.2;
+      text-align: center;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
+      cursor: default;
+      /* Identity values for every transform property that changes, so the
+         stacking context exists from the start and never flips on hover. */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+      /* Only scale transitions; translate and rotate are owned by the animations. */
+      transition: scale 0.3s ease;
+
+      @media (prefers-reduced-motion: no-preference) {
+        animation:
+          badge-spin 6s linear infinite,
+          badge-slide 3s ease-in-out infinite alternate;
+      }
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes badge-spin {
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: -60px 0; }
+      to { translate: 60px 0; }
+    }
   </style>
