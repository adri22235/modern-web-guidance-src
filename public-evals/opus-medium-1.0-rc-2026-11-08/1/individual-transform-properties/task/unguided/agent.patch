+    /* Featured promo badge */
+    .promo-track {
+      display: flex;
+      justify-content: center;
+      margin: 20px 0 10px;
+      padding: 10px 0;
+      overflow: hidden;
+    }
+
+    .target {
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      width: 110px;
+      height: 110px;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
+      font-weight: bold;
+      text-transform: uppercase;
+      line-height: 1.1;
+      text-align: center;
+      cursor: pointer;
+      /* Set up the stacking context on the base state so hover doesn't create a new one */
+      position: relative;
+      z-index: 1;
+      isolation: isolate;
+      /* Each motion uses its own property (rotate, translate, scale), so the hover scale
+         doesn't replace or restart the running animations */
+      scale: 1;
+      animation:
+        promo-spin 6s linear infinite,
+        promo-slide 4s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      scale: 1.2;
+    }
+
+    .target small {
+      font-size: 0.7rem;
+    }
+
+    .target strong {
+      font-size: 1.1rem;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -120px 0; }
+      to { translate: 120px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+      }
+    }
   </style>
