+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = document.querySelectorAll('.toc-sidebar a');
+    const headers = panel.querySelectorAll('.drink-section h3');
+
+    function setSelectedDrink(id) {
+      if (!id) return;
+      tocLinks.forEach((link) => {
+        const isActive = link.getAttribute('href') === `#${id}`;
+        link.classList.toggle('active', isActive);
+        link.classList.toggle('target-current', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // Highlight active link when a section settles into view via scrollsnapchange
+    panel.addEventListener('scrollsnapchange', (event) => {
+      const snappedHeader = event.snapTargetBlock;
+      if (snappedHeader) {
+        const targetId =
+          snappedHeader.id ||
+          snappedHeader.querySelector('[id]')?.id ||
+          snappedHeader.closest('[id]')?.id;
+        if (targetId) {
+          setSelectedDrink(targetId);
+        }
+      }
+    });
+
+    // Fallback for browsers that do not support scrollsnapchange
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const observer = new IntersectionObserver(
+        () => {
+          const panelTop = panel.getBoundingClientRect().top;
+          const topEntry = [...headers].reduce((currentTop, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) return currentTop;
+            if (!currentTop) return header;
+            return bottom < currentTop.getBoundingClientRect().bottom
+              ? header
+              : currentTop;
+          }, undefined);
+          if (topEntry) {
+            setSelectedDrink(topEntry.id);
+          }
+        },
+        { root: panel, threshold: 0.9 }
+      );
+
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Smoothly scroll to the target section and move focus when a TOC link is clicked
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetHeader = document.getElementById(targetId);
+        if (!targetHeader) return;
+
+        event.preventDefault();
+        const prefersSmooth = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
+        targetHeader.scrollIntoView({
+          behavior: prefersSmooth ? 'smooth' : 'auto',
+          block: 'start',
+        });
+        targetHeader.focus({ preventScroll: true });
+        setSelectedDrink(targetId);
+        history.replaceState(null, '', href);
+      });
+    });
+  </script>
+
