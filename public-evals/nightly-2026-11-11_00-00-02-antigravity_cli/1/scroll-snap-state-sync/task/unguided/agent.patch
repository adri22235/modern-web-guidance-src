+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const sections = Array.from(document.querySelectorAll('.drink-section'));
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a'));
+
+      if (!panel || sections.length === 0 || tocLinks.length === 0) return;
+
+      function setActiveSection(activeId) {
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${activeId}`;
+          link.classList.toggle('active', isMatch);
+          link.classList.toggle('is-active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === activeId;
+          section.classList.toggle('active', isMatch);
+          section.classList.toggle('is-active', isMatch);
+          if (isMatch) {
+            section.setAttribute('aria-current', 'true');
+          } else {
+            section.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function findSettledSection() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const rect = section.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        if (closestSection && closestSection.id) {
+          setActiveSection(closestSection.id);
+        }
+      }
+
+      // Observe intersections inside the scrollable panel
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.intersectionRatio >= 0.55) {
+              setActiveSection(bestEntry.target.id);
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.55, 0.75, 0.95]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      // Update when scroll settles (scrollend + debounced scroll fallback)
+      let scrollTimeout = null;
+      panel.addEventListener('scroll', () => {
+        if (scrollTimeout) clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(findSettledSection, 80);
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', () => {
+        if (scrollTimeout) clearTimeout(scrollTimeout);
+        findSettledSection();
+      });
+
+      // Smoothly scroll to the target section when a TOC link is clicked
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setActiveSection(targetId);
+
+          const header = targetSection.querySelector('header, h3') || targetSection;
+          const targetTop = targetSection.offsetTop;
+
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', href);
+          }
+        });
+      });
+
+      // Ensure initial active state matches current scroll position
+      findSettledSection();
+    })();
+  </script>
