   </footer>
 
+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'active', 'checked', 'drink', 'label'];
+      }
+
+      constructor() {
+        super();
+        this._favorited = false;
+        this._syncing = false;
+        this.attachShadow({ mode: 'open' });
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+            }
+
+            .favorite-btn {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+              padding: 6px 12px;
+              border-radius: 999px;
+              border: 1.5px solid #d7ccc8;
+              background-color: #fafafa;
+              color: #4e342e;
+              font-family: inherit;
+              font-size: 0.82rem;
+              font-weight: 600;
+              cursor: pointer;
+              transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
+              user-select: none;
+              line-height: 1;
+            }
+
+            .favorite-btn:hover {
+              border-color: #ffab40;
+              background-color: #fff8e1;
+            }
+
+            .favorite-btn:focus-visible {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+            }
+
+            .favorite-btn:active {
+              transform: scale(0.96);
+            }
+
+            .favorite-btn.is-favorited {
+              background-color: #fff3e0;
+              border-color: #ffab40;
+              color: #d84315;
+              box-shadow: 0 1px 4px rgba(255, 171, 64, 0.35);
+            }
+
+            .heart-icon {
+              width: 16px;
+              height: 16px;
+              fill: transparent;
+              stroke: currentColor;
+              stroke-width: 2;
+              transition: fill 0.2s ease, transform 0.2s ease;
+              flex-shrink: 0;
+            }
+
+            .favorite-btn.is-favorited .heart-icon {
+              fill: #e64a19;
+              stroke: #e64a19;
+              transform: scale(1.1);
+            }
+          </style>
+          <button type="button" class="favorite-btn" part="button" aria-pressed="false">
+            <svg class="heart-icon" viewBox="0 0 24 24" aria-hidden="true">
+              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
+            </svg>
+            <span class="favorite-label" part="label">Favorite</span>
+          </button>
+        `;
+
+        this._button = this.shadowRoot.querySelector('.favorite-btn');
+        this._labelEl = this.shadowRoot.querySelector('.favorite-label');
+
+        this.addEventListener('click', () => {
+          this.toggle();
+        });
+      }
+
+      connectedCallback() {
+        if (this.hasAttribute('favorited') || this.hasAttribute('active') || this.hasAttribute('checked')) {
+          this._favorited = true;
+        }
+        this._render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (this._syncing || oldValue === newValue) return;
+        if (name === 'favorited' || name === 'active' || name === 'checked') {
+          this._favorited = newValue !== null && newValue !== 'false';
+        }
+        this._render();
+      }
+
+      get drink() {
+        if (this.hasAttribute('drink')) {
+          return this.getAttribute('drink');
+        }
+        if (this.hasAttribute('label')) {
+          return this.getAttribute('label');
+        }
+        const cardTitle = this.closest('.card')?.querySelector('h3')?.textContent?.trim();
+        return cardTitle || 'drink';
+      }
+
+      set drink(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('drink');
+        } else {
+          this.setAttribute('drink', String(value));
+        }
+      }
+
+      get favorited() {
+        return this._favorited;
+      }
+
+      set favorited(value) {
+        const next = Boolean(value);
+        if (this._favorited === next) return;
+        this._favorited = next;
+        this._syncAttributes();
+        this._render();
+      }
+
+      get active() {
+        return this._favorited;
+      }
+
+      set active(value) {
+        this.favorited = value;
+      }
+
+      get checked() {
+        return this._favorited;
+      }
+
+      set checked(value) {
+        this.favorited = value;
+      }
+
+      toggle(force) {
+        const next = typeof force === 'boolean' ? force : !this._favorited;
+        this.favorited = next;
+        const detail = { favorited: this._favorited, active: this._favorited, drink: this.drink };
+        this.dispatchEvent(new CustomEvent('favorite-change', { detail, bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        return this._favorited;
+      }
+
+      _syncAttributes() {
+        this._syncing = true;
+        if (this._favorited) {
+          this.setAttribute('favorited', '');
+        } else {
+          this.removeAttribute('favorited');
+          this.removeAttribute('active');
+          this.removeAttribute('checked');
+        }
+        this._syncing = false;
+      }
+
+      _render() {
+        const isFav = this._favorited;
+        const drinkName = this.drink;
+        this.dataset.favorited = String(isFav);
+
+        if (this._button) {
+          this._button.classList.toggle('is-favorited', isFav);
+          this._button.classList.toggle('active', isFav);
+          this._button.setAttribute('aria-pressed', String(isFav));
+          this._button.setAttribute(
+            'aria-label',
+            isFav ? `Remove ${drinkName} from favorites` : `Mark ${drinkName} as favorite`
+          );
+          this._button.setAttribute(
+            'title',
+            isFav ? `Favorited: ${drinkName}` : `Mark ${drinkName} as favorite`
+          );
+        }
+
+        if (this._labelEl) {
+          this._labelEl.textContent = isFav ? 'Favorited' : 'Favorite';
+        }
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
