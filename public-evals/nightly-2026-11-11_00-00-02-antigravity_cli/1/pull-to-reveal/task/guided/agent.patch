+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      // Progressive enhancement fallback for browsers without CSS scroll-initial-target support
+      if (!CSS.supports("scroll-initial-target", "nearest")) {
+        const targetContent = document.querySelector(".main-content.target");
+        if (targetContent) {
+          targetContent.scrollIntoView({ behavior: "instant", block: "start" });
+        }
+      }
+
+      // Single-click / keyboard-accessible alternative to the pull-to-reveal gesture
+      const revealSearchBtn = document.getElementById("reveal-search-btn");
+      const searchBar = document.getElementById("site-search");
+      const searchInput = document.getElementById("search-input");
+
+      if (revealSearchBtn && searchBar) {
+        revealSearchBtn.addEventListener("click", () => {
+          searchBar.scrollIntoView({ behavior: "smooth", block: "start" });
+          if (searchInput) {
+            searchInput.focus();
+          }
+        });
+      }
+    });
+  </script>
