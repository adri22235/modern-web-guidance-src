+  <script>
+    (function () {
+      const section = document.getElementById('craft-parallax');
+      if (!section) return;
+
+      const layers = Array.from(section.querySelectorAll('[data-parallax-speed]'));
+      if (!layers.length) return;
+
+      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let prefersReducedMotion = motionQuery.matches;
+      let isVisible = true;
+      let ticking = false;
+
+      function resetTransforms() {
+        for (let i = 0; i < layers.length; i++) {
+          layers[i].style.transform = 'translate3d(0, 0, 0)';
+        }
+      }
+
+      function updateParallax() {
+        ticking = false;
+        if (prefersReducedMotion || !isVisible) return;
+
+        const rect = section.getBoundingClientRect();
+        const viewportCenter = window.innerHeight * 0.5;
+        const sectionCenter = rect.top + rect.height * 0.5;
+        const deltaFromCenter = sectionCenter - viewportCenter;
+
+        for (let i = 0; i < layers.length; i++) {
+          const layer = layers[i];
+          const speed = parseFloat(layer.getAttribute('data-parallax-speed')) || 0;
+          const offsetY = Math.round(deltaFromCenter * speed * 100) / 100;
+          layer.style.transform = 'translate3d(0, ' + offsetY + 'px, 0)';
+        }
+      }
+
+      function requestTick() {
+        if (!ticking && !prefersReducedMotion && isVisible) {
+          ticking = true;
+          window.requestAnimationFrame(updateParallax);
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries) {
+            entries.forEach(function (entry) {
+              isVisible = entry.isIntersecting;
+              if (isVisible) {
+                requestTick();
+              }
+            });
+          },
+          { rootMargin: '150px 0px' }
+        );
+        observer.observe(section);
+      }
+
+      window.addEventListener('scroll', requestTick, { passive: true });
+      window.addEventListener('resize', requestTick, { passive: true });
+
+      function handleMotionChange(event) {
+        prefersReducedMotion = event.matches;
+        if (prefersReducedMotion) {
+          resetTransforms();
+        } else {
+          requestTick();
+        }
+      }
+
+      if (typeof motionQuery.addEventListener === 'function') {
+        motionQuery.addEventListener('change', handleMotionChange);
+      } else if (typeof motionQuery.addListener === 'function') {
+        motionQuery.addListener(handleMotionChange);
+      }
+
+      requestTick();
+    })();
+  </script>
