+  <script>
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourBtn = document.getElementById('close-tour');
+
+    let isTourOpen = true;
+
+    function checkTourOpen() {
+      if (typeof tourStep.matches === 'function' && tourStep.hasAttribute('popover')) {
+        try {
+          return tourStep.matches(':popover-open');
+        } catch {
+          return isTourOpen;
+        }
+      }
+      return isTourOpen;
+    }
+
+    if (typeof tourStep.showPopover === 'function') {
+      tourStep.showPopover();
+    }
+
+    tourStep.addEventListener('toggle', (event) => {
+      isTourOpen = event.newState === 'open';
+      featureLink.classList.toggle('tour-active', isTourOpen);
+    });
+
+    closeTourBtn.addEventListener('click', () => {
+      isTourOpen = false;
+      featureLink.classList.remove('tour-active');
+      if (typeof tourStep.hidePopover === 'function' && checkTourOpen()) {
+        tourStep.hidePopover();
+      } else {
+        tourStep.style.display = 'none';
+      }
+    });
+
+    featureLink.addEventListener('click', (event) => {
+      if (checkTourOpen()) {
+        event.preventDefault();
+      }
+    });
+
+    if (typeof CSS === 'undefined' || !CSS.supports('anchor-name', '--feature')) {
+      function updatePosition() {
+        if (!checkTourOpen()) return;
+        const rect = featureLink.getBoundingClientRect();
+        tourStep.style.top = `${rect.bottom + 12}px`;
+        tourStep.style.left = `${rect.left + rect.width / 2}px`;
+      }
+      updatePosition();
+      window.addEventListener('resize', updatePosition, { passive: true });
+      window.addEventListener('scroll', updatePosition, { passive: true });
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updatePosition);
+        ro.observe(document.body);
+        ro.observe(featureLink);
+      }
+    }
+  </script>
+
 </body>
 
