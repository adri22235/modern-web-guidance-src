+  <script type="module">
+    const tourStep = document.getElementById('tour-step');
+    const featureLink = document.getElementById('feature');
+    const main = document.querySelector('main');
+    const closeBtn = tourStep.querySelector('button');
+
+    const isTourOpen = () =>
+      (typeof tourStep.matches === 'function' && tourStep.matches(':popover-open')) ||
+      tourStep.classList.contains(':popover-open') ||
+      tourStep.hasAttribute('open');
+
+    // Prevent the rewards link from navigating away while the onboarding tour step is active
+    featureLink.addEventListener('click', (event) => {
+      if (isTourOpen()) {
+        event.preventDefault();
+      }
+    });
+
+    // Clean up inert state and return focus to the rewards link when the tour step closes
+    const handleClose = () => {
+      if (main) {
+        main.inert = false;
+      }
+      featureLink.focus();
+    };
+
+    tourStep.addEventListener('toggle', (event) => {
+      if (event.newState === 'closed') {
+        handleClose();
+      }
+    });
+
+    closeBtn.addEventListener('click', () => {
+      if (typeof tourStep.hidePopover === 'function' && isTourOpen()) {
+        tourStep.hidePopover();
+      }
+      if (!isTourOpen()) {
+        handleClose();
+      }
+    });
+
+    async function initTour() {
+      // Conditionally load Popover polyfill only when native support is missing
+      if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+        await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js").catch(() => {});
+      }
+
+      // Conditionally load CSS Anchor Positioning polyfill only when native support is missing
+      if (!CSS.supports("anchor-name: --a")) {
+        await import("https://unpkg.com/@oddbird/css-anchor-positioning").catch(() => {});
+      }
+
+      if (typeof tourStep.showPopover === 'function') {
+        tourStep.showPopover();
+      } else {
+        tourStep.setAttribute('open', '');
+      }
+
+      if (main) {
+        main.inert = true;
+      }
+
+      // Programmatically route focus into the non-modal popover
+      closeBtn.focus();
+    }
+
+    initTour();
+  </script>
 </body>
 
