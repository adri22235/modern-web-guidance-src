+}
+
+static int g_w = 0;
+static int g_h = 0;
+static Vec *g_accum = NULL;
+static uint8_t *g_rgba = NULL;
+static int g_total_samples = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+int get_sphere_count() {
+  return sizeof(spheres) / sizeof(Sphere);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int idx, double r, double g, double b) {
+  int n = get_sphere_count();
+  if (idx >= 0 && idx < n) {
+    spheres[idx].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int idx) {
+  return (idx >= 0 && idx < get_sphere_count()) ? spheres[idx].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int idx) {
+  return (idx >= 0 && idx < get_sphere_count()) ? spheres[idx].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int idx) {
+  return (idx >= 0 && idx < get_sphere_count()) ? spheres[idx].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  for (int i = 0; i < 9; i++) {
+    spheres[i].c = default_colors[i];
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 31337) & 0xFFFF)
+  };
+  // Randomize Left, Right, Back, Bottom, Top walls, plus Mirror and Glass tint!
+  // Indices: 0 (Left), 1 (Right), 2 (Back), 4 (Bottom), 5 (Top), 6 (Mirror), 7 (Glass)
+  int targets[] = {0, 1, 2, 4, 5, 6, 7};
+  for (int k = 0; k < 7; k++) {
+    int idx = targets[k];
+    if (idx == 6 || idx == 7) {
+      // Mirror and glass look great with bright pastel / jewel tints
+      double r = 0.55 + 0.449 * erand48(Xi);
+      double g = 0.55 + 0.449 * erand48(Xi);
+      double b = 0.55 + 0.449 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    } else {
+      // Diffuse walls: vibrant colors with good albedo (0.15 to 0.85)
+      double r = 0.15 + 0.70 * erand48(Xi);
+      double g = 0.15 + 0.70 * erand48(Xi);
+      double b = 0.15 + 0.70 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_render(int w, int h) {
+  if (g_w != w || g_h != h || !g_accum || !g_rgba) {
+    if (g_accum) free(g_accum);
+    if (g_rgba) free(g_rgba);
+    g_w = w;
+    g_h = h;
+    g_accum = (Vec*)malloc(sizeof(Vec) * w * h);
+    g_rgba = (uint8_t*)malloc(sizeof(uint8_t) * w * h * 4);
+  }
+  for (int i = 0; i < w * h; i++) {
+    g_accum[i] = Vec(0, 0, 0);
+    g_rgba[i * 4 + 0] = 0;
+    g_rgba[i * 4 + 1] = 0;
+    g_rgba[i * 4 + 2] = 0;
+    g_rgba[i * 4 + 3] = 255;
+  }
+  g_total_samples = 0;
+  return g_rgba;
+}
+
+// Render a batch of rows for progressive rendering or full image rendering.
+// Each call to render_rows traces `samps_per_subpixel` samples for each of the 2x2 subpixels
+// (so 4 * samps_per_subpixel total samples per pixel in the row range [start_y, end_y)).
+// Wait: if we do progressive passes over the full image, or row-by-row for a fixed sample count,
+// let's support both!
+// In `render_rows(start_y, end_y, samps, pass_index)`:
+// Accumulates `samps` samples per subpixel (4 * samps rays per pixel) into g_accum for rows [start_y, end_y),
+// and updates g_rgba assuming `total_passes` completed so far for those rows is `pass_index + 1`.
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int start_y, int end_y, int samps, int pass_index) {
+  if (!g_accum || !g_rgba || g_w <= 0 || g_h <= 0) return;
+  int w = g_w;
+  int h = g_h;
+  if (start_y < 0) start_y = 0;
+  if (end_y > h) end_y = h;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  double weight = 1.0 / (double)(pass_index + 1);
+  double prev_weight = (double)pass_index / (double)(pass_index + 1);
+
+  for (int y = start_y; y < end_y; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(y + pass_index * 7919),
+      (unsigned short)(pass_index * 104729 + y * 31),
+      (unsigned short)(y * y * y + pass_index * 65537)
+    };
+    for (int x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec pixel_rad(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++) {   // 2x2 subpixel cols
+          r = Vec();
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          pixel_rad = pixel_rad + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      g_accum[i] = g_accum[i] * prev_weight + pixel_rad * weight;
+      g_rgba[i * 4 + 0] = toInt(g_accum[i].x);
+      g_rgba[i * 4 + 1] = toInt(g_accum[i].y);
+      g_rgba[i * 4 + 2] = toInt(g_accum[i].z);
+      g_rgba[i * 4 + 3] = 255;
+    }
+  }
+}
+
+// Single-call synchronous render for convenience
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps) {
+  init_render(w, h);
+  render_rows(0, h, samps, 0);
+  return g_rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_ptr() {
+  return g_rgba;
+}
+
+}
