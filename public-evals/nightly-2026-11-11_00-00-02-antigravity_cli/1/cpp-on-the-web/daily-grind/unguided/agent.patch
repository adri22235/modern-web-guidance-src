+  <script>
+    (function () {
+      const canvas = document.getElementById('render-canvas');
+      const ctx = canvas.getContext('2d');
+      const randomizeBtn = document.getElementById('randomize-btn');
+      const resetBtn = document.getElementById('reset-btn');
+      const resolutionSelect = document.getElementById('resolution-select');
+      const samplesSelect = document.getElementById('samples-select');
+      const statusDot = document.getElementById('status-dot');
+      const statusText = document.getElementById('status-text');
+      const timingText = document.getElementById('timing-text');
+      const progressFill = document.getElementById('progress-fill');
+      const swatchesList = document.getElementById('swatches-list');
+      const renderStats = document.getElementById('render-stats');
+
+      const SPHERE_LABELS = [
+        { idx: 0, name: 'Left Wall (Diffuse)' },
+        { idx: 1, name: 'Right Wall (Diffuse)' },
+        { idx: 2, name: 'Back Wall (Diffuse)' },
+        { idx: 4, name: 'Floor (Diffuse)' },
+        { idx: 5, name: 'Ceiling (Diffuse)' },
+        { idx: 6, name: 'Left Sphere (Mirror)' },
+        { idx: 7, name: 'Right Sphere (Glass)' }
+      ];
+
+      let wasmReady = false;
+      let currentRenderId = 0;
+
+      function toDisplayHex(r, g, b) {
+        const gamma = (v) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255)));
+        const hr = gamma(r).toString(16).padStart(2, '0');
+        const hg = gamma(g).toString(16).padStart(2, '0');
+        const hb = gamma(b).toString(16).padStart(2, '0');
+        return `#${hr}${hg}${hb}`;
+      }
+
+      function updateSwatchesUI() {
+        if (!wasmReady) return;
+        swatchesList.innerHTML = '';
+        for (const item of SPHERE_LABELS) {
+          const r = Module._get_sphere_color_r(item.idx);
+          const g = Module._get_sphere_color_g(item.idx);
+          const b = Module._get_sphere_color_b(item.idx);
+          const hex = toDisplayHex(r, g, b);
+
+          const row = document.createElement('div');
+          row.className = 'swatch-row';
+          row.innerHTML = `
+            <div class="swatch-info">
+              <span class="swatch-color" style="background-color: ${hex};"></span>
+              <span>${item.name}</span>
+            </div>
+            <span class="swatch-rgb">(${r.toFixed(2)}, ${g.toFixed(2)}, ${b.toFixed(2)})</span>
+          `;
+          swatchesList.appendChild(row);
+        }
+      }
+
+      function startRender() {
+        if (!wasmReady) return;
+
+        const renderId = ++currentRenderId;
+        const [wStr, hStr] = resolutionSelect.value.split('x');
+        const w = parseInt(wStr, 10);
+        const h = parseInt(hStr, 10);
+        const sampsPerSubpixel = parseInt(samplesSelect.value, 10);
+        const totalSpp = sampsPerSubpixel * 4;
+
+        canvas.width = w;
+        canvas.height = h;
+
+        Module._init_render(w, h);
+        updateSwatchesUI();
+
+        statusDot.className = 'dot rendering';
+        statusText.textContent = `Rendering ${w}×${h} (${totalSpp} spp)...`;
+        progressFill.style.width = '0%';
+
+        const startTime = performance.now();
+        const rowsPerChunk = 12;
+        let currentY = 0;
+
+        function renderNextChunk() {
+          if (renderId !== currentRenderId) return;
+
+          const endY = Math.min(h, currentY + rowsPerChunk);
+          Module._render_rows(currentY, endY, sampsPerSubpixel, 0);
+          currentY = endY;
+
+          const ptr = Module._get_rgba_ptr();
+          const pixels = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, w * h * 4);
+          const imageData = new ImageData(pixels, w, h);
+          ctx.putImageData(imageData, 0, 0);
+
+          const pct = Math.round((currentY / h) * 100);
+          progressFill.style.width = `${pct}%`;
+          const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
+          timingText.textContent = `${pct}% • ${elapsed}s`;
+          renderStats.innerHTML = `Scanline: <strong>${currentY}/${h}</strong> (${w * currentY * totalSpp} primary rays)`;
+
+          if (currentY < h) {
+            requestAnimationFrame(renderNextChunk);
+          } else {
+            statusDot.className = 'dot done';
+            statusText.textContent = `Render complete (${w}×${h}, ${totalSpp} spp)`;
+            timingText.textContent = `Completed in ${elapsed}s`;
+          }
+        }
+
+        requestAnimationFrame(renderNextChunk);
+      }
+
+      randomizeBtn.addEventListener('click', () => {
+        if (!wasmReady) return;
+        const seed = Math.floor(Math.random() * 0xFFFFFFFF) >>> 0;
+        Module._randomize_sphere_colors(seed);
+        startRender();
+      });
+
+      resetBtn.addEventListener('click', () => {
+        if (!wasmReady) return;
+        Module._reset_default_colors();
+        startRender();
+      });
+
+      resolutionSelect.addEventListener('change', () => startRender());
+      samplesSelect.addEventListener('change', () => startRender());
+
+      function onReady() {
+        if (wasmReady) return;
+        wasmReady = true;
+        startRender();
+      }
 
+      if (typeof Module !== 'undefined' && Module.calledRun) {
+        onReady();
+      } else if (typeof Module !== 'undefined') {
+        const prevInit = Module.onRuntimeInitialized;
+        Module.onRuntimeInitialized = function () {
+          if (typeof prevInit === 'function') prevInit();
+          onReady();
+        };
+      }
+    })();
+  </script>
