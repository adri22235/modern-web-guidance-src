+  <script type="module">
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const samplesSelect = document.getElementById('samples-select');
+    const statusText = document.getElementById('status-text');
+    const swatchList = document.getElementById('swatch-list');
+
+    const SPHERE_LABELS = [
+      { index: 0, name: 'Left Wall' },
+      { index: 1, name: 'Right Wall' },
+      { index: 2, name: 'Back Wall' },
+      { index: 4, name: 'Floor' },
+      { index: 5, name: 'Ceiling' },
+      { index: 6, name: 'Mirror Sphere' },
+      { index: 7, name: 'Glass Sphere' },
+    ];
+
+    const DEFAULT_COLORS = [
+      { index: 0, r: 0.75, g: 0.25, b: 0.25 },
+      { index: 1, r: 0.25, g: 0.25, b: 0.75 },
+      { index: 2, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 3, r: 0.0, g: 0.0, b: 0.0 },
+      { index: 4, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 5, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 6, r: 0.999, g: 0.999, b: 0.999 },
+      { index: 7, r: 0.999, g: 0.999, b: 0.999 },
+    ];
+
+    let activeColors = DEFAULT_COLORS.map((c) => ({ ...c }));
+    let currentJobId = 0;
+
+    function toCssRgb(c) {
+      const r = Math.round(Math.pow(Math.min(1, Math.max(0, c.r)), 1 / 2.2) * 255);
+      const g = Math.round(Math.pow(Math.min(1, Math.max(0, c.g)), 1 / 2.2) * 255);
+      const b = Math.round(Math.pow(Math.min(1, Math.max(0, c.b)), 1 / 2.2) * 255);
+      return `rgb(${r}, ${g}, ${b})`;
+    }
+
+    function updateSwatches(colors) {
+      swatchList.replaceChildren();
+      for (const meta of SPHERE_LABELS) {
+        const entry = colors.find((c) => c.index === meta.index);
+        if (!entry) continue;
+        const item = document.createElement('div');
+        item.className = 'swatch-item';
+
+        const dot = document.createElement('span');
+        dot.className = 'swatch-color';
+        dot.style.backgroundColor = toCssRgb(entry);
+
+        const label = document.createElement('span');
+        label.textContent = meta.name;
+
+        item.append(dot, label);
+        swatchList.append(item);
+      }
+    }
+
+    function hslToRgb(h, s, l) {
+      const a = s * Math.min(l, 1 - l);
+      const f = (n) => {
+        const k = (n + h / 30) % 12;
+        return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+      };
+      return { r: f(0), g: f(8), b: f(4) };
+    }
+
+    function generateRandomSphereColors() {
+      const randWall = () => {
+        const { r, g, b } = hslToRgb(Math.random() * 360, 0.55 + Math.random() * 0.35, 0.4 + Math.random() * 0.3);
+        return { r, g, b };
+      };
+      const randNeutralWall = () => {
+        const { r, g, b } = hslToRgb(Math.random() * 360, 0.15 + Math.random() * 0.35, 0.65 + Math.random() * 0.2);
+        return { r, g, b };
+      };
+      const randSpecular = () => {
+        const { r, g, b } = hslToRgb(Math.random() * 360, 0.65 + Math.random() * 0.3, 0.65 + Math.random() * 0.25);
+        return { r, g, b };
+      };
+
+      return [
+        { index: 0, ...randWall() },
+        { index: 1, ...randWall() },
+        { index: 2, ...randNeutralWall() },
+        { index: 3, r: 0.0, g: 0.0, b: 0.0 },
+        { index: 4, ...randNeutralWall() },
+        { index: 5, ...randNeutralWall() },
+        { index: 6, ...randSpecular() },
+        { index: 7, ...randSpecular() },
+      ];
+    }
+
+    const worker = new Worker(new URL('./worker.js', import.meta.url), {
+      type: 'module',
+    });
+
+    worker.addEventListener('message', (event) => {
+      const { type, jobId, pixels, width, height, samples, elapsedMs, message } = event.data || {};
+      if (jobId !== currentJobId) return;
+
+      randomizeBtn.disabled = false;
+      resetBtn.disabled = false;
+
+      if (type === 'rendered') {
+        if (canvas.width !== width || canvas.height !== height) {
+          canvas.width = width;
+          canvas.height = height;
+        }
+        const imageData = new ImageData(pixels, width, height);
+        ctx.putImageData(imageData, 0, 0);
+        statusText.textContent = `Rendered ${width}×${height} (${samples * 4} spp) in ${(elapsedMs / 1000).toFixed(2)}s via WebAssembly.`;
+      } else if (type === 'error') {
+        statusText.textContent = `Render error: ${message}`;
+      }
+    });
+
+    function triggerRender(colors) {
+      currentJobId += 1;
+      activeColors = colors.map((c) => ({ ...c }));
+      updateSwatches(activeColors);
+
+      const [width, height] = resolutionSelect.value.split('x').map(Number);
+      const samples = Number(samplesSelect.value) || 4;
+      const seed = Math.floor(Math.random() * 0xffffffff);
+
+      randomizeBtn.disabled = true;
+      resetBtn.disabled = true;
+      statusText.textContent = `Path tracing ${width}×${height} (${samples * 4} spp) in WebAssembly Worker...`;
+
+      worker.postMessage({
+        type: 'render',
+        jobId: currentJobId,
+        width,
+        height,
+        samples,
+        seed,
+        colors: activeColors,
+      });
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      triggerRender(generateRandomSphereColors());
+    });
+
+    resetBtn.addEventListener('click', () => {
+      triggerRender(DEFAULT_COLORS);
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      triggerRender(activeColors);
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      triggerRender(activeColors);
+    });
+
+    // Run initial render on load
+    triggerRender(DEFAULT_COLORS);
+  </script>
