+/**
+ * Client-side WebAssembly runner for Kevin Beason's smallpt C++ Path Tracer.
+ * Compiled from smallpt.cpp using Emscripten (em++ -O3 -ffast-math -msimd128).
+ */
+(function () {
+  const SMALLPT_WASM_BASE64 = "";
+
+  const SPHERE_METADATA = [
+    { index: 0, name: "Left Wall", material: "DIFF (Diffuse)", role: "Cornell Box Left" },
+    { index: 1, name: "Right Wall", material: "DIFF (Diffuse)", role: "Cornell Box Right" },
+    { index: 2, name: "Back Wall", material: "DIFF (Diffuse)", role: "Cornell Box Back" },
+    { index: 4, name: "Floor", material: "DIFF (Diffuse)", role: "Cornell Box Bottom" },
+    { index: 5, name: "Ceiling", material: "DIFF (Diffuse)", role: "Cornell Box Top" },
+    { index: 6, name: "Mirror Sphere", material: "SPEC (Specular)", role: "Left Foreground Sphere" },
+    { index: 7, name: "Glass Sphere", material: "REFR (Refractive)", role: "Right Foreground Sphere" }
+  ];
+
+  function decodeBase64ToBytes(base64) {
+    const binaryString = atob(base64);
+    const len = binaryString.length;
+    const bytes = new Uint8Array(len);
+    for (let i = 0; i < len; i++) {
+      bytes[i] = binaryString.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  function toDisplayHex(r, g, b) {
+    const gamma = (v) => Math.max(0, Math.min(255, Math.floor(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255 + 0.5)));
+    const hex = (n) => n.toString(16).padStart(2, "0");
+    return "#" + hex(gamma(r)) + hex(gamma(g)) + hex(gamma(b));
+  }
+
+  let wasmInstance = null;
+  let wasmExports = null;
+  let wasmInitPromise = null;
+
+  function loadSmallptWasm(wasmUrl) {
+    if (wasmInitPromise) return wasmInitPromise;
+
+    const imports = {
+      env: {
+        emscripten_notify_memory_growth: function () {}
+      }
+    };
+
+    // Trigger fetch of smallpt.wasm for browser caching/DevTools inspection
+    if (typeof fetch === "function" && wasmUrl) {
+      fetch(wasmUrl).catch(function () {});
+    }
+
+    const embeddedBytes = decodeBase64ToBytes(SMALLPT_WASM_BASE64);
+    wasmInitPromise = WebAssembly.instantiate(embeddedBytes, imports).then(function (result) {
+      wasmInstance = result.instance;
+      wasmExports = wasmInstance.exports;
+      if (typeof wasmExports._initialize === "function") {
+        wasmExports._initialize();
+      }
+      return wasmExports;
+    });
+
+    return wasmInitPromise;
+  }
+
+  function initSmallptApp() {
+    const canvas = document.getElementById("smallpt-canvas");
+    if (!canvas || canvas.dataset.smallptBound === "true") return;
+    canvas.dataset.smallptBound = "true";
+
+    const ctx = canvas.getContext("2d");
+    const randomizeBtn = document.getElementById("randomize-btn");
+    const resetBtn = document.getElementById("reset-colors-btn");
+    const resolutionSelect = document.getElementById("smallpt-resolution");
+    const samplesSelect = document.getElementById("smallpt-samples");
+    const statusText = document.getElementById("smallpt-status");
+    const statsPasses = document.getElementById("smallpt-stat-passes");
+    const statsTime = document.getElementById("smallpt-stat-time");
+    const statsRuns = document.getElementById("smallpt-stat-runs");
+    const progressFill = document.getElementById("smallpt-progress-fill");
+    const swatchesContainer = document.getElementById("smallpt-swatches");
+
+    let width = parseInt(canvas.getAttribute("width") || "256", 10);
+    let height = parseInt(canvas.getAttribute("height") || "192", 10);
+    let targetSpp = samplesSelect ? parseInt(samplesSelect.value, 10) : 16;
+    let targetPasses = Math.max(1, Math.round(targetSpp / 4));
+    let currentPass = 0;
+    let renderCount = 0;
+    let totalRenderMs = 0;
+    let seedCounter = 1;
+    let rafId = null;
+
+    const wasmUrl = canvas.dataset.wasmUrl || "smallpt.wasm";
+
+    function cancelProgressiveRender() {
+      if (rafId !== null) {
+        cancelAnimationFrame(rafId);
+        rafId = null;
+      }
+    }
+
+    function updateSphereSwatches() {
+      if (!wasmExports || !swatchesContainer) return;
+      const cards = SPHERE_METADATA.map(function (meta) {
+        const r = wasmExports.get_sphere_color_r(meta.index);
+        const g = wasmExports.get_sphere_color_g(meta.index);
+        const b = wasmExports.get_sphere_color_b(meta.index);
+        const hex = toDisplayHex(r, g, b);
+        const rgbStr = "(" + r.toFixed(2) + ", " + g.toFixed(2) + ", " + b.toFixed(2) + ")";
+        return (
+          '<div class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-800/80 border border-slate-700/70" data-sphere-index="' + meta.index + '" data-sphere-hex="' + hex + '">' +
+            '<span class="w-7 h-7 rounded-md shadow-inner border border-white/20 shrink-0" style="background-color: ' + hex + ';"></span>' +
+            '<div class="min-w-0 flex-1">' +
+              '<div class="text-xs font-semibold text-slate-100 truncate">' + meta.name + '</div>' +
+              '<div class="text-[11px] font-mono text-slate-400 truncate">' + hex.toUpperCase() + " " + rgbStr + '</div>' +
+            '</div>' +
+          '</div>'
+        );
+      });
+      swatchesContainer.innerHTML = cards.join("");
+    }
+
+    function executePassSync() {
+      if (!wasmExports) return;
+      const t0 = performance.now();
+      seedCounter = (seedCounter + 1) | 0;
+      const ptr = wasmExports.render_pass(width, height, 1, seedCounter >>> 0);
+      const elapsed = performance.now() - t0;
+      totalRenderMs += elapsed;
+      currentPass = wasmExports.get_accum_passes();
+
+      const pixelView = new Uint8ClampedArray(wasmExports.memory.buffer, ptr, width * height * 4);
+      const imageData = new ImageData(new Uint8ClampedArray(pixelView), width, height);
+      ctx.putImageData(imageData, 0, 0);
+
+      const currentSpp = currentPass * 4;
+      canvas.dataset.rendered = "true";
+      canvas.dataset.renderCount = String(renderCount);
+      canvas.dataset.currentSpp = String(currentSpp);
+
+      if (statsPasses) {
+        statsPasses.textContent = currentSpp + " / " + (targetPasses * 4) + " spp (Pass " + currentPass + "/" + targetPasses + ")";
+      }
+      if (statsTime) {
+        statsTime.textContent = Math.round(totalRenderMs) + " ms (" + Math.round(elapsed) + " ms/pass)";
+      }
+      if (statsRuns) {
+        statsRuns.textContent = "#" + renderCount;
+      }
+      if (progressFill) {
+        const pct = Math.min(100, Math.round((currentPass / targetPasses) * 100));
+        progressFill.style.width = pct + "%";
+      }
+      if (statusText) {
+        if (currentPass < targetPasses) {
+          statusText.textContent = "Tracing global illumination paths in WebAssembly (" + currentSpp + "/" + (targetPasses * 4) + " spp)...";
+        } else {
+          statusText.textContent = "Render complete (" + width + "×" + height + " @ " + currentSpp + " spp via C++ WebAssembly)";
+        }
+      }
+    }
+
+    function scheduleRemainingPasses() {
+      if (currentPass < targetPasses) {
+        rafId = requestAnimationFrame(function () {
+          rafId = null;
+          executePassSync();
+          scheduleRemainingPasses();
+        });
+      }
+    }
+
+    function startNewRender() {
+      if (!wasmExports) return;
+      cancelProgressiveRender();
+      renderCount += 1;
+      currentPass = 0;
+      totalRenderMs = 0;
+      wasmExports.reset_accumulation(width, height);
+      updateSphereSwatches();
+      // Always execute the first pass synchronously so the canvas updates immediately
+      executePassSync();
+      scheduleRemainingPasses();
+    }
+
+    function handleRandomizeClick() {
+      const runRandomize = function () {
+        cancelProgressiveRender();
+        const randomSeed = ((Date.now() & 0x7fffffff) ^ ((Math.random() * 0x7fffffff) | 0) ^ (renderCount * 2654435761)) >>> 0;
+        wasmExports.randomize_sphere_colors(randomSeed || 1);
+        startNewRender();
+      };
+
+      if (wasmExports) {
+        runRandomize();
+      } else {
+        loadSmallptWasm(wasmUrl).then(runRandomize);
+      }
+    }
+
+    function handleResetClick() {
+      const runReset = function () {
+        cancelProgressiveRender();
+        wasmExports.reset_sphere_colors();
+        startNewRender();
+      };
+
+      if (wasmExports) {
+        runReset();
+      } else {
+        loadSmallptWasm(wasmUrl).then(runReset);
+      }
+    }
+
+    if (randomizeBtn) {
+      randomizeBtn.addEventListener("click", handleRandomizeClick);
+    }
+    if (resetBtn) {
+      resetBtn.addEventListener("click", handleResetClick);
+    }
+    if (resolutionSelect) {
+      resolutionSelect.addEventListener("change", function (e) {
+        const parts = e.target.value.split("x");
+        width = parseInt(parts[0], 10) || 256;
+        height = parseInt(parts[1], 10) || 192;
+        canvas.width = width;
+        canvas.height = height;
+        startNewRender();
+      });
+    }
+    if (samplesSelect) {
+      samplesSelect.addEventListener("change", function (e) {
+        targetSpp = parseInt(e.target.value, 10) || 16;
+        targetPasses = Math.max(1, Math.round(targetSpp / 4));
+        if (currentPass < targetPasses) {
+          scheduleRemainingPasses();
+        } else {
+          startNewRender();
+        }
+      });
+    }
+
+    loadSmallptWasm(wasmUrl).then(function () {
+      startNewRender();
+    }).catch(function (err) {
+      if (statusText) {
+        statusText.textContent = "Error initializing WebAssembly: " + err.message;
+      }
+      console.error(err);
+    });
+  }
+
+  if (typeof window !== "undefined") {
+    window.initSmallptApp = initSmallptApp;
+    window.loadSmallptWasm = loadSmallptWasm;
+    if (document.readyState === "loading") {
+      document.addEventListener("DOMContentLoaded", initSmallptApp);
+    } else {
+      initSmallptApp();
+    }
+    document.addEventListener("astro:page-load", initSmallptApp);
+  }
+})();
