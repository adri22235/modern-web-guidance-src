+import initSmallpt from './smallpt.js';
+
+interface SmallptWasmModule {
+  _render_scene: (outRgbaPtr: number, w: number, h: number, samps: number) => void;
+  _render_rows: (
+    outRgbaPtr: number,
+    accumRgbPtr: number,
+    w: number,
+    h: number,
+    startY: number,
+    endY: number,
+    samps: number,
+    pass: number,
+  ) => void;
+  _randomize_sphere_colors: (seed: number) => void;
+  _reset_sphere_colors: () => void;
+  _set_sphere_color: (index: number, r: number, g: number, b: number) => void;
+  _get_sphere_color_channel: (index: number, channel: number) => number;
+  _malloc: (bytes: number) => number;
+  _free: (ptr: number) => void;
+  HEAPU8: Uint8Array;
+  HEAPF64: Float64Array;
+}
+
+export interface SpherePaletteItem {
+  index: number;
+  name: string;
+  material: string;
+  r: number;
+  g: number;
+  b: number;
+}
+
+const SPHERE_METADATA = [
+  { index: 0, name: 'Left Wall', material: 'Diffuse' },
+  { index: 1, name: 'Right Wall', material: 'Diffuse' },
+  { index: 2, name: 'Back Wall', material: 'Diffuse' },
+  { index: 4, name: 'Floor', material: 'Diffuse' },
+  { index: 5, name: 'Ceiling', material: 'Diffuse' },
+  { index: 6, name: 'Left Sphere', material: 'Mirror' },
+  { index: 7, name: 'Right Sphere', material: 'Glass' },
+];
+
+let wasmPromise: Promise<SmallptWasmModule> | null = null;
+let currentJobId = 0;
+
+function getWasm(): Promise<SmallptWasmModule> {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt() as Promise<SmallptWasmModule>;
+  }
+  return wasmPromise;
+}
+
+function readPalette(wasm: SmallptWasmModule): SpherePaletteItem[] {
+  return SPHERE_METADATA.map((meta) => ({
+    ...meta,
+    r: wasm._get_sphere_color_channel(meta.index, 0),
+    g: wasm._get_sphere_color_channel(meta.index, 1),
+    b: wasm._get_sphere_color_channel(meta.index, 2),
+  }));
+}
+
+async function runRenderJob(
+  jobId: number,
+  width: number,
+  height: number,
+  sampsPerPass: number,
+  totalPasses: number,
+  mode: 'default' | 'random' | 'keep',
+  seed: number,
+  customColors?: Array<{ index: number; r: number; g: number; b: number }>,
+) {
+  const wasm = await getWasm();
+  if (jobId !== currentJobId) return;
+
+  if (mode === 'default') {
+    wasm._reset_sphere_colors();
+  } else if (mode === 'random') {
+    wasm._randomize_sphere_colors(seed || Math.floor(Math.random() * 0xffffffff) || 1);
+  }
+
+  if (customColors && Array.isArray(customColors)) {
+    for (const c of customColors) {
+      wasm._set_sphere_color(c.index, c.r, c.g, c.b);
+    }
+  }
+
+  const palette = readPalette(wasm);
+  self.postMessage({
+    type: 'palette',
+    jobId,
+    palette,
+  });
+
+  const rgbaByteLength = width * height * 4;
+  const accumByteLength = width * height * 3 * 8;
+  const rgbaPtr = wasm._malloc(rgbaByteLength);
+  const accumPtr = wasm._malloc(accumByteLength);
+
+  const startTime = performance.now();
+  const rowsPerChunk = Math.max(8, Math.floor(height / 8));
+
+  try {
+    for (let pass = 1; pass <= totalPasses; pass++) {
+      for (let startY = 0; startY < height; startY += rowsPerChunk) {
+        if (jobId !== currentJobId) return;
+
+        const endY = Math.min(height, startY + rowsPerChunk);
+        wasm._render_rows(rgbaPtr, accumPtr, width, height, startY, endY, sampsPerPass, pass);
+
+        const pixels = new Uint8ClampedArray(
+          wasm.HEAPU8.buffer,
+          rgbaPtr,
+          rgbaByteLength,
+        ).slice();
+
+        const completedRows = (pass - 1) * height + endY;
+        const totalRows = totalPasses * height;
+        const progress = Math.min(100, Math.round((completedRows / totalRows) * 100));
+        const currentSpp = pass * sampsPerPass * 4;
+        const totalSpp = totalPasses * sampsPerPass * 4;
+        const elapsedMs = performance.now() - startTime;
+
+        self.postMessage(
+          {
+            type: 'frame',
+            jobId,
+            pixels,
+            width,
+            height,
+            pass,
+            totalPasses,
+            currentSpp,
+            totalSpp,
+            progress,
+            elapsedMs,
+            done: pass === totalPasses && endY === height,
+          },
+          [pixels.buffer],
+        );
+
+        // Yield cleanly inside the worker so incoming abort/restart messages can be processed
+        await new Promise((resolve) => setTimeout(resolve, 0));
+      }
+    }
+  } finally {
+    wasm._free(rgbaPtr);
+    wasm._free(accumPtr);
+  }
+}
+
+self.addEventListener('message', (event: MessageEvent) => {
+  const data = event.data;
+  if (!data) return;
+
+  if (data.type === 'render') {
+    currentJobId++;
+    const jobId = currentJobId;
+    const width = data.width || 320;
+    const height = data.height || 240;
+    const sampsPerPass = data.sampsPerPass || 1;
+    const totalPasses = data.totalPasses || 4;
+    const mode = data.mode || 'keep';
+    const seed = data.seed || Math.floor(Math.random() * 0xffffffff) + 1;
+
+    runRenderJob(jobId, width, height, sampsPerPass, totalPasses, mode, seed, data.customColors).catch(
+      (err) => {
+        self.postMessage({
+          type: 'error',
+          jobId,
+          message: err instanceof Error ? err.message : String(err),
+        });
+      },
+    );
+  } else if (data.type === 'stop') {
+    currentJobId++;
+  }
+});
