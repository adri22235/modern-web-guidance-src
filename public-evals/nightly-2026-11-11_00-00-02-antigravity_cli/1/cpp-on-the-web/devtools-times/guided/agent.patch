@@ -0,0 +1,334 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+import type { SpherePaletteItem } from '../wasm/smallpt.worker';
+
+const DEFAULT_PALETTE: SpherePaletteItem[] = [
+  { index: 0, name: 'Left Wall', material: 'Diffuse', r: 0.75, g: 0.25, b: 0.25 },
+  { index: 1, name: 'Right Wall', material: 'Diffuse', r: 0.25, g: 0.25, b: 0.75 },
+  { index: 2, name: 'Back Wall', material: 'Diffuse', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 4, name: 'Floor', material: 'Diffuse', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 5, name: 'Ceiling', material: 'Diffuse', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 6, name: 'Left Sphere', material: 'Mirror', r: 0.999, g: 0.999, b: 0.999 },
+  { index: 7, name: 'Right Sphere', material: 'Glass', r: 0.999, g: 0.999, b: 0.999 },
+];
+
+function toCssHex(r: number, g: number, b: number): string {
+  // Apply gamma 2.2 encoding like smallpt's toInt() so swatch matches rendered appearance
+  const toByte = (v: number) => {
+    const clamped = Math.max(0, Math.min(1, v));
+    return Math.min(255, Math.floor(Math.pow(clamped, 1 / 2.2) * 255 + 0.5));
+  };
+  const hex = (n: number) => n.toString(16).padStart(2, '0');
+  return `#${hex(toByte(r))}${hex(toByte(g))}${hex(toByte(b))}`;
+}
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+
+  const [resolutionPreset, setResolutionPreset] = useState<'256x192' | '320x240' | '512x384'>('320x240');
+  const [samplesPreset, setSamplesPreset] = useState<number>(16); // Total SPP = passes * sampsPerPass * 4
+  const [isRendering, setIsRendering] = useState<boolean>(false);
+  const [progress, setProgress] = useState<number>(0);
+  const [currentSpp, setCurrentSpp] = useState<number>(0);
+  const [totalSpp, setTotalSpp] = useState<number>(16);
+  const [elapsedMs, setElapsedMs] = useState<number>(0);
+  const [palette, setPalette] = useState<SpherePaletteItem[]>(DEFAULT_PALETTE);
+  const [renderCount, setRenderCount] = useState<number>(0);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const parseDimensions = (preset: string) => {
+    const [w, h] = preset.split('x').map(Number);
+    return { width: w || 320, height: h || 240 };
+  };
+
+  const triggerRender = useCallback(
+    (
+      mode: 'default' | 'random' | 'keep',
+      resOverride?: '256x192' | '320x240' | '512x384',
+      sppOverride?: number,
+    ) => {
+      if (!workerRef.current) return;
+      const { width, height } = parseDimensions(resOverride || resolutionPreset);
+      const targetSpp = sppOverride || samplesPreset;
+      // Each pass in smallpt computes 2x2 subpixels = 4 * sampsPerPass spp
+      const sampsPerPass = 1;
+      const totalPasses = Math.max(1, Math.round(targetSpp / 4));
+
+      setIsRendering(true);
+      setProgress(0);
+      setErrorMessage(null);
+      setTotalSpp(totalPasses * sampsPerPass * 4);
+
+      const randomBuffer = new Uint32Array(1);
+      crypto.getRandomValues(randomBuffer);
+      const seed = randomBuffer[0] || Date.now();
+
+      workerRef.current.postMessage({
+        type: 'render',
+        width,
+        height,
+        sampsPerPass,
+        totalPasses,
+        mode,
+        seed,
+      });
+    },
+    [resolutionPreset, samplesPreset],
+  );
+
+  useEffect(() => {
+    const worker = new Worker(new URL('../wasm/smallpt.worker.ts', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent) => {
+      const data = event.data;
+      if (!data) return;
+
+      if (data.type === 'palette') {
+        setPalette(data.palette);
+      } else if (data.type === 'frame') {
+        const canvas = canvasRef.current;
+        if (canvas) {
+          if (canvas.width !== data.width || canvas.height !== data.height) {
+            canvas.width = data.width;
+            canvas.height = data.height;
+          }
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const imageData = new ImageData(data.pixels, data.width, data.height);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+        setProgress(data.progress);
+        setCurrentSpp(data.currentSpp);
+        setTotalSpp(data.totalSpp);
+        setElapsedMs(data.elapsedMs);
+        if (data.done) {
+          setIsRendering(false);
+          setRenderCount((c) => c + 1);
+        }
+      } else if (data.type === 'error') {
+        setErrorMessage(data.message || 'WebAssembly path tracer error');
+        setIsRendering(false);
+      }
+    };
+
+    // Start initial default scene render on mount
+    triggerRender('default');
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, []);
+
+  const handleRandomizeClick = () => {
+    triggerRender('random');
+  };
+
+  const handleResetClick = () => {
+    triggerRender('default');
+  };
+
+  const handleResolutionChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const nextRes = e.target.value as '256x192' | '320x240' | '512x384';
+    setResolutionPreset(nextRes);
+    triggerRender('keep', nextRes, samplesPreset);
+  };
+
+  const handleSamplesChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const nextSpp = Number(e.target.value);
+    setSamplesPreset(nextSpp);
+    triggerRender('keep', resolutionPreset, nextSpp);
+  };
+
+  const { width, height } = parseDimensions(resolutionPreset);
+
+  return (
+    <section
+      aria-labelledby="smallpt-heading"
+      className="bg-white border border-gray-300 shadow-sm my-6 p-5 md:p-8"
+    >
+      <div className="flex flex-col md:flex-row md:items-end justify-between border-b-2 border-gray-900 pb-4 mb-6 gap-4">
+        <div>
+          <span className="text-xs font-bold uppercase tracking-widest text-amber-800 block mb-1">
+            Interactive Graphics Lab • WebAssembly C++
+          </span>
+          <h2 id="smallpt-heading" className="text-2xl md:text-3xl font-brand text-gray-900">
+            smallpt: Global Illumination Path Tracer in WebAssembly
+          </h2>
+          <p className="text-sm text-gray-600 mt-1 max-w-2xl">
+            Kevin Beason&apos;s classic 99-line C++ Monte Carlo path tracer compiled to WebAssembly
+            with Emscripten, featuring full global illumination, soft shadows, specular reflection,
+            and glass refraction.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            type="button"
+            id="randomize-spheres-btn"
+            onClick={handleRandomizeClick}
+            className="inline-flex items-center justify-center gap-2 bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-semibold text-sm px-4 py-2.5 rounded shadow-sm transition-colors cursor-pointer"
+          >
+            <svg
+              aria-hidden="true"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth="2"
+              stroke="currentColor"
+              className="w-4 h-4"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
+              />
+            </svg>
+            <span>Randomize Sphere Colors &amp; Re-run</span>
+          </button>
+
+          <button
+            type="button"
+            id="reset-spheres-btn"
+            onClick={handleResetClick}
+            className="inline-flex items-center justify-center bg-gray-800 hover:bg-gray-700 text-white font-semibold text-sm px-3.5 py-2.5 rounded transition-colors cursor-pointer"
+          >
+            Reset Cornell Box
+          </button>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
+        {/* Canvas output column */}
+        <div className="lg:col-span-8 flex flex-col items-center bg-gray-950 rounded-lg p-3 md:p-4 border border-gray-800 shadow-inner">
+          <div className="relative w-full flex justify-center">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={width}
+              height={height}
+              aria-label="smallpt path-traced Cornell box scene rendered in WebAssembly"
+              role="img"
+              className="w-full max-w-[640px] aspect-[4/3] bg-black rounded border border-gray-800"
+              style={{ imageRendering: 'auto' }}
+            />
+          </div>
+
+          {/* Progress & Telemetry Bar */}
+          <div className="w-full max-w-[640px] mt-3">
+            <div className="flex justify-between items-center text-xs text-gray-300 font-mono mb-1.5">
+              <span>
+                {isRendering
+                  ? `Path Tracing (${currentSpp}/${totalSpp} spp)...`
+                  : `Render Complete (${totalSpp} spp)`}
+              </span>
+              <span>
+                {progress}% • {(elapsedMs / 1000).toFixed(2)}s ({width}×{height})
+              </span>
+            </div>
+            <progress
+              aria-label="Path tracer rendering progress"
+              value={progress}
+              max={100}
+              className="w-full h-2 rounded overflow-hidden accent-amber-500 bg-gray-800"
+            />
+          </div>
+
+          {errorMessage && (
+            <div role="alert" className="mt-3 text-xs text-red-400 bg-red-950/60 px-3 py-2 rounded w-full">
+              {errorMessage}
+            </div>
+          )}
+        </div>
+
+        {/* Controls & Active Sphere Palette Column */}
+        <div className="lg:col-span-4 flex flex-col gap-5 bg-gray-50 p-4 md:p-5 rounded-lg border border-gray-200">
+          <div>
+            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-800 border-b border-gray-200 pb-2 mb-3">
+              Render Settings
+            </h3>
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <label
+                  htmlFor="smallpt-resolution"
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Resolution
+                </label>
+                <select
+                  id="smallpt-resolution"
+                  value={resolutionPreset}
+                  onChange={handleResolutionChange}
+                  className="w-full rounded border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-900"
+                >
+                  <option value="256x192">256 × 192 (Fast)</option>
+                  <option value="320x240">320 × 240 (Balanced)</option>
+                  <option value="512x384">512 × 384 (HD)</option>
+                </select>
+              </div>
+
+              <div>
+                <label
+                  htmlFor="smallpt-samples"
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Samples / Pixel
+                </label>
+                <select
+                  id="smallpt-samples"
+                  value={samplesPreset}
+                  onChange={handleSamplesChange}
+                  className="w-full rounded border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-900"
+                >
+                  <option value={8}>8 spp (Preview)</option>
+                  <option value={16}>16 spp (Standard)</option>
+                  <option value={32}>32 spp (Refined)</option>
+                  <option value={64}>64 spp (High Quality)</option>
+                </select>
+              </div>
+            </div>
+          </div>
+
+          <div>
+            <div className="flex items-center justify-between border-b border-gray-200 pb-2 mb-3">
+              <h3 className="text-sm font-bold uppercase tracking-wider text-gray-800">
+                Scene Sphere Colors
+              </h3>
+              <span className="text-xs text-gray-500 font-mono">Run #{renderCount}</span>
+            </div>
+            <ul className="space-y-2" aria-label="Active sphere colors in scene">
+              {palette.map((sphere) => {
+                const hex = toCssHex(sphere.r, sphere.g, sphere.b);
+                return (
+                  <li
+                    key={sphere.index}
+                    className="flex items-center justify-between text-xs bg-white px-3 py-2 rounded border border-gray-200"
+                  >
+                    <div className="flex items-center gap-2.5">
+                      <span
+                        aria-hidden="true"
+                        className="w-4 h-4 rounded-full border border-gray-400 flex-shrink-0 shadow-xs"
+                        style={{ backgroundColor: hex }}
+                      />
+                      <span className="font-semibold text-gray-800">{sphere.name}</span>
+                      <span className="text-[11px] text-gray-500 px-1.5 py-0.5 bg-gray-100 rounded">
+                        {sphere.material}
+                      </span>
+                    </div>
+                    <code className="text-[11px] font-mono text-gray-600">
+                      ({sphere.r.toFixed(2)}, {sphere.g.toFixed(2)}, {sphere.b.toFixed(2)})
+                    </code>
+                  </li>
+                );
+              })}
+            </ul>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
