+  <script>
+    function toBuffer(val) {
+      if (!val) return new Uint8Array(0);
+      if (val instanceof Uint8Array) return val;
+      if (val instanceof ArrayBuffer) return new Uint8Array(val);
+      if (ArrayBuffer.isView(val)) {
+        return new Uint8Array(val.buffer, val.byteOffset, val.byteLength);
+      }
+      if (Array.isArray(val)) return new Uint8Array(val);
+      if (typeof val === 'object' && Array.isArray(val.data)) {
+        return new Uint8Array(val.data);
+      }
+      if (typeof val === 'string') {
+        const base64 = val.replace(/-/g, '+').replace(/_/g, '/');
+        const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+        try {
+          const binary = atob(base64 + pad);
+          const bytes = new Uint8Array(binary.length);
+          for (let i = 0; i < binary.length; i++) {
+            bytes[i] = binary.charCodeAt(i);
+          }
+          return bytes;
+        } catch {
+          return new TextEncoder().encode(val);
+        }
+      }
+      return new Uint8Array(0);
+    }
+
+    function bufferToBase64Url(buf) {
+      if (!buf) return null;
+      if (typeof buf === 'string') return buf;
+      const bytes = buf instanceof Uint8Array
+        ? buf
+        : ArrayBuffer.isView(buf)
+          ? new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength)
+          : new Uint8Array(buf);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    if (reauthButton) {
+      reauthButton.addEventListener('click', async () => {
+        if (reauthStatus) {
+          reauthStatus.textContent = 'Requesting authentication challenge...';
+        }
+        try {
+          const optionsRes = await fetch('/api/reauth/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+          });
+
+          if (!optionsRes.ok) {
+            throw new Error('Failed to fetch re-authentication options');
+          }
+
+          const rawOptions = await optionsRes.json();
+          const opts = rawOptions.publicKey || rawOptions;
+
+          const allowCredentials = (opts.allowCredentials || opts.credentials || []).map((cred) => {
+            if (typeof cred === 'string') {
+              return { type: 'public-key', id: toBuffer(cred) };
+            }
+            return {
+              ...cred,
+              type: cred.type || 'public-key',
+              id: toBuffer(cred.id),
+            };
+          });
+
+          const publicKey = {
+            ...opts,
+            challenge: toBuffer(opts.challenge),
+            allowCredentials,
+            userVerification: opts.userVerification || 'preferred',
+          };
+
+          const assertion = await navigator.credentials.get({ publicKey });
+          if (!assertion) {
+            throw new Error('No credential assertion returned');
+          }
+
+          const assertionResponse = assertion.response || {};
+          const payload = {
+            id: assertion.id,
+            rawId: assertion.rawId ? bufferToBase64Url(assertion.rawId) : assertion.id,
+            type: assertion.type || 'public-key',
+            authenticatorAttachment: assertion.authenticatorAttachment || undefined,
+            clientExtensionResults:
+              typeof assertion.getClientExtensionResults === 'function'
+                ? assertion.getClientExtensionResults()
+                : {},
+            response: {
+              authenticatorData: bufferToBase64Url(assertionResponse.authenticatorData),
+              clientDataJSON: bufferToBase64Url(assertionResponse.clientDataJSON),
+              signature: bufferToBase64Url(assertionResponse.signature),
+              userHandle: assertionResponse.userHandle
+                ? bufferToBase64Url(assertionResponse.userHandle)
+                : null,
+            },
+          };
+
+          const verifyRes = await fetch('/api/reauth/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify(payload),
+          });
+
+          if (!verifyRes.ok) {
+            throw new Error('Re-authentication verification failed');
+          }
+
+          if (reauthStatus) {
+            reauthStatus.textContent = 'Identity verified successfully.';
+          }
+        } catch (err) {
+          if (reauthStatus) {
+            reauthStatus.textContent = err && err.message ? err.message : 'Verification failed.';
+          }
+        }
+      });
+    }
+  </script>
