+    /* Loyalty Rewards Section */
+    .rewards-section {
+      margin-top: 50px;
+    }
+
+    .rewards-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+      color: var(--primary);
+    }
+
+    .rewards-card {
+      background: white;
+      padding: 35px 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      border-top: 4px solid var(--accent);
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      width: 180px;
+      height: 180px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-shrink: 0;
+    }
+
+    .progress-ring {
+      width: 180px;
+      height: 180px;
+      transform: rotate(-90deg);
+    }
+
+    .progress-ring__track {
+      fill: transparent;
+      stroke: var(--secondary);
+      stroke-width: 14;
+    }
+
+    .progress-ring__fill {
+      fill: transparent;
+      stroke: var(--accent);
+      stroke-width: 14;
+      stroke-linecap: round;
+      /* Circumference = 2 * PI * 76 ≈ 477.52; 75% progress (3 of 4 or 7.5/10 -> let's use 8/10 = 80%: offset = 477.52 * (1 - 0.8) = 95.5) */
+      stroke-dasharray: 477.52;
+      stroke-dashoffset: 95.5;
+      transition: stroke-dashoffset 0.6s ease;
+    }
+
+    .progress-ring-center {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      padding: 20px;
+    }
+
+    .progress-count {
+      font-size: 1.9rem;
+      font-weight: bold;
+      color: var(--primary);
+      line-height: 1.1;
+    }
+
+    .progress-unit {
+      font-size: 0.85rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      color: var(--text);
+      margin-top: 4px;
+    }
+
+    .progress-subtext {
+      font-size: 0.75rem;
+      color: var(--primary);
+      background: var(--secondary);
+      padding: 2px 8px;
+      border-radius: 12px;
+      margin-top: 6px;
+      font-weight: 600;
+    }
+
+    .rewards-details {
+      flex: 1;
+      min-width: 260px;
+      max-width: 520px;
+      text-align: left;
+    }
+
+    .rewards-badge {
+      display: inline-block;
+      background: var(--secondary);
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: bold;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      padding: 4px 10px;
+      border-radius: 4px;
+      margin-bottom: 10px;
+    }
+
+    .rewards-details h3 {
+      font-size: 1.5rem;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .rewards-details p {
+      color: var(--text);
+      margin-bottom: 15px;
+    }
+
+    .rewards-milestones {
+      list-style: none;
+      display: flex;
+      gap: 15px;
+      flex-wrap: wrap;
+      margin-bottom: 10px;
+      font-size: 0.9rem;
+    }
+
+    .rewards-milestones li {
+      background: var(--light);
+      border: 1px solid var(--secondary);
+      padding: 6px 12px;
+      border-radius: 5px;
+      color: var(--text);
+    }
+
+    .rewards-milestones li strong {
+      color: var(--primary);
+    }
