+  <script>
+    const progress = document.getElementById("reward-progress");
+    const progressCount = document.getElementById("reward-progress-count");
+    const rewardHeading = document.getElementById("reward-heading");
+    const addDrinkBtn = document.getElementById("add-drink-btn");
+
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value"));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+    }
+
+    const totalDrinks = 10;
+    let currentDrinks = 8;
+
+    addDrinkBtn.addEventListener("click", () => {
+      currentDrinks = currentDrinks < totalDrinks ? currentDrinks + 1 : 0;
+      const percentage = Math.round((currentDrinks / totalDrinks) * 100);
+      const valueText = `${currentDrinks} of ${totalDrinks} drinks`;
+
+      progress.setAttribute("value", String(percentage));
+      progress.setAttribute("aria-valuetext", valueText);
+      progressCount.textContent = `${currentDrinks} of ${totalDrinks}`;
+
+      const remaining = totalDrinks - currentDrinks;
+      if (remaining === 0) {
+        rewardHeading.textContent = "Free Drink Unlocked! Ready to Redeem";
+        addDrinkBtn.textContent = "Claim Free Drink";
+      } else {
+        rewardHeading.textContent = `${remaining} ${remaining === 1 ? "Drink" : "Drinks"} Away from Your Next Free Cup`;
+        addDrinkBtn.textContent = "Log a Drink";
+      }
+    });
+  </script>
