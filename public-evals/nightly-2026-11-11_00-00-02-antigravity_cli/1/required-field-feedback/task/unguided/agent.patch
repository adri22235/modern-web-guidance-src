+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-list-email');
+      const errorEl = document.getElementById('mailing-list-error');
+      const successEl = document.getElementById('mailing-list-success');
+
+      if (!form || !emailInput || !errorEl) return;
+
+      let hasTyped = false;
+      let showingError = false;
+
+      function getValidationError(value) {
+        const trimmed = value.trim();
+        if (!trimmed) {
+          return 'Please enter your email address.';
+        }
+        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+        if (emailInput.validity.typeMismatch || !emailPattern.test(trimmed)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(message) {
+        showingError = true;
+        emailInput.classList.add('input-error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = message;
+        errorEl.hidden = false;
+        errorEl.classList.add('visible');
+        if (successEl) {
+          successEl.hidden = true;
+          successEl.classList.remove('visible');
+          successEl.textContent = '';
+        }
+      }
+
+      function clearError() {
+        showingError = false;
+        emailInput.classList.remove('input-error');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+        errorEl.classList.remove('visible');
+      }
+
+      function validateField() {
+        const errorMessage = getValidationError(emailInput.value);
+        if (errorMessage) {
+          showError(errorMessage);
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      emailInput.addEventListener('input', function () {
+        hasTyped = true;
+        if (successEl && !successEl.hidden) {
+          successEl.hidden = true;
+          successEl.classList.remove('visible');
+          successEl.textContent = '';
+        }
+
+        if (emailInput.value.trim() === '') {
+          showError('Please enter your email address.');
+        } else if (showingError) {
+          validateField();
+        }
+      });
+
+      emailInput.addEventListener('blur', function () {
+        validateField();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        validateField();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const isValid = validateField();
+        if (!isValid) {
+          emailInput.focus();
+          return;
+        }
+
+        emailInput.value = '';
+        hasTyped = false;
+        clearError();
+        if (successEl) {
+          successEl.textContent = 'Thank you for subscribing to our mailing list!';
+          successEl.hidden = false;
+          successEl.classList.add('visible');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
