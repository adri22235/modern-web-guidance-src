+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const roastSelect = document.getElementById("roast-picker");
+      if (!roastSelect) return;
+
+      // Intercept Left/Right arrow keys for horizontal navigation across the 3-column grid picker
+      roastSelect.addEventListener("keydown", (event) => {
+        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
+
+        const options = Array.from(roastSelect.querySelectorAll("option"));
+        const activeOption = document.activeElement?.tagName === "OPTION"
+          ? document.activeElement
+          : roastSelect.querySelector("option:checked") || options[0];
+
+        if (!activeOption) return;
+        const activeRect = activeOption.getBoundingClientRect();
+        // Only apply geometric horizontal navigation when the picker is open and options have layout geometry
+        if (activeRect.width === 0 && activeRect.height === 0) return;
+
+        const isRight = event.key === "ArrowRight";
+        let bestCandidate = null;
+        let bestDistance = Infinity;
+
+        for (const option of options) {
+          if (option === activeOption) continue;
+          const rect = option.getBoundingClientRect();
+          const dx = rect.left - activeRect.left;
+          if (isRight ? dx > 4 : dx < -4) {
+            const distance = Math.hypot(dx, rect.top - activeRect.top);
+            if (distance < bestDistance) {
+              bestDistance = distance;
+              bestCandidate = option;
+            }
+          }
+        }
+
+        if (bestCandidate) {
+          event.preventDefault();
+          bestCandidate.focus();
+          bestCandidate.selected = true;
+          roastSelect.dispatchEvent(new Event("change", { bubbles: true }));
+        }
+      });
+    });
+  </script>
