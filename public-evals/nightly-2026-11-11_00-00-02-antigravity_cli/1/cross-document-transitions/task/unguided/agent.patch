+  <script>
+    (function () {
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function normalizePath(urlStr) {
+        try {
+          const url = new URL(urlStr, window.location.origin);
+          return url.pathname === '/' ? '/index.html' : url.pathname;
+        } catch {
+          return '';
+        }
+      }
+
+      function applyDirection(direction, viewTransition) {
+        if (!direction) return;
+        const root = document.documentElement;
+        root.dataset.direction = direction;
+        root.classList.remove('transition-next', 'transition-previous');
+        root.classList.add('transition-' + direction);
+
+        if (viewTransition) {
+          if (reducedMotionQuery.matches) {
+            if (typeof viewTransition.skipTransition === 'function') {
+              viewTransition.skipTransition();
+            }
+            return;
+          }
+          if (viewTransition.types) {
+            viewTransition.types.clear();
+            viewTransition.types.add(direction);
+            viewTransition.types.add(direction === 'next' ? 'forwards' : 'backwards');
+          }
+        }
+      }
+
+      function detectDirectionOnOutgoing(activation) {
+        const storedClick = sessionStorage.getItem('pendingTransitionDirection');
+        if (storedClick === 'next' || storedClick === 'previous') {
+          sessionStorage.removeItem('pendingTransitionDirection');
+          return storedClick;
+        }
+
+        if (activation && activation.entry && activation.entry.url) {
+          const targetPath = normalizePath(activation.entry.url);
+          const nextEl = document.getElementById('next');
+          const prevEl = document.getElementById('previous');
+          if (nextEl && normalizePath(nextEl.href) === targetPath) {
+            return 'next';
+          }
+          if (prevEl && normalizePath(prevEl.href) === targetPath) {
+            return 'previous';
+          }
+        }
+
+        return sessionStorage.getItem('transitionDirection') || 'next';
+      }
+
+      function detectDirectionOnIncoming() {
+        const stored = sessionStorage.getItem('transitionDirection');
+        if (stored === 'next' || stored === 'previous') {
+          return stored;
+        }
+
+        const activation = window.navigation && window.navigation.activation;
+        if (activation && activation.from && activation.from.url) {
+          const fromPath = normalizePath(activation.from.url);
+          const prevEl = document.getElementById('previous');
+          const nextEl = document.getElementById('next');
+          if (prevEl && normalizePath(prevEl.href) === fromPath) {
+            return 'next';
+          }
+          if (nextEl && normalizePath(nextEl.href) === fromPath) {
+            return 'previous';
+          }
+        }
+
+        return null;
+      }
+
+      const initialDirection = sessionStorage.getItem('transitionDirection');
+      if (initialDirection) {
+        applyDirection(initialDirection, null);
+      }
+
+      window.addEventListener('pageswap', function (event) {
+        const direction = detectDirectionOnOutgoing(event.activation);
+        if (direction) {
+          sessionStorage.setItem('transitionDirection', direction);
+          applyDirection(direction, event.viewTransition);
+        }
+      });
+
+      window.addEventListener('pagereveal', function (event) {
+        const direction = detectDirectionOnIncoming();
+        if (direction) {
+          sessionStorage.setItem('transitionDirection', direction);
+          applyDirection(direction, event.viewTransition);
+        } else if (reducedMotionQuery.matches && event.viewTransition && typeof event.viewTransition.skipTransition === 'function') {
+          event.viewTransition.skipTransition();
+        }
+      });
+
+      window.addEventListener('click', function (event) {
+        const link = event.target && event.target.closest ? event.target.closest('#previous, #next') : null;
+        if (!link) return;
+        const direction = link.id === 'previous' ? 'previous' : 'next';
+        sessionStorage.setItem('pendingTransitionDirection', direction);
+        sessionStorage.setItem('transitionDirection', direction);
+        applyDirection(direction, null);
+      }, true);
+    })();
+  </script>
