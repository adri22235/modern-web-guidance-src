+  <link rel="expect" href="#main-content" blocking="render">
+  <script blocking="render">
+    function getTransitionDirection(fromEntry, toEntry) {
+      if (fromEntry?.url && toEntry?.url) {
+        const fromUrl = new URL(fromEntry.url);
+        const toUrl = new URL(toEntry.url);
+        const fromPage = Number(fromUrl.searchParams.get('page') ?? 1);
+        const toPage = Number(toUrl.searchParams.get('page') ?? 1);
+        if (toPage < fromPage) {
+          return 'previous';
+        }
+        if (toPage > fromPage) {
+          return 'next';
+        }
+      }
+      return sessionStorage.getItem('transitionDirection') || 'next';
+    }
+
+    window.addEventListener('pagereveal', (e) => {
+      if (!e.viewTransition) return;
+
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        e.viewTransition.skipTransition();
+        return;
+      }
+
+      if (window.navigation?.activation) {
+        const transitionType = getTransitionDirection(
+          window.navigation.activation.from,
+          window.navigation.activation.entry
+        );
+        if (transitionType === 'previous') {
+          e.viewTransition.types.add('previous');
+          e.viewTransition.types.add('backward');
+        } else {
+          e.viewTransition.types.add('next');
+          e.viewTransition.types.add('forward');
+        }
+      } else {
+        const fallbackType = sessionStorage.getItem('transitionDirection') || 'next';
+        if (fallbackType === 'previous') {
+          e.viewTransition.types.add('previous');
+          e.viewTransition.types.add('backward');
+        } else {
+          e.viewTransition.types.add('next');
+          e.viewTransition.types.add('forward');
+        }
+      }
+    });
+  </script>
   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      @view-transition {
+        navigation: none;
+      }
+
+      ::view-transition-group(root),
+      ::view-transition-old(root),
+      ::view-transition-new(root) {
+        animation: none !important;
+      }
+    }
+
+    @keyframes slide-to-left {
+      to {
+        transform: translateX(-100%);
+      }
+    }
+
+    @keyframes slide-from-right {
+      from {
+        transform: translateX(100%);
+      }
+    }
+
+    @keyframes slide-to-right {
+      to {
+        transform: translateX(100%);
+      }
+    }
+
+    @keyframes slide-from-left {
+      from {
+        transform: translateX(-100%);
+      }
+    }
+
+    ::view-transition-group(root) {
+      animation: 0.4s ease-in-out both;
+    }
+
+    ::view-transition-old(root),
+    ::view-transition-new(root) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-old(root),
+    html:active-view-transition-type(next)::view-transition-old(root) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-new(root),
+    html:active-view-transition-type(next)::view-transition-new(root) {
+      animation-name: slide-from-right;
+    }
+
+    html:active-view-transition-type(backward)::view-transition-old(root),
+    html:active-view-transition-type(previous)::view-transition-old(root) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(backward)::view-transition-new(root),
+    html:active-view-transition-type(previous)::view-transition-new(root) {
+      animation-name: slide-from-left;
+    }
