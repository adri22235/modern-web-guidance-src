+      border-radius: 8px;
+      padding: 12px;
+      flex-shrink: 0;
+      text-align: left;
+    }
+
+    .target {
+      scroll-start-target: auto;
+    }
+
+    .media-card.target {
+      border: 2px solid var(--accent);
+      background: #fff8f0;
+    }
+
+    .media-card img {
+      width: 140px;
+      height: 100px;
+      aspect-ratio: 140 / 100;
+      object-fit: cover;
+      border-radius: 6px;
+      flex-shrink: 0;
+      display: block;
+      background-color: var(--secondary);
+    }
+
+    .media-card-content {
+      flex: 1;
+    }
+
+    .media-card-content h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+      font-size: 1.1rem;
+    }
+
+    .media-card-content p {
+      font-size: 0.92rem;
+      color: var(--text);
+    }
+
+    .media-badge {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.75rem;
+      font-weight: bold;
+      padding: 2px 8px;
+      border-radius: 4px;
+      margin-bottom: 4px;
+    }
+
