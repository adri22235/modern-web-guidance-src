+      letter-spacing: 0.5px;
+    }
+
+    select.roast-select,
+    select.roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 10px 14px;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      background-color: rgba(62, 39, 35, 0.92);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      color: var(--light);
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    select.roast-select:hover {
+      border-color: var(--accent);
+      background-color: #3e2723;
+    }
+
+    select.roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: #2b1b17;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 8px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
+      width: anchor-size(width);
+      color: var(--light);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      color: var(--light);
+    }
+
+    select.roast-select option + option {
+      margin-top: 4px;
+    }
+
+    select.roast-select option:hover {
+      background-color: #4e342e;
+    }
+
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--accent);
+      color: #2b1b17;
+      outline: 2px solid #ffffff;
+      outline-offset: -2px;
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: #3e2723;
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 600;
+      font-size: 0.95rem;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
+    }
