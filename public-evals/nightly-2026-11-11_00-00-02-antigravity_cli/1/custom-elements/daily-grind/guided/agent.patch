+  <script type="module">
+    const cardSheet = new CSSStyleSheet();
+    cardSheet.replaceSync(`
+      :host {
+        display: block;
+        --_card-bg: var(--card-bg, white);
+        --_card-fg: var(--card-fg, var(--text, #3e2723));
+        --_primary: var(--primary, #4e342e);
+        --_accent: var(--accent, #ffab40);
+      }
+
+      :host([disabled]),
+      :host([sold-out]) {
+        opacity: 0.72;
+      }
+
+      .card {
+        background: var(--_card-bg);
+        color: var(--_card-fg);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        position: relative;
+        border: 2px solid transparent;
+        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+      }
+
+      :host([featured]) .card,
+      :host([seasonal]) .card {
+        border-color: var(--_accent);
+      }
+
+      :host(:state(favorited)) .card {
+        box-shadow: 0 4px 12px rgba(78, 52, 46, 0.22);
+      }
+
+      .card-header {
+        display: flex;
+        justify-content: space-between;
+        align-items: center;
+        min-height: 24px;
+        margin-bottom: 8px;
+      }
+
+      .badge {
+        display: inline-block;
+        background: var(--_accent);
+        color: var(--_card-fg);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 2px 8px;
+        border-radius: 999px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      .fav-btn {
+        font: inherit;
+        background: transparent;
+        border: 1px solid #d7ccc8;
+        color: var(--_primary);
+        border-radius: 999px;
+        padding: 2px 10px;
+        font-size: 0.8rem;
+        cursor: pointer;
+        margin-left: auto;
+        transition: background 0.2s, border-color 0.2s;
+      }
+
+      :host(:state(favorited)) .fav-btn {
+        background: #fff3e0;
+        border-color: var(--_accent);
+        font-weight: 600;
+      }
+
+      h3 {
+        margin: 0 0 10px;
+        color: var(--_primary);
+      }
+
+      .description {
+        margin: 0 0 12px;
+        flex-grow: 1;
+      }
+
+      .price {
+        font-weight: 700;
+        color: var(--_primary);
+        font-size: 1.05rem;
+        margin: 4px 0;
+      }
+
+      .price[hidden] {
+        display: none;
+      }
+
+      .actions {
+        margin-top: 15px;
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--_primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover {
+        background: #3e2723;
+      }
+
+      :host([disabled]) .btn,
+      :host([sold-out]) .btn {
+        pointer-events: none;
+        background: #8d6e63;
+      }
+    `);
+
+    const cardTemplate = document.createElement('template');
+    cardTemplate.innerHTML = `
+      <article class="card" part="card">
+        <div class="card-header">
+          <span class="badge" part="badge" hidden>Seasonal</span>
+          <button type="button" class="fav-btn" part="favorite-button" aria-pressed="false">☆ Save</button>
+        </div>
+        <h3 part="title"><slot name="title"></slot></h3>
+        <p class="description" part="description"><slot></slot></p>
+        <p class="price" part="price" hidden></p>
+        <div class="actions">
+          <a class="btn" part="cta" href="/menu">View Details</a>
+        </div>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'cta-label',
+        'price',
+        'seasonal',
+        'featured',
+        'sold-out',
+        'disabled',
+      ];
+
+      #internals;
+      #abortController = null;
+      #titleSlot;
+      #defaultSlot;
+      #priceEl;
+      #badgeEl;
+      #ctaEl;
+      #favBtn;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [cardSheet];
+        this.shadowRoot.append(cardTemplate.content.cloneNode(true));
+
+        this.#titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        this.#defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+        this.#priceEl = this.shadowRoot.querySelector('.price');
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#ctaEl = this.shadowRoot.querySelector('.btn');
+        this.#favBtn = this.shadowRoot.querySelector('.fav-btn');
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(value) {
+        value ? this.setAttribute('name', String(value)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(value) {
+        value ? this.setAttribute('description', String(value)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '/menu';
+      }
+      set href(value) {
+        value ? this.setAttribute('href', String(value)) : this.removeAttribute('href');
+      }
+
+      get ctaLabel() {
+        return this.getAttribute('cta-label') ?? 'View Details';
+      }
+      set ctaLabel(value) {
+        value ? this.setAttribute('cta-label', String(value)) : this.removeAttribute('cta-label');
+      }
+
+      // Numeric attribute: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(value) {
+        const num = Number(value);
+        if (Number.isFinite(num) && num > 0) {
+          this.setAttribute('price', String(num));
+        } else {
+          this.removeAttribute('price');
+        }
+      }
+
+      // Boolean attributes: present = true, absent = false (never set to "false")
+      get seasonal() {
+        return this.hasAttribute('seasonal');
+      }
+      set seasonal(on) {
+        this.toggleAttribute('seasonal', Boolean(on));
+      }
+
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', Boolean(on));
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+      set soldOut(on) {
+        this.toggleAttribute('sold-out', Boolean(on));
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      connectedCallback() {
+        // Idempotent setup: clean up prior listeners if re-inserted
+        this.#abortController?.abort();
+        this.#abortController = new AbortController();
+        const { signal } = this.#abortController;
+
+        this.#favBtn.addEventListener(
+          'click',
+          () => {
+            if (this.disabled) return;
+            const isFav = this.#internals.states.has('favorited');
+            if (isFav) {
+              this.#internals.states.delete('favorited');
+            } else {
+              this.#internals.states.add('favorited');
+            }
+            const nextState = !isFav;
+            this.#favBtn.setAttribute('aria-pressed', String(nextState));
+            this.#favBtn.textContent = nextState ? '★ Saved' : '☆ Save';
+            this.dispatchEvent(
+              new CustomEvent('favorite-toggle', {
+                detail: { name: this.name, favorited: nextState },
+                bubbles: true,
+                composed: true,
+              })
+            );
+          },
+          { signal }
+        );
+
+        this.#defaultSlot.addEventListener(
+          'slotchange',
+          () => {
+            this.render();
+          },
+          { signal }
+        );
+
+        this.render();
+      }
+
+      connectedMoveCallback() {
+        // Preserve runtime state and active listeners across Node.moveBefore() relocations
+      }
+
+      disconnectedCallback() {
+        this.#abortController?.abort();
+        this.#abortController = null;
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.render();
+        }
+      }
+
+      render() {
+        if (!this.isConnected) return;
+
+        this.#titleSlot.textContent = this.name;
+        this.#defaultSlot.textContent = this.description;
+
+        if (this.price > 0) {
+          this.#priceEl.hidden = false;
+          this.#priceEl.textContent = `$${this.price.toFixed(2)}`;
+        } else {
+          this.#priceEl.hidden = true;
+          this.#priceEl.textContent = '';
+        }
+
+        const showBadge = this.seasonal || this.featured || this.soldOut;
+        this.#badgeEl.hidden = !showBadge;
+        if (this.soldOut) {
+          this.#badgeEl.textContent = 'Sold Out';
+        } else if (this.seasonal) {
+          this.#badgeEl.textContent = 'Seasonal';
+        } else if (this.featured) {
+          this.#badgeEl.textContent = 'Featured';
+        }
+
+        const isUnavailable = this.soldOut || this.disabled;
+        this.#ctaEl.setAttribute('href', this.href);
+        this.#ctaEl.textContent = this.soldOut ? 'Sold Out' : this.ctaLabel;
+        if (isUnavailable) {
+          this.#ctaEl.setAttribute('aria-disabled', 'true');
+          this.#ctaEl.setAttribute('tabindex', '-1');
+        } else {
+          this.#ctaEl.removeAttribute('aria-disabled');
+          this.#ctaEl.removeAttribute('tabindex');
+        }
+        this.#favBtn.disabled = this.disabled;
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
 </body>
 
