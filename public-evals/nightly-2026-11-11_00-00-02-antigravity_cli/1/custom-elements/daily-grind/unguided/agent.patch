+  <script>
+    class CoffeeCard extends HTMLElement {
+      static STRING_ATTRIBUTES = ['name', 'description', 'href', 'cta-text', 'roast', 'image'];
+      static NUMERIC_ATTRIBUTES = ['price', 'calories', 'caffeine', 'rating'];
+      static BOOLEAN_ATTRIBUTES = ['seasonal', 'featured', 'iced', 'sold-out'];
+
+      static get observedAttributes() {
+        return [
+          ...CoffeeCard.STRING_ATTRIBUTES,
+          ...CoffeeCard.NUMERIC_ATTRIBUTES,
+          ...CoffeeCard.BOOLEAN_ATTRIBUTES
+        ];
+      }
+
+      static _attrToProp(attr) {
+        return attr.replace(/-([a-z])/g, (_, ch) => ch.toUpperCase());
+      }
+
+      constructor() {
+        super();
+        this._isConnected = false;
+        this._handleCtaClick = this._handleCtaClick.bind(this);
+
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('coffee-card-template');
+        if (template) {
+          shadow.appendChild(template.content.cloneNode(true));
+        }
+
+        this._els = {
+          imageWrapper: shadow.querySelector('.card-image-wrapper'),
+          image: shadow.querySelector('.card-image'),
+          badgeSeasonal: shadow.querySelector('.badge-seasonal'),
+          badgeIced: shadow.querySelector('.badge-iced'),
+          badgeRoast: shadow.querySelector('.badge-roast'),
+          badgeSoldOut: shadow.querySelector('.badge-sold-out'),
+          name: shadow.querySelector('h3'),
+          description: shadow.querySelector('.description'),
+          price: shadow.querySelector('.price'),
+          calories: shadow.querySelector('.calories'),
+          caffeine: shadow.querySelector('.caffeine'),
+          rating: shadow.querySelector('.rating'),
+          cta: shadow.querySelector('.btn')
+        };
+      }
+
+      // Lifecycle: invoked when inserted into the DOM
+      connectedCallback() {
+        this._isConnected = true;
+        this._upgradeProperties();
+        if (this._els.cta) {
+          this._els.cta.addEventListener('click', this._handleCtaClick);
+        }
+        this.render();
+      }
+
+      // Lifecycle: invoked when removed from the DOM
+      disconnectedCallback() {
+        this._isConnected = false;
+        if (this._els.cta) {
+          this._els.cta.removeEventListener('click', this._handleCtaClick);
+        }
+      }
+
+      // Lifecycle: invoked when moved to a new document
+      adoptedCallback() {
+        this.render();
+      }
+
+      // Lifecycle: invoked when an observed attribute is added, removed, or changed
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      _upgradeProperties() {
+        for (const attr of CoffeeCard.observedAttributes) {
+          const prop = CoffeeCard._attrToProp(attr);
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+      }
+
+      _handleCtaClick(event) {
+        if (this.soldOut) {
+          event.preventDefault();
+          return;
+        }
+        this.dispatchEvent(
+          new CustomEvent('coffee-select', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              name: this.name,
+              href: this.href,
+              price: this.price,
+              seasonal: this.seasonal,
+              iced: this.iced
+            }
+          })
+        );
+      }
+
+      // String attribute/property reflection helpers
+      _getStringAttr(attr, fallback = '') {
+        return this.hasAttribute(attr) ? this.getAttribute(attr) : fallback;
+      }
+
+      _setStringAttr(attr, value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute(attr);
+        } else {
+          this.setAttribute(attr, String(value));
+        }
+      }
+
+      // Numeric attribute/property reflection helpers
+      _getNumericAttr(attr, fallback = 0) {
+        if (!this.hasAttribute(attr)) return fallback;
+        const parsed = Number(this.getAttribute(attr));
+        return Number.isFinite(parsed) ? parsed : fallback;
+      }
+
+      _setNumericAttr(attr, value) {
+        if (value === null || value === undefined || value === '') {
+          this.removeAttribute(attr);
+          return;
+        }
+        const num = Number(value);
+        if (!Number.isFinite(num)) {
+          this.removeAttribute(attr);
+        } else {
+          this.setAttribute(attr, String(num));
+        }
+      }
+
+      // Boolean attribute/property reflection helpers
+      _getBooleanAttr(attr) {
+        return this.hasAttribute(attr);
+      }
+
+      _setBooleanAttr(attr, value) {
+        if (Boolean(value)) {
+          this.setAttribute(attr, '');
+        } else {
+          this.removeAttribute(attr);
+        }
+      }
+
+      // String properties
+      get name() {
+        return this._getStringAttr('name', '');
+      }
+      set name(value) {
+        this._setStringAttr('name', value);
+      }
+
+      get description() {
+        return this._getStringAttr('description', '');
+      }
+      set description(value) {
+        this._setStringAttr('description', value);
+      }
+
+      get href() {
+        return this._getStringAttr('href', '#');
+      }
+      set href(value) {
+        this._setStringAttr('href', value);
+      }
+
+      get ctaText() {
+        return this._getStringAttr('cta-text', 'View Details');
+      }
+      set ctaText(value) {
+        this._setStringAttr('cta-text', value);
+      }
+
+      get roast() {
+        return this._getStringAttr('roast', '');
+      }
+      set roast(value) {
+        this._setStringAttr('roast', value);
+      }
+
+      get image() {
+        return this._getStringAttr('image', '');
+      }
+      set image(value) {
+        this._setStringAttr('image', value);
+      }
+
+      // Numeric properties
+      get price() {
+        return this._getNumericAttr('price', 0);
+      }
+      set price(value) {
+        this._setNumericAttr('price', value);
+      }
+
+      get calories() {
+        return this._getNumericAttr('calories', 0);
+      }
+      set calories(value) {
+        this._setNumericAttr('calories', value);
+      }
+
+      get caffeine() {
+        return this._getNumericAttr('caffeine', 0);
+      }
+      set caffeine(value) {
+        this._setNumericAttr('caffeine', value);
+      }
+
+      get rating() {
+        return this._getNumericAttr('rating', 0);
+      }
+      set rating(value) {
+        this._setNumericAttr('rating', value);
+      }
+
+      // Boolean properties
+      get seasonal() {
+        return this._getBooleanAttr('seasonal');
+      }
+      set seasonal(value) {
+        this._setBooleanAttr('seasonal', value);
+      }
+
+      get featured() {
+        return this._getBooleanAttr('featured');
+      }
+      set featured(value) {
+        this._setBooleanAttr('featured', value);
+      }
+
+      get iced() {
+        return this._getBooleanAttr('iced');
+      }
+      set iced(value) {
+        this._setBooleanAttr('iced', value);
+      }
+
+      get soldOut() {
+        return this._getBooleanAttr('sold-out');
+      }
+      set soldOut(value) {
+        this._setBooleanAttr('sold-out', value);
+      }
+
+      render() {
+        const {
+          imageWrapper,
+          image,
+          badgeSeasonal,
+          badgeIced,
+          badgeRoast,
+          badgeSoldOut,
+          name,
+          description,
+          price,
+          calories,
+          caffeine,
+          rating,
+          cta
+        } = this._els;
+
+        if (!name) return;
+
+        name.textContent = this.name;
+        description.textContent = this.description;
+
+        if (this.image) {
+          image.src = this.image;
+          image.alt = this.name || 'Coffee image';
+          imageWrapper.hidden = false;
+        } else {
+          image.removeAttribute('src');
+          image.alt = '';
+          imageWrapper.hidden = true;
+        }
+
+        badgeSeasonal.hidden = !this.seasonal;
+        badgeIced.hidden = !this.iced;
+        badgeSoldOut.hidden = !this.soldOut;
+
+        if (this.roast) {
+          badgeRoast.textContent = `${this.roast} Roast`;
+          badgeRoast.hidden = false;
+        } else {
+          badgeRoast.textContent = '';
+          badgeRoast.hidden = true;
+        }
+
+        if (this.hasAttribute('price') && this.price > 0) {
+          price.textContent = `$${this.price.toFixed(2)}`;
+          price.hidden = false;
+        } else {
+          price.textContent = '';
+          price.hidden = true;
+        }
+
+        if (this.hasAttribute('calories') && this.calories > 0) {
+          calories.textContent = `${this.calories} cal`;
+          calories.hidden = false;
+        } else {
+          calories.textContent = '';
+          calories.hidden = true;
+        }
+
+        if (this.hasAttribute('caffeine') && this.caffeine > 0) {
+          caffeine.textContent = `${this.caffeine}mg caffeine`;
+          caffeine.hidden = false;
+        } else {
+          caffeine.textContent = '';
+          caffeine.hidden = true;
+        }
+
+        if (this.hasAttribute('rating') && this.rating > 0) {
+          rating.textContent = `★ ${this.rating.toFixed(1)}`;
+          rating.hidden = false;
+        } else {
+          rating.textContent = '';
+          rating.hidden = true;
+        }
+
+        cta.href = this.href;
+        cta.textContent = this.soldOut ? 'Sold Out' : this.ctaText;
+        cta.setAttribute('aria-disabled', String(this.soldOut));
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+    window.CoffeeCard = CoffeeCard;
+  </script>
