+  <script>
+    (function () {
+      const wholesaleTabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+
+      function activateWholesaleTab(targetTab) {
+        wholesaleTabs.forEach((tab) => {
+          const panel = tab.querySelector('.wholesale-tab-panel');
+          if (tab === targetTab) {
+            if (!tab.open) {
+              tab.open = true;
+            }
+            if (panel) {
+              panel.removeAttribute('hidden');
+            }
+          } else {
+            if (tab.open) {
+              tab.open = false;
+            }
+            if (panel) {
+              panel.setAttribute('hidden', 'until-found');
+            }
+          }
+        });
+      }
+
+      wholesaleTabs.forEach((tab) => {
+        const summary = tab.querySelector('summary');
+        const panel = tab.querySelector('.wholesale-tab-panel');
+
+        if (summary) {
+          summary.addEventListener('click', (event) => {
+            event.preventDefault();
+            activateWholesaleTab(tab);
+          });
+        }
+
+        tab.addEventListener('click', (event) => {
+          if (event.target === tab) {
+            activateWholesaleTab(tab);
+          }
+        });
+
+        tab.addEventListener('beforematch', () => {
+          activateWholesaleTab(tab);
+        });
+
+        if (panel) {
+          panel.addEventListener('beforematch', () => {
+            activateWholesaleTab(tab);
+          });
+        }
+
+        tab.addEventListener('toggle', () => {
+          if (tab.open) {
+            activateWholesaleTab(tab);
+          }
+        });
+      });
+
+      const revealCouponBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (!couponPanel) return;
+        couponPanel.removeAttribute('hidden');
+        if (revealCouponBtn) {
+          revealCouponBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (revealCouponBtn && couponPanel) {
+        revealCouponBtn.addEventListener('click', revealCoupon);
+        couponPanel.addEventListener('beforematch', revealCoupon);
+      }
+    })();
+  </script>
