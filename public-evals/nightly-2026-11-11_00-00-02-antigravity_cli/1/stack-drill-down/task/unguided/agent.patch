+      });
+
+      window.addEventListener('mouseup', (e) => {
+        if (!isPointerOrMouseDown) return;
+        isPointerOrMouseDown = false;
+        endSwipeGesture(e.clientX, e.clientY);
+      });
+
+      // Initialize from initial URL (Deep Link or Root)
+      const initialStack = parseStateFromLocation();
+      window.history.replaceState({ stack: initialStack, inApp: false }, '', window.location.pathname + window.location.search + window.location.hash);
+      applyStackUI(initialStack);
