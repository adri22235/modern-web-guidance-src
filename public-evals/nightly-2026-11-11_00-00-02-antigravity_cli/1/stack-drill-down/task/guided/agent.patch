+    /* Stack Scroller */
+    .Stack {
+      height: 100dvh;
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: 100%;
+      grid-template-rows: 100%;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: none;
+      scrollbar-width: none;
+    }
+
+    .Stack::-webkit-scrollbar {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .Stack {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .Stack-view {
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+    }
+
+    .Stack-viewContent {
+      width: 100%;
+      height: 100%;
+      background-color: Canvas;
+      color: CanvasText;
+      background: var(--light);
+      color: var(--text);
+      overflow-y: auto;
+      display: flex;
+      flex-direction: column;
+    }
+
+    .Stack-viewContent:focus {
+      outline: none;
+    }
+
+    @supports (animation-timeline: view()) {
+      .Stack-viewContent {
+        animation: parallax linear both;
+        animation-timeline: view(inline);
+        animation-range: exit 0% exit 100%;
+      }
+
+      .Stack-view:not(:first-child) .Stack-viewContent {
+        animation: parallax linear both, shadow-fade linear both;
+        animation-timeline: view(inline), view(inline);
+        animation-range: exit 0% exit 100%, entry 0% exit 100%;
+      }
+
+      @keyframes parallax {
+        to {
+          transform: translateX(75%);
+          filter: brightness(0.8);
+        }
+      }
+
+      @keyframes shadow-fade {
+        0%, 100% {
+          box-shadow: 0 0 1.5rem #0000;
+        }
+        25%, 75% {
+          box-shadow: 0 0 1.5rem #0004;
+        }
+      }
+    }
+
