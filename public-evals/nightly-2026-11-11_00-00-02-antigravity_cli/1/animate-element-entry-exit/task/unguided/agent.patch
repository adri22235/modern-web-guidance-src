+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoOffers = [
+      {
+        badge: 'Limited Time',
+        title: 'BOGO Cold Brew',
+        description: 'Buy one signature 18-hour Cold Brew and get a second one on the house.',
+        link: '/menu/cold-brew'
+      },
+      {
+        badge: 'Pastry Pairing',
+        title: 'Free Croissant with Large Latte',
+        description: 'Pair any large seasonal latte with a freshly baked butter croissant for free.',
+        link: '/menu/seasonal'
+      },
+      {
+        badge: 'Rewards Exclusive',
+        title: 'Double Bean Points Weekend',
+        description: 'Earn 2x loyalty points on every mobile and in-store order all weekend long.',
+        link: '/rewards'
+      },
+      {
+        badge: 'Roaster Deal',
+        title: '20% Off Whole Bean Bags',
+        description: 'Bring The Daily Grind home with 20% off all single-origin coffee bags.',
+        link: '/menu'
+      }
+    ];
+
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const offer = promoOffers[promoIndex % promoOffers.length];
+      promoIndex += 1;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <span class="promo-badge">${offer.badge}</span>
+        <h3>${offer.title}</h3>
+        <p>${offer.description}</p>
+        <a href="${offer.link}" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing', 'exiting');
+      let removed = false;
+      const cleanup = () => {
+        if (removed) return;
+        removed = true;
+        lastCard.remove();
+      };
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 320);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (!toggleCard.isConnected) {
+        toggleCard.classList.remove('removing', 'exiting', 'hidden', 'is-hidden');
+        domContainer.prepend(toggleCard);
+        return;
+      }
+      toggleCard.classList.toggle('hidden');
+    });
+  </script>
+
 </body>
 
