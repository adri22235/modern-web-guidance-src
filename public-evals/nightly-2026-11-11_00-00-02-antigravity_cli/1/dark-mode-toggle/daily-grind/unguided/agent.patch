+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theme-toggle');
+      const themeIcon = toggleBtn.querySelector('.theme-icon');
+      const themeLabel = toggleBtn.querySelector('.theme-label');
+      const root = document.documentElement;
+      const body = document.body;
+      const mediaQuery = window.matchMedia
+        ? window.matchMedia('(prefers-color-scheme: dark)')
+        : null;
+
+      function getSavedTheme() {
+        try {
+          const saved = localStorage.getItem('theme');
+          if (saved === 'dark' || saved === 'light') {
+            return saved;
+          }
+        } catch (e) {
+          // Ignore storage access errors
+        }
+        return null;
+      }
+
+      function getSystemTheme() {
+        return mediaQuery && mediaQuery.matches ? 'dark' : 'light';
+      }
+
+      function getCurrentTheme() {
+        const attrTheme = root.getAttribute('data-theme') || body.getAttribute('data-theme');
+        if (attrTheme === 'dark' || attrTheme === 'light') {
+          return attrTheme;
+        }
+        if (body.classList.contains('dark-mode') || root.classList.contains('dark-mode')) {
+          return 'dark';
+        }
+        if (body.classList.contains('light-mode') || root.classList.contains('light-mode')) {
+          return 'light';
+        }
+        return getSavedTheme() || getSystemTheme();
+      }
+
+      function applyTheme(theme, persist) {
+        const isDark = theme === 'dark';
+        root.setAttribute('data-theme', theme);
+        body.setAttribute('data-theme', theme);
+        root.classList.toggle('dark-mode', isDark);
+        root.classList.toggle('light-mode', !isDark);
+        body.classList.toggle('dark-mode', isDark);
+        body.classList.toggle('light-mode', !isDark);
+
+        toggleBtn.setAttribute('aria-pressed', String(isDark));
+        toggleBtn.setAttribute(
+          'aria-label',
+          isDark ? 'Switch to light mode' : 'Switch to dark mode'
+        );
+        if (themeIcon) {
+          themeIcon.textContent = isDark ? '☀️' : '🌙';
+        }
+        if (themeLabel) {
+          themeLabel.textContent = isDark ? 'Light Mode' : 'Dark Mode';
+        }
+
+        if (persist) {
+          try {
+            localStorage.setItem('theme', theme);
+          } catch (e) {
+            // Ignore storage access errors
+          }
+        }
+      }
+
+      // Initialize theme from saved override or system preference
+      const savedTheme = getSavedTheme();
+      if (savedTheme) {
+        applyTheme(savedTheme, false);
+      } else {
+        const isDarkSystem = getSystemTheme() === 'dark';
+        toggleBtn.setAttribute('aria-pressed', String(isDarkSystem));
+        toggleBtn.setAttribute(
+          'aria-label',
+          isDarkSystem ? 'Switch to light mode' : 'Switch to dark mode'
+        );
+        if (themeIcon) {
+          themeIcon.textContent = isDarkSystem ? '☀️' : '🌙';
+        }
+        if (themeLabel) {
+          themeLabel.textContent = isDarkSystem ? 'Light Mode' : 'Dark Mode';
+        }
+      }
+
+      toggleBtn.addEventListener('click', function () {
+        const nextTheme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
+        applyTheme(nextTheme, true);
+      });
+
+      if (mediaQuery && typeof mediaQuery.addEventListener === 'function') {
+        mediaQuery.addEventListener('change', function (e) {
+          if (!getSavedTheme() && !root.hasAttribute('data-theme')) {
+            const isDark = e.matches;
+            toggleBtn.setAttribute('aria-pressed', String(isDark));
+            if (themeIcon) {
+              themeIcon.textContent = isDark ? '☀️' : '🌙';
+            }
+            if (themeLabel) {
+              themeLabel.textContent = isDark ? 'Light Mode' : 'Dark Mode';
+            }
+          }
+        });
+      }
+    })();
+  </script>
