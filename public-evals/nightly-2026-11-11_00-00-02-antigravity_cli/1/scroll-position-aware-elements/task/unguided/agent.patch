+  <script>
+    (function () {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = document.querySelector('.scroll-sentinel');
+      const backToTopBtn = document.querySelector('.scroller .back-to-top');
+
+      if (!scroller || !sentinel || !backToTopBtn) return;
+
+      // Remove `hidden` once JS initializes so CSS transitions & visibility govern visual presentation
+      backToTopBtn.removeAttribute('hidden');
+
+      const setButtonVisibility = (visible) => {
+        if (visible) {
+          backToTopBtn.classList.add('is-visible');
+          backToTopBtn.removeAttribute('inert');
+          backToTopBtn.removeAttribute('tabindex');
+          backToTopBtn.setAttribute('aria-hidden', 'false');
+        } else {
+          backToTopBtn.classList.remove('is-visible');
+          backToTopBtn.setAttribute('inert', '');
+          backToTopBtn.setAttribute('tabindex', '-1');
+          backToTopBtn.setAttribute('aria-hidden', 'true');
+        }
+      };
+
+      // Use IntersectionObserver instead of continuous scroll event listeners
+      const observer = new IntersectionObserver(
+        (entries) => {
+          for (const entry of entries) {
+            // When the top sentinel scrolls out of view, reveal the button
+            setButtonVisibility(!entry.isIntersecting);
+          }
+        },
+        {
+          root: scroller,
+          threshold: 0,
+        }
+      );
+
+      observer.observe(sentinel);
+
+      backToTopBtn.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+    })();
+  </script>
