+
+    /* Scroll Container & Scroll-Position-Aware Back to Top Button */
+    @keyframes reveal-back-to-top {
+      0% {
+        visibility: hidden;
+        opacity: 0;
+        transform: translateY(20px) scale(0.8);
+        pointer-events: none;
+      }
+      1%, 10% {
+        visibility: visible;
+        opacity: 0;
+        transform: translateY(20px) scale(0.8);
+        pointer-events: none;
+      }
+      25%, 100% {
+        visibility: visible;
+        opacity: 1;
+        transform: translateY(0) scale(1);
+        pointer-events: auto;
+      }
+    }
+
+    .scroller {
+      height: 100vh;
+      overflow-y: auto;
+      scroll-behavior: smooth;
+      scroll-timeline: --scroller-timeline y;
+      position: relative;
+    }
+
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 120px;
+      pointer-events: none;
+      visibility: hidden;
+    }
+
+    .back-to-top {
+      position: fixed;
+      bottom: 2rem;
+      right: 2rem;
+      z-index: 1050;
+      display: inline-flex;
+      align-items: center;
+       gap: 0.5rem;
+      background: var(--primary);
+      color: white;
+      border: 2px solid var(--accent);
+      border-radius: 9999px;
+      padding: 0.75rem 1.25rem;
+      font-family: inherit;
+      font-size: 0.95rem;
+      font-weight: 600;
+      cursor: pointer;
+      text-decoration: none;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      /* Hidden initial state (prevents keyboard tabbing via visibility: hidden) */
+      visibility: hidden;
+      opacity: 0;
+      transform: translateY(20px) scale(0.8);
+      pointer-events: none;
+      transition:
+        opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        visibility 0.3s,
+        background-color 0.2s,
+        color 0.2s;
+    }
+
+    @supports (animation-timeline: scroll()) {
+      .back-to-top {
+        animation: reveal-back-to-top linear both;
+        animation-timeline: --scroller-timeline;
+        animation-range: 0px 300px;
+      }
+    }
+
+    .back-to-top.is-visible {
+      visibility: visible;
+      opacity: 1;
+      transform: translateY(0) scale(1);
+      pointer-events: auto;
+    }
+
+    .back-to-top:hover,
+    .back-to-top:focus-visible {
+      background: var(--accent);
+      color: var(--text);
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
