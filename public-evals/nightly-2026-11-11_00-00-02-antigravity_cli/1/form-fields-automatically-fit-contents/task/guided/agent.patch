     .btn:hover {
       background: #3e2723;
     }
 
+    /* Custom Order & Feedback Form */
+    .form-section {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 40px;
+    }
+
+    .form-section h2 {
+      color: var(--primary);
+      margin-bottom: 20px;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.25rem;
+      margin-block-end: 1.5rem;
+    }
+
+    .field label {
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .hint {
+      font-size: 0.875rem;
+      color: #5d4037;
+    }
+
+    input,
+    textarea,
+    select {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--text);
+      background-color: #fff;
+      border: 1px solid #767676;
+      border-radius: 5px;
+      padding: 0.65rem 0.75rem;
+      min-height: 48px;
+      align-self: start;
+    }
+
+    @media (pointer: coarse) {
+      input,
+      textarea,
+      select {
+        min-height: 52px;
+      }
+    }
+
+    input:focus-visible,
+    textarea:focus-visible,
+    select:focus-visible,
+    button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    input:user-invalid,
+    textarea:user-invalid,
+    select:user-invalid {
+      border-color: #b71c1c;
+    }
+
+    /* Applies horizontal auto-sizing to inputs */
+    input {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    /* Applies vertical auto-sizing with stable horizontal width to textareas */
+    textarea {
+      field-sizing: content;
+      height: auto;
+      width: 50ch;
+      max-inline-size: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    /* Sizes the select element to fit the active option only */
+    select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: 50ch;
+    }
+
+    button.btn {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      font-size: 1rem;
+      min-height: 48px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
