+  <div role="region" aria-label="Notifications">
+    <div id="info-notice" popover="manual">
+      <p id="info-notice-text">Fresh small-batch beans are roasted daily at 6:00 AM. Order before noon for same-day local delivery.</p>
+      <button type="button" id="dismiss-notice-btn" class="notice-close" command="hide-popover" commandfor="info-notice" aria-label="Dismiss notice">Dismiss</button>
+    </div>
