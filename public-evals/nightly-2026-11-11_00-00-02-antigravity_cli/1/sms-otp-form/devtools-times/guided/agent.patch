+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,68 @@
+import type { APIRoute } from 'astro';
+import {
+  extractHostDomain,
+  formatOriginBoundSms,
+  generateSixDigitOtp,
+  saveOtpRecord,
+} from '../../utils/sms-otp';
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let phone = '';
+    let domain = url.hostname;
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = String(body.phone || '').trim();
+      if (body.domain) {
+        domain = extractHostDomain(String(body.domain));
+      }
+    } else {
+      const formData = await request.formData();
+      phone = String(formData.get('phone') || '').trim();
+    }
+
+    if (!phone || !/^\+?[0-9\s\-()]{7,20}$/.test(phone)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid phone number.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const code = generateSixDigitOtp();
+    const record = saveOtpRecord(phone, code);
+    const smsMessage = formatOriginBoundSms(domain, code);
+
+    if (session) {
+      await session.set('pendingPhoneOtp', record);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent via SMS.',
+        smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to send verification code. Please try again.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
