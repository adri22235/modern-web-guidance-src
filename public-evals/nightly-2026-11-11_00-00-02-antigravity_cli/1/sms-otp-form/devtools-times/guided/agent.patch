+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,97 @@
+import type { APIRoute } from 'astro';
+import { normalizePhoneKey, verifyOtpRecord, type StoredOtpRecord } from '../../utils/sms-otp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let phone = '';
+    let otp = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = String(body.phone || '').trim();
+      otp = String(body.otp || '').trim();
+    } else {
+      const formData = await request.formData();
+      phone = String(formData.get('phone') || '').trim();
+      otp = String(formData.get('otp') || '').trim();
+    }
+
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid 6-digit verification code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (session) {
+      const sessionRecord = (await session.get('pendingPhoneOtp')) as StoredOtpRecord | undefined;
+      if (sessionRecord && (!phone || sessionRecord.phone === normalizePhoneKey(phone))) {
+        if (Date.now() > sessionRecord.expiresAt) {
+          await session.set('pendingPhoneOtp', undefined);
+          return new Response(
+            JSON.stringify({
+              error: 'Verification code has expired. Please request a new code.',
+            }),
+            {
+              status: 400,
+              headers: { 'Content-Type': 'application/json' },
+            }
+          );
+        }
+        if (sessionRecord.code === otp) {
+          await session.set('pendingPhoneOtp', undefined);
+          return new Response(
+            JSON.stringify({
+              success: true,
+              verified: true,
+            }),
+            {
+              status: 200,
+              headers: { 'Content-Type': 'application/json' },
+            }
+          );
+        }
+      }
+    }
+
+    const isValid = verifyOtpRecord(phone, otp);
+    if (!isValid) {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid or expired verification code. Please check the 6-digit code and try again.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to verify code at this time. Please try again.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
