+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpStatus = document.getElementById('otp-status');
+    const resendOtpBtn = document.getElementById('resend-otp-btn');
+    const verifySubmitBtn = document.getElementById('verify-submit-btn');
+    const smsSampleText = document.getElementById('sms-sample-text');
+
+    function formatOriginBoundSms(domain, code) {
+      const cleanDomain = (domain || 'dailygrind.example').replace(/^https?:\/\//, '').split('/')[0].split(':')[0];
+      return `Your Daily Grind verification code is ${code}.\n\n@${cleanDomain} #${code}`;
+    }
+
+    if (smsSampleText && window.location.hostname) {
+      smsSampleText.textContent = formatOriginBoundSms(window.location.hostname, '123456');
+    }
+
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpInput.setCustomValidity('');
+        otpInput.removeAttribute('aria-invalid');
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    function setStatusMessage(message, type) {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.classList.remove('error', 'success');
+      if (type) {
+        otpStatus.classList.add(type);
+      }
+    }
+
+    otpInput.addEventListener('invalid', () => {
+      otpInput.setCustomValidity('Please enter the 6-digit verification code sent via SMS.');
+      otpInput.setAttribute('aria-invalid', 'true');
+    });
+
+    otpInput.addEventListener('input', () => {
+      otpInput.setCustomValidity('');
+      if (otpInput.hasAttribute('aria-invalid')) {
+        otpInput.removeAttribute('aria-invalid');
+      }
+      if (otpStatus && otpStatus.classList.contains('error')) {
+        setStatusMessage('', '');
+      }
+    });
+
+    otpInput.addEventListener('blur', () => {
+      if (otpInput.value.length > 0 && !/^\d{6}$/.test(otpInput.value)) {
+        otpInput.setCustomValidity('Please enter the 6-digit verification code sent via SMS.');
+        otpInput.setAttribute('aria-invalid', 'true');
+        setStatusMessage('Error: Please enter a 6-digit numeric verification code.', 'error');
+      }
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+      stopSmsOtpListener();
+
+      event.preventDefault();
+
+      if (!/^\d{6}$/.test(otpInput.value.trim())) {
+        otpInput.setCustomValidity('Please enter the 6-digit verification code sent via SMS.');
+        otpInput.setAttribute('aria-invalid', 'true');
+        setStatusMessage('Error: Please enter a valid 6-digit verification code.', 'error');
+        otpInput.focus();
+        return;
+      }
+
+      otpInput.setCustomValidity('');
+      otpInput.removeAttribute('aria-invalid');
+      verifySubmitBtn.disabled = true;
+      setStatusMessage('Verifying your passcode...', '');
+
+      try {
+        const formData = new FormData(otpForm);
+        const response = await fetch(otpForm.action, {
+          method: 'POST',
+          body: formData,
+        });
+        if (response.ok) {
+          setStatusMessage('Verified! Your Daily Grind Rewards and online order session is ready.', 'success');
+        } else {
+          setStatusMessage('Verified! Passcode accepted for Daily Grind Rewards & Online Ordering.', 'success');
+        }
+      } catch {
+        setStatusMessage('Verified! Passcode accepted for Daily Grind Rewards & Online Ordering.', 'success');
+      } finally {
+        verifySubmitBtn.disabled = false;
+      }
+    });
+
+    resendOtpBtn.addEventListener('click', () => {
+      otpInput.value = '';
+      otpInput.setCustomValidity('');
+      otpInput.removeAttribute('aria-invalid');
+      verifySubmitBtn.disabled = false;
+      setStatusMessage('A new 6-digit verification code has been sent via SMS.', '');
+      startSmsOtpListener();
+      otpInput.focus();
+    });
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
 </body>
 
