+
+      const grid = document.getElementById('bean-grid');
+      const addBtn = document.getElementById('add-bean-btn');
+      const selectEl = document.getElementById('bean-variety-select');
+      const countBadge = document.getElementById('bean-count-badge');
+
+      let nextId = 5;
+      let catalogCursor = 0;
+
+      function updateCountAndEmptyState() {
+        const cards = grid.querySelectorAll('.bean-card');
+        const count = cards.length;
+        countBadge.textContent = count === 1 ? '1 Bean Selected' : `${count} Beans Selected`;
+
+        const existingEmpty = grid.querySelector('.bean-empty-state');
+        if (count === 0 && !existingEmpty) {
+          const emptyEl = document.createElement('div');
+          emptyEl.className = 'bean-empty-state';
+          emptyEl.textContent = 'No coffee beans in your box yet. Click "+ Add Bean" above to start building your selection.';
+          grid.appendChild(emptyEl);
+        } else if (count > 0 && existingEmpty) {
+          existingEmpty.remove();
+        }
+      }
+
+      function createBeanCard(beanData, id) {
+        const article = document.createElement('article');
+        article.className = 'bean-card';
+        article.setAttribute('role', 'listitem');
+        article.dataset.beanId = String(id);
+        article.style.viewTransitionName = `bean-item-${id}`;
+
+        article.innerHTML = `
+          <div class="bean-card-image-wrap">
+            <img src="${beanData.image}" alt="${beanData.name} coffee beans" loading="lazy">
+            <span class="bean-roast-badge">${beanData.roast}</span>
+          </div>
+          <div class="bean-card-body">
+            <span class="bean-card-Origin">${beanData.origin}</span>
+            <h3>${beanData.name}</h3>
+            <p class="bean-card-notes">${beanData.notes}</p>
+            <div class="bean-card-footer">
+              <span class="bean-price">${beanData.price}</span>
+              <button type="button" class="remove-bean-btn" data-action="remove" aria-label="Remove ${beanData.name}">Remove</button>
+            </div>
+          </div>
+        `;
+        return article;
+      }
+
+      function runWithGroupTransition(mutateDomFn) {
+        if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(() => {
+            mutateDomFn();
+          });
+          return;
+        }
+
+        // Fallback FLIP group animation when View Transitions API is unavailable
+        const beforeRects = new Map();
+        grid.querySelectorAll('.bean-card').forEach((card) => {
+          beforeRects.set(card, card.getBoundingClientRect());
+        });
+
+        mutateDomFn();
+
+        grid.querySelectorAll('.bean-card').forEach((card) => {
+          const first = beforeRects.get(card);
+          const last = card.getBoundingClientRect();
+          if (!first) {
+            card.animate(
+              [
+                { opacity: 0, transform: 'scale(0.85)' },
+                { opacity: 1, transform: 'scale(1)' }
+              ],
+              { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
+            );
+            return;
+          }
+          const dx = first.left - last.left;
+          const dy = first.top - last.top;
+          if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
+            card.animate(
+              [
+                { transform: `translate(${dx}px, ${dy}px)` },
+                { transform: 'translate(0, 0)' }
+              ],
+              { duration: 400, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
+            );
+          }
+        });
+      }
+
+      addBtn.addEventListener('click', () => {
+        const selectedKey = selectEl.value;
+        let beanData;
+        if (selectedKey && selectedKey !== 'auto') {
+          beanData = beanCatalog.find((b) => b.key === selectedKey) || beanCatalog[0];
+        } else {
+          beanData = beanCatalog[catalogCursor % beanCatalog.length];
+          catalogCursor += 1;
+        }
+
+        const id = nextId++;
+        const newCard = createBeanCard(beanData, id);
+
+        runWithGroupTransition(() => {
+          const emptyEl = grid.querySelector('.bean-empty-state');
+          if (emptyEl) emptyEl.remove();
+          grid.prepend(newCard);
+          updateCountAndEmptyState();
+        });
+      });
+
+      grid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.remove-bean-btn');
+        if (!removeBtn) return;
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        runWithGroupTransition(() => {
+          card.remove();
+          updateCountAndEmptyState();
+        });
+      });
+    })();
