+  <script>
+    const BEAN_CATALOG = [
+      {
+        id: 'bean-ethiopian-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        roast: 'Light Roast',
+        notes: 'Bright bergamot, jasmine blossom, and sweet Meyer lemon finish.',
+        price: '$19 / 12oz',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-colombian-supremo',
+        name: 'Colombian Supremo',
+        roast: 'Medium Roast',
+        notes: 'Velvety caramel, roasted hazelnut, and balanced red apple acidity.',
+        price: '$17 / 12oz',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied dark chocolate, cedar spice, and smooth earthy undertones.',
+        price: '$18 / 12oz',
+        image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-guatemala-antigua',
+        name: 'Guatemala Antigua',
+        roast: 'Medium Roast',
+        notes: 'Toasted almond, milk chocolate, and a hint of warm cinnamon spice.',
+        price: '$18 / 12oz',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-kenya-aa',
+        name: 'Kenya AA Nyeri',
+        roast: 'Light-Medium',
+        notes: 'Juicy blackcurrant,ruby grapefruit, and crisp cane sugar sweetness.',
+        price: '$21 / 12oz',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-costa-rica-tarrazu',
+        name: 'Costa Rica Tarrazú',
+        roast: 'Medium Roast',
+        notes: 'Honeyed stone fruit, brown sugar, and a clean citrus finish.',
+        price: '$19 / 12oz',
+        image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80'
+      }
+    ];
+
+    let selectedBeans = BEAN_CATALOG.slice(0, 4);
+
+    const listEl = document.getElementById('bean-selection-list');
+    const emptyMsgEl = document.getElementById('bean-empty-msg');
+    const selectEl = document.getElementById('bean-catalog-select');
+    const addBtn = document.getElementById('add-bean-btn');
+    const addRandomBtn = document.getElementById('add-random-bean-btn');
+    const shuffleBtn = document.getElementById('shuffle-beans-btn');
+
+    function createBeanElement(bean) {
+      const li = document.createElement('li');
+      li.className = 'bean-item';
+      li.dataset.id = bean.id;
+      li.style.viewTransitionName = bean.id;
+
+      const img = document.createElement('img');
+      img.src = bean.image;
+      img.alt = bean.name;
+      img.loading = 'lazy';
+
+      const body = document.createElement('div');
+      body.className = 'bean-item-body';
+
+      const badge = document.createElement('span');
+      badge.className = 'bean-badge';
+      badge.textContent = bean.roast;
+
+      const title = document.createElement('h3');
+      title.textContent = bean.name;
+
+      const notes = document.createElement('p');
+      notes.textContent = bean.notes;
+
+      const footer = document.createElement('div');
+      footer.className = 'bean-item-footer';
+
+      const weight = document.createElement('span');
+      weight.className = 'bean-weight';
+      weight.textContent = bean.price;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'bean-remove-btn';
+      removeBtn.textContent = 'Remove';
+      removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+      removeBtn.addEventListener('click', () => removeBean(bean.id, li));
+
+      footer.append(weight, removeBtn);
+      body.append(badge, title, notes, footer);
+      li.append(img, body);
+      return li;
+    }
+
+    function syncControls() {
+      const selectedIds = new Set(selectedBeans.map((b) => b.id));
+      const availableBeans = BEAN_CATALOG.filter((b) => !selectedIds.has(b.id));
+
+      const previousValue = selectEl.value;
+      selectEl.replaceChildren();
+
+      if (availableBeans.length === 0) {
+        const opt = document.createElement('option');
+        opt.value = '';
+        opt.textContent = 'All roasts added to box';
+        selectEl.appendChild(opt);
+        selectEl.disabled = true;
+        addBtn.disabled = true;
+        addRandomBtn.disabled = true;
+      } else {
+        for (const bean of availableBeans) {
+          const opt = document.createElement('option');
+          opt.value = bean.id;
+          opt.textContent = `${bean.name} (${bean.roast})`;
+          selectEl.appendChild(opt);
+        }
+        if (availableBeans.some((b) => b.id === previousValue)) {
+          selectEl.value = previousValue;
+        }
+        selectEl.disabled = false;
+        addBtn.disabled = false;
+        addRandomBtn.disabled = false;
+      }
+
+      shuffleBtn.disabled = selectedBeans.length < 2;
+      emptyMsgEl.hidden = selectedBeans.length > 0;
+    }
+
+    function renderBeans() {
+      const existingNodes = new Map(
+        Array.from(listEl.children, (el) => [el.dataset.id, el])
+      );
+
+      for (const [id, el] of existingNodes) {
+        if (!selectedBeans.some((b) => b.id === id)) {
+          el.remove();
+        }
+      }
+
+      for (const bean of selectedBeans) {
+        const el = existingNodes.get(bean.id) || createBeanElement(bean);
+        listEl.appendChild(el);
+      }
+
+      syncControls();
+    }
+
+    function updateWithViewTransition(updateDOM) {
+      if (document.startViewTransition) {
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+        transition.ready.catch(() => {});
+      } else {
+        updateDOM();
+      }
+    }
+
+    function addBeanById(beanId) {
+      const bean = BEAN_CATALOG.find((b) => b.id === beanId);
+      if (!bean || selectedBeans.some((b) => b.id === beanId)) return;
+
+      updateWithViewTransition(() => {
+        selectedBeans = [bean, ...selectedBeans];
+        renderBeans();
+      });
+    }
+
+    function removeBean(beanId, itemEl) {
+      const hadFocus = itemEl && itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl?.nextElementSibling?.querySelector('button') ??
+        itemEl?.previousElementSibling?.querySelector('button') ??
+        addBtn;
+
+      updateWithViewTransition(() => {
+        selectedBeans = selectedBeans.filter((b) => b.id !== beanId);
+        renderBeans();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    addBtn.addEventListener('click', () => {
+      if (selectEl.value) {
+        addBeanById(selectEl.value);
+      }
+    });
+
+    addRandomBtn.addEventListener('click', () => {
+      const selectedIds = new Set(selectedBeans.map((b) => b.id));
+      const available = BEAN_CATALOG.filter((b) => !selectedIds.has(b.id));
+      if (available.length > 0) {
+        addBeanById(available[0].id);
+      }
+    });
+
+    shuffleBtn.addEventListener('click', () => {
+      if (selectedBeans.length < 2) return;
+      updateWithViewTransition(() => {
+        const copy = [...selectedBeans];
+        for (let i = copy.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [copy[i], copy[j]] = [copy[j], copy[i]];
+        }
+        selectedBeans = copy;
+        renderBeans();
+      });
+    });
+
+    renderBeans();
+  </script>
 </body>
 
