+      <div class="journal-header">
+        <div>
+          <h2 id="journal-heading">Roaster's Journal: From Canopy to Cup</h2>
+          <p class="journal-meta">By Clara Vance, Head Roaster &amp; Green Coffee Buyer</p>
+        </div>
+        <div class="journal-actions">
+          <button type="button" id="summarize-btn" class="btn btn-summarize">Summarize</button>
