+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryContent = document.getElementById('summary-content');
+    const journalArticle = document.getElementById('journal-article');
+
+    function renderBullets(rawSummary) {
+      summaryContent.innerHTML = '';
+      const lines = rawSummary
+        .split('\n')
+        .map((line) => line.trim())
+        .filter((line) => line.length > 0);
+
+      const ul = document.createElement('ul');
+      for (const line of lines) {
+        const cleaned = line
+          .replace(/^([*\-•+]|\d+[.)])\s*/, '')
+          .replace(/\*\*(.*?)\*\*/g, '$1')
+          .trim();
+        if (cleaned) {
+          const li = document.createElement('li');
+          li.textContent = cleaned;
+          ul.appendChild(li);
+        }
+      }
+
+      if (ul.children.length > 0) {
+        summaryContent.appendChild(ul);
+      } else {
+        const p = document.createElement('p');
+        p.textContent = rawSummary;
+        summaryContent.appendChild(p);
+      }
+      summaryContainer.classList.add('visible');
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const summarizerFactory =
+        'Summarizer' in self
+          ? self.Summarizer
+          : self.ai && self.ai.summarizer
+            ? self.ai.summarizer
+            : null;
+
+      if (!summarizerFactory) {
+        summaryStatus.textContent = 'Built-in AI Summarizer API is not supported in this browser.';
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      summaryStatus.textContent = 'Checking AI availability...';
+
+      try {
+        let availability = 'available';
+        if (typeof summarizerFactory.availability === 'function') {
+          availability = await summarizerFactory.availability();
+        } else if (typeof summarizerFactory.capabilities === 'function') {
+          const caps = await summarizerFactory.capabilities();
+          availability = caps?.available || 'available';
+        }
+
+        if (availability === 'unavailable' || availability === 'no') {
+          summaryStatus.textContent = 'Built-in AI Summarizer is unavailable on this device.';
+          summarizeBtn.disabled = false;
+          return;
+        }
+
+        if (availability === 'downloadable' || availability === 'downloading' || availability === 'after-download') {
+          summaryStatus.textContent = 'Downloading on-device AI model...';
+        } else {
+          summaryStatus.textContent = 'Generating summary...';
+        }
+
+        const summarizer = await summarizerFactory.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'A journal entry from a specialty coffee roaster describing their bean sourcing process.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (typeof e.loaded === 'number') {
+                const pct = Math.round(e.loaded * 100);
+                summaryStatus.textContent = `Downloading AI model (${pct}%)...`;
+              }
+            });
+          }
+        });
+
+        summaryStatus.textContent = 'Summarizing article...';
+        const articleText = journalArticle.innerText.trim();
+        const summary = await summarizer.summarize(articleText, {
+          context: 'Turn this coffee bean sourcing article into a few concise bullet points.'
+        });
+
+        renderBullets(summary);
+        summaryStatus.textContent = 'Summary ready';
+
+        if (typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+      } catch (error) {
+        console.error('Summarization error:', error);
+        summaryStatus.textContent = `Unable to generate summary: ${error.message || 'Unknown error'}`;
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
