+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summary-status');
+      const summaryContainer = document.getElementById('summary-container');
+      const summaryList = document.getElementById('summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: 'An artisanal coffee roaster journal entry detailing ethical coffee bean sourcing, processing, and roasting.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      function renderBullets(summaryText) {
+        summaryList.innerHTML = '';
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^[\s*\-•–+\d.)]+/, '').trim())
+          .filter(Boolean);
+
+        const items = lines.length > 0 ? lines : [summaryText.trim()].filter(Boolean);
+
+        for (const item of items) {
+          const li = document.createElement('li');
+          li.textContent = item;
+          summaryList.appendChild(li);
+        }
+        summaryContainer.hidden = items.length === 0;
+      }
+
+      async function checkSupport() {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return false;
+        }
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            summarizeBtn.disabled = true;
+            statusEl.textContent = 'Local summarization is currently unavailable on this device.';
+            return false;
+          }
+          if (availability === 'downloadable' || availability === 'downloading') {
+            statusEl.textContent = 'On-device AI model will be downloaded upon clicking Summarize.';
+          }
+          return true;
+        } catch (err) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return false;
+        }
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return;
+        }
+
+        summarizeBtn.disabled = true;
+        statusEl.textContent = 'Checking on-device AI availability...';
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            statusEl.textContent = 'Local summarization is currently unavailable on this device.';
+            return;
+          }
+
+          statusEl.textContent = 'Preparing summarizer...';
+          const summarizer = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (e.total > 0) {
+                  const percent = Math.round((e.loaded / e.total) * 100);
+                  statusEl.textContent = `Downloading on-device AI model: ${percent}%`;
+                } else {
+                  statusEl.textContent = 'Downloading on-device AI model...';
+                }
+              });
+            },
+          });
+
+          statusEl.textContent = 'Generating summary...';
+          const longText = articleEl.innerText;
+          const summary = await summarizer.summarize(longText, {
+            context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points for coffee shop customers.',
+          });
+
+          renderBullets(summary);
+          statusEl.textContent = 'Summarized on-device using built-in AI.';
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        } catch (error) {
+          statusEl.textContent = `Unable to generate summary: ${error.message || 'An unexpected error occurred.'}`;
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+
+      checkSupport();
+    })();
+  </script>
+
