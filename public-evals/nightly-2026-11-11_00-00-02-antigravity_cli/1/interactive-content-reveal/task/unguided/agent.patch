+  <script>
+    (function () {
+      const TARGET_INNER = 115;
+      const TARGET_OUTER = 160;
+      const START_INNER = 45;
+      const START_OUTER = 70;
+      const GROW_DURATION_MS = 150;
+
+      function prefersReducedMotion() {
+        return Boolean(
+          window.matchMedia &&
+          window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        );
+      }
+
+      const cards = document.querySelectorAll('.product-card');
+
+      cards.forEach((card) => {
+        card.style.setProperty('--mouse-x', '0px');
+        card.style.setProperty('--mouse-y', '0px');
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+
+        let rafId = null;
+        let isHovered = false;
+
+        function cancelGrowth() {
+          if (rafId !== null) {
+            cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+        }
+
+        function setSize(inner, outer) {
+          card.style.setProperty('--inner-size', `${Math.round(inner)}px`);
+          card.style.setProperty('--outer-size', `${Math.round(outer)}px`);
+        }
+
+        function updateCoords(e) {
+          if (typeof e.clientX === 'number' && typeof e.clientY === 'number') {
+            const rect = card.getBoundingClientRect();
+            const x = Number((e.clientX - rect.left).toFixed(2));
+            const y = Number((e.clientY - rect.top).toFixed(2));
+            card.style.setProperty('--mouse-x', `${x}px`);
+            card.style.setProperty('--mouse-y', `${y}px`);
+          }
+        }
+
+        function startHover(e) {
+          updateCoords(e);
+          if (isHovered) return;
+          isHovered = true;
+          cancelGrowth();
+
+          if (prefersReducedMotion()) {
+            setSize(TARGET_INNER, TARGET_OUTER);
+            return;
+          }
+
+          setSize(START_INNER, START_OUTER);
+          const startTime = performance.now();
+
+          function step(now) {
+            if (!isHovered) return;
+            const elapsed = now - startTime;
+            const progress = Math.min(1, Math.max(0, elapsed / GROW_DURATION_MS));
+            const eased = 1 - Math.pow(1 - progress, 3);
+            const currentInner = START_INNER + (TARGET_INNER - START_INNER) * eased;
+            const currentOuter = START_OUTER + (TARGET_OUTER - START_OUTER) * eased;
+            setSize(currentInner, currentOuter);
+
+            if (progress < 1) {
+              rafId = requestAnimationFrame(step);
+            } else {
+              setSize(TARGET_INNER, TARGET_OUTER);
+              rafId = null;
+            }
+          }
+
+          rafId = requestAnimationFrame(step);
+        }
+
+        function handleMove(e) {
+          if (!isHovered) {
+            startHover(e);
+          } else {
+            updateCoords(e);
+          }
+        }
+
+        function endHover() {
+          isHovered = false;
+          cancelGrowth();
+          setSize(0, 0);
+        }
+
+        card.addEventListener('pointerenter', startHover);
+        card.addEventListener('mouseenter', startHover);
+        card.addEventListener('pointermove', handleMove);
+        card.addEventListener('mousemove', handleMove);
+        card.addEventListener('pointerleave', endHover);
+        card.addEventListener('mouseleave', endHover);
+      });
+    })();
+  </script>
