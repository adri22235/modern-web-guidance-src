+
     .card {
       background: white;
       padding: 20px;
       border-radius: 8px;
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    .product-card:hover {
+      --inner-size: 110px;
+      --outer-size: 140px;
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .extra-details {
+      margin-top: 12px;
+      padding: 10px 12px;
+      background: #f5ebe6;
+      border-radius: 6px;
+      font-size: 0.85rem;
+      color: var(--text);
+      text-align: left;
+    }
+
+    .extra-details span {
+      display: block;
+      margin-bottom: 4px;
+    }
+
+    .extra-details span:last-child {
+      margin-bottom: 0;
+    }
+
+    .reveal-layer {
+      position: absolute;
+      inset: 0;
+      padding: 20px;
+      border-radius: 8px;
+      background: var(--primary);
+      color: var(--light);
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      text-align: center;
+      pointer-events: none;
+      transition: --inner-size 0.2s ease-in-out, --outer-size 0.2s ease-in-out;
+      -webkit-mask-image: radial-gradient(
+        circle at var(--mouse-x) var(--mouse-y),
+        black var(--inner-size, 0%),
+        transparent var(--outer-size, 0%)
+      );
+      mask-image: radial-gradient(
+        circle at var(--mouse-x) var(--mouse-y),
+        black var(--inner-size, 0%),
+        transparent var(--outer-size, 0%)
+      );
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    .reveal-layer h3 {
+      color: var(--accent);
+    }
+
+    .reveal-layer .extra-details {
+      background: rgba(255, 255, 255, 0.12);
+      color: var(--light);
+      border: 1px solid rgba(255, 171, 64, 0.4);
+    }
+
+    .reveal-layer .extra-details strong {
+      color: var(--accent);
+    }
+
+    .reveal-layer .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .reveal-layer {
+        transition: none !important;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
