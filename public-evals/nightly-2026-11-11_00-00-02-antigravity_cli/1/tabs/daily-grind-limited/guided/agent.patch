+  <script>
+    (() => {
+      const menu = document.getElementById('coffee-menu');
+      if (!menu) return;
+
+      const tablist = menu.querySelector('.tablist');
+      const tabs = Array.from(tablist.querySelectorAll('button'));
+      const panels = Array.from(menu.querySelectorAll('[role="tabpanel"]'));
+
+      function selectTab(selectedTab) {
+        if (!selectedTab) return;
+
+        for (const tab of tabs) {
+          const isSelected = tab === selectedTab;
+          tab.ariaSelected = String(isSelected);
+          tab.toggleAttribute('focusgroupstart', isSelected);
+        }
+
+        for (const panel of panels) {
+          const isMatch = panel.getAttribute('aria-labelledby') === selectedTab.id;
+          if (isMatch) {
+            panel.hidden = false;
+          } else {
+            panel.hidden = 'until-found';
+          }
+        }
+
+        selectedTab.scrollIntoView({
+          block: 'nearest',
+          inline: 'nearest',
+          container: 'nearest',
+          behavior: window.matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto'
+        });
+      }
+
+      tablist.addEventListener('focusin', (event) => {
+        const tab = event.target.closest('button');
+        if (tab && tablist.contains(tab)) {
+          selectTab(tab);
+        }
+      });
+
+      tablist.addEventListener('click', (event) => {
+        const tab = event.target.closest('button');
+        if (tab && tablist.contains(tab)) {
+          selectTab(tab);
+        }
+      });
+
+      menu.addEventListener('beforematch', (event) => {
+        const matchedPanel = event.target.closest('[role="tabpanel"]');
+        if (!matchedPanel) return;
+        const tabId = matchedPanel.getAttribute('aria-labelledby');
+        const matchingTab = document.getElementById(tabId);
+        if (matchingTab) {
+          selectTab(matchingTab);
+        }
+      });
+    })();
+  </script>
+
