+  <script>
+    (function () {
+      const tabShell = document.getElementById('coffee-tab-shell');
+      const tabList = document.getElementById('coffee-tablist');
+      const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
+      const panels = Array.from(document.querySelectorAll('#coffee-menu [role="tabpanel"]'));
+      const prevBtn = document.getElementById('tab-scroll-prev');
+      const nextBtn = document.getElementById('tab-scroll-next');
+
+      function updateScrollIndicators() {
+        const maxScrollLeft = tabList.scrollWidth - tabList.clientWidth;
+        const isOverflowing = maxScrollLeft > 2;
+        const canScrollLeft = tabList.scrollLeft > 4;
+        const canScrollRight = tabList.scrollLeft < maxScrollLeft - 4;
+
+        tabShell.classList.toggle('is-overflowing', isOverflowing);
+        tabShell.classList.toggle('can-scroll-left', canScrollLeft);
+        tabShell.classList.toggle('can-scroll-right', canScrollRight);
+
+        if (prevBtn) prevBtn.disabled = !canScrollLeft;
+        if (nextBtn) nextBtn.disabled = !canScrollRight;
+      }
+
+      function scrollTabIntoCenter(tab) {
+        if (!tab || !tabList) return;
+        const tabRect = tab.getBoundingClientRect();
+        const listRect = tabList.getBoundingClientRect();
+        const currentScroll = tabList.scrollLeft;
+        const targetScroll =
+          currentScroll +
+          (tabRect.left - listRect.left) -
+          (listRect.width / 2 - tabRect.width / 2);
+
+        tabList.scrollTo({
+          left: Math.max(0, targetScroll),
+          behavior: 'smooth'
+        });
+      }
+
+      function activateTab(selectedTab, { focus = false } = {}) {
+        if (!selectedTab) return;
+        const targetPanelId = selectedTab.getAttribute('aria-controls');
+
+        tabs.forEach((tab) => {
+          const isSelected = tab === selectedTab;
+          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+          tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+        });
+
+        panels.forEach((panel) => {
+          const isMatch = panel.id === targetPanelId;
+          panel.classList.toggle('is-active', isMatch);
+          if (isMatch) {
+            panel.removeAttribute('hidden');
+          } else {
+            panel.setAttribute('hidden', '');
+          }
+        });
+
+        if (focus) {
+          selectedTab.focus({ preventScroll: true });
+        }
+
+        scrollTabIntoCenter(selectedTab);
+      }
+
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => {
+          activateTab(tab);
+        });
+
+        tab.addEventListener('keydown', (event) => {
+          let nextIndex = null;
+          if (event.key === 'ArrowRight') {
+            nextIndex = (index + 1) % tabs.length;
+          } else if (event.key === 'ArrowLeft') {
+            nextIndex = (index - 1 + tabs.length) % tabs.length;
+          } else if (event.key === 'Home') {
+            nextIndex = 0;
+          } else if (event.key === 'End') {
+            nextIndex = tabs.length - 1;
+          }
+
+          if (nextIndex !== null) {
+            event.preventDefault();
+            activateTab(tabs[nextIndex], { focus: true });
+          }
+        });
+      });
+
+      if (prevBtn) {
+        prevBtn.addEventListener('click', () => {
+          tabList.scrollBy({
+            left: -Math.max(160, Math.round(tabList.clientWidth * 0.65)),
+            behavior: 'smooth'
+          });
+        });
+      }
+
+      if (nextBtn) {
+        nextBtn.addEventListener('click', () => {
+          tabList.scrollBy({
+            left: Math.max(160, Math.round(tabList.clientWidth * 0.65)),
+            behavior: 'smooth'
+          });
+        });
+      }
+
+      tabList.addEventListener('scroll', updateScrollIndicators, { passive: true });
+      window.addEventListener('resize', updateScrollIndicators);
+      updateScrollIndicators();
+    })();
+  </script>
