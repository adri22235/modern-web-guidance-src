+  <script type="module">
+    const hasNativeFocusGroup = Object.hasOwn(HTMLElement.prototype, 'focusGroup');
+    if (!hasNativeFocusGroup) {
+      try {
+        const { polyfill } = await import('@microsoft/focusgroup-polyfill');
+        polyfill();
+      } catch {
+        // Fallback keyboard navigation if polyfill cannot be fetched
+      }
+    }
+
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      for (const scroller of document.querySelectorAll('.scroller')) {
+        const [first, last] = [scroller.firstElementChild, scroller.lastElementChild];
+        if (!first || !last) continue;
+        // rootMargin: without it, sub-pixel widths can leave an edge child a fraction of a pixel short of fully visible
+        const observer = new IntersectionObserver(entries => {
+          for (const { target, intersectionRatio } of entries) {
+            scroller.classList.toggle(target === first ? 'more-start' : 'more-end', intersectionRatio < 1);
+          }
+        }, { root: scroller, threshold: 1, rootMargin: '1px' });
+
+        observer.observe(first);
+        observer.observe(last);
+      }
+    }
+
+    const menuSection = document.getElementById('coffee-menu');
+    const tablist = menuSection.querySelector('[focusgroup~="tablist"]');
+    const tabs = Array.from(tablist.querySelectorAll('button'));
+    const panels = Array.from(menuSection.querySelectorAll('[role="tabpanel"]'));
+
+    function selectTab(selected) {
+      if (!selected) return;
+      for (const tab of tabs) {
+        const isSelected = tab === selected;
+        tab.ariaSelected = isSelected;
+        tab.toggleAttribute('focusgroupstart', isSelected);
+      }
+      for (const panel of panels) {
+        const isSelected = panel.getAttribute('aria-labelledby') === selected.id;
+        if (isSelected) {
+          panel.removeAttribute('hidden');
+        } else {
+          panel.hidden = 'until-found';
+        }
+      }
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }
+
+    tablist.addEventListener('focusin', (e) => {
+      const tab = e.target.closest('button');
+      if (tab && tablist.contains(tab)) {
+        selectTab(tab);
+      }
+    });
+
+    tablist.addEventListener('click', (e) => {
+      const tab = e.target.closest('button');
+      if (tab && tablist.contains(tab)) {
+        selectTab(tab);
+      }
+    });
+
+    menuSection.addEventListener('beforematch', (e) => {
+      const matchedPanel = e.target.closest('[role="tabpanel"]');
+      if (!matchedPanel) return;
+      const matchingTab = document.getElementById(matchedPanel.getAttribute('aria-labelledby'));
+      if (matchingTab) {
+        selectTab(matchingTab);
+      }
+    });
