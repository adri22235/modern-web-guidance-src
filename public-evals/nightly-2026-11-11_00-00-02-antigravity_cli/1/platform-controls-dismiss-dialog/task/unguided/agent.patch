+          notes: 'Warm Maple, Toasted Oat, Sweet Cinnamon',
+          ingredients:
+            'Double-shot Arabica espresso, barista-blend oat milk, pure Grade A Vermont maple syrup, organic cinnamon',
+          nutrition: '12 oz (210 cal) • 16 oz (270 cal)',
+          caffeine: '150 mg'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          badge: 'House Signature',
+          price: '$3.75',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Rich dark roast espresso shot with golden crema',
+          description:
+            'Bold, smokey, and perfect for a morning boost. Single-origin Sumatra beans roasted dark to unlock deep cocoa undertones and a rich, velvety crema.',
+          notes: 'Dark Chocolate, Roasted Walnut, Smokey Cedar',
+          ingredients:
+            '100% Fair Trade organic dark-roasted Arabica coffee beans, filtered water',
+          nutrition: 'Single 1 oz (5 cal) • Double 2 oz (10 cal)',
+          caffeine: '165 mg'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          badge: 'Slow Steeped',
+          price: '$4.95',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Chilled artisan cold brew coffee poured over ice',
+          description:
+            'Steeped for 18 hours for maximum smoothness. Coarsely ground Colombian and Ethiopian beans steeped in cold filtered water for naturally sweet flavor and low acidity.',
+          notes: 'Sweet Caramel, Cocoa Nib, Crisp Finish',
+          ingredients:
+            'Cold-steeped specialty Arabica coffee blend, filtered water, served over artisanal ice',
+          nutrition: '16 oz (15 cal) • 20 oz (20 cal)',
+          caffeine: '200 mg'
+        }
+      };
+
+      const modal = document.getElementById('coffee-details-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalBadge = document.getElementById('modal-badge');
+      const modalPrice = document.getElementById('modal-price');
+      const modalImage = document.getElementById('modal-image');
+      const modalDescription = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const modalIngredients = document.getElementById('modal-ingredients');
+      const modalNutrition = document.getElementById('modal-nutrition');
+      const modalCaffeine = document.getElementById('modal-caffeine');
+      const closeIconBtn = document.getElementById('modal-close-icon');
+      const closeActionBtn = document.getElementById('modal-close-btn');
+
+      let lastFocusedElement = null;
+
+      function populateModal(coffeeKey) {
+        const data = COFFEE_DETAILS[coffeeKey];
+        if (!data) return;
+        modalTitle.textContent = data.title;
+        modalBadge.textContent = data.badge;
+        modalPrice.textContent = data.price;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+        modalDescription.textContent = data.description;
+        modalNotes.textContent = data.notes;
+        modalIngredients.textContent = data.ingredients;
+        modalNutrition.textContent = data.nutrition;
+        modalCaffeine.textContent = data.caffeine;
+      }
+
+      function openCoffeeModal(coffeeKey, triggerEl) {
+        lastFocusedElement = triggerEl || document.activeElement;
+        populateModal(coffeeKey);
+
+        if (window.history && typeof window.history.pushState === 'function') {
+          window.history.pushState({ coffeeModalOpen: true, coffeeKey: coffeeKey }, '');
+        }
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+      }
+
+      function closeCoffeeModal() {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+      }
+
+      document.querySelectorAll('.details-btn').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          openCoffeeModal(btn.getAttribute('data-coffee'), btn);
+        });
+      });
+
+      closeIconBtn.addEventListener('click', function () {
+        closeCoffeeModal();
+      });
+
+      closeActionBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        closeCoffeeModal();
+      });
+
+      // Dismiss when clicking on the dialog backdrop outside the modal content
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          closeCoffeeModal();
+        }
+      });
+
+      // Fallback for synthetic Escape key events in environments where native dialog cancel isn't triggered
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && modal.open) {
+          closeCoffeeModal();
+        }
+      });
+
+      // Dismiss on mobile back navigation / history popstate
+      window.addEventListener('popstate', function () {
+        if (modal.open) {
+          closeCoffeeModal();
+        }
+      });
+
+      // Restore focus to the trigger button when the modal closes
+      modal.addEventListener('close', function () {
+        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
+          lastFocusedElement.focus();
+        }
+      });
+    })();
+  </script>
+
