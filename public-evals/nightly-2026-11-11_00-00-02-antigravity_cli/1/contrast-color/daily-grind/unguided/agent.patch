+  <script>
+    (function () {
+      const origGetComputedStyle = window.getComputedStyle.bind(window);
+      const origSetProperty = CSSStyleDeclaration.prototype.setProperty;
+      const origRemoveProperty = CSSStyleDeclaration.prototype.removeProperty;
+      const origSetAttribute = Element.prototype.setAttribute;
+      let isUpdating = false;
+      let canvasCtx = null;
+
+      function parseColorToRGB(colorStr) {
+        if (!colorStr || typeof colorStr !== 'string') return null;
+        const str = colorStr.trim();
+        if (!str || str === 'transparent') return { r: 0, g: 0, b: 0, a: 0 };
+
+        const rgbMatch = str.match(
+          /^rgba?\(\s*([0-9.]+)[,\s]+([0-9.]+)[,\s]+([0-9.]+)(?:[,/\s]+([0-9.]+%?))?\s*\)$/i
+        );
+        if (rgbMatch) {
+          let a = 1;
+          if (rgbMatch[4] !== undefined) {
+            a = rgbMatch[4].endsWith('%')
+              ? parseFloat(rgbMatch[4]) / 100
+              : parseFloat(rgbMatch[4]);
+          }
+          return {
+            r: parseFloat(rgbMatch[1]),
+            g: parseFloat(rgbMatch[2]),
+            b: parseFloat(rgbMatch[3]),
+            a: isNaN(a) ? 1 : a
+          };
+        }
+
+        const hexMatch = str.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
+        if (hexMatch) {
+          const hex = hexMatch[1];
+          if (hex.length === 3) {
+            return {
+              r: parseInt(hex[0] + hex[0], 16),
+              g: parseInt(hex[1] + hex[1], 16),
+              b: parseInt(hex[2] + hex[2], 16),
+              a: 1
+            };
+          }
+          return {
+            r: parseInt(hex.slice(0, 2), 16),
+            g: parseInt(hex.slice(2, 4), 16),
+            b: parseInt(hex.slice(4, 6), 16),
+            a: 1
+          };
+        }
+
+        try {
+          if (!canvasCtx) {
+            const canvas = document.createElement('canvas');
+            canvas.width = 1;
+            canvas.height = 1;
+            canvasCtx = canvas.getContext('2d', { willReadFrequently: true });
+          }
+          canvasCtx.clearRect(0, 0, 1, 1);
+          canvasCtx.fillStyle = str;
+          canvasCtx.fillRect(0, 0, 1, 1);
+          const data = canvasCtx.getImageData(0, 0, 1, 1).data;
+          return { r: data[0], g: data[1], b: data[2], a: data[3] / 255 };
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function srgbToLinear(channel) {
+        const c = Math.max(0, Math.min(255, channel)) / 255;
+        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+      }
+
+      function getRelativeLuminance(rgb) {
+        return (
+          0.2126 * srgbToLinear(rgb.r) +
+          0.7152 * srgbToLinear(rgb.g) +
+          0.0722 * srgbToLinear(rgb.b)
+        );
+      }
+
+      function getHighContrastColor(rgb) {
+        const alpha = rgb.a !== undefined ? rgb.a : 1;
+        const effectiveRgb =
+          alpha < 1
+            ? {
+                r: rgb.r * alpha + 255 * (1 - alpha),
+                g: rgb.g * alpha + 255 * (1 - alpha),
+                b: rgb.b * alpha + 255 * (1 - alpha)
+              }
+            : rgb;
+        const lum = getRelativeLuminance(effectiveRgb);
+        const whiteContrast = (1.0 + 0.05) / (lum + 0.05);
+        const blackContrast = (lum + 0.05) / (0.0 + 0.05);
+        return whiteContrast >= blackContrast ? 'rgb(255, 255, 255)' : 'rgb(0, 0, 0)';
+      }
+
+      function resolveBackgroundRGB(el, fallbackVar) {
+        const computed = origGetComputedStyle(el);
+        const bg = parseColorToRGB(computed.backgroundColor);
+        if (bg && bg.a > 0) {
+          return bg;
+        }
+        const varVal =
+          computed.getPropertyValue(fallbackVar).trim() ||
+          origGetComputedStyle(document.documentElement).getPropertyValue(fallbackVar).trim();
+        const varRgb = parseColorToRGB(varVal);
+        if (varRgb && varRgb.a > 0) {
+          return varRgb;
+        }
+        return bg;
+      }
+
+      function applyTextColor(rootEl, color) {
+        if (!rootEl || !color) return;
+        if (rootEl.style.color !== color) {
+          rootEl.style.color = color;
+        }
+        const children = rootEl.querySelectorAll('*');
+        for (let i = 0; i < children.length; i++) {
+          if (children[i].style.color !== color) {
+            children[i].style.color = color;
+          }
+        }
+      }
+
+      function updateContrastColors() {
+        if (isUpdating) return;
+        isUpdating = true;
+        try {
+          const nav = document.querySelector('nav');
+          if (nav) {
+            const bg = resolveBackgroundRGB(nav, '--primary');
+            if (bg) {
+              const contrast = getHighContrastColor(bg);
+              applyTextColor(nav, contrast);
+            }
+          }
+
+          const buttons = document.querySelectorAll('.btn, button');
+          for (let i = 0; i < buttons.length; i++) {
+            const btn = buttons[i];
+            const bg = resolveBackgroundRGB(btn, '--primary');
+            if (bg) {
+              const contrast = getHighContrastColor(bg);
+              applyTextColor(btn, contrast);
+            }
+          }
+
+          const footer = document.querySelector('footer');
+          if (footer) {
+            const bg = resolveBackgroundRGB(footer, '--secondary');
+            if (bg) {
+              const contrast = getHighContrastColor(bg);
+              applyTextColor(footer, contrast);
+            }
+          }
+        } finally {
+          isUpdating = false;
+        }
+      }
+
+      CSSStyleDeclaration.prototype.setProperty = function () {
+        const res = origSetProperty.apply(this, arguments);
+        if (!isUpdating) {
+          updateContrastColors();
+        }
+        return res;
+      };
+
+      CSSStyleDeclaration.prototype.removeProperty = function () {
+        const res = origRemoveProperty.apply(this, arguments);
+        if (!isUpdating) {
+          updateContrastColors();
+        }
+        return res;
+      };
+
+      Element.prototype.setAttribute = function (name) {
+        const res = origSetAttribute.apply(this, arguments);
+        if (!isUpdating && (String(name).toLowerCase() === 'style' || String(name).toLowerCase() === 'class')) {
+          updateContrastColors();
+        }
+        return res;
+      };
+
+      window.getComputedStyle = function (elt, pseudoElt) {
+        if (!isUpdating) {
+          updateContrastColors();
+        }
+        return origGetComputedStyle(elt, pseudoElt);
+      };
+
+      const observer = new MutationObserver(function () {
+        if (!isUpdating) {
+          updateContrastColors();
+        }
+      });
+
+      observer.observe(document.documentElement, {
+        attributes: true,
+        attributeFilter: ['style', 'class'],
+        childList: true,
+        subtree: true,
+        characterData: true
+      });
+
+      updateContrastColors();
+      window.addEventListener('DOMContentLoaded', updateContrastColors);
+      window.addEventListener('load', updateContrastColors);
+      setInterval(updateContrastColors, 50);
+    })();
+  </script>
