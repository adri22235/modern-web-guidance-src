+                      </select>
+                    </div>
+
+                    <div>
+                      <label htmlFor="attestation" className="block font-medium text-gray-700 mb-1">
+                        Attestation Conveyance
+                      </label>
+                      <select
+                        id="attestation"
+                        value={attestation}
+                        onChange={(e) => setAttestation(e.target.value as AttestationConveyancePreference)}
+                        className="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-md"
+                      >
+                        <option value="none">None (Privacy preserving)</option>
+                        <option value="indirect">Indirect</option>
+                        <option value="direct">Direct (Full hardware attestation)</option>
+                      </select>
+                    </div>
+                  </div>
+                )}
+              </div>
+            )}
+
+            {/* Password Fields when mode includes password */}
+            {(registrationMode === 'password' || registrationMode === 'both') && (
+              <div className="space-y-3 pt-1">
+                <div>
+                  <label htmlFor="password" className="block text-sm font-medium text-gray-700 mb-1">
+                    Password
+                  </label>
+                  <input
+                    type="password"
+                    id="password"
+                    name="password"
+                    autoComplete="new-password"
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    required
+                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
+                  />
+                  <p className="text-xs text-gray-500 mt-1">
+                    Must be at least 8 characters and contain a number.
+                  </p>
+                </div>
+
+                <div>
+                  <label htmlFor="confirmPassword" className="block text-sm font-medium text-gray-700 mb-1">
+                    Confirm Password <span className="text-xs text-gray-400 font-normal">(optional)</span>
+                  </label>
+                  <input
+                    type="password"
+                    id="confirmPassword"
+                    name="confirmPassword"
+                    autoComplete="new-password"
+                    value={confirmPassword}
+                    onChange={(e) => setConfirmPassword(e.target.value)}
+                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
+                  />
+                </div>
+              </div>
+            )}
+
+            <button
+              type="submit"
+              disabled={loading}
+              data-skip-tracking="true"
+              data-testid="signup-submit-btn"
+              className={`w-full py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 flex items-center justify-center gap-2 ${
+                loading ? 'opacity-75 cursor-not-allowed' : ''
+              }`}
+            >
+              {(registrationMode === 'passkey' || registrationMode === 'both') && (
+                <FingerPrintIcon className="w-5 h-5 text-amber-400" />
+              )}
+              <span>
+                {loading
+                  ? registrationMode === 'password'
+                    ? 'Signing up...'
+                    : 'Creating Passkey...'
+                  : registrationMode === 'passkey'
+                  ? 'Sign Up with a Passkey'
+                  : registrationMode === 'both'
+                  ? 'Sign Up with Passkey & Password'
+                  : 'Sign Up with Password'}
+              </span>
+            </button>
+          </form>
+
+          {/* Benefits / Info Footer */}
+          <div className="mt-6 pt-5 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-gray-600">
+            <div>
+              Already have an account?{' '}
+              <a href={`${baseUrl}signin`} className="font-semibold text-gray-900 hover:underline">
+                Sign in with a passkey
+              </a>
+            </div>
+            <div>
+              <a href={`${baseUrl}account`} className="font-semibold text-amber-700 hover:underline">
+                Account & Passkey Settings →
+              </a>
+            </div>
+          </div>
+        </div>
+      </div>
     </div>
   );
 }
