+// Comprehensive WebAuthn / Passkeys utility for The DevTools Times
+// Supports registration (navigator.credentials.create), authentication (navigator.credentials.get),
+// conditional UI (autofill), passkey management, and reauthentication flows.
+
+export type AuthenticatorAttachmentPreference = 'platform' | 'cross-platform' | 'any';
+export type UserVerificationPreference = 'required' | 'preferred' | 'discouraged';
+export type ResidentKeyPreference = 'required' | 'preferred' | 'discouraged';
+export type AttestationConveyancePreference = 'none' | 'indirect' | 'direct' | 'enterprise';
+
+export interface PasskeyCredentialRecord {
+  id: string;
+  credentialId: string;
+  rawIdBase64Url: string;
+  username: string;
+  displayName: string;
+  userHandleBase64Url: string;
+  nickname: string;
+  publicKeyBase64Url?: string;
+  algorithm: string;
+  coseAlgorithm: number;
+  transports: string[];
+  authenticatorAttachment: 'platform' | 'cross-platform' | 'unknown';
+  deviceType: 'platform' | 'cross-platform';
+  backedUp: boolean;
+  backupEligible: boolean;
+  residentKey: boolean;
+  userVerification: UserVerificationPreference;
+  attestationFormat: string;
+  aaguid: string;
+  signCount: number;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface AuthSession {
+  username: string;
+  displayName: string;
+  email: string;
+  authMethod: 'passkey' | 'password';
+  credentialId?: string;
+  authenticatedAt: string;
+  lastReauthenticatedAt?: string;
+  token?: string;
+}
+
+export interface WebAuthnCeremonyEvent {
+  id: string;
+  timestamp: string;
+  type: 'registration' | 'authentication' | 'reauthentication' | 'conditional' | 'revocation';
+  status: 'success' | 'error' | 'cancelled';
+  username?: string;
+  credentialId?: string;
+  message: string;
+  details?: Record<string, any>;
+}
+
+export interface WebAuthnCapabilities {
+  webauthnSupported: boolean;
+  platformAuthenticatorAvailable: boolean;
+  conditionalMediationAvailable: boolean;
+  passkeyClientCapabilities?: Record<string, boolean>;
+}
+
+const PASSKEYS_STORAGE_KEY = 'devtools_times_passkeys_v1';
+const SESSION_STORAGE_KEY = 'devtools_times_auth_session_v1';
+const CEREMONY_LOG_STORAGE_KEY = 'devtools_times_webauthn_logs_v1';
+
+// --- Base64URL and ArrayBuffer helpers ---
+
+export function bufferToBase64Url(buffer: ArrayBuffer | Uint8Array): string {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+}
+
+export function base64UrlToUint8Array(base64Url: string): Uint8Array {
+  const padding = '='.repeat((4 - (base64Url.length % 4)) % 4);
+  const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = atob(base64);
+  const outputArray = new Uint8Array(rawData.length);
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray;
+}
+
+export function stringToUint8Array(text: string): Uint8Array {
+  return new TextEncoder().encode(text);
+}
+
+export function generateRandomChallenge(byteLength = 32): Uint8Array {
+  const array = new Uint8Array(byteLength);
+  if (typeof window !== 'undefined' && window.crypto?.getRandomValues) {
+    window.crypto.getRandomValues(array);
+  } else {
+    for (let i = 0; i < byteLength; i++) {
+      array[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return array;
+}
+
+export function getRpId(): string {
+  if (typeof window === 'undefined') {
+    return 'localhost';
+  }
+  return window.location.hostname || 'localhost';
+}
+
+// --- Capabilities detection ---
+
+export async function detectWebAuthnCapabilities(): Promise<WebAuthnCapabilities> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    return {
+      webauthnSupported: false,
+      platformAuthenticatorAvailable: false,
+      conditionalMediationAvailable: false,
+    };
+  }
+
+  let platformAuthenticatorAvailable = false;
+  let conditionalMediationAvailable = false;
+  let passkeyClientCapabilities: Record<string, boolean> | undefined;
+
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      platformAuthenticatorAvailable =
+        await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    platformAuthenticatorAvailable = false;
+  }
+
+  try {
+    if (typeof (PublicKeyCredential as any).isConditionalMediationAvailable === 'function') {
+      conditionalMediationAvailable =
+        await (PublicKeyCredential as any).isConditionalMediationAvailable();
+    }
+  } catch {
+    conditionalMediationAvailable = false;
+  }
+
+  try {
+    if (typeof (PublicKeyCredential as any).getClientCapabilities === 'function') {
+      passkeyClientCapabilities = await (PublicKeyCredential as any).getClientCapabilities();
+    }
+  } catch {
+    // Ignore if unsupported
+  }
+
+  return {
+    webauthnSupported: true,
+    platformAuthenticatorAvailable,
+    conditionalMediationAvailable,
+    passkeyClientCapabilities,
+  };
+}
+
+// --- Storage helpers for Passkey Credentials ---
+
+const DEFAULT_DEMO_PASSKEYS: PasskeyCredentialRecord[] = [
+  {
+    id: 'pk_demo_platform_1',
+    credentialId: 'dGltZXMtZGVtby1wYXNza2V5LW1hY2Jvb2stdG91Y2hpZA',
+    rawIdBase64Url: 'dGltZXMtZGVtby1wYXNza2V5LW1hY2Jvb2stdG91Y2hpZA',
+    username: 'editor@devtoolstimes.dev',
+    displayName: 'Casey Vance (Senior Editor)',
+    userHandleBase64Url: bufferToBase64Url(stringToUint8Array('editor@devtoolstimes.dev')),
+    nickname: 'MacBook Pro (Touch ID)',
+    algorithm: 'ES256 (ECDSA P-256)',
+    coseAlgorithm: -7,
+    transports: ['internal', 'hybrid'],
+    authenticatorAttachment: 'platform',
+    deviceType: 'platform',
+    backedUp: true,
+    backupEligible: true,
+    residentKey: true,
+    userVerification: 'required',
+    attestationFormat: 'none',
+    aaguid: 'adce0002-35bc-c60a-648b-0b25f1f05503',
+    signCount: 14,
+    createdAt: new Date(Date.now() - 1000 * 60 * 60 * 24 * 18).toISOString(),
+    lastUsedAt: new Date(Date.now() - 1000 * 60 * 45).toISOString(),
+  },
+  {
+    id: 'pk_demo_security_key_2',
+    credentialId: 'dGltZXMtZGVtby1wYXNza2V5LXl1YmlrZXktNWMtbmZj',
+    rawIdBase64Url: 'dGltZXMtZGVtby1wYXNza2V5LXl1YmlrZXktNWMtbmZj',
+    username: 'editor@devtoolstimes.dev',
+    displayName: 'Casey Vance (Senior Editor)',
+    userHandleBase64Url: bufferToBase64Url(stringToUint8Array('editor@devtoolstimes.dev')),
+    nickname: 'YubiKey 5C NFC (Hardware Key)',
+    algorithm: 'EdDSA (Ed25519)',
+    coseAlgorithm: -8,
+    transports: ['usb', 'nfc'],
+    authenticatorAttachment: 'cross-platform',
+    deviceType: 'cross-platform',
+    backedUp: false,
+    backupEligible: false,
+    residentKey: true,
+    userVerification: 'preferred',
+    attestationFormat: 'packed',
+    aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a',
+    signCount: 5,
+    createdAt: new Date(Date.now() - 1000 * 60 * 60 * 24 * 45).toISOString(),
+    lastUsedAt: new Date(Date.now() - 1000 * 60 * 60 * 24 * 6).toISOString(),
+  },
+];
+
+export function getStoredPasskeys(): PasskeyCredentialRecord[] {
+  if (typeof window === 'undefined') return DEFAULT_DEMO_PASSKEYS;
+  try {
+    const raw = window.localStorage.getItem(PASSKEYS_STORAGE_KEY);
+    if (!raw) {
+      window.localStorage.setItem(PASSKEYS_STORAGE_KEY, JSON.stringify(DEFAULT_DEMO_PASSKEYS));
+      return DEFAULT_DEMO_PASSKEYS;
+    }
+    const parsed = JSON.parse(raw);
+    return Array.isArray(parsed) ? parsed : DEFAULT_DEMO_PASSKEYS;
+  } catch {
+    return DEFAULT_DEMO_PASSKEYS;
+  }
+}
+
+export function saveStoredPasskeys(passkeys: PasskeyCredentialRecord[]): void {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.setItem(PASSKEYS_STORAGE_KEY, JSON.stringify(passkeys));
+    window.dispatchEvent(new CustomEvent('passkeys-updated', { detail: passkeys }));
+  } catch {
+    // Ignore storage quota errors
+  }
+}
+
+export function getPasskeysForUser(username?: string): PasskeyCredentialRecord[] {
+  const all = getStoredPasskeys();
+  if (!username || !username.trim()) return all;
+  const normalized = username.trim().toLowerCase();
+  return all.filter((pk) => pk.username.toLowerCase() === normalized);
+}
+
+// --- Session management ---
+
+export function getStoredSession(): AuthSession | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = window.localStorage.getItem(SESSION_STORAGE_KEY);
+    if (!raw) return null;
+    return JSON.parse(raw) as AuthSession;
+  } catch {
+    return null;
+  }
+}
+
+export function setStoredSession(session: AuthSession | null): void {
+  if (typeof window === 'undefined') return;
+  try {
+    if (session) {
+      window.localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
+    } else {
+      window.localStorage.removeItem(SESSION_STORAGE_KEY);
+    }
+    window.dispatchEvent(new CustomEvent('auth-session-updated', { detail: session }));
+  } catch {
+    // Ignore
+  }
+}
+
+export function isReauthFresh(session: AuthSession | null, maxAgeMs = 5 * 60 * 1000): boolean {
+  if (!session?.lastReauthenticatedAt) return false;
+  const elapsed = Date.now() - new Date(session.lastReauthenticatedAt).getTime();
+  return elapsed >= 0 && elapsed <= maxAgeMs;
+}
+
+// --- Ceremony Logging (great for DevTools inspection & UI feedback) ---
+
+export function getCeremonyLogs(): WebAuthnCeremonyEvent[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = window.localStorage.getItem(CEREMONY_LOG_STORAGE_KEY);
+    return raw ? JSON.parse(raw) : [];
+  } catch {
+    return [];
+  }
+}
+
+export function logCeremonyEvent(
+  event: Omit<WebAuthnCeremonyEvent, 'id' | 'timestamp'>
+): WebAuthnCeremonyEvent {
+  const entry: WebAuthnCeremonyEvent = {
+    ...event,
+    id: `evt_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
+    timestamp: new Date().toISOString(),
+  };
+  if (typeof window !== 'undefined') {
+    try {
+      const existing = getCeremonyLogs();
+      const updated = [entry, ...existing].slice(0, 30);
+      window.localStorage.setItem(CEREMONY_LOG_STORAGE_KEY, JSON.stringify(updated));
+      window.dispatchEvent(new CustomEvent('webauthn-ceremony-log', { detail: entry }));
+    } catch {
+      // Ignore
+    }
+  }
+  return entry;
+}
+
+// --- Parse authenticatorData flags (UP, UV, BE, BS, signCount, AAGUID) ---
+
+export function parseAuthenticatorData(authDataBuffer: ArrayBuffer): {
+  userPresent: boolean;
+  userVerified: boolean;
+  backupEligible: boolean;
+  backedUp: boolean;
+  attestedCredentialDataIncluded: boolean;
+  signCount: number;
+  aaguid: string;
+} {
+  const bytes = new Uint8Array(authDataBuffer);
+  if (bytes.byteLength < 37) {
+    return {
+      userPresent: true,
+      userVerified: true,
+      backupEligible: true,
+      backedUp: false,
+      attestedCredentialDataIncluded: false,
+      signCount: 0,
+      aaguid: '00000000-0000-0000-0000-000000000000',
+    };
+  }
+  const flags = bytes[32];
+  const userPresent = (flags & 0x01) !== 0;
+  const userVerified = (flags & 0x04) !== 0;
+  const backupEligible = (flags & 0x08) !== 0;
+  const backedUp = (flags & 0x10) !== 0;
+  const attestedCredentialDataIncluded = (flags & 0x40) !== 0;
+
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const signCount = view.getUint32(33, false);
+
+  let aaguid = '00000000-0000-0000-0000-000000000000';
+  if (attestedCredentialDataIncluded && bytes.byteLength >= 53) {
+    const aaguidBytes = bytes.slice(37, 53);
+    const hex = Array.from(aaguidBytes)
+      .map((b) => b.toString(16).padStart(2, '0'))
+      .join('');
+    aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(
+      16,
+      20
+    )}-${hex.slice(20, 32)}`;
+  }
+
+  return {
+    userPresent,
+    userVerified,
+    backupEligible,
+    backedUp,
+    attestedCredentialDataIncluded,
+    signCount,
+    aaguid,
+  };
+}
+
+export function getAlgorithmLabel(coseAlg: number): string {
+  switch (coseAlg) {
+    case -7:
+      return 'ES256 (ECDSA P-256)';
+    case -8:
+      return 'EdDSA (Ed25519)';
+    case -257:
+      return 'RS256 (RSASSA-PKCS1-v1_5)';
+    default:
+      return `COSE Alg (${coseAlg})`;
+  }
+}
+
+export function detectDefaultPasskeyName(attachment: 'platform' | 'cross-platform' | 'unknown'): string {
+  if (attachment === 'cross-platform') {
+    return 'Hardware Security Key';
+  }
+  if (typeof navigator !== 'undefined') {
+    const ua = navigator.userAgent || '';
+    if (/Mac|iPhone|iPad/i.test(ua)) return 'Apple Passkey (iCloud Keychain / Touch ID)';
+    if (/Windows/i.test(ua)) return 'Windows Hello Passkey';
+    if (/Android/i.test(ua)) return 'Google Password Manager Passkey';
+    if (/Linux/i.test(ua)) return 'Chrome Profile Passkey (Linux)';
+  }
+  return 'Platform Passkey';
+}
+
+// --- WebAuthn Registration (navigator.credentials.create) ---
+
+export interface RegisterPasskeyOptions {
+  username: string;
+  displayName?: string;
+  nickname?: string;
+  authenticatorAttachment?: AuthenticatorAttachmentPreference;
+  userVerification?: UserVerificationPreference;
+  residentKey?: ResidentKeyPreference;
+  attestation?: AttestationConveyancePreference;
+  excludeExisting?: boolean;
+}
+
+export async function registerPasskey(
+  options: RegisterPasskeyOptions
+): Promise<PasskeyCredentialRecord> {
+  const username = options.username.trim();
+  if (!username) {
+    throw new Error('Username is required to register a passkey.');
+  }
+
+  const displayName = (options.displayName || username).trim();
+  const attachmentPref = options.authenticatorAttachment || 'any';
+  const userVerification = options.userVerification || 'preferred';
+  const residentKey = options.residentKey || 'required';
+  const attestation = options.attestation || 'none';
+
+  const challenge = generateRandomChallenge(32);
+  const userIdBytes = stringToUint8Array(username);
+  const existingUserPasskeys = getPasskeysForUser(username);
+
+  const excludeCredentials: PublicKeyCredentialDescriptor[] =
+    options.excludeExisting !== false
+      ? existingUserPasskeys
+          .map((pk) => {
+            try {
+              return {
+                id: base64UrlToUint8Array(pk.rawIdBase64Url) as unknown as BufferSource,
+                type: 'public-key' as const,
+                transports: pk.transports as AuthenticatorTransport[],
+              };
+            } catch {
+              return null;
+            }
+          })
+          .filter((item): item is NonNullable<typeof item> => item !== null)
+      : [];
+
+  const authenticatorSelection: AuthenticatorSelectionCriteria = {
+    userVerification,
+    residentKey,
+    requireResidentKey: residentKey === 'required',
+  };
+
+  if (attachmentPref === 'platform' || attachmentPref === 'cross-platform') {
+    authenticatorSelection.authenticatorAttachment = attachmentPref;
+  }
+
+  const publicKeyOptions: PublicKeyCredentialCreationOptions = {
+    challenge: challenge as unknown as BufferSource,
+    rp: {
+      name: 'The DevTools Times',
+      id: getRpId(),
+    },
+    user: {
+      id: userIdBytes as unknown as BufferSource,
+      name: username,
+      displayName,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 }, // ES256
+      { type: 'public-key', alg: -8 }, // EdDSA
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    timeout: 60000,
+    attestation,
+    authenticatorSelection,
+    excludeCredentials,
+  };
+
+  if (typeof window === 'undefined' || !navigator.credentials?.create) {
+    const err = new Error('WebAuthn is not supported in this browser environment.');
+    logCeremonyEvent({
+      type: 'registration',
+      status: 'error',
+      username,
+      message: err.message,
+    });
+    throw err;
+  }
+
+  try {
+    const credential = (await navigator.credentials.create({
+      publicKey: publicKeyOptions,
+    })) as PublicKeyCredential | null;
+
+    if (!credential) {
+      throw new Error('Passkey creation returned no credential.');
+    }
+
+    const response = credential.response as AuthenticatorAttestationResponse;
+    const rawIdBase64Url = bufferToBase64Url(credential.rawId);
+
+    let transports: string[] = ['internal', 'hybrid'];
+    if (typeof response.getTransports === 'function') {
+      const detected = response.getTransports();
+      if (detected && detected.length > 0) {
+        transports = detected;
+      }
+    }
+
+    let coseAlgorithm = -7;
+    if (typeof response.getPublicKeyAlgorithm === 'function') {
+      try {
+        coseAlgorithm = response.getPublicKeyAlgorithm();
+      } catch {
+        coseAlgorithm = -7;
+      }
+    }
+
+    let publicKeyBase64Url: string | undefined;
+    if (typeof response.getPublicKey === 'function') {
+      try {
+        const pkBuf = response.getPublicKey();
+        if (pkBuf) {
+          publicKeyBase64Url = bufferToBase64Url(pkBuf);
+        }
+      } catch {
+        // Ignore
+      }
+    }
+
+    let authDataInfo = {
+      userPresent: true,
+      userVerified: true,
+      backupEligible: true,
+      backedUp: true,
+      attestedCredentialDataIncluded: true,
+      signCount: 0,
+      aaguid: '00000000-0000-0000-0000-000000000000',
+    };
+
+    if (typeof response.getAuthenticatorData === 'function') {
+      try {
+        authDataInfo = parseAuthenticatorData(response.getAuthenticatorData());
+      } catch {
+        // Fallback
+      }
+    }
+
+    const attachment =
+      (credential.authenticatorAttachment as 'platform' | 'cross-platform' | null) ||
+      (attachmentPref === 'cross-platform' ? 'cross-platform' : 'platform');
+
+    const deviceType: 'platform' | 'cross-platform' =
+      attachment === 'cross-platform' ? 'cross-platform' : 'platform';
+
+    const nickname =
+      options.nickname?.trim() || detectDefaultPasskeyName(attachment);
+
+    const record: PasskeyCredentialRecord = {
+      id: `pk_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
+      credentialId: credential.id || rawIdBase64Url,
+      rawIdBase64Url,
+      username,
+      displayName,
+      userHandleBase64Url: bufferToBase64Url(userIdBytes),
+      nickname,
+      publicKeyBase64Url,
+      algorithm: getAlgorithmLabel(coseAlgorithm),
+      coseAlgorithm,
+      transports,
+      authenticatorAttachment: attachment,
+      deviceType,
+      backedUp: authDataInfo.backedUp,
+      backupEligible: authDataInfo.backupEligible,
+      residentKey: residentKey !== 'discouraged',
+      userVerification,
+      attestationFormat: attestation,
+      aaguid: authDataInfo.aaguid,
+      signCount: authDataInfo.signCount,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+    };
+
+    const allPasskeys = getStoredPasskeys();
+    saveStoredPasskeys([record, ...allPasskeys]);
+
+    logCeremonyEvent({
+      type: 'registration',
+      status: 'success',
+      username,
+      credentialId: record.credentialId,
+      message: `Registered passkey "${record.nickname}" (${record.algorithm})`,
+      details: {
+        authenticatorAttachment: record.authenticatorAttachment,
+        transports: record.transports,
+        aaguid: record.aaguid,
+        backedUp: record.backedUp,
+      },
+    });
+
+    return record;
+  } catch (err: any) {
+    const friendlyMessage = formatWebAuthnError(err, 'registration');
+    logCeremonyEvent({
+      type: 'registration',
+      status: err?.name === 'NotAllowedError' ? 'cancelled' : 'error',
+      username,
+      message: friendlyMessage,
+      details: { errorName: err?.name, rawMessage: err?.message },
+    });
+    const wrapped = new Error(friendlyMessage);
+    (wrapped as any).code = err?.name || 'WEBAUTHN_REGISTER_ERROR';
+    throw wrapped;
+  }
+}
+
+// --- WebAuthn Authentication & Reauthentication (navigator.credentials.get) ---
+
+export interface AuthenticatePasskeyOptions {
+  username?: string;
+  userVerification?: UserVerificationPreference;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  isReauthentication?: boolean;
+  allowAnyDiscoverable?: boolean;
+}
+
+export interface AuthenticatePasskeyResult {
+  credential: PublicKeyCredential;
+  record: PasskeyCredentialRecord;
+  session: AuthSession;
+  authenticatorFlags: ReturnType<typeof parseAuthenticatorData>;
+}
+
+export async function authenticateWithPasskey(
+  options: AuthenticatePasskeyOptions = {}
+): Promise<AuthenticatePasskeyResult> {
+  const username = options.username?.trim();
+  const userVerification =
+    options.userVerification || (options.isReauthentication ? 'required' : 'preferred');
+  const ceremonyType = options.isReauthentication
+    ? 'reauthentication'
+    : options.mediation === 'conditional'
+    ? 'conditional'
+    : 'authentication';
+
+  if (typeof window === 'undefined' || !navigator.credentials?.get) {
+    const err = new Error('WebAuthn authentication is not supported in this browser.');
+    logCeremonyEvent({
+      type: ceremonyType,
+      status: 'error',
+      username,
+      message: err.message,
+    });
+    throw err;
+  }
+
+  const challenge = generateRandomChallenge(32);
+
+  // If a username is specified and allowAnyDiscoverable is not forced, scope allowCredentials
+  // to known local passkeys for that user if any exist (while still allowing discoverable credentials if none match)
+  const userPasskeys = username ? getPasskeysForUser(username) : [];
+  const allowCredentials: PublicKeyCredentialDescriptor[] =
+    !options.allowAnyDiscoverable && username && userPasskeys.length > 0
+      ? userPasskeys
+          .map((pk) => {
+            try {
+              return {
+                id: base64UrlToUint8Array(pk.rawIdBase64Url) as unknown as BufferSource,
+                type: 'public-key' as const,
+                transports: pk.transports as AuthenticatorTransport[],
+              };
+            } catch {
+              return null;
+            }
+          })
+          .filter((item): item is NonNullable<typeof item> => item !== null)
+      : [];
+
+  const publicKeyRequestOptions: PublicKeyCredentialRequestOptions = {
+    challenge: challenge as unknown as BufferSource,
+    rpId: getRpId(),
+    timeout: 60000,
+    userVerification,
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  const credentialGetOptions: CredentialRequestOptions = {
+    publicKey: publicKeyRequestOptions,
+    ...(options.mediation ? { mediation: options.mediation } : {}),
+    ...(options.signal ? { signal: options.signal } : {}),
+  };
+
+  try {
+    const assertion = (await navigator.credentials.get(
+      credentialGetOptions
+    )) as PublicKeyCredential | null;
+
+    if (!assertion) {
+      throw new Error('No passkey assertion was returned by the authenticator.');
+    }
+
+    const response = assertion.response as AuthenticatorAssertionResponse;
+    const rawIdBase64Url = bufferToBase64Url(assertion.rawId);
+    const credentialId = assertion.id || rawIdBase64Url;
+
+    const authenticatorFlags = response.authenticatorData
+      ? parseAuthenticatorData(response.authenticatorData)
+      : {
+          userPresent: true,
+          userVerified: true,
+          backupEligible: true,
+          backedUp: true,
+          attestedCredentialDataIncluded: false,
+          signCount: 1,
+          aaguid: '00000000-0000-0000-0000-000000000000',
+        };
+
+    // Decode userHandle if returned by discoverable credential
+    let assertedUsername = username || '';
+    if (response.userHandle && response.userHandle.byteLength > 0) {
+      try {
+        const decoded = new TextDecoder().decode(response.userHandle);
+        if (decoded && /^[\x20-\x7E]+$/.test(decoded)) {
+          assertedUsername = decoded;
+        }
+      } catch {
+        // Ignore
+      }
+    }
+
+    const allPasskeys = getStoredPasskeys();
+    let matchedRecord = allPasskeys.find(
+      (pk) => pk.credentialId === credentialId || pk.rawIdBase64Url === rawIdBase64Url
+    );
+
+    const nowIso = new Date().toISOString();
+
+    if (matchedRecord) {
+      matchedRecord = {
+        ...matchedRecord,
+        lastUsedAt: nowIso,
+        signCount: Math.max(matchedRecord.signCount + 1, authenticatorFlags.signCount),
+        backedUp: authenticatorFlags.backedUp,
+      };
+      const updatedList = allPasskeys.map((pk) =>
+        pk.id === matchedRecord!.id ? matchedRecord! : pk
+      );
+      saveStoredPasskeys(updatedList);
+    } else {
+      // If authenticated with a passkey from the browser/OS virtual authenticator not yet in local list,
+      // register it in our local credential store so the user can manage it in Account Settings.
+      const resolvedUser = assertedUsername || username || 'reader@devtoolstimes.dev';
+      const attachment =
+        (assertion.authenticatorAttachment as 'platform' | 'cross-platform' | null) || 'platform';
+      matchedRecord = {
+        id: `pk_${Date.now()}`,
+        credentialId,
+        rawIdBase64Url,
+        username: resolvedUser,
+        displayName: resolvedUser,
+        userHandleBase64Url: response.userHandle
+          ? bufferToBase64Url(response.userHandle)
+          : bufferToBase64Url(stringToUint8Array(resolvedUser)),
+        nickname: detectDefaultPasskeyName(attachment),
+        algorithm: 'ES256 (ECDSA P-256)',
+        coseAlgorithm: -7,
+        transports: ['internal', 'hybrid'],
+        authenticatorAttachment: attachment,
+        deviceType: attachment === 'cross-platform' ? 'cross-platform' : 'platform',
+        backedUp: authenticatorFlags.backedUp,
+        backupEligible: authenticatorFlags.backupEligible,
+        residentKey: true,
+        userVerification,
+        attestationFormat: 'none',
+        aaguid: authenticatorFlags.aaguid,
+        signCount: authenticatorFlags.signCount || 1,
+        createdAt: nowIso,
+        lastUsedAt: nowIso,
+      };
+      saveStoredPasskeys([matchedRecord, ...allPasskeys]);
+    }
+
+    const currentSession = getStoredSession();
+    const session: AuthSession = {
+      username: matchedRecord.username,
+      displayName: matchedRecord.displayName || matchedRecord.username,
+      email: matchedRecord.username.includes('@')
+        ? matchedRecord.username
+        : `${matchedRecord.username}@devtoolstimes.dev`,
+      authMethod: 'passkey',
+      credentialId: matchedRecord.credentialId,
+      authenticatedAt: options.isReauthentication && currentSession
+        ? currentSession.authenticatedAt
+        : nowIso,
+      lastReauthenticatedAt: nowIso,
+    };
+
+    setStoredSession(session);
+
+    logCeremonyEvent({
+      type: ceremonyType,
+      status: 'success',
+      username: matchedRecord.username,
+      credentialId: matchedRecord.credentialId,
+      message: options.isReauthentication
+        ? `Reauthenticated "${matchedRecord.username}" with passkey "${matchedRecord.nickname}"`
+        : `Signed in as "${matchedRecord.username}" with passkey "${matchedRecord.nickname}"`,
+      details: {
+        signCount: matchedRecord.signCount,
+        userVerified: authenticatorFlags.userVerified,
+      },
+    });
+
+    return {
+      credential: assertion,
+      record: matchedRecord,
+      session,
+      authenticatorFlags,
+    };
+  } catch (err: any) {
+    if (err?.name === 'AbortError') {
+      throw err;
+    }
+    const friendlyMessage = formatWebAuthnError(err, ceremonyType);
+    logCeremonyEvent({
+      type: ceremonyType,
+      status: err?.name === 'NotAllowedError' ? 'cancelled' : 'error',
+      username,
+      message: friendlyMessage,
+      details: { errorName: err?.name, rawMessage: err?.message },
+    });
+    const wrapped = new Error(friendlyMessage);
+    (wrapped as any).code = err?.name || 'WEBAUTHN_AUTH_ERROR';
+    throw wrapped;
+  }
+}
+
+// --- Management Operations (Rename, Delete, Revoke) ---
+
+export function renamePasskeyCredential(id: string, newNickname: string): PasskeyCredentialRecord[] {
+  const trimmed = newNickname.trim();
+  if (!trimmed) return getStoredPasskeys();
+  const updated = getStoredPasskeys().map((pk) =>
+    pk.id === id || pk.credentialId === id ? { ...pk, nickname: trimmed } : pk
+  );
+  saveStoredPasskeys(updated);
+  return updated;
+}
+
+export function deletePasskeyCredential(id: string): PasskeyCredentialRecord[] {
+  const all = getStoredPasskeys();
+  const target = all.find((pk) => pk.id === id || pk.credentialId === id);
+  const updated = all.filter((pk) => pk.id !== id && pk.credentialId !== id);
+  saveStoredPasskeys(updated);
+
+  if (target) {
+    // Also notify PublicKeyCredential.signalUnknownCredential if supported by the browser
+    if (
+      typeof window !== 'undefined' &&
+      typeof (PublicKeyCredential as any)?.signalUnknownCredential === 'function'
+    ) {
+      try {
+        (PublicKeyCredential as any).signalUnknownCredential({
+          rpId: getRpId(),
+          credentialId: target.rawIdBase64Url,
+        });
+      } catch {
+        // Ignore if unsupported
+      }
+    }
+
+    logCeremonyEvent({
+      type: 'revocation',
+      status: 'success',
+      username: target.username,
+      credentialId: target.credentialId,
+      message: `Revoked passkey "${target.nickname}"`,
+    });
+  }
+
+  return updated;
+}
+
+export function formatWebAuthnError(err: any, ceremony: string): string {
+  const name = err?.name || '';
+  if (name === 'InvalidStateError') {
+    return 'A passkey for this authenticator is already registered on this account.';
+  }
+  if (name === 'NotAllowedError') {
+    return `Passkey ${ceremony} was cancelled, timed out, or not allowed by the authenticator.`;
+  }
+  if (name === 'SecurityError') {
+    return 'WebAuthn security error: ensure the page is served over HTTPS or localhost with a valid RP ID.';
+  }
+  if (name === 'NotSupportedError') {
+    return 'The selected authenticator does not support the requested passkey parameters.';
+  }
+  if (name === 'ConstraintError') {
+    return 'The requested authenticator attachment or resident key requirement could not be satisfied by any connected authenticator.';
+  }
+  return err?.message || `An unexpected error occurred during passkey ${ceremony}.`;
+}
