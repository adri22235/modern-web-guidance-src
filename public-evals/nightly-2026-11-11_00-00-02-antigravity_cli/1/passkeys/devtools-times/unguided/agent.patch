+
+        {/* Recent WebAuthn Ceremony Activity Log */}
+        <div className="bg-white border border-gray-200 rounded-xl p-5 shadow-xs space-y-3">
+          <div className="flex items-center justify-between">
+            <h3 className="text-sm font-bold text-gray-900 flex items-center gap-2">
+              <ClockIcon className="w-4 h-4 text-gray-700" />
+              <span>Recent WebAuthn Activity</span>
+            </h3>
+            <span className="text-[11px] text-gray-400">{ceremonyLogs.length} event(s)</span>
+          </div>
+
+          {ceremonyLogs.length === 0 ? (
+            <p className="text-xs text-gray-500 py-4 text-center">
+              No passkey ceremonies recorded in this browser session yet.
+            </p>
+          ) : (
+            <ul className="space-y-2 max-h-44 overflow-y-auto text-xs" data-testid="ceremony-log-list">
+              {ceremonyLogs.slice(0, 8).map((evt) => (
+                <li
+                  key={evt.id}
+                  className="p-2 rounded bg-gray-50 border border-gray-200 flex items-start justify-between gap-2"
+                >
+                  <div className="space-y-0.5">
+                    <div className="flex items-center gap-1.5">
+                      <span
+                        className={`w-2 h-2 rounded-full ${
+                          evt.status === 'success'
+                            ? 'bg-emerald-500'
+                            : evt.status === 'cancelled'
+                            ? 'bg-amber-500'
+                            : 'bg-red-500'
+                        }`}
+                      />
+                      <span className="font-semibold uppercase text-[10px] tracking-wider text-gray-600">
+                        {evt.type}
+                      </span>
+                    </div>
+                    <p className="text-gray-800">{evt.message}</p>
+                  </div>
+                  <span className="text-[10px] text-gray-400 shrink-0">
+                    {new Date(evt.timestamp).toLocaleTimeString()}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </section>
+
+      {/* Step-up Reauthentication Modal */}
+      <ReauthModal
+        isOpen={pendingAction !== null}
+        username={accountUsername}
+        actionTitle={pendingAction?.title || 'Verify Your Identity'}
+        actionDescription={
+          pendingAction?.description ||
+          'Please verify with your passkey before completing this sensitive action.'
+        }
+        onCancel={() => setPendingAction(null)}
+        onSuccess={(verifiedRecord) => {
+          const action = pendingAction;
+          setPendingAction(null);
+          refreshState();
+          if (action) {
+            action.execute(verifiedRecord);
+          }
+        }}
+      />
+    </div>
+  );
+}
