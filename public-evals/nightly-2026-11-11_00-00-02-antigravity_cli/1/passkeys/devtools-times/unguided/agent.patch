new file mode 100644
index 0000000..083ed3b
--- /dev/null
+++ b/src/components/ReauthModal.tsx
@@ -0,0 +1,148 @@
+import React, { useState } from 'react';
+import {
+  FingerPrintIcon,
+  ShieldCheckIcon,
+  ExclamationCircleIcon,
+  XMarkIcon,
+  LockClosedIcon,
+} from '@heroicons/react/24/outline';
+import {
+  type PasskeyCredentialRecord,
+  authenticateWithPasskey,
+} from '../utils/passkeys';
+
+export interface ReauthModalProps {
+  isOpen: boolean;
+  username?: string;
+  actionTitle: string;
+  actionDescription: string;
+  onSuccess: (record: PasskeyCredentialRecord) => void;
+  onCancel: () => void;
+}
+
+export default function ReauthModal({
+  isOpen,
+  username,
+  actionTitle,
+  actionDescription,
+  onSuccess,
+  onCancel,
+}: ReauthModalProps) {
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  if (!isOpen) return null;
+
+  const handleVerifyPasskey = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      const result = await authenticateWithPasskey({
+        username,
+        userVerification: 'required',
+        isReauthentication: true,
+        allowAnyDiscoverable: false,
+      });
+      onSuccess(result.record);
+    } catch (err: any) {
+      setError(err?.message || 'Passkey verification failed or was cancelled.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-[99999] bg-black/50 backdrop-blur-xs flex items-center justify-center p-4"
+      role="dialog"
