+        // Populate profile form fields when entering signed-in state or after profile save
+        if (populateProfileForm) {
+          els.profileName.value = user.name || '';
+          els.profileEmail.value = user.email || '';
+          els.profilePhone.value = user.phone || '';
+          els.profileCoffee.value = user.favoriteCoffee || '';
+          els.profileLocation.value = user.location || 'Downtown Roastery';
+        }
+
+        // Render saved passkeys list
+        renderPasskeysList(user);
+      }
+
+      // =========================================================
+      // Event Handlers for the 5 Core Features
+      // =========================================================
+
+      // 1. Customer Registration with Passkey
+      async function handleRegister(event) {
+        event.preventDefault();
+        hideStatus();
+
+        const rawName = els.registerName.value.trim();
+        const rawEmail = els.registerEmail.value.trim().toLowerCase();
+        const rawCoffee = els.registerCoffee.value.trim();
+        const rawPasskeyName = els.registerPasskeyName.value.trim();
+
+        if (!rawEmail && !rawName) {
+          showStatus('Please enter your name and email address to register an account.', 'error');
+          return;
+        }
+
+        const email = rawEmail || (rawName.toLowerCase().replace(/\s+/g, '.') + '@dailygrind.coffee');
+        const name = rawName || email.split('@')[0];
+
+        const users = loadUsers();
+        const existing = users.find(u => u.email.toLowerCase() === email);
+        if (existing) {
+          showStatus('An account with email "' + email + '" already exists. Please sign in with your passkey.', 'error');
+          return;
+        }
+
+        const newUser = {
+          id: generateId('cust'),
+          name: name,
+          email: email,
+          phone: '',
+          favoriteCoffee: rawCoffee || 'Maple Oat Latte',
+          location: 'Downtown Roastery',
+          createdAt: new Date().toISOString(),
+          updatedAt: new Date().toISOString(),
+          passkeys: []
+        };
+
+        try {
+          const passkeyRecord = await createPasskeyCredential(newUser, rawPasskeyName || 'Primary Passkey');
+          newUser.passkeys.push(passkeyRecord);
+
+          users.push(newUser);
+          saveUsers(users);
+
+          const nowIso = new Date().toISOString();
+          saveSession({
+            userId: newUser.id,
+            authenticatedAt: nowIso,
+            lastAuthenticatedAt: nowIso,
+            lastPasskeyId: passkeyRecord.credentialId,
+            lastPasskeyName: passkeyRecord.name,
+            reauthCount: 1,
+            locked: false
+          });
+
+          els.registerForm.reset();
+          renderUI(true);
+          showStatus('Welcome to The Daily Grind, ' + newUser.name + '! Your account and passkey ("' + passkeyRecord.name + '") have been registered.', 'success');
+        } catch (err) {
+          showStatus('Passkey registration failed or was cancelled: ' + (err && err.message ? err.message : String(err)), 'error');
+        }
+      }
+
+      // 2. Sign-In Authentication with Passkey
+      async function handleSignIn(event) {
+        event.preventDefault();
+        hideStatus();
+
+        const emailInput = els.signinEmail.value.trim().toLowerCase();
+        const users = loadUsers();
+
+        let candidateUsers = users;
+        let allowedPasskeys = [];
+
+        if (emailInput) {
+          const matchedUser = users.find(u => u.email.toLowerCase() === emailInput);
+          if (!matchedUser) {
+            showStatus('No customer account found for "' + emailInput + '". Please register first.', 'error');
+            return;
+          }
+          if (!Array.isArray(matchedUser.passkeys) || matchedUser.passkeys.length === 0) {
+            showStatus('No saved passkeys are available for "' + emailInput + '".', 'error');
+            return;
+          }
+          candidateUsers = [matchedUser];
+          allowedPasskeys = matchedUser.passkeys;
+        } else {
+          // Discoverable / one-click passkey sign-in across registered accounts
+          users.forEach(function (u) {
+            if (Array.isArray(u.passkeys)) {
+              allowedPasskeys = allowedPasskeys.concat(u.passkeys);
+            }
+          });
+        }
+
+        try {
+          const assertionResult = await requestPasskeyAssertion(allowedPasskeys);
+
+          let authenticatedUser = null;
+          let matchedPasskey = null;
+
+          for (let i = 0; i < candidateUsers.length; i++) {
+            const u = candidateUsers[i];
+            const pks = Array.isArray(u.passkeys) ? u.passkeys : [];
+            const foundPk = pks.find(pk => matchesPasskey(pk, assertionResult));
+            if (foundPk) {
+              authenticatedUser = u;
+              matchedPasskey = foundPk;
+              break;
+            }
+          }
+
+          if (!authenticatedUser || !matchedPasskey) {
+            showStatus('Passkey verification failed: the presented passkey is not linked to an active Daily Grind account.', 'error');
+            return;
+          }
+
+          const nowIso = new Date().toISOString();
+          matchedPasskey.lastUsedAt = nowIso;
+          matchedPasskey.usageCount = (matchedPasskey.usageCount || 1) + 1;
+          saveUsers(users);
+
+          saveSession({
+            userId: authenticatedUser.id,
+            authenticatedAt: nowIso,
+            lastAuthenticatedAt: nowIso,
+            lastPasskeyId: matchedPasskey.credentialId,
+            lastPasskeyName: matchedPasskey.name,
+            reauthCount: 1,
+            locked: false
+          });
+
+          els.signinForm.reset();
+          renderUI(true);
+          showStatus('Signed in as ' + authenticatedUser.name + ' using passkey "' + matchedPasskey.name + '".', 'success');
+        } catch (err) {
+          showStatus('Passkey sign-in failed or was cancelled: ' + (err && err.message ? err.message : String(err)), 'error');
+        }
+      }
+
+      // 3. Reauthentication (Explicit & Step-Up Helper)
+      async function verifyCurrentUserPasskey(reasonLabel) {
+        const user = getCurrentUser();
+        const session = loadSession();
+        if (!user || !session) {
+          throw new Error('You must be signed in to reauthenticate.');
+        }
+
+        const passkeys = Array.isArray(user.passkeys) ? user.passkeys : [];
+        if (passkeys.length === 0) {
+          throw new Error('No saved passkeys are registered on your account to verify identity.');
+        }
+
+        const assertionResult = await requestPasskeyAssertion(passkeys);
+        const users = loadUsers();
+        const storedUser = users.find(u => u.id === user.id);
+        if (!storedUser) {
+          throw new Error('Account record not found.');
+        }
+
+        const matchedPk = (storedUser.passkeys || []).find(pk => matchesPasskey(pk, assertionResult));
+        if (!matchedPk) {
+          throw new Error('Presented passkey does not match any saved passkey for this account.');
+        }
+
+        const nowIso = new Date().toISOString();
+        matchedPk.lastUsedAt = nowIso;
+        matchedPk.usageCount = (matchedPk.usageCount || 1) + 1;
+        saveUsers(users);
+
+        session.lastAuthenticatedAt = nowIso;
+        session.lastPasskeyId = matchedPk.credentialId;
+        session.lastPasskeyName = matchedPk.name;
+        session.reauthCount = (session.reauthCount || 1) + 1;
+        session.locked = false;
+        saveSession(session);
+
+        return {
+          user: storedUser,
+          passkey: matchedPk,
+          reason: reasonLabel
+        };
+      }
+
+      async function handleExplicitReauthenticate() {
+        hideStatus();
+        try {
+          const result = await verifyCurrentUserPasskey('session reauthentication');
+          renderUI(false);
+          showStatus('Reauthentication successful! Identity verified with passkey "' + result.passkey.name + '".', 'success');
+        } catch (err) {
+          showStatus('Reauthentication failed or was cancelled: ' + (err && err.message ? err.message : String(err)), 'error');
+        }
+      }
+
+      function handleLockSession() {
+        const session = loadSession();
+        if (!session) return;
+        session.locked = true;
+        saveSession(session);
+        renderUI(false);
+        showStatus('Session locked. Please reauthenticate with your passkey before making sensitive account changes.', 'info');
+      }
+
+      // 4. Profile Updates (with Passkey Reauthentication)
+      async function handleProfileUpdate(event) {
+        event.preventDefault();
+        hideStatus();
+
+        const currentUser = getCurrentUser();
+        if (!currentUser) {
+          showStatus('Please sign in to update your profile.', 'error');
+          return;
+        }
+
+        const newName = els.profileName.value.trim();
+        const newEmail = els.profileEmail.value.trim().toLowerCase();
+        const newPhone = els.profilePhone.value.trim();
+        const newCoffee = els.profileCoffee.value.trim();
+        const newLocation = els.profileLocation.value;
+
+        if (!newName || !newEmail) {
+          showStatus('Full Name and Email Address are required to update your profile.', 'error');
+          return;
+        }
+
+        const users = loadUsers();
+        const emailConflict = users.find(u => u.id !== currentUser.id && u.email.toLowerCase() === newEmail);
+        if (emailConflict) {
+          showStatus('Another account is already using "' + newEmail + '".', 'error');
+          return;
+        }
+
+        try {
+          // Step-up passkey reauthentication prior to committing profile changes
+          const authResult = await verifyCurrentUserPasskey('profile update');
+
+          const updatedUsers = loadUsers();
+          const targetUser = updatedUsers.find(u => u.id === currentUser.id);
+          if (!targetUser) {
+            showStatus('Unable to locate customer profile.', 'error');
+            return;
+          }
+
+          targetUser.name = newName;
+          targetUser.email = newEmail;
+          targetUser.phone = newPhone;
+          targetUser.favoriteCoffee = newCoffee || 'House Blend';
+          targetUser.location = newLocation;
+          targetUser.updatedAt = new Date().toISOString();
+
+          saveUsers(updatedUsers);
+          renderUI(true);
+          showStatus('Profile updated and verified with passkey "' + authResult.passkey.name + '".', 'success');
+        } catch (err) {
+          showStatus('Passkey reauthentication failed. Profile changes were not saved: ' + (err && err.message ? err.message : String(err)), 'error');
+        }
+      }
+
+      // 5. Saved Passkey Management (Add, Rename, Remove)
+      async function handleAddPasskey(event) {
+        event.preventDefault();
+        hideStatus();
+
+        const currentUser = getCurrentUser();
+        const session = loadSession();
+        if (!currentUser || !session) {
+          showStatus('Please sign in to add a passkey.', 'error');
+          return;
+        }
+
+        if (session.locked) {
+          showStatus('Your session is locked. Please reauthenticate with an existing passkey first.', 'error');
+          return;
+        }
+
+        const desiredName = els.newPasskeyName.value.trim();
+
+        try {
+          const newPk = await createPasskeyCredential(currentUser, desiredName);
+          const users = loadUsers();
+          const storedUser = users.find(u => u.id === currentUser.id);
+          if (!storedUser) return;
+
+          if (!Array.isArray(storedUser.passkeys)) {
+            storedUser.passkeys = [];
+          }
+          storedUser.passkeys.push(newPk);
+          storedUser.updatedAt = new Date().toISOString();
+          saveUsers(users);
+
+          session.lastPasskeyId = newPk.credentialId;
+          session.lastPasskeyName = newPk.name;
+          saveSession(session);
+
+          els.addPasskeyForm.reset();
+          renderUI(false);
+          showStatus('Added new saved passkey "' + newPk.name + '" to your account.', 'success');
+        } catch (err) {
+          showStatus('Failed to add new passkey: ' + (err && err.message ? err.message : String(err)), 'error');
+        }
+      }
+
+      function handleRenamePasskey(credentialId, newLabel) {
+        hideStatus();
+        const cleanLabel = (newLabel || '').trim();
+        if (!cleanLabel) {
+          showStatus('Passkey label cannot be empty.', 'error');
+          return;
+        }
+
+        const currentUser = getCurrentUser();
+        if (!currentUser) return;
+
+        const users = loadUsers();
+        const storedUser = users.find(u => u.id === currentUser.id);
+        if (!storedUser || !Array.isArray(storedUser.passkeys)) return;
+
+        const targetPk = storedUser.passkeys.find(pk => pk.credentialId === credentialId);
+        if (!targetPk) return;
+
+        const oldName = targetPk.name;
+        targetPk.name = cleanLabel;
+        saveUsers(users);
+
+        const session = loadSession();
+        if (session && session.lastPasskeyId === credentialId) {
+          session.lastPasskeyName = cleanLabel;
+          saveSession(session);
+        }
+
+        renderUI(false);
+        showStatus('Renamed passkey "' + oldName + '" to "' + cleanLabel + '".', 'success');
+      }
+
+      function handleDeletePasskey(credentialId) {
+        hideStatus();
+        const currentUser = getCurrentUser();
+        const session = loadSession();
+        if (!currentUser || !session) return;
+
+        if (session.locked) {
+          showStatus('Your session is locked. Please reauthenticate with your passkey before removing saved passkeys.', 'error');
+          return;
+        }
+
+        const users = loadUsers();
+        const storedUser = users.find(u => u.id === currentUser.id);
+        if (!storedUser || !Array.isArray(storedUser.passkeys)) return;
+
+        const idx = storedUser.passkeys.findIndex(pk => pk.credentialId === credentialId);
+        if (idx === -1) return;
+
+        const removed = storedUser.passkeys.splice(idx, 1)[0];
+        saveUsers(users);
+
+        renderUI(false);
+        showStatus('Removed saved passkey "' + removed.name + '" from your account.', 'info');
+      }
+
+      // Sign Out / Logout
+      function handleSignOut(event) {
+        if (event) event.preventDefault();
+        const user = getCurrentUser();
+        saveSession(null);
+        renderUI(false);
+        if (user) {
+          showStatus('You have been signed out of ' + (user.name || user.email) + '.', 'info');
+        } else {
+          showStatus('You are currently signed out.', 'info');
+        }
+      }
+
+      // Tab Focus Helpers
+      function activateAuthTab(mode) {
+        if (mode === 'register') {
+          els.tabRegister.classList.add('active');
+          els.tabRegister.setAttribute('aria-selected', 'true');
+          els.tabSignin.classList.remove('active');
+          els.tabSignin.setAttribute('aria-selected', 'false');
+          els.registerPanel.classList.add('highlighted');
+          els.signinPanel.classList.remove('highlighted');
+          els.registerName.focus();
+        } else {
+          els.tabSignin.classList.add('active');
+          els.tabSignin.setAttribute('aria-selected', 'true');
+          els.tabRegister.classList.remove('active');
+          els.tabRegister.setAttribute('aria-selected', 'false');
+          els.signinPanel.classList.add('highlighted');
+          els.registerPanel.classList.remove('highlighted');
+          els.signinEmail.focus();
+        }
+      }
+
+      // =========================================================
+      // Wire Up Event Listeners
+      // =========================================================
+      els.statusClose.addEventListener('click', hideStatus);
+      els.tabSignin.addEventListener('click', function () { activateAuthTab('signin'); });
+      els.tabRegister.addEventListener('click', function () { activateAuthTab('register'); });
+
+      els.registerForm.addEventListener('submit', handleRegister);
+      els.signinForm.addEventListener('submit', handleSignIn);
+      els.profileForm.addEventListener('submit', handleProfileUpdate);
+      els.addPasskeyForm.addEventListener('submit', handleAddPasskey);
+
+      els.reauthenticateBtn.addEventListener('click', handleExplicitReauthenticate);
+      els.summaryReauthBtn.addEventListener('click', handleExplicitReauthenticate);
+      els.bannerReauthBtn.addEventListener('click', handleExplicitReauthenticate);
+      els.lockSessionBtn.addEventListener('click', handleLockSession);
+
+      els.accountSignoutBtn.addEventListener('click', handleSignOut);
+      els.bannerSignoutBtn.addEventListener('click', handleSignOut);
+      els.navLogoutLink.addEventListener('click', handleSignOut);
+
+      els.navAccountLink.addEventListener('click', function (ev) {
+        ev.preventDefault();
+        const section = document.getElementById('my-account');
+        if (section && typeof section.scrollIntoView === 'function') {
+          section.scrollIntoView({ behavior: 'smooth' });
+        }
+      });
+
+      // Initialize UI on page load
+      updateWebAuthnBadge();
+      renderUI(true);
+    })();
+  </script>
 </body>
 
 </html>
