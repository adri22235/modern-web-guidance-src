+  <script>
+    // Focus management for skip link and keyboard navigation support
+    (function () {
+      const skipLink = document.querySelector('.skip-link');
+      const mainContent = document.getElementById('main-content');
+
+      if (skipLink && mainContent) {
+        skipLink.addEventListener('click', function (event) {
+          event.preventDefault();
+          mainContent.focus();
+          mainContent.scrollIntoView();
+        });
+      }
+
+      // Support Left/Right/Home/End arrow key navigation within nav link lists
+      const navLists = document.querySelectorAll('nav ul');
+      navLists.forEach(function (list) {
+        const links = Array.from(list.querySelectorAll('a'));
+        list.addEventListener('keydown', function (event) {
+          const currentIndex = links.indexOf(document.activeElement);
+          if (currentIndex === -1) return;
+
+          let nextIndex = null;
+          if (event.key === 'ArrowRight') {
+            nextIndex = (currentIndex + 1) % links.length;
+          } else if (event.key === 'ArrowLeft') {
+            nextIndex = (currentIndex - 1 + links.length) % links.length;
+          } else if (event.key === 'Home') {
+            nextIndex = 0;
+          } else if (event.key === 'End') {
+            nextIndex = links.length - 1;
+          }
+
+          if (nextIndex !== null) {
+            event.preventDefault();
+            links[nextIndex].focus();
+          }
+        });
+      });
+    })();
+  </script>
