+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[contenteditable]:not([contenteditable="false"])',
+        '[tabindex]'
+      ].join(', ');
+
+      const SUBPIXEL_TOLERANCE = 2;
+      const FALLBACK_WEIGHT = 2;
+      const ARROW_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);
+
+      function getAllFocusableDescendants(container) {
+        return Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR));
+      }
+
+      function getVisibleCandidates(container) {
+        return getAllFocusableDescendants(container).filter((el) =>
+          typeof el.checkVisibility === 'function' ? el.checkVisibility() : el.getClientRects().length > 0
+        );
+      }
+
+      function syncRovingTabindex(container, preferredActive = null) {
+        const allFocusable = getAllFocusableDescendants(container);
+        const visibleCandidates = getVisibleCandidates(container);
+        if (visibleCandidates.length === 0) return;
+
+        let activeItem =
+          preferredActive && visibleCandidates.includes(preferredActive)
+            ? preferredActive
+            : visibleCandidates.find((el) => el.getAttribute('tabindex') === '0') || visibleCandidates[0];
+
+        for (const el of allFocusable) {
+          const targetTabIndex = el === activeItem ? '0' : '-1';
+          if (el.getAttribute('tabindex') !== targetTabIndex) {
+            el.setAttribute('tabindex', targetTabIndex);
+          }
+        }
+      }
+
+      function findSpatialCandidate(container, current, key) {
+        const candidates = getVisibleCandidates(container);
+        if (!current || !candidates.includes(current)) {
+          return null;
+        }
+
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+        const isHorizontal = key === 'ArrowLeft' || key === 'ArrowRight';
+
+        const aligned = [];
+        const unaligned = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+
+          const candRect = candidate.getBoundingClientRect();
+          let inDirection = false;
+          let gap = 0;
+
+          switch (key) {
+            case 'ArrowRight':
+              inDirection = candRect.left >= currentRect.right - SUBPIXEL_TOLERANCE;
+              gap = Math.max(0, candRect.left - currentRect.right);
+              break;
+            case 'ArrowLeft':
+              inDirection = candRect.right <= currentRect.left + SUBPIXEL_TOLERANCE;
+              gap = Math.max(0, currentRect.left - candRect.right);
+              break;
+            case 'ArrowDown':
+              inDirection = candRect.top >= currentRect.bottom - SUBPIXEL_TOLERANCE;
+              gap = Math.max(0, candRect.top - currentRect.bottom);
+              break;
+            case 'ArrowUp':
+              inDirection = candRect.bottom <= currentRect.top + SUBPIXEL_TOLERANCE;
+              gap = Math.max(0, currentRect.top - candRect.bottom);
+              break;
+          }
+
+          if (!inDirection) continue;
+
+          const overlapsPerpendicular = isHorizontal
+            ? Math.min(currentRect.bottom, candRect.bottom) > Math.max(currentRect.top, candRect.top)
+            : Math.min(currentRect.right, candRect.right) > Math.max(currentRect.left, candRect.left);
+
+          const candCenterX = (candRect.left + candRect.right) / 2;
+          const candCenterY = (candRect.top + candRect.bottom) / 2;
+          const perpendicularCentreOffset = isHorizontal
+            ? Math.abs(candCenterY - currentCenterY)
+            : Math.abs(candCenterX - currentCenterX);
+
+          const entry = {
+            element: candidate,
+            gap,
+            perpendicularCentreOffset,
+            fallbackScore: gap + FALLBACK_WEIGHT * perpendicularCentreOffset
+          };
+
+          if (overlapsPerpendicular) {
+            aligned.push(entry);
+          } else {
+            unaligned.push(entry);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > SUBPIXEL_TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCentreOffset - b.perpendicularCentreOffset;
+          });
+          return aligned[0].element;
+        }
+
+        if (unaligned.length > 0) {
+          unaligned.sort((a, b) => {
+            if (Math.abs(a.fallbackScore - b.fallbackScore) > SUBPIXEL_TOLERANCE) {
+              return a.fallbackScore - b.fallbackScore;
+            }
+            return a.gap - b.gap;
+          });
+          return unaligned[0].element;
+        }
+
+        return null;
+      }
+
+      function initSpatialContainer(container) {
+        syncRovingTabindex(container);
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.composedPath()[0];
+          const candidates = getVisibleCandidates(container);
+          if (target instanceof HTMLElement && candidates.includes(target)) {
+            syncRovingTabindex(container, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+          if (!ARROW_KEYS.has(e.key)) return;
+
+          const innermostTarget = e.composedPath()[0];
+          if (
+            innermostTarget instanceof Element &&
+            innermostTarget.matches(':read-write, select, input[type="range"], [role="slider"]')
+          ) {
+            return;
+          }
+
+          const current = document.activeElement;
+          const nextCandidate = findSpatialCandidate(container, current, e.key);
+          if (!nextCandidate) {
+            return;
+          }
+
+          e.preventDefault();
+          syncRovingTabindex(container, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+
+        const observer = new MutationObserver(() => {
+          syncRovingTabindex(container);
+        });
+        observer.observe(container, {
+          childList: true,
+          subtree: true,
+          attributes: true,
+          attributeFilter: ['hidden', 'style', 'class']
+        });
+      }
+
+      const spatialContainers = document.querySelectorAll('.grid[role="grid"], [data-spatial-nav]');
+      spatialContainers.forEach(initSpatialContainer);
+
+      const grid = document.querySelector('.grid');
+      const layoutButtons = document.querySelectorAll('[data-set-layout]');
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-set-layout');
+          if (grid && mode) {
+            grid.setAttribute('data-layout', mode);
+          }
+          layoutButtons.forEach((other) => {
+            other.setAttribute('aria-pressed', String(other === btn));
+          });
+        });
+      });
+    })();
+  </script>
 </body>
 
