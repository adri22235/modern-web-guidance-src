+        const focusedCard = event.target.closest('.card');
+        if (!focusedCard || !grid.contains(focusedCard)) return;
+
+        const currentIndex = cards.indexOf(focusedCard);
+        if (currentIndex === -1) return;
+
+        activeCardIndex = currentIndex;
+
+        // Handle 4-way directional arrow keys
+        if (Object.prototype.hasOwnProperty.call(DIRECTION_VECTORS, event.key)) {
+          event.preventDefault();
+
+          const measured = computeLogicalCoordinates(measureCardRects(cards));
+          const allowWrap = Boolean(wrapToggle && wrapToggle.checked);
+          const vector = DIRECTION_VECTORS[event.key];
+          const isHorizontal = vector.dx !== 0;
+
+          // Ensure virtual cursor is initialized from current card if unset
+          if (virtualCursor.x === null) virtualCursor.x = measured[currentIndex].cx;
+          if (virtualCursor.y === null) virtualCursor.y = measured[currentIndex].cy;
+
+          const target = findSpatialTarget(
+            measured,
+            currentIndex,
+            event.key,
+            allowWrap
+          );
+
+          if (target) {
+            focusCardAtIndex(target.index, {
+              // When moving horizontally, update X cursor and keep Y; when moving vertically, keep X cursor!
+              updateVirtualX: isHorizontal,
+              updateVirtualY: !isHorizontal,
+              directionLabel: vector.label,
+              focusDOM: true,
+            });
+          } else if (liveRegion) {
+            const currentMetrics = measured[currentIndex];
+            liveRegion.textContent =
+              `Boundary reached (${vector.label}) at row ${currentMetrics.row}, column ${currentMetrics.col}.`;
+          }
+          return;
+        }
+
+        // Home: jump to first card
+        if (event.key === 'Home') {
+          event.preventDefault();
+          focusCardAtIndex(0, {
+            updateVirtualX: true,
+            updateVirtualY: true,
+            directionLabel: 'First',
+            focusDOM: true,
+          });
+          return;
+        }
+
+        // End: jump to last card
+        if (event.key === 'End') {
+          event.preventDefault();
+          focusCardAtIndex(cards.length - 1, {
+            updateVirtualX: true,
+            updateVirtualY: true,
+            directionLabel: 'Last',
+            focusDOM: true,
+          });
+          return;
+        }
+
+        // PageDown / PageUp: jump to bottom-most / top-most card in the current column
+        if (event.key === 'PageDown' || event.key === 'PageUp') {
+          event.preventDefault();
+          const measured = computeLogicalCoordinates(measureCardRects(cards));
+          const current = measured[currentIndex];
+          const sameCol = measured.filter(
+            (item) =>
+              getIntervalOverlap(
+                current.left,
+                current.right,
+                item.left,
+                item.right
+              ) > 0.15
+          );
+          if (sameCol.length > 0) {
+            sameCol.sort((a, b) => a.top - b.top);
+            const target =
+              event.key === 'PageDown'
+                ? sameCol[sameCol.length - 1]
+                : sameCol[0];
+            focusCardAtIndex(target.index, {
+              updateVirtualX: false,
+              updateVirtualY: true,
+              directionLabel: event.key,
+              focusDOM: true,
+            });
+          }
+          return;
+        }
+
+        // Enter or Space on the card activates it (unless focus is already directly on a link/button)
+        if (
+          (event.key === 'Enter' || event.key === ' ') &&
+          event.target === focusedCard
+        ) {
+          event.preventDefault();
+          activateCard(focusedCard);
+        }
+      });
+
+      // Keep roving tabindex synchronized when a user clicks or focuses a card directly
+      grid.addEventListener('click', (event) => {
+        const clickedCard = event.target.closest('.card');
+        if (!clickedCard || !grid.contains(clickedCard)) return;
+
+        const cards = getVisibleCards();
+        const idx = cards.indexOf(clickedCard);
+        if (idx !== -1) {
+          focusCardAtIndex(idx, {
+            updateVirtualX: true,
+            updateVirtualY: true,
+            focusDOM: !event.target.closest('a, button'),
+          });
+          if (!event.target.closest('a, button')) {
+            activateCard(clickedCard);
+          }
+        }
+      });
+
+      grid.addEventListener('focusin', (event) => {
+        const focusedCard = event.target.closest('.card');
+        if (!focusedCard || !grid.contains(focusedCard)) return;
+
+        const cards = getVisibleCards();
+        const idx = cards.indexOf(focusedCard);
+        if (idx !== -1 && idx !== activeCardIndex) {
+          focusCardAtIndex(idx, {
+            updateVirtualX: true,
+            updateVirtualY: true,
+            focusDOM: false,
+          });
+        }
+        if (telemetryDot) telemetryDot.classList.add('active');
+      });
+
+      grid.addEventListener('focusout', (event) => {
+        if (!grid.contains(event.relatedTarget) && telemetryDot) {
+          telemetryDot.classList.remove('active');
+        }
+      });
+
+      /**
+       * Switch layout mode while preserving the currently active card and recalculating
+       * spatial coordinates for the new geometry.
+       */
+      function setLayoutMode(mode, restoreFocus = false) {
+        if (!mode) return;
+        grid.setAttribute('data-layout', mode);
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.getAttribute('data-layout-mode') === mode;
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        // Reset virtual cursor after layout geometry changes so it re-anchors to new card position
+        const measured = refreshSpatialMetadata(true);
+        const current = measured[activeCardIndex] || measured[0];
+        if (current) {
+          virtualCursor.x = current.cx;
+          virtualCursor.y = current.cy;
+        }
+
+        if (restoreFocus && current) {
+          current.card.focus();
+        }
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          setLayoutMode(mode, false);
+        });
+      });
+
+      // Recalculate logical coordinates on viewport resize
+      let resizeFrame = null;
+      window.addEventListener('resize', () => {
+        if (resizeFrame) cancelAnimationFrame(resizeFrame);
+        resizeFrame = requestAnimationFrame(() => {
+          const measured = refreshSpatialMetadata(false);
+          const current = measured[activeCardIndex];
+          if (current) {
+            virtualCursor.x = current.cx;
+            virtualCursor.y = current.cy;
+          }
+        });
+      });
+
+      // Expose programmatic helper for external inspection/testing
+      window.DailyGrindSpatialNav = {
+        setLayoutMode,
+        focusCardAtIndex,
+        getActiveCardIndex: () => activeCardIndex,
+        refreshSpatialMetadata,
+      };
+
+      // Initialize spatial metadata on load
+      refreshSpatialMetadata(false);
+    })();
+  </script>
 </body>
 
 </html>
