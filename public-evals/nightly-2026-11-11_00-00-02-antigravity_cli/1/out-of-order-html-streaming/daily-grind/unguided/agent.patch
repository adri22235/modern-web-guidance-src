+
+    /**
+     * Refresh the coffee cards in place with fresh HTML from the server
+     * using native streaming and sanitized HTML insertion methods.
+     */
+    async function refreshSeasonalCards(season = menuSelect.value) {
+      const endpoint = `/api/menu/seasonal?season=${encodeURIComponent(season)}`;
+      try {
+        const response = await fetch(endpoint, {
+          headers: { Accept: 'text/html' }
+        });
+
+        if (!response.ok) {
+          throw new Error(`Server returned ${response.status}`);
+        }
+
+        // Stream fresh HTML chunks directly into the cards grid in place
+        if (typeof response.textStream === 'function' && typeof seasonalCardsGrid.streamHTML === 'function') {
+          await response.textStream().pipeTo(seasonalCardsGrid.streamHTML());
+        } else if (response.body && typeof seasonalCardsGrid.streamHTML === 'function') {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(seasonalCardsGrid.streamHTML());
+        } else {
+          const freshHtml = await response.text();
+          seasonalCardsGrid.setHTML(freshHtml);
+        }
+      } catch {
+        const fallbackHtml = FALLBACK_MENU_HTML[season] || FALLBACK_MENU_HTML.autumn;
+        if (typeof seasonalCardsGrid.streamHTML === 'function') {
+          const writer = seasonalCardsGrid.streamHTML().getWriter();
+          await writer.write(fallbackHtml);
+          await writer.close();
+        } else if (typeof seasonalCardsGrid.setHTML === 'function') {
+          seasonalCardsGrid.setHTML(fallbackHtml);
+        }
+      }
+    }
+
+    /**
+     * Update a single coffee card in place with fresh HTML from the server.
+     */
+    function updateCardInPlace(cardElement, freshCardHtml) {
+      if (typeof cardElement.replaceWithHTML === 'function') {
+        cardElement.replaceWithHTML(freshCardHtml);
+      } else if (typeof cardElement.setHTML === 'function') {
+        cardElement.setHTML(freshCardHtml);
+      }
+    }
+
+    menuSelect.addEventListener('change', (event) => {
+      refreshSeasonalCards(event.target.value);
+    });
+
+    refreshMenuBtn.addEventListener('click', () => {
+      refreshSeasonalCards(menuSelect.value);
+    });
+
+    window.addEventListener('menu-change', (event) => {
+      const nextSeason = event.detail?.season || menuSelect.value;
+      refreshSeasonalCards(nextSeason);
+    });
+
+    /**
+     * Customer-submitted reviews:
+     * Untrusted user-provided HTML is inserted with safe `setHTML()` and `appendHTML()`,
+     * which sanitize input by default via the browser's built-in Sanitizer API.
+     */
+    const initialCustomerReviewsHtml = `
+      <article class="review-item">
+        <strong>Elena R.</strong>
+        <p>The <em>Maple Oat Latte</em> is pure autumn in a cup! Best seasonal drink in town.</p>
