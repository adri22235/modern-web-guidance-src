+      <article class="review-item">
+        <strong>Marcus T.</strong>
+        <p>Love the <strong>18-hour Cold Brew</strong>—super smooth with zero bitterness.</p>
+      </article>
+    `;
+
+    function renderCustomerReviews(reviewsHtml) {
+      if (typeof reviewsList.setHTML === 'function') {
+        reviewsList.setHTML(reviewsHtml);
+      }
+    }
+
+    function addCustomerSubmittedReview(authorHtml, commentHtml) {
+      const reviewMarkup = `
+        <article class="review-item">
+          <strong>${authorHtml}</strong>
+          <p>${commentHtml}</p>
+        </article>
+      `;
+
+      if (typeof reviewsList.appendHTML === 'function') {
+        reviewsList.appendHTML(reviewMarkup);
+      } else if (typeof reviewsList.setHTML === 'function') {
+        const wrapper = document.createElement('div');
+        wrapper.setHTML(reviewMarkup);
+        reviewsList.append(...wrapper.childNodes);
+      }
+    }
+
+    reviewForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const nameInput = document.getElementById('reviewer-name');
+      const contentInput = document.getElementById('review-content');
+      addCustomerSubmittedReview(nameInput.value, contentInput.value);
+      reviewForm.reset();
+    });
+
+    /**
+     * First-party CMS promo block with its own embedded widget script:
+     * Uses `setHTMLUnsafe(html, { runScripts: true })` (or `streamHTMLUnsafe({ runScripts: true })`)
+     * so trusted HTML from our CMS renders alongside its embedded `<script>` widget execution.
+     */
+    const cmsPromoBlockHtml = `
+      <div class="cms-promo-box" id="cms-seasonal-promo">
+        <h4>Double Bean Rewards</h4>
+        <p>Order any Seasonal Favorite this week and earn <strong>2x Grind Points</strong> automatically.</p>
+        <div id="cms-promo-widget" class="cms-widget-badge">Loading promo widget...</div>
