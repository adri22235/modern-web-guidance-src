+              widgetEl.dataset.widgetActive = 'true';
+            }
+          })();
+        <\/script>
+      </div>
+    `;
+
+    async function renderCmsPromoBlock(promoHtml = cmsPromoBlockHtml) {
+      if (typeof cmsPromoContainer.setHTMLUnsafe === 'function') {
+        cmsPromoContainer.setHTMLUnsafe(promoHtml, { runScripts: true });
+      }
+    }
+
+    async function streamCmsPromoFromServer(endpoint = '/api/cms/seasonal-promo') {
+      try {
+        const response = await fetch(endpoint, {
+          headers: { Accept: 'text/html' }
+        });
+        if (!response.ok) throw new Error(`CMS returned ${response.status}`);
+
+        if (typeof response.textStream === 'function' && typeof cmsPromoContainer.streamHTMLUnsafe === 'function') {
+          await response.textStream().pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+        } else if (response.body && typeof cmsPromoContainer.streamHTMLUnsafe === 'function') {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+        } else {
+          const html = await response.text();
+          cmsPromoContainer.setHTMLUnsafe(html, { runScripts: true });
+        }
+      } catch {
