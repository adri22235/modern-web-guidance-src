+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'title',
+          'drink-title',
+          'name',
+          'heading',
+          'description',
+          'desc',
+          'href',
+          'link',
+          'action-link',
+          'url',
+          'action-text',
+          'link-text',
+          'cta',
+          'limited',
+          'badge',
+          'data-limited',
+          'data-badge'
+        ];
+      }
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+      }
+
+      connectedCallback() {
+        this.render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue !== newValue && this.shadowRoot) {
+          this.render();
+        }
+      }
+
+      get drinkTitle() {
+        return (
+          this.getAttribute('title') ||
+          this.getAttribute('drink-title') ||
+          this.getAttribute('name') ||
+          this.getAttribute('heading') ||
+          ''
+        );
+      }
+
+      set drinkTitle(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('title');
+        } else {
+          this.setAttribute('title', String(val));
+        }
+      }
+
+      get description() {
+        return (
+          this.getAttribute('description') ||
+          this.getAttribute('desc') ||
+          ''
+        );
+      }
+
+      set description(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('description');
+        } else {
+          this.setAttribute('description', String(val));
+        }
+      }
+
+      get href() {
+        return (
+          this.getAttribute('href') ||
+          this.getAttribute('link') ||
+          this.getAttribute('action-link') ||
+          this.getAttribute('url') ||
+          '#'
+        );
+      }
+
+      set href(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('href');
+        } else {
+          this.setAttribute('href', String(val));
+        }
+      }
+
+      get link() {
+        return this.href;
+      }
+
+      set link(val) {
+        this.href = val;
+      }
+
+      get actionLink() {
+        return this.href;
+      }
+
+      set actionLink(val) {
+        this.href = val;
+      }
+
+      get actionText() {
+        return (
+          this.getAttribute('action-text') ||
+          this.getAttribute('link-text') ||
+          this.getAttribute('cta') ||
+          'View Details'
+        );
+      }
+
+      set actionText(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('action-text');
+        } else {
+          this.setAttribute('action-text', String(val));
+        }
+      }
+
+      get limited() {
+        return this._resolveBadgeText() !== null;
+      }
+
+      set limited(val) {
+        if (val && val !== 'false' && val !== '0') {
+          this.setAttribute('limited', '');
+        } else {
+          this.removeAttribute('limited');
+          this.removeAttribute('badge');
+          this.removeAttribute('data-limited');
+          this.removeAttribute('data-badge');
+        }
+      }
+
+      get badge() {
+        return this._resolveBadgeText() || '';
+      }
+
+      set badge(val) {
+        if (val && val !== 'false' && val !== '0') {
+          this.setAttribute('badge', val === true ? 'Limited' : String(val));
+        } else {
+          this.removeAttribute('badge');
+          this.removeAttribute('limited');
+          this.removeAttribute('data-badge');
+          this.removeAttribute('data-limited');
+        }
+      }
+
+      _resolveBadgeText() {
+        const badgeAttrs = ['badge', 'data-badge'];
+        for (const attr of badgeAttrs) {
+          if (this.hasAttribute(attr)) {
+            const raw = (this.getAttribute(attr) || '').trim();
+            if (raw.toLowerCase() === 'false' || raw === '0') {
+              return null;
+            }
+            if (raw === '' || raw.toLowerCase() === 'true') {
+              return 'Limited';
+            }
+            return raw;
+          }
+        }
+
+        const limitedAttrs = ['limited', 'data-limited'];
+        for (const attr of limitedAttrs) {
+          if (this.hasAttribute(attr)) {
+            const raw = (this.getAttribute(attr) || '').trim();
+            if (raw.toLowerCase() === 'false' || raw === '0') {
+              return null;
+            }
+            if (raw === '' || raw.toLowerCase() === 'true' || raw.toLowerCase() === 'limited' || raw === '1') {
+              return 'Limited';
+            }
+            return raw;
+          }
+        }
+
+        return null;
+      }
+
+      _escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      }
+
+      render() {
+        const title = this._escapeHtml(this.drinkTitle);
+        const description = this._escapeHtml(this.description);
+        const href = this._escapeHtml(this.href);
+        const actionText = this._escapeHtml(this.actionText);
+        const badgeText = this._resolveBadgeText();
+        const badgeMarkup = badgeText
+          ? `<span class="badge" part="badge">${this._escapeHtml(badgeText)}</span>`
+          : `<slot name="badge"></slot>`;
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: block;
+              font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+              line-height: 1.6;
+              color: var(--text, #3e2723);
+            }
+
+            *, *::before, *::after {
+              box-sizing: border-box;
+              margin: 0;
+              padding: 0;
+            }
+
+            .card {
+              position: relative;
+              background: white;
+              padding: 20px;
+              border-radius: 8px;
+              box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+              text-align: center;
+              height: 100%;
+              display: flex;
+              flex-direction: column;
+              align-items: center;
+              justify-content: space-between;
+            }
+
+            .badge,
+            ::slotted([slot="badge"]) {
+              position: absolute;
+              top: 12px;
+              right: 12px;
+              background: var(--accent, #ffab40);
+              color: var(--text, #3e2723);
+              font-size: 0.75rem;
+              font-weight: 700;
+              text-transform: uppercase;
+              letter-spacing: 0.5px;
+              padding: 2px 8px;
+              border-radius: 999px;
+              line-height: 1.4;
+            }
+
+            h3 {
+              margin-bottom: 10px;
+              color: var(--primary, #4e342e);
+            }
+
+            p {
+              color: var(--text, #3e2723);
+            }
+
+            .btn {
+              display: inline-block;
+              background: var(--primary, #4e342e);
+              color: white;
+              padding: 10px 20px;
+              text-decoration: none;
+              border-radius: 5px;
+              margin-top: 15px;
+              transition: background 0.3s;
+            }
+
+            .btn:hover {
+              background: #3e2723;
+            }
+          </style>
+          <article class="card" part="card">
+            ${badgeMarkup}
+            <h3 part="title"><slot name="title">${title}</slot></h3>
+            <p part="description"><slot name="description"><slot>${description}</slot></slot></p>
+            <slot name="action"><a href="${href}" class="btn" part="action">${actionText}</a></slot>
+          </article>
+        `;
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
