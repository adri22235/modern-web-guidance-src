+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          --_primary: var(--primary, #4e342e);
+          --_accent: var(--accent, #ffab40);
+          --_text: var(--text, #3e2723);
+          --_card-bg: var(--card-bg, #ffffff);
+        }
+
+        *,
+        *::before,
+        *::after {
+          box-sizing: border-box;
+        }
+
+        .card {
+          position: relative;
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          align-items: center;
+          background: var(--_card-bg);
+          color: var(--_text);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+
+        .badge {
+          display: inline-block;
+          align-self: center;
+          background: var(--_accent);
+          color: var(--_text);
+          font-size: 0.75rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.05em;
+          padding: 2px 10px;
+          border-radius: 999px;
+          margin-bottom: 8px;
+        }
+
+        .badge[hidden] {
+          display: none;
+        }
+
+        .title {
+          margin: 0 0 10px;
+          color: var(--_primary);
+          font-size: 1.17rem;
+        }
+
+        .description {
+          margin: 0;
+          flex-grow: 1;
+        }
+
+        .description-fallback,
+        ::slotted([slot="description"]) {
+          margin: 0;
+        }
+
+        .actions {
+          margin-top: 15px;
+        }
+
+        .btn,
+        ::slotted([slot="action"]) {
+          display: inline-block;
+          background: var(--_primary);
+          color: #ffffff;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          transition: background 0.3s;
+          font: inherit;
+        }
+
+        .btn:hover,
+        ::slotted([slot="action"]:hover) {
+          background: #3e2723;
+        }
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <span class="badge" part="badge" hidden>
+          <slot name="badge"><span class="badge-fallback">Limited</span></slot>
+        </span>
+        <h3 class="title" part="title">
+          <slot name="title"><span class="title-fallback"></span></slot>
+        </h3>
+        <div class="description" part="description">
+          <slot name="description"><p class="description-fallback"></p></slot>
+        </div>
+        <div class="actions">
+          <slot name="action">
+            <a class="btn" part="action" href="#">View Details</a>
+          </slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = [
+        'heading',
+        'description',
+        'href',
+        'action-label',
+        'limited',
+        'badge',
+      ];
+
+      #badgeEl;
+      #badgeSlot;
+      #badgeFallbackEl;
+      #titleSlot;
+      #titleFallbackEl;
+      #descriptionSlot;
+      #descriptionFallbackEl;
+      #actionSlot;
+      #actionFallbackEl;
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this.#badgeFallbackEl = this.shadowRoot.querySelector('.badge-fallback');
+        this.#titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        this.#titleFallbackEl = this.shadowRoot.querySelector('.title-fallback');
+        this.#descriptionSlot = this.shadowRoot.querySelector('slot[name="description"]');
+        this.#descriptionFallbackEl = this.shadowRoot.querySelector('.description-fallback');
+        this.#actionSlot = this.shadowRoot.querySelector('slot[name="action"]');
+        this.#actionFallbackEl = this.shadowRoot.querySelector('.btn');
+
+        this.#badgeSlot.addEventListener('slotchange', () => this.#syncBadge());
+      }
+
+      connectedCallback() {
+        this.#render();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#render(name, oldVal, newVal);
+        }
+      }
+
+      get heading() {
+        return this.getAttribute('heading') ?? '';
+      }
+
+      set heading(value) {
+        value ? this.setAttribute('heading', value) : this.removeAttribute('heading');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(value) {
+        value ? this.setAttribute('description', value) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+
+      set href(value) {
+        value ? this.setAttribute('href', value) : this.removeAttribute('href');
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? '';
+      }
+
+      set actionLabel(value) {
+        value ? this.setAttribute('action-label', value) : this.removeAttribute('action-label');
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(on) {
+        this.toggleAttribute('limited', Boolean(on));
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(value) {
+        value ? this.setAttribute('badge', value) : this.removeAttribute('badge');
+      }
+
+      #syncBadge() {
+        const assignedBadgeNodes = this.#badgeSlot
+          .assignedNodes({ flatten: false })
+          .filter(
+            (node) =>
+              node.nodeType === Node.ELEMENT_NODE ||
+              (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+          );
+        const hasBadgeAttr =
+          this.hasAttribute('limited') ||
+          (this.hasAttribute('badge') && this.getAttribute('badge') !== 'false');
+        const badgeText = this.getAttribute('badge') || 'Limited';
+        this.#badgeFallbackEl.textContent = badgeText;
+        this.#badgeEl.hidden = !(assignedBadgeNodes.length > 0 || hasBadgeAttr);
+      }
+
+      #render(changedAttr, oldVal, newVal) {
+        this.#titleFallbackEl.textContent = this.heading;
+        if (changedAttr === 'heading' && oldVal !== null) {
+          const slottedTitle = this.#titleSlot.assignedElements()[0];
+          if (slottedTitle) slottedTitle.textContent = newVal ?? '';
+        }
+
+        this.#descriptionFallbackEl.textContent = this.description;
+        if (changedAttr === 'description' && oldVal !== null) {
+          const slottedDesc = this.#descriptionSlot.assignedElements()[0];
+          if (slottedDesc) slottedDesc.textContent = newVal ?? '';
+        }
+
+        this.#actionFallbackEl.href = this.href || '#';
+        this.#actionFallbackEl.textContent = this.actionLabel || 'View Details';
+        if ((changedAttr === 'href' || changedAttr === 'action-label') && oldVal !== null) {
+          const slottedAction = this.#actionSlot.assignedElements()[0];
+          if (slottedAction) {
+            if (changedAttr === 'href' && 'href' in slottedAction) {
+              slottedAction.setAttribute('href', newVal || '#');
+            }
+            if (changedAttr === 'action-label') {
+              slottedAction.textContent = newVal || 'View Details';
+            }
+          }
+        }
+
+        this.#syncBadge();
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
