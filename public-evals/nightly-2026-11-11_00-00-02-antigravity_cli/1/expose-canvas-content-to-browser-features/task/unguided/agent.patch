+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const cupOverlay = document.getElementById('cup-overlay');
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('cup-milk');
+      const syrupSelect = document.getElementById('cup-syrup');
+      const liveSummary = document.getElementById('cup-live-summary');
+
+      const milkPalette = {
+        'Oat Milk': '#eadbc8',
+        'Whole Milk': '#f7f1e8',
+        'Almond Milk': '#e5d0b7',
+        'Soy Milk': '#efe3cf',
+        'Coconut Milk': '#faf6f0'
+      };
+
+      const syrupPalette = {
+        'Vermont Maple': '#b85d19',
+        'Vanilla': '#f3d79b',
+        'Caramel': '#c67a27',
+        'Hazelnut': '#8d5524',
+        'Mocha': '#4e2f1e',
+        'No Syrup': '#6d4c41'
+      };
+
+      function updateLiveText() {
+        const rawName = (nameInput.value || '').trim();
+        const displayName = rawName || 'Guest';
+        const milk = milkSelect.value;
+        const syrup = syrupSelect.value;
+        liveSummary.textContent = `${displayName}'s Cup: ${milk} • ${syrup}`;
+      }
+
+      function lerp(a, b, t) {
+        return a + (b - a) * t;
+      }
+
+      function drawCoffeeCup() {
+        const dpr = window.devicePixelRatio || 1;
+        const cssWidth = canvas.clientWidth || (canvas.width / dpr) || 480;
+        const cssHeight = canvas.clientHeight || (canvas.height / dpr) || 560;
+        const scaleX = canvas.width / cssWidth || dpr;
+        const scaleY = canvas.height / cssHeight || dpr;
+
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        ctx.save();
+        ctx.scale(scaleX, scaleY);
+
+        const centerX = cssWidth / 2;
+
+        // Soft background halo
+        const bgGrad = ctx.createRadialGradient(centerX, cssHeight * 0.5, 30, centerX, cssHeight * 0.5, cssWidth * 0.55);
+        bgGrad.addColorStop(0, '#fffdf9');
+        bgGrad.addColorStop(1, '#f5ebe1');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+        // Steam wisps at the top
+        ctx.save();
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.28)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-32, 0, 32].forEach((offsetX, idx) => {
+          ctx.beginPath();
+          const startX = centerX + offsetX;
+          ctx.moveTo(startX, 68);
+          ctx.bezierCurveTo(startX - 10, 50, startX + 12, 34, startX - 4 + idx * 3, 18);
+          ctx.stroke();
+        });
+        ctx.restore();
+
+        // Cup geometry
+        const cupTopY = 116;
+        const cupBottomY = 496;
+        const topHalfW = 152;
+        const bottomHalfW = 108;
+
+        // Drop shadow beneath the cup
+        ctx.save();
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.14)';
+        ctx.beginPath();
+        ctx.ellipse(centerX, cupBottomY + 12, bottomHalfW + 14, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        // Cup body path
+        ctx.save();
+        ctx.beginPath();
+        ctx.moveTo(centerX - topHalfW, cupTopY);
+        ctx.lineTo(centerX + topHalfW, cupTopY);
+        ctx.lineTo(centerX + bottomHalfW, cupBottomY);
+        ctx.quadraticCurveTo(centerX, cupBottomY + 14, centerX - bottomHalfW, cupBottomY);
+        ctx.closePath();
+
+        const cupGrad = ctx.createLinearGradient(centerX - topHalfW, cupTopY, centerX + topHalfW, cupTopY);
+        cupGrad.addColorStop(0, '#efe6dd');
+        cupGrad.addColorStop(0.35, '#fbf8f4');
+        cupGrad.addColorStop(0.75, '#f2e9df');
+        cupGrad.addColorStop(1, '#dfd1c3');
+        ctx.fillStyle = cupGrad;
+        ctx.fill();
+        ctx.lineWidth = 2.5;
+        ctx.strokeStyle = '#6d4c41';
+        ctx.stroke();
+
+        // Subtle flavor band near top of cup reflecting selected milk & syrup
+        ctx.clip();
+        const milkColor = milkPalette[milkSelect.value] || '#eadbc8';
+        const syrupColor = syrupPalette[syrupSelect.value] || '#b85d19';
+
+        ctx.fillStyle = milkColor;
+        ctx.fillRect(centerX - topHalfW, cupTopY, topHalfW * 2, 42);
+
+        ctx.fillStyle = syrupColor;
+        ctx.fillRect(centerX - topHalfW, cupTopY + 34, topHalfW * 2, 10);
+        ctx.restore();
+
+        // Cardboard sleeve wrapping the middle of the cup
+        const overlayW = cupOverlay.offsetWidth || 224;
+        const overlayH = cupOverlay.offsetHeight || 220;
+        const sleeveCenterY = (cupTopY + cupBottomY) / 2 + 8;
+        const sleeveHalfH = Math.max(126, overlayH / 2 + 16);
+        const sleeveTopY = sleeveCenterY - sleeveHalfH;
+        const sleeveBottomY = sleeveCenterY + sleeveHalfH;
+
+        const tTop = (sleeveTopY - cupTopY) / (cupBottomY - cupTopY);
+        const tBot = (sleeveBottomY - cupTopY) / (cupBottomY - cupTopY);
+        const sleeveTopHalfW = lerp(topHalfW, bottomHalfW, tTop) + 2;
+        const sleeveBotHalfW = lerp(topHalfW, bottomHalfW, tBot) + 2;
+
+        ctx.save();
+        ctx.beginPath();
+        ctx.moveTo(centerX - sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(centerX + sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(centerX + sleeveBotHalfW, sleeveBottomY);
+        ctx.quadraticCurveTo(centerX, sleeveBottomY + 8, centerX - sleeveBotHalfW, sleeveBottomY);
+        ctx.closePath();
+
+        const sleeveGrad = ctx.createLinearGradient(centerX - sleeveTopHalfW, sleeveTopY, centerX + sleeveTopHalfW, sleeveTopY);
+        sleeveGrad.addColorStop(0, '#b9936c');
+        sleeveGrad.addColorStop(0.5, '#d2b08c');
+        sleeveGrad.addColorStop(1, '#a9825a');
+        ctx.fillStyle = sleeveGrad;
+        ctx.fill();
+        ctx.lineWidth = 2;
+        ctx.strokeStyle = '#5d4037';
+        ctx.stroke();
+        ctx.restore();
+
+        // Coffee cup lid
+        ctx.save();
+        ctx.fillStyle = '#4e342e';
+        ctx.strokeStyle = '#3e2723';
+        ctx.lineWidth = 2;
+
+        // Upper lid dome
+        ctx.beginPath();
+        ctx.roundRect(centerX - topHalfW - 4, cupTopY - 30, (topHalfW + 4) * 2, 18, [8, 8, 2, 2]);
+        ctx.fill();
+        ctx.stroke();
+
+        // Lower lid rim
+        ctx.beginPath();
+        ctx.roundRect(centerX - topHalfW - 12, cupTopY - 14, (topHalfW + 12) * 2, 18, 6);
+        ctx.fill();
+        ctx.stroke();
+
+        // Accent band on lid
+        ctx.fillStyle = syrupColor;
+        ctx.fillRect(centerX - 42, cupTopY - 26, 84, 5);
+        ctx.restore();
+
+        // Render the live interactive HTML controls & text directly inside the coffee cup sleeve
+        const drawX = Math.round(centerX - overlayW / 2);
+        const drawY = Math.round(sleeveCenterY - overlayH / 2);
+
+        ctx.save();
+        ctx.translate(drawX, drawY);
+        const drawTransform = ctx.getTransform();
+
+        if (typeof ctx.drawElementImage === 'function') {
+          try {
+            ctx.drawElementImage(cupOverlay, 0, 0);
+          } catch (err) {
+            // Ignore if browser requires paint event context
+          }
+        } else if (typeof ctx.drawElement === 'function') {
+          try {
+            ctx.drawElement(cupOverlay, 0, 0);
+          } catch (err) {}
+        }
+
+        if (typeof ctx.getElementTransform === 'function') {
+          try {
+            const transform = ctx.getElementTransform(cupOverlay, drawTransform);
+            if (transform) {
+              cupOverlay.style.transform = transform.toString();
+            }
+          } catch (err) {
+            cupOverlay.style.transform = `translate(${drawX}px, ${drawY}px)`;
+          }
+        } else {
+          cupOverlay.style.transform = `translate(${drawX}px, ${drawY}px)`;
+        }
+
+        ctx.restore();
+        ctx.restore();
+      }
+
+      function requestRedraw() {
+        updateLiveText();
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+        drawCoffeeCup();
+      }
+
+      canvas.onpaint = function () {
+        updateLiveText();
+        drawCoffeeCup();
+      };
+
+      const resizeObserver = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          let targetWidth;
+          let targetHeight;
+          if (entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0]) {
+            targetWidth = entry.devicePixelContentBoxSize[0].inlineSize;
+            targetHeight = entry.devicePixelContentBoxSize[0].blockSize;
+          } else {
+            const dpr = window.devicePixelRatio || 1;
+            const rect = entry.contentRect || canvas.getBoundingClientRect();
+            targetWidth = Math.round(rect.width * dpr);
+            targetHeight = Math.round(rect.height * dpr);
+          }
+          if (targetWidth > 0 && targetHeight > 0) {
+            if (canvas.width !== targetWidth || canvas.height !== targetHeight) {
+              canvas.width = targetWidth;
+              canvas.height = targetHeight;
+            }
+          }
+        }
+        requestRedraw();
+      });
+
+      try {
+        resizeObserver.observe(canvas, { box: ['device-pixel-content-box'] });
+      } catch (err) {
+        resizeObserver.observe(canvas);
+      }
+
+      [nameInput, milkSelect, syrupSelect].forEach((control) => {
+        control.addEventListener('input', requestRedraw);
+        control.addEventListener('change', requestRedraw);
+        control.addEventListener('focus', requestRedraw);
+        control.addEventListener('blur', requestRedraw);
+      });
+
+      // Initial high-DPI sizing and render
+      const initDpr = window.devicePixelRatio || 1;
+      const initRect = canvas.getBoundingClientRect();
+      if (initRect.width > 0 && initRect.height > 0) {
+        canvas.width = Math.round(initRect.width * initDpr);
+        canvas.height = Math.round(initRect.height * initDpr);
+      }
+      requestRedraw();
+    })();
+  </script>
+
 </body>
 
