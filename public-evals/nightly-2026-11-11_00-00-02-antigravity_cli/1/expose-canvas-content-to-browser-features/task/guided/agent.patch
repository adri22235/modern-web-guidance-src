+  <script>
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("ui-element");
+    const canvasStage = document.getElementById("canvas-stage");
+    const customizerForm = document.getElementById("cup-customizer-form");
+    const cupNameInput = document.getElementById("cup-name");
+    const milkSelect = document.getElementById("milk-select");
+    const syrupSelect = document.getElementById("syrup-select");
+    const summaryText = document.getElementById("cup-summary-text");
+    const orderStatus = document.getElementById("cup-order-status");
+
+    const MILK_PALETTE = {
+      "Oat Milk": { crema: "#e6ccb2", body: "#ede0d4" },
+      "Whole Milk": { crema: "#f5ebe0", body: "#faf3dd" },
+      "Almond Milk": { crema: "#ddb892", body: "#e6ccb2" },
+      "Soy Milk": { crema: "#ebd9c8", body: "#f2e8dc" },
+      "Coconut Milk": { crema: "#f8f9fa", body: "#f1faee" },
+      "Skim Milk": { crema: "#edf2f4", body: "#f8f9fa" }
+    };
+
+    const SYRUP_PALETTE = {
+      "Vermont Maple": "#b5651d",
+      "Madagascar Vanilla": "#f3c677",
+      "Salted Caramel": "#d48c28",
+      "Roasted Hazelnut": "#7f4f24",
+      "Cinnamon Dolce": "#a44a3f",
+      "No Syrup": "transparent"
+    };
+
+    function getOrderState() {
+      const rawName = cupNameInput.value.trim();
+      return {
+        name: rawName || "Guest",
+        milk: milkSelect.value,
+        syrup: syrupSelect.value
+      };
+    }
+
+    function updateSummaryDOM() {
+      const { name, milk, syrup } = getOrderState();
+      summaryText.textContent = "";
+      const strong = document.createElement("strong");
+      strong.textContent = `${name}'s Cup: `;
+      summaryText.append(strong, `${milk} \u2022 ${syrup}`);
+    }
+
+    function drawCoffeeCupScene() {
+      const cssWidth = canvas.clientWidth || 480;
+      const cssHeight = canvas.clientHeight || 560;
+      const scaleX = canvas.width / cssWidth;
+      const scaleY = canvas.height / cssHeight;
+
+      const { name, milk, syrup } = getOrderState();
+      const milkColors = MILK_PALETTE[milk] || MILK_PALETTE["Oat Milk"];
+      const syrupColor = SYRUP_PALETTE[syrup] || "#b5651d";
+
+      ctx.save();
+      ctx.scale(scaleX, scaleY);
+
+      // Soft cafe backdrop inside canvas
+      const bgGrad = ctx.createLinearGradient(0, 0, 0, cssHeight);
+      bgGrad.addColorStop(0, "#fdfbf9");
+      bgGrad.addColorStop(1, "#efe8e2");
+      ctx.fillStyle = bgGrad;
+      ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+      const centerX = cssWidth / 2;
+
+      // Table shadow under cup
+      ctx.beginPath();
+      ctx.ellipse(centerX, 528, 118, 16, 0, 0, Math.PI * 2);
+      ctx.fillStyle = "rgba(62, 39, 35, 0.14)";
+      ctx.fill();
+
+      // Rising steam wisps
+      ctx.strokeStyle = "rgba(141, 110, 99, 0.35)";
+      ctx.lineWidth = 3;
+      ctx.lineCap = "round";
+      [-36, 0, 36].forEach((offset, idx) => {
+        ctx.beginPath();
+        const startX = centerX + offset;
+        ctx.moveTo(startX, 58);
+        ctx.bezierCurveTo(startX - 12, 42, startX + 14, 28, startX - 4, 14 + idx * 2);
+        ctx.stroke();
+      });
+
+      // Cup body trapezoid (kraft/ceramic cup)
+      const topY = 104;
+      const bottomY = 520;
+      const topHalfW = 152;
+      const bottomHalfW = 108;
+
+      ctx.beginPath();
+      ctx.moveTo(centerX - topHalfW, topY);
+      ctx.lineTo(centerX + topHalfW, topY);
+      ctx.lineTo(centerX + bottomHalfW, bottomY);
+      ctx.quadraticCurveTo(centerX, bottomY + 14, centerX - bottomHalfW, bottomY);
+      ctx.closePath();
+
+      const cupGrad = ctx.createLinearGradient(centerX - topHalfW, topY, centerX + topHalfW, topY);
+      cupGrad.addColorStop(0, milkColors.body);
+      cupGrad.addColorStop(0.5, "#ffffff");
+      cupGrad.addColorStop(1, milkColors.crema);
+      ctx.fillStyle = cupGrad;
+      ctx.fill();
+      ctx.lineWidth = 3;
+      ctx.strokeStyle = "#5d4037";
+      ctx.stroke();
+
+      // Espresso + milk crema window near top of cup
+      ctx.beginPath();
+      ctx.ellipse(centerX, topY + 2, topHalfW - 8, 22, 0, 0, Math.PI * 2);
+      ctx.fillStyle = milkColors.crema;
+      ctx.fill();
+
+      // Syrup drizzle swirl in the crema
+      if (syrup !== "No Syrup") {
+        ctx.strokeStyle = syrupColor;
+        ctx.lineWidth = 3.5;
+        ctx.beginPath();
+        ctx.arc(centerX, topY + 2, 48, 0.2, Math.PI * 1.65);
+        ctx.stroke();
+        ctx.beginPath();
+        ctx.arc(centerX, topY + 2, 24, 0.8, Math.PI * 2.1);
+        ctx.stroke();
+      }
+
+      // Coffee cup lid
+      ctx.fillStyle = "#4e342e";
+      ctx.beginPath();
+      ctx.roundRect(centerX - topHalfW - 10, topY - 22, (topHalfW + 10) * 2, 24, 10);
+      ctx.fill();
+
+      ctx.fillStyle = "#3e2723";
+      ctx.beginPath();
+      ctx.roundRect(centerX - topHalfW + 8, topY - 38, (topHalfW - 8) * 2, 18, [8, 8, 2, 2]);
+      ctx.fill();
+
+      // Corrugated cardboard sleeve background behind the interactive UI
+      const sleeveTop = 162;
+      const sleeveBottom = 478;
+      const topRatio = (sleeveTop - topY) / (bottomY - topY);
+      const bottomRatio = (sleeveBottom - topY) / (bottomY - topY);
+      const sleeveTopHalfW = topHalfW - (topHalfW - bottomHalfW) * topRatio;
+      const sleeveBottomHalfW = topHalfW - (topHalfW - bottomHalfW) * bottomRatio;
+
+      ctx.beginPath();
+      ctx.moveTo(centerX - sleeveTopHalfW, sleeveTop);
+      ctx.lineTo(centerX + sleeveTopHalfW, sleeveTop);
+      ctx.lineTo(centerX + sleeveBottomHalfW, sleeveBottom);
+      ctx.lineTo(centerX - sleeveBottomHalfW, sleeveBottom);
+      ctx.closePath();
+      ctx.fillStyle = "#c89f7c";
+      ctx.fill();
+      ctx.lineWidth = 2.5;
+      ctx.strokeStyle = "#6d4c41";
+      ctx.stroke();
+
+      // Drawn badge text on cup above the sleeve
+      ctx.fillStyle = "#4e342e";
+      ctx.font = "bold 14px 'Segoe UI', sans-serif";
+      ctx.textAlign = "center";
+      ctx.fillText(`HANDCRAFTED FOR ${name.toUpperCase()}`, centerX, 142);
+
+      // Drawn syrup & milk footer badge near bottom of cup
+      ctx.font = "600 12px 'Segoe UI', sans-serif";
+      ctx.fillStyle = "#4e342e";
+      ctx.fillText(`${milk} \u2022 ${syrup}`, centerX, 504);
+
+      const uiWidth = uiElement.offsetWidth || 240;
+      const uiX = Math.round(centerX - uiWidth / 2);
+      const uiY = 176;
+
+      if (typeof ctx.drawElementImage === "function") {
+        // Draw the live HTML element into the 2D canvas and sync hit-test geometry
+        ctx.drawElementImage(uiElement, uiX, uiY);
+      }
+
+      ctx.restore();
+    }
+
+    const supportsHtmlInCanvas = "content" in HTMLCanvasElement.prototype;
+
+    function handlePaint() {
+      if (typeof ctx.reset === "function") {
+        ctx.reset();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+      }
+      drawCoffeeCupScene();
+    }
+
+    function requestCupRepaint() {
+      if (typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      } else {
+        handlePaint();
+      }
+    }
+
+    if ("content" in HTMLCanvasElement.prototype) {
+      // Use HTML-in-Canvas API
+      canvas.onpaint = () => {
+        ctx.reset();
+        drawCoffeeCupScene();
+      };
+    } else {
+      // Fallback strategy: place the HTML content on top of the canvas using CSS
+      canvasStage.classList.add("fallback-overlay");
+      canvas.onpaint = () => {
+        ctx.reset();
+        drawCoffeeCupScene();
+      };
+    }
+
+    // Scale canvas backing store to device pixels to prevent blurriness on high-DPI screens
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCupRepaint();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    // Keep live text and canvas graphic updated as the user interacts with controls
+    [cupNameInput, milkSelect, syrupSelect].forEach((control) => {
+      control.addEventListener("input", () => {
+        orderStatus.textContent = "";
+        updateSummaryDOM();
+        requestCupRepaint();
+      });
+      control.addEventListener("change", () => {
+        orderStatus.textContent = "";
+        updateSummaryDOM();
+        requestCupRepaint();
+      });
+    });
+
+    customizerForm.addEventListener("submit", (e) => {
+      e.preventDefault();
+      if (!customizerForm.checkValidity()) {
+        cupNameInput.focus();
+        return;
+      }
+      const { name, milk, syrup } = getOrderState();
+      orderStatus.textContent = `Added ${name}'s ${milk} (${syrup}) cup!`;
+      requestCupRepaint();
+    });
+
+    updateSummaryDOM();
+    requestCupRepaint();
+  </script>
 </body>
 
