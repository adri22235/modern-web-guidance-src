+          const currentIdx = STAGE_ORDER.indexOf(column.dataset.status || '');
+          const nextStage = STAGE_ORDER[currentIdx + dir];
+          if (nextStage) {
+            moveItemToColumn(card, nextStage);
+            handle.focus({ preventScroll: true });
+          }
+        } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          const cards = Array.from(column.querySelectorAll(':scope > .card'));
+          const idx = cards.indexOf(card);
+          if (e.key === 'ArrowUp' && idx > 0) {
+            moveItemToColumn(card, column, cards[idx - 1]);
+            handle.focus({ preventScroll: true });
+          } else if (e.key === 'ArrowDown' && idx < cards.length - 1) {
+            moveItemToColumn(card, column, cards[idx + 2] || null);
+            handle.focus({ preventScroll: true });
+          }
+        }
+      });
+
+      // Reveal full card when keyboard focus enters
+      document.addEventListener('focusin', (e) => {
+        const target = e.target instanceof Element ? e.target : null;
+        if (!target || !target.matches(':focus-visible')) return;
+        const card = target.closest('.board-column > .card');
+        if (card && card.getAnimations().length === 0) {
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      });
+
+      // Add New Order Form
+      const newOrderForm = document.getElementById('new-order-form');
+      if (newOrderForm) {
+        newOrderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const formData = new FormData(newOrderForm);
+          const customer = String(formData.get('customer') || '').trim() || 'Guest';
+          const drink = String(formData.get('drink') || 'Maple Oat Latte');
+          const notes = String(formData.get('notes') || '').trim() || '12oz Standard preparation';
+
+          const orderNum = nextOrderNumber++;
+          const cardId = `order-${orderNum}`;
+          const imgUrl = DRINK_IMAGES[drink] || DRINK_IMAGES['Maple Oat Latte'];
+
+          const article = document.createElement('article');
+          article.className = 'card';
+          article.id = cardId;
+          article.dataset.orderId = String(orderNum);
+          article.dataset.status = 'queued';
+          article.draggable = true;
+
+          const img = document.createElement('img');
+          img.src = imgUrl;
+          img.alt = drink;
+
+          const header = document.createElement('header');
+          const headerInfo = document.createElement('div');
+          const meta = document.createElement('div');
+          meta.className = 'order-meta';
+
+          const idSpan = document.createElement('span');
+          idSpan.className = 'order-id';
+          idSpan.textContent = `#${orderNum}`;
+
+          const badgeSpan = document.createElement('span');
+          badgeSpan.className = 'order-status-badge';
+          badgeSpan.textContent = 'Queued';
+
+          meta.append(idSpan, badgeSpan);
+
+          const titleHeading = document.createElement('h4');
+          titleHeading.textContent = drink;
+          headerInfo.append(meta, titleHeading);
+
+          const handleBtn = document.createElement('button');
+          handleBtn.type = 'button';
+          handleBtn.className = 'drag-handle';
+          handleBtn.setAttribute('aria-label', `Reorder or move order #${orderNum} ${drink}`);
+          handleBtn.setAttribute('aria-pressed', 'false');
+          handleBtn.title = 'Drag or press Space to move';
+          handleBtn.textContent = '⋮⋮';
+
+          header.append(headerInfo, handleBtn);
+
+          const details = document.createElement('div');
+          details.className = 'order-details';
+
+          const customerP = document.createElement('p');
+          customerP.className = 'order-customer';
+          customerP.textContent = `For: ${customer}`;
+
+          const notesP = document.createElement('p');
+          notesP.className = 'order-notes';
+          notesP.textContent = notes;
+
+          const hintP = document.createElement('p');
+          hintP.className = 'reorder-hint';
+          hintP.setAttribute('aria-hidden', 'true');
+          hintP.textContent = 'Space to pick up · Arrows to move';
+
+          details.append(customerP, notesP, hintP);
+
+          const footer = document.createElement('footer');
+          const prevBtn = document.createElement('button');
+          prevBtn.type = 'button';
+          prevBtn.className = 'card-action-btn prev-btn';
+          prevBtn.dataset.dir = '-1';
+          prevBtn.disabled = true;
+          prevBtn.setAttribute('aria-label', `Move order #${orderNum} to previous stage`);
+          prevBtn.textContent = '← Back';
+
+          const advanceBtn = document.createElement('button');
+          advanceBtn.type = 'button';
+          advanceBtn.className = 'card-action-btn advance-btn';
+          advanceBtn.dataset.dir = '1';
+          advanceBtn.setAttribute('aria-label', `Move order #${orderNum} to Brewing`);
+          advanceBtn.textContent = 'Start Brewing →';
+
+          footer.append(prevBtn, advanceBtn);
+          article.append(img, header, details, footer);
+
+          const queuedCol = resolveColumn('queued');
+          if (queuedCol) {
+            queuedCol.appendChild(article);
+            updateColumnCounts();
+            announce(`Added order #${orderNum} ${drink} for ${customer} to Queued.`);
+          }
+          newOrderForm.reset();
+        });
+      }
+    })();
+  </script>
+
 </body>
 
