+
+      // Application State
+      const orders = INITIAL_ORDERS.map((o) => ({ ...o }));
+      let nextOrderNum = 1044;
+      let activeDragOrderId = null;
+      let html5DragInProgress = false;
+
+      const columnElements = {
+        queued: document.getElementById('col-queued'),
+        brewing: document.getElementById('col-brewing'),
+        ready: document.getElementById('col-ready')
+      };
+
+      const columns = {
+        queued: new IsolatedBoardColumn(columnElements.queued, 'queued', moveOrderToColumn),
+        brewing: new IsolatedBoardColumn(columnElements.brewing, 'brewing', moveOrderToColumn),
+        ready: new IsolatedBoardColumn(columnElements.ready, 'ready', moveOrderToColumn)
+      };
+
+      function renderColumns(statusesToUpdate) {
+        const targetStatuses = statusesToUpdate || ['queued', 'brewing', 'ready'];
+        targetStatuses.forEach((status) => {
+          const col = columns[status];
+          if (col) {
+            const columnOrders = orders.filter((o) => o.status === status);
+            col.render(columnOrders);
+          }
+        });
+      }
+
+      function moveOrderToColumn(orderId, targetStatus) {
+        const orderIndex = orders.findIndex((o) => o.id === orderId);
+        if (orderIndex === -1) return;
+
+        const order = orders[orderIndex];
+        const previousStatus = order.status;
+        if (previousStatus === targetStatus) return;
+
+        // Move order to the end of the target column
+        order.status = targetStatus;
+        orders.splice(orderIndex, 1);
+        orders.push(order);
+
+        // Isolated column rendering: only update the source and destination columns
+        renderColumns([previousStatus, targetStatus]);
+      }
+
+      // HTML5 Drag and Drop delegation on board
+      const boardEl = document.getElementById('kanban-board');
+
+      boardEl.addEventListener('dragstart', (e) => {
+        const cardEl = e.target.closest('.card');
+        if (!cardEl) return;
+        html5DragInProgress = true;
+        pointerDragState = null;
+        activeDragOrderId = cardEl.dataset.orderId;
+        cardEl.classList.add('dragging');
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', activeDragOrderId);
+        }
+      });
+
+      boardEl.addEventListener('dragend', (e) => {
+        const cardEl = e.target.closest('.card');
+        if (cardEl) {
+          cardEl.classList.remove('dragging');
+        }
+        document.querySelectorAll('.board-column.drag-over').forEach((col) => {
+          col.classList.remove('drag-over');
+        });
+        html5DragInProgress = false;
+        activeDragOrderId = null;
+      });
+
+      // Fallback pointer/mouse drag support for environments using mouse.down/move/up
+      let pointerDragState = null;
+
+      boardEl.addEventListener('mousedown', (e) => {
+        if (e.button !== 0) return;
+        const cardEl = e.target.closest('.card');
+        if (!cardEl) return;
+        pointerDragState = {
+          orderId: cardEl.dataset.orderId,
+          cardEl,
+          startX: e.clientX,
+          startY: e.clientY,
+          dragging: false
+        };
+      });
+
+      window.addEventListener('mousemove', (e) => {
+        if (!pointerDragState || html5DragInProgress) return;
+        const dx = e.clientX - pointerDragState.startX;
+        const dy = e.clientY - pointerDragState.startY;
+        if (!pointerDragState.dragging && Math.hypot(dx, dy) > 5) {
+          pointerDragState.dragging = true;
+          activeDragOrderId = pointerDragState.orderId;
+          pointerDragState.cardEl.classList.add('dragging');
+        }
+
+        if (pointerDragState.dragging) {
+          const targetCol = findColumnAtPoint(e.clientX, e.clientY);
+          document.querySelectorAll('.board-column').forEach((col) => {
+            col.classList.toggle('drag-over', col === targetCol);
+          });
+        }
+      });
+
+      window.addEventListener('mouseup', (e) => {
+        if (!pointerDragState) return;
+        const state = pointerDragState;
+        pointerDragState = null;
+
+        if (state.dragging && !html5DragInProgress) {
+          state.cardEl.classList.remove('dragging');
+          document.querySelectorAll('.board-column.drag-over').forEach((col) => {
+            col.classList.remove('drag-over');
+          });
+          const targetCol = findColumnAtPoint(e.clientX, e.clientY);
+          if (targetCol && targetCol.dataset.status) {
+            moveOrderToColumn(state.orderId, targetCol.dataset.status);
+          }
+          activeDragOrderId = null;
+        }
+      });
+
+      function findColumnAtPoint(x, y) {
+        const cols = document.querySelectorAll('.board-column');
+        for (const col of cols) {
+          const rect = col.getBoundingClientRect();
+          if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
+            return col;
+          }
+        }
+        return null;
+      }
+
+      // Add New Order Form Handler
+      const newOrderForm = document.getElementById('new-order-form');
+      newOrderForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const customerInput = document.getElementById('customer-input');
+        const drinkInput = document.getElementById('drink-input');
+        const notesInput = document.getElementById('notes-input');
+
+        const customer = customerInput.value.trim();
+        const drink = drinkInput.value.trim();
+        const notes = notesInput.value;
+
+        if (!customer || !drink) return;
+
+        const newOrder = {
+          id: `order-${nextOrderNum}`,
+          number: `#${nextOrderNum}`,
+          customer,
+          drink,
+          notes,
+          time: 'Just now',
+          status: 'queued'
+        };
+        nextOrderNum += 1;
+
+        orders.push(newOrder);
+        // Only the queued column needs to re-render
+        renderColumns(['queued']);
+
+        customerInput.value = '';
+        drinkInput.value = '';
+      });
+
+      // Initial render of all 3 isolated columns
+      renderColumns(['queued', 'brewing', 'ready']);
+    })();
+  </script>
 </body>
 
 </html>
