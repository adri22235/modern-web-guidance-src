+          this.cardsContainer = columnEl.querySelector('[data-role="cards"]');
+          this.countBadge = columnEl.querySelector('[data-role="count"]');
+          this.lastSignature = null;
+          this.renderCount = 0;
+
+          this.bindDropEvents();
+        }
+
+        bindDropEvents() {
+          this.columnEl.addEventListener('dragover', (e) => {
+            e.preventDefault();
+            if (e.dataTransfer) {
+              e.dataTransfer.dropEffect = 'move';
+            }
+            this.columnEl.classList.add('drag-over');
+          });
+
+          this.columnEl.addEventListener('dragenter', (e) => {
+            e.preventDefault();
+            this.columnEl.classList.add('drag-over');
+          });
+
+          this.columnEl.addEventListener('dragleave', (e) => {
+            if (!this.columnEl.contains(e.relatedTarget)) {
+              this.columnEl.classList.remove('drag-over');
+            }
+          });
+
+          this.columnEl.addEventListener('drop', (e) => {
+            e.preventDefault();
+            this.columnEl.classList.remove('drag-over');
+            const transferredId = e.dataTransfer ? e.dataTransfer.getData('text/plain') : '';
+            const orderId = transferredId || activeDragOrderId;
+            if (orderId) {
+              this.onCardDrop(orderId, this.status);
+            }
+          });
+        }
+
+        render(ordersForColumn) {
+          const signature = ordersForColumn
+            .map((o) => `${o.id}:${o.status}:${o.drink}:${o.customer}:${o.notes}`)
+            .join('|');
+
+          // Skip rendering entirely if this column's items have not changed
+          if (signature === this.lastSignature) {
+            return false;
+          }
+
+          this.lastSignature = signature;
+          this.renderCount += 1;
