+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const submitBtn = document.getElementById('pay-submit-btn');
+    const paymentStatus = document.getElementById('payment-status');
+
+    const errorMessages = {
+      'cc-number': 'Please enter a valid card number (13 to 19 digits, spaces allowed).',
+      'cc-name': 'Please enter the cardholder name as shown on your card.',
+      'cc-exp': 'Please enter a valid expiry date in MM/YY format.',
+      'cc-csc': 'Please enter the 3- or 4-digit security code.'
+    };
+
+    Object.keys(errorMessages).forEach((id) => {
+      const input = document.getElementById(id);
+      if (!input) return;
+
+      input.addEventListener('invalid', () => {
+        input.setCustomValidity(errorMessages[id]);
+        input.setAttribute('aria-invalid', 'true');
+      });
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+      });
+
+      input.addEventListener('blur', () => {
+        if (input.value.length > 0 && !input.checkValidity()) {
+          input.setAttribute('aria-invalid', 'true');
+        }
+      });
+    });
+
+    paymentForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!paymentForm.checkValidity()) {
+        const firstInvalid = paymentForm.querySelector(':invalid');
+        if (firstInvalid) {
+          firstInvalid.focus();
+        }
+        return;
+      }
+      submitBtn.disabled = true;
+      paymentStatus.textContent = 'Payment submitted successfully.';
+    });
+  </script>
+
