diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,417 @@
+<!DOCTYPE html>
+<html lang="en" data-variant="control">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow — Ship Confident Product Experiments</title>
+
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+
+  <!--
+    Load the A/B testing SDK in <head> with both `async` and `blocking="render"`.
+    - `async`: Fetches in parallel without blocking the HTML parser.
+    - `blocking="render"`: Holds first paint until the experiment script executes,
+      ensuring the user never sees original content flash before the variant is applied.
+  -->
+  <script
+    id="experiment-sdk"
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Feature-detected anti-flicker fallback for browsers that do not support blocking="render".
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+
+    function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    }
+
+    window.onExperimentReady = onExperimentReady;
+
+    document.getElementById('experiment-sdk')?.addEventListener('load', onExperimentReady, { once: true });
+    document.getElementById('experiment-sdk')?.addEventListener('error', onExperimentReady, { once: true });
+  </script>
+
+  <style>
+    /* Fallback anti-flicker rule applied only when blocking="render" is unsupported */
+    .ab-loading {
+      opacity: 0 !important;
+    }
+
+    :root {
+      --bg-surface: #0b0f19;
+      --bg-elevated: #131b2e;
+      --bg-card: #172036;
+      --text-primary: #f8fafc;
+      --text-secondary: #94a3b8;
+      --accent-primary: #4f46e5;
+      --accent-hover: #4338ca;
+      --accent-glow: rgba(79, 70, 229, 0.35);
+      --border-subtle: rgba(148, 163, 184, 0.16);
+      --radius-md: 0.75rem;
+      --radius-lg: 1rem;
+    }
+
+    /* Variant B overrides keyed to the root data-variant attribute */
+    [data-variant="b"] {
+      --accent-primary: #059669;
+      --accent-hover: #047857;
+      --accent-glow: rgba(5, 150, 105, 0.35);
+    }
+
+    *,
+    *::before,
+    *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      min-block-size: 100dvh;
+      display: grid;
+      grid-template-rows: auto 1fr auto;
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background-color: var(--bg-surface);
+      color: var(--text-primary);
+      line-height: 1.6;
+    }
+
+    .container {
+      inline-size: min(100% - 2.5rem, 72rem);
+      margin-inline: auto;
+    }
+
+    header {
+      border-block-end: 1px solid var(--border-subtle);
+      padding-block: 1rem;
+    }
+
+    .nav-bar {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: safe center;
+      justify-content: space-between;
+      gap: 1rem;
+    }
+
+    .brand {
+      display: inline-flex;
+      align-items: safe center;
+      gap: 0.625rem;
+      font-weight: 700;
+      font-size: 1.125rem;
+      color: var(--text-primary);
+      text-decoration: none;
+      letter-spacing: -0.02em;
+    }
+
+    .nav-links {
+      display: flex;
+      flex-wrap: wrap;
+      flex-wrap: balance;
+      gap: 1.5rem;
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .nav-links a {
+      color: var(--text-secondary);
+      text-decoration: none;
+      font-size: 0.9375rem;
+      transition: color 0.15s ease;
+    }
+
+    .nav-links a:hover,
+    .nav-links a:focus-visible {
+      color: var(--text-primary);
+    }
+
+    .hero {
+      padding-block: clamp(3rem, 7vw, 6rem);
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+      align-items: safe center;
+      gap: clamp(2rem, 5vw, 4rem);
+    }
+
+    .hero-badge {
+      display: inline-flex;
+      align-items: safe center;
+      gap: 0.5rem;
+      padding-block: 0.35rem;
+      padding-inline: 0.85rem;
+      border-radius: 999px;
+      background-color: var(--bg-elevated);
+      border: 1px solid var(--border-subtle);
+      color: var(--text-secondary);
+      font-size: 0.8125rem;
+      font-weight: 500;
+      margin-block-end: 1.25rem;
+    }
+
+    .hero h1 {
+      font-size: clamp(2.25rem, 4.5vw, 3.5rem);
+      line-height: 1.1;
+      letter-spacing: -0.03em;
+      margin-block: 0 1.25rem;
+    }
+
+    .hero-subtitle {
+      font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
+      color: var(--text-secondary);
+      max-inline-size: 54ch;
+      margin-block: 0 2rem;
+    }
+
+    .hero-actions {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: safe center;
+      gap: 1rem;
+    }
+
+    .cta-button {
+      display: inline-flex;
+      align-items: safe center;
+      justify-content: center;
+      gap: 0.5rem;
+      padding-block: 0.875rem;
+      padding-inline: 1.75rem;
+      font-size: 1rem;
+      font-weight: 600;
+      font-family: inherit;
+      color: #ffffff;
+      background-color: var(--accent-primary);
+      border: 1px solid transparent;
+      border-radius: var(--radius-md);
+      box-shadow: 0 8px 24px -4px var(--accent-glow);
+      cursor: pointer;
+      transition: background-color 0.15s ease, transform 0.15s ease;
+    }
+
+    .cta-button:hover {
+      background-color: var(--accent-hover);
+    }
+
+    .cta-button:focus-visible {
+      outline: 2px solid #ffffff;
+      outline-offset: 3px;
+    }
+
+    .secondary-link {
+      display: inline-flex;
+      align-items: safe center;
+      padding-block: 0.875rem;
+      padding-inline: 1.25rem;
+      font-size: 0.9375rem;
+      font-weight: 500;
+      color: var(--text-primary);
+      text-decoration: none;
+      border-radius: var(--radius-md);
+      border: 1px solid var(--border-subtle);
+      background-color: var(--bg-elevated);
+    }
+
+    .hero-media {
+      margin: 0;
+      border-radius: var(--radius-lg);
+      overflow: clip;
+      border: 1px solid var(--border-subtle);
+      background-color: var(--bg-elevated);
+      box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6);
+    }
+
+    .hero-media img {
+      display: block;
+      inline-size: 100%;
+      block-size: auto;
+      aspect-ratio: 16 / 10;
+      object-fit: cover;
+    }
+
+    .features {
+      padding-block: 3rem 5rem;
+    }
+
+    .features h2 {
+      font-size: clamp(1.5rem, 2.5vw, 2rem);
+      margin-block: 0 2rem;
+      letter-spacing: -0.02em;
+    }
+
+    .feature-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
+      grid-template-rows: auto 1fr;
+      gap: 1.5rem;
+    }
+
+    .feature-card {
+      grid-row: span 2;
+      display: grid;
+      grid-template-rows: auto 1fr;
+      grid-template-rows: subgrid;
+      gap: 0.5rem;
+      padding: 1.5rem;
+      border-radius: var(--radius-md);
+      background-color: var(--bg-card);
+      border: 1px solid var(--border-subtle);
+    }
+
+    .feature-card h3 {
+      margin: 0;
+      font-size: 1.125rem;
+    }
+
+    .feature-card p {
+      margin: 0;
+      color: var(--text-secondary);
+      font-size: 0.9375rem;
+    }
+
+    dialog {
+      background-color: var(--bg-card);
+      color: var(--text-primary);
+      border: 1px solid var(--border-subtle);
+      border-radius: var(--radius-lg);
+      padding: 1.75rem;
+      max-inline-size: 28rem;
+      inline-size: calc(100% - 2rem);
+    }
+
+    dialog::backdrop {
+      background-color: rgba(11, 15, 25, 0.75);
+      backdrop-filter: blur(4px);
+    }
+
+    dialog h2 {
+      margin-block: 0 0.5rem;
+    }
+
+    dialog p {
+      color: var(--text-secondary);
+      margin-block: 0 1.25rem;
+    }
+
+    .dialog-actions {
+      display: flex;
+      justify-content: flex-end;
+      gap: 0.75rem;
+    }
+
+    footer {
+      border-block-start: 1px solid var(--border-subtle);
+      padding-block: 1.5rem;
+      color: var(--text-secondary);
+      font-size: 0.875rem;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <div class="container nav-bar">
+      <a href="/" class="brand">
+        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+          <rect width="24" height="24" rx="6" fill="currentColor" fill-opacity="0.15"/>
+          <path d="M6 13L10 9L14 15L18 11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
+        </svg>
+        <span>PulseFlow</span>
+      </a>
+      <nav aria-label="Primary">
+        <ul class="nav-links">
+          <li><a href="#features">Features</a></li>
+          <li><a href="#benchmarks">Benchmarks</a></li>
+          <li><a href="#pricing">Pricing</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main>
+    <section class="container hero" aria-labelledby="hero-heading" data-experiment-section="hero">
+      <div class="hero-content">
+        <span class="hero-badge" data-experiment-target="badge">Flicker-Free Experimentation Engine</span>
+        <h1 id="hero-heading" data-experiment-target="headline">
+          Ship high-velocity product experiments without visual flash.
+        </h1>
+        <p class="hero-subtitle" data-experiment-target="subheadline">
+          Run deterministic A/B and multivariate tests at the edge or in the browser while preserving Core Web Vitals and instant first paint.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            id="hero-cta"
+            class="cta-button"
+            data-experiment-target="cta"
+          >
+            Start Free Trial
+          </button>
+          <a href="#features" class="secondary-link">Explore Architecture</a>
+        </div>
+      </div>
+
+      <figure class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          alt="Analytics dashboard showing experiment conversion curves across two variants"
+          width="1200"
+          height="750"
+          fetchpriority="high"
+        >
+      </figure>
+    </section>
+
+    <section id="features" class="container features" aria-labelledby="features-heading">
+      <h2 id="features-heading">Built for zero-flicker performance</h2>
+      <div class="feature-grid">
+        <article class="feature-card">
+          <h3>Render-Blocking Coordination</h3>
+          <p>Synchronizes variant assignment before the browser's first paint using modern HTML render-blocking semantics.</p>
+        </article>
+        <article class="feature-card">
+          <h3>Sub-Millisecond Bucketing</h3>
+          <p>Evaluates audience targeting rules locally and applies variant state via root data attributes.</p>
+        </article>
+        <article class="feature-card">
+          <h3>Core Web Vitals Safe</h3>
+          <p>Parallelizes script fetching alongside HTML parsing so DOM construction never stalls on experiment setup.</p>
+        </article>
+      </div>
+    </section>
+
+    <dialog id="cta-dialog" closedby="any" aria-labelledby="dialog-title">
+      <form method="dialog">
+        <h2 id="dialog-title">Launch Your First Experiment</h2>
+        <p>Your workspace is ready. Connect the SDK to start testing variants with zero content flash.</p>
+        <div class="dialog-actions">
+          <button value="close" class="cta-button">Continue</button>
+        </div>
+      </form>
+    </dialog>
+  </main>
+
+  <footer>
+    <div class="container">
+      <p>&copy; 2026 PulseFlow Inc. All rights reserved.</p>
+    </div>
+  </footer>
+
+  <script type="module">
+    const ctaButton = document.getElementById('hero-cta');
+    const ctaDialog = document.getElementById('cta-dialog');
+
+    ctaButton?.addEventListener('click', () => {
+      ctaDialog?.showModal();
+    });
+  </script>
+</body>
+</html>
