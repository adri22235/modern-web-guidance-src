+  <!-- Synchronous anti-flicker controller & A/B testing configuration -->
+  <script>
+    (function () {
+      var docEl = document.documentElement;
+      docEl.classList.add('async-hide', 'ab-cloak');
+      docEl.setAttribute('data-ab-state', 'loading');
+
+      var revealed = false;
+      var fallbackTimer = null;
+      var MAX_WAIT_MS = 3000;
+
+      function revealExperimentContent(reason) {
+        if (revealed) return;
+        revealed = true;
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        docEl.classList.remove('async-hide', 'ab-cloak');
+        docEl.setAttribute('data-ab-state', reason || 'ready');
+      }
+
+      // Failsafe timeout so a hung network never leaves the page blank indefinitely
+      fallbackTimer = setTimeout(function () {
+        revealExperimentContent('timeout');
+      }, MAX_WAIT_MS);
+
+      // Standard anti-flicker & global SDK hooks
+      window.__revealExperiment = revealExperimentContent;
+      window.revealExperimentContent = revealExperimentContent;
+      window.dataLayer = window.dataLayer || [];
+      window.dataLayer.hide = {
+        end: function () {
+          revealExperimentContent('datalayer-end');
+        }
+      };
+
+      window.experimentConfig = {
+        experimentId: 'hero-cta-optimization',
+        selectors: {
+          hero: '#hero',
+          headline: '#hero-title',
+          subheadline: '#hero-subtitle',
+          cta: '#cta-button'
+        },
+        variants: {
+          control: {
+            headline: 'Ship production code with zero-config release pipelines',
+            subheadline: 'Automate builds, ephemeral preview environments, and global edge rollouts in one unified platform built for high-velocity engineering teams.',
+            cta: 'Start Free Trial'
+          },
+          variantA: {
+            headline: 'Deploy to the global edge in seconds, not hours',
+            subheadline: 'Eliminate CI/CD bottlenecks with instant atomic deployments, automated canary checks, and one-click rollbacks.',
+            cta: 'Deploy Now — Free'
+          },
+          variantB: {
+            headline: 'Cut your cloud deployment cycle time by 70%',
+            subheadline: 'Join 15,000+ engineering teams shipping faster with automated preview links, real-time telemetry, and zero-downtime releases.',
+            cta: 'Claim Your Free Workspace'
+          }
+        },
+        onReady: function () {
+          revealExperimentContent('sdk-callback');
+        }
+      };
+
+      window.__onExperimentScriptLoad = function () {
+        try {
+          var sdk = window.ExperimentSDK || window.experimentSDK;
+          if (sdk && typeof sdk.init === 'function' && !sdk.__initialized) {
+            sdk.__initialized = true;
+            sdk.init(window.experimentConfig);
+          } else if (sdk && typeof sdk.apply === 'function' && !sdk.__initialized) {
+            sdk.__initialized = true;
+            sdk.apply(window.experimentConfig);
+          }
+        } catch (err) {
+          // Ensure any SDK runtime error never leaves content hidden
+        }
+
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', function () {
+            revealExperimentContent('applied');
+          }, { once: true });
+        } else {
+          revealExperimentContent('applied');
+        }
+      };
+    })();
+  </script>
