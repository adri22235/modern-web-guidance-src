+  <script>
+    const defaultPageTitle = document.title;
+
+    function updateDetailContent(card) {
+      const hero = document.getElementById("hero");
+      const titleEl = document.getElementById("title");
+      const descEl = document.getElementById("detail-description");
+      const notesEl = document.getElementById("detail-notes");
+
+      const itemTitle = card.querySelector(".title")?.textContent?.trim() || "";
+      const itemDesc = card.querySelector(".card-desc")?.textContent?.trim() || "";
+      const itemImage = card.dataset.image || card.querySelector("img")?.src || "";
+      const itemAlt = card.dataset.imageAlt || card.querySelector("img")?.alt || itemTitle;
+      const itemNotes = card.dataset.notes || "";
+
+      if (hero) {
+        hero.src = itemImage;
+        hero.alt = itemAlt;
+      }
+      if (titleEl) {
+        titleEl.textContent = itemTitle;
+      }
+      if (descEl) {
+        descEl.textContent = itemDesc;
+      }
+      if (notesEl) {
+        notesEl.textContent = itemNotes;
+      }
+      if (itemTitle) {
+        document.title = `${itemTitle} | The Daily Grind`;
+      }
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+      document.querySelectorAll(".thumbnail.selected").forEach((el) => {
+        el.classList.remove("selected");
+      });
+      card.classList.add("selected");
+      updateDetailContent(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add("detail");
+        document.getElementById("title")?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add("detail");
+      });
+
+      transition.finished.finally(() => {
+        document.getElementById("title")?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      document.title = defaultPageTitle;
+
+      if (!document.startViewTransition) {
+        document.body.classList.remove("detail");
+        document.getElementById("list-heading")?.focus();
+        document.querySelectorAll(".selected").forEach((element) => {
+          element.classList.remove("selected");
+        });
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove("detail");
+      });
+
+      transition.finished.finally(() => {
+        document.getElementById("list-heading")?.focus();
+        document.querySelectorAll(".selected").forEach((element) => {
+          element.classList.remove("selected");
+        });
+      });
+    }
+
+    document.querySelectorAll(".thumbnail").forEach((card) => {
+      card.addEventListener("click", goFromListToDetail);
+    });
+
+    document.getElementById("back-btn")?.addEventListener("click", goFromDetailToList);
+  </script>
