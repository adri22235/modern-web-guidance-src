+            anchor.dataset.linkStatus = 'blocked';
+            anchor.setAttribute('aria-disabled', 'true');
+            appendAuditLog('LINK', 'REJECTED', 'Blocked unsafe link href: ' + String(rawHref));
+            results.push({ element: anchor, status: 'blocked', check: linkCheck });
+            return;
+          }
+
+          // Check if the link carries a redirect/returnTo/next query parameter via URLSearchParams
+          const parsedLink = parseHttpUrl(rawHref);
+          if (parsedLink) {
+            const redirectParamKeys = ['redirect', 'returnTo', 'next', 'continue'];
+            redirectParamKeys.forEach(function (key) {
+              if (parsedLink.searchParams.has(key)) {
+                const candidateRedirect = parsedLink.searchParams.get(key);
+                const redirectInspection = inspectRedirectUrl(candidateRedirect);
+                if (!redirectInspection.valid) {
+                  parsedLink.searchParams.set(key, SAFE_DEFAULT_REDIRECT);
+                  anchor.setAttribute('href', parsedLink.pathname + parsedLink.search + parsedLink.hash);
+                  anchor.dataset.redirectSanitized = 'true';
+                  appendAuditLog(
+                    'REDIRECT',
+                    'REJECTED',
+                    'Sanitized unsafe "' + key + '" parameter (' + candidateRedirect + ') to ' + SAFE_DEFAULT_REDIRECT
+                  );
+                } else {
+                  anchor.dataset.redirectValidated = 'true';
+                }
+              }
+            });
+          }
+
+          if (linkCheck.isExternal) {
+            anchor.setAttribute('rel', 'noopener noreferrer');
+            anchor.setAttribute('target', '_blank');
+            anchor.setAttribute('referrerpolicy', 'no-referrer');
+            anchor.dataset.external = 'true';
+            anchor.dataset.linkStatus = 'external-valid';
+            appendAuditLog('LINK', 'EXTERNAL_HARDENED', linkCheck.reason);
+          } else {
+            anchor.dataset.external = 'false';
+            anchor.dataset.linkStatus = linkCheck.isSameOrigin ? 'same-origin' : 'same-site';
+          }
+
+          results.push({ element: anchor, status: anchor.dataset.linkStatus, check: linkCheck });
+        });
+
+        return results;
+      }
+
+      /**
+       * Verifies whether a MessageEvent origin strictly matches the trusted ordering origin.
+       */
+      function isTrustedOrderOrigin(origin) {
+        if (typeof origin !== 'string' || origin.length === 0 || origin === 'null') {
+          return false;
+        }
+        let parsed;
+        try {
+          parsed = new URL(origin);
+        } catch {
+          return false;
+        }
+        return (
+          parsed.protocol === 'https:' &&
+          parsed.username === '' &&
+          parsed.password === '' &&
+          parsed.origin === TRUSTED_ORDER_ORIGIN &&
+          origin === TRUSTED_ORDER_ORIGIN
+        );
+      }
+
+      /**
+       * Determines if a message payload is a widget initialization handshake.
+       */
+      function isWidgetInitPayload(data) {
+        if (!data || typeof data !== 'object') {
+          return false;
+        }
+        return (
+          data.type === 'WIDGET_INIT' ||
+          data.type === 'INIT' ||
+          data.type === 'init'
+        );
+      }
+
+      /**
+       * Determines if a message payload is intended for the sandboxed widget channel.
+       */
+      function isWidgetPayload(data) {
+        if (!data || typeof data !== 'object' || typeof data.type !== 'string') {
+          return false;
+        }
+        return (
+          isWidgetInitPayload(data) ||
+          data.type.startsWith('WIDGET_') ||
+          data.channel === 'sandbox-widget'
+        );
+      }
+
+      /**
+       * Handles messages from sandboxed iframes (where event.origin === "null") using
+       * sender identity (event.source) pinning on initialization.
+       */
+      function handleSandboxedWidgetMessage(event) {
+        if (event.origin !== 'null') {
+          return {
+            accepted: false,
+            reason: 'Expected opaque "null" origin for sandboxed widget.'
+          };
+        }
+
+        // Require a genuine cross-frame sender reference distinct from the host window
+        if (!event.source || event.source === window) {
+          updateWidgetBanner(
+            'rejected',
+            'Rejected sandboxed message: missing or invalid MessageEvent.source identity.'
+          );
+          appendAuditLog('WIDGET', 'REJECTED', 'Invalid or missing MessageEvent.source for null-origin message.');
+          return {
+            accepted: false,
+            reason: 'Missing or invalid MessageEvent.source.'
+          };
+        }
+
+        const payload = event.data;
+        if (!payload || typeof payload !== 'object' || typeof payload.type !== 'string') {
+          updateWidgetBanner('rejected', 'Rejected sandboxed message: malformed message payload.');
+          appendAuditLog('WIDGET', 'REJECTED', 'Malformed payload from null origin.');
+          return {
+            accepted: false,
+            reason: 'Malformed widget payload.'
+          };
+        }
+
+        // Before initialization: only accept the first valid initialization message to pin event.source
+        if (pinnedWidgetSource === null) {
+          if (!isWidgetInitPayload(payload)) {
+            updateWidgetBanner(
+              'rejected',
+              'Rejected sandboxed message (' + payload.type + '): widget sender not initialized yet.'
+            );
+            appendAuditLog('WIDGET', 'REJECTED', 'Rejected pre-init message of type "' + payload.type + '".');
+            return {
+              accepted: false,
+              reason: 'Widget sender identity has not been initialized yet.'
+            };
+          }
+
+          // Never pin the known untrusted sandboxed iframe if it races initialization
+          if (untrustedSandboxIframe && event.source === untrustedSandboxIframe.contentWindow) {
+            updateWidgetBanner(
+              'rejected',
+              'Rejected initialization attempt from untrusted sandboxed iframe.'
+            );
+            appendAuditLog('WIDGET', 'REJECTED', 'Blocked initialization attempt from untrusted sandboxed iframe.');
+            return {
+              accepted: false,
+              reason: 'Untrusted sandboxed iframe cannot initialize widget.'
+            };
+          }
+
+          pinnedWidgetSource = event.source;
+          pinnedWidgetMetadata = {
+            widgetId: typeof payload.widgetId === 'string' ? payload.widgetId : 'daily-grind-widget',
+            pinnedAt: Date.now()
+          };
+
+          updateWidgetBanner(
+            'accepted',
+            'Pinned sandboxed widget sender identity (' + pinnedWidgetMetadata.widgetId + '). Subsequent messages from this widget will be accepted.'
+          );
+          appendAuditLog(
+            'WIDGET',
+            'PINNED',
+            'Pinned MessageEvent.source for widget "' + pinnedWidgetMetadata.widgetId + '" (origin: "null").'
+          );
+
+          return {
+            accepted: true,
+            pinned: true,
+            widgetId: pinnedWidgetMetadata.widgetId,
+            reason: 'Pinned sandboxed widget sender identity on initialization.'
+          };
+        }
+
+        // After initialization: strictly require event.source === pinnedWidgetSource
+        if (event.source !== pinnedWidgetSource) {
+          updateWidgetBanner(
+            'rejected',
+            'Rejected message (' + payload.type + ') from unpinned sandboxed iframe (event.source mismatch).'
+          );
+          appendAuditLog(
+            'WIDGET',
+            'REJECTED',
+            'Rejected "' + payload.type + '" from another sandboxed iframe (origin "null", unpinned event.source).'
+          );
+          return {
+            accepted: false,
+            reason: 'Sender event.source does not match pinned sandboxed widget.'
+          };
+        }
+
+        // Subsequent message from the same pinned widget source
+        const summaryText = typeof payload.summary === 'string'
+          ? payload.summary
+          : (typeof payload.action === 'string' ? payload.action : payload.type);
+        const pointsSuffix = typeof payload.points === 'number'
+          ? ' | Bean Points: ' + String(payload.points)
+          : '';
+
+        updateWidgetBanner(
+          'accepted',
+          'Accepted message from pinned widget: ' + summaryText + pointsSuffix
+        );
+        appendAuditLog(
+          'WIDGET',
+          'ACCEPTED',
+          'Accepted "' + payload.type + '" from pinned widget source (' + summaryText + ').'
+        );
+
+        return {
+          accepted: true,
+          pinned: false,
+          data: payload,
+          reason: 'Accepted subsequent message from pinned widget sender.'
+        };
+      }
+
+      /**
+       * Handles cross-window ordering messages after verifying event.origin against TRUSTED_ORDER_ORIGIN.
+       */
+      function handleOrderingMessage(event) {
+        if (!isTrustedOrderOrigin(event.origin)) {
+          updateOrderBanner(
+            'rejected',
+            'Rejected cross-window message from untrusted origin: ' + String(event.origin)
+          );
+          appendAuditLog(
+            'ORIGIN',
+            'REJECTED',
+            'Rejected message from untrusted origin "' + String(event.origin) + '" (expected "' + TRUSTED_ORDER_ORIGIN + '").'
+          );
+          return {
+            accepted: false,
+            reason: 'Untrusted message origin: ' + String(event.origin)
+          };
+        }
+
+        const payload = event.data;
+        if (!payload || typeof payload !== 'object' || typeof payload.type !== 'string') {
+          updateOrderBanner(
+            'rejected',
+            'Rejected message from ' + TRUSTED_ORDER_ORIGIN + ': invalid payload structure.'
+          );
+          appendAuditLog('ORIGIN', 'REJECTED', 'Invalid payload structure from trusted ordering origin.');
+          return {
+            accepted: false,
+            reason: 'Invalid ordering message payload.'
+          };
+        }
+
+        const orderId = typeof payload.orderId === 'string' ? payload.orderId : 'DG-1042';
+        const status = typeof payload.status === 'string' ? payload.status : 'Confirmed';
+        const item = typeof payload.item === 'string' ? payload.item : 'Maple Oat Latte';
+
+        updateOrderBanner(
+          'accepted',
+          'Verified order update from ' + event.origin + ' — Order #' + orderId + ' (' + item + '): ' + status
+        );
+        appendAuditLog(
+          'ORIGIN',
+          'ACCEPTED',
+          'Verified "' + payload.type + '" from ' + event.origin + ' for Order #' + orderId + ' (' + status + ').'
+        );
+
+        // If replying to the ordering window, always specify exact TRUSTED_ORDER_ORIGIN (never "*")
+        if (event.source && typeof event.source.postMessage === 'function' && event.source !== window) {
+          try {
+            event.source.postMessage(
+              { type: 'ORDER_ACK', orderId: orderId },
+              TRUSTED_ORDER_ORIGIN
+            );
+          } catch {
+            // Ignore cross-origin ack errors on synthetic MessageEvent objects
+          }
+        }
+
+        return {
+          accepted: true,
+          origin: event.origin,
+          orderId: orderId,
+          status: status,
+          item: item
+        };
+      }
+
+      /**
+       * Unified cross-window message dispatcher for window.addEventListener('message', ...).
+       * Routes opaque "null" origin messages to the pinned sandboxed widget verifier and
+       * routes standard origin messages to the trusted ordering origin verifier.
+       */
+      function handleIncomingMessage(event) {
+        if (!event || typeof event !== 'object') {
+          return { accepted: false, reason: 'Invalid event.' };
+        }
+
+        if (event.origin === 'null') {
+          return handleSandboxedWidgetMessage(event);
+        }
+
+        if (isWidgetPayload(event.data) && !isTrustedOrderOrigin(event.origin)) {
+          return handleSandboxedWidgetMessage(event);
+        }
+
+        return handleOrderingMessage(event);
+      }
+
+      function updateOrderBanner(state, text) {
+        if (!orderStatusEl) return;
+        orderStatusEl.className = 'status-banner ' + state;
+        orderStatusEl.textContent = text;
+      }
+
+      function updateWidgetBanner(state, text) {
+        if (!widgetStatusEl) return;
+        widgetStatusEl.className = 'status-banner ' + state;
+        widgetStatusEl.textContent = text;
+      }
+
+      function updateRedirectBanner(result) {
+        if (!redirectStatusEl) return;
+        redirectStatusEl.className = 'status-banner ' + (result.valid ? 'accepted' : 'rejected');
+        redirectStatusEl.textContent = result.reason + ' Resolved destination: ' + result.safeUrl;
+      }
+
+      /**
+       * Checks the current page URL query string (via URLSearchParams, no string splitting)
+       * for any redirect/returnTo/next parameter and validates it on load.
+       */
+      function validateInitialPageRedirectParam() {
+        const params = new URLSearchParams(window.location.search);
+        const paramKeys = ['redirect', 'returnTo', 'next', 'continue'];
+
+        for (const key of paramKeys) {
+          if (params.has(key)) {
+            const rawTarget = params.get(key);
+            const result = inspectRedirectUrl(rawTarget);
+            if (redirectInputEl) {
+              redirectInputEl.value = rawTarget;
+            }
+            updateRedirectBanner(result);
+            appendAuditLog(
+              'REDIRECT',
+              result.valid ? 'ACCEPTED' : 'REJECTED',
+              'Query param ?' + key + '=' + rawTarget + ' -> ' + result.safeUrl
+            );
+            return result;
+          }
+        }
+        return null;
+      }
+
+      /**
+       * Resets the pinned widget sender state (useful for re-initialization testing).
+       */
+      function resetWidgetPin() {
+        pinnedWidgetSource = null;
+        pinnedWidgetMetadata = null;
+      }
+
+      function getPinnedWidgetSource() {
+        return pinnedWidgetSource;
+      }
+
+      // Register cross-window message listener
+      window.addEventListener('message', handleIncomingMessage);
+
+      // Guard clicks on all links dynamically (in case links are modified or clicked)
+      document.addEventListener('click', function (event) {
+        const anchor = event.target && typeof event.target.closest === 'function'
+          ? event.target.closest('a')
+          : null;
+        if (!anchor) return;
+
+        const rawHref = anchor.getAttribute('href');
+        const linkCheck = validateExternalLink(rawHref);
+        if (!linkCheck.valid) {
+          event.preventDefault();
+          appendAuditLog('LINK', 'REJECTED', 'Prevented navigation to invalid URL: ' + String(rawHref));
+          return;
+        }
+
+        // If clicking the logout link, validate its redirect parameter before navigation
+        if (anchor.classList.contains('logout-link') || anchor.id === 'logout-link') {
+          const parsedHref = parseHttpUrl(rawHref);
+          if (parsedHref && parsedHref.searchParams.has('redirect')) {
+            const candidate = parsedHref.searchParams.get('redirect');
+            const redirectResult = inspectRedirectUrl(candidate);
+            updateRedirectBanner(redirectResult);
+            if (!redirectResult.valid) {
+              event.preventDefault();
+              parsedHref.searchParams.set('redirect', SAFE_DEFAULT_REDIRECT);
+              anchor.setAttribute('href', parsedHref.pathname + parsedHref.search);
+              appendAuditLog('REDIRECT', 'REJECTED', 'Blocked unsafe logout redirect: ' + candidate);
+            }
+          }
+        }
+      });
+
+      // Interactive UI controls for demonstrating & testing validation
+      const simTrustedBtn = document.getElementById('simulate-trusted-order-btn');
+      if (simTrustedBtn) {
+        simTrustedBtn.addEventListener('click', function () {
+          const evt = new MessageEvent('message', {
+            origin: TRUSTED_ORDER_ORIGIN,
+            data: {
+              type: 'ORDER_STATUS',
+              orderId: 'DG-2084',
+              item: 'Maple Oat Latte (Large)',
+              status: 'Ready for Pickup at Counter'
+            }
+          });
+          window.dispatchEvent(evt);
+        });
+      }
+
+      const simUntrustedBtn = document.getElementById('simulate-untrusted-order-btn');
+      if (simUntrustedBtn) {
+        simUntrustedBtn.addEventListener('click', function () {
+          const evt = new MessageEvent('message', {
+            origin: 'https://orders.dailygrind.com.evil.example',
+            data: {
+              type: 'ORDER_STATUS',
+              orderId: 'FAKE-999',
+              item: 'Phishing Voucher',
+              status: 'Click to claim'
+            }
+          });
+          window.dispatchEvent(evt);
+        });
+      }
+
+      const validateRedirectBtn = document.getElementById('validate-redirect-btn');
+      if (validateRedirectBtn && redirectInputEl) {
+        validateRedirectBtn.addEventListener('click', function () {
+          const candidate = redirectInputEl.value;
+          const result = inspectRedirectUrl(candidate);
+          updateRedirectBanner(result);
+          appendAuditLog(
+            'REDIRECT',
+            result.valid ? 'ACCEPTED' : 'REJECTED',
+            'Validated redirect "' + candidate + '" -> ' + result.safeUrl
+          );
+        });
+      }
+
+      document.querySelectorAll('[data-test-redirect]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const candidate = btn.getAttribute('data-test-redirect');
+          if (redirectInputEl) {
+            redirectInputEl.value = candidate;
+          }
+          const result = inspectRedirectUrl(candidate);
+          updateRedirectBanner(result);
+          appendAuditLog(
+            'REDIRECT',
+            result.valid ? 'ACCEPTED' : 'REJECTED',
+            'Validated redirect "' + candidate + '" -> ' + result.safeUrl
+          );
+        });
+      });
+
+      // Run initial link validation & redirect query inspection
+      validateAndHardenLinks(document);
+      if (!validateInitialPageRedirectParam() && redirectInputEl) {
+        const defaultCheck = inspectRedirectUrl(redirectInputEl.value);
+        updateRedirectBanner(defaultCheck);
+      }
+
+      // Expose security validation API on window for programmatic verification
+      const securityApi = {
+        SITE_DOMAIN: SITE_DOMAIN,
+        TRUSTED_ORDER_ORIGIN: TRUSTED_ORDER_ORIGIN,
+        SAFE_DEFAULT_REDIRECT: SAFE_DEFAULT_REDIRECT,
+        parseHttpUrl: parseHttpUrl,
+        isHostnameInSite: isHostnameInSite,
+        isSameOriginUrl: isSameOriginUrl,
+        isSameSiteUrl: isSameSiteUrl,
+        inspectRedirectUrl: inspectRedirectUrl,
+        validateRedirectUrl: validateRedirectUrl,
+        validateExternalLink: validateExternalLink,
+        validateAndHardenLinks: validateAndHardenLinks,
+        isTrustedOrderOrigin: isTrustedOrderOrigin,
+        handleIncomingMessage: handleIncomingMessage,
+        handleOrderingMessage: handleOrderingMessage,
+        handleSandboxedWidgetMessage: handleSandboxedWidgetMessage,
+        getPinnedWidgetSource: getPinnedWidgetSource,
+        resetWidgetPin: resetWidgetPin,
+        trustedWidgetIframe: trustedWidgetIframe,
+        untrustedSandboxIframe: untrustedSandboxIframe
+      };
+
+      window.DailyGrindSecurity = securityApi;
+      window.isTrustedOrderOrigin = isTrustedOrderOrigin;
+      window.isSameOriginUrl = isSameOriginUrl;
+      window.isSameSiteUrl = isSameSiteUrl;
+      window.validateRedirectUrl = validateRedirectUrl;
+      window.validateExternalLink = validateExternalLink;
+    })();
+  </script>
+
