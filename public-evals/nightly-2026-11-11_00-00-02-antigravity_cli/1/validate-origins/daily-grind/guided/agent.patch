+    // 1. Exact origin validation for privileged cross-window ordering messages
+    export function isTrustedOrderingOrigin(candidate) {
+      try {
+        if ('Origin' in globalThis) {
+          const trustedOrderingOrigin = Origin.from(TRUSTED_ORDERING_URL);
+          return extractOrigin(candidate).isSameOrigin(trustedOrderingOrigin);
