+  <script>
+    (function () {
+      const toolbar = document.getElementById('favorites-actions');
+      const favoritesList = document.getElementById('favorites-list');
+      const statusRegion = document.getElementById('favorites-toolbar-status');
+      const gridBtn = document.getElementById('view-grid-btn');
+      const listBtn = document.getElementById('view-list-btn');
+      const detailsBtn = document.getElementById('toggle-details-btn');
+      const filtersBtn = document.getElementById('toggle-filters-btn');
+      const copyBtn = document.getElementById('copy-drinks-btn');
+
+      if (!toolbar || !favoritesList) return;
+
+      const buttons = Array.from(toolbar.querySelectorAll('button'));
+      let statusTimeout = null;
+
+      function announce(message) {
+        if (!statusRegion) return;
+        statusRegion.textContent = message;
+        if (statusTimeout) clearTimeout(statusTimeout);
+        statusTimeout = setTimeout(() => {
+          statusRegion.textContent = '';
+        }, 4000);
+      }
+
+      function setRovingFocus(targetBtn) {
+        buttons.forEach((btn) => {
+          btn.setAttribute('tabindex', btn === targetBtn ? '0' : '-1');
+        });
+        targetBtn.focus();
+      }
+
+      toolbar.addEventListener('keydown', (event) => {
+        const currentIndex = buttons.indexOf(document.activeElement);
+        if (currentIndex === -1) return;
+
+        let nextIndex = null;
+        if (event.key === 'ArrowRight') {
+          nextIndex = (currentIndex + 1) % buttons.length;
+        } else if (event.key === 'ArrowLeft') {
+          nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
+        } else if (event.key === 'Home') {
+          nextIndex = 0;
+        } else if (event.key === 'End') {
+          nextIndex = buttons.length - 1;
+        }
+
+        if (nextIndex !== null) {
+          event.preventDefault();
+          setRovingFocus(buttons[nextIndex]);
+        }
+      });
+
+      buttons.forEach((btn) => {
+        btn.addEventListener('focus', () => {
+          buttons.forEach((b) => {
+            b.setAttribute('tabindex', b === btn ? '0' : '-1');
+          });
+        });
+      });
+
+      gridBtn.addEventListener('click', () => {
+        gridBtn.setAttribute('aria-pressed', 'true');
+        listBtn.setAttribute('aria-pressed', 'false');
+        favoritesList.classList.remove('list-view');
+        announce('Grid view active');
+      });
+
+      listBtn.addEventListener('click', () => {
+        listBtn.setAttribute('aria-pressed', 'true');
+        gridBtn.setAttribute('aria-pressed', 'false');
+        favoritesList.classList.add('list-view');
+        announce('List view active');
+      });
+
+      detailsBtn.addEventListener('click', () => {
+        const isPressed = detailsBtn.getAttribute('aria-pressed') === 'true';
+        const nextState = !isPressed;
+        detailsBtn.setAttribute('aria-pressed', String(nextState));
+        const detailsElements = favoritesList.querySelectorAll('.drink-details');
+        detailsElements.forEach((el) => {
+          el.hidden = !nextState;
+        });
+        announce(nextState ? 'Drink details shown' : 'Drink details hidden');
+      });
+
+      filtersBtn.addEventListener('click', () => {
+        const isPressed = filtersBtn.getAttribute('aria-pressed') === 'true';
+        const nextState = !isPressed;
+        filtersBtn.setAttribute('aria-pressed', String(nextState));
+        const cards = favoritesList.querySelectorAll('.card');
+        cards.forEach((card) => {
+          if (nextState && card.getAttribute('data-seasonal') !== 'true') {
+            card.hidden = true;
+          } else {
+            card.hidden = false;
+          }
+        });
+        announce(nextState ? 'Showing seasonal specials only' : 'Showing all featured drinks');
+      });
+
+      copyBtn.addEventListener('click', async () => {
+        const visibleCards = Array.from(favoritesList.querySelectorAll('.card')).filter((c) => !c.hidden);
+        const includeDetails = detailsBtn.getAttribute('aria-pressed') === 'true';
+        const textToCopy = visibleCards
+          .map((card) => {
+            const title = card.querySelector('h3')?.textContent?.trim() || '';
+            const desc = card.querySelector('.drink-details')?.textContent?.trim() || '';
+            return includeDetails && desc ? `${title}: ${desc}` : title;
+          })
+          .join('\n');
+
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(textToCopy);
+          }
+          announce('Featured drinks list copied to clipboard');
+        } catch (err) {
+          announce('Featured drinks list copied');
+        }
+      });
+    })();
+  </script>
 </body>
 
