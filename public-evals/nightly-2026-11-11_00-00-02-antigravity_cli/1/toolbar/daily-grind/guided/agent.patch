+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const drinksContainer = document.getElementById('featured-drinks');
+      if (!bar || !drinksContainer) return;
+
+      const items = Array.from(bar.querySelectorAll('button'));
+
+      // 1. Upgrade title tooltips only when interest invokers and anchor positioning both work
+      if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+        bar.querySelectorAll('button[title]').forEach((b, i) => {
+          const tip = Object.assign(document.createElement('div'), {
+            id: `tip-${i}`,
+            textContent: b.title,
+          });
+          tip.popover = 'hint';
+          b.setAttribute('interestfor', tip.id);
+          b.removeAttribute('title');
+          document.body.append(tip);
+        });
+      }
+
+      // 2. Fallback roving-tabindex for focusgroup
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) {
+            items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+          }
+        });
+        bar.addEventListener('keydown', (event) => {
+          const idx = items.indexOf(event.target);
+          if (idx === -1) return;
+          const vertical = bar.getAttribute('aria-orientation') === 'vertical';
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = vertical
+            ? { ArrowDown: 1, ArrowUp: -1 }
+            : { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          let nextIdx = -1;
+          if (event.key in steps) {
+            nextIdx = (idx + steps[event.key] + items.length) % items.length;
+          } else if (event.key === 'Home') {
+            nextIdx = 0;
+          } else if (event.key === 'End') {
+            nextIdx = items.length - 1;
+          }
+          if (nextIdx !== -1) {
+            event.preventDefault();
+            items[nextIdx].focus();
+          }
+        });
+      }
+
+      // 3. Toolbar view & toggle controls
+      bar.addEventListener('click', (event) => {
+        const button = event.target.closest('button');
+        if (!button || button.getAttribute('aria-disabled') === 'true') return;
+
+        const action = button.dataset.action;
+        if (action === 'view') {
+          const view = button.dataset.view;
+          bar.querySelectorAll('button[data-action="view"]').forEach((btn) => {
+            btn.setAttribute('aria-pressed', String(btn === button));
+          });
+          drinksContainer.classList.toggle('list-view', view === 'list');
+        } else if (action === 'toggle-details') {
+          const nextPressed = button.getAttribute('aria-pressed') !== 'true';
+          button.setAttribute('aria-pressed', String(nextPressed));
+          drinksContainer.classList.toggle('hide-details', !nextPressed);
+        } else if (action === 'toggle-filter') {
+          const nextPressed = button.getAttribute('aria-pressed') !== 'true';
+          button.setAttribute('aria-pressed', String(nextPressed));
+          const filterCategory = button.dataset.filter;
+          drinksContainer.querySelectorAll('.card').forEach((card) => {
+            card.hidden = nextPressed && card.dataset.category !== filterCategory;
+          });
+        }
+      });
+
+      // 4. Copy featured drinks list (Invoker Commands + Async Clipboard + Feedback)
+      const timers = new WeakMap();
+      let lastMessage = '';
+
+      function legacyCopy(text) {
+        const field = Object.assign(document.createElement('textarea'), { value: text });
+        field.setAttribute('readonly', '');
+        field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
+        document.body.append(field);
+        field.select();
+        try {
+          return document.execCommand('copy');
+        } finally {
+          field.remove();
+        }
+      }
+
+      function report(button, ok) {
+        const tip = document.getElementById('favorites-status');
+        clearTimeout(timers.get(button));
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.removeAttribute('data-visible');
+        let message = ok ? 'Copied' : 'Copy failed';
+        if (message === lastMessage) message += '\u00A0';
+        lastMessage = message;
+        tip.textContent = '';
+        void button.offsetWidth;
+        button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        tip.setAttribute('data-visible', '');
+        requestAnimationFrame(() => (tip.textContent = message));
+        timers.set(
+          button,
+          setTimeout(() => {
+            button.removeAttribute('data-copied');
+            button.removeAttribute('data-failed');
+            tip.removeAttribute('data-visible');
+            tip.textContent = '';
+          }, 2000)
+        );
+      }
+
+      async function copy(button, target, command = '--copy') {
+        const visibleCards = Array.from(target.querySelectorAll('.card:not([hidden])'));
+        const text =
+          visibleCards.length > 0
+            ? visibleCards
+                .map((card) => {
+                  const title = card.querySelector('h3')?.innerText.trim() || '';
+                  const desc = card.querySelector('p')?.innerText.trim() || '';
+                  return desc && !target.classList.contains('hide-details') ? `${title} - ${desc}` : title;
+                })
+                .join('\n')
+            : target.matches('input, textarea')
+              ? target.value
+              : target.innerText.trim();
+        if (!text) return;
+        try {
+          await navigator.clipboard.writeText(text);
+          report(button, true);
+        } catch {
+          try {
+            if (!legacyCopy(text)) throw new Error('Copy failed');
+            report(button, true);
+          } catch {
+            report(button, false);
+          }
+        }
+      }
+
+      if ('CommandEvent' in window) {
+        document.addEventListener(
+          'command',
+          (event) => {
+            if (event.command.startsWith('--copy')) copy(event.source, event.target, event.command);
+          },
+          true
+        );
+      } else {
+        document.addEventListener('click', (event) => {
+          const button = event.target.closest('button[command^="--copy"]');
+          if (!button) return;
+          const target = document.getElementById(button.getAttribute('commandfor'));
+          if (target) copy(button, target, button.getAttribute('command'));
+        });
+      }
+    })();
+  </script>
 </body>
 
