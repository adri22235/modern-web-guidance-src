+  <script>
+    (function () {
+      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
+      const primaryNavList = document.getElementById('primary-nav-list');
+      const menuNavItem = document.getElementById('menu-nav-item');
+      const submenuToggle = document.getElementById('menu-submenu-toggle');
+      const allNavLinks = Array.from(primaryNavList.querySelectorAll('a.nav-link, a.submenu-link'));
+
+      function setMobileMenuOpen(isOpen) {
+        mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
+        primaryNavList.classList.toggle('is-open', isOpen);
+        if (!isOpen) {
+          setSubmenuOpen(false);
+        }
+      }
+
+      function setSubmenuOpen(isOpen) {
+        submenuToggle.setAttribute('aria-expanded', String(isOpen));
+        menuNavItem.classList.toggle('submenu-open', isOpen);
+      }
+
+      mobileMenuToggle.addEventListener('click', function () {
+        const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
+        setMobileMenuOpen(!isExpanded);
+      });
+
+      submenuToggle.addEventListener('click', function (event) {
+        event.stopPropagation();
+        const isExpanded = submenuToggle.getAttribute('aria-expanded') === 'true';
+        setSubmenuOpen(!isExpanded);
+      });
+
+      // Close submenu or mobile menu when clicking outside
+      document.addEventListener('click', function (event) {
+        if (!menuNavItem.contains(event.target)) {
+          setSubmenuOpen(false);
+        }
+        const navElement = mobileMenuToggle.closest('nav');
+        if (navElement && !navElement.contains(event.target)) {
+          setMobileMenuOpen(false);
+        }
+      });
+
+      // Close menus on Escape key
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape') {
+          if (submenuToggle.getAttribute('aria-expanded') === 'true') {
+            setSubmenuOpen(false);
+            submenuToggle.focus();
+          } else if (mobileMenuToggle.getAttribute('aria-expanded') === 'true') {
+            setMobileMenuOpen(false);
+            mobileMenuToggle.focus();
+          }
+        }
+      });
+
+      // Active page state management
+      function setActiveLink(targetLink) {
+        if (!targetLink) return;
+
+        allNavLinks.forEach(function (link) {
+          link.classList.remove('active');
+          link.removeAttribute('aria-current');
+        });
+        menuNavItem.classList.remove('active');
+
+        targetLink.classList.add('active');
+        targetLink.setAttribute('aria-current', 'page');
+
+        if (targetLink.classList.contains('submenu-link') || targetLink.getAttribute('href') === '/menu') {
+          menuNavItem.classList.add('active');
+        }
+      }
+
+      // Sync active link with current URL path or hash on load
+      function syncActiveFromLocation() {
+        const currentPath = window.location.pathname;
+        const currentHash = window.location.hash.replace(/^#/, '');
+        const matchTarget = currentHash || (currentPath !== '/' && currentPath !== '/index.html' ? currentPath : '/menu');
+
+        const matchedLink = allNavLinks.find(function (link) {
+          return link.getAttribute('href') === matchTarget;
+        });
+
+        if (matchedLink) {
+          setActiveLink(matchedLink);
+        }
+      }
+
+      syncActiveFromLocation();
+      window.addEventListener('popstate', syncActiveFromLocation);
+      window.addEventListener('hashchange', syncActiveFromLocation);
+
+      // Update active indicator when clicking navigation links in single-page context
+      allNavLinks.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          // If clicking "Menu" on narrow viewports when submenu is closed, toggle submenu and mark active
+          const isMobile = window.matchMedia('(max-width: 768px)').matches;
+          if (isMobile && link.getAttribute('href') === '/menu' && submenuToggle.getAttribute('aria-expanded') !== 'true') {
+            event.preventDefault();
+            setSubmenuOpen(true);
+            setActiveLink(link);
+            return;
+          }
+
+          event.preventDefault();
+          const href = link.getAttribute('href');
+          if (window.history && window.history.pushState) {
+            window.history.pushState(null, '', href);
+          }
+          setActiveLink(link);
+
+          if (link.classList.contains('submenu-link')) {
+            setSubmenuOpen(false);
+          }
+          if (isMobile) {
+            setMobileMenuOpen(false);
+          }
+        });
+      });
+    })();
+  </script>
+
 </body>
 
