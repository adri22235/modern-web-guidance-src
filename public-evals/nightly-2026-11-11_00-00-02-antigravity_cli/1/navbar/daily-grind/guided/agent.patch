+    function isPopoverOpen(el) {
+      return el.matches(":is(:popover-open, .\\:popover-open)");
+    }
+
+    function syncLayout() {
+      const wasMenuOpen = !header.classList.contains("is-wide") && isPopoverOpen(siteMenu);
+
+      header.classList.add("is-measuring", "is-wide");
+      const wide = inner.scrollWidth <= inner.clientWidth;
+      header.classList.toggle("is-wide", wide);
+      lastHeaderWidth = header.clientWidth;
