+  <script>
+    (function () {
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => document.querySelector(link.getAttribute('href')))
+        .filter(Boolean);
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveOnScroll() {
+        const nav = document.querySelector('nav');
+        const navHeight = nav ? nav.offsetHeight : 64;
+        const triggerLine = navHeight + Math.min(140, window.innerHeight * 0.25);
+
+        // If scrolled to the very bottom of the page, highlight the last section
+        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 10) {
+          if (sections.length > 0) {
+            setActiveSection(sections[sections.length - 1].id);
+            return;
+          }
+        }
+
+        let currentId = '';
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerLine && rect.bottom > navHeight) {
+            currentId = section.id;
+          }
+        }
+
+        // Fallback if a section is the closest one currently in view
+        if (!currentId) {
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            if (rect.top < window.innerHeight * 0.5 && rect.bottom > triggerLine) {
+              currentId = section.id;
+              break;
+            }
+          }
+        }
+
+        setActiveSection(currentId);
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveOnScroll();
+          },
+          {
+            root: null,
+            rootMargin: '-15% 0px -45% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      window.addEventListener('scroll', updateActiveOnScroll, { passive: true });
+      window.addEventListener('resize', updateActiveOnScroll, { passive: true });
+      window.addEventListener('hashchange', () => {
+        const hashId = window.location.hash.replace(/^#/, '');
+        if (hashId && sections.some((s) => s.id === hashId)) {
+          setActiveSection(hashId);
+        } else {
+          updateActiveOnScroll();
+        }
+      });
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').replace(/^#/, '');
+          setActiveSection(targetId);
+        });
+      });
+
+      updateActiveOnScroll();
+    })();
+  </script>
+
 </body>
 
