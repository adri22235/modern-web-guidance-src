+  <script>
+    document.querySelectorAll('.customizations').forEach((fieldset) => {
+      const countBadge = fieldset.querySelector('.customizations-count');
+      const inputs = fieldset.querySelectorAll('.customization-input');
+
+      const updateCardState = () => {
+        let checkedCount = 0;
+        inputs.forEach((input) => {
+          const label = input.closest('.customization-option');
+          if (label) {
+            label.classList.toggle('is-checked', input.checked);
+          }
+          if (input.checked) {
+            checkedCount += 1;
+          }
+        });
+        if (countBadge) {
+          countBadge.textContent = `${checkedCount} selected`;
+          countBadge.classList.toggle('has-selections', checkedCount > 0);
+        }
+      };
+
+      inputs.forEach((input) => {
+        input.addEventListener('change', updateCardState);
+      });
+      updateCardState();
+    });
+  </script>
