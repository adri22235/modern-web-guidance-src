+
+function resolveSectionFromLocation(fallback: SectionId): SectionId {
+  if (typeof window === 'undefined') {
+    return fallback;
+  }
+
+  const params = new URLSearchParams(window.location.search);
+  const querySection = params.get('section')?.toLowerCase();
+  if (
+    querySection === 'top-news' ||
+    querySection === 'world' ||
+    querySection === 'politics' ||
+    querySection === 'multimedia' ||
+    querySection === 'reports'
+  ) {
+    return querySection;
+  }
+
+  const hashSection = window.location.hash.replace(/^#/, '').toLowerCase();
+  if (
+    hashSection === 'top-news' ||
+    hashSection === 'world' ||
+    hashSection === 'politics' ||
+    hashSection === 'multimedia' ||
+    hashSection === 'reports'
+  ) {
+    return hashSection;
+  }
+
+  const pathname = window.location.pathname.replace(/\/+$/, '');
+  if (pathname.endsWith('/multimedia')) {
+    return 'multimedia';
+  }
+  if (pathname.endsWith('/reports')) {
+    return 'reports';
+  }
+
+  return fallback;
+}
+
+function buildSectionUrl(baseUrl: string, sectionId: SectionId): string {
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+  if (sectionId === 'top-news') {
+    return normalizedBase;
+  }
+  if (sectionId === 'multimedia') {
+    return `${normalizedBase}multimedia`;
+  }
+  if (sectionId === 'reports') {
+    return `${normalizedBase}reports`;
+  }
+  return `${normalizedBase}?section=${sectionId}`;
+}
