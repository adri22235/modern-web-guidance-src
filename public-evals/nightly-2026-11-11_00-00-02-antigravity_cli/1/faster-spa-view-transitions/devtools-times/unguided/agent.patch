+                        {article.title}
+                      </h3>
+                    </a>
+                    <span className="text-xs text-gray-500">{article.dateFormatted}</span>
+                  </div>
+                ))}
+              </div>
+            </div>
+          </div>
+
+          {/* Lead Story */}
+          <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+            <LargeArticleTeaser article={topArticle} baseUrl={baseUrl} />
+          </div>
+
+          <div className="divide-y divide-gray-200 max-w-6xl mx-auto">
+            <section className="p-4 md:p-6 text-center">
+              <AdSlotBanner />
+            </section>
+
+            {/* "Top News" section with the new grid variant */}
+            <TopStoryTeaserGridView
+              title="Top News"
+              articles={topNewsArticles}
+              baseUrl={baseUrl}
+            />
+          </div>
+        </div>
+      </Activity>
+
+      {/* World View (preserved offscreen with React Activity) */}
+      <Activity mode={activeSection === 'world' ? 'visible' : 'hidden'} name="World">
+        <div
+          id="section-view-world"
+          data-section-view="world"
+          data-active={activeSection === 'world' ? 'true' : 'false'}
+          className="section-view divide-y divide-gray-200 max-w-6xl mx-auto"
+        >
+          <SimpleTeaserGridView title="World" articles={worldNewsArticles} baseUrl={baseUrl} />
+
+          <section className="p-4 md:p-6 text-center">
+            <AdSlotBanner />
+          </section>
+        </div>
+      </Activity>
+
+      {/* Politics View (preserved offscreen with React Activity) */}
+      <Activity mode={activeSection === 'politics' ? 'visible' : 'hidden'} name="Politics">
+        <div
+          id="section-view-politics"
+          data-section-view="politics"
+          data-active={activeSection === 'politics' ? 'true' : 'false'}
+          className="section-view divide-y divide-gray-200 max-w-6xl mx-auto"
+        >
+          {/* "Politics" section with the new grid variant */}
+          <TopStoryTeaserGridView
+            title="Politics"
+            articles={politicsArticles}
+            baseUrl={baseUrl}
+          />
+
+          <section className="p-4 md:p-6 text-center">
+            <AdSlotBanner />
+          </section>
+        </div>
+      </Activity>
+
+      {/* Multimedia View (preserved offscreen with React Activity) */}
+      <Activity mode={activeSection === 'multimedia' ? 'visible' : 'hidden'} name="Multimedia">
+        <div
+          id="section-view-multimedia"
+          data-section-view="multimedia"
+          data-active={activeSection === 'multimedia' ? 'true' : 'false'}
+          className="section-view max-w-6xl mx-auto"
+        >
+          <MultimediaSectionView items={multimediaItems} baseUrl={baseUrl} />
+        </div>
+      </Activity>
+
+      {/* Reports View (preserved offscreen with React Activity) */}
+      <Activity mode={activeSection === 'reports' ? 'visible' : 'hidden'} name="Reports">
+        <div
+          id="section-view-reports"
+          data-section-view="reports"
+          data-active={activeSection === 'reports' ? 'true' : 'false'}
+          className="section-view max-w-6xl mx-auto"
+        >
+          <ReportsSectionView items={reportItems} baseUrl={baseUrl} />
+        </div>
+      </Activity>
+    </div>
+  );
+};
+
+export default MainSectionSpa;
