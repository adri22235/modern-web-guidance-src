+++ b/src/utils/sectionsData.ts
@@ -0,0 +1,170 @@
+import { getCollection, type CollectionEntry, type RenderResult } from 'astro:content';
+import { getImage } from 'astro:assets';
+import { getArticleImage } from './images';
+
+export interface SerializedArticle {
+  id: string;
+  title: string;
+  summary: string;
+  author: string;
+  dateFormatted: string;
+  category: string;
+  capitalizedCategory: string;
+  readingTime?: number;
+  imageSrc: string;
+  imageWidth: number;
+  imageHeight: number;
+  isBookmarked: boolean;
+}
+
+export interface SerializedCollectionItem {
+  id: string;
+  slug: string;
+  title: string;
+  description: string;
+  publishDate: string;
+  category: string;
+}
+
+export interface SectionsPageData {
+  baseUrl: string;
+  topStories: {
+    id: string;
+    title: string;
+    dateFormatted: string;
+  }[];
+  topArticle: SerializedArticle;
+  topNewsArticles: SerializedArticle[];
+  worldNewsArticles: SerializedArticle[];
+  politicsArticles: SerializedArticle[];
+  multimediaItems: SerializedCollectionItem[];
+  reportItems: SerializedCollectionItem[];
+}
+
+async function serializeArticle(
+  article: CollectionEntry<'articles'>,
+  width: number,
+  height: number,
+  readingList: string[],
+  includeOptimizedImage = true
+): Promise<SerializedArticle> {
+  let imageSrc = article.data.image;
+
+  if (includeOptimizedImage) {
+    const rawImage = await getArticleImage(article);
+    const optimized = await getImage({
+      src: rawImage as any,
+      width,
+      height,
+      format: 'webp',
+    });
+    imageSrc = optimized.src;
+  }
+
+  const category = article.data.category;
+  const capitalizedCategory = category.charAt(0).toUpperCase() + category.slice(1);
+
+  return {
+    id: article.id,
+    title: article.data.title,
+    summary: article.data.summary,
+    author: article.data.author,
+    dateFormatted: article.data.date.toLocaleDateString(),
+    category,
+    capitalizedCategory,
+    readingTime: article.data.readingTime,
+    imageSrc,
+    imageWidth: width,
+    imageHeight: height,
+    isBookmarked: readingList.includes(article.id),
+  };
+}
+
+export async function getSectionsPageData(readingList: string[] = []): Promise<SectionsPageData> {
+  const articles = await getCollection('articles');
+  articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+  // Slicing articles for different sections
+  const topArticleEntry = articles[0];
+  const topStoriesEntries = articles.slice(1, 4);
+  const topNewsEntries = articles.slice(4, 8);      // 4 articles for the new grid
+  const worldNewsEntries = articles.slice(8, 11);   // 3 articles for the old grid
+  const politicsEntries = articles.slice(11, 15);   // 4 articles for the new grid
+
+  // Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+  politicsEntries[2] = {
+    id: 'public-transit-overhaul',
+    data: {
+      title: "What's new in DevTools",
+      summary:
+        'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+      author: 'Chrome DevTools Team',
+      date: new Date('2025-09-16T00:00:00.000Z'),
+      category: 'Web Development',
+      image:
+        'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+      image_caption: '',
+      readingTime: 3,
+    },
+    body: '',
+    collection: 'articles',
+    slug: 'public-transit-overhaul',
+    render: async () => '' as unknown as RenderResult,
+  } as unknown as CollectionEntry<'articles'>;
+
+  const topArticle = await serializeArticle(topArticleEntry, 800, 533, readingList, true);
+
+  const topNewsArticles = await Promise.all(
+    topNewsEntries.map((article, idx) =>
+      serializeArticle(article, 320, 180, readingList, idx === 0 || idx === 2)
+    )
+  );
+
+  const worldNewsArticles = await Promise.all(
+    worldNewsEntries.map((article) =>
+      serializeArticle(article, 400, 225, readingList, true)
+    )
+  );
+
+  const politicsArticles = await Promise.all(
+    politicsEntries.map((article, idx) =>
+      serializeArticle(article, 320, 180, readingList, idx === 0 || idx === 2)
+    )
+  );
+
+  const multimedia = await getCollection('multimedia');
+  const reports = await getCollection('reports');
+
+  const multimediaItems: SerializedCollectionItem[] = multimedia.map((item) => ({
+    id: item.id,
+    slug: (item as any).slug || item.id,
+    title: item.data.title,
+    description: item.data.description,
+    publishDate: item.data.publishDate,
+    category: item.data.category,
+  }));
+
+  const reportItems: SerializedCollectionItem[] = reports.map((report) => ({
+    id: report.id,
+    slug: (report as any).slug || report.id,
+    title: report.data.title,
+    description: report.data.description,
+    publishDate: report.data.publishDate,
+    category: report.data.category,
+  }));
+
+  return {
+    baseUrl: import.meta.env.BASE_URL,
+    topStories: topStoriesEntries.map((article) => ({
+      id: article.id,
+      title: article.data.title,
+      dateFormatted: article.data.date.toLocaleDateString(),
+    })),
+    topArticle,
+    topNewsArticles,
+    worldNewsArticles,
+    politicsArticles,
+    multimediaItems,
+    reportItems,
+  };
+}
