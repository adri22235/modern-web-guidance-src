+            {MAIN_SECTIONS.map((section) => {
+              const isActive = activeSection === section.id;
+              return (
+                <button
+                  key={section.id}
+                  id={`section-tab-${section.id}`}
+                  type="button"
+                  aria-current={isActive ? 'page' : undefined}
+                  aria-controls={`section-view-${section.id}`}
