+
+const MainSectionSpa: React.FC<MainSectionSpaProps> = ({
+  baseUrl,
+  topStories,
+  topArticle,
+  topNewsArticles,
+  worldNewsArticles,
+  politicsArticles,
+  multimediaItems,
+  reportItems,
+  initialSection = 'top-news',
+}) => {
+  const [activeSection, setActiveSection] = useState<SectionId>(initialSection);
+
+  const navigateToSection = (sectionId: SectionId, updateHistory = true) => {
+    startTransition(() => {
+      setActiveSection(sectionId);
+    });
+
+    if (typeof window !== 'undefined') {
+      const sectionMeta = MAIN_SECTIONS.find((s) => s.id === sectionId);
+      if (sectionMeta) {
+        document.title =
+          sectionId === 'top-news'
+            ? 'The DevTools Times'
+            : `${sectionMeta.label} | The DevTools Times`;
+      }
+
+      if (updateHistory) {
+        const nextUrl = buildSectionUrl(baseUrl, sectionId);
+        if (window.location.pathname + window.location.search !== nextUrl) {
+          window.history.pushState(null, '', nextUrl);
+        }
+      }
+    }
+  };
+
+  useEffect(() => {
+    const resolved = resolveSectionFromLocation(initialSection);
+    if (resolved !== activeSection) {
+      startTransition(() => {
+        setActiveSection(resolved);
+      });
+    }
+
+    // Ensure history state is null so Astro's ClientRouter does not trigger full-page swaps on popstate
+    window.history.replaceState(null, '', window.location.href);
+
+    const handlePopState = () => {
+      const nextSection = resolveSectionFromLocation('top-news');
+      startTransition(() => {
+        setActiveSection(nextSection);
+      });
+    };
+
+    const handleCustomNavigate = (event: Event) => {
+      const customEvent = event as CustomEvent<{ section?: SectionId }>;
+      const targetSection = customEvent.detail?.section;
+      if (targetSection) {
+        navigateToSection(targetSection, true);
+      }
+    };
+
+    (window as any).__devtoolsTimesNavigate = (sectionId: SectionId) => {
+      navigateToSection(sectionId, true);
+    };
+
+    window.addEventListener('popstate', handlePopState);
+    window.addEventListener('devtools-times:navigate', handleCustomNavigate);
+
+    return () => {
+      delete (window as any).__devtoolsTimesNavigate;
+      window.removeEventListener('popstate', handlePopState);
+      window.removeEventListener('devtools-times:navigate', handleCustomNavigate);
+    };
+  }, []);
+
+  return (
+    <div>
+      {/* Main Section SPA Navigation Bar */}
+      <nav
+        aria-label="Main sections"
+        data-section-nav="true"
+        className="bg-gray-50 border-b border-gray-300 sticky top-0 z-20"
+      >
+        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
