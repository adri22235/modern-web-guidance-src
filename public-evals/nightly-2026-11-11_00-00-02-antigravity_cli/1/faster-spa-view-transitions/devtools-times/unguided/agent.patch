+                  data-active={isActive ? 'true' : 'false'}
+                  onClick={() => navigateToSection(section.id)}
+                  className={`px-3.5 py-1.5 rounded-md whitespace-nowrap transition-colors cursor-pointer ${
+                    isActive
+                      ? 'bg-gray-900 text-amber-400 font-bold shadow-xs'
+                      : 'text-gray-700 hover:text-gray-900 hover:bg-gray-200'
+                  }`}
+                >
+                  {section.label}
+                </button>
+              );
+            })}
+          </div>
+        </div>
+      </nav>
+
+      {/* Top News View (preserved offscreen with React Activity) */}
+      <Activity mode={activeSection === 'top-news' ? 'visible' : 'hidden'} name="Top News">
+        <div
+          id="section-view-top-news"
+          data-section-view="top-news"
+          data-active={activeSection === 'top-news' ? 'true' : 'false'}
+          className="section-view"
+        >
+          {/* Top Stories Bar */}
