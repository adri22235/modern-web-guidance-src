+
+    <script>
+        function switchToView(viewId: string, options: { updateHistory?: boolean; moveFocus?: boolean } = {}) {
+            const { updateHistory = true, moveFocus = true } = options;
+            const activeView = document.getElementById(viewId);
+            if (!activeView || !activeView.classList.contains('spa-view')) {
+                return;
+            }
+
+            // Hide all views while preserving their rendered DOM state in memory
+            document.querySelectorAll<HTMLElement>('.spa-view').forEach((view) => {
+                view.classList.add('inactive');
+                view.setAttribute('aria-hidden', 'true');
+                view.setAttribute('inert', 'inert');
+            });
+
+            // Show the target view
+            activeView.classList.remove('inactive');
+            activeView.setAttribute('aria-hidden', 'false');
+            activeView.removeAttribute('inert');
+
+            // Update navigation triggers' aria-current state
+            document.querySelectorAll<HTMLElement>('[data-view-target]').forEach((trigger) => {
+                if (trigger.getAttribute('data-view-target') === viewId) {
+                    trigger.setAttribute('aria-current', 'page');
+                } else {
+                    trigger.removeAttribute('aria-current');
+                }
+            });
+
+            if (updateHistory && window.location.hash !== `#${viewId}`) {
+                history.pushState({ viewId }, '', `#${viewId}`);
+            }
+
+            window.dispatchEvent(new CustomEvent('spa-view-change', { detail: { viewId } }));
+
+            // MANDATORY: Move focus to the new view to ensure a logical tab-order
+            if (moveFocus) {
+                activeView.focus({ preventScroll: true });
+            }
+        }
+
+        function initSpaNavigation() {
+            (window as any).switchToView = switchToView;
+
+            document.querySelectorAll<HTMLElement>('[data-view-target]').forEach((trigger) => {
+                trigger.addEventListener('click', (event) => {
+                    const targetView = trigger.getAttribute('data-view-target');
+                    if (targetView && document.getElementById(targetView)) {
+                        event.preventDefault();
+                        switchToView(targetView);
+                    }
+                });
+            });
+
+            const initialHash = window.location.hash.replace(/^#/, '');
+            if (initialHash && document.getElementById(initialHash)) {
+                switchToView(initialHash, { updateHistory: false, moveFocus: false });
+            }
+        }
+
+        window.addEventListener('popstate', () => {
+            const hash = window.location.hash.replace(/^#/, '') || 'top-news';
+            if (document.getElementById(hash)) {
+                switchToView(hash, { updateHistory: false, moveFocus: true });
+            }
+        });
+
+        initSpaNavigation();
+        document.addEventListener('astro:page-load', initSpaNavigation);
+    </script>
+</Layout>
