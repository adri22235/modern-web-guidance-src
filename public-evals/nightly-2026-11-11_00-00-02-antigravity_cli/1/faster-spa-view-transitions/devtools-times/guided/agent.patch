+}
+
+.spa-view {
+  outline: none;
+}
+
+.spa-view.inactive {
+  /* MANDATORY: Use hidden to cache the rendering state of inactive views */
+  content-visibility: hidden;
+
+  /* Prevent hidden views from taking up physical space in layout flow */
+  position: absolute;
+  width: 0;
+  height: 0;
+  padding: 0;
+  margin: 0;
+  border: 0;
+  overflow: hidden;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
+
+.spa-nav-link[aria-current="page"] {
+  color: #111827;
+  border-bottom: 3px solid #b45309;
+  font-weight: 700;
+}
