+        } else {
+          reviewsListEl.appendChild(card);
+        }
+      }
+
+      initialReviews.forEach((review) => renderReviewItem(review, false));
+
+      reviewForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const rawFeedback = feedbackInput.value;
+        if (!rawFeedback || !rawFeedback.trim()) {
