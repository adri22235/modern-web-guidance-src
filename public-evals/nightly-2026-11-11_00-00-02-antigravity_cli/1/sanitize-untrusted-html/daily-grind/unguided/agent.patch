+        'i', 'img', 'ins', 'kbd', 'li', 'mark', 'ol', 'p', 'pre', 'q', 's',
+        'samp', 'small', 'span', 'strong', 'sub', 'sup', 'table', 'tbody',
+        'td', 'tfoot', 'th', 'thead', 'tr', 'u', 'ul', 'var'
+      ]);
+
+      const DROP_WITH_CONTENT_ELEMENTS = new Set([
+        'applet', 'audio', 'base', 'button', 'canvas', 'datalist', 'embed',
+        'fieldset', 'form', 'frame', 'frameset', 'head', 'iframe', 'input',
+        'keygen', 'label', 'link', 'map', 'math', 'meta', 'noembed',
+        'noframes', 'noscript', 'object', 'optgroup', 'option', 'output',
+        'param', 'picture', 'plaintext', 'portal', 'script', 'select',
+        'slot', 'source', 'style', 'svg', 'template', 'textarea', 'title',
+        'track', 'video', 'xmp'
+      ]);
+
+      const GLOBAL_ALLOWED_ATTRS = new Set([
+        'title', 'dir', 'lang', 'class', 'role', 'aria-label'
+      ]);
+
+      const ELEMENT_ALLOWED_ATTRS = {
+        a: new Set(['href', 'target', 'rel']),
+        img: new Set(['src', 'alt', 'width', 'height']),
+        td: new Set(['colspan', 'rowspan']),
+        th: new Set(['colspan', 'rowspan', 'scope']),
+        ol: new Set(['start', 'reversed', 'type']),
+        blockquote: new Set(['cite']),
+        q: new Set(['cite'])
+      };
+
+      function isSafeUrl(urlValue, attrName) {
+        if (typeof urlValue !== 'string') return false;
+        const trimmed = urlValue.replace(/[\u0000-\u0020]+/g, '').trim();
+        if (!trimmed) return false;
+
+        // Disallow protocol-relative URLs
+        if (trimmed.startsWith('//')) return false;
+
+        // Allow internal fragments or relative paths
+        if (trimmed.startsWith('#') || trimmed.startsWith('/') || trimmed.startsWith('./') || trimmed.startsWith('../')) {
+          return true;
+        }
+
+        try {
+          const parsed = new URL(trimmed, window.location.origin);
+          const allowedProtocols = attrName === 'href'
+            ? ['http:', 'https:', 'mailto:']
+            : ['http:', 'https:'];
+          return allowedProtocols.includes(parsed.protocol);
+        } catch {
+          return false;
+        }
+      }
+
+      function sanitizeNode(node, targetDoc) {
+        if (node.nodeType === Node.TEXT_NODE) {
+          return targetDoc.createTextNode(node.textContent || '');
+        }
+
+        if (node.nodeType !== Node.ELEMENT_NODE) {
+          return null;
+        }
+
+        const tagName = node.tagName.toLowerCase();
+
+        // Completely drop dangerous elements along with their subtree
+        if (DROP_WITH_CONTENT_ELEMENTS.has(tagName)) {
+          return null;
+        }
+
+        // If an element is not in our allowlist, unwrap or drop it
+        if (!ALLOWED_ELEMENTS.has(tagName)) {
+          const frag = targetDoc.createDocumentFragment();
+          for (const child of Array.from(node.childNodes)) {
+            const cleanChild = sanitizeNode(child, targetDoc);
+            if (cleanChild) frag.appendChild(cleanChild);
+          }
+          return frag;
+        }
+
+        const cleanEl = targetDoc.createElement(tagName);
+        const allowedForTag = ELEMENT_ALLOWED_ATTRS[tagName];
+
+        for (const attr of Array.from(node.attributes)) {
+          const attrName = attr.name.toLowerCase();
+          const attrVal = attr.value;
+
+          // Always block event handlers (on*) and style/srcdoc/formaction
+          if (
+            attrName.startsWith('on') ||
+            attrName === 'style' ||
+            attrName === 'srcdoc' ||
+            attrName === 'formaction' ||
+            attrName.includes(':')
+          ) {
+            continue;
+          }
+
+          const isAllowed =
+            GLOBAL_ALLOWED_ATTRS.has(attrName) ||
+            (allowedForTag && allowedForTag.has(attrName));
+
+          if (!isAllowed) {
+            continue;
+          }
+
+          if (attrName === 'href' || attrName === 'src' || attrName === 'cite') {
+            if (!isSafeUrl(attrVal, attrName)) {
+              continue;
+            }
+          }
+
+          cleanEl.setAttribute(attrName, attrVal);
+        }
+
+        if (tagName === 'a' && cleanEl.hasAttribute('href')) {
+          cleanEl.setAttribute('rel', 'noopener noreferrer');
+        }
+
+        for (const child of Array.from(node.childNodes)) {
+          const cleanChild = sanitizeNode(child, targetDoc);
+          if (cleanChild) {
+            cleanEl.appendChild(cleanChild);
+          }
+        }
+
+        return cleanEl;
+      }
+
+      function parseAndSanitizeMarkup(untrustedMarkup) {
+        const parser = new DOMParser();
+        const parsedDoc = parser.parseFromString(String(untrustedMarkup ?? ''), 'text/html');
+        const fragment = document.createDocumentFragment();
+
+        if (parsedDoc && parsedDoc.body) {
+          for (const child of Array.from(parsedDoc.body.childNodes)) {
+            const cleanNode = sanitizeNode(child, document);
+            if (cleanNode) {
+              fragment.appendChild(cleanNode);
+            }
+          }
+        }
+
+        return fragment;
+      }
+
+      function enforceSafeTreeInPlace(container) {
+        const elements = Array.from(container.querySelectorAll('*'));
+        for (const el of elements) {
+          const tagName = el.tagName.toLowerCase();
+          if (DROP_WITH_CONTENT_ELEMENTS.has(tagName) || !ALLOWED_ELEMENTS.has(tagName)) {
+            el.remove();
+            continue;
+          }
+          const allowedForTag = ELEMENT_ALLOWED_ATTRS[tagName];
+          for (const attr of Array.from(el.attributes)) {
+            const attrName = attr.name.toLowerCase();
+            const attrVal = attr.value;
+            const isAllowed =
