+  <script type="module">
+    const ALLOWED_ELEMENTS = [
+      'p', 'b', 'i', 'strong', 'em', 'u', 'ul', 'ol', 'li', 'blockquote', 'code', 'br', 'span'
+    ];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then(
+        (mod) => mod.default ?? mod
+      );
+      return domPurifyPromise;
+    }
+
+    export async function safeSetHTML(el, untrustedHTML) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(untrustedHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(untrustedHTML, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    export async function safeParsePreview(previewEl, untrustedHTML) {
+      if (!untrustedHTML.trim()) {
+        previewEl.textContent = 'Start typing above to preview your formatted review...';
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(untrustedHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, untrustedHTML);
+      }
+    }
+
+    const initialReviews = [
+      {
+        author: 'Elena R.',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of rich espresso and real Vermont maple sweetness!</p>'
+      },
+      {
+        author: 'Marcus T.',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Bold and velvety crema. <blockquote>Best morning pick-me-up in town.</blockquote></p>'
+      },
+      {
+        author: 'Priya K.',
+        drink: 'Cold Brew',
+        html: '<p>Incredibly smooth 18-hour steep with <u>zero bitterness</u>. Highly recommend!</p>'
+      }
+    ];
+
+    const reviewsContainer = document.getElementById('reviews-container');
+    const reviewForm = document.getElementById('customer-review-form');
+    const nameInput = document.getElementById('reviewer-name');
+    const nameError = document.getElementById('name-error');
+    const reviewInput = document.getElementById('review-html');
+    const reviewError = document.getElementById('review-html-error');
+    const reviewPreview = document.getElementById('review-preview');
+    const reviewStatus = document.getElementById('review-status');
+    const submitBtn = document.getElementById('submit-review-btn');
+
+    async function renderReviewItem({ author, drink, html }, prepend = false) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = author;
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      header.append(authorSpan, drinkBadge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      article.append(header, body);
+
+      if (prepend && reviewsContainer.firstChild) {
+        reviewsContainer.prepend(article);
+      } else {
+        reviewsContainer.append(article);
+      }
+    }
+
+    for (const review of initialReviews) {
+      await renderReviewItem(review);
+    }
+    await safeParsePreview(reviewPreview, '');
+
+    function validateField(input, errorEl, message) {
+      if (!input.value.trim()) {
+        input.setCustomValidity(message);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = `⚠ ${message}`;
+        errorEl.hidden = false;
+        return false;
+      }
+      input.setCustomValidity('');
+      input.removeAttribute('aria-invalid');
+      errorEl.hidden = true;
+      return true;
+    }
+
+    const touchedFields = new Set();
+
+    nameInput.addEventListener('blur', () => {
+      if (touchedFields.has(nameInput)) {
+        validateField(nameInput, nameError, 'Please enter your name.');
+      }
+    });
+
+    nameInput.addEventListener('input', () => {
+      touchedFields.add(nameInput);
+      if (nameInput.value.trim()) {
+        nameInput.setCustomValidity('');
+        nameInput.removeAttribute('aria-invalid');
+        nameError.hidden = true;
+      }
+    });
+
+    reviewInput.addEventListener('blur', () => {
+      if (touchedFields.has(reviewInput)) {
+        validateField(reviewInput, reviewError, 'Please enter your review feedback.');
+      }
+    });
+
+    reviewInput.addEventListener('input', () => {
+      touchedFields.add(reviewInput);
+      if (reviewInput.value.trim()) {
+        reviewInput.setCustomValidity('');
+        reviewInput.removeAttribute('aria-invalid');
+        reviewError.hidden = true;
+      }
+      safeParsePreview(reviewPreview, reviewInput.value);
+    });
+
+    document.querySelectorAll('.format-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const tag = btn.dataset.tag;
+        const start = reviewInput.selectionStart ?? reviewInput.value.length;
+        const end = reviewInput.selectionEnd ?? reviewInput.value.length;
+        const selected = reviewInput.value.slice(start, end) || 'text';
+        const replacement = `<${tag}>${selected}</${tag}>`;
+        reviewInput.setRangeText(replacement, start, end, 'select');
+        reviewInput.focus();
+        reviewInput.dispatchEvent(new Event('input', { bubbles: true }));
+      });
+    });
+
+    reviewForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      reviewStatus.textContent = '';
+
+      const isNameValid = validateField(nameInput, nameError, 'Please enter your name.');
+      const isReviewValid = validateField(reviewInput, reviewError, 'Please enter your review feedback.');
+
+      if (!isNameValid) {
+        nameInput.focus();
+        return;
+      }
+      if (!isReviewValid) {
+        reviewInput.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+
+      try {
+        const formData = new FormData(reviewForm);
+        const author = formData.get('reviewer_name').toString().trim();
+        const drink = formData.get('drink').toString();
+        const rawHtml = formData.get('review_html').toString();
+
+        await renderReviewItem({ author, drink, html: rawHtml }, true);
+
+        reviewForm.reset();
+        touchedFields.clear();
+        await safeParsePreview(reviewPreview, '');
+        reviewStatus.textContent = `Thank you, ${author}! Your sanitized review for ${drink} has been posted.`;
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
