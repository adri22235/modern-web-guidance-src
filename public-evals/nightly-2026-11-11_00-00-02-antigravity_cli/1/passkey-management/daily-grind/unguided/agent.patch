+  }
+
+  function startRenamePasskey(credentialId) {
+    state.editingCredentialId = credentialId;
+    renderPasskeys();
+  }
+
+  function cancelRenamePasskey() {
+    state.editingCredentialId = null;
+    renderPasskeys();
+  }
+
+  async function renamePasskey(credentialId, newName) {
+    const trimmed = String(newName || '').trim();
+    if (!trimmed) {
+      showNotification('Please provide a non-empty name for your passkey.', 'error');
+      return false;
+    }
+
+    const target = state.passkeys.find((pk) => (pk.credentialId || pk.id) === credentialId);
+    if (!target) {
+      showNotification('Passkey not found.', 'error');
+      return false;
+    }
+
+    const oldName = target.name;
+    target.name = trimmed;
+    state.editingCredentialId = null;
+    savePasskeys(state.passkeys);
+    renderPasskeys();
+
+    showNotification(`Renamed passkey from "${oldName}" to "${trimmed}".`, 'success');
+    return true;
+  }
+
+  async function deletePasskey(credentialId) {
+    const index = state.passkeys.findIndex((pk) => (pk.credentialId || pk.id) === credentialId);
+    if (index === -1) {
+      showNotification('Passkey not found.', 'error');
+      return false;
+    }
+
+    const [removed] = state.passkeys.splice(index, 1);
+    if (state.editingCredentialId === credentialId) {
+      state.editingCredentialId = null;
+    }
+    savePasskeys(state.passkeys);
+    renderPasskeys();
+
+    const syncResult = await syncAuthenticatorCredentials('delete');
+    showNotification(
+      `Deleted passkey "${removed.name}" and synced browser authenticator (${syncResult.allAcceptedCredentialIds.length} active key${syncResult.allAcceptedCredentialIds.length === 1 ? '' : 's'} remaining).`,
+      'success'
+    );
+    return true;
+  }
+
+  async function registerNewPasskey(customName) {
+    const label = String(customName || '').trim() || `Passkey (${navigator.platform || 'Browser Authenticator'})`;
+    let newCredentialId = generateCredentialId();
+
+    if (
+      window.PublicKeyCredential &&
+      navigator.credentials &&
+      typeof navigator.credentials.create === 'function'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userIdBytes = base64UrlToUint8Array(state.user.userId);
+
+        const credential = await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The Daily Grind Coffee Co.',
+              id: getRpId()
+            },
+            user: {
+              id: userIdBytes,
+              name: state.user.name,
+              displayName: state.user.displayName
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 }
+            ],
+            timeout: 15000,
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred'
+            },
+            excludeCredentials: state.passkeys.map((pk) => ({
+              id: base64UrlToUint8Array(pk.credentialId || pk.id),
+              type: 'public-key'
+            }))
+          }
+        });
+
+        if (credential && credential.id) {
+          newCredentialId = credential.id;
+        }
+      } catch (err) {
+        // Fallback to generated Base64URL credential ID when no hardware/virtual authenticator completes ceremony
+        console.info('WebAuthn create ceremony skipped or cancelled; using generated passkey credential ID.', err);
+      }
+    }
+
+    const todayStr = new Date().toLocaleDateString('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric'
+    });
+
+    const newPasskey = {
+      id: newCredentialId,
+      credentialId: newCredentialId,
+      name: label,
+      provider: 'Browser Passkey Provider',
+      createdAt: todayStr,
+      lastUsedAt: 'Just now',
+      transports: ['internal', 'hybrid'],
+      synced: true
+    };
+
+    state.passkeys.unshift(newPasskey);
+    savePasskeys(state.passkeys);
+    renderPasskeys();
+
+    const syncResult = await syncAuthenticatorCredentials('register');
+    showNotification(
+      `Registered new passkey "${label}" and synchronized ${syncResult.allAcceptedCredentialIds.length} accepted passkeys with your browser authenticator.`,
+      'success'
+    );
+    return newPasskey;
+  }
+
+  async function resetDemoPasskeys() {
+    state.passkeys = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+    state.user = { ...DEFAULT_USER };
+    state.editingCredentialId = null;
+    savePasskeys(state.passkeys);
+    saveUser(state.user);
+    renderUserProfile();
+    renderPasskeys();
+    await syncAuthenticatorCredentials('reset');
+    showNotification('Restored default registered passkeys and synchronized browser authenticator.', 'success');
+  }
+
+  function attachEventListeners() {
+    const listEl = document.getElementById('passkey-list');
+    if (listEl) {
+      listEl.addEventListener('click', (event) => {
+        const actionBtn = event.target.closest('[data-action]');
+        if (!actionBtn) return;
+
+        const action = actionBtn.getAttribute('data-action');
+        const credentialId = actionBtn.getAttribute('data-credential-id');
+
+        if (action === 'rename' && credentialId) {
+          startRenamePasskey(credentialId);
+        } else if (action === 'cancel-rename') {
+          cancelRenamePasskey();
+        } else if (action === 'delete' && credentialId) {
+          deletePasskey(credentialId);
+        }
+      });
+
+      listEl.addEventListener('submit', (event) => {
+        const form = event.target.closest('.passkey-rename-form');
+        if (!form) return;
+        event.preventDefault();
