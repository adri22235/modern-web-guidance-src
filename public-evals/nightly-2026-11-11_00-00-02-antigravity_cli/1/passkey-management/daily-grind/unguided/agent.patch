+      } catch (error) {
+        console.warn('signalCurrentUserDetails failed:', error);
+        return { synced: false, error, ...payload };
+      }
+    }
+    return { synced: false, unsupported: true, ...payload };
+  }
+
+  function renderUserProfile() {
+    const displayNameEl = document.getElementById('account-display-name');
+    const emailEl = document.getElementById('account-email');
+    const userIdEl = document.getElementById('account-user-id');
+    const displayNameInput = document.getElementById('profile-display-name-input');
+    const emailInput = document.getElementById('profile-email-input');
+
+    if (displayNameEl) displayNameEl.textContent = state.user.displayName;
+    if (emailEl) emailEl.textContent = state.user.name;
+    if (userIdEl) userIdEl.textContent = state.user.userId;
+    if (displayNameInput && document.activeElement !== displayNameInput) {
+      displayNameInput.value = state.user.displayName;
+    }
+    if (emailInput && document.activeElement !== emailInput) {
+      emailInput.value = state.user.name;
+    }
+  }
+
+  function renderPasskeys() {
