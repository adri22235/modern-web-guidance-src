+
+function loadStoredUser() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_USER);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (parsed && parsed.passkeyUserId) return parsed;
+    }
+  } catch {
+    // Fallback to in-memory default
+  }
+  return { ...DEFAULT_USER };
+}
+
+function saveStoredUser(user) {
+  try {
+    localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));
+  } catch {
+    // Ignore storage quota errors
+  }
+}
+
+function loadStoredCredentials() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_CREDS);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (Array.isArray(parsed)) return parsed;
+    }
+  } catch {
+    // Fallback to default seed credentials
+  }
+  const initial = DEFAULT_CREDENTIALS.map((c) => ({ ...c }));
+  saveStoredCredentials(initial);
+  return initial;
+}
+
+function saveStoredCredentials(creds) {
+  try {
+    localStorage.setItem(STORAGE_KEY_CREDS, JSON.stringify(creds));
+  } catch {
+    // Ignore storage quota errors
+  }
+}
+
+export function resetDemoCredentials() {
+  const initial = DEFAULT_CREDENTIALS.map((c) => ({ ...c }));
+  saveStoredCredentials(initial);
+  saveStoredUser({ ...DEFAULT_USER });
+  return {
+    rpId: SERVER_RP_ID,
+    userId: DEFAULT_USER.passkeyUserId,
+    user: { ...DEFAULT_USER },
+    credentials: initial,
+  };
+}
+
+/**
+ * Resolve provider metadata from the local AAGUID registry.
+ * Checks for zeroed AAGUID ('00000000-0000-0000-0000-000000000000') first.
+ */
+export function lookupAaguidMetadata(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    iconDark: provider?.icon_dark,
+  };
+}
+
+function createJsonResponse(body, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+// GET /api/credentials - List all user credentials alongside server rpId and Base64URL userId
+export async function listFetch() {
+  try {
+    const res = await fetch('/api/credentials', {
+      method: 'GET',
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fall back to local state store when running on static file server
+  }
+
+  const user = loadStoredUser();
+  const credentials = loadStoredCredentials().map((cred) => {
+    const meta = lookupAaguidMetadata(cred.aaguid);
+    return {
+      ...cred,
+      providerName: meta.name,
+      providerIcon: cred.providerIcon ?? meta.providerIcon,
+      name: cred.customName || cred.name || meta.name,
+    };
+  });
+
+  return createJsonResponse({
+    rpId: SERVER_RP_ID,
+    userId: user.passkeyUserId,
+    user,
+    credentials,
+  });
+}
+
+// PUT /api/credential/:id - Rename a specific passkey's custom nickname on the server
+export async function renameCredentialFetch(credentialId, { name }) {
+  const trimmedName = (name ?? '').trim();
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name: trimmedName }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fall back to local state store
+  }
+
+  const creds = loadStoredCredentials();
+  const idx = creds.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+
+  const meta = lookupAaguidMetadata(creds[idx].aaguid);
+  creds[idx] = {
+    ...creds[idx],
+    customName: trimmedName,
+    name: trimmedName || meta.name,
+  };
+  saveStoredCredentials(creds);
+  return createJsonResponse(creds[idx], 200);
+}
+
+// DELETE /api/credential/:id - Remove a specific credential from the database
+export async function deleteFetch(credentialId) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fall back to local state store
+  }
+
+  const creds = loadStoredCredentials();
+  const idx = creds.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+
+  creds.splice(idx, 1);
+  saveStoredCredentials(creds);
+  return createJsonResponse({ success: true }, 200);
+}
+
+// PUT /api/user - Update signed-in user's username (name) and displayName
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    const res = await fetch('/api/user', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name, displayName }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fall back to local state store
+  }
+
+  const user = loadStoredUser();
+  const updatedUser = {
+    ...user,
+    name: (name ?? user.name).trim(),
+    displayName: (displayName ?? user.displayName).trim(),
+  };
+  saveStoredUser(updatedUser);
+
+  return createJsonResponse({
+    ...updatedUser,
+    rpId: SERVER_RP_ID,
+    userId: updatedUser.passkeyUserId,
+  });
+}
+
+// POST /api/register/options - Generate WebAuthn creation options for management flow
+export async function optionsFetch({ promotion = false } = {}) {
+  try {
+    const res = await fetch('/api/register/options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ promotion }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return await res.json();
+    }
+  } catch {
+    // Fall back to local options generator
+  }
+
+  const user = loadStoredUser();
+  const existingCreds = loadStoredCredentials();
+
+  // Generate random 32-byte challenge encoded as unpadded Base64URL
+  const randomBytes = new Uint8Array(32);
+  crypto.getRandomValues(randomBytes);
+  const challenge = bytesToBase64Url(randomBytes);
+
+  // Management flow omits authenticatorAttachment so external security keys and platform authenticators both work
+  const authenticatorSelection = {
+    residentKey: 'required',
+    requireResidentKey: true,
+    userVerification: 'preferred',
+    ...(promotion && { authenticatorAttachment: 'platform' }),
+  };
+
+  return {
+    challenge,
+    rp: {
+      id: SERVER_RP_ID,
+      name: 'The Daily Grind Coffee Co.',
+    },
+    user: {
+      id: user.passkeyUserId,
+      name: user.name,
+      displayName: user.displayName,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },   // ES256
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    excludeCredentials: existingCreds.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid'],
+    })),
+    authenticatorSelection,
+  };
+}
+
+// POST /api/register/verify - Verify and persist newly created passkey credential
+export async function registerVerifyFetch(encodedResponse) {
+  try {
+    const res = await fetch('/api/register/verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(encodedResponse),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fall back to local state store
+  }
+
+  const user = loadStoredUser();
+  const creds = loadStoredCredentials();
+
+  // Extract or default AAGUID
+  const aaguid = encodedResponse.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+  const meta = lookupAaguidMetadata(aaguid);
+  const now = Date.now();
+
+  const newCredential = {
+    id: encodedResponse.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: encodedResponse.response?.attestationObject || 'pQECAyYgASFYIMockPublicKey',
+    credentialType: 'public-key',
+    credentialDeviceType: encodedResponse.authenticatorAttachment === 'cross-platform' ? 'singleDevice' : 'multiDevice',
+    credentialBackedUp: encodedResponse.authenticatorAttachment !== 'cross-platform',
+    aaguid,
+    providerIcon: meta.providerIcon,
+    name: meta.name,
+    customName: '',
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    registeredAt: now,
+    lastUsedAt: now,
+    counter: 0,
+  };
+
+  creds.unshift(newCredential);
+  saveStoredCredentials(creds);
+  return createJsonResponse(newCredential, 200);
+}
+
+function bytesToBase64Url(bytes) {
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
