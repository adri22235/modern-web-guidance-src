+// Client-side Passkey Management & Signal API Synchronization Module
+import './webauthn-polyfills.js';
+import {
+  listFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  deleteFetch,
+  optionsFetch,
+  registerVerifyFetch,
+  lookupAaguidMetadata,
+  resetDemoCredentials,
+} from './api.js';
+
+// Fallback SVG data URI when an AAGUID is zeroed ('00000000-0000-0000-0000-000000000000') or has no registry icon
+const FALLBACK_KEY_ICON_SVG =
+  "data:image/svg+xml;utf8," +
+  encodeURIComponent(
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>`
+  );
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value) {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+/**
+ * Synchronize accepted credential IDs with the browser's passkey provider via the WebAuthn Signal API.
+ * Uses the server-provided rpId (never window.location.hostname) and logs passive failures with console.warn.
+ */
+export async function syncAcceptedCredentials(rpId, userId, currentCredentialsList) {
+  updateSyncDiagnostics({
+    method: 'signalAllAcceptedCredentials',
+    rpId,
+    userId,
+    count: currentCredentialsList.length,
+  });
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    return;
+  }
+
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+/**
+ * Format a raw epoch timestamp (ms) into a clear, human-readable date string.
+ */
+function formatEpochDate(epochTimestamp) {
+  if (!epochTimestamp || typeof epochTimestamp !== 'number') {
+    return 'Never used';
+  }
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric',
+    }).format(new Date(epochTimestamp));
+  } catch {
+    return new Date(epochTimestamp).toLocaleDateString();
+  }
+}
+
+/**
+ * Check if passkey platform authenticator is supported via PublicKeyCredential.getClientCapabilities().
+ */
+async function isPasskeySupported() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+// Track active modal state
+let activeRenameCredentialId = null;
+let activeDeleteCredentialId = null;
+let cachedCredentials = [];
+let currentServerRpId = null;
+let currentServerUserId = null;
+
+function announceStatus(message) {
+  const statusRegion = document.getElementById('account-status-banner');
+  const statusText = document.getElementById('account-status-text');
+  if (!statusRegion || !statusText) return;
+
+  statusText.textContent = message;
+  statusRegion.hidden = false;
+}
+
+function updateSyncDiagnostics({ method, rpId, userId, count }) {
+  const badge = document.getElementById('signal-sync-indicator');
+  if (!badge) return;
+  const supported = Boolean(
+    window.PublicKeyCredential &&
+      (PublicKeyCredential.signalAllAcceptedCredentials ||
+        PublicKeyCredential.signalCurrentUserDetails)
+  );
+  const timeStr = new Intl.DateTimeFormat('en-US', {
+    hour: 'numeric',
+    minute: '2-digit',
+    second: '2-digit',
+  }).format(new Date());
+
+  badge.textContent = supported
+    ? `Authenticator synced (${method} • RP: ${rpId} • ${ timeStr })`
+    : `Server state saved (${method} • Signal API progressive enhancement ready • ${timeStr})`;
+  badge.dataset.lastSyncMethod = method;
+  badge.dataset.lastRpId = rpId || '';
+  badge.dataset.lastUserId = userId || '';
+  if (typeof count === 'number') {
+    badge.dataset.acceptedCount = String(count);
+  }
+}
+
+/**
+ * Render the list of registered passkeys and profile summary into the DOM.
+ */
+function renderUI(credentials, user) {
+  cachedCredentials = Array.isArray(credentials) ? credentials : [];
+
+  // Update user profile form and header summary if user object is provided
+  if (user) {
+    const usernameInput = document.getElementById('account-username-input');
+    const displayNameInput = document.getElementById('account-displayname-input');
+    const profileHeadingName = document.getElementById('profile-heading-name');
+    const profileHeadingEmail = document.getElementById('profile-heading-email');
+
+    if (usernameInput && document.activeElement !== usernameInput) {
+      usernameInput.value = user.name || '';
+    }
+    if (displayNameInput && document.activeElement !== displayNameInput) {
+      displayNameInput.value = user.displayName || '';
+    }
+    if (profileHeadingName) {
+      profileHeadingName.textContent = user.displayName || 'Valued Customer';
+    }
+    if (profileHeadingEmail) {
+      profileHeadingEmail.textContent = user.name || '';
+    }
+  }
+
+  const listEl = document.getElementById('passkey-list');
+  const emptyStateEl = document.getElementById('passkey-empty-state');
+  const countBadgeEl = document.getElementById('passkey-count-badge');
+
+  if (countBadgeEl) {
+    countBadgeEl.textContent = `${cachedCredentials.length} ${
+      cachedCredentials.length === 1 ? 'passkey' : 'passkeys'
+    }`;
+  }
+
+  if (!listEl || !emptyStateEl) return;
+
+  listEl.innerHTML = '';
+
+  if (cachedCredentials.length === 0) {
+    listEl.hidden = true;
+    emptyStateEl.hidden = false;
+    return;
+  }
+
+  listEl.hidden = false;
+  emptyStateEl.hidden = true;
+
+  for (const cred of cachedCredentials) {
+    // Map AAGUID metadata using local registry (checking zeroed AAGUID first)
+    let providerName = 'Unknown passkey provider';
+    let providerIcon = undefined;
+
+    if (cred.aaguid && cred.aaguid !== '00000000-0000-0000-0000-000000000000') {
+      const meta = lookupAaguidMetadata(cred.aaguid);
+      providerName = meta.name;
+      providerIcon = cred.providerIcon || meta.providerIcon;
+    }
+
+    const displayName = cred.customName || cred.name || providerName;
+    const showSecondaryProviderLabel =
+      cred.customName && cred.customName.toLowerCase() !== providerName.toLowerCase();
+
+    const registeredDateStr = formatEpochDate(cred.registeredAt);
+    const lastUsedDateStr = cred.lastUsedAt
+      ? formatEpochDate(cred.lastUsedAt)
+      : 'Never used';
+
+    const li = document.createElement('li');
+    li.className = 'passkey-row';
+    li.dataset.credentialId = cred.id;
+    li.dataset.aaguid = cred.aaguid || '00000000-0000-0000-0000-000000000000';
+
+    // 1. Provider Icon (AAGUID-derived image or fallback SVG data URI)
+    const iconWrapper = document.createElement('div');
+    iconWrapper.className = 'passkey-provider-icon-wrap';
+    const img = document.createElement('img');
+    img.className = 'passkey-provider-icon';
+    img.src = providerIcon || FALLBACK_KEY_ICON_SVG;
+    img.alt = `${providerName} icon`;
+    img.width = 36;
+    img.height = 36;
+    iconWrapper.appendChild(img);
+
+    // 2. Details Column: Provider/Custom Name + Sync Badge + Registration Date + Last Used Date
+    const infoCol = document.createElement('div');
+    infoCol.className = 'passkey-info';
+
+    const titleLine = document.createElement('div');
+    titleLine.className = 'passkey-title-line';
+
+    const nameStrong = document.createElement('strong');
+    nameStrong.className = 'passkey-name';
+    nameStrong.textContent = displayName;
+    titleLine.appendChild(nameStrong);
+
+    if (showSecondaryProviderLabel) {
+      const providerPill = document.createElement('span');
+      providerPill.className = 'passkey-provider-pill';
+      providerPill.textContent = providerName;
+      titleLine.appendChild(providerPill);
+    }
+
+    const syncBadge = document.createElement('span');
+    syncBadge.className =
+      cred.credentialDeviceType === 'singleDevice'
+        ? 'passkey-badge passkey-badge-hardware'
+        : 'passkey-badge passkey-badge-synced';
+    syncBadge.textContent =
+      cred.credentialDeviceType === 'singleDevice' ? 'Device-bound' : 'Synced';
+    titleLine.appendChild(syncBadge);
+
+    const metaLine = document.createElement('div');
+    metaLine.className = 'passkey-meta-dates';
+
+    const regSpan = document.createElement('span');
+    regSpan.className = 'passkey-date-item';
+    regSpan.innerHTML = `<span class="meta-label">Registered:</span> <time datetime="${new Date(
+      cred.registeredAt
+    ).toISOString()}">${registeredDateStr}</time>`;
+
+    const sepSpan = document.createElement('span');
+    sepSpan.className = 'meta-separator';
+    sepSpan.setAttribute('aria-hidden', 'true');
+    sepSpan.textContent = '•';
+
+    const usedSpan = document.createElement('span');
+    usedSpan.className = 'passkey-date-item';
+    if (cred.lastUsedAt) {
+      usedSpan.innerHTML = `<span class="meta-label">Last used:</span> <time datetime="${new Date(
+        cred.lastUsedAt
+      ).toISOString()}">${lastUsedDateStr}</time>`;
+    } else {
+      usedSpan.innerHTML = `<span class="meta-label">Last used:</span> <span>Never used</span>`;
+    }
+
+    metaLine.append(regSpan, sepSpan, usedSpan);
+    infoCol.append(titleLine, metaLine);
+
+    // 3. Action Buttons Column: Rename Button & Delete Button (disambiguated accessible names)
+    const actionsCol = document.createElement('div');
+    actionsCol.className = 'passkey-actions';
+
+    const renameBtn = document.createElement('button');
+    renameBtn.type = 'button';
+    renameBtn.className = 'btn-secondary btn-action rename-passkey-btn';
+    renameBtn.dataset.credentialId = cred.id;
+    renameBtn.setAttribute('aria-label', `Rename ${displayName}`);
+    renameBtn.textContent = 'Rename';
+    renameBtn.addEventListener('click', () => openRenameDialog(cred, displayName, providerName));
+
+    const deleteBtn = document.createElement('button');
+    deleteBtn.type = 'button';
+    deleteBtn.className = 'btn-danger-outline btn-action delete-passkey-btn';
+    deleteBtn.dataset.credentialId = cred.id;
+    deleteBtn.setAttribute('aria-label', `Delete ${displayName}`);
+    deleteBtn.textContent = 'Delete';
+    deleteBtn.addEventListener('click', () => openDeleteDialog(cred, displayName));
+
+    actionsCol.append(renameBtn, deleteBtn);
+    li.append(iconWrapper, infoCol, actionsCol);
+    listEl.appendChild(li);
+  }
+}
+
+/**
+ * Initial page load handler: fetch credentials, render UI, and invoke signalAllAcceptedCredentials().
+ */
+export async function loadManagementPanel() {
+  const response = await listFetch();
+  const { rpId, userId, user, credentials } = await response.json();
+
+  currentServerRpId = rpId;
+  currentServerUserId = userId;
+
+  renderUI(credentials, user);
+  // Sync accepted credentials on initial load using server-provided rpId and userId
+  await syncAcceptedCredentials(rpId, userId, credentials);
+}
+
+/**
+ * Delete a credential on the server and synchronize remaining accepted credentials via Signal API.
+ */
+export async function performDelete(credentialId) {
+  const targetCred = cachedCredentials.find((c) => c.id === credentialId);
+  const label = targetCred?.customName || targetCred?.name || 'passkey';
+
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { rpId, userId, user, credentials } = await updatedResponse.json();
+
+    currentServerRpId = rpId;
+    currentServerUserId = userId;
+
+    renderUI(credentials, user);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(rpId, userId, credentials);
+    announceStatus(
+      `Passkey "${label}" was removed from your account and synced with your browser authenticator.`
+    );
+  }
+}
+
+/**
+ * Rename a passkey's custom nickname on the server.
+ * Note: Renaming an individual passkey's nickname is a server-side label change and does NOT invoke signalCurrentUserDetails().
+ */
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, { name: newCredentialName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { credentials, user } = await updatedResponse.json();
+    renderUI(credentials, user);
+    announceStatus(`Passkey renamed to "${newCredentialName.trim() || 'Default provider name'}".`);
+  }
+}
+
+/**
+ * Update the signed-in user's account username (name) or displayName on the server
+ * and immediately synchronize with the password manager via PublicKeyCredential.signalCurrentUserDetails().
+ */
+export async function performUserRename(updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({
+    name: updatedName,
+    displayName: updatedDisplayName,
+  });
+
+  if (response.ok) {
+    const data = await response.json();
+    const { rpId, userId } = data;
+
+    // Refresh displayed profile state
+    const updatedResponse = await listFetch();
+    const { credentials, user } = await updatedResponse.json();
+    renderUI(credentials, user);
+
+    updateSyncDiagnostics({
+      method: 'signalCurrentUserDetails',
+      rpId,
+      userId,
+      count: credentials.length,
+    });
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      if (!rpId || !isValidBase64Url(userId)) {
+        console.warn(
+          'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+        );
+        return;
+      }
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+          userId, // Base64URL-encoded user ID from the server
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName, // Updated display name
+        });
+      } catch (e) {
+        // Use console.warn instead of console.error for passive background sync
+        console.warn('SignalCurrentUserDetails sync warning:', e);
+      }
+    }
+
+    announceStatus(
+      `Account details updated for ${updatedDisplayName} (${updatedName}) and synced with your authenticator.`
+    );
+  }
+}
+
+/**
+ * Register a new passkey from the management panel.
+ * Omits authenticatorSelection.authenticatorAttachment so security keys and platform authenticators are both allowed.
+ */
+export async function registerPasskey(isPromotion = false) {
+  if (!window.PublicKeyCredential) {
+    announceStatus('WebAuthn is not supported in this browser environment.');
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey =
+    PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      announceStatus('A passkey from this authenticator is already registered for your account.');
+    } else if (err.name === 'SecurityError') {
+      console.warn('Configuration RP ID or Secure Context error:', err);
+      announceStatus('Passkey creation requires a matching RP ID and secure context.');
+    } else if (err.name === 'NotAllowedError') {
+      announceStatus('Passkey registration was cancelled or timed out.');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    } else {
+      console.warn('Passkey creation did not complete:', err);
+    }
+    return; // Safe exit: do not signal unknown for standard WebAuthn cancellation
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+            credentialId: encodedResponse.id,
+          });
+        } catch (sigErr) {
+          console.warn('SignalUnknownCredential sync warning:', sigErr);
+        }
+      }
+      announceStatus('Server verification failed for the new passkey.');
+      return;
+    }
+
+    const updatedResponse = await listFetch();
+    const { rpId, userId, user, credentials } = await updatedResponse.json();
+    renderUI(credentials, user);
+    await syncAcceptedCredentials(rpId, userId, credentials);
+    announceStatus('New passkey registered and synced with your account.');
+  } catch (serverErr) {
+    console.warn('Server verification network failure:', serverErr);
+    if (PublicKeyCredential.signalUnknownCredential) {
+      try {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rp.id,
+          credentialId: encodedResponse.id,
+        });
+      } catch (sigErr) {
+        console.warn('SignalUnknownCredential sync warning:', sigErr);
+      }
+    }
+  }
+}
+
+/* --- Modal Dialog Helpers (Native <dialog> with showModal()) --- */
+
+function openRenameDialog(cred, currentDisplayName, providerName) {
+  const dialog = document.getElementById('rename-passkey-dialog');
+  const input = document.getElementById('rename-passkey-input');
+  const providerHint = document.getElementById('rename-passkey-provider-hint');
+  const errorEl = document.getElementById('rename-passkey-error');
+
+  if (!dialog || !input) return;
+
+  activeRenameCredentialId = cred.id;
+  input.value = currentDisplayName;
+  input.removeAttribute('aria-invalid');
+  if (errorEl) errorEl.textContent = '';
+  if (providerHint) {
+    providerHint.textContent = `Authenticator provider: ${providerName}. Clear or edit the nickname to help identify this passkey.`;
+  }
+
+  dialog.returnValue = '';
+  dialog.showModal();
+  input.select();
+}
+
+function openDeleteDialog(cred, currentDisplayName) {
+  const dialog = document.getElementById('delete-passkey-dialog');
+  const nameTarget = document.getElementById('delete-passkey-target-name');
+  if (!dialog) return;
+
+  activeDeleteCredentialId = cred.id;
+  if (nameTarget) {
+    nameTarget.textContent = currentDisplayName;
+  }
+
+  dialog.returnValue = '';
+  dialog.showModal();
+}
+
+function setupDialogsAndForms() {
+  // Light-dismiss fallback for browsers without native dialog closedby="any"
+  if (typeof HTMLDialogElement !== 'undefined' && !('closedBy' in HTMLDialogElement.prototype)) {
+    const outside = (e, dialog) => {
+      const r = dialog.getBoundingClientRect();
+      return (
+        e.clientX < r.left ||
+        e.clientX > r.right ||
+        e.clientY < r.top ||
+        e.clientY > r.bottom
+      );
+    };
+    for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => {
+        pressedOutside = outside(e, dialog);
+      });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e, dialog)) dialog.close();
+      });
+    }
+  }
+
+  // Rename Passkey Dialog Form
+  const renameDialog = document.getElementById('rename-passkey-dialog');
+  const renameForm = document.getElementById('rename-passkey-form');
+  const renameInput = document.getElementById('rename-passkey-input');
+  const renameError = document.getElementById('rename-passkey-error');
+  const renameCancelBtn = document.getElementById('rename-cancel-btn');
+
+  if (renameCancelBtn && renameDialog) {
+    renameCancelBtn.addEventListener('click', () => {
+      renameDialog.returnValue = 'cancel';
+      renameDialog.close();
+    });
+  }
+
+  if (renameInput && renameError) {
+    renameInput.addEventListener('input', () => {
+      renameInput.setCustomValidity('');
+      renameInput.removeAttribute('aria-invalid');
+      renameError.textContent = '';
+    });
+  }
+
+  if (renameForm && renameDialog && renameInput) {
+    renameForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const newName = renameInput.value.trim();
+      if (!newName) {
+        renameInput.setAttribute('aria-invalid', 'true');
+        if (renameError) {
+          renameError.textContent = 'Please enter a descriptive nickname for this passkey.';
+        }
+        renameInput.focus();
+        return;
+      }
+      const credId = activeRenameCredentialId;
+      activeRenameCredentialId = null;
+      renameDialog.returnValue = '';
+      renameDialog.close();
+      if (credId) {
+        await performCredentialRename(credId, newName);
+      }
+    });
+
+    renameDialog.addEventListener('close', () => {
+      renameDialog.returnValue = '';
+    });
+  }
+
+  // Delete Passkey Confirmation Dialog
+  const deleteDialog = document.getElementById('delete-passkey-dialog');
+  if (deleteDialog) {
+    deleteDialog.addEventListener('close', async () => {
+      const choice = deleteDialog.returnValue;
+      deleteDialog.returnValue = ''; // Reset returnValue immediately to avoid stale values on Esc
+      if (choice === 'delete' && activeDeleteCredentialId) {
+        const idToDelete = activeDeleteCredentialId;
+        activeDeleteCredentialId = null;
+        await performDelete(idToDelete);
+      } else {
+        activeDeleteCredentialId = null;
+      }
+    });
+  }
+
+  // User Account Profile Rename Form (triggers signalCurrentUserDetails)
+  const profileForm = document.getElementById('account-profile-form');
+  const usernameInput = document.getElementById('account-username-input');
+  const displayNameInput = document.getElementById('account-displayname-input');
+  const profileError = document.getElementById('account-profile-error');
+
+  if (profileForm && usernameInput && displayNameInput) {
+    const clearProfileError = () => {
+      usernameInput.removeAttribute('aria-invalid');
+      displayNameInput.removeAttribute('aria-invalid');
+      if (profileError) profileError.textContent = '';
+    };
+    usernameInput.addEventListener('input', clearProfileError);
+    displayNameInput.addEventListener('input', clearProfileError);
+
+    profileForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const updatedName = usernameInput.value.trim();
+      const updatedDisplayName = displayNameInput.value.trim();
+
+      if (!updatedName) {
+        usernameInput.setAttribute('aria-invalid', 'true');
+        if (profileError) profileError.textContent = 'Please enter a valid account email or username.';
+        usernameInput.focus();
+        return;
+      }
+      if (!updatedDisplayName) {
+        displayNameInput.setAttribute('aria-invalid', 'true');
+        if (profileError) profileError.textContent = 'Please enter a display name for your account.';
+        displayNameInput.focus();
+        return;
+      }
+
+      const submitBtn = document.getElementById('save-profile-btn');
+      if (submitBtn) submitBtn.disabled = true;
+      try {
+        await performUserRename(updatedName, updatedDisplayName);
+      } finally {
+        if (submitBtn) submitBtn.disabled = false;
+      }
+    });
+  }
+
+  // Conditional "Create passkey" button feature-detected via getClientCapabilities()
+  const createButton = document.getElementById('create-passkey');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+  if (createButton) {
+    isPasskeySupported().then((supported) => {
+      if (!supported) {
+        createButton.hidden = true;
+        if (fallbackNotice) fallbackNotice.hidden = false;
+      } else {
+        createButton.hidden = false;
+        if (fallbackNotice) fallbackNotice.hidden = true;
+      }
+    });
+
+    createButton.addEventListener('click', () => {
+      registerPasskey(false);
+    });
+  }
+
+  // Restore sample passkeys helper button (useful when testing deleting all passkeys)
+  const resetDemoBtn = document.getElementById('restore-sample-passkeys-btn');
+  if (resetDemoBtn) {
+    resetDemoBtn.addEventListener('click', async () => {
+      const { rpId, userId, user, credentials } = resetDemoCredentials();
+      renderUI(credentials, user);
+      await syncAcceptedCredentials(rpId, userId, credentials);
+      announceStatus('Sample registered passkeys restored and synced with your authenticator.');
+    });
+  }
+}
+
+async function initPasskeyManagement() {
+  setupDialogsAndForms();
+  await loadManagementPanel();
+}
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', initPasskeyManagement);
+} else {
+  initPasskeyManagement();
+}
