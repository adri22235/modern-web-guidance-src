@@ -0,0 +1,982 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  DEFAULT_READER_ACCOUNT,
+  INITIAL_PASSKEYS,
+  detectPasskeyCapabilities,
+  getEffectiveRpId,
+  syncAllAcceptedCredentialsWithAuthenticator,
+  syncCurrentUserDetailsWithAuthenticator,
+  syncRemovedPasskeyWithAuthenticator,
+  toBase64Url,
+  type PasskeyRecord,
+  type ReaderAccount,
+  type SyncSignalResult,
+} from '../utils/passkeys';
+
+const STORAGE_KEY_PASSKEYS = 'devtools_times_passkeys';
+const STORAGE_KEY_ACCOUNT = 'devtools_times_reader_account';
+
+interface AccountSettingsProps {
+  initialAccount?: ReaderAccount;
+  initialPasskeys?: PasskeyRecord[];
+}
+
+export default function AccountSettings({
+  initialAccount = DEFAULT_READER_ACCOUNT,
+  initialPasskeys = INITIAL_PASSKEYS,
+}: AccountSettingsProps) {
+  const [account, setAccount] = useState<ReaderAccount>(initialAccount);
+  const [passkeys, setPasskeys] = useState<PasskeyRecord[]>(initialPasskeys);
+
+  // Editing state for individual passkey display names
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingDisplayName, setEditingDisplayName] = useState<string>('');
+
+  // Account profile display name & username form state
+  const [profileDisplayName, setProfileDisplayName] = useState<string>(initialAccount.displayName);
+  const [profileUsername, setProfileUsername] = useState<string>(initialAccount.username);
+
+  // New passkey creation state
+  const [newKeyDisplayName, setNewKeyDisplayName] = useState<string>('');
+  const [isAddingKey, setIsAddingKey] = useState<boolean>(false);
+
+  // Authenticator sync status & logs
+  const [capabilities, setCapabilities] = useState<{
+    webauthnAvailable: boolean;
+    signalAllAcceptedCredentials: boolean;
+    signalCurrentUserDetails: boolean;
+    signalUnknownCredential: boolean;
+  }>({
+    webauthnAvailable: false,
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  });
+  const [syncLogs, setSyncLogs] = useState<SyncSignalResult[]>([]);
+  const [statusBanner, setStatusBanner] = useState<{
+    type: 'success' | 'info' | 'error';
+    message: string;
+  } | null>(null);
+  const [busyId, setBusyId] = useState<string | null>(null);
+
+  const appendSyncLogs = useCallback((results: SyncSignalResult | SyncSignalResult[]) => {
+    const items = Array.isArray(results) ? results : [results];
+    setSyncLogs((prev) => [...items, ...prev].slice(0, 12));
+  }, []);
+
+  const persistLocal = useCallback((nextAccount: ReaderAccount, nextPasskeys: PasskeyRecord[]) => {
+    try {
+      localStorage.setItem(STORAGE_KEY_ACCOUNT, JSON.stringify(nextAccount));
+      localStorage.setItem(STORAGE_KEY_PASSKEYS, JSON.stringify(nextPasskeys));
+    } catch {
+      // Ignore storage quota or private mode errors
+    }
+  }, []);
+
+  // Load state from server API and synchronize accepted credentials with browser authenticator on mount
+  useEffect(() => {
+    let mounted = true;
+
+    async function init() {
+      const caps = await detectPasskeyCapabilities();
+      if (mounted) {
+        setCapabilities(caps);
+      }
+
+      let currentAccount = initialAccount;
+      let currentPasskeys = initialPasskeys;
+
+      // Try loading from API
+      try {
+        const res = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`);
+        if (res.ok) {
+          const data = await res.json();
+          if (data.account && Array.isArray(data.passkeys)) {
+            currentAccount = data.account;
+            currentPasskeys = data.passkeys;
+          }
+        }
+      } catch {
+        // Fallback to localStorage if offline
+        try {
+          const storedAccount = localStorage.getItem(STORAGE_KEY_ACCOUNT);
+          const storedKeys = localStorage.getItem(STORAGE_KEY_PASSKEYS);
+          if (storedAccount) currentAccount = JSON.parse(storedAccount);
+          if (storedKeys) currentPasskeys = JSON.parse(storedKeys);
+        } catch {
+          // Use initial props
+        }
+      }
+
+      if (!mounted) return;
+
+      setAccount(currentAccount);
+      setProfileDisplayName(currentAccount.displayName);
+      setProfileUsername(currentAccount.username);
+      setPasskeys(currentPasskeys);
+      persistLocal(currentAccount, currentPasskeys);
+
+      // Keep browser authenticator in sync on initial view of account settings
+      const syncResult = await syncAllAcceptedCredentialsWithAuthenticator({
+        userId: currentAccount.userId,
+        allAcceptedCredentialIds: currentPasskeys.map((pk) => pk.credentialId),
+      });
+      if (mounted) {
+        appendSyncLogs(syncResult);
+      }
+    }
+
+    init();
+
+    return () => {
+      mounted = false;
+    };
+  }, []);
+
+  const handleStartEdit = (pk: PasskeyRecord) => {
+    setEditingPasskeyId(pk.id);
+    setEditingDisplayName(pk.displayName);
+    setStatusBanner(null);
+  };
+
+  const handleCancelEdit = () => {
+    setEditingPasskeyId(null);
+    setEditingDisplayName('');
+  };
+
+  const handleSavePasskeyName = async (pk: PasskeyRecord, e?: React.FormEvent) => {
+    if (e) e.preventDefault();
+    const trimmed = editingDisplayName.trim();
+    if (!trimmed) {
+      setStatusBanner({
+        type: 'error',
+        message: 'Please provide a non-empty display name for the passkey.',
+      });
+      return;
+    }
+
+    setBusyId(pk.id);
+    setStatusBanner(null);
+
+    let nextPasskeys = passkeys.map((item) =>
+      item.id === pk.id ? { ...item, displayName: trimmed } : item
+    );
+    let nextAccount = account;
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'rename',
+          id: pk.id,
+          credentialId: pk.credentialId,
+          displayName: trimmed,
+        }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          nextPasskeys = data.passkeys;
+        }
+        if (data.account) {
+          nextAccount = data.account;
+        }
+      }
+    } catch {
+      // Proceed with optimistic client state
+    }
+
+    setPasskeys(nextPasskeys);
+    setAccount(nextAccount);
+    persistLocal(nextAccount, nextPasskeys);
+    setEditingPasskeyId(null);
+    setEditingDisplayName('');
+
+    // Synchronize updated display name with the browser authenticator via WebAuthn Signal API
+    const userDetailsSignal = await syncCurrentUserDetailsWithAuthenticator({
+      userId: pk.userId || nextAccount.userId,
+      name: pk.name || nextAccount.username,
+      displayName: trimmed,
+    });
+    const acceptedSignal = await syncAllAcceptedCredentialsWithAuthenticator({
+      userId: nextAccount.userId,
+      allAcceptedCredentialIds: nextPasskeys.map((item) => item.credentialId),
+    });
+
+    appendSyncLogs([userDetailsSignal, acceptedSignal]);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'success',
+      message: `Updated passkey display name to "${trimmed}" and synchronized details with your browser authenticator.`,
+    });
+  };
+
+  const handleRemovePasskey = async (pk: PasskeyRecord) => {
+    setBusyId(pk.id);
+    setStatusBanner(null);
+
+    let nextPasskeys = passkeys.filter((item) => item.id !== pk.id);
+    let nextAccount = account;
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'remove',
+          id: pk.id,
+          credentialId: pk.credentialId,
+        }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          nextPasskeys = data.passkeys;
+        }
+        if (data.account) {
+          nextAccount = data.account;
+        }
+      }
+    } catch {
+      // Proceed with optimistic removal
+    }
+
+    setPasskeys(nextPasskeys);
+    setAccount(nextAccount);
+    persistLocal(nextAccount, nextPasskeys);
+    if (editingPasskeyId === pk.id) {
+      setEditingPasskeyId(null);
+      setEditingDisplayName('');
+    }
+
+    // Signal both the unknown/removed credential ID and the updated list of all accepted credentials
+    const remainingIds = nextPasskeys.map((item) => item.credentialId);
+    const signals = await syncRemovedPasskeyWithAuthenticator({
+      userId: nextAccount.userId,
+      removedCredentialId: pk.credentialId,
+      remainingCredentialIds: remainingIds,
+    });
+
+    appendSyncLogs(signals);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'success',
+      message: `Removed passkey "${pk.displayName}" and signaled your browser authenticator to prune the revoked key.`,
+    });
+  };
+
+  const handleUpdateReaderProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplay = profileDisplayName.trim();
+    const trimmedUsername = profileUsername.trim();
+    if (!trimmedDisplay || !trimmedUsername) {
+      setStatusBanner({
+        type: 'error',
+        message: 'Both reader display name and username/email are required.',
+      });
+      return;
+    }
+
+    setBusyId('profile');
+    setStatusBanner(null);
+
+    let nextAccount: ReaderAccount = {
+      ...account,
+      displayName: trimmedDisplay,
+      username: trimmedUsername,
+      email: trimmedUsername,
+    };
+    let nextPasskeys = passkeys.map((pk) => ({
+      ...pk,
+      name: trimmedUsername,
+    }));
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'updateProfile',
+          displayName: trimmedDisplay,
+          username: trimmedUsername,
+        }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (data.account) nextAccount = data.account;
+        if (Array.isArray(data.passkeys)) nextPasskeys = data.passkeys;
+      }
+    } catch {
+      // Fallback to local state
+    }
+
+    setAccount(nextAccount);
+    setPasskeys(nextPasskeys);
+    persistLocal(nextAccount, nextPasskeys);
+
+    const signalRes = await syncCurrentUserDetailsWithAuthenticator({
+      userId: nextAccount.userId,
+      name: nextAccount.username,
+      displayName: nextAccount.displayName,
+    });
+
+    appendSyncLogs(signalRes);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'success',
+      message: `Updated reader profile display name to "${trimmedDisplay}" and synced user details with your browser authenticator.`,
+    });
+  };
+
+  const handleRegisterNewPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const label = newKeyDisplayName.trim() || 'Chrome on This Device';
+    setBusyId('register');
+    setStatusBanner(null);
+
+    let createdCredentialId = toBase64Url(`devtools-passkey-${Date.now()}`);
+
+    // Attempt WebAuthn navigator.credentials.create if available and user wants to register
+    if (
+      typeof window !== 'undefined' &&
+      window.navigator?.credentials &&
+      typeof window.navigator.credentials.create === 'function' &&
+      typeof PublicKeyCredential !== 'undefined'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userIdBytes = new TextEncoder().encode(account.userId);
+        const credential = (await window.navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: getEffectiveRpId(),
+            },
+            user: {
+              id: userIdBytes,
+              name: account.username,
+              displayName: label,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 },
+            ],
+            authenticatorSelection: {
+              residentKey: 'preferred',
+              userVerification: 'preferred',
+            },
+            timeout: 15000,
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential && credential.id) {
+          createdCredentialId = credential.id;
+        }
+      } catch {
+        // In automated/headless environments or if user cancels dialog, fall back to generating a passkey record
+      }
+    }
+
+    let nextPasskeys = passkeys;
+    let nextAccount = account;
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'register',
+          displayName: label,
+          credentialId: createdCredentialId,
+          deviceType: 'Browser Platform Authenticator',
+          backedUp: true,
+        }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) nextPasskeys = data.passkeys;
+        if (data.account) nextAccount = data.account;
+      }
+    } catch {
+      const fallbackKey: PasskeyRecord = {
+        id: `pk-${Date.now()}`,
+        credentialId: createdCredentialId,
+        userId: account.userId,
+        name: account.username,
+        displayName: label,
+        deviceType: 'Browser Platform Authenticator',
+        createdAt: new Date().toISOString(),
+        lastUsedAt: new Date().toISOString(),
+        backedUp: true,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      };
+      nextPasskeys = [fallbackKey, ...passkeys];
+    }
+
+    setPasskeys(nextPasskeys);
+    setAccount(nextAccount);
+    persistLocal(nextAccount, nextPasskeys);
+    setNewKeyDisplayName('');
+    setIsAddingKey(false);
+
+    const acceptedSignal = await syncAllAcceptedCredentialsWithAuthenticator({
+      userId: nextAccount.userId,
+      allAcceptedCredentialIds: nextPasskeys.map((pk) => pk.credentialId),
+    });
+    const userSignal = await syncCurrentUserDetailsWithAuthenticator({
+      userId: nextAccount.userId,
+      name: nextAccount.username,
+      displayName: label,
+    });
+
+    appendSyncLogs([acceptedSignal, userSignal]);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'success',
+      message: `Registered new passkey "${label}" and synced accepted credentials with your browser authenticator.`,
+    });
+  };
+
+  const handleManualSyncAll = async () => {
+    setBusyId('manual-sync');
+    setStatusBanner(null);
+
+    const acceptedSignal = await syncAllAcceptedCredentialsWithAuthenticator({
+      userId: account.userId,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    });
+    const userSignal = await syncCurrentUserDetailsWithAuthenticator({
+      userId: account.userId,
+      name: account.username,
+      displayName: account.displayName,
+    });
+
+    appendSyncLogs([acceptedSignal, userSignal]);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'info',
+      message: `Synchronized ${passkeys.length} accepted passkey(s) and current reader details with your browser authenticator.`,
+    });
+  };
+
+  const handleResetDemoKeys = async () => {
+    setBusyId('reset');
+    setStatusBanner(null);
+
+    let nextAccount = DEFAULT_READER_ACCOUNT;
+    let nextPasskeys = INITIAL_PASSKEYS;
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset' }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (data.account) nextAccount = data.account;
+        if (Array.isArray(data.passkeys)) nextPasskeys = data.passkeys;
+      }
+    } catch {
+      // Fallback to constants
+    }
+
+    setAccount(nextAccount);
+    setProfileDisplayName(nextAccount.displayName);
+    setProfileUsername(nextAccount.username);
+    setPasskeys(nextPasskeys);
+    persistLocal(nextAccount, nextPasskeys);
+
+    const acceptedSignal = await syncAllAcceptedCredentialsWithAuthenticator({
+      userId: nextAccount.userId,
+      allAcceptedCredentialIds: nextPasskeys.map((pk) => pk.credentialId),
+    });
+    appendSyncLogs(acceptedSignal);
+    setBusyId(null);
+    setStatusBanner({
+      type: 'info',
+      message: 'Restored default registered passkeys and synced with your browser authenticator.',
+    });
+  };
+
+  const formatDate = (isoString: string) => {
+    try {
+      return new Date(isoString).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return isoString;
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8" data-testid="account-settings">
+      {/* Page Header */}
+      <div className="border-b-2 border-gray-900 pb-4 mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-amber-600 mb-1">
+            Subscriber Account Settings
+          </p>
+          <h1 className="text-3xl font-bold text-gray-900">Manage My Account</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as <span className="font-semibold text-gray-900">{account.displayName}</span> (
+            <span className="font-mono text-xs">{account.username}</span>)
+          </p>
+        </div>
+        <div className="flex items-center gap-2">
+          <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
+            <span className="w-2 h-2 rounded-full bg-green-600 mr-1.5"></span>
+            {account.subscriptionTier}
+          </span>
+        </div>
+      </div>
+
+      {/* Status Notification Banner */}
+      {statusBanner && (
+        <div
+          role="status"
+          aria-live="polite"
+          data-testid="passkey-status-banner"
+          className={`mb-6 p-4 rounded-lg border text-sm flex items-start justify-between gap-3 ${
+            statusBanner.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : statusBanner.type === 'info'
+              ? 'bg-blue-50 border-blue-200 text-blue-800'
+              : 'bg-green-50 border-green-200 text-green-800'
+          }`}
+        >
+          <div className="flex items-start gap-2.5">
+            <svg
+              className="w-5 h-5 flex-shrink-0 mt-0.5"
+              fill="none"
+              stroke="currentColor"
+              viewBox="0 0 24 24"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                strokeWidth={2}
+                d={
+                  statusBanner.type === 'error'
+                    ? 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
+                    : 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
+                }
+              />
+            </svg>
+            <span>{statusBanner.message}</span>
+          </div>
+          <button
+            type="button"
+            onClick={() => setStatusBanner(null)}
+            className="text-xs font-semibold underline hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      <div className="space-y-8">
+        {/* Passkey Management Section */}
+        <section
+          aria-labelledby="passkey-management-heading"
+          data-testid="passkey-management-section"
+          className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
+        >
+          <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-gray-50">
+            <div>
+              <div className="flex items-center gap-2">
+                <svg
+                  className="w-5 h-5 text-gray-900"
+                  fill="none"
+                  stroke="currentColor"
+                  viewBox="0 0 24 24"
+                >
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    strokeWidth={2}
+                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                  />
+                </svg>
+                <h2
+                  id="passkey-management-heading"
+                  className="text-xl font-bold text-gray-900"
+                >
+                  Passkey Management
+                </h2>
+              </div>
+              <p className="text-sm text-gray-600 mt-1">
+                View your registered passkeys, update their display names, or remove keys you no
+                longer use while keeping your browser authenticator in sync.
+              </p>
+            </div>
+
+            <div className="flex flex-wrap items-center gap-2">
+              <button
+                type="button"
+                onClick={handleManualSyncAll}
+                disabled={busyId === 'manual-sync'}
+                data-testid="sync-authenticator-button"
+                className="px-3 py-2 text-xs font-semibold text-gray-800 bg-white border border-gray-300 rounded-md hover:bg-gray-100 transition-colors cursor-pointer"
+              >
+                {busyId === 'manual-sync' ? 'Syncing...' : 'Sync Authenticator'}
+              </button>
+              <button
+                type="button"
+                onClick={() => setIsAddingKey((prev) => !prev)}
+                data-testid="add-passkey-toggle"
+                className="px-3.5 py-2 text-xs font-semibold text-white bg-gray-900 rounded-md hover:bg-gray-800 transition-colors cursor-pointer"
+              >
+                + Register Passkey
+              </button>
+            </div>
+          </div>
+
+          {/* Add New Passkey Drawer */}
+          {isAddingKey && (
+            <form
+              onSubmit={handleRegisterNewPasskey}
+              data-testid="register-passkey-form"
