+/**
+ * Helper to encode a string or Uint8Array into Base64URL format (no padding, '-' and '_')
+ */
+export function toBase64Url(input: string | Uint8Array): string {
+  const bytes =
+    typeof input === 'string' ? new TextEncoder().encode(input) : input;
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  const base64 =
+    typeof btoa === 'function'
+      ? btoa(binary)
+      : Buffer.from(bytes).toString('base64');
+  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export interface SyncSignalResult {
+  method: string;
+  supported: boolean;
+  executed: boolean;
+  rpId: string;
+  timestamp: string;
+  payload: Record<string, unknown>;
+  error?: string;
+}
+
+/**
+ * Resolve the effective RP ID for WebAuthn calls in the browser.
+ */
+export function getEffectiveRpId(): string {
+  if (typeof window !== 'undefined' && window.location?.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+/**
+ * Queries PublicKeyCredential.getClientCapabilities() when available in the browser.
+ */
+export async function detectPasskeyCapabilities(): Promise<{
+  webauthnAvailable: boolean;
+  signalAllAcceptedCredentials: boolean;
+  signalCurrentUserDetails: boolean;
+  signalUnknownCredential: boolean;
+}> {
+  if (typeof window === 'undefined' || typeof PublicKeyCredential === 'undefined') {
+    return {
+      webauthnAvailable: false,
+      signalAllAcceptedCredentials: false,
+      signalCurrentUserDetails: false,
+      signalUnknownCredential: false,
+    };
+  }
+
+  let capAllAccepted = typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function';
+  let capCurrentUser = typeof PublicKeyCredential.signalCurrentUserDetails === 'function';
+  let capUnknown = typeof PublicKeyCredential.signalUnknownCredential === 'function';
+
+  if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      if (caps && typeof caps === 'object') {
+        if ('signalAllAcceptedCredentials' in caps) {
+          capAllAccepted = Boolean(caps.signalAllAcceptedCredentials) || capAllAccepted;
+        }
+        if ('signalCurrentUserDetails' in caps) {
+          capCurrentUser = Boolean(caps.signalCurrentUserDetails) || capCurrentUser;
+        }
+        if ('signalUnknownCredential' in caps) {
+          capUnknown = Boolean(caps.signalUnknownCredential) || capUnknown;
+        }
+      }
+    } catch {
+      // Ignore capability detection errors and rely on static method checks
+    }
+  }
+
+  return {
+    webauthnAvailable: true,
+    signalAllAcceptedCredentials: capAllAccepted,
+    signalCurrentUserDetails: capCurrentUser,
+    signalUnknownCredential: capUnknown,
+  };
+}
+
+/**
+ * Signals to the browser authenticator that a credential was removed/is no longer recognized,
+ * and updates the list of all accepted credentials for this user.
+ */
+export async function syncRemovedPasskeyWithAuthenticator(params: {
+  rpId?: string;
+  userId: string;
+  removedCredentialId: string;
+  remainingCredentialIds: string[];
+}): Promise<SyncSignalResult[]> {
+  const rpId = params.rpId || getEffectiveRpId();
+  const results: SyncSignalResult[] = [];
+  const timestamp = new Date().toISOString();
+
+  // 1. Signal unknown credential for the specifically removed key
+  const unknownPayload = {
+    rpId,
+    credentialId: params.removedCredentialId,
+  };
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalUnknownCredential === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalUnknownCredential(unknownPayload);
+      results.push({
+        method: 'PublicKeyCredential.signalUnknownCredential',
+        supported: true,
+        executed: true,
+        rpId,
+        timestamp,
+        payload: unknownPayload,
+      });
+    } catch (err: any) {
+      results.push({
+        method: 'PublicKeyCredential.signalUnknownCredential',
+        supported: true,
+        executed: false,
+        rpId,
+        timestamp,
+        payload: unknownPayload,
+        error: err?.message || String(err),
+      });
+    }
+  } else {
+    results.push({
+      method: 'PublicKeyCredential.signalUnknownCredential',
+      supported: false,
+      executed: false,
+      rpId,
+      timestamp,
+      payload: unknownPayload,
+    });
+  }
+
+  // 2. Signal all remaining accepted credentials for the user
+  const acceptedPayload = {
+    rpId,
+    userId: params.userId,
+    allAcceptedCredentialIds: params.remainingCredentialIds,
+  };
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials(acceptedPayload);
+      results.push({
+        method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+        supported: true,
+        executed: true,
+        rpId,
+        timestamp,
+        payload: acceptedPayload,
+      });
+    } catch (err: any) {
+      results.push({
+        method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+        supported: true,
+        executed: false,
+        rpId,
+        timestamp,
+        payload: acceptedPayload,
+        error: err?.message || String(err),
+      });
+    }
+  } else {
+    results.push({
+      method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+      supported: false,
+      executed: false,
+      rpId,
+      timestamp,
+      payload: acceptedPayload,
+    });
+  }
+
+  return results;
+}
+
+/**
+ * Signals the complete list of accepted credential IDs for the current user to the browser authenticator.
+ */
+export async function syncAllAcceptedCredentialsWithAuthenticator(params: {
+  rpId?: string;
+  userId: string;
+  allAcceptedCredentialIds: string[];
+}): Promise<SyncSignalResult> {
+  const rpId = params.rpId || getEffectiveRpId();
+  const timestamp = new Date().toISOString();
+  const payload = {
+    rpId,
+    userId: params.userId,
+    allAcceptedCredentialIds: params.allAcceptedCredentialIds,
+  };
+
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+      return {
+        method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+        supported: true,
+        executed: true,
+        rpId,
+        timestamp,
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+        supported: true,
+        executed: false,
+        rpId,
+        timestamp,
+        payload,
+        error: err?.message || String(err),
+      };
+    }
+  }
+
+  return {
+    method: 'PublicKeyCredential.signalAllAcceptedCredentials',
+    supported: false,
+    executed: false,
+    rpId,
+    timestamp,
+    payload,
+  };
+}
+
+/**
+ * Signals updated user/passkey display name details to the browser authenticator.
+ */
+export async function syncCurrentUserDetailsWithAuthenticator(params: {
+  rpId?: string;
