+              <span
+                className={`px-2 py-0.5 rounded font-mono border ${
+                  capabilities.signalCurrentUserDetails
+                    ? 'bg-green-50 text-green-800 border-green-200'
+                    : 'bg-gray-100 text-gray-600 border-gray-300'
