index 0000000..7c64d2c
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,263 @@
+import type { APIRoute } from 'astro';
+import {
+  DEFAULT_READER_ACCOUNT,
+  INITIAL_PASSKEYS,
+  toBase64Url,
+  type PasskeyRecord,
+  type ReaderAccount,
+} from '../../utils/passkeys';
+
+// Fallback in-memory store in case session is unavailable in certain test environments
+let memoryAccount: ReaderAccount = { ...DEFAULT_READER_ACCOUNT };
+let memoryPasskeys: PasskeyRecord[] = [...INITIAL_PASSKEYS];
+
+async function getAccountState(session: App.Locals['session']): Promise<{
+  account: ReaderAccount;
+  passkeys: PasskeyRecord[];
+}> {
+  if (session) {
+    const account = (await session.get('readerAccount')) || { ...DEFAULT_READER_ACCOUNT };
+    const passkeys = (await session.get('passkeys')) || [...INITIAL_PASSKEYS];
+    return { account, passkeys };
+  }
+  return { account: memoryAccount, passkeys: memoryPasskeys };
+}
+
+async function saveAccountState(
+  session: App.Locals['session'],
+  account: ReaderAccount,
+  passkeys: PasskeyRecord[]
+) {
+  memoryAccount = account;
+  memoryPasskeys = passkeys;
+  if (session) {
+    await session.set('readerAccount', account);
+    await session.set('passkeys', passkeys);
+  }
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { account, passkeys } = await getAccountState(session);
+
+  return new Response(
+    JSON.stringify({
+      account,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action } = body;
+    let { account, passkeys } = await getAccountState(session);
+
+    if (action === 'rename' || action === 'update') {
+      const { id, credentialId, displayName, name } = body;
+      const trimmedDisplayName = (displayName || '').trim();
+      if (!trimmedDisplayName) {
+        return new Response(
+          JSON.stringify({ error: 'Display name cannot be empty.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      let updatedKey: PasskeyRecord | null = null;
+      passkeys = passkeys.map((pk) => {
+        if (pk.id === id || (credentialId && pk.credentialId === credentialId)) {
+          updatedKey = {
+            ...pk,
+            displayName: trimmedDisplayName,
+            name: name ? String(name).trim() : pk.name,
+          };
+          return updatedKey;
+        }
+        return pk;
+      });
+
+      if (!updatedKey) {
+        return new Response(
+          JSON.stringify({ error: 'Passkey not found.' }),
+          { status: 404, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      await saveAccountState(session, account, passkeys);
+      return new Response(
+        JSON.stringify({
+          account,
+          passkeys,
+          updatedPasskey: updatedKey,
+          allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'remove' || action === 'delete') {
+      const { id, credentialId } = body;
+      const target = passkeys.find(
+        (pk) => pk.id === id || (credentialId && pk.credentialId === credentialId)
+      );
+
+      if (!target) {
+        return new Response(
+          JSON.stringify({ error: 'Passkey not found.' }),
+          { status: 404, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      passkeys = passkeys.filter((pk) => pk.id !== target.id);
+      await saveAccountState(session, account, passkeys);
+
+      return new Response(
+        JSON.stringify({
+          account,
+          passkeys,
+          removedPasskey: target,
+          removedCredentialId: target.credentialId,
+          allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'updateProfile') {
+      const { username, displayName } = body;
+      const trimmedDisplay = (displayName ?? account.displayName).trim();
+      const trimmedUsername = (username ?? account.username).trim();
+
+      if (!trimmedDisplay || !trimmedUsername) {
+        return new Response(
+          JSON.stringify({ error: 'Username and display name are required.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      account = {
+        ...account,
+        username: trimmedUsername,
+        email: trimmedUsername,
+        displayName: trimmedDisplay,
+      };
+
+      passkeys = passkeys.map((pk) => ({
+        ...pk,
+        name: trimmedUsername,
+      }));
+
+      await saveAccountState(session, account, passkeys);
+
+      return new Response(
+        JSON.stringify({
+          account,
+          passkeys,
+          allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'register' || action === 'add') {
+      const { displayName, credentialId, deviceType, backedUp } = body;
+      const newCredId =
+        credentialId ||
+        toBase64Url(`devtools-passkey-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);
+      const newPasskey: PasskeyRecord = {
+        id: `pk-${Date.now()}`,
+        credentialId: newCredId,
+        userId: account.userId,
+        name: account.username,
+        displayName: (displayName || 'Passkey on This Device').trim(),
+        deviceType: deviceType || 'Browser Platform Authenticator',
+        createdAt: new Date().toISOString(),
+        lastUsedAt: new Date().toISOString(),
+        backedUp: backedUp ?? true,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      };
+
+      passkeys = [newPasskey, ...passkeys];
+      await saveAccountState(session, account, passkeys);
+
+      return new Response(
+        JSON.stringify({
+          account,
+          passkeys,
+          addedPasskey: newPasskey,
+          allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'reset') {
+      account = { ...DEFAULT_READER_ACCOUNT };
+      passkeys = [...INITIAL_PASSKEYS];
+      await saveAccountState(session, account, passkeys);
+
+      return new Response(
+        JSON.stringify({
+          account,
+          passkeys,
+          allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({ error: `Unsupported action: ${action}` }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Invalid request payload' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
+
+export const PATCH: APIRoute = POST;
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    let { account, passkeys } = await getAccountState(session);
+    const { id, credentialId } = body;
+    const target = passkeys.find(
+      (pk) => pk.id === id || (credentialId && pk.credentialId === credentialId)
+    );
+
+    if (!target) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    passkeys = passkeys.filter((pk) => pk.id !== target.id);
+    await saveAccountState(session, account, passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        removedPasskey: target,
+        removedCredentialId: target.credentialId,
+        allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Invalid request payload' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
