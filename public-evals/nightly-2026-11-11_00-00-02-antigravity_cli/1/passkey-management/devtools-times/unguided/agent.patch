+                    className="p-3 bg-gray-50 border border-gray-200 rounded-md text-xs font-mono"
+                  >
+                    <div className="flex items-center justify-between gap-2 mb-1">
+                      <span className="font-semibold text-gray-900">{log.method}()</span>
+                      <span
+                        className={`px-2 py-0.5 rounded text-[11px] font-sans font-semibold ${
+                          log.executed
+                            ? 'bg-green-100 text-green-800'
+                            : 'bg-amber-100 text-amber-800'
+                        }`}
+                      >
+                        {log.executed ? 'Synced with Browser Authenticator' : 'Signal Prepared'}
+                      </span>
+                    </div>
+                    <pre className="text-[11px] text-gray-600 overflow-x-auto whitespace-pre-wrap">
+                      {JSON.stringify(log.payload)}
+                    </pre>
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+}
