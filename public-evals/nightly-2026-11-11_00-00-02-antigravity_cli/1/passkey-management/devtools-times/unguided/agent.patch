+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import {
+  DEFAULT_READER_ACCOUNT,
+  INITIAL_PASSKEYS,
+  type PasskeyRecord,
+  type ReaderAccount,
+} from '../utils/passkeys';
+
+let initialAccount: ReaderAccount = DEFAULT_READER_ACCOUNT;
+let initialPasskeys: PasskeyRecord[] = INITIAL_PASSKEYS;
+
+if (Astro.session) {
+  const sessionAccount = await Astro.session.get('readerAccount');
+  const sessionPasskeys = await Astro.session.get('passkeys');
+  if (sessionAccount) {
+    initialAccount = sessionAccount;
+  }
+  if (Array.isArray(sessionPasskeys)) {
+    initialPasskeys = sessionPasskeys;
+  }
+}
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <AccountSettings
+    client:load
+    initialAccount={initialAccount}
+    initialPasskeys={initialPasskeys}
+  />
+</Layout>
