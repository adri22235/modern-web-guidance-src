@@ -0,0 +1,64 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+import {
+  RP_ID,
+  RP_NAME,
+  getSignedInUser,
+  findCredentialsByUserId,
+  setChallenge,
+} from '../../../utils/passkey-store';
+
+export const POST: APIRoute = async ({ request }) => {
+  let isPromotionFlow = false;
+  try {
+    const body = await request.json();
+    isPromotionFlow = Boolean(body?.promotion);
+  } catch {
+    isPromotionFlow = false;
+  }
+
+  const user = getSignedInUser();
+  const existingCredentials = findCredentialsByUserId(user.passkeyUserId);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: new Uint8Array(Buffer.from(user.passkeyUserId, 'base64url')),
+    userName: user.name,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existingCredentials.map((cred) => ({
+      id: cred.id,
+      transports: cred.transports as AuthenticatorTransportFuture[],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+      ...(isPromotionFlow ? { authenticatorAttachment: 'platform' } : {}),
+    },
+  });
+
+  // Ensure user.id matches the exact Base64URL passkeyUserId and requireResidentKey is included
+  const responseOptions = {
+    ...options,
+    user: {
+      ...options.user,
+      id: user.passkeyUserId,
+    },
+    authenticatorSelection: {
+      ...options.authenticatorSelection,
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(isPromotionFlow ? { authenticatorAttachment: 'platform' } : {}),
+    },
+  };
+
+  setChallenge(responseOptions.challenge);
+
+  return new Response(JSON.stringify(responseOptions), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..fcedeec
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,114 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  RP_ID,
+  getSignedInUser,
+  getChallenge,
+  saveCredential,
+  isValidBase64Url,
+} from '../../../utils/passkey-store';
+import { resolveAaguidProvider } from '../../../utils/aaguids';
+
+export const POST: APIRoute = async ({ request, url }) => {
+  const user = getSignedInUser();
+  const expectedChallenge = getChallenge();
+
+  if (!expectedChallenge) {
+    return new Response(
+      JSON.stringify({ error: 'Registration challenge expired or missing.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  let body: any;
+  try {
+    body = await request.json();
+  } catch {
+    return new Response(JSON.stringify({ error: 'Invalid JSON payload.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  try {
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin: [url.origin, `http://${RP_ID}:4321`, `http://${RP_ID}:11224`, `https://${RP_ID}`],
+      expectedRPID: RP_ID,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey verification failed.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const { registrationInfo } = verification;
+    const {
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+    } = registrationInfo;
+
+    const credentialId = credential.id;
+    if (!isValidBase64Url(credentialId)) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid Base64URL credential ID.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const providerMetadata = resolveAaguidProvider(aaguid);
+    const now = Date.now();
+
+    const storedCredential = saveCredential({
+      id: credentialId,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid: aaguid || '00000000-0000-0000-0000-000000000000',
+      providerIcon: providerMetadata.providerIcon,
+      name: providerMetadata.name,
+      transports: credential.transports || ['internal', 'hybrid'],
+      registeredAt: now,
+      lastUsedAt: now,
+      counter: credential.counter,
+    });
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+        credential: storedCredential,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Verification error.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
