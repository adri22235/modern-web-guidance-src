+import { resolveAaguidProvider } from './aaguids';
+
+export interface StoredPasskeyCredential {
+  id: string; // Valid unpadded Base64URL-encoded credential ID
+  passkeyUserId: string; // Associated application user ID (unpadded Base64URL)
+  credentialPublicKey: string; // Base64URL-encoded public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export interface UserProfile {
+  id: string;
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // username / email
+  displayName: string; // reader display name
+}
+
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The DevTools Times';
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+// Encode any UTF-8 string into valid unpadded Base64URL
+export function toBase64Url(input: string): string {
+  return Buffer.from(input, 'utf8').toString('base64url');
+}
+
+const DEFAULT_USER_PASSKEY_ID = toBase64Url('reader-user-alex-rivera-01'); // 'cmVhZGVyLXVzZXItYWxleC1yaXZlcmEtMDE'
+
+const googleProvider = resolveAaguidProvider('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+const icloudProvider = resolveAaguidProvider('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+const onePasswordProvider = resolveAaguidProvider('bada5566-a7aa-401f-bd96-45619a55120d');
+
+interface StoreState {
+  user: UserProfile;
+  credentials: StoredPasskeyCredential[];
+  currentChallenge?: string;
+}
+
+const globalForPasskeys = globalThis as unknown as {
+  __devtoolsTimesPasskeyStore?: StoreState;
+};
+
+function createInitialStore(): StoreState {
+  const now = Date.now();
+  const dayMs = 24 * 60 * 60 * 1000;
+
+  return {
+    user: {
+      id: 'user-alex-rivera',
+      passkeyUserId: DEFAULT_USER_PASSKEY_ID,
+      name: 'alex.rivera@devtoolstimes.com',
+      displayName: 'Alex Rivera',
+    },
+    credentials: [
+      {
+        id: toBase64Url('cred-google-pm-workstation-01'),
+        passkeyUserId: DEFAULT_USER_PASSKEY_ID,
+        credentialPublicKey: toBase64Url('mock-public-key-google-pm-01'),
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        providerIcon: googleProvider.providerIcon,
+        name: googleProvider.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 45 * dayMs,
+        lastUsedAt: now - 1 * dayMs,
+        counter: 12,
+      },
+      {
+        id: toBase64Url('cred-icloud-keychain-macbook-02'),
+        passkeyUserId: DEFAULT_USER_PASSKEY_ID,
+        credentialPublicKey: toBase64Url('mock-public-key-icloud-02'),
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        providerIcon: icloudProvider.providerIcon,
+        name: icloudProvider.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 90 * dayMs,
+        lastUsedAt: now - 14 * dayMs,
+        counter: 5,
+      },
+      {
+        id: toBase64Url('cred-1password-vault-key-03'),
+        passkeyUserId: DEFAULT_USER_PASSKEY_ID,
+        credentialPublicKey: toBase64Url('mock-public-key-1password-03'),
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+        providerIcon: onePasswordProvider.providerIcon,
+        name: onePasswordProvider.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 120 * dayMs,
+        lastUsedAt: undefined,
+        counter: 0,
+      },
+    ],
+  };
+}
+
+function getStore(): StoreState {
+  if (!globalForPasskeys.__devtoolsTimesPasskeyStore) {
+    globalForPasskeys.__devtoolsTimesPasskeyStore = createInitialStore();
+  }
+  return globalForPasskeys.__devtoolsTimesPasskeyStore;
+}
+
+export function getSignedInUser(): UserProfile {
+  return getStore().user;
+}
+
+export function updateSignedInUser(updates: {
+  name?: string;
+  displayName?: string;
+}): UserProfile {
+  const store = getStore();
+  if (typeof updates.name === 'string' && updates.name.trim()) {
+    store.user.name = updates.name.trim();
+  }
+  if (typeof updates.displayName === 'string' && updates.displayName.trim()) {
+    store.user.displayName = updates.displayName.trim();
+  }
+  return store.user;
+}
+
+export function findCredentialsByUserId(passkeyUserId: string): StoredPasskeyCredential[] {
+  return getStore().credentials.filter((c) => c.passkeyUserId === passkeyUserId);
+}
+
+export function findCredentialById(id: string): StoredPasskeyCredential | undefined {
+  return getStore().credentials.find((c) => c.id === id);
+}
+
+export function saveCredential(credential: StoredPasskeyCredential): StoredPasskeyCredential {
+  const store = getStore();
+  const idx = store.credentials.findIndex((c) => c.id === credential.id);
+  if (idx >= 0) {
+    store.credentials[idx] = credential;
+  } else {
+    store.credentials.unshift(credential);
+  }
+  return credential;
+}
+
+export function deleteCredentialById(id: string): boolean {
+  const store = getStore();
+  const before = store.credentials.length;
+  store.credentials = store.credentials.filter((c) => c.id !== id);
+  return store.credentials.length < before;
+}
+
+export function setChallenge(challenge: string): void {
+  getStore().currentChallenge = challenge;
+}
+
+export function getChallenge(): string | undefined {
+  return getStore().currentChallenge;
+}
