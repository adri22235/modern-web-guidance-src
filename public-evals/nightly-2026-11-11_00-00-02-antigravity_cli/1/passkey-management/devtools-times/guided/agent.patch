+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': {
+    name: 'iCloud Keychain',
+    icon_light: APPLE_ICON,
+    icon_dark: APPLE_ICON,
+  },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': {
+    name: 'iCloud Keychain (Managed)',
+    icon_light: APPLE_ICON,
+    icon_dark: APPLE_ICON,
+  },
+  'bada5566-a7aa-401f-bd96-45619a55120d': {
+    name: '1Password',
+    icon_light: ONEPASSWORD_ICON,
+    icon_dark: ONEPASSWORD_ICON,
+  },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': {
+    name: 'Bitwarden',
+    icon_light: BITWARDEN_ICON,
+    icon_dark: BITWARDEN_ICON,
+  },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': {
+    name: 'Windows Hello',
+    icon_light: WINDOWS_ICON,
+    icon_dark: WINDOWS_ICON,
+  },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': {
+    name: 'Windows Hello',
+    icon_light: WINDOWS_ICON,
+    icon_dark: WINDOWS_ICON,
+  },
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': {
+    name: 'YubiKey 5 Series',
+    icon_light: YUBIKEY_ICON,
+    icon_dark: YUBIKEY_ICON,
+  },
+};
+
+export function resolveAaguidProvider(aaguid?: string): {
+  name: string;
+  providerIcon?: string;
+} {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = AAGUID_REGISTRY[aaguid.toLowerCase()];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
