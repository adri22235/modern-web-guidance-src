@@ -0,0 +1,722 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import { resolveAaguidProvider } from '../utils/aaguids';
+import type { StoredPasskeyCredential, UserProfile } from '../utils/passkey-store';
+
+interface CredentialsApiResponse {
+  rpId: string;
+  userId: string;
+  user?: UserProfile;
+  credentials: StoredPasskeyCredential[];
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+// Passive background synchronization of accepted credential IDs via WebAuthn Signal API
+export async function syncAcceptedCredentials(
+  rpId: string,
+  userId: string,
+  currentCredentialsList: StoredPasskeyCredential[]
+): Promise<void> {
+  if (typeof window === 'undefined') return;
+  const PK = window.PublicKeyCredential as any;
+  if (!PK || typeof PK.signalAllAcceptedCredentials !== 'function') return;
+
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return;
+  }
+
+  try {
+    await PK.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+// Passive background synchronization of user account details via WebAuthn Signal API
+export async function syncCurrentUserDetails(
+  rpId: string,
+  userId: string,
+  name: string,
+  displayName: string
+): Promise<void> {
+  if (typeof window === 'undefined') return;
+  const PK = window.PublicKeyCredential as any;
+  if (!PK || typeof PK.signalCurrentUserDetails !== 'function') return;
+
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn(
+      'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+    );
+    return;
+  }
+
+  try {
+    await PK.signalCurrentUserDetails({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      name,
+      displayName,
+    });
+  } catch (e) {
+    console.warn('SignalCurrentUserDetails sync warning:', e);
+  }
+}
+
+function formatEpochDate(epochMs?: number): string {
+  if (!epochMs) return 'Never used';
+  return new Date(epochMs).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+export default function PasskeyManagement() {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const [rpId, setRpId] = useState<string>('');
+  const [userId, setUserId] = useState<string>('');
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>([]);
+  const [loading, setLoading] = useState<boolean>(true);
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+
+  // Reader Account Profile state (for updating username/displayName & syncing with Signal API)
+  const [accountName, setAccountName] = useState<string>('alex.rivera@devtoolstimes.com');
+  const [accountDisplayName, setAccountDisplayName] = useState<string>('Alex Rivera');
+  const [savingProfile, setSavingProfile] = useState<boolean>(false);
+
+  // Per-passkey rename state
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(null);
+  const [editingNameValue, setEditingNameValue] = useState<string>('');
+  const [savingCredentialId, setSavingCredentialId] = useState<string | null>(null);
+  const [deletingCredentialId, setDeletingCredentialId] = useState<string | null>(null);
+
+  // Passkey creation capability state
+  const [canCreatePasskey, setCanCreatePasskey] = useState<boolean>(false);
+  const [capabilitiesChecked, setCapabilitiesChecked] = useState<boolean>(false);
+  const [creatingPasskey, setCreatingPasskey] = useState<boolean>(false);
+
+  const fetchCredentials = useCallback(async () => {
+    const response = await fetch(`${baseUrl}api/credentials`);
+    if (!response.ok) {
+      throw new Error('Failed to load registered passkeys.');
+    }
+    const data: CredentialsApiResponse = await response.json();
+    setRpId(data.rpId);
+    setUserId(data.userId);
+    setCredentials(data.credentials || []);
+    if (data.user) {
+      setAccountName(data.user.name);
+      setAccountDisplayName(data.user.displayName);
+    }
+    return data;
+  }, [baseUrl]);
+
+  useEffect(() => {
+    let isMounted = true;
+
+    async function init() {
+      // Load webauthn-polyfills on client for getClientCapabilities & parseCreationOptionsFromJSON
+      try {
+        await import('webauthn-polyfills');
+      } catch (e) {
+        console.warn('Could not load webauthn-polyfills:', e);
+      }
+
+      // Check platform authenticator & conditionalGet capabilities before showing Create Passkey button
+      let supported = false;
+      const PK = typeof window !== 'undefined' ? (window.PublicKeyCredential as any) : undefined;
+      if (PK && typeof PK.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PK.getClientCapabilities();
+          supported = Boolean(
+            capabilities?.passkeyPlatformAuthenticator &&
+              (capabilities?.conditionalGet ?? true)
+          );
+        } catch {
+          supported = false;
+        }
+      }
+      if (isMounted) {
+        setCanCreatePasskey(supported);
+        setCapabilitiesChecked(true);
+      }
+
+      // Fetch registered passkeys and synchronize accepted credentials on page load
+      try {
+        const data = await fetchCredentials();
+        if (isMounted) {
+          setLoading(false);
+        }
+        await syncAcceptedCredentials(data.rpId, data.userId, data.credentials || []);
+      } catch (err: any) {
+        if (isMounted) {
+          setLoading(false);
+          setStatusMessage({
+            type: 'error',
+            text: err?.message || 'Unable to load passkeys.',
+          });
+        }
+      }
+    }
+
+    init();
+    return () => {
+      isMounted = false;
+    };
+  }, [fetchCredentials]);
+
+  // Update individual passkey display name (server-side label update only)
+  const handleStartRename = (cred: StoredPasskeyCredential) => {
+    const providerInfo = resolveAaguidProvider(cred.aaguid);
+    setEditingCredentialId(cred.id);
+    setEditingNameValue(cred.name || providerInfo.name);
+    setStatusMessage(null);
+  };
+
+  const handleCancelRename = () => {
+    setEditingCredentialId(null);
+    setEditingNameValue('');
+  };
+
+  const handleSaveCredentialRename = async (credentialId: string) => {
+    const trimmed = editingNameValue.trim();
+    if (!trimmed) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Passkey display name cannot be empty.',
+      });
+      return;
+    }
+
+    setSavingCredentialId(credentialId);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(credentialId)}`,
+        {
+          method: 'PUT',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ name: trimmed }),
+        }
+      );
+
+      if (!response.ok) {
+        const errData = await response.json().catch(() => ({}));
+        throw new Error(errData.error || 'Failed to rename passkey.');
+      }
+
+      await fetchCredentials();
+      setEditingCredentialId(null);
+      setEditingNameValue('');
+      setStatusMessage({
+        type: 'success',
+        text: `Passkey display name updated to "${trimmed}".`,
+      });
+    } catch (err: any) {
+      setStatusMessage({
+        type: 'error',
+        text: err?.message || 'Could not update passkey name.',
+      });
+    } finally {
+      setSavingCredentialId(null);
+    }
+  };
+
+  // Delete a passkey and synchronize remaining credentials via signalAllAcceptedCredentials
+  const handleDeleteCredential = async (credentialId: string, credentialLabel: string) => {
+    setDeletingCredentialId(credentialId);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(credentialId)}`,
+        {
+          method: 'DELETE',
+        }
+      );
+
+      if (!response.ok) {
+        const errData = await response.json().catch(() => ({}));
+        throw new Error(errData.error || 'Failed to remove passkey.');
+      }
+
+      const updatedData = await fetchCredentials();
+      await syncAcceptedCredentials(
+        updatedData.rpId,
+        updatedData.userId,
+        updatedData.credentials || []
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Removed passkey "${credentialLabel}" and synchronized with your browser authenticator.`,
+      });
+    } catch (err: any) {
+      setStatusMessage({
+        type: 'error',
+        text: err?.message || 'Could not remove passkey.',
+      });
+    } finally {
+      setDeletingCredentialId(null);
+    }
+  };
+
+  // Update reader account username / display name and sync via signalCurrentUserDetails
+  const handleUpdateUserProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedName = accountName.trim();
+    const trimmedDisplayName = accountDisplayName.trim();
+    if (!trimmedName || !trimmedDisplayName) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Both username and reader display name are required.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${baseUrl}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          name: trimmedName,
+          displayName: trimmedDisplayName,
+        }),
+      });
+
+      if (!response.ok) {
+        const errData = await response.json().catch(() => ({}));
+        throw new Error(errData.error || 'Failed to update account profile.');
+      }
+
+      const data = await response.json();
+      await syncCurrentUserDetails(
+        data.rpId,
+        data.userId,
+        trimmedName,
+        trimmedDisplayName
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: 'Account display name updated and synchronized with your passkey authenticator.',
+      });
+    } catch (err: any) {
+      setStatusMessage({
+        type: 'error',
+        text: err?.message || 'Could not update reader profile.',
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  // Register a new passkey from the management panel (omits authenticatorAttachment so security keys also work)
+  const handleCreatePasskey = async () => {
+    setCreatingPasskey(true);
+    setStatusMessage(null);
+
+    try {
+      const PK = window.PublicKeyCredential as any;
+      if (!PK || typeof PK.getClientCapabilities !== 'function') {
+        setCanCreatePasskey(false);
+        return;
+      }
+
+      const capabilities = await PK.getClientCapabilities();
+      if (!capabilities?.passkeyPlatformAuthenticator || !capabilities?.conditionalGet) {
+        setCanCreatePasskey(false);
+        return;
+      }
+
+      const optionsRes = await fetch(`${baseUrl}api/passkeys/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ promotion: false }),
+      });
+
+      if (!optionsRes.ok) {
+        throw new Error('Could not generate passkey registration options.');
+      }
+
+      const creationOptionsJSON = await optionsRes.json();
+      const publicKey = PK.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential: any;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err: any) {
+        if (err?.name === 'InvalidStateError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'A passkey already exists on this authenticator for your account.',
+          });
+        } else if (err?.name === 'SecurityError') {
+          setStatusMessage({
+            type: 'error',
+            text: 'Configuration RP ID or Secure Context error while creating passkey.',
+          });
+        } else if (err?.name === 'NotAllowedError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'Passkey creation was cancelled.',
+          });
+        } else if (err?.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        }
+        return;
+      }
+
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const verifyRes = await fetch(`${baseUrl}api/passkeys/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyRes.ok) {
+          if (typeof PK.signalUnknownCredential === 'function') {
+            try {
+              await PK.signalUnknownCredential({
+                rpId: publicKey.rp.id,
+                credentialId: encodedResponse.id,
+              });
+            } catch (sigErr) {
+              console.warn('SignalUnknownCredential warning:', sigErr);
+            }
+          }
+          const errBody = await verifyRes.json().catch(() => ({}));
+          throw new Error(errBody.error || 'Server verification of the new passkey failed.');
+        }
+
+        const updatedData = await fetchCredentials();
+        await syncAcceptedCredentials(
+          updatedData.rpId,
+          updatedData.userId,
+          updatedData.credentials || []
+        );
+
+        setStatusMessage({
+          type: 'success',
+          text: 'New passkey registered and synchronized with your authenticator.',
+        });
+      } catch (serverErr: any) {
+        if (typeof PK.signalUnknownCredential === 'function') {
+          try {
+            await PK.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: encodedResponse.id,
+            });
+          } catch (sigErr) {
+            console.warn('SignalUnknownCredential warning:', sigErr);
+          }
+        }
+        setStatusMessage({
+          type: 'error',
+          text: serverErr?.message || 'Failed to verify new passkey with the server.',
+        });
+      }
+    } catch (err: any) {
+      setStatusMessage({
+        type: 'error',
+        text: err?.message || 'An unexpected error occurred during passkey registration.',
+      });
+    } finally {
+      setCreatingPasskey(false);
+    }
+  };
+
+  return (
+    <div className="space-y-8" id="passkey-management-section">
+      {statusMessage && (
+        <div
+          role="alert"
+          className={`p-4 rounded-md border text-sm ${
+            statusMessage.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-blue-50 border-blue-200 text-blue-800'
+          }`}
+        >
+          {statusMessage.text}
+        </div>
+      )}
+
+      {/* Reader Profile & Authenticator Identity Sync Card */}
+      <section
+        aria-labelledby="reader-profile-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm p-6"
+      >
+        <div className="border-b border-gray-200 pb-4 mb-5">
+          <h2 id="reader-profile-heading" className="text-xl font-bold text-gray-900">
+            Reader Profile &amp; Authenticator Identity
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Update how your name and username appear across The DevTools Times and keep your
+            browser passkey authenticator synchronized automatically.
+          </p>
+        </div>
+
+        <form onSubmit={handleUpdateUserProfile} className="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display Name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={accountDisplayName}
+              onChange={(e) => setAccountDisplayName(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Account Username / Email
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              value={accountName}
+              onChange={(e) => setAccountName(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div className="md:col-span-2 flex justify-end pt-2">
+            <button
+              type="submit"
+              disabled={savingProfile}
+              className="py-2 px-4 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 cursor-pointer"
+            >
+              {savingProfile ? 'Saving & Syncing...' : 'Update Display Name'}
+            </button>
+          </div>
+        </form>
+      </section>
+
+      {/* Registered Passkeys Card */}
+      <section
+        aria-labelledby="registered-passkeys-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm p-6"
+      >
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-4 mb-6 gap-4">
+          <div>
+            <h2 id="registered-passkeys-heading" className="text-xl font-bold text-gray-900">
+              Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Sign in faster and more securely across your devices. Removing or renaming keys here
+              keeps your browser authenticator in sync.
+            </p>
+          </div>
+
+          {canCreatePasskey ? (
+            <button
+              id="create-passkey"
+              type="button"
+              onClick={handleCreatePasskey}
+              disabled={creatingPasskey}
+              className="inline-flex items-center justify-center py-2 px-4 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 whitespace-nowrap cursor-pointer"
+            >
+              <svg
+                className="w-4 h-4 mr-2"
+                fill="none"
+                stroke="currentColor"
+                viewBox="0 0 24 24"
+                aria-hidden="true"
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M12 4v16m8-8H4"
+                />
+              </svg>
+              {creatingPasskey ? 'Registering...' : 'Create passkey'}
+            </button>
+          ) : capabilitiesChecked ? (
+            <div className="text-xs text-gray-600 bg-gray-50 border border-gray-200 rounded-md px-3 py-2 max-w-xs">
+              Passkey creation is unavailable on this browser or device. Consider enrolling standard
+              multi-factor authentication (MFA) instead.
+            </div>
+          ) : null}
+        </div>
+
+        {loading ? (
+          <div className="py-8 text-center text-sm text-gray-500">Loading your registered passkeys...</div>
+        ) : credentials.length === 0 ? (
+          <div className="py-10 text-center bg-gray-50 rounded-lg border border-dashed border-gray-300">
+            <p className="text-base font-medium text-gray-800">No passkeys found</p>
+            <p className="text-sm text-gray-500 mt-1">
+              You have no registered passkeys on your DevTools Times account.
+            </p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200" aria-label="Registered passkeys">
+            {credentials.map((cred) => {
+              const providerInfo = resolveAaguidProvider(cred.aaguid);
+              const displayLabel = cred.name || providerInfo.name;
+              const iconSrc = cred.providerIcon || providerInfo.providerIcon;
+              const isEditing = editingCredentialId === cred.id;
+              const isDeleting = deletingCredentialId === cred.id;
+              const isSaving = savingCredentialId === cred.id;
+
+              return (
+                <li
+                  key={cred.id}
+                  data-credential-id={cred.id}
+                  className="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
+                >
+                  <div className="flex items-start space-x-4">
+                    {/* Provider Icon */}
+                    <div className="w-10 h-10 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center flex-shrink-0 mt-0.5">
+                      {iconSrc ? (
+                        <img
+                          src={iconSrc}
+                          alt={`${providerInfo.name} icon`}
+                          className="w-5 h-5 object-contain"
+                        />
+                      ) : (
+                        <svg
+                          className="w-5 h-5 text-gray-600"
+                          fill="none"
+                          stroke="currentColor"
+                          viewBox="0 0 24 24"
+                          aria-hidden="true"
+                        >
+                          <path
+                            strokeLinecap="round"
+                            strokeLinejoin="round"
+                            strokeWidth={2}
+                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                          />
+                        </svg>
+                      )}
+                    </div>
+
+                    {/* Passkey Name & Metadata */}
+                    <div className="flex-1 min-w-0">
+                      {isEditing ? (
+                        <div className="flex flex-wrap items-center gap-2">
+                          <label htmlFor={`rename-input-${cred.id}`} className="sr-only">
+                            Passkey display name
+                          </label>
+                          <input
+                            id={`rename-input-${cred.id}`}
+                            type="text"
+                            value={editingNameValue}
+                            onChange={(e) => setEditingNameValue(e.target.value)}
+                            className="px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                            autoFocus
+                          />
+                          <button
+                            type="button"
+                            disabled={isSaving}
+                            onClick={() => handleSaveCredentialRename(cred.id)}
+                            className="px-3 py-1.5 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800 disabled:opacity-60 cursor-pointer"
+                          >
+                            {isSaving ? 'Saving...' : 'Save'}
+                          </button>
+                          <button
+                            type="button"
+                            onClick={handleCancelRename}
+                            className="px-3 py-1.5 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-50 cursor-pointer"
+                          >
+                            Cancel
+                          </button>
+                        </div>
+                      ) : (
+                        <div className="flex items-center flex-wrap gap-2">
+                          <h3 className="text-base font-semibold text-gray-900">{displayLabel}</h3>
+                          {cred.credentialBackedUp && (
+                            <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">
+                              Synced
+                            </span>
+                          )}
+                          {displayLabel !== providerInfo.name && (
+                            <span className="text-xs text-gray-500">({providerInfo.name})</span>
+                          )}
+                        </div>
+                      )}
+
+                      <div className="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
+                        <span>
+                          Registered: <strong className="font-medium text-gray-700">{formatEpochDate(cred.registeredAt)}</strong>
+                        </span>
+                        <span>
+                          Last used: <strong className="font-medium text-gray-700">{formatEpochDate(cred.lastUsedAt)}</strong>
+                        </span>
+                      </div>
+                    </div>
+                  </div>
+
+                  {/* Per-Item Actions: Rename & Delete */}
+                  <div className="flex items-center space-x-2 self-end sm:self-center">
+                    {!isEditing && (
+                      <button
+                        type="button"
+                        onClick={() => handleStartRename(cred)}
+                        aria-label={`Rename ${displayLabel}`}
+                        className="px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer"
+                      >
+                        Rename
+                      </button>
+                    )}
+                    <button
+                      type="button"
+                      disabled={isDeleting}
+                      onClick={() => handleDeleteCredential(cred.id, displayLabel)}
+                      aria-label={`Delete ${displayLabel}`}
+                      className="px-3 py-1.5 text-xs font-semibold text-red-700 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 disabled:opacity-60 cursor-pointer"
+                    >
+                      {isDeleting ? 'Removing...' : 'Delete'}
+                    </button>
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+
+        {rpId && (
+          <div className="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
+            <span>Authenticator sync active for RP ID: {rpId}</span>
+            <span>WebAuthn Signal API ready</span>
+          </div>
+        )}
+      </section>
+    </div>
+  );
+}
