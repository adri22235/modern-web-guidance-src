+  <script type="module">
+    // Out-of-order batch of coffee order events collected from distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps (including sub-millisecond events
+    // within the exact same millisecond that would collide under legacy Date parsing).
+    const rawOrderEvents = [
+      {
+        nodeId: 'roastery-queue-02',
+        eventType: 'barista.ticket.queued',
+        orderItem: 'Order #4092 — Maple Oat Latte (Double Shot)',
+        ts: '2026-11-11T08:15:30.000489120Z',
+      },
+      {
+        nodeId: 'order-gateway-01',
+        eventType: 'order.request.received',
+        orderItem: 'Order #4092 — Maple Oat Latte (Double Shot)',
+        ts: '2026-11-11T08:15:30.000102050Z',
+      },
+      {
+        nodeId: 'barista-dispatch-01',
+        eventType: 'espresso.extraction.ready',
+        orderItem: 'Order #4092 — Maple Oat Latte (Double Shot)',
+        ts: '2026-11-11T08:15:30.001250900Z',
+      },
+      {
+        nodeId: 'inventory-svc-03',
+        eventType: 'beans.reserve.confirmed',
+        orderItem: 'Order #4092 — Vermont Maple & Oat Batch',
+        ts: '2026-11-11T08:15:30.000105506Z',
+      },
+      {
+        nodeId: 'payment-processor-02',
+        eventType: 'payment.ledger.settled',
+        orderItem: 'Order #4092 — Auth & Capture ($6.75)',
+        ts: '2026-11-11T08:15:30.000482000Z',
+      },
+      {
+        nodeId: 'rewards-engine-01',
+        eventType: 'loyalty.points.accrued',
+        orderItem: 'Order #4092 — +68 Daily Grind Stars',
+        ts: '2026-11-11T08:15:30.000489120Z',
+      },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    // 1. Parse recorded timestamps as Temporal.Instant (preserving full nanosecond precision)
+    function parseOrderEvents(rawBatch) {
+      return rawBatch.map((evt) => ({
+        ...evt,
+        timestamp: Temporal.Instant.from(evt.ts),
+      }));
+    }
+
+    // 2. Sort events chronologically using Temporal.Instant.compare
+    function sequenceEvents(items) {
+      return [...items].sort((a, b) =>
+        Temporal.Instant.compare(a.timestamp, b.timestamp)
+      );
+    }
+
+    // 3. Calculate intervals between consecutive events with .since() and format with .toLocaleString()
+    function analyzeTrace(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            isoTimestamp: curr.timestamp.toString(),
+            intervalDuration: null,
+            intervalFormatted: 'Initial event (0ns)',
+            transitionLabel: `${curr.eventType} (start)`,
+            isSimultaneous: false,
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        const gap = curr.timestamp.since(prev.timestamp);
+        const formattedGap = isSimultaneous
+          ? '0ns (simultaneous)'
+          : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`;
+
+        return {
+          ...curr,
+          isoTimestamp: curr.timestamp.toString(),
+          intervalDuration: gap,
+          intervalFormatted: formattedGap,
+          transitionLabel: `${prev.eventType} → ${curr.eventType}`,
+          isSimultaneous,
+        };
+      });
+    }
+
+    function renderTrace() {
+      const parsed = parseOrderEvents(rawOrderEvents);
+      const sorted = sequenceEvents(parsed);
+      const analyzed = analyzeTrace(sorted);
+
+      const firstInstant = sorted[0].timestamp;
+      const lastInstant = sorted[sorted.length - 1].timestamp;
+      const totalSpan = lastInstant.since(firstInstant);
+
+      const summaryEl = document.getElementById('trace-summary');
+      const resultsEl = document.getElementById('trace-results');
+      const tbodyEl = document.getElementById('trace-tbody');
+
+      tbodyEl.replaceChildren();
+
+      for (const [idx, item] of analyzed.entries()) {
+        const tr = document.createElement('tr');
+
+        const indexTd = document.createElement('td');
+        indexTd.textContent = String(idx + 1);
+
+        const nodeTd = document.createElement('td');
+        const nodeCode = document.createElement('code');
+        nodeCode.className = 'trace-code';
+        nodeCode.textContent = item.nodeId;
+        nodeTd.appendChild(nodeCode);
+
+        const eventTd = document.createElement('td');
+        const eventCode = document.createElement('code');
+        eventCode.className = 'trace-code';
+        eventCode.textContent = item.eventType;
+        eventTd.appendChild(eventCode);
+
+        const detailsTd = document.createElement('td');
+        detailsTd.textContent = item.orderItem;
+
+        const tsTd = document.createElement('td');
+        const timeEl = document.createElement('time');
+        timeEl.dateTime = item.isoTimestamp;
+        timeEl.className = 'trace-code';
+        timeEl.textContent = item.isoTimestamp;
+        tsTd.appendChild(timeEl);
+
+        const intervalTd = document.createElement('td');
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = 'interval-badge';
+        badgeSpan.title = item.transitionLabel;
+        if (item.intervalDuration) {
+          const durationTimeEl = document.createElement('time');
+          durationTimeEl.dateTime = item.intervalDuration.toString();
+          durationTimeEl.textContent = item.intervalFormatted;
+          badgeSpan.appendChild(durationTimeEl);
+        } else {
+          badgeSpan.textContent = item.intervalFormatted;
+        }
+        intervalTd.appendChild(badgeSpan);
+
+        tr.append(indexTd, nodeTd, eventTd, detailsTd, tsTd, intervalTd);
+        tbodyEl.appendChild(tr);
+      }
+
+      summaryEl.textContent = `Sorted ${analyzed.length} distributed events chronologically with nanosecond precision. Total pipeline span: ${totalSpan.toLocaleString('en-US', { style: 'narrow' })}.`;
+      summaryEl.hidden = false;
+      resultsEl.hidden = false;
+    }
+
+    function initializeApp() {
+      const loadBtn = document.getElementById('load-order-events-btn');
+      if (!loadBtn) return;
+
+      loadBtn.addEventListener('click', async () => {
+        await ensureTemporal();
+        renderTrace();
+      });
+    }
+
+    // Check if Temporal is supported natively and initialize
+    (async () => {
+      initializeApp();
+      await ensureTemporal();
+    })();
+  </script>
 </body>
 
