diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,111 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        price: "$5.75",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        url: "/menu/seasonal"
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        price: "$3.50",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        url: "/menu/espresso"
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Coffee",
+        price: "$4.75",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    function getMenuItems() {
+      const cards = Array.from(document.querySelectorAll(".card"));
+      if (cards.length === 0) return menuItems;
+
+      return cards.map((card) => {
+        const name = card.querySelector("h3")?.textContent?.trim() ?? "";
+        const description = card.querySelector("p")?.textContent?.trim() ?? "";
+        const url = card.querySelector("a")?.getAttribute("href") ?? "";
+        const catalogEntry = menuItems.find(
+          (entry) => entry.name.toLowerCase() === name.toLowerCase()
+        );
+        return {
+          ...catalogEntry,
+          name,
+          description,
+          url
+        };
+      });
+    }
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      window.addEventListener(
+        "pagehide",
+        () => {
+          controller.abort();
+        },
+        { once: true }
+      );
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Looks up details for a coffee shop menu item. Use when the user asks about a specific drink on the menu.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "Name of the menu item to look up."
+              }
+            },
+            required: ["itemName"]
+          },
+          execute({ itemName } = {}) {
+            if (typeof itemName !== "string" || !itemName.trim()) {
+              const items = getMenuItems();
+              return {
+                error: "Please provide the name of a menu item to look up.",
+                availableItems: items.map((entry) => entry.name)
+              };
+            }
+
+            const items = getMenuItems();
+            const normalizedQuery = itemName.trim().toLowerCase();
+            const item = items.find(
+              (entry) => entry.name.toLowerCase() === normalizedQuery
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${itemName}" not found.`,
+                availableItems: items.map((entry) => entry.name)
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true
+          }
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
