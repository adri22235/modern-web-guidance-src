diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,234 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const DEFAULT_MENU_ITEMS = [
+        {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          category: 'Seasonal Favorites',
+          price: '$5.50',
+          url: '/menu/seasonal'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          category: 'Seasonal Favorites',
+          price: '$3.75',
+          url: '/menu/espresso'
+        },
+        {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          category: 'Seasonal Favorites',
+          price: '$4.50',
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      function getMenuItems() {
+        const itemsByName = new Map();
+
+        for (const item of DEFAULT_MENU_ITEMS) {
+          itemsByName.set(item.name.toLowerCase(), { ...item });
+        }
+
+        const cards = document.querySelectorAll('.card');
+        cards.forEach((card) => {
+          const nameEl = card.querySelector('h3');
+          const descEl = card.querySelector('p');
+          const linkEl = card.querySelector('a');
+          const name = nameEl ? nameEl.textContent.trim() : '';
+          if (!name) return;
+
+          const key = name.toLowerCase();
+          const existing = itemsByName.get(key) || {
+            name,
+            category: 'Seasonal Favorites',
+            price: '$4.50'
+          };
+
+          itemsByName.set(key, {
+            ...existing,
+            name,
+            description: descEl ? descEl.textContent.trim() : existing.description,
+            url: linkEl ? linkEl.getAttribute('href') : existing.url
+          });
+        });
+
+        return Array.from(itemsByName.values());
+      }
+
+      function findMenuItemByName(input) {
+        const rawName =
+          typeof input === 'string'
+            ? input
+            : input?.name ||
+              input?.itemName ||
+              input?.item ||
+              input?.menuItem ||
+              input?.query ||
+              (input && typeof input === 'object'
+                ? Object.values(input).find((v) => typeof v === 'string')
+                : '') ||
+              '';
+
+        const normalizedQuery = String(rawName).trim().toLowerCase();
+        const items = getMenuItems();
+
+        if (!normalizedQuery) {
+          return {
+            found: false,
+            error: 'Please provide the name of a menu item to look up.',
+            availableItems: items.map((item) => item.name),
+            content: [
+              {
+                type: 'text',
+                text: 'Please provide the name of a menu item to look up.'
+              }
+            ]
+          };
+        }
+
+        const matchedItem =
+          items.find((item) => item.name.toLowerCase() === normalizedQuery) ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalizedQuery) ||
+              normalizedQuery.includes(item.name.toLowerCase())
+          );
+
+        if (!matchedItem) {
+          const message = `Menu item "${rawName}" was not found. Available items: ${items
+            .map((item) => item.name)
+            .join(', ')}.`;
+          return {
+            found: false,
+            error: message,
+            availableItems: items.map((item) => item.name),
+            content: [
+              {
+                type: 'text',
+                text: message
+              }
+            ]
+          };
+        }
+
+        const detailText = `${matchedItem.name}: ${matchedItem.description} (Category: ${matchedItem.category}, Price: ${matchedItem.price}, Details URL: ${matchedItem.url})`;
+
+        return {
+          found: true,
+          name: matchedItem.name,
+          description: matchedItem.description,
+          category: matchedItem.category,
+          price: matchedItem.price,
+          url: matchedItem.url,
+          details: detailText,
+          content: [
+            {
+              type: 'text',
+              text: JSON.stringify(matchedItem)
+            }
+          ]
+        };
+      }
+
+      const TOOL_NAME = 'get_menu_item_details';
+      const abortController = new AbortController();
+      let toolRegistration = null;
+      let isRegistered = false;
+      let isCleanedUp = false;
+
+      const menuItemTool = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item at The Daily Grind (such as the Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by its name.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up (e.g., "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew").'
+            }
+          },
+          required: ['name']
+        },
+        execute: async (input) => {
+          return findMenuItemByName(input);
+        }
+      };
+
+      function registerMenuItemTool() {
+        if (isRegistered) return;
+        const modelContext = navigator.modelContext || document.modelContext;
+        if (!modelContext || typeof modelContext.registerTool !== 'function') {
+          return;
+        }
+
+        isRegistered = true;
+        isCleanedUp = false;
+
+        try {
+          toolRegistration = modelContext.registerTool(menuItemTool, {
+            signal: abortController.signal
+          });
+          if (toolRegistration && typeof toolRegistration.then === 'function') {
+            toolRegistration
+              .then((resolved) => {
+                if (resolved) {
+                  toolRegistration = resolved;
+                }
+              })
+              .catch(() => {});
+          }
+        } catch (err) {
+          console.error('Failed to register menu item lookup tool:', err);
+        }
+      }
+
+      function cleanupMenuItemTool() {
+        if (isCleanedUp) return;
+        isCleanedUp = true;
+
+        try {
+          abortController.abort();
+        } catch (err) {}
+
+        try {
+          if (typeof toolRegistration === 'function') {
+            toolRegistration();
+          } else if (toolRegistration && typeof toolRegistration === 'object') {
+            if (typeof toolRegistration.unregister === 'function') {
+              toolRegistration.unregister();
+            } else if (typeof toolRegistration.deactivate === 'function') {
+              toolRegistration.deactivate();
+            } else if (typeof toolRegistration.dispose === 'function') {
+              toolRegistration.dispose();
+            }
+          }
+        } catch (err) {}
+
+        try {
+          const modelContext = navigator.modelContext || document.modelContext;
+          if (modelContext && typeof modelContext.unregisterTool === 'function') {
+            modelContext.unregisterTool(TOOL_NAME);
+          }
+        } catch (err) {}
+      }
+
+      registerMenuItemTool();
+      window.addEventListener('DOMContentLoaded', registerMenuItemTool);
+      window.addEventListener('load', registerMenuItemTool);
+
+      window.addEventListener('beforeunload', cleanupMenuItemTool);
+      window.addEventListener('pagehide', cleanupMenuItemTool);
+      window.addEventListener('unload', cleanupMenuItemTool);
+    })();
+  </script>
 </body>
 
 </html>
