+
+  .remove-btn {
+    font: inherit;
+    font-size: 0.8rem;
+    color: #b71c1c;
+    background: transparent;
+    border: 1px solid rgba(183, 28, 28, 0.3);
+    border-radius: 6px;
+    padding: 4px 8px;
+    cursor: pointer;
