+
+  connectedCallback() {
+    if (this.hasAttribute('active-category')) {
+      this.#category = this.getAttribute('active-category') || 'all';
+    }
+    if (this.hasAttribute('search')) {
+      this.#search = this.getAttribute('search') || '';
+    }
+    this.#applyFilters();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'active-category') {
+      this.#category = newVal || 'all';
+    } else if (name === 'search') {
+      this.#search = newVal || '';
+    }
+    if (this.isConnected) {
+      this.#applyFilters();
+    }
+  }
+
+  get activeCategory() {
+    return this.#category;
+  }
+  set activeCategory(val) {
+    this.#category = val || 'all';
+    this.setAttribute('active-category', this.#category);
+  }
+
+  #bindEvents() {
+    const pills = this.shadowRoot.querySelectorAll('.pill-btn');
+    const searchInput = this.shadowRoot.getElementById('search-input');
+    const resetBtn = this.shadowRoot.getElementById('reset-btn');
+    const cardsSlot = this.shadowRoot.getElementById('cards-slot');
+
+    pills.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        this.activeCategory = btn.dataset.filter || 'all';
+      });
+    });
+
+    searchInput?.addEventListener('input', (e) => {
+      this.#search = e.target.value.trim();
+      this.#applyFilters();
+    });
+
+    resetBtn?.addEventListener('click', () => {
+      this.#search = '';
+      if (searchInput) searchInput.value = '';
+      this.activeCategory = 'all';
+    });
+
+    cardsSlot?.addEventListener('slotchange', () => {
+      this.#applyFilters();
+    });
+
+    this.addEventListener('coffee-favorite-change', () => {
+      if (this.#category === 'favorites') {
+        this.#applyFilters();
+      }
+    });
+  }
+
+  #getCards() {
+    const slot = this.shadowRoot.getElementById('cards-slot');
+    if (!slot) return [];
+    return slot
+      .assignedElements({ flatten: true })
+      .filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+  }
+
+  #applyFilters() {
+    const pills = this.shadowRoot.querySelectorAll('.pill-btn');
+    pills.forEach((btn) => {
+      const isSelected = btn.dataset.filter === this.#category;
+      btn.setAttribute('aria-pressed', String(isSelected));
+    });
+
+    const cards = this.#getCards();
+    const query = this.#search.toLowerCase();
+    let visibleCount = 0;
+
+    cards.forEach((card) => {
+      const cardCat = (card.getAttribute('category') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited');
+
+      const matchesCategory =
+        this.#category === 'all' ||
+        (this.#category === 'favorites' ? isFav : cardCat === this.#category);
+
+      const searchableText = [
+        card.getAttribute('name') || '',
+        card.getAttribute('roast') || '',
+        card.getAttribute('notes') || '',
+        card.textContent || '',
+      ]
+        .join(' ')
+        .toLowerCase();
+
+      const matchesQuery = !query || searchableText.includes(query);
+      const visible = matchesCategory && matchesQuery;
+
+      card.hidden = !visible;
+      if (visible) visibleCount++;
+    });
+
+    const countEl = this.shadowRoot.getElementById('results-count');
+    if (countEl) {
+      countEl.textContent = `Showing ${visibleCount} of ${cards.length} artisanal coffees`;
+    }
+
+    const emptyState = this.shadowRoot.getElementById('empty-state');
+    if (emptyState) {
+      emptyState.hidden = visibleCount > 0 || cards.length === 0;
+    }
+  }
