+
+const orderDrawerTemplate = document.createElement('template');
+orderDrawerTemplate.innerHTML = `
+  <button type="button" class="trigger-btn" id="open-drawer-btn" part="trigger" aria-haspopup="dialog">
+    <span>Your Cup</span>
+    <span class="count-pill" id="order-count" aria-live="polite">0</span>
+  </button>
+
+  <div class="toast" id="order-toast" role="status" aria-live="polite" hidden></div>
+
+  <dialog id="order-dialog" aria-labelledby="drawer-title">
+    <div class="drawer-layout">
+      <div class="drawer-header">
+        <h2 id="drawer-title">Your Daily Grind Order</h2>
+        <button type="button" class="close-btn" id="close-drawer-btn" aria-label="Close order drawer">Close</button>
+      </div>
+      <div class="drawer-body">
+        <p id="empty-order-msg">Your cup is currently empty. Add a seasonal favorite from the menu!</p>
+        <ul class="item-list" id="order-list"></ul>
+      </div>
+      <div class="drawer-footer">
+        <div class="total-row">
+          <span>Estimated Total</span>
+          <span id="order-total">$0.00</span>
+        </div>
+        <a href="/order-online" class="checkout-link" id="checkout-link">Proceed to Pickup Order</a>
+      </div>
+    </div>
+  </dialog>
+`;
+
+export class GrindOrderDrawer extends HTMLElement {
+  #items = [];
+  #toastTimer = null;
+  #onDocOrderAdd;
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [orderDrawerSheet];
+      this.shadowRoot.append(orderDrawerTemplate.content.cloneNode(true));
+    }
+
+    this.#onDocOrderAdd = (e) => {
+      if (e.detail) {
+        this.addItem(e.detail);
+      }
+    };
+
+    this.#bindEvents();
+  }
+
+  connectedCallback() {
+    document.addEventListener('coffee-order-add', this.#onDocOrderAdd);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('coffee-order-add', this.#onDocOrderAdd);
+    if (this.#toastTimer) {
+      clearTimeout(this.#toastTimer);
+    }
+  }
+
+  get items() {
+    return [...this.#items];
+  }
+
+  addItem(item) {
+    this.#items.push({
+      id: `${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+      name: item.name || 'Coffee',
+      size: item.size || 'medium',
+      price: Number(item.price) || 4.5,
+    });
+    this.#render();
+    this.#showToast(`Added ${item.name} (${item.size}) to your order.`);
+  }
+
+  removeItem(id) {
+    this.#items = this.#items.filter((entry) => entry.id !== id);
+    this.#render();
+  }
+
+  open() {
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  }
+
+  close() {
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+    if (dialog && dialog.open) {
+      dialog.close();
+    }
+  }
+
+  #showToast(msg) {
+    const toast = this.shadowRoot.getElementById('order-toast');
+    if (!toast) return;
+    toast.textContent = msg;
+    toast.hidden = false;
+    if (this.#toastTimer) clearTimeout(this.#toastTimer);
+    this.#toastTimer = setTimeout(() => {
+      toast.hidden = true;
+    }, 3200);
+  }
+
+  #bindEvents() {
+    const openBtn = this.shadowRoot.getElementById('open-drawer-btn');
+    const closeBtn = this.shadowRoot.getElementById('close-drawer-btn');
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+
+    openBtn?.addEventListener('click', () => this.open());
+    closeBtn?.addEventListener('click', () => this.close());
+
+    dialog?.addEventListener('click', (e) => {
+      if (e.target === dialog) {
+        this.close();
+      }
+    });
+  }
+
+  #render() {
+    const countEl = this.shadowRoot.getElementById('order-count');
+    const emptyMsg = this.shadowRoot.getElementById('empty-order-msg');
+    const listEl = this.shadowRoot.getElementById('order-list');
+    const totalEl = this.shadowRoot.getElementById('order-total');
+
+    if (countEl) {
+      countEl.textContent = String(this.#items.length);
+    }
+
+    if (emptyMsg) {
+      emptyMsg.hidden = this.#items.length > 0;
+    }
+
+    if (listEl) {
+      listEl.replaceChildren();
+      this.#items.forEach((item) => {
+        const li = document.createElement('li');
+        li.className = 'order-item';
+
+        const info = document.createElement('div');
+        info.className = 'item-info';
+
+        const title = document.createElement('strong');
+        title.textContent = item.name;
+
+        const meta = document.createElement('span');
+        meta.className = 'item-meta';
+        meta.textContent = `Size: ${item.size} • $${item.price.toFixed(2)}`;
+
+        info.append(title, meta);
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'remove-btn';
+        removeBtn.textContent = 'Remove';
+        removeBtn.setAttribute('aria-label', `Remove ${item.name} from order`);
+        removeBtn.addEventListener('click', () => this.removeItem(item.id));
+
+        li.append(info, removeBtn);
+        listEl.append(li);
+      });
+    }
+
+    if (totalEl) {
+      const sum = this.#items.reduce((acc, item) => acc + item.price, 0);
+      totalEl.textContent = `$${sum.toFixed(2)}`;
+    }
+  }
+}
+
+// Register all custom elements idempotently
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+if (!customElements.get('grind-menu-explorer')) {
+  customElements.define('grind-menu-explorer', GrindMenuExplorer);
+}
+if (!customElements.get('grind-brew-calculator')) {
+  customElements.define('grind-brew-calculator', GrindBrewCalculator);
+}
+if (!customElements.get('grind-order-drawer')) {
+  customElements.define('grind-order-drawer', GrindOrderDrawer);
+}
