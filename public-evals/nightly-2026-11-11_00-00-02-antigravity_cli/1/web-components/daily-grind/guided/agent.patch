+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article part="card">
+    <div class="media-wrap" part="media">
+      <img id="card-img" src="" alt="" loading="lazy" width="480" height="300">
+      <div class="badges">
+        <span class="badge category" id="badge-category" part="badge"></span>
+        <span class="badge roast" id="badge-roast"></span>
+      </div>
+      <button type="button" class="fav-btn" id="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+        <span aria-hidden="true" id="fav-icon">♡</span>
+      </button>
+    </div>
+
+    <div class="content" part="content">
+      <div class="header-row">
+        <h3 id="card-title" part="title"><slot name="title">Artisanal Coffee</slot></h3>
+        <span class="price" id="card-price" part="price" aria-live="polite">$4.50</span>
+      </div>
+
+      <div class="description" id="card-desc">
+        <slot>Hand-crafted daily with freshly roasted beans.</slot>
+      </div>
+
+      <fieldset class="size-fieldset">
+        <legend>Cup Size</legend>
+        <div class="size-options" role="radiogroup" aria-label="Select cup size">
+          <button type="button" class="size-btn" role="radio" data-size="small" data-delta="-0.5" aria-checked="false">8oz</button>
+          <button type="button" class="size-btn" role="radio" data-size="medium" data-delta="0" aria-checked="true">12oz</button>
+          <button type="button" class="size-btn" role="radio" data-size="large" data-delta="0.75" aria-checked="false">16oz</button>
+        </div>
+      </fieldset>
+
+      <div class="details-panel" id="details-panel" hidden>
+        <dl class="details-dl">
+          <dt>Tasting Notes</dt>
+          <dd id="detail-notes">Caramel, toasted hazelnut, smooth cocoa finish</dd>
+          <dt>Origin</dt>
+          <dd id="detail-origin">Single-origin &amp; ethically sourced</dd>
+          <dt>Caffeine</dt>
+          <dd id="detail-caffeine">~150 mg (12oz)</dd>
+        </dl>
+        <slot name="details"></slot>
+      </div>
+
+      <div class="actions" part="actions">
+        <button type="button" class="action-btn add-btn" id="add-btn" part="cta">
+          Add to Order
+        </button>
+        <button type="button" class="action-btn details-toggle" id="details-toggle" part="details-button" aria-expanded="false" aria-controls="details-panel">
+          Tasting Notes
+        </button>
+        <a class="action-link" id="menu-link" href="/menu">Full Page</a>
+      </div>
+    </div>
+  </article>
+`;
+
+const SIZE_DELTAS = {
+  small: -0.5,
+  medium: 0,
+  large: 0.75,
+};
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'category',
+    'roast',
+    'price',
+    'image',
+    'href',
+    'notes',
+    'origin',
+    'caffeine',
+    'size',
+    'favorited',
+    'disabled',
+  ];
+
+  #internals;
+  #initialized = false;
+  #size = 'medium';
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals ? this.attachInternals() : null;
+
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+      this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+    } else if (this.shadowRoot.adoptedStyleSheets.length === 0) {
+      this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+    }
+
+    this.#bindEvents();
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#initialized = true;
+      if (this.hasAttribute('size')) {
+        this.#size = this.getAttribute('size') || 'medium';
+      }
+    }
+    this.#render();
+  }
+
+  attributeChangedCallback(attrName, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (attrName === 'size' && newVal) {
+      this.#size = newVal;
+    }
+    if (this.isConnected) {
+      this.#render();
+    }
+  }
+
+  // Reflected properties
+  get name() {
+    return (
+      this.getAttribute('name') ||
+      this.querySelector('[slot="title"]')?.textContent?.trim() ||
+      'Artisanal Coffee'
+    );
+  }
+  set name(val) {
+    val ? this.setAttribute('name', val) : this.removeAttribute('name');
+  }
+
+  get category() {
+    return this.getAttribute('category') || 'seasonal';
+  }
+  set category(val) {
+    val ? this.setAttribute('category', val) : this.removeAttribute('category');
+  }
+
+  get roast() {
+    return this.getAttribute('roast') || 'Medium Roast';
+  }
+  set roast(val) {
+    val ? this.setAttribute('roast', val) : this.removeAttribute('roast');
+  }
+
+  get price() {
+    const raw = Number(this.getAttribute('price'));
+    return Number.isFinite(raw) && raw > 0 ? raw : 4.5;
+  }
+  set price(val) {
+    this.setAttribute('price', String(val));
+  }
+
+  get size() {
+    return this.#size;
+  }
+  set size(val) {
+    if (val in SIZE_DELTAS) {
+      this.#size = val;
+      this.setAttribute('size', val);
+    }
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(val) {
+    this.toggleAttribute('favorited', Boolean(val));
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(val) {
+    this.toggleAttribute('disabled', Boolean(val));
+  }
+
+  get currentPrice() {
+    const delta = SIZE_DELTAS[this.#size] ?? 0;
+    return Math.max(0, this.price + delta);
+  }
+
+  toggleFavorite() {
+    this.favorited = !this.favorited;
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.name,
+          favorited: this.favorited,
+        },
+      })
+    );
+  }
+
+  toggleDetails(force) {
+    const panel = this.shadowRoot.getElementById('details-panel');
+    const toggleBtn = this.shadowRoot.getElementById('details-toggle');
+    if (!panel || !toggleBtn) return;
+
+    const nextExpanded = typeof force === 'boolean' ? force : panel.hidden;
+    panel.hidden = !nextExpanded;
+    toggleBtn.setAttribute('aria-expanded', String(nextExpanded));
+    this.#setState('expanded', nextExpanded);
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-details-toggle', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.name,
+          expanded: nextExpanded,
+        },
+      })
+    );
+  }
+
+  #setState(stateName, active) {
+    if (!this.#internals?.states) return;
+    if (active) {
+      this.#internals.states.add(stateName);
+    } else {
+      this.#internals.states.delete(stateName);
+    }
+  }
+
+  #bindEvents() {
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    const detailsToggle = this.shadowRoot.getElementById('details-toggle');
+    const addBtn = this.shadowRoot.getElementById('add-btn');
+    const sizeBtns = Array.from(this.shadowRoot.querySelectorAll('.size-btn'));
+
+    favBtn?.addEventListener('click', () => this.toggleFavorite());
+    detailsToggle?.addEventListener('click', () => this.toggleDetails());
+
+    sizeBtns.forEach((btn, idx) => {
+      btn.addEventListener('click', () => {
+        const chosen = btn.dataset.size;
+        if (chosen) {
+          this.size = chosen;
+        }
+      });
+
+      btn.addEventListener('keydown', (e) => {
+        let targetIdx = -1;
+        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
+          targetIdx = (idx + 1) % sizeBtns.length;
+        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
+          targetIdx = (idx - 1 + sizeBtns.length) % sizeBtns.length;
+        }
+        if (targetIdx !== -1) {
+          e.preventDefault();
+          const targetBtn = sizeBtns[targetIdx];
+          this.size = targetBtn.dataset.size;
+          targetBtn.focus();
+        }
+      });
+    });
+
+    addBtn?.addEventListener('click', () => {
+      this.dispatchEvent(
+        new CustomEvent('coffee-order-add', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.name,
+            size: this.size,
+            price: this.currentPrice,
+            category: this.category,
+            roast: this.roast,
+          },
+        })
+      );
+    });
+  }
+
+  #render() {
+    const root = this.shadowRoot;
+    if (!root) return;
+
+    const titleSlot = root.querySelector('slot[name="title"]');
+    if (this.hasAttribute('name') && titleSlot && titleSlot.assignedNodes().length === 0) {
+      titleSlot.textContent = this.getAttribute('name');
+    }
+
+    const img = root.getElementById('card-img');
+    const imgSrc =
+      this.getAttribute('image') ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80';
+    if (img) {
+      img.src = imgSrc;
+      img.alt = `${this.name} served fresh`;
+    }
+
+    const badgeCategory = root.getElementById('badge-category');
+    if (badgeCategory) {
+      badgeCategory.textContent = this.category;
+    }
+
+    const badgeRoast = root.getElementById('badge-roast');
+    if (badgeRoast) {
+      badgeRoast.textContent = this.roast;
+    }
+
+    const priceEl = root.getElementById('card-price');
+    if (priceEl) {
+      priceEl.textContent = `$${this.currentPrice.toFixed(2)}`;
+    }
+
+    const notesEl = root.getElementById('detail-notes');
+    if (notesEl) {
+      notesEl.textContent =
+        this.getAttribute('notes') || 'Caramel, toasted hazelnut, smooth cocoa finish';
+    }
+
+    const originEl = root.getElementById('detail-origin');
+    if (originEl) {
+      originEl.textContent =
+        this.getAttribute('origin') || 'Single-origin & ethically sourced';
+    }
+
+    const caffeineEl = root.getElementById('detail-caffeine');
+    if (caffeineEl) {
+      caffeineEl.textContent = this.getAttribute('caffeine') || '~150 mg';
+    }
+
+    const linkEl = root.getElementById('menu-link');
+    if (linkEl) {
+      const href = this.getAttribute('href') || '/menu';
+      linkEl.setAttribute('href', href);
+      linkEl.setAttribute('aria-label', `View full details for ${this.name}`);
+    }
+
+    const addBtn = root.getElementById('add-btn');
+    if (addBtn) {
+      const sizeLabel = this.#size === 'small' ? '8oz' : this.#size === 'large' ? '16oz' : '12oz';
+      addBtn.setAttribute(
+        'aria-label',
+        `Add ${sizeLabel} ${this.name} ($${this.currentPrice.toFixed(2)}) to order`
+      );
+    }
+
+    const favBtn = root.getElementById('fav-btn');
+    const favIcon = root.getElementById('fav-icon');
+    const isFav = this.favorited;
+    this.#setState('favorited', isFav);
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(isFav));
+      favBtn.setAttribute(
+        'aria-label',
+        isFav ? `Remove ${this.name} from favorites` : `Save ${this.name} to favorites`
+      );
+    }
+    if (favIcon) {
+      favIcon.textContent = isFav ? '♥' : '♡';
+    }
+
+    const sizeBtns = root.querySelectorAll('.size-btn');
+    sizeBtns.forEach((btn) => {
+      const active = btn.dataset.size === this.#size;
+      btn.setAttribute('aria-checked', String(active));
+      btn.tabIndex = active ? 0 : -1;
+    });
+  }
+}
