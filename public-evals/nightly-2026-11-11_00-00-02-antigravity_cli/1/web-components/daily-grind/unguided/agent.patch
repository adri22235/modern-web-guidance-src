+/**
+ * <store-locator> Web Component
+ * Interactive cafe & roastery locator with amenity filter toggles,
+ * accessible pickup store selection, and encapsulated styling.
+ */
+
+const STORES = [
+  {
+    id: 'downtown-roastery',
+    name: 'Downtown Flagship Roastery',
+    address: '412 Roaster Row, Suite 100',
+    hours: '6:00 AM – 8:00 PM Daily',
