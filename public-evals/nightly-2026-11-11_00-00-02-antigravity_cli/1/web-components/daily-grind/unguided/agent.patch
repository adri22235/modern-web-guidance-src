+
+export class BrewCustomizer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._state = {
+      temp: 'hot',
+      roast: 'medium',
+      milk: 'oat',
+      syrup: 'maple',
+      shots: 2,
+    };
+
+    this._radioGroups = Array.from(this.shadowRoot.querySelectorAll('[role="radiogroup"]'));
+    this._decBtn = this.shadowRoot.querySelector('.dec-shot');
+    this._incBtn = this.shadowRoot.querySelector('.inc-shot');
+    this._shotCountEl = this.shadowRoot.querySelector('.shot-count');
+    this._titleEl = this.shadowRoot.querySelector('.preview-title');
+    this._notesEl = this.shadowRoot.querySelector('.preview-notes');
+    this._priceOut = this.shadowRoot.querySelector('.price-out');
+    this._calOut = this.shadowRoot.querySelector('.cal-out');
+    this._cafOut = this.shadowRoot.querySelector('.caf-out');
+    this._recTemp = this.shadowRoot.querySelector('.rec-temp');
+    this._recRoast = this.shadowRoot.querySelector('.rec-roast');
+    this._recMilk = this.shadowRoot.querySelector('.rec-milk');
+    this._recSyrup = this.shadowRoot.querySelector('.rec-syrup');
+    this._recShots = this.shadowRoot.querySelector('.rec-shots');
+    this._orderBtn = this.shadowRoot.querySelector('.order-custom-btn');
+    this._resetBtn = this.shadowRoot.querySelector('.reset-custom-btn');
+
+    this._onGroupClick = this._onGroupClick.bind(this);
+    this._onGroupKeyDown = this._onGroupKeyDown.bind(this);
+    this._onDecShot = this._onDecShot.bind(this);
+    this._onIncShot = this._onIncShot.bind(this);
+    this._onOrder = this._onOrder.bind(this);
+    this._onReset = this._onReset.bind(this);
+  }
+
+  connectedCallback() {
+    this._radioGroups.forEach((group) => {
+      group.addEventListener('click', this._onGroupClick);
+      group.addEventListener('keydown', this._onGroupKeyDown);
+    });
+    this._decBtn.addEventListener('click', this._onDecShot);
+    this._incBtn.addEventListener('click', this._onIncShot);
+    this._orderBtn.addEventListener('click', this._onOrder);
+    this._resetBtn.addEventListener('click', this._onReset);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._radioGroups.forEach((group) => {
+      group.removeEventListener('click', this._onGroupClick);
+      group.removeEventListener('keydown', this._onGroupKeyDown);
+    });
+    this._decBtn.removeEventListener('click', this._onDecShot);
+    this._incBtn.removeEventListener('click', this._onIncShot);
+    this._orderBtn.removeEventListener('click', this._onOrder);
+    this._resetBtn.removeEventListener('click', this._onReset);
+  }
+
+  _onGroupClick(event) {
+    const btn = event.target.closest('[role="radio"]');
+    if (!btn) return;
+    const groupEl = btn.closest('[role="radiogroup"]');
+    if (!groupEl) return;
+    this._setOption(groupEl.dataset.group, btn.dataset.value, false);
+  }
+
+  _onGroupKeyDown(event) {
+    const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'];
+    if (!keys.includes(event.key)) return;
+    event.preventDefault();
+
+    const groupEl = event.currentTarget;
+    const groupName = groupEl.dataset.group;
+    const buttons = Array.from(groupEl.querySelectorAll('[role="radio"]'));
+    const currentIndex = buttons.findIndex((b) => b.dataset.value === this._state[groupName]);
+    let nextIndex = currentIndex >= 0 ? currentIndex : 0;
+
+    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+      nextIndex = (nextIndex + 1) % buttons.length;
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+      nextIndex = (nextIndex - 1 + buttons.length) % buttons.length;
+    } else if (event.key === 'Home') {
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      nextIndex = buttons.length - 1;
+    }
+
+    const nextBtn = buttons[nextIndex];
+    if (nextBtn) {
+      this._setOption(groupName, nextBtn.dataset.value, true);
+    }
+  }
+
+  _setOption(groupName, value, moveFocus = false) {
+    if (!CUSTOM_CONFIG[groupName] || !CUSTOM_CONFIG[groupName][value]) return;
+    this._state[groupName] = value;
+
+    const groupEl = this.shadowRoot.querySelector(`[data-group="${groupName}"]`);
+    if (groupEl) {
+      const buttons = Array.from(groupEl.querySelectorAll('[role="radio"]'));
+      buttons.forEach((btn) => {
+        const isChecked = btn.dataset.value === value;
+        btn.setAttribute('aria-checked', String(isChecked));
+        btn.setAttribute('tabindex', isChecked ? '0' : '-1');
+        if (isChecked && moveFocus) {
+          btn.focus();
+        }
+      });
+    }
+
+    this._render();
+  }
+
+  _onDecShot() {
+    if (this._state.shots > 1) {
+      this._state.shots -= 1;
+      this._render();
+    }
+  }
+
+  _onIncShot() {
+    if (this._state.shots < 4) {
+      this._state.shots += 1;
+      this._render();
+    }
+  }
+
+  _onReset() {
+    this._setOption('temp', 'hot', false);
+    this._setOption('roast', 'medium', false);
+    this._setOption('milk', 'oat', false);
+    this._setOption('syrup', 'maple', false);
+    this._state.shots = 2;
+    this._render();
+  }
+
+  getComputedDrink() {
+    const temp = CUSTOM_CONFIG.temp[this._state.temp];
+    const roast = CUSTOM_CONFIG.roast[this._state.roast];
+    const milk = CUSTOM_CONFIG.milk[this._state.milk];
+    const syrup = CUSTOM_CONFIG.syrup[this._state.syrup];
+    const shots = this._state.shots;
+
+    const basePrice = 4.25;
+    const extraShotsPrice = Math.max(0, shots - 2) * 1.0;
+    const totalPrice = basePrice + temp.price + milk.price + syrup.price + extraShotsPrice;
+    const totalCals = roast.cals * shots + milk.cals + syrup.cals;
+    const totalCaffeine = shots * 75;
+
+    const tempPrefix = this._state.temp === 'iced' ? 'Iced' : 'Hot';
+    const syrupPart = this._state.syrup !== 'none' ? ` ${syrup.label}` : '';
+    const drinkStyle =
+      this._state.milk === 'none'
