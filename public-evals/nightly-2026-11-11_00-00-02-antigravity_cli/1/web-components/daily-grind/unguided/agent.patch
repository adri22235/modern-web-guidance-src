+    this._searchInput = this.shadowRoot.querySelector('.search-input');
+    this._sortSelect = this.shadowRoot.querySelector('.sort-select');
+    this._statusText = this.shadowRoot.querySelector('.status-text');
+    this._grid = this.shadowRoot.querySelector('.grid');
+    this._slot = this.shadowRoot.querySelector('slot');
+    this._emptyState = this.shadowRoot.querySelector('.empty-state');
+    this._resetBtn = this.shadowRoot.querySelector('.reset-btn');
+
+    this._onTabClick = this._onTabClick.bind(this);
+    this._onTabKeyDown = this._onTabKeyDown.bind(this);
+    this._onSearchInput = this._onSearchInput.bind(this);
+    this._onSortChange = this._onSortChange.bind(this);
+    this._onReset = this._onReset.bind(this);
+    this._onSlotChange = this._onSlotChange.bind(this);
+    this._onCardFavorite = this._onCardFavorite.bind(this);
+  }
+
+  connectedCallback() {
+    this._tablist.addEventListener('click', this._onTabClick);
+    this._tablist.addEventListener('keydown', this._onTabKeyDown);
+    this._searchInput.addEventListener('input', this._onSearchInput);
+    this._sortSelect.addEventListener('change', this._onSortChange);
+    this._resetBtn.addEventListener('click', this._onReset);
+    this._slot.addEventListener('slotchange', this._onSlotChange);
+    this.addEventListener('coffee-favorite', this._onCardFavorite);
+
+    if (this.hasAttribute('heading')) {
+      this._headingEl.textContent = this.getAttribute('heading');
+    }
+    if (this.hasAttribute('subtitle')) {
+      this._subtitleEl.textContent = this.getAttribute('subtitle');
+    }
+    if (this.hasAttribute('active-category')) {
