+    if (this._roastVal) this._roastVal.textContent = data.roast;
+    if (this._nutritionVal) {
+      this._nutritionVal.textContent = `${data.calories} kcal (${data.sizeOz}) • ${data.caffeine} caffeine`;
+    }
