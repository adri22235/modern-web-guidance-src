+    amenityLabels: ['Express Drive-Thru', 'Waterfront Patio'],
+    image:
+      'https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=800&q=80',
+  },
+  {
+    id: 'university-commons',
+    name: 'University Commons Study Lounge',
+    address: '1205 College Ave',
+    hours: '6:00 AM – 11:00 PM Daily',
+    wait: '4–6 min pickup wait',
+    onTap: 'Honey Lavender Cortado & Late-Night Espresso Flights',
+    amenities: ['pour-over', 'wifi'],
+    amenityLabels: ['Reserve Pour-Over Bar', 'Late-Night Study Wi-Fi'],
+    image:
+      'https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=800&q=80',
+  },
+];
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
