+    this._priceEl.textContent = item.formattedPrice || `$${Number(item.price || 4.5).toFixed(2)}`;
+    this._descEl.textContent = item.description;
+    this._specRoast.textContent = item.roast || 'Medium Roast';
+    this._specNotes.textContent = item.notes || 'Balanced artisanal profile';
+    this._specCal.textContent = `${item.calories || 120} kcal`;
+    this._specCaf.textContent = item.caffeine || '150mg';
+    this._orderBtn.textContent = `Add ${item.size || 'Medium'} to Order • ${
+      item.formattedPrice || ''
