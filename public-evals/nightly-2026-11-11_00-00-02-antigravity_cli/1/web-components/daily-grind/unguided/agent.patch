+      tempLabel: temp.label,
+      roastLabel: roast.label,
+      milkLabel: milk.label,
+      syrupLabel: syrup.label,
+      shots,
+    };
+  }
+
+  _render() {
+    const drink = this.getComputedDrink();
+
+    this._shotCountEl.textContent = `${drink.shots} ${drink.shots === 1 ? 'Shot' : 'Shots'}`;
+    this._decBtn.disabled = drink.shots <= 1;
+    this._incBtn.disabled = drink.shots >= 4;
+
+    this._titleEl.textContent = drink.name;
+    this._notesEl.textContent = drink.notes;
+    this._priceOut.textContent = drink.formattedPrice;
+    this._calOut.textContent = `${drink.calories} kcal`;
+    this._cafOut.textContent = drink.caffeine;
+
+    this._recTemp.textContent = drink.tempLabel;
+    this._recRoast.textContent = drink.roastLabel;
+    this._recMilk.textContent = drink.milkLabel;
+    this._recSyrup.textContent = drink.syrupLabel;
+    this._recShots.textContent = `${drink.shots} ${drink.shots === 1 ? 'Pull (Single)' : 'Pulls'}`;
+
+    this._orderBtn.textContent = `Add Custom Cup to Order • ${drink.formattedPrice}`;
+  }
+
+  _onOrder() {
+    const drink = this.getComputedDrink();
+    this.dispatchEvent(
+      new CustomEvent('add-to-cart', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          ...drink,
+          quantity: 1,
+        },
+      })
+    );
+
+    const prevText = this._orderBtn.textContent;
+    this._orderBtn.textContent = 'Custom Cup Added to Order ✓';
+    setTimeout(() => {
+      this._render();
+    }, 1300);
+  }
+}
+
+if (!customElements.get('brew-customizer')) {
+  customElements.define('brew-customizer', BrewCustomizer);
+}
