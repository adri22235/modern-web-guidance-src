+    .header {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    .eyebrow {
+      display: inline-block;
+      font-size: 0.78rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 0.1em;
+      color: #8d6e63;
+      margin-bottom: 6px;
+    }
+
+    h2 {
+      font-size: 1.85rem;
+      color: var(--primary, #4e342e);
+      margin-bottom: 8px;
+    }
+
+    .subtitle {
+      color: var(--text-muted, #5d4037);
+      font-size: 0.96rem;
+      max-width: 600px;
+      margin: 0 auto;
+    }
+
+    .filter-bar {
+      display: flex;
+      justify-content: center;
+      flex-wrap: wrap;
+      gap: 10px;
+      margin-bottom: 24px;
+    }
+
+    .amenity-btn {
+      appearance: none;
+      background: #ffffff;
+      border: 1.5px solid #d7ccc8;
+      border-radius: 999px;
+      padding: 8px 16px;
+      font-family: inherit;
+      font-size: 0.86rem;
+      font-weight: 600;
+      color: var(--text, #3e2723);
+      cursor: pointer;
+      transition: all 0.2s ease;
+    }
+
+    .amenity-btn:hover {
+      border-color: var(--primary, #4e342e);
+      background: #f5f0ee;
+    }
+
+    .amenity-btn[aria-pressed="true"] {
+      background: var(--primary, #4e342e);
+      color: #ffffff;
+      border-color: var(--primary, #4e342e);
+    }
+
+    .stores-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
+      gap: 22px;
+    }
+
+    .store-card {
+      background: #ffffff;
+      border-radius: 12px;
+      overflow: hidden;
+      border: 2px solid rgba(78, 52, 46, 0.1);
+      box-shadow: 0 3px 12px rgba(62, 39, 35, 0.08);
+      display: flex;
+      flex-direction: column;
+      transition: border-color 0.2s ease, transform 0.2s ease;
+    }
+
+    .store-card[data-selected="true"] {
+      border-color: var(--accent, #ffab40);
+      box-shadow: 0 6px 20px rgba(78, 52, 46, 0.16);
+    }
+
+    .store-img-wrap {
+      position: relative;
+      height: 150px;
+      background: #4e342e;
+    }
+
+    .store-img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .wait-badge {
+      position: absolute;
+      bottom: 10px;
+      left: 10px;
+      background: rgba(46, 125, 50, 0.92);
+      color: #ffffff;
+      font-size: 0.75rem;
+      font-weight: 700;
+      padding: 3px 10px;
+      border-radius: 999px;
