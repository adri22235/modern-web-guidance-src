+          </div>
+          <div class="item-controls" role="group" aria-label="Quantity for ${item.name}">
+            <button type="button" class="qty-btn" data-key="${item.key}" data-action="dec" aria-label="Decrease quantity of ${item.name}">&minus;</button>
+            <span class="qty-val" aria-live="polite">${item.quantity}</span>
+            <button type="button" class="qty-btn" data-key="${item.key}" data-action="inc" aria-label="Increase quantity of ${item.name}">&#43;</button>
+          </div>
+        </li>
+      `
+      )
+      .join('');
+  }
+}
+
+if (!customElements.get('coffee-cart')) {
+  customElements.define('coffee-cart', CoffeeCart);
+}
