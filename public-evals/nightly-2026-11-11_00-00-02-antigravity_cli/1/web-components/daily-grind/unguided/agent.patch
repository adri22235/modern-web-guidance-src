+    } else if (name === 'subtitle' && this._subtitleEl) {
+      this._subtitleEl.textContent = newVal;
+    } else if (name === 'active-category') {
+      this._selectCategory(newVal || 'all', false);
+    }
+  }
+
+  _getCards() {
+    const assigned = this._slot.assignedElements({ flatten: true });
+    if (assigned.length > 0) {
+      return assigned.filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+    }
+    return Array.from(this.querySelectorAll('coffee-card'));
+  }
+
+  _captureInitialCards() {
+    const cards = this._getCards();
+    cards.forEach((card, index) => {
+      if (!card.dataset.initialIndex) {
+        card.dataset.initialIndex = String(index);
+      }
+    });
+  }
+
+  _onSlotChange() {
+    this._captureInitialCards();
+    this._applyFilters();
+  }
+
+  _onCardFavorite() {
+    this._applyFilters();
+  }
+
+  _onTabClick(event) {
+    const tab = event.target.closest('.tab-btn');
+    if (!tab) return;
+    this._selectCategory(tab.dataset.category, false);
+  }
+
+  _onTabKeyDown(event) {
+    const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
+    if (!keys.includes(event.key)) return;
+    event.preventDefault();
+
+    const currentIndex = this._tabs.findIndex(
+      (t) => t.dataset.category === this._activeCategory
+    );
+    let nextIndex = currentIndex >= 0 ? currentIndex : 0;
+
+    if (event.key === 'ArrowRight') {
+      nextIndex = (nextIndex + 1) % this._tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIndex = (nextIndex - 1 + this._tabs.length) % this._tabs.length;
+    } else if (event.key === 'Home') {
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      nextIndex = this._tabs.length - 1;
+    }
+
+    const nextTab = this._tabs[nextIndex];
+    if (nextTab) {
+      this._selectCategory(nextTab.dataset.category, true);
+    }
+  }
+
+  _selectCategory(category, focusTab = false) {
+    this._activeCategory = category;
+    this._tabs.forEach((tab) => {
+      const isSelected = tab.dataset.category === category;
+      tab.setAttribute('aria-selected', String(isSelected));
+      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+      if (isSelected) {
+        this._grid.setAttribute('aria-labelledby', tab.id);
+        if (focusTab) tab.focus();
+      }
+    });
+    this._applyFilters();
+  }
+
+  _onSearchInput(event) {
+    this._searchQuery = (event.target.value || '').trim().toLowerCase();
+    this._applyFilters();
+  }
+
+  _onSortChange(event) {
+    this._sortBy = event.target.value;
+    this._applyFilters();
+  }
+
+  _onReset() {
+    this._searchQuery = '';
+    this._searchInput.value = '';
+    this._sortBy = 'featured';
+    this._sortSelect.value = 'featured';
+    this._selectCategory('all', false);
+  }
+
+  _applyFilters() {
+    const cards = this._getCards();
+    const counts = {
+      all: cards.length,
+      seasonal: 0,
+      espresso: 0,
+      'cold-brew': 0,
+      favorites: 0,
+    };
+
+    cards.forEach((card) => {
+      const cat = (card.getAttribute('category') || 'seasonal').toLowerCase();
+      if (counts[cat] !== undefined) counts[cat] += 1;
+      if (card.hasAttribute('favorited') && card.getAttribute('favorited') !== 'false') {
+        counts.favorites += 1;
+      }
+    });
+
+    // Update count badges
+    Object.entries(counts).forEach(([key, val]) => {
+      const badge = this.shadowRoot.querySelector(`[data-count="${key}"]`);
+      if (badge) badge.textContent = String(val);
+    });
+
+    // Filter cards
+    let visibleCount = 0;
+    cards.forEach((card) => {
+      const cat = (card.getAttribute('category') || 'seasonal').toLowerCase();
+      const name = (card.getAttribute('name') || card.getAttribute('title') || '').toLowerCase();
+      const desc = (card.getAttribute('description') || '').toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const roast = (card.getAttribute('roast') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited') && card.getAttribute('favorited') !== 'false';
+
+      const matchesCategory =
+        this._activeCategory === 'all' ||
+        (this._activeCategory === 'favorites' ? isFav : cat === this._activeCategory);
+
+      const matchesSearch =
+        !this._searchQuery ||
+        name.includes(this._searchQuery) ||
+        desc.includes(this._searchQuery) ||
+        notes.includes(this._searchQuery) ||
+        roast.includes(this._searchQuery);
+
+      const isVisible = matchesCategory && matchesSearch;
+      card.hidden = !isVisible;
+      if (isVisible) visibleCount += 1;
+    });
+
+    // Sort cards in DOM if needed
+    const sorted = [...cards].sort((a, b) => {
+      const priceA = parseFloat((a.getAttribute('price') || '0').replace(/[^0-9.]/g, '')) || 0;
+      const priceB = parseFloat((b.getAttribute('price') || '0').replace(/[^0-9.]/g, '')) || 0;
+      const nameA = (a.getAttribute('name') || '').toLowerCase();
+      const nameB = (b.getAttribute('name') || '').toLowerCase();
+      const idxA = parseInt(a.dataset.initialIndex || '0', 10);
+      const idxB = parseInt(b.dataset.initialIndex || '0', 10);
+
+      if (this._sortBy === 'price-asc') return priceA - priceB;
+      if (this._sortBy === 'price-desc') return priceB - priceA;
+      if (this._sortBy === 'name-asc') return nameA.localeCompare(nameB);
+      return idxA - idxB;
+    });
+
+    sorted.forEach((card) => {
+      if (card.parentElement === this) {
+        this.appendChild(card);
+      }
+    });
+
+    this._emptyState.hidden = visibleCount > 0;
+    this._statusText.textContent = `Showing ${visibleCount} of ${cards.length} handcrafted ${
+      cards.length === 1 ? 'coffee' : 'coffees'
+    }`;
+
+    this.dispatchEvent(
+      new CustomEvent('filter-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          category: this._activeCategory,
+          query: this._searchQuery,
+          sortBy: this._sortBy,
+          visibleCount,
+          totalCount: cards.length,
+        },
+      })
+    );
+  }
+}
+
+if (!customElements.get('coffee-menu')) {
+  customElements.define('coffee-menu', CoffeeMenu);
+}
