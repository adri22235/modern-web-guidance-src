+        'aria-label',
+        `Add ${data.size} ${data.name} (${data.formattedPrice}) to order`
+      );
+    }
+  }
+
+  _onFavClick() {
+    this.favorited = !this.favorited;
+    const data = this.getCardData();
+    this._announce(
+      this.favorited
+        ? `${data.name} added to your favorites.`
+        : `${data.name} removed from your favorites.`
+    );
