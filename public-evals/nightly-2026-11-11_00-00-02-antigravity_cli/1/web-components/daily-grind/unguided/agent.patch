+      description: this.description,
+      size: sizeCfg.label,
+      sizeOz: sizeCfg.oz,
+      sizeKey: this._selectedSize,
+      price: Number(this.currentPrice.toFixed(2)),
+      formattedPrice: `$${this.currentPrice.toFixed(2)}`,
+      image: this.getAttribute('image') || '',
+      imageAlt: this.getAttribute('image-alt') || this.name,
+      href: this.getAttribute('href') || '/menu',
+      category: this.category,
+      roast: this.getAttribute('roast') || 'Medium Roast',
+      badge: this.getAttribute('badge') || this.category,
+      calories: computedCal,
+      caffeine: this.getAttribute('caffeine') || '150mg',
+      notes: this.getAttribute('notes') || 'Smooth, balanced artisanal finish',
+      favorited: this.favorited,
+    };
+  }
+
+  _render() {
+    const data = this.getCardData();
+
+    // Update text slots fallback when no light DOM slotted element overrides them
+    if (this._titleSlot.assignedNodes().length === 0) {
+      this._titleSlot.textContent = data.name;
+    }
+    if (this._descSlot.assignedNodes().length === 0 && data.description) {
+      this._descSlot.textContent = data.description;
+    }
+    if (this._badgeSlot.assignedNodes().length === 0) {
+      this._badgeSlot.textContent = this.getAttribute('badge') || data.category;
+    }
+
+    this._featuredBadge.hidden = !this.hasAttribute('featured');
+
+    // Image
+    const fallbackImg =
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80';
+    this._imgEl.src = data.image || fallbackImg;
+    this._imgEl.alt = data.imageAlt;
