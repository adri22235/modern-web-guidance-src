+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._activeAmenity = 'all';
+    this._selectedStoreId = STORES[0].id;
+
+    this._filterBar = this.shadowRoot.querySelector('.filter-bar');
+    this._amenityBtns = Array.from(this.shadowRoot.querySelectorAll('.amenity-btn'));
+    this._grid = this.shadowRoot.querySelector('.stores-grid');
+    this._announcer = this.shadowRoot.querySelector('.announcer');
+
+    this._onFilterClick = this._onFilterClick.bind(this);
+    this._onGridClick = this._onGridClick.bind(this);
+  }
+
+  connectedCallback() {
+    this._filterBar.addEventListener('click', this._onFilterClick);
+    this._grid.addEventListener('click', this._onGridClick);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._filterBar.removeEventListener('click', this._onFilterClick);
+    this._grid.removeEventListener('click', this._onGridClick);
+  }
+
+  _onFilterClick(event) {
+    const btn = event.target.closest('.amenity-btn');
+    if (!btn) return;
+    this._activeAmenity = btn.dataset.amenity;
+    this._amenityBtns.forEach((b) => {
+      b.setAttribute('aria-pressed', String(b.dataset.amenity === this._activeAmenity));
+    });
+    this._render();
+  }
+
+  _onGridClick(event) {
+    const btn = event.target.closest('.select-store-btn');
+    if (!btn) return;
+    const storeId = btn.dataset.storeId;
+    const store = STORES.find((s) => s.id === storeId);
+    if (!store) return;
+
+    this._selectedStoreId = store.id;
+    this._render();
+
+    this._announcer.textContent = `Pickup location set to ${store.name}.`;
+    this.dispatchEvent(
+      new CustomEvent('store-selected', {
+        bubbles: true,
+        composed: true,
+        detail: store,
+      })
+    );
+  }
+
+  _render() {
+    const visibleStores = STORES.filter(
+      (store) =>
+        this._activeAmenity === 'all' || store.amenities.includes(this._activeAmenity)
+    );
+
+    this._grid.innerHTML = visibleStores
+      .map((store) => {
+        const isSelected = store.id === this._selectedStoreId;
+        return `
+          <article class="store-card" data-selected="${isSelected}" aria-label="${store.name}">
+            <div class="store-img-wrap">
+              <img class="store-img" src="${store.image}" alt="${store.name} interior" loading="lazy" />
+              <span class="wait-badge">Open &bull; ${store.wait}</span>
+              ${isSelected ? '<span class="selected-pill">Active Pickup Cafe</span>' : ''}
+            </div>
+            <div class="store-body">
+              <h3>${store.name}</h3>
+              <p class="store-address">${store.address}</p>
+              <p class="store-hours">${store.hours}</p>
+              <div class="on-tap">
+                <strong>On Tap Today:</strong> ${store.onTap}
+              </div>
+              <ul class="amenities-list" aria-label="Cafe amenities">
+                ${store.amenityLabels.map((a) => `<li>${a}</li>`).join('')}
+              </ul>
+              <button
+                type="button"
+                class="select-store-btn"
+                data-store-id="${store.id}"
+                aria-pressed="${isSelected}"
+                aria-label="${isSelected ? `Selected pickup location: ${store.name}` : `Set ${store.name} as pickup location`}"
+              >
+                ${isSelected ? '✓ Selected for Pickup' : 'Set as Pickup Cafe'}
+              </button>
+            </div>
+          </article>
+        `;
+      })
+      .join('');
+  }
+}
+
+if (!customElements.get('store-locator')) {
+  customElements.define('store-locator', StoreLocator);
+}
