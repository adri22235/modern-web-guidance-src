+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: data,
+      })
+    );
+  }
+
+  _onSizeClick(event) {
+    const btn = event.target.closest('.size-btn');
+    if (!btn) return;
+    this._selectSize(btn.dataset.size, false);
+  }
+
+  _onSizeKeyDown(event) {
+    const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'];
+    if (!keys.includes(event.key)) return;
+    event.preventDefault();
+
+    const order = ['small', 'medium', 'large'];
+    const currentIndex = order.indexOf(this._selectedSize);
+    let nextIndex = currentIndex;
+
+    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+      nextIndex = (currentIndex + 1) % order.length;
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+      nextIndex = (currentIndex - 1 + order.length) % order.length;
+    } else if (event.key === 'Home') {
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      nextIndex = order.length - 1;
+    }
+
+    this._selectSize(order[nextIndex], true);
+  }
+
+  _selectSize(size, moveFocus = false) {
+    if (!SIZE_CONFIG[size]) return;
+    this._selectedSize = size;
+    this.setAttribute('selected-size', size);
+    this._render();
+
+    if (moveFocus) {
+      const targetBtn = this._sizeBtns.find((b) => b.dataset.size === size);
+      if (targetBtn) targetBtn.focus();
+    }
+
+    const data = this.getCardData();
+    this._announce(`Selected ${data.size} (${data.sizeOz}), price ${data.formattedPrice}`);
+    this.dispatchEvent(
+      new CustomEvent('size-change', {
+        bubbles: true,
+        composed: true,
+        detail: data,
+      })
+    );
+  }
+
+  _onToggleDetails() {
+    const expanded = this._detailsToggle.getAttribute('aria-expanded') === 'true';
+    const nextState = !expanded;
+    this._detailsToggle.setAttribute('aria-expanded', String(nextState));
+    this._tastingPanel.hidden = !nextState;
+  }
+
+  _onAddClick() {
+    const data = this.getCardData();
+    this.dispatchEvent(
+      new CustomEvent('add-to-cart', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          ...data,
+          quantity: 1,
+        },
+      })
+    );
+
+    this._announce(`Added ${data.size} ${data.name} to order.`);
+    this._addBtn.textContent = 'Added to Cup ✓';
+    this._addBtn.classList.add('added');
+
+    if (this._addedTimeout) clearTimeout(this._addedTimeout);
+    this._addedTimeout = setTimeout(() => {
+      this._addBtn.textContent = 'Add to Order';
+      this._addBtn.classList.remove('added');
+    }, 1400);
+  }
+
+  _onViewDetailsClick(event) {
+    // Allow modified clicks (Ctrl/Cmd/Shift) to follow link normally
+    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+      return;
+    }
+    const detailEvent = new CustomEvent('coffee-details', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: {
+        ...this.getCardData(),
+        triggerElement: this._detailsLink,
+      },
+    });
+    const notCancelled = this.dispatchEvent(detailEvent);
+    if (!notCancelled) {
+      event.preventDefault();
+    }
+  }
+
+  _announce(message) {
+    if (this._announcer) {
+      this._announcer.textContent = '';
+      setTimeout(() => {
+        this._announcer.textContent = message;
+      }, 20);
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
