+    if (event.key === 'ArrowRight') {
+      nextIdx = (nextIdx + 1) % this._tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIdx = (nextIdx - 1 + this._tabs.length) % this._tabs.length;
+    } else if (event.key === 'Home') {
+      nextIdx = 0;
+    } else if (event.key === 'End') {
+      nextIdx = this._tabs.length - 1;
+    }
+
+    const nextTab = this._tabs[nextIdx];
+    if (nextTab) {
+      this._selectTier(nextTab.dataset.tier, true);
+    }
+  }
+
+  _selectTier(tierKey, moveFocus = false) {
+    if (!TIERS[tierKey]) return;
+    this._tier = tierKey;
+    this._tabs.forEach((tab) => {
+      const isSelected = tab.dataset.tier === tierKey;
+      tab.setAttribute('aria-selected', String(isSelected));
+      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+      if (isSelected) {
+        this._tabpanel.setAttribute('aria-labelledby', tab.id);
+        if (moveFocus) tab.focus();
+      }
+    });
+    this._render();
+  }
+
+  _onRangeInput(event) {
+    this._cupsPerWeek = parseInt(event.target.value, 10) || 1;
+    this._rangeInput.setAttribute('aria-valuenow', String(this._cupsPerWeek));
+    this._render();
+  }
+
+  _onBonusClick() {
+    this._includeBonus = !this._includeBonus;
+    this._bonusBtn.setAttribute('aria-pressed', String(this._includeBonus));
+    this._bonusBtn.textContent = this._includeBonus
+      ? '✓ 100 Welcome Bonus Bean Points Included'
+      : '+ Include 100 Welcome Bonus Bean Points';
+    this._render();
+  }
+
+  _render() {
+    const tierCfg = TIERS[this._tier];
+    const avgCupPrice = 5.25;
+    const weeklyPoints = Math.round(this._cupsPerWeek * avgCupPrice * tierCfg.rate);
+    const bonusPoints = this._includeBonus ? 100 : 0;
+    const monthlyPoints = Math.round(weeklyPoints * 4.33) + bonusPoints;
+    const annualPoints = weeklyPoints * 52 + bonusPoints;
+    const freeDrinksPerYear = Math.floor(annualPoints / 150);
+    const annualSavings = freeDrinksPerYear * avgCupPrice;
+
+    const firstWeekProgress = Math.min(150, weeklyPoints + bonusPoints);
+    const pct = Math.round((firstWeekProgress / 150) * 100);
+
+    this._cupsOutput.textContent = `${this._cupsPerWeek} ${
+      this._cupsPerWeek === 1 ? 'cup' : 'cups'
+    } / week`;
+    this._perkText.textContent = tierCfg.perk;
+    this._monthlyPtsEl.textContent = monthlyPoints.toLocaleString();
+    this._freeDrinksEl.textContent = String(freeDrinksPerYear);
+    this._savingsEl.textContent = `$${annualSavings.toFixed(2)}`;
+    this._progressPct.textContent = `${pct}% (${firstWeekProgress}/150 pts in wk 1)`;
+    this._progressBar.setAttribute('aria-valuenow', String(firstWeekProgress));
+    this._progressFill.style.width = `${pct}%`;
+  }
+}
+
+if (!customElements.get('rewards-calculator')) {
+  customElements.define('rewards-calculator', RewardsCalculator);
+}
