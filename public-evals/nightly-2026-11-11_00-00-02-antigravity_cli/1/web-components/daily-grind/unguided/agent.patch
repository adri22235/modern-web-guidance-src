+    }
+
+    this._captureInitialCards();
+    this._applyFilters();
+  }
+
+  disconnectedCallback() {
+    this._tablist.removeEventListener('click', this._onTabClick);
+    this._tablist.removeEventListener('keydown', this._onTabKeyDown);
+    this._searchInput.removeEventListener('input', this._onSearchInput);
+    this._sortSelect.removeEventListener('change', this._onSortChange);
+    this._resetBtn.removeEventListener('click', this._onReset);
+    this._slot.removeEventListener('slotchange', this._onSlotChange);
