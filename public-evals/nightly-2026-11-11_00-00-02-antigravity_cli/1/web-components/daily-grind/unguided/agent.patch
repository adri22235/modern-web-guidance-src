+      border-left: 3px solid var(--accent, #ffab40);
+      padding: 8px 10px;
+      font-size: 0.82rem;
+      color: #4e342e;
+      margin-bottom: 12px;
+      border-radius: 0 6px 6px 0;
+    }
+
+    .amenities-list {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+      list-style: none;
+      margin-bottom: 16px;
+    }
+
+    .amenities-list li {
+      font-size: 0.74rem;
+      background: #f3ece9;
+      color: #4e342e;
+      padding: 3px 8px;
+      border-radius: 6px;
+      font-weight: 600;
+    }
+
+    .select-store-btn {
+      margin-top: auto;
+      appearance: none;
+      width: 100%;
+      padding: 10px 14px;
+      border-radius: 8px;
+      font-family: inherit;
+      font-size: 0.88rem;
+      font-weight: 700;
+      cursor: pointer;
+      border: 1.5px solid var(--primary, #4e342e);
+      background: transparent;
+      color: var(--primary, #4e342e);
+      transition: all 0.2s ease;
+    }
+
+    .select-store-btn:hover {
+      background: rgba(78, 52, 46, 0.08);
+    }
+
+    .select-store-btn[aria-pressed="true"] {
+      background: var(--primary, #4e342e);
+      color: #ffffff;
+    }
+
+    button:focus-visible {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+  </style>
+
+  <section aria-labelledby="locator-heading">
+    <div class="header">
+      <span class="eyebrow">Local Roasteries</span>
+      <h2 id="locator-heading">Select Your Pickup Cafe</h2>
+      <p class="subtitle">Filter by cafe amenities and choose your neighborhood roastery for express mobile pickup.</p>
+    </div>
+
+    <div class="filter-bar" role="group" aria-label="Filter locations by amenity">
+      <button type="button" class="amenity-btn" data-amenity="all" aria-pressed="true">All Locations</button>
+      <button type="button" class="amenity-btn" data-amenity="pour-over" aria-pressed="false">Reserve Pour-Over Bar</button>
+      <button type="button" class="amenity-btn" data-amenity="drive-thru" aria-pressed="false">Express Drive-Thru</button>
+      <button type="button" class="amenity-btn" data-amenity="patio" aria-pressed="false">Outdoor Patio</button>
+      <button type="button" class="amenity-btn" data-amenity="wifi" aria-pressed="false">Late-Night Wi-Fi</button>
