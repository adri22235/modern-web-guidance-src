+  <script>
+    (function () {
+      const grid = document.getElementById('seasonal-grid');
+      const sortButtons = Array.from(document.querySelectorAll('.sort-btn'));
+      if (!grid || !sortButtons.length) return;
+
+      function getCardTitle(card) {
+        if (card.dataset.name) return card.dataset.name.trim();
+        const heading = card.querySelector('h3');
+        return heading ? heading.textContent.trim() : '';
+      }
+
+      function getCardPrice(card) {
+        return parseFloat(card.dataset.price || '0');
+      }
+
+      function getCardFeaturedOrder(card) {
+        return parseInt(card.dataset.featured || '0', 10);
+      }
+
+      function sortSeasonalCards(sortType) {
+        const cards = Array.from(grid.querySelectorAll('.card'));
+        if (!cards.length) return;
+
+        // 1. FIRST: Record current visual positions on screen (works seamlessly even mid-animation)
+        const firstRects = new Map();
+        cards.forEach((card) => {
+          firstRects.set(card, card.getBoundingClientRect());
+        });
+
+        // Clean up any in-flight listeners/timers and reset transforms before DOM reordering
+        cards.forEach((card) => {
+          if (card._flipCleanup) {
+            card.removeEventListener('transitionend', card._flipCleanup);
+            card._flipCleanup = null;
+          }
+          if (card._flipTimer) {
+            clearTimeout(card._flipTimer);
+            card._flipTimer = null;
+          }
+          card.style.transition = 'none';
+          card.style.transform = '';
+          card.classList.remove('card-moving');
+        });
+
+        // Sort cards according to the selected criterion
+        const sortedCards = [...cards].sort((a, b) => {
+          switch (sortType) {
+            case 'name-asc':
+              return getCardTitle(a).localeCompare(getCardTitle(b));
+            case 'name-desc':
+              return getCardTitle(b).localeCompare(getCardTitle(a));
+            case 'price-asc':
+              return getCardPrice(a) - getCardPrice(b);
+            case 'price-desc':
+              return getCardPrice(b) - getCardPrice(a);
+            case 'featured':
+            default:
+              return getCardFeaturedOrder(a) - getCardFeaturedOrder(b);
+          }
+        });
+
+        // Reorder DOM nodes in the grid
+        sortedCards.forEach((card) => {
+          grid.appendChild(card);
+        });
+
+        // 2. LAST: Measure the new layout positions
+        const lastRects = new Map();
+        sortedCards.forEach((card) => {
+          lastRects.set(card, card.getBoundingClientRect());
+        });
+
+        // 3. INVERT: Apply inverse transforms so cards start from their previous positions
+        sortedCards.forEach((card) => {
+          const first = firstRects.get(card);
+          const last = lastRects.get(card);
+          const deltaX = first.left - last.left;
+          const deltaY = first.top - last.top;
+
+          if (Math.abs(deltaX) > 0.5 || Math.abs(deltaY) > 0.5) {
+            card.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
+            card.classList.add('card-moving');
+          } else {
+            card.style.transform = 'translateY(-6px) scale(0.98)';
+          }
+        });
+
+        // Force layout reflow so the browser registers the starting transform
+        void grid.offsetHeight;
+
+        // 4. PLAY: Animate cards smoothly into their new positions
+        sortedCards.forEach((card, index) => {
+          const staggerMs = index * 30;
+          const durationMs = 450;
+          card.style.transition = `transform ${durationMs}ms cubic-bezier(0.22, 1, 0.36, 1) ${staggerMs}ms, box-shadow 300ms ease`;
+          card.style.transform = 'translate(0px, 0px) scale(1)';
+
+          const cleanup = (event) => {
+            if (event && event.propertyName && event.propertyName !== 'transform') return;
+            card.classList.remove('card-moving');
+            card.style.transition = '';
+            card.style.transform = '';
+            card.removeEventListener('transitionend', cleanup);
+            card._flipCleanup = null;
+            if (card._flipTimer) {
+              clearTimeout(card._flipTimer);
+              card._flipTimer = null;
+            }
+          };
+
+          card._flipCleanup = cleanup;
+          card.addEventListener('transitionend', cleanup);
+          card._flipTimer = setTimeout(() => cleanup(), durationMs + staggerMs + 60);
+        });
+      }
+
+      sortButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          const sortType = button.dataset.sort;
+          sortButtons.forEach((btn) => {
+            const isSelected = btn === button;
+            btn.classList.toggle('active', isSelected);
+            btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
+          });
+          sortSeasonalCards(sortType);
+        });
+      });
+    })();
+  </script>
