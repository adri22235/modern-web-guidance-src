+  <script>
+    const sortSelect = document.getElementById('favorites-sort');
+    const favoritesGrid = document.getElementById('favorites-grid');
+    const sortStatus = document.getElementById('favorites-sort-status');
+    const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });
+
+    function reorder(container, orderedNodes) {
+      const move = Object.hasOwn(Element.prototype, 'moveBefore')
+        ? (node) => container.moveBefore(node, null)
+        : (node) => container.append(node);
+
+      for (const node of orderedNodes) move(node);
+    }
+
+    function reorderWithTransition(list, orderedNodes) {
+      const update = () => reorder(list, orderedNodes);
+
+      // Prefer a transition scoped to the list: the rest of the page stays interactive.
+      // Fall back to a document-level transition, then to a plain update.
+      if (list.startViewTransition) {
+        const transition = list.startViewTransition(update);
+        transition.ready?.catch(() => {});
+      } else if (document.startViewTransition) {
+        const transition = document.startViewTransition(update);
+        transition.ready?.catch(() => {});
+      } else {
+        update();
+      }
+    }
+
+    sortSelect?.addEventListener('change', (event) => {
+      const sortValue = event.target.value;
+      const cards = Array.from(favoritesGrid.children);
+
+      const orderedCards = cards.sort((a, b) => {
+        if (sortValue === 'name-asc') {
+          return collator.compare(a.dataset.name, b.dataset.name);
+        }
+        if (sortValue === 'name-desc') {
+          return collator.compare(b.dataset.name, a.dataset.name);
+        }
+        return Number(a.dataset.featuredOrder) - Number(b.dataset.featuredOrder);
+      });
+
+      reorderWithTransition(favoritesGrid, orderedCards);
+
+      const labelMap = {
+        'featured': 'featured order',
+        'name-asc': 'name, A to Z',
+        'name-desc': 'name, Z to A',
+      };
+      const sortDescription = labelMap[sortValue] || sortValue;
+      sortStatus.textContent = `Sorted by ${sortDescription}, ${orderedCards.length} items`;
+    });
+  </script>
+
