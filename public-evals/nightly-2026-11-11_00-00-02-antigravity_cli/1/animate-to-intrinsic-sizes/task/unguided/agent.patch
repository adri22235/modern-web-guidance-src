+  <script>
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    if (faqTrigger && faqContent) {
+      faqTrigger.addEventListener('click', () => {
+        const isOpen = faqContent.classList.toggle('open');
+        faqContent.classList.toggle('expanded', isOpen);
+        faqContent.classList.toggle('active', isOpen);
+        faqTrigger.classList.toggle('open', isOpen);
+        faqTrigger.setAttribute('aria-expanded', String(isOpen));
+        faqContent.setAttribute('aria-hidden', String(!isOpen));
+      });
+    }
+
+    if (alertDismiss && promoAlert) {
+      alertDismiss.addEventListener('click', () => {
+        promoAlert.classList.add('dismissed', 'collapsed');
+        promoAlert.setAttribute('aria-hidden', 'true');
+      });
+    }
+  </script>
