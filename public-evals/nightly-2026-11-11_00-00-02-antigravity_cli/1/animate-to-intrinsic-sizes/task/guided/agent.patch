+  <script>
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    function dismissAlert() {
+      if (!promoAlert) return;
+      promoAlert.classList.add('is-dismissed');
+      // Waits for the transitions the class starts, ignoring any other animations
+      // on the element; under reduced motion there are none
+      const transitions = promoAlert
+        .getAnimations()
+        .filter((animation) => animation instanceof CSSTransition);
+      Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
+        if (promoAlert.classList.contains('is-dismissed')) {
+          promoAlert.hidden = true;
+        }
+      });
+    }
+
+    alertDismiss?.addEventListener('click', dismissAlert);
+
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    faqTrigger?.addEventListener('click', () => {
+      const isExpanded = faqTrigger.getAttribute('aria-expanded') === 'true';
+      const nextExpanded = !isExpanded;
+      faqTrigger.setAttribute('aria-expanded', String(nextExpanded));
+
+      if (!faqContent) return;
+
+      if (nextExpanded) {
+        faqContent.hidden = false;
+        faqContent.inert = false;
+        faqContent.setAttribute('aria-hidden', 'false');
+        faqContent.classList.add('is-expanded');
+      } else {
+        faqContent.classList.remove('is-expanded');
+        const transitions = faqContent
+          .getAnimations()
+          .filter((animation) => animation instanceof CSSTransition);
+        Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
+          if (!faqContent.classList.contains('is-expanded')) {
+            faqContent.setAttribute('aria-hidden', 'true');
+            faqContent.inert = true;
+          }
+        });
+      }
+    });
+  </script>
+
