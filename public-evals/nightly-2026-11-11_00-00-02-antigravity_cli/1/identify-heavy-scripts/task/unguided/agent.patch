@@ -206,7 +206,80 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const STORAGE_KEY = 'recorded_slow_scripts';
+      const pastOccurrences = [];
+
+      try {
+        const stored = localStorage.getItem(STORAGE_KEY);
+        if (stored) {
+          const parsed = JSON.parse(stored);
+          if (Array.isArray(parsed)) {
+            pastOccurrences.push(...parsed);
+          }
+        }
+      } catch (e) {
+        // Ignore storage errors
+      }
+
+      window.slowScriptOccurrences = pastOccurrences;
+
+      function recordOccurrence(entry, script) {
+        const record = {
+          timestamp: Date.now(),
+          frameStartTime: entry.startTime,
+          frameDuration: entry.duration,
+          blockingDuration: entry.blockingDuration,
+          renderStart: entry.renderStart,
+          styleAndLayoutStart: entry.styleAndLayoutStart,
+          invoker: script ? script.invoker : undefined,
+          invokerType: script ? script.invokerType : undefined,
+          sourceURL: script ? script.sourceURL : undefined,
+          sourceFunctionName: script ? script.sourceFunctionName : undefined,
+          sourceCharPosition: script ? script.sourceCharPosition : undefined,
+          scriptDuration: script ? script.duration : undefined,
+          executionStart: script ? script.executionStart : undefined,
+          forcedStyleAndLayoutDuration: script ? script.forcedStyleAndLayoutDuration : undefined
+        };
+
+        pastOccurrences.push(record);
+
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(pastOccurrences));
+        } catch (e) {
+          // Ignore storage errors
+        }
+
+        console.warn('Slow script detected in long animation frame:', record);
+      }
+
+      if (typeof PerformanceObserver !== 'undefined') {
+        try {
+          const observer = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              if (entry.scripts && entry.scripts.length > 0) {
+                for (const script of entry.scripts) {
+                  recordOccurrence(entry, script);
+                }
+              } else {
+                recordOccurrence(entry, null);
+              }
+            }
+          });
+
+          observer.observe({
+            type: 'long-animation-frame',
+            buffered: true
+          });
+        } catch (e) {
+          console.error('Failed to initialize long-animation-frame PerformanceObserver:', e);
+        }
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
