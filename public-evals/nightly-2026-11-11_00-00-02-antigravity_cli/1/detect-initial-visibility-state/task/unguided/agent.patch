+  <script>
+    (function checkInitialBackgroundLoad() {
+      let backgrounded = false;
+      let timestamp =
+        typeof performance !== 'undefined' && typeof performance.now === 'function'
+          ? performance.now()
+          : Date.now();
+      let usedFallback = false;
+
+      const fallbackNote =
+        'Older fallback checks (document.visibilityState === "hidden" or document.hidden) are unreliable for async scripts because they evaluate visibility at script execution time rather than initial page load, after the user may have already switched tabs. Use buffered "visibility-state" performance entries (VisibilityStateEntry) for accurate initial load detection.';
+
+      const visibilityEntries =
+        typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function'
+          ? performance.getEntriesByType('visibility-state')
+          : [];
+
+      if (visibilityEntries && visibilityEntries.length > 0) {
+        const initialEntry =
+          visibilityEntries.find((entry) => entry.startTime === 0) || visibilityEntries[0];
+        backgrounded = initialEntry.name === 'hidden';
+        timestamp = initialEntry.startTime;
+      } else {
+        usedFallback = true;
+        backgrounded =
+          typeof document !== 'undefined'
+            ? document.visibilityState === 'hidden' || Boolean(document.hidden)
+            : false;
+      }
+
+      console.log({
+        backgrounded,
+        timestamp,
+        usedFallback,
+        note: fallbackNote,
+      });
+
+      if (
+        usedFallback &&
+        typeof PerformanceObserver !== 'undefined' &&
+        Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+        PerformanceObserver.supportedEntryTypes.includes('visibility-state')
+      ) {
+        const observer = new PerformanceObserver((list) => {
+          const entries = list.getEntries();
+          if (entries.length > 0) {
+            const initialEntry =
+              entries.find((entry) => entry.startTime === 0) || entries[0];
+            console.log({
+              backgrounded: initialEntry.name === 'hidden',
+              timestamp: initialEntry.startTime,
+              usedFallback: false,
+              note: fallbackNote,
+            });
+            observer.disconnect();
+          }
+        });
+        observer.observe({ type: 'visibility-state', buffered: true });
+      }
+    })();
+  </script>
+
 </body>
 
