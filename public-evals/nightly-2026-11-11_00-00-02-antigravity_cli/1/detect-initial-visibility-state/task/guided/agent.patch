+  <script>
+    const FALLBACK_ASYNC_NOTE =
+      'Fallback checks using document.visibilityState and visibilitychange are unreliable for async scripts because a tab opened in the background may be foregrounded before the script downloads and executes, causing document.visibilityState to read "visible" and miss the initial background state, and performance.now() in an event listener lacks the internal timeline precision of VisibilityStateEntry.startTime.';
+
+    /**
+     * Accurately determines visibility state history using the Performance API.
+     */
+    function getVisibilityInfo() {
+      const entries = performance.getEntriesByType('visibility-state');
+
+      if (entries.length > 0) {
+        const firstEntry = entries[0];
+        const initiallyBackgrounded = firstEntry.name === 'hidden';
+
+        let timeBackgrounded = null;
+        for (const entry of entries) {
+          if (entry.name === 'hidden') {
+            timeBackgrounded = entry.startTime;
+            break;
+          }
+        }
+
+        const timestamp = timeBackgrounded ?? firstEntry.startTime;
+
+        return {
+          initiallyBackgrounded,
+          backgrounded: initiallyBackgrounded,
+          timeBackgrounded,
+          timestamp,
+          note: FALLBACK_ASYNC_NOTE,
+        };
+      }
+
+      return getFallbackVisibilityInfo();
+    }
+
+    /**
+     * Fallback implementation using document.visibilityState.
+     * This approach is prone to race conditions if the script loads asynchronously.
+     */
+    function getFallbackVisibilityInfo() {
+      let initiallyBackgrounded = document.visibilityState === 'hidden';
+      let timeBackgrounded = initiallyBackgrounded ? 0 : null;
+
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden' && timeBackgrounded === null) {
+          timeBackgrounded = performance.now();
+        }
+      });
+
+      return {
+        get initiallyBackgrounded() {
+          return initiallyBackgrounded;
+        },
+        get backgrounded() {
+          return initiallyBackgrounded;
+        },
+        get timeBackgrounded() {
+          return timeBackgrounded;
+        },
+        get timestamp() {
+          return timeBackgrounded ?? performance.now();
+        },
+        note: FALLBACK_ASYNC_NOTE,
+      };
+    }
+
+    const visibilityInfo =
+      'VisibilityStateEntry' in window
+        ? getVisibilityInfo()
+        : getFallbackVisibilityInfo();
+
+    console.log(visibilityInfo);
+  </script>
+
