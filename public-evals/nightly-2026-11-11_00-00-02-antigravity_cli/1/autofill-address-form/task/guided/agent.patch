+  <script>
+    (function () {
+      const form = document.getElementById('shipping-address-form');
+      if (!form) return;
+
+      const submitBtn = document.getElementById('shipping-submit-btn');
+      const statusEl = document.getElementById('shipping-form-status');
+      const controls = Array.from(form.querySelectorAll('.form-control'));
+      const touched = new WeakSet();
+
+      function updateFieldValidity(control) {
+        const errorEl = document.getElementById(control.id + '-error');
+        const isValid = control.checkValidity();
+
+        if (!isValid) {
+          control.setAttribute('aria-invalid', 'true');
+          if (errorEl) {
+            errorEl.hidden = false;
+          }
+        } else {
+          control.removeAttribute('aria-invalid');
+          if (errorEl) {
+            errorEl.hidden = true;
+          }
+        }
+        return isValid;
+      }
+
+      controls.forEach((control) => {
+        control.addEventListener('blur', () => {
+          if (control.value.trim() !== '' || touched.has(control)) {
+            touched.add(control);
+            updateFieldValidity(control);
+          }
+        });
+
+        control.addEventListener('input', () => {
+          touched.add(control);
+          if (control.getAttribute('aria-invalid') === 'true' && control.checkValidity()) {
+            updateFieldValidity(control);
+          }
+          if (statusEl && !statusEl.hidden) {
+            statusEl.hidden = true;
+            statusEl.textContent = '';
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        let firstInvalid = null;
+
+        controls.forEach((control) => {
+          touched.add(control);
+          const valid = updateFieldValidity(control);
+          if (!valid && !firstInvalid) {
+            firstInvalid = control;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        submitBtn.disabled = true;
+        if (statusEl) {
+          statusEl.className = 'form-status success';
+          statusEl.textContent = 'Shipping address saved! Proceeding to coffee bean delivery payment...';
+          statusEl.hidden = false;
+        }
+      });
+    })();
+  </script>
