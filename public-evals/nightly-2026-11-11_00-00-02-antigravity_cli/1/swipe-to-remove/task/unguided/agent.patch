+  <script>
+    (function () {
+      const ACTION_COLOR = '#e53935';
+      const DEFAULT_TRACK_COLOR = '#d7ccc8';
+
+      function getClientX(e) {
+        if (e.touches && e.touches.length > 0) {
+          return e.touches[0].clientX !== undefined ? e.touches[0].clientX : e.touches[0].pageX;
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return e.changedTouches[0].clientX !== undefined ? e.changedTouches[0].clientX : e.changedTouches[0].pageX;
+        }
+        if (typeof e.clientX === 'number') {
+          return e.clientX;
+        }
+        if (typeof e.pageX === 'number') {
+          return e.pageX;
+        }
+        return 0;
+      }
+
+      function updateCartSummary(list) {
+        const remainingItems = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        const totalEl = document.getElementById('cart-total');
+        const summaryEl = document.getElementById('cart-summary');
+        const emptyEl = document.getElementById('cart-empty');
+
+        let sum = 0;
+        remainingItems.forEach(function (item) {
+          sum += parseFloat(item.getAttribute('data-price') || '0');
+        });
+
+        const count = remainingItems.length;
+        if (totalEl) {
+          totalEl.textContent = 'Total (' + count + (count === 1 ? ' item' : ' items') + '): $' + sum.toFixed(2);
+        }
+        if (count === 0) {
+          if (summaryEl) summaryEl.style.display = 'none';
+          if (emptyEl) emptyEl.style.display = 'block';
+        }
+      }
+
+      function initSwipeableItem(item, list) {
+        if (item.classList.contains('is-initialized')) return;
+        item.classList.add('is-initialized');
+
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let isDragging = false;
+        let isRemoving = false;
+        let hasMoved = false;
+        let startX = 0;
+        let currentX = 0;
+
+        function getThreshold() {
+          const width = item.offsetWidth || 300;
+          return Math.min(60, Math.max(30, width * 0.2));
+        }
+
+        function setActionState(active) {
+          if (active) {
+            item.classList.add('is-past-threshold', 'is-active');
+            track.classList.add('is-past-threshold', 'is-active');
+            item.style.backgroundColor = ACTION_COLOR;
+            track.style.backgroundColor = ACTION_COLOR;
+          } else {
+            item.classList.remove('is-past-threshold', 'is-active');
+            track.classList.remove('is-past-threshold', 'is-active');
+            item.style.backgroundColor = DEFAULT_TRACK_COLOR;
+            track.style.backgroundColor = DEFAULT_TRACK_COLOR;
+          }
+        }
+
+        function handleStart(e) {
+          if (isRemoving || isDragging) return;
+          if (e.type === 'mousedown' && e.button !== undefined && e.button !== 0) return;
+
+          isDragging = true;
+          hasMoved = false;
+          startX = getClientX(e);
+          currentX = startX;
+
+          item.classList.add('is-dragging');
+          content.style.transition = 'none';
+        }
+
+        function handleMove(e) {
+          if (!isDragging || isRemoving) return;
+
+          hasMoved = true;
+          currentX = getClientX(e);
+          const deltaX = currentX - startX;
+
+          content.style.transform = 'translateX(' + deltaX + 'px)';
+
+          if (Math.abs(deltaX) >= getThreshold()) {
+            setActionState(true);
+          } else {
+            setActionState(false);
+          }
+        }
+
+        function collapseAndRemove(deltaX) {
+          isRemoving = true;
+          item.classList.remove('is-dragging');
+          item.classList.add('is-removing');
+          setActionState(true);
+
+          const direction = deltaX < 0 ? -1 : 1;
+          const width = item.offsetWidth || 400;
+          content.style.transition = 'transform 0.2s ease';
+          content.style.transform = 'translateX(' + (direction * width) + 'px)';
+
+          const startHeight = item.offsetHeight;
+          item.style.height = startHeight + 'px';
+          track.style.height = startHeight + 'px';
+          void item.offsetHeight;
+
+          item.style.transition = 'height 0.3s ease, margin 0.3s ease, padding 0.3s ease, border-width 0.3s ease, background-color 0.2s ease';
+          track.style.transition = 'height 0.3s ease, background-color 0.2s ease';
+
+          item.style.height = '0px';
+          item.style.marginTop = '0px';
+          item.style.marginBottom = '0px';
+          item.style.paddingTop = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.borderWidth = '0px';
+          track.style.height = '0px';
+
+          updateCartSummary(list);
+
+          let removed = false;
+          function finalizeRemoval() {
+            if (removed) return;
+            removed = true;
+            if (item.parentNode) {
+              item.parentNode.removeChild(item);
+            }
+            updateCartSummary(list);
+          }
+
+          item.addEventListener('transitionend', function onEnd(ev) {
+            if (ev.propertyName === 'height') {
+              item.removeEventListener('transitionend', onEnd);
+              finalizeRemoval();
+            }
+          });
+
+          setTimeout(finalizeRemoval, 320);
+        }
+
+        function handleEnd(e) {
+          if (!isDragging || isRemoving) return;
+          isDragging = false;
+          item.classList.remove('is-dragging');
+
+          if (!hasMoved && e) {
+            const endX = getClientX(e);
+            if (endX !== 0) {
+              currentX = endX;
+            }
+          }
+
+          const deltaX = currentX - startX;
+          if (Math.abs(deltaX) >= getThreshold()) {
+            collapseAndRemove(deltaX);
+          } else {
+            setActionState(false);
+            content.style.transition = 'transform 0.25s ease';
+            content.style.transform = 'translateX(0px)';
+          }
+        }
+
+        [item, track, content].forEach(function (el) {
+          el.addEventListener('pointerdown', handleStart);
+          el.addEventListener('mousedown', handleStart);
+          el.addEventListener('touchstart', handleStart, { passive: true });
+
+          el.addEventListener('pointermove', handleMove);
+          el.addEventListener('mousemove', handleMove);
+          el.addEventListener('touchmove', handleMove, { passive: true });
+
+          el.addEventListener('pointerup', handleEnd);
+          el.addEventListener('mouseup', handleEnd);
+          el.addEventListener('touchend', handleEnd);
+          el.addEventListener('pointercancel', handleEnd);
+          el.addEventListener('touchcancel', handleEnd);
+        });
+
+        window.addEventListener('pointermove', handleMove);
+        window.addEventListener('mousemove', handleMove);
+        window.addEventListener('touchmove', handleMove, { passive: true });
+
+        window.addEventListener('pointerup', handleEnd);
+        window.addEventListener('mouseup', handleEnd);
+        window.addEventListener('touchend', handleEnd);
+        window.addEventListener('pointercancel', handleEnd);
+        window.addEventListener('touchcancel', handleEnd);
+      }
+
+      function initSwipeableLists() {
+        const lists = document.querySelectorAll('.SwipeableList');
+        lists.forEach(function (list) {
+          const items = list.querySelectorAll('.SwipeableList-item');
+          items.forEach(function (item) {
+            initSwipeableItem(item, list);
+          });
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSwipeableLists);
+      } else {
+        initSwipeableLists();
+      }
+    })();
+  </script>
 </body>
 
