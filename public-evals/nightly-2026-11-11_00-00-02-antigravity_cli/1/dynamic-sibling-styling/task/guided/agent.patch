+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateSiblingVars = () => {
+        ['.spectrum-card', '.fan-card', '.circle-orb'].forEach((selector) => {
+          const items = document.querySelectorAll(selector);
+          items.forEach((item, index) => {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', items.length);
+          });
+        });
+      };
+
+      updateSiblingVars();
+
+      const observer = new MutationObserver(updateSiblingVars);
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach((container) => {
+        observer.observe(container, { childList: true });
+      });
+    }
+  </script>
+
