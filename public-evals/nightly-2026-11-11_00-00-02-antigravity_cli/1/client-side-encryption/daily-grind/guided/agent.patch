+  <script type="module">
+    import {
+      toBase64,
+      fromBase64,
+      supportsPostQuantumEnvelope,
+      generateRecipientKeys,
+      loadOrCreateRecipientKeys,
+      encapsulateEnvelopeKey,
+      decapsulateEnvelopeKey,
+      encryptMessage,
+      decryptMessage,
+    } from './delivery-encryption.js';
+
+    const suiteBadge = document.getElementById('active-crypto-suite');
+    const kemSelect = document.getElementById('kem-algorithm');
+    const aadInput = document.getElementById('order-aad');
+    const noteInput = document.getElementById('delivery-note-input');
+    const form = document.getElementById('delivery-note-form');
+    const rotateBtn = document.getElementById('rotate-recipient-key-btn');
+    const decryptBtn = document.getElementById('decrypt-verify-btn');
+    const statusEl = document.getElementById('encryption-status');
+    const pubKeyFormatLabel = document.getElementById('pub-key-format-label');
+    const pubKeyOutput = document.getElementById('recipient-public-key-output');
+    const envelopeOutput = document.getElementById('encrypted-envelope-output');
+    const decryptedOutput = document.getElementById('decrypted-note-output');
+
+    const INFO_BYTES = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+    let activeRecipient = null;
+    let lastEnvelope = null;
+
+    function setStatus(message, isError = false) {
+      statusEl.textContent = message;
+      statusEl.className = `status-msg ${isError ? 'error' : 'success'}`;
+    }
+
+    async function initRecipient(forceRotate = false) {
+      try {
+        const selectedKem = kemSelect.value;
+        activeRecipient = forceRotate
+          ? await generateRecipientKeys(selectedKem)
+          : await loadOrCreateRecipientKeys(selectedKem);
+
+        const isPQ = supportsPostQuantumEnvelope(selectedKem);
+        suiteBadge.textContent = `Suite: ${activeRecipient.suite}`;
+        pubKeyFormatLabel.textContent = isPQ ? 'raw-public' : 'raw';
+        pubKeyOutput.textContent = `${toBase64(activeRecipient.publicKeyBytes)} (${activeRecipient.publicKeyBytes.byteLength} bytes)`;
+        lastEnvelope = null;
+        decryptBtn.disabled = true;
+        decryptedOutput.style.display = 'none';
+      } catch (err) {
+        setStatus(`Key initialization failed: ${err.message}`, true);
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const plaintext = noteInput.value.trim();
+      if (!plaintext) {
+        setStatus('Please enter delivery instructions to encrypt.', true);
+        return;
+      }
+
+      try {
+        if (!activeRecipient) {
+          await initRecipient(false);
+        }
+
+        const additionalData = new TextEncoder().encode(aadInput.value);
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+          activeRecipient.publicKeyBytes,
+          INFO_BYTES,
+        );
+        const { iv, ciphertext } = await encryptMessage(
+          sharedKey,
+          plaintext,
+          additionalData,
+        );
+
+        lastEnvelope = {
+          suite: activeRecipient.suite,
+          aad: aadInput.value,
+          capsule: toBase64(capsuleBytes),
+          iv: toBase64(iv),
+          ciphertext: toBase64(ciphertext),
+        };
+
+        envelopeOutput.textContent = JSON.stringify(lastEnvelope, null, 2);
+        decryptBtn.disabled = false;
+        decryptedOutput.style.display = 'none';
+        setStatus(
+          `Encrypted delivery note (${ciphertext.byteLength} bytes ciphertext, ${capsuleBytes.byteLength} bytes capsule).`,
+        );
+      } catch (err) {
+        setStatus(`Encryption error: ${err.message}`, true);
+      }
+    });
+
+    rotateBtn.addEventListener('click', async () => {
+      await initRecipient(true);
+      envelopeOutput.textContent = 'Courier key pair rotated. Submit to encrypt with the new key.';
+      setStatus('Generated and persisted a fresh courier key pair in IndexedDB.');
+    });
+
+    kemSelect.addEventListener('change', async () => {
+      await initRecipient(false);
+      setStatus(`Switched active suite to ${activeRecipient?.suite || kemSelect.value}.`);
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      if (!lastEnvelope || !activeRecipient) return;
+      try {
+        const capsuleBytes = fromBase64(lastEnvelope.capsule);
+        const iv = fromBase64(lastEnvelope.iv);
+        const ciphertext = fromBase64(lastEnvelope.ciphertext);
+        // Bind verification to current AAD field so tampering rejects with OperationError
+        const additionalData = new TextEncoder().encode(aadInput.value);
+
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          activeRecipient.keyPair.privateKey,
+          capsuleBytes,
+          INFO_BYTES,
+        );
+        const decryptedText = await decryptMessage(
+          recipientSharedKey,
+          iv,
+          ciphertext,
+          additionalData,
+        );
+
+        decryptedOutput.style.display = 'block';
+        decryptedOutput.textContent = `Verified & Decrypted Note: ${decryptedText}`;
+        setStatus('Decapsulated shared key and verified AEAD authentication tag.');
+      } catch (err) {
+        decryptedOutput.style.display = 'block';
+        decryptedOutput.textContent = `Decryption / Authentication failed (${err.name}): AAD or ciphertext was modified.`;
+        setStatus(`Authentication failed: ${err.name}`, true);
+      }
+    });
+
+    initRecipient(false);
+  </script>
 </body>
 
