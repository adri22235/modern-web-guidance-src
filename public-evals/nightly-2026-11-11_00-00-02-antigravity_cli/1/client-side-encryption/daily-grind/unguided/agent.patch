+    const encryptedBytes = new Uint8Array(encryptedBuffer);
+    const ciphertextBytes = encryptedBytes.subarray(0, encryptedBytes.length - 16);
+    const authTagBytes = encryptedBytes.subarray(encryptedBytes.length - 16);
