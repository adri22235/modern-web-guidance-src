+    return {
+      envelope: {
+        version: '1.0',
+        envelopeId,
+        suite: suite.id,
+        suiteLabel: suite.label,
+        kdf: 'HKDF-SHA256',
+        aead: 'AES-256-GCM',
+        metadata,
+        kem: {
+          keyId: recipientPublicBundle.keyId,
+          classicalCurve: activeCurve,
+          ephemeralPublicKey: ephemeralPublicKey ? toBase64(ephemeralPublicKey) : null,
+          pqAlgorithm: pqCiphertext ? 'ML-KEM-768' : null,
+          pqCiphertext: pqCiphertext ? toBase64(pqCiphertext) : null,
+          hkdfSalt: toBase64(hkdfSalt)
+        },
+        aeadPayload: {
+          iv: toBase64(iv),
+          aad: toBase64(aadBytes),
+          ciphertext: toBase64(ciphertextBytes),
+          authTag: toBase64(authTagBytes)
