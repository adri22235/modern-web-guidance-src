+    }
+  };
+
+  // ============================================================================
+  // 4. Classical ECDH Key Agreement (X25519 / P-256) via Web Crypto API
+  // ============================================================================
+
+  async function generateClassicalKeyPair(curve = 'P-256') {
+    const algo = curve === 'X25519' ? { name: 'X25519' } : { name: 'ECDH', namedCurve: 'P-256' };
+    try {
+      const keyPair = await webcrypto.subtle.generateKey(algo, true, ['deriveBits', 'deriveKey']);
