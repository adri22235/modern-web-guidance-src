+    const iv = randomBytes(12);
+    const encryptedBuffer = await webcrypto.subtle.encrypt(
+      {
+        name: 'AES-GCM',
+        iv,
+        additionalData: aadBytes,
+        tagLength: 128
+      },
+      aesKey,
+      plaintextBytes
+    );
