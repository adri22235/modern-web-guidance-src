+  }
+
+  // ============================================================================
+  // 5. Recipient Key Bundle Generation (Hybrid Classical + Post-Quantum)
+  // ============================================================================
+
+  async function generateRecipientKeyBundle(options = {}) {
+    const hubId = options.hubId || 'roastery-downtown-01';
+    const label = options.label || 'Downtown Roastery & Dispatch Hub';
+
+    const p256 = await generateClassicalKeyPair('P-256');
+    const x25519 = await generateClassicalKeyPair('X25519');
+    const pq = MLKEM768.keyGen();
+
+    const combinedPubBytes = concatBytes(
+      utf8Encode(`DG-KEY-V1|${hubId}|${p256.curve}|${x25519.curve}|ML-KEM-768|`),
+      p256.publicKey,
+      x25519.publicKey,
+      pq.publicKey
+    );
