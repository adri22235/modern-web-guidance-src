+  async function decryptDeliveryNote(envelope, recipientPrivateBundle) {
+    const suite = SUITES[envelope.suite];
+    if (!suite) {
+      throw new Error(`Unsupported cryptographic suite: ${envelope.suite}`);
+    }
+    if (envelope.kem.keyId !== recipientPrivateBundle.keyId) {
+      throw new Error(
+        `Key ID mismatch: envelope targets ${envelope.kem.keyId}, recipient holds ${recipientPrivateBundle.keyId}`
+      );
+    }
+
+    let classicalSecret = null;
+    let ephemeralPublicKey = null;
+    let pqSecret = null;
+    let pqCiphertext = null;
+    let pqImplicitRejection = false;
+
+    if (suite.kemType === 'hybrid' || suite.kemType === 'classical') {
+      if (!envelope.kem.ephemeralPublicKey) {
+        throw new Error('Missing classical ephemeral public key in envelope');
+      }
+      ephemeralPublicKey = fromBase64(envelope.kem.ephemeralPublicKey);
+      const useX25519 =
+        envelope.kem.classicalCurve === 'X25519' && recipientPrivateBundle.x25519PrivateKeyJwk;
+      const privJwk = useX25519
+        ? recipientPrivateBundle.x25519PrivateKeyJwk
+        : recipientPrivateBundle.classicalPrivateKeyJwk;
+      const curve = useX25519
+        ? recipientPrivateBundle.x25519Curve || 'X25519'
+        : recipientPrivateBundle.classicalCurve || 'P-256';
+
+      classicalSecret = await ecdhDeriveSharedSecret(privJwk, ephemeralPublicKey, curve);
+    }
+
+    if (suite.kemType === 'hybrid' || suite.kemType === 'pq') {
+      if (!envelope.kem.pqCiphertext) {
+        throw new Error('Missing ML-KEM-768 ciphertext in envelope');
+      }
+      pqCiphertext = fromBase64(envelope.kem.pqCiphertext);
+      const pqSecretKey = fromBase64(recipientPrivateBundle.pqSecretKey);
+      const decaps = MLKEM768.decapsulate(pqSecretKey, pqCiphertext);
+      pqSecret = decaps.sharedSecret;
+      pqImplicitRejection = !decaps.valid;
+    }
+
+    const hkdfSalt = fromBase64(envelope.kem.hkdfSalt);
+    const { aesKey, derivedKeyFingerprint } = await deriveAesGcmKeyFromSecrets({
+      classicalSecret,
+      pqSecret,
+      ephemeralPublicKey,
+      pqCiphertext,
+      keyId: recipientPrivateBundle.keyId,
+      suiteId: suite.id,
+      hkdfSalt
+    });
+
+    const expectedAad = buildCanonicalAAD(envelope.metadata);
+    const envelopeAad = fromBase64(envelope.aeadPayload.aad);
+    if (!constantTimeEqual(expectedAad, envelopeAad)) {
+      throw new Error('AAD integrity check failed: envelope metadata was modified');
+    }
+
+    const iv = fromBase64(envelope.aeadPayload.iv);
+    const ciphertext = fromBase64(envelope.aeadPayload.ciphertext);
+    const authTag = fromBase64(envelope.aeadPayload.authTag);
+    const combinedCiphertextAndTag = concatBytes(ciphertext, authTag);
+
+    let decryptedBuffer;
+    try {
+      decryptedBuffer = await webcrypto.subtle.decrypt(
+        {
+          name: 'AES-GCM',
+          iv,
+          additionalData: expectedAad,
+          tagLength: 128
+        },
+        aesKey,
+        combinedCiphertextAndTag
+      );
+    } catch (_err) {
+      const reason = pqImplicitRejection
+        ? 'ML-KEM-768 implicit rejection triggered & AES-256-GCM authentication tag verification failed'
+        : 'AES-256-GCM authentication tag verification failed (ciphertext, tag, or AAD tampered)';
+      throw new Error(reason);
+    }
+
+    const plaintextJson = utf8Decode(new Uint8Array(decryptedBuffer));
+    const data = JSON.parse(plaintextJson);
+
+    return {
+      verified: true,
+      data,
+      metadata: envelope.metadata,
+      derivedKeyFingerprint,
+      classicalSecretFingerprint: classicalSecret
+        ? toHex(sha3_256(classicalSecret).subarray(0, 12))
+        : null,
+      pqSecretFingerprint: pqSecret ? toHex(sha3_256(pqSecret).subarray(0, 12)) : null
+    };
+  }
+
+  return {
+    SUITES,
+    MLKEM768,
+    sha3_256,
+    sha3_512,
+    shake256,
+    generateClassicalKeyPair,
+    ecdhDeriveSharedSecret,
+    generateRecipientKeyBundle,
+    encryptDeliveryNote,
+    decryptDeliveryNote,
+    toHex,
+    fromHex,
+    toBase64,
+    fromBase64
+  };
+});
