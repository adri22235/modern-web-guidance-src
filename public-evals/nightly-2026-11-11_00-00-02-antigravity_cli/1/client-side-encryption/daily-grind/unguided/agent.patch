+      const ephemeral = await generateClassicalKeyPair(targetCurve);
+      const recipientClassicalPub = fromBase64(targetPubB64);
+      classicalSecret = await ecdhDeriveSharedSecret(
+        ephemeral.privateKeyJwk,
+        recipientClassicalPub,
+        ephemeral.curve
+      );
+      ephemeralPublicKey = ephemeral.publicKey;
+      activeCurve = ephemeral.curve;
+    }
+
+    if (suite.kemType === 'hybrid' || suite.kemType === 'pq') {
+      const recipientPqPub = fromBase64(recipientPublicBundle.pqPublicKey);
+      const encapsResult = MLKEM768.encapsulate(recipientPqPub);
+      pqCiphertext = encapsResult.ciphertext;
+      pqSecret = encapsResult.sharedSecret;
+    }
+
+    const hkdfSalt = randomBytes(16);
+    const { aesKey, derivedKeyFingerprint, transcriptHashHex } = await deriveAesGcmKeyFromSecrets({
+      classicalSecret,
+      pqSecret,
+      ephemeralPublicKey,
+      pqCiphertext,
+      keyId: recipientPublicBundle.keyId,
+      suiteId: suite.id,
+      hkdfSalt
+    });
+
+    const timestamp = options.timestamp || new Date().toISOString();
+    const metadata = {
+      suite: suite.id,
+      keyId: recipientPublicBundle.keyId,
+      hubId: recipientPublicBundle.hubId,
+      orderRef: (payload.orderRef || 'DG-2026-8841').trim(),
+      dropoffType: payload.dropoffType || 'contactless-doorstep',
+      urgency: payload.urgency || 'hot-priority',
+      timestamp
+    };
+    const aadBytes = buildCanonicalAAD(metadata);
+
+    const sensitivePlaintextObj = {
+      note: payload.note || '',
+      accessCode: payload.accessCode || '',
+      contactPhone: payload.contactPhone || '',
+      deliveryInstructions: payload.deliveryInstructions || '',
+      orderRef: metadata.orderRef,
+      dropoffType: metadata.dropoffType
+    };
