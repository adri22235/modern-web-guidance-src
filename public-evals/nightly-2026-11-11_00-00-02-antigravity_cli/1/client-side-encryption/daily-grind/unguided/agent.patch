+        envelopeId,
+        suite: suite.id,
+        suiteLabel: suite.label,
+        classicalCurve: activeCurve,
+        pqAlgorithm: pqCiphertext ? 'ML-KEM-768' : null,
+        classicalSecretFingerprint: classicalSecret
+          ? toHex(sha3_256(classicalSecret).subarray(0, 12))
+          : null,
+        pqSecretFingerprint: pqSecret ? toHex(sha3_256(pqSecret).subarray(0, 12)) : null,
+        derivedKeyFingerprint,
+        transcriptHashHex,
+        ephemeralPublicKeyBytes: ephemeralPublicKey ? ephemeralPublicKey.length : 0,
+        pqCiphertextBytes: pqCiphertext ? pqCiphertext.length : 0,
+        ivHex: toHex(iv),
+        authTagHex: toHex(authTagBytes),
+        plaintextByteLength: plaintextBytes.length,
+        ciphertextByteLength: ciphertextBytes.length,
+        aadByteLength: aadBytes.length
