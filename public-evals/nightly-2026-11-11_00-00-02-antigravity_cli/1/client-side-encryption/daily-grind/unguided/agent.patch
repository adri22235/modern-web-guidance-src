+  async function ecdhDeriveSharedSecret(privateKeyJwk, peerPublicKeyBytes, curve = 'P-256') {
+    const algo = curve === 'X25519' ? { name: 'X25519' } : { name: 'ECDH', namedCurve: 'P-256' };
