+    const keyId = `dgk_${toHex(fingerprintBytes.subarray(0, 8))}`;
+
+    return {
+      keyId,
+      hubId,
+      label,
+      createdAt: new Date().toISOString(),
+      classicalCurve: p256.curve,
+      x25519Supported: x25519.curve === 'X25519',
+      pqAlgorithm: 'ML-KEM-768',
+      fingerprint: toHex(fingerprintBytes.subarray(0, 16)),
+      publicBundle: {
+        keyId,
+        hubId,
+        label,
+        classicalCurve: p256.curve,
+        classicalPublicKey: toBase64(p256.publicKey),
+        x25519Curve: x25519.curve,
+        x25519PublicKey: toBase64(x25519.publicKey),
+        pqAlgorithm: 'ML-KEM-768',
+        pqPublicKey: toBase64(pq.publicKey),
+        fingerprint: toHex(fingerprintBytes.subarray(0, 16))
+      },
+      privateBundle: {
+        keyId,
+        classicalCurve: p256.curve,
+        classicalPrivateKeyJwk: p256.privateKeyJwk,
+        x25519Curve: x25519.curve,
+        x25519PrivateKeyJwk: x25519.privateKeyJwk,
+        pqSecretKey: toBase64(pq.secretKey)
+      }
+    };
+  }
+
+  // ============================================================================
+  // 6. HKDF-SHA256 Key Combiner & AES-256-GCM Authenticated Encryption
+  // ============================================================================
+
+  const SUITES = {
+    'HYBRID-X25519-MLKEM768': {
+      id: 'HYBRID-X25519-MLKEM768',
+      label: 'Hybrid Post-Quantum (X25519 + ML-KEM-768)',
+      kemType: 'hybrid',
+      curve: 'X25519',
+      pq: 'ML-KEM-768',
+      aead: 'AES-256-GCM',
+      kdf: 'HKDF-SHA256'
+    },
+    'HYBRID-P256-MLKEM768': {
+      id: 'HYBRID-P256-MLKEM768',
+      label: 'Hybrid Post-Quantum (ECDH P-256 + ML-KEM-768)',
+      kemType: 'hybrid',
+      curve: 'P-256',
+      pq: 'ML-KEM-768',
+      aead: 'AES-256-GCM',
+      kdf: 'HKDF-SHA256'
+    },
+    'PQ-MLKEM768': {
+      id: 'PQ-MLKEM768',
+      label: 'Post-Quantum KEM (FIPS 203 ML-KEM-768)',
+      kemType: 'pq',
+      curve: null,
+      pq: 'ML-KEM-768',
+      aead: 'AES-256-GCM',
+      kdf: 'HKDF-SHA256'
+    },
+    'CLASSICAL-ECDH-P256': {
+      id: 'CLASSICAL-ECDH-P256',
+      label: 'Classical Key Agreement (ECDH P-256)',
+      kemType: 'classical',
+      curve: 'P-256',
+      pq: null,
+      aead: 'AES-256-GCM',
+      kdf: 'HKDF-SHA256'
+    }
+  };
+
+  async function deriveAesGcmKeyFromSecrets({
+    classicalSecret,
+    pqSecret,
+    ephemeralPublicKey,
+    pqCiphertext,
+    keyId,
+    suiteId,
+    hkdfSalt
+  }) {
+    const ikmParts = [];
+    if (classicalSecret) ikmParts.push(classicalSecret);
+    if (pqSecret) ikmParts.push(pqSecret);
+    if (ikmParts.length === 0) {
+      throw new Error('At least one shared secret (classical or post-quantum) is required');
+    }
+    const ikm = concatBytes(...ikmParts);
+
+    const transcriptHash = sha3_256(
+      concatBytes(
+        utf8Encode(`DailyGrind-DeliveryNotes-v1|${suiteId}|${keyId}|`),
+        ephemeralPublicKey || new Uint8Array(0),
+        pqCiphertext || new Uint8Array(0)
+      )
+    );
+    const info = concatBytes(
+      utf8Encode('DailyGrind-AEAD-AES-256-GCM-Key|'),
+      transcriptHash
+    );
+
+    const baseKey = await webcrypto.subtle.importKey('raw', ikm, 'HKDF', false, [
+      'deriveKey',
+      'deriveBits'
+    ]);
+
+    const aesKey = await webcrypto.subtle.deriveKey(
+      {
+        name: 'HKDF',
+        hash: 'SHA-256',
+        salt: hkdfSalt,
+        info
+      },
+      baseKey,
+      { name: 'AES-GCM', length: 256 },
+      true,
+      ['encrypt', 'decrypt']
+    );
+
+    const rawDerivedKey = new Uint8Array(await webcrypto.subtle.exportKey('raw', aesKey));
+    const derivedKeyFingerprint = toHex(sha3_256(rawDerivedKey).subarray(0, 16));
+
+    return {
+      aesKey,
+      derivedKeyFingerprint,
+      transcriptHashHex: toHex(transcriptHash.subarray(0, 16))
+    };
+  }
+
+  function buildCanonicalAAD(metadata) {
+    const canonical = {
+      v: 1,
+      app: 'daily-grind-delivery-notes',
+      suite: metadata.suite,
+      keyId: metadata.keyId,
+      hubId: metadata.hubId,
+      orderRef: metadata.orderRef || 'ORD-UNASSIGNED',
+      dropoffType: metadata.dropoffType || 'contactless-doorstep',
+      urgency: metadata.urgency || 'standard',
+      timestamp: metadata.timestamp
+    };
+    return utf8Encode(JSON.stringify(canonical));
+  }
+
+  async function encryptDeliveryNote(payload, recipientPublicBundle, options = {}) {
+    const suiteId = options.suite || 'HYBRID-X25519-MLKEM768';
+    const suite = SUITES[suiteId] || SUITES['HYBRID-X25519-MLKEM768'];
+
+    let classicalSecret = null;
+    let ephemeralPublicKey = null;
+    let activeCurve = null;
+    let pqSecret = null;
+    let pqCiphertext = null;
+
+    if (suite.kemType === 'hybrid' || suite.kemType === 'classical') {
+      const wantX25519 = suite.curve === 'X25519' && recipientPublicBundle.x25519PublicKey;
+      const targetCurve = wantX25519
+        ? recipientPublicBundle.x25519Curve || 'X25519'
+        : recipientPublicBundle.classicalCurve || 'P-256';
+      const targetPubB64 = wantX25519
+        ? recipientPublicBundle.x25519PublicKey
+        : recipientPublicBundle.classicalPublicKey;
