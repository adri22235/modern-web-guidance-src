+          orderRef: 'DG-2026-9104',
+          dropoffType: 'contactless-doorstep',
+          accessCode: 'Side Gate Latch Code: 3190',
+          contactPhone: '(555) 014-9921',
+          note: 'Baby sleeping! Please do not knock or ring the smart doorbell. Place Cold Brew carafe behind the terracotta planter on the shaded front porch.'
+        },
+        'office-suite': {
+          orderRef: 'DG-2026-7732',
+          dropoffType: 'concierge-locker',
+          accessCode: 'Lobby Kiosk PIN: 904412#',
+          contactPhone: '(555) 018-4410',
+          note: 'Deliver 3x Dark Roast Espresso boxes to 14th Floor Roastery Locker #12 using kiosk PIN 904412#. Text upon lock confirmation.'
+        }
+      };
+
+      const SUITE_DESCRIPTIONS = {
+        'HYBRID-X25519-MLKEM768':
+          'Combines classical X25519 elliptic-curve Diffie-Hellman shared secret with NIST FIPS 203 ML-KEM-768 lattice encapsulation via HKDF-SHA256 and encrypts with AES-256-GCM.',
+        'HYBRID-P256-MLKEM768':
+          'Combines NIST P-256 ECDH shared secret with NIST FIPS 203 ML-KEM-768 lattice encapsulation via HKDF-SHA256 and encrypts with AES-256-GCM.',
+        'PQ-MLKEM768':
+          'Establishes a 256-bit shared secret using pure post-quantum NIST FIPS 203 ML-KEM-768 public-key encapsulation, derives an AEAD key with HKDF-SHA256, and seals with AES-256-GCM.',
+        'CLASSICAL-ECDH-P256':
+          'Establishes a 256-bit shared secret via ephemeral-static NIST P-256 ECDH key agreement, derives an AEAD key with HKDF-SHA256, and seals with AES-256-GCM.'
+      };
+
+      const STORAGE_KEY = 'daily_grind_encrypted_delivery_notes_v1';
+
+      const hubKeyBundles = {};
+      let activeHubId = 'roastery-downtown-01';
+      let currentEnvelope = null;
+      let currentTelemetry = null;
+      let savedEnvelopes = [];
+
+      // DOM elements
+      const hubSelect = document.getElementById('dispatch-hub-select');
+      const activeKeyIdEl = document.getElementById('active-key-id');
+      const activeKeyAlgosEl = document.getElementById('active-key-algos');
+      const rotateKeysBtn = document.getElementById('rotate-keys-btn');
+      const suiteSelect = document.getElementById('crypto-suite-select');
+      const suiteExplanation = document.getElementById('suite-explanation');
+      const form = document.getElementById('delivery-note-form');
+      const orderRefInput = document.getElementById('order-ref-input');
+      const dropoffTypeSelect = document.getElementById('dropoff-type-select');
+      const accessCodeInput = document.getElementById('access-code-input');
+      const contactPhoneInput = document.getElementById('contact-phone-input');
+      const noteInput = document.getElementById('delivery-note-input');
+      const copyEnvelopeBtn = document.getElementById('copy-envelope-btn');
+
+      const activeSuitePill = document.getElementById('active-suite-pill');
+      const statusBanner = document.getElementById('crypto-status-banner');
+      const statusText = document.getElementById('crypto-status-text');
+      const tClassicalSs = document.getElementById('telemetry-classical-ss');
+      const tPqSs = document.getElementById('telemetry-pq-ss');
+      const tDerivedKey = document.getElementById('telemetry-derived-key');
+      const tKemSizes = document.getElementById('telemetry-kem-sizes');
+      const tIv = document.getElementById('telemetry-iv');
+      const tAuthTag = document.getElementById('telemetry-authtag');
+      const tByteSummary = document.getElementById('telemetry-byte-summary');
+      const envelopeJsonPre = document.getElementById('encrypted-envelope-json');
+
+      const verifyDecryptBtn = document.getElementById('verify-decrypt-btn');
+      const simulateTamperBtn = document.getElementById('simulate-tamper-btn');
+      const verificationBadge = document.getElementById('verification-badge');
+      const decryptedResultBox = document.getElementById('decrypted-result-box');
+      const decStatus = document.getElementById('dec-status');
+      const decOrder = document.getElementById('dec-order');
+      const decPin = document.getElementById('dec-pin');
+      const decNote = document.getElementById('dec-note');
+
+      const savedNotesCount = document.getElementById('saved-notes-count');
+      const savedNotesList = document.getElementById('saved-notes-list');
+      const clearSavedNotesBtn = document.getElementById('clear-saved-notes-btn');
+
+      function loadSavedNotes() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (Array.isArray(parsed)) {
+              savedEnvelopes = parsed;
+            }
+          }
+        } catch (_e) {
+          savedEnvelopes = [];
+        }
+      }
+
+      function persistSavedNotes() {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(savedEnvelopes.slice(0, 10)));
+        } catch (_e) {
+          // Ignore storage quota errors
+        }
+      }
+
+      async function ensureHubKeyBundle(hubId, forceRotate = false) {
+        if (!hubKeyBundles[hubId] || forceRotate) {
+          const cfg = HUB_CONFIGS[hubId] || HUB_CONFIGS['roastery-downtown-01'];
+          hubKeyBundles[hubId] = await window.DailyGrindCrypto.generateRecipientKeyBundle(cfg);
+        }
+        const bundle = hubKeyBundles[hubId];
+        activeKeyIdEl.textContent = `${bundle.keyId} (${bundle.fingerprint.slice(0, 16)}…)`;
+        activeKeyAlgosEl.textContent = `${bundle.x25519Supported ? 'X25519 + ' : ''}ECDH P-256 + ML-KEM-768`;
+        return bundle;
+      }
+
+      function updateTelemetryUI(envelope, telemetry) {
+        activeSuitePill.textContent = envelope.suite;
+        tClassicalSs.textContent = telemetry.classicalSecretFingerprint
+          ? `${telemetry.classicalCurve}: ${telemetry.classicalSecretFingerprint}`
+          : 'N/A (PQ-Only Mode)';
+        tPqSs.textContent = telemetry.pqSecretFingerprint
+          ? `ML-KEM-768: ${telemetry.pqSecretFingerprint}`
+          : 'N/A (Classical Mode)';
+        tDerivedKey.textContent = `hkdf_${telemetry.derivedKeyFingerprint}`;
+        tKemSizes.textContent = `${telemetry.ephemeralPublicKeyBytes} B ephem / ${telemetry.pqCiphertextBytes} B PQ CT`;
+        tIv.textContent = telemetry.ivHex;
+        tAuthTag.textContent = telemetry.authTagHex;
+        tByteSummary.textContent = `${telemetry.plaintextByteLength} B plaintext → ${telemetry.ciphertextByteLength} B ciphertext + 16 B tag`;
+        envelopeJsonPre.textContent = JSON.stringify(envelope, null, 2);
+      }
+
+      async function verifyAndDisplayEnvelope(envelope, bundle) {
+        try {
+          const res = await window.DailyGrindCrypto.decryptDeliveryNote(
+            envelope,
+            bundle.privateBundle
+          );
+          decryptedResultBox.classList.remove('tampered');
+          verificationBadge.textContent = 'Verified Authentic (AES-256-GCM)';
+          verificationBadge.style.color = 'var(--success-text)';
+          statusBanner.className = 'status-banner success';
+          statusText.textContent = `Shared secret established (${envelope.suite}) & note authenticated with AES-256-GCM.`;
+
+          decStatus.textContent = `Verified (${envelope.aead} + ${envelope.kdf}, Key ID ${envelope.kem.keyId})`;
+          decOrder.textContent = `${res.data.orderRef} (${res.data.dropoffType})`;
+          decPin.textContent = res.data.accessCode || '(None provided)';
+          decNote.textContent = res.data.note;
+        } catch (err) {
+          decryptedResultBox.classList.add('tampered');
+          verificationBadge.textContent = 'Authentication Failed!';
+          verificationBadge.style.color = 'var(--danger-text)';
+          statusBanner.className = 'status-banner error';
+          statusText.textContent = `Security Alert: ${err.message}`;
+
+          decStatus.textContent = `REJECTED — ${err.message}`;
+          decOrder.textContent = 'BLOCKED (Unauthenticated Ciphertext)';
+          decPin.textContent = 'REDACTED';
+          decNote.textContent = 'Decryption aborted because AES-256-GCM authentication tag or AAD verification failed.';
+        }
+      }
+
+      function renderSavedNotes() {
+        savedNotesCount.textContent = String(savedEnvelopes.length);
+        savedNotesList.innerHTML = '';
+        if (savedEnvelopes.length === 0) {
+          const empty = document.createElement('p');
+          empty.style.fontSize = '0.86rem';
+          empty.style.color = 'var(--muted)';
+          empty.textContent = 'No encrypted delivery notes queued yet. Use the form above to seal a note.';
+          savedNotesList.appendChild(empty);
+          return;
+        }
+
+        savedEnvelopes.forEach((item, index) => {
+          const card = document.createElement('div');
+          card.className = 'saved-note-card';
+
+          const top = document.createElement('div');
+          const title = document.createElement('strong');
+          title.style.color = 'var(--primary)';
+          title.textContent = `${item.metadata.orderRef} • ${item.suite}`;
+          const meta = document.createElement('div');
+          meta.className = 'saved-note-meta';
+          meta.textContent = `Hub: ${item.metadata.hubId} | Drop-off: ${item.metadata.dropoffType} | Envelope: ${item.envelopeId}`;
+          top.appendChild(title);
+          top.appendChild(meta);
+
+          const cipherPreview = document.createElement('div');
+          cipherPreview.className = 'saved-note-cipher';
+          cipherPreview.textContent = `CT: ${item.aeadPayload.ciphertext.slice(0, 44)}… | Tag: ${item.aeadPayload.authTag}`;
+
+          const actions = document.createElement('div');
+          actions.style.display = 'flex';
+          actions.style.gap = '8px';
+
+          const inspectBtn = document.createElement('button');
+          inspectBtn.type = 'button';
+          inspectBtn.className = 'btn btn-outline';
+          inspectBtn.textContent = 'Inspect Envelope';
+          inspectBtn.addEventListener('click', async () => {
+            currentEnvelope = item;
+            envelopeJsonPre.textContent = JSON.stringify(item, null, 2);
+            const bundle = hubKeyBundles[item.metadata.hubId];
+            if (bundle && bundle.keyId === item.kem.keyId) {
+              await verifyAndDisplayEnvelope(item, bundle);
+            } else {
+              statusBanner.className = 'status-banner success';
+              statusText.textContent = `Loaded sealed envelope ${item.envelopeId} (${item.suite}).`;
+            }
+          });
+
+          const removeBtn = document.createElement('button');
+          removeBtn.type = 'button';
+          removeBtn.className = 'btn btn-danger-outline';
+          removeBtn.textContent = 'Remove';
+          removeBtn.addEventListener('click', () => {
+            savedEnvelopes.splice(index, 1);
+            persistSavedNotes();
+            renderSavedNotes();
+          });
+
+          actions.appendChild(inspectBtn);
+          actions.appendChild(removeBtn);
+
+          card.appendChild(top);
+          card.appendChild(cipherPreview);
+          card.appendChild(actions);
+          savedNotesList.appendChild(card);
+        });
+      }
+
+      async function handleEncrypt(saveToQueue = true) {
+        const bundle = await ensureHubKeyBundle(activeHubId, false);
+        const suite = suiteSelect.value;
+        const payload = {
+          orderRef: orderRefInput.value.trim() || 'DG-2026-8841',
+          dropoffType: dropoffTypeSelect.value,
+          accessCode: accessCodeInput.value.trim(),
+          contactPhone: contactPhoneInput.value.trim(),
+          note: noteInput.value.trim()
+        };
+
+        const { envelope, telemetry } = await window.DailyGrindCrypto.encryptDeliveryNote(
+          payload,
+          bundle.publicBundle,
+          { suite }
+        );
+
+        currentEnvelope = envelope;
+        currentTelemetry = telemetry;
+
+        updateTelemetryUI(envelope, telemetry);
+        await verifyAndDisplayEnvelope(envelope, bundle);
+
+        if (saveToQueue) {
+          savedEnvelopes = [envelope, ...savedEnvelopes.filter(e => e.envelopeId !== envelope.envelopeId)].slice(0, 8);
+          persistSavedNotes();
+          renderSavedNotes();
+        }
+      }
+
+      // Event Listeners
+      hubSelect.addEventListener('change', async () => {
+        activeHubId = hubSelect.value;
+        await ensureHubKeyBundle(activeHubId, false);
+        await handleEncrypt(false);
+      });
+
+      rotateKeysBtn.addEventListener('click', async () => {
+        await ensureHubKeyBundle(activeHubId, true);
+        await handleEncrypt(true);
+      });
+
+      suiteSelect.addEventListener('change', async () => {
+        suiteExplanation.textContent =
+          SUITE_DESCRIPTIONS[suiteSelect.value] || SUITE_DESCRIPTIONS['HYBRID-X25519-MLKEM768'];
+        await handleEncrypt(false);
+      });
+
+      document.querySelectorAll('.preset-chip').forEach((btn) => {
+        btn.addEventListener('click', async () => {
+          const preset = PRESETS[btn.getAttribute('data-preset')];
+          if (!preset) return;
+          orderRefInput.value = preset.orderRef;
+          dropoffTypeSelect.value = preset.dropoffType;
+          accessCodeInput.value = preset.accessCode;
+          contactPhoneInput.value = preset.contactPhone;
+          noteInput.value = preset.note;
+          await handleEncrypt(true);
+        });
+      });
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await handleEncrypt(true);
+      });
+
+      copyEnvelopeBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        const text = JSON.stringify(currentEnvelope, null, 2);
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          try {
+            await navigator.clipboard.writeText(text);
+            copyEnvelopeBtn.textContent = 'Copied Envelope JSON!';
+            setTimeout(() => {
+              copyEnvelopeBtn.textContent = 'Copy Encrypted Envelope JSON';
+            }, 1800);
+          } catch (_e) {
+            // Fallback
+          }
+        }
+      });
+
+      verifyDecryptBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        const bundle = await ensureHubKeyBundle(activeHubId, false);
+        await verifyAndDisplayEnvelope(currentEnvelope, bundle);
+      });
+
+      simulateTamperBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        const bundle = await ensureHubKeyBundle(activeHubId, false);
+        const tampered = JSON.parse(JSON.stringify(currentEnvelope));
+        const ctBytes = window.DailyGrindCrypto.fromBase64(tampered.aeadPayload.ciphertext);
+        if (ctBytes.length > 0) {
+          ctBytes[0] ^= 0xff;
+        }
+        tampered.aeadPayload.ciphertext = window.DailyGrindCrypto.toBase64(ctBytes);
+        envelopeJsonPre.textContent = JSON.stringify(tampered, null, 2);
+        await verifyAndDisplayEnvelope(tampered, bundle);
+      });
+
+      clearSavedNotesBtn.addEventListener('click', () => {
+        savedEnvelopes = [];
+        persistSavedNotes();
+        renderSavedNotes();
+      });
+
+      // Initialize on page load
+      (async function init() {
+        loadSavedNotes();
+        await ensureHubKeyBundle(activeHubId, false);
+        await handleEncrypt(savedEnvelopes.length === 0);
+        renderSavedNotes();
+      })();
+    })();
+  </script>
 </body>
 
 </html>
