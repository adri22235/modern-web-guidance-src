+    <div id="seasonal-preview" aria-live="polite">Select a drink to preview</div>
   </main>
 
+  <script>
+    const seasonalPreview = document.getElementById('seasonal-preview');
+    const DEFAULT_PREVIEW_TEXT = 'Select a drink to preview';
+    let activeInterestSource = null;
+
+    seasonalPreview.addEventListener('interest', (event) => {
+      const source =
+        event.source ||
+        document.querySelector('[interestfor="seasonal-preview"]:interest-source') ||
+        document.querySelector('[interestfor="seasonal-preview"]:hover, [interestfor="seasonal-preview"]:focus');
+
+      activeInterestSource = source || null;
+
+      const card = source ? source.closest('.card') : null;
+      const drink =
+        (source && source.dataset.drink) ||
+        (card && card.querySelector('h3') && card.querySelector('h3').textContent.trim()) ||
+        'Seasonal Drink';
+      const description =
+        (source && source.dataset.description) ||
+        (card && card.querySelector('p') && card.querySelector('p').textContent.trim()) ||
+        '';
+      const accentColor = (source && source.dataset.color) || '#ffab40';
+
+      seasonalPreview.textContent = description ? `${drink} — ${description}` : drink;
+      seasonalPreview.style.setProperty('--preview-accent', accentColor);
+      seasonalPreview.style.borderColor = accentColor;
+      seasonalPreview.dataset.drink = drink;
+    });
+
+    seasonalPreview.addEventListener('loseinterest', (event) => {
+      if (event.source && activeInterestSource && event.source !== activeInterestSource) {
+        return;
+      }
+      activeInterestSource = null;
+      seasonalPreview.textContent = DEFAULT_PREVIEW_TEXT;
+      seasonalPreview.style.removeProperty('--preview-accent');
+      seasonalPreview.style.borderColor = '';
+      delete seasonalPreview.dataset.drink;
+    });
+  </script>
