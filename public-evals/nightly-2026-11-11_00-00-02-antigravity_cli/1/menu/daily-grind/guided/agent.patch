+      setTimeout(() => {
+        windowBlurred = false;
+      }, 0);
+    });
+
+    // Trigger setup: pointerdown, click, toggle, and submenu preview
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+
+      // Prevent focus move on pointerdown so pointer click toggles cleanly
+      trigger.addEventListener("pointerdown", event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener("click", event => {
+        const fromPointer = pointerTrigger === trigger && event.detail > 0;
+        if (!hasInvokerCommands) {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            closeAndRestore(menu, { fromPointer });
+          } else {
+            if (!fromPointer) enterOnOpen.add(menu);
+            menu.showPopover({ source: trigger });
+          }
+          return;
+        }
+        // With native invokers, mark keyboard opens before toggle-popover opens the menu
+        if (!fromPointer && !isOpen(menu)) {
+          enterOnOpen.add(menu);
+        }
+      });
+
+      // Keep aria-expanded in sync and move focus in toggle, never in command
+      menu.addEventListener("toggle", event => {
+        const open = event.newState === "open";
+        trigger.setAttribute("aria-expanded", String(open));
+        if (!open) {
+          enterOnOpen.delete(menu);
+          pointerTrigger = null;
+          return;
+        }
+
+        positionMenuFallback(menu, trigger);
+
+        if (enterOnOpen.has(menu)) {
+          enterOnOpen.delete(menu);
+          const first = enabledItems(menu)[0];
+          first?.focus({ preventScroll: true });
+        } else if (pointerTrigger === trigger) {
+          focusElement(trigger, { fromPointer: true });
+        }
+        pointerTrigger = null;
+      });
+
+      // Trigger keyboard handling: ArrowDown on top-level triggers, ArrowRight on submenu triggers
+      trigger.addEventListener("keydown", event => {
+        if (!isSubmenuTrigger(trigger) && event.key === "ArrowDown") {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            enabledItems(menu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(menu);
+            trigger.click();
+          }
+        } else if (isSubmenuTrigger(trigger) && event.key === "ArrowRight") {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isOpen(menu)) {
+            enabledItems(menu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(menu);
+            trigger.click();
+          }
+        }
+      });
+
+      // Submenu triggers preview their submenu on focus and hide preview on blur
+      if (isSubmenuTrigger(trigger)) {
+        trigger.addEventListener("focus", event => {
+          if (windowBlurred || suppressPreview.has(trigger)) return;
+          if (event.relatedTarget && menu.contains(event.relatedTarget)) return;
+          if (!isOpen(menu)) {
+            menu.showPopover({ source: trigger });
+          }
+        });
+
+        trigger.addEventListener("blur", event => {
+          if (!isOpen(menu)) return;
+          if (event.relatedTarget && menu.contains(event.relatedTarget)) return;
+          menu.hidePopover();
+        });
+
+        trigger.addEventListener("pointerleave", event => {
+          clearTimeout(hoverTimers.get(trigger));
+          startBridge(menu, event);
+        });
+      }
+    });
+
+    // Menu container interactions: Home/End, Escape, ArrowLeft, Tab, pointer hover, and item activation
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      const menu = group.parentElement;
+
+      group.addEventListener("keydown", event => {
+        lastKeyDown = event.key;
+
+        // Native focusgroup handles ArrowUp/ArrowDown; script handles Home and End
+        if (hasNativeFocusGroup && (event.key === "Home" || event.key === "End")) {
+          const items = enabledItems(menu);
+          if (!items.length) return;
+          event.preventDefault();
+          const target = event.key === "Home" ? items[0] : items[items.length - 1];
+          target.focus({ preventScroll: true });
+          return;
+        }
+
+        if (event.key === "Escape") {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu, { fromPointer: false });
+          return;
+        }
+
+        if (event.key === "ArrowLeft" && isSubmenu(menu)) {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu, { fromPointer: false });
+          return;
+        }
+
+        if (event.key === "Tab") {
+          const rootMenu = rootMenuFor(menu);
+          if (rootMenu) {
+            const rootTrigger = triggerFor(rootMenu);
+            if (rootTrigger) {
+              suppressPreview.add(rootTrigger);
+              rootTrigger.focus({ preventScroll: true });
+              queueMicrotask(() => suppressPreview.delete(rootTrigger));
+            }
+            rootMenu.hidePopover();
+          }
+        }
+      });
+
+      // Hover follows focus without a focus ring; submenu triggers use a brief delay
+      group.addEventListener("pointermove", event => {
+        const item = event.target.closest("button");
+        if (!item || item.closest("[focusgroup]") !== group) return;
+        if (item.disabled || item.getAttribute("aria-disabled") === "true") return;
+
+        // Guard against hit-testing before the safe-triangle bridge existed
+        const hit = document.elementFromPoint(event.clientX, event.clientY);
+        if (!hit || !item.contains(hit)) return;
+
+        if (item.hasAttribute("commandfor")) {
+          if (document.activeElement === item || hoverTimers.has(item)) return;
+          const timer = setTimeout(() => {
+            hoverTimers.delete(item);
+            focusElement(item, { fromPointer: true });
+          }, 120);
+          hoverTimers.set(item, timer);
+        } else {
+          if (document.activeElement !== item) {
+            focusElement(item, { fromPointer: true });
+          }
+        }
+      });
+
+      // Command and checkable item activation
+      group.addEventListener("click", event => {
+        const item = event.target.closest("button");
+        if (!item || item.closest("[focusgroup]") !== group) return;
+        if (item.hasAttribute("commandfor")) return; // Submenu triggers never also run a command
+        if (item.disabled || item.getAttribute("aria-disabled") === "true") return;
+
+        const fromPointer = event.detail > 0;
+        const activationKey = fromPointer ? null : lastKeyDown;
+        lastKeyDown = null;
+
+        const role = item.getAttribute("role");
+        const rootMenu = rootMenuFor(menu);
+        const card = rootMenu ? triggerFor(rootMenu)?.closest("[data-drink-card]") : null;
+        const drinkName = card?.dataset.drinkCard || "Coffee Menu";
+
+        if (role === "menuitemcheckbox") {
+          const nextChecked = item.getAttribute("aria-checked") !== "true";
+          item.setAttribute("aria-checked", String(nextChecked));
+          const label = item.textContent.trim();
+          announce(`${drinkName}: ${label} ${nextChecked ? "enabled" : "disabled"}.`);
+          if (card) updateCardSummary(card, rootMenu);
+
+          // APG: Space on a checkbox toggles and stays open; Enter or pointer click closes after ~300ms
+          if (activationKey === " ") return;
+          setTimeout(() => {
+            closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+          return;
+        }
+
+        if (role === "menuitemradio") {
+          const radioGroup = item.closest('[role="group"]');
+          if (radioGroup) {
+            radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+              radio.setAttribute("aria-checked", String(radio === item));
+            });
+          } else {
+            item.setAttribute("aria-checked", "true");
+          }
+          const groupName = radioGroup?.getAttribute("aria-label") || "Option";
+          const label = item.textContent.trim();
+          announce(`${drinkName} (${groupName}): ${label} selected.`);
+          if (card) updateCardSummary(card, rootMenu);
+
+          setTimeout(() => {
+            closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+          return;
+        }
+
+        // Standard command activation
+        const actionMessage = item.dataset.action || `${drinkName}: ${item.textContent.trim()}`;
+        announce(`${actionMessage}.`);
+        closeAndRestore(rootMenu, { fromPointer });
+      });
+    });
+
+    // Close every open menu when focus moves outside the menu system
+    document.addEventListener("focusin", event => {
+      const target = event.target;
+      if (!(target instanceof Element)) return;
+      if (target.closest('[popover]:has(> [focusgroup~="menu"])')) return;
+      if (target.closest("button[commandfor]")) return;
+      menus.filter(isOpen).forEach(menu => menu.hidePopover());
+    });
+
+    function announce(message) {
+      if (statusText) {
+        statusText.textContent = message;
+      }
+    }
+
+    function updateCardSummary(card, rootMenu) {
+      const summaryEl = card.querySelector(".summary-text");
+      if (!summaryEl || !rootMenu) return;
+      const checkedItems = [...rootMenu.querySelectorAll('button[aria-checked="true"]')]
+        .map(btn => btn.textContent.trim());
+      summaryEl.textContent = checkedItems.length ? checkedItems.join(" · ") : "Standard preparation";
+    }
+  </script>
 </body>
 
 </html>
