+    /* Nutritional & Pricing Table */
+    .table-wrapper {
+      margin-top: 35px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      border: 1px solid var(--secondary);
+    }
+
+    .table-wrapper:focus {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      min-width: 600px;
+      text-align: left;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      padding: 18px 20px 12px;
+      text-align: left;
+      caption-side: top;
+      border-bottom: 2px solid var(--secondary);
+    }
+
+    .nutrition-table caption span {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: normal;
+      color: var(--text);
+      margin-top: 4px;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 14px 16px;
+      border-bottom: 1px solid var(--secondary);
+      vertical-align: middle;
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+      border-bottom: 2px solid #3e2723;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      font-weight: 600;
+      color: var(--primary);
+      background-color: #fff;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+      white-space: nowrap;
+      border-right: 1px solid var(--secondary);
+    }
+
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 2;
+      border-right: 1px solid rgba(255, 255, 255, 0.2);
+    }
+
+    .nutrition-table tbody tr:nth-child(even) {
+      background-color: #f8f5f4;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) th[scope="row"] {
+      background-color: #f8f5f4;
+    }
+
+    .nutrition-table tbody tr:hover,
+    .nutrition-table tbody tr:hover th[scope="row"] {
+      background-color: #efebe9;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .price-cell {
+      font-weight: 600;
+      color: var(--primary);
+      white-space: nowrap;
+    }
+
+    @media (max-width: 640px) {
+      .nutrition-table {
+        font-size: 0.875rem;
+        min-width: 520px;
+      }
+
+      .nutrition-table caption {
+        font-size: 1.1rem;
+        padding: 14px 14px 10px;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+      }
+
+      .nutrition-table tbody th[scope="row"] {
+        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.06);
+      }
+    }
+
