+  <script type="module">
+    const ownedExpandedTriggers = new WeakSet();
+
+    function normalizeText(str) {
+      return (str || '').replace(/\s+/g, ' ').trim();
+    }
+
+    function getAccessibleName(el) {
+      const labelledBy = el.getAttribute('aria-labelledby');
+      if (labelledBy) {
+        const text = labelledBy
+          .split(/\s+/)
+          .map((id) => document.getElementById(id)?.textContent || '')
+          .join(' ');
+        if (normalizeText(text)) return normalizeText(text);
+      }
+      const ariaLabel = el.getAttribute('aria-label');
+      if (ariaLabel && normalizeText(ariaLabel)) {
+        return normalizeText(ariaLabel);
+      }
+      const imgAlts = Array.from(el.querySelectorAll('img[alt]'))
+        .map((img) => img.getAttribute('alt') || '')
+        .join(' ');
+      const combinedText = normalizeText(`${el.textContent || ''} ${imgAlts}`);
+      if (combinedText) return combinedText;
+      return normalizeText(el.getAttribute('title') || '');
+    }
+
+    export function wireInterestHints(root = document) {
+      const triggers = root.querySelectorAll('[interestfor]');
+      for (const trigger of triggers) {
+        const targetId = trigger.getAttribute('interestfor');
+        if (!targetId) continue;
+        const hint = document.getElementById(targetId);
+        if (!hint || hint.getAttribute('popover') !== 'hint') continue;
+
+        const hintText = normalizeText(hint.textContent);
+        const triggerName = getAccessibleName(trigger);
+
+        if (hintText && hintText === triggerName) {
+          continue;
+        }
+
+        if (!hint.hasAttribute('role')) {
+          hint.setAttribute('role', 'tooltip');
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute('aria-labelledby')) {
+            trigger.setAttribute('aria-labelledby', targetId);
+          }
+        } else {
+          const opensOnActivation =
+            trigger.getAttribute('popovertarget') === targetId ||
+            trigger.getAttribute('commandfor') === targetId;
+
+          if (opensOnActivation) {
+            if (!trigger.hasAttribute('aria-expanded')) {
+              const isOpen =
+                hint.matches?.(':popover-open') ||
+                hint.classList.contains(':popover-open');
+              trigger.setAttribute('aria-expanded', String(isOpen));
+              ownedExpandedTriggers.add(trigger);
+            }
+          } else if (!trigger.hasAttribute('aria-describedby')) {
+            trigger.setAttribute('aria-describedby', targetId);
+          }
+        }
+      }
+    }
+
+    window.wireInterestHints = wireInterestHints;
+    wireInterestHints();
+
+    document.addEventListener(
+      'toggle',
+      (event) => {
+        const popover = event.target;
+        if (!(popover instanceof HTMLElement) || !popover.id) return;
+        const isOpen =
+          event.newState === 'open' ||
+          popover.matches?.(':popover-open') ||
+          popover.classList.contains(':popover-open');
+        const triggers = document.querySelectorAll(
+          `[interestfor="${CSS.escape(popover.id)}"]`
+        );
+        for (const trigger of triggers) {
+          if (ownedExpandedTriggers.has(trigger)) {
+            trigger.setAttribute('aria-expanded', String(isOpen));
+          }
+        }
+      },
+      true
+    );
+
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      await import(
+        'https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js'
+      );
+    }
+
+    if (!('interestForElement' in HTMLButtonElement.prototype)) {
+      await import('https://unpkg.com/interestfor@latest');
+    }
+
+    if (!CSS.supports('anchor-name: --a')) {
+      await import('https://unpkg.com/@oddbird/css-anchor-positioning');
+    }
+  </script>
