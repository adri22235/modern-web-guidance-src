+  <script>
+    document.querySelectorAll('.card').forEach((card) => {
+      const trigger = card.querySelector('.btn');
+      const hovercard = card.querySelector('.hovercard');
+      if (!trigger || !hovercard) return;
+
+      let hideTimeout = null;
+
+      const showCard = () => {
+        clearTimeout(hideTimeout);
+        document.querySelectorAll('.hovercard.is-visible').forEach((openCard) => {
+          if (openCard !== hovercard) {
+            openCard.classList.remove('is-visible');
+            openCard.setAttribute('aria-hidden', 'true');
+          }
+        });
+        hovercard.classList.add('is-visible');
+        hovercard.setAttribute('aria-hidden', 'false');
+      };
+
+      const scheduleHide = () => {
+        clearTimeout(hideTimeout);
+        hideTimeout = setTimeout(() => {
+          hovercard.classList.remove('is-visible');
+          hovercard.setAttribute('aria-hidden', 'true');
+        }, 120);
+      };
+
+      trigger.addEventListener('mouseenter', showCard);
+      trigger.addEventListener('mouseleave', scheduleHide);
+      trigger.addEventListener('focus', showCard);
+      trigger.addEventListener('blur', scheduleHide);
+
+      hovercard.addEventListener('mouseenter', showCard);
+      hovercard.addEventListener('mouseleave', scheduleHide);
+      hovercard.addEventListener('focusin', showCard);
+      hovercard.addEventListener('focusout', (e) => {
+        if (!hovercard.contains(e.relatedTarget) && e.relatedTarget !== trigger) {
+          scheduleHide();
+        }
+      });
+
+      const priceEl = hovercard.querySelector('[data-price]');
+      const calEl = hovercard.querySelector('[data-calories]');
+      const cafEl = hovercard.querySelector('[data-caffeine]');
+      const sizeBtns = hovercard.querySelectorAll('.hovercard-size-btn');
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          sizeBtns.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          if (priceEl && btn.dataset.sizePrice) priceEl.textContent = btn.dataset.sizePrice;
+          if (calEl && btn.dataset.sizeCal) calEl.textContent = btn.dataset.sizeCal;
+          if (cafEl && btn.dataset.sizeCaf) cafEl.textContent = btn.dataset.sizeCaf;
+        });
+      });
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') {
+        document.querySelectorAll('.hovercard.is-visible').forEach((openCard) => {
+          openCard.classList.remove('is-visible');
+          openCard.setAttribute('aria-hidden', 'true');
+        });
+      }
+    });
+  </script>
 </body>
 
