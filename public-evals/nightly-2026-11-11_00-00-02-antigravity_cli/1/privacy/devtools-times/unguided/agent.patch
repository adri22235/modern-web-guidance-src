 import React, { useState } from 'react';
 
+function mapSignInError(errorCode?: string): string {
+  // Privacy by Design: Use a uniform message for authentication failures (e.g. APP_ERR_2001 user not found,
+  // APP_ERR_2002 wrong password) to prevent account/username enumeration and avoid leaking internal codes.
+  if (!errorCode) {
+    return 'Unable to sign in. Please verify your credentials and try again.';
+  }
+
+  switch (errorCode) {
+    case 'APP_ERR_2001':
+    case 'APP_ERR_2002':
+      return 'Invalid username or password. Please verify your credentials and try again.';
+    default:
+      return 'Invalid username or password. Please verify your credentials and try again.';
+  }
+}
+
 export default function SignInForm() {
   const [username, setUsername] = useState('');
