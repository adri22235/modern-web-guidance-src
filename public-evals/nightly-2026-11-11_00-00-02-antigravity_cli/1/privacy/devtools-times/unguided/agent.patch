+export interface PrivacyConsentState {
+  /** Strictly necessary features (e.g., on-demand reading list session, local consent storage). Always true. */
+  essential: true;
+  /** Third-party click interaction analytics (times_cdn/lib/analytics-client.js). Default: false (opt-in only). */
+  analytics: boolean;
+  /** Third-party contextual advertising (times_cdn/lib/ad-client.js). Default: false (opt-in only). */
+  advertising: boolean;
+  /** ISO-8601 timestamp when the user explicitly made or updated their choice. */
+  updatedAt: string;
+}
+
+export const PRIVACY_CONSENT_STORAGE_KEY = 'dtt_privacy_consent_v1';
+export const PRIVACY_CONSENT_EVENT = 'dtt:privacy-consent-updated';
+export const OPEN_PRIVACY_MODAL_EVENT = 'dtt:open-privacy-preferences';
+
+/**
+ * Checks whether the user's browser is sending an automated privacy signal
+ * such as Global Privacy Control (GPC) or Do Not Track (DNT).
+ */
+export function hasBrowserPrivacySignal(): {
+  gpc: boolean;
+  dnt: boolean;
+  active: boolean;
+} {
+  if (typeof window === 'undefined' || typeof navigator === 'undefined') {
+    return { gpc: false, dnt: false, active: false };
+  }
+
+  const nav = navigator as Navigator & {
+    globalPrivacyControl?: boolean;
+    msDoNotTrack?: string;
+  };
+  const win = window as Window & { doNotTrack?: string };
+
+  const gpc = Boolean(nav.globalPrivacyControl);
+  const dnt =
+    nav.doNotTrack === '1' ||
+    nav.doNotTrack === 'yes' ||
+    win.doNotTrack === '1' ||
+    nav.msDoNotTrack === '1';
+
+  return {
+    gpc,
+    dnt,
+    active: gpc || dnt,
+  };
+}
+
+/**
+ * Reads stored privacy consent preferences from localStorage.
+ * Returns null if the user has not yet made an explicit choice.
+ */
+export function getStoredPrivacyConsent(): PrivacyConsentState | null {
+  if (typeof window === 'undefined') return null;
+
+  try {
+    const raw = window.localStorage.getItem(PRIVACY_CONSENT_STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw);
+    if (typeof parsed !== 'object' || parsed === null) return null;
+
+    // If Global Privacy Control is active, enforce opt-out of third-party tracking/advertising
+    const signals = hasBrowserPrivacySignal();
+    if (signals.gpc) {
+      return {
+        essential: true,
+        analytics: false,
+        advertising: false,
+        updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : new Date().toISOString(),
+      };
+    }
+
+    return {
+      essential: true,
+      analytics: Boolean(parsed.analytics),
+      advertising: Boolean(parsed.advertising),
+      updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : new Date().toISOString(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Returns the effective consent state, defaulting to strict privacy-by-default
+ * (all non-essential third-party scripts disabled) until explicit opt-in.
+ */
+export function getEffectivePrivacyConsent(): PrivacyConsentState {
+  const stored = getStoredPrivacyConsent();
+  if (stored) return stored;
+
+  return {
+    essential: true,
+    analytics: false,
+    advertising: false,
+    updatedAt: '',
+  };
+}
+
+/**
+ * Persists the user's explicit privacy preferences and notifies listeners.
+ */
+export function savePrivacyConsent(preferences: {
+  analytics: boolean;
+  advertising: boolean;
+}): PrivacyConsentState {
+  const signals = hasBrowserPrivacySignal();
+  const state: PrivacyConsentState = {
+    essential: true,
+    analytics: signals.gpc ? false : Boolean(preferences.analytics),
+    advertising: signals.gpc ? false : Boolean(preferences.advertising),
+    updatedAt: new Date().toISOString(),
+  };
+
+  if (typeof window !== 'undefined') {
+    try {
+      window.localStorage.setItem(PRIVACY_CONSENT_STORAGE_KEY, JSON.stringify(state));
+    } catch {
+      // Ignore storage quota errors
+    }
+    window.dispatchEvent(new CustomEvent(PRIVACY_CONSENT_EVENT, { detail: state }));
+  }
+
+  return state;
+}
+
+/**
+ * Checks whether the current path is a sensitive authentication route where
+ * third-party scripts must never execute regardless of consent.
+ */
+export function isSensitiveAuthRoute(pathname?: string): boolean {
+  const path =
+    pathname ?? (typeof window !== 'undefined' ? window.location.pathname : '');
+  return /\/(signin|signup)(\/|$)/i.test(path);
+}
