diff --git a/src/components/PrivacyPreferences.tsx b/src/components/PrivacyPreferences.tsx
new file mode 100644
index 0000000..d157ee6
--- /dev/null
+++ b/src/components/PrivacyPreferences.tsx
@@ -0,0 +1,390 @@
+import React, { useEffect, useState } from 'react';
+import {
+  getStoredPrivacyConsent,
+  getEffectivePrivacyConsent,
+  savePrivacyConsent,
+  hasBrowserPrivacySignal,
+  isSensitiveAuthRoute,
+  OPEN_PRIVACY_MODAL_EVENT,
+  PRIVACY_CONSENT_EVENT,
+  type PrivacyConsentState,
+} from '../utils/privacy';
+
+/**
+ * Dynamically activates inert `<script type="text/plain" data-consent-category="...">` tags
+ * in the document only for categories that the user has explicitly consented to.
+ * Never activates third-party scripts on sensitive authentication pages (/signin, /signup).
+ */
+function syncConsentedThirdPartyScripts(consent: PrivacyConsentState) {
+  if (typeof document === 'undefined') return;
+  if (isSensitiveAuthRoute()) return;
+
+  const inertScripts = document.querySelectorAll<HTMLScriptElement>(
+    'script[type="text/plain"][data-consent-category][data-src]'
+  );
+
+  inertScripts.forEach((inertScript) => {
+    const category = inertScript.getAttribute('data-consent-category');
+    const src = inertScript.getAttribute('data-src');
+    if (!category || !src) return;
+
+    const isAllowed =
+      (category === 'analytics' && consent.analytics) ||
+      (category === 'advertising' && consent.advertising);
+
+    const existingActive = document.querySelector<HTMLScriptElement>(
+      `script[data-activated-consent="${category}"]`
+    );
+
+    if (isAllowed && !existingActive) {
+      const activeScript = document.createElement('script');
+      activeScript.src = src;
+      activeScript.defer = true;
+      activeScript.async = true;
+      activeScript.crossOrigin = 'anonymous';
+      activeScript.referrerPolicy = 'no-referrer';
+      activeScript.setAttribute('data-activated-consent', category);
+      activeScript.setAttribute('data-skip-tracking', 'true');
+      document.head.appendChild(activeScript);
+    }
+  });
+}
+
+export default function PrivacyPreferences() {
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [analyticsEnabled, setAnalyticsEnabled] = useState(false);
+  const [advertisingEnabled, setAdvertisingEnabled] = useState(false);
+  const [signals, setSignals] = useState({ gpc: false, dnt: false, active: false });
+  const [lastUpdated, setLastUpdated] = useState<string>('');
+
+  const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+
+  useEffect(() => {
+    const detectedSignals = hasBrowserPrivacySignal();
+    setSignals(detectedSignals);
+
+    const stored = getStoredPrivacyConsent();
+    if (!stored) {
+      // Privacy by default: both third-party categories are false (unchecked)
+      setAnalyticsEnabled(false);
+      setAdvertisingEnabled(false);
+      // If GPC or DNT is enabled in the browser, automatically honor it without nagging
+      if (detectedSignals.active) {
+        const autoSaved = savePrivacyConsent({ analytics: false, advertising: false });
+        setLastUpdated(autoSaved.updatedAt);
+        setShowBanner(false);
+      } else {
+        setShowBanner(true);
+      }
+    } else {
+      setAnalyticsEnabled(stored.analytics);
+      setAdvertisingEnabled(stored.advertising);
+      setLastUpdated(stored.updatedAt);
+      syncConsentedThirdPartyScripts(stored);
+    }
+
+    const handleOpenModal = () => {
+      const current = getEffectivePrivacyConsent();
+      setAnalyticsEnabled(current.analytics);
+      setAdvertisingEnabled(current.advertising);
+      setLastUpdated(current.updatedAt);
+      setShowModal(true);
+    };
+
+    const handleDocumentClick = (e: MouseEvent) => {
+      const target = (e.target as HTMLElement | null)?.closest(
+        '[data-open-privacy-preferences="true"]'
+      );
+      if (target) {
+        e.preventDefault();
+        handleOpenModal();
+      }
+    };
+
+    const handleConsentEvent = (e: Event) => {
+      const customEvent = e as CustomEvent<PrivacyConsentState>;
+      if (customEvent.detail) {
+        syncConsentedThirdPartyScripts(customEvent.detail);
+      }
+    };
+
+    window.addEventListener(OPEN_PRIVACY_MODAL_EVENT, handleOpenModal);
+    window.addEventListener(PRIVACY_CONSENT_EVENT, handleConsentEvent);
+    document.addEventListener('click', handleDocumentClick);
+
+    return () => {
+      window.removeEventListener(OPEN_PRIVACY_MODAL_EVENT, handleOpenModal);
+      window.removeEventListener(PRIVACY_CONSENT_EVENT, handleConsentEvent);
+      document.removeEventListener('click', handleDocumentClick);
+    };
+  }, []);
+
+  const handleRejectAll = () => {
+    const state = savePrivacyConsent({ analytics: false, advertising: false });
+    setAnalyticsEnabled(false);
+    setAdvertisingEnabled(false);
+    setLastUpdated(state.updatedAt);
+    setShowBanner(false);
+    setShowModal(false);
+  };
+
+  const handleAcceptAll = () => {
+    const state = savePrivacyConsent({
+      analytics: !signals.gpc,
+      advertising: !signals.gpc,
+    });
+    setAnalyticsEnabled(state.analytics);
+    setAdvertisingEnabled(state.advertising);
+    setLastUpdated(state.updatedAt);
+    setShowBanner(false);
+    setShowModal(false);
+    syncConsentedThirdPartyScripts(state);
+  };
+
+  const handleSaveCustom = (e: React.FormEvent) => {
+    e.preventDefault();
+    const state = savePrivacyConsent({
+      analytics: analyticsEnabled,
+      advertising: advertisingEnabled,
+    });
+    setAnalyticsEnabled(state.analytics);
+    setAdvertisingEnabled(state.advertising);
+    setLastUpdated(state.updatedAt);
+    setShowBanner(false);
+    setShowModal(false);
+    syncConsentedThirdPartyScripts(state);
+  };
+
+  return (
+    <>
+      {/* Privacy by Design Consent Banner (Default-Off for all third-party scripts) */}
+      {showBanner && !showModal && (
+        <aside
+          role="region"
+          aria-label="Privacy and third-party script preferences"
+          data-skip-tracking="true"
+          className="fixed bottom-0 inset-x-0 z-[9999] bg-white border-t-2 border-gray-900 shadow-2xl p-4 md:p-6"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
+            <div className="text-sm text-gray-800 space-y-1 max-w-3xl">
+              <p className="font-bold text-base text-gray-900">
+                Your Privacy Choices &amp; Data Minimization
+              </p>
+              <p className="text-gray-700 leading-relaxed">
+                By default, <strong>The DevTools Times</strong> blocks all optional third-party analytics (
+                <code className="text-xs bg-gray-100 px-1 py-0.5 rounded">analytics-client.js</code>) and
+                advertising (<code className="text-xs bg-gray-100 px-1 py-0.5 rounded">ad-client.js</code>)
+                scripts and sets no tracking cookies for passive readers. Third-party scripts only run if you
+                explicitly opt in below, and never run on Sign In or Sign Up pages. Read our{' '}
+                <a
+                  href={`${baseUrl}legal/privacy`}
+                  data-skip-tracking="true"
+                  className="underline font-semibold text-gray-900 hover:text-amber-700"
+                >
+                  Privacy Policy
+                </a>{' '}
+                for full details.
+              </p>
+            </div>
+
+            <div className="flex flex-wrap items-center gap-2 shrink-0">
+              <button
+                type="button"
+                onClick={handleRejectAll}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-gray-900 bg-white border border-gray-900 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Essential Only (Default)
+              </button>
+              <button
+                type="button"
+                onClick={() => setShowModal(true)}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-gray-900 bg-gray-100 border border-gray-400 rounded hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Customize Preferences
+              </button>
+              <button
+                type="button"
+                onClick={handleAcceptAll}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 border border-gray-900 rounded hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Allow Optional Scripts
+              </button>
+            </div>
+          </div>
+        </aside>
+      )}
+
+      {/* Granular Privacy Preferences Modal */}
+      {showModal && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          data-skip-tracking="true"
+          className="fixed inset-0 z-[10000] bg-black/50 backdrop-blur-xs flex items-center justify-center p-4"
+        >
+          <div className="bg-white border border-gray-300 rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6">
+            <div className="flex items-start justify-between border-b border-gray-200 pb-4 mb-4">
+              <div>
+                <h2 id="privacy-modal-title" className="text-xl font-bold text-gray-900">
+                  Privacy &amp; Third-Party Script Preferences
+                </h2>
+                <p className="text-xs text-gray-600 mt-1">
+                  Privacy by Design: Non-essential scripts are disabled by default until you explicitly opt in.
+                </p>
+              </div>
+              <button
+                type="button"
+                onClick={() => setShowModal(false)}
+                data-skip-tracking="true"
+                aria-label="Close privacy preferences"
+                className="text-gray-500 hover:text-gray-800 p-1"
+              >
+                ✕
+              </button>
+            </div>
+
+            {signals.active && (
+              <div className="mb-4 p-3 bg-emerald-50 border border-emerald-300 rounded text-xs text-emerald-900">
+                <strong>Browser Privacy Signal Detected:</strong> Your browser is sending a{' '}
+                {signals.gpc ? 'Global Privacy Control (GPC)' : 'Do Not Track (DNT)'} signal. We
+                automatically honor this signal by keeping optional third-party tracking and advertising
+                disabled by default.
+              </div>
+            )}
+
+            <form onSubmit={handleSaveCustom} className="space-y-4">
+              {/* Category 1: Strictly Necessary */}
+              <div className="p-4 bg-gray-50 border border-gray-200 rounded-md">
+                <div className="flex items-center justify-between">
+                  <div>
+                    <h3 className="text-sm font-bold text-gray-900">
+                      1. Strictly Necessary &amp; First-Party Functionality
+                    </h3>
+                    <span className="text-xs text-gray-500">
+                      Provider: First-party (The DevTools Times)
+                    </span>
+                  </div>
+                  <span className="text-xs font-semibold text-gray-700 bg-gray-200 px-2 py-1 rounded">
+                    Always Active
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-2 leading-relaxed">
+                  Includes self-hosted fonts, security headers, your local privacy preference record (
+                  <code className="bg-white px-1 rounded">dtt_privacy_consent_v1</code>), and an on-demand
+                  session cookie created <em>only</em> if you actively save an article to your Reading List.
+                  Passive browsing sets no session cookies.
+                </p>
+              </div>
+
+              {/* Category 2: Optional Third-Party Analytics */}
+              <div className="p-4 bg-white border border-gray-200 rounded-md">
+                <div className="flex items-start justify-between gap-4">
+                  <div>
+                    <label
+                      htmlFor="consent-analytics"
+                      className="text-sm font-bold text-gray-900 cursor-pointer"
+                    >
+                      2. Third-Party Interaction Analytics (Opt-In)
+                    </label>
+                    <p className="text-xs text-gray-500">
+                      Script:{' '}
+                      <code>
+                        us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js
+                      </code>
+                    </p>
+                  </div>
+                  <input
+                    id="consent-analytics"
+                    type="checkbox"
+                    checked={analyticsEnabled}
+                    disabled={signals.gpc}
+                    onChange={(e) => setAnalyticsEnabled(e.target.checked)}
+                    className="h-4 w-4 mt-1 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </div>
+                <p className="text-xs text-gray-600 mt-2 leading-relaxed">
+                  <strong>Data collected &amp; purpose:</strong> When enabled, records clicks on links and
+                  buttons (HTML tag name, visible button/link text, and timestamp) and sends them to the
+                  third-party Cloud Functions analytics endpoint to measure content engagement. Never loaded
+                  on Sign In or Sign Up pages, and elements marked with{' '}
+                  <code>data-skip-tracking=&quot;true&quot;</code> are always excluded.
+                </p>
+              </div>
+
+              {/* Category 3: Optional Third-Party Advertising */}
+              <div className="p-4 bg-white border border-gray-200 rounded-md">
+                <div className="flex items-start justify-between gap-4">
+                  <div>
+                    <label
+                      htmlFor="consent-advertising"
+                      className="text-sm font-bold text-gray-900 cursor-pointer"
+                    >
+                      3. Third-Party Contextual Advertising (Opt-In)
+                    </label>
+                    <p className="text-xs text-gray-500">
+                      Script:{' '}
+                      <code>
+                        us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js
+                      </code>
+                    </p>
+                  </div>
+                  <input
+                    id="consent-advertising"
+                    type="checkbox"
+                    checked={advertisingEnabled}
+                    disabled={signals.gpc}
+                    onChange={(e) => setAdvertisingEnabled(e.target.checked)}
+                    className="h-4 w-4 mt-1 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </div>
+                <p className="text-xs text-gray-600 mt-2 leading-relaxed">
+                  <strong>Data collected &amp; purpose:</strong> When enabled, requests banner and fireplace
+                  ad slots from the third-party <code>times_cdn</code> ad service and embeds third-party ad
+                  iframes. Disabled by default to prevent unconsented third-party network connections.
+                </p>
+              </div>
+
+              {lastUpdated && (
+                <p className="text-xs text-gray-500">
+                  Preferences last updated: {new Date(lastUpdated).toLocaleString()}
+                </p>
+              )}
+
+              <div className="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-gray-200">
+                <a
+                  href={`${baseUrl}legal/privacy`}
+                  data-skip-tracking="true"
+                  className="text-xs font-semibold underline text-gray-700 hover:text-gray-900"
+                >
+                  Read Full Privacy Policy
+                </a>
+                <div className="flex flex-wrap gap-2">
+                  <button
+                    type="button"
+                    onClick={handleRejectAll}
+                    data-skip-tracking="true"
+                    className="px-4 py-2 text-xs font-semibold text-gray-900 bg-white border border-gray-900 rounded hover:bg-gray-100"
+                  >
+                    Reject All Optional
+                  </button>
+                  <button
+                    type="submit"
+                    data-skip-tracking="true"
+                    className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 border border-gray-900 rounded hover:bg-gray-800"
+                  >
+                    Save My Preferences
+                  </button>
+                </div>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
