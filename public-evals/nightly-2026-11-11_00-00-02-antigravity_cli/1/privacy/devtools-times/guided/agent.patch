diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..16f3a79 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -9,5 +9,35 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+
+  const response = await next();
+
+  // Privacy-preserving and preventative security headers
+  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+  response.headers.set(
+    'Permissions-Policy',
+    'geolocation=(), camera=(), microphone=(), accelerometer=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), focus-without-user-activation=()'
+  );
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('X-Frame-Options', 'SAMEORIGIN');
+  response.headers.set('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  response.headers.set('Cross-Origin-Resource-Policy', 'same-origin');
+  response.headers.set('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
+  response.headers.set(
+    'Content-Security-Policy',
+    "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
+  );
+
+  // Prevent caching of sensitive authentication pages
+  const pathname = context.url.pathname;
+  if (
+    pathname.endsWith('/signin') ||
+    pathname.endsWith('/signin/') ||
+    pathname.endsWith('/signup') ||
+    pathname.endsWith('/signup/')
+  ) {
+    response.headers.set('Cache-Control', 'no-store, max-age=0');
+  }
+
+  return response;
 });
