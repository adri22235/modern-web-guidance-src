+        res.writeHead(429, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ error: 'Rate limit exceeded. Try again shortly.' }));
+        return;
+      }
+      res.setHeader('Set-Cookie', [
+        '__Host-session_id=dg_ephemeral_session; Secure; HttpOnly; SameSite=Lax; Path=/',
+        '__Secure-theme_pref=roast-dark; SameSite=None; Secure; Path=/; Partitioned; HttpOnly',
+      ]);
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          ok: true,
+          cookiesConfigured: ['__Host-session_id (HttpOnly, Secure, SameSite=Lax)', '__Secure-theme_pref (CHIPS Partitioned)'],
+        }),
+      );
+      return;
+    }
+
+    // 3. Data Rights & User Control endpoints (Access, Rectification, Erasure) with rate limiting
+    if (pathname === '/api/privacy/data') {
+      if (!checkRateLimit(`${clientIp}:privacy-data`, 10)) {
+        res.writeHead(429, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ error: 'Rate limit exceeded to prevent bulk scraping.' }));
+        return;
+      }
+      if (req.method === 'DELETE') {
+        res.setHeader('Clear-Site-Data', '"cookies", "storage"');
+        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            deleted: true,
+            message: 'All stored personal preferences and ephemeral order data have been erased.',
+          }),
+        );
+        return;
+      }
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          collectedData: {
+            checkoutMode: 'guest-by-default',
+            ageBracket: '18-34 (coarse bracket only)',
+            storedPIIInLocalStorage: 'none (prohibited by policy)',
+          },
+        }),
+      );
+      return;
+    }
+
+    // 4. Security / Privacy violation report sink (with PII scrubbing)
+    if (pathname === '/api/security-reports' && req.method === 'POST') {
+      let body = '';
+      req.on('data', (chunk) => {
+        body += chunk.toString();
+      });
+      req.on('end', () => {
+        console.info('[Security Report]', scrubPII(body));
+        res.writeHead(204);
+        res.end();
+      });
+      return;
+    }
+
+    // 5. Serve static files
+    const safeSuffix = path.normalize(pathname === '/' ? '/index.html' : pathname).replace(/^(\.\.(\/|\\|$))+/, '');
+    const filePath = path.join(__dirname, safeSuffix);
+
+    try {
+      const ext = path.extname(filePath).toLowerCase();
+      const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+      const content = await fs.readFile(filePath);
+
+      if (ext === '.html') {
+        const htmlWithNonce = content.toString('utf-8').replace(/__CSP_NONCE__/g, nonce);
+        res.writeHead(200, { 'Content-Type': contentType });
+        res.end(htmlWithNonce);
+        return;
+      }
+
+      res.writeHead(200, { 'Content-Type': contentType });
+      res.end(content);
+    } catch {
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Not Found');
+    }
+  });
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const server = createDailyGrindServer();
+  server.listen(PORT, () => {
+    console.info(`The Daily Grind privacy-hardened server listening on http://localhost:${PORT}`);
+  });
