--- a/index.html
+++ b/index.html
@@ -206,7 +206,126 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const ANALYTICS_ENDPOINT = '/api/analytics';
+      const DEBOUNCE_DELAY_MS = 1000;
+      const MAX_BATCH_SIZE = 20;
+
+      const sessionId =
+        typeof crypto !== 'undefined' && crypto.randomUUID
+          ? crypto.randomUUID()
+          : 'sess-' + Math.random().toString(36).substring(2, 11) + '-' + Date.now();
+
+      let eventQueue = [];
+      let debounceTimer = null;
+
+      function flushEvents(useBeacon = false) {
+        if (debounceTimer) {
+          clearTimeout(debounceTimer);
+          debounceTimer = null;
+        }
+
+        if (eventQueue.length === 0) {
+          return;
+        }
+
+        const batch = eventQueue.slice();
+        eventQueue = [];
+
+        const payload = JSON.stringify({
+          sessionId: sessionId,
+          sentAt: new Date().toISOString(),
+          page: window.location.pathname,
+          events: batch,
+        });
+
+        if (useBeacon && navigator.sendBeacon) {
+          const blob = new Blob([payload], { type: 'application/json' });
+          navigator.sendBeacon(ANALYTICS_ENDPOINT, blob);
+          return;
+        }
+
+        fetch(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: payload,
+          keepalive: true,
+        }).catch(function () {
+          // Silently ignore telemetry transmission failures in background
+        });
+      }
+
+      function scheduleFlush() {
+        if (debounceTimer) {
+          clearTimeout(debounceTimer);
+        }
+
+        if (eventQueue.length >= MAX_BATCH_SIZE) {
+          flushEvents();
+          return;
+        }
+
+        debounceTimer = setTimeout(function () {
+          flushEvents();
+        }, DEBOUNCE_DELAY_MS);
+      }
+
+      function recordEvent(type, data) {
+        eventQueue.push(
+          Object.assign(
+            {
+              type: type,
+              timestamp: new Date().toISOString(),
+              url: window.location.href,
+            },
+            data
+          )
+        );
+        scheduleFlush();
+      }
+
+      // Record initial page view
+      recordEvent('pageview', {
+        title: document.title,
+        referrer: document.referrer || null,
+        viewport: window.innerWidth + 'x' + window.innerHeight,
+      });
+
+      // Record user click interactions across the page
+      document.addEventListener(
+        'click',
+        function (event) {
+          const target = event.target.closest('a, button, .btn, .card, nav, header, footer') || event.target;
+          const link = event.target.closest('a');
+
+          recordEvent('click', {
+            tag: target.tagName ? target.tagName.toLowerCase() : null,
+            text: (target.innerText || target.textContent || '').trim().slice(0, 100),
+            href: link ? link.getAttribute('href') : null,
+            className: target.className || null,
+            x: event.clientX,
+            y: event.clientY,
+          });
+        },
+        { capture: true, passive: true }
+      );
+
+      // Flush any remaining queued events when leaving or hiding the page
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'hidden') {
+          flushEvents(true);
+        }
+      });
+
+      window.addEventListener('pagehide', function () {
+        flushEvents(true);
+      });
+    })();
+  </script>
 </body>
 
 </html>
