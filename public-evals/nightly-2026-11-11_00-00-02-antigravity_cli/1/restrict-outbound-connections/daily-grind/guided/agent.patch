+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const submitButton = document.getElementById('newsletter-submit');
+    const statusElement = document.getElementById('newsletter-status');
+    let emailEdited = false;
+
+    function updateStatusMessage(message, state = 'error') {
+      if (!statusElement) return;
+      statusElement.dataset.state = state;
+      statusElement.textContent = message;
+    }
+
+    function validateEmailField() {
+      emailInput.setCustomValidity('');
+      const value = emailInput.value.trim();
+      if (!value) {
+        emailInput.setCustomValidity('Please enter your email address to subscribe.');
+      } else if (emailInput.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+        emailInput.setCustomValidity('Please enter a valid email address (for example, name@example.com).');
+      }
+      const isValid = emailInput.checkValidity();
+      if (!isValid) {
+        emailInput.setAttribute('aria-invalid', 'true');
+        updateStatusMessage(emailInput.validationMessage, 'error');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+      return isValid;
+    }
+
+    async function fetchWithPolicyHandling(url, { statusEl = statusElement, ...fetchOptions } = {}) {
+      try {
+        const response = await fetch(url, fetchOptions);
+        const contentType = response.headers.get('content-type') || '';
+        const payload = contentType.includes('application/json')
+          ? await response.json()
+          : { message: await response.text() };
+
+        if (!response.ok) {
+          const errMessage = payload?.message || `HTTP ${response.status}`;
+          if (statusEl) {
+            statusEl.dataset.state = 'error';
+            statusEl.textContent = `Unable to complete request: ${errMessage}`;
+          }
+          return { ok: false, body: payload, error: new Error(errMessage) };
+        }
+
+        const successMessage = payload?.message || 'Thanks for subscribing to The Daily Grind newsletter!';
+        if (statusEl) {
+          statusEl.dataset.state = 'success';
+          statusEl.textContent = successMessage;
+        }
+        return { ok: true, body: payload, error: null };
+      } catch (error) {
+        const reason = error instanceof Error ? error.message : String(error);
+        if (statusEl) {
+          statusEl.dataset.state = 'error';
+          statusEl.textContent = `Sorry, your request to ${url} could not go through because it was blocked by our security policy or the network is unavailable (${reason}).`;
+        }
+        return { ok: false, body: null, error };
+      }
+    }
+
+    window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+
+    emailInput.addEventListener('input', () => {
+      emailEdited = true;
+      emailInput.setCustomValidity('');
+      if (emailInput.getAttribute('aria-invalid') === 'true' && emailInput.checkValidity()) {
+        emailInput.removeAttribute('aria-invalid');
+        updateStatusMessage('', '');
+      }
+    });
+
+    emailInput.addEventListener('blur', () => {
+      if (emailEdited && emailInput.value.trim().length > 0) {
+        validateEmailField();
+      }
+    });
+
+    newsletterForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      emailEdited = true;
+
+      if (!validateEmailField()) {
+        emailInput.focus();
+        return;
+      }
+
+      const targetUrl = newsletterForm.getAttribute('action') || '/api/newsletter';
+      const email = emailInput.value.trim();
+      submitButton.disabled = true;
+
+      try {
+        const result = await fetchWithPolicyHandling(targetUrl, {
+          statusEl: statusElement,
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+          },
+          body: JSON.stringify({ email }),
+        });
+
+        if (result.ok) {
+          newsletterForm.reset();
+          emailEdited = false;
+        }
+      } finally {
+        submitButton.disabled = false;
+      }
+    });
+
+    document.addEventListener('securitypolicyviolation', (event) => {
