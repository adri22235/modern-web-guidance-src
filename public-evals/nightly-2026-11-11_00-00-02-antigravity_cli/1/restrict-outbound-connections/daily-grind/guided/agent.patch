+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+const ALLOWED_EXTERNAL_ORIGINS = ['https://images.unsplash.com'];
+const subscribers = new Set();
+
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(`Pattern must include an http:// or https:// scheme: ${rawPattern}`);
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(`Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`);
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(`Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`);
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = ALLOWED_EXTERNAL_ORIGINS,
+  reportTo = 'conn-reports',
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+export function setConnectionAllowlistHeaders(res, options = {}) {
+  const {
+    secFetchDest = 'document',
+    patterns = ALLOWED_EXTERNAL_ORIGINS,
+    reportOnlyPatterns,
+    reportEndpointName = 'conn-reports',
+    reportEndpointUrl = '/api/security-reports',
+    redirects = 'block',
+    webrtc = 'block',
+    reportOnly = false,
+  } = options;
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+
+  if (typeof res.appendHeader === 'function') {
+    res.appendHeader('Vary', 'Sec-Fetch-Dest');
+  } else if (typeof res.headers?.append === 'function') {
+    res.headers.append('Vary', 'Sec-Fetch-Dest');
+  } else {
+    setHeader('Vary', 'Sec-Fetch-Dest');
+  }
+  if (secFetchDest && !ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) return;
+
+  setHeader('Reporting-Endpoints', `${reportEndpointName}="${reportEndpointUrl}"`);
+  setHeader(
+    reportOnly ? 'Connection-Allowlist-Report-Only' : 'Connection-Allowlist',
+    buildConnectionAllowlistHeader({ allowSelf: true, patterns, reportTo: reportEndpointName, redirects, webrtc }),
+  );
+
+  if (!reportOnly && Array.isArray(reportOnlyPatterns)) {
+    setHeader(
+      'Connection-Allowlist-Report-Only',
+      buildConnectionAllowlistHeader({
+        allowSelf: true,
+        patterns: reportOnlyPatterns,
+        reportTo: reportEndpointName,
+        redirects,
+        webrtc,
+      }),
+    );
+  }
+}
+
+function getIndexHtmlAndHashes() {
+  const htmlPath = path.join(__dirname, 'index.html');
+  const html = fs.readFileSync(htmlPath, 'utf8');
+  const scriptHashes = [];
+  for (const match of html.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi)) {
+    if (match[1]) {
+      const digest = crypto.createHash('sha256').update(match[1], 'utf8').digest('base64');
+      scriptHashes.push(`'sha256-${digest}'`);
+    }
+  }
+  return { html, scriptHashes };
+}
+
+function setSecurityHeaders(req, res, { scriptHashes = [], isDocumentOrWorker = true } = {}) {
+  const proto = req.headers['x-forwarded-proto'] || 'http';
+  const host = req.headers.host || 'localhost:11222';
+  const reportEndpointUrl = `${proto}://${host}/api/security-reports`;
+  const secFetchDest = req.headers['sec-fetch-dest'] || (isDocumentOrWorker ? 'document' : '');
+
+  setConnectionAllowlistHeaders(res, {
+    secFetchDest,
+    patterns: ALLOWED_EXTERNAL_ORIGINS,
+    reportEndpointName: 'conn-reports',
+    reportEndpointUrl,
+    redirects: 'block',
+    webrtc: 'block',
+  });
+
+  const scriptSrcTokens = ["'self'", ...scriptHashes].join(' ');
+  const cspDirectives = [
+    "default-src 'self'",
+    "connect-src 'self' https://images.unsplash.com",
+    "img-src 'self' https://images.unsplash.com data: blob:",
+    "style-src 'self' 'unsafe-inline'",
+    `script-src ${scriptSrcTokens}`,
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "frame-ancestors 'none'",
+    'report-to conn-reports',
+  ];
+
+  res.setHeader('Content-Security-Policy', cspDirectives.join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+  );
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+}
+
+function readRequestBody(req, maxBytes = 16 * 1024) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let total = 0;
+    req.on('data', (chunk) => {
+      total += chunk.length;
+      if (total > maxBytes) {
+        reject(new Error('Request body too large'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function parseEmailFromBody(rawBody, contentType = '') {
+  if (!rawBody) return '';
+  if (contentType.includes('application/json')) {
+    const parsed = JSON.parse(rawBody);
+    return typeof parsed?.email === 'string' ? parsed.email.trim() : '';
+  }
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+  try {
+    const parsed = JSON.parse(rawBody);
+    if (typeof parsed?.email === 'string') return parsed.email.trim();
+  } catch {
+    const params = new URLSearchParams(rawBody);
+    if (params.has('email')) return (params.get('email') || '').trim();
+  }
+  return '';
+}
+
+export function createAppServer() {
+  return http.createServer(async (req, res) => {
+    const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+    const pathname = url.pathname;
+
+    if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+      const { html, scriptHashes } = getIndexHtmlAndHashes();
+      setSecurityHeaders(req, res, { scriptHashes, isDocumentOrWorker: true });
+      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+      res.end(html);
+      return;
+    }
+
+    if (
+      req.method === 'POST' &&
+      (pathname === '/api/newsletter' || pathname === '/newsletter' || pathname === '/subscribe')
+    ) {
+      setSecurityHeaders(req, res, { isDocumentOrWorker: false });
+      res.appendHeader('Vary', 'Sec-Fetch-Mode, Sec-Fetch-Site');
+
+      const secFetchSite = req.headers['sec-fetch-site'];
+      if (secFetchSite && !['same-origin', 'same-site', 'none'].includes(String(secFetchSite).toLowerCase())) {
+        res.writeHead(403, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ ok: false, message: 'Cross-site requests are not permitted.' }));
+        return;
+      }
+
+      try {
+        const rawBody = await readRequestBody(req);
+        const email = parseEmailFromBody(rawBody, req.headers['content-type'] || '');
+        const isValidEmail = email.length > 0 && email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+
+        if (!isValidEmail) {
+          res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+          res.end(
+            JSON.stringify({
+              ok: false,
+              message: 'Please provide a valid email address to subscribe.',
+            }),
+          );
+          return;
+        }
+
+        const normalizedEmail = email.toLowerCase();
+        subscribers.add(normalizedEmail);
+
+        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            ok: true,
+            email: normalizedEmail,
+            message: `Thanks for subscribing! We'll send Daily Grind updates to ${normalizedEmail}.`,
+          }),
+        );
+      } catch {
+        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            ok: false,
+            message: 'Unable to process your signup request. Please check your input and try again.',
+          }),
+        );
+      }
+      return;
+    }
+
+    if (req.method === 'POST' && pathname === '/api/security-reports') {
+      setSecurityHeaders(req, res, { isDocumentOrWorker: false });
+      try {
+        await readRequestBody(req);
+      } catch {
+        // Ignore malformed report bodies
+      }
+      res.writeHead(204);
+      res.end();
+      return;
+    }
+
+    setSecurityHeaders(req, res, { isDocumentOrWorker: false });
+    res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ ok: false, message: 'Not Found' }));
+  });
+}
+
+function resolvePort(argv = process.argv.slice(2), env = process.env) {
+  const portFlagIndex = argv.findIndex((arg) => arg === '--port' || arg === '-p');
+  if (portFlagIndex !== -1 && argv[portFlagIndex + 1]) {
+    return Number(argv[portFlagIndex + 1]);
+  }
+  const inlineFlag = argv.find((arg) => arg.startsWith('--port='));
+  if (inlineFlag) {
+    return Number(inlineFlag.split('=')[1]);
+  }
+  return Number(env.PORT) || 11222;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = resolvePort();
+  const server = createAppServer();
+  server.listen(port, () => {
+    console.log(`Daily Grind server listening on http://localhost:${port}`);
+  });
+}
