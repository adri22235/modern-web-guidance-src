+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const messageEl = document.getElementById('newsletter-message');
+
+      const DEFAULT_ERROR_TEXT =
+        "Sorry, your request can't go through right now. We were unable to send your request (connection failed or blocked). Please try again later.";
+
+      function showMessage(text, type) {
+        if (!messageEl) return;
+        messageEl.textContent = text;
+        messageEl.className = 'newsletter-message ' + (type === 'success' ? 'success' : 'error');
+        messageEl.hidden = false;
+        messageEl.style.display = 'block';
+      }
+
+      function showRequestBlockedOrFailed(detail) {
+        const msg = detail
+          ? "Sorry, your request can't go through: " + detail
+          : DEFAULT_ERROR_TEXT;
+        showMessage(msg, 'error');
+      }
+
+      document.addEventListener('securitypolicyviolation', function (event) {
+        const blocked = event && event.blockedURI ? ' (' + event.blockedURI + ' blocked)' : '';
+        showRequestBlockedOrFailed(
+          'Unable to reach an external server' + blocked + '. Requests to unauthorized hosts are not allowed.'
+        );
+      });
+
+      if (typeof window.fetch === 'function') {
+        const nativeFetch = window.fetch.bind(window);
+        window.fetch = function (...args) {
+          return nativeFetch(...args).then(
+            function (response) {
+              if (!response.ok) {
+                showRequestBlockedOrFailed('The server could not complete your request (status ' + response.status + ').');
+              }
+              return response;
+            },
+            function (err) {
+              showRequestBlockedOrFailed();
+              throw err;
+            }
+          );
+        };
+      }
+
+      if (typeof window.XMLHttpRequest === 'function') {
+        const originalOpen = XMLHttpRequest.prototype.open;
+        const originalSend = XMLHttpRequest.prototype.send;
+        XMLHttpRequest.prototype.open = function (method, url, ...rest) {
+          this._requestUrl = url;
+          return originalOpen.call(this, method, url, ...rest);
+        };
+        XMLHttpRequest.prototype.send = function (...args) {
+          this.addEventListener('error', function () {
+            showRequestBlockedOrFailed();
+          });
+          try {
+            return originalSend.apply(this, args);
+          } catch (err) {
+            showRequestBlockedOrFailed();
+            throw err;
+          }
+        };
+      }
+
+      if (navigator && typeof navigator.sendBeacon === 'function') {
+        const nativeSendBeacon = navigator.sendBeacon.bind(navigator);
+        navigator.sendBeacon = function (url, data) {
+          try {
+            const ok = nativeSendBeacon(url, data);
+            if (!ok) {
+              showRequestBlockedOrFailed();
+            }
+            return ok;
+          } catch (err) {
+            showRequestBlockedOrFailed();
+            throw err;
+          }
+        };
+      }
+
+      if (form) {
+        form.addEventListener('submit', async function (event) {
+          event.preventDefault();
+          const email = emailInput ? emailInput.value.trim() : '';
+
+          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+            showMessage("Sorry, your request can't go through. Please enter a valid email address.", 'error');
+            return;
+          }
+
+          const targetUrl = form.getAttribute('action') || '/subscribe';
+
+          try {
+            const response = await window.fetch(targetUrl, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+                'Accept': 'application/json'
+              },
+              body: JSON.stringify({ email: email })
+            });
+
+            let payload = null;
+            try {
+              payload = await response.json();
+            } catch (_) {
+              payload = null;
+            }
+
+            if (!response.ok || (payload && payload.ok === false)) {
+              const errorText =
+                (payload && (payload.error || payload.message)) ||
+                DEFAULT_ERROR_TEXT;
+              showMessage(errorText, 'error');
+              return;
+            }
+
+            showMessage(
+              (payload && payload.message) ||
+                'Thank you for subscribing! Your email has been registered for our newsletter.',
+              'success'
+            );
+            form.reset();
+          } catch (err) {
+            showMessage(DEFAULT_ERROR_TEXT, 'error');
+          }
+        });
+      }
+    })();
+  </script>
