+  <script>
+    (() => {
+      const cart = [];
+      const cartSummaryEl = document.getElementById('cart-summary');
+      const cartListEl = document.getElementById('cart-list');
+      const cartTotalEl = document.getElementById('cart-total');
+
+      const SIZES = ['Small', 'Medium', 'Large'];
+      const TEMPERATURES = ['Hot', 'Iced'];
+      const SHOTS = ['Single', 'Double', 'Triple'];
+      const ICE_LEVELS = ['Regular Ice', 'Light Ice', 'No Ice'];
+
+      const SIZE_PRICE_DELTA = {
+        Small: -0.50,
+        Medium: 0,
+        Large: 0.75,
+      };
+
+      const SHOT_PRICE_DELTA = {
+        Single: -0.50,
+        Double: 0,
+        Triple: 0.75,
+      };
+
+      function renderCart() {
+        if (!cartSummaryEl || !cartListEl || !cartTotalEl) return;
+        if (cart.length === 0) {
+          cartSummaryEl.hidden = true;
+          return;
+        }
+        cartSummaryEl.hidden = false;
+        cartListEl.replaceChildren();
+        let total = 0;
+
+        for (const entry of cart) {
+          total += entry.lineTotal;
+          const li = document.createElement('li');
+          const detailsSpan = document.createElement('span');
+          const optionsText = entry.options.filter(Boolean).join(', ');
+          const notesText = entry.notes ? ` — "${entry.notes}"` : '';
+          detailsSpan.textContent = `${entry.quantity}x ${entry.itemName} (${optionsText})${notesText}`;
+
+          const priceSpan = document.createElement('span');
+          priceSpan.textContent = `$${entry.lineTotal.toFixed(2)}`;
+
+          li.append(detailsSpan, priceSpan);
+          cartListEl.appendChild(li);
+        }
+
+        cartTotalEl.textContent = `Total: $${total.toFixed(2)}`;
+      }
+
+      function addOrderItem({ itemName, basePrice, quantity, options, notes, statusEl }) {
+        const lineTotal = Number((basePrice * quantity).toFixed(2));
+        const orderEntry = {
+          orderId: `ORD-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
+          itemName,
+          quantity,
+          options,
+          notes: notes ? notes.trim() : '',
+          unitPrice: Number(basePrice.toFixed(2)),
+          lineTotal,
+        };
+        cart.push(orderEntry);
+        renderCart();
+
+        const confirmationMessage = `Added ${quantity}x ${itemName} (${options.join(', ')}) to your order ($${lineTotal.toFixed(2)}).`;
+        if (statusEl) {
+          statusEl.className = 'order-status success';
+          statusEl.textContent = `✓ ${confirmationMessage}`;
+        }
+
+        return {
+          status: 'confirmed',
+          message: confirmationMessage,
+          order: orderEntry,
+          cartTotalItems: cart.reduce((sum, item) => sum + item.quantity, 0),
+        };
+      }
+
+      function validateFormInputs(form) {
+        const errors = [];
+        const quantityInput = form.elements.namedItem('quantity');
+        const qty = Number(quantityInput?.value);
+        if (!Number.isInteger(qty) || qty < 1 || qty > 10) {
+          errors.push({
+            field: 'quantity',
+            input: quantityInput,
+            message: 'Please enter a whole quantity between 1 and 10.',
+          });
+        }
+        return errors;
+      }
+
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const statusEl = form.querySelector('.order-status');
+        const quantityInput = form.elements.namedItem('quantity');
+
+        if (quantityInput) {
+          quantityInput.addEventListener('input', () => {
+            quantityInput.setCustomValidity('');
+            quantityInput.removeAttribute('aria-invalid');
+            if (statusEl && statusEl.classList.contains('error')) {
+              statusEl.textContent = '';
+              statusEl.className = 'order-status';
+            }
+          });
+
+          quantityInput.addEventListener('blur', () => {
+            const errors = validateFormInputs(form);
+            if (errors.length > 0) {
+              quantityInput.setCustomValidity(errors[0].message);
+              quantityInput.setAttribute('aria-invalid', 'true');
+              if (statusEl) {
+                statusEl.className = 'order-status error';
+                statusEl.textContent = `⚠ ${errors[0].message}`;
+              }
+            }
+          });
+        }
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const formValidationErrors = validateFormInputs(form);
+
+          if (formValidationErrors.length > 0) {
+            const firstErr = formValidationErrors[0];
+            if (firstErr.input) {
+              firstErr.input.setCustomValidity(firstErr.message);
+              firstErr.input.setAttribute('aria-invalid', 'true');
+              firstErr.input.focus();
+            }
+            if (statusEl) {
+              statusEl.className = 'order-status error';
+              statusEl.textContent = `⚠ ${firstErr.message}`;
+            }
+            if (event.agentInvoked && typeof event.respondWith === 'function') {
+              const errorString =
+                'Validation failed: ' +
+                formValidationErrors
+                  .map((err) => `${err.field} (${err.message})`)
+                  .join(', ');
+              event.respondWith(Promise.resolve(errorString));
+            }
+            return;
+          }
+
+          const formData = new FormData(form);
+          const itemName = form.dataset.itemName || 'Coffee';
+          const basePrice = Number(form.dataset.basePrice || 4.50);
+          const quantity = Number(formData.get('quantity') || 1);
+          const notes = String(formData.get('notes') || '');
+
+          const options = [];
+          let adjustedUnitPrice = basePrice;
+
+          if (formData.has('size')) {
+            const size = String(formData.get('size'));
+            options.push(size);
+            adjustedUnitPrice += SIZE_PRICE_DELTA[size] ?? 0;
+          }
+          if (formData.has('temperature')) {
+            options.push(String(formData.get('temperature')));
+          }
+          if (formData.has('shots')) {
+            const shots = String(formData.get('shots'));
+            options.push(`${shots} Shot`);
+            adjustedUnitPrice += SHOT_PRICE_DELTA[shots] ?? 0;
+          }
+          if (formData.has('ice')) {
+            options.push(String(formData.get('ice')));
+          }
+
+          const result = addOrderItem({
+            itemName,
+            basePrice: adjustedUnitPrice,
+            quantity,
+            options,
+            notes,
+            statusEl,
+          });
+
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(result));
+          }
+        });
