@@ -0,0 +1,290 @@
+import React from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+  category?: string;
+  author?: string;
+  date?: string;
+  readingTime?: number;
+}
+
+export interface CurrentArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  date: string;
+  readingTime?: number;
+}
+
+const LIST_ARTICLES_SCHEMA = {
+  type: 'object',
+  properties: {
+    category: {
+      type: 'string',
+      description: 'Publication section name to filter stories by, such as science, lifestyle, sports, or news.',
+    },
+    limit: {
+      type: 'number',
+      minimum: 1,
+      maximum: 50,
+      default: 10,
+      description: 'Maximum number of matching stories to include in the response.',
+    },
+  },
+} as const;
+
+const EMPTY_OBJECT_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const POPULARITY_SCHEMA = {
+  type: 'object',
+  properties: {
+    id: {
+      type: 'string',
+      description: 'Slug identifier of the article to inspect, such as super-bowl-lx or coffee-alchemy.',
+    },
+  },
+  required: ['id'],
+} as const;
+
+const READ_ONLY_ANNOTATIONS = {
+  readOnlyHint: true,
+} as const;
+
+const MUTATING_ANNOTATIONS = {
+  readOnlyHint: false,
+} as const;
+
+export function SiteArticleTools() {
+  useWebMCP<{ category?: string; limit?: number }, unknown>({
+    name: 'list-articles',
+    description:
+      'Browse published articles in The DevTools Times catalog. Use when the user wants to explore stories in a section or see available articles.',
+    inputSchema: LIST_ARTICLES_SCHEMA,
+    async execute(input = {}, { signal }) {
+      const rawCategory = typeof input.category === 'string' ? input.category.trim() : '';
+      const limit = typeof input.limit === 'number' ? input.limit : 10;
+
+      if (!Number.isFinite(limit) || limit < 1 || limit > 50) {
+        return {
+          error: 'Pass a valid story count between 1 and 50.',
+        };
+      }
+
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+        if (!response.ok) {
+          return { error: `Failed to load articles with status ${response.status}` };
+        }
+        const articles: ArticleSummary[] = await response.json();
+        const filtered = rawCategory
+          ? articles.filter(
+              article =>
+                typeof article.category === 'string' &&
+                article.category.toLowerCase() === rawCategory.toLowerCase()
+            )
+          : articles;
+
+        if (rawCategory && filtered.length === 0) {
+          const availableCategories = Array.from(
+            new Set(articles.map(a => a.category).filter(Boolean))
+          );
+          return {
+            error: `No articles found in category "${rawCategory}".`,
+            availableCategories,
+          };
+        }
+
+        return {
+          count: Math.min(filtered.length, limit),
+          totalMatching: filtered.length,
+          articles: filtered.slice(0, limit).map(article => ({
+            ...article,
+            url: `${import.meta.env.BASE_URL}articles/${article.slug}`,
+          })),
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get-reading-list',
+    description:
+      'Retrieve the articles currently saved in the user reading list. Use when the user asks which stories they have bookmarked for later.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    async execute(_input, { signal }) {
+      try {
+        const [readingListResponse, articlesResponse] = await Promise.all([
+          fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { signal }),
+          fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal }),
+        ]);
+
+        if (!readingListResponse.ok) {
+          return {
+            error: `Failed to fetch reading list with status ${readingListResponse.status}`,
+          };
+        }
+        if (!articlesResponse.ok) {
+          return {
+            error: `Failed to fetch article catalog with status ${articlesResponse.status}`,
+          };
+        }
+
+        const readingListData = await readingListResponse.json();
+        const allArticles: ArticleSummary[] = await articlesResponse.json();
+        const slugs: string[] = Array.isArray(readingListData.readingList)
+          ? readingListData.readingList
+          : [];
+        const savedArticles = allArticles
+          .filter(article => slugs.includes(article.slug))
+          .map(article => ({
+            ...article,
+            url: `${import.meta.env.BASE_URL}articles/${article.slug}`,
+          }));
+
+        return {
+          count: savedArticles.length,
+          slugs,
+          articles: savedArticles,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<{ id?: string }, unknown>({
+    name: 'get-article-popularity',
+    description:
+      'Fetch live readership view counts and trending status for a published article. Use when the user asks how popular a story is or whether it is trending.',
+    inputSchema: POPULARITY_SCHEMA,
+    async execute(input = {}, { signal }) {
+      const id = typeof input.id === 'string' ? input.id.trim() : '';
+      if (!id) {
+        return { error: 'Provide a non-empty article slug identifier.' };
+      }
+
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(id)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          return {
+            error: `Popularity lookup failed with status ${response.status}`,
+          };
+        }
+        return await response.json();
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  return null;
+}
+
+export function ArticlePageTools({ article }: { article: CurrentArticleMetadata }) {
+  const isArticleAvailable = Boolean(article?.slug);
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'read-current-article',
+    description:
+      'Extract the full text, metadata, word count, and estimated reading time of the article currently open on the page. Use when the user asks about or wants a summary of the current story.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    enabled: isArticleAvailable,
+    execute() {
+      if (!article?.slug) {
+        return { error: 'No active article is open on the current page.' };
+      }
+      const bodyElement = document.querySelector('[data-article-body]');
+      const bodyText = bodyElement?.textContent?.trim() ?? '';
+      const words = bodyText ? bodyText.split(/\s+/).length : 0;
+      const estimatedReadingMinutes = article.readingTime ?? Math.max(1, Math.ceil(words / 200));
+
+      return {
+        ...article,
+        wordCount: words,
+        estimatedReadingMinutes,
+        content: bodyText,
+      };
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'bookmark-current-article',
+    description:
+      'Toggle the bookmark status of the article currently open on the page and update the bookmark button state. Use when the user wants to save or remove the story they are currently reading.',
+    inputSchema: EMPTY_OBJECT_SCHEMA,
+    enabled: isArticleAvailable,
+    async execute(_input, { signal }) {
+      if (!article?.slug) {
+        return { error: 'No active article is open on the current page.' };
+      }
+
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ slug: article.slug }),
+          signal,
+        });
+
+        if (!response.ok) {
+          return {
+            error: `Bookmark update failed with status ${response.status}`,
+          };
+        }
+
+        const data = await response.json();
+        const updatedList: string[] = Array.isArray(data.readingList) ? data.readingList : [];
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } })
+        );
+
+        const bookmarked = updatedList.includes(article.slug);
+        return {
+          slug: article.slug,
+          title: article.title,
+          bookmarked,
+          readingList: updatedList,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: MUTATING_ANNOTATIONS,
+  });
+
+  return null;
+}
+
+export default SiteArticleTools;
