+    /* Breadcrumbs */
+    .breadcrumb {
+      max-width: 1100px;
+      margin: 24px auto 0;
+      padding: 0 20px;
+    }
+
+    .breadcrumb > ol {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 0.5rem;
+      list-style: none;
+      margin: 0;
+      padding: 0.5rem 0;
+      border-block-end: 1px solid var(--secondary);
+    }
+
+    .breadcrumb > ol > li {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    /* Empty alt text after the slash hides the decorative divider from screen readers */
+    .breadcrumb > ol > li + li::before {
+      content: "/" / "";
+      color: var(--primary);
+      opacity: 0.75;
+      user-select: none;
+    }
+
+    .breadcrumb > ol > li > a {
+      display: inline-flex;
+      align-items: center;
+      min-block-size: 24px;
+      min-inline-size: 24px;
+      padding: 0.15rem 0.25rem;
+      border-radius: 4px;
+      color: var(--primary);
+      font-size: 0.95rem;
+      text-decoration: underline;
+      text-underline-offset: 0.2em;
+      transition: color 0.2s, background-color 0.2s;
+    }
+
+    .breadcrumb > ol > li > a:hover {
+      color: var(--text);
+      background-color: rgba(78, 52, 46, 0.08);
+      text-decoration-thickness: 2px;
+    }
+
+    .breadcrumb > ol > li > a:focus-visible {
+      position: relative;
+      z-index: 1;
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .breadcrumb > ol > li > a[aria-current="page"] {
+      color: var(--text);
+      font-weight: 700;
+      text-decoration: none;
+    }
+
+    @media (forced-colors: active) {
+      .breadcrumb > ol > li > a[aria-current="page"] {
+        text-decoration: underline;
+      }
+    }
