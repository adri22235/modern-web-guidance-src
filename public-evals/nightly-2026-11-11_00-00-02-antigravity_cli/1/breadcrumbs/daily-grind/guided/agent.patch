+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        href: '/menu/seasonal',
+        meta: '12 oz / 16 oz \u2022 Available Hot or Iced',
+        description: 'Creamy steamed oat milk blended with our signature espresso and pure Grade A Vermont maple syrup, finished with a light dusting of cinnamon.'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        href: '/menu/espresso',
+        meta: 'Single / Double Shot \u2022 Single-Origin Roast',
+        description: 'Bold, smokey, and full-bodied espresso pulled from freshly ground dark-roasted beans with rich dark chocolate undertones.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        href: '/menu/cold-brew',
+        meta: '16 oz / 20 oz \u2022 Slow-Steeped 18 Hours',
+        description: 'Coarse-ground artisanal beans steeped in filtered cold water for 18 hours for a naturally sweet, ultra-smooth finish with low acidity.'
+      }
+    };
+
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    const favoritesGrid = document.getElementById('favorites-grid');
+    const detailView = document.getElementById('item-detail-view');
+    const detailTitle = document.getElementById('detail-title');
+    const detailMeta = document.getElementById('detail-meta');
+    const detailDescription = document.getElementById('detail-description');
+    const sectionHeading = document.getElementById('section-heading');
+    const backBtn = document.getElementById('back-to-seasonal');
+
+    function renderBreadcrumbs(trail) {
+      breadcrumbList.replaceChildren(
+        ...trail.map((crumb, index) => {
+          const li = document.createElement('li');
+          const a = document.createElement('a');
+          a.href = crumb.href;
+          a.dataset.level = crumb.level;
+          a.textContent = crumb.label;
+          if (index === trail.length - 1) {
+            a.setAttribute('aria-current', 'page');
+          }
+          li.appendChild(a);
+          return li;
+        })
+      );
+    }
+
+    function showCategoryView(level = 'seasonal', moveFocus = false) {
+      detailView.hidden = true;
+      favoritesGrid.hidden = false;
+
+      const baseTrail = [
+        { label: 'Home', href: '/', level: 'home' },
+        { label: 'Menu', href: '/menu', level: 'menu' },
+        { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' }
+      ];
+
+      if (level === 'home') {
+        renderBreadcrumbs(baseTrail.slice(0, 1));
+      } else if (level === 'menu') {
+        renderBreadcrumbs(baseTrail.slice(0, 2));
+      } else {
+        renderBreadcrumbs(baseTrail);
+      }
+
+      if (moveFocus) {
+        sectionHeading.focus();
+      }
+    }
+
+    function showItemDetail(itemKey) {
+      const item = ITEMS[itemKey];
+      if (!item) return;
+
+      detailTitle.textContent = item.title;
+      detailMeta.textContent = item.meta;
+      detailDescription.textContent = item.description;
+      favoritesGrid.hidden = true;
+      detailView.hidden = false;
+
+      renderBreadcrumbs([
+        { label: 'Home', href: '/', level: 'home' },
+        { label: 'Menu', href: '/menu', level: 'menu' },
+        { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' },
+        { label: item.title, href: item.href, level: 'item', itemKey }
+      ]);
+
+      detailTitle.focus();
+    }
+
+    favoritesGrid.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-item]');
+      if (!link) return;
+      event.preventDefault();
+      showItemDetail(link.dataset.item);
+    });
+
+    backBtn.addEventListener('click', (event) => {
+      event.preventDefault();
+      showCategoryView('seasonal', true);
+    });
+
+    breadcrumbList.addEventListener('click', (event) => {
+      const link = event.target.closest('a');
+      if (!link) return;
+      event.preventDefault();
+      const level = link.dataset.level;
+      if (level === 'item') return;
+      showCategoryView(level || 'seasonal', true);
+    });
+  </script>
+
 </body>
 
