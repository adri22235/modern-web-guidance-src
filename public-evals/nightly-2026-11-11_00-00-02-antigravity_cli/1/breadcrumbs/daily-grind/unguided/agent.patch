+      function renderRoute(routeKey) {
+        const config = routes[routeKey] || routes.seasonal;
+        sectionTitle.textContent = config.title;
+        sectionSubtitle.textContent = config.subtitle;
+        favoritesGrid.style.display = config.showGrid ? 'grid' : 'none';
+
+        if (config.detail) {
+          detailTitle.textContent = config.detail.title;
+          detailCategory.textContent = config.detail.category;
+          detailPrice.textContent = config.detail.price;
+          detailCalories.textContent = config.detail.calories;
+          detailDescription.textContent = config.detail.description;
+          itemDetail.classList.add('active');
+        } else {
+          itemDetail.classList.remove('active');
+        }
+
+        breadcrumbList.innerHTML = '';
+        config.trail.forEach((step, index) => {
+          const li = document.createElement('li');
+          li.className = 'breadcrumb-item';
+          const isLast = index === config.trail.length - 1;
+
+          if (isLast) {
+            li.setAttribute('aria-current', 'page');
+            const span = document.createElement('span');
+            span.setAttribute('aria-current', 'page');
+            span.textContent = step.label;
+            li.appendChild(span);
+          } else {
+            const a = document.createElement('a');
+            a.href = step.href;
+            a.dataset.route = step.route;
+            a.textContent = step.label;
+            li.appendChild(a);
+          }
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      document.addEventListener('click', function (e) {
+        const routeLink = e.target.closest('[data-route]');
+        if (routeLink) {
+          e.preventDefault();
+          const targetRoute = routeLink.getAttribute('data-route');
+          renderRoute(targetRoute);
+          return;
+        }
+
+        const topMenuLink = e.target.closest('nav:not(.breadcrumb) a[href="/menu"]');
+        if (topMenuLink) {
+          e.preventDefault();
