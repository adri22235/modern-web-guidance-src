+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const themeSelect = document.getElementById('theme-select');
+      const systemOption = document.getElementById('theme-option-system');
+      const darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateSystemOptionLabel() {
+        if (systemOption) {
+          const currentSystemScheme = darkMediaQuery.matches ? 'dark' : 'light';
+          systemOption.textContent = `System (Currently ${currentSystemScheme})`;
+        }
+      }
+
+      function syncUIWithStorage() {
+        let stored = null;
+        try {
+          stored = localStorage.getItem('color-scheme');
+        } catch (e) {}
+
+        if (stored === 'light' || stored === 'dark') {
+          meta.content = stored;
+          themeSelect.value = stored;
+        } else {
+          meta.content = 'light dark';
+          themeSelect.value = 'system';
+        }
+      }
+
+      themeSelect.addEventListener('change', (event) => {
+        const selected = event.target.value;
+        if (selected === 'light' || selected === 'dark') {
+          meta.content = selected;
+          try {
+            localStorage.setItem('color-scheme', selected);
+          } catch (e) {}
+        } else {
+          meta.content = 'light dark';
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch (e) {}
+        }
+      });
+
+      // Keep UI in sync if override changes from another tab
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          syncUIWithStorage();
+        }
+      });
+
+      // Update system option label when OS preference changes without clearing any pinned user preference
+      darkMediaQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      updateSystemOptionLabel();
+      syncUIWithStorage();
+    })();
+  </script>
 </body>
 
 </html>
