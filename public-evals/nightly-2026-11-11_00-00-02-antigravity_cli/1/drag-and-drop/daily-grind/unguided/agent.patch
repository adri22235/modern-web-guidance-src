+  <script>
+    (function () {
+      const grid = document.querySelector('#seasonal-favorites-grid') || document.querySelector('.grid');
+      if (!grid) return;
+
+      let draggedCard = null;
+      let isHtml5Dragging = false;
+      let pointerDragState = null;
+      let suppressNextClick = false;
+
+      function getCards() {
+        return Array.from(grid.querySelectorAll('.card'));
+      }
+
+      function clearDragOverClasses() {
+        getCards().forEach((card) => card.classList.remove('drag-over'));
+      }
+
+      function reorderByClientX(activeCard, clientX) {
+        if (!activeCard || typeof clientX !== 'number') return;
+        const cards = getCards();
+        const dragIndex = cards.indexOf(activeCard);
+        if (dragIndex === -1) return;
+
+        const otherCards = cards.filter((card) => card !== activeCard);
+        const nextCard = otherCards.find((card) => {
+          const rect = card.getBoundingClientRect();
+          const cardIndex = cards.indexOf(card);
+          const ratio = cardIndex > dragIndex ? 0.25 : 0.75;
+          const threshold = rect.left + rect.width * ratio;
+          return clientX < threshold;
+        });
+
+        if (nextCard) {
+          if (activeCard.nextElementSibling !== nextCard) {
+            grid.insertBefore(activeCard, nextCard);
+          }
+        } else if (grid.lastElementChild !== activeCard) {
+          grid.appendChild(activeCard);
+        }
+      }
+
+      function reorderByTargetCard(activeCard, targetCard) {
+        if (!activeCard || !targetCard || activeCard === targetCard) return;
+        const cards = getCards();
+        const dragIndex = cards.indexOf(activeCard);
+        const targetIndex = cards.indexOf(targetCard);
+        if (dragIndex === -1 || targetIndex === -1) return;
+
+        if (dragIndex < targetIndex) {
+          targetCard.after(activeCard);
+        } else {
+          targetCard.before(activeCard);
+        }
+      }
+
+      function cleanupDrag() {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+        }
+        clearDragOverClasses();
+        draggedCard = null;
+        isHtml5Dragging = false;
+        pointerDragState = null;
+      }
+
+      // HTML5 Drag and Drop handlers
+      grid.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+
+        isHtml5Dragging = true;
+        pointerDragState = null;
+        draggedCard = card;
+        card.classList.add('dragging');
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          try {
+            e.dataTransfer.setData('text/plain', card.dataset.cardId || card.querySelector('h3')?.textContent || '');
+          } catch (_) {
+            // Ignore in restricted synthetic environments
+          }
+        }
+      });
+
+      grid.addEventListener('dragenter', (e) => {
+        if (!draggedCard) return;
+        e.preventDefault();
+        const targetCard = e.target.closest('.card');
+        clearDragOverClasses();
+        if (targetCard && targetCard !== draggedCard) {
+          targetCard.classList.add('drag-over');
+        }
+      });
+
+      grid.addEventListener('dragover', (e) => {
+        if (!draggedCard) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+
+        const targetCard = e.target.closest('.card');
+        clearDragOverClasses();
+        if (targetCard && targetCard !== draggedCard) {
+          targetCard.classList.add('drag-over');
+        }
+
+        if (e.clientX !== 0 || e.clientY !== 0) {
+          reorderByClientX(draggedCard, e.clientX);
+        }
+      });
+
+      grid.addEventListener('dragleave', (e) => {
+        const targetCard = e.target.closest('.card');
+        if (targetCard && !targetCard.contains(e.relatedTarget)) {
+          targetCard.classList.remove('drag-over');
+        }
+      });
+
+      grid.addEventListener('drop', (e) => {
+        if (!draggedCard) return;
+        e.preventDefault();
+
+        const targetCard = e.target.closest('.card');
+        if (e.clientX !== 0 || e.clientY !== 0) {
+          reorderByClientX(draggedCard, e.clientX);
+        } else if (targetCard && targetCard !== draggedCard) {
+          reorderByTargetCard(draggedCard, targetCard);
+        }
+
+        cleanupDrag();
+      });
+
+      grid.addEventListener('dragend', () => {
+        cleanupDrag();
+      });
+
+      // Fallback Mouse / Touch drag support (when native HTML5 dragstart does not fire)
+      grid.addEventListener('mousedown', (e) => {
+        if (e.button !== 0) return;
+        const card = e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+
+        pointerDragState = {
+          card,
+          startX: e.clientX,
+          startY: e.clientY,
+          active: false
+        };
+      });
+
+      window.addEventListener('mousemove', (e) => {
+        if (isHtml5Dragging || !pointerDragState) return;
+        const deltaX = Math.abs(e.clientX - pointerDragState.startX);
+        if (!pointerDragState.active && deltaX > 5) {
+          pointerDragState.active = true;
+          draggedCard = pointerDragState.card;
+          draggedCard.classList.add('dragging');
+        }
+
+        if (pointerDragState.active && (e.clientX !== 0 || e.clientY !== 0)) {
+          reorderByClientX(draggedCard, e.clientX);
+        }
+      });
+
+      window.addEventListener('mouseup', (e) => {
+        if (isHtml5Dragging || !pointerDragState) return;
+        const { card, startX, active } = pointerDragState;
+        const movedHorizontally = (e.clientX !== 0 || e.clientY !== 0) && Math.abs(e.clientX - startX) > 10;
+
+        if (active || movedHorizontally) {
+          reorderByClientX(card, e.clientX);
+          suppressNextClick = true;
+        }
+        cleanupDrag();
+      });
+
+      grid.addEventListener('touchstart', (e) => {
+        if (e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        const card = e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+
+        pointerDragState = {
+          card,
+          startX: touch.clientX,
+          startY: touch.clientY,
+          active: false
+        };
+      }, { passive: true });
+
+      window.addEventListener('touchmove', (e) => {
+        if (!pointerDragState || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        const deltaX = Math.abs(touch.clientX - pointerDragState.startX);
+        const deltaY = Math.abs(touch.clientY - pointerDragState.startY);
+
+        if (!pointerDragState.active && deltaX > 8 && deltaX > deltaY) {
+          pointerDragState.active = true;
+          draggedCard = pointerDragState.card;
+          draggedCard.classList.add('dragging');
+        }
+
+        if (pointerDragState.active) {
+          reorderByClientX(draggedCard, touch.clientX);
+        }
+      }, { passive: true });
+
+      window.addEventListener('touchend', () => {
+        if (!pointerDragState) return;
+        cleanupDrag();
+      });
+
+      grid.addEventListener('click', (e) => {
+        if (suppressNextClick) {
+          suppressNextClick = false;
+          e.preventDefault();
+          e.stopPropagation();
+        }
+      }, true);
+    })();
+  </script>
+
 </body>
 
