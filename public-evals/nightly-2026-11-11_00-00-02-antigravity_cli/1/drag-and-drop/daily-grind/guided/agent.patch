+
+      function endKeyboardGrab(commit, shouldAnnounce = true) {
+        if (!keyboardGrab) return;
+        const state = keyboardGrab;
+        keyboardGrab = null;
+
+        const { card, handle, originalNextSibling, originalIndex } = state;
+        handle.setAttribute('aria-pressed', 'false');
+        delete card.dataset.grabbed;
+        setHintText(card, HINT_IDLE);
+
+        if (!commit) {
+          const currentCards = getCards();
+          const currentIndex = currentCards.indexOf(card);
+          if (currentIndex !== originalIndex) {
+            const oldRects = new Map();
+            for (const c of currentCards) {
+              finishAnimations(c);
+              oldRects.set(c, c.getBoundingClientRect());
+            }
+            const oldScrollLeft = container.scrollLeft;
+
+            const ref =
+              originalNextSibling && originalNextSibling.parentNode === container
+                ? originalNextSibling
+                : getCards()[originalIndex] ?? null;
+            moveNodeBefore(card, ref, handle, null);
+
+            card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+            handle.focus({ preventScroll: true });
+            animateMoveWithFLIP(card, oldRects, oldScrollLeft, null);
+          } else {
+            card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+            handle.focus({ preventScroll: true });
+          }
+
+          if (shouldAnnounce) {
+            const cards = getCards();
+            announce(
+              `Reorder cancelled. ${getCardTitle(card)} returned to position ${ cards.indexOf(card) + 1 } of ${cards.length}.`
+            );
+          }
+          return;
+        }
+
+        if (shouldAnnounce) {
+          const cards = getCards();
+          const finalIndex = cards.indexOf(card);
+          if (finalIndex !== originalIndex) {
+            announce(
+              `Dropped ${getCardTitle(card)} at position ${finalIndex + 1} of ${cards.length}.`
+            );
+          } else {
+            announce(`Dropped ${getCardTitle(card)}, position unchanged.`);
+          }
+        }
+      }
+
+      function moveCardByKeyboard(card, handle, visualDirection) {
+        const cards = getCards();
+        const index = cards.indexOf(card);
+        if (index === -1) return;
+
+        const rtl = isRTL();
+        // ArrowLeft moves earlier in LTR, later in RTL; ArrowRight moves later in LTR, earlier in RTL
+        const delta =
+          visualDirection === 'left' ? (rtl ? 1 : -1) : rtl ? -1 : 1;
+        const targetIndex = index + delta;
+
+        if (targetIndex < 0 || targetIndex >= cards.length) {
+          return;
+        }
+
+        const oldRects = new Map();
+        for (const c of cards) {
+          finishAnimations(c);
+          oldRects.set(c, c.getBoundingClientRect());
+        }
+        const oldScrollLeft = container.scrollLeft;
+
+        const referenceNode =
+          delta < 0 ? cards[targetIndex] : cards[targetIndex].nextElementSibling;
+        moveNodeBefore(card, referenceNode, handle, null);
+
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        handle.focus({ preventScroll: true });
+
+        animateMoveWithFLIP(card, oldRects, oldScrollLeft, null);
+
+        const updatedCards = getCards();
+        const newIndex = updatedCards.indexOf(card);
+        announce(
+          `Moved ${getCardTitle(card)} ${visualDirection} to position ${newIndex + 1} of ${updatedCards.length}.`
+        );
+      }
+
+      container.addEventListener('keydown', (event) => {
+        const handle = event.target.closest('.drag-handle');
+        if (!handle || !container.contains(handle)) return;
+        const card = handle.closest('.card');
+        if (!card) return;
+
+        if (event.key === ' ' || event.key === 'Enter') {
+          event.preventDefault();
+          if (keyboardGrab && keyboardGrab.card === card) {
+            endKeyboardGrab(true, true);
+          } else {
+            if (keyboardGrab) endKeyboardGrab(true, false);
+            startKeyboardGrab(card, handle);
+          }
+          return;
+        }
+
+        if (event.key === 'Escape' && keyboardGrab && keyboardGrab.card === card) {
+          event.preventDefault();
+          endKeyboardGrab(false, true);
+          return;
+        }
+
+        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+          // Allow bare ArrowLeft/ArrowRight while grabbed, or Alt+ArrowLeft/ArrowRight directly
+          if ((keyboardGrab && keyboardGrab.card === card) || event.altKey) {
+            event.preventDefault();
+            const direction = event.key === 'ArrowLeft' ? 'left' : 'right';
+            moveCardByKeyboard(card, handle, direction);
+          }
+        }
+      });
+
+      // Drop when the handle itself loses focus (unless caused by the DOM move itself)
+      container.addEventListener('focusout', (event) => {
+        if (!keyboardGrab || isMovingDOM) return;
+        if (event.target === keyboardGrab.handle) {
+          endKeyboardGrab(true, true);
+        }
+      });
+
+      // Reveal the whole card when keyboard focus enters an item
+      container.addEventListener('focusin', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element) || !target.matches(':focus-visible')) return;
+        const card = target.closest('.card');
+        if (!card || card.getAnimations().length > 0) return;
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+    })();
+  </script>
 </body>
 
 </html>
