+  <script>
+    (function () {
+      const scrollLinks = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target], .hero a[data-scroll-target], .footer-links a[data-scroll-target]');
+      const sections = document.querySelectorAll('.page-section');
+      const navLinks = document.querySelectorAll('nav a');
+      let activeScrollCleanup = null;
+
+      function clearSectionEffects() {
+        sections.forEach((section) => {
+          section.classList.remove('scroll-target-active', 'is-highlighted', 'animate-highlight', 'active');
+          section.removeAttribute('data-scroll-arrived');
+        });
+      }
+
+      function applyPostScrollEffects(targetSection, triggerLink) {
+        clearSectionEffects();
+
+        navLinks.forEach((link) => {
+          const isMatch = link === triggerLink || link.getAttribute('href') === '#' + targetSection.id;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        targetSection.classList.add('scroll-target-active', 'is-highlighted', 'animate-highlight', 'active');
+        targetSection.setAttribute('data-scroll-arrived', 'true');
+
+        if (typeof targetSection.animate === 'function') {
+          try {
+            targetSection.animate(
+              [
+                { transform: 'translateY(0) scale(1)' },
+                { transform: 'translateY(-4px) scale(1.01)' },
+                { transform: 'translateY(0) scale(1)' }
+              ],
+              { duration: 600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
+            );
+          } catch (_) {
+            // Ignore if Web Animations API is stubbed or unsupported
+          }
+        }
+
+        targetSection.focus({ preventScroll: true });
+
+        if (history.pushState) {
+          history.pushState(null, '', '#' + targetSection.id);
+        }
+      }
+
+      function scrollToTargetSection(targetSection, triggerLink) {
+        if (activeScrollCleanup) {
+          activeScrollCleanup();
+          activeScrollCleanup = null;
+        }
+
+        // Ensure target effects and focus are not active while smooth scroll is in flight
+        clearSectionEffects();
+        if (document.activeElement === targetSection) {
+          targetSection.blur();
+        }
+
+        let finished = false;
+        let idleTimer = null;
+        let maxTimer = null;
+
+        function cleanup() {
+          window.removeEventListener('scrollend', onScrollEnd);
+          document.removeEventListener('scrollend', onScrollEnd);
+          window.removeEventListener('scroll', onScroll);
+          if (idleTimer) clearTimeout(idleTimer);
+          if (maxTimer) clearTimeout(maxTimer);
+        }
+
+        function finishScroll() {
+          if (finished) return;
+          finished = true;
+          cleanup();
+          activeScrollCleanup = null;
+          applyPostScrollEffects(targetSection, triggerLink);
+        }
+
+        function onScrollEnd() {
+          finishScroll();
+        }
+
+        function onScroll() {
+          if (idleTimer) clearTimeout(idleTimer);
+          idleTimer = setTimeout(finishScroll, 140);
+        }
+
+        activeScrollCleanup = cleanup;
+
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+        document.addEventListener('scrollend', onScrollEnd, { once: true });
+        window.addEventListener('scroll', onScroll, { passive: true });
+
+        // Fallback timer if no scroll events fire (e.g., already at target position) or scrollend isn't emitted
+        idleTimer = setTimeout(finishScroll, 350);
+        maxTimer = setTimeout(finishScroll, 1500);
+
+        targetSection.scrollIntoView({
+          behavior: 'smooth',
+          block: 'start'
+        });
+      }
+
+      scrollLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const rawTarget = link.getAttribute('data-scroll-target') || link.getAttribute('href') || '';
+          const targetId = rawTarget.replace(/^#/, '');
+          if (!targetId) return;
+
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          scrollToTargetSection(targetSection, link);
+        });
+      });
+    })();
+  </script>
