+    document.addEventListener('click', (event) => {
+      const trigger = event.target.closest('.toast-trigger');
+      if (trigger) {
+        // Suppress background toast surfacing while a modal dialog is open
+        if (document.querySelector('dialog:modal')) {
+          event.preventDefault();
+          return;
+        }
+
+        lastActiveTrigger = trigger;
+        const targetId = trigger.getAttribute('popovertarget') || trigger.dataset.toastTarget;
+        const toast = targetId ? document.getElementById(targetId) : null;
+        if (toast) {
+          toastTriggerMap.set(toast, trigger);
+          toast.removeAttribute('data-closing');
+
+          // If the toast is already open, move it to the front of the stack and re-announce
+          if (isToastOpen(toast)) {
+            event.preventDefault();
+            const existingIdx = openToastStack.indexOf(toast);
+            if (existingIdx !== -1) openToastStack.splice(existingIdx, 1);
+            openToastStack.push(toast);
+            updateToastStackPositions();
+            announceToast(toast);
+          }
+        }
+        return;
+      }
+
+      const closeBtn = event.target.closest('.toast-close, [popovertargetaction="hide"]');
+      if (closeBtn) {
+        const toast = closeBtn.closest('.toast');
+        if (toast) {
+          event.preventDefault();
+          const hadFocusInside = toast.contains(document.activeElement);
+          dismissToast(toast, { moveFocus: hadFocusInside || event.detail === 0 });
+        }
+      }
+    });
+
+    // Listen to native popover toggle events to manage stacking and screen reader announcements
+    toastContainer?.querySelectorAll('.toast').forEach((toast) => {
+      toast.addEventListener('toggle', (event) => {
+        if (event.newState === 'open') {
+          const existingIdx = openToastStack.indexOf(toast);
+          if (existingIdx !== -1) openToastStack.splice(existingIdx, 1);
+          openToastStack.push(toast);
+          updateToastStackPositions();
+          announceToast(toast);
+        } else if (event.newState === 'closed') {
+          const existingIdx = openToastStack.indexOf(toast);
+          if (existingIdx !== -1) openToastStack.splice(existingIdx, 1);
+          toast.style.removeProperty('--toast-offset');
+          updateToastStackPositions();
+        }
+      });
+    });
+
+    window.addEventListener('resize', updateToastStackPositions);
+  </script>
