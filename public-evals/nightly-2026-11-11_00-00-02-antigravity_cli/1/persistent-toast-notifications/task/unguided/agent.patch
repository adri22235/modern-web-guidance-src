+  <!-- Toast Notification Stack Container -->
+  <div id="toast-container" class="toast-container" role="region" aria-live="polite" aria-label="Notifications"></div>
+
+  <script>
+    (function () {
+      const container = document.getElementById('toast-container');
+      const DEFAULT_DURATION = 4500;
+
+      const ICONS = {
+        success: '✓',
+        info: '☕',
+        reward: '★',
+        warning: '!'
+      };
+
+      function dismissToast(toastEl) {
+        if (!toastEl || toastEl.classList.contains('toast-leaving')) return;
+
+        if (toastEl._toastTimer) {
+          clearTimeout(toastEl._toastTimer);
+          toastEl._toastTimer = null;
+        }
+
+        toastEl.classList.remove('toast-visible', 'show', 'active');
+        toastEl.classList.add('toast-leaving', 'hide', 'removing');
+
+        const removeElement = () => {
+          if (toastEl.parentNode) {
+            toastEl.parentNode.removeChild(toastEl);
+          }
+        };
+
+        toastEl.addEventListener('animationend', removeElement, { once: true });
+        toastEl.addEventListener('transitionend', removeElement, { once: true });
+        setTimeout(removeElement, 350);
+      }
+
+      function scheduleAutoDismiss(toastEl, duration) {
+        if (duration <= 0) return;
+        let remaining = duration;
+        let startTime = Date.now();
+
+        const startTimer = () => {
+          startTime = Date.now();
+          toastEl._toastTimer = setTimeout(() => {
+            dismissToast(toastEl);
+          }, remaining);
+        };
+
+        const pauseTimer = () => {
+          if (toastEl._toastTimer) {
+            clearTimeout(toastEl._toastTimer);
+            toastEl._toastTimer = null;
+            remaining -= Date.now() - startTime;
+            if (remaining < 400) remaining = 400;
+          }
+        };
+
+        toastEl.addEventListener('mouseenter', pauseTimer);
+        toastEl.addEventListener('mouseleave', startTimer);
+
+        startTimer();
+      }
+
+      function createToast(options = {}) {
+        const type = options.type || 'info';
+        const title = options.title || 'The Daily Grind';
+        const message = options.message || 'Your coffee notification is ready!';
+        const duration = typeof options.duration === 'number' ? options.duration : DEFAULT_DURATION;
+
+        const toast = document.createElement('div');
+        toast.className = 'toast toast-visible show active';
+        toast.setAttribute('role', 'status');
+        toast.setAttribute('aria-atomic', 'true');
+        toast.setAttribute('data-toast-type', type);
+
+        const iconSpan = document.createElement('div');
+        iconSpan.className = 'toast-icon';
+        iconSpan.setAttribute('aria-hidden', 'true');
+        iconSpan.textContent = ICONS[type] || ICONS.info;
+
+        const bodyDiv = document.createElement('div');
+        bodyDiv.className = 'toast-body';
+
+        if (title) {
+          const titleDiv = document.createElement('div');
+          titleDiv.className = 'toast-title';
+          titleDiv.textContent = title;
+          bodyDiv.appendChild(titleDiv);
+        }
+
+        const msgDiv = document.createElement('div');
+        msgDiv.className = 'toast-message';
+        msgDiv.textContent = message;
+        bodyDiv.appendChild(msgDiv);
+
+        const closeBtn = document.createElement('button');
+        closeBtn.type = 'button';
+        closeBtn.className = 'toast-close';
+        closeBtn.setAttribute('aria-label', 'Dismiss notification');
+        closeBtn.innerHTML = '&times;';
+        closeBtn.addEventListener('click', () => dismissToast(toast));
+
+        const progress = document.createElement('div');
+        progress.className = 'toast-progress';
+        progress.style.animationDuration = duration + 'ms';
+
+        toast.appendChild(iconSpan);
+        toast.appendChild(bodyDiv);
+        toast.appendChild(closeBtn);
+        if (duration > 0) {
+          toast.appendChild(progress);
+        }
+
+        container.appendChild(toast);
+        scheduleAutoDismiss(toast, duration);
+
+        return toast;
+      }
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger) return;
+
+        if (trigger.tagName === 'A') {
+          event.preventDefault();
+        }
+
+        const title = trigger.getAttribute('data-toast-title') || trigger.getAttribute('data-title') || 'The Daily Grind';
+        const message =
+          trigger.getAttribute('data-toast-message') ||
+          trigger.getAttribute('data-message') ||
+          trigger.getAttribute('data-toast') ||
+          `${trigger.textContent.trim()} notification triggered.`;
+        const type = trigger.getAttribute('data-toast-type') || trigger.getAttribute('data-type') || 'info';
+        const durationAttr = trigger.getAttribute('data-toast-duration');
+        const duration = durationAttr ? parseInt(durationAttr, 10) : DEFAULT_DURATION;
+
+        createToast({ title, message, type, duration });
+      });
+
+      window.showToast = createToast;
+      window.dismissToast = dismissToast;
+    })();
+  </script>
 </body>
 
