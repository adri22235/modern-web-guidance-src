+          <span className="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 px-2.5 py-0.5 rounded-full">
+            <span className="w-2 h-2 rounded-full bg-gray-400" />
+            Disconnected
+          </span>
+        );
+    }
+  };
+
+  return (
+    <section
+      id="developer-diagnostics-widget"
+      data-testid="developer-diagnostics-widget"
+      aria-label="Developer Diagnostics Connection Widget"
+      className={`bg-slate-900 text-slate-100 border-y border-slate-700 ${
+        compact ? 'p-4 rounded-lg shadow-xl' : 'py-5 px-4 sm:px-6 lg:px-8'
+      }`}
+    >
+      <div className="max-w-6xl mx-auto">
+        {/* Header Bar */}
+        <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3 pb-4 border-b border-slate-800">
+          <div>
+            <div className="flex items-center gap-2.5">
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-amber-400 text-slate-950">
+                DevTools Lab
+              </span>
+              <h2 className="text-base sm:text-lg font-bold tracking-tight text-white">
+                Developer Diagnostics Connection Hub
+              </h2>
+            </div>
+            <p className="text-xs sm:text-sm text-slate-400 mt-1">
+              Connect directly from your browser to a private Wi-Fi LAN hardware test device (
+              <code className="text-amber-300 font-mono">192.168.1.x</code>,{' '}
+              <code className="text-amber-300 font-mono">targetAddressSpace: &quot;local&quot;</code>) and your
+              local companion CLI (<code className="text-amber-300 font-mono">127.0.0.1</code>,{' '}
+              <code className="text-amber-300 font-mono">targetAddressSpace: &quot;loopback&quot;</code>).
+            </p>
+          </div>
+
+          <div className="flex flex-wrap items-center gap-2">
+            <button
+              type="button"
+              onClick={connectBoth}
+              data-testid="connect-both-button"
+              disabled={lanStatus.state === 'connecting' || cliStatus.state === 'connecting'}
+              className="bg-amber-400 hover:bg-amber-300 disabled:opacity-60 text-slate-950 font-semibold text-xs px-3.5 py-2 rounded transition cursor-pointer"
+            >
+              Connect Both Endpoints
+            </button>
+            <button
+              type="button"
+              onClick={() => refreshPermissions()}
+              data-testid="refresh-permissions-button"
+              className="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium text-xs px-3 py-2 rounded transition cursor-pointer"
+            >
+              Check LNA Permissions
+            </button>
+            <button
+              type="button"
+              onClick={() => setShowGuide((prev) => !prev)}
+              className="bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-medium text-xs px-3 py-2 rounded transition cursor-pointer"
+            >
+              {showGuide ? 'Hide LNA Guide' : 'LNA & CORS Guide'}
+            </button>
+          </div>
+        </div>
+
+        {/* Dual Connection Cards */}
+        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
+          {/* Card 1: Hardware Test Device on Private Wi-Fi LAN (192.168.1.x) */}
+          <div
+            data-testid="lan-device-card"
+            className="bg-slate-800/90 border border-slate-700 rounded-lg p-4 flex flex-col justify-between"
+          >
+            <div>
+              <div className="flex flex-wrap items-start justify-between gap-2 mb-2">
+                <div>
+                  <span className="text-[11px] font-mono uppercase tracking-wider text-amber-400 block">
+                    Private Wi-Fi LAN • targetAddressSpace: &quot;local&quot;
+                  </span>
+                  <h3 className="text-sm sm:text-base font-bold text-white">
+                    Hardware Test Device (192.168.1.x)
+                  </h3>
+                </div>
+                {renderConnectionBadge(lanStatus.state, lanStatus.latencyMs)}
+              </div>
+
+              <div className="flex flex-wrap items-center gap-2 mb-3">
+                {renderPermissionBadge(lanStatus.permissionName, lanStatus.permissionState)}
+                <span className="text-xs text-slate-400">
+                  Private LAN / RFC1918 (<code className="font-mono text-slate-300">192.168.1.x</code>)
+                </span>
+              </div>
+
+              <label
+                htmlFor="lan-device-url-input"
+                className="block text-xs font-medium text-slate-300 mb-1"
+              >
+                LAN Hardware Endpoint URL or IP
+              </label>
+              <div className="flex gap-2">
+                <input
+                  id="lan-device-url-input"
+                  data-testid="lan-device-url-input"
+                  type="text"
+                  value={lanUrl}
+                  onChange={(e) => setLanUrl(e.target.value)}
+                  placeholder="http://192.168.1.100:8080/diagnostics"
+                  className="flex-1 bg-slate-950 border border-slate-700 rounded px-3 py-1.5 text-xs sm:text-sm font-mono text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+                <button
+                  type="button"
+                  data-testid="connect-lan-button"
+                  onClick={() => connectToEndpoint('local', lanUrl)}
+                  disabled={lanStatus.state === 'connecting'}
+                  className="bg-amber-400 hover:bg-amber-300 disabled:opacity-50 text-slate-950 font-semibold text-xs px-3.5 py-1.5 rounded whitespace-nowrap transition cursor-pointer"
+                >
+                  {lanStatus.state === 'connecting' ? 'Connecting...' : 'Connect LAN Device'}
+                </button>
+              </div>
+
+              {/* Presets for 192.168.1.x */}
+              <div className="flex flex-wrap items-center gap-1.5 mt-2">
+                <span className="text-[11px] text-slate-400">Presets:</span>
+                {[
+                  'http://192.168.1.100:8080/diagnostics',
+                  'http://192.168.1.50:8080/status',
+                  'http://192.168.1.1:8080/health',
+                ].map((preset) => (
+                  <button
+                    key={preset}
+                    type="button"
+                    onClick={() => setLanUrl(preset)}
+                    className="text-[11px] font-mono bg-slate-900 hover:bg-slate-700 text-slate-300 border border-slate-700 px-2 py-0.5 rounded transition cursor-pointer"
+                  >
+                    {preset.replace(/^http:\/\//, '')}
+                  </button>
+                ))}
+              </div>
+            </div>
+
+            {/* Status / Response Output */}
+            <div className="mt-3 pt-3 border-t border-slate-700/80 text-xs">
+              {lanStatus.errorMessage && (
+                <div
+                  data-testid="lan-error-message"
+                  className="bg-red-950/60 border border-red-800/80 text-red-200 rounded p-2.5 font-mono text-[11px] leading-relaxed"
+                >
+                  {lanStatus.errorMessage}
+                </div>
+              )}
+              {lanStatus.payload && (
+                <div className="mt-1">
+                  <span className="text-[11px] text-slate-400 block mb-1">
+                    Device Telemetry Payload:
+                  </span>
+                  <pre
+                    data-testid="lan-response-payload"
+                    className="bg-slate-950 border border-slate-800 rounded p-2 text-[11px] font-mono text-emerald-300 overflow-x-auto max-h-28"
+                  >
+                    {lanStatus.payload}
+                  </pre>
+                </div>
+              )}
+              {!lanStatus.errorMessage && !lanStatus.payload && (
+                <p className="text-slate-400 text-[11px]">
+                  Ready to probe hardware test rig on private Wi-Fi LAN using{' '}
+                  <code className="font-mono text-slate-300">
+                    fetch(url, &#123; targetAddressSpace: &apos;local&apos; &#125;)
+                  </code>
+                  .
+                </p>
+              )}
+            </div>
+          </div>
+
+          {/* Card 2: Local Companion CLI on Loopback (127.0.0.1) */}
+          <div
+            data-testid="loopback-cli-card"
+            className="bg-slate-800/90 border border-slate-700 rounded-lg p-4 flex flex-col justify-between"
+          >
+            <div>
+              <div className="flex flex-wrap items-start justify-between gap-2 mb-2">
+                <div>
+                  <span className="text-[11px] font-mono uppercase tracking-wider text-sky-400 block">
+                    Local Machine Loopback • targetAddressSpace: &quot;loopback&quot;
+                  </span>
+                  <h3 className="text-sm sm:text-base font-bold text-white">
+                    Local Companion CLI (127.0.0.1)
+                  </h3>
+                </div>
+                {renderConnectionBadge(cliStatus.state, cliStatus.latencyMs)}
+              </div>
+
+              <div className="flex flex-wrap items-center gap-2 mb-3">
+                {renderPermissionBadge(cliStatus.permissionName, cliStatus.permissionState)}
+                <span className="text-xs text-slate-400">
+                  Loopback Interface (<code className="font-mono text-slate-300">127.0.0.1</code> /{' '}
+                  <code className="font-mono text-slate-300">localhost</code>)
+                </span>
+              </div>
+
+              <label
+                htmlFor="loopback-cli-url-input"
+                className="block text-xs font-medium text-slate-300 mb-1"
+              >
+                Companion CLI Endpoint URL
+              </label>
+              <div className="flex gap-2">
+                <input
+                  id="loopback-cli-url-input"
+                  data-testid="loopback-cli-url-input"
+                  type="text"
+                  value={cliUrl}
+                  onChange={(e) => setCliUrl(e.target.value)}
+                  placeholder="http://127.0.0.1:9229/diagnostics"
+                  className="flex-1 bg-slate-950 border border-slate-700 rounded px-3 py-1.5 text-xs sm:text-sm font-mono text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+                <button
+                  type="button"
+                  data-testid="connect-cli-button"
+                  onClick={() => connectToEndpoint('loopback', cliUrl)}
+                  disabled={cliStatus.state === 'connecting'}
+                  className="bg-sky-400 hover:bg-sky-300 disabled:opacity-50 text-slate-950 font-semibold text-xs px-3.5 py-1.5 rounded whitespace-nowrap transition cursor-pointer"
+                >
+                  {cliStatus.state === 'connecting' ? 'Connecting...' : 'Connect Local CLI'}
+                </button>
+              </div>
+
+              {/* Presets for 127.0.0.1 */}
+              <div className="flex flex-wrap items-center gap-1.5 mt-2">
+                <span className="text-[11px] text-slate-400">Presets:</span>
+                {[
+                  'http://127.0.0.1:9229/diagnostics',
+                  'http://127.0.0.1:8787/status',
+                  'http://localhost:9229/diagnostics',
+                ].map((preset) => (
+                  <button
+                    key={preset}
+                    type="button"
+                    onClick={() => setCliUrl(preset)}
+                    className="text-[11px] font-mono bg-slate-900 hover:bg-slate-700 text-slate-300 border border-slate-700 px-2 py-0.5 rounded transition cursor-pointer"
+                  >
+                    {preset.replace(/^http:\/\//, '')}
+                  </button>
+                ))}
+              </div>
+            </div>
+
+            {/* Status / Response Output */}
+            <div className="mt-3 pt-3 border-t border-slate-700/80 text-xs">
+              {cliStatus.errorMessage && (
+                <div
+                  data-testid="cli-error-message"
+                  className="bg-red-950/60 border border-red-800/80 text-red-200 rounded p-2.5 font-mono text-[11px] leading-relaxed"
