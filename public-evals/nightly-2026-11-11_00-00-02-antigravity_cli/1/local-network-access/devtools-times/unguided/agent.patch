+import React, { useState, useEffect, useCallback } from 'react';
+
+export type AddressSpaceType = 'local' | 'loopback';
+export type ConnectionState = 'idle' | 'connecting' | 'connected' | 'error';
+export type PermissionStateValue = PermissionState | 'unsupported' | 'checking';
+
+interface EndpointStatus {
+  state: ConnectionState;
+  latencyMs: number | null;
+  statusCode: number | null;
+  payload: string | null;
+  errorMessage: string | null;
+  lastChecked: string | null;
+  permissionName: string;
+  permissionState: PermissionStateValue;
+}
+
+interface LogEntry {
+  id: string;
+  timestamp: string;
+  target: 'Hardware Test Device (LAN)' | 'Local Companion CLI (Loopback)' | 'Permissions API';
+  url: string;
+  addressSpace: AddressSpaceType;
+  status: 'info' | 'success' | 'error';
+  message: string;
+}
+
+function normalizeEndpointUrl(input: string, defaultProtocol = 'http://'): string {
+  const trimmed = input.trim();
+  if (!trimmed) return '';
+  if (/^https?:\/\//i.test(trimmed)) {
+    return trimmed;
+  }
+  return `${defaultProtocol}${trimmed}`;
+}
+
+async function queryNetworkPermission(
+  candidates: string[]
+): Promise<{ name: string; state: PermissionStateValue; statusObj: PermissionStatus | null }> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return { name: candidates[0], state: 'unsupported', statusObj: null };
+  }
+
+  for (const name of candidates) {
+    try {
+      const statusObj = await navigator.permissions.query({
+        name: name as PermissionName,
+      });
+      return { name, state: statusObj.state, statusObj };
+    } catch {
+      // Try next fallback permission name
+    }
+  }
+
+  return { name: candidates[0], state: 'unsupported', statusObj: null };
+}
+
+interface DiagnosticsWidgetProps {
+  compact?: boolean;
+}
+
+export default function DiagnosticsWidget({ compact = false }: DiagnosticsWidgetProps) {
+  const [lanUrl, setLanUrl] = useState('http://192.168.1.100:8080/diagnostics');
+  const [cliUrl, setCliUrl] = useState('http://127.0.0.1:9229/diagnostics');
+  const [showGuide, setShowGuide] = useState(false);
+
+  const [lanStatus, setLanStatus] = useState<EndpointStatus>({
+    state: 'idle',
+    latencyMs: null,
+    statusCode: null,
+    payload: null,
+    errorMessage: null,
+    lastChecked: null,
+    permissionName: 'local-network',
+    permissionState: 'checking',
+  });
+
+  const [cliStatus, setCliStatus] = useState<EndpointStatus>({
+    state: 'idle',
+    latencyMs: null,
+    statusCode: null,
+    payload: null,
+    errorMessage: null,
+    lastChecked: null,
+    permissionName: 'loopback-network',
+    permissionState: 'checking',
+  });
+
+  const [logs, setLogs] = useState<LogEntry[]>([]);
+
+  const appendLog = useCallback((entry: Omit<LogEntry, 'id' | 'timestamp'>) => {
+    const now = new Date().toLocaleTimeString();
+    setLogs((prev) => [
+      {
+        ...entry,
+        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
+        timestamp: now,
+      },
+      ...prev.slice(0, 19),
+    ]);
+  }, []);
+
+  const refreshPermissions = useCallback(async () => {
+    // Check LAN permission ('local-network' with fallback to 'local-network-access')
+    const lanPerm = await queryNetworkPermission(['local-network', 'local-network-access']);
+    setLanStatus((prev) => ({
+      ...prev,
+      permissionName: lanPerm.name,
+      permissionState: lanPerm.state,
+    }));
+    if (lanPerm.statusObj) {
+      lanPerm.statusObj.onchange = () => {
+        setLanStatus((prev) => ({
+          ...prev,
+          permissionState: lanPerm.statusObj ? lanPerm.statusObj.state : prev.permissionState,
+        }));
+      };
+    }
+
+    // Check Loopback CLI permission ('loopback-network' with fallback to 'local-network-access')
+    const cliPerm = await queryNetworkPermission(['loopback-network', 'local-network-access']);
+    setCliStatus((prev) => ({
+      ...prev,
+      permissionName: cliPerm.name,
+      permissionState: cliPerm.state,
+    }));
+    if (cliPerm.statusObj) {
+      cliPerm.statusObj.onchange = () => {
+        setCliStatus((prev) => ({
+          ...prev,
+          permissionState: cliPerm.statusObj ? cliPerm.statusObj.state : prev.permissionState,
+        }));
+      };
+    }
+
+    return { lanPerm, cliPerm };
+  }, []);
+
+  useEffect(() => {
+    refreshPermissions();
+  }, [refreshPermissions]);
+
+  const connectToEndpoint = useCallback(
+    async (addressSpace: AddressSpaceType, rawUrl: string) => {
+      const isLan = addressSpace === 'local';
+      const targetLabel = isLan
+        ? 'Hardware Test Device (LAN)'
+        : 'Local Companion CLI (Loopback)';
+      const setStatus = isLan ? setLanStatus : setCliStatus;
+      const url = normalizeEndpointUrl(rawUrl);
+
+      if (!url) {
+        setStatus((prev) => ({
+          ...prev,
+          state: 'error',
+          errorMessage: 'Please enter a valid endpoint URL or IP address.',
+        }));
+        return;
+      }
+
+      setStatus((prev) => ({
+        ...prev,
+        state: 'connecting',
+        errorMessage: null,
+        statusCode: null,
+      }));
+
+      appendLog({
+        target: targetLabel,
+        url,
+        addressSpace,
+        status: 'info',
+        message: `Initiating fetch("${url}", { targetAddressSpace: "${addressSpace}" })`,
+      });
+
+      const controller = new AbortController();
+      const timeoutId = window.setTimeout(() => controller.abort(), 5000);
+      const startTime = performance.now();
+
+      try {
+        const requestInit: RequestInit = {
+          method: 'GET',
+          mode: 'cors',
+          targetAddressSpace: addressSpace,
+          headers: {
+            Accept: 'application/json, text/plain, */*',
+          },
+          signal: controller.signal,
+        };
+
+        const response = await fetch(url, requestInit);
+        window.clearTimeout(timeoutId);
+
+        const latencyMs = Math.round(performance.now() - startTime);
+        const rawText = await response.text();
+        let formattedPayload = rawText;
+
+        try {
+          const parsed = JSON.parse(rawText);
+          formattedPayload = JSON.stringify(parsed, null, 2);
+        } catch {
+          // Keep plain text payload if not JSON
+        }
+
+        await refreshPermissions();
+
+        if (!response.ok) {
+          const errText = `HTTP ${response.status} ${response.statusText || ''}`.trim();
+          setStatus((prev) => ({
+            ...prev,
+            state: 'error',
+            latencyMs,
+            statusCode: response.status,
+            payload: formattedPayload || null,
+            errorMessage: `Endpoint responded with ${errText}`,
+            lastChecked: new Date().toLocaleTimeString(),
+          }));
+
+          appendLog({
+            target: targetLabel,
+            url,
+            addressSpace,
+            status: 'error',
+            message: `${errText} (${latencyMs}ms)`,
+          });
+          return;
+        }
+
+        setStatus((prev) => ({
+          ...prev,
+          state: 'connected',
+          latencyMs,
+          statusCode: response.status,
+          payload: formattedPayload || '{"status":"ok"}',
+          errorMessage: null,
+          lastChecked: new Date().toLocaleTimeString(),
+        }));
+
+        appendLog({
+          target: targetLabel,
+          url,
+          addressSpace,
+          status: 'success',
+          message: `Connected via targetAddressSpace: "${addressSpace}" (${latencyMs}ms)`,
+        });
+      } catch (err: unknown) {
+        window.clearTimeout(timeoutId);
+        const latencyMs = Math.round(performance.now() - startTime);
+        const perms = await refreshPermissions();
+        const currentPerm = isLan ? perms.lanPerm : perms.cliPerm;
+
+        const isAborted = err instanceof DOMException && err.name === 'AbortError';
+        let diagnosticHint = '';
+
+        if (currentPerm.state === 'denied') {
+          diagnosticHint = `Browser permission "${currentPerm.name}" was denied. Allow Local Network Access in your browser address bar settings.`;
+        } else if (isAborted) {
+          diagnosticHint = `Connection timed out after 5s. Verify that the ${
+            isLan ? 'LAN hardware device (192.168.1.x)' : 'local companion CLI (127.0.0.1)'
+          } is running and reachable.`;
+        } else {
+          diagnosticHint = `Failed to reach ${url} (targetAddressSpace: "${addressSpace}"). Ensure the service is running, Local Network Access permission is granted, and CORS headers are enabled.`;
+        }
+
+        setStatus((prev) => ({
+          ...prev,
+          state: 'error',
+          latencyMs,
+          statusCode: null,
+          errorMessage: diagnosticHint,
+          lastChecked: new Date().toLocaleTimeString(),
+        }));
+
+        appendLog({
+          target: targetLabel,
+          url,
+          addressSpace,
+          status: 'error',
+          message: diagnosticHint,
+        });
+      }
+    },
+    [appendLog, refreshPermissions]
+  );
+
+  const connectBoth = useCallback(async () => {
+    await Promise.allSettled([
+      connectToEndpoint('local', lanUrl),
+      connectToEndpoint('loopback', cliUrl),
+    ]);
+  }, [connectToEndpoint, lanUrl, cliUrl]);
+
+  const renderPermissionBadge = (name: string, state: PermissionStateValue) => {
+    const styles: Record<PermissionStateValue, string> = {
+      granted: 'bg-emerald-100 text-emerald-800 border-emerald-300',
+      prompt: 'bg-amber-100 text-amber-800 border-amber-300',
+      denied: 'bg-red-100 text-red-800 border-red-300',
+      unsupported: 'bg-gray-100 text-gray-700 border-gray-300',
+      checking: 'bg-blue-50 text-blue-700 border-blue-200',
+    };
+
+    return (
+      <span
+        className={`inline-flex items-center gap-1.5 text-xs font-mono px-2 py-0.5 rounded border ${styles[state]}`}
+        title={`Permissions API status for "${name}"`}
+      >
+        <span
+          className={`w-1.5 h-1.5 rounded-full ${
+            state === 'granted'
+              ? 'bg-emerald-600'
+              : state === 'prompt'
+              ? 'bg-amber-500'
+              : state === 'denied'
+              ? 'bg-red-600'
+              : 'bg-gray-400'
+          }`}
+        />
+        {name}: {state}
+      </span>
+    );
+  };
+
+  const renderConnectionBadge = (state: ConnectionState, latencyMs: number | null) => {
+    switch (state) {
