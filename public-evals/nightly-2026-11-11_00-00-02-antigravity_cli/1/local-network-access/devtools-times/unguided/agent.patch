+                </div>
+              )}
+              {cliStatus.payload && (
+                <div className="mt-1">
+                  <span className="text-[11px] text-slate-400 block mb-1">
+                    CLI Diagnostics Output:
+                  </span>
+                  <pre
+                    data-testid="cli-response-payload"
+                    className="bg-slate-950 border border-slate-800 rounded p-2 text-[11px] font-mono text-sky-300 overflow-x-auto max-h-28"
+                  >
+                    {cliStatus.payload}
+                  </pre>
+                </div>
+              )}
+              {!cliStatus.errorMessage && !cliStatus.payload && (
+                <p className="text-slate-400 text-[11px]">
+                  Ready to query local companion CLI on loopback using{' '}
+                  <code className="font-mono text-slate-300">
+                    fetch(url, &#123; targetAddressSpace: &apos;loopback&apos; &#125;)
+                  </code>
+                  .
+                </p>
+              )}
+            </div>
+          </div>
+        </div>
+
+        {/* Collapsible Setup & LNA Guide */}
+        {showGuide && (
+          <div
+            data-testid="lna-setup-guide"
+            className="mt-4 bg-slate-950 border border-slate-800 rounded-lg p-4 text-xs text-slate-300 space-y-2"
+          >
+            <h4 className="font-bold text-white text-sm">
+              Local Network Access (LNA) & Companion Endpoint Requirements
+            </h4>
+            <p>
+              Modern browsers gate requests from public websites to private LAN devices (
+              <code className="font-mono text-amber-300">local</code>) and local host services (
+              <code className="font-mono text-sky-300">loopback</code>) behind the{' '}
+              <strong>Local Network Access</strong> permission prompt and explicit{' '}
+              <code className="font-mono text-amber-300">targetAddressSpace</code> fetch options:
+            </p>
+            <div className="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
+              <div className="bg-slate-900 p-3 rounded border border-slate-800">
+                <div className="font-semibold text-amber-300 mb-1">
+                  1. Browser Fetch Options (Client)
+                </div>
+                <pre className="font-mono text-[11px] text-slate-200 overflow-x-auto">{`// Private Wi-Fi LAN Hardware Device
+await fetch("http://192.168.1.100:8080/diagnostics", {
+  targetAddressSpace: "local"
+});
+
+// Local Machine Companion CLI
+await fetch("http://127.0.0.1:9229/diagnostics", {
+  targetAddressSpace: "loopback"
+});`}</pre>
+              </div>
+              <div className="bg-slate-900 p-3 rounded border border-slate-800">
+                <div className="font-semibold text-sky-300 mb-1">
+                  2. Device & CLI Response Headers (Server)
+                </div>
+                <pre className="font-mono text-[11px] text-slate-200 overflow-x-auto">{`Access-Control-Allow-Origin: https://astro-news-pytrpecapa-uc.a.run.app
+Access-Control-Allow-Methods: GET, POST, OPTIONS
+Access-Control-Allow-Headers: Content-Type, Accept
+Access-Control-Allow-Private-Network: true`}</pre>
+              </div>
+            </div>
+          </div>
+        )}
+
+        {/* Recent Connection Activity Log */}
+        {logs.length > 0 && (
+          <div className="mt-4 bg-slate-950 border border-slate-800 rounded-lg p-3">
+            <div className="flex items-center justify-between mb-2">
+              <span className="text-[11px] font-mono uppercase tracking-wider text-slate-400">
+                Diagnostics Activity Log
+              </span>
+              <button
+                type="button"
+                onClick={() => setLogs([])}
+                className="text-[11px] text-slate-400 hover:text-white cursor-pointer"
+              >
+                Clear
+              </button>
+            </div>
+            <ul className="space-y-1 max-h-28 overflow-y-auto font-mono text-[11px]">
+              {logs.map((entry) => (
+                <li key={entry.id} className="flex flex-wrap items-baseline gap-2">
+                  <span className="text-slate-500">[{entry.timestamp}]</span>
+                  <span
+                    className={
+                      entry.addressSpace === 'local' ? 'text-amber-400' : 'text-sky-400'
+                    }
+                  >
+                    [{entry.addressSpace}]
+                  </span>
+                  <span
+                    className={
+                      entry.status === 'success'
+                        ? 'text-emerald-300'
+                        : entry.status === 'error'
+                        ? 'text-red-300'
+                        : 'text-slate-300'
+                    }
+                  >
+                    {entry.message}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
