+
+              {cliResult && !cliError && (
+                <div className="p-2 rounded bg-slate-950 border border-emerald-800/60 font-mono text-[11px] text-emerald-300 overflow-x-auto">
+                  <div>
+                    Connected to {cliResult.endpoint} ({cliResult.addressSpace}) at{' '}
+                    {cliResult.timestamp}
+                  </div>
+                  <pre className="mt-1 text-slate-300 whitespace-pre-wrap">
+                    {typeof cliResult.payload === 'string'
+                      ? cliResult.payload
+                      : JSON.stringify(cliResult.payload, null, 2)}
+                  </pre>
+                </div>
+              )}
+            </div>
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
