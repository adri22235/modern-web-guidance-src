@@ -0,0 +1,137 @@
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+export interface DiagnosticsResponse {
+  status: string;
+  endpoint: string;
+  addressSpace: TargetAddressSpace;
+  timestamp: string;
+  payload: unknown;
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions ('local-network' and 'loopback-network').
+ * Wraps navigator.permissions.query in try/catch and falls back to 'prompt' when unsupported.
+ * Never queries the legacy 'local-network-access' permission name, which crashes older Chrome versions.
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    return status.state;
+  } catch {
+    // Unrecognized PermissionName in browsers without granular LNA support; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target address space
+ * and subscribes to live permission state changes in browser site settings.
+ */
+export async function subscribeLnaPermission(
+  permissionName: LnaPermissionName,
+  onStateChange: (state: PermissionState) => void
+): Promise<() => void> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    onStateChange('prompt');
+    return () => {};
+  }
+
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    const handleChange = () => {
+      onStateChange(status.state);
+    };
+    status.addEventListener('change', handleChange);
+    onStateChange(status.state);
+    return () => {
+      status.removeEventListener('change', handleChange);
+    };
+  } catch {
+    onStateChange('prompt');
+    return () => {};
+  }
+}
+
+/**
+ * Connects to a hardware test device on the user's private Wi-Fi LAN (e.g., 192.168.1.x or .local).
+ * Explicitly sets targetAddressSpace: 'local' for Mixed Content exemption and IP address space verification.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status'
+): Promise<DiagnosticsResponse> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Hardware test device responded with HTTP ${response.status}`);
+  }
+
+  const contentType = response.headers.get('content-type') || '';
+  const payload = contentType.includes('application/json')
+    ? await response.json()
+    : await response.text();
+
+  return {
+    status: 'connected',
+    endpoint: deviceUrl,
+    addressSpace: 'local',
+    timestamp: new Date().toISOString(),
+    payload,
+  };
+}
+
+/**
+ * Connects to a local companion CLI daemon running on the user's loopback interface (127.0.0.1, [::1], or localhost).
+ * Explicitly sets targetAddressSpace: 'loopback' for Mixed Content exemption and IP address space verification.
+ */
+export async function fetchLoopbackCompanionCli(
+  daemonUrl = 'http://127.0.0.1:45678/health'
+): Promise<DiagnosticsResponse> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion CLI responded with HTTP ${response.status}`);
+  }
+
+  const contentType = response.headers.get('content-type') || '';
+  const payload = contentType.includes('application/json')
+    ? await response.json()
+    : await response.text();
+
+  return {
+    status: 'connected',
+    endpoint: daemonUrl,
+    addressSpace: 'loopback',
+    timestamp: new Date().toISOString(),
+    payload,
+  };
+}
+
+/**
+ * Opens a real-time WebSocket stream to a local network hardware device or loopback CLI.
+ * Passes only the subprotocol array as the second argument (never a targetAddressSpace options object).
+ */
+export function openDiagnosticsWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream'
+): WebSocket {
+  return new WebSocket(wsUrl, ['v1.telemetry']);
+}
