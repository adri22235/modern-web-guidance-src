+  <script type="module">
+    /**
+     * Synchronizes permission badge and remediation instructions for a granular LNA permission.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {PermissionState} state
+     */
+    function updatePermissionUI(permissionName, state) {
+      const badge = document.querySelector(`[data-permission-badge="${permissionName}"]`);
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+
+      if (badge) {
+        badge.dataset.state = state;
+      }
+      if (statusBadge) {
+        statusBadge.textContent = state;
+      }
+      if (remediationBox) {
+        remediationBox.hidden = state !== 'denied';
+      }
+    }
+
+    /**
+     * Cross-browser permission check for the granular LNA permissions ('local-network' and 'loopback-network').
+     * Never queries the legacy 'local-network-access' alias, which crashes older Chrome versions.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {() => void} [onGrantedCallback]
+     * @returns {Promise<PermissionState>}
+     */
+    async function checkNetworkPermission(permissionName, onGrantedCallback) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+          if (status.state === 'granted' && typeof onGrantedCallback === 'function') {
+            onGrantedCallback();
+          }
+        });
+
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name in browsers without LNA support; fall back to 'prompt'
+        // so connections only run on an explicit user gesture.
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    /**
+     * Connects to the Wi-Fi coffee brewer on the shop's private LAN over HTTP.
+     * Declares targetAddressSpace: 'local' for Mixed Content exemption and post-DNS verification.
+     * @param {string} deviceUrl
+     */
+    async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request, {
+        mode: 'cors',
+        targetAddressSpace: 'local',
+      });
+
+      if (!response.ok) {
+        throw new Error(`Brewer responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to the companion desktop brewing helper running on the user's loopback interface.
+     * Declares targetAddressSpace: 'loopback' for Mixed Content exemption and post-DNS verification.
+     * @param {string} daemonUrl
+     */
+    async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request, {
+        mode: 'cors',
+        targetAddressSpace: 'loopback',
+      });
+
+      if (!response.ok) {
+        throw new Error(`Desktop helper responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a real-time WebSocket stream to a local or loopback endpoint.
+     * Passes only subprotocol string(s) as the second argument (never a targetAddressSpace options object).
+     * @param {string} httpUrl
+     * @param {HTMLElement} statusEl
+     * @param {'local-network' | 'loopback-network'} permissionName
+     */
+    function openTelemetryWebSocket(httpUrl, statusEl, permissionName) {
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      try {
+        const parsed = new URL(httpUrl);
+        parsed.protocol = parsed.protocol === 'https:' ? 'wss:' : 'ws:';
+        parsed.pathname = '/stream';
+        const wsUrl = parsed.toString();
+
+        statusEl.dataset.statusType = 'info';
+        statusEl.textContent = `Opening WebSocket telemetry stream to ${wsUrl}...`;
+
+        const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+
+        socket.addEventListener('open', () => {
+          statusEl.dataset.statusType = 'success';
+          statusEl.textContent = `Connected to live telemetry stream at ${wsUrl}.`;
+          if (remediationBox) remediationBox.hidden = true;
+        });
+
+        socket.addEventListener('message', (event) => {
+          statusEl.dataset.statusType = 'success';
+          statusEl.textContent = `Live telemetry update: ${String(event.data)}`;
+        });
+
+        socket.addEventListener('error', () => {
+          statusEl.dataset.statusType = 'error';
+          statusEl.textContent = `WebSocket connection failed for ${wsUrl}. Check device power, network connection, and browser Site settings.`;
+          if (remediationBox) remediationBox.hidden = false;
+        });
+
+        return socket;
+      } catch (err) {
+        statusEl.dataset.statusType = 'error';
+        statusEl.textContent = `Invalid endpoint URL for WebSocket stream: ${err instanceof Error ? err.message : String(err)}`;
+        return null;
+      }
+    }
+
+    /**
+     * Attaches accessible form validation (validate on blur if edited, clear on input, route focus on submit).
+     * @param {HTMLInputElement} input
+     * @param {string} emptyMessage
+     * @param {string} typeMessage
+     */
+    function setupInputValidation(input, emptyMessage, typeMessage) {
+      let dirty = false;
+
+      const updateValidityMessage = () => {
+        input.setCustomValidity('');
+        if (input.validity.valueMissing) {
+          input.setCustomValidity(emptyMessage);
+        } else if (input.validity.typeMismatch) {
+          input.setCustomValidity(typeMessage);
+        }
+      };
+
+      input.addEventListener('input', () => {
+        dirty = true;
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+      });
+
+      input.addEventListener('blur', () => {
+        if (!dirty) return;
+        updateValidityMessage();
+        if (!input.checkValidity()) {
+          input.setAttribute('aria-invalid', 'true');
+        }
+      });
+
+      input.addEventListener('invalid', () => {
+        updateValidityMessage();
+        input.setAttribute('aria-invalid', 'true');
+      });
+    }
+
+    const lanForm = document.getElementById('lan-brewer-form');
+    const lanInput = document.getElementById('lan-brewer-url');
+    const lanStatus = document.getElementById('lan-brewer-status');
+    const lanConnectBtn = document.getElementById('lan-connect-btn');
+    const lanWsBtn = document.getElementById('lan-ws-btn');
+
+    const loopbackForm = document.getElementById('loopback-helper-form');
+    const loopbackInput = document.getElementById('loopback-helper-url');
+    const loopbackStatus = document.getElementById('loopback-helper-status');
+    const loopbackConnectBtn = document.getElementById('loopback-connect-btn');
+    const loopbackWsBtn = document.getElementById('loopback-ws-btn');
+
+    setupInputValidation(
+      lanInput,
+      'Please enter the shop Wi-Fi brewer endpoint URL.',
+      'Please enter a valid http:// or https:// LAN URL (such as http://192.168.1.100:8080/api/status).'
+    );
+
+    setupInputValidation(
+      loopbackInput,
+      'Please enter the companion Desktop Helper loopback URL.',
+      'Please enter a valid http:// or https:// loopback URL (such as http://127.0.0.1:45678/health).'
+    );
+
+    async function handleLanConnect() {
+      const remediationBox = document.querySelector('[data-remediation="local-network"]');
+      const url = lanInput.value.trim();
+      lanConnectBtn.disabled = true;
+      lanStatus.dataset.statusType = 'info';
+      lanStatus.textContent = `Connecting to shop Wi-Fi brewer at ${url} (targetAddressSpace: "local")...`;
+
+      try {
+        const data = await fetchLocalDeviceStatus(url);
+        lanStatus.dataset.statusType = 'success';
+        lanStatus.textContent = `Connected to Wi-Fi Brewer: ${JSON.stringify(data)}`;
+        if (remediationBox) remediationBox.hidden = true;
+      } catch (err) {
+        lanStatus.dataset.statusType = 'error';
+        lanStatus.textContent = `Unable to reach LAN brewer at ${url} (${err instanceof Error ? err.message : 'Network error'}). Ensure the brewer is online and Local network access is allowed.`;
+        if (remediationBox) remediationBox.hidden = false;
+      } finally {
+        lanConnectBtn.disabled = false;
+      }
+    }
+
+    async function handleLoopbackConnect() {
+      const remediationBox = document.querySelector('[data-remediation="loopback-network"]');
+      const url = loopbackInput.value.trim();
+      loopbackConnectBtn.disabled = true;
+      loopbackStatus.dataset.statusType = 'info';
+      loopbackStatus.textContent = `Connecting to companion Desktop Helper at ${url} (targetAddressSpace: "loopback")...`;
+
+      try {
+        const data = await fetchLoopbackDaemon(url);
+        loopbackStatus.dataset.statusType = 'success';
+        loopbackStatus.textContent = `Connected to Desktop Helper: ${JSON.stringify(data)}`;
+        if (remediationBox) remediationBox.hidden = true;
+      } catch (err) {
+        loopbackStatus.dataset.statusType = 'error';
+        loopbackStatus.textContent = `Unable to reach Desktop Helper at ${url} (${err instanceof Error ? err.message : 'Network error'}). Ensure the helper daemon is running on 127.0.0.1 and Loopback network access is allowed.`;
+        if (remediationBox) remediationBox.hidden = false;
+      } finally {
+        loopbackConnectBtn.disabled = false;
+      }
+    }
+
+    lanForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!lanForm.checkValidity()) {
+        lanInput.focus();
+        lanInput.reportValidity();
+        return;
+      }
+      await handleLanConnect();
+    });
+
+    loopbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!loopbackForm.checkValidity()) {
+        loopbackInput.focus();
+        loopbackInput.reportValidity();
+        return;
+      }
+      await handleLoopbackConnect();
+    });
+
+    lanWsBtn.addEventListener('click', () => {
+      if (!lanForm.checkValidity()) {
+        lanInput.focus();
+        lanInput.reportValidity();
+        return;
+      }
+      openTelemetryWebSocket(lanInput.value.trim(), lanStatus, 'local-network');
+    });
+
+    loopbackWsBtn.addEventListener('click', () => {
+      if (!loopbackForm.checkValidity()) {
+        loopbackInput.focus();
+        loopbackInput.reportValidity();
+        return;
+      }
+      openTelemetryWebSocket(loopbackInput.value.trim(), loopbackStatus, 'loopback-network');
+    });
+
+    // Pre-check granular LNA permissions on load without firing network requests when state is 'prompt'.
+    // Only auto-connect if permission was already granted by the user.
+    async function initEquipmentConnections() {
+      const localState = await checkNetworkPermission('local-network', handleLanConnect);
+      if (localState === 'granted') {
+        handleLanConnect();
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network', handleLoopbackConnect);
+      if (loopbackState === 'granted') {
+        handleLoopbackConnect();
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
