+        const timeoutId = setTimeout(() => controller.abort(), 3500);
+
+        const fetchOptions = {
+          method,
+          mode: 'cors',
+          targetAddressSpace,
+          signal: controller.signal,
+          headers: payload ? { 'Content-Type': 'application/json' } : undefined,
+          body: payload ? JSON.stringify(payload) : undefined
+        };
+
+        setBadgeState(statusBadgeEl, 'prompt', 'Connecting');
+        appendLog(
+          targetAddressSpace,
+          method + ' ' + url + ' with { mode: "cors", targetAddressSpace: "' + targetAddressSpace + '" }'
+        );
+
+        try {
+          const response = await fetch(url, fetchOptions);
+          clearTimeout(timeoutId);
+
+          if (!response.ok) {
+            throw new Error('HTTP ' + response.status + ' ' + response.statusText);
+          }
+
+          const data = await response.json();
+          setBadgeState(statusBadgeEl, 'granted', 'Connected');
+          appendLog(
+            targetAddressSpace,
+            'Received response from ' + url + ': ' + JSON.stringify(data),
+            'success'
+          );
+          return { ok: true, simulated: false, data };
+        } catch (err) {
+          clearTimeout(timeoutId);
+          const permState = permissionStates[targetAddressSpace];
+
+          if (permState === 'denied') {
+            setBadgeState(statusBadgeEl, 'denied', 'Blocked');
+            appendLog(
+              targetAddressSpace,
+              'Request blocked because Local Network Access permission is denied (' + err.message + ').',
+              'error'
+            );
+            return { ok: false, simulated: false, error: err };
+          }
+
+          if (simulateFallbackToggle && simulateFallbackToggle.checked) {
+            setBadgeState(statusBadgeEl, 'granted', 'Simulated Ready');
+            appendLog(
+              targetAddressSpace,
+              'Direct fetch to ' + url + ' did not reach live hardware (' + err.name + ': ' + err.message + '). Showing simulated device telemetry.',
+              'info'
+            );
+            return { ok: true, simulated: true, data: null };
+          }
+
+          setBadgeState(statusBadgeEl, 'denied', 'Unreachable');
+          appendLog(
+            targetAddressSpace,
+            'Failed to connect to ' + url + ' (' + err.name + ': ' + err.message + '). Verify device is online and CORS/LNA headers are enabled.',
+            'error'
+          );
+          return { ok: false, simulated: false, error: err };
+        }
+      }
+
+      // LAN Wi-Fi Coffee Brewer handlers (targetAddressSpace: "local")
+      const brewerEndpointInput = document.getElementById('brewer-endpoint');
+      const brewerProfileSelect = document.getElementById('brewer-profile');
+      const brewerVolumeSelect = document.getElementById('brewer-volume');
+      const brewerStatusBtn = document.getElementById('brewer-status-btn');
+      const brewerStartBtn = document.getElementById('brewer-start-btn');
+      const brewerConnState = document.getElementById('brewer-conn-state');
+      const brewerTemp = document.getElementById('brewer-temp');
+      const brewerWater = document.getElementById('brewer-water');
+      const brewerActiveProfile = document.getElementById('brewer-active-profile');
+      const brewerSpaceVerified = document.getElementById('brewer-space-verified');
+
+      function updateBrewerTelemetry(data) {
+        brewerTemp.textContent = (data.boilerTemp || '93.4') + ' °C';
+        brewerWater.textContent = (data.waterLevel || '86') + ' %';
+        brewerActiveProfile.textContent = data.activeProfile || 'Ready (Standby)';
+        brewerSpaceVerified.textContent = data.addressSpace || 'local (LAN Verified)';
+      }
+
+      brewerStatusBtn.addEventListener('click', async function () {
+        const endpoint = brewerEndpointInput.value.trim() || 'http://192.168.1.50:8080/api/brewer';
+        brewerStatusBtn.disabled = true;
+        const result = await performEquipmentRequest({
+          url: endpoint,
+          method: 'GET',
+          targetAddressSpace: 'local',
+          statusBadgeEl: brewerConnState
+        });
+        brewerStatusBtn.disabled = false;
+
+        if (result.ok) {
+          updateBrewerTelemetry(
+            result.data || {
+              boilerTemp: '93.2',
+              waterLevel: '88',
+              activeProfile: 'Idle — Boiler Ready',
+              addressSpace: 'local (192.168.1.x)'
+            }
+          );
+        }
+      });
+
+      brewerStartBtn.addEventListener('click', async function () {
+        const endpoint = brewerEndpointInput.value.trim() || 'http://192.168.1.50:8080/api/brewer';
+        const profile = brewerProfileSelect.value;
+        const profileText = brewerProfileSelect.options[brewerProfileSelect.selectedIndex].text;
+        const volumeMl = Number(brewerVolumeSelect.value);
+
+        brewerStartBtn.disabled = true;
+        const result = await performEquipmentRequest({
+          url: endpoint,
+          method: 'POST',
+          payload: {
+            command: 'START_BREW',
+            profile,
+            volumeMl,
+            requestedAt: new Date().toISOString()
+          },
+          targetAddressSpace: 'local',
+          statusBadgeEl: brewerConnState
+        });
+        brewerStartBtn.disabled = false;
+
+        if (result.ok) {
+          updateBrewerTelemetry(
+            result.data || {
+              boilerTemp: profile === 'batch-gold-cup' ? '94.0' : profile === 'espresso-preinfuse' ? '92.0' : '93.0',
+              waterLevel: '74',
+              activeProfile: 'Brewing: ' + profileText + ' (' + volumeMl + ' ml)',
+              addressSpace: 'local (192.168.1.x)'
+            }
+          );
+        }
+      });
+
+      // Companion Desktop Brewing Helper handlers (targetAddressSpace: "loopback")
+      const helperEndpointInput = document.getElementById('helper-endpoint');
+      const helperGrindSelect = document.getElementById('helper-grind-size');
+      const helperDoseInput = document.getElementById('helper-dose');
+      const helperConnectBtn = document.getElementById('helper-connect-btn');
+      const helperSyncBtn = document.getElementById('helper-sync-btn');
+      const helperConnState = document.getElementById('helper-conn-state');
+      const helperWeight = document.getElementById('helper-weight');
+      const helperGrind = document.getElementById('helper-grind');
+      const helperFlow = document.getElementById('helper-flow');
+      const helperSpaceVerified = document.getElementById('helper-space-verified');
+
+      function updateHelperTelemetry(data) {
+        helperWeight.textContent = (data.scaleWeight !== undefined ? data.scaleWeight : '0.0') + ' g';
+        helperGrind.textContent = data.grindSetting || '5.0 (Calibrated)';
+        helperFlow.textContent = (data.flowRate || '0.0') + ' g/s';
+        helperSpaceVerified.textContent = data.addressSpace || 'loopback (127.0.0.1)';
+      }
+
+      helperConnectBtn.addEventListener('click', async function () {
+        const endpoint = helperEndpointInput.value.trim() || 'http://127.0.0.1:4242/api/helper';
+        helperConnectBtn.disabled = true;
+        const result = await performEquipmentRequest({
+          url: endpoint,
+          method: 'GET',
+          targetAddressSpace: 'loopback',
+          statusBadgeEl: helperConnState
+        });
+        helperConnectBtn.disabled = false;
+
+        if (result.ok) {
+          updateHelperTelemetry(
+            result.data || {
+              scaleWeight: '0.0',
+              grindSetting: helperGrindSelect.value + ' (Ready)',
+              flowRate: '0.0',
+              addressSpace: 'loopback (127.0.0.1)'
+            }
+          );
+        }
+      });
+
+      helperSyncBtn.addEventListener('click', async function () {
+        const endpoint = helperEndpointInput.value.trim() || 'http://127.0.0.1:4242/api/helper';
+        const grindSize = helperGrindSelect.value;
+        const targetDoseG = Number(helperDoseInput.value) || 22.5;
+
+        helperSyncBtn.disabled = true;
+        const result = await performEquipmentRequest({
+          url: endpoint,
+          method: 'POST',
+          payload: {
+            command: 'TARE_AND_SYNC_RECIPE',
+            grindSize,
+            targetDoseG,
+            syncedAt: new Date().toISOString()
+          },
+          targetAddressSpace: 'loopback',
+          statusBadgeEl: helperConnState
+        });
+        helperSyncBtn.disabled = false;
+
+        if (result.ok) {
+          updateHelperTelemetry(
+            result.data || {
+              scaleWeight: targetDoseG.toFixed(1),
+              grindSetting: 'Set to ' + grindSize + ' stepped burr',
+              flowRate: '4.2',
+              addressSpace: 'loopback (127.0.0.1)'
+            }
+          );
+        }
+      });
+
+      document.getElementById('refresh-permissions-btn').addEventListener('click', function () {
+        checkAllPermissions();
+      });
+
+      document.getElementById('clear-log-btn').addEventListener('click', function () {
+        logContainer.innerHTML = '';
+        appendLog('system', 'Log cleared.');
+      });
+
+      // Initialize permissions check on page load
+      checkAllPermissions();
+    })();
+  </script>
+
 </body>
 
