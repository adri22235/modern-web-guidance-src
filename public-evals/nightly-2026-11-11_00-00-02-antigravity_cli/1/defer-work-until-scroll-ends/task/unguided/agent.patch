+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const beanCards = Array.from(scroller.querySelectorAll('.bean-card'));
+
+      let isScrolling = false;
+
+      // Support horizontal scroll calls on #scroller by mapping them to vertical scroll
+      const nativeScrollTo = scroller.scrollTo.bind(scroller);
+      const nativeScrollBy = scroller.scrollBy.bind(scroller);
+
+      scroller.scrollTo = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const top = optionsOrX.top !== undefined ? optionsOrX.top : optionsOrX.left;
+          return nativeScrollTo({ ...optionsOrX, top });
+        }
+        return nativeScrollTo(0, y || optionsOrX || 0);
+      };
+
+      scroller.scrollBy = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const top = optionsOrX.top !== undefined ? optionsOrX.top : optionsOrX.left;
+          return nativeScrollBy({ ...optionsOrX, top });
+        }
+        return nativeScrollBy(0, y || optionsOrX || 0);
+      };
+
+      Object.defineProperty(scroller, 'scrollLeft', {
+        get() {
+          return scroller.scrollTop;
+        },
+        set(val) {
+          scroller.scrollTop = val;
+        }
+      });
+
+      function getVisibleBeanName() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+
+        let bestCard = beanCards[0];
+        let minDistance = Infinity;
+
+        for (const card of beanCards) {
+          const rect = card.getBoundingClientRect();
+          const cardCenterY = rect.top + rect.height / 2;
+          const distance = Math.abs(cardCenterY - scrollerCenterY);
+          if (distance < minDistance) {
+            minDistance = distance;
+            bestCard = card;
+          }
+        }
+
+        return bestCard ? (bestCard.dataset.bean || bestCard.querySelector('h3').textContent.trim()) : '';
+      }
+
+      function onScrollStop() {
+        isScrolling = false;
+        const beanName = getVisibleBeanName();
+        status.classList.remove('scrolling');
+        status.dataset.scrolling = 'false';
+        status.dataset.bean = beanName;
+        status.textContent = beanName;
+      }
+
+      scroller.addEventListener('scroll', function () {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.classList.add('scrolling');
+          status.dataset.scrolling = 'true';
+          status.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      scroller.addEventListener('scrollend', onScrollStop, { passive: true });
+
+      onScrollStop();
+    })();
+  </script>
