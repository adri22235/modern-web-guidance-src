+  <script>
+    function findMostVisibleBean(scroller) {
+      const items = scroller.querySelectorAll('.bean-item');
+      const scrollerRect = scroller.getBoundingClientRect();
+      const scrollerCenter = scrollerRect.top + scrollerRect.height / 2;
+
+      let closestItem = items[0];
+      let minDistance = Infinity;
+
+      items.forEach((item) => {
+        const rect = item.getBoundingClientRect();
+        const itemCenter = rect.top + rect.height / 2;
+        const distance = Math.abs(scrollerCenter - itemCenter);
+        if (distance < minDistance) {
+          minDistance = distance;
+          closestItem = item;
+        }
+      });
+
+      return closestItem;
+    }
+
+    function updateVisibleBean(scroller, statusEl, targetBean) {
+      const visibleBean = targetBean || findMostVisibleBean(scroller);
+      if (!visibleBean) return;
+      const beanName = visibleBean.dataset.bean || visibleBean.querySelector('h3')?.textContent || 'Coffee Bean';
+      statusEl.classList.remove('is-scrolling');
+      statusEl.textContent = `Showing: ${beanName}`;
+    }
+
+    function initializeBeanScroller() {
+      const scroller = document.querySelector('#scroller');
+      const statusEl = document.querySelector('#status');
+      if (!scroller || !statusEl) return;
+
+      let isScrolling = false;
+
+      // 1. Informative feedback during scroll without layout recalculations
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.classList.add('is-scrolling');
+          statusEl.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      // 2. Safe callback when scrolling rests
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        updateVisibleBean(scroller, statusEl);
+      });
+
+      // Also support native scrollsnapchange when available
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        scroller.addEventListener('scrollsnapchange', (event) => {
+          const snappedBean = event.snapTargetBlock || event.snapTargetInline;
+          if (snappedBean) {
+            isScrolling = false;
+            updateVisibleBean(scroller, statusEl, snappedBean);
+          }
+        });
+      }
+
+      updateVisibleBean(scroller, statusEl);
+    }
+
+    if ('onscrollend' in window) {
+      initializeBeanScroller();
+    } else {
+      initializeBeanScroller();
+      const scroller = document.querySelector('#scroller');
+      if (scroller) {
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(window.scrollendtimer);
+          window.scrollendtimer = setTimeout(() => {
+            scroller.dispatchEvent(new CustomEvent('scrollend'));
+          }, 100);
+        }, { passive: true });
+      }
+    }
+  </script>
