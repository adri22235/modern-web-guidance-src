+  <script>
+    (function () {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel ? panel.querySelector('[data-drag-handle]') : null;
+
+      if (panel && handle) {
+        let isDragging = false;
+        let startX = 0;
+        let startY = 0;
+        let startLeft = 0;
+        let startTop = 0;
+
+        function getClientCoords(e) {
+          if (e.touches && e.touches.length > 0) {
+            return { x: e.touches[0].clientX, y: e.touches[0].clientY };
+          }
+          if (e.changedTouches && e.changedTouches.length > 0) {
+            return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
+          }
+          const x = typeof e.clientX === 'number' ? e.clientX : e.pageX;
+          const y = typeof e.clientY === 'number' ? e.clientY : e.pageY;
+          return { x, y };
+        }
+
+        function onDragStart(e) {
+          if (typeof e.button === 'number' && e.button !== 0) return;
+          const coords = getClientCoords(e);
+          if (typeof coords.x !== 'number' || typeof coords.y !== 'number') return;
+
+          if (!isDragging) {
+            const rect = panel.getBoundingClientRect();
+            startLeft = rect.left;
+            startTop = rect.top;
+            startX = coords.x;
+            startY = coords.y;
+            isDragging = true;
+
+            panel.style.left = startLeft + 'px';
+            panel.style.top = startTop + 'px';
+            panel.style.right = 'auto';
+            panel.style.bottom = 'auto';
+            panel.style.margin = '0';
+            panel.classList.add('is-dragging');
+          }
+
+          if (e.cancelable && e.type !== 'touchstart') {
+            e.preventDefault();
+          }
+        }
+
+        function onDragMove(e) {
+          if (!isDragging) return;
+          const coords = getClientCoords(e);
+          if (typeof coords.x !== 'number' || typeof coords.y !== 'number') return;
+
+          const dx = coords.x - startX;
+          const dy = coords.y - startY;
+
+          const newLeft = startLeft + dx;
+          const newTop = startTop + dy;
+
+          panel.style.left = newLeft + 'px';
+          panel.style.top = newTop + 'px';
+        }
+
+        function onDragEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          panel.classList.remove('is-dragging');
+        }
+
+        handle.addEventListener('mousedown', onDragStart);
+        handle.addEventListener('pointerdown', onDragStart);
+        handle.addEventListener('touchstart', onDragStart, { passive: true });
+
+        [document, window].forEach((target) => {
+          target.addEventListener('mousemove', onDragMove);
+          target.addEventListener('pointermove', onDragMove);
+          target.addEventListener('touchmove', onDragMove, { passive: true });
+
+          target.addEventListener('mouseup', onDragEnd);
+          target.addEventListener('pointerup', onDragEnd);
+          target.addEventListener('pointercancel', onDragEnd);
+          target.addEventListener('touchend', onDragEnd);
+        });
+      }
+
+      // Interactive Quick-Order Cart Logic
+      const cartItems = [
+        { id: 'item-1', name: 'Maple Oat Latte', size: 'Medium', milk: 'Oat Milk', unitPrice: 6.00, qty: 1 },
+        { id: 'item-2', name: 'Cold Brew', size: 'Small', milk: 'No Milk', unitPrice: 4.75, qty: 1 }
+      ];
+
+      const listEl = document.getElementById('cart-items-list');
+      const badgeEl = document.getElementById('cart-count-badge');
+      const subtotalEl = document.getElementById('cart-subtotal');
+      const totalEl = document.getElementById('cart-total');
+      const statusEl = document.getElementById('order-status-msg');
+      const drinkSelect = document.getElementById('quick-drink-select');
+      const sizeSelect = document.getElementById('quick-size-select');
+      const milkSelect = document.getElementById('quick-milk-select');
+      const addBtn = document.getElementById('quick-add-btn');
+      const clearBtn = document.getElementById('clear-cart-btn');
+      const checkoutBtn = document.getElementById('checkout-btn');
+
+      function renderCart() {
+        listEl.innerHTML = '';
+        let totalQty = 0;
+        let subtotal = 0;
+
+        if (cartItems.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-item';
+          emptyLi.textContent = 'Your coffee cart is empty.';
+          listEl.appendChild(emptyLi);
+        } else {
+          cartItems.forEach((item) => {
+            totalQty += item.qty;
+            subtotal += item.unitPrice * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+            li.setAttribute('data-cart-item', item.id);
+
+            const info = document.createElement('div');
+            info.className = 'cart-item-info';
+
+            const nameSpan = document.createElement('span');
+            nameSpan.className = 'cart-item-name';
+            nameSpan.textContent = item.name;
+
+            const metaSpan = document.createElement('span');
+            metaSpan.className = 'cart-item-meta';
+            metaSpan.textContent = `${item.size} • ${item.milk} • $${(item.unitPrice * item.qty).toFixed(2)}`;
+
+            info.appendChild(nameSpan);
+            info.appendChild(metaSpan);
+
+            const actions = document.createElement('div');
+            actions.className = 'cart-item-actions';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-btn';
+            decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+            decBtn.setAttribute('data-action', 'decrease');
+            decBtn.textContent = '−';
+            decBtn.addEventListener('click', () => {
+              item.qty -= 1;
+              if (item.qty <= 0) {
+                const idx = cartItems.indexOf(item);
+                if (idx !== -1) cartItems.splice(idx, 1);
+              }
+              statusEl.textContent = '';
+              renderCart();
+            });
+
+            const qtySpan = document.createElement('span');
+            qtySpan.className = 'item-qty';
+            qtySpan.setAttribute('data-item-qty', '');
+            qtySpan.textContent = String(item.qty);
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-btn';
+            incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+            incBtn.setAttribute('data-action', 'increase');
+            incBtn.textContent = '+';
+            incBtn.addEventListener('click', () => {
+              item.qty += 1;
+              statusEl.textContent = '';
+              renderCart();
+            });
+
+            actions.appendChild(decBtn);
+            actions.appendChild(qtySpan);
+            actions.appendChild(incBtn);
+
+            li.appendChild(info);
+            li.appendChild(actions);
+            listEl.appendChild(li);
+          });
+        }
+
+        badgeEl.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'}`;
+        subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
+        totalEl.textContent = `$${subtotal.toFixed(2)}`;
+      }
+
+      addBtn.addEventListener('click', () => {
+        const drinkOption = drinkSelect.options[drinkSelect.selectedIndex];
+        const sizeOption = sizeSelect.options[sizeSelect.selectedIndex];
+        const name = drinkOption.value;
+        const basePrice = parseFloat(drinkOption.getAttribute('data-price') || '4.50');
+        const size = sizeOption.value;
+        const upcharge = parseFloat(sizeOption.getAttribute('data-upcharge') || '0');
+        const milk = milkSelect.value;
+        const unitPrice = basePrice + upcharge;
+
+        const existing = cartItems.find(
+          (i) => i.name === name && i.size === size && i.milk === milk
+        );
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cartItems.push({
+            id: 'item-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
+            name,
+            size,
+            milk,
+            unitPrice,
+            qty: 1
+          });
+        }
+        statusEl.textContent = `Added ${size} ${name}!`;
+        renderCart();
+      });
+
+      clearBtn.addEventListener('click', () => {
+        cartItems.length = 0;
+        statusEl.textContent = 'Cart cleared.';
+        renderCart();
+      });
+
+      checkoutBtn.addEventListener('click', () => {
+        if (cartItems.length === 0) {
+          statusEl.textContent = 'Add a drink before placing your order.';
+          return;
+        }
+        const total = totalEl.textContent;
+        statusEl.textContent = `Order placed (${total})! Ready in ~5 mins.`;
+      });
+
+      renderCart();
+    })();
+  </script>
 </body>
 
