+  <script>
+    (() => {
+      const draggable = document.querySelector('[data-draggable]');
+      const handle = draggable?.querySelector('[data-drag-handle]');
+      const gripBtn = document.getElementById('cart-drag-grip');
+      const liveRegion = document.getElementById('drag-live-region');
+
+      if (!draggable || !handle) return;
+
+      // Progressive enhancement: reveal grip button and enable drag affordances when JS initializes
+      handle.classList.add('js-drag-ready');
+      if (gripBtn) {
+        gripBtn.hidden = false;
+        gripBtn.classList.add('js-drag-ready');
+      }
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let hasPositioned = false;
+      let liveRegionTimer = null;
+
+      function announceMove(description) {
+        if (!liveRegion) return;
+        clearTimeout(liveRegionTimer);
+        liveRegion.textContent = description
+          ? `Quick Order Coffee Cart ${description}`
+          : 'Quick Order Coffee Cart moved';
+        liveRegionTimer = setTimeout(() => {
+          liveRegion.textContent = '';
+        }, 1200);
+      }
+
+      function ensureExplicitPosition() {
+        if (!hasPositioned) {
+          const rect = draggable.getBoundingClientRect();
+          draggable.style.margin = '0';
+          draggable.style.right = 'auto';
+          draggable.style.bottom = 'auto';
+          draggable.style.left = `${rect.left}px`;
+          draggable.style.top = `${rect.top}px`;
+          hasPositioned = true;
+        }
+      }
+
+      function moveTo(left, top) {
+        ensureExplicitPosition();
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        const clampedLeft = Math.max(0, Math.min(left, maxLeft));
+        const clampedTop = Math.max(0, Math.min(top, maxTop));
+
+        draggable.style.left = `${clampedLeft}px`;
+        draggable.style.top = `${clampedTop}px`;
+        return { left: clampedLeft, top: clampedTop, maxLeft, maxTop };
+      }
+
+      function describePosition(left, top, maxLeft, maxTop) {
+        const parts = [];
+        if (top <= 16) parts.push('docked top');
+        else if (top >= maxTop - 16) parts.push('docked bottom');
+
+        if (left <= 16) parts.push('docked left');
+        else if (left >= maxLeft - 16) parts.push('docked right');
+
+        return parts.length > 0 ? parts.join(' and ') : 'moved';
+      }
+
+      // Pointer dragging via setPointerCapture on the header handle
+      handle.addEventListener('pointerdown', (event) => {
+        const control = event.target.closest('button, input, select, textarea, a');
+        if (event.button !== 0 || (control && control !== handle && control !== gripBtn)) return;
+
+        ensureExplicitPosition();
+        const rect = draggable.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        const dist = Math.hypot(event.clientX - startX, event.clientY - startY);
+        if (dist >= 4 || handle.classList.contains('dragging')) {
+          handle.classList.add('dragging');
+          if (gripBtn) gripBtn.classList.add('dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      function finishPointerDrag() {
+        const wasDragging = handle.classList.contains('dragging');
+        handle.classList.remove('dragging');
+        if (gripBtn) gripBtn.classList.remove('dragging');
+        if (wasDragging) {
+          const rect = draggable.getBoundingClientRect();
+          const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+          const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+          announceMove(describePosition(rect.left, rect.top, maxLeft, maxTop));
+        }
+      }
+
+      handle.addEventListener('lostpointercapture', finishPointerDrag);
+
+      // Keyboard movement on handle (or dedicated grip button inside handle)
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle && event.target !== gripBtn) return;
+
+        const step = event.shiftKey ? 45 : 15;
+        const rect = draggable.getBoundingClientRect();
+        let nextLeft = rect.left;
+        let nextTop = rect.top;
+        let directionLabel = '';
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            nextLeft -= step;
+            directionLabel = 'moved left';
+            break;
+          case 'ArrowRight':
+            nextLeft += step;
+            directionLabel = 'moved right';
+            break;
+          case 'ArrowUp':
+            nextTop -= step;
+            directionLabel = 'moved up';
+            break;
+          case 'ArrowDown':
+            nextTop += step;
+            directionLabel = 'moved down';
+            break;
+          default:
+            return;
+        }
+
+        event.preventDefault();
+        moveTo(nextLeft, nextTop);
+        announceMove(directionLabel);
+      });
+
+      // Re-clamp on viewport or element-size changes
+      function reclampCurrentPosition() {
+        if (!hasPositioned) return;
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      window.addEventListener('resize', reclampCurrentPosition);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(reclampCurrentPosition).observe(draggable);
+      }
+
+      // Single-pointer / click-to-reposition controls (accessible alternative to dragging)
+      const repositionToggle = document.getElementById('cart-reposition-toggle');
+      const repositionPanel = document.getElementById('cart-reposition-panel');
+      const helpToggle = document.getElementById('cart-help-toggle');
+      const helpPanel = document.getElementById('cart-help-panel');
+      const minimizeToggle = document.getElementById('cart-minimize-toggle');
+
+      repositionToggle?.addEventListener('click', () => {
+        const isHidden = repositionPanel.hidden;
+        repositionPanel.hidden = !isHidden;
+        repositionToggle.setAttribute('aria-expanded', String(isHidden));
+      });
+
+      helpToggle?.addEventListener('click', () => {
+        const isHidden = helpPanel.hidden;
+        helpPanel.hidden = !isHidden;
+        helpToggle.setAttribute('aria-expanded', String(isHidden));
+      });
+
+      minimizeToggle?.addEventListener('click', () => {
+        const minimized = draggable.classList.toggle('is-minimized');
+        minimizeToggle.setAttribute('aria-expanded', String(!minimized));
+        minimizeToggle.setAttribute(
+          'aria-label',
+          minimized ? 'Expand quick order cart' : 'Minimize quick order cart'
+        );
+        minimizeToggle.innerHTML = minimized ? '+' : '&ndash;';
+      });
+
+      document.querySelectorAll('[data-move-action]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const action = btn.getAttribute('data-move-action');
+          const rect = draggable.getBoundingClientRect();
+          const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+          const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+          const step = 40;
+          const margin = 16;
+
+          switch (action) {
+            case 'move-up':
+              moveTo(rect.left, rect.top - step);
+              announceMove('moved up');
+              break;
+            case 'move-down':
+              moveTo(rect.left, rect.top + step);
+              announceMove('moved down');
+              break;
+            case 'move-left':
+              moveTo(rect.left - step, rect.top);
+              announceMove('moved left');
+              break;
+            case 'move-right':
+              moveTo(rect.left + step, rect.top);
+              announceMove('moved right');
+              break;
+            case 'dock-top':
+              moveTo(rect.left, margin);
+              announceMove('docked top');
+              break;
+            case 'dock-bottom':
+              moveTo(rect.left, Math.max(0, maxTop - margin));
+              announceMove('docked bottom');
+              break;
+            case 'dock-left':
+              moveTo(margin, rect.top);
+              announceMove('docked left');
+              break;
+            case 'dock-right':
+              moveTo(Math.max(0, maxLeft - margin), rect.top);
+              announceMove('docked right');
+              break;
+          }
+        });
+      });
+
+      // Interactive Quick-Order Cart Logic
+      const sizeSelect = document.getElementById('cart-size-select');
+      const milkSelect = document.getElementById('cart-milk-select');
+      const countBadge = document.getElementById('cart-item-count');
+      const totalPriceEl = document.getElementById('cart-total-price');
+      const checkoutBtn = document.getElementById('cart-checkout-btn');
+      const clearBtn = document.getElementById('cart-clear-btn');
+      const statusMsg = document.getElementById('cart-status-msg');
+      const itemRows = Array.from(draggable.querySelectorAll('.cart-item'));
+
+      function updateCartSummary() {
+        const sizeSurcharge = parseFloat(sizeSelect?.value || '0');
+        let totalQty = 0;
+        let totalCost = 0;
+
+        itemRows.forEach((row) => {
+          const basePrice = parseFloat(row.getAttribute('data-base-price') || '0');
+          const qtyEl = row.querySelector('[data-qty-value]');
+          const qty = parseInt(qtyEl?.textContent || '0', 10);
+          totalQty += qty;
+          totalCost += qty * (basePrice + sizeSurcharge);
+        });
+
+        if (countBadge) countBadge.textContent = String(totalQty);
+        if (totalPriceEl) totalPriceEl.textContent = `$${totalCost.toFixed(2)}`;
+        if (checkoutBtn) checkoutBtn.disabled = totalQty === 0;
+      }
+
+      itemRows.forEach((row) => {
+        row.querySelectorAll('[data-qty-change]').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const delta = parseInt(btn.getAttribute('data-qty-change') || '0', 10);
+            const qtyEl = row.querySelector('[data-qty-value]');
+            if (!qtyEl) return;
+            const current = parseInt(qtyEl.textContent || '0', 10);
+            const next = Math.max(0, current + delta);
+            qtyEl.textContent = String(next);
+            if (statusMsg) statusMsg.hidden = true;
+            updateCartSummary();
+          });
+        });
+      });
+
+      document.querySelectorAll('.quick-add-card-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const itemId = btn.getAttribute('data-item-id');
+          const targetRow = draggable.querySelector(`.cart-item[data-item="${itemId}"]`);
+          const qtyEl = targetRow?.querySelector('[data-qty-value]');
+          if (qtyEl) {
+            qtyEl.textContent = String(parseInt(qtyEl.textContent || '0', 10) + 1);
+            draggable.classList.remove('is-minimized');
+            minimizeToggle?.setAttribute('aria-expanded', 'true');
+            if (minimizeToggle) minimizeToggle.innerHTML = '&ndash;';
+            if (statusMsg) statusMsg.hidden = true;
+            updateCartSummary();
+          }
+        });
+      });
+
+      sizeSelect?.addEventListener('change', updateCartSummary);
+      milkSelect?.addEventListener('change', () => {
+        if (statusMsg) statusMsg.hidden = true;
+      });
+
+      clearBtn?.addEventListener('click', () => {
+        itemRows.forEach((row) => {
+          const qtyEl = row.querySelector('[data-qty-value]');
+          if (qtyEl) qtyEl.textContent = '0';
+        });
+        if (statusMsg) statusMsg.hidden = true;
+        updateCartSummary();
+      });
+
+      checkoutBtn?.addEventListener('click', () => {
+        const count = parseInt(countBadge?.textContent || '0', 10);
+        if (count === 0 || !statusMsg) return;
+        const sizeLabel = sizeSelect?.options[sizeSelect.selectedIndex]?.text.split(' ')[0] || 'Medium';
+        const milkLabel = milkSelect?.value || 'Oat Milk';
+        statusMsg.textContent = `Order queued: ${count} ${sizeLabel} drink(s) with ${milkLabel}!`;
+        statusMsg.hidden = false;
+      });
+
+      updateCartSummary();
+    })();
+  </script>
 </body>
 
 </html>
