+  <script>
+    (function () {
+      const modal = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const closeBtn = document.getElementById('close-modal-btn');
+      const form = document.getElementById('feedback-form');
+      const statusMsg = document.getElementById('feedback-status');
+      const sectionIndicator = document.getElementById('modal-section-indicator');
+      const sections = Array.from(document.querySelectorAll('.page-section'));
+
+      function updateIndicator() {
+        const parentSection = modal.closest('.page-section') || modal.parentElement;
+        if (parentSection && sectionIndicator) {
+          const name = parentSection.getAttribute('data-section-name') || parentSection.id || parentSection.tagName.toLowerCase();
+          sectionIndicator.textContent = 'Section: ' + name;
+          sectionIndicator.setAttribute('data-current-section', parentSection.id || name);
+        }
+      }
+
+      function ensureOpenAndModal() {
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            try {
+              modal.showModal();
+            } catch (err) {
+              modal.setAttribute('open', '');
+            }
+          } else if (typeof modal.matches === 'function' && !modal.matches(':modal')) {
+            try {
+              modal.close();
+              modal.showModal();
+            } catch (err) {
+              modal.setAttribute('open', '');
+            }
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+        modal.classList.add('open', 'active');
+        updateIndicator();
+      }
+
+      function moveModalBetweenSections() {
+        if (sections.length < 2) return;
+
+        const currentSection = modal.closest('.page-section') || modal.parentElement;
+        const currentIndex = sections.indexOf(currentSection);
+        const nextIndex = (currentIndex + 1) % sections.length;
+        const targetSection = sections[nextIndex];
+
+        const activeEl = document.activeElement;
+        const selStart = activeEl && typeof activeEl.selectionStart === 'number' ? activeEl.selectionStart : null;
+        const selEnd = activeEl && typeof activeEl.selectionEnd === 'number' ? activeEl.selectionEnd : null;
+
+        if (typeof targetSection.moveBefore === 'function') {
+          try {
+            targetSection.moveBefore(modal, null);
+          } catch (err) {
+            targetSection.appendChild(modal);
+          }
+        } else {
+          targetSection.appendChild(modal);
+        }
+
+        ensureOpenAndModal();
+
+        if (activeEl && modal.contains(activeEl) && document.activeElement !== activeEl) {
+          activeEl.focus();
+          if (selStart !== null && selEnd !== null && typeof activeEl.setSelectionRange === 'function') {
+            try {
+              activeEl.setSelectionRange(selStart, selEnd);
+            } catch (err) {}
+          }
+        }
+      }
+
+      moveBtn.addEventListener('click', moveModalBetweenSections);
+
+      openBtn.addEventListener('click', function () {
+        ensureOpenAndModal();
+      });
+
+      closeBtn.addEventListener('click', function () {
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+        modal.classList.remove('open', 'active');
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        statusMsg.classList.add('visible');
+      });
+
+      // Open the feedback modal on initial page load so it is immediately active
+      ensureOpenAndModal();
+    })();
+  </script>
+
