       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* Enable smooth transitions to and from intrinsic keyword sizes (like height: auto) globally */
+      interpolate-size: allow-keywords;
     }
 
+    /* Note: Directly transitioning or interpolating between two different intrinsic sizing keywords
+       (e.g., from min-content to max-content) is not supported. One end of the transition must be a
+       fixed length or percentage (such as 0 to auto), and calc-size() only allows a single intrinsic
+       size basis per calculation without mixing intrinsic keywords. */
+
+    .promo-badge {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 0.8rem;
+      padding-block: 0.25rem;
+      padding-inline: 0.5rem;
+      border-radius: 4px;
+      margin-block-end: 0.5rem;
+      /* Fallback for browsers that do not support calc-size() */
+      inline-size: max-content;
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    .faq-section {
+      margin-block-start: 2.5rem;
+      background: white;
+      padding-block: 1.5rem;
+      padding-inline: 1.5rem;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .faq-section h2 {
+      color: var(--primary);
+      margin-block-end: 1rem;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding-block: 0.75rem;
+      padding-inline: 1rem;
+      font-size: 1rem;
+      font-weight: bold;
+      border-radius: 5px;
+      cursor: pointer;
+      text-align: start;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover:not(:disabled) {
+      background: #3e2723;
+    }
+
+    .accordion-content {
+      display: block;
+      overflow: hidden;
+      /* Fallback value for closed state */
+      block-size: 0;
+      opacity: 0;
+      visibility: hidden;
+      transition: block-size 0.3s ease-out, opacity 0.3s ease-out, visibility 0.3s;
+    }
+
+    .accordion-content:is(.open, .is-expanded, [aria-hidden="false"]) {
+      /* Fallback value for open state */
+      block-size: auto;
+      /* Animate from 0 to natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      opacity: 1;
+      visibility: visible;
+      padding-block-start: 1rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        transition: opacity 0.3s ease, visibility 0.3s;
+      }
+
+      .accordion-content:is(.open, .is-expanded, [aria-hidden="false"]) {
+        block-size: auto;
+      }
+    }
