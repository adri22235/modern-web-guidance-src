+  <script>
+    const accordionToggle = document.getElementById('accordion-toggle');
+    const accordionContent = document.querySelector('.accordion-content');
+    const accordionContainer = document.querySelector('.accordion');
+    const accordionIndicator = document.querySelector('.accordion-indicator');
+
+    if (accordionToggle && accordionContent) {
+      accordionToggle.addEventListener('click', () => {
+        const isExpanded = accordionToggle.getAttribute('aria-expanded') === 'true';
+        const nextState = !isExpanded;
+        accordionToggle.setAttribute('aria-expanded', String(nextState));
+        accordionContent.classList.toggle('expanded', nextState);
+        accordionContent.classList.toggle('open', nextState);
+        accordionContent.classList.toggle('active', nextState);
+        accordionContent.classList.toggle('is-open', nextState);
+        if (accordionContainer) {
+          accordionContainer.classList.toggle('expanded', nextState);
+          accordionContainer.classList.toggle('open', nextState);
+        }
+        if (accordionIndicator) {
+          accordionIndicator.textContent = nextState ? '−' : '+';
+        }
+      });
+    }
+  </script>
