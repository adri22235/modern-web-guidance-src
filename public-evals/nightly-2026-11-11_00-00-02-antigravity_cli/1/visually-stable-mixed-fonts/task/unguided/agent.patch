diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,58 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>CSS Typography &amp; Font Size Adjustment</title>
+  <link rel="stylesheet" href="styles.css" />
+  <style>
+    /* Automatic visual height normalization across mixed font families */
+    #mixed-fonts-container {
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
+      font-size: 1.125rem;
+      font-size-adjust: from-font;
+      line-height: 1.75;
+    }
+
+    #mixed-fonts-container code {
+      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
+    }
+
+    /* Independent theme container with specific numeric metric override */
+    #independent-theme-container {
+      font-family: Georgia, Cambria, "Times New Roman", Times, serif;
+      font-size: 1.125rem;
+      font-size-adjust: 0.5;
+      line-height: 1.75;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Optical Font Metric Normalization</h1>
+      <p>Harmonizing mixed typefaces and locking visual proportions with modern CSS <code>font-size-adjust</code>.</p>
+    </header>
+
+    <section id="mixed-fonts-container" class="card">
+      <span class="card-label">Automatic Metric Normalization (from-font)</span>
+      <p>
+        When mixing regular prose with inline code snippets such as <code>font-size-adjust: from-font</code> or
+        <code>const scale = Math.hypot(dx, dy)</code>, differences in each typeface's lowercase x-height can make inline
+        code appear disproportionately large or small. Applying <code>font-size-adjust: from-font</code> on the parent
+        container automatically computes the primary font's aspect value and normalizes the visual height of nested
+        <code>&lt;code&gt;</code> elements across mixed font families.
+      </p>
+    </section>
+
+    <section id="independent-theme-container" class="card">
+      <span class="card-label">Independent Theme (Numeric Metric Override)</span>
+      <p>
+        This independent editorial theme uses an explicit numeric metric override (<code>font-size-adjust: 0.5</code>)
+        to lock down its visual proportions and guarantee a consistent x-height to font-size ratio of <code>0.5</code>
+        regardless of which primary or fallback serif or monospace font is rendered.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
