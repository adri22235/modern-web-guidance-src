+  <script type="module">
+    const hasNativeInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+    if (!hasNativeInvokers) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    const maplePopover = document.getElementById('maple-nutrition-popover');
+    const espressoPopover = document.getElementById('espresso-details-popover');
+    const espressoShowBtn = document.getElementById('espresso-show-btn');
+
+    maplePopover?.addEventListener('command', (event) => {
+      if (!hasNativeInvokers && event.command === 'toggle-popover') {
+        const isOpen = !maplePopover.matches(':popover-open, .\\:popover-open');
+        event.source?.setAttribute('aria-expanded', String(isOpen));
+      }
+    });
+
+    espressoPopover?.addEventListener('command', (event) => {
+      if (event.command === 'hide-popover') {
+        if (espressoPopover.contains(event.source)) {
+          requestAnimationFrame(() => espressoShowBtn?.focus());
+        }
+        if (!hasNativeInvokers) {
+          espressoShowBtn?.setAttribute('aria-expanded', 'false');
+        }
+      } else if (!hasNativeInvokers && event.command === 'show-popover') {
+        espressoShowBtn?.setAttribute('aria-expanded', 'true');
+      }
+    });
+  </script>
