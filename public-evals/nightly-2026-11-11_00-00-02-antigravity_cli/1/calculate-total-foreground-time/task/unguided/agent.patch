   </footer>
 
+  <script>
+    let accumulatedForegroundTime = 0;
+    let visibleStartTime = document.visibilityState === 'visible' ? performance.now() : null;
+
+    function handleVisibilityChange() {
+      const now = performance.now();
+      if (document.visibilityState === 'visible') {
+        if (visibleStartTime === null) {
+          visibleStartTime = now;
+        }
+      } else {
+        if (visibleStartTime !== null) {
+          accumulatedForegroundTime += now - visibleStartTime;
+          visibleStartTime = null;
+        }
+      }
+    }
+
+    document.addEventListener('visibilitychange', handleVisibilityChange);
+
+    function calculateTotalForegroundTime() {
+      if (document.visibilityState === 'visible' && visibleStartTime !== null) {
+        return accumulatedForegroundTime + (performance.now() - visibleStartTime);
+      }
+      return accumulatedForegroundTime;
+    }
+
+    window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+    window.getTotalForegroundTime = calculateTotalForegroundTime;
+    window.getForegroundTime = calculateTotalForegroundTime;
+    window.calculateForegroundTime = calculateTotalForegroundTime;
+  </script>
+
 </body>
 
 </html>
