+
+      // Close and Cancel buttons
+      closeBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        attemptCloseModal();
+      });
+
+      cancelBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        attemptCloseModal();
+      });
+
+      // Keep editing button
+      keepEditingBtn.addEventListener('click', function () {
+        unsavedBanner.classList.remove('dismiss-blocked');
+        unsavedBannerText.textContent = 'You have unsaved changes to your order options.';
+      });
+
+      // Discard changes button (confirms discarding changes and closes modal)
+      discardBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        forceCloseModal();
+      });
+
+      // Prevent backdrop click from dismissing when options have been changed
+      modal.addEventListener('click', function (e) {
+        if (e.target === modal || !modalPanel.contains(e.target)) {
+          attemptCloseModal();
+        }
+      });
+
+      // Prevent Escape key from dismissing when options have been changed
+      modal.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        attemptCloseModal();
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && modal.open) {
+          e.preventDefault();
+          attemptCloseModal();
+        }
+      });
+
+      // Handle form submission ("Add to Order")
+      orderForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const drink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        forceCloseModal();
+        toastEl.textContent = 'Added ' + qty + 'x ' + drink.name + ' (' + sizeSelect.options[sizeSelect.selectedIndex].text.split(' ')[0] + ') to your order!';
+        toastEl.hidden = false;
+        if (toastTimer) clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () {
+          toastEl.hidden = true;
+        }, 4000);
+      });
+    })();
+  </script>
