+
+      function applyDrinkDefaults(drinkKey) {
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        drinkSelect.value = drinkKey;
+        sizeSelect.value = drink.defaults.size;
+        milkSelect.value = drink.defaults.milk;
+        if (drink.defaults.temperature === 'iced') {
