+        if (sizeSelect.value === 'small') unitPrice -= 0.50;
+        if (sizeSelect.value === 'large') unitPrice += 0.75;
+        if (extraShotInput.checked) unitPrice += 1.25;
+        if (whippedCreamInput.checked) unitPrice += 0.75;
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const total = unitPrice * qty;
+        totalPriceEl.textContent = 'Total: $' + total.toFixed(2);
