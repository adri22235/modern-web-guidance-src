+            favoriteDrink: parsed.favoriteDrink || DEFAULT_CONFIG.favoriteDrink,
+            preferredMilk: parsed.preferredMilk || DEFAULT_CONFIG.preferredMilk,
+            pickupLocation: parsed.pickupLocation || DEFAULT_CONFIG.pickupLocation
+          };
+        } catch {
+          return { ...DEFAULT_CONFIG };
+        }
+      }
+
+      function saveLocalConfig(config, statusText) {
