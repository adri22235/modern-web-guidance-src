+          favoriteDrink: config.favoriteDrink || DEFAULT_CONFIG.favoriteDrink,
+          preferredMilk: config.preferredMilk || DEFAULT_CONFIG.preferredMilk,
+          pickupLocation: config.pickupLocation || DEFAULT_CONFIG.pickupLocation
