+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Daily Grind Origin Migration Bridge</title>
+</head>
+<body>
+  <script>
+    const OLD_ORIGIN = 'https://old-app.dailygrind.com';
+    const NEW_ORIGIN = 'https://new-app.dailygrind.com';
+    const SITE_DOMAIN = 'dailygrind.com';
+    const STORAGE_KEY = 'dailyGrindUserConfig';
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function isTrustedOrigin(candidate, expectedOriginUrl) {
+      try {
+        if ('Origin' in globalThis) {
+          const candidateOrigin = extractOrigin(candidate);
+          const trustedOrigin = Origin.from(expectedOriginUrl);
+          return (
+            candidateOrigin.isSameOrigin(trustedOrigin) &&
+            candidateOrigin.isSameSite(Origin.from(OLD_ORIGIN))
+          );
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(expectedOriginUrl);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.origin === trustedUrl.origin &&
+          candidateUrl.protocol === 'https:' &&
+          (candidateUrl.hostname === SITE_DOMAIN ||
+            candidateUrl.hostname.endsWith(`.${SITE_DOMAIN}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    window.addEventListener('message', (event) => {
+      if (!isTrustedOrigin(event, NEW_ORIGIN)) return;
+
+      if (event.data && event.data.type === 'REQUEST_USER_CONFIG') {
+        const rawConfig = localStorage.getItem(STORAGE_KEY);
+        let parsedConfig = null;
+        try {
+          parsedConfig = rawConfig ? JSON.parse(rawConfig) : null;
+        } catch {
+          parsedConfig = null;
+        }
+
+        event.source?.postMessage(
+          {
+            type: 'MIGRATE_USER_CONFIG',
+            config: parsedConfig,
+            migratedAt: new Date().toISOString()
+          },
+          NEW_ORIGIN
+        );
+      }
+    });
+  </script>
+</body>
+</html>
