+  <script>
+    (() => {
+      const COFFEE_MENU = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup and balanced espresso.',
+          temperature: 'hot',
+          roast: 'medium',
+          milkOptions: ['oat', 'almond', 'whole', 'soy'],
+          defaultMilk: 'oat',
+          decafAvailable: true,
+          price: '$5.75',
+          flavors: ['maple', 'oat', 'sweet', 'creamy', 'latte', 'seasonal'],
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smoky double shot pulled for a rich morning boost.',
+          temperature: 'hot',
+          roast: 'dark',
+          milkOptions: ['black', 'whole', 'oat'],
+          defaultMilk: 'black',
+          decafAvailable: true,
+          price: '$3.75',
+          flavors: ['bold', 'smoky', 'smokey', 'dark', 'chocolate', 'espresso'],
+          url: '/menu/espresso'
+        },
+        {
+          id: '18-hour-cold-brew',
+          name: '18-Hour Steeped Cold Brew',
+          description: 'Steeped slow for 18 hours for maximum smoothness and low acidity.',
+          temperature: 'iced',
+          roast: 'medium',
+          milkOptions: ['black', 'oat', 'almond', 'coconut', 'whole'],
+          defaultMilk: 'black',
+          decafAvailable: false,
+          price: '$4.95',
+          flavors: ['smooth', 'cocoa', 'cold brew', 'refreshing', 'caramel'],
+          url: '/menu/cold-brew'
+        },
+        {
+          id: 'ethiopian-citrus-pour-over',
+          name: 'Ethiopian Yirgacheffe Pour-Over',
+          description: 'Single-origin light roast bursting with bergamot, jasmine, and bright citrus notes.',
+          temperature: 'hot',
+          roast: 'light',
+          milkOptions: ['black'],
+          defaultMilk: 'black',
+          decafAvailable: false,
+          price: '$5.25',
+          flavors: ['citrus', 'floral', 'bright', 'bergamot', 'tea-like', 'pour-over'],
+          url: '/menu/pour-over'
+        },
+        {
+          id: 'iced-toasted-coconut-mocha',
+          name: 'Iced Toasted Coconut Mocha',
+          description: 'Dark chocolate ganache, espresso, and chilled coconut milk over ice.',
+          temperature: 'iced',
+          roast: 'dark',
+          milkOptions: ['coconut', 'oat', 'almond', 'whole'],
+          defaultMilk: 'coconut',
+          decafAvailable: true,
+          price: '$6.25',
+          flavors: ['coconut', 'mocha', 'chocolate', 'nutty', 'sweet', 'iced'],
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'honey-almond-cortado',
+          name: 'Honey Almond Cortado',
+          description: 'Equal parts bright espresso and steamed almond milk kissed with wildflower honey.',
+          temperature: 'hot',
+          roast: 'light',
+          milkOptions: ['almond', 'oat', 'whole', 'soy'],
+          defaultMilk: 'almond',
+          decafAvailable: true,
+          price: '$4.85',
+          flavors: ['honey', 'almond', 'nutty', ' floral', 'cortado', 'vanilla'],
+          url: '/menu/espresso'
+        }
+      ];
+
+      const form = document.getElementById('coffee-finder-form');
+      const flavorInput = document.getElementById('flavor-notes');
+      const flavorError = document.getElementById('flavor-error');
+      const submitBtn = document.getElementById('finder-submit-btn');
+      const resultsSummary = document.getElementById('results-summary');
+      const resultsGrid = document.getElementById('results-grid');
+      const agentStatusBadge = document.getElementById('agent-status-badge');
+
+      let flavorEdited = false;
+
+      function setFlavorError(message) {
+        if (message) {
+          flavorInput.setCustomValidity(message);
+          flavorInput.setAttribute('aria-invalid', 'true');
+          flavorError.textContent = 'Error: ' + message;
+          flavorError.hidden = false;
+        } else {
+          flavorInput.setCustomValidity('');
+          flavorInput.removeAttribute('aria-invalid');
+          flavorError.textContent = '';
+          flavorError.hidden = true;
+        }
+      }
+
+      function validateFormFields() {
+        const errors = [];
+        const rawFlavor = flavorInput.value;
+        const allowedPattern = /^[A-Za-z0-9\s,\-]*$/;
+
+        if (rawFlavor.length > 60) {
+          const msg = 'Please use 60 characters or fewer for flavor notes.';
+          setFlavorError(msg);
+          errors.push({ field: 'flavor', message: msg, element: flavorInput });
+        } else if (!allowedPattern.test(rawFlavor)) {
+          const msg = 'Please enter only letters, numbers, spaces, commas, or hyphens.';
+          setFlavorError(msg);
+          errors.push({ field: 'flavor', message: msg, element: flavorInput });
+        } else {
+          setFlavorError('');
+        }
+
+        return errors;
+      }
+
+      flavorInput.addEventListener('input', () => {
+        flavorEdited = true;
+        if (flavorInput.getAttribute('aria-invalid') === 'true') {
+          validateFormFields();
+        }
+      });
+
+      flavorInput.addEventListener('blur', () => {
+        if (flavorEdited) {
+          validateFormFields();
+        }
+      });
+
+      function renderDrinkCards(drinks, criteriaSummary) {
+        resultsSummary.textContent = criteriaSummary;
+        resultsGrid.replaceChildren();
+
+        for (const drink of drinks) {
+          const card = document.createElement('div');
+          card.className = 'card';
+
+          const title = document.createElement('h3');
+          title.textContent = drink.name;
+
+          const desc = document.createElement('p');
+          desc.textContent = drink.description;
+
+          const meta = document.createElement('div');
+          const tempBadge = document.createElement('span');
+          tempBadge.className = 'badge';
+          tempBadge.textContent = drink.temperature === 'iced' ? 'Iced' : 'Hot';
+
+          const roastBadge = document.createElement('span');
+          roastBadge.className = 'badge';
+          roastBadge.textContent = drink.roast.charAt(0).toUpperCase() + drink.roast.slice(1) + ' Roast';
+
+          meta.append(tempBadge, roastBadge);
+
+          if (drink.decafAvailable) {
+            const decafBadge = document.createElement('span');
+            decafBadge.className = 'badge';
+            decafBadge.textContent = 'Decaf Available';
+            meta.append(decafBadge);
+          }
+
+          const price = document.createElement('div');
+          price.className = 'price-tag';
+          price.textContent = drink.price;
+
+          const linkWrap = document.createElement('div');
+          const link = document.createElement('a');
+          link.href = drink.url;
+          link.className = 'btn';
+          link.textContent = 'Order ' + drink.name;
+          linkWrap.append(link);
+
+          card.append(title, desc, meta, price, linkWrap);
+          resultsGrid.append(card);
+        }
+      }
+
+      function performCoffeeSearch(formData) {
+        const temperature = (formData.get('temperature') || 'any').toString().toLowerCase();
+        const roast = (formData.get('roast') || 'any').toString().toLowerCase();
+        const milk = (formData.get('milk') || 'any').toString().toLowerCase();
+        const flavorQuery = (formData.get('flavor') || '').toString().trim().toLowerCase();
+        const decafOnly = formData.get('decaf') === 'true';
+
+        const keywords = flavorQuery
+          ? flavorQuery.split(/[\s,]+/).filter(Boolean)
+          : [];
+
+        const matches = COFFEE_MENU.filter((drink) => {
+          if (temperature !== 'any' && drink.temperature !== temperature) {
+            return false;
+          }
+          if (roast !== 'any' && drink.roast !== roast) {
+            return false;
+          }
+          if (milk !== 'any' && !drink.milkOptions.includes(milk)) {
+            return false;
+          }
+          if (decafOnly && !drink.decafAvailable) {
+            return false;
+          }
+          if (keywords.length > 0) {
+            const searchableText = [
+              drink.name,
+              drink.description,
+              ...drink.flavors
+            ].join(' ').toLowerCase();
+            return keywords.every((kw) => searchableText.includes(kw));
+          }
+          return true;
+        });
+
+        const summaryText = matches.length > 0
+          ? `Found ${matches.length} matching coffee${matches.length === 1 ? '' : 's'}.`
+          : 'No exact matches found for those filters. Try broadening your roast, milk, or flavor preferences.';
+
+        renderDrinkCards(matches, summaryText);
+
+        const structuredResponse = matches.length > 0
+          ? `${summaryText} Recommendations: ` +
+            matches
+              .map((d) => `${d.name} (${d.price}, ${d.temperature}, ${d.roast} roast — ${d.description})`)
+              .join('; ')
+          : summaryText;
+
+        return Promise.resolve(structuredResponse);
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const formValidationErrors = validateFormFields();
+
+        if (formValidationErrors.length > 0) {
+          formValidationErrors[0].element.focus();
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            const errorString =
+              'Validation failed: ' +
+              formValidationErrors
+                .map((err) => `${err.field} (${err.message})`)
+                .join(', ');
+            event.respondWith(Promise.resolve(errorString));
+          }
+          return;
+        }
+
+        submitBtn.disabled = true;
+        const resultPromise = performCoffeeSearch(new FormData(form)).finally(() => {
+          submitBtn.disabled = false;
+        });
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(resultPromise);
+        }
+      });
+
+      form.addEventListener('reset', () => {
+        flavorEdited = false;
+        setFlavorError('');
+        setTimeout(() => {
+          performCoffeeSearch(new FormData(form));
+        }, 0);
+      });
+
+      // WebMCP Lifecycle Events (Chrome 156+ dispatches on document.modelContext; older versions on window)
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        if (toolName === 'find-coffee') {
+          agentStatusBadge.textContent = 'AI Assistant is searching for your coffee...';
+          agentStatusBadge.hidden = false;
+        }
+      });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        if (toolName === 'find-coffee') {
+          agentStatusBadge.textContent = 'AI Assistant search was cancelled.';
+          agentStatusBadge.hidden = false;
+        }
+      });
+
+      // Render initial full catalog
+      renderDrinkCards(COFFEE_MENU, `Showing all ${COFFEE_MENU.length} signature coffees`);
+    })();
+  </script>
 </body>
 
 </html>
