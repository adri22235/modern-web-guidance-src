+                onclick="selectDrinkForOrder('${item.name}', '${temperature}', '${item.defaultMilk}')"
+              >
+                Order This Drink
+              </button>
+            </div>
+          </div>
+        `
+          )
+          .join('');
+
+        finderResultsBox.classList.add('visible');
+
+        const responsePayload = {
+          status: 'success',
+          exactMatch,
+          filters: { temperature, roast, flavor, caffeine, query },
+          recommendations: matches.map((m) => ({
+            name: m.name,
+            price: m.price,
+            roast: m.roast,
+            flavor: m.flavor,
+            availableTemperatures: m.temperature,
+            caffeine: m.caffeine,
+            description: m.description
+          }))
+        };
+
+        if (typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(responsePayload));
+        }
+      });
+
+      finderForm.addEventListener('reset', () => {
+        finderResultsBox.classList.remove('visible');
+      });
+    }
+
+    // Handle Quick-Order Form submission (Human + Declarative WebMCP Agent Tool)
+    const orderForm = document.getElementById('quick-order-form');
+    const orderConfirmation = document.getElementById('order-confirmation');
+    const orderSummaryText = document.getElementById('order-summary-text');
+
+    if (orderForm) {
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(orderForm);
+        const drink = formData.get('drink') || 'Maple Oat Latte';
+        const size = formData.get('size') || 'Medium';
+        const temperature = formData.get('temperature') || 'Hot';
+        const milk = formData.get('milk') || 'Oat Milk';
+        const sweetness = formData.get('sweetness') || 'Standard';
+        const extraShots = parseInt(formData.get('extra_shots') || '0', 10) || 0;
+        const location = formData.get('location') || 'Downtown Roastery';
+        const customerName = (formData.get('customer_name') || 'Guest').trim();
+        const notes = (formData.get('notes') || '').trim();
+
+        const basePrice = DRINK_PRICES[drink] || 5.00;
+        const sizeMod = SIZE_MODIFIERS[size] || 0;
+        const shotsCost = Math.max(0, extraShots) * 1.00;
+        const totalPrice = (basePrice + sizeMod + shotsCost).toFixed(2);
+        const orderId = 'DG-' + Math.floor(100000 + Math.random() * 900000);
+
+        const shotsText = extraShots > 0 ? ` + ${extraShots} extra shot${extraShots > 1 ? 's' : ''}` : '';
+        const notesText = notes ? ` | Notes: "${notes}"` : '';
+
+        orderSummaryText.innerHTML = `
+          Thank you, <strong>${customerName}</strong>! Your order <strong>#${orderId}</strong> for a
+          <strong>${size} ${temperature} ${drink}</strong> (${milk}, ${sweetness}${shotsText})
+          has been sent to <strong>${location}</strong>.<br/>
+          <strong>Total: $${totalPrice}</strong> &bull; Estimated pickup ready in <strong>5–7 minutes</strong>${notesText}.
+        `;
+
+        orderConfirmation.classList.add('visible');
+
+        const orderPayload = {
+          status: 'confirmed',
+          orderId,
+          customerName,
+          item: {
+            drink,
+            size,
+            temperature,
+            milk,
+            sweetness,
+            extraShots,
+            notes
+          },
+          pickupLocation: location,
+          totalPrice: `$${totalPrice}`,
+          estimatedReadyMinutes: '5-7 minutes'
+        };
+
+        if (typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(orderPayload));
+        }
+      });
+    }
+  </script>
