+    /**
+     * Extract numeric wall-clock parts (year, month, day, hour, minute, second)
+     * for a UTC timestamp in a given IANA timeZone.
+     */
+    function getWallClockParts(epochMs, timeZone) {
+      const formatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        year: 'numeric',
+        month: '2-digit',
+        day: '2-digit',
+        hour: '2-digit',
+        minute: '2-digit',
+        second: '2-digit',
+        hourCycle: 'h23'
+      });
+      const parts = formatter.formatToParts(new Date(epochMs));
+      const map = {};
+      for (const p of parts) {
+        if (p.type !== 'literal') {
+          map[p.type] = parseInt(p.value, 10);
+        }
+      }
+      // Handle quirks where 24 might be returned for midnight
+      if (map.hour === 24) map.hour = 0;
+      return map;
