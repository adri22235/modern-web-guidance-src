+      const day = parseInt(dateMatch[3], 10);
+      const hour = parseInt(timeMatch[1], 10);
+      const minute = parseInt(timeMatch[2], 10);
+
+      // Verify calendar date validity (e.g. reject Feb 30)
+      const checkCalendar = new Date(Date.UTC(year, month - 1, day));
+      if (
+        checkCalendar.getUTCFullYear() !== year ||
+        checkCalendar.getUTCMonth() + 1 !== month ||
+        checkCalendar.getUTCDate() !== day ||
+        hour < 0 || hour > 23 || minute < 0 || minute > 59
+      ) {
+        return {
+          valid: false,
+          reason: 'The specified calendar date or time is out of bounds.'
+        };
+      }
+
+      // Check timezone validity
+      try {
+        new Intl.DateTimeFormat('en-US', { timeZone: hostTz });
+      } catch (err) {
+        return {
+          valid: false,
+          reason: `Unsupported or invalid timezone: ${hostTz}`
+        };
+      }
+
+      const targetAsUtcMs = Date.UTC(year, month - 1, day, hour, minute, 0);
+
+      // Probe surrounding window (-36h to +36h) for possible offsets in hostTz
+      const candidateOffsets = new Set();
+      for (let deltaHours = -36; deltaHours <= 36; deltaHours += 6) {
+        const probeMs = targetAsUtcMs + deltaHours * 3600000;
+        candidateOffsets.add(getOffsetMinutesAtInstant(probeMs, hostTz));
+      }
+
+      // Also do a two-step iterative refinement from targetAsUtcMs
+      const firstOffset = getOffsetMinutesAtInstant(targetAsUtcMs, hostTz);
+      candidateOffsets.add(firstOffset);
+      const firstGuess = targetAsUtcMs - firstOffset * 60000;
+      const secondOffset = getOffsetMinutesAtInstant(firstGuess, hostTz);
+      candidateOffsets.add(secondOffset);
+
+      const matchingInstants = [];
+      for (const offsetMin of candidateOffsets) {
+        const candidateUtcMs = targetAsUtcMs - offsetMin * 60000;
+        const actualParts = getWallClockParts(candidateUtcMs, hostTz);
+        if (
+          actualParts.year === year &&
+          actualParts.month === month &&
+          actualParts.day === day &&
+          actualParts.hour === hour &&
+          actualParts.minute === minute
+        ) {
+          matchingInstants.push(candidateUtcMs);
+        }
+      }
+
+      if (matchingInstants.length === 0) {
+        // Non-existent local time due to Daylight Saving Time spring-forward transition!
+        const minOffset = Math.min(...candidateOffsets);
+        const postJumpParts = getWallClockParts(targetAsUtcMs - minOffset * 60000, hostTz);
+        const pad = n => String(n).padStart(2, '0');
+        return {
+          valid: false,
+          isDstGap: true,
+          reason: `Invalid local time: ${dateStr} ${pad(hour)}:${pad(minute)} does not exist in ${hostTz} due to a Daylight Saving Time (DST) spring-forward transition (clocks jump forward and skip this hour, shifting to ${pad(postJumpParts.hour)}:${pad(postJumpParts.minute)}). Please select a valid time outside the DST transition gap.`
+        };
+      }
+
+      // Sort chronologically; if fold/ambiguous, pick the first occurrence and note it
+      matchingInstants.sort((a, b) => a - b);
+      const chosenInstantMs = matchingInstants[0];
+      const isAmbiguousFold = matchingInstants.length > 1;
+
+      return {
+        valid: true,
+        epochMs: chosenInstantMs,
+        isAmbiguousFold,
+        hostParts: { year, month, day, hour, minute }
+      };
+    }
+
+    function formatDisplayInZone(epochMs, timeZone, hostParts) {
+      const timeFormatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        hour: '2-digit',
+        minute: '2-digit',
+        hour12: true
+      });
+      const time24Formatter = new Intl.DateTimeFormat('en-GB', {
+        timeZone,
+        hour: '2-digit',
+        minute: '2-digit',
+        hourCycle: 'h23'
+      });
+      const dateFormatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        weekday: 'short',
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric'
+      });
+
+      const targetParts = getWallClockParts(epochMs, timeZone);
+      const hostDayUtc = Date.UTC(hostParts.year, hostParts.month - 1, hostParts.day);
+      const targetDayUtc = Date.UTC(targetParts.year, targetParts.month - 1, targetParts.day);
+      const dayDiff = Math.round((targetDayUtc - hostDayUtc) / 86400000);
+
+      let dayDiffLabel = 'Same day';
+      if (dayDiff === 1) dayDiffLabel = '+1 day (Next day)';
+      else if (dayDiff === -1) dayDiffLabel = '-1 day (Previous day)';
+      else if (dayDiff > 1) dayDiffLabel = `+${dayDiff} days`;
+      else if (dayDiff < -1) dayDiffLabel = `${dayDiff} days`;
+
+      return {
+        time12: timeFormatter.format(new Date(epochMs)),
+        time24: time24Formatter.format(new Date(epochMs)),
+        dateFormatted: dateFormatter.format(new Date(epochMs)),
+        dayDiff,
+        dayDiffLabel
+      };
+    }
+
+    function updateSchedule() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const errorBanner = document.getElementById('errorMessage');
+      const hostSummary = document.getElementById('hostSummary');
+      const utcReference = document.getElementById('utcReference');
+      const grid = document.getElementById('grid');
+
+      const dateVal = dateInput ? dateInput.value : '';
+      const timeVal = timeInput ? timeInput.value : '';
+      const hostTz = hostTzSelect ? hostTzSelect.value : 'America/New_York';
+
+      const resolution = resolveHostDateTime(dateVal, timeVal, hostTz);
+
+      if (!resolution.valid) {
+        errorBanner.className = 'error-banner visible';
+        errorBanner.innerHTML = `
+          <strong>Invalid Event Time Rejected (DST Transition Conflict)</strong>
+          <span>${resolution.reason}</span>
+        `;
+        hostSummary.innerHTML = `
+          <span><strong>Status:</strong> Invalid / Non-existent local time in <code>${hostTz}</code></span>
+          <span>Adjust the time or date to schedule the tasting event.</span>
+        `;
+        utcReference.textContent = 'UTC Reference: Invalid local time';
+
+        // Clear valid converted cards and show explicit rejection feedback in #grid
+        grid.innerHTML = `
+          <div class="card card-error" data-status="invalid">
+            <h3>Cannot Convert Invalid DST Transition Time</h3>
+            <p>${resolution.reason}</p>
+          </div>
+        `;
+        return;
+      }
+
+      // Valid time
+      errorBanner.className = 'error-banner';
+      errorBanner.innerHTML = '';
+
+      const epochMs = resolution.epochMs;
+      const hostMeta = getTimezoneMetadata(epochMs, hostTz);
+      const hostDisplay = formatDisplayInZone(epochMs, hostTz, resolution.hostParts);
+      const utcIso = new Date(epochMs).toISOString().replace('.000Z', ' UTC');
+
+      const foldNotice = resolution.isAmbiguousFold
+        ? ' <em>(Note: Fall-back repeated hour; resolved to first occurrence)</em>'
+        : '';
+
+      hostSummary.innerHTML = `
+        <span>
+          <strong>Host Session:</strong> ${hostDisplay.dateFormatted} at ${hostDisplay.time24} (${hostDisplay.time12})
+          — <code>${hostTz}</code> (${hostMeta.shortTzName}, ${hostMeta.utcOffsetString}, ${hostMeta.isDst ? 'DST Active' : 'Standard Time'})${foldNotice}
+        </span>
+      `;
+      utcReference.textContent = `Universal Instant: ${utcIso}`;
+
+      // Ensure all target timezones are rendered (including Tokyo and the selected host timezone if not already in list)
+      const zonesToRender = [...TARGET_TIMEZONES];
+      if (!zonesToRender.some(z => z.tz === hostTz)) {
+        zonesToRender.unshift({
+          city: hostTz.split('/').pop().replace(/_/g, ' '),
+          region: 'Selected Host Hub',
+          tz: hostTz,
+          roastery: 'Host Tasting Headquarters',
+          tastingNote: 'Primary broadcast & sensory calibration table'
+        });
+      }
+
+      grid.innerHTML = zonesToRender.map(target => {
+        const meta = getTimezoneMetadata(epochMs, target.tz);
+        const disp = formatDisplayInZone(epochMs, target.tz, resolution.hostParts);
+        const isHost = target.tz === hostTz;
+        const diffHoursFromHost = (meta.offsetMinutes - hostMeta.offsetMinutes) / 60;
+        let relOffsetLabel = 'Same as host time';
+        if (diffHoursFromHost !== 0) {
+          const sign = diffHoursFromHost > 0 ? '+' : '';
+          relOffsetLabel = `${sign}${diffHoursFromHost}h from host`;
+        }
+
+        const dstBadgeText = meta.observesDst
+          ? (meta.isDst ? 'DST Active' : 'Standard Time')
+          : 'No DST (Standard)';
+        const dstBadgeClass = meta.isDst ? 'badge-dst' : 'badge-std';
+
+        const dayShiftHtml = disp.dayDiff !== 0
+          ? `<span class="day-shift">${disp.dayDiffLabel}</span>`
+          : '';
+
+        return `
+          <article class="card ${isHost ? 'is-host' : ''}" data-tz="${target.tz}" data-city="${target.city}">
+            <div>
+              <div class="card-top">
+                <div>
+                  <h3>${target.city}</h3>
+                  <div class="tz-identifier">${target.tz} &bull; ${target.region}</div>
+                </div>
+                <div class="badge-group">
+                  ${isHost ? '<span class="badge badge-host">Host Hub</span>' : ''}
+                  <span class="badge ${dstBadgeClass}">${dstBadgeText}</span>
+                </div>
+              </div>
+
+              <div class="converted-time" data-time24="${disp.time24}" data-time12="${disp.time12}">
+                ${disp.time24} <span style="font-size: 1rem; font-weight: 500; color: var(--text-muted);">(${disp.time12})</span>
+              </div>
+
+              <div class="converted-date">
+                ${disp.dateFormatted}${dayShiftHtml}
+              </div>
+
+              <p class="roastery-note"><strong>${target.roastery}:</strong> ${target.tastingNote}</p>
+            </div>
+
+            <div class="card-meta">
+              <span><strong>${meta.shortTzName}</strong> (${meta.utcOffsetString})</span>
+              <span>${relOffsetLabel}</span>
+            </div>
+          </article>
+        `;
+      }).join('');
+    }
+
+    // Wire up inputs and preset buttons
+    document.addEventListener('DOMContentLoaded', () => {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      [dateInput, timeInput, hostTzSelect].forEach(el => {
+        if (el) {
+          el.addEventListener('input', updateSchedule);
+          el.addEventListener('change', updateSchedule);
+        }
+      });
+
+      document.querySelectorAll('.preset-btn').forEach(btn => {
+        btn.addEventListener('click', () => {
+          dateInput.value = btn.getAttribute('data-date');
+          timeInput.value = btn.getAttribute('data-time');
+          hostTzSelect.value = btn.getAttribute('data-tz');
+          updateSchedule();
+        });
+      });
+
+      updateSchedule();
+    });
+  </script>
 </body>
 
 </html>
