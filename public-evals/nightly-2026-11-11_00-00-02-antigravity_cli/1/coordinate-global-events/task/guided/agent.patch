+  <script type="module">
+    const TASTING_LOCATIONS = [
+      { city: 'Tokyo Pour-Over Lab', timeZone: 'Asia/Tokyo', note: 'Single-Origin Geisha Flight' },
+      { city: 'New York Roastery', timeZone: 'America/New_York', note: 'East Coast Cupping Table' },
+      { city: 'London Tasting Room', timeZone: 'Europe/London', note: 'European Espresso Calibration' },
+      { city: 'Bogotá Origin Estate', timeZone: 'America/Bogota', note: 'Andean Harvest Lot Review' },
+      { city: 'Addis Ababa Cupping Hub', timeZone: 'Africa/Addis_Ababa', note: 'Heirloom Washed Selection' },
+      { city: 'Sydney Espresso Bar', timeZone: 'Australia/Sydney', note: 'APAC Barista Guild Session' }
+    ];
+
+    function coordinateTastingEvent() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const dstAlert = document.getElementById('dstAlert');
+      const hostSummary = document.getElementById('hostSummary');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) {
+        dstAlert.hidden = false;
+        dstAlert.textContent = 'Please provide a valid date, time, and host time zone.';
+        grid.replaceChildren();
+        return;
+      }
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        } else {
+          dstAlert.hidden = false;
+          dstAlert.textContent = 'Invalid date or time format selected.';
+          timeInput.setAttribute('aria-invalid', 'true');
+          grid.replaceChildren();
+          return;
+        }
+      }
+
+      // Resolve the host time safely using disambiguation: 'compatible'
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+      const resolvedTimeLabel = hostTime.toLocaleString('en-US', {
+        weekday: 'short',
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric',
+        hour: 'numeric',
+        minute: '2-digit',
+        timeZoneName: 'short'
+      });
+
+      if (hasConflict) {
+        timeInput.setAttribute('aria-invalid', 'true');
+        timeInput.setCustomValidity(
+          'This time falls in a Daylight Saving Time transition gap or overlap and was rejected.'
+        );
+        dstAlert.hidden = false;
+        dstAlert.textContent =
+          `Warning: ${time} on ${date} in ${timeZone} falls in a Daylight Saving Time transition (skipped or repeated hour) and was rejected by strict DST validation. Compatible resolved time: ${resolvedTimeLabel}.`;
+      } else {
+        timeInput.removeAttribute('aria-invalid');
+        timeInput.setCustomValidity('');
+        dstAlert.hidden = true;
+        dstAlert.textContent = '';
+      }
+
+      hostSummary.textContent = `Host Session (${timeZone}): ${resolvedTimeLabel}`;
+
+      // Convert to target time zones (including Asia/Tokyo) using .withTimeZone()
+      const tokyoTime = hostTime.withTimeZone('Asia/Tokyo');
+      const cards = TASTING_LOCATIONS.map((loc) => {
+        const zoned = loc.timeZone === 'Asia/Tokyo' ? tokyoTime : hostTime.withTimeZone(loc.timeZone);
+
+        const card = document.createElement('article');
+        card.className = loc.timeZone === 'Asia/Tokyo' ? 'card is-tokyo' : 'card';
+        card.dataset.timezone = loc.timeZone;
+
+        const heading = document.createElement('h3');
+        heading.textContent = loc.city;
+
+        const tzBadge = document.createElement('p');
+        tzBadge.className = 'tz-id';
+        tzBadge.textContent = loc.timeZone;
+
+        const timeDisplay = document.createElement('p');
+        timeDisplay.className = 'converted-time';
+        timeDisplay.textContent = zoned.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+
+        const dateDisplay = document.createElement('p');
+        dateDisplay.className = 'converted-date';
+        dateDisplay.textContent = zoned.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const noteDisplay = document.createElement('p');
+        noteDisplay.className = 'hint';
+        noteDisplay.textContent = loc.note;
+
+        const offsetBadge = document.createElement('span');
+        offsetBadge.className = 'tz-offset';
+        offsetBadge.textContent = `UTC ${zoned.offset}`;
+
+        card.append(heading, tzBadge, timeDisplay, dateDisplay, noteDisplay, offsetBadge);
+        return card;
+      });
+
+      grid.replaceChildren(...cards);
+    }
+
+    function initializeApp() {
+      const form = document.getElementById('tastingForm');
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const testDstGapBtn = document.getElementById('testDstGapBtn');
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        coordinateTastingEvent();
+        if (timeInput.getAttribute('aria-invalid') === 'true') {
+          timeInput.focus();
+        }
+      });
+
+      dateInput.addEventListener('input', coordinateTastingEvent);
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+        timeInput.removeAttribute('aria-invalid');
+        coordinateTastingEvent();
+      });
+      timeInput.addEventListener('blur', coordinateTastingEvent);
+      hostTzSelect.addEventListener('change', coordinateTastingEvent);
+
+      testDstGapBtn.addEventListener('click', () => {
+        dateInput.value = '2025-03-09';
+        timeInput.value = '02:30';
+        hostTzSelect.value = 'America/New_York';
+        coordinateTastingEvent();
+      });
+
+      coordinateTastingEvent();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
+
 </body>
 
 </html>
