+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+</head>
+<body>
+  <header>
+    <h1>Dashboard</h1>
+  </header>
+  <main id="app">
+    <section aria-labelledby="overview-heading">
+      <h2 id="overview-heading">Overview</h2>
+      <p>Dashboard metrics and legacy widgets load below.</p>
+      <div id="widgets-container"></div>
+    </section>
+  </main>
+  <footer>
+    <small>System Dashboard</small>
+  </footer>
+  <!-- Deprioritize parser-blocking late-body script to favor critical resources -->
+  <script src="/js/legacy-widgets.js" fetchpriority="low"></script>
+</body>
+</html>
