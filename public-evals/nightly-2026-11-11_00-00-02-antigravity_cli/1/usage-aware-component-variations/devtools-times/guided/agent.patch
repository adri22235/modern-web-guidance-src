index e9a9abb..0504bad 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,55 @@
 @import "tailwindcss";
 
+:root {
+  --brand-accent: #d97706;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* 1. Set the semantic context on layout containers */
+.featured {
+  --surface: featured;
+}
+
+/* 2. Components default to subtle presentation */
+.teaser-button,
+.button {
+  background: transparent;
+  border: 1px solid currentColor;
+  color: #374151;
+}
+
+.teaser-badge,
+.badge {
+  display: none;
+}
+
+/* Selector-based contextual fallback for broad browser support */
+:where(.featured) :is(.teaser-button, .button) {
+  background: var(--brand-accent);
+  color: white;
+  border: none;
+}
+
+:where(.featured) :is(.teaser-badge, .badge) {
+  display: inline-block;
+}
+
+/* Progressive enhancement: style queries override when supported */
+@container style(--surface: featured) {
+  .teaser-button,
+  .button {
+    background: var(--brand-accent);
+    color: white;
+    border: none;
+  }
+
+  .teaser-badge,
+  .badge {
+    display: inline-block;
+  }
+}
