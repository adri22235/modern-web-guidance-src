+}
+
+/* Default / standard section presentation */
+[data-section-context="default"] {
+  --card-variant: default;
+  --promo-badge-display: none;
+  --action-btn-bg: transparent;
+  --action-btn-text: #111827;
+  --action-btn-border: #d1d5db;
+  --action-btn-hover-bg: #f3f4f6;
+  --action-btn-hover-border: #111827;
+  --card-border-color: #e5e7eb;
+  --card-bg: #ffffff;
+  container-name: teaser-section;
+}
+
+/* Featured section presentation */
+[data-section-context="featured"],
+.featured-section {
+  --card-variant: featured;
+  --promo-badge-display: inline-flex;
+  --action-btn-bg: #111827;
+  --action-btn-text: #ffffff;
+  --action-btn-border: #111827;
+  --action-btn-hover-bg: #d97706;
+  --action-btn-hover-border: #d97706;
+  --card-border-color: #f59e0b;
+  --card-bg: #fffdf7;
+  container-name: teaser-section;
+}
+
+.teaser-card {
+  background-color: var(--card-bg, #ffffff);
+  border-radius: 0.5rem;
+  border: 1px solid var(--card-border-color, transparent);
+  transition: box-shadow 150ms ease, border-color 150ms ease;
+}
+
+[data-section-context="featured"] .teaser-card,
+.featured-section .teaser-card {
+  border-color: var(--card-border-color, #f59e0b);
+  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
+}
+
+.teaser-promo-badge {
+  display: var(--promo-badge-display, none);
+}
+
+.teaser-action-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.375rem;
+  padding: 0.375rem 0.75rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  line-height: 1rem;
+  border-radius: 0.375rem;
+  border: 1px solid var(--action-btn-border, #d1d5db);
+  background-color: var(--action-btn-bg, transparent);
+  color: var(--action-btn-text, #111827);
+  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.teaser-action-btn:hover {
+  background-color: var(--action-btn-hover-bg, #f3f4f6);
+  border-color: var(--action-btn-hover-border, #111827);
+  color: var(--action-btn-text, #111827);
+}
+
+[data-section-context="featured"] .teaser-action-btn:hover,
+.featured-section .teaser-action-btn:hover {
+  color: #ffffff;
+}
+
+/* Container style queries for automatic switching based on parent semantic context */
+@container style(--card-variant: featured) {
+  .teaser-card {
+    background-color: #fffdf7;
+    border-color: #f59e0b;
+    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
+  }
+
+  .teaser-promo-badge {
+    display: inline-flex;
+  }
+
+  .teaser-action-btn,
+  .teaser-bookmark-btn {
+    background-color: #111827;
+    color: #ffffff;
+    border-color: #111827;
+  }
+
+  .teaser-action-btn:hover,
+  .teaser-bookmark-btn:hover {
+    background-color: #d97706;
+    border-color: #d97706;
+    color: #ffffff;
+  }
+}
+
+@container style(--card-variant: default) {
+  .teaser-card {
+    background-color: #ffffff;
+    border-color: transparent;
+    box-shadow: none;
+  }
+
+  .teaser-promo-badge {
+    display: none;
+  }
+
+  .teaser-action-btn,
+  .teaser-bookmark-btn {
+    background-color: transparent;
+    color: #111827;
+    border-color: #d1d5db;
+  }
+
+  .teaser-action-btn:hover,
+  .teaser-bookmark-btn:hover {
+    background-color: #f3f4f6;
+    border-color: #111827;
+    color: #111827;
+  }
+}
