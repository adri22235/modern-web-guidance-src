+import { fileURLToPath } from 'node:url';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const ORIGIN_TRIAL_TOKEN =
+  process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN ||
+  'A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6EmailVerificationOriginTrialToken==';
+
+const SESSION_COOKIE_NAME = 'dg_session_id';
+const SESSION_TTL_MS = 15 * 60 * 1000;
+
+// Server-side session store mapping session IDs to single-use cryptographic nonces
+const sessionNonceStore = new Map();
+
+// In-memory rewards account store for demo purposes
+const rewardsAccounts = new Map();
+
+function pruneExpiredSessions() {
+  const now = Date.now();
+  for (const [sessionId, entry] of sessionNonceStore.entries()) {
+    if (now - entry.createdAt > SESSION_TTL_MS) {
+      sessionNonceStore.delete(sessionId);
+    }
+  }
+}
+
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const pair of cookieHeader.split(';')) {
+    const idx = pair.indexOf('=');
+    if (idx === -1) continue;
+    const key = pair.slice(0, idx).trim();
+    const val = pair.slice(idx + 1).trim();
+    if (key) cookies[key] = decodeURIComponent(val);
+  }
+  return cookies;
+}
+
+/**
+ * Generates a fresh cryptographic nonce (256 bits of entropy) per form render
+ * and stores it in server-side session state keyed by an HttpOnly session cookie.
+ */
+export function issueSessionNonce(existingSessionId) {
+  pruneExpiredSessions();
+  const sessionId = existingSessionId || randomBytes(24).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessionNonceStore.set(sessionId, {
+    nonce,
+    createdAt: Date.now(),
+  });
+  return { sessionId, nonce };
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce from server-side session state.
+ */
+export async function consumeSessionNonce(cookieHeader = '') {
+  pruneExpiredSessions();
+  const cookies = parseCookies(cookieHeader);
+  const sessionId = cookies[SESSION_COOKIE_NAME];
+  if (!sessionId) return null;
+
+  const entry = sessionNonceStore.get(sessionId);
+  // Immediately delete so an intercepted token cannot be replayed
+  sessionNonceStore.delete(sessionId);
+
+  if (!entry || Date.now() - entry.createdAt > SESSION_TTL_MS) {
+    return null;
+  }
+  return entry.nonce;
+}
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// Include 'EdDSA' while live issuers and Chrome Origin Trial builds finish transitioning to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+/**
+ * Verifies an SD-JWT Email Verification Token presentation (EVT~KB-JWT)
+ * according to the Email Verification Protocol (EVP).
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience = RP_ORIGIN,
+}) {
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded?.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded?.kbJwt || !iss || evtPayload?.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Submitted email is missing a domain.');
+  }
+
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    r.join('')
+  );
+  if (
+    !txtRecords.some(
+      (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+    )
+  ) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+
+  const discoveryResponse = await fetch(discoveryUrl);
+  if (!discoveryResponse.ok) {
+    throw new Error(`Failed to fetch issuer metadata (${discoveryResponse.status}).`);
+  }
+  const metadata = await discoveryResponse.json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+function completeAccountCreation({ name, email }) {
+  const account = {
+    id: randomBytes(12).toString('hex'),
+    name,
+    email,
+    emailVerified: true,
+    verificationMethod: 'evp-token',
+    points: 100, // Welcome bonus points
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(email.toLowerCase(), account);
+  return {
+    status: 'verified',
+    emailVerified: true,
+    email,
+    name,
+    points: account.points,
+    message: `Welcome to Daily Grind Rewards, ${name || email}! Your email (${email}) was verified instantly by your browser—100 bonus beans have been added to your account.`,
+  };
+}
+
+function sendTraditionalVerificationEmail({ name, email }) {
+  const account = {
+    id: randomBytes(12).toString('hex'),
+    name,
+    email,
+    emailVerified: false,
+    verificationMethod: 'fallback-email',
+    points: 0,
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(email.toLowerCase(), account);
+  return {
+    status: 'pending_email_verification',
+    emailVerified: false,
+    email,
+    name,
+    points: 0,
+    message: `Almost there, ${name || email}! Your account has been created. Please check ${email} for a verification link to activate your 100 welcome bonus beans.`,
+  };
+}
+
+/**
+ * Handles the rewards sign-up form submission with Email Verification Protocol (EVP)
+ * fast-path verification and graceful fallback to standard email verification.
+ */
+export async function handleSignupSubmission({
+  name,
+  submittedEmail,
+  password,
+  rawToken,
+  cookieHeader,
+  expectedAudience = RP_ORIGIN,
+}) {
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = await consumeSessionNonce(cookieHeader);
+
+  if (!submittedEmail || !submittedEmail.includes('@')) {
+    return {
+      httpStatus: 400,
+      body: {
+        status: 'error',
+        message: 'Please enter a valid email address in the format you@example.com.',
+      },
+    };
+  }
+
+  if (!password || password.length < 8) {
+    return {
+      httpStatus: 400,
+      body: {
+        status: 'error',
+        message: 'Password must be at least 8 characters long.',
+      },
+    };
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return {
+        httpStatus: 200,
+        body: completeAccountCreation({ name, email: submittedEmail }),
+      };
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return {
+    httpStatus: 200,
+    body: sendTraditionalVerificationEmail({ name, email: submittedEmail }),
+  };
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString('utf8');
+  const contentType = req.headers['content-type'] || '';
+
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(raw);
+    } catch {
+      return {};
+    }
+  }
+
+  // Default to application/x-www-form-urlencoded
+  const params = new URLSearchParams(raw);
+  return Object.fromEntries(params.entries());
+}
+
+export async function requestListener(req, res) {
+  const url = new URL(req.url || '/', `http://${req.headers.host || `localhost:${PORT}`}`);
+
+  // Serve homepage with freshly generated per-render nonce and Origin-Trial header
+  if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+    try {
+      const cookies = parseCookies(req.headers.cookie);
+      const { sessionId, nonce } = issueSessionNonce(cookies[SESSION_COOKIE_NAME]);
+
+      const htmlPath = path.join(__dirname, 'index.html');
+      let html = await readFile(htmlPath, 'utf8');
+
+      // Inject the freshly generated per-render nonce into the hidden token input
+      html = html.replace(
+        /(<input[^>]*autocomplete="email-verification-token"[^>]*nonce=")[^"]*(")/i,
+        `$1${nonce}$2`
+      ).replace(
+        /(<input[^>]*nonce=")[^"]*("[^>]*autocomplete="email-verification-token")/i,
+        `$1${nonce}$2`
+      );
+
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+        'Set-Cookie': `${SESSION_COOKIE_NAME}=${encodeURIComponent(sessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+      });
+      res.end(html);
+      return;
+    } catch (err) {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Internal Server Error');
+      return;
+    }
+  }
+
+  // Endpoint to fetch a fresh single-use session nonce for progressive enhancement / SPA refresh
+  if (req.method === 'GET' && url.pathname === '/api/verify-email/nonce') {
+    const cookies = parseCookies(req.headers.cookie);
+    const { sessionId, nonce } = issueSessionNonce(cookies[SESSION_COOKIE_NAME]);
+    res.writeHead(200, {
+      'Content-Type': 'application/json; charset=utf-8',
+      'Cache-Control': 'no-store',
+      'Set-Cookie': `${SESSION_COOKIE_NAME}=${encodeURIComponent(sessionId)}; HttpOnly; Secure; SameSite=Lax; Path=/`,
+    });
+    res.end(JSON.stringify({ nonce }));
+    return;
+  }
+
+  // Server verification & rewards registration endpoint
+  if (req.method === 'POST' && url.pathname === '/api/verify-email') {
+    const data = await readRequestBody(req);
+    const name = String(data.name || data['full-name'] || '').trim();
+    const submittedEmail = String(data.email || '').trim();
+    const password = String(data.password || data['new-password'] || '');
+    const rawToken = String(data.token || '').trim();
+
+    const originHeader = req.headers.origin;
+    const expectedAudience = originHeader || RP_ORIGIN;
+
+    const result = await handleSignupSubmission({
+      name,
+      submittedEmail,
+      password,
+      rawToken,
+      cookieHeader: req.headers.cookie || '',
+      expectedAudience,
+    });
+
+    const acceptsJson = (req.headers.accept || '').includes('application/json');
+    if (acceptsJson) {
+      res.writeHead(result.httpStatus, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Cache-Control': 'no-store',
+      });
+      res.end(JSON.stringify(result.body));
+      return;
+    }
+
+    // Standard HTML form submission response
+    res.writeHead(result.httpStatus, {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Cache-Control': 'no-store',
+    });
+    res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Daily Grind Rewards | Registration Status</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723; padding: 3rem 1.5rem; text-align: center; }
+    .status-card { max-width: 540px; margin: 0 auto; background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
+    .btn { display: inline-block; margin-top: 1.25rem; background: #4e342e; color: #fff; padding: 0.75rem 1.5rem; border-radius: 5px; text-decoration: none; }
+  </style>
+</head>
+<body>
+  <main class="status-card">
+    <h1>${result.body.emailVerified ? 'Rewards Account Verified!' : 'Check Your Email'}</h1>
+    <p>${result.body.message.replace(/[<>&"']/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;', "'": '&#39;' }[c]))}</p>
+    <a href="/" class="btn">Return to Homepage</a>
+  </main>
+</body>
+</html>`);
+    return;
+  }
+
+  res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+  res.end(JSON.stringify({ error: 'Not Found' }));
+}
+
+export function createServer() {
+  return http.createServer(requestListener);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const server = createServer();
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
