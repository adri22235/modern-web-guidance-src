+import http from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { verifyEmailVerificationToken } from './verify-evt.js';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const SESSION_COOKIE_NAME = 'dg_session';
+const SESSION_TTL_MS = 15 * 60 * 1000; // 15 minutes
+
+// Server-side session & nonce stores (kept strictly server-side, bound to HttpOnly cookie)
+const sessions = new Map();
+const issuedNonces = new Map();
+const rewardsAccounts = new Map();
+
+/**
+ * Generate a cryptographically random nonce with >= 128 bits of entropy.
+ */
+export function generateNonce() {
+  return randomBytes(24).toString('base64url');
+}
+
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const pair of cookieHeader.split(';')) {
+    const idx = pair.indexOf('=');
+    if (idx === -1) continue;
+    const key = pair.slice(0, idx).trim();
+    const val = pair.slice(idx + 1).trim();
+    if (key) {
+      cookies[key] = decodeURIComponent(val);
+    }
+  }
+  return cookies;
+}
+
+function getOrCreateSession(req, res) {
+  const cookies = parseCookies(req.headers.cookie);
+  let sessionId = cookies[SESSION_COOKIE_NAME];
+  let session = sessionId ? sessions.get(sessionId) : null;
+
+  if (!session || Date.now() - session.createdAt > SESSION_TTL_MS) {
+    sessionId = randomUUID();
+    session = {
+      id: sessionId,
+      nonce: generateNonce(),
+      createdAt: Date.now(),
+    };
+    sessions.set(sessionId, session);
+  } else {
+    session.nonce = generateNonce();
+    session.createdAt = Date.now();
+  }
+
+  issuedNonces.set(session.nonce, {
+    sessionId,
+    createdAt: Date.now(),
+    used: false,
+  });
+
+  const isSecure =
+    req.headers['x-forwarded-proto'] === 'https' || Boolean(req.socket?.encrypted);
+  const cookieParts = [
+    `${SESSION_COOKIE_NAME}=${encodeURIComponent(sessionId)}`,
+    'HttpOnly',
+    'Path=/',
+    'SameSite=Lax',
+    `Max-Age=${Math.floor(SESSION_TTL_MS / 1000)}`,
+  ];
+  if (isSecure) {
+    cookieParts.push('Secure');
+  }
+  res.setHeader('Set-Cookie', cookieParts.join('; '));
+
+  return session;
+}
+
+function getRequestOrigin(req) {
+  if (req.headers.origin) {
+    return req.headers.origin;
+  }
+  const proto = req.headers['x-forwarded-proto'] || (req.socket?.encrypted ? 'https' : 'http');
+  const host = req.headers['x-forwarded-host'] || req.headers.host || 'localhost:11222';
+  return `${proto}://${host}`;
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const rawBody = Buffer.concat(chunks).toString('utf8');
+  const contentType = (req.headers['content-type'] || '').toLowerCase();
+
+  if (contentType.includes('application/json')) {
+    return rawBody ? JSON.parse(rawBody) : {};
+  }
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    return Object.fromEntries(new URLSearchParams(rawBody));
+  }
+  try {
+    return rawBody ? JSON.parse(rawBody) : {};
+  } catch {
+    return Object.fromEntries(new URLSearchParams(rawBody));
+  }
+}
+
+function sendJson(res, statusCode, payload) {
+  const body = JSON.stringify(payload, null, 2);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+  res.end(body);
+}
+
+async function handleVerificationAndSignup(req, res) {
+  const prefersJson =
+    (req.headers.accept || '').includes('application/json') ||
+    (req.headers['content-type'] || '').includes('application/json');
+
+  try {
+    const body = await readRequestBody(req);
+
+    const email = (
+      body.email ||
+      body['email-address'] ||
+      body.emailAddress ||
+      ''
+    ).trim();
+
+    const rawToken = (
+      body.token ||
+      body.evt ||
+      body.evt_token ||
+      body.presentation_token ||
+      body.presentationToken ||
+      body['email-verification-token'] ||
+      ''
+    ).trim();
+
+    const fullName = (body.name || body.fullName || body['full-name'] || 'Coffee Lover').trim();
+    const favoriteDrink = (body.favoriteDrink || body['favorite-drink'] || 'Maple Oat Latte').trim();
+    const birthdayMonth = (body.birthdayMonth || body['birthday-month'] || '').trim();
+
+    if (!email) {
+      return sendJson(res, 400, {
+        verified: false,
+        error: 'Email address is required to register a Daily Grind Rewards account.',
+      });
+    }
+
+    if (!rawToken) {
+      return sendJson(res, 400, {
+        verified: false,
+        fallbackRequired: true,
+        error:
+          'No browser Email Verification Token (EVT) was provided. Please use a browser supporting the Email Verification Protocol (EVP).',
+      });
+    }
+
+    // Resolve expected session nonce from HttpOnly session cookie (or active issued nonces)
+    const cookies = parseCookies(req.headers.cookie);
+    const sessionId = cookies[SESSION_COOKIE_NAME];
+    const session = sessionId ? sessions.get(sessionId) : null;
+
+    let expectedNonce = session?.nonce || '';
+    if (!expectedNonce && typeof body.nonce === 'string') {
+      const nonceRecord = issuedNonces.get(body.nonce);
+      if (nonceRecord && !nonceRecord.used) {
+        expectedNonce = body.nonce;
+      }
+    }
+
+    if (!expectedNonce) {
+      return sendJson(res, 400, {
+        verified: false,
+        error: 'Missing or expired session nonce. Please reload the registration form and try again.',
+      });
+    }
+
+    const nonceRecord = issuedNonces.get(expectedNonce);
+    if (nonceRecord?.used) {
+      return sendJson(res, 400, {
+        verified: false,
+        error: 'Session nonce has already been used (replay attempt blocked).',
+      });
+    }
+
+    const expectedOrigin = getRequestOrigin(req);
+
+    const verificationResult = await verifyEmailVerificationToken({
+      rawToken,
+      expectedEmail: email,
+      expectedNonce,
+      expectedOrigin,
+    });
+
+    // Consume nonce after successful verification to prevent replay attacks
+    if (nonceRecord) {
+      nonceRecord.used = true;
+    }
+    if (session) {
+      session.nonce = generateNonce();
+      issuedNonces.set(session.nonce, {
+        sessionId: session.id,
+        createdAt: Date.now(),
+        used: false,
+      });
+    }
+
+    const account = {
+      id: randomUUID(),
+      name: fullName,
+      email: verificationResult.email,
+      emailVerified: true,
+      verificationMethod: 'EVP (Browser Email Verification Protocol / SD-JWT+KB)',
+      issuer: verificationResult.issuer,
+      favoriteDrink,
+      birthdayMonth: birthdayMonth || null,
+      pointsBalance: 150,
+      tier: 'Gold Bean Member',
+      createdAt: new Date().toISOString(),
+      nextNonce: session?.nonce || null,
+    };
+
+    rewardsAccounts.set(account.email.toLowerCase(), account);
+
+    if (prefersJson) {
+      return sendJson(res, 200, {
+        verified: true,
+        message: 'Email cryptographically verified by your browser via EVP. Welcome to Daily Grind Rewards!',
+        account,
+        evtJwtDecodedPayload: verificationResult.evtJwtDecodedPayload,
+        kbJwtDecodedPayload: verificationResult.kbJwtDecodedPayload,
+      });
+    }
+
+    res.writeHead(200, {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Cache-Control': 'no-store',
+    });
+    res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Rewards Account Confirmed | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
+    .card { background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 8px 24px rgba(78,52,46,0.12); max-width: 520px; text-align: center; }
+    .badge { display: inline-block; background: #e8f5e9; color: #2e7d32; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 0.85rem; margin-bottom: 1rem; }
+    a.btn { display: inline-block; margin-top: 1.5rem; background: #4e342e; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <span class="badge">Browser Email Verified (No OTP Required)</span>
+    <h1>Welcome, ${account.name}!</h1>
+    <p>Your email <strong>${account.email}</strong> was cryptographically verified via <code>${account.issuer}</code>.</p>
+    <p style="margin-top: 0.75rem;">You've earned <strong>${account.pointsBalance} Bonus Beans</strong> toward your next ${account.favoriteDrink}.</p>
+    <a href="/" class="btn">Back to Homepage</a>
+  </div>
+</body>
+</html>`);
+  } catch (err) {
+    const statusCode = 400;
+    if (prefersJson) {
+      return sendJson(res, statusCode, {
+        verified: false,
+        error: err.message || 'Email verification token validation failed.',
+      });
+    }
+    res.writeHead(statusCode, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end(`Verification failed: ${err.message || 'Invalid Email Verification Token'}`);
+  }
+}
+
+export function createServer() {
+  return http.createServer(async (req, res) => {
+    const url = new URL(req.url || '/', getRequestOrigin(req));
+    const pathname = url.pathname;
+
+    // 1. Session Nonce Endpoint
+    if (req.method === 'GET' && (pathname === '/api/nonce' || pathname === '/nonce')) {
+      const session = getOrCreateSession(req, res);
+      return sendJson(res, 200, {
+        nonce: session.nonce,
+      });
+    }
+
+    // 2. Email Verification Protocol (EVP) & Rewards Sign-Up Verification Endpoints
+    if (
+      req.method === 'POST' &&
+      (pathname === '/verify-email' ||
+        pathname === '/api/verify-email' ||
+        pathname === '/api/rewards/signup' ||
+        pathname === '/rewards/signup' ||
+        pathname === '/signup')
+    ) {
+      return handleVerificationAndSignup(req, res);
+    }
+
+    // 3. Homepage with Server-Injected Session Nonce
+    if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+      try {
+        const session = getOrCreateSession(req, res);
+        const indexPath = path.join(__dirname, 'index.html');
+        let html = await fs.readFile(indexPath, 'utf8');
+
+        // Inject the dynamic server-side session nonce into the autocomplete="email-verification-token" input
+        html = html.replace(
+          /(<input[^>]*autocomplete=["']email-verification-token["'][^>]*nonce=["'])[^"']*(['"][^>]*>)/i,
+          `$1${session.nonce}$2`
+        );
+        html = html.replace(
+          /(<input[^>]*nonce=["'])[^"']*(['"][^>]*autocomplete=["']email-verification-token["'][^>]*>)/i,
+          `$1${session.nonce}$2`
+        );
+
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Cache-Control': 'no-store',
+        });
+        return res.end(html);
+      } catch (err) {
+        res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+        return res.end(`Failed to load homepage: ${err.message}`);
+      }
+    }
+
+    res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ error: 'Not Found' }));
+  });
+}
+
+function resolvePort() {
+  const args = process.argv.slice(2);
+  const portFlagIndex = args.indexOf('--port');
+  if (portFlagIndex !== -1 && args[portFlagIndex + 1]) {
+    const parsed = Number(args[portFlagIndex + 1]);
+    if (!Number.isNaN(parsed) && parsed > 0) return parsed;
+  }
+  return Number(process.env.PORT) || 11222;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = resolvePort();
+  const server = createServer();
+  server.listen(port, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${port}`);
+  });
+}
