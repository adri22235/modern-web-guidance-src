index 0000000..396e987
--- /dev/null
+++ b/verify-evt.js
@@ -0,0 +1,334 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeJwt, decodeProtectedHeader, importJWK, jwtVerify } from 'jose';
+
+/**
+ * Normalize an issuer string or origin so that DNS TXT `iss=accounts.google.com`
+ * and JWT `iss: "https://accounts.google.com"` can be compared reliably.
+ */
+export function normalizeIssuerHost(issuer) {
+  if (!issuer || typeof issuer !== 'string') return '';
+  const trimmed = issuer.trim().replace(/\/+$/, '');
+  try {
+    if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
+      return new URL(trimmed).host.toLowerCase();
+    }
+  } catch {
+    // Fall through to host normalization
+  }
+  return trimmed.replace(/^https?:\/\//i, '').toLowerCase();
+}
+
+export function normalizeIssuerOrigin(issuer) {
+  if (!issuer || typeof issuer !== 'string') return '';
+  const trimmed = issuer.trim().replace(/\/+$/, '');
+  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
+    return trimmed;
+  }
+  return `https://${trimmed}`;
+}
+
+/**
+ * Resolve selectively disclosed claims if SD-JWT disclosures are included between
+ * the EVT JWT and the Key Binding JWT (`<evtJwt>~<disclosure1>~...~<kbJwt>`).
+ */
+function resolveSelectiveDisclosures(evtPayload, disclosures) {
+  const resolved = { ...evtPayload };
+  if (!Array.isArray(disclosures) || disclosures.length === 0) {
+    return resolved;
+  }
+
+  const sdDigests = new Set(Array.isArray(evtPayload._sd) ? evtPayload._sd : []);
+  for (const rawDisclosure of disclosures) {
+    if (!rawDisclosure) continue;
+    const digest = createHash('sha256').update(rawDisclosure).digest('base64url');
+    if (sdDigests.size > 0 && !sdDigests.has(digest)) {
+      throw new Error('Selective disclosure digest not present in EVT _sd claim.');
+    }
+    const decodedJson = Buffer.from(rawDisclosure, 'base64url').toString('utf8');
+    const parsed = JSON.parse(decodedJson);
+    // Standard SD-JWT object property disclosure: [salt, claimName, claimValue]
+    if (Array.isArray(parsed) && parsed.length === 3 && typeof parsed[1] === 'string') {
+      resolved[parsed[1]] = parsed[2];
+    }
+  }
+  return resolved;
+}
+
+/**
+ * Constant-time string comparison helper for cryptographic digests and nonces.
+ */
+function safeCompareStrings(a, b) {
+  if (typeof a !== 'string' || typeof b !== 'string') return false;
+  const bufA = Buffer.from(a, 'utf8');
+  const bufB = Buffer.from(b, 'utf8');
+  if (bufA.length !== bufB.length) return false;
+  return timingSafeEqual(bufA, bufB);
+}
+
+/**
+ * Validates an Email Verification Protocol (EVP) token package (`SD-JWT+KB`)
+ * following the 5-step verification specification:
+ *  1. Parse the token (`evtJwt` and `kbJwt` separated by `~`)
+ *  2. Validate expected values (`email_verified`, `email`, `nonce`, `aud`, `iat`)
+ *  3. Validate key binding (`cnf.jwk` signature on `kbJwt` and `sd_hash` over `evtJwt~`)
+ *  4. Validate DNS TXT record (`_email-verification.<email-domain>`)
+ *  5. Discover the issuer (`/.well-known/email-verification`) and verify the EVT signature via JWKS
+ *
+ * @param {object} options
+ * @param {string} options.rawToken - Raw token package from `<input autocomplete="email-verification-token">`
+ * @param {string} options.expectedEmail - Email address submitted in the registration form
+ * @param {string} options.expectedNonce - Server-generated session-bound nonce from the form
+ * @param {string} options.expectedOrigin - Relying Party origin (`aud`)
+ * @param {number} [options.maxAgeSeconds=300] - Maximum acceptable age for `iat` timestamps
+ * @param {typeof dns.resolveTxt} [options.resolveTxt=dns.resolveTxt] - DNS TXT resolver (injectable for testing)
+ * @param {typeof fetch} [options.fetchImpl=globalThis.fetch] - Fetch implementation (injectable for testing)
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  expectedEmail,
+  expectedNonce,
+  expectedOrigin,
+  maxAgeSeconds = 300,
+  resolveTxt = dns.resolveTxt.bind(dns),
+  fetchImpl = globalThis.fetch,
+}) {
+  if (!rawToken || typeof rawToken !== 'string') {
+    throw new Error('Missing email verification token.');
+  }
+  if (!expectedEmail || typeof expectedEmail !== 'string') {
+    throw new Error('Missing expected email address.');
+  }
+  if (!expectedNonce || typeof expectedNonce !== 'string') {
+    throw new Error('Missing expected session nonce.');
+  }
+  if (!expectedOrigin || typeof expectedOrigin !== 'string') {
+    throw new Error('Missing expected site origin.');
+  }
+
+  // ============================================================================
+  // Step 1: Parse the token (SD-JWT+KB separated by '~')
+  // ============================================================================
+  const parts = rawToken.trim().split('~');
+  if (parts.length < 2) {
+    throw new Error('Invalid EVT format: expected SD-JWT+KB token separated by "~".');
+  }
+
+  const evtJwt = parts[0];
+  const kbJwt = parts[parts.length - 1];
+  const disclosures = parts.slice(1, -1).filter(Boolean);
+
+  if (!evtJwt || !kbJwt) {
+    throw new Error('Invalid EVT package: both EVT and Key Binding JWT (KB-JWT) are required.');
+  }
+
+  const evtHeader = decodeProtectedHeader(evtJwt);
+  const rawEvtPayload = decodeJwt(evtJwt);
+  const evtJwtDecodedPayload = resolveSelectiveDisclosures(rawEvtPayload, disclosures);
+
+  const kbHeader = decodeProtectedHeader(kbJwt);
+  const kbJwtDecodedPayload = decodeJwt(kbJwt);
+
+  if (evtHeader.typ && evtHeader.typ !== 'evt+jwt' && evtHeader.typ !== 'JWT') {
+    throw new Error(`Unexpected EVT header typ: ${evtHeader.typ}`);
+  }
+  if (kbHeader.typ && kbHeader.typ !== 'kb+jwt' && kbHeader.typ !== 'JWT') {
+    throw new Error(`Unexpected KB-JWT header typ: ${kbHeader.typ}`);
+  }
+
+  // ============================================================================
+  // Step 2: Validate expected values
+  // ============================================================================
+  if (evtJwtDecodedPayload.email_verified !== true) {
+    throw new Error('Email address is not marked as verified (email_verified !== true).');
+  }
+
+  const normalizedSubmittedEmail = expectedEmail.trim().toLowerCase();
+  const normalizedTokenEmail =
+    typeof evtJwtDecodedPayload.email === 'string'
+      ? evtJwtDecodedPayload.email.trim().toLowerCase()
+      : '';
+
+  if (!normalizedTokenEmail || normalizedTokenEmail !== normalizedSubmittedEmail) {
+    throw new Error('Token email claim does not match the submitted email address.');
+  }
+
+  if (!safeCompareStrings(String(kbJwtDecodedPayload.nonce || ''), expectedNonce)) {
+    throw new Error('Key Binding JWT nonce does not match the session nonce.');
+  }
+
+  const normalizedAud = String(kbJwtDecodedPayload.aud || '').replace(/\/+$/, '').toLowerCase();
+  const normalizedOrigin = expectedOrigin.replace(/\/+$/, '').toLowerCase();
+  if (!normalizedAud || normalizedAud !== normalizedOrigin) {
+    throw new Error(
+      `Key Binding JWT audience (${kbJwtDecodedPayload.aud}) does not match expected origin (${expectedOrigin}).`
+    );
+  }
+
+  const nowSeconds = Math.floor(Date.now() / 1000);
+  const clockSkewSeconds = 60;
+
+  for (const [label, payload] of [
+    ['EVT', evtJwtDecodedPayload],
+    ['KB-JWT', kbJwtDecodedPayload],
+  ]) {
+    if (typeof payload.iat !== 'number') {
+      throw new Error(`Missing iat timestamp in ${label}.`);
+    }
+    if (payload.iat > nowSeconds + clockSkewSeconds) {
+      throw new Error(`${label} iat timestamp is in the future.`);
+    }
+    if (nowSeconds - payload.iat > maxAgeSeconds) {
+      throw new Error(`${label} token has expired (iat outside acceptable window).`);
+    }
+    if (typeof payload.exp === 'number' && nowSeconds - clockSkewSeconds >= payload.exp) {
+      throw new Error(`${label} token exp claim has passed.`);
+    }
+  }
+
+  // ============================================================================
+  // Step 3: Validate key binding (cnf.jwk signature & sd_hash)
+  // ============================================================================
+  const cnfJwk = evtJwtDecodedPayload.cnf?.jwk;
+  if (!cnfJwk || typeof cnfJwk !== 'object') {
+    throw new Error('Missing browser ephemeral key (cnf.jwk) in EVT payload.');
+  }
+
+  const signedSdPrefix = `${ parts.slice(0, -1).join('~') }~`;
+  const calculatedHash = createHash('sha256')
+    .update(signedSdPrefix)
+    .digest('base64url');
+
+  if (!safeCompareStrings(String(kbJwtDecodedPayload.sd_hash || ''), calculatedHash)) {
+    throw new Error('Key Binding JWT sd_hash does not match SHA-256 hash of EVT.');
+  }
+
+  const ephemeralPublicKey = await importJWK(cnfJwk, kbHeader.alg);
+  await jwtVerify(kbJwt, ephemeralPublicKey, {
+    audience: expectedOrigin,
+  });
+
+  // ============================================================================
+  // Step 4: Validate DNS record (_email-verification.<email-domain>)
+  // ============================================================================
+  const atIndex = normalizedTokenEmail.lastIndexOf('@');
+  if (atIndex === -1 || atIndex === normalizedTokenEmail.length - 1) {
+    throw new Error('Invalid email address domain.');
+  }
+  const emailDomain = normalizedTokenEmail.slice(atIndex + 1);
+  const dnsRecordName = `_email-verification.${emailDomain}`;
+
+  let txtRecords;
+  try {
+    txtRecords = await resolveTxt(dnsRecordName);
+  } catch (err) {
+    throw new Error(
+      `Failed to resolve DNS TXT record for ${dnsRecordName}: ${err.message || err}`
+    );
+  }
+
+  const flattenedRecords = (Array.isArray(txtRecords) ? txtRecords : [])
+    .map((chunks) => (Array.isArray(chunks) ? chunks.join('') : String(chunks)).trim())
+    .filter((entry) => entry.startsWith('iss='));
+
+  if (flattenedRecords.length !== 1) {
+    throw new Error(
+      `Expected exactly one _email-verification TXT record with "iss=" for ${emailDomain}, found ${flattenedRecords.length}.`
+    );
+  }
+
+  const dnsIssuerValue = flattenedRecords[0].slice('iss='.length).trim();
+  const dnsIssuerHost = normalizeIssuerHost(dnsIssuerValue);
+  const tokenIssuerHost = normalizeIssuerHost(evtJwtDecodedPayload.iss);
+
+  if (!dnsIssuerHost || dnsIssuerHost !== tokenIssuerHost) {
+    throw new Error(
+      `EVT issuer (${evtJwtDecodedPayload.iss}) does not match authoritative DNS issuer (${dnsIssuerValue}).`
+    );
+  }
+
+  // ============================================================================
+  // Step 5: Discover the issuer and verify the EVT signature via JWKS
+  // ============================================================================
+  const issuerOrigin = normalizeIssuerOrigin(evtJwtDecodedPayload.iss);
+  const wellKnownUrl = new URL('/.well-known/email-verification', issuerOrigin).toString();
+
+  const metadataResponse = await fetchImpl(wellKnownUrl, {
+    headers: { Accept: 'application/json' },
+  });
+  if (!metadataResponse.ok) {
+    throw new Error(
+      `Failed to fetch issuer metadata from ${wellKnownUrl} (HTTP ${metadataResponse.status}).`
+    );
+  }
+
+  const issuerMetadata = await metadataResponse.json();
+  if (!issuerMetadata || typeof issuerMetadata.jwks_uri !== 'string') {
+    throw new Error('Issuer metadata is missing a valid jwks_uri.');
+  }
+
+  if (
+    Array.isArray(issuerMetadata.signing_alg_values_supported) &&
+    evtHeader.alg &&
+    !issuerMetadata.signing_alg_values_supported.includes(evtHeader.alg)
+  ) {
+    throw new Error(
+      `EVT signing algorithm (${evtHeader.alg}) is not in issuer signing_alg_values_supported.`
+    );
+  }
+
+  const jwksResponse = await fetchImpl(issuerMetadata.jwks_uri, {
+    headers: { Accept: 'application/json' },
+  });
+  if (!jwksResponse.ok) {
+    throw new Error(
+      `Failed to fetch issuer JWKS from ${issuerMetadata.jwks_uri} (HTTP ${jwksResponse.status}).`
+    );
+  }
+
+  const jwksData = await jwksResponse.json();
+  const keys = Array.isArray(jwksData?.keys) ? jwksData.keys : [];
+  if (keys.length === 0) {
+    throw new Error('Issuer JWKS does not contain any public keys.');
+  }
+
+  // Filter candidate keys by kid if provided, otherwise fall back to iterating all keys
+  // (e.g., for providers such as Gmail that may omit kid in the EVT header).
+  const candidateKeys = evtHeader.kid
+    ? keys.filter((k) => k.kid === evtHeader.kid)
+    : keys;
+  const keysToTry = candidateKeys.length > 0 ? candidateKeys : keys;
+
+  let evtVerified = false;
+  let lastVerifyError = null;
+
+  for (const jwk of keysToTry) {
+    try {
+      const alg = jwk.alg || evtHeader.alg;
+      const publicKey = await importJWK(jwk, alg);
+      await jwtVerify(evtJwt, publicKey, {
+        issuer: evtJwtDecodedPayload.iss,
+      });
+      evtVerified = true;
+      break;
+    } catch (err) {
+      lastVerifyError = err;
+    }
+  }
+
+  if (!evtVerified) {
+    throw new Error(
+      `EVT cryptographic signature verification failed: ${
+        lastVerifyError ? lastVerifyError.message : 'no matching key in issuer JWKS'
+      }`
+    );
+  }
+
+  return {
+    verified: true,
+    email: evtJwtDecodedPayload.email,
+    issuer: evtJwtDecodedPayload.iss,
+    evtJwtDecodedPayload,
+    kbJwtDecodedPayload,
+  };
+}
