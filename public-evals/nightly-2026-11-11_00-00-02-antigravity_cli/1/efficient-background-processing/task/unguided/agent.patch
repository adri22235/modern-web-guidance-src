+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const stageLabelEl = document.getElementById('roast-stage-label');
+      const statusLabelEl = document.getElementById('roast-status-label');
+
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext && canvas.getContext('2d');
+
+      let currentTemp = 385;
+      let tempDirection = 1;
+      const minTemp = 370;
+      const maxTemp = 445;
+
+      let rafId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+      let frameCount = 0;
+      let drumAngle = 0;
+
+      const beans = Array.from({ length: 28 }, (_, i) => {
+        const angle = (i / 28) * Math.PI * 2;
+        const dist = 30 + (i % 5) * 20;
+        return {
+          x: canvas.width / 2 + Math.cos(angle) * dist,
+          y: canvas.height / 2 + Math.sin(angle) * dist,
+          vx: (Math.cos(angle + 1.2) * 1.8) + ((i % 3) - 1) * 0.4,
+          vy: (Math.sin(angle + 1.2) * 1.6) - 0.5,
+          rx: 12 + (i % 4) * 1.5,
+          ry: 8 + (i % 3) * 1.2,
+          rotation: (i * 0.45) % (Math.PI * 2),
+          vRotation: (i % 2 === 0 ? 1 : -1) * (0.04 + (i % 4) * 0.015),
+          shadeOffset: (i % 5) * 4 - 8
+        };
+      });
+
+      function getStageInfo(temp) {
+        if (temp < 385) return 'Drying & Yellowing';
+        if (temp < 405) return 'First Crack · Cinnamon';
+        if (temp < 425) return 'First Crack · Medium';
+        if (temp < 438) return 'Full City · Rich Caramel';
+        return 'Second Crack · Dark Roast';
+      }
+
+      function getBeanColor(temp, offset) {
+        const t = Math.max(0, Math.min(1, (temp - minTemp) / (maxTemp - minTemp)));
+        const r = Math.max(35, Math.min(210, Math.round(165 - t * 105 + offset)));
+        const g = Math.max(20, Math.min(160, Math.round(115 - t * 80 + offset * 0.7)));
+        const b = Math.max(12, Math.min(110, Math.round(68 - t * 48 + offset * 0.5)));
+        return 'rgb(' + r + ', ' + g + ', ' + b + ')';
+      }
+
+      function drawRoasterScene() {
+        if (!ctx) return;
+
+        const w = canvas.width;
+        const h = canvas.height;
+        const cx = w / 2;
+        const cy = h / 2;
+        const drumRadius = Math.min(w, h) * 0.43;
+
+        ctx.clearRect(0, 0, w, h);
+
+        // Background thermal glow
+        const bgGrad = ctx.createRadialGradient(cx, cy + 30, 15, cx, cy, drumRadius * 1.25);
+        bgGrad.addColorStop(0, '#3e1e10');
+        bgGrad.addColorStop(0.65, '#1f100a');
+        bgGrad.addColorStop(1, '#120906');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, w, h);
+
+        // Roaster drum ring
+        ctx.save();
+        ctx.beginPath();
+        ctx.arc(cx, cy, drumRadius, 0, Math.PI * 2);
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.35)';
+        ctx.lineWidth = 6;
+        ctx.stroke();
+
+        // Rotating drum paddles
+        for (let i = 0; i < 6; i++) {
+          const pAngle = drumAngle + (i * Math.PI) / 3;
+          const x1 = cx + Math.cos(pAngle) * (drumRadius - 18);
+          const y1 = cy + Math.sin(pAngle) * (drumRadius - 18);
+          const x2 = cx + Math.cos(pAngle) * drumRadius;
+          const y2 = cy + Math.sin(pAngle) * drumRadius;
+          ctx.beginPath();
+          ctx.moveTo(x1, y1);
+          ctx.lineTo(x2, y2);
+          ctx.strokeStyle = 'rgba(215, 204, 200, 0.35)';
+          ctx.lineWidth = 3;
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Draw roasting coffee beans
+        for (let i = 0; i < beans.length; i++) {
+          const bean = beans[i];
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.rotation);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = getBeanColor(currentTemp, bean.shadeOffset);
+          ctx.fill();
+          ctx.lineWidth = 1.5;
+          ctx.strokeStyle = '#1b0d08';
+          ctx.stroke();
+
+          // Bean highlight
+          ctx.beginPath();
+          ctx.ellipse(-bean.rx * 0.2, -bean.ry * 0.28, bean.rx * 0.45, bean.ry * 0.22, -0.2, 0, Math.PI * 2);
+          ctx.fillStyle = 'rgba(255, 235, 215, 0.14)';
+          ctx.fill();
+
+          // Center roast crease
+          ctx.beginPath();
+          ctx.moveTo(-bean.rx * 0.78, 0);
+          ctx.bezierCurveTo(
+            -bean.rx * 0.25,
+            bean.ry * 0.35,
+            bean.rx * 0.25,
+            -bean.ry * 0.35,
+            bean.rx * 0.78,
+            0
+          );
+          ctx.strokeStyle = '#160904';
+          ctx.lineWidth = 1.8;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function stepPhysics() {
+        const cx = canvas.width / 2;
+        const cy = canvas.height / 2;
+        const maxDist = Math.min(canvas.width, canvas.height) * 0.36;
+
+        drumAngle += 0.025;
+        frameCount += 1;
+        widget.dataset.frame = String(frameCount);
+
+        for (let i = 0; i < beans.length; i++) {
+          const bean = beans[i];
+          // Add slight swirl + gravity inside tumbling drum
+          const dx = bean.x - cx;
+          const dy = bean.y - cy;
+          bean.vx += (-dy * 0.0008);
+          bean.vy += (dx * 0.0008) + 0.04;
+
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.rotation += bean.vRotation;
+
+          const distSq = (bean.x - cx) * (bean.x - cx) + (bean.y - cy) * (bean.y - cy);
+          if (distSq > maxDist * maxDist) {
+            const dist = Math.sqrt(distSq) || 1;
+            const nx = (bean.x - cx) / dist;
+            const ny = (bean.y - cy) / dist;
+            bean.x = cx + nx * maxDist;
+            bean.y = cy + ny * maxDist;
+            const dot = bean.vx * nx + bean.vy * ny;
+            bean.vx = (bean.vx - 1.85 * dot * nx) - ny * 0.6;
+            bean.vy = (bean.vy - 1.85 * dot * ny) + nx * 0.6;
+          }
+
+          // Clamp speed
+          const speed = Math.sqrt(bean.vx * bean.vx + bean.vy * bean.vy);
+          if (speed > 3.5) {
+            bean.vx = (bean.vx / speed) * 3.5;
+            bean.vy = (bean.vy / speed) * 3.5;
+          } else if (speed < 0.8) {
+            bean.vx *= 1.2;
+            bean.vy = (bean.vy || -0.8) * 1.2;
+          }
+        }
+      }
+
+      function animateLoop() {
+        if (!isRunning) {
+          rafId = null;
+          return;
+        }
+        stepPhysics();
+        drawRoasterScene();
+        rafId = window.requestAnimationFrame(animateLoop);
+      }
+
+      function updateTemperature() {
+        if (!isRunning) return;
+        currentTemp += tempDirection * 2;
+        if (currentTemp >= maxTemp) {
+          currentTemp = maxTemp;
+          tempDirection = -1;
+        } else if (currentTemp <= minTemp) {
+          currentTemp = minTemp;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = String(currentTemp);
+        if (stageLabelEl) {
+          stageLabelEl.textContent = getStageInfo(currentTemp);
+        }
+      }
+
+      function pauseSimulation() {
+        isRunning = false;
+        widget.dataset.state = 'paused';
+        widget.dataset.paused = 'true';
+        if (statusLabelEl) {
+          statusLabelEl.textContent = 'Paused (Off-screen)';
+        }
+        if (rafId !== null) {
+          window.cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (tempIntervalId !== null) {
+          window.clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      function resumeSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        widget.dataset.state = 'running';
+        widget.dataset.paused = 'false';
+        if (statusLabelEl) {
+          statusLabelEl.textContent = 'Live Roasting';
+        }
+        if (rafId === null) {
+          rafId = window.requestAnimationFrame(animateLoop);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = window.setInterval(updateTemperature, 200);
+        }
+      }
+
+      // Render initial frame and start simulation
+      drawRoasterScene();
+      resumeSimulation();
+
+      let hasSkippedContentVisibility = false;
+      let isIntersectingViewport = true;
+
+      const supportsContentVisibilityStateChange =
+        'oncontentvisibilityautostatechange' in window ||
+        'ContentVisibilityAutoStateChangeEvent' in window;
+
+      // Primary native rendering state change handler (content-visibility: auto)
+      widget.addEventListener('contentvisibilityautostatechange', function (event) {
+        if (event.skipped) {
+          hasSkippedContentVisibility = true;
+          pauseSimulation();
+        } else if (hasSkippedContentVisibility || !event.isTrusted || isIntersectingViewport) {
+          hasSkippedContentVisibility = false;
+          resumeSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver (or scroll/resize listeners) for browsers lacking
+      // native rendering state change support and to track viewport entry/exit accurately
+      if (!supportsContentVisibilityStateChange || 'IntersectionObserver' in window) {
+        if ('IntersectionObserver' in window) {
+          const observer = new window.IntersectionObserver(
+            function (entries) {
+              for (let i = 0; i < entries.length; i++) {
+                const entry = entries[i];
+                if (entry.target !== widget) continue;
+                isIntersectingViewport = Boolean(entry.isIntersecting);
+                if (entry.isIntersecting) {
+                  resumeSimulation();
+                } else {
+                  pauseSimulation();
+                }
+              }
+            },
+            { root: null, threshold: 0 }
+          );
+          observer.observe(widget);
+        } else {
+          function checkViewportBounds() {
+            const rect = widget.getBoundingClientRect();
+            const vh = window.innerHeight || document.documentElement.clientHeight || 0;
+            const vw = window.innerWidth || document.documentElement.clientWidth || 0;
+            const visible = rect.bottom > 0 && rect.top < vh && rect.right > 0 && rect.left < vw;
+            isIntersectingViewport = visible;
+            if (visible) {
+              resumeSimulation();
+            } else {
+              pauseSimulation();
+            }
+          }
+          window.addEventListener('scroll', checkViewportBounds, { passive: true });
+          window.addEventListener('resize', checkViewportBounds, { passive: true });
+          checkViewportBounds();
+        }
+      }
+    })();
+  </script>
