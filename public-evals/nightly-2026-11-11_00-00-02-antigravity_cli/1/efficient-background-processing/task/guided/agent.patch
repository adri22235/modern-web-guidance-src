+  <script>
+    (function () {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const stageEl = document.getElementById('roast-stage');
+      if (!roastingWidget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let currentTemp = 405.0;
+      let tempDirection = 1;
+      let drumAngle = 0;
+
+      const beanColors = ['#6d4c41', '#5d4037', '#4e342e', '#3e2723', '#795548'];
+      const beans = Array.from({ length: 28 }, (_, i) => {
+        const angle = (i / 28) * Math.PI * 2;
+        const dist = 25 + (i % 5) * 18;
+        return {
+          x: canvas.width / 2 + Math.cos(angle) * dist,
+          y: canvas.height / 2 + Math.sin(angle) * dist,
+          vx: (Math.random() - 0.5) * 2.2,
+          vy: (Math.random() - 0.5) * 2.2,
+          rx: 10 + (i % 3) * 1.5,
+          ry: 6.5 + (i % 2) * 1.2,
+          rotation: Math.random() * Math.PI * 2,
+          vRot: (Math.random() - 0.5) * 0.08,
+          color: beanColors[i % beanColors.length]
+        };
+      });
+
+      function drawRoasterFrame() {
+        if (!ctx) return;
+        const w = canvas.width;
+        const h = canvas.height;
+        const cx = w / 2;
+        const cy = h / 2;
+        const drumRadius = Math.min(w, h) * 0.42;
+
+        ctx.clearRect(0, 0, w, h);
+
+        // Warm thermal glow underneath drum
+        const glow = ctx.createRadialGradient(cx, cy + drumRadius * 0.55, 10, cx, cy, drumRadius * 1.25);
+        glow.addColorStop(0, 'rgba(255, 138, 50, 0.35)');
+        glow.addColorStop(0.6, 'rgba(78, 52, 46, 0.15)');
+        glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, w, h);
+
+        // Rotating drum outline and paddles
+        drumAngle += 0.015;
+        ctx.save();
+        ctx.translate(cx, cy);
+        ctx.rotate(drumAngle);
+
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.55)';
+        ctx.lineWidth = 4;
+        ctx.beginPath();
+        ctx.arc(0, 0, drumRadius, 0, Math.PI * 2);
+        ctx.stroke();
+
+        for (let i = 0; i < 6; i++) {
+          const pAngle = (i * Math.PI) / 3;
+          ctx.beginPath();
+          ctx.moveTo(Math.cos(pAngle) * (drumRadius - 14), Math.sin(pAngle) * (drumRadius - 14));
+          ctx.lineTo(Math.cos(pAngle) * drumRadius, Math.sin(pAngle) * drumRadius);
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Update and draw tumbling coffee beans
+        beans.forEach((bean) => {
+          // Gentle gravity + rotational agitation from drum
+          bean.vy += 0.06;
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.rotation += bean.vRot;
+
+          const dx = bean.x - cx;
+          const dy = bean.y - cy;
+          const dist = Math.hypot(dx, dy);
+          const maxDist = drumRadius - bean.rx - 4;
+
+          if (dist > maxDist && dist > 0) {
+            const nx = dx / dist;
+            const ny = dy / dist;
+            bean.x = cx + nx * maxDist;
+            bean.y = cy + ny * maxDist;
+            // Bounce inward with tangential boost from rotating drum
+            const dot = bean.vx * nx + bean.vy * ny;
+            bean.vx = (bean.vx - 1.7 * dot * nx) * 0.85 - ny * 1.1;
+            bean.vy = (bean.vy - 1.7 * dot * ny) * 0.85 + nx * 1.1;
+          }
+
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.rotation);
+
+          // Bean body
+          ctx.fillStyle = bean.color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+          ctx.fill();
+
+          // Bean center crease
+          ctx.strokeStyle = '#24140e';
+          ctx.lineWidth = 1.4;
+          ctx.beginPath();
+          ctx.moveTo(-bean.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, bean.ry * 0.35, bean.rx * 0.7, 0);
+          ctx.stroke();
+
+          ctx.restore();
+        });
+      }
+
+      function animationLoop() {
+        drawRoasterFrame();
+        animationFrameId = requestAnimationFrame(animationLoop);
+      }
+
+      function updateTemperature() {
+        const delta = (Math.random() * 1.4 + 0.3) * tempDirection;
+        currentTemp = Math.round((currentTemp + delta) * 10) / 10;
+
+        if (currentTemp >= 432) {
+          tempDirection = -1;
+        } else if (currentTemp <= 396) {
+          tempDirection = 1;
+        }
+
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+
+        if (stageEl) {
+          if (currentTemp < 405) {
+            stageEl.textContent = 'Maillard Phase';
+          } else if (currentTemp < 420) {
+            stageEl.textContent = 'First Crack';
+          } else {
+            stageEl.textContent = 'Medium-Dark Roast';
+          }
+        }
+      }
+
+      function startSimulation() {
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(animationLoop);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 1000);
+        }
+      }
+
+      function stopSimulation() {
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Start initially; native or fallback visibility handlers will pause immediately if off-screen
+      startSimulation();
+
+      // Listen for native rendering state changes via content-visibility: auto
+      roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver for older browsers lacking content-visibility support
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(roastingWidget);
+      }
+    })();
+  </script>
