+  <script>
+    (function () {
+      const ALLOWED_TAGS = new Set([
+        'div', 'section', 'article', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
+        'p', 'span', 'a', 'img', 'ul', 'ol', 'li', 'strong', 'em', 'b', 'i', 'br'
+      ]);
+      const VOID_TAGS = new Set(['img', 'br']);
+      const ALLOWED_ATTRS = new Set(['class', 'id', 'href', 'src', 'alt', 'title', 'role', 'aria-label']);
+      const URL_ATTRS = new Set(['href', 'src']);
+
+      function escapeText(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;');
+      }
+
+      function escapeAttr(str) {
+        return escapeText(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+      }
+
+      function isSafeUrl(value) {
+        const cleaned = String(value).replace(/[\u0000-\u0020]+/g, '');
+        if (!cleaned) return false;
+        if (cleaned.startsWith('/') || cleaned.startsWith('#') || cleaned.startsWith('./') || cleaned.startsWith('../')) {
+          return !cleaned.startsWith('//');
+        }
+        try {
+          const parsed = new URL(cleaned);
+          return parsed.protocol === 'http:' || parsed.protocol === 'https:';
+        } catch {
+          return false;
+        }
+      }
+
+      function sanitizeAttributes(attrString) {
+        if (!attrString) return '';
+        let result = '';
+        const attrRegex = /([a-zA-Z][a-zA-Z0-9:-]*)\s*(?:=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
+        let match;
+        while ((match = attrRegex.exec(attrString)) !== null) {
+          const name = match[1].toLowerCase();
+          if (name.startsWith('on') || !ALLOWED_ATTRS.has(name)) {
+            continue;
+          }
+          const rawVal = match[2] ?? match[3] ?? match[4] ?? '';
+          if (URL_ATTRS.has(name) && !isSafeUrl(rawVal)) {
+            continue;
+          }
+          result += ` ${name}="${escapeAttr(rawVal)}"`;
+        }
+        return result;
+      }
+
+      function sanitizeHTML(dirty) {
+        const stripped = String(dirty)
+          .replace(/<!--[\s\S]*?-->/g, '')
+          .replace(/<(script|style|iframe|object|embed|svg|math|template|noscript)\b[^>]*>[\s\S]*?<\/\1>/gi, '');
+
+        const tokenRegex = /<\/?([a-zA-Z][a-zA-Z0-9:-]*)(\s[^>]*)?\s*\/?>|([^<]+)|</g;
+        let output = '';
+        let match;
+
+        while ((match = tokenRegex.exec(stripped)) !== null) {
+          const [fullMatch, rawTagName, rawAttrs, textNode] = match;
+          if (textNode !== undefined) {
+            output += escapeText(textNode);
+            continue;
+          }
+          if (!rawTagName) {
+            output += '&lt;';
+            continue;
+          }
+          const tagName = rawTagName.toLowerCase();
+          if (!ALLOWED_TAGS.has(tagName)) {
+            continue;
+          }
+          const isClosing = fullMatch.startsWith('</');
+          if (isClosing) {
+            if (!VOID_TAGS.has(tagName)) {
+              output += `</${tagName}>`;
+            }
+          } else {
+            const safeAttrs = sanitizeAttributes(rawAttrs);
+            output += `<${tagName}${safeAttrs}>`;
+          }
+        }
+
+        return output;
+      }
+
+      const policy = window.trustedTypes && window.trustedTypes.createPolicy
+        ? window.trustedTypes.createPolicy('seasonal-cards', {
+            createHTML: (input) => sanitizeHTML(input)
+          })
+        : {
+            createHTML: (input) => sanitizeHTML(input)
+          };
+
+      const seasonalFavoritesHTML = [
+        `<div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>`,
+        `<div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>`,
+        `<div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>`
+      ];
+
+      const grid = document.querySelector('.grid');
+      if (grid) {
+        grid.innerHTML = policy.createHTML(seasonalFavoritesHTML.join('\n'));
+      }
+    })();
+  </script>
+
