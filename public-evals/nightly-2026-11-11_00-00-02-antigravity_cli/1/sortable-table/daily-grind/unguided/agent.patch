+  <script>
+    (function () {
+      const table = document.getElementById('seasonal-drinks');
+      if (!table) return;
+
+      const headers = table.querySelectorAll('thead th');
+      const tbody = table.querySelector('tbody');
+      let currentCol = -1;
+      let ascending = true;
+
+      function parseCellValue(text) {
+        const cleaned = text.replace(/[^0-9.-]+/g, '');
+        if (cleaned !== '' && !isNaN(Number(cleaned)) && /^[\s$€£¥+-]*\d+(\.\d+)?[\s%a-zA-Z]*$/.test(text.trim())) {
+          return { isNumeric: true, value: parseFloat(cleaned), raw: text.trim().toLowerCase() };
+        }
+        return { isNumeric: false, value: text.trim().toLowerCase(), raw: text.trim().toLowerCase() };
+      }
+
+      headers.forEach((header, colIndex) => {
+        header.addEventListener('click', () => {
+          if (currentCol === colIndex) {
+            ascending = !ascending;
+          } else {
+            currentCol = colIndex;
+            ascending = true;
+          }
+
+          headers.forEach((h, i) => {
+            if (i === colIndex) {
+              h.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
+              h.setAttribute('data-sort-dir', ascending ? 'asc' : 'desc');
+            } else {
+              h.removeAttribute('aria-sort');
+              h.removeAttribute('data-sort-dir');
+            }
+          });
+
+          const rows = Array.from(tbody.querySelectorAll('tr'));
+          rows.sort((rowA, rowB) => {
+            const cellA = rowA.children[colIndex]?.textContent || '';
+            const cellB = rowB.children[colIndex]?.textContent || '';
+            const valA = parseCellValue(cellA);
+            const valB = parseCellValue(cellB);
+
+            let comparison = 0;
+            if (valA.isNumeric && valB.isNumeric) {
+              comparison = valA.value - valB.value;
+            } else {
+              comparison = valA.raw.localeCompare(valB.raw);
+            }
+
+            return ascending ? comparison : -comparison;
+          });
+
+          rows.forEach(row => tbody.appendChild(row));
+        });
+      });
+    })();
+  </script>
 </body>
 
