+          dot.setAttribute('aria-current', idx === activeIdx ? 'true' : 'false');
+        });
+        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
+        prevBtn.disabled = carousel.scrollLeft <= 6;
+        nextBtn.disabled = carousel.scrollLeft >= maxScroll - 6;
+      }
+
+      prevBtn.addEventListener('click', () => {
+        scrollToCardIndex(getActiveIndex() - 1);
+      });
+
+      nextBtn.addEventListener('click', () => {
+        scrollToCardIndex(getActiveIndex() + 1);
+      });
+
+      dots.forEach((dot) => {
+        dot.addEventListener('click', () => {
+          const slideIndex = Number(dot.getAttribute('data-slide') || 0);
+          scrollToCardIndex(slideIndex);
+        });
+      });
+
+      carousel.addEventListener('scroll', () => {
+        window.requestAnimationFrame(updateCarouselControls);
+      }, { passive: true });
+
+      window.addEventListener('resize', updateCarouselControls);
+      updateCarouselControls();
+
+      // Keyboard navigation when focused inside or on the carousel
+      carousel.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowRight') {
+          e.preventDefault();
+          scrollToCardIndex(getActiveIndex() + 1);
+        } else if (e.key === 'ArrowLeft') {
+          e.preventDefault();
+          scrollToCardIndex(getActiveIndex() - 1);
+        } else if (e.key === 'Home') {
+          e.preventDefault();
+          scrollToCardIndex(0);
+        } else if (e.key === 'End') {
+          e.preventDefault();
+          scrollToCardIndex(cards.length - 1);
+        }
+      });
+
+      // Mouse / Pointer drag-to-swipe support (in addition to native touch swipe)
+      let isPointerDown = false;
+      let hasDragged = false;
+      let startX = 0;
+      let startScrollLeft = 0;
+
+      carousel.addEventListener('pointerdown', (e) => {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        // Don't hijack clicks on buttons or links inside cards
+        if (e.target.closest('button, a')) return;
+        isPointerDown = true;
+        hasDragged = false;
+        startX = e.clientX;
+        startScrollLeft = carousel.scrollLeft;
+        carousel.classList.add('is-dragging');
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!isPointerDown) return;
+        const deltaX = e.clientX - startX;
+        if (Math.abs(deltaX) > 5) {
+          hasDragged = true;
+        }
+        carousel.scrollLeft = startScrollLeft - deltaX;
+      });
+
+      function endPointerDrag() {
+        if (!isPointerDown) return;
+        isPointerDown = false;
+        carousel.classList.remove('is-dragging');
+        if (hasDragged) {
+          scrollToCardIndex(getActiveIndex());
+        }
+      }
+
+      window.addEventListener('pointerup', endPointerDrag);
+      window.addEventListener('pointercancel', endPointerDrag);
+
+      /* ----------------------------------------------------------
+       * 2. Card Favorite Button & Size Selector Feedback
+       * ---------------------------------------------------------- */
+      document.querySelectorAll('.fav-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const pressed = btn.getAttribute('aria-pressed') === 'true';
+          btn.setAttribute('aria-pressed', String(!pressed));
+          btn.innerHTML = !pressed ? '&#9829;' : '&#9825;';
+        });
+      });
+
+      const sizeBtns = Array.from(document.querySelectorAll('.size-option-btn'));
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeBtns.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
+        });
+      });
+
+      /* ----------------------------------------------------------
+       * 3. Expanding Detail View Morphing Right Out of Trigger Button
+       * ---------------------------------------------------------- */
+      const expander = document.getElementById('drink-detail-expander');
+      const backdrop = document.getElementById('detail-backdrop');
+      const closeBtn = document.getElementById('detail-close-btn');
+      const secondaryCloseBtn = document.getElementById('detail-secondary-close');
+
+      const detailImage = document.getElementById('detail-image');
+      const detailBadge = document.getElementById('detail-badge');
+      const detailPrice = document.getElementById('detail-price');
+      const detailTitle = document.getElementById('detail-title');
+      const detailDescription = document.getElementById('detail-description');
+      const detailCalories = document.getElementById('detail-calories');
+      const detailCaffeine = document.getElementById('detail-caffeine');
+      const detailRoast = document.getElementById('detail-roast');
+      const detailNotes = document.getElementById('detail-notes');
+      const detailOrderLink = document.getElementById('detail-order-link');
+
+      let activeTriggerBtn = null;
+      let isDetailOpen = false;
+      let morphTimer = null;
+
+      function populateDrinkDetail(drinkId) {
+        const data = DRINK_DATA[drinkId] || DRINK_DATA['maple-oat-latte'];
+        detailImage.src = data.image;
+        detailImage.alt = data.alt;
+        detailBadge.textContent = data.badge;
+        detailPrice.textContent = data.price;
+        detailTitle.textContent = data.title;
+        detailDescription.textContent = data.description;
+        detailCalories.textContent = data.calories;
+        detailCaffeine.textContent = data.caffeine;
+        detailRoast.textContent = data.roast;
+        detailOrderLink.href = data.href;
+
+        detailNotes.innerHTML = '';
+        data.notes.forEach((note) => {
+          const li = document.createElement('li');
+          li.textContent = note;
+          detailNotes.appendChild(li);
+        });
+      }
+
+      function getTargetDialogBox() {
+        const vw = window.innerWidth;
+        const vh = window.innerHeight;
+        const width = Math.min(540, vw - 32);
+        const height = Math.min(610, vh - 40);
+        const left = Math.round((vw - width) / 2);
+        const top = Math.round((vh - height) / 2);
+        return { top, left, width, height };
+      }
+
+      function applyBoxRect(el, rect, borderRadius) {
+        el.style.top = rect.top + 'px';
+        el.style.left = rect.left + 'px';
+        el.style.width = rect.width + 'px';
+        el.style.height = rect.height + 'px';
+        el.style.borderRadius = borderRadius;
+      }
+
+      function openDrinkDetails(triggerBtn) {
+        if (morphTimer) {
+          clearTimeout(morphTimer);
+          morphTimer = null;
+        }
+
+        const drinkId = triggerBtn.getAttribute('data-drink-id');
+        populateDrinkDetail(drinkId);
+
+        if (activeTriggerBtn && activeTriggerBtn !== triggerBtn) {
+          activeTriggerBtn.setAttribute('aria-expanded', 'false');
+          activeTriggerBtn.classList.remove('is-origin-open');
+        }
+
+        activeTriggerBtn = triggerBtn;
+        activeTriggerBtn.setAttribute('aria-expanded', 'true');
+        activeTriggerBtn.classList.add('is-origin-open');
+        isDetailOpen = true;
+
+        const originRect = triggerBtn.getBoundingClientRect();
+        const targetRect = getTargetDialogBox();
+
+        // 1. Place the expander at the exact coordinates & size of the clicked button
+        expander.style.transition = 'none';
+        expander.classList.remove('is-expanded');
+        expander.classList.add('is-visible', 'is-morphing-button');
+        expander.setAttribute('aria-hidden', 'false');
+        backdrop.classList.add('is-open');
+        backdrop.setAttribute('aria-hidden', 'false');
+
+        applyBoxRect(expander, {
+          top: originRect.top,
+          left: originRect.left,
+          width: originRect.width,
+          height: originRect.height
+        }, '8px');
+
+        // Force synchronous layout so the browser registers the starting button box
+        void expander.offsetWidth;
+
+        // 2. Smoothly transition from the trigger button geometry to the expanded dialog box
+        expander.style.transition =
+          'top 0.42s cubic-bezier(0.22, 1, 0.36, 1), ' +
+          'left 0.42s cubic-bezier(0.22, 1, 0.36, 1), ' +
+          'width 0.42s cubic-bezier(0.22, 1, 0.36, 1), ' +
+          'height 0.42s cubic-bezier(0.22, 1, 0.36, 1), ' +
+          'border-radius 0.42s cubic-bezier(0.22, 1, 0.36, 1), ' +
+          'opacity 0.2s ease';
+
+        expander.classList.remove('is-morphing-button');
+        expander.classList.add('is-expanded');
+        applyBoxRect(expander, targetRect, '16px');
+
+        morphTimer = setTimeout(() => {
+          closeBtn.focus({ preventScroll: true });
+        }, 120);
+      }
+
+      function closeDrinkDetails() {
+        if (!isDetailOpen) return;
+        isDetailOpen = false;
+
+        if (morphTimer) {
+          clearTimeout(morphTimer);
+          morphTimer = null;
+        }
+
+        backdrop.classList.remove('is-open');
+        backdrop.setAttribute('aria-hidden', 'true');
+        expander.classList.remove('is-expanded');
+        expander.classList.add('is-morphing-button');
+
+        if (activeTriggerBtn) {
+          const destRect = activeTriggerBtn.getBoundingClientRect();
+          expander.style.transition =
+            'top 0.34s cubic-bezier(0.4, 0, 0.2, 1), ' +
+            'left 0.34s cubic-bezier(0.4, 0, 0.2, 1), ' +
+            'width 0.34s cubic-bezier(0.4, 0, 0.2, 1), ' +
+            'height 0.34s cubic-bezier(0.4, 0, 0.2, 1), ' +
+            'border-radius 0.34s cubic-bezier(0.4, 0, 0.2, 1), ' +
+            'opacity 0.28s ease 0.08s';
+
+          applyBoxRect(expander, {
+            top: destRect.top,
+            left: destRect.left,
+            width: destRect.width,
+            height: destRect.height
+          }, '8px');
+        }
+
+        const btnToRestore = activeTriggerBtn;
+        if (btnToRestore) {
+          btnToRestore.setAttribute('aria-expanded', 'false');
+          btnToRestore.classList.remove('is-origin-open');
+          btnToRestore.focus({ preventScroll: true });
+        }
+
+        morphTimer = setTimeout(() => {
+          expander.classList.remove('is-visible', 'is-morphing-button');
+          expander.setAttribute('aria-hidden', 'true');
+        }, 350);
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          openDrinkDetails(btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDrinkDetails);
+      secondaryCloseBtn.addEventListener('click', closeDrinkDetails);
+      backdrop.addEventListener('click', closeDrinkDetails);
+
+      // Reposition expanded dialog on viewport resize
+      window.addEventListener('resize', () => {
+        if (!isDetailOpen) return;
+        expander.style.transition = 'none';
+        applyBoxRect(expander, getTargetDialogBox(), '16px');
+      });
+
+      // Keyboard operability: Escape to close + Focus trap inside open dialog
+      document.addEventListener('keydown', (e) => {
+        if (!isDetailOpen) return;
+
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeDrinkDetails();
+          return;
+        }
+
+        if (e.key === 'Tab') {
+          const focusables = Array.from(
+            expander.querySelectorAll('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])')
+          );
+          if (focusables.length === 0) return;
+          const first = focusables[0];
+          const last = focusables[focusables.length - 1];
+
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
