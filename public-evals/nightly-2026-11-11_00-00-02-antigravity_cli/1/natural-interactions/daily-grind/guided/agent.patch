+  <script type="module">
+    // Feature detect 'popover' on HTMLElement.prototype and conditionally load polyfill if needed.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Fallback positioning when CSS Anchor Positioning (position-area) is unsupported,
+    // and focus management when closing a detail popover from inside.
+    const supportsPositionArea = typeof CSS !== "undefined" && CSS.supports("position-area: bottom");
+
+    document.querySelectorAll(".drink-details-popover").forEach((popover) => {
+      const trigger = document.querySelector(`[popovertarget="${popover.id}"]`);
+
+      popover.addEventListener("beforetoggle", (event) => {
+        if (event.newState === "open" && !supportsPositionArea && trigger) {
+          const rect = trigger.getBoundingClientRect();
+          const top = Math.min(rect.bottom + 8, window.innerHeight - 280);
+          const left = Math.max(12, Math.min(rect.left, window.innerWidth - 332));
+          popover.style.position = "fixed";
+          popover.style.top = `${Math.max(12, top)}px`;
+          popover.style.left = `${left}px`;
+          popover.style.margin = "0";
+        }
+      });
+
+      popover.addEventListener("toggle", (event) => {
+        if (event.newState === "closed" && trigger && !popover.contains(document.activeElement)) {
+          // If focus was lost when closing via an internal button, return focus to the trigger
+          if (document.activeElement === document.body || document.activeElement === null) {
+            trigger.focus();
+          }
+        }
+      });
+    });
+  </script>
