+  <script>
+    (function () {
+      const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+      const supportsMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+
+      const gridEl = document.getElementById('seasonal-grid');
+      const statusEl = document.getElementById('reorder-status');
+      const sortAlphaBtn = document.getElementById('sort-alpha-btn');
+      const shuffleCardsBtn = document.getElementById('shuffle-cards-btn');
+      const restoreCardsBtn = document.getElementById('restore-cards-btn');
+
+      // Preserve removed card wrapper DOM nodes so restoring reuses their identity
+      const removedCardWrappers = [];
+      let extraItemCounter = 1;
+
+      function runScopedTransition(scopeEl, updateDOM) {
+        if (!supportsScopedTransition) {
+          updateDOM();
+          return;
+        }
+        const transition = scopeEl.startViewTransition(() => {
+          updateDOM();
+        });
+        transition.ready.catch(() => {});
+      }
+
+      function reorder(container, orderedNodes) {
+        const move = supportsMoveBefore
+          ? (node) => container.moveBefore(node, null)
+          : (node) => container.append(node);
+
+        for (const node of orderedNodes) {
+          move(node);
+        }
+      }
+
+      function announce(message) {
+        if (statusEl) {
+          statusEl.textContent = message;
+        }
+      }
+
+      function createCustomItemNode(id, label) {
+        const li = document.createElement('li');
+        li.dataset.id = id;
+
+        const labelSpan = document.createElement('span');
+        labelSpan.className = 'item-label';
+        labelSpan.textContent = label;
+
+        const actionsSpan = document.createElement('span');
+        actionsSpan.className = 'item-actions';
+
+        const upBtn = document.createElement('button');
+        upBtn.type = 'button';
+        upBtn.className = 'icon-btn';
+        upBtn.dataset.action = 'item-up';
+        upBtn.setAttribute('aria-label', `Move ${label} up`);
+        upBtn.textContent = '↑';
+
+        const downBtn = document.createElement('button');
+        downBtn.type = 'button';
+        downBtn.className = 'icon-btn';
+        downBtn.dataset.action = 'item-down';
+        downBtn.setAttribute('aria-label', `Move ${label} down`);
+        downBtn.textContent = '↓';
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'icon-btn danger';
+        removeBtn.dataset.action = 'item-remove';
+        removeBtn.setAttribute('aria-label', `Remove ${label}`);
+        removeBtn.textContent = '✕';
+
+        actionsSpan.append(upBtn, downBtn, removeBtn);
+        li.append(labelSpan, actionsSpan);
+        return li;
+      }
+
+      // Section-level controls (scoped to #seasonal-grid)
+      sortAlphaBtn?.addEventListener('click', () => {
+        const wrappers = Array.from(gridEl.children);
+        if (wrappers.length < 2) return;
+
+        const isAscending = sortAlphaBtn.getAttribute('aria-pressed') === 'true';
+        const nextAscending = !isAscending;
+
+        const ordered = wrappers.slice().sort((a, b) => {
+          const titleA = a.dataset.title || '';
+          const titleB = b.dataset.title || '';
+          return nextAscending
+            ? titleA.localeCompare(titleB)
+            : titleB.localeCompare(titleA);
+        });
+
+        sortAlphaBtn.setAttribute('aria-pressed', String(nextAscending));
+        sortAlphaBtn.textContent = nextAscending ? 'Sorted A–Z' : 'Sorted Z–A';
+
+        runScopedTransition(gridEl, () => {
+          reorder(gridEl, ordered);
+        });
+
+        announce(
+          `Sorted seasonal drinks ${nextAscending ? 'A to Z' : 'Z to A'}, ${ordered.length} drinks`
+        );
+      });
+
+      shuffleCardsBtn?.addEventListener('click', () => {
+        const wrappers = Array.from(gridEl.children);
+        if (wrappers.length < 2) return;
+
+        const ordered = wrappers.slice();
+        for (let i = ordered.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [ordered[i], ordered[j]] = [ordered[j], ordered[i]];
+        }
