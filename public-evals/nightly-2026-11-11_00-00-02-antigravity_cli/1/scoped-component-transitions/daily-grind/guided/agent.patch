+          const hadFocus = wrapperEl.contains(document.activeElement);
+          const nextFocusTarget =
+            wrapperEl.nextElementSibling?.querySelector('button') ??
+            wrapperEl.previousElementSibling?.querySelector('button') ??
+            restoreCardsBtn ??
+            sortAlphaBtn;
+
+          removedCardWrappers.push(wrapperEl);
+          if (restoreCardsBtn) restoreCardsBtn.hidden = false;
+
+          runScopedTransition(gridEl, () => {
+            wrapperEl.remove();
+            if (hadFocus) {
+              nextFocusTarget?.focus();
+            }
+          });
+
+          announce(`Removed ${drinkTitle}, ${gridEl.children.length} drinks remaining`);
+          return;
+        }
+
+        const listEl = cardEl.querySelector('.custom-list');
+        if (!listEl) return;
+
+        // 3. Reorder all items in a single card's list (scoped to listEl so controls outside listEl stay interactive)
+        if (action === 'sort-items') {
+          const items = Array.from(listEl.children);
+          if (items.length < 2) return;
+          const reversed = items.slice().reverse();
+
+          runScopedTransition(listEl, () => {
+            reorder(listEl, reversed);
+          });
+
+          announce(`Reversed customizations for ${drinkTitle}, ${reversed.length} items`);
+          return;
+        }
+
+        // 4. Add customization item to card (scoped to cardEl so the card animates its height change)
+        if (action === 'add-item') {
+          const pool = (listEl.dataset.extraPool || 'Extra Shot,Light Ice,Oat Milk Whip')
+            .split(',')
+            .map((s) => s.trim())
+            .filter(Boolean);
+          const currentLabels = new Set(
+            Array.from(listEl.querySelectorAll('.item-label'), (el) => el.textContent.trim())
+          );
+          const nextLabel =
+            pool.find((candidate) => !currentLabels.has(candidate)) ||
+            `${pool[extraItemCounter % pool.length]} #${extraItemCounter + 1}`;
+          const newItem = createCustomItemNode(`custom-extra-${extraItemCounter++}`, nextLabel);
+
+          runScopedTransition(cardEl, () => {
+            listEl.append(newItem);
+          });
+
+          announce(`Added ${nextLabel} to ${drinkTitle}`);
+          return;
+        }
+
+        // 5. Single customization item move up / down (scoped to listEl)
+        const itemEl = btn.closest('li');
+        if (!itemEl) return;
+        const itemLabel = itemEl.querySelector('.item-label')?.textContent || 'item';
+
+        if (action === 'item-up' || action === 'item-down') {
+          const items = Array.from(listEl.children);
+          const idx = items.indexOf(itemEl);
+          const targetIdx = action === 'item-up' ? idx - 1 : idx + 1;
+          if (idx === -1 || targetIdx < 0 || targetIdx >= items.length) return;
+
+          const ordered = items.slice();
+          [ordered[idx], ordered[targetIdx]] = [ordered[targetIdx], ordered[idx]];
+
+          runScopedTransition(listEl, () => {
+            reorder(listEl, ordered);
+            btn.focus();
+          });
+
+          announce(`Moved ${itemLabel} to position ${targetIdx + 1} in ${drinkTitle}`);
+          return;
+        }
+
+        // 6. Remove customization item (scoped to cardEl so card height and item exit animate together while preserving focus)
+        if (action === 'item-remove') {
+          const hadFocus = itemEl.contains(document.activeElement);
+          const nextFocusTarget =
+            itemEl.nextElementSibling?.querySelector('button[data-action="item-remove"]') ??
+            itemEl.previousElementSibling?.querySelector('button[data-action="item-remove"]') ??
+            cardEl.querySelector('button[data-action="add-item"]') ??
+            cardEl.querySelector('button');
+
+          runScopedTransition(cardEl, () => {
+            itemEl.remove();
+            if (hadFocus) {
+              nextFocusTarget?.focus();
+            }
+          });
+
+          announce(`Removed ${itemLabel} from ${drinkTitle}`);
+        }
+      });
+    })();
+  </script>
