+      // Toolbar: Sort Cards A-Z / Z-A (Scoped to .grid)
+      if (sortBtn) {
+        sortBtn.addEventListener('click', function () {
+          const cards = Array.from(grid.querySelectorAll('.card'));
+          if (cards.length < 2) return;
+          const sorted = cards.slice().sort(function (a, b) {
+            const titleA = (a.querySelector('h3') ? a.querySelector('h3').textContent : '').trim();
+            const titleB = (b.querySelector('h3') ? b.querySelector('h3').textContent : '').trim();
+            return sortAscending ? titleA.localeCompare(titleB) : titleB.localeCompare(titleA);
+          });
+          sortAscending = !sortAscending;
+          runScopedTransition(grid, function () {
+            sorted.forEach(function (c) {
+              grid.appendChild(c);
+            });
+            updateGridControlsState();
+          });
+        });
+      }
+
+      // Toolbar: Add Spiced Chai Card (Scoped to .grid)
+      if (addSeasonalBtn) {
+        addSeasonalBtn.addEventListener('click', function () {
+          if (grid.querySelector('[data-card-id="spiced-chai"]')) return;
+          runScopedTransition(grid, function () {
+            if (removedCardsStore.has('spiced-chai')) {
+              const stored = removedCardsStore.get('spiced-chai');
+              removedCardsStore.delete('spiced-chai');
+              grid.appendChild(stored.node);
+              renderRemovedTray();
+            } else {
+              const wrapper = document.createElement('div');
+              wrapper.innerHTML = bonusCardHTML.trim();
+              const newCard = wrapper.firstElementChild;
+              grid.appendChild(newCard);
+              snapshotCardDefaults(grid);
+            }
+            updateGridControlsState();
+          });
+        });
+      }
+
+      // Toolbar: Reset All Favorites (Scoped to .grid)
+      if (resetAllBtn) {
+        resetAllBtn.addEventListener('click', function () {
+          runScopedTransition(grid, function () {
+            removedCardsStore.clear();
+            renderRemovedTray();
+            grid.innerHTML = initialGridHTML;
+            snapshotCardDefaults(grid);
+            updateGridControlsState();
+          });
+        });
+      }
+
+      // Drag and Drop reordering for Drink Cards (Scoped to .grid)
+      let draggedCard = null;
+      grid.addEventListener('dragstart', function (event) {
+        const card = event.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        card.classList.add('dragging');
+        if (event.dataTransfer) {
+          event.dataTransfer.effectAllowed = 'move';
+          event.dataTransfer.setData('text/plain', card.dataset.cardId || '');
+        }
+      });
+
+      grid.addEventListener('dragend', function () {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+      });
+
+      grid.addEventListener('dragover', function (event) {
+        if (!draggedCard) return;
+        event.preventDefault();
+        if (event.dataTransfer) {
+          event.dataTransfer.dropEffect = 'move';
+        }
+      });
+
+      grid.addEventListener('drop', function (event) {
+        if (!draggedCard) return;
+        event.preventDefault();
+        const targetCard = event.target.closest('.card');
+        if (!targetCard || targetCard === draggedCard) return;
+
+        const cards = Array.from(grid.querySelectorAll('.card'));
+        const draggedIdx = cards.indexOf(draggedCard);
+        const targetIdx = cards.indexOf(targetCard);
+
+        runScopedTransition(grid, function () {
+          if (draggedIdx < targetIdx) {
+            grid.insertBefore(draggedCard, targetCard.nextElementSibling);
+          } else {
+            grid.insertBefore(draggedCard, targetCard);
+          }
+          updateGridControlsState();
+        });
+      });
+    })();
+  </script>
 </body>
 
 </html>
