+  <script>
+    document.querySelectorAll('.card').forEach((card) => {
+      const priceBadge = card.querySelector('[data-price-display]');
+      const sizeInputs = card.querySelectorAll('input[type="radio"]');
+      const addBtn = card.querySelector('.add-to-order-btn');
+      const statusEl = card.querySelector('.order-status');
+      const drinkName = card.dataset.drink || card.querySelector('h3')?.textContent || 'Drink';
+
+      sizeInputs.forEach((input) => {
+        input.addEventListener('change', () => {
+          if (priceBadge && input.dataset.price) {
+            priceBadge.textContent = `$${ Number(input.dataset.price).toFixed(2) }`;
+          }
+          if (addBtn?.classList.contains('added')) {
+            addBtn.classList.remove('added');
+            addBtn.textContent = 'Add to Order';
+          }
+        });
+      });
+
+      if (addBtn) {
+        addBtn.addEventListener('click', () => {
+          const selected = card.querySelector('input[type="radio"]:checked');
+          const size = selected ? selected.value : 'medium';
+          const price = selected?.dataset.price ? `$${ Number(selected.dataset.price).toFixed(2) }` : '';
+          addBtn.classList.add('added');
+          addBtn.textContent = `Added (${ size.charAt(0).toUpperCase() + size.slice(1) })`;
+          if (statusEl) {
+            statusEl.textContent = `Added 1 ${ size } ${ drinkName } ${ price } to your order.`.trim();
+          }
+        });
+      }
+    });
+  </script>
