+  <script>
+    const statusRegion = document.getElementById('order-status');
+    const orderForms = document.querySelectorAll('.order-form');
+
+    orderForms.forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(form);
+        const drink = formData.get('drink');
+        const size = formData.get('size');
+        if (statusRegion && drink && size) {
+          statusRegion.textContent = `Added ${size} ${drink} to your order.`;
+        }
+      });
+    });
+
+    if (!CSS.supports('selector(:has(*))')) {
+      const cards = document.querySelectorAll('.card');
+      cards.forEach((card) => {
+        if (card.querySelector('img, picture, video, svg, .media')) {
+          card.classList.add('has-image');
+        }
+
+        const syncSelectionState = () => {
+          const checkedInput = card.querySelector('input[name="size"]:checked');
+          card.classList.toggle('is-selected', Boolean(checkedInput));
+          card.classList.toggle('is-large-selected', checkedInput?.value === 'Large');
+          card.querySelectorAll('.size-option').forEach((option) => {
+            option.classList.toggle('is-active', Boolean(option.querySelector('input:checked')));
+          });
+        };
+
+        syncSelectionState();
+        card.addEventListener('change', syncSelectionState);
+      });
+    }
+  </script>
