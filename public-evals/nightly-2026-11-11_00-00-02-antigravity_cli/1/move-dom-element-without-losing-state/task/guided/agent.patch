+  <script>
+    const heroSection = document.getElementById('hero-section');
+    const heroTheaterSlot = document.getElementById('hero-theater-slot');
+    const videoSectionSlot = document.getElementById('video-section-slot');
+    const videoWrapper = document.getElementById('roasting-video-wrapper');
+    const toggleBtn = document.getElementById('theater-toggle-btn');
+    const toggleLabel = document.getElementById('theater-toggle-label');
+    const liveStatus = document.getElementById('video-live-status');
+
+    function moveElementPreservingState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    toggleBtn.addEventListener('click', () => {
+      const isTheaterMode = toggleBtn.getAttribute('aria-pressed') === 'true';
+      const nextTheaterState = !isTheaterMode;
+      const targetSlot = nextTheaterState ? heroTheaterSlot : videoSectionSlot;
+
+      moveElementPreservingState(targetSlot, videoWrapper);
+
+      toggleBtn.setAttribute('aria-pressed', String(nextTheaterState));
+      toggleLabel.textContent = nextTheaterState ? 'Exit Theater Mode' : 'Theater Mode';
+      heroSection.classList.toggle('has-theater-video', nextTheaterState);
+
+      liveStatus.textContent = nextTheaterState
+        ? 'Coffee roasting video moved to the hero section in Theater Mode.'
+        : 'Coffee roasting video returned to the roastery video section.';
+    });
+  </script>
