+  <script>
+    (function () {
+      const heroSection = document.getElementById('hero-section');
+      const videoSlot = document.getElementById('video-player-slot');
+      const roastingVideo = document.getElementById('roasting-video');
+      const theaterToggleBtn = document.getElementById('theater-toggle');
+
+      function moveElementPreservingState(targetParent, element, referenceNode = null) {
+        if (typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(element, referenceNode);
+        } else {
+          targetParent.insertBefore(element, referenceNode);
+        }
+      }
+
+      theaterToggleBtn.addEventListener('click', function () {
+        const isInHero = heroSection.contains(roastingVideo);
+
+        if (!isInHero) {
+          moveElementPreservingState(heroSection, roastingVideo, null);
+          heroSection.classList.add('theater-active');
+          theaterToggleBtn.setAttribute('aria-pressed', 'true');
+          theaterToggleBtn.textContent = 'Exit Theater Mode';
+        } else {
+          moveElementPreservingState(videoSlot, roastingVideo, null);
+          heroSection.classList.remove('theater-active');
+          theaterToggleBtn.setAttribute('aria-pressed', 'false');
+          theaterToggleBtn.textContent = 'Theater Mode';
+        }
+      });
+    })();
+  </script>
