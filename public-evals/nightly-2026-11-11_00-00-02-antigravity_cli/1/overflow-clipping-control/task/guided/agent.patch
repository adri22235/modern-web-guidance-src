       margin: 40px auto;
       padding: 0 20px;
     }
 
+    /* Showcase Section */
+    .showcase-section {
+      margin-bottom: 50px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 32px;
+      margin-top: 24px;
+      align-items: start;
+    }
+
+    /**
+     * 1. Block Container: Nested Rounded Curves
+     * Standard block layout container with outer corner radii and padding.
+     * Base fallback clips roughly at the padding box.
+     */
+    .nested-curve-parent {
+      background: white;
+      padding: 20px;
+      border-radius: 28px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
+      /* Level 1 Fallback: clips child roughly at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .nested-curve-footer {
+      background: var(--primary);
+      color: white;
+      padding: 16px 20px;
+      text-align: left;
+    }
+
+    .nested-curve-footer h3 {
+      margin-bottom: 6px;
+      color: var(--accent);
+    }
+
+    .nested-curve-footer p {
+      font-size: 0.92rem;
+      opacity: 0.95;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* MANDATORY: overflow: clip is required on non-replaced elements */
+        overflow: clip;
+        /* Automatically curves clipping edge to match inner content-box radius */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    /**
+     * 2. Block Container: Child Element Shadow Bleed
+     * Base fallback uses overflow: hidden, which clips overflowing content
+     * while @supports upgrades to overflow: clip with an offset safety zone.
+     */
+    .safety-zone-parent {
+      background: white;
+      padding: 24px;
+      border-radius: 16px;
+      border: 1px solid var(--secondary);
+      /* Level 1 Fallback: clips overflowing content but truncates child shadows */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent .promo-overflow-text {
+      white-space: nowrap;
+      font-size: 0.95rem;
+      color: var(--text);
+      margin-bottom: 20px;
+    }
+
+    .demo-glowing-btn {
+      display: block;
+      width: 100%;
+      padding: 12px 20px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 1rem;
+      border: none;
+      border-radius: 8px;
+      cursor: pointer;
+      box-shadow: 0 10px 18px rgba(255, 171, 64, 0.75);
+      transition: transform 0.2s, box-shadow 0.2s;
+    }
+
+    .demo-glowing-btn:hover:not(:disabled) {
+      transform: translateY(-1px);
+      box-shadow: 0 12px 22px rgba(255, 171, 64, 0.85);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Establishes a visible safety zone allowing child element shadows to render safely outside */
+        overflow-clip-margin: 15px;
+      }
+    }
+
