+  <script>
+    (function () {
+      const ACTION_TRAY_WIDTH = 192;
+      const SWIPE_THRESHOLD = 40;
+      const cards = Array.from(document.querySelectorAll('.card'));
+      const feedbackEl = document.getElementById('seasonal-action-feedback');
+
+      function getCoordX(e) {
+        if (e.touches && e.touches.length > 0) {
+          return e.touches[0].clientX ?? e.touches[0].pageX ?? null;
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return e.changedTouches[0].clientX ?? e.changedTouches[0].pageX ?? null;
+        }
+        if (typeof e.clientX === 'number') {
+          return e.clientX;
+        }
+        if (typeof e.pageX === 'number') {
+          return e.pageX;
+        }
+        return null;
+      }
+
+      function getCoordY(e) {
+        if (e.touches && e.touches.length > 0) {
+          return e.touches[0].clientY ?? e.touches[0].pageY ?? null;
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return e.changedTouches[0].clientY ?? e.changedTouches[0].pageY ?? null;
+        }
+        if (typeof e.clientY === 'number') {
+          return e.clientY;
+        }
+        if (typeof e.pageY === 'number') {
+          return e.pageY;
+        }
+        return null;
+      }
+
+      function setCardState(card, offset) {
+        const content = card.querySelector('.card-content');
+        const actions = card.querySelector('.card-actions');
+        const buttons = card.querySelectorAll('.action-btn');
+        const isRevealed = offset !== 0;
+
+        card._currentOffset = offset;
+        content.style.transform = `translateX(${offset}px)`;
+        card.classList.toggle('is-revealed', isRevealed);
+        card.classList.toggle('swiped', isRevealed);
+        card.classList.toggle('open', isRevealed);
+        card.classList.toggle('actions-left', offset > 0);
+        card.setAttribute('data-swipe-state', isRevealed ? 'open' : 'closed');
+        card.setAttribute('data-revealed', isRevealed ? 'true' : 'false');
+        actions.setAttribute('aria-hidden', isRevealed ? 'false' : 'true');
+        buttons.forEach((btn) => {
+          btn.setAttribute('tabindex', isRevealed ? '0' : '-1');
+        });
+      }
+
+      function closeOtherCards(activeCard) {
+        cards.forEach((c) => {
+          if (c !== activeCard && c._currentOffset !== 0) {
+            setCardState(c, 0);
+          }
+        });
+      }
+
+      cards.forEach((card) => {
+        card._currentOffset = 0;
+        const content = card.querySelector('.card-content');
+        let isDragging = false;
+        let startX = 0;
+        let startY = 0;
+        let currentX = 0;
+        let baseOffset = 0;
+        let didSwipe = false;
+
+        function onStart(e) {
+          if (e.target.closest('.card-actions')) {
+            return;
+          }
+          if (e.type === 'mousedown' && e.button !== 0 && e.button !== undefined) {
+            return;
+          }
+          if (isDragging) {
+            return;
+          }
+          isDragging = true;
+          didSwipe = false;
+          startX = getCoordX(e) ?? 0;
+          startY = getCoordY(e) ?? 0;
+          currentX = startX;
+          baseOffset = card._currentOffset || 0;
+          card.classList.add('is-dragging');
+        }
+
+        function onMove(e) {
+          if (!isDragging) {
+            return;
+          }
+          const nextX = getCoordX(e);
+          if (nextX !== null) {
+            currentX = nextX;
+          }
+          const currentY = getCoordY(e) ?? startY;
+          const deltaX = currentX - startX;
+          const deltaY = currentY - startY;
+
+          if (Math.abs(deltaX) > 8 && Math.abs(deltaX) >= Math.abs(deltaY)) {
+            didSwipe = true;
+            closeOtherCards(card);
+          }
+
+          let nextOffset = baseOffset + deltaX;
+          if (baseOffset === 0) {
+            card.classList.toggle('actions-left', nextOffset > 0);
+            nextOffset = Math.max(-ACTION_TRAY_WIDTH, Math.min(ACTION_TRAY_WIDTH, nextOffset));
+          } else if (baseOffset < 0) {
+            nextOffset = Math.max(-ACTION_TRAY_WIDTH, Math.min(0, nextOffset));
+          } else {
+            nextOffset = Math.max(0, Math.min(ACTION_TRAY_WIDTH, nextOffset));
+          }
+
+          content.style.transform = `translateX(${nextOffset}px)`;
+        }
+
+        function onEnd(e) {
+          if (!isDragging) {
+            return;
+          }
+          isDragging = false;
+          card.classList.remove('is-dragging');
+
+          const endX = getCoordX(e) ?? currentX;
+          const deltaX = endX - startX;
+
+          if (Math.abs(deltaX) > 8) {
+            didSwipe = true;
+          }
+
+          if (baseOffset === 0) {
+            if (deltaX <= -SWIPE_THRESHOLD) {
+              closeOtherCards(card);
+              setCardState(card, -ACTION_TRAY_WIDTH);
+            } else if (deltaX >= SWIPE_THRESHOLD) {
+              closeOtherCards(card);
+              setCardState(card, ACTION_TRAY_WIDTH);
+            } else {
+              setCardState(card, 0);
+            }
+          } else if (baseOffset < 0) {
+            if (deltaX >= SWIPE_THRESHOLD) {
+              setCardState(card, 0);
+            } else {
+              setCardState(card, -ACTION_TRAY_WIDTH);
+            }
+          } else {
+            if (deltaX <= -SWIPE_THRESHOLD) {
+              setCardState(card, 0);
+            } else {
+              setCardState(card, ACTION_TRAY_WIDTH);
+            }
+          }
+        }
+
+        card.addEventListener('dragstart', (e) => e.preventDefault());
+
+        card.addEventListener('touchstart', onStart, { passive: true });
+        card.addEventListener('touchmove', onMove, { passive: true });
+        card.addEventListener('touchend', onEnd);
+        card.addEventListener('touchcancel', onEnd);
+
+        card.addEventListener('pointerdown', onStart);
+        window.addEventListener('pointermove', onMove);
+        window.addEventListener('pointerup', onEnd);
+        window.addEventListener('pointercancel', onEnd);
+
+        card.addEventListener('mousedown', onStart);
+        window.addEventListener('mousemove', onMove);
+        window.addEventListener('mouseup', onEnd);
+
+        content.addEventListener('click', (e) => {
+          if (didSwipe) {
+            e.preventDefault();
+            e.stopPropagation();
+            didSwipe = false;
+          } else if (card._currentOffset !== 0 && !e.target.closest('a')) {
+            setCardState(card, 0);
+          }
+        }, true);
+
+        card.querySelectorAll('.action-btn').forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const drink = btn.getAttribute('data-drink');
+            const action = btn.getAttribute('data-action');
+
+            if (action === 'favorite') {
+              const isPressed = btn.getAttribute('aria-pressed') === 'true';
+              const nextState = !isPressed;
+              btn.setAttribute('aria-pressed', String(nextState));
+              btn.classList.toggle('is-active', nextState);
+              feedbackEl.textContent = nextState
+                ? `Saved ${drink} to your favorites.`
+                : `Removed ${drink} from your favorites.`;
+            } else if (action === 'order') {
+              feedbackEl.textContent = `Added ${drink} to your order.`;
+            } else if (action === 'customize') {
+              feedbackEl.textContent = `Customizing ${drink}...`;
+            }
+          });
+        });
+      });
+
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('.card')) {
+          closeOtherCards(null);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
