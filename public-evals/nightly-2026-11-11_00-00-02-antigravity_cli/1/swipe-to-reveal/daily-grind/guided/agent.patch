+  <script>
+    function setActionTabIndexes(reveal, isExpanded) {
+      for (const control of reveal.querySelectorAll('.SwipeReveal-panel button, .SwipeReveal-panel a')) {
+        control.setAttribute('tabindex', isExpanded ? '0' : '-1');
+      }
+    }
+
+    for (const trigger of document.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]')) {
+      trigger.addEventListener('click', () => {
+        const reveal = trigger.closest('.SwipeReveal');
+        if (!reveal) return;
+
+        const label = (trigger.getAttribute('aria-label') || '').toLowerCase();
+        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+        if (isExpanded) {
+          if (label.includes('leading')) {
+            const leadingScrollPanelWidth = reveal.querySelector('.SwipeReveal-panel').offsetWidth;
+            reveal.scrollTo({
+              left: leadingScrollPanelWidth,
+              behavior: 'smooth',
+            });
+          } else if (label.includes('trailing')) {
+            const leadingScrollPanelWidth = reveal.querySelector('.SwipeReveal-panel').offsetWidth;
+            reveal.scrollTo({
+              left: leadingScrollPanelWidth,
+              behavior: 'smooth',
+            });
+          } else {
+            reveal.scrollTo({
+              left: 0,
+              behavior: 'smooth',
+            });
+          }
+
+          for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+            actionButton.setAttribute('aria-expanded', 'false');
+          }
+          setActionTabIndexes(reveal, false);
+          return;
+        }
+
+        const panels = Array.from(reveal.querySelectorAll('.SwipeReveal-panel'));
+        if (panels.length === 0) return;
+
+        let targetScrollLeft = reveal.scrollWidth;
+
+        if (label.includes('leading')) {
+          targetScrollLeft = 0;
+        } else if (label.includes('trailing')) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else if (panels.length === 1) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else {
+          const content = reveal.querySelector('.SwipeReveal-content');
+          const firstTrigger = content.querySelector('[aria-label$="actions"]');
+          targetScrollLeft = trigger === firstTrigger ? 0 : reveal.scrollWidth;
+        }
+
+        reveal.scrollTo({
+          left: targetScrollLeft,
+          behavior: 'smooth',
+        });
+
+        for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+          actionButton.setAttribute('aria-expanded', actionButton === trigger ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, true);
+      });
+    }
+
+    for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+      const content = reveal.querySelector('.SwipeReveal-content');
+      const panel = reveal.querySelector('.SwipeReveal-panel');
+      const items = [content, panel].filter(Boolean);
+      const triggers = reveal.querySelectorAll('[aria-label$="actions"]');
+
+      if (content) {
+        content.addEventListener('focusin', (event) => {
+          if (
+            event.target.matches(':focus-visible') &&
+            !event.target.matches('[aria-label$="actions"]')
+          ) {
+            content.scrollIntoView({ block: 'nearest', inline: 'start' });
+          }
+        });
+      }
+
+      const applySettledState = (activeIndex) => {
+        const isExpanded = items[activeIndex] === panel;
+        items.forEach((item, idx) => {
+          item.classList.remove('pending', 'active');
+          if (idx === activeIndex) {
+            item.classList.add('active');
+          }
+        });
+        for (const actionButton of triggers) {
+          actionButton.classList.remove('pending');
+          actionButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, isExpanded);
+      };
+
+      const findClosestItemIndex = () => {
+        if (!panel) return 0;
+        const maxScrollLeft = Math.max(0, reveal.scrollWidth - reveal.clientWidth);
+        if (maxScrollLeft === 0) return 0;
+        return reveal.scrollLeft >= maxScrollLeft / 2 ? 1 : 0;
+      };
+
+      const initActiveItem = () => {
+        if (!CSS.supports('scroll-initial-target', 'nearest') && content) {
+          reveal.scrollTo({ left: content.offsetLeft, behavior: 'instant' });
+        }
+        const closestIndex = findClosestItemIndex();
+        applySettledState(closestIndex);
+      };
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        reveal.addEventListener('scrollsnapchanging', (event) => {
+          const pendingTarget = event.snapTargetInline;
+          const index = items.indexOf(pendingTarget);
+          if (index === -1) return;
+
+          items.forEach((item) => item.classList.remove('pending'));
+          items[index].classList.add('pending');
+        });
+
+        reveal.addEventListener('scrollsnapchange', (event) => {
+          const snappedTarget = event.snapTargetInline;
+          const index = items.indexOf(snappedTarget);
+          if (index === -1) return;
+
+          applySettledState(index);
+        });
+      } else {
+        let scrollTimeout;
+        let rafId = null;
+
+        const promotePendingToActive = () => {
+          const closestIndex = findClosestItemIndex();
+          applySettledState(closestIndex);
+        };
+
+        reveal.addEventListener('scroll', () => {
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              const closestIndex = findClosestItemIndex();
+              if (!items[closestIndex]) return;
+
+              items.forEach((item) => item.classList.remove('pending'));
+              items[closestIndex].classList.add('pending');
+            });
+          }
+
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(promotePendingToActive, 100);
+        }, { passive: true });
+
+        reveal.addEventListener('scrollend', () => {
+          clearTimeout(scrollTimeout);
+          promotePendingToActive();
+        });
+      }
+
+      if (document.readyState === 'complete') {
+        initActiveItem();
+      } else {
+        window.addEventListener('load', initActiveItem, { once: true });
+      }
+    }
+
+    const feedbackEl = document.getElementById('seasonal-action-feedback');
+    for (const actionBtn of document.querySelectorAll('.SwipeReveal-action')) {
+      actionBtn.addEventListener('click', () => {
+        const drink = actionBtn.dataset.drink;
+        const action = actionBtn.dataset.action;
+        if (actionBtn.hasAttribute('aria-pressed')) {
+          const nextPressed = actionBtn.getAttribute('aria-pressed') !== 'true';
+          actionBtn.setAttribute('aria-pressed', String(nextPressed));
+          actionBtn.textContent = nextPressed ? 'Favorited' : 'Favorite';
+          if (feedbackEl) {
+            feedbackEl.textContent = `${drink}: ${nextPressed ? 'Saved to favorites' : 'Removed from favorites'}.`;
+          }
+        } else if (feedbackEl) {
+          feedbackEl.textContent = `${drink}: ${action}.`;
+        }
+      });
+    }
+  </script>
+
