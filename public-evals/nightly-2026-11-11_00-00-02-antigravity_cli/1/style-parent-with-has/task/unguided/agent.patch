+  <script>
+    (function () {
+      const form = document.getElementById('contact-form');
+      if (!form) return;
+
+      const statusBanner = document.getElementById('form-status');
+      const fields = Array.from(form.querySelectorAll('input, textarea'));
+
+      function isFieldValid(field) {
+        const trimmed = field.value.trim();
+        if (field.required && trimmed.length === 0) {
+          if (field.value.length > 0) {
+            field.setCustomValidity('This field is required.');
+          } else {
+            field.setCustomValidity('');
+          }
+          return false;
+        }
+        field.setCustomValidity('');
+        return field.checkValidity();
+      }
+
+      function updateFieldState(field) {
+        const wrapper = field.closest('.field-wrapper');
+        if (!wrapper) return true;
+
+        const valid = isFieldValid(field);
+        const interacted = field.dataset.interacted === 'true';
+
+        if (!valid && interacted) {
+          wrapper.classList.add('error', 'invalid');
+          wrapper.setAttribute('data-invalid', 'true');
+          field.setAttribute('aria-invalid', 'true');
+        } else {
+          wrapper.classList.remove('error', 'invalid');
+          wrapper.removeAttribute('data-invalid');
+          field.setAttribute('aria-invalid', valid ? 'false' : 'false');
+        }
+
+        return valid;
+      }
+
+      fields.forEach((field) => {
+        field.addEventListener('input', () => {
+          field.dataset.interacted = 'true';
+          if (statusBanner) statusBanner.classList.remove('visible');
+          updateFieldState(field);
+        });
+
+        field.addEventListener('blur', () => {
+          field.dataset.interacted = 'true';
+          updateFieldState(field);
+        });
+
+        field.addEventListener('change', () => {
+          field.dataset.interacted = 'true';
+          updateFieldState(field);
+        });
+
+        field.addEventListener('invalid', (event) => {
+          event.preventDefault();
+          field.dataset.interacted = 'true';
+          updateFieldState(field);
+        });
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        let allValid = true;
+
+        fields.forEach((field) => {
+          field.dataset.interacted = 'true';
+          if (!updateFieldState(field)) {
+            allValid = false;
+          }
+        });
+
+        if (allValid) {
+          if (statusBanner) statusBanner.classList.add('visible');
+          form.reset();
+          fields.forEach((field) => {
+            delete field.dataset.interacted;
+            const wrapper = field.closest('.field-wrapper');
+            if (wrapper) {
+              wrapper.classList.remove('error', 'invalid');
+              wrapper.removeAttribute('data-invalid');
+            }
+            field.removeAttribute('aria-invalid');
+          });
+        } else {
+          const firstInvalid = fields.find((f) => !isFieldValid(f));
+          if (firstInvalid) firstInvalid.focus();
+        }
+      });
+    })();
+  </script>
+
