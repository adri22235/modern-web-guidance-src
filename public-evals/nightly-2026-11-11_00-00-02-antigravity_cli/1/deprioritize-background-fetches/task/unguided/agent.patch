diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,23 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Minimal Concurrent Fetch</title>
+</head>
+<body>
+  <button id="fetch-btn" type="button">Load Data</button>
+
+  <script>
+    document.getElementById('fetch-btn').addEventListener('click', () => {
+      fetch('/api/data', { priority: 'high' });
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true
+      });
+    });
+  </script>
+</body>
+</html>
