+  <script>
+    const notificationToggle = document.getElementById('order-notifications');
+    const preferenceStatus = document.getElementById('preference-status');
+
+    if (notificationToggle) {
+      const savedPref = localStorage.getItem('order_notifications');
+      if (savedPref !== null) {
+        notificationToggle.checked = savedPref === 'true';
+      }
+
+      notificationToggle.addEventListener('change', () => {
+        const isEnabled = notificationToggle.checked;
+        localStorage.setItem('order_notifications', String(isEnabled));
+        if (preferenceStatus) {
+          preferenceStatus.textContent = isEnabled
+            ? 'Order ready notifications enabled.'
+            : 'Order ready notifications disabled.';
+        }
+      });
+    }
+  </script>
