+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_preference_on';
+      const toggle = document.getElementById('preference-toggle');
+      const statusText = document.getElementById('preference-status');
+
+      if (!toggle || !statusText) return;
+
+      function applyPreference(isOn) {
+        const stateStr = isOn ? 'on' : 'off';
+        toggle.checked = isOn;
+        toggle.setAttribute('aria-checked', String(isOn));
+        toggle.setAttribute('data-state', stateStr);
+        statusText.textContent = isOn ? 'On' : 'Off';
+        statusText.setAttribute('data-state', stateStr);
+        document.body.setAttribute('data-preference', stateStr);
+        document.body.classList.toggle('dark-mode', isOn);
+      }
+
+      try {
+        const saved = localStorage.getItem(STORAGE_KEY);
+        if (saved === 'on' || saved === 'true') {
+          applyPreference(true);
+        } else {
+          applyPreference(false);
+        }
+      } catch (e) {
+        applyPreference(false);
+      }
+
+      toggle.addEventListener('change', function () {
+        const isOn = Boolean(toggle.checked);
+        applyPreference(isOn);
+        try {
+          localStorage.setItem(STORAGE_KEY, isOn ? 'on' : 'off');
+        } catch (e) {
+          // Ignore storage errors in restricted environments
+        }
+      });
+
+      toggle.addEventListener('keydown', function (event) {
+        if (event.key === 'Enter') {
+          event.preventDefault();
+          toggle.checked = !toggle.checked;
+          toggle.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      });
+    })();
+  </script>
