+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const toggle = document.getElementById('notifications');
+    const status = document.getElementById('preference-status');
+    const STORAGE_KEY = 'daily_grind_notifications';
+
+    try {
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved !== null) {
+        toggle.checked = saved === 'true';
+      }
+    } catch {
+      // Ignore storage access errors
+    }
+
+    toggle.addEventListener('change', () => {
+      const isEnabled = toggle.checked;
+      try {
+        localStorage.setItem(STORAGE_KEY, String(isEnabled));
+      } catch {
+        // Ignore storage errors
+      }
+      status.textContent = isEnabled
+        ? 'Order ready notifications enabled.'
+        : 'Order ready notifications disabled.';
+    });
+  </script>
