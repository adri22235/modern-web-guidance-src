@@ -4,4 +4,71 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+.top-story-content {
+  view-transition-name: top-story;
+}
+
+/* Slide an element out to the left */
+@keyframes slide-to-left {
+  to {
+    transform: translateX(-100%);
+  }
+}
+
+/* Slide an element in from the right */
+@keyframes slide-from-right {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+/* Slide an element out to the right */
+@keyframes slide-to-right {
+  to {
+    transform: translateX(100%);
+  }
+}
+
+/* Slide an element in from the left */
+@keyframes slide-from-left {
+  from {
+    transform: translateX(-100%);
+  }
+}
+
+::view-transition-group(root),
+::view-transition-group(top-story) {
+  animation: 0.4s ease-in-out both;
+}
+
+html:active-view-transition-type(forward)::view-transition-old(root),
+html:active-view-transition-type(forward)::view-transition-old(top-story) {
+  animation-name: slide-to-left;
+}
+
+html:active-view-transition-type(forward)::view-transition-new(root),
+html:active-view-transition-type(forward)::view-transition-new(top-story) {
+  animation-name: slide-from-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-old(root),
+html:active-view-transition-type(backward)::view-transition-old(top-story) {
+  animation-name: slide-to-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-new(root),
+html:active-view-transition-type(backward)::view-transition-new(top-story) {
+  animation-name: slide-from-left;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(root),
+  ::view-transition-group(top-story),
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
