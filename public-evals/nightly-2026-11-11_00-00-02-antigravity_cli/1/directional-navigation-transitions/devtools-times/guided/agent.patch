+    <script>
+        /**
+         * Navigates to a new story with a directional view transition.
+         * @param {() => void} updateDOM - Callback to update the DOM state.
+         * @param {'forward' | 'backward'} direction - Navigation direction.
+         */
+        function navigate(updateDOM: () => void, direction: 'forward' | 'backward') {
+            if (!document.startViewTransition) {
+                updateDOM();
+                return;
+            }
+
+            const transition = document.startViewTransition({
+                update: updateDOM,
+                types: [direction],
+            });
+            transition.ready?.catch(() => {});
+        }
+
+        function initTopStoriesCarousel() {
+            const carousel = document.getElementById('top-stories-carousel');
+            if (!carousel || carousel.dataset.initialized === 'true') return;
+
+            const storiesRaw = carousel.dataset.stories;
+            if (!storiesRaw) return;
+
+            const stories: Array<{ id: string; href: string; title: string; date: string }> = JSON.parse(storiesRaw);
+            if (!stories.length) return;
+
+            carousel.dataset.initialized = 'true';
+            let currentIndex = 0;
+
+            const prevBtn = document.getElementById('prev-story');
+            const nextBtn = document.getElementById('next-story');
+            const contentEl = document.getElementById('top-story-content');
+            const linkEl = document.getElementById('top-story-link') as HTMLAnchorElement | null;
+            const titleEl = document.getElementById('top-story-title');
+            const dateEl = document.getElementById('top-story-date');
+
+            const renderStory = (index: number) => {
+                const story = stories[index];
+                if (!story) return;
+                if (linkEl) linkEl.href = story.href;
+                if (titleEl) titleEl.textContent = story.title;
+                if (dateEl) dateEl.textContent = story.date;
+                if (contentEl) contentEl.setAttribute('aria-label', `${index + 1} of ${stories.length}`);
+            };
+
+            prevBtn?.addEventListener('click', () => {
+                currentIndex = (currentIndex - 1 + stories.length) % stories.length;
+                navigate(() => renderStory(currentIndex), 'backward');
+            });
+
+            nextBtn?.addEventListener('click', () => {
+                currentIndex = (currentIndex + 1) % stories.length;
+                navigate(() => renderStory(currentIndex), 'forward');
+            });
+        }
+
+        initTopStoriesCarousel();
+        document.addEventListener('astro:page-load', initTopStoriesCarousel);
