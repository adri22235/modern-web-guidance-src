+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  data: {
+    title: string;
+    date: Date | string;
+    category?: string;
+    summary?: string;
+  };
+}
+
+interface TopStoriesCarouselProps {
+  stories: TopStory[];
+}
+
+export default function TopStoriesCarousel({ stories }: TopStoriesCarouselProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [step, setStep] = useState(0);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handlePrevious = () => {
+    setDirection('prev');
+    setStep((s) => s + 1);
+    setCurrentIndex((prevIndex) => (prevIndex - 1 + stories.length) % stories.length);
+  };
+
+  const handleNext = () => {
+    setDirection('next');
+    setStep((s) => s + 1);
+    setCurrentIndex((prevIndex) => (prevIndex + 1) % stories.length);
+  };
+
+  const currentStory = stories[currentIndex];
+  const baseUrl = import.meta.env.BASE_URL;
+  const formattedDate =
+    currentStory.data.date instanceof Date
+      ? currentStory.data.date.toLocaleDateString()
+      : new Date(currentStory.data.date).toLocaleDateString();
+
+  const animationClass =
+    direction === 'next'
+      ? 'slide-in-right'
+      : direction === 'prev'
+      ? 'slide-in-left'
+      : '';
+
+  return (
+    <div
+      className="flex items-center justify-between gap-4"
+      role="region"
+      aria-roledescription="carousel"
+      aria-label="Top Stories"
+    >
+      <button
+        type="button"
+        onClick={handlePrevious}
+        aria-label="Previous"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <ChevronLeftIcon className="w-4 h-4" />
+        <span>Previous</span>
+      </button>
+
+      <div className="overflow-hidden flex-1 px-2" aria-live="polite">
+        <div
+          key={`${currentStory.id}-${step}`}
+          data-direction={direction ?? undefined}
+          className={animationClass}
+        >
+          <a href={`${baseUrl}articles/${currentStory.id}`}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+              {currentStory.data.title}
+            </h3>
+          </a>
+          <span className="text-xs text-gray-500">{formattedDate}</span>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={handleNext}
+        aria-label="Next"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <span>Next</span>
+        <ChevronRightIcon className="w-4 h-4" />
+      </button>
+    </div>
+  );
+}
