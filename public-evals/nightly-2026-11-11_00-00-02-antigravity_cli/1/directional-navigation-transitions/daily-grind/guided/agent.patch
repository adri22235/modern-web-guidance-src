+  <script>
+    const cards = Array.from(document.querySelectorAll('#seasonal-carousel .card'));
+    const prevBtn = document.getElementById('prev-btn');
+    const nextBtn = document.getElementById('next-btn');
+    let currentIndex = 0;
+
+    function showCard(nextIndex) {
+      currentIndex = (nextIndex + cards.length) % cards.length;
+      cards.forEach((card, index) => {
+        card.hidden = index !== currentIndex;
+      });
+    }
+
+    function navigate(updateDOM, direction) {
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+
+      transition.ready?.catch(() => {});
+    }
+
+    nextBtn.addEventListener('click', () => {
+      navigate(() => {
+        showCard(currentIndex + 1);
+      }, 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      navigate(() => {
+        showCard(currentIndex - 1);
+      }, 'backward');
+    });
+  </script>
