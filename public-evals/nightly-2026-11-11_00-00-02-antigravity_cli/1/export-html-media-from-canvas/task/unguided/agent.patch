+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+
+      const messageInput = document.getElementById('card_message_input');
+      const nameInput = document.getElementById('card_name_input');
+      const amountSelect = document.getElementById('card_amount_select');
+      const bgColorInput = document.getElementById('card_bg_color');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export_card_btn');
+
+      const messageTextEl = document.getElementById('card_message_text');
+      const nameTextEl = document.getElementById('card_name_text');
+      const amountTextEl = document.getElementById('card_amount_text');
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        context.beginPath();
+        context.moveTo(x + radius, y);
+        context.lineTo(x + width - radius, y);
+        context.quadraticCurveTo(x + width, y, x + width, y + radius);
+        context.lineTo(x + width, y + height - radius);
+        context.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
+        context.lineTo(x + radius, y + height);
+        context.quadraticCurveTo(x, y + height, x, y + height - radius);
+        context.lineTo(x, y + radius);
+        context.quadraticCurveTo(x, y, x + radius, y);
+        context.closePath();
+      }
+
+      function wrapCanvasText(context, text, x, y, maxWidth, lineHeight, maxLines) {
+        const words = (text || '').split(/\s+/);
+        let line = '';
+        let lineCount = 0;
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line ? line + ' ' + words[i] : words[i];
+          const metrics = context.measureText(testLine);
+          if (metrics.width > maxWidth && line) {
+            context.fillText(line, x, y + lineCount * lineHeight);
+            line = words[i];
+            lineCount++;
+            if (maxLines && lineCount >= maxLines - 1) {
+              break;
+            }
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          context.fillText(line, x, y + lineCount * lineHeight);
+        }
+      }
+
+      function renderFallback2D() {
+        const w = canvas.width;
+        const h = canvas.height;
+        const bgColor = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+        const message = (messageTextEl ? messageTextEl.textContent : messageInput.value) || 'Enjoy a warm cup on me!';
+        const recipient = (nameTextEl ? nameTextEl.textContent : nameInput.value) || 'Coffee Lover';
+        const amount = (amountTextEl ? amountTextEl.textContent : amountSelect.value) || '$25';
+
+        ctx.clearRect(0, 0, w, h);
+
+        // Card background
+        drawRoundedRect(ctx, 0, 0, w, h, 16);
+        ctx.fillStyle = bgColor;
+        ctx.fill();
+
+        // Subtle decorative coffee ring accent
+        ctx.save();
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.12)';
+        ctx.lineWidth = 22;
+        ctx.beginPath();
+        ctx.arc(w - 40, h - 20, 110, 0, Math.PI * 2);
+        ctx.stroke();
+        ctx.restore();
+
+        // Gold border
+        drawRoundedRect(ctx, 2, 2, w - 4, h - 4, 15);
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.5)';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Brand badge circle
+        ctx.fillStyle = 'rgba(255, 171, 64, 0.2)';
+        ctx.beginPath();
+        ctx.arc(54, 52, 22, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.65)';
+        ctx.lineWidth = 1.5;
+        ctx.stroke();
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '22px "Segoe UI", sans-serif';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText('\u2615', 54, 53);
+
+        // Brand title & subtitle
+        ctx.textAlign = 'left';
+        ctx.textBaseline = 'alphabetic';
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 17px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('THE DAILY GRIND', 88, 48);
+
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 11px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('ARTISANAL COFFEE GIFT CARD', 88, 66);
+
+        // Gift amount pill
+        ctx.font = 'bold 20px "Segoe UI", Tahoma, sans-serif';
+        const amountWidth = Math.max(68, ctx.measureText(amount).width + 32);
+        const pillX = w - 32 - amountWidth;
+        const pillY = 30;
+        drawRoundedRect(ctx, pillX, pillY, amountWidth, 38, 19);
+        ctx.fillStyle = '#ffab40';
+        ctx.fill();
+
+        ctx.fillStyle = '#3e2723';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(amount, pillX + amountWidth / 2, pillY + 19);
+
+        // Custom message body
+        ctx.textAlign = 'left';
+        ctx.textBaseline = 'top';
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 22px "Segoe UI", Tahoma, sans-serif';
+        wrapCanvasText(ctx, message, 32, 118, w - 64, 30, 3);
+
+        // Footer divider
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(32, h - 76);
+        ctx.lineTo(w - 32, h - 76);
+        ctx.stroke();
+
+        // Recipient label & name
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 11px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('PREPARED FOR', 32, h - 62);
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(recipient, 32, h - 42);
+
+        // Gift card code badge
+        const codeText = 'TDG-2026-COFFEE';
+        ctx.font = '13px monospace';
+        const codeWidth = ctx.measureText(codeText).width + 20;
+        const codeX = w - 32 - codeWidth;
+        const codeY = h - 50;
+        drawRoundedRect(ctx, codeX, codeY, codeWidth, 26, 4);
+        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
+        ctx.fill();
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(codeText, codeX + codeWidth / 2, codeY + 13);
+      }
+
+      function paintCardToCanvas() {
+        if (typeof ctx.drawElementImage === 'function') {
+          try {
+            ctx.clearRect(0, 0, canvas.width, canvas.height);
+            ctx.drawElementImage(exportElement, 0, 0, canvas.width, canvas.height);
+            return;
+          } catch (err) {
+            // Fall through to standard 2D rendering if layoutsubtree paint context isn't active
+          }
+        } else if (typeof ctx.drawElement === 'function') {
+          try {
+            ctx.clearRect(0, 0, canvas.width, canvas.height);
+            ctx.drawElement(exportElement, 0, 0);
+            return;
+          } catch (err) {
+            // Fall through to standard 2D rendering
+          }
+        }
+        renderFallback2D();
+      }
+
+      function requestCardRender() {
+        paintCardToCanvas();
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      }
+
+      canvas.onpaint = function () {
+        paintCardToCanvas();
+      };
+
+      function syncElementFromInputs() {
+        if (messageTextEl) {
+          messageTextEl.textContent = messageInput.value || 'Enjoy a warm cup on me!';
+        }
+        if (nameTextEl) {
+          nameTextEl.textContent = nameInput.value || 'Coffee Lover';
+        }
+        if (amountTextEl) {
+          amountTextEl.textContent = amountSelect.value;
+        }
+        exportElement.style.backgroundColor = bgColorInput.value;
+        requestCardRender();
+      }
+
+      messageInput.addEventListener('input', syncElementFromInputs);
+      nameInput.addEventListener('input', syncElementFromInputs);
+      amountSelect.addEventListener('change', syncElementFromInputs);
+
+      bgColorInput.addEventListener('input', function () {
+        swatches.forEach(function (btn) {
+          btn.classList.toggle('active', btn.dataset.color.toLowerCase() === bgColorInput.value.toLowerCase());
+        });
+        syncElementFromInputs();
+      });
+
+      swatches.forEach(function (swatch) {
+        swatch.addEventListener('click', function () {
+          const color = swatch.dataset.color;
+          bgColorInput.value = color;
+          swatches.forEach(function (btn) {
+            btn.classList.toggle('active', btn === swatch);
+          });
+          syncElementFromInputs();
+        });
+      });
+
+      // Keep inputs synced if user types directly inside #export_element
+      exportElement.addEventListener('input', function () {
+        if (messageTextEl) {
+          messageInput.value = messageTextEl.textContent;
+        }
+        if (nameTextEl) {
+          nameInput.value = nameTextEl.textContent;
+        }
+        requestCardRender();
+      });
+
+      exportBtn.addEventListener('click', function () {
+        requestCardRender();
+        const dataUrl = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        const recipientSlug = (nameInput.value || 'coffee-lover')
+          .toLowerCase()
+          .replace(/[^a-z0-9]+/g, '-')
+          .replace(/(^-|-$)/g, '') || 'coffee';
+        link.download = 'daily-grind-gift-card-' + recipientSlug + '.png';
+        link.href = dataUrl;
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+      });
+
+      // Initial render
+      syncElementFromInputs();
+    })();
+  </script>
 </body>
 
 </html>
