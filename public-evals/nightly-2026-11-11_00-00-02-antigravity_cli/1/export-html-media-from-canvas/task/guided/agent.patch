+  <script>
+    const canvas = document.getElementById('gift-card-canvas');
+    const ctx = canvas.getContext('2d');
+    const exportElement = document.getElementById('export_element');
+    const inlineMessageInput = document.getElementById('card-inline-message');
+    const controlMessageInput = document.getElementById('custom-message-input');
+    const colorPicker = document.getElementById('card-bg-color');
+    const designerForm = document.getElementById('gift-card-form');
+    const exportStatus = document.getElementById('export-status');
+
+    function getContrastingTextColor(hexColor) {
+      const hex = hexColor.replace('#', '');
+      const r = parseInt(hex.substring(0, 2), 16) / 255;
+      const g = parseInt(hex.substring(2, 4), 16) / 255;
+      const b = parseInt(hex.substring(4, 6), 16) / 255;
+      const toLinear = (c) => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));
+      const luminance = 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
+      return luminance > 0.17913 ? '#000000' : '#ffffff';
+    }
+
+    function renderFallbackCanvas() {
+      const dpr = window.devicePixelRatio || 1;
+      const width = canvas.width / dpr;
+      const height = canvas.height / dpr;
+      if (!width || !height) return;
+
+      const bgColor = colorPicker.value || '#4e342e';
+      const fgColor = getContrastingTextColor(bgColor);
+      const message = inlineMessageInput.value || 'Coffee is on me!';
+
+      ctx.save();
+      ctx.clearRect(0, 0, canvas.width, canvas.height);
+      ctx.scale(dpr, dpr);
+
+      ctx.fillStyle = bgColor;
+      ctx.fillRect(0, 0, width, height);
+
+      ctx.strokeStyle = fgColor;
+      ctx.lineWidth = 2;
+      ctx.strokeRect(12, 12, width - 24, height - 24);
+
+      ctx.fillStyle = fgColor;
+      ctx.font = 'bold 16px "Segoe UI", sans-serif';
+      ctx.fillText('THE DAILY GRIND', 28, 46);
+      ctx.fillText('$25.00', width - 85, 46);
+
+      ctx.beginPath();
+      ctx.moveTo(28, 60);
+      ctx.lineTo(width - 28, 60);
+      ctx.stroke();
+
+      ctx.font = '600 12px "Segoe UI", sans-serif';
+      ctx.fillText('CUSTOM MESSAGE OR RECIPIENT NAME', 28, 105);
+
+      ctx.font = 'bold 20px "Segoe UI", sans-serif';
+      ctx.fillText(message, 28, 140, width - 56);
+
+      ctx.font = '14px "Segoe UI", sans-serif';
+      ctx.fillText('Redeemable for any handcrafted beverage or bag of beans.', 28, 185, width - 56);
+
+      ctx.font = '600 12px "Segoe UI", sans-serif';
+      ctx.fillText('GIFT CARD • EST. 2026 • ARTISANAL ROASTERS', 28, height - 28);
+      ctx.restore();
+    }
+
+    function requestCardPaint() {
+      if ('content' in HTMLCanvasElement.prototype && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        renderFallbackCanvas();
+      }
+    }
+
+    if ('content' in HTMLCanvasElement.prototype) {
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(exportElement, 0, 0);
+      };
+    }
+
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCardPaint();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+
+    inlineMessageInput.addEventListener('input', () => {
+      controlMessageInput.value = inlineMessageInput.value;
+      requestCardPaint();
+    });
+
+    controlMessageInput.addEventListener('input', () => {
+      inlineMessageInput.value = controlMessageInput.value;
+      requestCardPaint();
+    });
+
+    colorPicker.addEventListener('input', () => {
+      exportElement.style.setProperty('--card-bg', colorPicker.value);
+      requestCardPaint();
+    });
+
+    designerForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      requestCardPaint();
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'daily-grind-gift-card.png';
+      link.href = dataURL;
+      link.click();
+      exportStatus.textContent = 'Gift card image exported as daily-grind-gift-card.png.';
+    });
+  </script>
+
 </body>
 
