+  <script>
+    (async () => {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-language-btn');
+      const submitBtn = document.getElementById('submit-feedback-btn');
+      const resultEl = document.getElementById('detection-result');
+
+      const displayNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      function formatLanguage(code) {
+        if (!code) return 'Unknown';
+        try {
+          const name = displayNames ? displayNames.of(code) : code;
+          return name && name !== code ? `${name} (${code})` : code;
+        } catch {
+          return code;
+        }
+      }
+
+      function showResult(message, state = 'info') {
+        resultEl.dataset.state = state;
+        resultEl.textContent = message;
+      }
+
+      textarea.addEventListener('input', () => {
+        textarea.setCustomValidity('');
+        if (textarea.getAttribute('aria-invalid') === 'true') {
+          textarea.removeAttribute('aria-invalid');
+        }
+      });
+
+      let detectorInstance = null;
+
+      async function checkSupport() {
+        if (!('LanguageDetector' in self)) {
+          detectBtn.disabled = true;
+          showResult('Client-side language detection is currently unsupported in this browser.', 'error');
+          return false;
+        }
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            detectBtn.disabled = true;
+            showResult('Language detection model is unavailable on this device.', 'error');
+            return false;
+          }
+          return true;
+        } catch {
+          detectBtn.disabled = true;
+          showResult('Unable to verify language detector availability in this browser.', 'error');
+          return false;
+        }
+      }
+
+      await checkSupport();
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          textarea.setCustomValidity('Please enter a feedback message before detecting the language.');
+          textarea.setAttribute('aria-invalid', 'true');
+          showResult('Please enter a message to detect its language.', 'error');
+          textarea.focus();
+          return;
+        }
+
+        if (!('LanguageDetector' in self)) {
+          detectBtn.disabled = true;
+          showResult('Client-side language detection is currently unsupported in this browser.', 'error');
+          return;
+        }
+
+        detectBtn.disabled = true;
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            showResult('Language detection model is unavailable on this device.', 'error');
+            return;
+          }
+
+          if (!detectorInstance) {
+            showResult('Preparing language detector...', 'info');
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = Math.round((e.loaded || 0) * 100);
+                  showResult(`Downloading language detection model: ${pct}%`, 'info');
+                });
+              },
+            });
+          }
+
+          const results = await detectorInstance.detect(text);
+          if (results && results.length > 0) {
+            const top = results[0];
+            const langLabel = formatLanguage(top.detectedLanguage);
+            const confidencePct = (top.confidence * 100).toFixed(1);
+            textarea.lang = top.detectedLanguage;
+            showResult(`Detected language: ${langLabel} — ${confidencePct}% confidence`, 'info');
+          } else {
+            showResult('Could not confidently determine the language of the message.', 'error');
+          }
+        } catch (err) {
+          showResult(`Language detection failed: ${err && err.message ? err.message : 'Unknown error'}`, 'error');
+        } finally {
+          if ('LanguageDetector' in self) {
+            detectBtn.disabled = false;
+          }
+        }
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const text = textarea.value.trim();
+        if (!text) {
+          textarea.setCustomValidity('Please enter your feedback message.');
+          textarea.setAttribute('aria-invalid', 'true');
+          showResult('Please enter your feedback message before submitting.', 'error');
+          textarea.focus();
+          return;
+        }
+        submitBtn.disabled = true;
+        showResult('Thank you for your feedback!', 'info');
+      });
+    })();
+  </script>
