+  <script>
+    (function () {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-language-btn');
+      const resultEl = document.getElementById('detection-result');
+
+      const displayNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      const LANGUAGE_NAMES = {
+        en: 'English',
+        es: 'Spanish',
+        fr: 'French',
+        de: 'German',
+        it: 'Italian',
+        pt: 'Portuguese',
+        nl: 'Dutch',
+        ru: 'Russian',
+        ja: 'Japanese',
+        zh: 'Chinese',
+        ko: 'Korean',
+        ar: 'Arabic',
+        hi: 'Hindi',
+        tr: 'Turkish',
+        pl: 'Polish',
+        sv: 'Swedish',
+        vi: 'Vietnamese',
+        el: 'Greek',
+        he: 'Hebrew',
+        th: 'Thai',
+        id: 'Indonesian'
+      };
+
+      function getLanguageName(code) {
+        if (!code || code === 'und') return 'Unknown';
+        const normalized = code.toLowerCase().split('-')[0];
+        if (LANGUAGE_NAMES[normalized]) {
+          return LANGUAGE_NAMES[normalized];
+        }
+        if (displayNames) {
+          try {
+            const name = displayNames.of(code);
+            if (name && name.toLowerCase() !== code.toLowerCase()) {
+              return name;
+            }
+          } catch (_) {
+            // Fall through if code is already a full language name
+          }
+        }
+        return code;
+      }
+
+      function fallbackDetectLanguage(text) {
+        const trimmed = text.trim();
+        if (!trimmed) {
+          return null;
+        }
+
+        // Script-based checks for non-Latin scripts
+        if (/[\u3040-\u309F\u30A0-\u30FF]/.test(trimmed)) {
+          return { detectedLanguage: 'ja', confidence: 0.96 };
+        }
+        if (/[\uAC00-\uD7AF\u1100-\u11FF]/.test(trimmed)) {
+          return { detectedLanguage: 'ko', confidence: 0.96 };
+        }
+        if (/[\u4E00-\u9FFF]/.test(trimmed)) {
+          return { detectedLanguage: 'zh', confidence: 0.94 };
+        }
+        if (/[\u0400-\u04FF]/.test(trimmed)) {
+          return { detectedLanguage: 'ru', confidence: 0.94 };
+        }
+        if (/[\u0600-\u06FF]/.test(trimmed)) {
+          return { detectedLanguage: 'ar', confidence: 0.95 };
+        }
+        if (/[\u0900-\u097F]/.test(trimmed)) {
+          return { detectedLanguage: 'hi', confidence: 0.95 };
+        }
+        if (/[\u0370-\u03FF]/.test(trimmed)) {
+          return { detectedLanguage: 'el', confidence: 0.95 };
+        }
+        if (/[\u0590-\u05FF]/.test(trimmed)) {
+          return { detectedLanguage: 'he', confidence: 0.95 };
+        }
+        if (/[\u0E00-\u0E7F]/.test(trimmed)) {
+          return { detectedLanguage: 'th', confidence: 0.95 };
+        }
+
+        const lower = trimmed.toLowerCase();
+        const words = lower
+          .replace(/[^\p{L}\s']/gu, ' ')
+          .split(/\s+/)
+          .filter(Boolean);
+
+        const profiles = {
+          en: {
+            words: new Set([
+              'the', 'and', 'was', 'for', 'that', 'with', 'this', 'have', 'from', 'great',
+              'good', 'coffee', 'love', 'loved', 'best', 'very', 'really', 'nice', 'service',
+              'latte', 'espresso', 'brew', 'drink', 'drinks', 'shop', 'staff', 'friendly',
+              'delicious', 'amazing', 'here', 'your', 'you', 'are', 'were', 'had', 'but',
+              'not', 'they', 'their', 'would', 'will', 'recommend', 'taste', 'morning', 'cup',
+              'thank', 'thanks', 'awesome', 'warm', 'fresh', 'cozy', 'always', 'my', 'it', 'is', 'in'
+            ]),
+            chars: null
+          },
+          es: {
+            words: new Set([
+              'el', 'la', 'los', 'las', 'de', 'del', 'que', 'en', 'un', 'una', 'es', 'muy',
+              'por', 'con', 'para', 'como', 'más', 'pero', 'sus', 'le', 'ya', 'este', 'sí',
+              'porque', 'esta', 'entre', 'cuando', 'todo', 'también', 'fue', 'había', 'era',
+              'bueno', 'buena', 'excelente', 'café', 'gracias', 'rico', 'delicioso', 'encanta',
+              'encantó', 'mejor', 'servicio', 'lugar', 'atención', 'hola', 'siempre', 'mi', 'me', 'no', 'y'
+            ]),
+            chars: /[ñáéíóúü¿¡]/g
+          },
+          fr: {
+            words: new Set([
+              'le', 'la', 'les', 'de', 'des', 'du', 'un', 'une', 'et', 'est', 'en', 'que',
+              'qui', 'dans', 'ce', 'il', 'ne', 'sur', 'se', 'pas', 'plus', 'par', 'pour',
+              'avec', 'tout', 'faire', 'son', 'mais', 'nous', 'vous', 'très', 'bon', 'bonne',
+              'café', 'merci', 'excellent', 'délicieux', 'super', 'j\'adore', 'adore', 'service',
+              'toujours', 'bien', 'accueil', 'chaud', 'boisson', 'c\'est', 'était', 'mon', 'ma', 'je'
+            ]),
+            chars: /[éèêëàâùûçœîï]/g
+          },
+          de: {
+            words: new Set([
+              'der', 'die', 'das', 'und', 'in', 'den', 'von', 'zu', 'mit', 'sich', 'auf',
+              'für', 'ist', 'im', 'dem', 'nicht', 'ein', 'eine', 'als', 'auch', 'es', 'an',
+              'werden', 'aus', 'er', 'hat', 'dass', 'sie', 'nach', 'wird', 'bei', 'einer',
+              'sehr', 'gut', 'guter', 'lecker', 'kaffee', 'danke', 'immer', 'freundlich',
+              'wirklich', 'toll', 'super', 'schmeckt', 'heiß', 'frisch', 'ich', 'war', 'hier'
+            ]),
+            chars: /[äöüß]/g
+          },
+          it: {
+            words: new Set([
+              'il', 'lo', 'la', 'i', 'gli', 'le', 'di', 'del', 'della', 'che', 'è', 'un',
+              'una', 'in', 'per', 'non', 'con', 'sono', 'mi', 'si', 'ho', 'ma', 'anche',
+              'molto', 'buono', 'ottimo', 'caffè', 'grazie', 'sempre', 'servizio', 'locale',
+              'delizioso', 'perfetto', 'piace', 'questo', 'questa', 'qui', 'tutto', 'bene'
+            ]),
+            chars: /[àèéìòù]/g
+          },
+          pt: {
+            words: new Set([
+              'o', 'a', 'os', 'as', 'um', 'uma', 'de', 'do', 'da', 'dos', 'das', 'em', 'no',
+              'na', 'por', 'para', 'com', 'não', 'que', 'é', 'muito', 'bom', 'boa', 'ótimo',
+              'excelente', 'café', 'obrigado', 'obrigada', 'delicioso', 'sempre', 'atendimento',
+              'lugar', 'gostei', 'amo', 'adoro', 'melhor', 'está', 'foi', 'mais', 'eu', 'meu'
+            ]),
+            chars: /[ãõçáéíóúâêô]/g
+          },
+          nl: {
+            words: new Set([
+              'de', 'het', 'een', 'en', 'van', 'in', 'is', 'op', 'dat', 'die', 'voor', 'zijn',
+              'met', 'niet', 'aan', 'er', 'om', 'ook', 'als', 'maar', 'bij', 'of', 'uit',
+              'koffie', 'lekker', 'heel', 'goed', 'bedankt', 'altijd', 'service', 'vriendelijk',
+              'echt', 'super', 'fijn', 'smaakt', 'warm', 'vers', 'ik', 'was', 'hier', 'zeer'
+            ]),
+            chars: null
+          },
+          tr: {
+            words: new Set([
+              'bir', 've', 'bu', 'için', 'çok', 'da', 'de', 'ile', 'ama', 'daha', 'gibi',
+              'kahve', 'güzel', 'harika', 'lezzetli', 'teşekkürler', 'teşekkür', 'iyi', 'mekan',
+              'hizmet', 'her', 'zaman', 'sıcak', 'taze', 'sevdim', 'bayıldım'
+            ]),
+            chars: /[ğışçöü]/g
+          },
+          pl: {
+            words: new Set([
+              'i', 'w', 'nie', 'na', 'z', 'do', 'to', 'że', 'się', 'jest', 'bardzo', 'kawa',
+              'dobra', 'pyszna', 'świetna', 'dziękuję', 'miła', 'obsługa', 'miejsce', 'zawsze'
+            ]),
+            chars: /[ąćęłńóśźż]/g
+          },
+          vi: {
+            words: new Set([
+              'của', 'và', 'các', 'có', 'được', 'trong', 'là', 'cho', 'không', 'với', 'rất',
+              'cà', 'phê', 'ngon', 'tuyệt', 'vời', 'cảm', 'ơn', 'quán', 'phục', 'vụ', 'tốt'
+            ]),
+            chars: /[ăâđêôơưạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹ]/g
+          }
+        };
+
+        let bestLang = 'en';
+        let bestScore = 0;
+
+        for (const [lang, profile] of Object.entries(profiles)) {
+          let score = 0;
+          for (const w of words) {
+            if (profile.words.has(w)) {
+              score += 2;
+            }
+          }
+          if (profile.chars) {
+            const matches = lower.match(profile.chars);
+            if (matches) {
+              score += matches.length * 1.5;
+            }
+          }
+          if (score > bestScore) {
+            bestScore = score;
+            bestLang = lang;
+          }
+        }
+
+        const confidence = bestScore > 0
+          ? Math.min(0.98, 0.65 + bestScore * 0.05)
+          : 0.7;
+
+        return { detectedLanguage: bestLang, confidence };
+      }
+
+      async function detectWithBrowserAI(text) {
+        try {
+          if ('LanguageDetector' in self && self.LanguageDetector && typeof self.LanguageDetector.create === 'function') {
+            const detector = await self.LanguageDetector.create();
+            const results = await detector.detect(text);
+            if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage && results[0].detectedLanguage !== 'und') {
+              return results[0];
+            }
+          }
+          if (self.ai && self.ai.languageDetector && typeof self.ai.languageDetector.create === 'function') {
+            const detector = await self.ai.languageDetector.create();
+            const results = await detector.detect(text);
+            if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage && results[0].detectedLanguage !== 'und') {
+              return results[0];
+            }
+          }
+          if (self.translation && typeof self.translation.createDetector === 'function') {
+            const detector = await self.translation.createDetector();
+            const results = await detector.detect(text);
+            if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage && results[0].detectedLanguage !== 'und') {
+              return results[0];
+            }
+          }
+        } catch (_) {
+          // Fall back to built-in heuristic detector if Web AI API is unavailable
+        }
+        return null;
+      }
+
+      detectBtn.addEventListener('click', async function () {
+        const text = textarea.value.trim();
+        resultEl.classList.add('visible');
+
+        if (!text) {
+          resultEl.textContent = 'Please enter a message to detect its language.';
+          return;
+        }
+
+        const aiResult = await detectWithBrowserAI(text);
+        const detection = aiResult || fallbackDetectLanguage(text);
+
+        if (!detection || !detection.detectedLanguage) {
+          resultEl.textContent = 'Could not determine the language.';
+          return;
+        }
+
+        const code = detection.detectedLanguage;
+        const langName = getLanguageName(code);
+        const confidencePct = typeof detection.confidence === 'number'
+          ? ` (${Math.round(detection.confidence * 100)}% confidence)`
+          : '';
+
+        if (langName.toLowerCase() !== code.toLowerCase()) {
+          resultEl.textContent = `Detected Language: ${langName} [${code}]${confidencePct}`;
+        } else {
+          resultEl.textContent = `Detected Language: ${langName}${confidencePct}`;
+        }
+      });
+    })();
+  </script>
+
