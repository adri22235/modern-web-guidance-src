diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,133 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Video Landing Page</title>
+
+  <!-- Elevate priority for the video poster image acting as the LCP candidate -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+
+  <!-- Preload critical header font (fonts default to high priority, so fetchpriority="high" is omitted) -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Deprioritize secondary font preload to avoid network contention with LCP and critical font -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <!-- Inline critical CSS to avoid render-blocking stylesheet requests -->
+  <style>
+    @font-face {
+      font-family: 'Brand Font';
+      src: url('brand-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: 'Secondary Font';
+      src: url('secondary-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      font-family: 'Secondary Font', system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      background-color: #090a0f;
+      color: #f3f4f6;
+      line-height: 1.5;
+    }
+
+    header {
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 2rem 1.5rem 1rem;
+      text-align: center;
+    }
+
+    h1 {
+      margin: 0;
+      font-family: 'Brand Font', system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      font-size: clamp(2rem, 5vw, 3.5rem);
+      line-height: 1.1;
+      letter-spacing: -0.02em;
+    }
+
+    main {
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 1rem 1.5rem 3rem;
+      display: grid;
+      gap: 1.5rem;
+      justify-items: center;
+    }
+
+    .video-shell {
+      width: 100%;
+      max-width: 1200px;
+      aspect-ratio: 16 / 9;
+      background-color: #111827;
+      border-radius: 0.75rem;
+      overflow: hidden;
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+    }
+
+    .secondary-ui {
+      font-family: 'Secondary Font', system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      color: #9ca3af;
+      font-size: 0.95rem;
+      text-align: center;
+      margin: 0;
+    }
+
+    footer {
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 1.5rem;
+      text-align: center;
+      font-family: 'Secondary Font', system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      font-size: 0.875rem;
+      color: #6b7280;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Instant Stream Showcase</h1>
+  </header>
+
+  <main>
+    <div class="video-shell">
+      <video
+        controls
+        width="1280"
+        height="720"
+        poster="poster.jpg"
+        preload="none"
+      >
+        <source src="video.webm" type="video/webm">
+        <source src="video.mp4" type="video/mp4">
+        <track src="captions.vtt" kind="captions" srclang="en" label="English">
+      </video>
+    </div>
+    <p class="secondary-ui">High-efficiency playback — press play to stream on demand.</p>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 Stream Showcase</p>
+  </footer>
+</body>
+</html>
