diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,135 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Video Landing Page</title>
+
+  <!-- Preload the LCP element (video poster image) with high priority -->
+  <link rel="preload" as="image" href="poster.jpg" fetchpriority="high">
+
+  <!-- Preload the critical header web font -->
+  <link rel="preload" as="font" type="font/woff2" href="brand-font.woff2" crossorigin>
+
+  <style>
+    /* Critical font for header rendering */
+    @font-face {
+      font-family: 'BrandFont';
+      src: url('brand-font.woff2') format('woff2');
+      font-weight: 700;
+      font-style: normal;
+      font-display: swap;
+    }
+
+    /* Secondary font for less critical UI elements (not preloaded to avoid bandwidth contention with LCP) */
+    @font-face {
+      font-family: 'SecondaryFont';
+      src: url('secondary-font.woff2') format('woff2');
+      font-weight: 400;
+      font-style: normal;
+      font-display: optional;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      background-color: #0f172a;
+      color: #f8fafc;
+      font-family: system-ui, -apple-system, sans-serif;
+      line-height: 1.5;
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 2rem 1rem;
+    }
+
+    header {
+      width: 100%;
+      max-width: 960px;
+      margin-bottom: 1.5rem;
+      text-align: center;
+    }
+
+    h1 {
+      font-family: 'BrandFont', system-ui, -apple-system, sans-serif;
+      font-size: clamp(1.75rem, 4vw, 2.75rem);
+      letter-spacing: -0.02em;
+    }
+
+    main {
+      width: 100%;
+      max-width: 960px;
+    }
+
+    .video-container {
+      width: 100%;
+      aspect-ratio: 16 / 9;
+      background-color: #1e293b;
+      border-radius: 8px;
+      overflow: hidden;
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: 100%;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+    }
+
+    .secondary-ui {
+      font-family: 'SecondaryFont', system-ui, -apple-system, sans-serif;
+      color: #94a3b8;
+      font-size: 0.95rem;
+      margin-top: 1rem;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    footer {
+      font-family: 'SecondaryFont', system-ui, -apple-system, sans-serif;
+      color: #64748b;
+      font-size: 0.85rem;
+      margin-top: auto;
+      padding-top: 2rem;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Next-Generation Video Streaming</h1>
+  </header>
+
+  <main>
+    <div class="video-container">
+      <!-- LCP element: poster="poster.jpg" with preload="none" to prevent video stream from competing with poster image download -->
+      <video
+        poster="poster.jpg"
+        preload="none"
+        controls
+        playsinline
+        width="1280"
+        height="720"
+      >
+        <source src="feature-video.mp4" type="video/mp4">
+        Your browser does not support HTML5 video.
+      </video>
+    </div>
+
+    <div class="secondary-ui">
+      <span>Duration: 02:45</span>
+      <span>1080p HD</span>
+    </div>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 StreamPlatform</p>
+  </footer>
+</body>
+</html>
