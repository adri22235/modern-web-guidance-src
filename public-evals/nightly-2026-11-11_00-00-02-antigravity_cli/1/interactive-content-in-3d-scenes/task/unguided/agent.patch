+        const dy = e.clientY - dragStartY;
+        targetRotYDeg = Math.max(-180, Math.min(180, dragStartRotY + dx * 0.45));
+        targetRotXDeg = Math.max(-65, Math.min(65, dragStartRotX - dy * 0.35));
+      });
+
+      function endDrag() {
+        isDragging = false;
+      }
+
+      viewportWrapper.addEventListener('pointerup', endDrag);
+      viewportWrapper.addEventListener('pointercancel', endDrag);
+
+      // Slider & preset button handlers
+      rotateYSlider.addEventListener('input', () => {
+        autoRotate = false;
+        toggleAutoRotateBtn.classList.remove('active');
+        toggleAutoRotateBtn.setAttribute('aria-pressed', 'false');
+        toggleAutoRotateBtn.textContent = 'Auto-Rotate: OFF';
+        targetRotYDeg = parseFloat(rotateYSlider.value) || 0;
+        rotYDeg = targetRotYDeg;
+        updateRotationUI();
+        requestCanvasRepaint();
+      });
+
+      rotateXSlider.addEventListener('input', () => {
+        autoRotate = false;
+        toggleAutoRotateBtn.classList.remove('active');
+        toggleAutoRotateBtn.setAttribute('aria-pressed', 'false');
+        toggleAutoRotateBtn.textContent = 'Auto-Rotate: OFF';
+        targetRotXDeg = parseFloat(rotateXSlider.value) || 0;
+        rotXDeg = targetRotXDeg;
+        updateRotationUI();
+        requestCanvasRepaint();
+      });
+
+      toggleAutoRotateBtn.addEventListener('click', () => {
+        autoRotate = !autoRotate;
+        animStartTime = performance.now();
+        toggleAutoRotateBtn.classList.toggle('active', autoRotate);
+        toggleAutoRotateBtn.setAttribute('aria-pressed', String(autoRotate));
+        toggleAutoRotateBtn.textContent = autoRotate ? 'Auto-Rotate: ON' : 'Auto-Rotate: OFF';
+      });
+
+      resetRotationBtn.addEventListener('click', () => {
+        autoRotate = false;
+        toggleAutoRotateBtn.classList.remove('active');
+        toggleAutoRotateBtn.setAttribute('aria-pressed', 'false');
+        toggleAutoRotateBtn.textContent = 'Auto-Rotate: OFF';
+        targetRotYDeg = -18;
+        targetRotXDeg = 10;
+      });
+
+      viewFrontBtn.addEventListener('click', () => {
+        autoRotate = false;
+        toggleAutoRotateBtn.classList.remove('active');
+        toggleAutoRotateBtn.setAttribute('aria-pressed', 'false');
+        toggleAutoRotateBtn.textContent = 'Auto-Rotate: OFF';
+        targetRotYDeg = 0;
+        targetRotXDeg = 0;
+      });
+
+      viewSideBtn.addEventListener('click', () => {
+        autoRotate = false;
+        toggleAutoRotateBtn.classList.remove('active');
+        toggleAutoRotateBtn.setAttribute('aria-pressed', 'false');
+        toggleAutoRotateBtn.textContent = 'Auto-Rotate: OFF';
+        targetRotYDeg = -34;
+        targetRotXDeg = 14;
+      });
+
+      // Sync form fields with live summary & 3D box packaging textures
+      function syncFormToBoxState(statusMessage) {
+        const recipient = (recipientInput.value || 'Coffee Lover').trim();
+        const roast = roastSelect.value;
+        const grind = grindSelect.value;
+        const bags = Math.max(1, Math.min(12, parseInt(bagsInput.value, 10) || 1));
+
+        summaryRecipient.textContent = recipient;
+        summaryRoast.textContent = roast;
+        summaryGrind.textContent = grind;
+        summaryBags.textContent = String(bags);
+
+        if (statusMessage) {
+          statusBox.textContent = statusMessage;
+        }
+
+        refreshPackagingTextures();
+        requestCanvasRepaint();
+      }
+
+      [recipientInput, roastSelect, grindSelect, bagsInput, emailInput, tastingNotesCheckbox].forEach((el) => {
+        el.addEventListener('input', () => {
+          syncFormToBoxState('Updated 3D box for ' + (recipientInput.value || 'your roast'));
+        });
+        el.addEventListener('change', () => {
+          syncFormToBoxState('Updated 3D box: ' + roastSelect.value + ' (' + grindSelect.value + ')');
+        });
+      });
+
+      surpriseBtn.addEventListener('click', () => {
+        const roasts = Array.from(roastSelect.options).map((o) => o.value);
+        const grinds = Array.from(grindSelect.options).map((o) => o.value);
+        const currentRoastIdx = roasts.indexOf(roastSelect.value);
+        roastSelect.value = roasts[(currentRoastIdx + 1) % roasts.length];
+        grindSelect.value = grinds[Math.floor(Math.random() * grinds.length)];
+        bagsInput.value = String(Math.floor(Math.random() * 4) + 1);
+        tastingNotesCheckbox.checked = true;
+        syncFormToBoxState('Surprise blend selected: ' + roastSelect.value + '!');
+      });
+
+      formElement.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const recipient = (recipientInput.value || 'Coffee Lover').trim();
+        const roast = roastSelect.value;
+        const grind = grindSelect.value;
+        const bags = Math.max(1, Math.min(12, parseInt(bagsInput.value, 10) || 1));
+        syncFormToBoxState(
+          'Order confirmed! ' + bags + 'x ' + roast + ' (' + grind + ') for ' + recipient + '.'
+        );
+      });
+
+      // Initialize WebGL and start the 3D animation loop
+      initWebGL();
+      syncFormToBoxState();
+
+      function animate(now) {
+        if (autoRotate && !isDragging) {
+          const elapsed = (now - animStartTime) * 0.001;
+          targetRotYDeg = Math.sin(elapsed * 0.85) * 26;
+          targetRotXDeg = 8 + Math.cos(elapsed * 0.6) * 10;
+        }
+
+        // Smooth interpolation
+        rotYDeg += (targetRotYDeg - rotYDeg) * 0.14;
+        rotXDeg += (targetRotXDeg - rotXDeg) * 0.14;
+
+        updateRotationUI();
+        requestCanvasRepaint();
+        requestAnimationFrame(animate);
+      }
+
+      requestAnimationFrame(animate);
+    })();
+  </script>
 </body>
 
 </html>
