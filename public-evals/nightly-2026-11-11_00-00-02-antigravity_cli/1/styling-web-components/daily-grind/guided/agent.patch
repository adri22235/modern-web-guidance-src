+  <script type="module">
+    const drinkCardSheet = new CSSStyleSheet();
+    drinkCardSheet.replaceSync(`
+      @layer base, theme, variants, responsive;
+
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          container-name: drink-card;
+          border-radius: 8px;
+          transition: transform 0.2s ease, box-shadow 0.2s ease;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        article {
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          align-items: center;
+          gap: 12px;
+          height: 100%;
+          padding: 20px;
+          border-radius: inherit;
+          text-align: center;
+          box-sizing: border-box;
+        }
+
+        header {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 6px;
+        }
+
+        .body {
+          display: flex;
+          flex-direction: column;
+          gap: 8px;
+          flex: 1;
+        }
+
+        footer {
+          margin-top: 8px;
+        }
+
+        .badge {
+          display: inline-block;
+          padding: 2px 10px;
+          border-radius: 999px;
+          font-size: 0.75rem;
+          font-weight: 700;
+        }
+
+        .badge[hidden] {
+          display: none;
+        }
+
+        .cta {
+          display: inline-block;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          font: inherit;
+          transition: background 0.3s ease, color 0.3s ease;
+        }
+
+        ::slotted([slot="title"]) {
+          margin: 0;
+          line-height: 1.25;
+        }
+
+        ::slotted(p) {
+          margin: 0;
+        }
+      }
+
+      @layer theme {
+        :host {
+          --_bg: var(--card-bg, var(--light, #ffffff));
+          --_fg: var(--card-fg, var(--text, #3e2723));
+          --_primary: var(--card-primary, var(--primary, #4e342e));
+          --_secondary: var(--card-secondary, var(--secondary, #d7ccc8));
+          --_accent: var(--card-accent, var(--accent, #ffab40));
+          --_border: 1px solid transparent;
+          --_shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          color: var(--_fg);
+        }
+
+        article {
+          background: var(--_bg);
+          color: var(--_fg);
+          border: var(--_border);
+          box-shadow: var(--_shadow);
+        }
+
+        .badge {
+          background: var(--_secondary);
+          color: var(--_primary);
+        }
+
+        .cta {
+          background: var(--_primary);
+          color: #ffffff;
+        }
+
+        .cta:hover {
+          background: var(--_fg);
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          --_bg: linear-gradient(135deg, #ffffff 0%, #fff8f0 100%);
+          --_border: 2px solid var(--_accent);
+          --_shadow: 0 4px 14px rgba(78, 52, 46, 0.14);
+        }
+
+        :host([variant="featured"]) .badge {
+          background: var(--_accent);
+          color: var(--_fg);
+        }
+
+        :host([variant="roast"]) {
+          --_border: 1px solid var(--_primary);
+          border-top: 4px solid var(--_primary);
+        }
+
+        :host([variant="chilled"]) {
+          --_border: 1px solid var(--_secondary);
+          border-top: 4px solid var(--_accent);
+        }
+
+        :host(:hover) {
+          transform: translateY(-2px);
+        }
+      }
+
+      @layer responsive {
+        @container drink-card (min-width: 480px) {
+          article {
+            flex-direction: row;
+            text-align: start;
+            align-items: center;
+            padding: 24px 28px;
+            gap: 24px;
+          }
+
+          header {
+            align-items: flex-start;
+            min-width: 180px;
+          }
+
+          .body {
+            align-items: flex-start;
+          }
+
+          footer {
+            margin-top: 0;
+            flex-shrink: 0;
+          }
+        }
+      }
+    `);
+
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <article part="card">
+        <header part="header">
+          <span class="badge" part="badge" hidden></span>
+          <slot name="title"></slot>
+        </header>
+        <div class="body" part="body">
+          <slot></slot>
+        </div>
+        <footer part="footer">
+          <a class="cta" part="cta" href="/menu">
+            <slot name="cta">View Details</slot>
+          </a>
+        </footer>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['variant', 'badge', 'href'];
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [drinkCardSheet];
+        this.shadowRoot.append(drinkCardTemplate.content.cloneNode(true));
+      }
+
+      connectedCallback() {
+        this.#render();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.isConnected) {
+          this.#render();
+        }
+      }
+
+      get variant() {
+        return this.getAttribute('variant') ?? '';
+      }
+
+      set variant(val) {
+        val ? this.setAttribute('variant', val) : this.removeAttribute('variant');
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(val) {
+        val ? this.setAttribute('badge', val) : this.removeAttribute('badge');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '/menu';
+      }
+
+      set href(val) {
+        val ? this.setAttribute('href', val) : this.removeAttribute('href');
+      }
+
+      #render() {
+        const badgeEl = this.shadowRoot.querySelector('.badge');
+        const ctaEl = this.shadowRoot.querySelector('.cta');
+
+        if (badgeEl) {
+          const badgeText = this.badge;
+          badgeEl.textContent = badgeText;
+          badgeEl.hidden = !badgeText;
+        }
+
+        if (ctaEl) {
+          ctaEl.setAttribute('href', this.href);
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
