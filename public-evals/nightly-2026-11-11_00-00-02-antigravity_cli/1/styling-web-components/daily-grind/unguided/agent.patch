+        }
+
+        :host([variant="dark"]) {
+          --card-surface: linear-gradient(160deg, var(--card-primary) 0%, var(--card-primary-dark) 100%);
+          --card-text: var(--light, #fafafa);
+          --card-border: 1px solid rgba(255, 171, 64, 0.4);
+          --card-accent-strip: var(--card-accent);
+          --badge-bg: rgba(255, 171, 64, 0.2);
+          --badge-color: var(--card-accent);
+          --btn-bg: var(--card-accent);
+          --btn-color: var(--card-primary-dark);
+          --btn-hover-bg: #ffd180;
+          color: var(--light, #fafafa);
+        }
+
+        :host([variant="dark"]) ::slotted([slot="title"]),
+        :host([variant="dark"]) ::slotted(h3) {
+          color: #ffffff;
+        }
+
+        :host([variant="dark"]) ::slotted([slot="description"]),
+        :host([variant="dark"]) ::slotted(p) {
+          color: var(--card-secondary);
+        }
+
+        :host([variant="cold"]) {
+          --card-surface: linear-gradient(160deg, #ffffff 0%, #f3efe9 100%);
+          --card-border: 1px solid var(--card-secondary);
+          --card-accent-strip: var(--card-secondary);
+          --badge-bg: var(--card-primary);
+          --badge-color: var(--light, #fafafa);
+        }
+      }
+
+      @layer responsive {
+        /* Container queries responding to each card's own inline dimensions */
+        @container drink-card (max-width: 260px) {
+          .card-shell {
+            padding: 14px;
+            gap: 10px;
+          }
+
+          .card-header {
+            flex-direction: column;
+            align-items: center;
+          }
+
+          .btn {
+            width: 100%;
+          }
+        }
+
+        @container drink-card (min-width: 440px) {
+          .card-shell {
+            display: grid;
+            grid-template-columns: 1fr auto;
+            grid-template-areas:
+              "header header"
+              "body footer";
+            align-items: center;
+            text-align: left;
+            padding: 24px 28px;
+            column-gap: 24px;
+          }
+
+          .card-header {
+            grid-area: header;
+            border-bottom: 1px solid rgba(78, 52, 46, 0.12);
+            padding-bottom: 10px;
+          }
+
+          .card-body {
+            grid-area: body;
+            align-items: flex-start;
+          }
+
+          .card-footer {
+            grid-area: footer;
+            padding-top: 0;
+            justify-content: flex-end;
+          }
+
+          ::slotted([slot="title"]),
+          ::slotted(h3) {
+            font-size: clamp(1.3rem, 3.2cqi, 1.6rem);
+          }
+
+          ::slotted([slot="meta"]) {
+            justify-content: flex-start;
+          }
+        }
+      }
+
+      @layer overrides {
+        :host([disabled]) {
+          opacity: 0.6;
+          pointer-events: none;
+        }
+      }
+    </style>
+
+    <article class="card-shell" part="card">
+      <div class="card-accent" part="accent-bar" aria-hidden="true"></div>
+      <header class="card-header" part="header">
+        <span class="badge" part="badge">
+          <slot name="badge"><span class="badge-text">Seasonal</span></slot>
+        </span>
+        <span class="price" part="price">
+          <slot name="price"><span class="price-text"></span></slot>
+        </span>
+      </header>
+      <div class="card-body" part="body">
+        <div class="title-wrap" part="title">
+          <slot name="title"><h3>Featured Drink</h3></slot>
+        </div>
+        <div class="description-wrap" part="description">
+          <slot name="description"><slot></slot></slot>
+        </div>
+        <div class="meta-wrap" part="meta">
+          <slot name="meta"></slot>
+        </div>
+      </div>
+      <footer class="card-footer" part="footer">
+        <slot name="action">
+          <a class="btn" part="button" href="/menu">View Details</a>
+        </slot>
+      </footer>
+    </article>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['variant', 'badge', 'price', 'href', 'cta-label'];
+      }
+
+      constructor() {
+        super();
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        if (template) {
+          shadowRoot.appendChild(template.content.cloneNode(true));
+        }
+      }
+
+      connectedCallback() {
+        this.#syncAttributes();
+      }
+
+      attributeChangedCallback() {
+        this.#syncAttributes();
+      }
+
+      #syncAttributes() {
+        if (!this.shadowRoot) return;
+
+        const badgeTextEl = this.shadowRoot.querySelector('.badge-text');
+        if (badgeTextEl) {
+          badgeTextEl.textContent = this.getAttribute('badge') || 'Seasonal';
+        }
+
+        const priceTextEl = this.shadowRoot.querySelector('.price-text');
+        if (priceTextEl) {
+          priceTextEl.textContent = this.getAttribute('price') || '';
+        }
+
+        const buttonEl = this.shadowRoot.querySelector('[part="button"]');
+        if (buttonEl) {
+          buttonEl.setAttribute('href', this.getAttribute('href') || '/menu');
+          buttonEl.textContent = this.getAttribute('cta-label') || 'View Details';
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
