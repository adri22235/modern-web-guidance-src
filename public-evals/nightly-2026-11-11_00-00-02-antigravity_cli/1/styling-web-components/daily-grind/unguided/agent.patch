+          --card-accent-strip: linear-gradient(90deg, var(--card-primary), var(--card-accent));
+          --badge-bg: var(--card-accent);
+          --badge-color: var(--card-primary-dark);
+          --btn-bg: var(--card-primary);
+          --btn-hover-bg: var(--card-primary-dark);
