+  <template id="drink-card-template">
+    <style>
+      /* Structured priority tiers using CSS Cascade Layers */
+      @layer reset, base, layout, components, variants, responsive, overrides;
+
+      @layer reset {
+        *,
+        *::before,
+        *::after {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          /* Inherit coffee theme tokens from document :root across Shadow DOM boundary */
+          --card-primary: var(--primary, #4e342e);
+          --card-primary-dark: var(--primary-dark, #3e2723);
+          --card-secondary: var(--secondary, #d7ccc8);
+          --card-accent: var(--accent, #ffab40);
+          --card-text: var(--text, #3e2723);
+          --card-surface: var(--surface, #ffffff);
+          --card-radius: var(--radius-md, 10px);
+          --card-shadow: var(--shadow-sm, 0 2px 6px rgba(62, 39, 35, 0.1));
+          --card-border: 1px solid rgba(78, 52, 46, 0.12);
+          --card-accent-strip: var(--card-primary);
+          --badge-bg: var(--card-secondary);
+          --badge-color: var(--card-primary-dark);
+          --btn-bg: var(--card-primary);
+          --btn-color: #ffffff;
+          --btn-hover-bg: var(--card-primary-dark);
+
+          display: block;
+          container-type: inline-size;
+          container-name: drink-card;
+          font-family: inherit;
+          line-height: inherit;
+          color: var(--card-text);
+          background: var(--card-surface);
+          border: var(--card-border);
+          border-radius: var(--card-radius);
+          box-shadow: var(--card-shadow);
+          overflow: hidden;
+          transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        :host(:hover),
+        :host(:focus-within) {
+          transform: translateY(-3px);
+          box-shadow: var(--shadow-md, 0 10px 24px rgba(62, 39, 35, 0.16));
+        }
+      }
+
+      @layer layout {
+        .card-shell {
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          min-height: 100%;
+          padding: 20px;
+          gap: 14px;
+          text-align: center;
+          position: relative;
+        }
+
+        .card-accent {
+          position: absolute;
+          inset: 0 0 auto 0;
+          height: 4px;
+          background: var(--card-accent-strip);
+        }
+
+        .card-header {
+          display: flex;
+          align-items: center;
+          justify-content: space-between;
+          gap: 8px;
+          padding-top: 4px;
+        }
+
+        .card-body {
+          display: flex;
+          flex-direction: column;
+          gap: 10px;
+          flex: 1 1 auto;
+          justify-content: center;
+        }
+
+        .card-footer {
+          display: flex;
+          align-items: center;
+          justify-content: center;
+          padding-top: 6px;
+        }
+      }
+
+      @layer components {
+        .badge {
+          display: inline-flex;
+          align-items: center;
+          padding: 3px 10px;
+          border-radius: 999px;
+          font-size: 0.72rem;
+          background: var(--badge-bg);
