+        }
+
+        .price {
+          font-size: 1rem;
+          font-weight: 700;
+          color: var(--card-primary);
+        }
+
+        /* Default styling for projected light-DOM content via ::slotted() */
+        ::slotted([slot="title"]),
+        ::slotted(h3) {
+          margin: 0;
+          font-size: 1.25rem;
+          color: var(--card-primary);
+          line-height: 1.3;
+        }
+
+        ::slotted([slot="description"]),
