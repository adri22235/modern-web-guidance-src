+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const slides = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('#gallery-thumbnails button'));
+      const statusEl = document.getElementById('gallery-snap-status');
+
+      let activeIndex = 0;
+      let pendingIndex = null;
+      let clickedTargetIndex = null;
+      let settleTimer = null;
+      let isScrolling = false;
+      let lastSettledScrollLeft = 0;
+      let nativeChangingActive = false;
+
+      function detectSnapSupport() {
+        return (
+          'onscrollsnapchange' in window &&
+          'onscrollsnapchanging' in window &&
+          'onscrollsnapchange' in gallery &&
+          'onscrollsnapchanging' in gallery
+        );
+      }
+
+      const supportsSnapEvents = detectSnapSupport();
+      gallery.dataset.snapSupport = supportsSnapEvents ? 'native' : 'fallback';
+      gallery.dataset.fallback = String(!supportsSnapEvents);
+      if (!supportsSnapEvents) {
+        gallery.classList.add('fallback');
+      }
+      if (statusEl) {
+        statusEl.dataset.snapMode = supportsSnapEvents ? 'native' : 'fallback';
+        statusEl.textContent = supportsSnapEvents
+          ? 'Snap Detection: Native'
+          : 'Snap Detection: Fallback';
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        pendingIndex = index;
+        thumbnails.forEach((btn, i) => {
+          const isPending = i === index;
+          btn.classList.toggle('pending', isPending);
+          if (isPending) {
+            btn.setAttribute('data-state', 'pending');
+          } else if (btn.getAttribute('data-state') === 'pending') {
+            btn.setAttribute('data-state', i === activeIndex ? 'active' : 'idle');
+          }
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        if (settleTimer) {
+          clearTimeout(settleTimer);
+          settleTimer = null;
+        }
+        activeIndex = index;
+        pendingIndex = null;
+        clickedTargetIndex = null;
+        isScrolling = false;
+        nativeChangingActive = false;
+        lastSettledScrollLeft = gallery.scrollLeft;
+
+        thumbnails.forEach((btn, i) => {
+          const isActive = i === index;
+          btn.classList.remove('pending');
+          btn.classList.toggle('active', isActive);
+          btn.setAttribute('aria-selected', String(isActive));
+          btn.setAttribute('aria-current', String(isActive));
+          btn.setAttribute('data-state', isActive ? 'active' : 'idle');
+        });
+
+        slides.forEach((slide, i) => {
+          slide.setAttribute('data-active', String(i === index));
+        });
+      }
+
+      function getSlideIndexFromEvent(event) {
+        const target =
+          event.snapTargetInline ||
+          event.snapTargetBlock ||
+          (event.detail && (event.detail.snapTargetInline || event.detail.snapTargetBlock || event.detail.target));
+        if (target) {
+          const idx = slides.indexOf(target);
+          if (idx !== -1) return idx;
+          const closestSlide = target.closest && target.closest('.gallery-item');
+          if (closestSlide) {
+            const cIdx = slides.indexOf(closestSlide);
+            if (cIdx !== -1) return cIdx;
+          }
+        }
+        if (event.detail && typeof event.detail.index === 'number') {
+          return event.detail.index;
+        }
+        return -1;
+      }
+
+      function getClosestSlideIndex() {
+        if (!slides.length) return 0;
+        const scrollLeft = gallery.scrollLeft;
+        let bestIndex = 0;
+        let minDistance = Infinity;
+        slides.forEach((slide, i) => {
+          const dist = Math.abs(slide.offsetLeft - scrollLeft);
+          if (dist < minDistance) {
+            minDistance = dist;
+            bestIndex = i;
+          }
+        });
+        return bestIndex;
+      }
+
+      function getPreviewSlideIndex() {
+        if (clickedTargetIndex !== null) {
+          return clickedTargetIndex;
+        }
+        const closest = getClosestSlideIndex();
+        if (closest !== activeIndex) {
+          return closest;
+        }
+        const activeSlide = slides[activeIndex];
+        if (!activeSlide) return closest;
+        const delta = gallery.scrollLeft - activeSlide.offsetLeft;
+        if (Math.abs(delta) > 5) {
+          const nextIdx = delta > 0 ? activeIndex + 1 : activeIndex - 1;
+          if (nextIdx >= 0 && nextIdx < slides.length) {
+            return nextIdx;
+          }
+        }
+        return closest;
+      }
+
+      function scheduleFallbackSettle() {
+        if (settleTimer) {
+          clearTimeout(settleTimer);
+        }
+        settleTimer = setTimeout(() => {
+          settleTimer = null;
+          const settledIdx = getClosestSlideIndex();
+          setActive(settledIdx);
+        }, 160);
+      }
+
+      // Native Scroll Snap Events
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        isScrolling = true;
+        nativeChangingActive = true;
+        const idx = getSlideIndexFromEvent(event);
+        const targetIdx = idx !== -1 ? idx : getPreviewSlideIndex();
+        setPending(targetIdx);
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const idx = getSlideIndexFromEvent(event);
+        const targetIdx = idx !== -1 ? idx : getClosestSlideIndex();
+        setActive(targetIdx);
+      });
+
+      // Fallback & mid-scroll tracking via scroll + scrollend + IntersectionObserver
+      gallery.addEventListener('scroll', () => {
+        if (Math.abs(gallery.scrollLeft - lastSettledScrollLeft) < 2 && clickedTargetIndex === null) {
+          return;
+        }
+        isScrolling = true;
+        if (!nativeChangingActive) {
+          const previewIdx = getPreviewSlideIndex();
+          setPending(previewIdx);
+        }
+        scheduleFallbackSettle();
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', () => {
+        const settledIdx = getClosestSlideIndex();
+        setActive(settledIdx);
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (!isScrolling || nativeChangingActive) return;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
+                const idx = slides.indexOf(entry.target);
+                if (idx !== -1 && clickedTargetIndex === null) {
+                  setPending(idx);
+                }
+              }
+            });
+          },
+          {
+            root: gallery,
+            threshold: [0.5, 0.75]
+          }
+        );
+        slides.forEach((slide) => observer.observe(slide));
+      }
+
+      thumbnails.forEach((btn, index) => {
+        btn.addEventListener('click', () => {
+          const targetSlide = slides[index];
+          if (!targetSlide) return;
+          const targetLeft = targetSlide.offsetLeft;
+          if (Math.abs(gallery.scrollLeft - targetLeft) < 2) {
+            setActive(index);
+            return;
+          }
+          clickedTargetIndex = index;
+          isScrolling = true;
+          setPending(index);
+          gallery.scrollTo({
+            left: targetLeft,
+            behavior: 'smooth'
+          });
+          scheduleFallbackSettle();
+        });
+      });
+    })();
+  </script>
 </body>
 
