+  <script type="module">
+    // Feature-detect scheduler.postTask and conditionally load scheduler-polyfill when missing
+    let schedulerReady = ('scheduler' in window && 'postTask' in window.scheduler);
+    if (!schedulerReady) {
+      try {
+        await import('scheduler-polyfill');
+        schedulerReady = ('scheduler' in window && 'postTask' in window.scheduler);
+      } catch {
+        // Fallback handled gracefully below if bare module specifier is unavailable without bundler
+      }
+    }
+
+    // Yield helper with feature detection for scheduler.yield() and setTimeout fallback
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        await window.scheduler.yield();
+      } else {
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+
+    let taskIdCounter = 0;
+    let queuedCount = 0;
+    let completedCount = 0;
+    let totalYields = 0;
+
+    const statQueuedEl = document.getElementById('stat-queued');
+    const statCompletedEl = document.getElementById('stat-completed');
+    const statYieldsEl = document.getElementById('stat-yields');
+    const taskQueueListEl = document.getElementById('task-queue-list');
+    const executionLogListEl = document.getElementById('execution-log-list');
+    const queueEmptyStateEl = document.getElementById('queue-empty-state');
+    const logEmptyStateEl = document.getElementById('log-empty-state');
+
+    function updateStats() {
+      statQueuedEl.textContent = String(queuedCount);
+      statCompletedEl.textContent = String(completedCount);
+      statYieldsEl.textContent = String(totalYields);
+      queueEmptyStateEl.style.display = taskQueueListEl.children.length <= 1 ? 'block' : 'none';
+    }
+
+    function appendLog(message, priority = 'user-visible') {
+      if (logEmptyStateEl.parentNode === executionLogListEl) {
+        logEmptyStateEl.style.display = 'none';
+      }
+      const li = document.createElement('li');
+      li.className = `log-entry log-${priority}`;
+      const time = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
+      li.textContent = `[${time}] [${priority}] ${message}`;
+      executionLogListEl.prepend(li);
+    }
+
+    // Perform simulated heavy CPU processing broken up into <= 50ms chunks
+    async function runChunkedWork(totalDurationMs, onProgress, signal) {
+      const startTime = performance.now();
+      let elapsed = 0;
+      let deadline = performance.now() + 50;
+
+      while (elapsed < totalDurationMs) {
+        if (signal?.aborted) {
+          throw new DOMException('Task aborted', 'AbortError');
+        }
+
+        // Busy-spin in small increments to simulate heavy synchronous work
+        const spinUntil = Math.min(performance.now() + 12, startTime + totalDurationMs);
+        while (performance.now() < spinUntil) {
+          // Simulated computation
+        }
+
+        elapsed = performance.now() - startTime;
+        const progress = Math.min(100, Math.round((elapsed / totalDurationMs) * 100));
+        onProgress(progress);
+
+        // MANDATORY: Yield to the main thread periodically when 50ms deadline is reached
+        if (performance.now() >= deadline && elapsed < totalDurationMs) {
+          totalYields++;
+          updateStats();
+          await yieldToMain();
+          deadline = performance.now() + 50;
+        }
+      }
+    }
+
+    function scheduleOperation({ name, priority, durationMs }) {
+      const id = ++taskIdCounter;
+      queuedCount++;
+
+      // Create TaskController if supported so queued tasks can be reprioritized or aborted
+      const controller = typeof TaskController !== 'undefined'
+        ? new TaskController({ priority })
+        : new AbortController();
+
+      const itemEl = document.createElement('li');
+      itemEl.className = 'task-item';
+      itemEl.dataset.taskId = String(id);
+
+      const topRow = document.createElement('div');
+      topRow.className = 'task-item-top';
+
+      const titleSpan = document.createElement('span');
+      titleSpan.innerHTML = `<strong>#${id} ${name}</strong> <span class="task-status">(Queued)</span>`;
+
+      const actionsDiv = document.createElement('div');
+      actionsDiv.className = 'task-item-actions';
+
+      const badgeSpan = document.createElement('span');
+      badgeSpan.className = `priority-tag tag-${priority}`;
+      badgeSpan.textContent = priority;
+      actionsDiv.appendChild(badgeSpan);
+
+      let currentPriority = priority;
+      if (priority !== 'user-blocking' && 'setPriority' in controller) {
+        const promoteBtn = document.createElement('button');
+        promoteBtn.type = 'button';
+        promoteBtn.className = 'task-action-btn';
+        promoteBtn.textContent = 'Promote';
+        promoteBtn.title = 'Promote to user-blocking via TaskController.setPriority()';
+        promoteBtn.addEventListener('click', () => {
+          controller.setPriority('user-blocking');
+          currentPriority = 'user-blocking';
+          badgeSpan.className = 'priority-tag tag-user-blocking';
+          badgeSpan.textContent = 'user-blocking';
+          promoteBtn.remove();
+          appendLog(`Promoted #${id} (${name}) to user-blocking`, 'user-blocking');
+        });
+        actionsDiv.appendChild(promoteBtn);
+      }
+
+      const cancelBtn = document.createElement('button');
+      cancelBtn.type = 'button';
+      cancelBtn.className = 'task-action-btn';
+      cancelBtn.textContent = 'Cancel';
+      cancelBtn.addEventListener('click', () => {
+        controller.abort();
+      });
+      actionsDiv.appendChild(cancelBtn);
+
+      topRow.appendChild(titleSpan);
+      topRow.appendChild(actionsDiv);
+
+      const progressTrack = document.createElement('div');
+      progressTrack.className = 'progress-track';
+      const progressFill = document.createElement('div');
+      progressFill.className = 'progress-fill';
+      progressTrack.appendChild(progressFill);
+
+      itemEl.appendChild(topRow);
+      itemEl.appendChild(progressTrack);
+      taskQueueListEl.appendChild(itemEl);
+      updateStats();
+
+      const statusSpan = titleSpan.querySelector('.task-status');
+
+      const executeTask = async () => {
+        if (controller.signal.aborted) return;
+        statusSpan.textContent = '(Running)';
+        const startStamp = performance.now();
+        appendLog(`Started #${id}: ${name}`, currentPriority);
+
+        await runChunkedWork(
+          durationMs,
+          (pct) => {
+            progressFill.style.width = `${pct}%`;
+          },
+          controller.signal
+        );
+
+        const totalTime = Math.round(performance.now() - startStamp);
+        completedCount++;
+        appendLog(`Completed #${id}: ${name} (${totalTime}ms)`, currentPriority);
+      };
+
+      // Schedule via scheduler.postTask using controller.signal (omitting explicit priority so controller.setPriority works)
+      let taskPromise;
+      if ('scheduler' in window && 'postTask' in window.scheduler) {
+        const postTaskOptions = typeof TaskController !== 'undefined'
+          ? { signal: controller.signal }
+          : { priority: currentPriority, signal: controller.signal };
+        taskPromise = window.scheduler.postTask(executeTask, postTaskOptions);
+      } else {
+        // Fallback when scheduler.postTask is unavailable
+        const delayMap = { 'user-blocking': 0, 'user-visible': 10, 'background': 25 };
+        taskPromise = new Promise((resolve, reject) => {
+          setTimeout(async () => {
+            if (controller.signal.aborted) {
+              reject(new DOMException('Task aborted', 'AbortError'));
+              return;
+            }
+            try {
+              await executeTask();
+              resolve();
+            } catch (err) {
+              reject(err);
+            }
+          }, delayMap[currentPriority] ?? 0);
+        });
+      }
+
+      taskPromise
+        .catch((err) => {
+          if (err?.name === 'AbortError') {
+            appendLog(`Cancelled #${id}: ${name}`, currentPriority);
+          } else {
+            appendLog(`Error in #${id}: ${err?.message || err}`, currentPriority);
+          }
+        })
+        .finally(() => {
+          queuedCount = Math.max(0, queuedCount - 1);
+          itemEl.remove();
+          updateStats();
+        });
+
+      return taskPromise;
+    }
+
+    document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+      scheduleOperation({
+        name: 'Urgent Checkout Processing',
+        priority: 'user-blocking',
+        durationMs: 140
+      });
+    });
+
+    document.getElementById('btn-menu-update').addEventListener('click', () => {
+      scheduleOperation({
+        name: 'Standard Menu Inventory Sync',
+        priority: 'user-visible',
+        durationMs: 180
+      });
+    });
+
+    document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+      scheduleOperation({
+        name: 'Background Telemetry Logging',
+        priority: 'background',
+        durationMs: 220
+      });
+    });
+
+    document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+      appendLog('Queuing mixed batch (Telemetry -> Menu -> Checkout -> Telemetry -> Checkout)...', 'user-visible');
+      // Enqueue in reverse/mixed order to demonstrate scheduler.postTask running higher priorities first
+      scheduleOperation({
+        name: 'Batch: Telemetry Flush #1',
+        priority: 'background',
+        durationMs: 160
+      });
+      scheduleOperation({
+        name: 'Batch: Seasonal Menu Refresh',
+        priority: 'user-visible',
+        durationMs: 150
+      });
+      scheduleOperation({
+        name: 'Batch: Express Order Checkout #1',
+        priority: 'user-blocking',
+        durationMs: 120
+      });
+      scheduleOperation({
+        name: 'Batch: Telemetry Analytics #2',
+        priority: 'background',
+        durationMs: 160
+      });
+      scheduleOperation({
+        name: 'Batch: Express Order Checkout #2',
+        priority: 'user-blocking',
+        durationMs: 120
+      });
+    });
+
+    document.getElementById('btn-clear-log').addEventListener('click', () => {
+      executionLogListEl.innerHTML = '';
+      executionLogListEl.appendChild(logEmptyStateEl);
+      logEmptyStateEl.style.display = 'block';
+    });
+  </script>
