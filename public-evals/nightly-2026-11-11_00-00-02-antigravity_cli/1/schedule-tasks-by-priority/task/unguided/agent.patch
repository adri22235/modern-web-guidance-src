+        updateStats();
+
+        const taskEl = createTaskElement(task);
+        const statusEl = taskEl.querySelector('[data-role="status"]');
+        const progressEl = taskEl.querySelector('[data-role="progress"]');
+        const stepDetailEl = taskEl.querySelector('[data-role="step-detail"]');
+        const execOrderEl = taskEl.querySelector('[data-role="exec-order"]');
+
+        let controller = null;
+        if (typeof TaskController !== 'undefined') {
+          try {
+            controller = new TaskController({ priority: task.priority });
+          } catch (e) {
+            controller = null;
+          }
+        }
+
+        const postTaskOptions = { priority: task.priority };
+        if (controller && controller.signal) {
+          postTaskOptions.signal = controller.signal;
+        }
+
+        return window.scheduler.postTask(async function () {
+          queuedCount = Math.max(0, queuedCount - 1);
+          const execOrder = ++executionOrderCounter;
+          const startTime = performance.now();
+
+          taskEl.setAttribute('data-status', 'running');
+          taskEl.setAttribute('data-execution-order', String(execOrder));
+          statusEl.textContent = 'Running';
+          statusEl.className = 'status-badge running';
+          execOrderEl.textContent = 'Exec #' + execOrder;
+          updateStats(task.name + ' (#' + task.id + ')');
+
+          appendLog(
+            'START [#' + execOrder + '] ' + task.name + ' (priority: ' + task.priority + ')',
+            task.priority
+          );
+
+          const totalChunks = task.chunks.length;
+          for (let i = 0; i < totalChunks; i++) {
+            stepDetailEl.textContent = 'Step ' + (i + 1) + '/' + totalChunks + ': ' + task.chunks[i];
+            performChunkWork(task.chunkWorkMs);
+            const pct = Math.round(((i + 1) / totalChunks) * 100);
+            progressEl.style.width = pct + '%';
+
+            // Yield between long-task chunks so the UI remains responsive
+            if (i < totalChunks - 1) {
+              await yieldToMainThread();
+            }
+          }
+
+          const elapsedMs = Math.max(1, Math.round(performance.now() - startTime));
+          taskEl.setAttribute('data-status', 'completed');
+          statusEl.textContent = 'Completed';
+          statusEl.className = 'status-badge completed';
+          stepDetailEl.textContent = 'Completed all ' + totalChunks + ' chunks (' + (totalChunks - 1) + ' yields)';
+          execOrderEl.textContent = 'Order #' + execOrder + ' • ' + elapsedMs + 'ms';
+
+          completedCount++;
+          updateStats(queuedCount > 0 ? 'Switching tasks...' : 'Idle');
+
+          appendLog(
+            'DONE  [#' + execOrder + '] ' + task.name + ' (' + task.priority + ') finished in ' + elapsedMs + 'ms',
+            task.priority
+          );
+
+          return {
+            id: task.id,
+            name: task.name,
+            priority: task.priority,
+            executionOrder: execOrder
+          };
+        }, postTaskOptions);
+      }
+
+      function scheduleMixedBatch() {
+        // Enqueue mixed tasks in reverse priority order (background -> user-visible -> user-blocking)
+        // scheduler.postTask executes them in strict priority order:
+        // 1. Urgent Checkout Task (user-blocking)
+        // 2. Standard Menu Update (user-visible)
+        // 3. Background Telemetry Logging (background)
+        scheduleOperation('telemetry');
+        scheduleOperation('menu');
+        scheduleOperation('checkout');
+      }
+
+      function clearQueueAndLog() {
+        queuedCount = 0;
+        completedCount = 0;
+        yieldCount = 0;
+        executionOrderCounter = 0;
+        taskCounter = 0;
+        updateStats('Idle');
+        taskQueueListEl.innerHTML =
+          '<li id="task-empty-state" class="task-empty">No operations queued. Use the buttons above to schedule tasks.</li>';
+        executionLogEl.innerHTML = '';
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', function () {
+        scheduleOperation('checkout');
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', function () {
+        scheduleOperation('menu');
+      });
+
+      document.getElementById('btn-telemetry-log').addEventListener('click', function () {
+        scheduleOperation('telemetry');
+      });
+
+      document.getElementById('btn-batch-tasks').addEventListener('click', function () {
+        scheduleMixedBatch();
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', function () {
+        clearQueueAndLog();
+      });
+
+      document.getElementById('btn-ui-ping').addEventListener('click', function () {
+        pingCount++;
+        pingCounterEl.textContent = String(pingCount);
+      });
+    })();
+  </script>
 </body>
 
 </html>
