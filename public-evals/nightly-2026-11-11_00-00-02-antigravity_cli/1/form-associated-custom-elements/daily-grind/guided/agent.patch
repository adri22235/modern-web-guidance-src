+  <script>
+    const supportsFACE =
+      'attachInternals' in HTMLElement.prototype &&
+      'setFormValue' in ElementInternals.prototype;
+
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+      static observedAttributes = ['value', 'required', 'disabled'];
+
+      #internals = null;
+      #value = '';
+      #defaultValue = '';
+      #initialized = false;
+      #fallbackInput = null;
+
+      constructor() {
+        super();
+        if (supportsFACE) {
+          this.#internals = this.attachInternals();
+          this.#internals.role = 'group';
+        }
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.#buildShadowDOM();
+      }
+
+      #buildShadowDOM() {
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              --_star-active: var(--star-color, #ffab40);
+              --_star-inactive: var(--star-inactive-color, #d7ccc8);
+              --_star-focus: var(--star-focus-color, #4e342e);
+              display: inline-block;
+            }
+
+            :host(:disabled),
+            :host([disabled]) {
+              opacity: 0.55;
+              pointer-events: none;
+            }
+
+            .stars {
+              display: inline-flex;
+              align-items: center;
+              gap: 0.35rem;
+            }
+
+            button {
+              font: inherit;
+              color: var(--_star-inactive);
+              background: transparent;
+              border: 2px solid transparent;
+              border-radius: 6px;
+              min-width: 48px;
+              min-height: 48px;
+              padding: 0.25rem;
+              font-size: 1.75rem;
+              line-height: 1;
+              cursor: pointer;
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+              transition: transform 0.15s ease, color 0.15s ease;
+            }
+
+            button[data-selected="true"] {
+              color: var(--_star-active);
+            }
+
+            button:hover:not(:disabled) {
+              transform: scale(1.1);
+              color: var(--_star-active);
+            }
+
+            button:focus-visible {
+              outline: 3px solid var(--_star-focus);
+              outline-offset: 2px;
+            }
+
+            button:disabled {
+              cursor: not-allowed;
+            }
+
+            .status-text {
+              font-size: 0.9rem;
+              margin-inline-start: 0.5rem;
+              color: inherit;
+            }
+          </style>
+          <div class="stars" part="stars">
+            ${[1, 2, 3, 4, 5].map((n) => `
+              <button
+                type="button"
+                part="star"
+                data-rating="${n}"
+                tabindex="${n === 1 ? '0' : '-1'}"
+                aria-label="${n} ${n === 1 ? 'star' : 'stars'}"
+                aria-pressed="false"
+              >&#9733;</button>
+            `).join('')}
+            <span class="status-text" part="status" aria-live="polite">No rating selected</span>
+          </div>
+        `;
+
+        this.shadowRoot.addEventListener('click', (e) => {
+          const btn = e.target.closest('button[data-rating]');
+          if (!btn || btn.disabled) return;
+          this.#commitUserValue(btn.dataset.rating);
+        });
+
+        this.shadowRoot.addEventListener('keydown', (e) => {
+          const buttons = Array.from(this.shadowRoot.querySelectorAll('button[data-rating]'));
+          const currentIndex = buttons.indexOf(this.shadowRoot.activeElement);
+          if (currentIndex === -1) return;
+
+          let nextIndex = -1;
+          if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+            nextIndex = Math.min(buttons.length - 1, currentIndex + 1);
+          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+            nextIndex = Math.max(0, currentIndex - 1);
+          } else if (e.key === 'Home') {
+            nextIndex = 0;
+          } else if (e.key === 'End') {
+            nextIndex = buttons.length - 1;
+          }
+
+          if (nextIndex !== -1) {
+            e.preventDefault();
+            const targetBtn = buttons[nextIndex];
+            if (!targetBtn.disabled) {
+              this.#commitUserValue(targetBtn.dataset.rating);
+              targetBtn.focus();
+            }
+          }
+        });
+      }
+
+      connectedCallback() {
+        if (!this.#initialized) {
+          this.#defaultValue = this.getAttribute('value') ?? '';
+          this.#value = this.#defaultValue;
+          this.#initialized = true;
+        }
+        if (!supportsFACE) {
+          this.#ensureFallbackInput();
+        }
+        if (this.hasAttribute('disabled')) {
+          this.formDisabledCallback(true);
+        }
+        this.#syncUI();
+        this.#syncFormState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'value') {
+          this.#value = newVal ?? '';
+          this.#syncUI();
+          this.#syncFormState();
+        } else if (name === 'required') {
+          this.#validate();
+        } else if (name === 'disabled') {
+          this.formDisabledCallback(this.hasAttribute('disabled'));
+        }
+      }
+
+      get value() {
+        return this.#value;
+      }
+
+      set value(v) {
+        const next = v == null ? '' : String(v);
+        if (this.#value === next) return;
+        this.#value = next;
+        this.#syncUI();
+        this.#syncFormState();
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(on) {
+        this.toggleAttribute('required', Boolean(on));
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      get form() {
+        return this.#internals ? this.#internals.form : this.closest('form');
+      }
+
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this.#internals?.validity;
+      }
+
+      get validationMessage() {
+        return this.#internals?.validationMessage ?? '';
+      }
+
+      get willValidate() {
+        return this.#internals ? this.#internals.willValidate : !this.disabled;
+      }
+
+      checkValidity() {
+        return this.#internals ? this.#internals.checkValidity() : true;
+      }
+
+      reportValidity() {
+        return this.#internals ? this.#internals.reportValidity() : true;
+      }
+
+      #commitUserValue(newVal) {
+        this.value = newVal;
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+      }
+
+      #syncFormState() {
+        if (this.#internals) {
+          this.#internals.setFormValue(this.#value);
+        } else if (this.#fallbackInput) {
+          this.#fallbackInput.value = this.#value;
+        }
+        this.#validate();
+      }
+
+      #validate() {
+        if (!this.#internals) return;
+        const anchor = this.shadowRoot.querySelector('button[tabindex="0"]') ||
+          this.shadowRoot.querySelector('button');
+        if (this.hasAttribute('required') && !this.#value) {
+          this.#internals.setValidity(
+            { valueMissing: true },
+            'Please choose a star rating for your coffee.',
+            anchor
+          );
+          this.#internals.states?.add('invalid');
+        } else {
+          this.#internals.setValidity({});
+          this.#internals.states?.delete('invalid');
+          this.removeAttribute('aria-invalid');
+        }
+      }
+
+      #syncUI() {
+        const numeric = Number(this.#value) || 0;
+        const buttons = this.shadowRoot.querySelectorAll('button[data-rating]');
+        buttons.forEach((btn) => {
+          const rating = Number(btn.dataset.rating);
+          const isSelected = numeric >= rating && numeric > 0;
+          const isExact = numeric === rating;
+          btn.dataset.selected = String(isSelected);
+          btn.setAttribute('aria-pressed', String(isExact));
+          btn.setAttribute('tabindex', (isExact || (numeric === 0 && rating === 1)) ? '0' : '-1');
+        });
+        const status = this.shadowRoot.querySelector('.status-text');
+        if (status) {
+          status.textContent = numeric > 0 ? `${numeric} of 5 stars` : 'No rating selected';
+        }
+      }
+
+      #ensureFallbackInput() {
+        if (this.#fallbackInput) return;
+        const input = document.createElement('input');
+        input.type = 'text';
+        input.name = this.name;
+        input.value = this.#value;
+        input.required = this.required;
+        input.tabIndex = -1;
+        input.setAttribute('aria-hidden', 'true');
+        input.style.cssText = 'position:absolute;clip-path:inset(50%);overflow:hidden;width:1px;height:1px;margin:-1px;padding:0;border:0;white-space:nowrap;';
+        this.appendChild(input);
+        this.#fallbackInput = input;
+      }
+
+      formResetCallback() {
+        this.value = this.#defaultValue;
+        this.removeAttribute('aria-invalid');
+      }
+
+      formDisabledCallback(disabled) {
+        // Disable internal controls so they leave the tab order and ignore clicks.
+        // Do NOT toggle `disabled` on `this`, or a `<fieldset disabled>` toggle will
+        // leave the host permanently stuck with its own `disabled` attribute.
+        for (const btn of this.shadowRoot.querySelectorAll('button')) {
+          btn.disabled = disabled;
+        }
+        if (this.#fallbackInput) {
+          this.#fallbackInput.disabled = disabled;
+        }
+      }
+
+      formStateRestoreCallback(state, _mode) {
+        this.value = state ?? '';
+      }
+    }
+
+    customElements.define('star-rating', StarRating);
+
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackFieldset = document.getElementById('feedback-fieldset');
+    const toggleFieldsetBtn = document.getElementById('toggle-fieldset');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const ratingEl = document.getElementById('coffee-rating');
+
+    ratingEl.addEventListener('invalid', () => {
+      ratingEl.setAttribute('aria-invalid', 'true');
+    });
+
+    toggleFieldsetBtn.addEventListener('click', () => {
+      const nextDisabled = !feedbackFieldset.disabled;
+      feedbackFieldset.disabled = nextDisabled;
+      toggleFieldsetBtn.setAttribute('aria-pressed', String(nextDisabled));
+      toggleFieldsetBtn.textContent = nextDisabled ? 'Enable Fieldset' : 'Disable Fieldset';
+    });
+
+    feedbackForm.addEventListener('reset', () => {
+      feedbackStatus.hidden = true;
+      feedbackStatus.textContent = '';
+    });
+
+    feedbackForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const formData = new FormData(feedbackForm);
+      const name = formData.get('customer_name') || 'Coffee Lover';
+      const blend = formData.get('coffee_blend') || 'coffee';
+      const rating = formData.get('rating');
+      feedbackStatus.textContent = `Thank you, ${name}! Your ${rating}-star review for ${blend.replace(/-/g, ' ')} has been recorded.`;
+      feedbackStatus.hidden = false;
+    });
+  </script>
