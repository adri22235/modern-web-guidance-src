+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled', 'max', 'name'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this._value = '';
+        this._defaultValue = '';
+        this._defaultInitialized = false;
+        this._disabled = false;
+        this._hoverValue = 0;
+
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this._render();
+      }
+
+      connectedCallback() {
+        if (!this._defaultInitialized) {
+          this._defaultValue = this.getAttribute('value') || '';
+          this._value = this._defaultValue;
+          this._defaultInitialized = true;
+        }
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'radiogroup');
+        }
+        this._syncState();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        if (name === 'value') {
+          this._value = newValue !== null ? String(newValue) : '';
+          if (!this._defaultInitialized) {
+            this._defaultValue = this._value;
+            this._defaultInitialized = true;
+          }
+          this._syncState();
+        } else if (name === 'required') {
+          this._updateValidity();
+          this._updateUI();
+        } else if (name === 'disabled') {
+          this._disabled = this.hasAttribute('disabled');
+          this._updateUI();
+          this._updateValidity();
+        } else if (name === 'max') {
+          this._renderStars();
+          this._syncState();
+        }
+      }
+
+      get form() {
+        return this._internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', val);
+        }
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this._internals.validity;
+      }
+
+      get validationMessage() {
+        return this._internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this._internals.willValidate;
+      }
+
+      checkValidity() {
+        return this._internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this._internals.reportValidity();
+      }
+
+      get max() {
+        const parsed = parseInt(this.getAttribute('max') || '5', 10);
+        return Number.isNaN(parsed) || parsed < 1 ? 5 : parsed;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        const normalized = val === null || val === undefined || val === '' || val === 0 || val === '0'
+          ? ''
+          : String(val);
+        this._value = normalized;
+        this._syncState();
+      }
+
+      get defaultValue() {
+        return this._defaultValue;
+      }
+
+      set defaultValue(val) {
+        this._defaultValue = val === null || val === undefined ? '' : String(val);
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        if (val) {
+          this.setAttribute('required', '');
+        } else {
+          this.removeAttribute('required');
+        }
+      }
+
+      get disabled() {
+        return this._disabled || this.hasAttribute('disabled');
+      }
+
+      set disabled(val) {
+        const isDisabled = Boolean(val);
+        this._disabled = isDisabled;
+        if (isDisabled) {
+          this.setAttribute('disabled', '');
+        } else {
+          this.removeAttribute('disabled');
+        }
+      }
+
+      formAssociatedCallback(form) {
+        this._syncState();
+      }
+
+      formDisabledCallback(disabled) {
+        this._disabled = disabled;
+        this._updateUI();
+        this._updateValidity();
+      }
+
+      formResetCallback() {
+        this._value = this.getAttribute('value') ?? this._defaultValue ?? '';
+        this._hoverValue = 0;
+        this._syncState();
+      }
+
+      formStateRestoreCallback(state, mode) {
+        this._value = state !== null && state !== undefined ? String(state) : '';
+        this._syncState();
+      }
+
+      _syncState() {
+        const val = this._value ? String(this._value) : null;
+        this._internals.setFormValue(val, val);
+        this._updateValidity();
+        this._updateUI();
+      }
+
+      _updateValidity() {
+        if (this.disabled) {
+          this._internals.setValidity({});
+          return;
+        }
+        const numericVal = Number(this._value);
+        if (this.required && (!this._value || Number.isNaN(numericVal) || numericVal < 1)) {
+          const anchor = this.shadowRoot.querySelector('.star-btn') || undefined;
+          this._internals.setValidity(
+            { valueMissing: true },
+            'Please select a star rating.',
+            anchor
+          );
+        } else {
+          this._internals.setValidity({});
+        }
+      }
+
+      _selectRating(rating) {
+        if (this.disabled) return;
+        const nextVal = String(rating);
+        const changed = this._value !== nextVal;
+        this._value = nextVal;
+        this._syncState();
+        if (changed) {
+          this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+          this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        }
+      }
+
+      _handleKeyDown(e) {
+        if (this.disabled) return;
+        const max = this.max;
+        const current = parseInt(this._value || '0', 10) || 0;
+        let next = current;
+
+        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          next = current < max ? current + 1 : max;
+        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          next = current > 1 ? current - 1 : 1;
+        } else if (e.key === 'Home') {
+          e.preventDefault();
+          next = 1;
+        } else if (e.key === 'End') {
+          e.preventDefault();
+          next = max;
+        } else if (/^[1-9]$/.test(e.key)) {
+          const digit = parseInt(e.key, 10);
+          if (digit <= max) {
+            e.preventDefault();
+            next = digit;
+          }
+        } else {
+          return;
+        }
+
+        this._selectRating(next);
+        const targetBtn = this.shadowRoot.querySelector(`.star-btn[data-value="${next}"]`);
+        if (targetBtn) {
+          targetBtn.focus();
+        }
+      }
+
+      _render() {
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+              vertical-align: middle;
+              user-select: none;
+            }
+            .stars-wrapper {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+              padding: 4px 0;
+            }
+            .star-btn {
+              background: transparent;
+              border: none;
+              padding: 2px 4px;
+              font-size: 2rem;
+              line-height: 1;
+              cursor: pointer;
+              color: #d7ccc8;
+              transition: transform 0.15s ease, color 0.15s ease;
+              border-radius: 4px;
+            }
+            .star-btn.active {
+              color: #ffab40;
+            }
+            .star-btn.preview {
+              color: #ffca28;
+            }
+            .star-btn:focus-visible {
+              outline: 2px solid #4e342e;
+              outline-offset: 2px;
+            }
+            .star-btn:hover:not(:disabled) {
+              transform: scale(1.15);
+            }
+            .star-btn:disabled {
+              cursor: not-allowed;
+              opacity: 0.55;
+              transform: none;
+            }
+            .rating-text {
+              margin-left: 10px;
+              font-size: 0.9rem;
+              color: #4e342e;
+              font-weight: 500;
+            }
+          </style>
+          <div class="stars-wrapper" part="wrapper">
+            <div class="stars-container" part="stars"></div>
+            <span class="rating-text" part="label" aria-live="polite"></span>
+          </div>
+        `;
+        this._renderStars();
+      }
+
+      _renderStars() {
+        const container = this.shadowRoot.querySelector('.stars-container');
+        if (!container) return;
+        container.innerHTML = '';
+        const max = this.max;
+
+        for (let i = 1; i <= max; i++) {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.className = 'star-btn';
+          btn.dataset.value = String(i);
+          btn.setAttribute('role', 'radio');
+          btn.setAttribute('aria-label', `${i} out of ${max} stars`);
+          btn.textContent = '★';
+
+          btn.addEventListener('click', () => {
+            this._selectRating(i);
+          });
+
+          btn.addEventListener('mouseenter', () => {
+            if (this.disabled) return;
+            this._hoverValue = i;
+            this._updateUI();
+          });
+
+          btn.addEventListener('mouseleave', () => {
+            if (this.disabled) return;
+            this._hoverValue = 0;
+            this._updateUI();
+          });
+
+          btn.addEventListener('keydown', (e) => this._handleKeyDown(e));
+
+          container.appendChild(btn);
+        }
+      }
+
+      _updateUI() {
+        const buttons = this.shadowRoot.querySelectorAll('.star-btn');
+        const label = this.shadowRoot.querySelector('.rating-text');
+        const currentVal = parseInt(this._value || '0', 10) || 0;
+        const isDisabled = this.disabled;
+        const max = this.max;
+
+        this.setAttribute('aria-disabled', String(isDisabled));
+        this.setAttribute('aria-required', String(this.required));
+
+        buttons.forEach((btn, idx) => {
+          const starVal = idx + 1;
+          const isChecked = starVal === currentVal;
+          const isFilled = starVal <= currentVal;
+          const isPreview = !isDisabled && this._hoverValue > 0 && starVal <= this._hoverValue;
+
+          btn.disabled = isDisabled;
+          btn.classList.toggle('active', isFilled);
+          btn.classList.toggle('preview', isPreview);
+          btn.setAttribute('aria-checked', String(isChecked));
+
+          if (isDisabled) {
+            btn.tabIndex = -1;
+          } else if (currentVal > 0) {
+            btn.tabIndex = isChecked ? 0 : -1;
+          } else {
+            btn.tabIndex = starVal === 1 ? 0 : -1;
+          }
+        });
+
+        if (label) {
+          if (currentVal > 0) {
+            label.textContent = `${currentVal} / ${max} stars`;
+          } else {
+            label.textContent = 'No rating selected';
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('star-rating')) {
+      customElements.define('star-rating', StarRating);
+    }
+
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    if (feedbackForm && feedbackStatus) {
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(feedbackForm);
+        const name = formData.get('customerName') || 'Guest';
+        const drink = formData.get('drink') || 'Coffee';
+        const rating = formData.get('rating');
+
+        feedbackStatus.textContent = `Thank you, ${name}! Your ${rating}-star review for ${drink} has been received.`;
+        feedbackStatus.classList.add('visible');
+      });
+
+      feedbackForm.addEventListener('reset', () => {
+        feedbackStatus.textContent = '';
+        feedbackStatus.classList.remove('visible');
+      });
+    }
+  </script>
