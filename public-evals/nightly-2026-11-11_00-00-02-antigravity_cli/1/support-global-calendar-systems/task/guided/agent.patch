+  <script>
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function resolveCalendarId(candidates) {
+      for (const candidate of candidates) {
+        if (isCalendarSupported(candidate)) {
+          return candidate;
+        }
+      }
+      return candidates[0];
+    }
+
+    function initializeCalendarConverter() {
+      const dateInput = document.getElementById('converter-date-input');
+      if (!dateInput) return;
+
+      const todayIso = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      const calendarConfigs = [
+        {
+          elementId: 'islamic-date',
+          candidates: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic'],
+          locale: 'en-u-ca-islamic-umalqura',
+          formatOptions: { day: 'numeric', month: 'long', year: 'numeric' }
+        },
+        {
+          elementId: 'hebrew-date',
+          candidates: ['hebrew'],
+          locale: 'en-u-ca-hebrew',
+          formatOptions: { day: 'numeric', month: 'long', year: 'numeric' }
+        },
+        {
+          elementId: 'japanese-date',
+          candidates: ['japanese'],
+          locale: 'en-u-ca-japanese',
+          formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+        }
+      ];
+
+      function renderCalendars(isoDateStr) {
+        let selectedIsoDate;
+        try {
+          selectedIsoDate = isoDateStr
+            ? Temporal.PlainDate.from(isoDateStr)
+            : Temporal.Now.plainDateISO();
+        } catch {
+          selectedIsoDate = Temporal.Now.plainDateISO();
+        }
+
+        const currentTodayIso = Temporal.Now.plainDateISO();
+
+        for (const config of calendarConfigs) {
+          const cardEl = document.getElementById(config.elementId);
+          if (!cardEl) continue;
+
+          const calendarId = resolveCalendarId(config.candidates);
+          const supported = isCalendarSupported(calendarId);
+          const targetDate = supported
+            ? selectedIsoDate.withCalendar(calendarId)
+            : selectedIsoDate;
+          const todayInCalendar = supported
+            ? currentTodayIso.withCalendar(calendarId)
+            : currentTodayIso;
+
+          const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+          const relative = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+          const localeTag = supported ? `en-u-ca-${calendarId}` : config.locale;
+          const localizedDisplay = targetDate.toLocaleString(localeTag, config.formatOptions);
+
+          const localizedEl = cardEl.querySelector('[data-field="localized"]');
+          const relativeEl = cardEl.querySelector('[data-field="relative"]');
+          const yearEl = cardEl.querySelector('[data-field="year"]');
+          const monthEl = cardEl.querySelector('[data-field="month"]');
+          const monthCodeEl = cardEl.querySelector('[data-field="monthCode"]');
+          const monthsInYearEl = cardEl.querySelector('[data-field="monthsInYear"]');
+          const breakdownListEl = cardEl.querySelector('[data-field="monthsBreakdown"]');
+
+          if (localizedEl) localizedEl.textContent = localizedDisplay;
+          if (relativeEl) {
+            relativeEl.textContent = relative;
+            relativeEl.setAttribute('data-status', relative);
+          }
+          if (yearEl) yearEl.textContent = String(targetDate.year);
+          if (monthEl) monthEl.textContent = String(targetDate.month);
+          if (monthCodeEl) monthCodeEl.textContent = targetDate.monthCode;
+          if (monthsInYearEl) monthsInYearEl.textContent = String(targetDate.monthsInYear);
+
+          if (breakdownListEl) {
+            breakdownListEl.replaceChildren();
+            for (let m = 1; m <= targetDate.monthsInYear; m++) {
+              const monthDate = targetDate.with({ month: m, day: 1 });
+              const li = document.createElement('li');
+              li.className = 'month-chip' + (m === targetDate.month ? ' active-month' : '');
+              li.dataset.month = String(m);
+              li.dataset.monthCode = monthDate.monthCode;
+              li.dataset.days = String(monthDate.daysInMonth);
+
+              const codeSpan = document.createElement('span');
+              codeSpan.className = 'month-code';
+              codeSpan.textContent = monthDate.monthCode;
+
+              const daysSpan = document.createElement('span');
+              daysSpan.className = 'month-days';
+              daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+              li.append(codeSpan, daysSpan);
+              breakdownListEl.appendChild(li);
+            }
+          }
+        }
+      }
+
+      renderCalendars(dateInput.value);
+
+      dateInput.addEventListener('input', (e) => {
+        renderCalendars(e.target.value);
+      });
+      dateInput.addEventListener('change', (e) => {
+        renderCalendars(e.target.value);
+      });
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeCalendarConverter();
+    })();
+  </script>
 </body>
 
