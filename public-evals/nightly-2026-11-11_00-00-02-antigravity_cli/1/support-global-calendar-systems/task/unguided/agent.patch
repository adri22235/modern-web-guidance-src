+  <script>
+    (function () {
+      const CALENDARS = [
+        {
+          elementId: 'islamic-date',
+          title: 'Islamic Calendar',
+          calendarIds: ['islamic', 'islamic-umalqura', 'islamic-civil'],
+          includeEra: false
+        },
+        {
+          elementId: 'hebrew-date',
+          title: 'Hebrew Calendar',
+          calendarIds: ['hebrew'],
+          includeEra: false
+        },
+        {
+          elementId: 'japanese-date',
+          title: 'Japanese Calendar',
+          calendarIds: ['japanese'],
+          includeEra: true
+        }
+      ];
+
+      const dateInput = document.getElementById('calendar-date-input');
+      const globalStatusBadge = document.getElementById('global-date-status');
+
+      function getTodayISO() {
+        return Temporal.Now.plainDateISO();
+      }
+
+      function getRelativeStatus(selectedIsoDate, todayIsoDate) {
+        const cmp = Temporal.PlainDate.compare(selectedIsoDate, todayIsoDate);
+        if (cmp < 0) return 'Past';
+        if (cmp > 0) return 'Future';
+        return 'Today';
+      }
+
+      function toCalendarPlainDate(isoDate, calendarIds) {
+        for (const id of calendarIds) {
+          try {
+            return isoDate.withCalendar(id);
+          } catch (e) {
+            // Try next fallback calendar identifier if needed
+          }
+        }
+        throw new Error('Unsupported calendar: ' + calendarIds.join(', '));
+      }
+
+      function formatLocalizedDate(calDate, isoDate, calId, options) {
+        const fullOpts = Object.assign({ calendar: calId }, options);
+        try {
+          return calDate.toLocaleString('en-US', fullOpts);
+        } catch (e) {
+          try {
+            return calDate.toLocaleString('en-US', options);
+          } catch (e2) {
+            const utcDate = new Date(Date.UTC(isoDate.year, isoDate.month - 1, isoDate.day, 12, 0, 0));
+            return new Intl.DateTimeFormat('en-US', Object.assign({}, fullOpts, { timeZone: 'UTC' })).format(utcDate);
+          }
+        }
+      }
+
+      function getMonthsBreakdown(calDate) {
+        const total = calDate.monthsInYear;
+        const months = [];
+        for (let m = 1; m <= total; m++) {
+          let monthDate;
+          try {
+            monthDate = calDate.with({ month: m, day: 1 });
+          } catch (e) {
+            monthDate = Temporal.PlainDate.from({
+              calendar: calDate.calendarId,
+              year: calDate.year,
+              month: m,
+              day: 1
+            });
+          }
+          months.push({
+            month: m,
+            monthCode: monthDate.monthCode,
+            daysInMonth: monthDate.daysInMonth,
+            isCurrent: monthDate.monthCode === calDate.monthCode
+          });
+        }
+        return months;
+      }
+
+      function renderCalendarCards(dateStr) {
+        if (!dateStr) return;
+        let selectedIsoDate;
+        try {
+          selectedIsoDate = Temporal.PlainDate.from(dateStr);
+        } catch (e) {
+          return;
+        }
+
+        const todayIsoDate = getTodayISO();
+        const relativeStatus = getRelativeStatus(selectedIsoDate, todayIsoDate);
+        const statusClass = 'status-' + relativeStatus.toLowerCase();
+
+        if (globalStatusBadge) {
+          globalStatusBadge.textContent = relativeStatus;
+          globalStatusBadge.className = 'status-badge ' + statusClass;
+        }
+
+        for (const calConfig of CALENDARS) {
+          const cardEl = document.getElementById(calConfig.elementId);
+          if (!cardEl) continue;
+
+          const calDate = toCalendarPlainDate(selectedIsoDate, calConfig.calendarIds);
+          const calId = calDate.calendarId || calConfig.calendarIds[0];
+
+          const longOptions = {
+            year: 'numeric',
+            month: 'long',
+            day: 'numeric'
+          };
+          const shortOptions = {};
+          if (calConfig.includeEra) {
+            longOptions.era = 'long';
+            shortOptions.era = 'long';
+          }
+
+          const localizedLong = formatLocalizedDate(calDate, selectedIsoDate, calId, longOptions);
+          const localizedShort = formatLocalizedDate(calDate, selectedIsoDate, calId, shortOptions);
+          const months = getMonthsBreakdown(calDate);
+
+          const monthsListHtml = months
+            .map(function (m) {
+              const activeClass = m.isCurrent ? ' active-month' : '';
+              return (
+                '<li class="month-item' + activeClass + '">' +
+                '<span class="month-code">' + m.monthCode + '</span>: ' +
+                '<span class="month-days">' + m.daysInMonth + ' days</span>' +
+                '</li>'
+              );
+            })
+            .join('');
+
+          const secondaryLine =
+            localizedShort !== localizedLong
+              ? '<div class="localized-date-secondary">' + localizedShort + '</div>'
+              : '';
+
+          cardEl.innerHTML =
+            '<div class="calendar-card-header">' +
+              '<h3>' + calConfig.title + '</h3>' +
+              '<span class="status-badge ' + statusClass + '">' + relativeStatus + '</span>' +
+            '</div>' +
+            '<div class="localized-date-box">' +
+              '<div class="localized-date-primary">' + localizedLong + '</div>' +
+              secondaryLine +
+            '</div>' +
+            '<div class="calendar-meta">' +
+              '<div class="calendar-meta-item">' +
+                '<span class="calendar-meta-label">Converted Year</span>' +
+                '<span class="calendar-meta-value">' + calDate.year + '</span>' +
+              '</div>' +
+              '<div class="calendar-meta-item">' +
+                '<span class="calendar-meta-label">Month &amp; Code</span>' +
+                '<span class="calendar-meta-value">Month ' + calDate.month + ' (' + calDate.monthCode + ')</span>' +
+              '</div>' +
+              '<div class="calendar-meta-item">' +
+                '<span class="calendar-meta-label">Numeric Month</span>' +
+                '<span class="calendar-meta-value">' + calDate.month + '</span>' +
+              '</div>' +
+              '<div class="calendar-meta-item">' +
+                '<span class="calendar-meta-label">Month Code</span>' +
+                '<span class="calendar-meta-value">' + calDate.monthCode + '</span>' +
+              '</div>' +
+              '<div class="calendar-meta-item" style="grid-column: span 2;">' +
+                '<span class="calendar-meta-label">Total Months in Year</span>' +
+                '<span class="calendar-meta-value">' + calDate.monthsInYear + ' months</span>' +
+              '</div>' +
+            '</div>' +
+            '<div class="months-breakdown">' +
+              '<h4>Months in Year (' + calDate.monthsInYear + ')</h4>' +
+              '<ul class="months-list">' + monthsListHtml + '</ul>' +
+            '</div>';
+        }
+      }
+
+      const initialDateStr = getTodayISO().toString();
+      dateInput.value = initialDateStr;
+      renderCalendarCards(initialDateStr);
+
+      dateInput.addEventListener('input', function (e) {
+        renderCalendarCards(e.target.value);
+      });
+      dateInput.addEventListener('change', function (e) {
+        renderCalendarCards(e.target.value);
+      });
+    })();
+  </script>
 </body>
 
