+  <script type="module">
+    const carousel = document.querySelector('.carousel');
+    if (carousel) {
+      const track = carousel.querySelector('.carousel-track');
+      const slides = Array.from(track.children);
+      const prevButton = carousel.querySelector('button[data-direction="previous"]');
+      const nextButton = carousel.querySelector('button[data-direction="next"]');
+      const markersNav = carousel.querySelector('.carousel-markers');
+      const statusRegion = carousel.querySelector('[role="status"]');
+      const supportsLooping =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('order', 'sibling-index()') &&
+        slides.length >= 3;
+
+      let activeMarkerIndex = -1;
+      let pendingSlide = null;
+      let lastSettledSlide = null;
+      let rafId = 0;
+
+      const markers = slides.map((slide, index) => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.setAttribute('aria-label', slide.dataset.markerName || `Go to slide ${index + 1}`);
+        button.addEventListener('click', () => {
+          scrollToSlide(slide);
+        });
+        markersNav.append(button);
+        return button;
+      });
+
+      function getSlideOffset(slide) {
+        const trackRect = track.getBoundingClientRect();
+        const slideRect = slide.getBoundingClientRect();
+        return (slideRect.left + slideRect.width / 2) - (trackRect.left + trackRect.width / 2);
+      }
+
+      function getNearestSlide() {
+        let nearest = slides[0];
+        let minDistance = Infinity;
+        for (const slide of slides) {
+          const distance = Math.abs(getSlideOffset(slide));
+          if (distance < minDistance) {
+            minDistance = distance;
+            nearest = slide;
+          }
+        }
+        return nearest;
+      }
+
+      function getVisualSlides() {
+        return [...slides].sort(
+          (a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left
+        );
+      }
+
+      function setActiveMarker(index) {
+        if (index === activeMarkerIndex) return;
+        if (activeMarkerIndex >= 0 && markers[activeMarkerIndex]) {
+          markers[activeMarkerIndex].removeAttribute('aria-current');
+        }
+        activeMarkerIndex = index;
+        if (markers[index]) {
+          markers[index].setAttribute('aria-current', 'true');
+        }
+      }
+
+      function scrollToSlide(targetSlide) {
+        const targetIndex = slides.indexOf(targetSlide);
+        setActiveMarker(targetIndex);
+        const offset = getSlideOffset(targetSlide);
+        if (Math.abs(offset) < 1) {
+          pendingSlide = null;
+          return;
+        }
+        pendingSlide = targetSlide;
+        track.scrollBy({ left: offset });
+      }
+
+      function updateParking(currentSlide, currentIndex) {
+        if (!supportsLooping) {
+          track.style.setProperty('--current', String(currentIndex));
+          return;
+        }
+
+        const firstSlide = slides[0];
+        const lastSlide = slides[slides.length - 1];
+        const prevFirstOrder = getComputedStyle(firstSlide).order;
+        const prevLastOrder = getComputedStyle(lastSlide).order;
+        const beforeLeft = currentSlide.getBoundingClientRect().left;
+
+        track.style.scrollSnapType = 'none';
+        track.style.overflowX = 'hidden';
+        track.style.setProperty('--current', String(currentIndex));
+
+        const nextFirstOrder = getComputedStyle(firstSlide).order;
+        const nextLastOrder = getComputedStyle(lastSlide).order;
+        const parkingChanged =
+          prevFirstOrder !== nextFirstOrder || prevLastOrder !== nextLastOrder;
+
+        if (parkingChanged) {
+          const afterLeft = currentSlide.getBoundingClientRect().left;
+          const delta = afterLeft - beforeLeft;
+          if (delta !== 0) {
+            track.scrollBy({ left: delta, behavior: 'instant' });
+          }
+          track.style.scrollSnapType = '';
+          requestAnimationFrame(() => {
+            requestAnimationFrame(() => {
+              track.style.overflowX = '';
+            });
+          });
+        } else {
+          track.style.scrollSnapType = '';
+          track.style.overflowX = '';
+        }
+
+        firstSlide.inert = nextFirstOrder !== '0' && currentSlide !== firstSlide;
+        lastSlide.inert = nextLastOrder !== '0' && currentSlide !== lastSlide;
+      }
+
+      function updateButtons(currentSlide) {
+        const visualSlides = getVisualSlides();
+        const visualIndex = visualSlides.indexOf(currentSlide);
+        prevButton.disabled = visualIndex <= 0;
+        nextButton.disabled = visualIndex >= visualSlides.length - 1;
+      }
+
+      function onScrollSettled(isInitial = false) {
+        const currentSlide = getNearestSlide();
+        if (!isInitial && pendingSlide && currentSlide !== pendingSlide) {
+          return;
+        }
+
+        const currentIndex = slides.indexOf(currentSlide);
+        pendingSlide = null;
+        setActiveMarker(currentIndex);
+        updateParking(currentSlide, currentIndex);
+        updateButtons(currentSlide);
+
+        if (isInitial) {
+          lastSettledSlide = currentSlide;
+          return;
+        }
+
+        if (currentSlide !== lastSettledSlide) {
+          lastSettledSlide = currentSlide;
+          statusRegion.textContent = `Slide ${currentIndex + 1} of ${slides.length}`;
+        }
+      }
+
+      for (const button of [prevButton, nextButton]) {
+        button.addEventListener('click', () => {
+          const baseSlide = pendingSlide ?? getNearestSlide();
+          const visualSlides = getVisualSlides();
+          const visualIndex = visualSlides.indexOf(baseSlide);
+          const step = button.dataset.direction === 'previous' ? -1 : 1;
+          const targetSlide = visualSlides[visualIndex + step];
+          if (targetSlide) {
+            scrollToSlide(targetSlide);
+          }
+        });
+      }
+
+      for (const eventName of ['pointerdown', 'touchstart', 'wheel', 'keydown']) {
+        track.addEventListener(
+          eventName,
+          () => {
+            pendingSlide = null;
+          },
+          { passive: true }
+        );
+      }
+
+      track.addEventListener(
+        'scroll',
+        () => {
+          if (pendingSlide) return;
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = 0;
+              if (pendingSlide) return;
+              const nearest = getNearestSlide();
+              setActiveMarker(slides.indexOf(nearest));
+            });
+          }
+        },
+        { passive: true }
+      );
+
+      if ('onscrollend' in window) {
+        track.addEventListener('scrollend', () => onScrollSettled(false));
+      } else {
+        let settleTimer = 0;
+        track.addEventListener(
+          'scroll',
+          () => {
+            clearTimeout(settleTimer);
+            settleTimer = setTimeout(() => onScrollSettled(false), 150);
+          },
+          { passive: true }
+        );
+      }
+
+      onScrollSettled(true);
+    }
+  </script>
