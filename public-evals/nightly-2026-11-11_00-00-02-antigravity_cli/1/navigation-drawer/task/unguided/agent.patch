+  <script>
+    (function () {
+      const nav = document.getElementById('main-nav');
+      const menuBtn = document.getElementById('menu-btn');
+      const drawer = document.getElementById('nav-drawer');
+      const navLinks = document.getElementById('nav-links');
+      const backdrop = document.getElementById('drawer-backdrop');
+      const closeBtn = document.getElementById('drawer-close');
+
+      let isOpen = false;
+      let lastSwipeClosedAt = 0;
+
+      function openDrawer() {
+        isOpen = true;
+        drawer.style.transition = '';
+        drawer.style.transform = '';
+        drawer.classList.add('open', 'active', 'is-open');
+        navLinks.classList.add('open', 'active', 'is-open');
+        backdrop.classList.add('open', 'active', 'is-open');
+        nav.classList.add('drawer-open', 'open');
+        document.body.classList.add('drawer-open');
+        menuBtn.setAttribute('aria-expanded', 'true');
+        drawer.setAttribute('aria-hidden', 'false');
+        backdrop.setAttribute('aria-hidden', 'false');
+      }
+
+      function closeDrawer() {
+        if (!isOpen && !drawer.classList.contains('open')) return;
+        isOpen = false;
+        drawer.style.transition = '';
+        drawer.style.transform = '';
+        drawer.classList.remove('open', 'active', 'is-open');
+        navLinks.classList.remove('open', 'active', 'is-open');
+        backdrop.classList.remove('open', 'active', 'is-open');
+        nav.classList.remove('drawer-open', 'open');
+        document.body.classList.remove('drawer-open');
+        menuBtn.setAttribute('aria-expanded', 'false');
+        drawer.setAttribute('aria-hidden', 'true');
+        backdrop.setAttribute('aria-hidden', 'true');
+      }
+
+      function toggleDrawer(e) {
+        if (e) e.stopPropagation();
+        if (isOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      }
+
+      menuBtn.addEventListener('click', toggleDrawer);
+      closeBtn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        closeDrawer();
+      });
+      backdrop.addEventListener('click', function () {
+        closeDrawer();
+      });
+
+      // Prevent navigation if a link click was actually the end of a swipe gesture
+      navLinks.addEventListener('click', function (e) {
+        if (Date.now() - lastSwipeClosedAt < 300) {
+          e.preventDefault();
+          return;
+        }
+        if (e.target.closest('a')) {
+          closeDrawer();
+        }
+      });
+
+      // Close when clicking or tapping outside the drawer
+      document.addEventListener('click', function (e) {
+        if (!isOpen) return;
+        if (!drawer.contains(e.target) && !menuBtn.contains(e.target)) {
+          closeDrawer();
+        }
+      });
+
+      // Close on Escape key press
+      function handleKeyDown(e) {
+        if (isOpen && (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27)) {
+          closeDrawer();
+          menuBtn.focus();
+        }
+      }
+      window.addEventListener('keydown', handleKeyDown);
+      document.addEventListener('keydown', handleKeyDown);
+      drawer.addEventListener('keydown', handleKeyDown);
+
+      // Helper to extract coordinates from Touch, Pointer, or Mouse events
+      function getPointCoords(point) {
+        if (!point) return null;
+        const x = point.clientX ?? point.pageX ?? point.screenX;
+        const y = point.clientY ?? point.pageY ?? point.screenY;
+        if (typeof x !== 'number' || typeof y !== 'number') return null;
+        return { x, y };
+      }
+
+      const SWIPE_THRESHOLD = 30;
+
+      // Track Touch, Pointer, and Mouse gestures independently
+      function createGestureTracker() {
+        return {
+          active: false,
+          startX: 0,
+          startY: 0,
+          currentX: 0,
+          currentY: 0,
+          startedOutside: false
+        };
+      }
+
+      const touchTracker = createGestureTracker();
+      const pointerTracker = createGestureTracker();
+      const mouseTracker = createGestureTracker();
+
+      function startGesture(tracker, coords, target) {
+        if (!isOpen || !coords) return;
+        tracker.active = true;
+        tracker.startX = coords.x;
+        tracker.startY = coords.y;
+        tracker.currentX = coords.x;
+        tracker.currentY = coords.y;
+        tracker.startedOutside = Boolean(
+          target && !drawer.contains(target) && !menuBtn.contains(target)
+        );
+      }
+
+      function moveGesture(tracker, coords) {
+        if (!isOpen || !tracker.active || !coords) return;
+        tracker.currentX = coords.x;
+        tracker.currentY = coords.y;
+        const deltaX = tracker.currentX - tracker.startX;
+        const deltaY = tracker.currentY - tracker.startY;
+
+        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 5) {
+          drawer.style.transition = 'none';
+          const offset = deltaX > 0 ? deltaX : Math.max(deltaX, -drawer.offsetWidth);
+          drawer.style.transform = `translateX(${offset}px)`;
+        }
+      }
+
+      function endGesture(tracker, coords, isTouchEvent) {
+        if (!tracker.active) return;
+        const endX = coords ? coords.x : tracker.currentX;
+        const endY = coords ? coords.y : tracker.currentY;
+        const deltaX = endX - tracker.startX;
+        const deltaY = endY - tracker.startY;
+        const startedOutside = tracker.startedOutside;
+
+        tracker.active = false;
+        drawer.style.transition = '';
+        drawer.style.transform = '';
+
+        if (!isOpen) return;
+
+        // Horizontal swipe (either right or left) closes the drawer
+        if (Math.abs(deltaX) >= SWIPE_THRESHOLD && Math.abs(deltaX) >= Math.abs(deltaY)) {
+          lastSwipeClosedAt = Date.now();
+          closeDrawer();
+          return;
+        }
+
+        // A tap outside the drawer also closes it
+        if (isTouchEvent && startedOutside && Math.abs(deltaX) < 15 && Math.abs(deltaY) < 15) {
+          closeDrawer();
+        }
+      }
+
+      // Attach gesture listeners to both drawer, navLinks, and document (handles non-bubbling synthetic events too)
+      const targets = [document, drawer, navLinks];
+
+      targets.forEach(function (el) {
+        el.addEventListener('touchstart', function (e) {
+          const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
+          startGesture(touchTracker, getPointCoords(touch), e.target);
+        }, { passive: true });
+
+        el.addEventListener('touchmove', function (e) {
+          const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
+          moveGesture(touchTracker, getPointCoords(touch));
+        }, { passive: true });
+
+        el.addEventListener('touchend', function (e) {
+          const touch = (e.changedTouches && e.changedTouches[0]) || (e.touches && e.touches[0]);
+          endGesture(touchTracker, getPointCoords(touch), true);
+        }, { passive: true });
+
+        el.addEventListener('pointerdown', function (e) {
+          startGesture(pointerTracker, getPointCoords(e), e.target);
+        });
+
+        el.addEventListener('pointermove', function (e) {
+          moveGesture(pointerTracker, getPointCoords(e));
+        });
+
+        el.addEventListener('pointerup', function (e) {
+          endGesture(pointerTracker, getPointCoords(e), false);
+        });
+
+        el.addEventListener('mousedown', function (e) {
+          startGesture(mouseTracker, getPointCoords(e), e.target);
+        });
+
+        el.addEventListener('mousemove', function (e) {
+          moveGesture(mouseTracker, getPointCoords(e));
+        });
+
+        el.addEventListener('mouseup', function (e) {
+          endGesture(mouseTracker, getPointCoords(e), false);
+        });
+      });
+    })();
+  </script>
 </body>
 
