+  <script type="module">
+    const COFFEE_ORIGINS = [
+      { name: 'Ethiopian Yirgacheffe', acidity: 8.8, body: 5.2, sweetness: 8.4, bitterness: 2.8, aroma: 9.4, notes: ['Jasmine', 'Bergamot', 'Peach'] },
+      { name: 'Colombian Huila', acidity: 7.2, body: 7.0, sweetness: 8.1, bitterness: 4.0, aroma: 8.2, notes: ['Caramel', 'Red Apple', 'Milk Chocolate'] },
+      { name: 'Sumatra Mandheling', acidity: 4.1, body: 9.3, sweetness: 6.2, bitterness: 7.4, aroma: 7.6, notes: ['Dark Cocoa', 'Cedar', 'Earthy Spice'] },
+      { name: 'Guatemalan Antigua', acidity: 6.9, body: 7.8, sweetness: 7.6, bitterness: 4.8, aroma: 8.5, notes: ['Toffee', 'Toasted Hazelnut', 'Orange Peel'] },
+      { name: 'Kenyan AA Nyeri', acidity: 9.2, body: 6.4, sweetness: 7.9, bitterness: 3.3, aroma: 9.0, notes: ['Blackcurrant', 'Grapefruit', 'Hibiscus'] },
+      { name: 'Brazilian Cerrado', acidity: 4.8, body: 8.2, sweetness: 7.8, bitterness: 5.6, aroma: 7.2, notes: ['Roasted Almond', 'Brown Sugar', 'Dark Chocolate'] }
+    ];
+
+    const ROAST_MODIFIERS = {
+      light: { acidity: 1.18, body: 0.88, sweetness: 1.06, bitterness: 0.72, aroma: 1.15, tempBase: 198 },
+      medium: { acidity: 1.0, body: 1.04, sweetness: 1.12, bitterness: 0.96, aroma: 1.05, tempBase: 212 },
+      dark: { acidity: 0.74, body: 1.2, sweetness: 0.92, bitterness: 1.32, aroma: 0.94, tempBase: 226 }
+    };
+
+    const BREW_MODIFIERS = {
+      espresso: { bodyBoost: 1.18, clarity: 0.95, optimalExtraction: 20.2 },
+      pourover: { bodyBoost: 0.9, clarity: 1.16, optimalExtraction: 20.8 },
+      frenchpress: { bodyBoost: 1.22, clarity: 0.86, optimalExtraction: 19.6 },
+      coldbrew: { bodyBoost: 1.1, clarity: 1.02, optimalExtraction: 18.8 }
+    };
+
+    const batchSizeSelect = document.getElementById('batch-size');
+    const roastCurveSelect = document.getElementById('roast-curve');
+    const brewMethodSelect = document.getElementById('brew-method');
+    const targetAcidityInput = document.getElementById('target-acidity');
+    const acidityValSpan = document.getElementById('acidity-val');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const cancelBtn = document.getElementById('cancel-simulation-btn');
+    const statusText = document.getElementById('simulation-status-text');
+    const yieldStats = document.getElementById('simulation-yield-stats');
+    const progressBar = document.getElementById('simulation-progress');
+    const metricEvaluated = document.getElementById('metric-evaluated');
+    const metricTopScore = document.getElementById('metric-top-score');
+    const metricAvgExtraction = document.getElementById('metric-avg-extraction');
+    const metricDuration = document.getElementById('metric-duration');
+    const resultsGrid = document.getElementById('blend-results-grid');
+
+    let isRunning = false;
+    let cancelRequested = false;
+
+    targetAcidityInput.addEventListener('input', () => {
+      acidityValSpan.textContent = Number(targetAcidityInput.value).toFixed(1);
+    });
+
+    function generateRecipeBatch(count, roastKey, brewKey, targetAcidity) {
+      const recipes = new Array(count);
+      const len = COFFEE_ORIGINS.length;
+      for (let i = 0; i < count; i++) {
+        const idxA = i % len;
+        const idxB = (i * 3 + 1) % len;
+        const idxC = (i * 7 + 2) % len;
+
+        const rawA = 40 + ((i * 17) % 45);
+        const rawB = 15 + ((i * 29) % 35);
+        const rawC = Math.max(5, 100 - rawA - rawB);
+        const sum = rawA + rawB + rawC;
+
+        recipes[i] = {
+          id: i + 1,
+          name: `Artisanal Blend #${String(i + 1).padStart(4, '0')}`,
+          origins: [
+            { bean: COFFEE_ORIGINS[idxA], ratio: rawA / sum },
+            { bean: COFFEE_ORIGINS[idxB], ratio: rawB / sum },
+            { bean: COFFEE_ORIGINS[idxC], ratio: rawC / sum }
+          ],
+          roastKey,
+          brewKey,
+          targetAcidity,
+          roastDurationSec: 510 + (i % 180)
+        };
+      }
+      return recipes;
+    }
+
+    function simulateBlendProfile(recipe) {
+      const roastMod = ROAST_MODIFIERS[recipe.roastKey] || ROAST_MODIFIERS.medium;
+      const brewMod = BREW_MODIFIERS[recipe.brewKey] || BREW_MODIFIERS.espresso;
+
+      let acidity = 0;
+      let body = 0;
+      let sweetness = 0;
+      let bitterness = 0;
+      let aroma = 0;
+
+      for (const component of recipe.origins) {
+        acidity += component.bean.acidity * component.ratio;
+        body += component.bean.body * component.ratio;
+        sweetness += component.bean.sweetness * component.ratio;
+        bitterness += component.bean.bitterness * component.ratio;
+        aroma += component.bean.aroma * component.ratio;
+      }
+
+      // Simulate thermal Maillard reaction & volatile compound curves across roast steps
+      let thermalIntegral = 0;
+      const steps = 160;
+      for (let step = 1; step <= steps; step++) {
+        const progress = step / steps;
+        const tempCurve = roastMod.tempBase * (0.65 + 0.35 * Math.sin(progress * Math.PI * 0.85));
+        const caramelization = Math.cos(progress * sweetness * 0.4) * Math.sin(tempCurve * 0.02);
+        thermalIntegral += caramelization / steps;
+      }
+
+      const finalAcidity = Math.min(10, Math.max(1, acidity * roastMod.acidity * brewMod.clarity + thermalIntegral * 0.35));
+      const finalBody = Math.min(10, Math.max(1, body * roastMod.body * brewMod.bodyBoost));
+      const finalSweetness = Math.min(10, Math.max(1, sweetness * roastMod.sweetness + Math.abs(thermalIntegral) * 0.5));
+      const finalBitterness = Math.min(10, Math.max(1, bitterness * roastMod.bitterness));
+      const finalAroma = Math.min(10, Math.max(1, aroma * roastMod.aroma * brewMod.clarity));
+
+      const extractionYield = brewMod.optimalExtraction + Math.sin(recipe.id * 0.37) * 1.15 + thermalIntegral * 0.4;
+      const acidityDeltaPenalty = Math.abs(finalAcidity - recipe.targetAcidity) * 1.85;
+      const balanceBonus = (finalSweetness * 1.3 + finalAroma * 1.25 + finalBody * 1.1) - finalBitterness * 0.65;
+      const cuppingScore = Math.min(98.5, Math.max(72.0, 74 + balanceBonus - acidityDeltaPenalty));
+
+      const noteSet = new Set();
+      for (const component of recipe.origins) {
+        noteSet.add(component.bean.notes[recipe.id % component.bean.notes.length]);
+      }
+
+      return {
+        id: recipe.id,
+        name: recipe.name,
+        composition: recipe.origins
+          .map(o => `${Math.round(o.ratio * 100)}% ${o.bean.name}`)
+          .join(' • '),
+        acidity: finalAcidity,
+        body: finalBody,
+        sweetness: finalSweetness,
+        bitterness: finalBitterness,
+        aroma: finalAroma,
+        extractionYield,
+        cuppingScore,
+        notes: Array.from(noteSet)
+      };
+    }
+
+    function renderTopBlends(topBlends) {
+      resultsGrid.replaceChildren();
+      const fragment = document.createDocumentFragment();
+
+      for (const blend of topBlends) {
+        const card = document.createElement('article');
+        card.className = 'blend-card';
+
+        const header = document.createElement('div');
+        header.className = 'blend-card-header';
+        const title = document.createElement('h4');
+        title.textContent = blend.name;
+        const badge = document.createElement('span');
+        badge.className = 'cup-score-badge';
+        badge.textContent = `${blend.cuppingScore.toFixed(1)} pts`;
+        header.append(title, badge);
+
+        const comp = document.createElement('p');
+        comp.className = 'blend-composition';
+        comp.textContent = blend.composition;
+
+        const bars = document.createElement('div');
+        bars.className = 'flavor-bars';
+        const dimensions = [
+          ['Acidity', blend.acidity],
+          ['Body', blend.body],
+          ['Sweetness', blend.sweetness],
+          ['Aroma', blend.aroma],
+          ['Bitterness', blend.bitterness]
+        ];
+
+        for (const [label, val] of dimensions) {
+          const row = document.createElement('div');
+          row.className = 'flavor-bar-row';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.textContent = label;
+
+          const track = document.createElement('div');
+          track.className = 'flavor-bar-track';
+          const fill = document.createElement('div');
+          fill.className = 'flavor-bar-fill';
+          fill.style.width = `${Math.round(val * 10)}%`;
+          track.appendChild(fill);
+
+          const scoreSpan = document.createElement('span');
+          scoreSpan.textContent = val.toFixed(1);
+
+          row.append(nameSpan, track, scoreSpan);
+          bars.appendChild(row);
+        }
+
+        const notesContainer = document.createElement('div');
+        notesContainer.className = 'tasting-notes';
+        for (const note of blend.notes) {
+          const tag = document.createElement('span');
+          tag.className = 'note-tag';
+          tag.textContent = note;
+          notesContainer.appendChild(tag);
+        }
+
+        card.append(header, comp, bars, notesContainer);
+        fragment.appendChild(card);
+      }
+
+      resultsGrid.appendChild(fragment);
+    }
+
+    async function processRecipeBatch(recipes) {
+      const total = recipes.length;
+      const startTime = performance.now();
+      let processed = 0;
+      let yieldCount = 0;
+      let totalExtraction = 0;
+      let topBlends = [];
+
+      // Set a 50ms time-based deadline to prevent long tasks from blocking the main thread
+      let deadline = performance.now() + 50;
+
+      for (const recipe of recipes) {
+        if (cancelRequested) {
+          break;
+        }
+
+        const result = simulateBlendProfile(recipe);
+        processed++;
+        totalExtraction += result.extractionYield;
+
+        if (topBlends.length < 6 || result.cuppingScore > topBlends[topBlends.length - 1].cuppingScore) {
+          topBlends.push(result);
+          topBlends.sort((a, b) => b.cuppingScore - a.cuppingScore);
+          if (topBlends.length > 6) {
+            topBlends.pop();
+          }
+        }
+
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          const pct = Math.round((processed / total) * 100);
+          progressBar.value = pct;
+          progressBar.textContent = `${pct}%`;
+          statusText.textContent = `Simulating flavor profiles... (${pct}%)`;
+          yieldStats.textContent = `Processed: ${processed.toLocaleString()} / ${total.toLocaleString()} (${pct}%) • Main-thread yields: ${yieldCount}`;
+          metricEvaluated.textContent = processed.toLocaleString();
+          metricDuration.textContent = `${Math.round(performance.now() - startTime)} ms`;
+
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+
+      const elapsedMs = Math.round(performance.now() - startTime);
+      const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
+      progressBar.value = pct;
+      progressBar.textContent = `${pct}%`;
+      metricEvaluated.textContent = processed.toLocaleString();
+      metricDuration.textContent = `${elapsedMs} ms`;
+
+      if (processed > 0) {
+        metricTopScore.textContent = `${topBlends[0].cuppingScore.toFixed(1)} pts`;
+        metricAvgExtraction.textContent = `${(totalExtraction / processed).toFixed(1)}%`;
+        renderTopBlends(topBlends);
+      }
+
+      if (cancelRequested) {
+        statusText.textContent = `Simulation paused at ${processed.toLocaleString()} of ${total.toLocaleString()} blends.`;
+      } else {
+        statusText.textContent = `Completed simulation of ${processed.toLocaleString()} recipe blends without blocking the UI.`;
+      }
+      yieldStats.textContent = `Processed: ${processed.toLocaleString()} / ${total.toLocaleString()} (${pct}%) • Main-thread yields: ${yieldCount}`;
+    }
+
+    async function handleRunSimulation() {
+      if (isRunning) return;
+      isRunning = true;
+      cancelRequested = false;
+      runBtn.disabled = true;
+      cancelBtn.disabled = false;
+
+      const count = Number(batchSizeSelect.value) || 5000;
+      const roastKey = roastCurveSelect.value;
+      const brewKey = brewMethodSelect.value;
+      const targetAcidity = Number(targetAcidityInput.value) || 6.5;
+
+      statusText.textContent = `Preparing ${count.toLocaleString()} recipe blends...`;
+      progressBar.value = 0;
+
+      const recipes = generateRecipeBatch(count, roastKey, brewKey, targetAcidity);
+      await processRecipeBatch(recipes);
+
+      isRunning = false;
+      runBtn.disabled = false;
+      cancelBtn.disabled = true;
+    }
+
+    runBtn.addEventListener('click', handleRunSimulation);
+    cancelBtn.addEventListener('click', () => {
+      if (isRunning) {
+        cancelRequested = true;
+      }
+    });
+
+    // Run an initial batch automatically so results are populated on load
+    handleRunSimulation();
+  </script>
