+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('tooltip');
+      if (!anchor || !tooltip) return;
+
+      let openedByHoverAt = 0;
+
+      function updateOrientation() {
+        if (!tooltip.matches(':popover-open')) return;
+        const anchorRect = anchor.getBoundingClientRect();
+        const tooltipRect = tooltip.getBoundingClientRect();
+        const isFlippedBelow = tooltipRect.top >= anchorRect.bottom - 2;
+        tooltip.classList.toggle('flipped', isFlippedBelow);
+        tooltip.dataset.orientation = isFlippedBelow ? 'bottom' : 'top';
+      }
+
+      anchor.addEventListener('mouseenter', () => {
+        if (!tooltip.matches(':popover-open') && typeof tooltip.showPopover === 'function') {
+          openedByHoverAt = performance.now();
+          tooltip.showPopover();
+          requestAnimationFrame(updateOrientation);
+        }
+      });
+
+      anchor.addEventListener('click', (event) => {
+        if (tooltip.matches(':popover-open') && performance.now() - openedByHoverAt < 350) {
+          event.preventDefault();
+          openedByHoverAt = 0;
+        }
+        requestAnimationFrame(updateOrientation);
+      });
+
+      tooltip.addEventListener('toggle', () => {
+        requestAnimationFrame(updateOrientation);
+      });
+
+      window.addEventListener('scroll', updateOrientation, { passive: true });
+      window.addEventListener('resize', updateOrientation, { passive: true });
+    })();
+  </script>
+
