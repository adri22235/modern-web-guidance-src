+  <script>
+    const orderProgress = document.getElementById('order-progress');
+    const orderStatus = document.getElementById('order-status');
+    const controlButtons = document.querySelectorAll('.progress-controls .progress-btn');
+
+    controlButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        controlButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+        button.setAttribute('aria-pressed', 'true');
+
+        if (button.dataset.state === 'indeterminate') {
+          orderProgress.removeAttribute('value');
+          orderStatus.textContent = 'Connecting to roastery baristas...';
+        } else {
+          orderProgress.value = Number(button.dataset.value);
+          orderStatus.textContent = button.dataset.label;
+        }
+      });
+    });
+  </script>
