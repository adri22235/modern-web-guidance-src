+  <script>
+    (function () {
+      const stateButtons = document.querySelectorAll('.state-btn');
+      const progressBar = document.getElementById('primary-progress-bar');
+      const progressFill = document.getElementById('primary-progress-fill');
+      const nativeProgress = document.getElementById('native-order-progress');
+      const badge = document.getElementById('primary-progress-badge');
+      const statusText = document.getElementById('primary-progress-status');
+      const steps = document.querySelectorAll('#primary-progress-steps .progress-step');
+
+      const descriptions = {
+        25: 'Determinate state: Order received at the counter (50 / 200 Loyalty Beans earned).',
+        50: 'Determinate state: Grinding single-origin beans to order (100 / 200 Loyalty Beans earned).',
+        75: 'Determinate state: 50 more Loyalty Beans to unlock your next complimentary craft beverage.',
+        100: 'Determinate state: Order ready for pickup & Free Handcrafted Drink Reward unlocked (200 / 200 Beans)!'
+      };
+
+      stateButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          stateButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          const mode = btn.getAttribute('data-mode');
+          if (mode === 'indeterminate') {
+            progressBar.classList.remove('is-determinate');
+            progressBar.classList.add('is-indeterminate');
+            progressBar.setAttribute('data-state', 'indeterminate');
+            progressBar.removeAttribute('aria-valuenow');
+            progressBar.setAttribute('aria-busy', 'true');
+            progressFill.classList.add('indeterminate');
+
+            nativeProgress.removeAttribute('value');
+            nativeProgress.textContent = 'Processing...';
+
+            badge.textContent = 'Syncing Order & Rewards...';
+            badge.classList.add('badge-indeterminate');
+            statusText.textContent = 'Indeterminate state: Calculating bonus loyalty beans and syncing live barista handoff...';
+
+            steps.forEach((step) => step.classList.remove('completed'));
+          } else {
+            const val = parseInt(btn.getAttribute('data-value') || '75', 10);
+            const beans = Math.round((val / 100) * 200);
+
+            progressBar.classList.remove('is-indeterminate');
+            progressBar.classList.add('is-determinate');
+            progressBar.setAttribute('data-state', 'determinate');
+            progressBar.setAttribute('aria-valuenow', String(val));
+            progressBar.removeAttribute('aria-busy');
+
+            progressFill.classList.remove('indeterminate');
+            progressFill.style.setProperty('--progress-value', val + '%');
+            progressFill.style.width = val + '%';
+
+            nativeProgress.setAttribute('value', String(val));
+            nativeProgress.textContent = val + '%';
+
+            badge.textContent = val + '% Complete (' + beans + ' / 200 Beans)';
+            badge.classList.remove('badge-indeterminate');
+            statusText.textContent = descriptions[val] || descriptions[75];
+
+            steps.forEach((step) => {
+              const threshold = parseInt(step.getAttribute('data-threshold') || '0', 10);
+              if (val >= threshold) {
+                step.classList.add('completed');
+              } else {
+                step.classList.remove('completed');
+              }
+            });
+          }
+        });
+      });
+    })();
+  </script>
+
