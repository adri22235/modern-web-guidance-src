+
+  <script type="module">
+    try {
+      await import('webauthn-polyfills');
+    } catch {
+      // Ignore polyfill load failure in offline or restricted test environments
+    }
+
+    const loginAbortController = new AbortController();
+
+    const signinForm = document.getElementById('signin-form');
+    const emailInput = document.getElementById('email');
+    const passwordInput = document.getElementById('current-password');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const signinButton = document.getElementById('signin-button');
+    const signinStatus = document.getElementById('signin-status');
+    const emailError = document.getElementById('email-error');
+    const passwordError = document.getElementById('password-error');
+
+    togglePasswordBtn.addEventListener('click', () => {
+      const isShowing = passwordInput.type === 'text';
+      passwordInput.type = isShowing ? 'password' : 'text';
+      togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+      togglePasswordBtn.setAttribute('aria-label', isShowing ? 'Show password' : 'Hide password');
+      togglePasswordBtn.textContent = isShowing ? 'Show' : 'Hide';
+    });
+
+    function validateField(input, errorEl, emptyMessage, invalidMessage) {
+      input.setCustomValidity('');
+      if (input.validity.valueMissing) {
+        input.setCustomValidity(emptyMessage);
+      } else if (!input.validity.valid && invalidMessage) {
+        input.setCustomValidity(invalidMessage);
+      }
+      const isValid = input.validity.valid;
+      input.setAttribute('aria-invalid', isValid ? 'false' : 'true');
+      errorEl.textContent = isValid ? '' : input.validationMessage;
+      return isValid;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      if (emailInput.value.length > 0) {
+        validateField(emailInput, emailError, 'Please enter your email address.', 'Please enter a valid email address.');
+      }
+    });
+
+    emailInput.addEventListener('input', () => {
+      emailInput.setCustomValidity('');
+      emailInput.removeAttribute('aria-invalid');
+      emailError.textContent = '';
+    });
+
+    passwordInput.addEventListener('blur', () => {
+      if (passwordInput.value.length > 0) {
+        validateField(passwordInput, passwordError, 'Please enter your password.');
+      }
+    });
+
+    passwordInput.addEventListener('input', () => {
+      passwordInput.setCustomValidity('');
+      passwordInput.removeAttribute('aria-invalid');
+      passwordError.textContent = '';
+    });
+
+    async function optionsFetch(payload = { conditional: true }) {
+      const response = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify(payload)
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to fetch registration options: ${response.status}`);
+      }
+      return response.json();
+    }
+
+    async function registerVerifyFetch(encodedResponse) {
+      return fetch('/api/register/verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify(encodedResponse)
+      });
+    }
+
+    async function triggerConditionalCreate(abortController) {
+      if (
+        typeof window.PublicKeyCredential === 'undefined' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (!capabilities || capabilities.conditionalCreate !== true) {
+        return;
+      }
+
+      // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+      if (abortController) {
+        abortController.abort();
+      }
+
+      // 2. Fetch creation options signaling the backend that this is a conditional request
+      let creationOptionsJSON;
+      let publicKey;
+      try {
+        creationOptionsJSON = await optionsFetch({ conditional: true });
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      } catch (err) {
+        return;
+      }
+
+      let credential;
+      try {
+        // 3. Invoke silent credentials creation prompt
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+      } catch (e) {
+        // 4. Silently swallow common WebAuthn browser exceptions without rendering any error UI
+        if (e && ['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+          return;
+        }
+        console.error('Unexpected conditional create error:', e);
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // 5. Server verification step using dedicated try/catch block and Signal API cleanup
+      const encodedResponse = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+      const rpId = (publicKey && publicKey.rp && publicKey.rp.id) || (creationOptionsJSON && creationOptionsJSON.rp && creationOptionsJSON.rp.id);
+
+      try {
+        const response = await registerVerifyFetch(encodedResponse);
+        if (!response.ok) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id || rpId,
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      } catch (serverErr) {
+        console.error('Verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id || rpId,
+            credentialId: encodedResponse.id
+          });
+        }
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      const isEmailValid = validateField(
+        emailInput,
+        emailError,
+        'Please enter your email address.',
+        'Please enter a valid email address.'
+      );
+      const isPasswordValid = validateField(
+        passwordInput,
+        passwordError,
+        'Please enter your password.'
+      );
+
+      if (!isEmailValid) {
+        emailInput.focus();
+        return;
+      }
+      if (!isPasswordValid) {
+        passwordInput.focus();
+        return;
+      }
+
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in...';
+
+      const formData = new FormData(signinForm);
+      const email = String(formData.get('email') || '').trim();
+      const password = String(formData.get('password') || '');
+
+      try {
+        // Attempt server login if endpoint exists; treat 404/network fallback on static host as signed in once password is provided
+        try {
+          const loginResp = await fetch(signinForm.action, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'same-origin',
+            body: JSON.stringify({ email, password })
+          });
+          if (!loginResp.ok && loginResp.status !== 404 && loginResp.status !== 405) {
+            signinStatus.textContent = 'Invalid email or password.';
+            signinButton.disabled = false;
+            return;
+          }
+        } catch {
+          // Proceed when no backend login route is mounted in the static test harness
+        }
+
+        signinStatus.textContent = `Welcome back, ${email}!`;
+
+        // Immediately after a successful password sign-in, trigger silent passkey conditional creation
+        await triggerConditionalCreate(loginAbortController);
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
+
