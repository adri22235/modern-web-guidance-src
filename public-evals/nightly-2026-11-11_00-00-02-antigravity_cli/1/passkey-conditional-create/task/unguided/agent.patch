+    async function registerPasskeySilently(username) {
+      try {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+          !navigator.credentials ||
+          typeof navigator.credentials.create !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (
+          !capabilities ||
+          !capabilities.conditionalCreate ||
+          capabilities.userVerifyingPlatformAuthenticator === false
+        ) {
+          return;
+        }
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ username }),
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const optionsJSON = await optionsResponse.json();
+        const rawOptions = optionsJSON && optionsJSON.publicKey ? optionsJSON.publicKey : optionsJSON;
+        const publicKeyOptions = parseCreationOptions(rawOptions);
+
+        const credential = await navigator.credentials.create({
+          publicKey: publicKeyOptions,
+          mediation: 'conditional',
+        });
