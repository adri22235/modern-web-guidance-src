+                    verifyData.ok === false ||
+                    Boolean(verifyData.error))
+                ) {
+                  verificationFailed = true;
+                }
+              } catch (_) {
+                // Non-JSON response body with 2xx status is treated as success
+              }
+            }
+          }
+        } catch (_) {
+          verificationFailed = true;
+        }
+
+        if (verificationFailed) {
+          const rpId =
+            (rawOptions && rawOptions.rp && rawOptions.rp.id) ||
+            (publicKeyOptions && publicKeyOptions.rp && publicKeyOptions.rp.id) ||
+            window.location.hostname;
+          const credentialId =
+            credential.id || (credential.rawId ? bufferToBase64Url(credential.rawId) : undefined);
+
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function' && credentialId) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId,
+            });
+          }
+        }
+      } catch (_) {
+        // Silently ignore background passkey registration errors without showing any dialog or error UI
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    const signinStatus = document.getElementById('signin-status');
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const usernameInput = document.getElementById('username');
+        const username = usernameInput ? usernameInput.value.trim() : '';
+
+        if (signinStatus) {
+          signinStatus.textContent = 'Signed in successfully.';
+          signinStatus.hidden = false;
+        }
+
+        await registerPasskeySilently(username);
+      });
+    }
+  </script>
