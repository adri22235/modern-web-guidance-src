+        state.lastUnmodifiedBundleInVerifier = JSON.parse(JSON.stringify(state.latestSignedReceipt));
+        await loadBundleIntoVerifier(tampered, false);
+      };
+
+      // --- 3. GIFT VOUCHER BUILDER & SIGNER ---
+      window.regenerateVoucherCode = function () {
+        const num = Math.floor(1000 + Math.random() * 9000);
+        const suffix = randomHex(2);
+        document.getElementById('voucher-code-input').value = `DG-GIFT-2026-${num}-${suffix}`;
+      };
+
+      window.setVoucherPresetAmount = function (amount) {
+        document.getElementById('voucher-amount-input').value = Number(amount).toFixed(2);
+        document.querySelectorAll('.preset-pill').forEach((btn) => {
+          btn.classList.toggle('active', btn.textContent === `$${amount}`);
+        });
+      };
+
+      function buildGiftVoucherPayload() {
+        const voucherCode = document.getElementById('voucher-code-input').value.trim() || 'DG-GIFT-2026-7739-K9X2';
+        const rawAmount = parseFloat(document.getElementById('voucher-amount-input').value);
+        const amount = Number((isNaN(rawAmount) ? 50.00 : rawAmount).toFixed(2));
+        const recipientName = document.getElementById('voucher-recipient-input').value.trim() || 'Valued Guest';
+        const senderName = document.getElementById('voucher-sender-input').value.trim() || 'The Daily Grind';
+        const expiresAt = document.getElementById('voucher-expiry-input').value || '2027-11-11';
+        const redemptionScope = document.getElementById('voucher-scope-input').value;
+        const personalMessage = document.getElementById('voucher-message-input').value.trim();
+
+        return {
+          documentType: 'GIFT_VOUCHER',
+          issuer: 'The Daily Grind Coffee Co.',
+          voucherCode,
+          amount,
+          currency: 'USD',
+          recipientName,
+          senderName,
+          personalMessage,
+          redemptionScope,
+          issuedAt: new Date().toISOString(),
+          expiresAt,
+          securityNonce: randomHex(8)
+        };
+      }
+
+      function renderSignedGiftVoucherCard(signedBundle) {
+        const { payload, cryptographicProof } = signedBundle;
+        document.getElementById('voucher-view-amount').textContent = `$${payload.amount.toFixed(2)}`;
+        document.getElementById('voucher-view-code').textContent = payload.voucherCode;
+        document.getElementById('voucher-view-recipient').textContent = payload.recipientName;
+        document.getElementById('voucher-view-sender').textContent = payload.senderName;
+        document.getElementById('voucher-view-expiry').textContent = payload.expiresAt;
+        document.getElementById('voucher-view-scope').textContent = payload.redemptionScope;
+        document.getElementById('voucher-view-message').textContent = `"${payload.personalMessage}"`;
+
+        const sigBadge = document.getElementById('voucher-sig-badge');
+        sigBadge.textContent = 'CRYPTOGRAPHICALLY MINTED';
+        sigBadge.className = 'badge badge-valid';
+
+        const isPqc = cryptographicProof.regime === 'quantum-resistant';
+        const regimePill = document.getElementById('voucher-regime-pill');
+        regimePill.textContent = `${cryptographicProof.algorithm} (${isPqc ? 'Quantum-Resistant' : 'Classical'})`;
+        regimePill.className = 'badge ' + (isPqc ? 'badge-pqc' : 'badge-classical');
+
+        document.getElementById('voucher-seal-algo').textContent =
+          `${cryptographicProof.algorithmName} [${cryptographicProof.regimeLabel}]`;
+        document.getElementById('voucher-seal-keyid').textContent = cryptographicProof.keyId;
+        document.getElementById('voucher-seal-digest').textContent = cryptographicProof.canonicalDigestSha256;
+        document.getElementById('voucher-seal-sig').textContent =
+          `${cryptographicProof.signatureBase64.slice(0, 56)}... (${cryptographicProof.signatureByteLength} bytes)`;
+      }
+
+      window.signCurrentGiftVoucher = async function () {
+        if (!state.activeKeyPair) {
+          await window.handleGenerateNewKeyPair();
+        }
+        const payload = buildGiftVoucherPayload();
+        const signed = await CryptoEngine.signPayload(payload, state.activeKeyPair);
+        state.latestSignedVoucher = signed;
+        renderSignedGiftVoucherCard(signed);
+        addSignedDocumentToLedger(signed);
+        await loadBundleIntoVerifier(signed, true);
+        return signed;
+      };
+
+      window.signVoucherWithRegime = async function (regime) {
+        await window.selectRegimeFilter(regime);
+        return await window.signCurrentGiftVoucher();
+      };
+
+      window.verifyLatestVoucherInPortal = async function () {
+        if (!state.latestSignedVoucher) {
+          await window.signCurrentGiftVoucher();
+        }
+        await loadBundleIntoVerifier(state.latestSignedVoucher, true);
+      };
+
+      window.simulateTamperOnLatestVoucher = async function () {
+        if (!state.latestSignedVoucher) {
+          await window.signCurrentGiftVoucher();
+        }
+        const forged = JSON.parse(JSON.stringify(state.latestSignedVoucher));
+        forged.payload.amount = Number((forged.payload.amount * 10).toFixed(2));
+        document.getElementById('voucher-view-amount').textContent = `$${forged.payload.amount.toFixed(2)}!`;
+        const sigBadge = document.getElementById('voucher-sig-badge');
+        sigBadge.textContent = 'COUNTERFEIT / ALTERED VALUE';
+        sigBadge.className = 'badge badge-invalid';
+
+        state.lastUnmodifiedBundleInVerifier = JSON.parse(JSON.stringify(state.latestSignedVoucher));
+        await loadBundleIntoVerifier(forged, false);
+      };
+
+      window.copySignedBundle = function (type) {
+        const bundle = type === 'voucher' ? state.latestSignedVoucher : state.latestSignedReceipt;
+        if (bundle && navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(JSON.stringify(bundle, null, 2));
+        }
+      };
+
+      // --- 4. UNIVERSAL VERIFICATION PORTAL & LEDGER ---
+      function addSignedDocumentToLedger(signedBundle) {
+        state.signedLedger.unshift(JSON.parse(JSON.stringify(signedBundle)));
+        if (state.signedLedger.length > 12) {
+          state.signedLedger.pop();
+        }
+        renderSignedLedger();
+      }
+
+      function renderSignedLedger() {
+        const tbody = document.getElementById('signed-ledger-tbody');
+        tbody.innerHTML = '';
+        state.signedLedger.forEach((bundle, idx) => {
+          const isVoucher = bundle.payload.documentType === 'GIFT_VOUCHER';
+          const idOrCode = isVoucher ? bundle.payload.voucherCode : bundle.payload.orderId;
+          const party = isVoucher ? bundle.payload.recipientName : bundle.payload.customerName;
+          const amount = isVoucher ? bundle.payload.amount : bundle.payload.totalAmount;
+          const isPqc = bundle.cryptographicProof.regime === 'quantum-resistant';
+          const badgeClass = isPqc ? 'badge-pqc' : 'badge-classical';
+
+          const tr = document.createElement('tr');
+          tr.innerHTML = `
+            <td><strong>${isVoucher ? 'Gift Voucher' : 'Order Receipt'}</strong></td>
+            <td style="font-family:var(--mono);">${escapeHtml(idOrCode)}</td>
+            <td>${escapeHtml(party)}</td>
+            <td><strong>$${Number(amount).toFixed(2)}</strong></td>
+            <td><span class="badge ${badgeClass}">${bundle.cryptographicProof.algorithm}</span></td>
+            <td style="font-family:var(--mono); font-size:0.76rem;">${bundle.cryptographicProof.keyId}</td>
+            <td>
+              <button type="button" class="btn btn-outline btn-sm" data-verify-ledger="${idx}">Verify</button>
+            </td>
+          `;
+          tbody.appendChild(tr);
+        });
+
+        tbody.querySelectorAll('[data-verify-ledger]').forEach((btn) => {
+          btn.addEventListener('click', async () => {
+            const idx = Number(btn.getAttribute('data-verify-ledger'));
+            if (state.signedLedger[idx]) {
+              await loadBundleIntoVerifier(state.signedLedger[idx], true);
+            }
+          });
+        });
+      }
+
+      async function loadBundleIntoVerifier(bundle, saveAsCleanBackup) {
+        if (saveAsCleanBackup) {
+          state.lastUnmodifiedBundleInVerifier = JSON.parse(JSON.stringify(bundle));
+        }
+        document.getElementById('verifier-bundle-json').value = JSON.stringify(bundle, null, 2);
+        if (bundle && bundle.cryptographicProof && bundle.cryptographicProof.publicKeyPem) {
+          document.getElementById('verifier-pubkey-pem').value = bundle.cryptographicProof.publicKeyPem;
+        }
+        await window.runVerificationFromInputs();
+      }
+
+      function updateCheckItem(elementId, passed, labelText) {
+        const el = document.getElementById(elementId);
+        el.className = 'audit-check-item ' + (passed ? 'pass' : 'fail');
+        el.innerHTML = `<span>[${passed ? 'PASS' : 'FAIL'}] ${escapeHtml(labelText)}</span>`;
+      }
+
+      window.runVerificationFromInputs = async function () {
+        const rawJson = document.getElementById('verifier-bundle-json').value;
+        const pubKeyPem = document.getElementById('verifier-pubkey-pem').value;
+
+        let parsedBundle;
+        try {
+          parsedBundle = JSON.parse(rawJson);
+        } catch (err) {
+          renderVerificationReport({
+            valid: false,
+            summary: 'INVALID JSON — Signed document envelope could not be parsed.',
+            reasons: [err.message],
+            checks: {
+              schemaValid: false,
+              digestMatches: false,
+              keyFingerprintMatches: false,
+              signatureCryptographicallyValid: false
+            }
+          }, null);
+          return;
+        }
+
+        const result = await CryptoEngine.verifySignedBundle(parsedBundle, pubKeyPem);
+        renderVerificationReport(result, parsedBundle);
+        return result;
+      };
+
+      function renderVerificationReport(result, bundle) {
+        const banner = document.getElementById('verification-result-banner');
+        const titleEl = document.getElementById('verification-banner-title');
+        const descEl = document.getElementById('verification-banner-desc');
+        const badgeEl = document.getElementById('verification-banner-badge');
+        const timingEl = document.getElementById('verification-timing-meta');
+
+        if (result.valid) {
+          banner.className = 'verification-banner valid';
+          titleEl.textContent = 'AUTHENTIC & INTACT — DIGITAL SIGNATURE VERIFIED';
+          descEl.textContent = result.reasons.join(' ');
+          badgeEl.className = 'badge badge-valid';
+          badgeEl.textContent = `VERIFIED (${result.algorithm})`;
+        } else {
+          banner.className = 'verification-banner invalid';
+          titleEl.textContent = 'VERIFICATION FAILED — TAMPERING OR INVALID SIGNATURE DETECTED';
+          descEl.textContent = result.reasons.join(' | ');
+          badgeEl.className = 'badge badge-invalid';
+          badgeEl.textContent = 'INVALID / TAMPERED';
+        }
+
+        timingEl.textContent = result.verifyDurationMs
+          ? `Verified in ${result.verifyDurationMs} ms`
+          : 'Verification halted';
+
+        updateCheckItem(
+          'check-schema',
+          result.checks.schemaValid,
+          result.checks.schemaValid
+            ? 'Document Schema & Required Fields Valid'
+            : 'Document Schema Invalid or Missing Identifier'
+        );
+        updateCheckItem(
+          'check-digest',
+          result.checks.digestMatches,
+          result.checks.digestMatches
+            ? 'Canonical SHA-256 Digest Matches Payload'
+            : 'Canonical SHA-256 Digest Mismatch (Payload Tampered)'
+        );
+        updateCheckItem(
+          'check-keyid',
+          result.checks.keyFingerprintMatches,
+          result.checks.keyFingerprintMatches
+            ? `Issuer Key Fingerprint Verified (${result.computedKeyId || ''})`
+            : 'Public Key Fingerprint Mismatch (Untrusted Key)'
+        );
+        updateCheckItem(
+          'check-signature',
+          result.checks.signatureCryptographicallyValid,
+          result.checks.signatureCryptographicallyValid
+            ? `Asymmetric Signature Verified (${result.algorithmName || ''})`
+            : 'Asymmetric Cryptographic Signature Rejected'
+        );
+
+        document.getElementById('diag-doc-type').textContent =
+          (bundle && bundle.payload && bundle.payload.documentType) || 'UNKNOWN';
+        document.getElementById('diag-algo').textContent =
+          result.algorithmName ? `${result.algorithm} (${result.regimeLabel})` : '--';
+        document.getElementById('diag-computed-digest').textContent =
+          result.computedDigestHex ? `${result.computedDigestHex.slice(0, 24)}...` : '--';
+        document.getElementById('diag-claimed-digest').textContent =
+          result.claimedDigestHex ? `${result.claimedDigestHex.slice(0, 24)}...` : '--';
+      }
+
+      window.verifierSimulatePayloadTamper = async function () {
+        try {
+          const bundle = JSON.parse(document.getElementById('verifier-bundle-json').value);
+          if (bundle.payload.totalAmount !== undefined) {
+            bundle.payload.totalAmount = Number((bundle.payload.totalAmount + 100).toFixed(2));
+          } else if (bundle.payload.amount !== undefined) {
+            bundle.payload.amount = Number((bundle.payload.amount + 100).toFixed(2));
+          }
+          document.getElementById('verifier-bundle-json').value = JSON.stringify(bundle, null, 2);
+          await window.runVerificationFromInputs();
+        } catch (_) {}
+      };
+
+      window.verifierSimulateSignatureCorruption = async function () {
+        try {
+          const bundle = JSON.parse(document.getElementById('verifier-bundle-json').value);
+          const sigBytes = CryptoEngine.base64ToBytes(bundle.cryptographicProof.signatureBase64);
+          sigBytes[Math.floor(sigBytes.length / 2)] ^= 0xff;
+          sigBytes[Math.floor(sigBytes.length / 3)] ^= 0xaa;
+          bundle.cryptographicProof.signatureBase64 = CryptoEngine.bytesToBase64(sigBytes);
+          document.getElementById('verifier-bundle-json').value = JSON.stringify(bundle, null, 2);
+          await window.runVerificationFromInputs();
+        } catch (_) {}
+      };
+
+      window.verifierSimulateWrongPublicKey = async function () {
+        try {
+          const bundle = JSON.parse(document.getElementById('verifier-bundle-json').value);
+          const algo = (bundle.cryptographicProof && bundle.cryptographicProof.algorithm) || 'ML-DSA-65';
+          const rogueKey = await CryptoEngine.generateKeyPair(algo, 'Unauthorized Rogue Key');
+          document.getElementById('verifier-pubkey-pem').value = rogueKey.publicKeyPem;
+          await window.runVerificationFromInputs();
+        } catch (_) {}
+      };
+
+      window.verifierUseBundlePublicKey = async function () {
+        try {
+          const bundle = JSON.parse(document.getElementById('verifier-bundle-json').value);
+          if (bundle && bundle.cryptographicProof && bundle.cryptographicProof.publicKeyPem) {
+            document.getElementById('verifier-pubkey-pem').value = bundle.cryptographicProof.publicKeyPem;
+            await window.runVerificationFromInputs();
+          }
+        } catch (_) {}
+      };
+
+      window.verifierRestoreOriginalBundle = async function () {
+        if (state.lastUnmodifiedBundleInVerifier) {
+          if (state.latestSignedReceipt) {
+            renderSignedReceiptTicket(state.latestSignedReceipt);
+          }
+          if (state.latestSignedVoucher) {
+            renderSignedGiftVoucherCard(state.latestSignedVoucher);
+          }
+          await loadBundleIntoVerifier(state.lastUnmodifiedBundleInVerifier, false);
+        }
+      };
+
+      // Initialize Key Vault, Sample Signed Receipt, and Sample Signed Gift Voucher on load
+      async function initializeStudio() {
+        renderOrderBuilderItems();
+
+        // Pre-populate keyring with both Classical and Quantum-Resistant keys
+        const classicalKp = await CryptoEngine.generateKeyPair(
+          'ECDSA-P256',
+          'Register #02 Classical Key (ECDSA P-256)'
+        );
+        state.keyRing.push(classicalKp);
+
+        const pqcKp = await CryptoEngine.generateKeyPair(
+          'ML-DSA-65',
+          'Roastery Primary Quantum-Safe Key (ML-DSA-65)'
+        );
+        state.keyRing.unshift(pqcKp);
+
+        setActiveKeyPair(pqcKp);
+
+        // Mint initial signed Gift Voucher & signed Coffee Order Receipt so both are ready immediately
+        await window.signCurrentGiftVoucher();
+        await window.signCurrentOrderReceipt();
+      }
+
+      document.getElementById('verifier-bundle-json').addEventListener('input', () => {
+        window.runVerificationFromInputs();
+      });
+      document.getElementById('verifier-pubkey-pem').addEventListener('input', () => {
+        window.runVerificationFromInputs();
+      });
+
+      initializeStudio();
+    })();
+  </script>
