+            <td>${escapeHtml(item.item)}</td>
+            <td>${item.quantity}</td>
+            <td>$${item.lineTotal.toFixed(2)}</td>
+          `;
+          tbody.appendChild(tr);
+        });
+
+        document.getElementById('receipt-view-subtotal').textContent = `$${payload.subtotal.toFixed(2)}`;
+        document.getElementById('receipt-view-tax').textContent = `$${payload.taxAmount.toFixed(2)}`;
+        document.getElementById('receipt-view-total').textContent = `$${payload.totalAmount.toFixed(2)}`;
+
+        document.getElementById('receipt-seal-algo').textContent =
+          `${cryptographicProof.algorithmName} [${cryptographicProof.regimeLabel}]`;
+        document.getElementById('receipt-seal-keyid').textContent = cryptographicProof.keyId;
+        document.getElementById('receipt-seal-digest').textContent = cryptographicProof.canonicalDigestSha256;
+        document.getElementById('receipt-seal-sig').textContent =
+          `${cryptographicProof.signatureBase64.slice(0, 56)}... (${cryptographicProof.signatureByteLength} bytes)`;
+      }
+
+      window.signCurrentOrderReceipt = async function () {
+        if (!state.activeKeyPair) {
+          await window.handleGenerateNewKeyPair();
+        }
+        const payload = buildOrderReceiptPayload();
+        const signed = await CryptoEngine.signPayload(payload, state.activeKeyPair);
