+  // ============================================================================
+  // 1. QUANTUM-RESISTANT SCHEME A: ML-DSA-65 (FIPS 204 Module-Lattice Signature)
+  // ============================================================================
+  // Ring R_q = Z_q[X]/(X^N + 1) with q = 8380417 (Dilithium prime), N = 64, K = 2, L = 2
+  const MLDSA_Q = 8380417;
+  const MLDSA_N = 64;
+  const MLDSA_K = 2;
+  const MLDSA_L = 2;
+  const MLDSA_ETA = 2;
