+  <script>
+    function fitHeroLockup() {
+      const heading = document.querySelector('.hero h1');
+      if (!heading) return;
+      const targetWidth = heading.clientWidth;
+      if (!targetWidth) return;
+      const lines = heading.querySelectorAll('.lockup-line');
+      lines.forEach((line) => {
+        line.style.fontSize = '100px';
+        const measured = line.getBoundingClientRect().width;
+        if (measured > 0) {
+          const firstPass = (100 * targetWidth) / measured;
+          line.style.fontSize = firstPass + 'px';
+          const secondMeasured = line.getBoundingClientRect().width;
+          if (secondMeasured > 0) {
+            line.style.fontSize = (firstPass * targetWidth) / secondMeasured + 'px';
+          }
+        }
+      });
+    }
+
+    fitHeroLockup();
+    window.addEventListener('resize', fitHeroLockup);
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(fitHeroLockup);
+    }
+  </script>
+
