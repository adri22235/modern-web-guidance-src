+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('toggle-spacious');
+      const targetContainer = document.getElementById('target-container');
+      if (!toggleBtn || !targetContainer) return;
+
+      if (typeof CSS !== 'undefined' && typeof CSS.supports === 'function') {
+        if (!CSS.supports('container-type', 'inline-size') && !CSS.supports('container-type', 'normal')) {
+          toggleBtn.style.display = 'none';
+          return;
+        }
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        const currentDensity = getComputedStyle(targetContainer)
+          .getPropertyValue('--card-density')
+          .trim();
+        const nextDensity = currentDensity === 'spacious' ? 'normal' : 'spacious';
+        targetContainer.style.setProperty('--card-density', nextDensity);
+        toggleBtn.setAttribute('aria-pressed', String(nextDensity === 'spacious'));
+      });
+    })();
+  </script>
+
