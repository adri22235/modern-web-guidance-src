+  <script>
+    const toggleSpaciousBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    toggleSpaciousBtn?.addEventListener('click', () => {
+      const currentDensity = getComputedStyle(targetContainer)
+        .getPropertyValue('--card-density')
+        .trim();
+      const nextDensity = currentDensity === 'spacious' ? 'compact' : 'spacious';
+      targetContainer.style.setProperty('--card-density', nextDensity);
+      toggleSpaciousBtn.setAttribute('aria-pressed', String(nextDensity === 'spacious'));
+    });
+  </script>
