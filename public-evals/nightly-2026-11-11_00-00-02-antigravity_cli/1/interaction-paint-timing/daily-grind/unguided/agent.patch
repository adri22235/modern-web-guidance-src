+  <script>
+    (function () {
+      const metrics = [];
+
+      const VIEW_CONTENT = {
+        'home': {
+          title: 'Welcome to The Daily Grind',
+          description: 'Explore our seasonal favorites and freshly roasted artisanal blends.'
+        },
+        'menu': {
+          title: 'Full Artisanal Menu',
+          description: 'Browse our handcrafted espresso drinks, pour-overs, cold brews, and fresh pastries.'
+        },
+        'locations': {
+          title: 'Our Coffee Houses',
+          description: 'Visit us in Downtown, Riverside, and West End — open daily from 6:00 AM to 7:00 PM.'
+        },
+        'rewards': {
+          title: 'Daily Grind Rewards',
+          description: 'Earn 10 beans per dollar spent. Redeem for complimentary drinks and single-origin bags.'
+        },
+        'account': {
+          title: 'My Account',
+          description: 'Manage your coffee subscriptions, saved payment methods, and favorite drink presets.'
+        },
+        'logout': {
+          title: 'Signed Out',
+          description: 'You have been safely logged out. See you for your next cup!'
+        },
+        'order-online': {
+          title: 'Order Online for Pickup or Delivery',
+          description: 'Select your local cafe and customize your drink for express pickup.'
+        },
+        'menu/seasonal': {
+          title: 'Maple Oat Latte — Seasonal Favorite',
+          description: 'Double shot of signature espresso, steamed barista oat milk, pure Vermont grade-A maple syrup, and a dusting of cinnamon ($5.75).'
+        },
+        'menu/espresso': {
+          title: 'Dark Roast Espresso — Seasonal Favorite',
+          description: 'Full-bodied blend of Sumatra and Colombian beans roasted dark with notes of dark chocolate and toasted walnut ($3.50).'
+        },
+        'menu/cold-brew': {
+          title: '18-Hour Cold Brew — Seasonal Favorite',
+          description: 'Coarse-ground Ethiopian beans steeped in filtered cold water for 18 hours for a velvety, low-acid finish ($4.75).'
+        }
+      };
+
+      /**
+       * Wait until the browser has finished painting visual updates on the page
+       * using nested requestAnimationFrame callbacks (first rAF runs before layout/paint,
+       * second rAF runs immediately after the frame has been painted).
+       */
+      function afterNextPaint(callback) {
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () {
+            callback(performance.now());
+          });
+        });
+      }
+
+      /**
+       * Measure the time from interaction/start until visual updates finish painting.
+       */
+      function measurePaintLatency(category, label, startTime, detail) {
+        const startMark = 'perf-start-' + category + '-' + metrics.length;
+        const endMark = 'perf-paint-' + category + '-' + metrics.length;
+        const measureName = category + ':' + label;
+
+        try {
+          performance.mark(startMark, { startTime: startTime });
+        } catch (e) {
+          performance.mark(startMark);
+        }
+
+        afterNextPaint(function (paintTime) {
+          const duration = Math.max(0, paintTime - startTime);
+          try {
+            performance.mark(endMark, { startTime: paintTime });
+            performance.measure(measureName, {
+              start: startTime,
+              end: paintTime,
+              detail: Object.assign({ category: category, label: label, durationMs: duration }, detail || {})
+            });
+          } catch (e) {
+            try {
+              performance.measure(measureName, startMark);
+            } catch (_) {}
+          }
+
+          const entry = {
+            id: metrics.length + 1,
+            category: category,
+            label: label,
+            startTime: Number(startTime.toFixed(2)),
+            paintTime: Number(paintTime.toFixed(2)),
+            durationMs: Number(duration.toFixed(2)),
+            timestamp: new Date().toISOString()
+          };
+
+          metrics.push(entry);
+          updateMonitorUI(entry);
+
+          window.dispatchEvent(new CustomEvent('dailygrind:perf', { detail: entry }));
+          console.info('[PerfMonitor] ' + category + ' ("' + label + '") painted in ' + entry.durationMs.toFixed(2) + ' ms', entry);
+        });
+      }
+
+      function updateMonitorUI(latestEntry) {
+        const countEl = document.getElementById('perf-count');
+        const lastEl = document.getElementById('perf-last');
+        const avgEl = document.getElementById('perf-avg');
+        const maxEl = document.getElementById('perf-max');
+        const logEl = document.getElementById('perf-log');
+
+        if (!countEl || !logEl) return;
+
+        const total = metrics.length;
+        const sum = metrics.reduce(function (acc, m) { return acc + m.durationMs; }, 0);
+        const max = metrics.reduce(function (acc, m) { return Math.max(acc, m.durationMs); }, 0);
+        const avg = total > 0 ? sum / total : 0;
+
+        countEl.textContent = total + (total === 1 ? ' event' : ' events');
+        lastEl.textContent = latestEntry.durationMs.toFixed(1) + ' ms';
+        avgEl.textContent = avg.toFixed(1) + ' ms';
+        maxEl.textContent = max.toFixed(1) + ' ms';
+
+        const li = document.createElement('li');
+        const nameSpan = document.createElement('span');
+        nameSpan.textContent = '[' + latestEntry.category + '] ' + latestEntry.label;
+        const durSpan = document.createElement('span');
+        durSpan.className = 'perf-duration';
+        durSpan.textContent = latestEntry.durationMs.toFixed(2) + ' ms';
+
+        li.appendChild(nameSpan);
+        li.appendChild(durSpan);
+        logEl.insertBefore(li, logEl.firstChild);
+      }
+
+      /**
+       * Perform a client-side view switch and measure its paint completion time.
+       */
+      function switchView(viewKey, triggerStartTime) {
+        const viewSwitchStart = typeof triggerStartTime === 'number' ? triggerStartTime : performance.now();
+        const normalizedKey = (viewKey || 'home').replace(/^\/+/, '') || 'home';
+        const content = VIEW_CONTENT[normalizedKey] || {
+          title: normalizedKey,
+          description: 'Viewing ' + normalizedKey
+        };
+
+        // Update active state on nav links
+        const navLinks = document.querySelectorAll('nav a');
+        navLinks.forEach(function (link) {
+          const linkView = (link.getAttribute('data-view') || link.getAttribute('href') || '').replace(/^\/+/, '');
+          if (linkView === normalizedKey) {
+            link.classList.add('active');
+          } else {
+            link.classList.remove('active');
+          }
+        });
+
+        // Update selected state on seasonal cards
+        const cards = document.querySelectorAll('#seasonal-grid .card');
+        cards.forEach(function (card) {
+          const cardView = (card.getAttribute('data-view') || '').replace(/^\/+/, '');
+          if (cardView === normalizedKey) {
+            card.classList.add('selected');
+          } else {
+            card.classList.remove('selected');
+          }
+        });
+
+        // Update dynamic view panel
+        const panel = document.getElementById('dynamic-view-panel');
+        const titleEl = document.getElementById('view-title');
+        const descEl = document.getElementById('view-description');
+
+        if (panel && titleEl && descEl) {
+          if (normalizedKey === 'home') {
+            panel.classList.remove('active');
+          } else {
+            titleEl.textContent = content.title;
+            descEl.textContent = content.description;
+            panel.classList.add('active');
+          }
+        }
+
+        // Update URL hash/history without triggering page reload
+        try {
+          if (window.location.protocol !== 'file:') {
+            const targetUrl = normalizedKey === 'home' ? '/' : '/' + normalizedKey;
+            window.history.pushState({ view: normalizedKey }, content.title, targetUrl);
+          }
+        } catch (_) {}
+
+        measurePaintLatency('view-switch', normalizedKey, viewSwitchStart, { view: normalizedKey });
+      }
+
+      // 1. Navigation bar clicks
+      const navEl = document.querySelector('nav');
+      if (navEl) {
+        navEl.addEventListener('click', function (event) {
+          const clickStart = (event.timeStamp && event.timeStamp > 0) ? event.timeStamp : performance.now();
+          const link = event.target.closest('a, .logo');
+          if (!link) return;
+
+          event.preventDefault();
+          const label = (link.textContent || 'Nav Item').trim();
+          const targetView = link.getAttribute('data-view') || link.getAttribute('href') || 'home';
+
+          measurePaintLatency('nav-click', label, clickStart, { targetView: targetView });
+          switchView(targetView, performance.now());
+        });
+      }
+
+      // 2. "Order Now" button click
+      const orderBtn = document.getElementById('order-now-btn') || document.querySelector('.hero .btn');
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (event) {
+          const clickStart = (event.timeStamp && event.timeStamp > 0) ? event.timeStamp : performance.now();
+          event.preventDefault();
+          const label = (orderBtn.textContent || 'Order Now').trim();
+          const targetView = orderBtn.getAttribute('data-view') || orderBtn.getAttribute('href') || 'order-online';
+
+          measurePaintLatency('order-now-click', label, clickStart, { targetView: targetView });
+          switchView(targetView, performance.now());
+        });
+      }
+
+      // 3. "Seasonal Favorites" card clicks
+      const seasonalGrid = document.getElementById('seasonal-grid');
+      if (seasonalGrid) {
+        seasonalGrid.addEventListener('click', function (event) {
+          const card = event.target.closest('.card');
+          if (!card) return;
+
+          const clickStart = (event.timeStamp && event.timeStamp > 0) ? event.timeStamp : performance.now();
+          event.preventDefault();
+
+          const heading = card.querySelector('h3');
+          const label = card.getAttribute('data-item') || (heading ? heading.textContent.trim() : 'Seasonal Card');
+          const link = card.querySelector('a');
+          const targetView = card.getAttribute('data-view') || (link ? link.getAttribute('href') : 'menu/seasonal');
+
+          measurePaintLatency('seasonal-card-click', label, clickStart, { targetView: targetView });
+          switchView(targetView, performance.now());
+        });
+      }
+
+      // 4. Back to Featured button & browser popstate (client-side view switches)
+      const backBtn = document.getElementById('back-home-btn');
+      if (backBtn) {
+        backBtn.addEventListener('click', function () {
+          switchView('home', performance.now());
+        });
+      }
+
+      window.addEventListener('popstate', function (event) {
+        const view = (event.state && event.state.view) || window.location.pathname.replace(/^\/+/, '') || 'home';
+        switchView(view, performance.now());
+      });
+
+      // Expose programmatic API for inspecting metrics and triggering measured view switches
+      window.dailyGrindPerf = {
+        getMetrics: function () { return metrics.slice(); },
+        getMetricsByCategory: function (category) {
+          return metrics.filter(function (m) { return m.category === category; });
+        },
+        clearMetrics: function () {
+          metrics.length = 0;
+          performance.clearMarks();
+          performance.clearMeasures();
+        },
+        measureInteractionPaint: measurePaintLatency,
+        switchView: switchView
+      };
+    })();
+  </script>
 </body>
 
