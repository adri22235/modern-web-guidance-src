+  <script type="module">
+    const interactionTargetsById = new Map();
+    let lastTrackedTarget = null;
+
+    const perfMetrics = {
+      interactionPaints: [],
+      softNavigations: [],
+      hardNavigationLCP: [],
+      eventTimings: [],
+      layoutShifts: [],
+    };
+
+    /**
+     * Identifies whether a DOM node belongs to one of the monitored homepage targets:
+     * navigation bar, "Order Now" button, or "Seasonal Favorites" cards.
+     *
+     * @param {EventTarget | null} node
+     * @returns {{ category: string, label: string, href: string | null, element: Element } | null}
+     */
+    export function identifyMonitoredTarget(node) {
+      if (!(node instanceof Element)) return null;
+
+      const orderNowEl = node.closest('[data-perf-target="order-now"], .hero .btn');
+      if (orderNowEl) {
+        return {
+          category: 'order-now',
+          label: orderNowEl.textContent?.trim() || 'Order Now',
+          href: orderNowEl.getAttribute('href'),
+          element: orderNowEl,
+        };
+      }
+
+      const seasonalCardEl = node.closest('[data-perf-target="seasonal-favorites"], .card');
+      if (seasonalCardEl) {
+        const cardContainer = seasonalCardEl.closest('.card') || seasonalCardEl;
+        const heading = cardContainer.querySelector('h3')?.textContent?.trim();
+        const linkEl = seasonalCardEl.closest('a') || cardContainer.querySelector('a');
+        return {
+          category: 'seasonal-favorites',
+          label: heading || seasonalCardEl.textContent?.trim() || 'Seasonal Favorites Card',
+          href: linkEl ? linkEl.getAttribute('href') : null,
+          element: cardContainer,
+        };
+      }
+
+      const navEl = node.closest('nav a, [data-perf-target="navigation-bar"], nav');
+      if (navEl) {
+        const linkEl = navEl.closest('a') || navEl.querySelector('a');
+        return {
+          category: 'navigation-bar',
+          label: (linkEl || navEl).textContent?.trim() || 'Navigation Bar',
+          href: linkEl ? linkEl.getAttribute('href') : null,
+          element: linkEl || navEl,
+        };
+      }
+
+      return null;
+    }
+
+    /**
+     * Observes contentful paints caused by user interactions and invokes a callback
+     * whenever an interaction produces a larger contentful paint.
+     *
+     * @param {(entry: PerformanceEntry, targetInfo: ReturnType<typeof identifyMonitoredTarget>) => void} onInteractionPaint
+     */
+    export function observeInteractionPaints(onInteractionPaint) {
+      // Feature-detect support before calling observe() so unsupported browsers
+      // do not throw or log console warnings.
+      if (
+        typeof PerformanceObserver === 'undefined' ||
+        !PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint')
+      ) {
+        return null;
+      }
+
+      const observer = new PerformanceObserver((list) => {
+        for (const entry of list.getEntries()) {
+          // entry.duration is already calculated as (entry.presentationTime - entry.startTime),
+          // giving the total time from the user interaction to this contentful paint.
+          const targetInfo =
+            (entry.interactionId && interactionTargetsById.get(entry.interactionId)) ||
+            lastTrackedTarget ||
+            null;
+          onInteractionPaint(entry, targetInfo);
+        }
+      });
+
+      // MANDATORY: Pass buffered: true to capture interaction paints that occurred
+      // before this observer was registered.
+      observer.observe({ type: 'interaction-contentful-paint', buffered: true });
+      return observer;
+    }
+
+    /**
+     * Tracks FCP and LCP for each client-side soft navigation and reports finalized
+     * route metrics when the user navigates to a new route or hides the page.
+     *
+     * @param {(report: {
+     *   url: string,
+     *   navigationId: number,
+     *   interactionId: number,
+     *   fcpDuration: number,
+     *   lcpDuration: number | null,
+     *   lcpElement: Element | null,
+     *   lcpSize: number | null,
+     *   target: ReturnType<typeof identifyMonitoredTarget>
+     * }) => void} onSoftNavReport
+     */
+    export function trackSoftNavigationLCP(onSoftNavReport) {
+      const supported =
+        typeof PerformanceObserver !== 'undefined' &&
+        PerformanceObserver.supportedEntryTypes?.includes('soft-navigation') &&
+        PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint');
+
+      if (!supported) {
+        return null;
+      }
+
+      let activeSoftNav = null;
+      let activeLcpEntry = null;
+
+      function finalizeCurrentSoftNav() {
+        if (!activeSoftNav) return;
+
+        const targetInfo =
+          (activeSoftNav.interactionId &&
+            interactionTargetsById.get(activeSoftNav.interactionId)) ||
+          lastTrackedTarget ||
+          null;
+
+        onSoftNavReport({
+          // activeSoftNav.name holds the destination URL of the soft navigation.
+          url: activeSoftNav.name,
+          navigationId: activeSoftNav.navigationId,
+          interactionId: activeSoftNav.interactionId,
+          // activeSoftNav.duration is (activeSoftNav.presentationTime - activeSoftNav.startTime),
+          // which represents First Contentful Paint (FCP) relative to interaction start.
+          fcpDuration: activeSoftNav.duration,
+          // activeLcpEntry.duration is (activeLcpEntry.presentationTime - activeSoftNav.startTime),
+          // representing the soft navigation's LCP duration relative to interaction start.
+          lcpDuration: activeLcpEntry ? activeLcpEntry.duration : null,
+          lcpElement: activeLcpEntry?.largestContentfulPaint?.element ?? null,
+          lcpSize: activeLcpEntry?.largestContentfulPaint?.size ?? null,
+          target: targetInfo,
+        });
+
+        activeSoftNav = null;
+        activeLcpEntry = null;
+      }
+
+      const softNavObserver = new PerformanceObserver((list) => {
+        for (const softNavEntry of list.getEntries()) {
+          // Finalize the previous route's metrics before resetting state for the new route.
+          finalizeCurrentSoftNav();
+
+          activeSoftNav = softNavEntry;
+          // MANDATORY: Seed the LCP candidate with getLargestInteractionContentfulPaint()
+          // to capture any attributed contentful paints that occurred before the URL updated.
+          activeLcpEntry = softNavEntry.getLargestInteractionContentfulPaint();
+        }
+      });
+
+      const icpObserver = new PerformanceObserver((list) => {
+        for (const icpEntry of list.getEntries()) {
+          // MANDATORY: Match by interactionId (not navigationId) so only paints caused
+          // by the soft navigation's initiating interaction update the route's LCP.
+          if (activeSoftNav && icpEntry.interactionId === activeSoftNav.interactionId) {
+            activeLcpEntry = icpEntry;
+          }
+        }
+      });
+
+      softNavObserver.observe({ type: 'soft-navigation', buffered: true });
+      icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+
+      // Finalize the active route's LCP when the page is backgrounded or unloaded.
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden') {
+          finalizeCurrentSoftNav();
+        }
+      });
+
+      return { softNavObserver, icpObserver, finalizeCurrentSoftNav };
+    }
+
+    /**
+     * Keeps standard hard-navigation and responsiveness observers active across all
+     * browsers as a fallback and baseline alongside soft-navigation and interaction-paint observers.
+     */
+    export function observeStandardPerformanceMetrics() {
+      if (typeof PerformanceObserver === 'undefined') {
+        return null;
+      }
+
+      const observers = {};
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
+        const lcpObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            perfMetrics.hardNavigationLCP.push({
+              startTime: entry.startTime,
+              renderTime: entry.renderTime,
+              loadTime: entry.loadTime,
+              size: entry.size,
+              element: entry.element ?? null,
+              url: entry.url ?? '',
+              id: entry.id ?? '',
+            });
+          }
+        });
+        lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
+        observers.lcpObserver = lcpObserver;
+      }
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('event')) {
+        const eventObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            const targetInfo = identifyMonitoredTarget(entry.target);
+            if (entry.interactionId && targetInfo) {
+              interactionTargetsById.set(entry.interactionId, targetInfo);
+            }
+            if (
+              targetInfo &&
+              (entry.name === 'click' || entry.name === 'pointerdown' || entry.name === 'pointerup')
+            ) {
+              perfMetrics.eventTimings.push({
+                name: entry.name,
+                interactionId: entry.interactionId,
+                startTime: entry.startTime,
+                processingStart: entry.processingStart,
+                processingEnd: entry.processingEnd,
+                duration: entry.duration,
+                targetCategory: targetInfo.category,
+                targetLabel: targetInfo.label,
+              });
+            }
+          }
+        });
+        eventObserver.observe({ type: 'event', buffered: true, durationThreshold: 16 });
+        observers.eventObserver = eventObserver;
+      }
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('layout-shift')) {
+        const clsObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (!entry.hadRecentInput) {
+              perfMetrics.layoutShifts.push({
+                value: entry.value,
+                startTime: entry.startTime,
+              });
+            }
+          }
+        });
+        clsObserver.observe({ type: 'layout-shift', buffered: true });
+        observers.clsObserver = clsObserver;
+      }
+
+      return observers;
+    }
+
+    // Initialize observers and store structured telemetry entries.
+    const interactionPaintObserver = observeInteractionPaints((entry, targetInfo) => {
+      const record = {
+        interactionId: entry.interactionId,
+        startTime: entry.startTime,
+        paintTime: entry.paintTime,
+        presentationTime: entry.presentationTime,
+        // Use entry.duration (entry.presentationTime - entry.startTime) for interaction paint latency
+        duration: entry.duration,
+        element: entry.largestContentfulPaint?.element ?? null,
+        size: entry.largestContentfulPaint?.size ?? null,
+        url: entry.largestContentfulPaint?.url ?? '',
+        id: entry.largestContentfulPaint?.id ?? '',
+        renderTime: entry.largestContentfulPaint?.renderTime ?? null,
+        loadTime: entry.largestContentfulPaint?.loadTime ?? null,
+        targetCategory: targetInfo?.category ?? null,
+        targetLabel: targetInfo?.label ?? null,
+      };
+      perfMetrics.interactionPaints.push(record);
+      window.dispatchEvent(new CustomEvent('dailygrind:interaction-paint', { detail: record }));
+    });
+
+    const softNavTracker = trackSoftNavigationLCP((report) => {
+      perfMetrics.softNavigations.push(report);
+      window.dispatchEvent(new CustomEvent('dailygrind:soft-navigation', { detail: report }));
+    });
+
+    const standardObservers = observeStandardPerformanceMetrics();
+
+    // Client-side view content for navigation bar, "Order Now", and "Seasonal Favorites" views
+    const VIEWS = {
+      '/menu': {
+        title: 'Full Artisanal Menu',
+        description: 'Explore our seasonal single-origin pour-overs, signature espresso drinks, and house-made pastries baked fresh every morning.',
+      },
+      '/locations': {
+        title: 'Our Coffeehouse Locations',
+        description: 'Visit our downtown roastery, neighborhood cafes, and reserve tasting room open daily from 6:00 AM to 7:00 PM.',
+      },
+      '/rewards': {
+        title: 'Daily Grind Rewards',
+        description: 'Earn 2 beans for every $1 spent. Redeem beans for handcrafted beverages, whole-bean bags, and brewing gear.',
+      },
+      '/account': {
+        title: 'My Account & Subscriptions',
+        description: 'Manage your recurring whole-bean deliveries, saved favorite drinks, and payment methods.',
+      },
+      '/logout': {
+        title: 'Signed Out',
+        description: 'You have been safely signed out of your Daily Grind account. See you again soon for your next cup!',
+      },
+      '/order-online': {
+        title: 'Order Ahead for Pickup or Delivery',
+        description: 'Customize your handcrafted espresso, cold brew, or seasonal latte for express pickup in 5 minutes.',
+      },
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte — Seasonal Favorite',
+        description: 'Double-shot artisanal espresso velvety-steamed with organic oat milk, pure Grade-A Vermont maple syrup, and a dusting of cinnamon.',
+      },
+      '/menu/espresso': {
+        title: 'Dark Roast Espresso — Seasonal Favorite',
+        description: 'Full-bodied dark roast blend with tasting notes of bittersweet cocoa, toasted walnut, and smoky caramel finish.',
+      },
+      '/menu/cold-brew': {
+        title: '18-Hour Cold Brew — Seasonal Favorite',
+        description: 'Coarse-ground Colombian beans steeped in cold filtered water for 18 hours for ultra-smooth, low-acidity chocolatey richness.',
+      },
+    };
+
+    const dynamicViewEl = document.getElementById('dynamic-view');
+
+    function renderClientView(path, targetInfo, pushHistory = true) {
+      const viewData = VIEWS[path];
+      if (!viewData || !dynamicViewEl) {
+        if (path === '/' && dynamicViewEl) {
+          dynamicViewEl.hidden = true;
+          dynamicViewEl.replaceChildren();
+          if (pushHistory && window.location.pathname !== '/') {
+            history.pushState({ path: '/' }, '', '/');
+          }
+        }
+        return;
+      }
+
+      if (pushHistory && window.location.pathname !== path) {
+        history.pushState({ path, category: targetInfo?.category ?? null }, '', path);
+      }
+
+      const heading = document.createElement('h2');
+      heading.textContent = viewData.title;
+
+      const body = document.createElement('p');
+      body.textContent = viewData.description;
+
+      dynamicViewEl.replaceChildren(heading, body);
+      dynamicViewEl.hidden = false;
+    }
+
+    document.addEventListener('click', (event) => {
+      const targetInfo = identifyMonitoredTarget(event.target);
+      if (!targetInfo) return;
+
+      lastTrackedTarget = targetInfo;
+
+      if (targetInfo.href && (VIEWS[targetInfo.href] || targetInfo.href === '/')) {
+        event.preventDefault();
+        renderClientView(targetInfo.href, targetInfo, true);
+      }
+    });
+
+    window.addEventListener('popstate', () => {
+      renderClientView(window.location.pathname, null, false);
+    });
+
+    // Expose monitoring API and collected telemetry on window for inspection
+    window.dailyGrindPerf = {
+      metrics: perfMetrics,
+      observeInteractionPaints,
+      trackSoftNavigationLCP,
+      observeStandardPerformanceMetrics,
+      identifyMonitoredTarget,
+      interactionPaintObserver,
+      softNavTracker,
+      standardObservers,
+    };
+  </script>
+
