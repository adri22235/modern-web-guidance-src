+  <script>
+    document.querySelectorAll('.card .iced-checkbox').forEach((checkbox) => {
+      const updateCardState = () => {
+        const card = checkbox.closest('.card');
+        if (!card) return;
+        const isChecked = checkbox.checked;
+        card.classList.toggle('is-iced', isChecked);
+        card.classList.toggle('iced', isChecked);
+        card.setAttribute('data-iced', String(isChecked));
+      };
+
+      checkbox.addEventListener('change', updateCardState);
+      updateCardState();
+    });
+  </script>
