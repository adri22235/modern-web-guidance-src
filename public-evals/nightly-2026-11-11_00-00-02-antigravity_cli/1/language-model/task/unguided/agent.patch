+
+          const structuredOutput = {
+            score: typeof parsedResult.score === 'number' ? parsedResult.score : Number(parsedResult.score) || 5,
+            category: parsedResult.category || 'Positive'
+          };
+
+          sentimentOutputEl.textContent = JSON.stringify(structuredOutput, null, 2);
+        } catch (err) {
