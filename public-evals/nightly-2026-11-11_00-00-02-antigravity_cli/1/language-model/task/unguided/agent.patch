+
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+      const contextUsageEl = document.getElementById('context-usage');
+      const activeBranchesCountEl = document.getElementById('active-branches-count');
+      const branchListEl = document.getElementById('branch-list');
+      const branchOutputEl = document.getElementById('branch-output');
+
+      /**
+       * Resolves the built-in Prompt API provider (supports modern global LanguageModel
+       * as well as window.ai.languageModel).
+       */
+      function getLanguageModelProvider() {
+        if (typeof LanguageModel !== 'undefined') {
+          return LanguageModel;
+        }
+        if (typeof window !== 'undefined' && window.ai && window.ai.languageModel) {
+          return window.ai.languageModel;
+        }
+        return null;
+      }
+
+      /**
+       * Checks whether the built-in AI model is available before starting.
+       * Supports both modern `availability()` and legacy `capabilities()`.
+       */
+      async function checkModelAvailability() {
+        const provider = getLanguageModelProvider();
+        if (!provider) {
+          modelStatusEl.textContent = 'Model Status: Built-in AI Not Supported';
+          return { available: false, status: 'unsupported', provider: null };
+        }
+
+        try {
+          if (typeof provider.availability === 'function') {
+            const availability = await provider.availability();
+            modelStatusEl.textContent = `Model Status: ${availability}`;
+            if (availability === 'no' || availability === 'unavailable') {
+              return { available: false, status: availability, provider };
+            }
+            return { available: true, status: availability, provider };
+          }
+
+          if (typeof provider.capabilities === 'function') {
+            const capabilities = await provider.capabilities();
+            const available = capabilities?.available || 'readily';
+            modelStatusEl.textContent = `Model Status: ${available}`;
+            if (available === 'no') {
+              return { available: false, status: available, provider };
+            }
+            return { available: true, status: available, provider };
+          }
+
+          modelStatusEl.textContent = 'Model Status: Ready';
+          return { available: true, status: 'available', provider };
+        } catch (err) {
+          modelStatusEl.textContent = 'Model Status: Error checking availability';
+          return { available: false, status: 'error', error: err, provider };
+        }
+      }
+
+      /**
+       * Updates context window usage display from a session object.
+       * Supports modern inputUsage/inputQuota and legacy tokensSoFar/maxTokens/tokensLeft.
+       */
+      function updateContextUsageDisplay(session) {
+        if (!session) {
+          contextUsageEl.textContent = '0 / 0 tokens (No active session)';
+          return;
+        }
+
+        const used = session.inputUsage ?? session.tokensSoFar ?? 0;
+        const quota = session.inputQuota ?? session.maxTokens ?? 0;
+        const left = session.tokensLeft ?? Math.max(0, quota - used);
+
+        contextUsageEl.textContent = `${used} / ${quota} tokens (${left} remaining)`;
+      }
+
+      /**
+       * Attaches progress monitoring (`monitor`) and context overflow (`oncontextoverflow` / `quotaoverflow`)
+       * listeners following modern client-side AI best practices.
+       */
+      function createDownloadMonitor(m) {
+        m.addEventListener('downloadprogress', (e) => {
+          progressContainer.style.display = 'block';
+          const ratio = e.total ? e.loaded / e.total : (typeof e.loaded === 'number' ? e.loaded : 0);
+          const clamped = Math.min(1, Math.max(0, ratio));
+          progressBar.value = clamped;
+          const pct = Math.round(clamped * 100);
+          progressText.textContent = `${pct}%`;
+          modelStatusEl.textContent = `Model Status: Downloading (${pct}%)`;
+          if (clamped >= 1) {
+            setTimeout(() => {
+              progressContainer.style.display = 'none';
+            }, 800);
+          }
+        });
+      }
+
+      function attachSessionListeners(session) {
+        if (!session) return;
+        if (typeof session.addEventListener === 'function') {
+          session.addEventListener('contextoverflow', () => {
+            branchOutputEl.textContent = 'Notice: Session context window reached capacity; older messages may be truncated.';
+            updateContextUsageDisplay(session);
+          });
+          session.addEventListener('quotaoverflow', () => {
+            branchOutputEl.textContent = 'Notice: Session token quota exceeded.';
+            updateContextUsageDisplay(session);
+          });
+        }
+        updateContextUsageDisplay(session);
+      }
+
+      /**
+       * Creates or retrieves the active barista session with initialPrompts / systemPrompt
+       * and download progress monitoring.
+       */
+      async function ensureActiveSession(signal) {
+        if (activeSession) {
+          return activeSession;
+        }
+
+        const check = await checkModelAvailability();
+        if (!check.available || !check.provider) {
+          throw new Error(`Built-in AI model is unavailable (status: ${check.status}).`);
+        }
+
+        activeSession = await check.provider.create({
+          systemPrompt: BARISTA_SYSTEM_PROMPT,
+          initialPrompts: [
+            { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+          ],
+          signal,
+          monitor: createDownloadMonitor
+        });
+
+        modelStatusEl.textContent = 'Model Status: Active';
+        attachSessionListeners(activeSession);
+        return activeSession;
+      }
+
+      /**
+       * Destroys a session safely and releases resources.
+       */
+      function destroySessionSafely(session) {
+        if (session && typeof session.destroy === 'function') {
+          try {
+            session.destroy();
+          } catch (e) {
+            console.warn('Error destroying AI session:', e);
+          }
+        }
+      }
+
+      /**
+       * Cleans up all unneeded cloned sessions and updates the UI.
+       */
+      function cleanupUnneededSessions() {
+        let cleanedCount = 0;
+        while (clonedSessions.length > 0) {
+          const branch = clonedSessions.pop();
+          destroySessionSafely(branch.session);
+          cleanedCount++;
+        }
+        renderBranchList();
+        branchOutputEl.textContent = `Cleaned up ${cleanedCount} unneeded cloned session(s) via session.destroy().`;
+        updateContextUsageDisplay(activeSession);
+      }
+
+      /**
+       * Renders the list of cloned session branches with individual switching/cleanup controls.
+       */
+      function renderBranchList() {
+        activeBranchesCountEl.textContent = String(clonedSessions.length);
+        branchListEl.innerHTML = '';
+
+        clonedSessions.forEach((branch, index) => {
+          const used = branch.session.inputUsage ?? branch.session.tokensSoFar ?? 0;
+          const quota = branch.session.inputQuota ?? branch.session.maxTokens ?? 0;
+
+          const item = document.createElement('div');
+          item.className = 'branch-item';
+          item.innerHTML = `
+            <div>
+              <strong>Branch #${branch.id}</strong>
+              <span style="font-size: 0.85rem; margin-left: 8px;">(${used} / ${quota} tokens)</span>
+            </div>
+            <div class="ai-controls">
+              <button type="button" class="btn btn-secondary use-branch-btn" data-index="${index}" style="padding: 5px 10px; font-size: 0.8rem;">Switch To Branch</button>
+              <button type="button" class="btn btn-danger destroy-branch-btn" data-index="${index}" style="padding: 5px 10px; font-size: 0.8rem;">Destroy</button>
+            </div>
+          `;
+          branchListEl.appendChild(item);
+        });
+
+        branchListEl.querySelectorAll('.use-branch-btn').forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            const idx = Number(e.currentTarget.getAttribute('data-index'));
+            const selected = clonedSessions[idx];
+            if (!selected) return;
+            // Destroy previous active session if it isn't in clonedSessions
+            if (activeSession && activeSession !== selected.session) {
+              destroySessionSafely(activeSession);
+            }
+            activeSession = selected.session;
+            clonedSessions.splice(idx, 1);
+            renderBranchList();
+            updateContextUsageDisplay(activeSession);
+            branchOutputEl.textContent = `Switched active conversation to Branch #${selected.id} and destroyed previous session.`;
+          });
+        });
+
+        branchListEl.querySelectorAll('.destroy-branch-btn').forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            const idx = Number(e.currentTarget.getAttribute('data-index'));
+            const removed = clonedSessions.splice(idx, 1)[0];
+            if (removed) {
+              destroySessionSafely(removed.session);
+              renderBranchList();
+              branchOutputEl.textContent = `Destroyed Branch #${removed.id} and freed local AI resources.`;
+            }
+          });
+        });
+      }
+
+      // 1. Ask the Barista (Streaming Response with Availability Check)
+      askBaristaBtn.addEventListener('click', async () => {
+        const question = (questionInput.value || '').trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+
+        if (currentAbortController) {
+          currentAbortController.abort();
+        }
+        currentAbortController = new AbortController();
+        const { signal } = currentAbortController;
+
+        baristaAnswerEl.textContent = 'Checking model availability...';
+        askBaristaBtn.disabled = true;
+        stopBtn.style.display = 'inline-block';
+
+        try {
+          const availabilityCheck = await checkModelAvailability();
+          if (!availabilityCheck.available) {
+            baristaAnswerEl.textContent = `Built-in AI model is not available (${availabilityCheck.status}). Unable to answer questions about the Maple Oat Latte or Cold Brew right now.`;
+            return;
+          }
+
+          const session = await ensureActiveSession(signal);
+          baristaAnswerEl.textContent = '';
+
+          const promptText = `Customer Question (Maple Oat Latte / Cold Brew): ${question}`;
+          const stream = session.promptStreaming(promptText, { signal });
+
+          let accumulated = '';
