+  <script>
+    (() => {
+      const SYSTEM_PROMPT =
+        'You are the knowledgeable head barista at The Daily Grind artisanal coffee shop. ' +
+        'Our signature drinks include the Maple Oat Latte (creamy oat milk with pure Vermont maple syrup and espresso) ' +
+        'and our Cold Brew (ethically sourced beans steeped for 18 hours for maximum smoothness). ' +
+        'Provide concise, friendly, and helpful answers.';
+
+      const SENTIMENT_SCHEMA = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product-praise', 'service-issue']
+          }
+        },
+        required: ['score', 'category']
+      };
+
+      const workspaceEl = document.getElementById('barista-ai-workspace');
+      const modelStatusEl = document.getElementById('model-status');
+      const downloadProgressEl = document.getElementById('download-progress');
+
+      const questionInput = document.getElementById('barista-question');
+      const askBaristaBtn = document.getElementById('ask-the-barista');
+      const stopBaristaBtn = document.getElementById('stop-barista-btn');
+      const baristaAnswerEl = document.getElementById('barista-answer');
+
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const sentimentOutputEl = document.getElementById('sentiment-output');
+
+      const branchPromptInput = document.getElementById('branch-prompt');
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+      const cloneOutputEl = document.getElementById('clone-output');
+      const contextUsedEl = document.getElementById('context-used');
+      const contextWindowEl = document.getElementById('context-window');
+      const activeClonesCountEl = document.getElementById('active-clones-count');
+
+      let baseSession = null;
+      let baseSessionPromise = null;
+      const activeClones = new Set();
+      let baristaAbortController = null;
+
+      function updateContextMetrics(sessionToInspect = baseSession) {
+        const usage = sessionToInspect && typeof sessionToInspect.contextUsage === 'number'
+          ? sessionToInspect.contextUsage
+          : 0;
+        const maxWindow = sessionToInspect && typeof sessionToInspect.contextWindow === 'number'
+          ? sessionToInspect.contextWindow
+          : 0;
+        contextUsedEl.textContent = String(usage);
+        contextWindowEl.textContent = String(maxWindow);
+        const totalSessions = (baseSession ? 1 : 0) + activeClones.size;
+        activeClonesCountEl.textContent = String(totalSessions);
+      }
+
+      async function checkModelAvailability() {
+        if (!('LanguageModel' in self)) {
+          modelStatusEl.textContent = 'Built-in AI (LanguageModel API) is not supported in this browser. Using fallback mode.';
+          return 'unavailable';
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (availability === 'available') {
+            modelStatusEl.textContent = 'Built-in AI model is ready on-device.';
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            modelStatusEl.textContent = `Built-in AI model is ${availability}. Click an action button to download and start.`;
+          } else {
+            modelStatusEl.textContent = 'Built-in AI model is unavailable on this device.';
+          }
+          return availability;
+        } catch (err) {
+          modelStatusEl.textContent = 'Unable to verify AI model availability.';
+          return 'unavailable';
+        }
+      }
+
+      async function ensureBaseSession() {
+        if (baseSession) {
+          return baseSession;
+        }
+        if (baseSessionPromise) {
+          return baseSessionPromise;
+        }
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || !('LanguageModel' in self)) {
+          throw new Error('Built-in LanguageModel API is unavailable on this device.');
+        }
+
+        baseSessionPromise = (async () => {
+          try {
+            const session = await LanguageModel.create({
+              initialPrompts: [{ role: 'system', content: SYSTEM_PROMPT }],
+              expectedInputs: [{ type: 'text' }],
+              expectedOutputs: [{ type: 'text' }],
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  downloadProgressEl.hidden = false;
+                  const loaded = typeof e.loaded === 'number' ? e.loaded : 0;
+                  downloadProgressEl.value = loaded;
+                  modelStatusEl.textContent = `Downloading AI model (${Math.round(loaded * 100)}%)...`;
+                });
+              }
+            });
+            downloadProgressEl.hidden = true;
+            modelStatusEl.textContent = 'Model downloaded and base session ready.';
+            baseSession = session;
+            updateContextMetrics(baseSession);
+            return session;
+          } finally {
+            baseSessionPromise = null;
+          }
+        })();
+
+        return baseSessionPromise;
+      }
+
+      // Pre-warm the base session when the user interacts with or hovers over the AI workspace
+      // ONLY if the model is already 'available' (when 'downloadable', create() requires a user gesture).
+      async function prewarmIfAvailable() {
+        if (baseSession || baseSessionPromise || !('LanguageModel' in self)) {
+          return;
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (availability === 'available') {
+            await ensureBaseSession();
+          }
+        } catch {
+          // Ignore background pre-warm errors
+        }
+      }
+
+      workspaceEl.addEventListener('pointerenter', prewarmIfAvailable, { once: true });
+      workspaceEl.addEventListener('focusin', prewarmIfAvailable, { once: true });
+
+      // Initial availability check on load
+      checkModelAvailability();
+
+      // 1. Ask the Barista (Streaming response with availability check, AbortController, and session cleanup)
+      stopBaristaBtn.addEventListener('click', () => {
+        if (baristaAbortController) {
+          baristaAbortController.abort();
+        }
+        if (document.activeElement === stopBaristaBtn) {
+          askBaristaBtn.focus();
+        }
+      });
+
+      askBaristaBtn.addEventListener('click', async () => {
+        const rawQuestion = questionInput.value.trim();
+        if (!rawQuestion) {
+          baristaAnswerEl.textContent = 'Please enter a question about the Maple Oat Latte or Cold Brew.';
+          return;
+        }
+
+        // Normalize input for sessionStorage cache lookup
+        const cacheKey = `barista_cache_${rawQuestion.toLowerCase()}`;
+        const cached = sessionStorage.getItem(cacheKey);
+        if (cached) {
+          baristaAnswerEl.textContent = cached;
+          return;
+        }
+
+        baristaAnswerEl.textContent = '';
+        baristaAnswerEl.setAttribute('aria-busy', 'true');
+        askBaristaBtn.disabled = true;
+        stopBaristaBtn.hidden = false;
+        baristaAbortController = new AbortController();
+
+        let taskSession = null;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            baristaAnswerEl.textContent =
+              'Local AI is unavailable in this environment. Fallback Barista Note: Our Maple Oat Latte pairs velvety oat milk with real Vermont maple syrup, while our Cold Brew is slow-steeped for 18 hours for ultra-smooth flavor.';
+            return;
+          }
+
+          const rootSession = await ensureBaseSession();
+          taskSession = await rootSession.clone();
+          activeClones.add(taskSession);
+          updateContextMetrics(taskSession);
+
+          const stream = taskSession.promptStreaming(
+            `Answer the customer's question about our Maple Oat Latte or Cold Brew: ${rawQuestion}`,
+            { signal: baristaAbortController.signal }
+          );
+
+          let completeResult = '';
+          for await (const chunk of stream) {
+            completeResult += chunk;
+            baristaAnswerEl.append(chunk);
+            updateContextMetrics(taskSession);
+          }
+
+          if (completeResult) {
+            sessionStorage.setItem(cacheKey, completeResult);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            baristaAnswerEl.append(' [Generation stopped by user]');
+          } else {
+            baristaAnswerEl.textContent = `Could not generate barista response: ${err.message || 'Unknown error'}`;
+          }
+        } finally {
+          if (taskSession) {
+            taskSession.destroy();
+            activeClones.delete(taskSession);
+          }
+          updateContextMetrics(baseSession);
+          baristaAnswerEl.setAttribute('aria-busy', 'false');
+          if (document.activeElement === stopBaristaBtn) {
+            askBaristaBtn.focus();
+          }
+          stopBaristaBtn.hidden = true;
+          askBaristaBtn.disabled = false;
+          baristaAbortController = null;
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output via responseConstraint with score and category)
+      sentimentBtn.addEventListener('click', async () => {
+        const feedbackText = feedbackInput.value.trim();
+        if (!feedbackText) {
+          sentimentOutputEl.textContent = 'Please enter customer feedback to analyze.';
+          return;
+        }
+
+        sentimentOutputEl.setAttribute('aria-busy', 'true');
+        sentimentBtn.disabled = true;
+
+        let sentimentSession = null;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            const fallbackResult = { score: 5, category: 'positive' };
+            sentimentOutputEl.textContent = JSON.stringify(fallbackResult, null, 2);
+            return;
+          }
+
+          const rootSession = await ensureBaseSession();
+          sentimentSession = await rootSession.clone();
+          activeClones.add(sentimentSession);
+          updateContextMetrics(sentimentSession);
+
+          const rawJson = await sentimentSession.prompt(
+            `Analyze the sentiment of this coffee shop customer feedback: "${feedbackText}"`,
+            { responseConstraint: SENTIMENT_SCHEMA }
+          );
+
+          const parsed = JSON.parse(rawJson);
+          sentimentOutputEl.textContent = JSON.stringify(parsed, null, 2);
+        } catch (err) {
+          sentimentOutputEl.textContent = `Error analyzing feedback: ${err.message || 'Failed to parse structured JSON.'}`;
+        } finally {
+          if (sentimentSession) {
+            sentimentSession.destroy();
+            activeClones.delete(sentimentSession);
+          }
+          updateContextMetrics(baseSession);
+          sentimentOutputEl.setAttribute('aria-busy', 'false');
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // 3. Conversation Branching & Session Management (Clone active session, track contextUsage / contextWindow, destroy unneeded sessions)
+      cloneBtn.addEventListener('click', async () => {
+        const promptText = branchPromptInput.value.trim() || 'Recommend a pairing for the Maple Oat Latte or Cold Brew.';
+        cloneOutputEl.setAttribute('aria-busy', 'true');
+        cloneBtn.disabled = true;
+
+        let clonedBranch = null;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            cloneOutputEl.textContent =
+              'Local AI is unavailable on this device. Unable to clone an active LanguageModel session.';
+            return;
+          }
+
+          const rootSession = await ensureBaseSession();
+          clonedBranch = await rootSession.clone();
+          activeClones.add(clonedBranch);
+          updateContextMetrics(clonedBranch);
+
+          const reply = await clonedBranch.prompt(promptText);
+          const usedTokens = typeof clonedBranch.contextUsage === 'number' ? clonedBranch.contextUsage : 0;
+          const totalWindow = typeof clonedBranch.contextWindow === 'number' ? clonedBranch.contextWindow : 0;
+          updateContextMetrics(clonedBranch);
+
+          cloneOutputEl.textContent =
+            `[Cloned Branch Output (Context: ${usedTokens}/${totalWindow} tokens)]:\n${reply}`;
+        } catch (err) {
+          cloneOutputEl.textContent = `Branch execution failed: ${err.message || 'Unknown error'}`;
+        } finally {
+          // Immediately destroy the cloned branch once its task finishes to free memory
+          if (clonedBranch) {
+            clonedBranch.destroy();
+            activeClones.delete(clonedBranch);
+          }
+          updateContextMetrics(baseSession);
+          cloneOutputEl.setAttribute('aria-busy', 'false');
+          cloneBtn.disabled = false;
+        }
+      });
+
+      function destroyAllSessions() {
+        for (const clone of activeClones) {
+          try {
+            clone.destroy();
+          } catch {
+            // Ignore cleanup errors
+          }
+        }
+        activeClones.clear();
+
+        if (baseSession) {
+          try {
+            baseSession.destroy();
+          } catch {
+            // Ignore cleanup errors
+          }
+          baseSession = null;
+        }
+        updateContextMetrics(null);
+      }
+
+      cleanupBtn.addEventListener('click', () => {
+        destroyAllSessions();
+        cloneOutputEl.textContent = 'All active and baseline AI sessions have been destroyed to free device memory.';
+        modelStatusEl.textContent = 'Sessions cleaned up. Click an action button to initialize a new session.';
+      });
+
+      window.addEventListener('pagehide', destroyAllSessions);
+    })();
+  </script>
