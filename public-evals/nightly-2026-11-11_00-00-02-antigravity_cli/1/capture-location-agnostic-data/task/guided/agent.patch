+  <script type="module">
+    const STORAGE_KEYS = {
+      pickupTime: 'dailyGrind.pickupPlainTime',
+      anniversaryDate: 'dailyGrind.anniversaryPlainDate',
+    };
+
+    function initializeApp() {
+      const form = document.getElementById('preferences-form');
+      const pickupInput = document.getElementById('pickup-time');
+      const anniversaryInput = document.getElementById('anniversary-date');
+      const pickupError = document.getElementById('pickup-time-error');
+      const anniversaryError = document.getElementById('anniversary-date-error');
+      const statusBanner = document.getElementById('preferences-status');
+
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const displayPickupMeta = document.getElementById('display-pickup-meta');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const displayAnniversaryMeta = document.getElementById('display-anniversary-meta');
+      const displayCombinedSchedule = document.getElementById('display-combined-schedule');
+      const displayCombinedMeta = document.getElementById('display-combined-meta');
+
+      const savedTimeStr = localStorage.getItem(STORAGE_KEYS.pickupTime);
+      const savedDateStr = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+      if (savedTimeStr) {
+        pickupInput.value = savedTimeStr;
+      }
+      if (savedDateStr) {
+        anniversaryInput.value = savedDateStr;
+      }
+
+      const editedFields = new Set();
+
+      function clearFieldError(input, errorEl) {
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+      }
+
+      function validatePickupField() {
+        const raw = pickupInput.value.trim();
+        if (!raw) {
+          const message = 'Please select a daily pickup reminder time (e.g., 08:00).';
+          pickupInput.setCustomValidity(message);
+          pickupInput.setAttribute('aria-invalid', 'true');
+          pickupError.textContent = message;
+          pickupError.hidden = false;
+          return null;
+        }
+        try {
+          const plainTime = Temporal.PlainTime.from(raw);
+          clearFieldError(pickupInput, pickupError);
+          return plainTime;
+        } catch {
+          const message = 'Please enter a valid wall-clock time in HH:MM format.';
+          pickupInput.setCustomValidity(message);
+          pickupInput.setAttribute('aria-invalid', 'true');
+          pickupError.textContent = message;
+          pickupError.hidden = false;
+          return null;
+        }
+      }
+
+      function validateAnniversaryField() {
+        const raw = anniversaryInput.value.trim();
+        if (!raw) {
+          const message = 'Please select your coffee anniversary calendar date.';
+          anniversaryInput.setCustomValidity(message);
+          anniversaryInput.setAttribute('aria-invalid', 'true');
+          anniversaryError.textContent = message;
+          anniversaryError.hidden = false;
+          return null;
+        }
+        try {
+          const plainDate = Temporal.PlainDate.from(raw);
+          clearFieldError(anniversaryInput, anniversaryError);
+          return plainDate;
+        } catch {
+          const message = 'Please enter a valid calendar date (YYYY-MM-DD).';
+          anniversaryInput.setCustomValidity(message);
+          anniversaryInput.setAttribute('aria-invalid', 'true');
+          anniversaryError.textContent = message;
+          anniversaryError.hidden = false;
+          return null;
+        }
+      }
+
+      function renderSchedule(reminderTime, anniversaryDate) {
+        const canonicalTime = reminderTime.toString({ smallestUnit: 'minute' });
+        const canonicalDate = anniversaryDate.toString();
+
+        // Read calendar and wall-clock fields directly from the Temporal Plain types
+        const { year, month, day } = anniversaryDate;
+        const { hour, minute } = reminderTime;
+        const paddedHour = String(hour).padStart(2, '0');
+        const paddedMinute = String(minute).padStart(2, '0');
+
+        // Model the annual recurring anniversary without a year using Temporal.PlainMonthDay
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+
+        // Convert PlainMonthDay to a PlainDate with an explicit year before comparing or adding years
+        let nextOccurrenceDate = annualAnniversary.toPlainDate({ year: today.year });
+        if (Temporal.PlainDate.compare(nextOccurrenceDate, today) < 0) {
+          nextOccurrenceDate = nextOccurrenceDate.add({ years: 1 }, { overflow: 'constrain' });
+        }
+
+        // Combine PlainDate and PlainTime into a location-agnostic PlainDateTime without string interpolation
+        const nextCelebrationSchedule = nextOccurrenceDate.toPlainDateTime(reminderTime);
+
+        displayPickupTime.textContent = `${reminderTime.toLocaleString([], { hour: '2-digit', minute: '2-digit' })} (${canonicalTime})`;
+        displayPickupMeta.textContent = `Fixed wall-clock time (${paddedHour}:${paddedMinute}) — unaffected by time zone or DST changes.`;
+
+        displayAnniversaryDate.textContent = `${anniversaryDate.toLocaleString(undefined, { dateStyle: 'long' })} (${canonicalDate})`;
+        displayAnniversaryMeta.textContent = isAnniversaryToday
+          ? `Happy Coffee Anniversary! Joined ${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')} (${annualAnniversary.toString()}).`
+          : `Recurring annual milestone: ${annualAnniversary.toLocaleString(undefined, { month: 'long', day: 'numeric' })} (${annualAnniversary.toString()}).`;
+
+        displayCombinedSchedule.textContent = nextCelebrationSchedule.toString();
+        displayCombinedMeta.textContent = `Next celebration pickup: ${nextCelebrationSchedule.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })} (location-agnostic).`;
+      }
+
+      pickupInput.addEventListener('input', () => {
+        editedFields.add(pickupInput);
+        clearFieldError(pickupInput, pickupError);
+      });
+
+      anniversaryInput.addEventListener('input', () => {
+        editedFields.add(anniversaryInput);
+        clearFieldError(anniversaryInput, anniversaryError);
+      });
+
+      pickupInput.addEventListener('blur', () => {
+        if (editedFields.has(pickupInput)) {
+          validatePickupField();
+        }
+      });
+
+      anniversaryInput.addEventListener('blur', () => {
+        if (editedFields.has(anniversaryInput)) {
+          validateAnniversaryField();
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const reminderTime = validatePickupField();
+        const anniversaryDate = validateAnniversaryField();
+
+        if (!reminderTime) {
+          pickupInput.focus();
+          return;
+        }
+        if (!anniversaryDate) {
+          anniversaryInput.focus();
+          return;
+        }
+
+        const canonicalTime = reminderTime.toString({ smallestUnit: 'minute' });
+        const canonicalDate = anniversaryDate.toString();
+        pickupInput.value = canonicalTime;
+        anniversaryInput.value = canonicalDate;
+
+        localStorage.setItem(STORAGE_KEYS.pickupTime, canonicalTime);
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, canonicalDate);
+
+        renderSchedule(reminderTime, anniversaryDate);
+        statusBanner.textContent = `Saved! Reminder set for ${canonicalTime} and anniversary locked to ${canonicalDate} across all time zones.`;
+      });
+
+      const initialTime = validatePickupField();
+      const initialDate = validateAnniversaryField();
+      if (initialTime && initialDate) {
+        renderSchedule(initialTime, initialDate);
+      }
+    }
+
+    // Check if Temporal is supported natively
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        // Load the polyfill conditionally
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        // Extend Date.prototype if needed
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
+
 </body>
 
