+  <script>
+    (function () {
+      const STORAGE_KEYS = {
+        pickupTime: 'dailyGrind_pickupReminderTime',
+        anniversaryDate: 'dailyGrind_coffeeAnniversaryDate'
+      };
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeValueEl = document.getElementById('pickup-time-value');
+      const dateValueEl = document.getElementById('anniversary-date-value');
+      const form = document.getElementById('coffee-preferences-form');
+      const statusEl = document.getElementById('preferences-status');
+
+      /**
+       * Parses a plain time string (HH:MM) directly as wall-clock components
+       * without using Date objects or UTC/timezone conversions.
+       */
+      function parsePlainTime(timeStr) {
+        if (!timeStr || typeof timeStr !== 'string') return null;
+        const match = /^(\d{2}):(\d{2})(?::\d{2})?$/.exec(timeStr.trim());
+        if (!match) return null;
+        const hour = Number(match[1]);
+        const minute = Number(match[2]);
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return null;
+        return {
+          raw: `${match[1]}:${match[2]}`,
+          hour,
+          minute
+        };
+      }
+
+      /**
+       * Formats a plain time string (HH:MM) into a location-agnostic representation.
+       */
+      function formatPlainTime(timeStr) {
+        const parsed = parsePlainTime(timeStr);
+        if (!parsed) return 'Not set';
+        const period = parsed.hour >= 12 ? 'PM' : 'AM';
+        const hour12 = parsed.hour % 12 === 0 ? 12 : parsed.hour % 12;
+        const paddedMinute = String(parsed.minute).padStart(2, '0');
+        return `${hour12}:${paddedMinute} ${period} (${parsed.raw})`;
+      }
+
+      /**
+       * Parses a plain calendar date string (YYYY-MM-DD) directly as year, month, and day
+       * components without instantiating Date or applying UTC/local timezone offsets.
+       */
+      function parsePlainDate(dateStr) {
+        if (!dateStr || typeof dateStr !== 'string') return null;
+        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr.trim());
+        if (!match) return null;
+        const year = Number(match[1]);
+        const month = Number(match[2]);
+        const day = Number(match[3]);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return null;
+        return {
+          raw: match[0],
+          year,
+          month,
+          day
+        };
+      }
+
+      /**
+       * Formats a plain calendar date string (YYYY-MM-DD) into a human-readable string
+       * purely from its literal calendar components, preventing any timezone shift.
+       */
+      function formatPlainDate(dateStr) {
+        const parsed = parsePlainDate(dateStr);
+        if (!parsed) return 'Not set';
+        const monthName = MONTH_NAMES[parsed.month - 1];
+        return `${monthName} ${parsed.day}, ${parsed.year} (${parsed.raw})`;
+      }
+
+      function safeGetStorage(key) {
+        try {
+          return window.localStorage.getItem(key) || '';
+        } catch (_) {
+          return '';
+        }
+      }
+
+      function safeSetStorage(key, value) {
+        try {
+          if (value) {
+            window.localStorage.setItem(key, value);
+          } else {
+            window.localStorage.removeItem(key);
+          }
+        } catch (_) {
+          // Ignore storage errors in restricted environments
+        }
+      }
+
+      function renderTime(rawTime) {
+        const parsed = parsePlainTime(rawTime);
+        const normalized = parsed ? parsed.raw : '';
+        if (timeInput.value !== normalized) {
+          timeInput.value = normalized;
+        }
+        timeValueEl.textContent = formatPlainTime(normalized);
+        timeValueEl.setAttribute('data-raw-value', normalized);
+      }
+
+      function renderDate(rawDate) {
+        const parsed = parsePlainDate(rawDate);
+        const normalized = parsed ? parsed.raw : '';
+        if (dateInput.value !== normalized) {
+          dateInput.value = normalized;
+        }
+        dateValueEl.textContent = formatPlainDate(normalized);
+        dateValueEl.setAttribute('data-raw-value', normalized);
+      }
+
+      function persistAndRender(showConfirmation) {
+        const parsedTime = parsePlainTime(timeInput.value);
+        const parsedDate = parsePlainDate(dateInput.value);
+
+        const rawTime = parsedTime ? parsedTime.raw : '';
+        const rawDate = parsedDate ? parsedDate.raw : '';
+
+        safeSetStorage(STORAGE_KEYS.pickupTime, rawTime);
+        safeSetStorage(STORAGE_KEYS.anniversaryDate, rawDate);
+
+        renderTime(rawTime);
+        renderDate(rawDate);
+
+        if (showConfirmation) {
+          statusEl.textContent = 'Preferences saved as location-agnostic values (immune to time zone shifts).';
+        }
+      }
+
+      // Initialize from stored plain string values on load
+      const initialTime = safeGetStorage(STORAGE_KEYS.pickupTime) || timeInput.value;
+      const initialDate = safeGetStorage(STORAGE_KEYS.anniversaryDate) || dateInput.value;
+      renderTime(initialTime);
+      renderDate(initialDate);
+
+      timeInput.addEventListener('input', function () {
+        persistAndRender(false);
+      });
+      timeInput.addEventListener('change', function () {
+        persistAndRender(false);
+      });
+
+      dateInput.addEventListener('input', function () {
+        persistAndRender(false);
+      });
+      dateInput.addEventListener('change', function () {
+        persistAndRender(false);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        persistAndRender(true);
+      });
+    })();
+  </script>
