+  <script>
+    const observer = new ResizeObserver(entries => {
+      for (const { target } of entries) {
+        const scrollWidth = target.scrollWidth - target.clientWidth;
+        const isTruncated = scrollWidth > 0;
+        target.classList.toggle('truncated', isTruncated);
+        if (isTruncated) {
+          target.style.setProperty('--scroll-width', String(scrollWidth));
+        } else {
+          target.style.removeProperty('--scroll-width');
+        }
+      }
+    });
+
+    for (const label of document.querySelectorAll('nav a')) {
+      observer.observe(label);
+    }
+  </script>
