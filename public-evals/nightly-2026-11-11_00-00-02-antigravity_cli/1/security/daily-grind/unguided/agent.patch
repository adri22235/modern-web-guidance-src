+(function () {
+  'use strict';
+
+  // 1. Register a default Trusted Types policy to guard DOM XSS sinks when supported
+  if (window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+    try {
+      if (!window.trustedTypes.defaultPolicy) {
+        window.trustedTypes.createPolicy('default', {
+          createHTML: function (input) {
+            return String(input)
+              .replace(/&/g, '&amp;')
+              .replace(/</g, '&lt;')
+              .replace(/>/g, '&gt;')
+              .replace(/"/g, '&quot;')
+              .replace(/'/g, '&#39;');
+          },
+          createScriptURL: function (input) {
+            const url = new URL(String(input), window.location.origin);
+            if (url.origin !== window.location.origin) {
+              throw new TypeError('Blocked cross-origin script URL: ' + url.href);
+            }
+            return url.href;
+          },
+          createScript: function () {
+            throw new TypeError('Dynamic script evaluation is blocked by security policy.');
+          }
+        });
+      }
+    } catch (_) {
+      // Policy already registered or disallowed by browser configuration
+    }
+  }
+
+  // 2. Monitor and report Content Security Policy violations for safe policy deployment
+  document.addEventListener('securitypolicyviolation', function (event) {
+    const payload = JSON.stringify({
+      blockedURI: event.blockedURI,
+      violatedDirective: event.violatedDirective,
+      effectiveDirective: event.effectiveDirective,
+      originalPolicy: event.originalPolicy,
+      sourceFile: event.sourceFile,
+      lineNumber: event.lineNumber,
+      columnNumber: event.columnNumber,
+      disposition: event.disposition,
+      timestamp: new Date().toISOString()
+    });
+
+    if (navigator.sendBeacon) {
+      const blob = new Blob([payload], { type: 'application/csp-report' });
+      navigator.sendBeacon('/csp-report', blob);
+    } else if (typeof window.fetch === 'function') {
+      window.fetch('/csp-report', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/csp-report' },
+        body: payload,
+        keepalive: true,
+        credentials: 'same-origin'
+      }).catch(function () {});
+    }
+  });
+
+  // 3. Preventative DOM link and attribute auditing
+  const DANGEROUS_PROTOCOL_RE = /^\s*(javascript|vbscript|data):/i;
+
+  function hardenElement(root) {
+    if (!root || typeof root.querySelectorAll !== 'function') return;
+
+    const links = root.querySelectorAll('a[href]');
+    links.forEach(function (anchor) {
+      const rawHref = anchor.getAttribute('href') || '';
+      if (DANGEROUS_PROTOCOL_RE.test(rawHref)) {
+        anchor.setAttribute('href', '#');
+        return;
+      }
+
+      try {
+        const resolved = new URL(rawHref, window.location.origin);
+        if (resolved.origin !== window.location.origin || anchor.getAttribute('target') === '_blank') {
+          const existingRel = (anchor.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+          if (!existingRel.includes('noopener')) existingRel.push('noopener');
+          if (!existingRel.includes('noreferrer')) existingRel.push('noreferrer');
+          anchor.setAttribute('rel', existingRel.join(' '));
+        }
+
+        if (resolved.pathname === '/logout' || resolved.pathname === '/logout/') {
+          const existingRel = (anchor.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+          if (!existingRel.includes('nofollow')) existingRel.push('nofollow');
+          anchor.setAttribute('rel', existingRel.join(' '));
+          anchor.setAttribute('data-no-prefetch', 'true');
+        }
+      } catch (_) {
+        anchor.setAttribute('href', '#');
+      }
+    });
+  }
+
+  // 4. Safe client-side logout handling (clears client storage and issues explicit POST)
+  function clearClientSessionData() {
+    try {
+      window.localStorage.clear();
+    } catch (_) {}
+    try {
+      window.sessionStorage.clear();
+    } catch (_) {}
+  }
+
+  function setupLogoutHandler() {
+    const logoutLinks = document.querySelectorAll('a.logout-link, a[href="/logout"]');
+    logoutLinks.forEach(function (link) {
+      link.addEventListener('click', function (event) {
+        if (!event.isTrusted) {
+          event.preventDefault();
+          return;
+        }
+        event.preventDefault();
+        clearClientSessionData();
+
+        window.fetch('/logout', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: {
+            'X-Requested-With': 'XMLHttpRequest'
+          }
+        })
+          .then(function () {
+            window.location.assign('/logout');
+          })
+          .catch(function () {
+            window.location.assign('/logout');
+          });
+      });
+    });
+  }
+
+  function initSecurityMeasures() {
+    hardenElement(document);
+    setupLogoutHandler();
+
+    if (typeof MutationObserver === 'function' && document.body) {
+      const observer = new MutationObserver(function (mutations) {
+        mutations.forEach(function (mutation) {
+          mutation.addedNodes.forEach(function (node) {
+            if (node && node.nodeType === Node.ELEMENT_NODE) {
+              hardenElement(node);
+            }
+          });
+        });
+      });
+      observer.observe(document.body, { childList: true, subtree: true });
+    }
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initSecurityMeasures);
+  } else {
+    initSecurityMeasures();
+  }
+})();
