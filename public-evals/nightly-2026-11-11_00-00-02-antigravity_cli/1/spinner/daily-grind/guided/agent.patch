+  <script>
+    const DRINK_DETAILS = {
+      seasonal: {
+        title: 'Maple Oat Latte',
+        roast: 'Medium Espresso Roast',
+        notes: 'Grade-A Vermont maple, toasted oat, warm cinnamon finish',
+        size: '12 oz / 16 oz',
+        price: '$5.75'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        roast: 'Full City+ Dark Roast',
+        notes: 'Dark cacao, roasted walnut, rich crema',
+        size: 'Double Shot (2 oz)',
+        price: '$3.50'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        roast: 'Single-Origin Colombian',
+        notes: 'Smooth molasses, sweet citrus, zero bitterness',
+        size: '16 oz / 20 oz',
+        price: '$4.75'
+      }
+    };
+
+    const orderNowBtn = document.getElementById('order-now-btn');
+    const orderStatus = document.getElementById('order-status');
+
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (orderNowBtn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const spinner = orderNowBtn.querySelector('progress.loading-spinner');
+        const label = orderNowBtn.querySelector('.btn-label');
+
+        orderNowBtn.setAttribute('aria-busy', 'true');
+        orderNowBtn.setAttribute('aria-disabled', 'true');
+        if (spinner) {
+          spinner.hidden = false;
+        }
+        if (label) {
+          label.textContent = 'Starting Order…';
+        }
+        if (orderStatus) {
+          orderStatus.hidden = true;
+          orderStatus.textContent = '';
+        }
+
+        window.setTimeout(() => {
+          orderNowBtn.setAttribute('aria-busy', 'false');
+          orderNowBtn.removeAttribute('aria-disabled');
+          if (spinner) {
+            spinner.hidden = true;
+          }
+          if (label) {
+            label.textContent = 'Order Now';
+          }
+          if (orderStatus) {
+            orderStatus.textContent = 'Your order session is ready. Select your favorite drinks below!';
+            orderStatus.hidden = false;
+          }
+        }, 1200);
+      });
+    }
+
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const detailButtons = document.querySelectorAll('[data-action="view-details"]');
+
+    detailButtons.forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (btn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const card = btn.closest('.card');
+        const drinkId = btn.getAttribute('data-drink-id');
+        const details = DRINK_DETAILS[drinkId];
+        const btnSpinner = btn.querySelector('progress.loading-spinner');
+        const cardLoading = card ? card.querySelector('.drink-details-loading') : null;
+        const detailsPanel = card ? card.querySelector('.drink-details-panel') : null;
+
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        if (card) {
+          card.setAttribute('aria-busy', 'true');
+        }
+        if (seasonalSection) {
+          seasonalSection.setAttribute('aria-busy', 'true');
+        }
+        if (btnSpinner) {
+          btnSpinner.hidden = false;
+        }
+        if (cardLoading) {
+          cardLoading.hidden = false;
+        }
+        if (detailsPanel) {
+          detailsPanel.hidden = true;
+        }
+
+        window.setTimeout(() => {
+          btn.setAttribute('aria-busy', 'false');
+          btn.removeAttribute('aria-disabled');
+          if (card) {
+            card.setAttribute('aria-busy', 'false');
+          }
+          if (seasonalSection && !seasonalSection.querySelector('.card[aria-busy="true"]')) {
+            seasonalSection.setAttribute('aria-busy', 'false');
+          }
+          if (btnSpinner) {
+            btnSpinner.hidden = true;
+          }
+          if (cardLoading) {
+            cardLoading.hidden = true;
+          }
+          if (detailsPanel && details) {
+            detailsPanel.replaceChildren();
+            const list = document.createElement('dl');
+            const items = [
+              ['Roast', details.roast],
+              ['Tasting Notes', details.notes],
+              ['Serving Size', details.size],
+              ['Price', details.price]
+            ];
+            for (const [term, desc] of items) {
+              const dt = document.createElement('dt');
+              dt.style.fontWeight = 'bold';
+              dt.textContent = term;
+              const dd = document.createElement('dd');
+              dd.style.marginBottom = '6px';
+              dd.textContent = desc;
+              list.append(dt, dd);
+            }
+            detailsPanel.append(list);
+            detailsPanel.hidden = false;
+          }
+        }, 1200);
+      });
+    });
+  </script>
+
 </body>
 
