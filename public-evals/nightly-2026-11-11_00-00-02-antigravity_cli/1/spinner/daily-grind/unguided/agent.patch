+  <script>
+    (function () {
+      const orderBtn = document.getElementById('order-now-btn');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalStatus = document.getElementById('seasonal-status');
+      const seasonalStatusText = seasonalStatus ? seasonalStatus.querySelector('.seasonal-status-text') : null;
+      const detailBtns = document.querySelectorAll('#seasonal-favorites .btn');
+
+      function setButtonBusy(btn, visibleText, srAnnouncement) {
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('disabled', '');
+        btn.setAttribute('data-loading', 'true');
+        btn.classList.add('is-loading', 'loading');
+
+        const btnText = btn.querySelector('.btn-text');
+        if (btnText && visibleText) {
+          btnText.textContent = visibleText;
+        }
+
+        const statusText = btn.querySelector('.status-text');
+        if (statusText && srAnnouncement) {
+          statusText.textContent = srAnnouncement;
+        }
+      }
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (event) {
+          event.preventDefault();
+          if (orderBtn.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+          setButtonBusy(
+            orderBtn,
+            'Starting order...',
+            'Order Now: Starting order, please wait...'
+          );
+        });
+      }
+
+      detailBtns.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          if (btn.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+
+          const card = btn.closest('.card');
+          const drinkName = btn.getAttribute('data-drink') ||
+            (card && card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : 'drink');
+
+          setButtonBusy(
+            btn,
+            'Loading details...',
+            'View Details: Loading ' + drinkName + ' details, please wait...'
+          );
+
+          if (card) {
+            card.setAttribute('aria-busy', 'true');
+            card.classList.add('is-loading', 'loading');
+          }
+
+          if (seasonalSection) {
+            seasonalSection.setAttribute('aria-busy', 'true');
+            seasonalSection.setAttribute('data-card-loading', 'true');
+            seasonalSection.classList.add('is-loading', 'loading');
+          }
+
+          if (seasonalStatus) {
+            seasonalStatus.setAttribute('aria-busy', 'true');
+            seasonalStatus.classList.add('is-loading', 'loading');
+            if (seasonalStatusText) {
+              seasonalStatusText.textContent = 'Loading ' + drinkName + ' details...';
+            }
+          }
+        });
+      });
+    })();
+  </script>
