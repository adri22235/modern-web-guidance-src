+          return await response.json();
+        }
+      } catch {
+        // Fallback options for static preview when no backend server is active
+      }
+      return {
+        challenge: generateBase64UrlChallenge(),
+        rpId: window.location.hostname || 'localhost',
+        userVerification: 'preferred',
