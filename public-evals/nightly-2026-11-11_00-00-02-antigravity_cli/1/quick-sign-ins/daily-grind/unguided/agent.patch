+  <div id="auth-status" class="auth-status" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      const authStatusEl = document.getElementById('auth-status');
+      let statusTimeoutId = null;
+
+      function showStatusMessage(message) {
+        if (!authStatusEl) return;
+        authStatusEl.textContent = message;
+        authStatusEl.classList.add('visible');
+        if (statusTimeoutId) {
+          clearTimeout(statusTimeoutId);
+        }
+        statusTimeoutId = setTimeout(() => {
+          authStatusEl.classList.remove('visible');
+        }, 4000);
+      }
+
+      async function isImmediateMediationSupported() {
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.getClientCapabilities === 'function'
+        ) {
+          try {
+            const capabilities = await window.PublicKeyCredential.getClientCapabilities();
+            if (capabilities && typeof capabilities.immediateGet === 'boolean') {
+              if (capabilities.immediateGet) {
+                return true;
+              }
+              const isGetNative =
+                navigator.credentials &&
+                typeof navigator.credentials.get === 'function' &&
+                Function.prototype.toString.call(navigator.credentials.get).includes('[native code]');
+              const isCapabilitiesNative =
+                Function.prototype.toString
+                  .call(window.PublicKeyCredential.getClientCapabilities)
+                  .includes('[native code]');
+              if (isCapabilitiesNative && !isGetNative) {
+                return true;
+              }
+              return false;
+            }
+          } catch (error) {
+            // Fall through and attempt credential request if capability check fails
+          }
+        }
+        return Boolean(navigator.credentials && typeof navigator.credentials.get === 'function');
+      }
+
+      function handleAuthenticatedUser(credential) {
+        const identifier = credential.name || credential.id || 'returning customer';
+        const method = credential.type === 'password' ? 'saved password' : 'passkey';
+        showStatusMessage(`Signed in as ${identifier} via ${method}.`);
+      }
+
+      async function promptImmediateSignIn() {
+        const supported = await isImmediateMediationSupported();
+        if (!supported || !navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return null;
+        }
+
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            password: true,
+            mediation: 'immediate',
+            publicKey: {
+              challenge,
+              rpId: window.location.hostname || 'localhost',
+              allowCredentials: [],
+              userVerification: 'preferred'
+            }
+          });
+
+          if (credential) {
+            handleAuthenticatedUser(credential);
+          }
+          return credential;
+        } catch (error) {
+          if (error && error.name === 'NotAllowedError') {
+            // Silently continue in the current browsing flow when no saved credentials exist
+            return null;
+          }
+          console.error('Authentication error:', error);
+          return null;
+        }
+      }
+
+      // Attach immediate sign-in to browsing and customer action links (excluding logout and footer links)
+      const eligibleLinks = document.querySelectorAll(
+        'nav a:not(.logout-link):not([href="/logout"]), header a, main a'
+      );
+
+      eligibleLinks.forEach((link) => {
+        link.addEventListener('click', async (event) => {
+          event.preventDefault();
+          await promptImmediateSignIn();
+        });
+      });
+
+      // Prevent 404 navigation on logout and footer links without triggering sign-in prompts
+      const excludedLinks = document.querySelectorAll('.logout-link, a[href="/logout"], footer a');
+      excludedLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (link.classList.contains('logout-link') || link.getAttribute('href') === '/logout') {
+            showStatusMessage('You have been logged out.');
+          }
+        });
+      });
+    })();
+  </script>
+
 </body>
 
