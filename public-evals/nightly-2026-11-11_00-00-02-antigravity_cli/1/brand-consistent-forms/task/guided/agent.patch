+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const progressEl = document.getElementById('setup-progress');
+      const progressStatus = document.getElementById('progress-status');
+      const feedbackEl = document.getElementById('subscription-feedback');
+
+      const roastLabels = {
+        1: 'Light Roast (1 / 5)',
+        2: 'Medium-Light Roast (2 / 5)',
+        3: 'Medium Roast (3 / 5)',
+        4: 'Medium-Dark Roast (4 / 5)',
+        5: 'Dark Roast (5 / 5)'
+      };
+
+      let roastInteracted = false;
+
+      function updateSliderProgress() {
+        const min = Number(roastSlider.min) || 1;
+        const max = Number(roastSlider.max) || 5;
+        const val = Number(roastSlider.value) || 3;
+        const pct = ((val - min) / (max - min)) * 100;
+        roastSlider.style.setProperty('--progress', `${pct}%`);
+        roastOutput.value = roastLabels[val] || `Level ${val}`;
+        roastOutput.textContent = roastLabels[val] || `Level ${val}`;
+      }
+
+      function updateCompletionProgress(isSubmitted) {
+        if (isSubmitted) {
+          progressEl.value = 100;
+          progressEl.textContent = '100%';
+          progressStatus.textContent = '100%';
+          return;
+        }
+        let completedSteps = 0;
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFreq) completedSteps += 1;
+        if (roastSlider.value) completedSteps += 1;
+        if (emailCheckbox.checked) completedSteps += 1;
+        if (roastInteracted) completedSteps += 1;
+
+        const pct = Math.round((completedSteps / 4) * 100);
+        progressEl.value = pct;
+        progressEl.textContent = `${pct}%`;
+        progressStatus.textContent = `${pct}%`;
+      }
+
+      roastSlider.addEventListener('input', () => {
+        roastInteracted = true;
+        updateSliderProgress();
+        updateCompletionProgress(false);
+      });
+
+      form.addEventListener('change', () => {
+        updateCompletionProgress(false);
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        roastInteracted = true;
+        updateCompletionProgress(true);
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        const freqLabel = selectedFreq ? selectedFreq.value : 'biweekly';
+        feedbackEl.textContent = `✓ Your personalized ${roastLabels[roastSlider.value]} subscription (${freqLabel} delivery) is ready!`;
+        feedbackEl.classList.add('visible');
+      });
+
+      updateSliderProgress();
+      updateCompletionProgress(false);
+    })();
+  </script>
 </body>
 
