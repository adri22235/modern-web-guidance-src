+  <script>
+    const roastInput = document.getElementById('roast-level');
+    const roastLabel = document.getElementById('roast-value-label');
+    const progressEl = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const form = document.getElementById('coffee-subscription-form');
+
+    const roastNames = {
+      1: 'Light (1/5)',
+      2: 'Medium-Light (2/5)',
+      3: 'Medium (3/5)',
+      4: 'Medium-Dark (4/5)',
+      5: 'Dark (5/5)'
+    };
+
+    if (roastInput && roastLabel) {
+      roastInput.addEventListener('input', () => {
+        roastLabel.textContent = roastNames[roastInput.value] || `${roastInput.value}/5`;
+      });
+    }
+
+    if (form && progressEl && progressText) {
+      const updateProgress = () => {
+        const hasFreq = !!form.querySelector('input[name="delivery_frequency"]:checked');
+        const hasRoast = !!roastInput.value;
+        const hasEmailChoice = document.getElementById('receive-emails').checked;
+        const completedSteps = (hasFreq ? 1 : 0) + (hasRoast ? 1 : 0) + (hasEmailChoice ? 1 : 0);
+        const pct = Math.min(100, Math.round((completedSteps / 3) * 100));
+        progressEl.value = pct;
+        progressEl.textContent = `${pct}%`;
+        progressText.textContent = `${pct}%`;
+      };
+
+      form.addEventListener('change', updateProgress);
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        progressEl.value = 100;
+        progressEl.textContent = '100%';
+        progressText.textContent = '100%';
+      });
+    }
+  </script>
+
