+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+      const nav = document.querySelector('nav');
+      const logo = document.querySelector('.logo');
+      const root = document.documentElement;
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const initialHeight = 90;
+      const finalHeight = 50;
+      const scrollDistance = 40;
+
+      const updateNavOnScroll = () => {
+        if (prefersReducedMotion.matches) {
+          nav.style.height = '';
+          nav.style.boxShadow = '';
+          root.style.scrollPaddingTop = '';
+          if (logo) logo.style.transform = '';
+          return;
+        }
+
+        const scrollY = window.scrollY;
+        const scrollPercent = Math.min(1, Math.max(0, scrollY / scrollDistance));
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = scrollPercent > 0 ? `0 2px 8px rgba(0, 0, 0, ${0.2 * scrollPercent})` : 'none';
+        root.style.scrollPaddingTop = `${newHeight}px`;
+
+        if (logo) {
+          const scale = 1 - 0.15 * scrollPercent;
+          logo.style.transform = `scale(${scale})`;
+        }
+      };
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      prefersReducedMotion.addEventListener('change', updateNavOnScroll);
+      updateNavOnScroll();
+    }
+  </script>
+
 </body>
 
