+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var logo = document.querySelector('.logo');
+      var navLinks = document.querySelectorAll('nav a');
+      var logoutBtn = document.querySelector('.logout-link');
+      if (!nav) return;
+
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline: scroll()');
+
+      // Fallback for older browsers that do not support CSS Scroll-Driven Animations
+      if (!supportsScrollTimeline) {
+        var maxScroll = 150;
+        var ticking = false;
+
+        function updateNavbar() {
+          var scrollY = window.scrollY !== undefined ? window.scrollY : (window.pageYOffset || document.documentElement.scrollTop || 0);
+          var progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
+
+          // Toggle class for basic CSS fallback & accessibility
+          if (scrollY > 30) {
+            nav.classList.add('scrolled');
+          } else {
+            nav.classList.remove('scrolled');
+          }
+
+          // Smoothly interpolate vertical space & styling linked directly to scroll position
+          var padY = 1.5 - progress * (1.5 - 0.5);
+          var bgAlpha = 1 - progress * (1 - 0.95);
+          var shadowBlur = 6 + progress * (12 - 6);
+          var shadowAlpha = 0.1 + progress * (0.25 - 0.1);
+
+          nav.style.transition = 'none';
+          nav.style.paddingTop = padY.toFixed(3) + 'rem';
+          nav.style.paddingBottom = padY.toFixed(3) + 'rem';
+          nav.style.backgroundColor = 'rgba(78, 52, 46, ' + bgAlpha.toFixed(3) + ')';
+          nav.style.boxShadow = '0 ' + (2 + progress * 2).toFixed(1) + 'px ' + shadowBlur.toFixed(1) + 'px rgba(0, 0, 0, ' + shadowAlpha.toFixed(3) + ')';
+
+          if (logo) {
+            var logoSize = 1.5 - progress * (1.5 - 1.15);
+            logo.style.transition = 'none';
+            logo.style.fontSize = logoSize.toFixed(3) + 'rem';
+          }
+
+          for (var i = 0; i < navLinks.length; i++) {
+            var linkSize = 0.9 - progress * (0.9 - 0.85);
+            navLinks[i].style.fontSize = linkSize.toFixed(3) + 'rem';
+          }
+
+          if (logoutBtn) {
+            var btnPadY = 5 - progress * (5 - 3);
+            var btnPadX = 12 - progress * (12 - 10);
+            logoutBtn.style.padding = btnPadY.toFixed(1) + 'px ' + btnPadX.toFixed(1) + 'px';
+          }
+
+          ticking = false;
+        }
+
+        function onScroll() {
+          if (!ticking) {
+            if (window.requestAnimationFrame) {
+              window.requestAnimationFrame(updateNavbar);
+              ticking = true;
+            } else {
+              updateNavbar();
+            }
+          }
+        }
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        updateNavbar();
+      }
+    })();
+  </script>
+
