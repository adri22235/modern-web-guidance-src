+  <script>
+    const brewLevels = [
+      {
+        name: 'Mild',
+        notes: 'Light, delicate body with bright citrus and floral undertones.'
+      },
+      {
+        name: 'Medium',
+        notes: 'Balanced body with smooth caramel and toasted hazelnut notes.'
+      },
+      {
+        name: 'Bold',
+        notes: 'Full-bodied roast with rich dark chocolate and warm spice notes.'
+      },
+      {
+        name: 'Extra Bold',
+        notes: 'Intense, smokey espresso-style depth with a lingering cocoa finish.'
+      }
+    ];
+
+    const slider = document.querySelector('#brew-strength');
+    const output = document.querySelector('#brew-strength-output');
+    const notes = document.querySelector('#brew-strength-notes');
+    const stepLabels = document.querySelectorAll('.brew-steps span[data-step]');
+
+    function syncSliderValue() {
+      const index = Number(slider.value);
+      const level = brewLevels[index] || brewLevels[1];
+
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 3);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', level.name);
+
+      output.textContent = level.name;
+      notes.textContent = level.notes;
+
+      stepLabels.forEach((span) => {
+        if (Number(span.dataset.step) === index) {
+          span.setAttribute('data-active', 'true');
+        } else {
+          span.removeAttribute('data-active');
+        }
+      });
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
