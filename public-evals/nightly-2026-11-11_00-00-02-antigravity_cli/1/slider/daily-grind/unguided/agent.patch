+  <script>
+    (function () {
+      const STRENGTH_PROFILES = [
+        {
+          name: 'Mild',
+          description: 'Light, floral, and tea-like clarity with subtle honey sweetness and bright stone-fruit notes.',
+          roast: 'Light Blonde',
+          ratio: '1:18'
+        },
+        {
+          name: 'Medium',
+          description: 'Balanced body with smooth caramel sweetness, toasted hazelnut notes, and a clean citrus finish.',
+          roast: 'City Medium',
+          ratio: '1:16'
+        },
+        {
+          name: 'Bold',
+          description: 'Full-bodied and rich with deep dark chocolate, roasted almond, and warm spice undertones.',
+          roast: 'Full City Dark',
+          ratio: '1:14'
+        },
+        {
+          name: 'Extra Bold',
+          description: 'Intense, velvety extraction with smoky bittersweet cocoa, molasses depth, and a lingering crema finish.',
+          roast: 'French Espresso',
+          ratio: '1:12'
+        }
+      ];
+
+      const slider = document.getElementById('brew-strength-range');
+      const valueBadge = document.getElementById('brew-strength-value');
+      const fillBar = document.getElementById('brew-strength-fill');
+      const trackContainer = document.getElementById('slider-track-container');
+      const descriptionEl = document.getElementById('strength-description');
+      const roastEl = document.getElementById('strength-roast');
+      const ratioEl = document.getElementById('strength-ratio');
+      const stepButtons = document.querySelectorAll('.strength-step');
+
+      function updateBrewStrength(rawIndex) {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 3;
+        const index = Math.max(min, Math.min(max, Number(rawIndex)));
+        const profile = STRENGTH_PROFILES[index] || STRENGTH_PROFILES[0];
+        const percent = ((index - min) / (max - min)) * 100;
+        const percentStr = percent.toFixed(4) + '%';
+
+        slider.value = String(index);
+        slider.style.setProperty('--fill-percent', percentStr);
+        slider.setAttribute('aria-valuenow', String(index));
+        slider.setAttribute('aria-valuetext', profile.name);
+
+        if (trackContainer) {
+          trackContainer.style.setProperty('--fill-percent', percentStr);
+        }
+        if (fillBar) {
+          fillBar.style.width = percentStr;
+        }
+        if (valueBadge) {
+          valueBadge.textContent = profile.name;
+        }
+        if (descriptionEl) {
+          descriptionEl.textContent = profile.description;
+        }
+        if (roastEl) {
+          roastEl.textContent = profile.roast;
+        }
+        if (ratioEl) {
+          ratioEl.textContent = profile.ratio;
+        }
+
+        stepButtons.forEach((btn) => {
+          const stepIndex = Number(btn.getAttribute('data-step'));
+          btn.classList.toggle('is-active', stepIndex === index);
+          btn.classList.toggle('is-filled', stepIndex <= index);
+          btn.setAttribute('aria-pressed', String(stepIndex === index));
+        });
+      }
+
+      slider.addEventListener('input', (e) => updateBrewStrength(e.target.value));
+      slider.addEventListener('change', (e) => updateBrewStrength(e.target.value));
+
+      stepButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const stepIndex = Number(btn.getAttribute('data-step'));
+          updateBrewStrength(stepIndex);
+        });
+      });
+
+      updateBrewStrength(slider.value);
+    })();
+  </script>
