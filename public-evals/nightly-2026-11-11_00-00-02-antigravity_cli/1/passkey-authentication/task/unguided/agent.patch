+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      const loginForm = document.getElementById('login-form');
+
+      let conditionalAbortController = null;
+
+      function toBuffer(value) {
+        if (!value) {
+          return new Uint8Array(32).buffer;
+        }
+        if (value instanceof ArrayBuffer) {
+          return value;
+        }
+        if (ArrayBuffer.isView(value)) {
+          return value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength);
+        }
+        if (Array.isArray(value)) {
+          return new Uint8Array(value).buffer;
+        }
+        if (typeof value === 'object' && Array.isArray(value.data)) {
+          return new Uint8Array(value.data).buffer;
+        }
+        if (typeof value === 'string') {
+          try {
+            const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+            const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
+            const binary = atob(padded);
+            const bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++) {
+              bytes[i] = binary.charCodeAt(i);
+            }
+            return bytes.buffer;
+          } catch (_) {
+            return new TextEncoder().encode(value).buffer;
+          }
+        }
+        return new Uint8Array(32).buffer;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return '';
+        if (typeof buffer === 'string') return buffer;
+        let bytes;
+        if (buffer instanceof ArrayBuffer) {
+          bytes = new Uint8Array(buffer);
+        } else if (ArrayBuffer.isView(buffer)) {
+          bytes = new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+        } else if (Array.isArray(buffer)) {
+          bytes = new Uint8Array(buffer);
+        } else {
+          return String(buffer);
+        }
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function normalizePublicKeyOptions(raw) {
+        const source = raw && raw.publicKey ? { ...raw.publicKey } : { ...(raw || {}) };
+        const publicKey = {
+          ...source,
+          challenge: toBuffer(source.challenge),
+          userVerification: source.userVerification || 'preferred',
+        };
+        if (Array.isArray(source.allowCredentials)) {
+          publicKey.allowCredentials = source.allowCredentials.map((cred) => ({
+            ...cred,
+            type: cred.type || 'public-key',
+            id: toBuffer(cred.id),
+          }));
+        }
+        return publicKey;
+      }
+
+      async function fetchRequestOptions() {
+        let response = await fetch('/api/login/options');
+        if (!response.ok && response.status === 405) {
+          response = await fetch('/api/login/options', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ username: usernameField ? usernameField.value : '' }),
+          });
+        }
+        if (!response.ok) {
+          throw new Error('Failed to fetch authentication options');
+        }
+        const data = await response.json();
+        return normalizePublicKeyOptions(data);
+      }
+
+      async function requestCredential(getOptions) {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          throw new Error('WebAuthn is not supported in this browser');
+        }
+        try {
+          return await navigator.credentials.get(getOptions);
+        } catch (err) {
+          if (
+            err &&
+            err.name === 'SecurityError' &&
+            getOptions.publicKey &&
+            getOptions.publicKey.rpId &&
+            getOptions.publicKey.rpId !== window.location.hostname
+          ) {
+            return await navigator.credentials.get({
+              ...getOptions,
+              publicKey: {
+                ...getOptions.publicKey,
+                rpId: window.location.hostname,
+              },
+            });
+          }
+          throw err;
+        }
+      }
+
+      function serializeCredential(credential) {
+        if (!credential) return {};
+        const response = credential.response || {};
+        const payload = {
+          id: credential.id || bufferToBase64url(credential.rawId),
+          rawId: bufferToBase64url(credential.rawId || credential.id),
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : credential.clientExtensionResults || {},
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null,
+          },
+        };
+        if (usernameField && usernameField.value) {
+          payload.username = usernameField.value;
+        }
+        return payload;
+      }
+
+      async function verifyCredential(credential) {
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(payload),
+        });
+
+        let data = null;
+        const text = await response.text();
+        if (text) {
+          try {
+            data = JSON.parse(text);
+          } catch (_) {
+            data = { message: text };
+          }
+        }
+
+        if (!response.ok || (data && (data.verified === false || data.success === false || data.ok === false))) {
+          const errMsg = (data && (data.error || data.message)) || 'Authentication verification failed';
+          throw new Error(errMsg);
+        }
+
+        const userName =
+          (data && (typeof data.user === 'string' ? data.user : data.user?.username || data.user?.name || data.username)) ||
+          (usernameField && usernameField.value) ||
+          '';
+
+        const statusParts = ['Authenticated successfully! Verified and signed in.'];
+        if (data && typeof data.message === 'string' && data.message.trim()) {
+          statusParts.unshift(data.message.trim());
+        }
+        if (userName) {
+          statusParts.push(`Welcome, ${userName}!`);
+        }
+
+        if (authStatus) {
+          authStatus.className = 'auth-status success';
+          authStatus.textContent = statusParts.join(' ');
+        }
+      }
+
+      async function handleConditionalPasskeyOnFocus() {
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+        }
+        const controller = new AbortController();
+        conditionalAbortController = controller;
+        const { signal } = controller;
+
+        try {
+          const optionsPromise = fetchRequestOptions();
+          if (
+            window.PublicKeyCredential &&
+            typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+          ) {
+            try {
+              await window.PublicKeyCredential.isConditionalMediationAvailable();
+            } catch (_) {}
+          }
+
+          const publicKey = await optionsPromise;
+          if (signal.aborted) return;
+
+          const credential = await requestCredential({
+            publicKey,
+            mediation: 'conditional',
+            signal,
+          });
+
+          if (signal.aborted || !credential) return;
+          await verifyCredential(credential);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        } finally {
+          if (conditionalAbortController === controller) {
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function handleDirectBiometricAuth(event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        try {
+          const publicKey = await fetchRequestOptions();
+          const credential = await requestCredential({
+            publicKey,
+          });
+          if (!credential) {
+            throw new Error('No passkey credential returned');
+          }
+          await verifyCredential(credential);
+        } catch (err) {
+          if (authStatus) {
+            authStatus.className = 'auth-status error';
+            authStatus.textContent = (err && err.message) || 'Authentication failed';
+          }
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', handleConditionalPasskeyOnFocus);
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleDirectBiometricAuth);
+      }
+
+      if (loginForm) {
+        loginForm.addEventListener('submit', handleDirectBiometricAuth);
+      }
+    })();
+  </script>
+
 </body>
 
