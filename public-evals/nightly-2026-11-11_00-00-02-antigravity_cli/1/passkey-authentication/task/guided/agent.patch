+  <script type="module">
+    const usernameField = document.querySelector('[data-testid="username-field"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    const signinForm = document.getElementById('signin-form');
+
+    let autofillAbortController = new AbortController();
+    let isConditionalPending = false;
+
+    async function optionsFetch() {
+      const response = await fetch('/api/login/options');
+      if (!response.ok) {
+        throw new Error(`Failed to fetch login options: ${response.status}`);
+      }
+      const data = await response.json();
+      return data.publicKey ?? data;
+    }
+
+    async function loginVerifyFetch(encoded) {
+      return fetch('/api/login/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encoded),
+      });
+    }
+
+    async function handleVerificationSuccess(response) {
+      let data = null;
+      try {
+        data = await response.clone().json();
+      } catch {
+        // Response body may be empty or plain text
+      }
+      const detail =
+        data?.message || (data?.username ? `Welcome, ${data.username}!` : '');
+      authStatus.textContent = detail
+        ? `Signed in and authenticated successfully: ${detail}`
+        : 'Signed in and authenticated successfully!';
+    }
+
+    async function initializeConditionalAutofill() {
+      if (typeof PublicKeyCredential === 'undefined' || isConditionalPending) {
+        return;
+      }
+
+      try {
+        // Feature detect Conditional Get autofill support
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalGet === true) {
+          isConditionalPending = true;
+          const loginOptionsJSON = await optionsFetch();
+          const publicKey =
+            PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+          try {
+            // Initiate Conditional UI form autofill suggestions
+            const credential = await navigator.credentials.get({
+              publicKey,
+              signal: autofillAbortController.signal,
+              mediation: 'conditional',
+            });
+
+            isConditionalPending = false;
+            if (!credential) {
+              return;
+            }
+
+            // Segregated verification fetch
+            const encoded = credential.toJSON();
+            try {
+              const response = await loginVerifyFetch(encoded);
+              if (response.ok) {
+                await handleVerificationSuccess(response);
+              } else if (response.status === 404) {
+                authStatus.textContent =
+                  'Passkey not recognized. This credential is no longer registered.';
+                if (PublicKeyCredential.signalUnknownCredential) {
+                  await PublicKeyCredential.signalUnknownCredential({
+                    rpId: publicKey.rpId,
+                    credentialId: encoded.id,
+                  });
+                }
+              } else {
+                authStatus.textContent =
+                  'Authentication failed. Please try again.';
+              }
+            } catch (serverErr) {
+              authStatus.textContent =
+                'Verification request error. Please try again.';
+              console.error('Verification request error:', serverErr);
+            }
+          } catch (err) {
+            isConditionalPending = false;
+            // Silently swallow expected client WebAuthn exceptions
+            if (['NotAllowedError', 'AbortError'].includes(err.name)) {
+              return;
+            }
+            console.error('Unexpected conditional get error:', err);
+          }
+        }
+      } catch (err) {
+        isConditionalPending = false;
+        console.error('Conditional autofill setup error:', err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController(); // Reset controller for next triggers
+      isConditionalPending = false;
+
+      let publicKey;
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        publicKey =
+          PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+      } catch (err) {
+        authStatus.textContent = 'Failed to load authentication options.';
+        console.error('Options fetch error:', err);
+        return;
+      }
+
+      let credential;
+      try {
+        // Passkey explicit prompt trigger
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          authStatus.textContent = 'Passkey sign-in was cancelled.';
+          console.log('User cancelled passkey login.');
+        } else if (err.name === 'AbortError') {
+          console.log('The authentication operation was aborted.');
+        } else {
+          authStatus.textContent = 'Passkey authentication failed.';
+        }
+        // Re-arm Conditional autofill Suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return; // Safe exit
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // Segregated verification try/catch (HTTP 404 trigger)
+      const encoded = credential.toJSON();
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          await handleVerificationSuccess(response);
+        } else if (response.status === 404) {
+          authStatus.textContent =
+            'Passkey not recognized. This credential is no longer registered.';
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          }
+        } else {
+          authStatus.textContent = 'Authentication failed. Please try again.';
+        }
+      } catch (serverErr) {
+        authStatus.textContent =
+          'Verification request error. Please try again.';
+        console.error('Verification request error:', serverErr);
+      }
+    }
+
+    authButton.addEventListener('click', triggerButtonAuthentication);
+    usernameField.addEventListener('focus', () => {
+      if (!isConditionalPending) {
+        initializeConditionalAutofill();
+      }
+    });
+    signinForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+    });
+
+    // Trigger Conditional Get on load
+    if (document.readyState === 'loading') {
+      window.addEventListener('DOMContentLoaded', initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
