diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..3ef62e1
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,187 @@
+import type {
+  TranslatorAvailability,
+  TranslatorInstance,
+  TranslatorLanguagePairOptions,
+  LanguageDetectorInstance,
+} from '../../global';
+
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish (Español)' },
+  { code: 'fr', label: 'French (Français)' },
+  { code: 'de', label: 'German (Deutsch)' },
+  { code: 'it', label: 'Italian (Italiano)' },
+  { code: 'pt', label: 'Portuguese (Português)' },
+  { code: 'nl', label: 'Dutch (Nederlands)' },
+  { code: 'pl', label: 'Polish (Polski)' },
+  { code: 'ru', label: 'Russian (Русский)' },
+  { code: 'uk', label: 'Ukrainian (Українська)' },
+  { code: 'ja', label: 'Japanese (日本語)' },
+  { code: 'ko', label: 'Korean (한국어)' },
+  { code: 'zh', label: 'Chinese Simplified (简体中文)' },
+  { code: 'zh-Hant', label: 'Chinese Traditional (繁體中文)' },
+  { code: 'ar', label: 'Arabic (العربية)' },
+  { code: 'hi', label: 'Hindi (हिन्दी)' },
+  { code: 'tr', label: 'Turkish (Türkçe)' },
+  { code: 'vi', label: 'Vietnamese (Tiếng Việt)' },
+  { code: 'id', label: 'Indonesian (Bahasa Indonesia)' },
+  { code: 'th', label: 'Thai (ไทย)' },
+  { code: 'sv', label: 'Swedish (Svenska)' },
+  { code: 'da', label: 'Danish (Dansk)' },
+  { code: 'fi', label: 'Finnish (Suomi)' },
+  { code: 'no', label: 'Norwegian (Norsk)' },
+  { code: 'cs', label: 'Czech (Čeština)' },
+  { code: 'el', label: 'Greek (Ελληνικά)' },
+  { code: 'he', label: 'Hebrew (עברית)' },
+  { code: 'ro', label: 'Romanian (Română)' },
+  { code: 'hu', label: 'Hungarian (Magyar)' },
+  { code: 'bg', label: 'Bulgarian (Български)' },
+  { code: 'bn', label: 'Bengali (বাংলা)' },
+  { code: 'hr', label: 'Croatian (Hrvatski)' },
+  { code: 'kn', label: 'Kannada (ಕನ್ನಡ)' },
+  { code: 'lt', label: 'Lithuanian (Lietuvių)' },
+  { code: 'mr', label: 'Marathi (मराठी)' },
+  { code: 'sk', label: 'Slovak (Slovenčina)' },
+  { code: 'sl', label: 'Slovenian (Slovenščina)' },
+  { code: 'ta', label: 'Tamil (தமிழ்)' },
+  { code: 'te', label: 'Telugu (తెలుగు)' },
+];
+
+export const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && Boolean(self.Translator);
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return (
+    typeof self !== 'undefined' &&
+    'LanguageDetector' in self &&
+    Boolean(self.LanguageDetector)
+  );
+}
+
+export async function checkPairAvailability(
+  options: TranslatorLanguagePairOptions
+): Promise<TranslatorAvailability> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unavailable';
+  }
+  if (options.sourceLanguage === options.targetLanguage) {
+    return 'available';
+  }
+  try {
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export async function detectSourceLanguage(
+  sampleText: string,
+  onProgress?: (percent: number) => void
+): Promise<{ detectedLanguage: string; confidence: number } | null> {
+  if (!isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return null;
+  }
+  const trimmed = sampleText.trim();
+  if (trimmed.length < 15) {
+    return null;
+  }
+
+  const availability = await self.LanguageDetector.availability();
+  if (availability === 'unavailable') {
+    return null;
+  }
+
+  const detector: LanguageDetectorInstance = await self.LanguageDetector.create({
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        if (onProgress && typeof e.loaded === 'number') {
+          onProgress(Math.round(e.loaded * 100));
+        }
+      });
+    },
+  });
+
+  const results = await detector.detect(trimmed);
+  if (!results || results.length === 0) {
+    return null;
+  }
+  return results[0];
+}
+
+export async function createOnDeviceTranslator(
+  options: TranslatorLanguagePairOptions,
+  onProgress?: (percent: number) => void,
+  signal?: AbortSignal
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    throw new Error('Client-side Translator API is not supported in this browser.');
+  }
+
+  // Pass identical sourceLanguage and targetLanguage options to availability() and create()
+  const pairOptions: TranslatorLanguagePairOptions = {
+    sourceLanguage: options.sourceLanguage,
+    targetLanguage: options.targetLanguage,
+  };
+
+  const availability = await self.Translator.availability(pairOptions);
+  if (availability === 'unavailable') {
+    throw new Error(
+      `Translation model for ${pairOptions.sourceLanguage} → ${pairOptions.targetLanguage} is unavailable on this device.`
+    );
+  }
+
+  return await self.Translator.create({
+    ...pairOptions,
+    signal,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        if (onProgress && typeof e.loaded === 'number') {
+          onProgress(Math.round(e.loaded * 100));
+        }
+      });
+    },
+  });
+}
+
+export async function translateTextWithStreaming(
+  translator: TranslatorInstance,
+  text: string,
+  onChunk?: (partialText: string) => void
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  // Use translateStreaming for longer text when supported
+  if (trimmed.length > 240 && typeof translator.translateStreaming === 'function') {
+    try {
+      const stream = translator.translateStreaming(trimmed);
+      let accumulated = '';
+      for await (const chunk of stream) {
+        // Handle both incremental chunks and cumulative chunks safely
+        if (chunk.startsWith(accumulated) && chunk.length >= accumulated.length && accumulated.length > 0) {
+          accumulated = chunk;
+        } else {
+          accumulated += chunk;
+        }
+        onChunk?.(accumulated);
+      }
+      if (accumulated) {
+        return accumulated;
+      }
+    } catch {
+      // Fall back to standard translate() if streaming fails
+    }
+  }
+
+  const result = await translator.translate(trimmed);
+  onChunk?.(result);
+  return result;
+}
