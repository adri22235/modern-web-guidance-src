diff --git a/src/components/ArticleTranslateControl.tsx b/src/components/ArticleTranslateControl.tsx
new file mode 100644
index 0000000..0d444d4
--- /dev/null
+++ b/src/components/ArticleTranslateControl.tsx
@@ -0,0 +1,602 @@
+import React, { useState, useEffect, useRef, useId } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  RTL_LANGUAGES,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkPairAvailability,
+  detectSourceLanguage,
+  createOnDeviceTranslator,
+  translateTextWithStreaming,
+} from '../utils/translator';
+import type { TranslatorAvailability } from '../../global';
+
+export interface ArticleTranslateControlProps {
+  /** Scope selector for the article or page container to translate. Defaults to '[data-translatable-article]' */
+  containerSelector?: string;
+  /** Default source language (BCP 47 code) */
+  defaultSourceLanguage?: string;
+  /** Default target language (BCP 47 code) */
+  defaultTargetLanguage?: string;
+  /** Whether to also offer translating all visible teasers on the page */
+  includeTeasersToggle?: boolean;
+  /** Compact variant for inline teaser bars */
+  compact?: boolean;
+  /** Optional heading label */
+  label?: string;
+}
+
+interface OriginalNodeRecord {
+  element: HTMLElement;
+  originalText: string;
+  originalLang: string | null;
+  originalDir: string | null;
+}
+
+export default function ArticleTranslateControl({
+  containerSelector = '[data-translatable-article]',
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+  includeTeasersToggle = true,
+  compact = false,
+  label = 'On-Device Translation',
+}: ArticleTranslateControlProps) {
+  const instanceId = useId();
+  const sourceSelectId = `${instanceId}-source-lang`;
+  const targetSelectId = `${instanceId}-target-lang`;
+  const statusDescId = `${instanceId}-status-desc`;
+
+  const [apiSupported, setApiSupported] = useState<boolean | null>(null);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(false);
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>(defaultTargetLanguage);
+  const [availability, setAvailability] = useState<TranslatorAvailability | 'checking'>('checking');
+
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isDetecting, setIsDetecting] = useState<boolean>(false);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [translateTeasers, setTranslateTeasers] = useState<boolean>(true);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translationProgress, setTranslationProgress] = useState<{ current: number; total: number } | null>(null);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const originalRecordsRef = useRef<OriginalNodeRecord[]>([]);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    const supported = isTranslatorSupported();
+    setApiSupported(supported);
+    setDetectorSupported(isLanguageDetectorSupported());
+
+    if (!supported) {
+      setAvailability('unavailable');
+    }
+  }, []);
+
+  useEffect(() => {
+    if (apiSupported === false || apiSupported === null) return;
+
+    let cancelled = false;
+    setAvailability('checking');
+    setErrorMessage(null);
+
+    checkPairAvailability({ sourceLanguage, targetLanguage }).then((status) => {
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [apiSupported, sourceLanguage, targetLanguage]);
+
+  const collectTranslatableElements = (): HTMLElement[] => {
+    const elements: HTMLElement[] = [];
+    const seen = new Set<HTMLElement>();
+
+    const addEl = (el: Element | null) => {
+      if (!el || !(el instanceof HTMLElement) || seen.has(el)) return;
+      if (el.closest('[data-no-translate]')) return;
+      const text = el.textContent?.trim();
+      if (!text) return;
+      seen.add(el);
+      elements.push(el);
+    };
+
+    // 1. Collect from targeted article container(s)
+    const containers = document.querySelectorAll(containerSelector);
+    containers.forEach((container) => {
+      const explicitTargets = container.querySelectorAll('[data-translate-target]');
+      explicitTargets.forEach((el) => addEl(el));
+
+      const proseContainers = container.querySelectorAll('[data-translate-prose]');
+      proseContainers.forEach((prose) => {
+        const blocks = prose.querySelectorAll('p, h2, h3, h4, h5, h6, li, blockquote, figcaption');
+        blocks.forEach((block) => {
+          // Avoid nested list items or blockquotes duplicating parent text
+          const hasBlockChild = block.querySelector('p, ul, ol, blockquote');
+          if (!hasBlockChild) {
+            addEl(block);
+          }
+        });
+      });
+    });
+
+    // 2. Also collect teaser elements if enabled or if containerSelector targets teasers
+    if (translateTeasers || containerSelector.includes('teaser')) {
+      const teaserTargets = document.querySelectorAll('[data-translate-teaser]');
+      teaserTargets.forEach((el) => addEl(el));
+    }
+
+    return elements;
+  };
+
+  const handleDetectLanguage = async () => {
+    setErrorMessage(null);
+    setIsDetecting(true);
+    setDownloadProgress(null);
+
+    try {
+      const elements = collectTranslatableElements();
+      const sampleText = elements
+        .slice(0, 4)
+        .map((el) => el.textContent?.trim() || '')
+        .join(' ')
+        .slice(0, 600);
+
+      if (sampleText.length < 15) {
+        setStatusMessage('Not enough text on page to detect source language automatically.');
+        return;
+      }
+
+      const detected = await detectSourceLanguage(sampleText, (pct) => {
+        setDownloadProgress(pct);
+      });
+
+      if (detected && detected.detectedLanguage) {
+        const baseCode = detected.detectedLanguage.split('-')[0];
+        const matched =
+          SUPPORTED_LANGUAGES.find((l) => l.code.toLowerCase() === detected.detectedLanguage.toLowerCase()) ||
+          SUPPORTED_LANGUAGES.find((l) => l.code.toLowerCase() === baseCode.toLowerCase());
+
+        if (matched) {
+          setSourceLanguage(matched.code);
+          const confidencePct = Math.round(detected.confidence * 100);
+          setStatusMessage(`Detected source language: ${matched.label} (${confidencePct}% confidence).`);
+          if (matched.code === targetLanguage) {
+            const fallbackTarget = matched.code === 'en' ? 'es' : 'en';
+            setTargetLanguage(fallbackTarget);
+          }
+        } else {
+          setStatusMessage(`Detected language "${detected.detectedLanguage}" is not in the supported preset list.`);
+        }
+      } else {
+        setStatusMessage('Could not confidently detect the article language.');
+      }
+    } catch (err: any) {
+      setErrorMessage(err?.message || 'Language detection failed.');
+    } finally {
+      setIsDetecting(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+      abortControllerRef.current = null;
+    }
+
+    for (const record of originalRecordsRef.current) {
+      record.element.textContent = record.originalText;
+      if (record.originalLang) {
+        record.element.setAttribute('lang', record.originalLang);
+      } else {
+        record.element.removeAttribute('lang');
+      }
+      if (record.originalDir) {
+        record.element.setAttribute('dir', record.originalDir);
+      } else {
+        record.element.removeAttribute('dir');
+      }
+    }
+
+    setIsTranslated(false);
+    setIsTranslating(false);
+    setTranslationProgress(null);
+    setDownloadProgress(null);
+    setErrorMessage(null);
+    setStatusMessage('Restored original language.');
+  };
+
+  const handleSwapLanguages = () => {
+    if (isTranslating) return;
+    const prevSource = sourceLanguage;
+    setSourceLanguage(targetLanguage);
+    setTargetLanguage(prevSource);
+  };
+
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+    setStatusMessage('');
+
+    if (sourceLanguage === targetLanguage) {
+      setErrorMessage('Please select a target language different from the source language.');
+      return;
+    }
+
+    if (!isTranslatorSupported()) {
+      setErrorMessage('Client-side translation is currently unsupported in this browser.');
+      return;
+    }
+
+    const elements = collectTranslatableElements();
+    if (elements.length === 0) {
+      setErrorMessage('No translatable article or teaser content found on this page.');
+      return;
+    }
+
+    // Snapshot original text on first translation before modifying DOM
+    if (originalRecordsRef.current.length === 0) {
+      originalRecordsRef.current = elements.map((element) => ({
+        element,
+        originalText: element.textContent || '',
+        originalLang: element.getAttribute('lang'),
+        originalDir: element.getAttribute('dir'),
+      }));
+    } else {
+      // Ensure any new elements are also recorded
+      const recordedMap = new Map(originalRecordsRef.current.map((r) => [r.element, r]));
+      elements.forEach((element) => {
+        if (!recordedMap.has(element)) {
+          originalRecordsRef.current.push({
+            element,
+            originalText: element.textContent || '',
+            originalLang: element.getAttribute('lang'),
+            originalDir: element.getAttribute('dir'),
+          });
+        }
+      });
+    }
+
+    const controller = new AbortController();
+    abortControllerRef.current = controller;
+
+    setIsTranslating(true);
+    setDownloadProgress(null);
+    setTranslationProgress({ current: 0, total: originalRecordsRef.current.length });
+
+    try {
+      // User-gesture initiated Translator.create() with identical options passed to availability()
+      const translator = await createOnDeviceTranslator(
+        { sourceLanguage, targetLanguage },
+        (pct) => {
+          setDownloadProgress(pct);
+        },
+        controller.signal
+      );
+
+      setDownloadProgress(null);
+      const isRtl = RTL_LANGUAGES.has(targetLanguage);
+      const records = originalRecordsRef.current;
+
+      for (let i = 0; i < records.length; i++) {
+        if (controller.signal.aborted) break;
+
+        const record = records[i];
+        const sourceText = record.originalText.trim();
+        setTranslationProgress({ current: i + 1, total: records.length });
+
+        if (!sourceText) continue;
+
+        record.element.setAttribute('lang', targetLanguage);
+        record.element.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
+
+        const translated = await translateTextWithStreaming(translator, sourceText, (partial) => {
+          if (!controller.signal.aborted) {
+            record.element.textContent = partial;
+          }
+        });
+
+        if (!controller.signal.aborted) {
+          record.element.textContent = translated;
+        }
+      }
+
+      if (!controller.signal.aborted) {
+        const targetLabel =
+          SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage)?.label || targetLanguage;
+        setIsTranslated(true);
+        setStatusMessage(`Translated ${records.length} sections into ${targetLabel} on-device.`);
+      }
+
+      if (typeof translator.destroy === 'function') {
+        translator.destroy();
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError') {
+        setStatusMessage('Translation cancelled.');
+      } else {
+        setErrorMessage(
+          err?.message || 'Unable to complete on-device translation for the selected language pair.'
+        );
+      }
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+      setTranslationProgress(null);
+    }
+  };
+
+  const availabilityBadge = () => {
+    if (apiSupported === false) {
+      return (
+        <span className="inline-flex items-center gap-1 rounded-full bg-gray-200 px-2.5 py-0.5 text-xs font-medium text-gray-700">
+          <span className="h-1.5 w-1.5 rounded-full bg-gray-500" aria-hidden="true" />
+          Browser Unsupported
+        </span>
+      );
+    }
+    if (availability === 'checking') {
+      return (
+        <span className="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">
+          Checking model…
+        </span>
+      );
+    }
+    if (availability === 'available') {
+      return (
+        <span className="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">
+          <span className="h-1.5 w-1.5 rounded-full bg-emerald-600" aria-hidden="true" />
+          On-Device Ready
+        </span>
+      );
+    }
+    if (availability === 'downloadable' || availability === 'downloading') {
+      return (
+        <span className="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-900">
+          <span className="h-1.5 w-1.5 rounded-full bg-amber-600" aria-hidden="true" />
+          {availability === 'downloading' ? 'Model Downloading' : 'Model Downloadable'}
+        </span>
+      );
+    }
+    return (
+      <span className="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">
+        <span className="h-1.5 w-1.5 rounded-full bg-red-600" aria-hidden="true" />
+        Pair Unavailable
+      </span>
+    );
+  };
+
+  return (
+    <section
+      data-no-translate="true"
+      aria-label={label}
+      className={`rounded-lg border border-gray-200 bg-gray-50/90 text-left shadow-xs ${
+        compact ? 'p-3' : 'p-4 my-4'
+      }`}
+    >
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
+        <div className="flex items-center gap-2">
+          <svg
+            aria-hidden="true"
+            className="w-5 h-5 text-amber-700 flex-shrink-0"
+             xmlns="http://www.w3.org/2000/svg"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.8}
+            stroke="currentColor"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <span className="text-sm font-bold text-gray-900">{label}</span>
+          {availabilityBadge()}
+        </div>
+
+        <span className="text-xs text-gray-600">
+          Private, built-in browser AI (no cloud upload)
+        </span>
+      </div>
+
+      <div className="flex flex-wrap items-end gap-3">
+        {/* Source Language Selector */}
+        <div className="flex flex-col min-w-[150px] flex-1 sm:flex-initial">
+          <label htmlFor={sourceSelectId} className="text-xs font-semibold text-gray-700 mb-1">
+            Translate from
+          </label>
+          <select
+            id={sourceSelectId}
+            value={sourceLanguage}
+            onChange={(e) => setSourceLanguage(e.target.value)}
+            disabled={isTranslating || apiSupported === false}
+            aria-describedby={statusDescId}
+            className="min-h-[38px] rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:bg-gray-100 disabled:text-gray-500"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`src-${lang.code}`} value={lang.code}>
+                {lang.label}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {/* Swap Languages Button */}
+        <button
+          type="button"
+          onClick={handleSwapLanguages}
+          disabled={isTranslating || apiSupported === false}
+          aria-label="Swap source and target languages"
+          className="min-h-[38px] min-w-[38px] inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-gray-700 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:opacity-50"
+        >
+          <svg
+            aria-hidden="true"
+            className="w-4 h-4"
+            xmlns="http://www.w3.org/2000/svg"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={2}
+            stroke="currentColor"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+            />
+          </svg>
+        </button>
+
+        {/* Target Language Selector */}
+        <div className="flex flex-col min-w-[150px] flex-1 sm:flex-initial">
+          <label htmlFor={targetSelectId} className="text-xs font-semibold text-gray-700 mb-1">
+            Translate into
+          </label>
+          <select
+            id={targetSelectId}
+            value={targetLanguage}
+            onChange={(e) => setTargetLanguage(e.target.value)}
+            disabled={isTranslating || apiSupported === false}
+            aria-describedby={statusDescId}
+            className="min-h-[38px] rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:bg-gray-100 disabled:text-gray-500"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`tgt-${lang.code}`} value={lang.code}>
+                {lang.label}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {/* Auto-Detect Source Button (when LanguageDetector API is supported or available) */}
+        {detectorSupported && (
+          <button
+            type="button"
+            onClick={handleDetectLanguage}
+            disabled={isDetecting || isTranslating}
+            className="min-h-[38px] inline-flex items-center gap-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-800 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:opacity-50"
+          >
+            {isDetecting ? 'Detecting…' : 'Detect source'}
+          </button>
+        )}
+
+        {/* Include Teasers Checkbox */}
+        {includeTeasersToggle && !compact && (
+          <div className="flex items-center gap-1.5 min-h-[38px] px-1">
+            <input
+              id={`${instanceId}-include-teasers`}
+              type="checkbox"
+              checked={translateTeasers}
+              onChange={(e) => setTranslateTeasers(e.target.checked)}
+              disabled={isTranslating || apiSupported === false}
+              className="h-4 w-4 rounded border-gray-300 text-amber-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
+            />
+            <label
+              htmlFor={`${instanceId}-include-teasers`}
+              className="text-xs font-medium text-gray-700 select-none cursor-pointer"
+            >
+              Include article teasers
+            </label>
+          </div>
+        )}
+
+        {/* Action Buttons */}
+        <div className="flex items-center gap-2 ml-auto">
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={
+              isTranslating ||
+              apiSupported === false ||
+              availability === 'unavailable' ||
+              sourceLanguage === targetLanguage
+            }
+            className="min-h-[38px] inline-flex items-center justify-center gap-1.5 rounded-md bg-gray-900 px-4 py-1.5 text-xs font-semibold text-white hover:bg-amber-700 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:bg-gray-300 disabled:text-gray-600 disabled:cursor-not-allowed"
+          >
+            {isTranslating
+              ? 'Translating…'
+              : availability === 'downloadable'
+              ? 'Download & Translate'
+              : isTranslated
+              ? 'Re-translate'
+              : 'Translate'}
+          </button>
+
+          {(isTranslated || isTranslating) && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              className="min-h-[38px] inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-800 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
+            >
+              {isTranslating ? 'Cancel & Restore' : 'Show Original'}
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress Bars for Model Download or Section Translation */}
+      {downloadProgress !== null && (
+        <div className="mt-3 flex items-center gap-3">
+          <label htmlFor={`${instanceId}-dl-progress`} className="text-xs font-medium text-gray-700">
+            Downloading language model ({downloadProgress}%)
+          </label>
+          <progress
+            id={`${instanceId}-dl-progress`}
+            max={100}
+            value={downloadProgress}
+            className="h-2 flex-1 overflow-hidden rounded bg-gray-200 accent-amber-600"
+          >
+            {downloadProgress}%
+          </progress>
+        </div>
+      )}
+
+      {translationProgress !== null && downloadProgress === null && (
+        <div className="mt-3 flex items-center gap-3">
+          <label htmlFor={`${instanceId}-tx-progress`} className="text-xs font-medium text-gray-700">
+            Translating section {translationProgress.current} of {translationProgress.total}
+          </label>
+          <progress
+            id={`${instanceId}-tx-progress`}
+            max={translationProgress.total}
+            value={translationProgress.current}
+            className="h-2 flex-1 overflow-hidden rounded bg-gray-200 accent-amber-600"
+          >
+            {Math.round((translationProgress.current / Math.max(1, translationProgress.total)) * 100)}%
+          </progress>
+        </div>
+      )}
+
+      {/* Status / Fallback / Error Feedback */}
+      <div id={statusDescId} aria-live="polite" className="mt-2">
+        {apiSupported === false && (
+          <p className="text-xs text-gray-600">
+            Client-side translation is currently unsupported in this browser. Open in Chrome 138+ or Edge 148+ on desktop to use the built-in on-device Translator API.
+          </p>
+        )}
+        {apiSupported && sourceLanguage === targetLanguage && !errorMessage && (
+          <p className="text-xs text-amber-800">
+            Source and target languages are identical. Choose a different target language to translate.
+          </p>
+        )}
+        {apiSupported && availability === 'unavailable' && sourceLanguage !== targetLanguage && !errorMessage && (
+          <p className="text-xs text-red-700">
+            On-device translation model for {sourceLanguage.toUpperCase()} → {targetLanguage.toUpperCase()} is unavailable on this device.
+          </p>
+        )}
+        {errorMessage && (
+          <p role="alert" className="text-xs font-medium text-red-700">
+            {errorMessage}
+          </p>
+        )}
+        {!errorMessage && statusMessage && (
+          <p className="text-xs font-medium text-emerald-800">{statusMessage}</p>
+        )}
+      </div>
+    </section>
+  );
+}
