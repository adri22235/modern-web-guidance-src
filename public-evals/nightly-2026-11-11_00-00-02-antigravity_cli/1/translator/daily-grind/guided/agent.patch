+  <script>
+    (() => {
+      const languageSelect = document.getElementById('language-select');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const statusEl = document.getElementById('translation-status');
+      const progressEl = document.getElementById('translation-progress');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      let currentLanguage = 'en';
+
+      function setStatus(message, showProgress = false, progressPercent = 0) {
+        statusEl.textContent = message;
+        progressEl.hidden = !showProgress;
+        if (showProgress) {
+          progressEl.value = progressPercent;
+        }
+      }
+
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      async function createTranslatorWithMonitor(options) {
+        return Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              console.log(`Downloaded ${percent}%`);
+              setStatus(`Downloading language pack (${percent}%)...`, true, percent);
+            });
+          },
+        });
+      }
+
+      async function translateContent(translator, targetLanguage) {
+        setStatus('Translating menu and story...');
+        for (const el of translatableElements) {
+          const textToTranslate = el.textContent.trim();
+          if (textToTranslate) {
+            const translated = await translator.translate(textToTranslate);
+            el.textContent = translated;
+            el.lang = targetLanguage;
+          }
+        }
+        currentLanguage = targetLanguage;
+        setStatus(`Translated to ${targetLanguage.toUpperCase()}.`, false);
+      }
+
+      async function handleTranslationRequest() {
+        const targetLanguage = languageSelect.value;
+        if (targetLanguage === currentLanguage) {
+          setStatus(`Already displaying content in ${targetLanguage.toUpperCase()}.`, false);
+          return;
+        }
+
+        const options = {
+          sourceLanguage: currentLanguage,
+          targetLanguage,
+        };
+
+        try {
+          translateBtn.disabled = true;
+          languageSelect.disabled = true;
+          setStatus('Checking on-device language model availability...');
+
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            console.warn('Translation model is unavailable on this device.');
+            setStatus('Translation model is unavailable on this device for the selected language pair.');
+            return;
+          }
+
+          if (availability === 'available') {
+            const translator = await createTranslatorWithMonitor(options);
+            await translateContent(translator, targetLanguage);
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            setStatus('Downloading on-device language model...', true, 0);
+            const translator = await createTranslatorWithMonitor(options);
+            await translateContent(translator, targetLanguage);
+          }
+        } catch (err) {
+          if (err && err.name === 'NotAllowedError') {
+            setStatus('Model download requires confirmation. Click "Translate" to download and translate.');
+          } else {
+            setStatus('Unable to complete on-device translation on this device.');
+          }
+        } finally {
+          if ('Translator' in self) {
+            translateBtn.disabled = false;
+            languageSelect.disabled = false;
+          }
+        }
+      }
+
+      languageSelect.addEventListener('change', handleTranslationRequest);
+      translateBtn.addEventListener('click', handleTranslationRequest);
+    })();
+  </script>
 </body>
 
