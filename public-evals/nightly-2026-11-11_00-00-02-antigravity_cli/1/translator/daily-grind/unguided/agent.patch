+      const languageSelect = document.getElementById('language-select');
+      const statusText = document.getElementById('translation-status');
+      const statusDot = document.getElementById('status-dot');
+      const progressWrapper = document.getElementById('translation-progress-wrapper');
+      const progressBar = document.getElementById('translation-progress-bar');
+      const progressText = document.getElementById('translation-progress-text');
+
+      let currentLanguage = 'en';
+      let requestSequence = 0;
+
+      function getTranslatableElements() {
+        const nodes = document.querySelectorAll('[data-translate], .card p, .story-text, #story p, .hero p');
+        const elements = Array.from(new Set(nodes));
+        elements.forEach((el) => {
+          if (!el.dataset.originalText) {
+            el.dataset.originalText = el.textContent.trim();
+          }
+        });
+        return elements;
+      }
+
+      function updateProgress(percent) {
+        const clamped = Math.min(100, Math.max(0, Math.round(percent)));
+        progressWrapper.hidden = false;
+        progressBar.style.width = clamped + '%';
+        progressBar.setAttribute('aria-valuenow', String(clamped));
+        progressText.textContent = clamped + '%';
+      }
+
+      function hideProgress() {
+        progressWrapper.hidden = true;
+        progressBar.style.width = '0%';
+        progressBar.setAttribute('aria-valuenow', '0');
+        progressText.textContent = '0%';
+      }
+
+      async function createBrowserTranslator(sourceLanguage, targetLanguage, onProgress) {
+        const monitorCallback = function (m) {
+          if (m && typeof m.addEventListener === 'function') {
+            m.addEventListener('downloadprogress', function (e) {
+              const ratio = e.total && e.total > 1 ? e.loaded / e.total : (e.loaded || 0);
+              onProgress(ratio * 100);
+            });
+          }
+        };
+
+        // Standard Built-in AI Translator API (window.Translator / self.Translator)
+        if ('Translator' in self && self.Translator && typeof self.Translator.create === 'function') {
+          let availability = 'available';
+          if (typeof self.Translator.availability === 'function') {
+            availability = await self.Translator.availability({
+              sourceLanguage: sourceLanguage,
+              targetLanguage: targetLanguage
+            });
+          }
+          if (availability === 'unavailable' || availability === 'no') {
+            return { unavailable: true };
+          }
+          const translator = await self.Translator.create({
+            sourceLanguage: sourceLanguage,
+            targetLanguage: targetLanguage,
+            monitor: monitorCallback
+          });
+          return { translator: translator, availability: availability };
+        }
+
+        // Legacy self.ai.translator fallback
+        if (self.ai && self.ai.translator && typeof self.ai.translator.create === 'function') {
+          const translator = await self.ai.translator.create({
+            sourceLanguage: sourceLanguage,
+            targetLanguage: targetLanguage,
+            monitor: monitorCallback
+          });
+          return { translator: translator, availability: 'available' };
+        }
+
+        // Legacy self.translation.createTranslator fallback
+        if (self.translation && typeof self.translation.createTranslator === 'function') {
+          const translator = await self.translation.createTranslator({
+            sourceLanguage: sourceLanguage,
+            targetLanguage: targetLanguage
+          });
+          return { translator: translator, availability: 'available' };
+        }
+
+        return { unsupported: true };
+      }
+
+      function applyFallbackTranslations(elements, targetLanguage) {
+        const dict = FALLBACK_DICTIONARY[targetLanguage] || {};
+        elements.forEach((el) => {
+          const original = el.dataset.originalText || el.textContent.trim();
+          if (dict[original]) {
+            el.textContent = dict[original];
+          }
+          el.setAttribute('lang', targetLanguage);
+        });
+      }
+
+      async function translatePage(targetLanguage) {
+        const reqId = ++requestSequence;
+        const elements = getTranslatableElements();
+        const langLabel = LANGUAGE_NAMES[targetLanguage] || targetLanguage;
+
+        if (targetLanguage === 'en') {
+          elements.forEach((el) => {
+            if (el.dataset.originalText) {
+              el.textContent = el.dataset.originalText;
+            }
+            el.setAttribute('lang', 'en');
+          });
+          document.documentElement.lang = 'en';
+          currentLanguage = 'en';
+          hideProgress();
+          statusDot.className = 'status-dot';
+          statusText.textContent = 'Showing original language (English)';
+          return;
+        }
+
+        statusDot.className = 'status-dot busy';
+        statusText.textContent = 'Translating to ' + langLabel + ' on-device...';
+
+        try {
+          const result = await createBrowserTranslator('en', targetLanguage, function (pct) {
+            if (reqId !== requestSequence) return;
+            updateProgress(pct);
+            statusText.textContent = 'Downloading ' + langLabel + ' language model: ' + Math.round(pct) + '%';
+          });
+
+          if (reqId !== requestSequence) return;
+
+          if (result && result.translator) {
+            for (const el of elements) {
+              if (reqId !== requestSequence) break;
+              const original = el.dataset.originalText || el.textContent.trim();
+              const translated = await result.translator.translate(original);
+              if (reqId === requestSequence && typeof translated === 'string' && translated.trim()) {
