+  <script>
+    (function () {
+      var supportsAnchor =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('anchor-name', '--seasonal-btn');
+
+      var cards = document.querySelectorAll('.card');
+      cards.forEach(function (card) {
+        var btn = card.querySelector('.btn');
+        var tooltip = card.querySelector('.tooltip');
+        if (!btn || !tooltip) return;
+
+        function updateFallbackPosition() {
+          if (!supportsAnchor && btn.offsetHeight > 0) {
+            tooltip.style.top = (btn.offsetTop + btn.offsetHeight + 8) + 'px';
+            tooltip.style.left = (btn.offsetLeft + btn.offsetWidth / 2) + 'px';
+          }
+        }
+
+        function showTooltip() {
+          updateFallbackPosition();
+          tooltip.classList.add('is-visible');
+        }
+
+        function hideTooltip() {
+          tooltip.classList.remove('is-visible');
+        }
+
+        btn.addEventListener('mouseenter', showTooltip);
+        btn.addEventListener('mouseleave', hideTooltip);
+        btn.addEventListener('focus', showTooltip);
+        btn.addEventListener('blur', hideTooltip);
+      });
+    })();
+  </script>
+
