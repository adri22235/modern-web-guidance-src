+  <script type="module">
+    const ownedTriggers = new WeakSet();
+
+    function normalizeWhitespace(value) {
+      return (value || "").replace(/\s+/g, " ").trim();
+    }
+
+    function getAccessibleName(element) {
+      const labelledBy = element.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const text = labelledBy
+          .split(/\s+/)
+          .map((id) => document.getElementById(id)?.textContent || "")
+          .join(" ");
+        if (normalizeWhitespace(text)) return text;
+      }
+      const ariaLabel = element.getAttribute("aria-label");
+      if (normalizeWhitespace(ariaLabel)) return ariaLabel;
+
+      const imgAlts = Array.from(element.querySelectorAll("img[alt]"))
+        .map((img) => img.getAttribute("alt") || "")
+        .join(" ");
+      const textContent = `${element.textContent || ""} ${imgAlts}`;
+      if (normalizeWhitespace(textContent)) return textContent;
+
+      return element.getAttribute("title") || "";
+    }
+
+    export function wireInterestHints(root = document) {
+      for (const trigger of root.querySelectorAll("[interestfor]")) {
+        const targetId = trigger.getAttribute("interestfor");
+        const hint = targetId ? document.getElementById(targetId) : null;
+        if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+        const triggerName = normalizeWhitespace(getAccessibleName(trigger));
+        const hintText = normalizeWhitespace(hint.textContent);
+        if (triggerName && triggerName === hintText) continue;
+
+        if (!hint.hasAttribute("role")) {
+          hint.setAttribute("role", "tooltip");
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", targetId);
+          }
+          continue;
+        }
+
+        const activatesHint =
+          trigger.getAttribute("popovertarget") === targetId ||
+          trigger.getAttribute("commandfor") === targetId;
+
+        if (activatesHint) {
+          if (!trigger.hasAttribute("aria-expanded")) {
+            const isOpen =
+              hint.matches(":popover-open") ||
+              hint.classList.contains(":popover-open");
+            trigger.setAttribute("aria-expanded", String(isOpen));
+            ownedTriggers.add(trigger);
+          }
+        } else if (!trigger.hasAttribute("aria-describedby")) {
+          trigger.setAttribute("aria-describedby", targetId);
+        }
+      }
+    }
+
+    document.addEventListener(
+      "toggle",
+      (event) => {
+        const target = event.target;
+        if (
+          !(target instanceof HTMLElement) ||
+          !target.id ||
+          target.getAttribute("popover") !== "hint"
+        ) {
+          return;
+        }
+        const isOpen = event.newState === "open";
+        for (const trigger of document.querySelectorAll(
+          `[interestfor="${CSS.escape(target.id)}"]`
+        )) {
+          if (ownedTriggers.has(trigger)) {
+            trigger.setAttribute("aria-expanded", String(isOpen));
+          }
+        }
+      },
+      true
+    );
+
+    wireInterestHints();
+    window.wireInterestHints = wireInterestHints;
+
+    const probe = document.createElement("div");
+    probe.setAttribute("popover", "hint");
+    if (probe.popover !== "hint") {
+      document.addEventListener(
+        "beforetoggle",
+        ({ target, newState }) => {
+          const toggletip =
+            target instanceof HTMLElement &&
+            target.getAttribute("popover") === "hint" &&
+            target.id &&
+            document.querySelector(`[popovertarget="${CSS.escape(target.id)}"]`);
+          if (newState === "open" && toggletip) {
+            target.popover = "auto";
+          }
+        },
+        true
+      );
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
+
