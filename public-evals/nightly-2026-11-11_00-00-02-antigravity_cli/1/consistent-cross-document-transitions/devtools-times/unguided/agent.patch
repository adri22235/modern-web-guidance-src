 @import "tailwindcss";
 
+@view-transition {
+  navigation: auto;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+@keyframes vt-fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes vt-fade-out {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes vt-slide-from-bottom {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-slide-to-top {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+}
+
+@keyframes vt-slide-from-top {
+  from {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-slide-to-bottom {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+}
+
+::view-transition-group(*) {
+  animation-duration: 280ms;
+  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 240ms;
+  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+::view-transition-old(main-content) {
+  animation: 180ms cubic-bezier(0.4, 0, 1, 1) both vt-slide-to-top;
+}
+
+::view-transition-new(main-content) {
+  animation: 260ms cubic-bezier(0, 0, 0.2, 1) 40ms both vt-slide-from-bottom;
+}
+
+[data-astro-transition="back"]::view-transition-old(main-content) {
+  animation-name: vt-slide-to-bottom;
+}
+
+[data-astro-transition="back"]::view-transition-new(main-content) {
+  animation-name: vt-slide-from-top;
+}
+
+::view-transition-old(site-header),
+::view-transition-new(site-header),
+::view-transition-group(site-header) {
+  animation-duration: 0s;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 1ms !important;
+    animation-delay: 0ms !important;
+  }
 }
