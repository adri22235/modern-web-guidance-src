+    <script>
+      const IMAGE_READY_TIMEOUT_MS = 600;
+
+      function normalizeCategorySlug(raw: string): string {
+        try {
+          return decodeURIComponent(raw)
+            .trim()
+            .toLowerCase()
+            .replace(/[^a-z0-9_-]/g, "-");
+        } catch {
+          return raw
+            .trim()
+            .toLowerCase()
+            .replace(/[^a-z0-9_-]/g, "-");
+        }
+      }
+
+      function waitForImage(img: HTMLImageElement, timeoutMs = IMAGE_READY_TIMEOUT_MS): Promise<void> {
+        const src = img.currentSrc || img.getAttribute("src");
+        if (!src) return Promise.resolve();
+        if (img.getAttribute("crossorigin") === "use-credentials") {
+          return Promise.resolve();
+        }
+
+        const preloadPromise = new Promise<void>((resolve) => {
+          const probe = new Image();
+          const srcset = img.getAttribute("srcset");
+          const sizes = img.getAttribute("sizes");
+          if (srcset) probe.srcset = srcset;
+          if (sizes) probe.sizes = sizes;
+          probe.decoding = "sync";
+          probe.onload = () => {
+            if (typeof probe.decode === "function") {
+              probe.decode().then(() => resolve(), () => resolve());
+            } else {
+              resolve();
+            }
+          };
+          probe.onerror = () => resolve();
+          probe.src = src;
+
+          if (probe.complete) {
+            if (typeof probe.decode === "function") {
+              probe.decode().then(() => resolve(), () => resolve());
+            } else {
+              resolve();
+            }
+          }
+        });
+
+        const timeoutPromise = new Promise<void>((resolve) => {
+          setTimeout(resolve, timeoutMs);
+        });
+
+        return Promise.race([preloadPromise, timeoutPromise]);
+      }
+
+      function assignDynamicCategoryTransition(sourceElement: Element | null | undefined, targetUrl: URL) {
+        const categoryMatch = targetUrl.pathname.match(/\/category\/([^/?#]+)/);
+        if (!categoryMatch || !sourceElement) return;
+        const slug = normalizeCategorySlug(categoryMatch[1]);
+        const transitionName = `category-title-${slug}`;
+
+        const existing = document.querySelectorAll<HTMLElement>(
+          `[style*="view-transition-name: ${transitionName}"], [style*="view-transition-name:${transitionName}"]`
+        );
+        existing.forEach((el) => {
+          if (el !== sourceElement) {
+            el.style.viewTransitionName = "";
+          }
+        });
+
+        if (sourceElement instanceof HTMLElement && !sourceElement.hasAttribute("data-astro-transition-scope")) {
+          sourceElement.style.viewTransitionName = transitionName;
+        }
+      }
+
+      document.addEventListener("astro:before-preparation", (event: any) => {
+        if (event.to instanceof URL) {
+          assignDynamicCategoryTransition(event.sourceElement, event.to);
+        }
+
+        const originalLoader = event.loader;
+        event.loader = async () => {
+          await originalLoader();
+
+          const newDoc: Document | undefined = event.newDocument;
+          if (!newDoc) return;
+
+          const priorityImages = Array.from(
+            newDoc.querySelectorAll<HTMLImageElement>(
+              'main img[loading="eager"], main img[fetchpriority="high"], main img[data-astro-transition-scope], header img'
+            )
+          ).slice(0, 6);
+
+          priorityImages.forEach((img) => {
+            img.setAttribute("loading", "eager");
+            img.setAttribute("decoding", "sync");
+          });
+
+          const fontsReady =
+            "fonts" in document && document.fonts?.ready
+              ? Promise.race([
+                  document.fonts.ready,
+                  new Promise((resolve) => setTimeout(resolve, IMAGE_READY_TIMEOUT_MS)),
+                ])
+              : Promise.resolve();
+
+          await Promise.all([
+            fontsReady,
+            ...priorityImages.map((img) => waitForImage(img)),
+          ]);
+        };
+      });
+
+      document.addEventListener("astro:before-swap", (event: any) => {
+        const newDoc: Document | undefined = event.newDocument;
+        if (!newDoc) return;
+
+        const visibleImages = newDoc.querySelectorAll<HTMLImageElement>(
+          'main img[loading="eager"], main img[fetchpriority="high"], main img[data-astro-transition-scope]'
+        );
+        visibleImages.forEach((img) => {
+          img.setAttribute("loading", "eager");
+          img.setAttribute("decoding", "sync");
+        });
+      });
+    </script>
   </body>
 </html>
