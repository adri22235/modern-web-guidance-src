+// Apply initial theme and layout attributes before the page renders
+// so cross-document view transition snapshots capture the stable layout state.
+(function initThemeAndLayout() {
+  try {
+    const storedTheme = localStorage.getItem('theme') || 'light';
+    document.documentElement.dataset.theme = storedTheme;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+  }
+  document.documentElement.dataset.layout = 'ready';
+})();
