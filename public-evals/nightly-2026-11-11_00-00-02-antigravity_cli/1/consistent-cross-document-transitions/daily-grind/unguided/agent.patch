--- /dev/null
+++ b/theme.js
@@ -0,0 +1,35 @@
+(function () {
+  var root = document.documentElement;
+  try {
+    var savedTheme = localStorage.getItem('daily-grind-theme');
+    var prefersDark =
+      window.matchMedia &&
+      window.matchMedia('(prefers-color-scheme: dark)').matches;
+    var theme = savedTheme || (prefersDark ? 'dark' : 'light');
+    root.dataset.theme = theme;
+    var savedLayout = localStorage.getItem('daily-grind-layout') || 'standard';
+    root.dataset.layout = savedLayout;
+  } catch (e) {
+    root.dataset.theme = 'light';
+    root.dataset.layout = 'standard';
+  }
+  root.classList.add('layout-ready');
+
+  window.addEventListener('pageswap', function (event) {
+    if (event.viewTransition) {
+      var targetUrl =
+        event.activation && event.activation.entry
+          ? new URL(event.activation.entry.url)
+          : null;
+      if (targetUrl) {
+        sessionStorage.setItem('last-path', window.location.pathname);
+      }
+    }
+  });
+
+  window.addEventListener('pagereveal', function (event) {
+    if (event.viewTransition) {
+      root.dataset.transitioned = 'true';
+    }
+  });
+})();
