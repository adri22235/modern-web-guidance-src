+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMsg = document.getElementById('newsletter-error');
+      const successMsg = document.getElementById('newsletter-success');
+      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+      function isValidEmail(value) {
+        const trimmed = value.trim();
+        return trimmed.length > 0 && emailPattern.test(trimmed) && emailInput.checkValidity();
+      }
+
+      function showError(message) {
+        if (message) {
+          errorMsg.textContent = message;
+        }
+        emailInput.classList.add('is-invalid', 'invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.hidden = false;
+        errorMsg.classList.add('visible');
+        successMsg.hidden = true;
+        successMsg.classList.remove('visible');
+      }
+
+      function clearError() {
+        emailInput.classList.remove('is-invalid', 'invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorMsg.hidden = true;
+        errorMsg.classList.remove('visible');
+      }
+
+      // Suppress error state while the user is actively typing
+      emailInput.addEventListener('input', function () {
+        clearError();
+        successMsg.hidden = true;
+        successMsg.classList.remove('visible');
+      });
+
+      // Validate only after the user clicks away (loses focus)
+      emailInput.addEventListener('blur', function () {
+        const value = emailInput.value.trim();
+        if (value.length === 0) {
+          clearError();
+          return;
+        }
+        if (!isValidEmail(value)) {
+          showError('Please enter a valid email address.');
+        } else {
+          clearError();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const value = emailInput.value.trim();
+        if (!isValidEmail(value)) {
+          showError('Please enter a valid email address.');
+          return;
+        }
+        clearError();
+        emailInput.value = '';
+        successMsg.hidden = false;
+        successMsg.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
