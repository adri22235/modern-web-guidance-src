+  <script>
+    (function () {
+      const lazyMediaElements = document.querySelectorAll('.lazy-media');
+
+      function hydrateMediaElement(mediaEl) {
+        if (!mediaEl || mediaEl.dataset.loaded === 'true') {
+          return;
+        }
+
+        if (mediaEl.dataset.poster) {
+          mediaEl.setAttribute('poster', mediaEl.dataset.poster);
+        }
+
+        const sources = mediaEl.querySelectorAll('source[data-src]');
+        sources.forEach(function (sourceEl) {
+          if (sourceEl.dataset.src && !sourceEl.getAttribute('src')) {
+            sourceEl.setAttribute('src', sourceEl.dataset.src);
+          }
+        });
+
+        if (mediaEl.dataset.src && !mediaEl.getAttribute('src')) {
+          mediaEl.setAttribute('src', mediaEl.dataset.src);
+        }
+
+        const targetPreload = mediaEl.dataset.preload || 'metadata';
+        mediaEl.setAttribute('preload', targetPreload);
+        mediaEl.preload = targetPreload;
+
+        mediaEl.dataset.loaded = 'true';
+
+        if (typeof mediaEl.load === 'function') {
+          mediaEl.load();
+        }
+
+        const statusId = mediaEl.id + '-status';
+        const statusEl = document.getElementById(statusId);
+        if (statusEl) {
+          statusEl.textContent = 'Media ready to play.';
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const mediaObserver = new IntersectionObserver(
+          function (entries, observer) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                hydrateMediaElement(entry.target);
+                observer.unobserve(entry.target);
+              }
+            });
+          },
+          {
+            rootMargin: '200px 0px',
+            threshold: 0.01
+          }
+        );
+
+        lazyMediaElements.forEach(function (mediaEl) {
+          mediaObserver.observe(mediaEl);
+        });
+      } else {
+        lazyMediaElements.forEach(hydrateMediaElement);
+      }
+    })();
+  </script>
+
