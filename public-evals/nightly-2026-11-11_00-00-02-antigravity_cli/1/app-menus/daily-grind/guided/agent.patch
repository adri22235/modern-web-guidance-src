+            pointerTrigger = null;
+            trigger.focus({ preventScroll: true, focusVisible: false });
+          }
+        }
+      });
+
+      menu.markReturningFocus = () => {
+        returningFromOwnMenu = true;
+      };
+    });
+
+    // Inside menu interactions
+    menus.forEach(menu => {
+      const group = menu.querySelector('[focusgroup~="menu"]');
+      if (!group) return;
+      const isSubmenu = Boolean(menu.parentElement?.closest('[focusgroup~="menu"]'));
+      const rootMenu = menu.closest('[role="menubar"] > [popover]') || menu;
+      const rootTrigger = triggerFor(rootMenu);
+
+      let hoverSubmenuTimer = null;
+
+      group.addEventListener('pointermove', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        const hit = document.elementFromPoint(event.clientX, event.clientY);
+        if (!hit || !item.contains(hit)) return;
+
+        // Close any sibling open submenu when moving to another sibling item
+        const siblingSubmenuTriggers = [...group.querySelectorAll('[commandfor]')].filter(
+          t => t.closest('[focusgroup]') === group && t !== item
+        );
+        siblingSubmenuTriggers.forEach(t => {
+          const sub = menuFor(t);
+          if (isOpen(sub)) sub.hidePopover();
+        });
+
+        clearTimeout(hoverSubmenuTimer);
+        if (item.hasAttribute('commandfor')) {
+          hoverSubmenuTimer = setTimeout(() => {
+            item.focus({ preventScroll: true, focusVisible: false });
+            showMenu(menuFor(item), item);
+          }, 120);
+        } else {
+          item.focus({ preventScroll: true, focusVisible: false });
+        }
+      });
+
+      group.addEventListener('keydown', event => {
+        const active = document.activeElement;
+        if (!active || active.closest('[focusgroup]') !== group) return;
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          const trigger = triggerFor(menu);
+          menu.markReturningFocus?.();
+          trigger?.focus({ preventScroll: true });
+          menu.hidePopover();
+        } else if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isSubmenu) {
+            const trigger = triggerFor(menu);
+            menu.markReturningFocus?.();
+            trigger?.focus({ preventScroll: true });
+            menu.hidePopover();
+          } else if (rootTrigger) {
+            moveToRootTrigger(rootTrigger, -1);
+          }
+        } else if (event.key === 'ArrowRight') {
+          if (!active.hasAttribute('commandfor') && rootTrigger) {
+            event.preventDefault();
+            event.stopPropagation();
+            moveToRootTrigger(rootTrigger, 1);
+          }
+        } else if (event.key === 'Tab') {
+          rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+        } else if (event.key === ' ' && active.getAttribute('role') === 'menuitemcheckbox') {
+          // Space on a checkbox toggles and stays open (APG)
+          event.preventDefault();
+          event.stopPropagation();
+          const checked = active.getAttribute('aria-checked') === 'true';
+          active.setAttribute('aria-checked', String(!checked));
+        }
+      });
+
+      group.addEventListener('click', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        if (item.hasAttribute('commandfor')) return; // Submenu trigger handled separately
+
+        const fromPointer = event.detail > 0;
+        const role = item.getAttribute('role');
+
+        if (role === 'menuitemcheckbox') {
+          const checked = item.getAttribute('aria-checked') === 'true';
+          item.setAttribute('aria-checked', String(!checked));
+          setTimeout(() => {
+            if (rootMenu && rootTrigger) {
+              rootMenu.markReturningFocus?.();
+              closeAndRestore(rootMenu, { fromPointer });
+            }
+          }, 300);
+          return;
+        }
+
+        if (role === 'menuitemradio') {
+          const radioGroup = item.closest('[role="group"]') || group;
+          radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+            radio.setAttribute('aria-checked', String(radio === item));
+          });
+          setTimeout(() => {
+            if (rootMenu && rootTrigger) {
+              rootMenu.markReturningFocus?.();
+              closeAndRestore(rootMenu, { fromPointer });
+            }
+          }, 300);
+          return;
+        }
+
+        // Standard command or link activation
+        if (rootMenu && rootTrigger) {
+          rootMenu.markReturningFocus?.();
+          rootTrigger.focus({ preventScroll: true, focusVisible: !fromPointer });
+          rootMenu.hidePopover();
+        }
+      });
+    });
+
+    // Close every open menu when focus lands outside the menu system (treating menubar as inside)
+    document.addEventListener('focusin', event => {
+      if (menubar?.contains(event.target)) return;
+      rootTriggers.map(menuFor).filter(isOpen).forEach(menu => menu.hidePopover());
+    });
+  </script>
+
 </body>
 
 </html>
