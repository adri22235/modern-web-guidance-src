+  <script>
+    (function () {
+      const menubar = document.querySelector('[role="menubar"]');
+      if (!menubar) return;
+
+      const menuItems = Array.from(menubar.querySelectorAll('.menubar-item'));
+      const triggers = menuItems.map(item => item.querySelector('.menubar-trigger'));
+
+      function closeAllMenus() {
+        menuItems.forEach(item => {
+          item.classList.remove('open');
+          const trigger = item.querySelector('.menubar-trigger');
+          if (trigger) trigger.setAttribute('aria-expanded', 'false');
+        });
+      }
+
+      function openMenu(index, focusFirstItem = false) {
+        closeAllMenus();
+        const item = menuItems[index];
+        if (!item) return;
+        item.classList.add('open');
+        const trigger = item.querySelector('.menubar-trigger');
+        if (trigger) trigger.setAttribute('aria-expanded', 'true');
+
+        if (focusFirstItem) {
+          const firstSubItem = item.querySelector('.app-submenu [role="menuitem"]');
+          if (firstSubItem) firstSubItem.focus();
+        }
+      }
+
+      triggers.forEach((trigger, index) => {
+        trigger.addEventListener('click', (e) => {
+          const parent = menuItems[index];
+          const isOpen = parent.classList.contains('open');
+          if (!isOpen) {
+            e.preventDefault();
+            openMenu(index, false);
+          } else {
+            closeAllMenus();
+          }
+        });
+
+        trigger.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowRight') {
+            e.preventDefault();
+            const nextIndex = (index + 1) % triggers.length;
+            triggers[nextIndex].focus();
+            if (menuItems[index].classList.contains('open')) {
+              openMenu(nextIndex, false);
+            }
+          } else if (e.key === 'ArrowLeft') {
+            e.preventDefault();
+            const prevIndex = (index - 1 + triggers.length) % triggers.length;
+            triggers[prevIndex].focus();
+            if (menuItems[index].classList.contains('open')) {
+              openMenu(prevIndex, false);
+            }
+          } else if (e.key === 'ArrowDown' || e.key === ' ' || e.key === 'Enter') {
+            e.preventDefault();
+            openMenu(index, true);
+          } else if (e.key === 'Escape') {
+            closeAllMenus();
+            trigger.focus();
+          }
+        });
+      });
+
+      menuItems.forEach((item, menuIndex) => {
+        const subItems = Array.from(item.querySelectorAll('.app-submenu [role="menuitem"]'));
+        subItems.forEach((subItem, subIndex) => {
+          subItem.addEventListener('keydown', (e) => {
+            if (e.key === 'ArrowDown') {
+              e.preventDefault();
+              const nextSub = subItems[(subIndex + 1) % subItems.length];
+              nextSub.focus();
+            } else if (e.key === 'ArrowUp') {
+              e.preventDefault();
+              const prevSub = subItems[(subIndex - 1 + subItems.length) % subItems.length];
+              prevSub.focus();
+            } else if (e.key === 'ArrowRight') {
+              e.preventDefault();
+              const nextMenuIndex = (menuIndex + 1) % triggers.length;
+              triggers[nextMenuIndex].focus();
+              openMenu(nextMenuIndex, true);
+            } else if (e.key === 'ArrowLeft') {
+              e.preventDefault();
+              const prevMenuIndex = (menuIndex - 1 + triggers.length) % triggers.length;
+              triggers[prevMenuIndex].focus();
+              openMenu(prevMenuIndex, true);
+            } else if (e.key === 'Escape') {
+              e.preventDefault();
+              closeAllMenus();
+              triggers[menuIndex].focus();
+            }
+          });
+        });
+      });
+
+      document.addEventListener('click', (e) => {
+        if (!menubar.contains(e.target)) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
