+  <script>
+    function updateMapleOatLatteCountdown() {
+      const remainingEl = document.getElementById('maple-countdown-remaining');
+      const elapsedEl = document.getElementById('maple-countdown-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promotionStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const offerEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const remainingDuration = now.until(offerEnd, {
+        largestUnit: 'days',
+        smallestUnit: 'hours'
+      });
+
+      const elapsedDuration = now.since(promotionStart, {
+        largestUnit: 'days',
+        smallestUnit: 'hours'
+      });
+
+      if (Temporal.ZonedDateTime.compare(now, offerEnd) >= 0) {
+        remainingEl.textContent = `Offer ended (0 days, 0 hours left)`;
+      } else {
+        remainingEl.textContent = `${remainingDuration.days} days, ${remainingDuration.hours} hours left until March 1, 2026`;
+      }
+
+      elapsedEl.textContent = `Time elapsed since promo start: ${elapsedDuration.days} days, ${elapsedDuration.hours} hours (${userTimeZone})`;
+    }
+
+    document.addEventListener('DOMContentLoaded', updateMapleOatLatteCountdown);
+  </script>
+
