+  <script>
+    function initializeCountdown() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      const statusEl = document.getElementById('maple-oat-status');
+
+      if (!remainingEl || !elapsedEl || !statusEl) return;
+
+      // 1. Get the current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // 2. Combine separate date and time strings using Temporal methods
+      const startDateStr = '2026-01-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr)
+        .toPlainDateTime(startTimeStr)
+        .toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr)
+        .toPlainDateTime(endTimeStr)
+        .toZonedDateTime(tz);
+
+      // 3. Calculate elapsed and remaining durations balanced to days and hours
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // 4. Format durations for human display via Intl.DurationFormat (.toLocaleString)
+      // and machine-readable ISO 8601 strings via .toString()
+      elapsedEl.textContent = timeActive.toLocaleString('en-US', { style: 'long' });
+      elapsedEl.setAttribute('datetime', timeActive.toString());
+
+      remainingEl.textContent = timeRemaining.toLocaleString('en-US', { style: 'long' });
+      remainingEl.setAttribute('datetime', timeRemaining.toString());
+
+      // 5. Check status via .sign and compare durations with Temporal.Duration.compare()
+      const isExpired = timeRemaining.sign < 0;
+      const isPastHalfway = Temporal.Duration.compare(timeActive, timeRemaining, { relativeTo: now }) > 0;
+
+      if (isExpired) {
+        statusEl.textContent = 'Offer ended (March 1, 2026)';
+      } else if (isPastHalfway) {
+        statusEl.textContent = 'Hurry! Over halfway through the promotion';
+      } else {
+        statusEl.textContent = 'Limited-Time Seasonal Offer';
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initializeCountdown);
+      } else {
+        initializeCountdown();
+      }
+    })();
+  </script>
