+  <script>
+    const searchInput = document.getElementById("search-input");
+    const menuGrid = document.getElementById("menu-grid");
+
+    // Collect and cache text nodes inside menu cards using TreeWalker
+    const treeWalker = document.createTreeWalker(menuGrid, NodeFilter.SHOW_TEXT);
+    const allTextNodes = [];
+    let currentNode = treeWalker.nextNode();
+    while (currentNode) {
+      if (currentNode.parentElement && currentNode.parentElement.closest(".card") && currentNode.textContent.trim()) {
+        allTextNodes.push(currentNode);
+      }
+      currentNode = treeWalker.nextNode();
+    }
+
+    function updateSearchHighlights() {
+      const term = searchInput.value.trim().toLowerCase();
+
+      if (CSS.highlights) {
+        CSS.highlights.clear();
+        if (!term) return;
+
+        const matchingRanges = [];
+        for (const textNode of allTextNodes) {
+          const text = textNode.textContent.toLowerCase();
+          let matchStartIndex = text.indexOf(term);
+          while (matchStartIndex !== -1) {
+            const matchEndIndex = matchStartIndex + term.length;
+            const range = new Range();
+            range.setStart(textNode, matchStartIndex);
+            range.setEnd(textNode, matchEndIndex);
+            matchingRanges.push(range);
+            matchStartIndex = text.indexOf(term, matchEndIndex);
+          }
+        }
+
+        if (matchingRanges.length > 0) {
+          const searchHighlight = new Highlight(...matchingRanges);
+          CSS.highlights.set("search-results", searchHighlight);
+        }
+      } else {
+        for (const mark of menuGrid.querySelectorAll("mark[data-search-highlight]")) {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        }
+        menuGrid.normalize();
+        if (!term) return;
+
+        const walker = document.createTreeWalker(menuGrid, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+          if (n.parentElement && n.parentElement.closest(".card") && n.textContent.trim()) {
+            nodes.push(n);
+          }
+        }
+
+        for (const textNode of nodes) {
+          const text = textNode.textContent;
+          let pos = text.toLowerCase().indexOf(term);
+          if (pos === -1) continue;
+
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          while (pos !== -1) {
+            frag.append(text.slice(last, pos));
+            const mark = document.createElement("mark");
+            mark.dataset.searchHighlight = "";
+            mark.textContent = text.slice(pos, pos + term.length);
+            frag.append(mark);
+            last = pos + term.length;
+            pos = text.toLowerCase().indexOf(term, last);
+          }
+          frag.append(text.slice(last));
+          textNode.replaceWith(frag);
+        }
+      }
+    }
+
+    searchInput.addEventListener("input", updateSearchHighlights);
+  </script>
