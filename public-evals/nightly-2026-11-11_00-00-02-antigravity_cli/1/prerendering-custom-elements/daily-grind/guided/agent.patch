+          background: #fff8e1;
+          border-color: var(--_card-accent);
+        }
+      </style>
+      <article class="card" part="card">
+        <div class="card-header">
+          <slot name="header"></slot>
+          <button type="button" id="favorite-toggle" class="favorite-btn" part="favorite" aria-pressed="false" aria-label="Favorite drink">
+            <span class="heart" aria-hidden="true">♡</span>
+            <span class="fav-label">Favorite</span>
+          </button>
+        </div>
+        <div class="body">
+          <slot></slot>
+        </div>
+        <div class="details" id="details-panel" part="details" hidden>
+          <slot name="details"></slot>
+        </div>
+        <div class="actions">
+          <button type="button" id="toggle" class="btn" part="toggle" aria-expanded="false" aria-controls="details-panel">
+            View Details
+          </button>
+        </div>
+      </article>
+    `;
+
+    const supportsDeclarativeShadowDOM = Object.hasOwn(
+      HTMLTemplateElement.prototype,
+      'shadowRootMode'
+    );
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['open', 'favorited'];
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals =
+          typeof this.attachInternals === 'function' ? this.attachInternals() : null;
+
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // only attach a shadow root if absent (e.g. engines without shadowRootMode
+        // or dynamically constructed instances).
+        if (!this.shadowRoot) {
+          const declarativeTemplate = !supportsDeclarativeShadowDOM
+            ? this.querySelector(':scope > template[shadowrootmode]')
+            : this.querySelector(':scope > template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' });
+          if (declarativeTemplate) {
+            this.shadowRoot.append(declarativeTemplate.content.cloneNode(true));
+            declarativeTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach event listeners once against the existing
+        // shadow root markup without re-rendering or replacing nodes.
+        this.shadowRoot
+          .getElementById('toggle')
+          ?.addEventListener('click', () => {
+            this.open = !this.open;
+            this.dispatchEvent(
+              new CustomEvent('toggle', {
+                detail: { open: this.open, drinkId: this.getAttribute('drink-id') },
+                bubbles: true,
+                composed: true,
+              })
+            );
+          });
+
+        this.shadowRoot
+          .getElementById('favorite-toggle')
+          ?.addEventListener('click', () => {
+            this.favorited = !this.favorited;
+            this.dispatchEvent(
+              new CustomEvent('change', {
+                detail: { favorited: this.favorited, drinkId: this.getAttribute('drink-id') },
+                bubbles: true,
+                composed: true,
+              })
+            );
+          });
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(on) {
+        this.toggleAttribute('open', Boolean(on));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(on) {
+        this.toggleAttribute('favorited', Boolean(on));
+      }
+
+      connectedCallback() {
+        this.#syncState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#syncState();
+        }
+      }
+
+      #syncState() {
+        const isOpen = this.open;
+        const isFav = this.favorited;
+
+        if (this.#internals?.states) {
+          if (isOpen) {
+            this.#internals.states.add('expanded');
+          } else {
+            this.#internals.states.delete('expanded');
+          }
+          if (isFav) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+
+        const toggleBtn = this.shadowRoot?.getElementById('toggle');
+        const detailsPanel = this.shadowRoot?.getElementById('details-panel');
+        if (toggleBtn && toggleBtn.getAttribute('aria-expanded') !== String(isOpen)) {
+          toggleBtn.setAttribute('aria-expanded', String(isOpen));
+          toggleBtn.textContent = isOpen ? 'Hide Details' : 'View Details';
+        }
+        if (detailsPanel && detailsPanel.hasAttribute('hidden') === isOpen) {
+          detailsPanel.toggleAttribute('hidden', !isOpen);
+        }
+
+        const favBtn = this.shadowRoot?.getElementById('favorite-toggle');
+        if (favBtn && favBtn.getAttribute('aria-pressed') !== String(isFav)) {
+          favBtn.setAttribute('aria-pressed', String(isFav));
+          const heart = favBtn.querySelector('.heart');
+          if (heart) heart.textContent = isFav ? '♥' : '♡';
+          const label = favBtn.querySelector('.fav-label');
+          if (label) label.textContent = isFav ? 'Favorited' : 'Favorite';
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
