+  <script type="module">
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'expanded'];
+      }
+
+      constructor() {
+        super();
+        // Hydrate existing Declarative Shadow DOM in place without re-creating or re-rendering
+        if (!this.shadowRoot) {
+          const template = this.querySelector('template[shadowrootmode]');
+          if (template) {
+            const mode = template.getAttribute('shadowrootmode') || 'open';
+            const root = this.attachShadow({ mode });
+            root.appendChild(template.content.cloneNode(true));
+            template.remove();
+          }
+        }
+
+        this._onToggleFavorite = this._onToggleFavorite.bind(this);
+        this._onToggleDetails = this._onToggleDetails.bind(this);
+      }
+
+      connectedCallback() {
+        if (!this.shadowRoot) return;
+
+        this._favBtn = this.shadowRoot.querySelector('[data-action="favorite"]');
+        this._detailsBtn = this.shadowRoot.querySelector('[data-action="details"]');
+        this._detailsPanel = this.shadowRoot.getElementById('details-panel');
+
+        if (this._favBtn) {
+          this._favBtn.addEventListener('click', this._onToggleFavorite);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.addEventListener('click', this._onToggleDetails);
+        }
+
+        this._syncState();
+      }
+
+      disconnectedCallback() {
+        if (this._favBtn) {
+          this._favBtn.removeEventListener('click', this._onToggleFavorite);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onToggleDetails);
+        }
+      }
+
+      attributeChangedCallback() {
+        this._syncState();
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        if (val) {
+          this.setAttribute('favorited', '');
+        } else {
+          this.removeAttribute('favorited');
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(val) {
+        if (val) {
+          this.setAttribute('expanded', '');
+        } else {
+          this.removeAttribute('expanded');
+        }
+      }
+
+      _onToggleFavorite() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(
+          new CustomEvent('drink-favorite-toggle', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              drinkId: this.getAttribute('drink-id'),
+              favorited: this.favorited,
+            },
+          })
+        );
+      }
+
+      _onToggleDetails() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(
+          new CustomEvent('drink-details-toggle', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              drinkId: this.getAttribute('drink-id'),
+              expanded: this.expanded,
+            },
+          })
+        );
+      }
+
+      _syncState() {
+        if (!this.shadowRoot) return;
+
+        if (this._favBtn) {
+          const isFav = this.favorited;
+          this._favBtn.setAttribute('aria-pressed', String(isFav));
+          const icon = this._favBtn.querySelector('span');
+          if (icon) {
+            icon.textContent = isFav ? '♥' : '♡';
+          }
+        }
+
+        if (this._detailsBtn && this._detailsPanel) {
+          const isExp = this.expanded;
+          this._detailsBtn.setAttribute('aria-expanded', String(isExp));
+          this._detailsBtn.textContent = isExp ? 'Hide Details' : 'View Details';
+          this._detailsPanel.hidden = !isExp;
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
