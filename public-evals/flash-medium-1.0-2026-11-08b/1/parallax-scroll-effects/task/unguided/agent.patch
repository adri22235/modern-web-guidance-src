+  <script>
+    (function () {
+      'use strict';
+
+      const section = document.getElementById('craft-journey');
+      if (!section) return;
+
+      const layers = section.querySelectorAll('[data-parallax-speed]');
+      if (!layers.length) return;
+
+      // Accessibility: query user's motion preference
+      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let prefersReducedMotion = motionQuery.matches;
+
+      // Visibility state tracked by IntersectionObserver to eliminate off-screen work
+      let isVisible = false;
+      let ticking = false;
+
+      function resetTransforms() {
+        for (let i = 0; i < layers.length; i++) {
+          layers[i].style.transform = '';
+        }
+      }
+
+      function updateParallax() {
+        ticking = false;
+
+        if (prefersReducedMotion || !isVisible) {
+          return;
+        }
+
+        const rect = section.getBoundingClientRect();
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+
+        // Calculate offset relative to the center of the viewport
+        const sectionCenter = rect.top + rect.height / 2;
+        const viewportCenter = viewportHeight / 2;
+        const deltaY = sectionCenter - viewportCenter;
+
+        // Scale motion appropriately on smaller viewports to prevent collisions
+        const isMobile = window.innerWidth < 960;
+        const scaleFactor = isMobile ? 0.4 : 1.0;
+
+        for (let i = 0; i < layers.length; i++) {
+          const layer = layers[i];
+          const speed = parseFloat(layer.getAttribute('data-parallax-speed')) || 0;
+          const translateY = (deltaY * speed * scaleFactor).toFixed(2);
+          layer.style.transform = `translate3d(0, ${translateY}px, 0)`;
+        }
+      }
+
+      function requestTick() {
+        if (!ticking && isVisible && !prefersReducedMotion) {
+          ticking = true;
+          window.requestAnimationFrame(updateParallax);
+        }
+      }
+
+      function onScroll() {
+        requestTick();
+      }
+
+      function onResize() {
+        requestTick();
+      }
+
+      // Dynamically react if the user toggles prefers-reduced-motion
+      if (typeof motionQuery.addEventListener === 'function') {
+        motionQuery.addEventListener('change', function (e) {
+          prefersReducedMotion = e.matches;
+          if (prefersReducedMotion) {
+            resetTransforms();
+          } else {
+            requestTick();
+          }
+        });
+      } else if (typeof motionQuery.addListener === 'function') {
+        motionQuery.addListener(function (e) {
+          prefersReducedMotion = e.matches;
+          if (prefersReducedMotion) {
+            resetTransforms();
+          } else {
+            requestTick();
+          }
+        });
+      }
+
+      // IntersectionObserver ensures animations only compute when visible in/near viewport
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries) {
+            for (let i = 0; i < entries.length; i++) {
+              if (entries[i].target === section) {
+                isVisible = entries[i].isIntersecting;
+                if (isVisible) {
+                  requestTick();
+                }
+              }
+            }
+          },
+          {
+            root: null,
+            rootMargin: '120px 0px 120px 0px',
+            threshold: 0
+          }
+        );
+
+        observer.observe(section);
+      } else {
+        isVisible = true;
+      }
+
+      // Passive listeners keep scrolling at 60/120 fps without blocking the main thread
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onResize, { passive: true });
+
+      // Initial alignment
+      if (!prefersReducedMotion) {
+        requestTick();
+      }
+    })();
+  </script>
