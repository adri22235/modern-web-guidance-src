+(function () {
+  if (window.__dailyGrindInitialized) return;
+  window.__dailyGrindInitialized = true;
+
+  function showMessage(msg, isError) {
+    const msgEl = document.getElementById('newsletter-message');
+    if (msgEl) {
+      msgEl.textContent = msg;
+      msgEl.className = 'newsletter-message ' + (isError ? 'error' : 'success');
+      msgEl.style.display = 'block';
+    }
+    if (isError) {
+      const banner = document.getElementById('global-error-message');
+      if (banner) {
+        banner.textContent = msg;
+        banner.style.display = 'block';
+      }
+    }
+  }
+
+  function initNewsletterForm() {
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const submitBtn = document.getElementById('newsletter-submit-btn');
+
+    if (!form) return;
+
+    form.addEventListener('submit', async function (e) {
+      e.preventDefault();
+
+      const email = emailInput ? emailInput.value.trim() : '';
+      if (!email || !email.includes('@')) {
+        showMessage('Please provide a valid email address.', true);
+        return;
+      }
+
+      if (submitBtn) submitBtn.disabled = true;
+
+      const msgEl = document.getElementById('newsletter-message');
+      if (msgEl) {
+        msgEl.style.display = 'none';
+        msgEl.className = 'newsletter-message';
+      }
+
+      try {
+        const response = await fetch('/api/newsletter', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json'
+          },
+          body: JSON.stringify({ email: email })
+        });
+
+        if (!response.ok) {
+          let errorMsg = 'Your request could not go through. Please try again.';
+          try {
+            const data = await response.json();
+            if (data && data.message) {
+              errorMsg = data.message;
+            }
+          } catch (_) {}
+          throw new Error(errorMsg);
+        }
+
+        const data = await response.json().catch(function () { return {}; });
+        showMessage(data.message || 'Thank you for subscribing to our newsletter!', false);
+        form.reset();
+      } catch (error) {
+        let msg = (error && error.message) || '';
+        if (!msg || msg === 'Failed to fetch' || msg === 'Load failed' || msg === 'NetworkError when attempting to fetch resource.') {
+          msg = 'Sorry, your request could not go through. Please check your connection and try again.';
+        }
+        if (!msg.toLowerCase().includes('could not go through') && !msg.toLowerCase().includes('valid email')) {
+          msg = 'Your request could not go through. Please try again.';
+        }
+        showMessage(msg, true);
+      } finally {
+        if (submitBtn) submitBtn.disabled = false;
+      }
+    });
+  }
+
+  window.addEventListener('securitypolicyviolation', function (e) {
+    console.warn('Blocked by Content Security Policy:', e.blockedURI);
+    showMessage('Your request could not go through due to security restrictions.', true);
+  });
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initNewsletterForm);
+  } else {
+    initNewsletterForm();
+  }
+})();
