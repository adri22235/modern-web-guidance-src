@@ -0,0 +1,141 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const PORT = process.env.PORT || 11222;
+
+const CSP_DIRECTIVES = [
+  "default-src 'self' https://images.unsplash.com https://*.unsplash.com https://unsplash.com",
+  "connect-src 'self' https://images.unsplash.com https://*.unsplash.com https://unsplash.com",
+  "img-src 'self' https://images.unsplash.com https://*.unsplash.com https://unsplash.com data:",
+  "style-src 'self' 'unsafe-inline' https://images.unsplash.com https://*.unsplash.com https://unsplash.com",
+  "script-src 'self' 'unsafe-inline'",
+  "font-src 'self'",
+  "form-action 'self'",
+  "base-uri 'self'"
+];
+
+const CSP_HEADER = CSP_DIRECTIVES.join('; ');
+
+const subscribers = [];
+
+function setSecurityHeaders(res, contentType = 'text/html; charset=utf-8') {
+  res.setHeader('Content-Type', contentType);
+  res.setHeader('Content-Security-Policy', CSP_HEADER);
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+}
+
+const server = http.createServer((req, res) => {
+  const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+  const pathname = parsedUrl.pathname;
+
+  // Handle newsletter subscription endpoint
+  if (req.method === 'POST' && (
+    pathname === '/api/newsletter' ||
+    pathname === '/newsletter' ||
+    pathname === '/subscribe' ||
+    pathname === '/api/subscribe'
+  )) {
+    let body = '';
+    req.on('data', chunk => {
+      body += chunk.toString();
+      if (body.length > 1e6) {
+        req.destroy();
+      }
+    });
+
+    req.on('end', () => {
+      let email = '';
+      const contentType = req.headers['content-type'] || '';
+
+      if (contentType.includes('application/json')) {
+        try {
+          const data = JSON.parse(body);
+          email = typeof data.email === 'string' ? data.email.trim() : '';
+        } catch (_) {
+          setSecurityHeaders(res, 'application/json; charset=utf-8');
+          res.writeHead(400);
+          res.end(JSON.stringify({ success: false, message: 'Invalid JSON payload.' }));
+          return;
+        }
+      } else {
+        const params = new URLSearchParams(body);
+        email = (params.get('email') || '').trim();
+      }
+
+      if (!email || !email.includes('@') || email.indexOf('@') === 0 || email.indexOf('@') === email.length - 1) {
+        setSecurityHeaders(res, 'application/json; charset=utf-8');
+        res.writeHead(400);
+        res.end(JSON.stringify({ success: false, message: 'Please provide a valid email address.' }));
+        return;
+      }
+
+      subscribers.push({ email, subscribedAt: new Date().toISOString() });
+
+      setSecurityHeaders(res, 'application/json; charset=utf-8');
+      res.writeHead(200);
+      res.end(JSON.stringify({ success: true, message: 'Thank you for subscribing to our newsletter!' }));
+    });
+    return;
+  }
+
+  // Handle GET / HEAD requests for static files
+  if (req.method === 'GET' || req.method === 'HEAD') {
+    let relativePath = pathname === '/' || pathname === '/index.html' ? 'index.html' : pathname.slice(1);
+    const safePath = path.normalize(relativePath).replace(/^(\.\.[\/\\])+/, '');
+    const filePath = path.join(__dirname, safePath);
+
+    if (!filePath.startsWith(__dirname)) {
+      setSecurityHeaders(res, 'text/plain; charset=utf-8');
+      res.writeHead(403);
+      res.end('Forbidden');
+      return;
+    }
+
+    fs.stat(filePath, (err, stats) => {
+      if (err || !stats.isFile()) {
+        setSecurityHeaders(res, 'text/plain; charset=utf-8');
+        res.writeHead(404);
+        res.end('Not Found');
+        return;
+      }
+
+      const ext = path.extname(filePath).toLowerCase();
+      const mimeTypes = {
+        '.html': 'text/html; charset=utf-8',
+        '.js': 'application/javascript; charset=utf-8',
+        '.css': 'text/css; charset=utf-8',
+        '.json': 'application/json; charset=utf-8',
+        '.png': 'image/png',
+        '.jpg': 'image/jpeg',
+        '.jpeg': 'image/jpeg',
+        '.svg': 'image/svg+xml',
+        '.ico': 'image/x-icon'
+      };
+
+      const contentType = mimeTypes[ext] || 'application/octet-stream';
+      setSecurityHeaders(res, contentType);
+      res.writeHead(200);
+
+      if (req.method === 'HEAD') {
+        res.end();
+        return;
+      }
+
+      fs.createReadStream(filePath).pipe(res);
+    });
+    return;
+  }
+
+  setSecurityHeaders(res, 'text/plain; charset=utf-8');
+  res.writeHead(405);
+  res.end('Method Not Allowed');
+});
+
+if (require.main === module) {
+  server.listen(PORT, () => {
+    console.log(`Server running at http://localhost:${PORT}/`);
+  });
+}
+
+module.exports = server;
