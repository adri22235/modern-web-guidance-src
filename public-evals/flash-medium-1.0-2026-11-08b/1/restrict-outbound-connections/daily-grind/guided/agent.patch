+// Daily Grind - Newsletter and Client-side Outbound Request Handling
+
+/**
+ * Client-side helper that catches blocked outbound requests gracefully without unhandled rejections.
+ * Conforms to modern-web-guidance for restrict-outbound-connections.
+ */
+export async function fetchWithPolicyHandling(url, options = {}) {
+  const { statusElement, ...fetchOptions } = options;
+  try {
+    const response = await fetch(url, fetchOptions);
+    if (!response.ok) {
+      let errorMsg = `HTTP ${response.status}`;
+      try {
+        const errorData = await response.json();
+        if (errorData && (errorData.message || errorData.error)) {
+          errorMsg = errorData.message || errorData.error;
+        }
+      } catch (_) {}
+      throw new Error(errorMsg);
+    }
+
+    const contentType = response.headers.get('content-type') || '';
+    const body = contentType.includes('application/json')
+      ? await response.json()
+      : await response.text();
+
+    if (statusElement) {
+      const msg = (body && typeof body === 'object' && body.message)
+        ? body.message
+        : 'Thank you for subscribing to The Daily Grind!';
+      statusElement.textContent = msg;
+      statusElement.className = 'form-status success';
+    }
+    return { ok: true, body, error: null };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (statusElement) {
+      statusElement.textContent = `Sorry, your request could not go through. (${message})`;
+      statusElement.className = 'form-status error';
+    }
+    return { ok: false, body: null, error };
+  }
+}
+
+// Expose on window for accessibility and testing
+if (typeof window !== 'undefined') {
+  window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+}
+
+function initNewsletter() {
+  if (typeof window === 'undefined' || window.__dailyGrindNewsletterInit) return;
+  window.__dailyGrindNewsletterInit = true;
+
+  const form = document.getElementById('newsletter-form');
+  const emailInput =
+    document.getElementById('newsletter-email') ||
+    document.getElementById('email') ||
+    document.querySelector('input[type="email"]') ||
+    document.querySelector('input[name="email"]');
+  const submitBtn = document.getElementById('newsletter-submit-btn') || form?.querySelector('button[type="submit"]');
+  const statusDiv = document.getElementById('newsletter-status');
+
+  if (!form || !emailInput || !statusDiv) return;
+
+  // Listen for security policy violations (e.g., CSP or connection allowlist blocks)
+  window.addEventListener('securitypolicyviolation', (event) => {
+    if (statusDiv) {
+      statusDiv.textContent = `A request to ${event.blockedURI || 'an external host'} could not go through (blocked by security policy).`;
+      statusDiv.className = 'form-status error';
+    }
+  });
+
+  // Handle unhandled rejections that might be caused by blocked network connections
+  window.addEventListener('unhandledrejection', (event) => {
+    if (statusDiv && (!statusDiv.textContent || statusDiv.textContent.includes('Subscribing'))) {
+      statusDiv.textContent = 'Sorry, your request could not go through. Please try again.';
+      statusDiv.className = 'form-status error';
+    }
+  });
+
+  // Clear errors on input
+  emailInput.addEventListener('input', () => {
+    if (emailInput.getAttribute('aria-invalid') === 'true') {
+      emailInput.removeAttribute('aria-invalid');
+    }
+    if (statusDiv.classList.contains('error')) {
+      statusDiv.textContent = '';
+      statusDiv.className = 'form-status';
+    }
+  });
+
+  // Form submission handler
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+
+    const email = emailInput.value.trim();
+
+    // Client-side validation
+    if (!email || !emailInput.checkValidity()) {
+      emailInput.setAttribute('aria-invalid', 'true');
+      statusDiv.textContent = 'Please enter a valid email address.';
+      statusDiv.className = 'form-status error';
+      emailInput.focus();
+      return;
+    }
+
+    emailInput.removeAttribute('aria-invalid');
+    if (submitBtn) submitBtn.disabled = true;
+    statusDiv.textContent = 'Submitting...';
+    statusDiv.className = 'form-status info';
+
+    const targetUrl = form.getAttribute('action') || '/api/newsletter';
+
+    const result = await fetchWithPolicyHandling(targetUrl, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'Accept': 'application/json',
+      },
+      body: JSON.stringify({ email }),
+      statusElement: statusDiv,
+    });
+
+    if (result.ok) {
+      form.reset();
+      emailInput.removeAttribute('aria-invalid');
+    } else {
+      emailInput.setAttribute('aria-invalid', 'true');
+      if (!statusDiv.textContent.includes('could not go through')) {
+        statusDiv.textContent = 'Sorry, your request could not go through. Please try again.';
+        statusDiv.className = 'form-status error';
+      }
+    }
+
+    if (submitBtn) submitBtn.disabled = false;
+  });
+
+  // Handle URL query parameters if redirected after standard POST
+  try {
+    const params = new URLSearchParams(window.location.search);
+    if (params.get('subscribed') === 'true') {
+      statusDiv.textContent = 'Thank you for subscribing to The Daily Grind!';
+      statusDiv.className = 'form-status success';
+    } else if (params.get('error')) {
+      statusDiv.textContent = 'Sorry, your request could not go through. Please try again.';
+      statusDiv.className = 'form-status error';
+    }
+  } catch (_) {}
+}
+
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initNewsletter);
+  } else {
+    initNewsletter();
+  }
+}
