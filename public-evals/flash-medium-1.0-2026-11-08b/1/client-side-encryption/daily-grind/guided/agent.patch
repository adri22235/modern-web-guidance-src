@@ -0,0 +1,417 @@
+/**
+ * Web Cryptography delivery notes encryption engine.
+ *
+ * Implements:
+ * - Post-quantum hybrid Key Encapsulation Mechanism (MLKEM768-X25519)
+ * - Standalone post-quantum KEMs (ML-KEM-768, ML-KEM-1024)
+ * - Classical ephemeral-static key agreement fallback (X25519 + HKDF + AES-GCM)
+ * - Authenticated Encryption with Associated Data (ChaCha20-Poly1305 and AES-GCM)
+ *
+ * Follows modern WebCrypto specifications and Web Guidance for client-side encryption.
+ */
+
+export const SUITES = {
+  HYBRID_MLKEM768: 'MLKEM768-X25519',
+  PQ_MLKEM768: 'ML-KEM-768',
+  PQ_MLKEM1024: 'ML-KEM-1024',
+  CLASSICAL_X25519: 'X25519+HKDF+AES-GCM',
+};
+
+export const KEM_PUBLIC_KEY_SIZES = {
+  1216: 'MLKEM768-X25519',
+  1184: 'ML-KEM-768',
+  1568: 'ML-KEM-1024',
+  32: 'X25519',
+};
+
+export const HKDF_INFO = new TextEncoder().encode('daily-grind-encrypted-delivery-notes-v1');
+
+/**
+ * Checks if SubtleCrypto.supports() static method is available.
+ */
+export function isSubtleCryptoSupportsAvailable() {
+  return typeof globalThis.SubtleCrypto?.supports === 'function';
+}
+
+/**
+ * Detects if a KEM and AEAD suite is supported natively.
+ */
+export function supportsKemSuite(kemName = 'MLKEM768-X25519', aeadName = 'ChaCha20-Poly1305') {
+  if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+    return SubtleCrypto.supports('encapsulateKey', kemName, aeadName);
+  }
+  return false;
+}
+
+/**
+ * Detects if post-quantum hybrid envelope encryption is supported.
+ */
+export function supportsPostQuantumEnvelope() {
+  return supportsKemSuite('MLKEM768-X25519', 'ChaCha20-Poly1305');
+}
+
+/**
+ * Inspects all cryptographic suites and returns their availability status.
+ */
+export function getAvailableSuites() {
+  const hybridSupported = supportsKemSuite('MLKEM768-X25519', 'ChaCha20-Poly1305');
+  const pq768Supported = supportsKemSuite('ML-KEM-768', 'ChaCha20-Poly1305');
+  const pq1024Supported = supportsKemSuite('ML-KEM-1024', 'ChaCha20-Poly1305');
+
+  return [
+    {
+      id: SUITES.HYBRID_MLKEM768,
+      name: 'MLKEM768-X25519 + ChaCha20-Poly1305',
+      label: 'Hybrid Post-Quantum + Classical (FIPS 203 + X25519)',
+      description: 'NIST ML-KEM-768 combined with classical X25519. Maximum safety against both present and quantum threats.',
+      isPostQuantum: true,
+      isHybrid: true,
+      aead: 'ChaCha20-Poly1305',
+      supported: hybridSupported,
+      recommended: hybridSupported,
+    },
+    {
+      id: SUITES.PQ_MLKEM768,
+      name: 'ML-KEM-768 + ChaCha20-Poly1305',
+      label: 'Standalone Post-Quantum (NIST Category 3 / FIPS 203)',
+      description: 'Standardized lattice-based KEM without classical hybrid component (~192-bit quantum security).',
+      isPostQuantum: true,
+      isHybrid: false,
+      aead: 'ChaCha20-Poly1305',
+      supported: pq768Supported,
+      recommended: false,
+    },
+    {
+      id: SUITES.PQ_MLKEM1024,
+      name: 'ML-KEM-1024 + ChaCha20-Poly1305',
+      label: 'Highest Margin Post-Quantum (NIST Category 5 / CNSA 2.0)',
+      description: 'Maximum security margin lattice-based KEM (~256-bit security level).',
+      isPostQuantum: true,
+      isHybrid: false,
+      aead: 'ChaCha20-Poly1305',
+      supported: pq1024Supported,
+      recommended: false,
+    },
+    {
+      id: SUITES.CLASSICAL_X25519,
+      name: 'X25519 + HKDF-SHA256 + AES-GCM-256',
+      label: 'Classical Diffie-Hellman Fallback (Baseline Widely Available)',
+      description: 'Standard classical elliptic-curve key agreement for legacy environments.',
+      isPostQuantum: false,
+      isHybrid: false,
+      aead: 'AES-GCM',
+      supported: true,
+      recommended: !hybridSupported,
+    },
+  ];
+}
+
+/**
+ * Encode Uint8Array to Base64 string.
+ */
+export function bytesToBase64(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64();
+  }
+  let binary = '';
+  const len = bytes.byteLength;
+  for (let i = 0; i < len; i += 8192) {
+    binary += String.fromCharCode.apply(null, bytes.subarray(i, Math.min(i + 8192, len)));
+  }
+  return btoa(binary);
+}
+
+/**
+ * Decode Base64 string to Uint8Array.
+ */
+export function base64ToBytes(base64) {
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(base64);
+  }
+  const binary = atob(base64.trim());
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Convert bytes to lowercase hexadecimal string.
+ */
+export function bytesToHex(bytes) {
+  return Array.from(bytes)
+    .map((b) => b.toString(16).padStart(2, '0'))
+    .join('');
+}
+
+/**
+ * Computes a short SHA-256 key fingerprint (e.g. 16 hex characters).
+ */
+export async function computeFingerprint(bytes) {
+  const hash = await crypto.subtle.digest('SHA-256', bytes);
+  return bytesToHex(new Uint8Array(hash)).slice(0, 16);
+}
+
+/**
+ * Generates a recipient key pair for the given suite.
+ * - Non-extractable private key for security.
+ * - Exports raw-public or raw public key bytes.
+ */
+export async function generateRecipientKeyPair(suiteId = SUITES.HYBRID_MLKEM768) {
+  if (suiteId === SUITES.CLASSICAL_X25519) {
+    const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw', keyPair.publicKey)
+    );
+    const fingerprint = await computeFingerprint(publicKeyBytes);
+    return {
+      suiteId,
+      keyPair,
+      publicKeyBytes,
+      fingerprint,
+    };
+  }
+
+  // Post-quantum KEM suite (MLKEM768-X25519, ML-KEM-768, or ML-KEM-1024)
+  const keyPair = await crypto.subtle.generateKey(suiteId, false, [
+    'encapsulateKey',
+    'decapsulateKey',
+  ]);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw-public', keyPair.publicKey)
+  );
+  const fingerprint = await computeFingerprint(publicKeyBytes);
+  return {
+    suiteId,
+    keyPair,
+    publicKeyBytes,
+    fingerprint,
+  };
+}
+
+/**
+ * Imports a recipient's public key from raw bytes.
+ */
+export async function importPublicKey(publicKeyBytes, suiteId) {
+  const bytes =
+    publicKeyBytes instanceof Uint8Array
+      ? publicKeyBytes
+      : new Uint8Array(publicKeyBytes);
+
+  if (suiteId === SUITES.CLASSICAL_X25519 || bytes.byteLength === 32) {
+    return crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+  }
+
+  const kemName = suiteId || KEM_PUBLIC_KEY_SIZES[bytes.byteLength] || 'MLKEM768-X25519';
+  return crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey']);
+}
+
+/**
+ * Helper to derive AES-GCM key from X25519 shared secret using HKDF.
+ */
+async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = HKDF_INFO) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt']
+  );
+}
+
+/**
+ * Encapsulates a one-time shared AEAD key against a recipient's public key.
+ *
+ * Returns:
+ * - sharedKey: CryptoKey for AEAD encryption
+ * - capsuleBytes: Uint8Array containing the ciphertext capsule to send to the recipient
+ */
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  suiteId = SUITES.HYBRID_MLKEM768,
+  infoBytes = HKDF_INFO
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await importPublicKey(recipientPublicKeyOrBytes, suiteId);
+
+  if (pubKey.algorithm.name === 'X25519') {
+    // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+    const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    const capsuleBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw', ephemeral.publicKey)
+    );
+    const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+    return { sharedKey, capsuleBytes, suiteId: SUITES.CLASSICAL_X25519 };
+  }
+
+  // Modern Post-Quantum KEM
+  const kemAlgorithm = pubKey.algorithm.name;
+  const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+    kemAlgorithm,
+    pubKey,
+    'ChaCha20-Poly1305',
+    false,
+    ['encrypt', 'decrypt']
+  );
+
+  return {
+    sharedKey,
+    capsuleBytes: new Uint8Array(ciphertext),
+    suiteId: kemAlgorithm,
+  };
+}
+
+/**
+ * Decapsulates a shared key using the recipient's private key and ciphertext capsule.
+ */
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  suiteId = SUITES.HYBRID_MLKEM768,
+  infoBytes = HKDF_INFO
+) {
+  if (recipientPrivateKey.algorithm.name === 'X25519') {
+    const ephemeralPubKey = await crypto.subtle.importKey(
+      'raw',
+      capsuleBytes,
+      'X25519',
+      true,
+      []
+    );
+    return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+  }
+
+  return crypto.subtle.decapsulateKey(
+    recipientPrivateKey.algorithm.name,
+    recipientPrivateKey,
+    capsuleBytes,
+    'ChaCha20-Poly1305',
+    false,
+    ['encrypt', 'decrypt']
+  );
+}
+
+/**
+ * Encrypts UTF-8 plaintext with an AEAD CryptoKey (ChaCha20-Poly1305 or AES-GCM).
+ * Always generates a fresh, random 12-byte IV.
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded
+  );
+
+  return {
+    iv,
+    ciphertext: new Uint8Array(ciphertextBuffer),
+  };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload.
+ * Throws OperationError if tampered or AAD mismatch.
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+/**
+ * Creates an end-to-end encrypted delivery note package.
+ */
+export async function createEncryptedDeliveryPackage({
+  recipientPublicKeyBytes,
+  suiteId = SUITES.HYBRID_MLKEM768,
+  plaintext,
+  orderId = '',
+  address = '',
+}) {
+  // Bind orderId and address into additionalData for tamper-proofing
+  const aadString = JSON.stringify({ orderId, address });
+  const additionalData = new TextEncoder().encode(aadString);
+
+  // Encapsulate shared key
+  const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+    recipientPublicKeyBytes,
+    suiteId
+  );
+
+  // Encrypt with AEAD
+  const { iv, ciphertext } = await encryptMessage(sharedKey, plaintext, additionalData);
+
+  return {
+    version: '1.0',
+    suiteId,
+    aead: sharedKey.algorithm.name,
+    orderId,
+    address,
+    capsuleBase64: bytesToBase64(capsuleBytes),
+    ivBase64: bytesToBase64(iv),
+    ciphertextBase64: bytesToBase64(ciphertext),
+    aadString,
+    createdAt: new Date().toISOString(),
+  };
+}
+
+/**
+ * Opens and decrypts an encrypted delivery note package with the recipient's private key.
+ */
+export async function openEncryptedDeliveryPackage({
+  packageData,
+  recipientPrivateKey,
+}) {
+  const capsuleBytes = base64ToBytes(packageData.capsuleBase64);
+  const iv = base64ToBytes(packageData.ivBase64);
+  const ciphertext = base64ToBytes(packageData.ciphertextBase64);
+  const additionalData = new TextEncoder().encode(packageData.aadString);
+
+  // Decapsulate shared AEAD key
+  const sharedKey = await decapsulateEnvelopeKey(
+    recipientPrivateKey,
+    capsuleBytes,
+    packageData.suiteId
+  );
+
+  // Decrypt and authenticate ciphertext
+  const decryptedNote = await decryptMessage(sharedKey, iv, ciphertext, additionalData);
+
+  return {
+    orderId: packageData.orderId,
+    address: packageData.address,
+    decryptedNote,
+    suiteId: packageData.suiteId,
+    aead: packageData.aead,
+    createdAt: packageData.createdAt,
+  };
+}
