+import {
+  SUITES,
+  getAvailableSuites,
+  generateRecipientKeyPair,
+  importPublicKey,
+  encapsulateEnvelopeKey,
+  decapsulateEnvelopeKey,
+  encryptMessage,
+  decryptMessage,
+  createEncryptedDeliveryPackage,
+  openEncryptedDeliveryPackage,
+  bytesToBase64,
+  base64ToBytes,
+  computeFingerprint,
+} from '../delivery-crypto.js';
+
+async function runTests() {
+  console.log('Testing delivery-crypto.js...');
+
+  // 1. Suite discovery
+  const suites = getAvailableSuites();
+  console.log('Available suites count:', suites.length);
+  const hybridSuite = suites.find((s) => s.id === SUITES.HYBRID_MLKEM768);
+  if (!hybridSuite) throw new Error('Hybrid suite missing');
+
+  // Test Base64 roundtrip
+  const sampleBytes = new Uint8Array([0, 15, 255, 128, 42, 99]);
+  const b64 = bytesToBase64(sampleBytes);
+  const roundtripBytes = base64ToBytes(b64);
+  if (roundtripBytes.length !== sampleBytes.length || roundtripBytes[2] !== 255) {
+    throw new Error('Base64 roundtrip failed');
+  }
+
+  // Test all supported suites
+  for (const suite of suites) {
+    if (!suite.supported) {
+      console.log(`Skipping unsupported suite: ${suite.id}`);
+      continue;
+    }
+
+    console.log(`\nTesting Suite: ${suite.id} (${suite.aead})`);
+
+    // A. Key Generation
+    const recipient = await generateRecipientKeyPair(suite.id);
+    if (!recipient.keyPair || !recipient.publicKeyBytes) {
+      throw new Error(`Failed to generate recipient keys for ${suite.id}`);
+    }
+    console.log(`- Generated key pair, public key size: ${recipient.publicKeyBytes.byteLength} bytes`);
+    console.log(`- Fingerprint: ${recipient.fingerprint}`);
+
+    // B. Encapsulation & Decapsulation
+    const { sharedKey: senderSharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+      recipient.publicKeyBytes,
+      suite.id
+    );
+    console.log(`- Encapsulated key, capsule size: ${capsuleBytes.byteLength} bytes`);
+
+    const recipientSharedKey = await decapsulateEnvelopeKey(
+      recipient.keyPair.privateKey,
+      capsuleBytes,
+      suite.id
+    );
+    console.log(`- Decapsulated key on recipient`);
+
+    // C. Encryption & Decryption
+    const note = 'Sensitive note: Gate code is 8821. Key under the flowerpot.';
+    const aad = new TextEncoder().encode('AAD-ORDER-101');
+    const { iv, ciphertext } = await encryptMessage(senderSharedKey, note, aad);
+    console.log(`- Encrypted note, ciphertext size: ${ciphertext.byteLength} bytes, IV: ${iv.byteLength} bytes`);
+
+    const decryptedNote = await decryptMessage(recipientSharedKey, iv, ciphertext, aad);
+    if (decryptedNote !== note) {
+      throw new Error(`Decrypted note does not match original! Expected "${note}", got "${decryptedNote}"`);
+    }
+    console.log(`- Successfully decrypted and authenticated note`);
+
+    // D. Tamper testing - Ciphertext
+    const tamperedCiphertext = new Uint8Array(ciphertext);
+    tamperedCiphertext[tamperedCiphertext.length - 1] ^= 0x01;
+    let tamperDetected = false;
+    try {
+      await decryptMessage(recipientSharedKey, iv, tamperedCiphertext, aad);
+    } catch (e) {
+      tamperDetected = true;
+    }
+    if (!tamperDetected) {
+      throw new Error('Authenticated encryption failed to detect tampered ciphertext!');
+    }
+    console.log(`- Correctly rejected tampered ciphertext`);
+
+    // E. Tamper testing - AAD
+    const tamperedAad = new TextEncoder().encode('AAD-ORDER-TAMPERED');
+    let aadTamperDetected = false;
+    try {
+      await decryptMessage(recipientSharedKey, iv, ciphertext, tamperedAad);
+    } catch (e) {
+      aadTamperDetected = true;
+    }
+    if (!aadTamperDetected) {
+      throw new Error('Authenticated encryption failed to detect tampered AAD!');
+    }
+    console.log(`- Correctly rejected tampered AAD`);
+
+    // F. High-level package workflow
+    const pkg = await createEncryptedDeliveryPackage({
+      recipientPublicKeyBytes: recipient.publicKeyBytes,
+      suiteId: suite.id,
+      plaintext: 'Package Test: Leave behind counter #3',
+      orderId: 'DG-TEST-99',
+      address: '123 Coffee Lane',
+    });
+
+    const opened = await openEncryptedDeliveryPackage({
+      packageData: pkg,
+      recipientPrivateKey: recipient.keyPair.privateKey,
+    });
+
+    if (opened.decryptedNote !== 'Package Test: Leave behind counter #3') {
+      throw new Error('Package decryption failed');
+    }
+    console.log(`- High-level package workflow verified for ${suite.id}`);
+  }
+
+  console.log('\n=============================');
+  console.log('ALL CRYPTO TESTS PASSED 100%!');
+  console.log('=============================');
+}
+
+runTests().catch((err) => {
+  console.error('Test failed:', err);
+  process.exit(1);
+});
