@@ -0,0 +1,524 @@
+/**
+ * UI Controller for Daily Grind Encrypted Delivery Notes.
+ *
+ * Implements accessible form handling, post-quantum hybrid KEM key establishment,
+ * authenticated client-side AEAD encryption, recipient decapsulation, and tampering checks.
+ */
+
+import {
+  SUITES,
+  getAvailableSuites,
+  generateRecipientKeyPair,
+  createEncryptedDeliveryPackage,
+  openEncryptedDeliveryPackage,
+  bytesToBase64,
+  computeFingerprint,
+} from './delivery-crypto.js';
+
+// State for active recipient key pair and encrypted packages
+let currentRecipient = null;
+let savedPackages = [];
+
+// Fallback sample data if storage is empty
+const SAMPLE_PACKAGES = [
+  {
+    orderId: 'DG-2026-7814',
+    address: '42 Maple Street, Apt 3B',
+    note: 'Gate code is #9021. Please place coffee in the weather-proof parcel bin by the porch swing.',
+  },
+];
+
+/**
+ * Initializes the delivery notes feature on the homepage.
+ */
+export async function initDeliveryNotes() {
+  const container = document.getElementById('encrypted-delivery-section');
+  if (!container) return;
+
+  // Initialize suites and recipient key pair
+  const suites = getAvailableSuites();
+  renderSuiteOptions(suites);
+  updateStatusBanner(suites);
+
+  // Initialize default dispatch recipient key pair (Hybrid MLKEM768-X25519 if supported, else X25519)
+  const defaultSuite = suites.find((s) => s.recommended) || suites[0];
+  await setupRecipientKeys(defaultSuite.id);
+
+  // Wire up UI events
+  setupEventListeners();
+
+  // Populate sample note into store
+  await seedInitialPackage(defaultSuite.id);
+  renderSavedNotesList();
+}
+
+/**
+ * Updates the platform crypto support banner.
+ */
+function updateStatusBanner(suites) {
+  const badgeEl = document.getElementById('crypto-support-badge');
+  const detailsEl = document.getElementById('crypto-support-details');
+  if (!badgeEl) return;
+
+  const hybrid = suites.find((s) => s.id === SUITES.HYBRID_MLKEM768);
+  if (hybrid && hybrid.supported) {
+    badgeEl.textContent = '🛡️ Post-Quantum Hybrid Active (MLKEM768-X25519 + ChaCha20-Poly1305)';
+    badgeEl.className = 'security-badge badge-quantum';
+    detailsEl.textContent =
+      'WebCrypto native quantum-resistant Key Encapsulation (FIPS 203) combined with classical X25519 and ChaCha20-Poly1305 authenticated encryption is active in this browser.';
+  } else {
+    badgeEl.textContent = '🔒 Classical Security Active (X25519 + HKDF + AES-GCM-256)';
+    badgeEl.className = 'security-badge badge-classical';
+    detailsEl.textContent =
+      'Running in classical authenticated key agreement mode (X25519 with 256-bit AES-GCM AEAD).';
+  }
+}
+
+/**
+ * Generates and sets up the dispatch center recipient key pair.
+ */
+async function setupRecipientKeys(suiteId) {
+  const statusEl = document.getElementById('recipient-key-status');
+  const fingerprintEl = document.getElementById('recipient-fingerprint');
+  const sizeEl = document.getElementById('recipient-key-size');
+
+  try {
+    currentRecipient = await generateRecipientKeyPair(suiteId);
+
+    if (statusEl) {
+      statusEl.textContent = `Dispatch Key Active (${currentRecipient.suiteId})`;
+    }
+    if (fingerprintEl) {
+      fingerprintEl.textContent = currentRecipient.fingerprint;
+    }
+    if (sizeEl) {
+      sizeEl.textContent = `${currentRecipient.publicKeyBytes.byteLength} bytes`;
+    }
+
+    const pubKeyBase64El = document.getElementById('recipient-pubkey-base64');
+    if (pubKeyBase64El) {
+      pubKeyBase64El.value = bytesToBase64(currentRecipient.publicKeyBytes);
+    }
+  } catch (err) {
+    console.error('Failed to setup recipient keys:', err);
+    if (statusEl) {
+      statusEl.textContent = `Key Error: ${err.message}`;
+    }
+  }
+}
+
+/**
+ * Renders the radio button selection list for available cryptographic suites.
+ */
+function renderSuiteOptions(suites) {
+  const container = document.getElementById('suite-options-container');
+  if (!container) return;
+
+  container.innerHTML = '';
+
+  suites.forEach((suite, index) => {
+    const wrapper = document.createElement('div');
+    wrapper.className = `suite-option-card ${suite.supported ? '' : 'suite-disabled'}`;
+
+    const radioId = `suite-radio-${index}`;
+    const input = document.createElement('input');
+    input.type = 'radio';
+    input.id = radioId;
+    input.name = 'cryptoSuite';
+    input.value = suite.id;
+    input.disabled = !suite.supported;
+    if (suite.recommended) {
+      input.checked = true;
+    }
+
+    const label = document.createElement('label');
+    label.htmlFor = radioId;
+    label.innerHTML = `
+      <div class="suite-title">
+        <strong>${suite.label}</strong>
+        ${suite.recommended ? '<span class="tag tag-recommended">Recommended</span>' : ''}
+        ${suite.isPostQuantum ? '<span class="tag tag-pq">Post-Quantum</span>' : ''}
+        ${suite.isHybrid ? '<span class="tag tag-hybrid">Hybrid</span>' : ''}
+      </div>
+      <div class="suite-desc">${suite.description}</div>
+      <div class="suite-meta"><small>KEM / Agreement: <code>${suite.id}</code> | AEAD: <code>${suite.aead}</code></small></div>
+    `;
+
+    wrapper.appendChild(input);
+    wrapper.appendChild(label);
+    container.appendChild(wrapper);
+
+    input.addEventListener('change', async () => {
+      if (input.checked) {
+        await setupRecipientKeys(suite.id);
+      }
+    });
+  });
+}
+
+/**
+ * Attaches event listeners for tab switching, encryption, decryption, and tamper testing.
+ */
+function setupEventListeners() {
+  // Tab switching
+  const tabButtons = document.querySelectorAll('.tab-btn');
+  tabButtons.forEach((btn) => {
+    btn.addEventListener('click', () => {
+      tabButtons.forEach((b) => {
+        b.classList.remove('active');
+        b.setAttribute('aria-selected', 'false');
+      });
+      document.querySelectorAll('.tab-panel').forEach((p) => {
+        p.classList.remove('active');
+        p.hidden = true;
+      });
+
+      btn.classList.add('active');
+      btn.setAttribute('aria-selected', 'true');
+      const targetId = btn.getAttribute('data-target');
+      const targetPanel = document.getElementById(targetId);
+      if (targetPanel) {
+        targetPanel.classList.add('active');
+        targetPanel.hidden = false;
+      }
+    });
+  });
+
+  // Delivery Notes Form Submit (Encryption)
+  const form = document.getElementById('encrypt-note-form');
+  if (form) {
+    form.addEventListener('submit', handleEncryptSubmit);
+  }
+
+  // Clear Form Button
+  const clearBtn = document.getElementById('btn-clear-note-form');
+  if (clearBtn) {
+    clearBtn.addEventListener('click', () => {
+      form.reset();
+      const outputCard = document.getElementById('encrypted-output-card');
+      if (outputCard) outputCard.hidden = true;
+      announceLive('Form cleared.');
+    });
+  }
+
+  // Copy Encrypted JSON
+  const copyBtn = document.getElementById('btn-copy-package-json');
+  if (copyBtn) {
+    copyBtn.addEventListener('click', async () => {
+      const jsonEl = document.getElementById('output-package-json');
+      if (!jsonEl || !jsonEl.value) return;
+      try {
+        await navigator.clipboard.writeText(jsonEl.value);
+        copyBtn.textContent = 'Copied!';
+        setTimeout(() => (copyBtn.textContent = 'Copy Encrypted Package JSON'), 2000);
+      } catch {
+        jsonEl.select();
+        document.execCommand('copy');
+        copyBtn.textContent = 'Copied!';
+        setTimeout(() => (copyBtn.textContent = 'Copy Encrypted Package JSON'), 2000);
+      }
+    });
+  }
+
+  // Rotate Key Pair Button
+  const rotateBtn = document.getElementById('btn-rotate-recipient-keys');
+  if (rotateBtn) {
+    rotateBtn.addEventListener('click', async () => {
+      const selectedSuite = document.querySelector('input[name="cryptoSuite"]:checked')?.value || SUITES.HYBRID_MLKEM768;
+      rotateBtn.disabled = true;
+      rotateBtn.textContent = 'Generating...';
+      await setupRecipientKeys(selectedSuite);
+      rotateBtn.disabled = false;
+      rotateBtn.textContent = '🔄 Rotate Dispatch Key Pair';
+      announceLive('Dispatch recipient key pair rotated successfully.');
+    });
+  }
+
+  // Decrypt Note Button
+  const decryptBtn = document.getElementById('btn-decrypt-action');
+  if (decryptBtn) {
+    decryptBtn.addEventListener('click', handleDecryptAction);
+  }
+
+  // Tamper Ciphertext Button
+  const tamperCiphertextBtn = document.getElementById('btn-tamper-ciphertext');
+  if (tamperCiphertextBtn) {
+    tamperCiphertextBtn.addEventListener('click', handleTamperCiphertext);
+  }
+
+  // Tamper AAD Button
+  const tamperAadBtn = document.getElementById('btn-tamper-aad');
+  if (tamperAadBtn) {
+    tamperAadBtn.addEventListener('click', handleTamperAad);
+  }
+}
+
+/**
+ * Handles submission of customer delivery note and client-side encryption.
+ */
+async function handleEncryptSubmit(e) {
+  e.preventDefault();
+
+  const orderIdInput = document.getElementById('note-order-id');
+  const addressInput = document.getElementById('note-address');
+  const noteTextInput = document.getElementById('note-plaintext');
+  const submitBtn = document.getElementById('btn-submit-encrypt');
+
+  const orderId = orderIdInput.value.trim();
+  const address = addressInput.value.trim();
+  const plaintext = noteTextInput.value.trim();
+
+  if (!plaintext) {
+    alert('Please enter delivery instructions.');
+    noteTextInput.focus();
+    return;
+  }
+
+  const selectedSuite =
+    document.querySelector('input[name="cryptoSuite"]:checked')?.value ||
+    currentRecipient?.suiteId ||
+    SUITES.HYBRID_MLKEM768;
+
+  try {
+    submitBtn.disabled = true;
+    submitBtn.textContent = '🔒 Establishing Secret & Encrypting...';
+
+    // 1. Establish shared secret and encrypt customer note client-side
+    const encryptedPkg = await createEncryptedDeliveryPackage({
+      recipientPublicKeyBytes: currentRecipient.publicKeyBytes,
+      suiteId: selectedSuite,
+      plaintext,
+      orderId: orderId || `DG-${Date.now().toString().slice(-4)}`,
+      address: address || 'Daily Grind Delivery',
+    });
+
+    // 2. Save into session packages
+    savedPackages.unshift(encryptedPkg);
+    renderSavedNotesList();
+
+    // 3. Display live output inspector
+    renderEncryptedOutput(encryptedPkg);
+
+    // 4. Update courier panel inputs with the newly encrypted package
+    const courierPkgInput = document.getElementById('courier-package-input');
+    if (courierPkgInput) {
+      courierPkgInput.value = JSON.stringify(encryptedPkg, null, 2);
+    }
+
+    announceLive(`Delivery note encrypted with ${selectedSuite} and authenticated successfully!`);
+  } catch (err) {
+    console.error('Encryption failed:', err);
+    alert(`Encryption failed: ${err.message}`);
+  } finally {
+    submitBtn.disabled = false;
+    submitBtn.textContent = '🔐 Encrypt & Submit Delivery Note';
+  }
+}
+
+/**
+ * Renders the cryptographic details of the encrypted payload.
+ */
+function renderEncryptedOutput(pkg) {
+  const outputCard = document.getElementById('encrypted-output-card');
+  if (!outputCard) return;
+
+  document.getElementById('out-suite').textContent = `${pkg.suiteId} + ${pkg.aead}`;
+  document.getElementById('out-capsule').textContent = pkg.capsuleBase64;
+  document.getElementById('out-iv').textContent = pkg.ivBase64;
+  document.getElementById('out-ciphertext').textContent = pkg.ciphertextBase64;
+  document.getElementById('out-aad').textContent = pkg.aadString;
+  document.getElementById('output-package-json').value = JSON.stringify(pkg, null, 2);
+
+  outputCard.hidden = false;
+  outputCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+}
+
+/**
+ * Handles courier decapsulation and decryption.
+ */
+async function handleDecryptAction() {
+  const courierPkgInput = document.getElementById('courier-package-input');
+  const decryptBtn = document.getElementById('btn-decrypt-action');
+  const resultCard = document.getElementById('decrypt-result-card');
+  const resultText = document.getElementById('decrypt-result-text');
+  const resultMeta = document.getElementById('decrypt-result-meta');
+  const resultBadge = document.getElementById('decrypt-status-badge');
+
+  if (!courierPkgInput || !courierPkgInput.value.trim()) {
+    alert('Please provide an encrypted package JSON.');
+    return;
+  }
+
+  try {
+    decryptBtn.disabled = true;
+    decryptBtn.textContent = '🔓 Decapsulating Shared Secret...';
+
+    const pkg = JSON.parse(courierPkgInput.value.trim());
+
+    // Decapsulate and decrypt with dispatch private key
+    const decrypted = await openEncryptedDeliveryPackage({
+      packageData: pkg,
+      recipientPrivateKey: currentRecipient.keyPair.privateKey,
+    });
+
+    resultCard.hidden = false;
+    resultCard.className = 'result-card success';
+    resultBadge.textContent = '✅ Authenticated & Decrypted Successfully';
+    resultBadge.className = 'badge badge-success';
+    resultText.textContent = decrypted.decryptedNote;
+    resultMeta.innerHTML = `
+      <strong>Order ID:</strong> ${decrypted.orderId} |
+      <strong>Delivery Address:</strong> ${decrypted.address} |
+      <strong>Suite:</strong> ${decrypted.suiteId} (${decrypted.aead})
+    `;
+
+    announceLive('Encrypted delivery note decapsulated and decrypted successfully.');
+  } catch (err) {
+    console.error('Decryption failed:', err);
+    resultCard.hidden = false;
+    resultCard.className = 'result-card error';
+    resultBadge.textContent = '❌ Authentication / Decryption Failed!';
+    resultBadge.className = 'badge badge-error';
+    resultText.textContent = `Security Rejection: ${err.name} - ${err.message}. The payload or authenticated data has been tampered with or corrupted.`;
+    resultMeta.innerHTML = '<strong>Tamper Alert:</strong> Authenticated encryption tag rejected this payload.';
+    announceLive('Decryption failed: Authenticated tag rejection.');
+  } finally {
+    decryptBtn.disabled = false;
+    decryptBtn.textContent = '🔓 Decapsulate Key & Decrypt Note';
+  }
+}
+
+/**
+ * Tamper simulation: modifies 1 byte of the ciphertext.
+ */
+function handleTamperCiphertext() {
+  const courierPkgInput = document.getElementById('courier-package-input');
+  if (!courierPkgInput || !courierPkgInput.value.trim()) {
+    alert('No package in courier input to tamper with.');
+    return;
+  }
+
+  try {
+    const pkg = JSON.parse(courierPkgInput.value.trim());
+    // Flip characters in ciphertext
+    const ct = pkg.ciphertextBase64;
+    const alteredChar = ct[0] === 'A' ? 'B' : 'A';
+    pkg.ciphertextBase64 = alteredChar + ct.slice(1);
+
+    courierPkgInput.value = JSON.stringify(pkg, null, 2);
+    announceLive('Ciphertext tampered! Click Decrypt to test authentication verification.');
+    alert('⚠️ Tamper Simulated: 1 byte of the ciphertext was modified. Click "Decapsulate Key & Decrypt Note" to verify that AEAD rejects it.');
+  } catch (err) {
+    alert('Invalid JSON in courier input: ' + err.message);
+  }
+}
+
+/**
+ * Tamper simulation: modifies the Associated Authenticated Data (AAD).
+ */
+function handleTamperAad() {
+  const courierPkgInput = document.getElementById('courier-package-input');
+  if (!courierPkgInput || !courierPkgInput.value.trim()) {
+    alert('No package in courier input to tamper with.');
+    return;
+  }
+
+  try {
+    const pkg = JSON.parse(courierPkgInput.value.trim());
+    pkg.aadString = JSON.stringify({ orderId: 'DG-TAMPERED-ATTACKER', address: 'Attacker Redirection' });
+    pkg.orderId = 'DG-TAMPERED-ATTACKER';
+
+    courierPkgInput.value = JSON.stringify(pkg, null, 2);
+    announceLive('Order ID / AAD tampered! Click Decrypt to test authentication verification.');
+    alert('⚠️ Tamper Simulated: Associated Authenticated Data (AAD) was modified to an attacker order ID. Click "Decapsulate Key & Decrypt Note" to verify that AEAD rejects it.');
+  } catch (err) {
+    alert('Invalid JSON in courier input: ' + err.message);
+  }
+}
+
+/**
+ * Renders the list of saved encrypted packages.
+ */
+function renderSavedNotesList() {
+  const container = document.getElementById('saved-notes-list');
+  if (!container) return;
+
+  if (savedPackages.length === 0) {
+    container.innerHTML = '<p class="empty-state">No encrypted delivery notes stored yet.</p>';
+    return;
+  }
+
+  container.innerHTML = '';
+  savedPackages.forEach((pkg, index) => {
+    const item = document.createElement('div');
+    item.className = 'saved-note-item';
+    item.innerHTML = `
+      <div class="note-header">
+        <span class="note-order"><strong>${pkg.orderId}</strong> (${pkg.address})</span>
+        <span class="note-suite-badge">${pkg.suiteId}</span>
+      </div>
+      <div class="note-preview">
+        <small>Encrypted Ciphertext: <code>${pkg.ciphertextBase64.slice(0, 36)}...</code> (${pkg.ciphertextBase64.length} chars)</small>
+      </div>
+      <div class="note-actions">
+        <button type="button" class="btn btn-sm btn-outline load-pkg-btn" data-index="${index}">
+          Load into Courier Decryptor
+        </button>
+      </div>
+    `;
+    container.appendChild(item);
+  });
+
+  container.querySelectorAll('.load-pkg-btn').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const idx = parseInt(btn.getAttribute('data-index'), 10);
+      const pkg = savedPackages[idx];
+      if (pkg) {
+        const courierPkgInput = document.getElementById('courier-package-input');
+        if (courierPkgInput) {
+          courierPkgInput.value = JSON.stringify(pkg, null, 2);
+        }
+        // Switch to courier tab
+        const courierTabBtn = document.querySelector('[data-target="panel-courier"]');
+        if (courierTabBtn) courierTabBtn.click();
+        courierPkgInput?.scrollIntoView({ behavior: 'smooth' });
+      }
+    });
+  });
+}
+
+/**
+ * Seeds an initial sample encrypted delivery note for immediate demo capability.
+ */
+async function seedInitialPackage(suiteId) {
+  try {
+    const sample = SAMPLE_PACKAGES[0];
+    const pkg = await createEncryptedDeliveryPackage({
+      recipientPublicKeyBytes: currentRecipient.publicKeyBytes,
+      suiteId,
+      plaintext: sample.note,
+      orderId: sample.orderId,
+      address: sample.address,
+    });
+    savedPackages.push(pkg);
+  } catch (err) {
+    console.warn('Could not seed initial package:', err);
+  }
+}
+
+/**
+ * Helper to announce messages to screen readers via aria-live.
+ */
+function announceLive(message) {
+  const liveEl = document.getElementById('crypto-live-announcer');
+  if (liveEl) {
+    liveEl.textContent = message;
+  }
+}
+
+// Auto-initialize when DOM is ready
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', initDeliveryNotes);
+} else {
+  initDeliveryNotes();
+}
