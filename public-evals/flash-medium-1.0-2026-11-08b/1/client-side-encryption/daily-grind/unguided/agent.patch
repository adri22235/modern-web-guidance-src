@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import {
+  KEM_ALGORITHMS,
+  generateKeyPair,
+  sealDeliveryNote,
+  openDeliveryNote
+} from '../src/crypto.js';
+
+async function runTests() {
+  console.log('Running Encrypted Delivery Notes Cryptographic Tests...\n');
+
+  const algorithms = Object.keys(KEM_ALGORITHMS);
+  assert(algorithms.length >= 4, 'Should support at least 4 algorithms');
+  console.log(`Registered algorithms (${algorithms.length}):`, algorithms.join(', '));
+
+  for (const algoId of algorithms) {
+    console.log(`\nTesting algorithm: ${algoId} (${KEM_ALGORITHMS[algoId].name})...`);
+
+    // 1. Key generation
+    const keyPair = generateKeyPair(algoId);
+    assert.ok(keyPair.publicKeyBase64, 'Public key should exist');
+    assert.ok(keyPair.secretKeyBase64, 'Secret key should exist');
+    assert.ok(keyPair.fingerprint, 'Fingerprint should exist');
+    console.log(`  ✓ Keypair generated (Fingerprint: ${keyPair.fingerprint})`);
+
+    // 2. Encryption / Sealing
+    const noteText = `Gate Code: #4829. Watch out for Buster the Lab. Order: ${algoId}`;
+    const orderId = `TEST-${Date.now().toString(36).toUpperCase()}`;
+
+    const sealResult = await sealDeliveryNote({
+      recipientPublicKeyBase64: keyPair.publicKeyBase64,
+      algorithmId: algoId,
+      note: noteText,
+      orderId,
+      metadata: { customerId: 'cust_7721' }
+    });
+
+    assert.ok(sealResult.envelope, 'Envelope should be generated');
+    assert.equal(sealResult.envelope.algorithm, algoId);
+    assert.equal(sealResult.envelope.orderId, orderId);
+    assert.ok(sealResult.envelope.kemCiphertext, 'KEM ciphertext should exist');
+    assert.ok(sealResult.envelope.ciphertext, 'AES ciphertext should exist');
+    assert.ok(sealResult.envelope.iv, 'IV should exist');
+    console.log(`  ✓ Note sealed with AEAD AES-256-GCM (CT len: ${sealResult.ciphertextBytes} bytes, KEM CT len: ${sealResult.kemCiphertextBytes} bytes)`);
+
+    // 3. Decryption / Opening
+    const openResult = await openDeliveryNote({
+      envelope: sealResult.envelope,
+      recipientSecretKeyBase64: keyPair.secretKeyBase64
+    });
+
+    assert.equal(openResult.plaintextNote, noteText, 'Decrypted text must match original note');
+    assert.equal(openResult.orderId, orderId);
+    assert.equal(openResult.verified, true);
+    assert.equal(openResult.sharedSecretHex, sealResult.sharedSecretHex, 'Derived shared secrets must match');
+    console.log('  ✓ Note successfully decapsulated and decrypted with tag verification');
+
+    // 4. Tamper Test: modified ciphertext byte
+    const tamperedEnvelope1 = JSON.parse(JSON.stringify(sealResult.envelope));
+    const ctBytes = Buffer.from(tamperedEnvelope1.ciphertext, 'base64');
+    ctBytes[0] ^= 0x01; // flip 1 bit
+    tamperedEnvelope1.ciphertext = ctBytes.toString('base64');
+
+    await assert.rejects(
+      async () => {
+        await openDeliveryNote({
+          envelope: tamperedEnvelope1,
+          recipientSecretKeyBase64: keyPair.secretKeyBase64
+        });
+      },
+      /Authenticated decryption failed/,
+      'Tampered ciphertext should fail AEAD authentication tag check'
+    );
+    console.log('  ✓ Tampered ciphertext rejected by AEAD tag check');
+
+    // 5. Tamper Test: modified Additional Authenticated Data (AAD)
+    const tamperedEnvelope2 = JSON.parse(JSON.stringify(sealResult.envelope));
+    tamperedEnvelope2.aad = tamperedEnvelope2.aad.replace(orderId, 'ATTACKER_ORDER_999');
+
+    await assert.rejects(
+      async () => {
+        await openDeliveryNote({
+          envelope: tamperedEnvelope2,
+          recipientSecretKeyBase64: keyPair.secretKeyBase64
+        });
+      },
+      /Authenticated decryption failed/,
+      'Tampered AAD should fail AEAD authentication tag check'
+    );
+    console.log('  ✓ Tampered AAD rejected by AEAD tag check');
+
+    // 6. Tamper Test: modified KEM ciphertext (flip byte in coordinate)
+    const tamperedEnvelope3 = JSON.parse(JSON.stringify(sealResult.envelope));
+    const kemCtBytes = Buffer.from(tamperedEnvelope3.kemCiphertext, 'base64');
+    kemCtBytes[kemCtBytes.length > 2 ? 2 : 0] ^= 0x01; // flip 1 bit in coordinate
+    tamperedEnvelope3.kemCiphertext = kemCtBytes.toString('base64');
+
+    await assert.rejects(
+      async () => {
+        await openDeliveryNote({
+          envelope: tamperedEnvelope3,
+          recipientSecretKeyBase64: keyPair.secretKeyBase64
+        });
+      },
+      /(KEM decapsulation failed|Authenticated decryption failed)/,
+      'Tampered KEM ciphertext should fail decapsulation or AEAD decryption'
+    );
+    console.log('  ✓ Tampered KEM ciphertext rejected');
+  }
+
+  console.log('\n🎉 ALL CRYPTOGRAPHIC TESTS PASSED SUCCESSFULLY!');
+}
+
+runTests().catch(err => {
+  console.error('Test failed:', err);
+  process.exit(1);
+});
