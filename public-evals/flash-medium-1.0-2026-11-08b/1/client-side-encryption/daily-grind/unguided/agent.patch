+import { ml_kem512, ml_kem768, ml_kem1024 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519, ml_kem768_p256, _ecdhKem } from '@noble/post-quantum/hybrid.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+import { p256 } from '@noble/curves/nist.js';
+import { hkdf } from '@noble/hashes/hkdf.js';
+import { sha256 } from '@noble/hashes/sha2.js';
+
+// Algorithm registry supporting Post-Quantum, Hybrid, and Classical key encapsulation / key agreement
+export const KEM_ALGORITHMS = {
+  'hybrid-x25519-mlkem768': {
+    id: 'hybrid-x25519-mlkem768',
+    name: 'Hybrid X25519 + ML-KEM-768 (Recommended)',
+    type: 'Hybrid Post-Quantum + Classical',
+    category: 'hybrid',
+    description: 'Combines classical X25519 ECDH with FIPS 203 ML-KEM-768 (Kyber). Dual-layer protection: secure if either scheme holds.',
+    pqcProtected: true,
+    classicalProtected: true,
+    kem: ml_kem768_x25519,
+    securityLevel: 'NIST Level 3 (128+ bit post-quantum & classical)'
+  },
+  'hybrid-p256-mlkem768': {
+    id: 'hybrid-p256-mlkem768',
+    name: 'Hybrid NIST P-256 + ML-KEM-768',
+    type: 'Hybrid Post-Quantum + Classical',
+    category: 'hybrid',
+    description: 'Combines NIST P-256 elliptic curve key agreement with FIPS 203 ML-KEM-768. Ideal for FIPS/NIST compliance.',
+    pqcProtected: true,
+    classicalProtected: true,
+    kem: ml_kem768_p256,
+    securityLevel: 'NIST Level 3 (128+ bit post-quantum & classical)'
+  },
+  'mlkem768': {
+    id: 'mlkem768',
+    name: 'ML-KEM-768 (FIPS 203 / Kyber-768)',
+    type: 'Pure Post-Quantum Lattice KEM',
+    category: 'post-quantum',
+    description: 'NIST standard for post-quantum key encapsulation based on Module Learning with Errors (MLWE). Resistant to quantum Shor attacks.',
+    pqcProtected: true,
+    classicalProtected: false,
+    kem: ml_kem768,
+    securityLevel: 'NIST Level 3 (AES-192 equivalent)'
+  },
+  'mlkem1024': {
+    id: 'mlkem1024',
+    name: 'ML-KEM-1024 (FIPS 203 / Kyber-1024)',
+    type: 'High-Security Post-Quantum Lattice KEM',
+    category: 'post-quantum',
+    description: 'Highest security level parameter set for NIST FIPS 203 Module-Lattice-Based Key-Encapsulation Mechanism.',
+    pqcProtected: true,
+    classicalProtected: false,
+    kem: ml_kem1024,
+    securityLevel: 'NIST Level 5 (AES-256 equivalent)'
+  },
+  'x25519': {
+    id: 'x25519',
+    name: 'Classical X25519 (ECDH Key Agreement)',
+    type: 'Classical Elliptic Curve Diffie-Hellman',
+    category: 'classical',
+    description: 'High-speed Montgomery curve Diffie-Hellman (RFC 7748). Provides classical forward secrecy (vulnerable to future cryptanalytically relevant quantum computers).',
+    pqcProtected: false,
+    classicalProtected: true,
+    kem: _ecdhKem(x25519),
+    securityLevel: '128-bit Classical Security'
+  },
+  'p256': {
+    id: 'p256',
+    name: 'Classical NIST P-256 (ECDH Key Agreement)',
+    type: 'Classical Elliptic Curve Diffie-Hellman',
+    category: 'classical',
+    description: 'Standard NIST P-256 prime-field elliptic curve Diffie-Hellman key agreement (SP 800-56A).',
+    pqcProtected: false,
+    classicalProtected: true,
+    kem: _ecdhKem(p256, true),
+    securityLevel: '128-bit Classical Security'
+  }
+};
+
+// Utilities for byte manipulation and base64 conversions
+export function bytesToBase64(bytes) {
+  let binary = '';
+  const len = bytes.byteLength;
+  for (let i = 0; i < len; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(base64) {
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToHex(bytes) {
+  return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function hexToBytes(hex) {
+  const cleanHex = hex.replace(/[^0-9a-fA-F]/g, '');
+  const bytes = new Uint8Array(cleanHex.length / 2);
+  for (let i = 0; i < cleanHex.length; i += 2) {
+    bytes[i / 2] = parseInt(cleanHex.slice(i, i + 2), 16);
+  }
+  return bytes;
+}
+
+/**
+ * Compute short SHA-256 fingerprint for display (e.g. key verification)
+ */
+export function getPublicKeyFingerprint(publicKeyBytes) {
+  const digest = sha256(publicKeyBytes);
+  const hex = bytesToHex(digest.slice(0, 8));
+  return hex.match(/.{1,4}/g).join(':').toUpperCase();
+}
+
+/**
+ * Generate a recipient public/private keypair using chosen KEM / key agreement algorithm
+ */
+export function generateKeyPair(algorithmId = 'hybrid-x25519-mlkem768') {
+  const algo = KEM_ALGORITHMS[algorithmId];
+  if (!algo) {
+    throw new Error(`Unsupported KEM algorithm: ${algorithmId}`);
+  }
+
+  const keys = algo.kem.keygen();
+  return {
+    algorithm: algorithmId,
+    publicKeyBytes: keys.publicKey,
+    secretKeyBytes: keys.secretKey,
+    publicKeyBase64: bytesToBase64(keys.publicKey),
+    secretKeyBase64: bytesToBase64(keys.secretKey),
+    fingerprint: getPublicKeyFingerprint(keys.publicKey)
+  };
+}
+
+/**
+ * Derive AES-256-GCM symmetric key from KEM shared secret via HKDF-SHA256
+ */
+export function deriveSymmetricKey(sharedSecretBytes, contextString = 'TheDailyGrind-DeliveryNote-v1') {
+  const encoder = new TextEncoder();
+  const salt = encoder.encode('DailyGrind-HKDF-Salt-2026');
+  const info = encoder.encode(contextString);
+  const keyBytes = hkdf(sha256, sharedSecretBytes, salt, info, 32);
+  return keyBytes;
+}
+
+/**
+ * Encapsulate a shared secret and encrypt sensitive delivery notes using Authenticated Encryption (AES-256-GCM)
+ * 
+ * @param {Object} options
+ * @param {string} options.recipientPublicKeyBase64 - Recipient's public key in base64
+ * @param {string} options.algorithmId - Key agreement / KEM algorithm
+ * @param {string} options.note - Sensitive customer note plaintext
+ * @param {string} options.orderId - Customer Order ID (used as Additional Authenticated Data)
+ * @param {Object} [options.metadata] - Optional additional metadata bound to encryption
+ * @returns {Promise<Object>} Encrypted delivery note envelope
+ */
+export async function sealDeliveryNote({
+  recipientPublicKeyBase64,
+  algorithmId = 'hybrid-x25519-mlkem768',
+  note,
+  orderId = 'DG-' + Math.floor(100000 + Math.random() * 900000),
+  metadata = {}
+}) {
+  const algo = KEM_ALGORITHMS[algorithmId];
+  if (!algo) {
+    throw new Error(`Unsupported KEM algorithm: ${algorithmId}`);
+  }
+
+  if (!note || note.trim().length === 0) {
+    throw new Error('Delivery note content cannot be empty.');
+  }
+
+  const recipientPublicKey = base64ToBytes(recipientPublicKeyBase64);
+
+  // 1. Establish shared secret via Public-Key Encapsulation (KEM) / Key Agreement
+  const encapResult = algo.kem.encapsulate(recipientPublicKey);
+  const kemCipherText = encapResult.cipherText;
+  const rawSharedSecret = encapResult.sharedSecret;
+
+  // 2. Derive 256-bit AEAD key using HKDF-SHA256
+  const aesKeyBytes = deriveSymmetricKey(rawSharedSecret, `TheDailyGrind:${algorithmId}:AES-256-GCM`);
+
+  // 3. Import key into Web Crypto API for hardware-accelerated AES-256-GCM
+  const cryptoKey = await crypto.subtle.importKey(
+    'raw',
+    aesKeyBytes,
+    { name: 'AES-GCM' },
+    false,
+    ['encrypt']
+  );
+
+  // 4. Generate 96-bit (12-byte) cryptographically secure random nonce/IV
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+
+  // 5. Construct Additional Authenticated Data (AAD) to bind ciphertext to order context
+  const timestamp = new Date().toISOString();
+  const aadPayload = JSON.stringify({
+    orderId,
+    algorithm: algorithmId,
+    timestamp,
+    ...metadata
+  });
+  const encoder = new TextEncoder();
+  const aadBytes = encoder.encode(aadPayload);
+  const plaintextBytes = encoder.encode(note);
+
+  // 6. Encrypt with Authenticated Encryption (AES-256-GCM)
+  // Web Crypto encrypt with AES-GCM appends the 128-bit authentication tag at the end of ciphertext
+  const encryptedBuffer = await crypto.subtle.encrypt(
+    {
+      name: 'AES-GCM',
+      iv,
+      additionalData: aadBytes,
+      tagLength: 128
+    },
+    cryptoKey,
+    plaintextBytes
+  );
+  const cipherTextWithTag = new Uint8Array(encryptedBuffer);
+
+  // 7. Assemble complete, self-contained encrypted envelope
+  const envelope = {
+    version: '1.0',
+    type: 'DailyGrindEncryptedDeliveryNote',
+    orderId,
+    algorithm: algorithmId,
+    algorithmName: algo.name,
+    pqcProtected: algo.pqcProtected,
+    classicalProtected: algo.classicalProtected,
+    securityLevel: algo.securityLevel,
+    timestamp,
+    aad: aadPayload,
+    kemCiphertext: bytesToBase64(kemCipherText),
+    iv: bytesToBase64(iv),
+    ciphertext: bytesToBase64(cipherTextWithTag),
+    recipientFingerprint: getPublicKeyFingerprint(recipientPublicKey)
+  };
+
+  return {
+    envelope,
+    sharedSecretHex: bytesToHex(rawSharedSecret),
+    sharedSecretFingerprint: getPublicKeyFingerprint(rawSharedSecret),
+    aesKeyFingerprint: getPublicKeyFingerprint(aesKeyBytes),
+    kemCiphertextBytes: kemCipherText.length,
+    ciphertextBytes: cipherTextWithTag.length,
+    aadString: aadPayload
+  };
+}
+
+/**
+ * Decapsulate shared secret and decrypt sensitive delivery notes with AEAD tag verification
+ * 
+ * @param {Object} options
+ * @param {Object} options.envelope - The encrypted delivery note envelope
+ * @param {string} options.recipientSecretKeyBase64 - Recipient's secret key in base64
+ * @returns {Promise<Object>} Decrypted note and verification report
+ */
+export async function openDeliveryNote({
+  envelope,
+  recipientSecretKeyBase64
+}) {
+  if (!envelope || !envelope.algorithm || !envelope.kemCiphertext || !envelope.ciphertext || !envelope.iv) {
+    throw new Error('Invalid envelope format: missing required cryptographic fields.');
+  }
+
+  const algo = KEM_ALGORITHMS[envelope.algorithm];
+  if (!algo) {
+    throw new Error(`Unsupported KEM algorithm in envelope: ${envelope.algorithm}`);
+  }
+
+  let secretKeyBytes, kemCipherText, cipherTextWithTag, iv, aadBytes;
+  try {
+    secretKeyBytes = base64ToBytes(recipientSecretKeyBase64);
+    kemCipherText = base64ToBytes(envelope.kemCiphertext);
+    cipherTextWithTag = base64ToBytes(envelope.ciphertext);
+    iv = base64ToBytes(envelope.iv);
+    aadBytes = new TextEncoder().encode(envelope.aad);
+  } catch (err) {
+    throw new Error(`Invalid base64 payload in envelope or key: ${err.message}`);
+  }
+
+  // 1. Decapsulate shared secret using Recipient's Private Key
+  let rawSharedSecret;
+  try {
+    rawSharedSecret = algo.kem.decapsulate(kemCipherText, secretKeyBytes);
+  } catch (err) {
+    throw new Error(`KEM decapsulation failed: ${err.message || 'Invalid ciphertext or private key'}`);
+  }
+
+  // 2. Derive 256-bit AEAD key using HKDF-SHA256
+  const aesKeyBytes = deriveSymmetricKey(rawSharedSecret, `TheDailyGrind:${envelope.algorithm}:AES-256-GCM`);
+
+  // 3. Import key for AES-GCM decryption
+  const cryptoKey = await crypto.subtle.importKey(
+    'raw',
+    aesKeyBytes,
+    { name: 'AES-GCM' },
+    false,
+    ['decrypt']
+  );
+
+  // 4. Decrypt and verify authenticated ciphertext & tag against AAD
+  let decryptedBuffer;
+  try {
+    decryptedBuffer = await crypto.subtle.decrypt(
+      {
+        name: 'AES-GCM',
+        iv,
+        additionalData: aadBytes,
+        tagLength: 128
+      },
+      cryptoKey,
+      cipherTextWithTag
+    );
+  } catch (err) {
+    throw new Error('Authenticated decryption failed: Ciphertext, IV, or Additional Authenticated Data has been tampered with or corrupted!');
+  }
+
+  const decryptedNote = new TextDecoder().decode(decryptedBuffer);
+
+  return {
+    plaintextNote: decryptedNote,
+    orderId: envelope.orderId,
+    algorithm: envelope.algorithm,
+    algorithmName: envelope.algorithmName,
+    pqcProtected: envelope.pqcProtected,
+    classicalProtected: envelope.classicalProtected,
+    timestamp: envelope.timestamp,
+    sharedSecretHex: bytesToHex(rawSharedSecret),
+    sharedSecretFingerprint: getPublicKeyFingerprint(rawSharedSecret),
+    aesKeyFingerprint: getPublicKeyFingerprint(aesKeyBytes),
+    verified: true
+  };
+}
