+import {
+  KEM_ALGORITHMS,
+  generateKeyPair,
+  sealDeliveryNote,
+  openDeliveryNote,
+  getPublicKeyFingerprint,
+  bytesToHex,
+  base64ToBytes
+} from './crypto.js';
+
+// Application State for the Encrypted Delivery Notes feature
+const state = {
+  selectedAlgorithm: 'hybrid-x25519-mlkem768',
+  keyPairs: {}, // Cache of keypairs per algorithm
+  lastSealedEnvelope: null,
+  orderId: 'DG-' + Math.floor(100000 + Math.random() * 900000)
+};
+
+// Preset sample delivery notes
+const PRESETS = [
+  {
+    title: '🚪 Gate Code & Pet Warning',
+    text: 'Gate code is #8421. Please place cold brew on the wooden bench by the side door. Watch out for Buster (friendly Golden Retriever in yard)!'
+  },
+  {
+    title: '🏢 Apartment Intercom & Elevator',
+    text: 'Buzzer #14B (Smith). Please take elevator to 4th floor and leave whole-bean espresso package outside unit 402. No need to knock.'
+  },
+  {
+    title: '📦 Porch Lockbox Dropoff',
+    text: 'Porch lockbox code is 9204. Please slide the coffee tins inside and latch closed so they stay out of direct morning sunlight.'
+  },
+  {
+    title: '🛎️ Front Desk Concierge',
+    text: 'Building concierge holds all deliveries. Deliver to security desk under order name "Sarah M." Contact (555) 019-2831 upon arrival.'
+  }
+];
+
+function initializeKeyPairs() {
+  // Generate keypairs for each algorithm once on init
+  for (const algoId of Object.keys(KEM_ALGORITHMS)) {
+    try {
+      state.keyPairs[algoId] = generateKeyPair(algoId);
+    } catch (err) {
+      console.warn(`Failed to initialize keypair for ${algoId}:`, err);
+    }
+  }
+}
+
+export function initEncryptedNotes() {
+  initializeKeyPairs();
+  renderApp();
+}
+
+function renderApp() {
+  const container = document.getElementById('encrypted-delivery-container');
+  if (!container) return;
+
+  container.innerHTML = `
+    <div class="edn-card">
+      <div class="edn-header">
+        <div class="edn-title-group">
+          <span class="edn-badge-pqc">FIPS 203 Quantum-Resilient</span>
+          <h2>Encrypted Delivery Notes</h2>
+          <p>
+            Protect sensitive customer dropoff instructions (gate codes, lockboxes, alarm details) with 
+            browser-side authenticated encryption and post-quantum hybrid key encapsulation.
+          </p>
+        </div>
+        <div class="edn-tabs">
+          <button id="edn-tab-seal" class="edn-tab-btn active">1. Customer: Seal Delivery Note</button>
+          <button id="edn-tab-open" class="edn-tab-btn">2. Courier: Dispatch Reader Terminal</button>
+        </div>
+      </div>
+
+      <!-- TAB 1: CUSTOMER ENCRYPTION -->
+      <div id="edn-panel-seal" class="edn-panel active">
+        <div class="edn-grid">
+          <!-- Left Column: Configuration & Input -->
+          <div class="edn-col">
+            <div class="edn-form-group">
+              <label for="edn-algo-select"><strong>1. Key Encapsulation & Agreement Scheme:</strong></label>
+              <select id="edn-algo-select" class="edn-select">
+                ${Object.values(KEM_ALGORITHMS).map(algo => `
+                  <option value="${algo.id}" ${algo.id === state.selectedAlgorithm ? 'selected' : ''}>
+                    ${algo.name}
+                  </option>
+                `).join('')}
+              </select>
+            </div>
+
+            <!-- Algorithm Details Card -->
+            <div id="edn-algo-info" class="edn-info-card">
+              <!-- Dynamically populated -->
+            </div>
+
+            <div class="edn-form-group">
+              <div class="edn-label-row">
+                <label><strong>Recipient Courier Public Key:</strong></label>
+                <button id="edn-regen-keys" class="edn-btn-link" title="Generate a fresh keypair for this algorithm">🔄 New Keypair</button>
+              </div>
+              <div class="edn-key-display">
+                <div class="edn-key-meta">
+                  <span>Fingerprint: <strong id="edn-pk-fingerprint">--</strong></span>
+                  <span id="edn-pk-length">-- bytes</span>
+                </div>
+                <textarea id="edn-public-key" class="edn-textarea-mono" rows="2" readonly></textarea>
+              </div>
+            </div>
+
+            <div class="edn-form-group">
+              <label for="edn-order-id"><strong>Order Reference ID (Authenticated Data):</strong></label>
+              <input type="text" id="edn-order-id" class="edn-input" value="${state.orderId}">
+              <small class="edn-help">Bound into AES-GCM as Additional Authenticated Data (AAD) to prevent replay or order-swap tampering.</small>
+            </div>
+
+            <div class="edn-form-group">
+              <div class="edn-label-row">
+                <label for="edn-note-input"><strong>Confidential Delivery Instructions:</strong></label>
+                <span id="edn-char-count">0 characters</span>
+              </div>
+              <textarea id="edn-note-input" class="edn-textarea" rows="4" placeholder="Enter sensitive instructions (e.g. gate code, buzzer code, drop-off location, phone contact)..."></textarea>
+              
+              <div class="edn-presets">
+                <span class="edn-presets-label">Quick Presets:</span>
+                <div class="edn-presets-list">
+                  ${PRESETS.map((p, idx) => `
+                    <button type="button" class="edn-chip-btn" data-preset="${idx}">${p.title}</button>
+                  `).join('')}
+                </div>
+              </div>
+            </div>
+
+            <button id="edn-btn-encrypt" class="btn btn-primary edn-btn-block">
+              🔒 Encrypt & Seal Delivery Note
+            </button>
+          </div>
+
+          <!-- Right Column: Cryptographic Inspection & Sealed Envelope -->
+          <div class="edn-col">
+            <div class="edn-audit-trail">
+              <h3>Cryptographic Audit Pipeline</h3>
+              <div class="edn-pipeline-steps">
+                <div class="edn-step" id="edn-step-kem">
+                  <div class="edn-step-icon">1</div>
+                  <div class="edn-step-content">
+                    <h4>Public-Key Encapsulation (KEM)</h4>
+                    <p>Generates ephemeral shared secret and encapsulates ciphertext against Courier's public key.</p>
+                    <div class="edn-step-data" id="edn-step-kem-data">Awaiting sealing...</div>
+                  </div>
+                </div>
+
+                <div class="edn-step" id="edn-step-hkdf">
+                  <div class="edn-step-icon">2</div>
+                  <div class="edn-step-content">
+                    <h4>HKDF-SHA256 Key Derivation</h4>
+                    <p>Expands raw shared secret into 256-bit symmetric key with context domain separation.</p>
+                    <div class="edn-step-data" id="edn-step-hkdf-data">Awaiting derivation...</div>
+                  </div>
+                </div>
+
+                <div class="edn-step" id="edn-step-aead">
+                  <div class="edn-step-icon">3</div>
+                  <div class="edn-step-content">
+                    <h4>AES-256-GCM Authenticated Encryption</h4>
+                    <p>Encrypts note with 96-bit random IV and binds Order ID in 128-bit authentication tag.</p>
+                    <div class="edn-step-data" id="edn-step-aead-data">Awaiting encryption...</div>
+                  </div>
+                </div>
+              </div>
+            </div>
+
+            <!-- Sealed Output Card -->
+            <div id="edn-sealed-card" class="edn-output-card" style="display: none;">
+              <div class="edn-output-header">
+                <h4>📦 Sealed Delivery Envelope</h4>
+                <div class="edn-action-group">
+                  <button id="edn-btn-copy" class="edn-btn-sm">📋 Copy JSON</button>
+                  <button id="edn-btn-send-courier" class="edn-btn-sm edn-btn-accent">🚚 Open in Courier Terminal &rarr;</button>
+                </div>
+              </div>
+              <pre id="edn-sealed-json" class="edn-json-box"></pre>
+              <div class="edn-seal-meta" id="edn-seal-meta"></div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <!-- TAB 2: COURIER DECRYPTION TERMINAL -->
+      <div id="edn-panel-open" class="edn-panel">
+        <div class="edn-courier-wrapper">
+          <div class="edn-courier-banner">
+            <div class="edn-courier-badge">Courier Mobile Dispatch Simulator</div>
+            <h3>Delivery Driver Decryption & Authentication Terminal</h3>
+            <p>
+              In production, the courier's handheld device holds the private key matching the published roaster/courier public key. 
+              The driver decapsulates the KEM ciphertext to recover the shared secret and verifies the AEAD tag before revealing sensitive notes.
+            </p>
+          </div>
+
+          <div class="edn-grid">
+            <div class="edn-col">
+              <div class="edn-form-group">
+                <label for="edn-courier-input"><strong>Sealed Envelope JSON:</strong></label>
+                <textarea id="edn-courier-input" class="edn-textarea-mono" rows="8" placeholder="Paste or seal a note above to automatically load the encrypted delivery envelope..."></textarea>
+              </div>
+
+              <div class="edn-form-group">
+                <label><strong>Courier Private Key (matching recipient key):</strong></label>
+                <input type="password" id="edn-courier-sk" class="edn-input edn-mono" readonly>
+                <div class="edn-key-actions">
+                  <button type="button" id="edn-toggle-sk" class="edn-btn-link">👁️ Show Private Key</button>
+                  <span id="edn-courier-sk-fingerprint" class="edn-text-muted"></span>
+                </div>
+              </div>
+
+              <div class="edn-courier-buttons">
+                <button id="edn-btn-decrypt" class="btn btn-primary">
+                  🔓 Decapsulate & Decrypt Delivery Note
+                </button>
+                <button id="edn-btn-tamper" class="btn edn-btn-warning" title="Test AEAD integrity verification by modifying ciphertext or metadata">
+                  ⚠️ Simulate Tamper Attack
+                </button>
+              </div>
+            </div>
+
+            <div class="edn-col">
+              <div id="edn-decrypt-result" class="edn-result-box">
+                <div class="edn-placeholder-msg">
+                  <p>Awaiting envelope decryption...</p>
+                  <small>Seal a note in Tab 1 and click "Open in Courier Terminal" or paste an envelope here.</small>
+                </div>
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  `;
+
+  attachEventListeners();
+  updateAlgorithmView();
+}
+
+function updateAlgorithmView() {
+  const algoId = state.selectedAlgorithm;
+  const algo = KEM_ALGORITHMS[algoId];
+  if (!algo) return;
+
+  // Ensure keypair exists
+  if (!state.keyPairs[algoId]) {
+    state.keyPairs[algoId] = generateKeyPair(algoId);
+  }
+  const keyPair = state.keyPairs[algoId];
+
+  // Update public key UI
+  const pkEl = document.getElementById('edn-public-key');
+  const pkFingerprintEl = document.getElementById('edn-pk-fingerprint');
+  const pkLengthEl = document.getElementById('edn-pk-length');
+
+  if (pkEl) pkEl.value = keyPair.publicKeyBase64;
+  if (pkFingerprintEl) pkFingerprintEl.textContent = keyPair.fingerprint;
+  if (pkLengthEl) pkLengthEl.textContent = `${keyPair.publicKeyBytes.length} bytes`;
+
+  // Update courier private key in Tab 2
+  const courierSkEl = document.getElementById('edn-courier-sk');
+  const courierSkFpEl = document.getElementById('edn-courier-sk-fingerprint');
+  if (courierSkEl) courierSkEl.value = keyPair.secretKeyBase64;
+  if (courierSkFpEl) courierSkFpEl.textContent = `Algorithm: ${algo.id}`;
+
+  // Update info card
+  const infoEl = document.getElementById('edn-algo-info');
+  if (infoEl) {
+    infoEl.innerHTML = `
+      <div class="edn-badges-row">
+        ${algo.pqcProtected ? '<span class="edn-badge edn-badge-pqc">🛡️ Post-Quantum Protected</span>' : ''}
+        ${algo.classicalProtected ? '<span class="edn-badge edn-badge-ecc">⚡ Classical ECDH</span>' : ''}
+        <span class="edn-badge edn-badge-aead">🔒 AES-256-GCM AEAD</span>
+      </div>
+      <p class="edn-algo-desc">${algo.description}</p>
+      <div class="edn-algo-meta">
+        <span><strong>Type:</strong> ${algo.type}</span> | 
+        <span><strong>Strength:</strong> ${algo.securityLevel}</span>
+      </div>
+    `;
+  }
+}
+
+function attachEventListeners() {
+  // Tab switching
+  const tabSeal = document.getElementById('edn-tab-seal');
+  const tabOpen = document.getElementById('edn-tab-open');
+  const panelSeal = document.getElementById('edn-panel-seal');
+  const panelOpen = document.getElementById('edn-panel-open');
+
+  tabSeal?.addEventListener('click', () => {
+    tabSeal.classList.add('active');
+    tabOpen?.classList.remove('active');
+    panelSeal?.classList.add('active');
+    panelOpen?.classList.remove('active');
+  });
+
+  tabOpen?.addEventListener('click', () => {
+    tabOpen.classList.add('active');
+    tabSeal?.classList.remove('active');
+    panelOpen?.classList.add('active');
+    panelSeal?.classList.remove('active');
+  });
+
+  // Algorithm select change
+  const algoSelect = document.getElementById('edn-algo-select');
+  algoSelect?.addEventListener('change', (e) => {
+    state.selectedAlgorithm = e.target.value;
+    updateAlgorithmView();
+  });
+
+  // Regenerate keys
+  const regenBtn = document.getElementById('edn-regen-keys');
+  regenBtn?.addEventListener('click', () => {
+    state.keyPairs[state.selectedAlgorithm] = generateKeyPair(state.selectedAlgorithm);
+    updateAlgorithmView();
+    showNotification('Fresh recipient keypair generated for ' + state.selectedAlgorithm);
+  });
+
+  // Note character counter
+  const noteInput = document.getElementById('edn-note-input');
+  const charCount = document.getElementById('edn-char-count');
+  noteInput?.addEventListener('input', () => {
+    if (charCount) charCount.textContent = `${noteInput.value.length} characters`;
+  });
+
+  // Presets
+  const presetBtns = document.querySelectorAll('.edn-chip-btn');
+  presetBtns.forEach(btn => {
+    btn.addEventListener('click', () => {
+      const idx = parseInt(btn.getAttribute('data-preset'), 10);
+      if (PRESETS[idx] && noteInput) {
+        noteInput.value = PRESETS[idx].text;
+        noteInput.dispatchEvent(new Event('input'));
+      }
+    });
+  });
+
+  // Encrypt button
+  const encryptBtn = document.getElementById('edn-btn-encrypt');
+  encryptBtn?.addEventListener('click', handleEncryptNote);
+
+  // Copy button
+  const copyBtn = document.getElementById('edn-btn-copy');
+  copyBtn?.addEventListener('click', () => {
+    if (!state.lastSealedEnvelope) return;
+    navigator.clipboard?.writeText(JSON.stringify(state.lastSealedEnvelope, null, 2))
+      .then(() => showNotification('Envelope JSON copied to clipboard!'))
+      .catch(() => alert('Copied!'));
+  });
+
+  // Open in courier terminal button
+  const sendCourierBtn = document.getElementById('edn-btn-send-courier');
+  sendCourierBtn?.addEventListener('click', () => {
+    if (!state.lastSealedEnvelope) return;
+    const courierInput = document.getElementById('edn-courier-input');
+    if (courierInput) {
+      courierInput.value = JSON.stringify(state.lastSealedEnvelope, null, 2);
+    }
+    tabOpen?.click();
+    showNotification('Envelope dispatched to Courier Terminal. Click Decrypt to view!');
+  });
+
+  // Toggle courier private key visibility
+  const toggleSkBtn = document.getElementById('edn-toggle-sk');
+  const courierSkInput = document.getElementById('edn-courier-sk');
+  toggleSkBtn?.addEventListener('click', () => {
+    if (!courierSkInput) return;
+    if (courierSkInput.type === 'password') {
+      courierSkInput.type = 'text';
+      toggleSkBtn.textContent = '🙈 Hide Private Key';
+    } else {
+      courierSkInput.type = 'password';
+      toggleSkBtn.textContent = '👁️ Show Private Key';
+    }
+  });
+
+  // Courier Decrypt button
+  const decryptBtn = document.getElementById('edn-btn-decrypt');
+  decryptBtn?.addEventListener('click', handleDecryptNote);
+
+  // Tamper simulation button
+  const tamperBtn = document.getElementById('edn-btn-tamper');
+  tamperBtn?.addEventListener('click', handleTamperSimulation);
+}
+
+async function handleEncryptNote() {
+  const noteInput = document.getElementById('edn-note-input');
+  const orderIdInput = document.getElementById('edn-order-id');
+  const note = noteInput?.value?.trim();
+  const orderId = orderIdInput?.value?.trim() || state.orderId;
+
+  if (!note) {
+    alert('Please enter or select delivery instructions to encrypt.');
+    noteInput?.focus();
+    return;
+  }
+
+  const keyPair = state.keyPairs[state.selectedAlgorithm];
+  if (!keyPair) {
+    alert('No keypair available for this algorithm.');
+    return;
+  }
+
+  try {
+    const result = await sealDeliveryNote({
+      recipientPublicKeyBase64: keyPair.publicKeyBase64,
+      algorithmId: state.selectedAlgorithm,
+      note,
+      orderId,
+      metadata: {
+        app: 'The Daily Grind Artisanal Coffee',
+        deliveryMethod: 'Morning Express Roaster Drop'
+      }
+    });
+
+    state.lastSealedEnvelope = result.envelope;
+
+    // Update pipeline steps UI
+    const stepKemData = document.getElementById('edn-step-kem-data');
+    if (stepKemData) {
+      stepKemData.innerHTML = `
+        <span class="edn-tag-ok">Shared Secret Established (${result.sharedSecretFingerprint})</span>
+        <br><small>KEM Ciphertext: ${result.kemCiphertextBytes} bytes</small>
+      `;
+    }
+
+    const stepHkdfData = document.getElementById('edn-step-hkdf-data');
+    if (stepHkdfData) {
+      stepHkdfData.innerHTML = `
+        <span class="edn-tag-ok">AES Key Derived (${result.aesKeyFingerprint})</span>
+        <br><small>HKDF-SHA256 with domain context: TheDailyGrind:${result.envelope.algorithm}:AES-256-GCM</small>
+      `;
+    }
+
+    const stepAeadData = document.getElementById('edn-step-aead-data');
+    if (stepAeadData) {
+      stepAeadData.innerHTML = `
+        <span class="edn-tag-ok">AES-256-GCM Ciphertext & Tag Created</span>
+        <br><small>Ciphertext: ${result.ciphertextBytes} bytes, IV: 12 bytes, Tag: 128-bit</small>
+      `;
+    }
+
+    // Display sealed card
+    const sealedCard = document.getElementById('edn-sealed-card');
+    const sealedJson = document.getElementById('edn-sealed-json');
+    const sealMeta = document.getElementById('edn-seal-meta');
+
+    if (sealedJson) sealedJson.textContent = JSON.stringify(result.envelope, null, 2);
+    if (sealMeta) {
+      sealMeta.innerHTML = `
+        <span>Algorithm: <strong>${result.envelope.algorithm}</strong></span> &bull; 
+        <span>Order: <strong>${result.envelope.orderId}</strong></span> &bull; 
+        <span>Protected: <strong>${result.envelope.pqcProtected ? 'Post-Quantum + AEAD' : 'AEAD Authenticated'}</strong></span>
+      `;
+    }
+    if (sealedCard) sealedCard.style.display = 'block';
+
+    // Auto populate courier input
+    const courierInput = document.getElementById('edn-courier-input');
+    if (courierInput) {
+      courierInput.value = JSON.stringify(result.envelope, null, 2);
+    }
+
+    showNotification('Delivery note sealed with ' + result.envelope.algorithmName + '!');
+  } catch (err) {
+    console.error('Encryption failed:', err);
+    alert('Encryption error: ' + err.message);
+  }
+}
+
+async function handleDecryptNote() {
+  const courierInput = document.getElementById('edn-courier-input');
+  const resultBox = document.getElementById('edn-decrypt-result');
+  const rawInput = courierInput?.value?.trim();
+
+  if (!rawInput) {
+    alert('Please seal a note first or paste an envelope JSON.');
+    return;
+  }
+
+  let envelope;
+  try {
+    envelope = JSON.parse(rawInput);
+  } catch (err) {
+    if (resultBox) {
+      resultBox.innerHTML = `
+        <div class="edn-alert edn-alert-danger">
+          <h4>❌ JSON Parsing Error</h4>
+          <p>The input text is not a valid JSON envelope.</p>
+        </div>
+      `;
+    }
+    return;
+  }
+
+  const keyPair = state.keyPairs[envelope.algorithm];
+  if (!keyPair) {
+    if (resultBox) {
+      resultBox.innerHTML = `
+        <div class="edn-alert edn-alert-danger">
+          <h4>❌ Key Mismatch</h4>
+          <p>No courier private key found for algorithm: <strong>${envelope.algorithm}</strong></p>
+        </div>
+      `;
+    }
+    return;
+  }
+
+  try {
+    const openResult = await openDeliveryNote({
+      envelope,
+      recipientSecretKeyBase64: keyPair.secretKeyBase64
+    });
+
+    if (resultBox) {
+      resultBox.innerHTML = `
+        <div class="edn-alert edn-alert-success">
+          <div class="edn-alert-header">
+            <h4>✅ Authenticated & Decrypted Successfully</h4>
+            <span class="edn-badge-verified">AEAD Tag Verified</span>
+          </div>
+          <div class="edn-decrypted-content">
+            <label>Decrypted Sensitive Instructions:</label>
+            <div class="edn-note-text">${escapeHtml(openResult.plaintextNote)}</div>
+          </div>
+          <div class="edn-decrypted-audit">
+            <p><strong>Order ID:</strong> ${escapeHtml(openResult.orderId)}</p>
+            <p><strong>Key Agreement / KEM:</strong> ${escapeHtml(openResult.algorithmName)}</p>
+            <p><strong>Post-Quantum Safe:</strong> ${openResult.pqcProtected ? 'Yes (FIPS 203 Lattice KEM)' : 'Classical Only'}</p>
+            <p><strong>Shared Secret Fingerprint:</strong> ${openResult.sharedSecretFingerprint}</p>
+            <p><strong>Timestamp:</strong> ${new Date(openResult.timestamp).toLocaleString()}</p>
+          </div>
+        </div>
+      `;
+    }
+  } catch (err) {
+    console.error('Decryption failed:', err);
+    if (resultBox) {
+      resultBox.innerHTML = `
+        <div class="edn-alert edn-alert-danger">
+          <h4>🚨 Cryptographic Authentication Verification FAILED!</h4>
+          <p>${escapeHtml(err.message)}</p>
+          <hr>
+          <small>
+            Authenticated Encryption with Associated Data (AEAD AES-256-GCM) ensures that even a 1-bit alteration 
+            in ciphertext, nonce, or order metadata causes instant rejection, protecting against active man-in-the-middle attacks.
+          </small>
+        </div>
+      `;
+    }
+  }
+}
+
+async function handleTamperSimulation() {
+  const courierInput = document.getElementById('edn-courier-input');
+  const rawInput = courierInput?.value?.trim();
+
+  if (!rawInput) {
+    alert('Please seal a note first so there is an envelope to tamper with.');
+    return;
+  }
+
+  try {
+    const envelope = JSON.parse(rawInput);
+    
+    // Flip a bit in the ciphertext to simulate interception/tampering
+    const bytes = base64ToBytes(envelope.ciphertext);
+    bytes[0] ^= 0x01;
+    let binary = '';
+    for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+    envelope.ciphertext = btoa(binary);
+
+    courierInput.value = JSON.stringify(envelope, null, 2);
+    showNotification('⚠️ Tampered with 1 bit of AES-GCM ciphertext! Click Decrypt to test.');
+
+    // Automatically trigger decryption to demonstrate rejection
+    await handleDecryptNote();
+  } catch (err) {
+    alert('Failed to tamper envelope: ' + err.message);
+  }
+}
+
+function escapeHtml(str) {
+  if (!str) return '';
+  return str.replace(/[&<>'"]/g, tag => ({
+    '&': '&amp;',
+    '<': '&lt;',
+    '>': '&gt;',
+    "'": '&#39;',
+    '"': '&quot;'
+  }[tag] || tag));
+}
+
+function showNotification(msg) {
+  let toast = document.getElementById('edn-toast');
+  if (!toast) {
+    toast = document.createElement('div');
+    toast.id = 'edn-toast';
+    toast.className = 'edn-toast';
+    document.body.appendChild(toast);
+  }
+  toast.textContent = msg;
+  toast.classList.add('show');
+  setTimeout(() => toast.classList.remove('show'), 3500);
+}
+
+// Automatically initialize when DOM is loaded
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initEncryptedNotes);
+  } else {
+    initEncryptedNotes();
+  }
+}
diff --git a/test/crypto.test.js b/test/crypto.test.js
