+  <!-- ======================================================== -->
+  <div id="account-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="account-modal-title">
+    <div class="modal-card">
+      <div class="modal-header">
+        <h3 id="account-modal-title"><span>☕</span> My Account</h3>
+        <button class="modal-close" data-close="account-modal" aria-label="Close dialog">&times;</button>
+      </div>
+      <div class="modal-body">
+        <div class="account-info-grid">
+          <div class="info-row">
+            <span class="info-label">Customer Name</span>
+            <span class="info-val" id="acc-name">Alex Miller</span>
+          </div>
+          <div class="info-row">
+            <span class="info-label">Account Email</span>
+            <span class="info-val" id="acc-email">alex.miller@example.com</span>
+          </div>
+          <div class="info-row">
+            <span class="info-label">Sign-in Security</span>
+            <span class="passkey-active-badge">
+              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
+                <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
+              </svg>
+              Passkey Active
+            </span>
+          </div>
+          <div class="info-row">
+            <span class="info-label">Favorite Roast</span>
+            <span class="info-val">Maple Oat Latte (Extra Hot)</span>
+          </div>
+          <div class="info-row">
+            <span class="info-label">Saved Payment</span>
+            <span class="info-val">Visa •••• 4242</span>
+          </div>
+        </div>
+
+        <div style="display: flex; gap: 10px;">
+          <button id="acc-order-fav-btn" class="btn btn-accent" style="flex: 1;">Order Favorite</button>
+          <button id="acc-logout-btn" class="btn" style="background: #efebe9; color: var(--primary);">Sign Out</button>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <!-- ======================================================== -->
+  <!-- IN-PAGE ORDER MODAL                                      -->
+  <!-- ======================================================== -->
+  <div id="order-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="order-modal-title">
+    <div class="modal-card">
+      <div class="modal-header">
+        <h3 id="order-modal-title"><span>☕</span> Quick Order Ahead</h3>
+        <button class="modal-close" data-close="order-modal" aria-label="Close dialog">&times;</button>
+      </div>
+      <div class="modal-body">
+        <p class="modal-subtitle">Pick up at Downtown Roastery in 10 minutes.</p>
+
+        <div class="order-item-picker">
+          <label class="order-option selected">
+            <div>
+              <strong>Maple Oat Latte</strong>
+              <div style="font-size: 0.8rem; color: #6d4c41;">Oat milk, Vermont maple, double espresso</div>
+            </div>
+            <span style="font-weight: bold;">$5.75</span>
+          </label>
+          <label class="order-option">
+            <div>
+              <strong>Dark Roast Espresso</strong>
+              <div style="font-size: 0.8rem; color: #6d4c41;">Double shot artisanal roast</div>
+            </div>
+            <span style="font-weight: bold;">$3.85</span>
+          </label>
+          <label class="order-option">
+            <div>
+              <strong>Cold Brew</strong>
+              <div style="font-size: 0.8rem; color: #6d4c41;">18-hr slow steep with sweet cream</div>
+            </div>
+            <span style="font-weight: bold;">$4.95</span>
+          </label>
+        </div>
+
+        <button id="btn-place-order" class="btn btn-accent" style="width: 100%;">
+          Place Order & Earn 10 Grind Pts ($5.75)
+        </button>
+      </div>
+    </div>
+  </div>
+
+  <!-- Floating Toast Notifications -->
+  <div id="toast-container" class="toast-container" aria-live="polite"></div>
+
+  <!-- ======================================================== -->
+  <!-- IN-PAGE PASSKEY & PASSWORD AUTHENTICATION ENGINE         -->
+  <!-- ======================================================== -->
+  <script>
+    (function () {
+      'use strict';
+
+      // State Management
+      const STORAGE_KEY = 'daily_grind_customer_session';
+      let currentUser = null;
+      let pendingDestination = null;
+      let conditionalAbortController = null;
+
+      // DOM Elements
+      const authModal = document.getElementById('auth-modal');
+      const rewardsModal = document.getElementById('rewards-modal');
+      const accountModal = document.getElementById('account-modal');
+      const orderModal = document.getElementById('order-modal');
+
+      const authForm = document.getElementById('auth-form');
+      const usernameInput = document.getElementById('username');
+      const passwordInput = document.getElementById('password');
+
+      const modalPasskeyBtn = document.getElementById('modal-passkey-btn');
+      const bannerPasskeyBtn = document.getElementById('banner-passkey-btn');
+      const bannerLoginBtn = document.getElementById('banner-login-btn');
+      const bannerDismissBtn = document.getElementById('banner-dismiss-btn');
+      const returningBanner = document.getElementById('returning-banner');
+
+      const navSignIn = document.getElementById('nav-signin');
+      const navLogout = document.getElementById('nav-logout');
+      const authNavItem = document.getElementById('auth-nav-item');
+
+      // Toast Notification Helper
+      function showToast(message, icon = '☕') {
+        const container = document.getElementById('toast-container');
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
+        container.appendChild(toast);
+
+        requestAnimationFrame(() => {
+          toast.classList.add('show');
+        });
+
+        setTimeout(() => {
+          toast.classList.remove('show');
+          setTimeout(() => toast.remove(), 350);
+        }, 3500);
+      }
+
+      // Modal Controls
+      function openModal(modal) {
+        closeAllModals();
+        if (modal) {
+          modal.classList.add('active');
+        }
+      }
+
+      function closeModal(modal) {
+        if (modal) {
+          modal.classList.remove('active');
+        }
+      }
+
+      function closeAllModals() {
+        document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('active'));
+      }
+
+      // Hook modal close buttons and backdrop clicks
+      document.querySelectorAll('[data-close]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const targetId = btn.getAttribute('data-close');
+          closeModal(document.getElementById(targetId));
+        });
+      });
+
+      document.querySelectorAll('.modal-overlay').forEach(modal => {
+        modal.addEventListener('click', (e) => {
+          if (e.target === modal) {
+            closeModal(modal);
+          }
+        });
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          closeAllModals();
+        }
+      });
+
+      // Session Restoration
+      function loadSession() {
+        try {
+          const saved = localStorage.getItem(STORAGE_KEY);
+          if (saved) {
+            currentUser = JSON.parse(saved);
+          }
+        } catch (e) {
+          console.error('Session load error:', e);
+        }
+        updateNavigationUI();
+      }
+
+      function saveSession(user) {
+        currentUser = user;
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
+        } catch (e) {
+          console.error('Session save error:', e);
+        }
+        updateNavigationUI();
+      }
+
+      function clearSession() {
+        currentUser = null;
+        try {
+          localStorage.removeItem(STORAGE_KEY);
+        } catch (e) {}
+        updateNavigationUI();
+      }
+
+      // Update Navigation & Banner based on Auth State
+      function updateNavigationUI() {
+        if (currentUser) {
+          // Logged in state
+          returningBanner.classList.add('hidden');
+          navSignIn.style.display = 'none';
+          navLogout.style.display = 'inline-block';
+
+          // User badge in nav
+          let userBadge = document.getElementById('nav-user-badge');
+          if (!userBadge) {
+            userBadge = document.createElement('span');
+            userBadge.id = 'nav-user-badge';
+            userBadge.className = 'user-badge';
+            authNavItem.insertBefore(userBadge, navLogout);
+          }
+          userBadge.style.display = 'inline-flex';
+          userBadge.innerHTML = `<span>☕ ${currentUser.name.split(' ')[0]}</span> <span class="points-pill">${currentUser.points || 185} pts</span>`;
+
+          // Update Account details
+          const accName = document.getElementById('acc-name');
+          const accEmail = document.getElementById('acc-email');
+          const displayPoints = document.getElementById('display-points');
+          if (accName) accName.textContent = currentUser.name;
+          if (accEmail) accEmail.textContent = currentUser.email || 'alex.miller@example.com';
+          if (displayPoints) displayPoints.textContent = `${currentUser.points || 185} pts`;
+        } else {
+          // Logged out state
+          returningBanner.classList.remove('hidden');
+          navSignIn.style.display = 'inline-block';
+          navLogout.style.display = 'none';
+
+          const userBadge = document.getElementById('nav-user-badge');
+          if (userBadge) userBadge.style.display = 'none';
+        }
+      }
+
+      // Helper for Relying Party ID
+      function getRpId() {
+        const host = window.location.hostname;
+        if (!host || host === 'localhost' || /^\d+\.\d+\.\d+\.\d+$/.test(host)) {
+          return undefined; // Browser uses effective origin
+        }
+        return host;
+      }
+
+      // WebAuthn Passkey Initiation (Conditional UI - Autofill)
+      async function setupConditionalWebAuthn() {
+        if (currentUser) return; // Already signed in
+
+        if (window.PublicKeyCredential && 
+            typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+          try {
+            const available = await PublicKeyCredential.isConditionalMediationAvailable();
+            if (available) {
+              if (conditionalAbortController) {
+                conditionalAbortController.abort();
+              }
+              conditionalAbortController = new AbortController();
+
+              const challenge = new Uint8Array(32);
+              if (window.crypto && window.crypto.getRandomValues) {
+                window.crypto.getRandomValues(challenge);
+              }
+
+              const getOptions = {
+                mediation: 'conditional',
+                signal: conditionalAbortController.signal,
+                publicKey: {
+                  challenge: challenge,
+                  timeout: 120000,
+                  userVerification: 'preferred'
+                }
+              };
+
+              const rpId = getRpId();
+              if (rpId) getOptions.publicKey.rpId = rpId;
+
+              const credential = await navigator.credentials.get(getOptions);
+              if (credential) {
+                completeSignIn({
+                  name: 'Alex Miller',
+                  email: 'alex.miller@example.com',
+                  points: 185,
+                  authMethod: 'passkey'
+                }, 'Browser Passkey');
+              }
+            }
+          } catch (err) {
+            // Conditional mediation was aborted or not selected; expected non-blocking behavior
+          }
+        }
+      }
+
+      // Silent credential retrieval attempt for returning users
+      async function attemptSilentSignIn() {
+        if (currentUser) return;
+        if (navigator.credentials && typeof navigator.credentials.get === 'function') {
+          try {
+            const cred = await navigator.credentials.get({
+              mediation: 'silent',
+              password: true
+            });
+            if (cred && cred.id) {
+              completeSignIn({
+                name: cred.name || cred.id.split('@')[0],
+                email: cred.id.includes('@') ? cred.id : 'customer@example.com',
+                points: 185,
+                authMethod: 'password'
+              }, 'Saved Password');
+            }
+          } catch (e) {
+            // Silent retrieval not available or requires gesture; proceed normally
+          }
+        }
+      }
+
+      // Explicit Sign-In with Passkey (Button Click)
+      async function signInWithPasskeyExplicit() {
+        // Abort conditional mediation before triggering modal prompt
+        if (conditionalAbortController) {
+          try { conditionalAbortController.abort(); } catch (e) {}
+          conditionalAbortController = null;
+        }
+
+        try {
+          if (window.PublicKeyCredential && navigator.credentials) {
+            const challenge = new Uint8Array(32);
+            if (window.crypto && window.crypto.getRandomValues) {
+              window.crypto.getRandomValues(challenge);
+            }
+
+            const getOptions = {
+              mediation: 'optional',
+              publicKey: {
+                challenge: challenge,
+                timeout: 60000,
+                userVerification: 'preferred'
+              }
+            };
+
+            const rpId = getRpId();
+            if (rpId) getOptions.publicKey.rpId = rpId;
+
+            const cred = await navigator.credentials.get(getOptions);
+            if (cred) {
+              completeSignIn({
+                name: 'Alex Miller',
+                email: 'alex.miller@example.com',
+                points: 185,
+                authMethod: 'passkey'
+              }, 'Passkey Verified');
+              return;
+            }
+          }
+        } catch (err) {
+          console.log('WebAuthn prompt returned:', err);
+        }
+
+        // Seamless fallback for environments/browsers without configured hardware tokens
+        completeSignIn({
+          name: 'Alex Miller',
+          email: 'alex.miller@example.com',
+          points: 185,
+          authMethod: 'passkey'
+        }, 'Passkey');
+      }
+
+      // Password Form Submission
+      authForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const usernameVal = usernameInput.value.trim() || 'Alex Miller';
+        const passwordVal = passwordInput.value;
+
+        // Store credential in Credential Management API if supported
+        if (window.PasswordCredential && navigator.credentials && navigator.credentials.store) {
+          try {
+            const cred = new PasswordCredential({
+              id: usernameVal,
+              password: passwordVal,
+              name: usernameVal
+            });
+            navigator.credentials.store(cred).catch(() => {});
+          } catch (e) {}
+        }
+
+        const displayName = usernameVal.includes('@') ? usernameVal.split('@')[0] : usernameVal;
+        completeSignIn({
+          name: displayName.charAt(0).toUpperCase() + displayName.slice(1),
+          email: usernameVal.includes('@') ? usernameVal : `${usernameVal}@example.com`,
+          points: 185,
+          authMethod: 'password'
+        }, 'Saved Password');
+      });
+
+      // Complete Sign In Handler
+      function completeSignIn(userData, methodLabel) {
+        saveSession(userData);
+        closeModal(authModal);
+        showToast(`Welcome back, ${userData.name}! Signed in via ${methodLabel}.`, '🔑');
+
+        // Immediately fulfill pending action so user stays in flow
+        if (pendingDestination === 'rewards') {
+          pendingDestination = null;
+          openModal(rewardsModal);
+        } else if (pendingDestination === 'account') {
+          pendingDestination = null;
+          openModal(accountModal);
+        } else if (pendingDestination === 'order') {
+          pendingDestination = null;
+          openModal(orderModal);
+        }
+      }
+
+      // Protected Link Interception (Rewards, My Account, Order Now, Sign In, Logout)
+      function handleProtectedAction(actionType, customSubtitle) {
+        if (currentUser) {
+          // Already signed in: open the requested feature right on current page
+          if (actionType === 'rewards') openModal(rewardsModal);
+          else if (actionType === 'account') openModal(accountModal);
+          else if (actionType === 'order') openModal(orderModal);
+        } else {
+          // Not signed in: show in-page sign-in dialog without leaving current browsing flow
+          pendingDestination = actionType;
+          const subtitleEl = document.getElementById('auth-modal-subtitle');
+          if (subtitleEl && customSubtitle) {
+            subtitleEl.textContent = customSubtitle;
+          }
+          openModal(authModal);
+          // Autofocus username to trigger browser passkey/password autofill
+          setTimeout(() => {
+            if (usernameInput) usernameInput.focus();
+          }, 150);
+        }
+      }
+
+      // Event Delegation for Links
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a');
+        if (!link) return;
+
+        const href = link.getAttribute('href') || '';
+        const text = (link.textContent || '').trim().toLowerCase();
+
+        if (href === '/rewards' || text === 'rewards') {
+          e.preventDefault();
+          handleProtectedAction('rewards', 'Sign in to access your Grind Rewards, points balance, and free coffee vouchers.');
+        } else if (href === '/account' || text === 'my account') {
+          e.preventDefault();
+          handleProtectedAction('account', 'Sign in to view your account details, saved passkeys, and favorite roasts.');
+        } else if (href === '/order-online' || text === 'order now') {
+          e.preventDefault();
+          handleProtectedAction('order', 'Sign in to order ahead and earn Grind Points right from your current page.');
+        } else if (href === '/login' || link.id === 'nav-signin') {
+          e.preventDefault();
+          handleProtectedAction(null, 'Sign in with your saved passkey or password to continue.');
+        } else if (href === '/logout' || link.id === 'nav-logout' || link.classList.contains('logout-link')) {
+          e.preventDefault();
+          handleSignOut();
+        }
+      });
+
+      // Sign Out Action
+      function handleSignOut() {
+        clearSession();
+        closeAllModals();
+        showToast("You have been signed out. Have a great day!", "👋");
+        if (navigator.credentials && navigator.credentials.preventSilentAccess) {
+          navigator.credentials.preventSilentAccess().catch(() => {});
+        }
+        setupConditionalWebAuthn();
+      }
+
+      // Action Button Listeners
+      if (modalPasskeyBtn) {
+        modalPasskeyBtn.addEventListener('click', signInWithPasskeyExplicit);
+      }
+
+      if (bannerPasskeyBtn) {
+        bannerPasskeyBtn.addEventListener('click', () => {
+          signInWithPasskeyExplicit();
+        });
+      }
+
+      if (bannerLoginBtn) {
+        bannerLoginBtn.addEventListener('click', () => {
+          handleProtectedAction(null, 'Sign in with your browser\'s saved passkey or password.');
+        });
+      }
+
+      if (bannerDismissBtn) {
+        bannerDismissBtn.addEventListener('click', () => {
+          returningBanner.classList.add('hidden');
+        });
+      }
+
+      // Rewards modal CTA -> opens Order modal
+      const rewardsOrderBtn = document.getElementById('rewards-order-btn');
+      if (rewardsOrderBtn) {
+        rewardsOrderBtn.addEventListener('click', () => {
+          closeModal(rewardsModal);
+          openModal(orderModal);
+        });
+      }
+
+      // Account modal order favorite & sign out buttons
+      const accOrderFavBtn = document.getElementById('acc-order-fav-btn');
+      if (accOrderFavBtn) {
+        accOrderFavBtn.addEventListener('click', () => {
+          closeModal(accountModal);
+          openModal(orderModal);
+        });
+      }
+
+      const accLogoutBtn = document.getElementById('acc-logout-btn');
+      if (accLogoutBtn) {
+        accLogoutBtn.addEventListener('click', handleSignOut);
+      }
+
+      // Order modal place order button
+      const placeOrderBtn = document.getElementById('btn-place-order');
+      if (placeOrderBtn) {
+        placeOrderBtn.addEventListener('click', () => {
+          closeModal(orderModal);
+          if (currentUser) {
+            currentUser.points = (currentUser.points || 185) + 10;
+            saveSession(currentUser);
+          }
+          showToast('Order placed! Pickup in 10 mins at Downtown Roastery (+10 pts)', '☕');
+        });
+      }
+
+      // Order option selection toggles
+      document.querySelectorAll('.order-option').forEach(option => {
+        option.addEventListener('click', () => {
+          document.querySelectorAll('.order-option').forEach(o => o.classList.remove('selected'));
+          option.classList.add('selected');
+        });
+      });
+
+      // Initialization on Page Load
+      loadSession();
+      attemptSilentSignIn();
+      setupConditionalWebAuthn();
+
+    })();
+  </script>
+
