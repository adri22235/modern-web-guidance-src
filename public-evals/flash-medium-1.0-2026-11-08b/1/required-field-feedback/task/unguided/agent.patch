+  <script>
+    function initNewsletter() {
+      var form = document.getElementById('newsletter-form');
+      var emailInput = document.getElementById('newsletter-email');
+      var errorMessage = document.getElementById('newsletter-error');
+      var successMessage = document.getElementById('newsletter-success');
+      var submitBtn = document.getElementById('newsletter-submit');
+
+      if (!form || !emailInput || !errorMessage) return;
+
+      var hasInteracted = false;
+
+      function getErrorMessage() {
+        var val = emailInput.value.trim();
+        if (!val) {
+          return 'Email is required.';
+        }
+        var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+        if (!emailInput.checkValidity() || !emailPattern.test(val)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(msg) {
+        emailInput.classList.add('error');
+        emailInput.classList.add('is-invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMessage.textContent = msg;
+        errorMessage.classList.add('visible');
+        errorMessage.style.display = 'block';
+
+        if (successMessage) {
+          successMessage.textContent = '';
+          successMessage.classList.remove('visible');
+          successMessage.style.display = 'none';
+        }
+      }
+
+      function clearError() {
+        emailInput.classList.remove('error');
+        emailInput.classList.remove('is-invalid');
+        emailInput.removeAttribute('aria-invalid');
+        errorMessage.textContent = '';
+        errorMessage.classList.remove('visible');
+        errorMessage.style.display = 'none';
+      }
+
+      // Show error when user interacts with field and leaves it empty (or invalid)
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        var err = getErrorMessage();
+        if (err) {
+          showError(err);
+        } else {
+          clearError();
+        }
+      });
+
+      // While typing, clear error immediately once valid, or update if empty
+      emailInput.addEventListener('input', function () {
+        if (hasInteracted || emailInput.classList.contains('error')) {
+          var err = getErrorMessage();
+          if (!err) {
+            clearError();
+          } else if (!emailInput.value.trim()) {
+            showError('Email is required.');
+          }
+        }
+      });
+
+      // Suppress native invalid bubbles if triggered
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        var err = getErrorMessage();
+        showError(err || 'Email is required.');
+      });
+
+      // Form submission attempt
+      function handleSubmit(e) {
+        e.preventDefault();
+        hasInteracted = true;
+        var err = getErrorMessage();
+        if (err) {
+          showError(err);
+          emailInput.focus();
+        } else {
+          clearError();
+          if (successMessage) {
+            successMessage.textContent = 'Thank you for subscribing!';
+            successMessage.classList.add('visible');
+            successMessage.style.display = 'block';
+          }
+          form.reset();
+        }
+      }
+
+      form.addEventListener('submit', handleSubmit);
+      if (submitBtn) {
+        submitBtn.addEventListener('click', function (e) {
+          var err = getErrorMessage();
+          if (err) {
+            e.preventDefault();
+            hasInteracted = true;
+            showError(err);
+            emailInput.focus();
+          }
+        });
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initNewsletter);
+    } else {
+      initNewsletter();
+    }
+  </script>
+
 </body>
 
