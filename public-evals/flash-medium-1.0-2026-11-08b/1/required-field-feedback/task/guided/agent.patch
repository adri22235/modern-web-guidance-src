+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorText = document.getElementById('newsletter-error-text');
+      const successMsg = document.getElementById('newsletter-success');
+
+      if (!form || !emailInput) return;
+
+      const dirtyState = new WeakMap();
+
+      const updateErrorMessage = () => {
+        if (!errorText) return;
+        if (emailInput.validity.valueMissing) {
+          errorText.textContent = 'Please enter an email address.';
+        } else if (emailInput.validity.typeMismatch) {
+          errorText.textContent = 'Please enter a valid email address.';
+        } else {
+          errorText.textContent = 'Please enter a valid email address.';
+        }
+      };
+
+      const syncAriaInvalid = (input) => {
+        let isInvalid = false;
+        try {
+          if (input.matches(':user-invalid')) {
+            isInvalid = true;
+          } else if (input.matches(':user-valid')) {
+            isInvalid = false;
+          } else {
+            const state = dirtyState.get(input);
+            if (state && (state.hasInteracted || state.hasSubmitted) && state.hasBlurred) {
+              isInvalid = !input.checkValidity();
+            }
+          }
+        } catch {
+          const state = dirtyState.get(input);
+          if (state && (state.hasInteracted || state.hasSubmitted) && state.hasBlurred) {
+            isInvalid = !input.checkValidity();
+          }
+        }
+
+        if (isInvalid) {
+          input.setAttribute('aria-invalid', 'true');
+          input.classList.add('user-invalid-fallback');
+          input.classList.remove('user-valid-fallback');
+          updateErrorMessage();
+        } else {
+          input.removeAttribute('aria-invalid');
+          input.classList.remove('user-invalid-fallback');
+          if (input.checkValidity() && input.value.trim() !== '') {
+            input.classList.add('user-valid-fallback');
+          } else {
+            input.classList.remove('user-valid-fallback');
+          }
+        }
+      };
+
+      // Track user interaction
+      form.addEventListener('input', (e) => {
+        if (e.target === emailInput) {
+          const state = dirtyState.get(emailInput) || { hasInteracted: false, hasBlurred: false };
+          state.hasInteracted = true;
+          dirtyState.set(emailInput, state);
+
+          if (emailInput.checkValidity()) {
+            emailInput.removeAttribute('aria-invalid');
+            emailInput.classList.remove('user-invalid-fallback');
+            if (emailInput.value.trim() !== '') {
+              emailInput.classList.add('user-valid-fallback');
+            }
+          } else {
+            updateErrorMessage();
+          }
+        }
+      });
+
+      form.addEventListener('blur', (e) => {
+        if (e.target === emailInput) {
+          const state = dirtyState.get(emailInput) || { hasInteracted: false, hasBlurred: false };
+          state.hasBlurred = true;
+          dirtyState.set(emailInput, state);
+
+          syncAriaInvalid(emailInput);
+        }
+      }, true);
+
+      // Submission attempt triggers interaction state
+      const handleSubmissionAttempt = () => {
+        const state = dirtyState.get(emailInput) || { hasInteracted: false, hasBlurred: false };
+        state.hasSubmitted = true;
+        state.hasBlurred = true;
+        dirtyState.set(emailInput, state);
+
+        if (!emailInput.checkValidity()) {
+          emailInput.classList.add('user-invalid-fallback');
+          emailInput.setAttribute('aria-invalid', 'true');
+          updateErrorMessage();
+        }
+      };
+
+      const submitBtn = form.querySelector('button[type="submit"]');
+      if (submitBtn) {
+        submitBtn.addEventListener('click', handleSubmissionAttempt);
+      }
+
+      form.addEventListener('invalid', (e) => {
+        if (e.target === emailInput) {
+          handleSubmissionAttempt();
+          syncAriaInvalid(emailInput);
+        }
+      }, true);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        handleSubmissionAttempt();
+
+        if (!emailInput.checkValidity()) {
+          syncAriaInvalid(emailInput);
+          return;
+        }
+
+        if (successMsg) {
+          successMsg.hidden = false;
+        }
+        emailInput.value = '';
+        emailInput.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+        emailInput.removeAttribute('aria-invalid');
+        dirtyState.delete(emailInput);
+      });
+
+      form.addEventListener('reset', () => {
+        dirtyState.delete(emailInput);
+        emailInput.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+        emailInput.removeAttribute('aria-invalid');
+        if (successMsg) {
+          successMsg.hidden = true;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
