+        context.quadraticCurveTo(cx, 222, 338, 212);
+        context.lineTo(321, 422);
+        context.quadraticCurveTo(cx, 432, 119, 422);
+        context.closePath();
+
+        // Kraft paper cardboard gradient
+        const sleeveGrad = context.createLinearGradient(102, 0, 338, 0);
+        sleeveGrad.addColorStop(0, '#be945e');
+        sleeveGrad.addColorStop(0.15, '#dcb888');
+        sleeveGrad.addColorStop(0.65, '#cca26e');
+        sleeveGrad.addColorStop(0.95, '#b08752');
+        sleeveGrad.addColorStop(1, '#9e7542');
+
+        context.fillStyle = sleeveGrad;
+        context.fill();
+
+        // Cardboard border and subtle stitch lines
+        context.strokeStyle = '#8d6e63';
+        context.lineWidth = 1.5;
+        context.stroke();
+
+        // Corrugated texture lines
+        context.save();
+        context.strokeStyle = 'rgba(141, 110, 99, 0.12)';
+        context.lineWidth = 1;
+        for (let y = 224; y < 418; y += 10) {
+          context.beginPath();
+          const progress = (y - 212) / 210;
+          const leftX = 102 + (119 - 102) * progress;
+          const rightX = 338 + (321 - 338) * progress;
+          context.moveTo(leftX + 2, y);
+          context.quadraticCurveTo(cx, y + 10, rightX - 2, y);
+          context.stroke();
+        }
+        context.restore();
+
+        // Barista handwritten cup name on the sleeve (below the overlay)
+        context.save();
+        context.font = 'bold italic 13px "Segoe Print", "Caveat", "Comic Sans MS", cursive, sans-serif';
+        context.fillStyle = '#3e2723';
+        context.textAlign = 'center';
+        const displayName = (cupName || 'Alex').trim();
+        context.fillText(`★ Crafted for: ${displayName} ★`, cx, 412);
+        context.restore();
+
+        context.restore();
+      }
+
+      function drawLid(context) {
+        context.save();
+
+        // Lid base snapping over cup rim (y = 96 to 112, width ~274)
+        context.beginPath();
+        context.roundRect(83, 96, 274, 16, [6, 6, 2, 2]);
+        const lidRimGrad = context.createLinearGradient(83, 0, 357, 0);
+        lidRimGrad.addColorStop(0, '#eae6e0');
+        lidRimGrad.addColorStop(0.2, '#ffffff');
+        lidRimGrad.addColorStop(0.7, '#f0eae2');
+        lidRimGrad.addColorStop(1, '#cfc8be');
+        context.fillStyle = lidRimGrad;
+        context.fill();
+        context.strokeStyle = '#c4bcb0';
+        context.lineWidth = 1.2;
+        context.stroke();
+
+        // Lid upper dome (y = 70 to 96, width ~244: 98 to 342)
+        context.beginPath();
+        context.roundRect(98, 70, 244, 26, [8, 8, 3, 3]);
+        const domeGrad = context.createLinearGradient(98, 0, 342, 0);
+        domeGrad.addColorStop(0, '#f2ede7');
+        domeGrad.addColorStop(0.25, '#ffffff');
+        domeGrad.addColorStop(0.7, '#ede7df');
+        domeGrad.addColorStop(1, '#d8d0c4');
+        context.fillStyle = domeGrad;
+        context.fill();
+        context.strokeStyle = '#c9c1b5';
+        context.lineWidth = 1;
+        context.stroke();
+
+        // Sipping drink aperture / spout platform (y = 56 to 70, width ~60: 190 to 250)
+        context.beginPath();
+        context.roundRect(190, 58, 60, 14, [5, 5, 2, 2]);
+        context.fillStyle = '#e8e2d9';
+        context.fill();
+        context.strokeStyle = '#bab1a3';
+        context.lineWidth = 1;
+        context.stroke();
+
+        // Dark sipping hole
+        context.beginPath();
+        context.ellipse(cx, 65, 12, 4.5, 0, 0, Math.PI * 2);
+        context.fillStyle = '#2d1810';
+        context.fill();
+
+        context.restore();
+      }
+
+      function drawScene(time) {
+        if (!ctx) return;
+
+        // Clear 440x560 canvas virtual rect
+        ctx.clearRect(0, 0, 440, 560);
+
+        const cupName = (cupNameInput.value || '').trim() || 'Alex';
+        const milk = milkSelect.value || 'Oat Milk';
+        const syrup = syrupSelect.value || 'Caramel';
+
+        // 1. Shadow underneath
+        drawShadow(ctx);
+
+        // 2. Rising steam wisps (animated with time)
+        drawSteam(ctx, time);
+
+        // 3. Cup body
+        drawCupBody(ctx);
+
+        // 4. Coffee liquid peek window (reflects milk and syrup live)
+        drawLiquidPeek(ctx, milk, syrup, time);
+
+        // 5. Kraft cardboard sleeve (includes handwritten barista text)
+        drawSleeve(ctx, cupName);
+
+        // 6. Barista lid
+        drawLid(ctx);
+      }
+
+      // Responsive High-DPI Scaling & Layout Alignment
+      function resizeAndRender() {
+        if (!canvas || !ctx || !container) return;
+
+        const dpr = window.devicePixelRatio || 1;
+        const rect = container.getBoundingClientRect();
+        const displayWidth = rect.width || 440;
+        const displayHeight = rect.height || 560;
+
+        // Scale internal pixel buffer by devicePixelRatio for crisp rendering on high-DPI
+        canvas.width = Math.round(displayWidth * dpr);
+        canvas.height = Math.round(displayHeight * dpr);
+
+        // Ensure canvas CSS dimensions fill container exactly
+        canvas.style.width = displayWidth + 'px';
+        canvas.style.height = displayHeight + 'px';
+
+        // Scale context so drawing commands in 440x560 coordinates map cleanly
+        const scaleX = displayWidth / 440;
+        const scaleY = displayHeight / 560;
+
+        ctx.setTransform(dpr * scaleX, 0, 0, dpr * scaleY, 0, 0);
+
+        const now = performance.now();
+        drawScene(now);
+      }
+
+      // Animation loop for rising steam and live updates
+      function animate(time) {
+        if (canvas && ctx && container) {
+          const dpr = window.devicePixelRatio || 1;
+          const rect = container.getBoundingClientRect();
+          const displayWidth = rect.width || 440;
+          const displayHeight = rect.height || 560;
+          const scaleX = displayWidth / 440;
+          const scaleY = displayHeight / 560;
+
+          ctx.setTransform(dpr * scaleX, 0, 0, dpr * scaleY, 0, 0);
+          drawScene(time);
+        }
+        animFrameId = requestAnimationFrame(animate);
+      }
+
+      // Event listeners for live interactivity
+      cupNameInput.addEventListener('input', function () {
+        updateLiveText();
+        drawScene(performance.now());
+      });
+
+      milkSelect.addEventListener('change', function () {
+        updateLiveText();
+        drawScene(performance.now());
+      });
+
+      syrupSelect.addEventListener('change', function () {
+        updateLiveText();
+        drawScene(performance.now());
+      });
+
+      // Actions
+      if (placeOrderBtn) {
+        placeOrderBtn.addEventListener('click', function () {
+          const name = (cupNameInput.value || '').trim() || 'Alex';
+          const milk = milkSelect.value;
+          const syrup = syrupSelect.value;
+          const price = calculatePrice(milk, syrup);
+
+          if (orderFeedback) {
+            orderFeedback.style.display = 'block';
+            orderFeedback.textContent = `✓ Brew request queued for ${name}! ($${price})`;
+            setTimeout(function () {
+              orderFeedback.style.display = 'none';
+            }, 3500);
+          }
+        });
+      }
+
+      if (randomizeBtn) {
+        const names = ['Taylor', 'Jordan', 'Morgan', 'Casey', 'Riley', 'Avery', 'Sam', 'Quinn'];
+        const milks = ['Oat Milk', 'Whole Milk', 'Almond Milk', 'Skim Milk', 'None'];
+        const syrups = ['Caramel', 'Vanilla', 'Hazelnut', 'Maple', 'None'];
+
+        randomizeBtn.addEventListener('click', function () {
+          cupNameInput.value = names[Math.floor(Math.random() * names.length)];
+          milkSelect.value = milks[Math.floor(Math.random() * milks.length)];
+          syrupSelect.value = syrups[Math.floor(Math.random() * syrups.length)];
+          updateLiveText();
+          drawScene(performance.now());
+        });
+      }
+
+      // Window resize and ResizeObserver for high-DPI displays and responsiveness
+      window.addEventListener('resize', resizeAndRender);
+
+      if (typeof ResizeObserver !== 'undefined' && container) {
+        const ro = new ResizeObserver(resizeAndRender);
+        ro.observe(container);
+      }
+
+      // Initialize
+      updateLiveText();
+      resizeAndRender();
+      animFrameId = requestAnimationFrame(animate);
+    })();
+  </script>
 </body>
 
 </html>
