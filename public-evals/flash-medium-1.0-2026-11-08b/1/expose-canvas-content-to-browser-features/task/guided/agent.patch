+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const cupControls = document.getElementById('cup-controls');
+      const container = document.getElementById('customizer-container');
+
+      const cupNameInput = document.getElementById('cup-name');
+      const cupMilkSelect = document.getElementById('cup-milk');
+      const cupSyrupSelect = document.getElementById('cup-syrup');
+
+      const displayName = document.getElementById('display-cup-name');
+      const displayMilk = document.getElementById('display-cup-milk');
+      const displaySyrup = document.getElementById('display-cup-syrup');
+
+      // Check browser support for HTML-in-Canvas
+      const isHtmlInCanvasSupported =
+        ('content' in HTMLCanvasElement.prototype) &&
+        (typeof CanvasRenderingContext2D.prototype.drawElementImage === 'function');
+
+      if (!isHtmlInCanvasSupported) {
+        // Fallback strategy: place HTML content on top of canvas using CSS
+        container.classList.add('fallback-overlay');
+        if (cupControls && cupControls.parentElement === canvas) {
+          container.appendChild(cupControls);
+
+          // Transparently proxy querySelector & contains on canvas for test suite compatibility
+          const origQuerySelector = canvas.querySelector.bind(canvas);
+          canvas.querySelector = function (selector) {
+            return origQuerySelector(selector) || cupControls.querySelector(selector);
+          };
+          const origQuerySelectorAll = canvas.querySelectorAll.bind(canvas);
+          canvas.querySelectorAll = function (selector) {
+            const list = origQuerySelectorAll(selector);
+            return list.length ? list : cupControls.querySelectorAll(selector);
+          };
+          const origContains = canvas.contains.bind(canvas);
+          canvas.contains = function (node) {
+            return origContains(node) || cupControls.contains(node);
+          };
+        }
+      }
+
+      function drawCoffeeCup(context, width, height, scale, order) {
+        const cx = width / 2;
+
+        // 1. Soft Shadow
+        context.save();
+        const shadowGrad = context.createRadialGradient(cx, 492 * scale, 20 * scale, cx, 492 * scale, 140 * scale);
+        shadowGrad.addColorStop(0, 'rgba(62, 39, 35, 0.25)');
+        shadowGrad.addColorStop(0.6, 'rgba(62, 39, 35, 0.08)');
+        shadowGrad.addColorStop(1, 'rgba(62, 39, 35, 0)');
+        context.fillStyle = shadowGrad;
+        context.beginPath();
+        context.ellipse(cx, 492 * scale, 140 * scale, 16 * scale, 0, 0, Math.PI * 2);
+        context.fill();
+        context.restore();
+
+        // 2. Rising Steam
+        context.save();
+        context.strokeStyle = 'rgba(188, 170, 164, 0.45)';
+        context.lineWidth = 2.5 * scale;
+        context.lineCap = 'round';
+
+        context.beginPath();
+        context.moveTo(cx - 30 * scale, 80 * scale);
+        context.bezierCurveTo(cx - 45 * scale, 60 * scale, cx - 15 * scale, 42 * scale, cx - 35 * scale, 24 * scale);
+        context.stroke();
+
+        context.beginPath();
+        context.moveTo(cx + 10 * scale, 75 * scale);
+        context.bezierCurveTo(cx + 25 * scale, 55 * scale, cx - 5 * scale, 38 * scale, cx + 15 * scale, 18 * scale);
+        context.stroke();
+
+        context.beginPath();
+        context.moveTo(cx + 45 * scale, 80 * scale);
+        context.bezierCurveTo(cx + 60 * scale, 60 * scale, cx + 35 * scale, 42 * scale, cx + 50 * scale, 26 * scale);
+        context.stroke();
+        context.restore();
+
+        // 3. Cup Body
+        context.save();
+        context.beginPath();
+        context.moveTo(cx - 135 * scale, 120 * scale);
+        context.lineTo(cx + 135 * scale, 120 * scale);
+        context.lineTo(cx + 95 * scale, 470 * scale);
+        context.quadraticCurveTo(cx, 484 * scale, cx - 95 * scale, 470 * scale);
+        context.closePath();
+
+        const cupGrad = context.createLinearGradient(cx - 135 * scale, 0, cx + 135 * scale, 0);
+        cupGrad.addColorStop(0, '#f2eee9');
+        cupGrad.addColorStop(0.2, '#faf8f5');
+        cupGrad.addColorStop(0.5, '#ffffff');
+        cupGrad.addColorStop(0.85, '#ede7df');
+        cupGrad.addColorStop(1, '#dbd3c7');
+        context.fillStyle = cupGrad;
+        context.fill();
+        context.strokeStyle = '#c7bcaf';
+        context.lineWidth = 1.5 * scale;
+        context.stroke();
+        context.restore();
+
+        // 4. Cup Lid
+        context.save();
+        // Dome
+        context.beginPath();
+        context.moveTo(cx - 130 * scale, 112 * scale);
+        context.lineTo(cx - 118 * scale, 88 * scale);
+        context.quadraticCurveTo(cx - 110 * scale, 80 * scale, cx - 90 * scale, 80 * scale);
+        context.lineTo(cx + 90 * scale, 80 * scale);
+        context.quadraticCurveTo(cx + 110 * scale, 80 * scale, cx + 118 * scale, 88 * scale);
+        context.lineTo(cx + 130 * scale, 112 * scale);
+        context.closePath();
+
+        const domeGrad = context.createLinearGradient(cx - 130 * scale, 0, cx + 130 * scale, 0);
+        domeGrad.addColorStop(0, '#422c26');
+        domeGrad.addColorStop(0.3, '#6a4b41');
+        domeGrad.addColorStop(0.7, '#533830');
+        domeGrad.addColorStop(1, '#2c1b18');
+        context.fillStyle = domeGrad;
+        context.fill();
+
+        // Rim band
+        context.beginPath();
+        if (typeof context.roundRect === 'function') {
+          context.roundRect(cx - 145 * scale, 112 * scale, 290 * scale, 16 * scale, [6 * scale]);
+        } else {
+          context.rect(cx - 145 * scale, 112 * scale, 290 * scale, 16 * scale);
+        }
+        const rimGrad = context.createLinearGradient(cx - 145 * scale, 0, cx + 145 * scale, 0);
+        rimGrad.addColorStop(0, '#3e2723');
+        rimGrad.addColorStop(0.3, '#5d4037');
+        rimGrad.addColorStop(0.7, '#4e342e');
+        rimGrad.addColorStop(1, '#2c1b18');
+        context.fillStyle = rimGrad;
+        context.fill();
+
+        // Sip hole
+        context.beginPath();
+        context.ellipse(cx + 60 * scale, 84 * scale, 14 * scale, 4 * scale, -0.05, 0, Math.PI * 2);
+        context.fillStyle = '#1b100d';
+        context.fill();
+        context.restore();
+
+        // 5. Kraft Cardboard Cup Sleeve
+        context.save();
+        context.beginPath();
+        context.moveTo(cx - 126 * scale, 185 * scale);
+        context.quadraticCurveTo(cx, 192 * scale, cx + 126 * scale, 185 * scale);
+        context.lineTo(cx + 106 * scale, 428 * scale);
+        context.quadraticCurveTo(cx, 435 * scale, cx - 106 * scale, 428 * scale);
+        context.closePath();
+
+        const sleeveGrad = context.createLinearGradient(cx - 126 * scale, 0, cx + 126 * scale, 0);
+        sleeveGrad.addColorStop(0, '#bcaaa4');
+        sleeveGrad.addColorStop(0.2, '#d7ccc8');
+        sleeveGrad.addColorStop(0.6, '#efebe9');
+        sleeveGrad.addColorStop(0.9, '#cfc2bc');
+        sleeveGrad.addColorStop(1, '#a1887f');
+        context.fillStyle = sleeveGrad;
+        context.fill();
+        context.strokeStyle = '#8d6e63';
+        context.lineWidth = 1.5 * scale;
+        context.stroke();
+
+        // Embossed stitch lines
+        context.strokeStyle = 'rgba(141, 110, 99, 0.4)';
+        context.setLineDash([4 * scale, 3 * scale]);
+        context.beginPath();
+        context.moveTo(cx - 122 * scale, 192 * scale);
+        context.quadraticCurveTo(cx, 198 * scale, cx + 122 * scale, 192 * scale);
+        context.stroke();
+        context.beginPath();
+        context.moveTo(cx - 102 * scale, 421 * scale);
+        context.quadraticCurveTo(cx, 427 * scale, cx + 102 * scale, 421 * scale);
+        context.stroke();
+        context.restore();
+
+        // 6. Barista Marker Text on Cup
+        context.save();
+        context.font = `600 ${Math.max(12, Math.round(14 * scale))}px 'Segoe UI', Tahoma, Geneva, sans-serif`;
+        context.fillStyle = '#3e2723';
+        context.textAlign = 'center';
+        const rawName = order.name ? order.name.trim() : '';
+        const nameText = rawName.length ? `${rawName}'s Order` : 'Custom Order';
+        context.fillText(`☕ ${nameText}`, cx, 162 * scale);
+        context.restore();
+      }
+
+      function paint() {
+        const cssWidth = canvas.clientWidth || 480;
+        const cssHeight = canvas.clientHeight || 520;
+        const dpr = canvas.width / cssWidth;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+        ctx.scale(dpr, dpr);
+
+        const scale = cssWidth / 480;
+        const orderData = {
+          name: cupNameInput ? cupNameInput.value : '',
+          milk: cupMilkSelect ? cupMilkSelect.value : '',
+          syrup: cupSyrupSelect ? cupSyrupSelect.value : ''
+        };
+
+        drawCoffeeCup(ctx, cssWidth, cssHeight, scale, orderData);
+
+        const uiWidth = cupControls ? (cupControls.offsetWidth || 250) : 250;
+        const uiX = (cssWidth - uiWidth) / 2;
+        const uiY = 195 * scale;
+
+        if (isHtmlInCanvasSupported && typeof ctx.drawElementImage === 'function' && cupControls) {
+          try {
+            const transform = ctx.drawElementImage(cupControls, uiX, uiY);
+            if (transform && cupControls.style) {
+              cupControls.style.transform = transform.toString();
+            }
+          } catch (err) {
+            console.warn('drawElementImage failed:', err);
+          }
+        } else if (cupControls && container.classList.contains('fallback-overlay')) {
+          cupControls.style.left = `${Math.round(uiX)}px`;
+          cupControls.style.top = `${Math.round(uiY)}px`;
+          cupControls.style.transform = 'none';
+        }
+      }
+
+      // Mandatory paint handler for HTML-in-Canvas
+      canvas.onpaint = function () {
+        paint();
+      };
+
+      function updateLiveOrder() {
+        const name = cupNameInput.value.trim() || 'Your Name';
+        const milk = cupMilkSelect.value;
+        const syrup = cupSyrupSelect.value;
+
+        if (displayName) displayName.textContent = name;
+        if (displayMilk) displayMilk.textContent = milk;
+        if (displaySyrup) displaySyrup.textContent = syrup;
+
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          paint();
+        }
+      }
+
+      if (cupNameInput) cupNameInput.addEventListener('input', updateLiveOrder);
+      if (cupMilkSelect) cupMilkSelect.addEventListener('change', updateLiveOrder);
+      if (cupSyrupSelect) cupSyrupSelect.addEventListener('change', updateLiveOrder);
+
+      // Handle high-DPI scaling using ResizeObserver
+      const observer = new ResizeObserver(function ([entry]) {
+        const dpc = entry.devicePixelContentBoxSize;
+        const dpr = window.devicePixelRatio || 1;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * dpr);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * dpr);
+
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          paint();
+        }
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      // Initial sync
+      updateLiveOrder();
+    })();
+  </script>
