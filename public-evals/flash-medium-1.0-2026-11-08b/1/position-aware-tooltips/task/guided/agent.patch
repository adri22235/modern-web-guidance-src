+
+    #anchor {
+      anchor-name: --anchor;
+    }
+
+    #tooltip {
+      position: fixed;
+      position-anchor: --anchor;
+      position-area: block-start;
+      position-try-fallbacks: flip-block;
+
+      /* Enable anchored container queries */
+      container-type: anchored;
+
+      border: none;
+      background: transparent;
+      padding: 0;
+      overflow: visible;
+    }
+
+    .tooltip-content {
+      position: relative;
+      background: var(--text);
+      color: var(--light);
