diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..b767bfe
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,182 @@
+/**
+ * WebMCP (Web Model Context Protocol) support and utilities.
+ * Conforms to the W3C WebML CG draft specification and Chrome DevTools WebMCP standards.
+ */
+
+export interface ModelContextTool {
+  name: string;
+  description: string;
+  inputSchema?: Record<string, any>;
+  execute: (args: any) => Promise<any> | any;
+}
+
+export interface ModelContextInterface extends EventTarget {
+  registerTool: (tool: ModelContextTool, options?: any) => Promise<void> | void;
+  unregisterTool?: (name: string) => Promise<void> | void;
+  getTools?: () => Promise<ModelContextTool[]> | ModelContextTool[];
+  executeTool?: (toolOrName: string | ModelContextTool, inputObject?: any) => Promise<any>;
+  ontoolchange?: ((event: Event) => void) | null;
+}
+
+class PolyfillModelContext extends EventTarget implements ModelContextInterface {
+  private _tools: Map<string, ModelContextTool> = new Map();
+  public ontoolchange: ((event: Event) => void) | null = null;
+
+  async registerTool(tool: ModelContextTool): Promise<void> {
+    if (!tool || !tool.name) {
+      throw new Error('Tool must have a valid name');
+    }
+    this._tools.set(tool.name, tool);
+    const event = new Event('toolchange');
+    this.dispatchEvent(event);
+    if (typeof this.ontoolchange === 'function') {
+      this.ontoolchange(event);
+    }
+  }
+
+  async unregisterTool(name: string): Promise<void> {
+    if (this._tools.has(name)) {
+      this._tools.delete(name);
+      const event = new Event('toolchange');
+      this.dispatchEvent(event);
+      if (typeof this.ontoolchange === 'function') {
+        this.ontoolchange(event);
+      }
+    }
+  }
+
+  async getTools(): Promise<ModelContextTool[]> {
+    const toolsMap = new Map<string, ModelContextTool>(this._tools);
+
+    // Also scan DOM for declarative forms with toolname
+    if (typeof document !== 'undefined') {
+      const declarativeForms = document.querySelectorAll<HTMLFormElement>('form[toolname]');
+      declarativeForms.forEach((form) => {
+        const toolName = form.getAttribute('toolname');
+        if (!toolName || toolsMap.has(toolName)) return;
+
+        const description = form.getAttribute('tooldescription') || '';
+        const properties: Record<string, any> = {};
+        const required: string[] = [];
+
+        const inputs = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
+        inputs.forEach((input) => {
+          const name = input.getAttribute('name');
+          if (!name) return;
+
+          const paramDesc = input.getAttribute('toolparamdescription') || input.getAttribute('placeholder') || name;
+          const paramType = (input as HTMLInputElement).type === 'number' ? 'number' : (input as HTMLInputElement).type === 'checkbox' ? 'boolean' : 'string';
+
+          properties[name] = {
+            type: paramType,
+            description: paramDesc,
+          };
+
+          if (input.required) {
+            required.push(name);
+          }
+        });
+
+        toolsMap.set(toolName, {
+          name: toolName,
+          description,
+          inputSchema: {
+            type: 'object',
+            properties,
+            required,
+          },
+          execute: async (args: any) => {
+            if (args && typeof args === 'object') {
+              for (const [key, value] of Object.entries(args)) {
+                const inputEl = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${key}"]`);
+                if (inputEl) {
+                  inputEl.value = String(value);
+                  inputEl.dispatchEvent(new Event('input', { bubbles: true }));
+                  inputEl.dispatchEvent(new Event('change', { bubbles: true }));
+                }
+              }
+            }
+            form.requestSubmit();
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: `Form ${toolName} submitted.`,
+                },
+              ],
+            };
+          },
+        });
+      });
+    }
+
+    return Array.from(toolsMap.values());
+  }
+
+  async executeTool(toolOrName: string | ModelContextTool, inputObject: any = {}): Promise<any> {
+    const name = typeof toolOrName === 'string' ? toolOrName : toolOrName.name;
+    const tools = await this.getTools();
+    const tool = tools.find((t) => t.name === name);
+    if (!tool) {
+      throw new Error(`Tool "${name}" not found`);
+    }
+    return await tool.execute(inputObject);
+  }
+}
+
+/**
+ * Initializes modelContext on document, navigator, and window if not present.
+ */
+export function initWebMCP(): ModelContextInterface | null {
+  if (typeof window === 'undefined') return null;
+
+  let modelContext: ModelContextInterface | undefined =
+    (document as any).modelContext || (navigator as any).modelContext || (window as any).modelContext;
+
+  if (!modelContext) {
+    const polyfill = new PolyfillModelContext();
+    (document as any).modelContext = polyfill;
+    (navigator as any).modelContext = polyfill;
+    (window as any).modelContext = polyfill;
+    modelContext = polyfill;
+  } else {
+    // Ensure aliases exist across document, navigator, window
+    if (!(document as any).modelContext) (document as any).modelContext = modelContext;
+    if (!(navigator as any).modelContext) (navigator as any).modelContext = modelContext;
+    if (!(window as any).modelContext) (window as any).modelContext = modelContext;
+  }
+
+  return modelContext;
+}
+
+/**
+ * Registers one or more tool definitions with WebMCP and returns an unregister function.
+ */
+export function registerWebMCPTool(tools: ModelContextTool | ModelContextTool[]): () => void {
+  if (typeof window === 'undefined') return () => {};
+
+  const modelContext = initWebMCP();
+  if (!modelContext) return () => {};
+
+  const toolList = Array.isArray(tools) ? tools : [tools];
+
+  for (const tool of toolList) {
+    try {
+      modelContext.registerTool(tool);
+    } catch (e) {
+      console.debug(`[WebMCP] Could not register tool "${tool.name}":`, e);
+    }
+  }
+
+  return () => {
+    for (const tool of toolList) {
+      try {
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(tool.name);
+        }
+      } catch (e) {
+        console.debug(`[WebMCP] Could not unregister tool "${tool.name}":`, e);
+      }
+    }
+  };
+}
