+        reselectBtn.addEventListener('click', () => {
+          finderForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        });
+      }
+
+      resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    }
+  </script>
