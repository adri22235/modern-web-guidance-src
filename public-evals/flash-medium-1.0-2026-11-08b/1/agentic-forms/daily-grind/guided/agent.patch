+
+    function calculateOrderPrice(basePrice, size) {
+      if (size === '12oz') return (basePrice - 0.50).toFixed(2);
+      if (size === '16oz') return basePrice.toFixed(2);
+      if (size === '20oz') return (basePrice + 0.75).toFixed(2);
+      if (size === 'whole-bean') return '16.50';
+      return basePrice.toFixed(2);
+    }
+
+    function findMatchingCoffee(preferences) {
+      // Find the first matching coffee in catalog according to priority logic
+      const matched = COFFEE_CATALOG.find((coffee) => coffee.matchLogic(preferences)) || COFFEE_CATALOG[5];
+      const finalPrice = calculateOrderPrice(matched.basePrice, preferences.size);
+      const orderRef = 'DG-' + Math.floor(100000 + Math.random() * 900000);
+
+      const sizeLabels = {
+        '12oz': 'Small (12 oz)',
+        '16oz': 'Medium (16 oz)',
+        '20oz': 'Large (20 oz)',
+        'whole-bean': 'Whole Bean Bag (12 oz)'
+      };
+
+      const milkLabels = {
+        'oat': 'Oat Milk',
+        'almond': 'Almond Milk',
+        'whole': 'Whole Milk',
+        'none': 'Black / No Milk'
+      };
+
+      return {
+        item: matched,
+        orderSummary: {
+          orderNumber: orderRef,
+          roast: preferences.roast,
+          flavor: preferences.flavor,
+          brewMethod: preferences.brew_method,
+          milk: milkLabels[preferences.milk] || preferences.milk,
+          size: sizeLabels[preferences.size] || preferences.size,
+          notes: preferences.notes || 'None',
+          price: finalPrice
+        },
+        pickupEstimate: 'Ready for pickup in ~4 minutes at downtown counter'
+      };
+    }
+
+    // --- WebMCP Tool Registration & Lifecycle Events ---
+    const finderForm = document.getElementById('coffee-finder-form');
+    const resultsContainer = document.getElementById('finder-results');
+    const agentBadge = document.getElementById('agent-status-badge');
+
+    // Backward-compatible target selector for WebMCP lifecycle events
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', (e) => {
+      if (!e?.toolName || e.toolName === 'find-coffee') {
+        if (agentBadge) {
+          agentBadge.classList.add('active');
+          agentBadge.textContent = '🤖 Agent executing "find-coffee" tool...';
+        }
+      }
+    });
+
+    targetFor('toolcancel', (e) => {
+      if (agentBadge) {
+        agentBadge.classList.remove('active');
+        agentBadge.textContent = '🤖 WebMCP Tool Enabled: find-coffee';
+      }
+    });
+
+    // --- Interactive Form Submission Handling ---
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(finderForm);
+      const preferences = {
+        roast: formData.get('roast') || 'medium',
+        flavor: formData.get('flavor') || 'caramel-maple',
+        brew_method: formData.get('brew_method') || 'espresso-latte',
+        milk: formData.get('milk') || 'oat',
+        size: formData.get('size') || '16oz',
+        notes: (formData.get('notes') || '').trim()
+      };
+
+      // Form validation
+      const validationErrors = [];
+      if (!preferences.roast) {
+        validationErrors.push({ field: 'roast', message: 'Roast preference is required' });
+      }
+      if (!preferences.flavor) {
+        validationErrors.push({ field: 'flavor', message: 'Flavor profile is required' });
+      }
+      if (!preferences.brew_method) {
+        validationErrors.push({ field: 'brew_method', message: 'Brew method is required' });
+      }
+
+      if (validationErrors.length > 0) {
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          const errorMsg = 'Validation failed: ' +
+            validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+          event.respondWith(Promise.resolve(errorMsg));
+        }
+        return;
+      }
+
+      // Generate recommendation & quick order preparation
+      const result = findMatchingCoffee(preferences);
+
+      // Render interactive match card for users in browser
+      renderRecommendationUI(result);
+
+      // If invoked by AI agent via WebMCP declarative tool API, respond via event.respondWith
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        const agentResponsePromise = Promise.resolve({
+          status: 'success',
+          toolName: 'find-coffee',
+          match: {
+            name: result.item.name,
+            roast: result.item.roast,
+            tastingNotes: result.item.tastingNotes,
+            description: result.item.description,
+            recommendedBrew: result.item.recommendedBrew
+          },
+          orderSummary: result.orderSummary,
+          pickupEstimate: result.pickupEstimate,
+          message: `Successfully matched "${result.item.name}" ($${result.orderSummary.price}, ${result.orderSummary.size}) based on customer preferences. Quick-order reference: ${result.orderSummary.orderNumber}.`
+        });
+
+        event.respondWith(agentResponsePromise);
+      }
+    });
+
+    finderForm.addEventListener('reset', () => {
+      resultsContainer.hidden = true;
+      resultsContainer.innerHTML = '';
+      if (agentBadge) {
+        agentBadge.classList.remove('active');
+        agentBadge.textContent = '🤖 WebMCP Tool Enabled: find-coffee';
