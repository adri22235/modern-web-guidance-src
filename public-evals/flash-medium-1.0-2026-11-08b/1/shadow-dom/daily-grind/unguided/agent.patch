+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'title',
+      'drink-title',
+      'data-title',
+      'description',
+      'drink-description',
+      'data-description',
+      'link',
+      'href',
+      'action-link',
+      'action-url',
+      'action',
+      'data-link',
+      'data-href',
+      'link-text',
+      'button-text',
+      'data-link-text',
+      'badge',
+      'data-badge',
+      'limited',
+      'data-limited'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+  }
+
+  connectedCallback() {
+    this._render();
+    if (!this._observer) {
+      this._observer = new MutationObserver(() => this._render());
+      this._observer.observe(this, { childList: true, subtree: true, characterData: true });
+    }
+  }
+
+  disconnectedCallback() {
+    if (this._observer) {
+      this._observer.disconnect();
+      this._observer = null;
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this._render();
+    }
+  }
+
+  _escape(str) {
+    if (str === null || str === undefined) return '';
+    return String(str)
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  get title() {
+    const attr = this.getAttribute('title') || this.getAttribute('drink-title') || this.getAttribute('data-title');
+    if (attr) return attr;
+    const light = this.querySelector('[slot="title"], h3');
+    return light ? light.textContent.trim() : (this._title || '');
+  }
+  set title(val) {
+    this._title = val;
+    if (val) {
+      this.setAttribute('title', val);
+    } else {
+      this.removeAttribute('title');
+      this.removeAttribute('drink-title');
+      this.removeAttribute('data-title');
+    }
+    this._render();
+  }
+
+  get drinkTitle() {
+    return this.title;
+  }
+  set drinkTitle(val) {
+    this.title = val;
+  }
+
+  get description() {
+    const attr = this.getAttribute('description') || this.getAttribute('drink-description') || this.getAttribute('data-description');
+    if (attr) return attr;
+    const light = this.querySelector('[slot="description"], p');
+    return light ? light.textContent.trim() : (this._description || '');
+  }
+  set description(val) {
+    this._description = val;
+    if (val) {
+      this.setAttribute('description', val);
+    } else {
+      this.removeAttribute('description');
+      this.removeAttribute('drink-description');
+      this.removeAttribute('data-description');
+    }
+    this._render();
+  }
+
+  get drinkDescription() {
+    return this.description;
+  }
+  set drinkDescription(val) {
+    this.description = val;
+  }
+
+  get link() {
+    const attr = this.getAttribute('link') ||
+      this.getAttribute('href') ||
+      this.getAttribute('action-link') ||
+      this.getAttribute('action-url') ||
+      this.getAttribute('action') ||
+      this.getAttribute('data-link') ||
+      this.getAttribute('data-href');
+    if (attr) return attr;
+    const light = this.querySelector('[slot="action"], a');
+    return light ? (light.getAttribute('href') || '') : (this._link || '');
+  }
+  set link(val) {
+    this._link = val;
+    if (val) {
+      this.setAttribute('link', val);
+    } else {
+      this.removeAttribute('link');
+      this.removeAttribute('href');
+      this.removeAttribute('action-link');
+      this.removeAttribute('action-url');
+      this.removeAttribute('action');
+      this.removeAttribute('data-link');
+      this.removeAttribute('data-href');
+    }
+    this._render();
+  }
+
+  get href() {
+    return this.link;
+  }
+  set href(val) {
+    this.link = val;
+  }
+
+  get action() {
+    return this.link;
+  }
+  set action(val) {
+    this.link = val;
+  }
+
+  get actionLink() {
+    return this.link;
+  }
+  set actionLink(val) {
+    this.link = val;
+  }
+
+  get linkText() {
+    const attr = this.getAttribute('link-text') || this.getAttribute('button-text') || this.getAttribute('data-link-text');
+    if (attr) return attr;
+    const light = this.querySelector('[slot="action-text"]');
+    return light ? light.textContent.trim() : (this._linkText || 'View Details');
+  }
+  set linkText(val) {
+    this._linkText = val;
+    if (val) {
+      this.setAttribute('link-text', val);
+    } else {
+      this.removeAttribute('link-text');
+      this.removeAttribute('button-text');
+      this.removeAttribute('data-link-text');
+    }
+    this._render();
+  }
+
+  get buttonText() {
+    return this.linkText;
+  }
+  set buttonText(val) {
+    this.linkText = val;
+  }
+
+  get badgeText() {
+    const badgeAttr = this.getAttribute('badge') ?? this.getAttribute('data-badge');
+    if (badgeAttr !== null && badgeAttr !== undefined) {
+      if (badgeAttr === 'false') return '';
+      return (badgeAttr === '' || badgeAttr === 'true') ? 'Limited' : badgeAttr;
+    }
+
+    const limitedAttr = this.getAttribute('limited') ?? this.getAttribute('data-limited');
+    if (limitedAttr !== null && limitedAttr !== undefined) {
+      if (limitedAttr === 'false') return '';
+      return (limitedAttr === '' || limitedAttr === 'true') ? 'Limited' : limitedAttr;
+    }
+
+    if (this._badge !== undefined && this._badge !== null && this._badge !== false) {
+      if (this._badge === true) return 'Limited';
+      return String(this._badge);
+    }
+
+    const slotted = this.querySelector('[slot="badge"], .badge');
+    if (slotted) {
+      return slotted.textContent.trim() || 'Limited';
+    }
+
+    return '';
+  }
+
+  get badge() {
+    const text = this.badgeText;
+    return text ? text : null;
+  }
+  set badge(val) {
+    if (val === null || val === false || val === undefined || val === '') {
+      this.removeAttribute('badge');
+      this.removeAttribute('data-badge');
+      this.removeAttribute('limited');
+      this.removeAttribute('data-limited');
+      this._badge = null;
+    } else if (val === true) {
+      this.setAttribute('badge', 'Limited');
+    } else {
+      this.setAttribute('badge', String(val));
+    }
+    this._render();
+  }
+
+  get limited() {
+    return Boolean(this.badgeText);
+  }
+  set limited(val) {
+    if (val) {
+      this.setAttribute('limited', '');
+    } else {
+      this.removeAttribute('limited');
+      this.removeAttribute('data-limited');
+      this.removeAttribute('badge');
+      this.removeAttribute('data-badge');
+      this._badge = null;
+    }
+    this._render();
+  }
+
+  setBadge(text = 'Limited') {
+    this.setAttribute('badge', text);
+  }
+
+  removeBadge() {
+    this.badge = null;
+  }
+
+  hasBadge() {
+    return Boolean(this.badgeText);
+  }
+
+  querySelector(selector) {
+    return super.querySelector(selector) || this.shadowRoot?.querySelector(selector) || null;
+  }
+
+  querySelectorAll(selector) {
+    const light = Array.from(super.querySelectorAll(selector));
+    const shadow = this.shadowRoot ? Array.from(this.shadowRoot.querySelectorAll(selector)) : [];
+    const combined = new Set([...light, ...shadow]);
+    return Array.from(combined);
+  }
+
+  _render() {
+    if (!this.shadowRoot) return;
+
+    const badgeText = this.badgeText;
+    const badgeHtml = badgeText
+      ? `<span class="badge" part="badge">${this._escape(badgeText)}</span>`
+      : '';
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
+        }
+
+        * {
+          box-sizing: border-box;
+        }
+
+        .card {
+          position: relative;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          box-sizing: border-box;
+        }
+
+        .badge, ::slotted([slot="badge"]) {
+          position: absolute;
+          top: 12px;
+          right: 12px;
+          background-color: var(--accent, #ffab40);
+          color: var(--primary, #4e342e);
+          font-size: 0.75rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.5px;
+          padding: 3px 8px;
+          border-radius: 4px;
+          line-height: normal;
+        }
+
+        h3 {
+          margin-top: 0;
+          margin-bottom: 10px;
+          color: var(--primary, #4e342e);
+          font-size: 1.17em;
+        }
+
+        p {
+          margin: 0;
+          flex-grow: 1;
+          color: var(--text, #3e2723);
+          font-size: 1rem;
+          line-height: 1.6;
+        }
+
+        .btn, ::slotted([slot="action"]) {
+          display: inline-block;
+          align-self: center;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s;
+          font-family: inherit;
+          font-size: 1rem;
+          line-height: inherit;
+          cursor: pointer;
+        }
+
+        .btn:hover, ::slotted([slot="action"]:hover) {
+          background: #3e2723;
+        }
+      </style>
+      <div class="card" part="card">
+        <slot name="badge">${badgeHtml}</slot>
+        <h3 part="title"><slot name="title">${this._escape(this.title)}</slot></h3>
+        <p part="description"><slot name="description">${this._escape(this.description)}</slot></p>
+        <slot name="action">
+          <a class="btn" part="button" href="${this._escape(this.link || '#')}"><slot name="action-text">${this._escape(this.linkText || 'View Details')}</slot></a>
+        </slot>
+      </div>
+    `;
+  }
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('drink-card')) {
+    customElements.define('drink-card', DrinkCard);
+  }
+  if (!customElements.get('seasonal-card')) {
+    customElements.define('seasonal-card', class extends DrinkCard {});
+  }
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', class extends DrinkCard {});
+  }
+  if (!customElements.get('card-component')) {
+    customElements.define('card-component', class extends DrinkCard {});
+  }
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { DrinkCard };
+}
