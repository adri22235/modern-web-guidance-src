+/**
+ * Reusable Drink Card Web Component
+ * Encapsulates card layout and styles within Shadow DOM.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      font-family: inherit;
+      color: var(--text, #3e2723);
+    }
+
+    :host([hidden]) {
+      display: none !important;
+    }
+
+    * {
+      box-sizing: border-box;
+    }
+
+    .card {
+      background: white;
+      padding: 24px 20px 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      height: 100%;
+    }
+
+    .badge-wrapper {
+      margin-bottom: 12px;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+    }
+
+    .badge-wrapper[hidden] {
+      display: none !important;
+    }
+
+    .badge,
+    ::slotted([slot="badge"]) {
+      display: inline-block;
+      background-color: var(--accent, #ffab40);
+      color: var(--primary, #4e342e);
+      font-size: 0.75rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      padding: 4px 10px;
+      border-radius: 9999px;
+      line-height: 1.2;
+    }
+
+    h3,
+    ::slotted(h3),
+    ::slotted([slot="title"]) {
+      margin: 0 0 10px 0;
+      color: var(--primary, #4e342e);
+      font-size: 1.25rem;
+      font-weight: bold;
+    }
+
+    p,
+    ::slotted(p),
+    ::slotted([slot="description"]) {
+      margin: 0 0 15px 0;
+      color: var(--text, #3e2723);
+      font-size: 1rem;
+      line-height: 1.6;
+      flex-grow: 1;
+    }
+
+    .btn,
+    ::slotted(a),
+    ::slotted([slot="action"]) {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: auto;
+      font-family: inherit;
+      font-size: 0.9rem;
+      font-weight: 500;
+      line-height: 1.5;
+      transition: background 0.3s;
+    }
+
+    .btn:hover,
+    ::slotted(a:hover),
+    ::slotted([slot="action"]:hover) {
+      background: #3e2723;
+    }
+  </style>
+
+  <div class="card" part="card">
+    <div class="badge-wrapper" part="badge-wrapper" id="badge-wrapper" hidden>
+      <slot name="badge"><span class="badge" part="badge" id="badge-el"></span></slot>
+    </div>
+    <slot name="title"><h3 part="title" id="title-el"></h3></slot>
+    <slot name="description"><p part="description" id="description-el"></p></slot>
+    <slot name="action"><a class="btn" part="action btn" id="action-el"></a></slot>
+    <slot></slot>
+  </div>
+`;
+
+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'title',
+      'drink-title',
+      'heading',
+      'description',
+      'desc',
+      'link',
+      'href',
+      'action-link',
+      'action-href',
+      'action-text',
+      'badge',
+      'limited'
+    ];
+  }
+
+  #badgeWrapper;
+  #badgeEl;
+  #titleEl;
+  #descEl;
+  #actionEl;
+  #badgeSlot;
+  #titleSlot;
+  #descSlot;
+  #actionSlot;
+  #mutationObserver;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this.#badgeWrapper = this.shadowRoot.getElementById('badge-wrapper');
+    this.#badgeEl = this.shadowRoot.getElementById('badge-el');
+    this.#titleEl = this.shadowRoot.getElementById('title-el');
+    this.#descEl = this.shadowRoot.getElementById('description-el');
+    this.#actionEl = this.shadowRoot.getElementById('action-el');
+
+    this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+    this.#titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+    this.#descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+    this.#actionSlot = this.shadowRoot.querySelector('slot[name="action"]');
+
+    if (this.#badgeSlot) {
+      this.#badgeSlot.addEventListener('slotchange', () => this.#update());
+    }
+    if (this.#titleSlot) {
+      this.#titleSlot.addEventListener('slotchange', () => this.#update());
+    }
+    if (this.#descSlot) {
+      this.#descSlot.addEventListener('slotchange', () => this.#update());
+    }
+    if (this.#actionSlot) {
+      this.#actionSlot.addEventListener('slotchange', () => this.#update());
+    }
+  }
+
+  connectedCallback() {
+    this.#assignSlots();
+    this.#update();
+
+    if (typeof MutationObserver !== 'undefined') {
+      this.#mutationObserver = new MutationObserver(() => {
+        this.#assignSlots();
+        this.#update();
+      });
+      this.#mutationObserver.observe(this, { childList: true, subtree: true, characterData: true });
+    }
+  }
+
+  disconnectedCallback() {
+    if (this.#mutationObserver) {
+      this.#mutationObserver.disconnect();
+      this.#mutationObserver = null;
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.#update();
+    }
+  }
+
+  #assignSlots() {
+    for (const child of this.children) {
+      if (!child.slot) {
+        const tag = child.tagName.toLowerCase();
+        if (tag === 'h3' || tag === 'h2' || tag === 'h4' || child.classList.contains('title')) {
+          child.slot = 'title';
+        } else if (tag === 'p' || child.classList.contains('description')) {
+          child.slot = 'description';
+        } else if (tag === 'a' || tag === 'button' || child.classList.contains('btn') || child.classList.contains('action')) {
+          child.slot = 'action';
+        } else if (child.classList.contains('badge') || child.textContent.trim().toLowerCase() === 'limited') {
+          child.slot = 'badge';
+        }
+      }
+    }
+  }
+
+  #update() {
+    if (!this.shadowRoot) return;
+
+    // 1. Badge handling
+    const slottedBadges = this.#badgeSlot ? this.#badgeSlot.assignedElements() : [];
+    const hasSlottedBadge = slottedBadges.length > 0;
+    const badgeAttr = this.getAttribute('badge');
+    const hasBadgeAttr = this.hasAttribute('badge') && badgeAttr !== 'false';
+    const hasLimitedAttr = this.hasAttribute('limited') && this.getAttribute('limited') !== 'false';
+
+    if (hasSlottedBadge) {
+      this.#badgeWrapper.hidden = false;
+      this.#badgeEl.hidden = true;
+      this.toggleAttribute('has-badge', true);
+    } else if (hasBadgeAttr || hasLimitedAttr) {
+      const badgeText = (badgeAttr && badgeAttr !== 'true' && badgeAttr !== '') ? badgeAttr : 'Limited';
+      this.#badgeEl.textContent = badgeText;
+      this.#badgeEl.hidden = false;
+      this.#badgeWrapper.hidden = false;
+      this.toggleAttribute('has-badge', true);
+    } else {
+      this.#badgeEl.textContent = '';
+      this.#badgeEl.hidden = true;
+      this.#badgeWrapper.hidden = true;
+      this.toggleAttribute('has-badge', false);
+    }
+
+    // 2. Title handling
+    const slottedTitles = this.#titleSlot ? this.#titleSlot.assignedElements() : [];
+    if (slottedTitles.length > 0) {
+      this.#titleEl.hidden = true;
+    } else {
+      const titleText = this.getAttribute('title') || this.getAttribute('drink-title') || this.getAttribute('heading') || '';
+      this.#titleEl.textContent = titleText;
+      this.#titleEl.hidden = !titleText;
+    }
+
+    // 3. Description handling
+    const slottedDescs = this.#descSlot ? this.#descSlot.assignedElements() : [];
+    if (slottedDescs.length > 0) {
+      this.#descEl.hidden = true;
+    } else {
+      const descText = this.getAttribute('description') || this.getAttribute('desc') || '';
+      this.#descEl.textContent = descText;
+      this.#descEl.hidden = !descText;
+    }
+
+    // 4. Action handling
+    const slottedActions = this.#actionSlot ? this.#actionSlot.assignedElements() : [];
+    if (slottedActions.length > 0) {
+      this.#actionEl.hidden = true;
+    } else {
+      const actionHref = this.getAttribute('link') || this.getAttribute('href') || this.getAttribute('action-link') || this.getAttribute('action-href') || '';
+      const actionText = this.getAttribute('action-text') || 'View Details';
+      this.#actionEl.href = actionHref;
+      this.#actionEl.textContent = actionText;
+      this.#actionEl.hidden = !actionHref && !this.hasAttribute('action-text');
+    }
+  }
+
+  // Properties reflection
+  get drinkTitle() {
+    return this.getAttribute('drink-title') || this.getAttribute('title') || '';
+  }
+  set drinkTitle(v) {
+    v ? this.setAttribute('drink-title', v) : this.removeAttribute('drink-title');
+  }
+
+  get heading() {
+    return this.drinkTitle;
+  }
+  set heading(v) {
+    this.drinkTitle = v;
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? this.getAttribute('desc') ?? '';
+  }
+  set description(v) {
+    v ? this.setAttribute('description', v) : this.removeAttribute('description');
+  }
+
+  get link() {
+    return this.getAttribute('link') ?? this.getAttribute('href') ?? '';
+  }
+  set link(v) {
+    v ? this.setAttribute('link', v) : this.removeAttribute('link');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? this.getAttribute('link') ?? '';
+  }
+  set href(v) {
+    v ? this.setAttribute('href', v) : this.removeAttribute('href');
+  }
+
+  get actionLink() {
+    return this.link;
+  }
+  set actionLink(v) {
+    this.link = v;
+  }
+
+  get actionText() {
+    return this.getAttribute('action-text') ?? 'View Details';
+  }
+  set actionText(v) {
+    v ? this.setAttribute('action-text', v) : this.removeAttribute('action-text');
+  }
+
+  get badge() {
+    return this.getAttribute('badge') ?? '';
+  }
+  set badge(v) {
+    if (v === null || v === false || v === undefined || v === '') {
+      this.removeAttribute('badge');
+      this.removeAttribute('limited');
+    } else {
+      this.setAttribute('badge', typeof v === 'string' ? v : 'Limited');
+    }
+  }
+
+  get limited() {
+    return this.hasAttribute('limited') || (this.hasAttribute('badge') && this.getAttribute('badge') !== 'false');
+  }
+  set limited(v) {
+    if (v) {
+      if (!this.hasAttribute('badge')) {
+        this.setAttribute('badge', 'Limited');
+      }
+    } else {
+      this.removeAttribute('badge');
+      this.removeAttribute('limited');
+    }
+  }
+
+  addBadge(text = 'Limited') {
+    this.badge = text;
+  }
+
+  removeBadge() {
+    this.badge = null;
+  }
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('drink-card')) {
+    customElements.define('drink-card', DrinkCard);
+  }
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', class extends DrinkCard {});
+  }
+  if (!customElements.get('seasonal-card')) {
+    customElements.define('seasonal-card', class extends DrinkCard {});
+  }
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { DrinkCard };
+}
