+  <script>
+    let autofillAbortController = new AbortController();
+    let isConditionalActive = false;
+
+    async function isConditionalGetSupported() {
+      if (typeof window === 'undefined' || !navigator?.credentials) {
+        return false;
+      }
+      if (typeof PublicKeyCredential !== 'undefined') {
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            const capabilities = await PublicKeyCredential.getClientCapabilities();
+            if (typeof capabilities?.conditionalGet === 'boolean') {
+              return capabilities.conditionalGet;
+            }
+          } catch (e) {
+            console.warn('getClientCapabilities error:', e);
+          }
+        }
+        if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+          try {
+            const available = await PublicKeyCredential.isConditionalMediationAvailable();
+            if (typeof available === 'boolean') {
+              return available;
+            }
+          } catch (e) {
+            console.warn('isConditionalMediationAvailable error:', e);
+          }
+        }
+      }
+      return true;
+    }
+
+    function base64UrlToBuffer(base64url) {
+      if (!base64url) return new ArrayBuffer(0);
+      if (base64url instanceof ArrayBuffer) return base64url;
+      if (ArrayBuffer.isView(base64url)) return base64url.buffer;
+      let base64 = String(base64url).replace(/-/g, '+').replace(/_/g, '/');
+      while (base64.length % 4) {
+        base64 += '=';
+      }
+      const binary = atob(base64);
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      return bytes.buffer;
+    }
+
+    function bufferToBase64Url(buffer) {
+      if (!buffer) return null;
+      if (typeof buffer === 'string') return buffer;
+      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary)
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+    }
+
+    function parseRequestOptions(loginOptionsJSON) {
+      const options = loginOptionsJSON.publicKey || loginOptionsJSON;
+      if (
+        typeof PublicKeyCredential !== 'undefined' &&
+        typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function' &&
+        typeof options.challenge === 'string'
+      ) {
+        try {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+        } catch (e) {
+          console.warn('parseRequestOptionsFromJSON fallback:', e);
+        }
+      }
+
+      const res = { ...options };
+      if (typeof res.challenge === 'string') {
+        res.challenge = base64UrlToBuffer(res.challenge);
+      }
+      if (Array.isArray(res.allowCredentials)) {
+        res.allowCredentials = res.allowCredentials.map(cred => ({
+          ...cred,
+          id: typeof cred.id === 'string' ? base64UrlToBuffer(cred.id) : cred.id,
+        }));
+      }
+      return res;
+    }
+
+    function encodeCredential(credential) {
+      if (typeof credential.toJSON === 'function') {
+        return credential.toJSON();
+      }
+      const resp = credential.response || {};
+      return {
+        id: credential.id,
+        rawId: credential.rawId ? bufferToBase64Url(credential.rawId) : credential.id,
+        type: credential.type || 'public-key',
+        response: {
+          authenticatorData: bufferToBase64Url(resp.authenticatorData),
+          clientDataJSON: bufferToBase64Url(resp.clientDataJSON),
+          signature: bufferToBase64Url(resp.signature),
+          userHandle: resp.userHandle ? bufferToBase64Url(resp.userHandle) : null,
+        },
+        authenticatorAttachment: credential.authenticatorAttachment,
+        clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+      };
+    }
+
+    async function optionsFetch() {
+      const response = await fetch('/api/login/options');
+      if (!response.ok) {
+        throw new Error(`Failed to fetch login options: ${response.status}`);
+      }
+      return await response.json();
+    }
+
+    async function loginVerifyFetch(encoded) {
+      return await fetch('/api/login/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encoded),
+      });
+    }
+
+    async function verifyCredential(encoded, publicKey) {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          let data = null;
+          let text = '';
+          try {
+            text = await response.text();
+            data = JSON.parse(text);
+          } catch {
+            // response text is not json
+          }
+          if (statusEl) {
+            const msg = (data && (data.message || data.status || data.user || data.username)) ||
+              (text && !text.startsWith('{') && text.trim().length > 0 ? text : 'Authenticated successfully');
+            statusEl.textContent = msg;
+            statusEl.setAttribute('data-status', 'success');
+          }
+          return true;
+        } else if (response.status === 404) {
+          if (typeof PublicKeyCredential !== 'undefined' && PublicKeyCredential.signalUnknownCredential) {
+            try {
+              const rpId = publicKey.rpId || publicKey.rp?.id;
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId,
+                credentialId: encoded.id,
+              });
+            } catch (signalErr) {
+              console.warn('signalUnknownCredential error:', signalErr);
+            }
+          }
+          if (statusEl) {
+            statusEl.textContent = 'Authentication failed: Credential not found';
+            statusEl.setAttribute('data-status', 'error');
+          }
+        } else {
+          if (statusEl) {
+            statusEl.textContent = 'Authentication failed';
+            statusEl.setAttribute('data-status', 'error');
+          }
+        }
+      } catch (err) {
+        console.error('Verification request error:', err);
+        if (statusEl) {
+          statusEl.textContent = 'Verification error';
+          statusEl.setAttribute('data-status', 'error');
+        }
+      }
+      return false;
+    }
+
+    async function initializeConditionalAutofill() {
+      if (isConditionalActive) return;
+      const supported = await isConditionalGetSupported();
+      if (!supported) return;
+
+      if (autofillAbortController.signal.aborted) {
+        autofillAbortController = new AbortController();
+      }
+
+      try {
+        isConditionalActive = true;
+        const loginOptionsJSON = await optionsFetch();
+        const publicKey = parseRequestOptions(loginOptionsJSON);
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+
+        if (credential) {
+          const encoded = encodeCredential(credential);
+          await verifyCredential(encoded, publicKey);
+        }
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) {
+          return;
+        }
+        console.error('Unexpected conditional get error:', err);
+      } finally {
+        isConditionalActive = false;
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+      isConditionalActive = false;
+
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        const publicKey = parseRequestOptions(loginOptionsJSON);
+
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: autofillAbortController.signal,
+          });
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            console.log('User cancelled passkey login.');
+          } else if (err.name === 'AbortError') {
+            console.log('The authentication operation was aborted.');
+          }
+          initializeConditionalAutofill();
+          return;
+        }
+
+        if (credential) {
+          const encoded = encodeCredential(credential);
+          await verifyCredential(encoded, publicKey);
+        }
+      } catch (err) {
+        console.error('Button authentication error:', err);
+        initializeConditionalAutofill();
+      }
+    }
+
+    function initAuth() {
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      if (authButton) {
+        authButton.addEventListener('click', (e) => {
+          e.preventDefault();
+          triggerButtonAuthentication();
+        });
+      }
+
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (!isConditionalActive) {
+            initializeConditionalAutofill();
+          }
+        });
+      }
+
+      const signinForm = document.getElementById('signin-form');
+      if (signinForm) {
+        signinForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          triggerButtonAuthentication();
+        });
+      }
+
+      initializeConditionalAutofill();
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initAuth);
+    } else {
+      initAuth();
+    }
+
+    window.initializeConditionalAutofill = initializeConditionalAutofill;
+    window.triggerButtonAuthentication = triggerButtonAuthentication;
+  </script>
 </body>
 
