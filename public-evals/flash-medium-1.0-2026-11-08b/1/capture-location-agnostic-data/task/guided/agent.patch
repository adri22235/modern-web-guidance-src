+  <script type="module">
+    // Feature detect Temporal API or dynamically load polyfill
+    async function initTemporal() {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/temporal-polyfill');
+          globalThis.Temporal = module.Temporal;
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        } catch {
+          try {
+            const localModule = await import('./node_modules/temporal-polyfill/index.js');
+            globalThis.Temporal = localModule.Temporal;
+            Date.prototype.toTemporalInstant = localModule.toTemporalInstant;
+          } catch (err) {
+            console.error('Failed to load Temporal polyfill:', err);
+          }
+        }
+      }
+    }
+
+    async function initPreferences() {
+      await initTemporal();
+
+      const pickupInput = document.getElementById('pickup-time');
+      const anniversaryInput = document.getElementById('anniversary-date');
+      const form = document.getElementById('preferences-form');
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const scheduleDetails = document.getElementById('schedule-details');
+      const saveStatus = document.getElementById('save-status');
+
+      // Default values if not yet set in localStorage
+      const defaultTime = '08:00';
+      const defaultDate = '2024-10-01';
+
+      // Load saved location-agnostic ISO strings from localStorage
+      const savedTimeStr = localStorage.getItem('dailyPickupTime') || defaultTime;
+      const savedDateStr = localStorage.getItem('coffeeAnniversaryDate') || defaultDate;
+
+      function render(timePlain, datePlain) {
+        // Read calendar and clock fields directly from Plain types without time zone conversion
+        const formattedTime = timePlain.toLocaleString(undefined, {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+
+        const formattedDate = datePlain.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        });
+
+        displayPickupTime.textContent = formattedTime;
+        displayAnniversaryDate.textContent = formattedDate;
+
+        // Combine into location-agnostic PlainDateTime without string interpolation
+        const today = Temporal.Now.plainDateISO();
+        const nextPickupDateTime = today.toPlainDateTime(timePlain);
+
+        // Model recurring annual anniversary using PlainMonthDay without time zone drift
+        const anniversaryMonthDay = datePlain.toPlainMonthDay();
+        let nextOccurrence = anniversaryMonthDay.toPlainDate({ year: today.year });
+        if (Temporal.PlainDate.compare(nextOccurrence, today) < 0) {
+          nextOccurrence = anniversaryMonthDay.toPlainDate({ year: today.year + 1 });
+        }
+        const daysToNext = today.until(nextOccurrence, { largestUnit: 'days' }).days;
+
+        const celebrationText = daysToNext === 0
+          ? 'Today is your coffee anniversary!'
+          : `${daysToNext} day${daysToNext === 1 ? '' : 's'} until your next annual celebration.`;
+
+        scheduleDetails.textContent = `Daily pickup reminder is set for ${formattedTime} wall-clock time wherever you travel. Member since ${formattedDate} (${celebrationText}). Both stay fixed without time zone drift.`;
+
+        // Update form inputs to match
+        pickupInput.value = timePlain.toString().slice(0, 5);
+        anniversaryInput.value = datePlain.toString();
+      }
+
+      try {
+        const initialTime = Temporal.PlainTime.from(savedTimeStr);
+        const initialDate = Temporal.PlainDate.from(savedDateStr);
+        render(initialTime, initialDate);
+      } catch (err) {
+        console.error('Error parsing initial schedule:', err);
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!pickupInput.value || !anniversaryInput.value) return;
+
+        try {
+          // Parse directly to Temporal Plain types (no time zone offset)
+          const newTime = Temporal.PlainTime.from(pickupInput.value);
+          const newDate = Temporal.PlainDate.from(anniversaryInput.value);
+
+          // Save location-agnostic ISO strings
+          localStorage.setItem('dailyPickupTime', newTime.toString());
+          localStorage.setItem('coffeeAnniversaryDate', newDate.toString());
+
+          render(newTime, newDate);
+
+          saveStatus.textContent = 'Saved! Location-agnostic schedule updated.';
+          setTimeout(() => {
+            saveStatus.textContent = '';
+          }, 3500);
+        } catch (err) {
+          console.error('Failed to update schedule:', err);
+          saveStatus.style.color = '#c62828';
+          saveStatus.textContent = 'Error saving schedule. Please check input values.';
+        }
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initPreferences);
+    } else {
+      initPreferences();
+    }
+  </script>
