diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,30 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Minimal Fetch</title>
+</head>
+<body>
+  <button id="action-btn">Load Data</button>
+
+  <script>
+    document.getElementById('action-btn').addEventListener('click', () => {
+      // Mission-critical data request with high priority
+      fetch('/api/data', {
+        priority: 'high'
+      });
+
+      // Background analytics request deprioritized to avoid network contention
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+    });
+  </script>
+</body>
+</html>
