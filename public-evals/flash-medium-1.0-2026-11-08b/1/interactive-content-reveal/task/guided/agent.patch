+    /* Registered custom properties for smooth spotlight size transitions */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    /* Seasonal Favorites Cards with Spotlight Reveal Effect */
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      transition: --inner-size 0.2s ease-in-out, --outer-size 0.2s ease-in-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 100px;
+      --outer-size: 120px;
+    }
+
+    /* Spotlight reveal overlay */
+    .reveal-layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+      background: linear-gradient(145deg, #2b1a13 0%, #3e2723 100%);
+      color: #fafafa;
+      padding: 20px;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+      box-sizing: border-box;
+
+      /* Only transition the size properties, NOT the position variables */
+      transition: --inner-size 0.2s ease-in-out, --outer-size 0.2s ease-in-out;
+
+      -webkit-mask-image: radial-gradient(
+        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      mask-image: radial-gradient(
+        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    /* Disable transition scaling for motion-sensitive users */
+    @media (prefers-reduced-motion: reduce) {
+      .product-card,
+      .reveal-layer {
+        transition: none !important;
+      }
+    }
+
