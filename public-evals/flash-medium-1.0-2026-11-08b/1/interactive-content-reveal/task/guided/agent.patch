+  <script>
+    (() => {
+      const cards = document.querySelectorAll('.product-card');
+
+      cards.forEach((card) => {
+        let rect = card.getBoundingClientRect();
+        const resizeObserver = new ResizeObserver(() => {
+          rect = card.getBoundingClientRect();
+        });
+        resizeObserver.observe(card);
+
+        function updatePosition(e) {
+          if (!rect.width || !rect.height) {
+            rect = card.getBoundingClientRect();
+          }
+          const width = rect.width || card.offsetWidth || 1;
+          const height = rect.height || card.offsetHeight || 1;
+          const x = ((e.clientX - rect.left) / width) * 100;
+          const y = ((e.clientY - rect.top) / height) * 100;
+
+          card.style.setProperty('--mouse-x', `${x}%`);
+          card.style.setProperty('--mouse-y', `${y}%`);
+        }
+
+        card.addEventListener('pointerenter', updatePosition);
+        card.addEventListener('pointermove', updatePosition);
+        card.addEventListener('mouseenter', updatePosition);
+        card.addEventListener('mousemove', updatePosition);
+      });
+    })();
+  </script>
