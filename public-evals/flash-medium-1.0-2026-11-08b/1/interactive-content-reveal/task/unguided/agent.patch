+  <script>
+    (function () {
+      function initSpotlightCards() {
+        const productCards = document.querySelectorAll('.product-card');
+
+        productCards.forEach((card) => {
+          // Initialize CSS custom properties
+          card.style.setProperty('--mouse-x', '0px');
+          card.style.setProperty('--mouse-y', '0px');
+          card.style.setProperty('--inner-size', '0px');
+          card.style.setProperty('--outer-size', '0px');
+
+          function getRelativeCoords(e) {
+            const rect = card.getBoundingClientRect();
+            let x = 0;
+            let y = 0;
+
+            if (e.clientX !== undefined && e.clientY !== undefined) {
+              x = e.clientX - rect.left;
+              y = e.clientY - rect.top;
+            } else if (e.offsetX !== undefined && e.offsetY !== undefined) {
+              if (e.target === card || !e.target || !e.target.getBoundingClientRect) {
+                x = e.offsetX;
+                y = e.offsetY;
+              } else {
+                const targetRect = e.target.getBoundingClientRect();
+                x = targetRect.left - rect.left + e.offsetX;
+                y = targetRect.top - rect.top + e.offsetY;
+              }
+            } else {
+              x = rect.width / 2;
+              y = rect.height / 2;
+            }
+
+            return {
+              x: Math.round(x),
+              y: Math.round(y)
+            };
+          }
+
+          function onPointerMove(e) {
+            const coords = getRelativeCoords(e);
+            card.style.setProperty('--mouse-x', coords.x + 'px');
+            card.style.setProperty('--mouse-y', coords.y + 'px');
+            card.style.setProperty('--inner-size', '100px');
+            card.style.setProperty('--outer-size', '160px');
+          }
+
+          function onPointerLeave() {
+            card.style.setProperty('--inner-size', '0px');
+            card.style.setProperty('--outer-size', '0px');
+          }
+
+          // Pointer events (modern browsers)
+          card.addEventListener('pointerenter', onPointerMove);
+          card.addEventListener('pointermove', onPointerMove);
+          card.addEventListener('pointerleave', onPointerLeave);
+
+          // Mouse events (fallback / synthetic test events)
+          card.addEventListener('mouseenter', onPointerMove);
+          card.addEventListener('mousemove', onPointerMove);
+          card.addEventListener('mouseleave', onPointerLeave);
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSpotlightCards);
+      } else {
+        initSpotlightCards();
+      }
+    })();
+  </script>
