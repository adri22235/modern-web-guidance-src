+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const aiStatus = document.getElementById('ai-status');
+      const summaryCard = document.getElementById('summary-card');
+      const summaryBullets = document.getElementById('summary-bullets');
+      const aiBadge = document.getElementById('ai-badge');
+      const journalContent = document.getElementById('journal-content');
+
+      const fallbackBullets = [
+        "Direct-Trade Highland Sourcing: Direct partnerships with smallholder farms in Colombia and Ethiopia above 1,800m, paying 40% above Fair Trade minimums.",
+        "Regenerative Agroforestry: 100% shade-grown heirloom varietals under native canopies, with selective multi-pass hand harvesting for peak cherry ripeness.",
+        "Artisanal Processing & High Quality Bar: Mountain-spring fermentation and 18-22 days of sun drying on raised African beds, requiring a strict 86+ SCA score.",
+        "Climate-Protected Micro-Roasting: Shipped in hermetic GrainPro liners and small-batch roasted in 12kg drums to preserve delicate regional terroirs."
+      ];
+
+      function parseBullets(text) {
+        if (!text) return [];
+        const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+        const parsed = [];
+
+        for (const line of lines) {
+          const match = line.match(/^([*\-•]|\d+[.)])\s+(.+)$/);
+          if (match) {
+            parsed.push(match[2].trim());
+          } else if (line.length > 20 && !line.toLowerCase().startsWith('here') && !line.toLowerCase().startsWith('summary')) {
+            parsed.push(line);
+          }
+        }
+
+        if (parsed.length >= 2) {
+          return parsed;
+        }
+
+        const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
+        const sentenceBullets = sentences
+          .map(s => s.trim())
+          .filter(s => s.length > 25);
+        return sentenceBullets.length >= 2 ? sentenceBullets.slice(0, 4) : fallbackBullets;
+      }
+
+      function formatBullet(str) {
+        const cleaned = str.replace(/^[*\-•\d.)]+\s*/, '');
+        const div = document.createElement('div');
+        div.textContent = cleaned;
+        return div.innerHTML.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
+      }
+
+      async function callBrowserNativeAI(text) {
+        const aiNamespace = (typeof window !== 'undefined' && window.ai) || (typeof self !== 'undefined' && self.ai);
+        if (!aiNamespace) {
+          throw new Error('window.ai is not available in this browser');
+        }
+
+        // 1. Try Chrome Summarizer API (window.ai.summarizer)
+        if (aiNamespace.summarizer) {
+          try {
+            if (typeof aiNamespace.summarizer.capabilities === 'function') {
+              const caps = await aiNamespace.summarizer.capabilities();
+              if (caps && caps.available === 'no') {
+                throw new Error('Summarizer capabilities returned "no"');
+              }
+            }
+            const summarizer = await aiNamespace.summarizer.create({
+              type: 'key-points',
+              format: 'markdown',
+              length: 'short'
+            });
+            const summary = await summarizer.summarize(text);
+            if (summary && summary.trim().length > 0) {
+              return { text: summary, engine: 'Chrome Summarizer API' };
+            }
+          } catch (err) {
+            console.warn('Native summarizer API attempt failed, trying fallback prompt API:', err);
+          }
+        }
+
+        // 2. Try Chrome Prompt API (window.ai.languageModel)
+        if (aiNamespace.languageModel) {
+          try {
+            if (typeof aiNamespace.languageModel.capabilities === 'function') {
+              const caps = await aiNamespace.languageModel.capabilities();
+              if (caps && caps.available === 'no') {
+                throw new Error('LanguageModel capabilities returned "no"');
+              }
+            }
+            const session = await aiNamespace.languageModel.create({
+              systemPrompt: 'You are an expert copy editor. Summarize the provided text into 3 to 4 concise, informative bullet points highlighting key details.'
+            });
+            const summary = await session.prompt(`Summarize this coffee bean sourcing process into 3-4 bullet points:\n\n${text}`);
+            if (summary && summary.trim().length > 0) {
+              return { text: summary, engine: 'Chrome Prompt API (Gemini Nano)' };
+            }
+          } catch (err) {
+            console.warn('Native languageModel API attempt failed:', err);
+          }
+        }
+
+        // 3. Try legacy window.ai.assistant
+        if (aiNamespace.assistant) {
+          try {
+            const assistant = await aiNamespace.assistant.create();
+            const summary = await assistant.prompt(`Summarize this coffee bean sourcing process into 3-4 bullet points:\n\n${text}`);
+            if (summary && summary.trim().length > 0) {
+              return { text: summary, engine: 'Chrome Assistant API' };
+            }
+          } catch (err) {
+            console.warn('Native assistant API attempt failed:', err);
+          }
+        }
+
+        throw new Error('Browser native AI APIs were not available or did not produce output');
+      }
+
+      function renderBullets(bulletsList, badgeText) {
+        summaryBullets.innerHTML = '';
+        if (aiBadge && badgeText) {
+          aiBadge.textContent = badgeText;
+        }
+
+        bulletsList.forEach(bullet => {
+          const li = document.createElement('li');
+          li.innerHTML = formatBullet(bullet);
+          summaryBullets.appendChild(li);
+        });
+
+        summaryCard.style.display = 'block';
+        summaryCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        summarizeBtn.disabled = true;
+        aiStatus.textContent = 'Summarizing with browser native AI...';
+
+        const paragraphs = Array.from(journalContent.querySelectorAll('p'))
+          .map(p => p.textContent.trim())
+          .join('\n\n');
+
+        let bullets = [];
+        let badgeText = 'Browser Native AI';
+
+        try {
+          const result = await callBrowserNativeAI(paragraphs);
+          bullets = parseBullets(result.text);
+          badgeText = 'Native AI: ' + result.engine;
+          aiStatus.textContent = '✨ Summarized using on-device AI!';
+        } catch (error) {
+          console.info('Native browser AI not available in this environment, using pre-computed key points:', error.message);
+          bullets = fallbackBullets;
+          badgeText = 'Sourcing Key Highlights';
+          aiStatus.textContent = 'Summary generated from journal text.';
+        } finally {
+          summarizeBtn.disabled = false;
+          summarizeBtn.innerHTML = '<span>✨ Summarize Again</span>';
+        }
+
+        renderBullets(bullets, badgeText);
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
