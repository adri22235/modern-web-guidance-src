+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summarize-status');
+      const summaryContainer = document.getElementById('journal-summary');
+      const summaryContent = document.getElementById('summary-content');
+      const journalArticle = document.getElementById('journal-text');
+
+      if (!summarizeBtn || !journalArticle || !summaryContent || !summaryContainer) {
+        return;
+      }
+
+      function renderBulletPoints(container, text) {
+        container.innerHTML = '';
+        const lines = text
+          .split('\n')
+          .map(function (line) { return line.trim(); })
+          .filter(function (line) { return line.length > 0; });
+
+        const ul = document.createElement('ul');
+        ul.className = 'summary-bullet-list';
+
+        let count = 0;
+        lines.forEach(function (rawLine) {
+          const clean = rawLine.replace(/^([*•\-\+]|\d+[\.\)])\s*/, '').trim();
+          if (clean) {
+            const li = document.createElement('li');
+            li.textContent = clean;
+            ul.appendChild(li);
+            count++;
+          }
+        });
+
+        if (count > 0) {
+          container.appendChild(ul);
+        } else {
+          const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
+          sentences.forEach(function (s) {
+            const trimmed = s.trim();
+            if (trimmed) {
+              const li = document.createElement('li');
+              li.textContent = trimmed;
+              ul.appendChild(li);
+            }
+          });
+          container.appendChild(ul);
+        }
+      }
+
+      const fallbackPoints = [
+        "Direct-trade relationships with smallholder family farms ensure premium compensation above fair-trade standards.",
+        "High-altitude Arabica cherries (1,700–2,200m) are hand-picked at 20–22% Brix for maximum sweetness and density.",
+        "Washed and natural fermentation methods are tailored to highlight delicate jasmine, stone fruit, and berry notes.",
+        "Precision small-batch roasting unlocks each origin's distinctive terroir and flavor profile."
+      ];
+
+      summarizeBtn.addEventListener('click', async function () {
+        const articleText = (journalArticle.innerText || journalArticle.textContent || '').trim();
+
+        summarizeBtn.disabled = true;
+        statusEl.textContent = 'Summarizing...';
+
+        const options = {
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'medium'
+        };
+
+        try {
+          const SummarizerAPI = window.Summarizer || (typeof self !== 'undefined' ? self.Summarizer : undefined);
+
+          if (SummarizerAPI && typeof SummarizerAPI.availability === 'function') {
+            const availability = await SummarizerAPI.availability(options);
+
+            if (availability === 'available' || availability === 'readily') {
+              const summarizer = await SummarizerAPI.create(options);
+              const result = await summarizer.summarize(articleText);
+              renderBulletPoints(summaryContent, result);
+              summaryContainer.hidden = false;
+              statusEl.textContent = 'Summary generated successfully.';
+              if (typeof summarizer.destroy === 'function') {
+                summarizer.destroy();
+              }
+            } else if (
+              availability === 'downloadable' ||
+              availability === 'after-download' ||
+              availability === 'downloading'
+            ) {
+              statusEl.textContent = 'Downloading AI model...';
+              const summarizer = await SummarizerAPI.create({
+                ...options,
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    if (e.total) {
+                      const pct = Math.round((e.loaded / e.total) * 100);
+                      statusEl.textContent = `Downloading AI model: ${pct}%...`;
+                    }
+                  });
+                }
+              });
+              statusEl.textContent = 'Summarizing...';
+              const result = await summarizer.summarize(articleText);
+              renderBulletPoints(summaryContent, result);
+              summaryContainer.hidden = false;
+              statusEl.textContent = 'Summary generated successfully.';
+              if (typeof summarizer.destroy === 'function') {
+                summarizer.destroy();
+              }
+            } else {
+              statusEl.textContent = 'Native AI summarizer is currently unavailable on this device.';
+              renderBulletPoints(summaryContent, fallbackPoints.join('\n'));
+              summaryContainer.hidden = false;
+            }
+          } else if (typeof window.ai !== 'undefined' && window.ai && window.ai.summarizer) {
+            const capabilities = await window.ai.summarizer.capabilities();
+            if (capabilities.available !== 'no') {
+              const summarizer = await window.ai.summarizer.create(options);
+              const result = await summarizer.summarize(articleText);
+              renderBulletPoints(summaryContent, result);
+              summaryContainer.hidden = false;
+              statusEl.textContent = 'Summary generated successfully.';
+              if (typeof summarizer.destroy === 'function') {
+                summarizer.destroy();
+              }
+            } else {
+              statusEl.textContent = 'Native AI summarizer is unavailable.';
+              renderBulletPoints(summaryContent, fallbackPoints.join('\n'));
+              summaryContainer.hidden = false;
+            }
+          } else {
+            statusEl.textContent = 'Native AI summarizer not supported in this browser. Showing highlights:';
+            renderBulletPoints(summaryContent, fallbackPoints.join('\n'));
+            summaryContainer.hidden = false;
+          }
+        } catch (err) {
+          console.error('Summarization failed:', err);
+          statusEl.textContent = 'Error during AI summarization. Showing highlights:';
+          renderBulletPoints(summaryContent, fallbackPoints.join('\n'));
+          summaryContainer.hidden = false;
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
