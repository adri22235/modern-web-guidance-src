+      const presetButtons = document.querySelectorAll('.preset-btn');
+
+      function updateCardBackground(color) {
+        if (!color) return;
+        if (cardElement) {
+          cardElement.style.backgroundColor = color;
+        }
+        if (bgColorInput) {
+          bgColorInput.value = color;
+        }
+        if (hexLabel) {
+          hexLabel.textContent = color;
+        }
+        renderCardToCanvas();
+      }
+
+      function renderCardToCanvas() {
+        if (!cardElement || !canvas) return;
+
+        const ctx = canvas.getContext('2d');
+        if (!ctx) return;
+
+        const width = canvas.width;
+        const height = canvas.height;
+
+        // Clear canvas
+        ctx.clearRect(0, 0, width, height);
+
+        // Read background color
+        const bgColor = cardElement.style.backgroundColor ||
+          window.getComputedStyle(cardElement).backgroundColor ||
+          (bgColorInput ? bgColorInput.value : '#4e342e');
+
+        ctx.save();
+
+        // 1. Draw rounded rectangle card clip
+        const radius = 16;
+        ctx.beginPath();
+        ctx.moveTo(radius, 0);
+        ctx.lineTo(width - radius, 0);
+        ctx.quadraticCurveTo(width, 0, width, radius);
+        ctx.lineTo(width, height - radius);
+        ctx.quadraticCurveTo(width, height, width - radius, height);
+        ctx.lineTo(radius, height);
+        ctx.quadraticCurveTo(0, height, 0, height - radius);
+        ctx.lineTo(0, radius);
+        ctx.quadraticCurveTo(0, 0, radius, 0);
+        ctx.closePath();
+        ctx.clip();
+
+        // 2. Fill background
