+        shine.addColorStop(0.55, 'rgba(255, 255, 255, 0)');
+        shine.addColorStop(1, 'rgba(0, 0, 0, 0.28)');
+        ctx.fillStyle = shine;
+        ctx.fillRect(0, 0, width, height);
+
+        // 4. Subtle decorative coffee bean / cup ring watermark in bottom corner
