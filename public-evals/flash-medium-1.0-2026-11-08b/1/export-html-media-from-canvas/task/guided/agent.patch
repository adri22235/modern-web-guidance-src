+  <script>
+    // 1. Check if HTML-in-Canvas is supported in the browser
+    const isHtmlInCanvasSupported = 'content' in HTMLCanvasElement.prototype;
+
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const exportElement = document.getElementById('export_element');
+    const exportBtn = document.getElementById('export_button');
+    const downloadBtn = document.getElementById('download');
+
+    const cardName = document.getElementById('card_name');
+    const cardMessage = document.getElementById('card_message');
+    const designerName = document.getElementById('designer_name');
+    const designerMessage = document.getElementById('designer_message');
+    const bgColorInput = document.getElementById('card_bg_color');
+    const presetBtns = document.querySelectorAll('.preset-btn');
+    const statusNote = document.getElementById('api-status-note');
+
+    if (isHtmlInCanvasSupported) {
+      if (statusNote) {
+        statusNote.textContent = '✨ HTML-in-Canvas native acceleration active';
+        statusNote.className = 'status-note active';
+      }
+    } else {
+      if (statusNote) {
+        statusNote.textContent = 'ℹ️ Note: Standard canvas fallback active for this browser.';
+        statusNote.className = 'status-note fallback';
+      }
+    }
+
+    // Fallback 2D rendering when HTML-in-Canvas is not supported
+    function renderFallback() {
+      if (!canvas || !ctx) return;
+      const logicalWidth = 500;
+      const logicalHeight = 300;
+
+      if (typeof ctx.reset === 'function') {
+        ctx.reset();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+      }
+
+      ctx.save();
+      ctx.scale(canvas.width / logicalWidth, canvas.height / logicalHeight);
+
+      // Card Background
+      const bgColor = exportElement.style.backgroundColor || (bgColorInput ? bgColorInput.value : '#4e342e');
+      ctx.fillStyle = bgColor;
+      if (typeof ctx.roundRect === 'function') {
+        ctx.beginPath();
+        ctx.roundRect(0, 0, logicalWidth, logicalHeight, 16);
+        ctx.fill();
+      } else {
+        ctx.fillRect(0, 0, logicalWidth, logicalHeight);
+      }
+
+      // Card Border
+      ctx.strokeStyle = '#ffab40';
+      ctx.lineWidth = 2;
+      if (typeof ctx.roundRect === 'function') {
+        ctx.beginPath();
+        ctx.roundRect(2, 2, logicalWidth - 4, logicalHeight - 4, 14);
+        ctx.stroke();
+      } else {
+        ctx.strokeRect(2, 2, logicalWidth - 4, logicalHeight - 4);
+      }
+
+      // Brand Header
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('☕ THE DAILY GRIND', 24, 42);
+
+      // Badge
+      ctx.fillStyle = 'rgba(255, 171, 64, 0.2)';
+      if (typeof ctx.roundRect === 'function') {
+        ctx.beginPath();
+        ctx.roundRect(370, 24, 106, 26, 13);
+        ctx.fill();
+        ctx.strokeStyle = '#ffab40';
+        ctx.lineWidth = 1;
+        ctx.stroke();
+      } else {
+        ctx.fillRect(370, 24, 106, 26);
+      }
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 11px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('GIFT CARD', 393, 41);
+
+      // Recipient
+      ctx.fillStyle = '#d7ccc8';
+      ctx.font = '11px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('TO:', 24, 88);
+
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'bold 16px "Segoe UI", Tahoma, sans-serif';
+      const nameVal = (cardName && cardName.value) || (designerName && designerName.value) || 'A Special Coffee Lover';
+      ctx.fillText(nameVal, 24, 114);
+
+      // Message
+      ctx.fillStyle = '#d7ccc8';
+      ctx.font = '11px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('MESSAGE:', 24, 150);
+
+      ctx.fillStyle = '#f5f5f5';
+      ctx.font = '14px "Segoe UI", Tahoma, sans-serif';
+      const msgVal = (cardMessage && cardMessage.value) || (designerMessage && designerMessage.value) || 'Enjoy handcrafted artisanal coffee on us!';
+      const words = msgVal.split(' ');
+      let line = '';
+      let y = 174;
+      const maxWidth = 450;
+      for (let n = 0; n < words.length; n++) {
+        const testLine = line + words[n] + ' ';
+        const metrics = ctx.measureText(testLine);
+        if (metrics.width > maxWidth && n > 0) {
+          ctx.fillText(line, 24, y);
+          line = words[n] + ' ';
+          y += 20;
+        } else {
+          line = testLine;
+        }
+      }
+      ctx.fillText(line, 24, y);
+
+      // Footer
+      ctx.fillStyle = '#d7ccc8';
+      ctx.font = '11px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('VALUE', 24, 252);
+
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 22px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('$25.00', 24, 276);
+
+      ctx.fillStyle = '#d7ccc8';
+      ctx.font = '11px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('CARD CODE', 380, 252);
+
+      ctx.fillStyle = '#ffffff';
+      ctx.font = '12px monospace';
+      ctx.fillText('DG-2026-COFFEE', 370, 274);
+
+      ctx.restore();
+    }
+
+    // 4. Render the HTML content to the canvas inside a canvas.onpaint event handler
+    canvas.onpaint = (event) => {
+      if (typeof ctx.reset === 'function') {
+        ctx.reset();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
