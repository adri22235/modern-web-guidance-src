+    // Color updates
+    function setCardBackgroundColor(color) {
+      exportElement.style.backgroundColor = color;
+      if (bgColorInput) bgColorInput.value = color;
+      requestCanvasUpdate();
+    }
+
+    if (bgColorInput) {
+      bgColorInput.addEventListener('input', (e) => setCardBackgroundColor(e.target.value));
+      bgColorInput.addEventListener('change', (e) => setCardBackgroundColor(e.target.value));
+    }
+
+    presetBtns.forEach(btn => {
+      btn.addEventListener('click', () => {
+        const color = btn.getAttribute('data-color');
+        if (color) setCardBackgroundColor(color);
+      });
+    });
+
+    // Synchronize Name & Message inputs between designer form and card
+    function syncName(val) {
+      if (cardName && cardName.value !== val) cardName.value = val;
+      if (designerName && designerName.value !== val) designerName.value = val;
+      requestCanvasUpdate();
+    }
+
+    function syncMessage(val) {
+      if (cardMessage && cardMessage.value !== val) cardMessage.value = val;
+      if (designerMessage && designerMessage.value !== val) designerMessage.value = val;
+      requestCanvasUpdate();
+    }
+
+    if (designerName) {
+      designerName.addEventListener('input', (e) => syncName(e.target.value));
+    }
+    if (designerMessage) {
+      designerMessage.addEventListener('input', (e) => syncMessage(e.target.value));
+    }
+    if (cardName) {
+      cardName.addEventListener('input', (e) => syncName(e.target.value));
+    }
+    if (cardMessage) {
+      cardMessage.addEventListener('input', (e) => syncMessage(e.target.value));
+    }
+
+    // Listen on #export_element for any typing / bubbling input events
+    exportElement.addEventListener('input', (e) => {
+      if (e.target === cardName) syncName(cardName.value);
+      else if (e.target === cardMessage) syncMessage(cardMessage.value);
+      else requestCanvasUpdate();
+    });
+
+    // Observe programmatic attribute or content changes on #export_element
+    const mutationObs = new MutationObserver(() => {
+      requestCanvasUpdate();
+    });
+    mutationObs.observe(exportElement, {
+      attributes: true,
+      childList: true,
+      characterData: true,
+      subtree: true,
+    });
+
+    // Export button handler
+    function exportCanvasImage() {
+      requestCanvasUpdate();
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'coffee-gift-card.png';
