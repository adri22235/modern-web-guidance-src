+              <p>Velvety nitrogen-infused cold brew with toasted hazelnut notes.</p>
+              <a href="/menu/nitro-hazelnut" class="btn">View Details</a>
+            </div>
+          `;
+        }
+        const prev = document.getElementById('previous');
+        const next = document.getElementById('next');
+        if (prev) prev.href = 'index.html?page=1';
+        if (next) next.href = 'index.html?page=1';
+      }
+    });
+  </script>
