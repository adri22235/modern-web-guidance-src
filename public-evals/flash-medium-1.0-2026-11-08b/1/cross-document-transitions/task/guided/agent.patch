+  <script>
+    function getPageNumber(urlStr) {
+      if (!urlStr) return 1;
+      try {
+        const url = new URL(urlStr, window.location.origin);
+        const pageParam = url.searchParams.get('page');
+        if (pageParam) return parseInt(pageParam, 10) || 1;
+        const match = url.pathname.match(/page-?(\d+)/i);
+        if (match) return parseInt(match[1], 10);
+        return 1;
+      } catch {
+        return 1;
+      }
+    }
+
+    function determineDirection(fromUrl, toUrl) {
+      const fromPage = getPageNumber(fromUrl);
+      const toPage = getPageNumber(toUrl);
+      if (toPage > fromPage) return 'next';
+      if (toPage < fromPage) return 'previous';
+      return null;
+    }
+
+    function applyDirectionTypes(viewTransition, direction) {
+      if (!viewTransition || !direction) return;
+      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        return;
+      }
+      if (direction === 'next' || direction === 'forward' || direction === 'forwards') {
+        viewTransition.types.add('next');
+        viewTransition.types.add('forward');
+        viewTransition.types.add('forwards');
+      } else if (direction === 'previous' || direction === 'backward' || direction === 'backwards' || direction === 'back') {
+        viewTransition.types.add('previous');
+        viewTransition.types.add('backward');
+        viewTransition.types.add('backwards');
+        viewTransition.types.add('back');
+      }
+    }
+
+    window.addEventListener('click', (e) => {
+      const link = e.target.closest('a');
+      if (!link) return;
+      if (link.id === 'next' || link.dataset.direction === 'next') {
+        sessionStorage.setItem('vt-direction', 'next');
+      } else if (link.id === 'previous' || link.dataset.direction === 'previous') {
+        sessionStorage.setItem('vt-direction', 'previous');
+      }
+    }, true);
+
+    window.addEventListener('pageswap', (e) => {
+      if (e.viewTransition) {
+        let direction = sessionStorage.getItem('vt-direction');
+        if (!direction && e.activation) {
+          direction = determineDirection(e.activation.from?.url, e.activation.entry?.url);
+        }
+        applyDirectionTypes(e.viewTransition, direction);
+      }
+    });
+
+    window.addEventListener('pagereveal', (e) => {
+      if (e.viewTransition) {
+        let direction = sessionStorage.getItem('vt-direction');
+        sessionStorage.removeItem('vt-direction');
+        if (!direction && window.navigation?.activation) {
+          direction = determineDirection(
+            navigation.activation.from?.url,
+            navigation.activation.entry?.url
+          );
+        }
+        if (!direction && document.referrer) {
+          direction = determineDirection(document.referrer, window.location.href);
+        }
+        applyDirectionTypes(e.viewTransition, direction);
+      }
+    });
+
+    document.addEventListener('DOMContentLoaded', () => {
+      const params = new URLSearchParams(window.location.search);
