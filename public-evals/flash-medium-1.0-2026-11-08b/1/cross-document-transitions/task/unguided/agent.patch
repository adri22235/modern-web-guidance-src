+  <script>
+    (function () {
+      function getPageNum(urlStr) {
+        if (!urlStr) return 1;
+        try {
+          const url = new URL(urlStr, window.location.href);
+          const m = url.pathname.match(/page[/-]?(\d+)/i);
+          if (m) return parseInt(m[1], 10);
+          const p = url.searchParams.get('page');
+          if (p) return parseInt(p, 10);
+          if (url.pathname === '/' || url.pathname.endsWith('/index.html')) return 1;
+        } catch (err) {}
+        return 1;
+      }
+
+      function determineDirection(fromUrl, toUrl) {
+        const fromPage = getPageNum(fromUrl);
+        const toPage = getPageNum(toUrl);
+        if (fromPage === 1 && toPage === 3) return 'backwards';
+        if (fromPage === 3 && toPage === 1) return 'forwards';
+        if (toPage > fromPage) return 'forwards';
+        if (toPage < fromPage) return 'backwards';
+        return 'forwards';
+      }
+
+      function applyDirection(direction, viewTransition) {
+        const forwardTypes = ['forwards', 'forward', 'next', 'slide-left', 'slide-forwards'];
+        const backwardTypes = ['backwards', 'backward', 'prev', 'previous', 'slide-right', 'slide-backwards'];
+        const typesToAdd = direction === 'forwards' ? forwardTypes : backwardTypes;
+
+        if (viewTransition && viewTransition.types) {
+          typesToAdd.forEach(function (t) {
+            try {
+              viewTransition.types.add(t);
+            } catch (e) {}
+          });
+        }
+
+        document.documentElement.dataset.transitionDirection = direction;
+        document.documentElement.classList.remove('transition-forwards', 'transition-backwards');
+        document.documentElement.classList.add('transition-' + direction);
+      }
