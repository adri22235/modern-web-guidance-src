+/**
+ * The Daily Grind - Client-Side Script
+ * Implements preventative client-side security measures (Trusted Types, safe DOM handling, session hygiene)
+ */
+
+// Phase 1 & 3: Trusted Types runtime enforcement and fallback tinyfill
+if (!window.trustedTypes) {
+  window.trustedTypes = {
+    createPolicy: (name, rules) => rules,
+  };
+}
+
+// Named policy for application HTML
+let appPolicy;
+try {
+  appPolicy = window.trustedTypes.createPolicy('app-html', {
+    createHTML(input) {
+      return String(input)
+        .replaceAll('&', '&amp;')
+        .replaceAll('<', '&lt;')
+        .replaceAll('>', '&gt;')
+        .replaceAll('"', '&quot;')
+        .replaceAll("'", '&#39;');
+    },
+  });
+} catch (e) {
+  // Policy may already exist
+}
+
+// Safeguard default policy for migration phase
+try {
+  if (window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+    window.trustedTypes.createPolicy('default', {
+      createHTML(input) {
+        return appPolicy ? appPolicy.createHTML(input) : String(input);
+      },
+    });
+  }
+} catch (e) {
+  // Default policy already defined or disallowed
+}
+
+// Client-side session and storage hygiene
+document.addEventListener('DOMContentLoaded', () => {
+  // Secure logout listener: clear local client storage on logout action
+  const logoutLinks = document.querySelectorAll('.logout-link');
+  logoutLinks.forEach((link) => {
+    link.addEventListener('click', () => {
+      try {
+        sessionStorage.clear();
+        localStorage.clear();
+      } catch (e) {
+        // Handle storage access restrictions
+      }
+    });
+  });
+
+  // Example safe DOM update without dangerous sinks
+  const currentYearSpan = document.getElementById('copyright-year');
+  if (currentYearSpan) {
+    currentYearSpan.textContent = String(new Date().getFullYear());
+  }
+});
