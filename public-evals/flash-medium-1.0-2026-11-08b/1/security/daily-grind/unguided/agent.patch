+'use strict';
+
+// Preventative Client-Side Security Measures
+
+// 1. Monitor and report security policy violations
+document.addEventListener('securitypolicyviolation', (e) => {
+  const report = {
+    'csp-report': {
+      'document-uri': e.documentURI,
+      'referrer': document.referrer,
+      'violated-directive': e.violatedDirective,
+      'effective-directive': e.effectiveDirective,
+      'original-policy': e.originalPolicy,
+      'disposition': e.disposition,
+      'blocked-uri': e.blockedURI,
+      'line-number': e.lineNumber,
+      'column-number': e.columnNumber,
+      'source-file': e.sourceFile,
+      'status-code': e.statusCode,
+      'sample': e.sample
+    }
+  };
+
+  if (navigator.sendBeacon) {
+    navigator.sendBeacon('/csp-report', JSON.stringify(report));
+  } else {
+    fetch('/csp-report', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(report),
+      keepalive: true
+    }).catch(() => {});
+  }
+});
+
+// 2. Preventative client-side storage cleanup on logout
+document.querySelectorAll('a[href="/logout"], a[href="/logout/"]').forEach((link) => {
+  link.addEventListener('click', () => {
+    try {
+      localStorage.clear();
+      sessionStorage.clear();
+    } catch (e) {
+      console.error('Error clearing storage:', e);
+    }
+  });
+});
+
+// 3. Tabnabbing prevention for external or new-window links
+document.querySelectorAll('a[target="_blank"]').forEach((link) => {
+  link.setAttribute('rel', 'noopener noreferrer');
+});
+
+// 4. Trusted Types policy enforcement if supported
+if (window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+  try {
+    window.trustedTypes.createPolicy('default', {
+      createHTML: (string) => string,
+      createScript: (string) => string,
+      createScriptURL: (string) => string,
+    });
+  } catch {
+    // Policy may already exist
+  }
+}
