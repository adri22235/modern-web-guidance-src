+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const slides = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.gallery-thumbnails button, .thumbnail-indicator'));
+
+      function getIndex(target) {
+        if (typeof target === 'number') return target;
+        if (!target) return -1;
+        const slideIdx = slides.indexOf(target);
+        if (slideIdx !== -1) return slideIdx;
+        return thumbnails.indexOf(target);
+      }
+
+      function setPending(target) {
+        const index = getIndex(target);
+        if (index === -1) return;
+
+        thumbnails.forEach((thumb, i) => {
+          if (i === index) {
+            thumb.classList.add('pending');
+          } else {
+            thumb.classList.remove('pending');
+          }
+        });
+
+        slides.forEach((slide, i) => {
+          if (i === index) {
+            slide.classList.add('pending');
+          } else {
+            slide.classList.remove('pending');
+          }
+        });
+      }
+
+      function setActive(target) {
+        const index = getIndex(target);
+        if (index === -1) return;
+
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === index) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+
+        slides.forEach((slide, i) => {
+          slide.classList.remove('pending');
+          if (i === index) {
+            slide.classList.add('active');
+          } else {
+            slide.classList.remove('active');
+          }
+        });
+      }
+
+      // Thumbnail Click Interactions
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          if (slides[index]) {
+            slides[index].scrollIntoView({
+              behavior: 'smooth',
+              block: 'nearest',
+              inline: 'center'
+            });
+            setPending(slides[index]);
+            setActive(slides[index]);
+          }
+        });
+      });
+
+      // Geometric calculation to determine the snap target closest to container's scroll center
+      function findClosestSlide() {
+        const containerWidth = gallery.clientWidth || gallery.offsetWidth || 800;
+        const scrollCenter = gallery.scrollLeft + containerWidth / 2;
+        const containerRect = typeof gallery.getBoundingClientRect === 'function' ? gallery.getBoundingClientRect() : null;
+
+        let closestSlide = slides[0];
+        let minDistance = Infinity;
+
+        slides.forEach((slide, i) => {
+          let slideCenter;
+          if (slide.offsetLeft !== undefined && slide.offsetLeft !== 0) {
+            const slideWidth = slide.offsetWidth || containerWidth;
+            slideCenter = slide.offsetLeft + slideWidth / 2;
+          } else if (containerRect && typeof slide.getBoundingClientRect === 'function') {
+            const rect = slide.getBoundingClientRect();
+            const relLeft = rect.left - containerRect.left + gallery.scrollLeft;
+            slideCenter = relLeft + (rect.width || containerWidth) / 2;
+          } else {
+            slideCenter = i * containerWidth + containerWidth / 2;
+          }
+
+          const distance = Math.abs(scrollCenter - slideCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSlide = slide;
+          }
+        });
+
+        return closestSlide;
+      }
+
+      // Fallback detection: check support for modern CSS Scroll Snap Events
+      const supportsScrollSnapChanging = 'onscrollsnapchanging' in window ||
+        'onscrollsnapchanging' in Element.prototype ||
+        ('onscrollsnapchanging' in gallery);
+
+      const supportsScrollSnapChange = 'onscrollsnapchange' in window ||
+        'onscrollsnapchange' in Element.prototype ||
+        ('onscrollsnapchange' in gallery);
+
+      const supportsNativeEvents = supportsScrollSnapChanging && supportsScrollSnapChange;
+
+      let receivedNativeEvent = false;
+      let scrollRaf = null;
+      let settleTimer = null;
+
+      function onFallbackScroll() {
+        if (receivedNativeEvent) return;
+        if (!scrollRaf) {
+          scrollRaf = requestAnimationFrame(() => {
+            scrollRaf = null;
+            const closest = findClosestSlide();
+            if (closest) setPending(closest);
+          });
+        }
+
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => {
+          const closest = findClosestSlide();
+          if (closest) setActive(closest);
+        }, 150);
+      }
+
+      function onFallbackScrollEnd() {
+        if (receivedNativeEvent) return;
+        clearTimeout(settleTimer);
+        const closest = findClosestSlide();
+        if (closest) setActive(closest);
+      }
+
+      function setupFallback() {
+        gallery.addEventListener('scroll', onFallbackScroll, { passive: true });
+        if ('onscrollend' in window || 'onscrollend' in Element.prototype || ('onscrollend' in gallery)) {
+          gallery.addEventListener('scrollend', onFallbackScrollEnd);
+        }
+      }
+
+      // Listen for native scroll snap events
+      gallery.addEventListener('scrollsnapchanging', (e) => {
+        receivedNativeEvent = true;
+        const target = e.snapTargetInline || e.snapTargetBlock;
+        if (target) setPending(target);
+      });
+
+      gallery.addEventListener('scrollsnapchange', (e) => {
+        receivedNativeEvent = true;
+        const target = e.snapTargetInline || e.snapTargetBlock;
+        if (target) setActive(target);
+      });
+
+      // Always setup fallback detection listeners (active if native events unsupported or not received)
+      setupFallback();
+
+      // Expose properties and fallback methods on the element for testing and verification
+      gallery.supportsScrollSnapEvents = supportsNativeEvents;
+      gallery.setPending = setPending;
+      gallery.setActive = setActive;
+      gallery.findClosestSlide = findClosestSlide;
+      gallery.setupFallback = setupFallback;
+      gallery.dataset.scrollSnapSupport = supportsNativeEvents ? 'native' : 'fallback';
+
+      // Initialize initial active state
+      setActive(0);
+    })();
+  </script>
