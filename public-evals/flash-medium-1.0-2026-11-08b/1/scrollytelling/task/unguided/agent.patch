+  <script>
+    (function () {
+      function initScrollytelling() {
+        const tracked = document.getElementById('tracked');
+        const animated = document.getElementById('animated');
+        if (!tracked || !animated) return;
+
+        const textSections = Array.from(tracked.querySelectorAll(':scope > section'));
+        const visualSections = Array.from(animated.querySelectorAll(':scope > section'));
+        if (!textSections.length || !visualSections.length) return;
+
+        function setActiveStep(index) {
+          textSections.forEach((sec, idx) => {
+            const isActive = idx === index;
+            sec.classList.toggle('active', isActive);
+            sec.setAttribute('data-active', isActive ? 'true' : 'false');
+          });
+          visualSections.forEach((vis, idx) => {
+            const isActive = idx === index;
+            vis.classList.toggle('active', isActive);
+            vis.setAttribute('data-active', isActive ? 'true' : 'false');
+          });
+        }
+
+        function onScroll() {
+          const vh = window.innerHeight;
+          const vCenter = vh / 2;
+
+          let closestIndex = 0;
+          let minDistance = Infinity;
+
+          textSections.forEach((sec, idx) => {
+            const rect = sec.getBoundingClientRect();
+            const center = rect.top + rect.height / 2;
+            const dist = Math.abs(center - vCenter);
+
+            const progress = Math.max(0, Math.min(1, (vh - rect.top) / (vh + rect.height)));
+            sec.style.setProperty('--scroll-progress', progress.toFixed(3));
+            if (visualSections[idx]) {
+              visualSections[idx].style.setProperty('--scroll-progress', progress.toFixed(3));
+            }
+
+            if (rect.bottom > 0 && rect.top < vh) {
+              if (dist < minDistance) {
+                minDistance = dist;
+                closestIndex = idx;
+              }
+            }
+          });
+
+          setActiveStep(closestIndex);
+        }
+
+        if ('IntersectionObserver' in window) {
+          const observer = new IntersectionObserver((entries) => {
+            let maxRatio = -1;
+            let candidateIndex = -1;
+
+            entries.forEach(entry => {
+              if (entry.isIntersecting && entry.intersectionRatio > maxRatio) {
+                maxRatio = entry.intersectionRatio;
+                candidateIndex = textSections.indexOf(entry.target);
+              }
+            });
+
+            if (candidateIndex !== -1) {
+              setActiveStep(candidateIndex);
+            }
+          }, {
+            rootMargin: '-20% 0px -20% 0px',
+            threshold: [0, 0.25, 0.5, 0.75, 1.0]
+          });
+
+          textSections.forEach(sec => observer.observe(sec));
+        }
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('resize', onScroll, { passive: true });
+
+        onScroll();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initScrollytelling);
+      } else {
+        initScrollytelling();
+      }
+    })();
+  </script>
+
