+  <script>
+    // Progressive enhancement for browsers that don't yet support CSS field-sizing: content
+    (function () {
+      const supportsFieldSizing = window.CSS && CSS.supports && (CSS.supports('field-sizing', 'content') || CSS.supports('field-sizing: content'));
+
+      if (!supportsFieldSizing) {
+        function autoSizeInput(el) {
+          const len = (el.value || el.placeholder || '').length;
+          el.style.width = Math.max(len + 3, 6) + 'ch';
+        }
+
+        function autoSizeTextarea(el) {
+          el.style.height = 'auto';
+          el.style.height = Math.max(el.scrollHeight, 38) + 'px';
+        }
+
+        function autoSizeSelect(el) {
+          const opt = el.options[el.selectedIndex];
+          const text = opt ? opt.text : '';
+          el.style.width = Math.max(text.length + 5, 8) + 'ch';
+        }
+
+        document.querySelectorAll('input[type="text"]').forEach(input => {
+          autoSizeInput(input);
+          input.addEventListener('input', () => autoSizeInput(input));
+        });
+
+        document.querySelectorAll('textarea').forEach(textarea => {
+          autoSizeTextarea(textarea);
+          textarea.addEventListener('input', () => autoSizeTextarea(textarea));
+        });
+
+        document.querySelectorAll('select').forEach(select => {
+          autoSizeSelect(select);
+          select.addEventListener('change', () => autoSizeSelect(select));
+        });
+      }
+    })();
+  </script>
+
