+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .custom-order-form {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 1.5rem;
+      max-width: 650px;
+      margin: 0 auto;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.35rem;
+      width: 100%;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      font-size: 0.95rem;
+      color: var(--primary);
+    }
+
+    /* Auto-sizing form controls using field-sizing: content */
+    input[type="text"],
+    textarea,
+    select {
+      field-sizing: content;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      padding: 0.6rem 0.85rem;
+      border: 1.5px solid #8d6e63;
+      border-radius: 5px;
+      background-color: var(--light);
+      color: var(--text);
+      align-self: flex-start;
+      box-sizing: border-box;
+      transition: border-color 0.2s, outline 0.2s;
+    }
+
+    input[type="text"]:focus-visible,
+    textarea:focus-visible,
+    select:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+      border-color: var(--primary);
+    }
+
+    /* Input: auto sizes horizontally to fit content without collapsing or growing infinitely */
+    input[type="text"] {
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    /* Select: auto sizes to fit the active option only */
+    select {
+      width: auto;
+      max-inline-size: 50ch;
+      cursor: pointer;
+    }
+
+    /* Textarea: auto sizes vertically to fit wrapped text and lines without unnecessary whitespace */
+    textarea {
+      height: auto;
+      width: min(50ch, 100%);
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+      resize: vertical;
+    }
+
