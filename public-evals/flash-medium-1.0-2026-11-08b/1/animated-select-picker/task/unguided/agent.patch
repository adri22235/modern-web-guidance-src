+    /* Choose Your Store Select & Customizable Select Styling */
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .store-select {
+      margin-top: 15px;
+      margin-bottom: 5px;
+      padding: 10px 18px;
+      font-size: 1rem;
+      border-radius: 6px;
+      border: 1px solid var(--secondary);
+      background-color: white;
+      color: var(--text);
+      font-family: inherit;
+      cursor: pointer;
+      min-width: 250px;
+      outline: none;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
+    }
+
+    .store-select:hover {
+      border-color: var(--accent);
+    }
+
+    .store-select:focus-visible {
+      border-color: var(--accent);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.4);
+    }
+
+    /* Native Customizable Select Opt-in */
+    select,
+    ::picker(select),
+    select::picker(select) {
+      appearance: base-select;
+    }
+
+    /* Arrow icon rotation animation */
+    select::picker-icon,
+    .store-select::picker-icon {
+      transition: rotate 0.4s ease;
+    }
+
+    select:open::picker-icon,
+    .store-select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    /* Native picker menu smooth fade in and out animation */
+    ::picker(select),
+    select::picker(select),
+    .store-select::picker(select) {
+      opacity: 0;
+      transition: opacity 0.4s ease, display 0.4s allow-discrete, overlay 0.4s allow-discrete;
+      transition-behavior: allow-discrete;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
+    }
+
+    :open::picker(select),
+    select:open::picker(select),
+    .store-select:open::picker(select) {
+      opacity: 1;
+    }
+
+    @starting-style {
+      :open::picker(select),
+      select:open::picker(select),
+      .store-select:open::picker(select) {
+        opacity: 0;
+      }
+    }
+
+    .store-select option {
+      padding: 10px 14px;
+      border-radius: 4px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus {
+      background-color: var(--secondary);
+    }
+
+    .store-select option:checked {
+      background-color: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
