+      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
+    }
+
+    .store-select:focus-visible,
+    .store-select:focus {
+      outline: none;
+      border-color: var(--accent);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.4);
+    }
+
+    .store-select button {
+      appearance: none;
+      background: transparent;
+      border: none;
+      color: inherit;
+      font: inherit;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 0;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .store-select button:focus {
+      outline: none;
+    }
+
+    /* Arrow icon styling and smooth rotation */
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), rotate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+      transform-origin: center;
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+      rotate: 180deg;
+    }
+
+    /*
+     * The Native Picker Container
+     * Smoothly animates fading in when opening and fading out when closing
+     */
+    .store-select::picker(select) {
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
+      padding: 0.5rem;
+      margin-top: 0.35rem;
+      width: anchor-size(width);
+      min-width: 280px;
+
+      /* Closed state / exit animation end state (fade out) */
+      opacity: 0;
+      transition:
+        display 0.3s,
+        overlay 0.3s,
+        opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+      transition-behavior: allow-discrete;
+    }
+
+    /* Open state (fade in target) */
+    .store-select:open::picker(select) {
+      opacity: 1;
+    }
+
+    /* @starting-style hooks transition on initial open (fade in start) */
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+      }
+    }
+
+    .store-select option {
+      padding: 0.6rem 0.75rem;
