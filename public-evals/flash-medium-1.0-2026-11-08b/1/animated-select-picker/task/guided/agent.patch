+      color: var(--text);
+      cursor: pointer;
+      transition: background-color 0.15s ease;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus {
+      background-color: #f5ece5;
+    }
+
+    /* Multiple indicators for checked state for accessibility */
+    .store-select option:checked {
+      font-weight: 700;
+      background-color: #ebdcd0;
+      color: var(--primary);
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    /* Respect reduced-motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
