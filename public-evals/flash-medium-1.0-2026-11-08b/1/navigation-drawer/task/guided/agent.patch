+  <script>
+    const drawer = document.getElementById('drawer');
+    const openBtn = document.getElementById('drawer-open');
+    const scroller = drawer.querySelector('.Drawer-scroller');
+    const sheet = drawer.querySelector('.Drawer-sheet');
+    const closeBtn = document.getElementById('drawer-close');
+
+    let isOpening = false;
+
+    function setBackgroundInert(inert) {
+      document.querySelectorAll('nav, header, main, footer').forEach((el) => {
+        el.inert = inert;
+      });
+    }
+
+    async function openDrawer() {
+      if (drawer.matches(':popover-open')) return;
+      isOpening = true;
+      drawer.showPopover();
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        const prevBehavior = scroller.style.scrollBehavior;
+        scroller.style.scrollBehavior = 'auto';
+        scroller.scrollLeft = scroller.offsetWidth;
+        await new Promise((r) =>
+          requestAnimationFrame(() => requestAnimationFrame(r))
+        );
+        scroller.style.scrollBehavior = prevBehavior;
+      }
+
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (!drawer.matches(':popover-open')) return;
+      isOpening = false;
+      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
+    }
+
+    function toggleDrawer() {
+      if (drawer.matches(':popover-open')) {
+        closeDrawer();
+      } else {
+        openDrawer();
+      }
+    }
+
+    function onDrawerOpened() {
+      isOpening = false;
+      setBackgroundInert(true);
+      drawer.setAttribute('aria-modal', 'true');
+      openBtn.setAttribute('aria-expanded', 'true');
+      sheet.focus();
+    }
+
+    function onDrawerClosed() {
+      if (!drawer.matches(':popover-open')) return;
+      drawer.hidePopover();
+      setBackgroundInert(false);
+      if (drawer.hasAttribute('aria-modal')) {
+        drawer.removeAttribute('aria-modal');
+      }
+      openBtn.setAttribute('aria-expanded', 'false');
+      openBtn.focus();
+    }
+
+    const visibleThreshold = 1 / window.innerWidth;
+
+    const observer = new IntersectionObserver(
+      (entries) => {
+        const entry = entries.at(-1);
+        if (!drawer.matches(':popover-open')) return;
+        if (!isOpening && entry.intersectionRatio < visibleThreshold) {
+          onDrawerClosed();
+        }
+        if (entry.intersectionRatio === 1) {
+          onDrawerOpened();
+        }
+      },
+      { root: drawer, threshold: [visibleThreshold, 1] }
+    );
+    observer.observe(sheet);
+
+    // Fallback backdrop fade for browsers without animation-timeline support
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      scroller.addEventListener('scroll', () => {
+        const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / sheet.offsetWidth));
+        drawer.style.setProperty('--drawer-backdrop', ratio);
+      });
+    }
+
+    // Open & Close button triggers
+    openBtn.addEventListener('click', toggleDrawer);
+    closeBtn.addEventListener('click', closeDrawer);
+
+    // Tapping outside the drawer menu closes it (light dismiss)
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target)) {
+        closeDrawer();
+      }
+    });
+
+    // Pressing Escape closes the drawer
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && drawer.matches(':popover-open')) {
+        closeDrawer();
+      }
+    });
+
+    // Close when navigating links
+    sheet.querySelectorAll('a').forEach((link) => {
+      link.addEventListener('click', () => {
+        closeDrawer();
+      });
+    });
+
+    // Swipe gesture support to swipe menu away (leftwards)
+    let startX = 0;
+    let startY = 0;
+    let isTrackingGesture = false;
+    let startTime = 0;
+
+    function handleGestureStart(clientX, clientY) {
+      startX = clientX;
+      startY = clientY;
+      startTime = Date.now();
+      isTrackingGesture = true;
+    }
+
+    function handleGestureEnd(clientX, clientY) {
+      if (!isTrackingGesture) return;
+      isTrackingGesture = false;
+      const deltaX = clientX - startX;
+      const deltaY = clientY - startY;
+      const elapsed = Date.now() - startTime;
+
+      const isHorizontal = Math.abs(deltaX) > Math.abs(deltaY);
+      const isSwipeLeft = deltaX < -40 || (deltaX < -20 && elapsed < 300);
+
+      if (isHorizontal && isSwipeLeft) {
+        closeDrawer();
+      }
+    }
+
+    drawer.addEventListener('touchstart', (e) => {
+      if (e.touches.length === 1) {
+        handleGestureStart(e.touches[0].clientX, e.touches[0].clientY);
+      }
+    }, { passive: true });
+
+    drawer.addEventListener('touchend', (e) => {
+      if (e.changedTouches.length > 0) {
+        handleGestureEnd(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
+      }
+    }, { passive: true });
+
+    drawer.addEventListener('pointerdown', (e) => {
+      if (e.pointerType === 'mouse' && e.button !== 0) return;
+      handleGestureStart(e.clientX, e.clientY);
+    });
+
+    drawer.addEventListener('pointerup', (e) => {
+      handleGestureEnd(e.clientX, e.clientY);
+    });
+
+    drawer.addEventListener('pointercancel', () => {
+      isTrackingGesture = false;
+    });
+
+    drawer.addEventListener('swipeleft', closeDrawer);
+  </script>
