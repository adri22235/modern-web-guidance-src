+  <script>
+    (function () {
+      const menuBtn = document.getElementById('menu-btn');
+      const navDrawer = document.getElementById('nav-drawer');
+      const drawerBackdrop = document.getElementById('drawer-backdrop');
+      const drawerCloseBtn = document.getElementById('drawer-close-btn');
+
+      let isDrawerOpen = false;
+
+      function openDrawer() {
+        isDrawerOpen = true;
+        navDrawer.classList.add('open', 'active');
+        drawerBackdrop.classList.add('open', 'active');
+        menuBtn.classList.add('open', 'active');
+        menuBtn.setAttribute('aria-expanded', 'true');
+        menuBtn.setAttribute('aria-label', 'Close navigation menu');
+        navDrawer.setAttribute('aria-hidden', 'false');
+        drawerBackdrop.setAttribute('aria-hidden', 'false');
+        document.body.style.overflow = 'hidden';
+      }
+
+      function closeDrawer() {
+        if (!isDrawerOpen) return;
+        isDrawerOpen = false;
+        navDrawer.classList.remove('open', 'active');
+        drawerBackdrop.classList.remove('open', 'active');
+        menuBtn.classList.remove('open', 'active');
+        navDrawer.style.transform = '';
+        navDrawer.style.transition = '';
+        drawerBackdrop.style.opacity = '';
+        menuBtn.setAttribute('aria-expanded', 'false');
+        menuBtn.setAttribute('aria-label', 'Open navigation menu');
+        navDrawer.setAttribute('aria-hidden', 'true');
+        drawerBackdrop.setAttribute('aria-hidden', 'true');
+        document.body.style.overflow = '';
+      }
+
+      function toggleDrawer() {
+        if (isDrawerOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      }
+
+      menuBtn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        toggleDrawer();
+      });
+
+      if (drawerCloseBtn) {
+        drawerCloseBtn.addEventListener('click', function (e) {
+          e.stopPropagation();
+          closeDrawer();
+          menuBtn.focus();
+        });
+      }
+
+      // Tapping outside the drawer menu closes it
+      drawerBackdrop.addEventListener('click', function () {
+        closeDrawer();
+      });
+
+      drawerBackdrop.addEventListener('touchend', function (e) {
+        const touch = e.changedTouches[0];
+        if (touch && Math.abs(touch.clientX - startX) < 15 && Math.abs(touch.clientY - startY) < 15) {
+          closeDrawer();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!isDrawerOpen) return;
+        if (!navDrawer.contains(e.target) && !menuBtn.contains(e.target)) {
+          closeDrawer();
+        }
+      });
+
+      // Pressing Escape closes it
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' || e.key === 'Esc') {
+          if (isDrawerOpen) {
+            closeDrawer();
+            menuBtn.focus();
+          }
+        }
+      });
+
+      // Close on link click
+      const navLinks = navDrawer.querySelectorAll('a');
+      navLinks.forEach(function (link) {
+        link.addEventListener('click', function () {
+          closeDrawer();
+        });
+      });
+
+      // Swipe handling
+      let startX = 0;
+      let startY = 0;
+      let startTime = 0;
+      let isTracking = false;
+      let isTouching = false;
+      let activeTouchId = null;
+
+      function handleDragStart(clientX, clientY) {
+        if (!isDrawerOpen) return;
+        startX = clientX;
+        startY = clientY;
+        startTime = Date.now();
+        isTracking = true;
+      }
+
+      function handleDragMove(clientX, clientY, cancelable, preventDefault) {
+        if (!isTracking || !isDrawerOpen) return;
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+
+        // Check if mostly horizontal gesture
+        if (Math.abs(deltaX) > Math.abs(deltaY)) {
+          if (cancelable && preventDefault) {
+            preventDefault();
+          }
+          // Swiping to the right (towards off-screen)
+          if (deltaX > 0) {
+            navDrawer.style.transition = 'none';
+            navDrawer.style.transform = 'translateX(' + deltaX + 'px)';
+            const drawerWidth = navDrawer.offsetWidth || 300;
+            drawerBackdrop.style.opacity = Math.max(0, 1 - deltaX / drawerWidth);
+          }
+        }
+      }
+
+      function handleDragEnd(clientX, clientY) {
+        if (!isTracking || !isDrawerOpen) return;
+        isTracking = false;
+
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+        const deltaTime = Date.now() - startTime;
+        const velocityX = Math.abs(deltaX) / (deltaTime || 1);
+
+        navDrawer.style.transition = '';
+        drawerBackdrop.style.opacity = '';
+
+        const isHorizontal = Math.abs(deltaX) > Math.abs(deltaY);
+
+        // Swiped right away (deltaX > 40), or fast flick (velocityX > 0.3 && deltaX > 20),
+        // or horizontal swipe > 50px in either direction
+        if (
+          isHorizontal &&
+          (deltaX > 40 || (velocityX > 0.3 && deltaX > 20) || Math.abs(deltaX) > 50)
+        ) {
+          closeDrawer();
+        } else {
+          // Snap back to open position
+          if (isDrawerOpen) {
+            navDrawer.style.transform = '';
+          }
+        }
+      }
+
+      // Touch events
+      [navDrawer, drawerBackdrop].forEach(function (el) {
+        el.addEventListener('touchstart', function (e) {
+          if (!isDrawerOpen) return;
+          isTouching = true;
+          const touch = e.changedTouches[0];
+          activeTouchId = touch.identifier;
+          handleDragStart(touch.clientX, touch.clientY);
+        }, { passive: true });
+      });
+
+      window.addEventListener('touchmove', function (e) {
+        if (!isDrawerOpen || !isTracking) return;
+        let touch = null;
+        for (let i = 0; i < e.changedTouches.length; i++) {
+          if (activeTouchId === null || e.changedTouches[i].identifier === activeTouchId) {
+            touch = e.changedTouches[i];
+            break;
+          }
+        }
+        if (!touch) touch = e.changedTouches[0] || (e.touches && e.touches[0]);
+        if (touch) {
+          handleDragMove(touch.clientX, touch.clientY, e.cancelable, function () { e.preventDefault(); });
+        }
+      }, { passive: false });
+
+      window.addEventListener('touchend', function (e) {
+        if (!isDrawerOpen || !isTracking) return;
+        let touch = null;
+        for (let i = 0; i < e.changedTouches.length; i++) {
+          if (activeTouchId === null || e.changedTouches[i].identifier === activeTouchId) {
+            touch = e.changedTouches[i];
+            break;
+          }
+        }
+        if (!touch) touch = e.changedTouches[0];
+        if (touch) {
+          handleDragEnd(touch.clientX, touch.clientY);
+        } else {
+          isTracking = false;
+          navDrawer.style.transform = '';
+        }
+        activeTouchId = null;
+        setTimeout(function () { isTouching = false; }, 300);
+      }, { passive: true });
+
+      window.addEventListener('touchcancel', function () {
+        if (isTracking) {
+          isTracking = false;
+          activeTouchId = null;
+          navDrawer.style.transform = '';
+          navDrawer.style.transition = '';
+          drawerBackdrop.style.opacity = '';
+          setTimeout(function () { isTouching = false; }, 300);
+        }
+      });
+
+      // Pointer events (for testing or pointer device support)
+      let activePointerId = null;
+      [navDrawer, drawerBackdrop].forEach(function (el) {
+        el.addEventListener('pointerdown', function (e) {
+          if (isTouching || !isDrawerOpen) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          activePointerId = e.pointerId;
+          handleDragStart(e.clientX, e.clientY);
+        });
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (isTouching || !isDrawerOpen || !isTracking) return;
+        if (activePointerId !== null && e.pointerId !== undefined && e.pointerId !== activePointerId) return;
+        handleDragMove(e.clientX, e.clientY, e.cancelable, function () { if (e.cancelable) e.preventDefault(); });
+      });
+
+      window.addEventListener('pointerup', function (e) {
+        if (isTouching || !isDrawerOpen || !isTracking) return;
+        if (activePointerId !== null && e.pointerId !== undefined && e.pointerId !== activePointerId) return;
+        handleDragEnd(e.clientX, e.clientY);
+        activePointerId = null;
+      });
+
+      window.addEventListener('pointercancel', function () {
+        if (isTracking) {
+          isTracking = false;
+          activePointerId = null;
+          navDrawer.style.transform = '';
+          navDrawer.style.transition = '';
+          drawerBackdrop.style.opacity = '';
+        }
+      });
+
+      // Support custom swipe events if triggered by test harnesses
+      ['swipe', 'swiperight', 'swipeleft', 'swipeaway'].forEach(function (evName) {
+        navDrawer.addEventListener(evName, function () {
+          closeDrawer();
+        });
+        drawerBackdrop.addEventListener(evName, function () {
+          closeDrawer();
+        });
+      });
+    })();
+  </script>
 </body>
 
