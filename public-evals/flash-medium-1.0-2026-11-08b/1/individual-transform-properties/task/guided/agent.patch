+    /* Featured Promo Badge */
+    .promo-badge-container {
+      text-align: center;
+      margin: 20px 0;
+    }
+
+    .target {
+      display: inline-block;
+      padding: 8px 20px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      border-radius: 20px;
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+      cursor: pointer;
+
+      /* Establish identity transformations upfront to guarantee a stable stacking context without will-change */
+      translate: 0px 0px;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Smooth transition for hover scaling */
+      transition: scale 0.3s ease;
+
+      /* Run spin and slide animations concurrently */
+      animation: spin 4s linear infinite, slide 2s ease-in-out infinite alternate;
+    }
+
+    .target:hover {
+      scale: 1.15;
+    }
+
+    @keyframes spin {
+      from {
+        rotate: 0deg;
+      }
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes slide {
+      from {
+        translate: -20px 0px;
+      }
+      to {
+        translate: 20px 0px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation-duration: 20s, 20s;
+      }
+    }
   </style>
