@@ -0,0 +1,332 @@
+import { test, describe, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { Window } from 'happy-dom';
+
+describe('CoffeeCard Autonomous Custom Element', () => {
+  let window;
+  let document;
+  let CoffeeCard;
+
+  beforeEach(async () => {
+    window = new Window();
+    document = window.document;
+
+    // Polyfill global environment for the module import if needed
+    globalThis.window = window;
+    globalThis.document = document;
+    globalThis.HTMLElement = window.HTMLElement;
+    globalThis.customElements = window.customElements;
+    globalThis.CustomEvent = window.CustomEvent;
+
+    // Dynamically import CoffeeCard into the simulated window environment
+    const mod = await import(`../js/coffee-card.js?t=${Date.now()}`);
+    CoffeeCard = mod.CoffeeCard;
+
+    if (!window.customElements.get('coffee-card')) {
+      window.customElements.define('coffee-card', CoffeeCard);
+    }
+  });
+
+  test('registers as an autonomous custom element extending HTMLElement', () => {
+    assert.equal(window.customElements.get('coffee-card'), CoffeeCard);
+    const card = document.createElement('coffee-card');
+    assert.ok(card instanceof window.HTMLElement);
+    assert.ok(card instanceof CoffeeCard);
+    assert.ok(card.shadowRoot);
+  });
+
+  test('observes the required attributes', () => {
+    assert.deepEqual(CoffeeCard.observedAttributes, [
+      'name',
+      'description',
+      'href',
+      'button-text',
+      'image',
+      'image-alt',
+      'price',
+      'rating',
+      'featured',
+      'sold-out'
+    ]);
+  });
+
+  describe('String attribute/property reflection', () => {
+    test('reflects name attribute to property and vice versa', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      // Default
+      assert.equal(card.name, '');
+
+      // Property -> Attribute
+      card.name = 'Caramel Macchiato';
+      assert.equal(card.getAttribute('name'), 'Caramel Macchiato');
+      assert.equal(card.name, 'Caramel Macchiato');
+
+      // Attribute -> Property
+      card.setAttribute('name', 'Iced Americano');
+      assert.equal(card.name, 'Iced Americano');
+
+      // Removal
+      card.name = '';
+      assert.equal(card.hasAttribute('name'), false);
+      assert.equal(card.name, '');
+    });
+
+    test('reflects description attribute to property and vice versa', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.description, '');
+
+      card.description = 'Rich and smooth espresso with steamed milk.';
+      assert.equal(card.getAttribute('description'), 'Rich and smooth espresso with steamed milk.');
+
+      card.setAttribute('description', 'Cold brewed for 24 hours.');
+      assert.equal(card.description, 'Cold brewed for 24 hours.');
+
+      card.description = null;
+      assert.equal(card.hasAttribute('description'), false);
+      assert.equal(card.description, '');
+    });
+
+    test('reflects href attribute to property and vice versa', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.href, '#');
+
+      card.href = '/menu/macchiato';
+      assert.equal(card.getAttribute('href'), '/menu/macchiato');
+
+      card.setAttribute('href', '/menu/americano');
+      assert.equal(card.href, '/menu/americano');
+
+      card.href = '';
+      assert.equal(card.hasAttribute('href'), false);
+      assert.equal(card.href, '#');
+    });
+
+    test('reflects button-text (and camelCase buttonText) attribute to property', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.buttonText, 'View Details');
+
+      card.buttonText = 'Order Now';
+      assert.equal(card.getAttribute('button-text'), 'Order Now');
+      assert.equal(card['button-text'], 'Order Now');
+
+      card.setAttribute('button-text', 'Customize');
+      assert.equal(card.buttonText, 'Customize');
+      assert.equal(card['button-text'], 'Customize');
+
+      card['button-text'] = 'Buy Instant';
+      assert.equal(card.getAttribute('button-text'), 'Buy Instant');
+      assert.equal(card.buttonText, 'Buy Instant');
