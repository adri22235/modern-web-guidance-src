+      assert.equal(card['image-alt'], 'A shot of espresso with crema');
+    });
+  });
+
+  describe('Numeric attribute/property reflection', () => {
+    test('reflects price attribute and property with numeric coercion', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      // Default
+      assert.equal(card.price, 0);
+
+      // Property -> Attribute (number)
+      card.price = 4.75;
+      assert.equal(card.getAttribute('price'), '4.75');
+      assert.equal(card.price, 4.75);
+
+      // Attribute -> Property (string coerced to number)
+      card.setAttribute('price', '5.50');
+      assert.equal(card.price, 5.5);
+
+      // Invalid numeric values clear attribute
+      card.price = NaN;
+      assert.equal(card.hasAttribute('price'), false);
+      assert.equal(card.price, 0);
+
+      card.price = 3.25;
+      card.price = null;
+      assert.equal(card.hasAttribute('price'), false);
+      assert.equal(card.price, 0);
+    });
+
+    test('reflects rating attribute and property with numeric coercion', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.rating, 0);
+
+      card.rating = 4.9;
+      assert.equal(card.getAttribute('rating'), '4.9');
+      assert.equal(card.rating, 4.9);
+
+      card.setAttribute('rating', '4.2');
+      assert.equal(card.rating, 4.2);
+
+      card.rating = null;
+      assert.equal(card.hasAttribute('rating'), false);
+      assert.equal(card.rating, 0);
+    });
+  });
+
+  describe('Boolean attribute/property reflection', () => {
+    test('reflects featured boolean attribute (present = true, absent = false)', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.featured, false);
+      assert.equal(card.hasAttribute('featured'), false);
+
+      // Setting property to true toggles attribute on
+      card.featured = true;
+      assert.equal(card.hasAttribute('featured'), true);
+      assert.equal(card.getAttribute('featured'), '');
+      assert.equal(card.featured, true);
+
+      // Setting property to false toggles attribute off
+      card.featured = false;
+      assert.equal(card.hasAttribute('featured'), false);
+      assert.equal(card.featured, false);
+
+      // Attribute presence toggles property
+      card.setAttribute('featured', '');
+      assert.equal(card.featured, true);
+
+      card.removeAttribute('featured');
+      assert.equal(card.featured, false);
+    });
+
+    test('reflects sold-out (and camelCase soldOut) boolean attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.soldOut, false);
+      assert.equal(card['sold-out'], false);
+      assert.equal(card.hasAttribute('sold-out'), false);
+
+      card.soldOut = true;
+      assert.equal(card.hasAttribute('sold-out'), true);
+      assert.equal(card.soldOut, true);
+      assert.equal(card['sold-out'], true);
+
+      card['sold-out'] = false;
+      assert.equal(card.hasAttribute('sold-out'), false);
+      assert.equal(card.soldOut, false);
+
+      card.setAttribute('sold-out', '');
+      assert.equal(card.soldOut, true);
+    });
+  });
+
+  describe('Lifecycle and DOM rendering', () => {
+    test('renders shadow DOM on connectedCallback and updates on attribute changes', () => {
+      const card = document.createElement('coffee-card');
+      card.setAttribute('name', 'Maple Oat Latte');
+      card.setAttribute('description', 'Oat milk and maple syrup.');
+      card.setAttribute('price', '4.75');
+      card.setAttribute('rating', '4.9');
+      card.setAttribute('href', '/menu/seasonal');
+      card.setAttribute('featured', '');
+      document.body.appendChild(card);
+
+      const shadow = card.shadowRoot;
+      assert.ok(shadow.querySelector('h3'));
+      assert.ok(shadow.innerHTML.includes('Maple Oat Latte'));
+      assert.ok(shadow.innerHTML.includes('Oat milk and maple syrup.'));
+      assert.ok(shadow.innerHTML.includes('$4.75'));
+      assert.ok(shadow.innerHTML.includes('★ 4.9'));
+      assert.ok(shadow.querySelector('.badge-featured'));
+
+      // Changing attribute updates shadow DOM
+      card.setAttribute('sold-out', '');
+      assert.ok(shadow.querySelector('.badge-sold-out'));
+
+      card.removeAttribute('featured');
+      assert.equal(shadow.querySelector('.badge-featured'), null);
+    });
+
+    test('progressively enhances from light DOM when attributes are omitted', () => {
+      const card = document.createElement('coffee-card');
+      card.innerHTML = `
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours.</p>
+        <a href="/menu/cold-brew">View Cold Brew</a>
+      `;
+      document.body.appendChild(card);
+
+      assert.equal(card.name, 'Cold Brew');
+      assert.equal(card.description, 'Steeped for 18 hours.');
+      assert.equal(card.href, '/menu/cold-brew');
+      assert.equal(card.buttonText, 'View Cold Brew');
+    });
+
+    test('dispatches coffee-select custom event on button click', () => {
+      const card = document.createElement('coffee-card');
+      card.name = 'Dark Roast';
+      card.price = 3.5;
+      card.href = '/menu/espresso';
+      document.body.appendChild(card);
+
+      let eventFired = false;
+      let eventDetail = null;
+
+      card.addEventListener('coffee-select', (e) => {
+        eventFired = true;
+        eventDetail = e.detail;
+      });
+
+      const btn = card.shadowRoot.querySelector('.btn');
+      btn.click();
+
+      assert.equal(eventFired, true);
+      assert.equal(eventDetail.name, 'Dark Roast');
+      assert.equal(eventDetail.price, 3.5);
+      assert.equal(eventDetail.href, '/menu/espresso');
+    });
+
+    test('reconnection is idempotent without leaking listeners', () => {
+      const card = document.createElement('coffee-card');
+      card.name = 'Cortado';
+      document.body.appendChild(card);
+
+      // Disconnect
+      document.body.removeChild(card);
+
+      // Reconnect
+      document.body.appendChild(card);
+
+      let clicks = 0;
+      card.addEventListener('coffee-select', () => {
+        clicks++;
+      });
+
+      const btn = card.shadowRoot.querySelector('.btn');
+      btn.click();
+
+      assert.equal(clicks, 1);
+    });
+  });
+});
