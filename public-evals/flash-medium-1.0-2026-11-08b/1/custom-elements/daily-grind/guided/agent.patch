+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { Window } from 'happy-dom';
+
+describe('index.html Integration Test', () => {
+  test('index.html contains autonomous <coffee-card> elements and upgrades them properly', async () => {
+    const htmlPath = path.resolve('index.html');
+    const htmlContent = fs.readFileSync(htmlPath, 'utf8');
+
+    const window = new Window();
+    const document = window.document;
+
+    globalThis.window = window;
+    globalThis.document = document;
+    globalThis.HTMLElement = window.HTMLElement;
+    globalThis.customElements = window.customElements;
+
+    const { CoffeeCard } = await import('../js/coffee-card.js');
+    if (!window.customElements.get('coffee-card')) {
+      window.customElements.define('coffee-card', CoffeeCard);
+    }
+
+    document.write(htmlContent);
+
+    const cards = document.querySelectorAll('coffee-card');
+    assert.equal(cards.length, 3);
+
+    // Card 1: Maple Oat Latte (Featured)
+    const card1 = cards[0];
+    assert.equal(card1.name, 'Maple Oat Latte');
+    assert.equal(card1.price, 4.75);
+    assert.equal(card1.rating, 4.9);
+    assert.equal(card1.featured, true);
+    assert.equal(card1.soldOut, false);
+    assert.ok(card1.shadowRoot.querySelector('.badge-featured'));
+    assert.ok(card1.shadowRoot.innerHTML.includes('Maple Oat Latte'));
+
+    // Card 2: Dark Roast Espresso
+    const card2 = cards[1];
+    assert.equal(card2.name, 'Dark Roast Espresso');
+    assert.equal(card2.price, 3.50);
+    assert.equal(card2.rating, 4.8);
+    assert.equal(card2.featured, false);
+    assert.ok(card2.shadowRoot.innerHTML.includes('Dark Roast Espresso'));
+
+    // Card 3: Cold Brew
+    const card3 = cards[2];
+    assert.equal(card3.name, 'Cold Brew');
+    assert.equal(card3.price, 4.25);
+    assert.equal(card3.rating, 4.7);
+    assert.ok(card3.shadowRoot.innerHTML.includes('Cold Brew'));
+  });
+});
