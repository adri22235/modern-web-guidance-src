+
+    test('reflects image and image-alt attributes to properties', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.image, '');
+      assert.equal(card.imageAlt, 'Coffee image');
+
+      card.name = 'Espresso';
+      assert.equal(card.imageAlt, 'Espresso');
+
+      card.image = 'https://example.com/espresso.jpg';
+      assert.equal(card.getAttribute('image'), 'https://example.com/espresso.jpg');
+
+      card.imageAlt = 'A shot of espresso with crema';
