+import { test, describe, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { Window } from 'happy-dom';
+
+describe('CoffeeCard Autonomous Custom Element', () => {
+  let window;
+  let document;
+  let CoffeeCard;
+
+  beforeEach(async () => {
+    window = new Window();
+    document = window.document;
+
+    // Expose globals for custom elements and DOM
+    globalThis.window = window;
+    globalThis.document = document;
+    globalThis.HTMLElement = window.HTMLElement;
+    globalThis.customElements = window.customElements;
+    globalThis.CustomEvent = window.CustomEvent;
+    globalThis.AbortController = window.AbortController;
+
+    // Dynamically import module with fresh environment
+    const module = await import(`../coffee-card.js?t=${Date.now()}_${Math.random()}`);
+    CoffeeCard = module.CoffeeCard;
+  });
+
+  test('registers coffee-card as an autonomous custom element extending HTMLElement', () => {
+    assert.ok(window.customElements.get('coffee-card'));
+    const card = document.createElement('coffee-card');
+    assert.ok(card instanceof CoffeeCard);
+    assert.ok(card instanceof window.HTMLElement);
+  });
+
+  test('observes expected attributes', () => {
+    const observed = CoffeeCard.observedAttributes;
+    assert.ok(observed.includes('title'));
+    assert.ok(observed.includes('description'));
+    assert.ok(observed.includes('price'));
+    assert.ok(observed.includes('rating'));
+    assert.ok(observed.includes('calories'));
+    assert.ok(observed.includes('featured'));
+    assert.ok(observed.includes('seasonal'));
+    assert.ok(observed.includes('sold-out'));
+    assert.ok(observed.includes('button-text'));
+    assert.ok(observed.includes('badge'));
+    assert.ok(observed.includes('image'));
+    assert.ok(observed.includes('href'));
+  });
+
+  describe('String Attribute and Property Reflection', () => {
+    test('reflects title property <-> attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      // Property -> Attribute
+      card.title = 'Vanilla Hazelnut';
+      assert.equal(card.getAttribute('title'), 'Vanilla Hazelnut');
+      assert.equal(card.title, 'Vanilla Hazelnut');
+
+      // Attribute -> Property
+      card.setAttribute('title', 'Caramel Macchiato');
+      assert.equal(card.title, 'Caramel Macchiato');
+
+      // Clear title
+      card.title = null;
+      assert.equal(card.hasAttribute('title'), false);
+      assert.equal(card.title, '');
+    });
+
+    test('reflects description property <-> attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      card.description = 'Freshly brewed artisan roast.';
+      assert.equal(card.getAttribute('description'), 'Freshly brewed artisan roast.');
+      assert.equal(card.description, 'Freshly brewed artisan roast.');
+
+      card.setAttribute('description', 'Updated description text.');
+      assert.equal(card.description, 'Updated description text.');
+
+      card.description = null;
+      assert.equal(card.hasAttribute('description'), false);
+      assert.equal(card.description, '');
+    });
+
+    test('reflects image, badge, and href properties <-> attributes', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      card.image = 'https://images.unsplash.com/coffee.jpg';
+      assert.equal(card.getAttribute('image'), 'https://images.unsplash.com/coffee.jpg');
+      assert.equal(card.image, 'https://images.unsplash.com/coffee.jpg');
+
+      card.badge = 'Special Roast';
+      assert.equal(card.getAttribute('badge'), 'Special Roast');
+      assert.equal(card.badge, 'Special Roast');
+
+      card.href = '/order/special';
+      assert.equal(card.getAttribute('href'), '/order/special');
+      assert.equal(card.href, '/order/special');
+    });
+
+    test('reflects buttonText property <-> button-text attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      // Default value
+      assert.equal(card.buttonText, 'View Details');
+
+      // Property -> Attribute
+      card.buttonText = 'Order Now';
+      assert.equal(card.getAttribute('button-text'), 'Order Now');
+      assert.equal(card.buttonText, 'Order Now');
+
+      // Attribute -> Property
+      card.setAttribute('button-text', 'Customize');
+      assert.equal(card.buttonText, 'Customize');
+
+      // Reset
+      card.buttonText = null;
+      assert.equal(card.hasAttribute('button-text'), false);
+      assert.equal(card.buttonText, 'View Details');
+    });
+  });
+
+  describe('Numeric Attribute and Property Reflection', () => {
+    test('reflects price numeric property <-> attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.price, null);
+
+      // Property -> Attribute
+      card.price = 4.75;
+      assert.equal(card.getAttribute('price'), '4.75');
+      assert.equal(card.price, 4.75);
+
+      // Attribute -> Property
+      card.setAttribute('price', '5.50');
+      assert.equal(card.price, 5.5);
+
+      // Null/invalid value clears attribute
+      card.price = null;
+      assert.equal(card.hasAttribute('price'), false);
+      assert.equal(card.price, null);
+
+      card.price = NaN;
+      assert.equal(card.hasAttribute('price'), false);
+      assert.equal(card.price, null);
+    });
+
+    test('reflects rating numeric property <-> attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.rating, null);
+
+      card.rating = 4.9;
+      assert.equal(card.getAttribute('rating'), '4.9');
+      assert.equal(card.rating, 4.9);
+
+      card.setAttribute('rating', '3.8');
+      assert.equal(card.rating, 3.8);
+
+      card.rating = undefined;
+      assert.equal(card.hasAttribute('rating'), false);
+      assert.equal(card.rating, null);
+    });
+
+    test('reflects calories numeric property <-> attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.calories, null);
+
+      card.calories = 190;
+      assert.equal(card.getAttribute('calories'), '190');
+      assert.equal(card.calories, 190);
+
+      card.setAttribute('calories', '220');
+      assert.equal(card.calories, 220);
+
+      card.calories = null;
+      assert.equal(card.hasAttribute('calories'), false);
+      assert.equal(card.calories, null);
+    });
+  });
+
+  describe('Boolean Attribute and Property Reflection', () => {
+    test('reflects featured boolean attribute <-> property', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.featured, false);
+      assert.equal(card.hasAttribute('featured'), false);
+
+      // Property -> Attribute
+      card.featured = true;
+      assert.equal(card.hasAttribute('featured'), true);
+      assert.equal(card.featured, true);
+
+      card.featured = false;
+      assert.equal(card.hasAttribute('featured'), false);
+      assert.equal(card.featured, false);
+
+      // Attribute -> Property
+      card.setAttribute('featured', '');
+      assert.equal(card.featured, true);
+
+      card.removeAttribute('featured');
+      assert.equal(card.featured, false);
+    });
+
+    test('reflects seasonal boolean attribute <-> property', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.seasonal, false);
+
+      card.seasonal = true;
+      assert.equal(card.hasAttribute('seasonal'), true);
+      assert.equal(card.seasonal, true);
+
+      card.seasonal = false;
+      assert.equal(card.hasAttribute('seasonal'), false);
+      assert.equal(card.seasonal, false);
+    });
+
+    test('reflects soldOut property <-> sold-out attribute', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      assert.equal(card.soldOut, false);
+
+      card.soldOut = true;
+      assert.equal(card.hasAttribute('sold-out'), true);
+      assert.equal(card.soldOut, true);
+
+      card.soldOut = false;
+      assert.equal(card.hasAttribute('sold-out'), false);
+      assert.equal(card.soldOut, false);
+
+      card.setAttribute('sold-out', '');
+      assert.equal(card.soldOut, true);
+    });
+  });
+
+  describe('Lifecycle Management', () => {
+    test('handles connectedCallback and disconnectedCallback events and listener teardown', () => {
+      let connectedFired = false;
+      let disconnectedFired = false;
+
+      const card = document.createElement('coffee-card');
+      card.addEventListener('coffee-card-connected', () => {
+        connectedFired = true;
+      });
+      card.addEventListener('coffee-card-disconnected', () => {
+        disconnectedFired = true;
+      });
+
+      document.body.appendChild(card);
+      assert.equal(connectedFired, true);
+      assert.ok(card.shadowRoot);
+
+      document.body.removeChild(card);
+      assert.equal(disconnectedFired, true);
+    });
+
+    test('updates shadow DOM when attributes change dynamically via attributeChangedCallback', () => {
+      const card = document.createElement('coffee-card');
+      document.body.appendChild(card);
+
+      card.setAttribute('title', 'Espresso Macchiato');
+      card.setAttribute('price', '3.75');
+      card.setAttribute('rating', '4.6');
+      card.setAttribute('featured', '');
+
+      const titleEl = card.shadowRoot.querySelector('.card-title');
+      const priceEl = card.shadowRoot.querySelector('.price-tag');
+      const ratingEl = card.shadowRoot.querySelector('.rating-tag');
+      const featuredBadge = card.shadowRoot.querySelector('.badge-featured');
+
+      assert.equal(titleEl.textContent, 'Espresso Macchiato');
+      assert.equal(priceEl.textContent, '$3.75');
+      assert.equal(ratingEl.textContent, '★ 4.6');
+      assert.ok(featuredBadge);
+
+      // Dynamically change attributes
+      card.setAttribute('title', 'Flat White');
+      card.setAttribute('price', '4.20');
+      assert.equal(titleEl.textContent, 'Flat White');
+      assert.equal(priceEl.textContent, '$4.20');
+    });
+
+    test('upgrades pre-set properties prior to appending to document', () => {
+      const card = document.createElement('coffee-card');
+      // Set properties before connecting to DOM
+      card.title = 'Nitro Cold Brew';
+      card.price = 5.25;
+      card.featured = true;
+
+      document.body.appendChild(card);
+
+      assert.equal(card.getAttribute('title'), 'Nitro Cold Brew');
+      assert.equal(card.getAttribute('price'), '5.25');
+      assert.equal(card.hasAttribute('featured'), true);
+
+      const titleEl = card.shadowRoot.querySelector('.card-title');
+      assert.equal(titleEl.textContent, 'Nitro Cold Brew');
+    });
+
+    test('dispatches coffee-select event when action button is clicked', () => {
+      const card = document.createElement('coffee-card');
+      card.title = 'Maple Oat Latte';
+      card.price = 4.75;
+      card.href = '/menu/seasonal';
+      document.body.appendChild(card);
+
+      let selectEventFired = false;
+      let eventDetail = null;
+
+      document.addEventListener('coffee-select', (e) => {
+        selectEventFired = true;
+        eventDetail = e.detail;
+      });
+
+      const btn = card.shadowRoot.querySelector('.btn');
+      btn.click();
+
+      assert.equal(selectEventFired, true);
+      assert.equal(eventDetail.title, 'Maple Oat Latte');
+      assert.equal(eventDetail.price, 4.75);
+      assert.equal(eventDetail.href, '/menu/seasonal');
+    });
+
+    test('prevents action when soldOut is true', () => {
+      const card = document.createElement('coffee-card');
+      card.title = 'Sold Out Roast';
+      card.soldOut = true;
+      document.body.appendChild(card);
+
+      let selectEventFired = false;
+      document.addEventListener('coffee-select', () => {
+        selectEventFired = true;
+      });
+
+      const btn = card.shadowRoot.querySelector('.btn');
+      btn.click();
+
+      assert.equal(selectEventFired, false);
+      assert.equal(btn.textContent, 'Sold Out');
+    });
+  });
+});
