+/**
+ * CoffeeCard Autonomous Custom Element (<coffee-card>)
+ *
+ * Implements autonomous custom element standards with:
+ * - Shadow DOM encapsulation
+ * - Complete lifecycle management (constructor, connectedCallback, disconnectedCallback, attributeChangedCallback, adoptedCallback)
+ * - Two-way property and attribute reflection for String, Numeric, and Boolean types
+ * - Accessible markup and customizable CSS parts & slots
+ */
+export class CoffeeCard extends HTMLElement {
+  // Attributes to observe for changes
+  static get observedAttributes() {
+    return [
+      'title',
+      'name',
+      'description',
+      'image',
+      'badge',
+      'href',
+      'button-text',
+      'price',
+      'rating',
+      'calories',
+      'featured',
+      'seasonal',
+      'sold-out'
+    ];
+  }
+
+  constructor() {
+    super();
+
+    // Attach open shadow DOM for encapsulation
+    this.attachShadow({ mode: 'open' });
+
+    // Track lifecycle state
+    this._isRendered = false;
+    this._abortController = null;
+    this._boundOnClick = this._handleClick.bind(this);
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Property Reflection: String Attributes                                    */
+  /* -------------------------------------------------------------------------- */
+
+  get title() {
+    return this.getAttribute('title') || this.getAttribute('name') || '';
+  }
+
+  set title(value) {
+    this._reflectStringAttribute('title', value);
+  }
+
+  // Alias name <-> title
+  get name() {
+    return this.title;
+  }
+
+  set name(value) {
+    this.title = value;
+  }
+
+  get description() {
+    return this.getAttribute('description') || '';
+  }
+
+  set description(value) {
+    this._reflectStringAttribute('description', value);
+  }
+
+  get image() {
+    return this.getAttribute('image') || '';
+  }
+
+  set image(value) {
+    this._reflectStringAttribute('image', value);
+  }
+
+  get badge() {
+    return this.getAttribute('badge') || '';
+  }
+
+  set badge(value) {
+    this._reflectStringAttribute('badge', value);
+  }
+
+  get href() {
+    return this.getAttribute('href') || '#';
+  }
+
+  set href(value) {
+    this._reflectStringAttribute('href', value);
+  }
+
+  get buttonText() {
+    return this.getAttribute('button-text') || 'View Details';
+  }
+
+  set buttonText(value) {
+    this._reflectStringAttribute('button-text', value);
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Property Reflection: Numeric Attributes                                   */
+  /* -------------------------------------------------------------------------- */
+
+  get price() {
+    if (!this.hasAttribute('price')) return null;
+    const val = parseFloat(this.getAttribute('price'));
+    return Number.isFinite(val) ? val : null;
+  }
+
+  set price(value) {
+    this._reflectNumericAttribute('price', value);
+  }
+
+  get rating() {
+    if (!this.hasAttribute('rating')) return null;
+    const val = parseFloat(this.getAttribute('rating'));
+    return Number.isFinite(val) ? val : null;
+  }
+
+  set rating(value) {
+    this._reflectNumericAttribute('rating', value);
+  }
+
+  get calories() {
+    if (!this.hasAttribute('calories')) return null;
+    const val = parseInt(this.getAttribute('calories'), 10);
+    return Number.isFinite(val) ? val : null;
+  }
+
+  set calories(value) {
+    this._reflectNumericAttribute('calories', value);
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Property Reflection: Boolean Attributes                                   */
+  /* -------------------------------------------------------------------------- */
+
+  get featured() {
+    return this.hasAttribute('featured');
+  }
+
+  set featured(value) {
+    this._reflectBooleanAttribute('featured', value);
+  }
+
+  get seasonal() {
+    return this.hasAttribute('seasonal');
+  }
+
+  set seasonal(value) {
+    this._reflectBooleanAttribute('seasonal', value);
+  }
+
+  get soldOut() {
+    return this.hasAttribute('sold-out');
+  }
+
+  set soldOut(value) {
+    this._reflectBooleanAttribute('sold-out', value);
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Reflection Helper Methods                                                 */
+  /* -------------------------------------------------------------------------- */
+
+  _reflectStringAttribute(name, value) {
+    if (value === null || value === undefined) {
+      if (this.hasAttribute(name)) {
+        this.removeAttribute(name);
+      }
+    } else {
+      const strVal = String(value);
+      if (this.getAttribute(name) !== strVal) {
+        this.setAttribute(name, strVal);
+      }
+    }
+  }
+
+  _reflectNumericAttribute(name, value) {
+    if (value === null || value === undefined || value === '' || Number.isNaN(Number(value))) {
+      if (this.hasAttribute(name)) {
+        this.removeAttribute(name);
+      }
+    } else {
+      const numStr = String(value);
+      if (this.getAttribute(name) !== numStr) {
+        this.setAttribute(name, numStr);
+      }
+    }
+  }
+
+  _reflectBooleanAttribute(name, value) {
+    const isTrue = Boolean(value);
+    if (isTrue) {
+      if (!this.hasAttribute(name)) {
+        this.setAttribute(name, '');
+      }
+    } else {
+      if (this.hasAttribute(name)) {
+        this.removeAttribute(name);
+      }
+    }
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Lifecycle Callbacks                                                       */
+  /* -------------------------------------------------------------------------- */
+
+  connectedCallback() {
+    // Upgrade any properties assigned before the custom element definition was registered
+    this._upgradeProperties([
+      'title',
+      'name',
+      'description',
+      'image',
+      'badge',
+      'href',
+      'buttonText',
+      'price',
+      'rating',
+      'calories',
+      'featured',
+      'seasonal',
+      'soldOut'
+    ]);
+
+    // Initial render
+    this._render();
+
+    // Setup lifecycle event listeners
+    this._setupListeners();
+
+    // Dispatch connected notification event
+    this.dispatchEvent(
+      new CustomEvent('coffee-card-connected', {
+        bubbles: true,
+        composed: true,
+        detail: { card: this }
+      })
+    );
+  }
+
+  disconnectedCallback() {
+    // Teardown event listeners
+    this._teardownListeners();
+
+    // Dispatch disconnected notification event
+    this.dispatchEvent(
+      new CustomEvent('coffee-card-disconnected', {
+        bubbles: true,
+        composed: true,
+        detail: { card: this }
+      })
+    );
+  }
+
+  adoptedCallback() {
+    // Handle adoption into a new document
+    if (this._isRendered) {
+      this._updateContent();
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+
+    // Synchronize title alias
+    if (name === 'name' && !this.hasAttribute('title')) {
+      // name acts as fallback for title
+    }
+
+    if (this._isRendered) {
+      this._updateContent();
+    }
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Property Upgrading                                                        */
+  /* -------------------------------------------------------------------------- */
+
+  _upgradeProperties(props) {
+    props.forEach((prop) => {
+      if (Object.prototype.hasOwnProperty.call(this, prop)) {
+        const val = this[prop];
+        delete this[prop];
+        this[prop] = val;
+      }
+    });
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Event Listeners Setup & Cleanup                                           */
+  /* -------------------------------------------------------------------------- */
+
+  _setupListeners() {
+    this._teardownListeners();
+
+    this._abortController = new AbortController();
+    const { signal } = this._abortController;
+
+    const actionBtn = this.shadowRoot.querySelector('.btn');
+    if (actionBtn) {
+      actionBtn.addEventListener('click', this._boundOnClick, { signal });
+    }
+  }
+
+  _teardownListeners() {
+    if (this._abortController) {
+      this._abortController.abort();
+      this._abortController = null;
+    }
+  }
+
+  _handleClick(e) {
+    if (this.soldOut) {
+      e.preventDefault();
+      e.stopPropagation();
+      return;
+    }
+
+    // Dispatch an autonomous custom event crossing shadow DOM boundaries
+    const customEvent = new CustomEvent('coffee-select', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: {
+        title: this.title,
+        price: this.price,
+        rating: this.rating,
+        calories: this.calories,
+        featured: this.featured,
+        seasonal: this.seasonal,
+        soldOut: this.soldOut,
+        href: this.href
+      }
+    });
+
+    const isAllowed = this.dispatchEvent(customEvent);
+    if (!isAllowed) {
+      e.preventDefault();
+    }
+  }
+
+  /* -------------------------------------------------------------------------- */
+  /* Rendering & DOM Management                                                */
+  /* -------------------------------------------------------------------------- */
+
+  _render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          font-family: inherit;
+          box-sizing: border-box;
+        }
+
+        :host([hidden]) {
+          display: none !important;
+        }
+
+        *, *::before, *::after {
+          box-sizing: border-box;
+        }
+
+        .card {
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          background: #ffffff;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          padding: 20px;
+          position: relative;
+          overflow: hidden;
+          transition: transform 0.25s ease, box-shadow 0.25s ease;
+        }
+
+        .card:hover {
+          transform: translateY(-4px);
+          box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
+        }
+
+        :host([featured]) .card {
+          border: 2px solid var(--accent, #ffab40);
+          box-shadow: 0 4px 14px rgba(255, 171, 64, 0.25);
+        }
+
+        :host([sold-out]) .card {
+          opacity: 0.72;
+          filter: grayscale(25%);
+        }
+
+        /* Badges */
+        .badges-wrapper {
+          position: absolute;
+          top: 12px;
+          left: 12px;
+          display: flex;
+          flex-wrap: wrap;
+          gap: 6px;
+          z-index: 2;
+        }
+
+        .badge {
+          font-size: 0.75rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.5px;
+          padding: 3px 8px;
+          border-radius: 4px;
+          color: #ffffff;
+          background: var(--primary, #4e342e);
+        }
+
+        .badge-featured {
+          background: var(--accent, #ffab40);
+          color: #3e2723;
+        }
+
+        .badge-seasonal {
+          background: #2e7d32;
+          color: #ffffff;
+        }
+
+        .badge-sold-out {
+          background: #c62828;
+          color: #ffffff;
+        }
+
+        /* Media / Stock Image */
+        .card-media {
+          width: 100%;
+          height: 180px;
+          border-radius: 6px;
+          overflow: hidden;
+          margin-bottom: 16px;
+          background: #f5efe6;
+          position: relative;
+          display: flex;
+          align-items: center;
+          justify-content: center;
+        }
+
+        .card-media img {
+          width: 100%;
+          height: 100%;
+          object-fit: cover;
+          display: block;
+          transition: transform 0.3s ease;
+        }
+
+        .card:hover .card-media img {
+          transform: scale(1.04);
+        }
+
+        .fallback-icon {
+          display: none;
+          color: var(--primary, #4e342e);
+          opacity: 0.4;
+          font-size: 2.5rem;
+        }
+
+        .card-media.no-img .fallback-icon {
+          display: block;
+        }
+
+        .card-media.no-img img {
+          display: none;
+        }
+
+        /* Content */
+        .card-body {
+          display: flex;
+          flex-direction: column;
+          flex: 1 1 auto;
+        }
+
+        .card-title {
+          margin: 0 0 8px 0;
+          color: var(--primary, #4e342e);
+          font-size: 1.25rem;
+          font-weight: 600;
+          line-height: 1.3;
+        }
+
+        /* Meta details: price, rating, calories */
+        .card-meta {
+          display: flex;
+          justify-content: center;
+          align-items: center;
+          gap: 12px;
+          margin-bottom: 10px;
+          font-size: 0.9rem;
+          font-weight: 500;
+        }
+
+        .price-tag {
+          font-size: 1.15rem;
+          font-weight: 700;
+          color: var(--primary, #4e342e);
+        }
+
+        .rating-tag {
+          display: inline-flex;
+          align-items: center;
+          gap: 3px;
+          color: #e65100;
+        }
+
+        .calories-tag {
+          color: #795548;
+          font-size: 0.85rem;
+        }
+
+        .card-desc {
+          font-size: 0.95rem;
+          color: var(--text, #3e2723);
+          line-height: 1.5;
+          margin: 0 0 16px 0;
+          flex: 1 1 auto;
+        }
+
+        /* Action button */
+        .card-footer {
+          margin-top: auto;
+        }
+
+        .btn {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: #ffffff;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          font-weight: 500;
+          transition: background 0.3s ease, transform 0.1s ease;
+          border: none;
+          cursor: pointer;
+          font-family: inherit;
+          font-size: 0.95rem;
+        }
+
+        .btn:hover {
+          background: #3e2723;
+        }
+
+        :host([sold-out]) .btn {
+          background: #9e9e9e;
+          cursor: not-allowed;
+          pointer-events: none;
+        }
+      </style>
+
+      <div class="card" part="card">
+        <div class="badges-wrapper" part="badges"></div>
+
+        <div class="card-media" part="media">
+          <img part="image" alt="" loading="lazy" />
+          <div class="fallback-icon" aria-hidden="true">&#9749;</div>
+        </div>
+
+        <div class="card-body" part="body">
+          <slot name="title">
+            <h3 class="card-title" part="title"></h3>
+          </slot>
+
+          <div class="card-meta" part="meta">
+            <span class="price-tag" part="price"></span>
+            <span class="rating-tag" part="rating"></span>
+            <span class="calories-tag" part="calories"></span>
+          </div>
+
+          <slot name="description">
+            <p class="card-desc" part="description"></p>
+          </slot>
+
+          <div class="card-footer" part="footer">
+            <slot name="action">
+              <a class="btn" part="button" role="button"></a>
+            </slot>
+          </div>
+        </div>
+      </div>
+    `;
+
+    this._isRendered = true;
+    this._updateContent();
+  }
+
+  _updateContent() {
+    if (!this.shadowRoot) return;
+
+    // Badges update
+    const badgesWrapper = this.shadowRoot.querySelector('.badges-wrapper');
+    if (badgesWrapper) {
+      badgesWrapper.innerHTML = '';
+
+      if (this.soldOut) {
+        const b = document.createElement('span');
+        b.className = 'badge badge-sold-out';
+        b.part = 'badge badge-sold-out';
+        b.textContent = 'Sold Out';
+        badgesWrapper.appendChild(b);
+      }
+
+      if (this.featured) {
+        const b = document.createElement('span');
+        b.className = 'badge badge-featured';
+        b.part = 'badge badge-featured';
+        b.textContent = 'Featured';
+        badgesWrapper.appendChild(b);
+      }
+
+      if (this.seasonal) {
+        const b = document.createElement('span');
+        b.className = 'badge badge-seasonal';
+        b.part = 'badge badge-seasonal';
+        b.textContent = 'Seasonal';
+        badgesWrapper.appendChild(b);
+      }
+
+      const customBadge = this.badge;
+      if (customBadge && !this.seasonal && !this.featured) {
+        const b = document.createElement('span');
+        b.className = 'badge';
+        b.part = 'badge';
+        b.textContent = customBadge;
+        badgesWrapper.appendChild(b);
+      }
+    }
+
+    // Media / Image update
+    const mediaEl = this.shadowRoot.querySelector('.card-media');
+    const imgEl = this.shadowRoot.querySelector('.card-media img');
+    if (mediaEl && imgEl) {
+      const imgSrc = this.image;
+      if (imgSrc) {
+        imgEl.src = imgSrc;
+        imgEl.alt = this.title || 'Artisanal Coffee';
+        mediaEl.classList.remove('no-img');
+        mediaEl.style.display = 'flex';
+      } else {
+        imgEl.removeAttribute('src');
+        imgEl.alt = '';
+        mediaEl.classList.add('no-img');
+        // If image is completely absent, keep fallback cup icon
+        mediaEl.style.display = 'flex';
+      }
+    }
+
+    // Title update
+    const titleEl = this.shadowRoot.querySelector('.card-title');
+    if (titleEl) {
+      titleEl.textContent = this.title;
+      titleEl.style.display = this.title ? 'block' : 'none';
+    }
+
+    // Meta updates: Price, Rating, Calories
+    const metaEl = this.shadowRoot.querySelector('.card-meta');
+    const priceEl = this.shadowRoot.querySelector('.price-tag');
+    const ratingEl = this.shadowRoot.querySelector('.rating-tag');
+    const caloriesEl = this.shadowRoot.querySelector('.calories-tag');
+
+    const price = this.price;
+    const rating = this.rating;
+    const calories = this.calories;
+
+    if (priceEl) {
+      if (price !== null) {
+        priceEl.textContent = `$${price.toFixed(2)}`;
+        priceEl.style.display = 'inline';
+      } else {
+        priceEl.textContent = '';
+        priceEl.style.display = 'none';
+      }
+    }
+
+    if (ratingEl) {
+      if (rating !== null) {
+        ratingEl.textContent = `★ ${rating.toFixed(1)}`;
+        ratingEl.style.display = 'inline';
+      } else {
+        ratingEl.textContent = '';
+        ratingEl.style.display = 'none';
+      }
+    }
+
+    if (caloriesEl) {
+      if (calories !== null) {
+        caloriesEl.textContent = `${calories} cal`;
+        caloriesEl.style.display = 'inline';
+      } else {
+        caloriesEl.textContent = '';
+        caloriesEl.style.display = 'none';
+      }
+    }
+
+    if (metaEl) {
+      const hasMeta = price !== null || rating !== null || calories !== null;
+      metaEl.style.display = hasMeta ? 'flex' : 'none';
+    }
+
+    // Description update
+    const descEl = this.shadowRoot.querySelector('.card-desc');
+    if (descEl) {
+      descEl.textContent = this.description;
+      descEl.style.display = this.description ? 'block' : 'none';
+    }
+
+    // Action button update
+    const actionEl = this.shadowRoot.querySelector('.card-footer .btn');
+    if (actionEl) {
+      actionEl.href = this.href;
+      actionEl.textContent = this.soldOut ? 'Sold Out' : this.buttonText;
+      if (this.soldOut) {
+        actionEl.setAttribute('aria-disabled', 'true');
+        actionEl.tabIndex = -1;
+      } else {
+        actionEl.removeAttribute('aria-disabled');
+        actionEl.removeAttribute('tabindex');
+      }
+    }
+  }
+}
+
+// Register the autonomous custom element if not already defined
+if (typeof customElements !== 'undefined' && !customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
