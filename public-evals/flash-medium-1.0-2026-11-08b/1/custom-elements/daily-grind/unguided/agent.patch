@@ -0,0 +1,71 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { Window } from 'happy-dom';
+
+describe('index.html Integration Test', () => {
+  test('index.html properly instantiates and renders coffee-card autonomous custom elements', async () => {
+    const htmlPath = path.resolve('index.html');
+    const htmlContent = fs.readFileSync(htmlPath, 'utf-8');
+
+    const window = new Window();
+    const document = window.document;
+
+    globalThis.window = window;
+    globalThis.document = document;
+    globalThis.HTMLElement = window.HTMLElement;
+    globalThis.customElements = window.customElements;
+    globalThis.CustomEvent = window.CustomEvent;
+    globalThis.AbortController = window.AbortController;
+
+    const { CoffeeCard } = await import('../coffee-card.js');
+
+    document.write(htmlContent);
+
+    const cards = document.querySelectorAll('coffee-card');
+    assert.equal(cards.length, 3, 'Expected 3 coffee cards in index.html');
+
+    // First card: Maple Oat Latte
+    const firstCard = cards[0];
+    assert.equal(firstCard.title, 'Maple Oat Latte');
+    assert.equal(firstCard.price, 4.75);
+    assert.equal(firstCard.rating, 4.9);
+    assert.equal(firstCard.calories, 210);
+    assert.equal(firstCard.featured, true);
+    assert.equal(firstCard.seasonal, true);
+    assert.equal(firstCard.soldOut, false);
+    assert.equal(firstCard.href, '/menu/seasonal');
+    assert.equal(firstCard.buttonText, 'View Details');
+
+    // Verify shadow DOM contents
+    assert.ok(firstCard.shadowRoot);
+    const titleEl = firstCard.shadowRoot.querySelector('.card-title');
+    const priceEl = firstCard.shadowRoot.querySelector('.price-tag');
+    const ratingEl = firstCard.shadowRoot.querySelector('.rating-tag');
+    const descEl = firstCard.shadowRoot.querySelector('.card-desc');
+    const btnEl = firstCard.shadowRoot.querySelector('.btn');
+
+    assert.equal(titleEl.textContent, 'Maple Oat Latte');
+    assert.equal(priceEl.textContent, '$4.75');
+    assert.equal(ratingEl.textContent, '★ 4.9');
+    assert.equal(descEl.textContent, 'Creamy oat milk with a hint of Vermont maple syrup.');
+    assert.equal(btnEl.getAttribute('href'), '/menu/seasonal');
+
+    // Second card: Dark Roast Espresso
+    const secondCard = cards[1];
+    assert.equal(secondCard.title, 'Dark Roast Espresso');
+    assert.equal(secondCard.price, 3.5);
+    assert.equal(secondCard.rating, 4.7);
+    assert.equal(secondCard.calories, 10);
+    assert.equal(secondCard.featured, false);
+
+    // Third card: Cold Brew
+    const thirdCard = cards[2];
+    assert.equal(thirdCard.title, 'Cold Brew');
+    assert.equal(thirdCard.price, 4.25);
+    assert.equal(thirdCard.rating, 4.8);
+    assert.equal(thirdCard.calories, 15);
+    assert.equal(thirdCard.badge, 'Staff Pick');
+  });
+});
