+  <script>
+    // Smooth scroll helper with faithful fallback for browsers where scroll methods return undefined
+    function scrollIntoViewAsync(element, options = { behavior: 'smooth', block: 'start' }, scroller = window) {
+      const result = element.scrollIntoView(options);
+
+      // Feature detect: in supporting browsers, scrollIntoView() returns a Promise
+      if (result && typeof result.then === 'function') {
+        return result;
+      }
+
+      // Fallback for browsers where scrollIntoView() returns undefined
+      return new Promise((resolve) => {
+        let timeoutId;
+
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+
+        // If no scroll event fires within the idle window (e.g., target already in view), resolve.
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    let currentScrollId = 0;
+
+    async function scrollToTarget(targetElement) {
+      const scrollId = ++currentScrollId;
+
+      // Clear previous active highlight states across all sections
+      document.querySelectorAll('.page-section').forEach((sec) => {
+        sec.classList.remove('is-scrolled-target', 'highlight');
+      });
+
+      // Await programmatic smooth scroll until it completes
+      await scrollIntoViewAsync(targetElement, {
+        behavior: 'smooth',
+        block: 'start'
+      });
+
+      // Guard: Abort follow-up effect if another scroll was triggered while awaiting
+      if (scrollId !== currentScrollId) {
+        return;
+      }
+
+      // Ensure element can receive focus
+      if (!targetElement.hasAttribute('tabindex')) {
+        targetElement.setAttribute('tabindex', '-1');
+      }
+
+      // Shift focus to the scrolled-to target without triggering a second jump/scroll
+      targetElement.focus({ preventScroll: true });
+
+      // Trigger visual effects and animations only AFTER scroll completion
+      targetElement.classList.add('is-scrolled-target', 'highlight');
+    }
+
+    // Attach navigation scroll handler
+    document.querySelectorAll('nav a, a[data-scroll-target], a[href^="#"]').forEach((link) => {
+      link.addEventListener('click', async (event) => {
+        const targetId = link.dataset.scrollTarget || link.getAttribute('href')?.replace(/^#/, '');
+        if (!targetId) return;
+
+        const targetElement = document.getElementById(targetId);
+        if (!targetElement) return;
+
+        event.preventDefault();
+        await scrollToTarget(targetElement);
+        history.pushState(null, '', `#${targetId}`);
+      });
+    });
+  </script>
+
