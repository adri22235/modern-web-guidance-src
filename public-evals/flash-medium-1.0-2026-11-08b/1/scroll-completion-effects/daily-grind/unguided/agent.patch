+          window.removeEventListener('scrollend', onScrollEnd);
+          window.removeEventListener('scroll', onScroll);
+        };
+
+        // Listen for modern browser scrollend event
+        if ('onscrollend' in window) {
+          window.addEventListener('scrollend', onScrollEnd, { once: true });
+        }
+        window.addEventListener('scroll', onScroll, { passive: true });
+
+        // Trigger native smooth scrolling to the calculated position
+        window.scrollTo({
+          top: targetTop,
+          behavior: 'smooth'
+        });
+
+        // Fallback safety timeout in case scrollend or scroll event doesn't fire
+        const safetyDuration = Math.min(Math.max(distance * 0.8, 400), 1500);
+        const safetyTimeout = setTimeout(finish, safetyDuration + 150);
+      }
+
+      scrollLinks.forEach(link => {
+        link.addEventListener('click', (e) => {
+          const target = getTargetElement(link);
+          if (!target) return;
+
+          e.preventDefault();
+
+          // Update active styling on navigation items
+          document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
+          if (link.tagName.toLowerCase() === 'a' && link.closest('nav')) {
+            link.classList.add('active');
+          }
+
+          // Clear any active highlight classes from previous targets
+          document.querySelectorAll('.section-highlight, .animating-highlight, .highlight, .target-active').forEach(sec => {
+            sec.classList.remove('section-highlight', 'animating-highlight', 'highlight', 'target-active');
+          });
+
+          // Smoothly scroll to the target element
+          smoothScrollTo(target, () => {
+            // Trigger visual effects, animations, and focus changes ONLY AFTER smooth scroll has finished
+
+            // 1. Focus change
+            if (!target.hasAttribute('tabindex')) {
+              target.setAttribute('tabindex', '-1');
+            }
+            target.focus({ preventScroll: true });
+
+            // 2. Trigger visual effect and animation
+            target.classList.add('section-highlight', 'animating-highlight', 'highlight', 'target-active');
+
+            // 3. Update URL hash without causing an instant scroll jump
+            if (history.pushState) {
+              history.pushState(null, '', '#' + target.id);
+            } else {
+              location.hash = '#' + target.id;
+            }
+
+            // Remove animation class after keyframe animation completes
+            target.addEventListener('animationend', () => {
+              target.classList.remove('animating-highlight');
+            }, { once: true });
+          });
+        });
+      });
+
+      // Handle direct hash navigation on page load
+      if (window.location.hash) {
+        const initialTarget = document.getElementById(window.location.hash.substring(1));
+        if (initialTarget) {
+          setTimeout(() => {
+            smoothScrollTo(initialTarget, () => {
+              if (!initialTarget.hasAttribute('tabindex')) {
+                initialTarget.setAttribute('tabindex', '-1');
+              }
+              initialTarget.focus({ preventScroll: true });
+              initialTarget.classList.add('section-highlight', 'animating-highlight', 'highlight', 'target-active');
+            });
+          }, 200);
+        }
+      }
+    });
+  </script>
