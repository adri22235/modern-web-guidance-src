diff --git a/src/components/PrivacyConsent.tsx b/src/components/PrivacyConsent.tsx
new file mode 100644
index 0000000..3998771
--- /dev/null
+++ b/src/components/PrivacyConsent.tsx
@@ -0,0 +1,392 @@
+import React, { useState, useEffect } from 'react';
+
+export interface ConsentPreferences {
+  necessary: boolean;
+  analytics: boolean;
+  advertising: boolean;
+  timestamp: string;
+  userChoiceMade: boolean;
+}
+
+const STORAGE_KEY = 'devtools_times_privacy_consent';
+
+export default function PrivacyConsent() {
+  const [preferences, setPreferences] = useState<ConsentPreferences>({
+    necessary: true,
+    analytics: false,
+    advertising: false,
+    timestamp: '',
+    userChoiceMade: false,
+  });
+
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [dntDetected, setDntDetected] = useState(false);
+
+  // Check DNT / GPC signals
+  const checkDnt = (): boolean => {
+    if (typeof window === 'undefined') return false;
+    return (
+      navigator.doNotTrack === '1' ||
+      (window as any).doNotTrack === '1' ||
+      (navigator as any).globalPrivacyControl === true
+    );
+  };
+
+  // Dynamically load or unload third-party scripts according to consent and page context
+  const applyThirdPartyScripts = (prefs: ConsentPreferences) => {
+    if (typeof window === 'undefined' || typeof document === 'undefined') return;
+
+    const isDnt = checkDnt();
+    const pathname = window.location.pathname;
+    const isAuthPage = pathname.includes('/signin') || pathname.includes('/signup');
+
+    // 1. Analytics Script (analytics-client.js)
+    const analyticsScriptId = 'devtools-analytics-script';
+    const existingAnalyticsScript = document.getElementById(analyticsScriptId);
+
+    // Data minimization & Privacy by Design:
+    // Never load analytics on authentication pages or when DNT/GPC is active or without consent
+    if (prefs.analytics && !isDnt && !isAuthPage) {
+      if (!existingAnalyticsScript) {
+        const script = document.createElement('script');
+        script.id = analyticsScriptId;
+        script.src = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+        script.defer = true;
+        document.head.appendChild(script);
+      }
+    } else if (existingAnalyticsScript) {
+      existingAnalyticsScript.remove();
+    }
+
+    // 2. Advertising Script (ad-client.js)
+    const adScriptId = 'devtools-ad-script';
+    const existingAdScript = document.getElementById(adScriptId);
+
+    if (prefs.advertising && !isDnt) {
+      if (!existingAdScript) {
+        const script = document.createElement('script');
+        script.id = adScriptId;
+        script.src = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js';
+        script.defer = true;
+        document.head.appendChild(script);
+      }
+    } else if (existingAdScript) {
+      existingAdScript.remove();
+    }
+
+    // Broadcast consent event for ad slots and listeners
+    window.dispatchEvent(
+      new CustomEvent('privacy-consent-changed', {
+        detail: { ...prefs, isDnt, isAuthPage },
+      })
+    );
+  };
+
+  useEffect(() => {
+    const isDnt = checkDnt();
+    setDntDetected(isDnt);
+
+    let initialPrefs: ConsentPreferences = {
+      necessary: true,
+      analytics: false,
+      advertising: false,
+      timestamp: new Date().toISOString(),
+      userChoiceMade: false,
+    };
+
+    const stored = localStorage.getItem(STORAGE_KEY);
+    if (stored) {
+      try {
+        const parsed = JSON.parse(stored);
+        initialPrefs = {
+          ...parsed,
+          necessary: true,
+          // If DNT is detected, enforce opt-out for tracking
+          analytics: isDnt ? false : !!parsed.analytics,
+          advertising: isDnt ? false : !!parsed.advertising,
+          userChoiceMade: true,
+        };
+      } catch (e) {
+        // Fallback to default
+      }
+    } else if (isDnt) {
+      // Respect DNT/GPC signal automatically
+      initialPrefs.userChoiceMade = true;
+      initialPrefs.analytics = false;
+      initialPrefs.advertising = false;
+    }
+
+    setPreferences(initialPrefs);
+    if (!initialPrefs.userChoiceMade && !isDnt) {
+      setShowBanner(true);
+    }
+
+    applyThirdPartyScripts(initialPrefs);
+
+    // Listen for footer or in-page triggers to open preferences modal
+    const handleOpenModal = () => setShowModal(true);
+    window.addEventListener('open-privacy-preferences', handleOpenModal);
+
+    const footerTrigger = document.getElementById('open-privacy-preferences');
+    if (footerTrigger) {
+      footerTrigger.addEventListener('click', handleOpenModal);
+    }
+
+    const policyTrigger = document.getElementById('privacy-policy-open-prefs');
+    if (policyTrigger) {
+      policyTrigger.addEventListener('click', handleOpenModal);
+    }
+
+    // Astro View Transitions: re-evaluate script policy on page transition
+    const handlePageLoad = () => {
+      const currentStored = localStorage.getItem(STORAGE_KEY);
+      let currentPrefs = initialPrefs;
+      if (currentStored) {
+        try {
+          currentPrefs = JSON.parse(currentStored);
+        } catch (e) {}
+      }
+      applyThirdPartyScripts(currentPrefs);
+
+      // Re-attach triggers if DOM replaced
+      const ft = document.getElementById('open-privacy-preferences');
+      if (ft) ft.addEventListener('click', handleOpenModal);
+      const pt = document.getElementById('privacy-policy-open-prefs');
+      if (pt) pt.addEventListener('click', handleOpenModal);
+    };
+
+    document.addEventListener('astro:page-load', handlePageLoad);
+
+    return () => {
+      window.removeEventListener('open-privacy-preferences', handleOpenModal);
+      document.removeEventListener('astro:page-load', handlePageLoad);
+      if (footerTrigger) footerTrigger.removeEventListener('click', handleOpenModal);
+      if (policyTrigger) policyTrigger.removeEventListener('click', handleOpenModal);
+    };
+  }, []);
+
+  const savePreferences = (newPrefs: ConsentPreferences) => {
+    const updated = {
+      ...newPrefs,
+      necessary: true,
+      userChoiceMade: true,
+      timestamp: new Date().toISOString(),
+    };
+    setPreferences(updated);
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+    applyThirdPartyScripts(updated);
+    setShowBanner(false);
+    setShowModal(false);
+  };
+
+  const handleAcceptAll = () => {
+    savePreferences({
+      necessary: true,
+      analytics: !dntDetected,
+      advertising: !dntDetected,
+      timestamp: new Date().toISOString(),
+      userChoiceMade: true,
+    });
+  };
+
+  const handleRejectAll = () => {
+    savePreferences({
+      necessary: true,
+      analytics: false,
+      advertising: false,
+      timestamp: new Date().toISOString(),
+      userChoiceMade: true,
+    });
+  };
+
+  return (
+    <>
+      {/* Cookie & Privacy Consent Banner */}
+      {showBanner && (
+        <div
+          role="region"
+          aria-label="Privacy and Cookie Consent"
+          className="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-300 shadow-xl p-4 md:p-6"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
+            <div className="text-sm text-gray-700 max-w-3xl">
+              <p className="font-semibold text-gray-900 mb-1 flex items-center gap-1.5">
+                <span>🛡️</span> Privacy by Design & User Transparency
+              </p>
+              <p>
+                The DevTools Times respects your right to privacy and practices data minimization.
+                We only use essential cookies to maintain your session and reading list. Non-essential
+                third-party scripts (analytics and sponsor advertisements) are disabled by default
+                and only run with your explicit consent. Authentication pages are never tracked.
+              </p>
+            </div>
+            <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={handleRejectAll}
+                className="flex-1 md:flex-none px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-md shadow-sm transition-colors"
+              >
+                Reject Non-Essential
+              </button>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={() => setShowModal(true)}
+                className="flex-1 md:flex-none px-4 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 rounded-md shadow-sm transition-colors"
+              >
+                Customize
+              </button>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={handleAcceptAll}
+                className="flex-1 md:flex-none px-4 py-2 text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 rounded-md shadow-sm transition-colors"
+              >
+                Accept All
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+
+      {/* Privacy Preferences Modal */}
+      {showModal && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
+        >
+          <div className="bg-white rounded-lg shadow-2xl max-w-xl w-full p-6 max-h-[90vh] overflow-y-auto">
+            <div className="flex justify-between items-center pb-4 border-b border-gray-200">
+              <h3 id="privacy-modal-title" className="text-xl font-bold text-gray-900">
+                Manage Privacy Preferences
+              </h3>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={() => setShowModal(false)}
+                className="text-gray-400 hover:text-gray-600 text-2xl font-bold leading-none p-1"
+                aria-label="Close modal"
+              >
+                &times;
+              </button>
+            </div>
+
+            {dntDetected && (
+              <div className="my-4 p-3 bg-blue-50 border border-blue-200 rounded-md text-xs text-blue-800">
+                <strong>Signal Detected:</strong> Your browser has sent a Global Privacy Control (GPC) or
+                Do Not Track (DNT) signal. Non-essential tracking scripts are automatically disabled.
+              </div>
+            )}
+
+            <div className="py-4 space-y-6">
+              {/* Category 1: Strictly Necessary */}
+              <div className="flex items-start justify-between gap-4">
+                <div>
+                  <h4 className="text-sm font-semibold text-gray-900">
+                    Strictly Necessary (Always Active)
+                  </h4>
+                  <p className="text-xs text-gray-600 mt-1">
+                    Essential for website security, user authentication, and maintaining your local reading list.
+                    These do not track your behavior across websites and cannot be disabled.
+                  </p>
+                </div>
+                <span className="text-xs font-semibold px-2.5 py-1 bg-gray-200 text-gray-700 rounded whitespace-nowrap">
+                  Required
+                </span>
+              </div>
+
+              {/* Category 2: Analytics Scripts */}
+              <div className="flex items-start justify-between gap-4 pt-4 border-t border-gray-100">
+                <div>
+                  <h4 className="text-sm font-semibold text-gray-900">
+                    Performance & Analytics Scripts
+                  </h4>
+                  <p className="text-xs text-gray-600 mt-1">
+                    Loads <code className="bg-gray-100 px-1 py-0.5 rounded text-gray-800">analytics-client.js</code> to measure anonymous readership engagement.
+                    In accordance with data minimization, authentication forms (/signin and /signup) and sensitive actions are never tracked.
+                  </p>
+                </div>
+                <label className="relative inline-flex items-center cursor-pointer">
+                  <input
+                    type="checkbox"
+                    checked={preferences.analytics && !dntDetected}
+                    disabled={dntDetected}
+                    onChange={(e) =>
+                      setPreferences({
+                        ...preferences,
+                        analytics: e.target.checked,
+                      })
+                    }
+                    className="sr-only peer"
+                  />
+                  <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900 peer-disabled:opacity-50"></div>
+                </label>
+              </div>
+
+              {/* Category 3: Advertising Scripts */}
+              <div className="flex items-start justify-between gap-4 pt-4 border-t border-gray-100">
+                <div>
+                  <h4 className="text-sm font-semibold text-gray-900">
+                    Sponsor & Advertising Scripts
+                  </h4>
+                  <p className="text-xs text-gray-600 mt-1">
+                    Loads <code className="bg-gray-100 px-1 py-0.5 rounded text-gray-800">ad-client.js</code> to populate designated sponsor banner slots.
+                    No personal data is sold or shared with external data brokers.
+                  </p>
+                </div>
+                <label className="relative inline-flex items-center cursor-pointer">
+                  <input
+                    type="checkbox"
+                    checked={preferences.advertising && !dntDetected}
+                    disabled={dntDetected}
+                    onChange={(e) =>
+                      setPreferences({
+                        ...preferences,
+                        advertising: e.target.checked,
+                      })
+                    }
+                    className="sr-only peer"
+                  />
+                  <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900 peer-disabled:opacity-50"></div>
+                </label>
+              </div>
+            </div>
+
+            <div className="pt-4 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center gap-3">
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={handleRejectAll}
+                className="w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors"
+              >
+                Reject All
+              </button>
+              <div className="flex gap-2 w-full sm:w-auto">
+                <button
+                  type="button"
+                  data-skip-tracking="true"
+                  onClick={handleAcceptAll}
+                  className="flex-1 sm:flex-none px-4 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 rounded-md transition-colors"
+                >
+                  Accept All
+                </button>
+                <button
+                  type="button"
+                  data-skip-tracking="true"
+                  onClick={() => savePreferences(preferences)}
+                  className="flex-1 sm:flex-none px-4 py-2 text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 rounded-md transition-colors"
+                >
+                  Save Choices
+                </button>
+              </div>
+            </div>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
