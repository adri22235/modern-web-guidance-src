+/**
+ * The Daily Grind - Privacy by Design Suite (privacy.js)
+ *
+ * Implements client-side Privacy by Design principles:
+ * 1. Global Privacy Control (GPC) and Do Not Track (DNT) detection & enforcement
+ * 2. Privacy as Default - Opt-in consent management with TTL expiration
+ * 3. Data Minimization - Strips URL trackers (utm, gclid, fbclid), sanitizes form inputs
+ * 4. Secure Data Handling - In-memory and secure storage, automatic TTL purge
+ * 5. Data Subject Rights - Right to access (Export JSON) & Right to be Forgotten (Purge)
+ * 6. Secure Logout - Clears local/session storage, cookies, and invokes Clear-Site-Data
+ * 7. Third-Party Audit - Real-time DOM & network audit of third-party domains
+ */
+
+'use strict';
+
+(function (window, document) {
+  // Storage Keys & Constants
+  const STORAGE_KEYS = {
+    CONSENT: 'dg_privacy_consent_v1',
+    AUDIT_LOG: 'dg_third_party_audit_log'
+  };
+
+  const CONSENT_TTL_DAYS = 180; // Valid for 6 months
+  const APPROVED_ORIGINS = [
+    window.location.origin,
+    'https://images.unsplash.com'
+  ];
+
+  // Tracking query parameters to strip automatically from URLs (Data Minimization)
+  const TRACKING_PARAMS = [
+    'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
+    'fbclid', 'gclid', 'msclkid', 'mc_eid', 'dclid', 'yclid', '_hsenc', '_hsmi'
+  ];
+
+  /**
+   * Detect Global Privacy Control (GPC) and Do Not Track (DNT) signals.
+   * Privacy by Default: If present, non-essential tracking is strictly disabled.
+   */
+  function detectGPC() {
+    return Boolean(
+      navigator.globalPrivacyControl === true ||
+      navigator.doNotTrack === '1' ||
+      window.doNotTrack === '1' ||
+      navigator.msDoNotTrack === '1'
+    );
+  }
+
