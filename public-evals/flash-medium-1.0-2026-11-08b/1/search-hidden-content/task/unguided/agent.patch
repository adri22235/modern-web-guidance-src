+  <script>
+    (function () {
+      // Coupon Reveal Functionality
+      const revealCouponBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (couponPanel) {
+          couponPanel.removeAttribute('hidden');
+        }
+        if (revealCouponBtn) {
+          revealCouponBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (revealCouponBtn) {
+        revealCouponBtn.addEventListener('click', revealCoupon);
+      }
+
+      if (couponPanel) {
+        couponPanel.addEventListener('beforematch', revealCoupon);
+      }
+
+      // Mutually Exclusive Wholesale and Catering Tabs
+      const wholesaleTab = document.getElementById('wholesale-tab');
+      const cateringTab = document.getElementById('catering-tab');
+      const wholesalePanel = document.getElementById('wholesale-panel');
+      const cateringPanel = document.getElementById('catering-panel');
+
+      function activateTab(tabName) {
+        if (tabName === 'wholesale') {
+          if (wholesalePanel) wholesalePanel.removeAttribute('hidden');
+          if (cateringPanel) cateringPanel.setAttribute('hidden', 'until-found');
+
+          if (wholesaleTab) {
+            wholesaleTab.setAttribute('aria-selected', 'true');
+            wholesaleTab.classList.add('active');
+          }
+          if (cateringTab) {
+            cateringTab.setAttribute('aria-selected', 'false');
+            cateringTab.classList.remove('active');
+          }
+        } else if (tabName === 'catering') {
+          if (cateringPanel) cateringPanel.removeAttribute('hidden');
+          if (wholesalePanel) wholesalePanel.setAttribute('hidden', 'until-found');
+
+          if (cateringTab) {
+            cateringTab.setAttribute('aria-selected', 'true');
+            cateringTab.classList.add('active');
+          }
+          if (wholesaleTab) {
+            wholesaleTab.setAttribute('aria-selected', 'false');
+            wholesaleTab.classList.remove('active');
+          }
+        }
+      }
+
+      if (wholesaleTab) {
+        wholesaleTab.addEventListener('click', function () {
+          activateTab('wholesale');
+        });
+      }
+
+      if (cateringTab) {
+        cateringTab.addEventListener('click', function () {
+          activateTab('catering');
+        });
+      }
+
+      // Listen for beforematch so find-in-page switches tabs automatically
+      if (wholesalePanel) {
+        wholesalePanel.addEventListener('beforematch', function () {
+          activateTab('wholesale');
+        });
+      }
+
+      if (cateringPanel) {
+        cateringPanel.addEventListener('beforematch', function () {
+          activateTab('catering');
+        });
+      }
+
+      // Keyboard accessibility (Arrow keys to switch tabs)
+      const tabs = [wholesaleTab, cateringTab].filter(Boolean);
+      tabs.forEach(function (tab) {
+        tab.addEventListener('keydown', function (e) {
+          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
+            e.preventDefault();
+            const targetTab = tab === wholesaleTab ? cateringTab : wholesaleTab;
+            const targetName = targetTab === wholesaleTab ? 'wholesale' : 'catering';
+            targetTab.focus();
+            activateTab(targetName);
+          }
+        });
+      });
+    })();
+  </script>
+
