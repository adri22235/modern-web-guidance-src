+  <script>
+    function initTabsAndCoupon() {
+      const tabList = document.querySelector('[role="tablist"]');
+      const tabs = document.querySelectorAll('.wholesale-tab');
+      const panels = document.querySelectorAll('.tab-panels > [role="tabpanel"]');
+
+      function selectTab(selectedTab) {
+        tabs.forEach(tab => {
+          const isSelected = (tab === selectedTab);
+          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+          tab.toggleAttribute('focusgroupstart', isSelected);
+        });
+
+        panels.forEach(panel => {
+          const isMatched = panel.getAttribute('aria-labelledby') === selectedTab.id;
+          if (isMatched) {
+            panel.removeAttribute('hidden');
+            panel.setAttribute('tabindex', '0');
+          } else {
+            panel.hidden = 'until-found';
+            panel.removeAttribute('tabindex');
+          }
+        });
+      }
+
+      tabs.forEach(tab => {
+        tab.addEventListener('click', () => {
+          selectTab(tab);
+        });
+      });
+
+      if (tabList) {
+        tabList.addEventListener('keydown', (e) => {
+          const targetTab = e.target.closest('[role="tab"]');
+          if (!targetTab) return;
+          const tabArray = Array.from(tabs);
+          const index = tabArray.indexOf(targetTab);
+          let newIndex = -1;
+          if (e.key === 'ArrowRight') {
+            newIndex = (index + 1) % tabArray.length;
+          } else if (e.key === 'ArrowLeft') {
+            newIndex = (index - 1 + tabArray.length) % tabArray.length;
+          } else if (e.key === 'Home') {
+            newIndex = 0;
+          } else if (e.key === 'End') {
+            newIndex = tabArray.length - 1;
+          }
+          if (newIndex !== -1) {
+            e.preventDefault();
+            tabArray[newIndex].focus();
+            selectTab(tabArray[newIndex]);
+          }
+        });
+      }
+
+      const tabPanelsContainer = document.querySelector('.tab-panels');
+      if (tabPanelsContainer) {
+        tabPanelsContainer.addEventListener('beforematch', (e) => {
+          const matchedPanel = e.target.closest('[role="tabpanel"]');
+          if (matchedPanel) {
+            const tabId = matchedPanel.getAttribute('aria-labelledby');
+            const associatedTab = document.getElementById(tabId);
+            if (associatedTab) {
+              selectTab(associatedTab);
+            }
+          }
+        });
+      }
+
+      const revealCouponBtn = document.getElementById('reveal-coupon');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (couponPanel) {
+          couponPanel.removeAttribute('hidden');
+        }
+        if (revealCouponBtn) {
+          revealCouponBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (revealCouponBtn) {
+        revealCouponBtn.addEventListener('click', revealCoupon);
+      }
+
+      if (couponPanel) {
+        couponPanel.addEventListener('beforematch', revealCoupon);
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initTabsAndCoupon);
+    } else {
+      initTabsAndCoupon();
+    }
+  </script>
+
 </body>
 
