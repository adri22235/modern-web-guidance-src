+  <script type="module">
+    // INP Optimization & Main-Thread Cooperative Scheduling
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        return await window.scheduler.yield();
+      }
+      return new Promise(resolve => setTimeout(resolve, 0));
+    }
+
+    // Attach non-blocking interaction listeners to ensure responsive input handling
+    document.addEventListener('pointerdown', async (event) => {
+      const interactiveEl = event.target.closest('a, button, .btn');
+      if (!interactiveEl) return;
+      // Yield control back to the browser immediately so presentation is never delayed
+      await yieldToMain();
+    }, { passive: true });
+
+    // Performance & Core Web Vitals Telemetry Observer
+    if ('PerformanceObserver' in window) {
+      try {
+        // Observe LCP
+        if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
+          const lcpObserver = new PerformanceObserver((entryList) => {
+            const entries = entryList.getEntries();
+            const lastEntry = entries[entries.length - 1];
+            window.__LCP = lastEntry.startTime;
+          });
+          lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
+        }
+
+        // Observe CLS
+        if (PerformanceObserver.supportedEntryTypes?.includes('layout-shift')) {
+          let clsValue = 0;
+          const clsObserver = new PerformanceObserver((entryList) => {
+            for (const entry of entryList.getEntries()) {
+              if (!entry.hadRecentInput) {
+                clsValue += entry.value;
+                window.__CLS = clsValue;
+              }
+            }
+          });
+          clsObserver.observe({ type: 'layout-shift', buffered: true });
+        }
+
+        // Observe INP via Event Timing
+        if (PerformanceObserver.supportedEntryTypes?.includes('event')) {
+          let maxDuration = 0;
+          const inpObserver = new PerformanceObserver((entryList) => {
+            for (const entry of entryList.getEntries()) {
+              if (entry.interactionId && entry.duration > maxDuration) {
+                maxDuration = entry.duration;
+                window.__INP = maxDuration;
+              }
+            }
+          });
+          inpObserver.observe({ type: 'event', buffered: true, durationThreshold: 16 });
+        }
+
+        // Observe modern interaction-contentful-paint if supported
+        if (PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint')) {
+          const icpObserver = new PerformanceObserver((entryList) => {
+            for (const entry of entryList.getEntries()) {
+              window.__ICP = entry.duration;
+            }
+          });
+          icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+        }
+      } catch (err) {
+        // Gracefully ignore telemetry observation errors
+      }
+    }
+  </script>
