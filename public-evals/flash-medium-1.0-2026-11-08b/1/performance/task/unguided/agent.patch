diff --git a/audit.js b/audit.js
new file mode 100644
--- a/audit.js
+++ b/audit.js
@@ -0,0 +1,129 @@
+#!/usr/bin/env node
+
+const fs = require('fs');
+const path = require('path');
+
+console.log('====================================================');
+console.log(' DAILY GRIND - WEB PERFORMANCE & CORE WEB VITALS AUDIT');
+console.log('====================================================\n');
+
+const indexPath = path.join(__dirname, 'index.html');
+const swPath = path.join(__dirname, 'sw.js');
+
+if (!fs.existsSync(indexPath)) {
+  console.error('❌ index.html not found!');
+  process.exit(1);
+}
+
+const html = fs.readFileSync(indexPath, 'utf-8');
+const sw = fs.existsSync(swPath) ? fs.readFileSync(swPath, 'utf-8') : '';
+
+let passedChecks = 0;
+let totalChecks = 0;
+
+function check(title, condition, detail = '') {
+  totalChecks++;
+  if (condition) {
+    passedChecks++;
+    console.log(`  ✅ [PASS] ${title}`);
+    if (detail) console.log(`     ↳ ${detail}`);
+  } else {
+    console.log(`  ❌ [FAIL] ${title}`);
+    if (detail) console.log(`     ↳ ${detail}`);
+  }
+}
+
+console.log('1. Largest Contentful Paint (LCP) Optimizations:');
+check('Preconnect to external image origin',
+  html.includes('rel="preconnect"') && html.includes('images.unsplash.com'),
+  'Establishes early TLS/TCP connection saving 100-300ms handshake time');
+
+check('Hero LCP image preloaded in <head>',
+  html.includes('rel="preload"') && html.includes('as="image"') && html.includes('fetchpriority="high"'),
+  'Preload scanner dispatches LCP image fetch immediately without waiting for CSS parsing');
+
+check('Responsive imagesrcset in preload link',
+  html.includes('imagesrcset=') && html.includes('imagesizes='),
+  'Serves appropriately sized responsive image candidates (640w/1024w/1440w)');
+
+check('Hero image element uses fetchpriority="high"',
+  html.includes('class="hero-img"') && html.includes('fetchpriority="high"'),
+  'Gives browser explicit instruction to prioritize LCP element bandwidth');
+
+check('Modern WebP/AVIF format offered via <picture>',
+  html.includes('<picture') && html.includes('type="image/webp"'),
+  'Reduces image payload size by 30-50% over legacy formats');
+
+console.log('\n2. Cumulative Layout Shift (CLS) Optimizations:');
+check('Explicit width and height on all <img> elements',
+  (() => {
+    const imgMatches = html.match(/<img[^>]+>/g) || [];
+    return imgMatches.length > 0 && imgMatches.every(tag => tag.includes('width=') && tag.includes('height='));
+  })(),
+  'Guarantees browser reserves layout dimensions before image bytes load');
+
+check('Hero section dimension stability (clamp/contain)',
+  html.includes('height: clamp(') && html.includes('contain: layout'),
+  'Prevents dynamic mobile address bar height jitter and recalculations');
+
+check('Image containers define aspect-ratio / skeleton background',
+  html.includes('aspect-ratio: 16 / 10') && html.includes('background-color: #ebdcd5'),
+  'Maintains constant aspect ratio container with fallback skeleton');
+
+check('Zero-CLS system font stack',
+  html.includes('font-family: system-ui') || html.includes('-apple-system'),
+  'Avoids Flash of Unstyled/Invisible Text (FOUT/FOIT) shifts entirely');
+
+console.log('\n3. Interaction to Next Paint (INP) & Interactivity:');
+check('Eliminate 300ms mobile tap delay (touch-action: manipulation)',
+  html.includes('touch-action: manipulation'),
+  'Removes delay waiting for double-tap gestures on mobile devices');
+
+check('Fast visual feedback (:active state scaling)',
+  html.includes('.btn:active') && html.includes('transform: scale('),
+  'Provides instant sub-16ms tactile response to user click/tap');
+
+check('Responsive accessible mobile navigation menu',
+  html.includes('aria-expanded') && html.includes('nav-toggle'),
+  'Keyboard and screen-reader accessible with GPU-accelerated transition');
+
+check('Interactive quick-view & order customization modal',
+  html.includes('<dialog id="order-dialog"') && html.includes('showModal'),
+  'Native <dialog> element provides hardware-accelerated, accessible UI');
+
+check('Event listeners use passive: true',
+  html.includes('{ passive: true }'),
+  'Prevents scrolling and touch handling from blocking main thread frames');
+
+console.log('\n4. Rendering, Runtime & Caching Optimizations:');
+check('CSS content-visibility applied to below-the-fold content',
+  html.includes('content-visibility: auto') && html.includes('contain-intrinsic-size'),
+  'Skips off-screen layout and paint passes during initial render');
+
+check('Speculation Rules API for sub-second page transitions',
+  html.includes('type="speculationrules"') && html.includes('prefetch'),
+  'Speculatively prefetches high-probability next pages');
+
+check('Hover link prefetcher for instant clicks',
+  (html.includes("link.rel = 'prefetch'") || html.includes('rel="prefetch"')) && html.includes('mouseover'),
+  'Prefetches target pages during hover latency');
+
+check('Service Worker (PWA caching layer) configured',
+  fs.existsSync(swPath) && sw.includes('daily-grind-v1') && sw.includes('caches.open'),
+  'Enables sub-10ms repeat visits and offline availability');
+
+check('Core Web Vitals Real-User Monitoring (RUM) Telemetry',
+  html.includes('__perfMetrics') && html.includes('PerformanceObserver') && html.includes('largest-contentful-paint'),
+  'Tracks LCP, FID/INP, CLS, FCP, TTFB dynamically');
+
+console.log('\n====================================================');
+console.log(` AUDIT SUMMARY: ${passedChecks}/${totalChecks} CHECKS PASSED (${Math.round((passedChecks / totalChecks) * 100)}%)`);
+console.log('====================================================\n');
+
+if (passedChecks === totalChecks) {
+  console.log('🎉 EXCELLENT: All Core Web Vitals & performance optimization criteria satisfied!');
+  process.exit(0);
+} else {
+  console.error('⚠️ Some checks failed. Please review the output above.');
+  process.exit(1);
+}
