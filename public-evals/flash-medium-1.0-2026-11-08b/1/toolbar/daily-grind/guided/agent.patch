+  <script>
+    // View Layout Switching (Grid vs List)
+    const btnGrid = document.getElementById('btn-view-grid');
+    const btnList = document.getElementById('btn-view-list');
+    const favoritesList = document.getElementById('favorites-list');
+
+    if (btnGrid && btnList && favoritesList) {
+      btnGrid.addEventListener('click', () => {
+        btnGrid.setAttribute('aria-pressed', 'true');
+        btnList.setAttribute('aria-pressed', 'false');
+        favoritesList.classList.remove('list-view');
+      });
+
+      btnList.addEventListener('click', () => {
+        btnGrid.setAttribute('aria-pressed', 'false');
+        btnList.setAttribute('aria-pressed', 'true');
+        favoritesList.classList.add('list-view');
+      });
+    }
+
+    // Toggle Drink Details
+    const btnDetails = document.getElementById('btn-toggle-details');
+    if (btnDetails && favoritesList) {
+      btnDetails.addEventListener('click', () => {
+        const isPressed = btnDetails.getAttribute('aria-pressed') === 'true';
+        btnDetails.setAttribute('aria-pressed', String(!isPressed));
+        favoritesList.classList.toggle('details-hidden', isPressed);
+      });
+    }
+
+    // Toggle Filters Panel
+    const btnFilters = document.getElementById('btn-toggle-filters');
+    const filtersBar = document.getElementById('favorites-filters');
+    if (btnFilters && filtersBar) {
+      btnFilters.addEventListener('click', () => {
+        const isPressed = btnFilters.getAttribute('aria-pressed') === 'true';
+        btnFilters.setAttribute('aria-pressed', String(!isPressed));
+        filtersBar.hidden = isPressed;
+        if (isPressed) {
+          // Reset to show all when closing filters
+          document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
+          document.querySelector('.filter-chip[data-filter="all"]')?.classList.add('active');
+          document.querySelectorAll('#favorites-list .card').forEach(c => (c.style.display = ''));
+        }
+      });
+    }
+
+    // Filter Chips
+    document.querySelectorAll('.filter-chip').forEach(chip => {
+      chip.addEventListener('click', () => {
+        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
+        chip.classList.add('active');
+        const filter = chip.getAttribute('data-filter');
+        document.querySelectorAll('#favorites-list .card').forEach(card => {
+          const categories = card.getAttribute('data-category') || '';
+          if (filter === 'all' || categories.includes(filter)) {
+            card.style.display = '';
+          } else {
+            card.style.display = 'none';
+          }
+        });
+      });
+    });
+
+    // Copy Featured Drinks List
+    let lastCopyMessage = '';
+    const copyTimers = new WeakMap();
+
+    function reportCopy(button, ok) {
+      const tip = button.parentElement.querySelector('.copy-tip');
+      if (!tip) return;
+      clearTimeout(copyTimers.get(button));
+      button.removeAttribute('data-copied');
+      button.removeAttribute('data-failed');
+      let message = ok ? 'Copied' : 'Copy failed';
+      if (message === lastCopyMessage) message += '\u00A0';
+      lastCopyMessage = message;
+      tip.textContent = '';
+      void button.offsetWidth;
+      button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+      requestAnimationFrame(() => {
+        tip.textContent = message;
+      });
+      copyTimers.set(button, setTimeout(() => {
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.textContent = '';
+      }, 2000));
+    }
+
+    function getFeaturedDrinksText() {
+      const cards = document.querySelectorAll('#favorites-list .card');
+      const lines = [];
+      cards.forEach(card => {
+        if (card.style.display === 'none') return;
+        const title = card.querySelector('h3')?.textContent.trim() || '';
+        const desc = card.querySelector('.card-details')?.textContent.trim() || '';
+        if (title) {
+          lines.push(desc ? `${title} - ${desc}` : title);
+        }
+      });
+      return lines.join('\n');
+    }
+
+    function fallbackCopy(text) {
+      const field = Object.assign(document.createElement('textarea'), { value: text });
+      field.setAttribute('readonly', '');
+      field.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none;';
+      document.body.append(field);
+      field.select();
+      try {
+        return document.execCommand('copy');
+      } catch {
+        return false;
+      } finally {
+        field.remove();
+      }
+    }
+
+    async function handleCopy(button) {
+      const text = getFeaturedDrinksText();
+      if (!text) return;
+      try {
+        if (navigator.clipboard && window.isSecureContext) {
+          await navigator.clipboard.writeText(text);
+          reportCopy(button, true);
+        } else {
+          fallbackCopy(text) ? reportCopy(button, true) : reportCopy(button, false);
+        }
+      } catch {
+        fallbackCopy(text) ? reportCopy(button, true) : reportCopy(button, false);
+      }
+    }
+
+    // Invoker Command event listener
+    document.addEventListener('command', (event) => {
+      if (event.command === '--copy' && event.source?.id === 'btn-copy-drinks') {
+        handleCopy(event.source);
+      }
+    }, true);
+
+    // Fallback click listener for browsers without Invoker Commands
+    if (!('CommandEvent' in window)) {
+      document.getElementById('btn-copy-drinks')?.addEventListener('click', (e) => {
+        handleCopy(e.currentTarget);
+      });
+    }
+
+    // Toolbar keyboard navigation fallback for browsers without native focusgroup
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      const toolbar = document.getElementById('favorites-actions');
+      if (toolbar) {
+        const items = Array.from(toolbar.querySelectorAll('button'));
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        toolbar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        toolbar.addEventListener('keydown', (e) => {
+          const activeIdx = items.indexOf(document.activeElement);
+          if (activeIdx === -1) return;
+          let nextIdx = activeIdx;
+          if (e.key === 'ArrowRight') {
+            nextIdx = (activeIdx + 1) % items.length;
+          } else if (e.key === 'ArrowLeft') {
+            nextIdx = (activeIdx - 1 + items.length) % items.length;
+          } else if (e.key === 'Home') {
+            nextIdx = 0;
+          } else if (e.key === 'End') {
+            nextIdx = items.length - 1;
+          } else {
+            return;
+          }
+          e.preventDefault();
+          items[nextIdx].focus();
+        });
+      }
+    }
+
+    // Upgrade baseline title tooltips to interest invokers when supported
+    if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+      document.querySelectorAll('#favorites-actions button[title]').forEach((b, i) => {
+        const tip = Object.assign(document.createElement('div'), { id: `fav-tip-${i}`, textContent: b.title });
+        tip.popover = 'hint';
+        tip.className = 'toolbar-popover-tip';
+        b.setAttribute('interestfor', tip.id);
+        b.removeAttribute('title');
+        document.body.append(tip);
+      });
+    }
+  </script>
