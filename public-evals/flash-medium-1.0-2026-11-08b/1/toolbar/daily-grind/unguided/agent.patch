+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const drinksContainer = document.getElementById('drinks-container');
+      const btnGridView = document.getElementById('btn-grid-view');
+      const btnListView = document.getElementById('btn-list-view');
+      const btnToggleDetails = document.getElementById('btn-toggle-details');
+      const btnToggleFilters = document.getElementById('btn-toggle-filters');
+      const btnCopyDrinks = document.getElementById('btn-copy-drinks');
+      const filtersBar = document.getElementById('favorites-filters');
+      const filterChips = document.querySelectorAll('.filter-chip');
+      const cards = document.querySelectorAll('#drinks-container .card');
+
+      // Grid / List view toggle
+      btnGridView?.addEventListener('click', () => {
+        drinksContainer.classList.remove('list-view');
+        btnGridView.classList.add('active');
+        btnGridView.setAttribute('aria-pressed', 'true');
+        btnListView.classList.remove('active');
+        btnListView.setAttribute('aria-pressed', 'false');
+      });
+
+      btnListView?.addEventListener('click', () => {
+        drinksContainer.classList.add('list-view');
+        btnListView.classList.add('active');
+        btnListView.setAttribute('aria-pressed', 'true');
+        btnGridView.classList.remove('active');
+        btnGridView.setAttribute('aria-pressed', 'false');
+      });
+
+      // Toggle details
+      btnToggleDetails?.addEventListener('click', () => {
+        const isHidden = drinksContainer.classList.toggle('hide-details');
+        const isDetailsOn = !isHidden;
+        btnToggleDetails.classList.toggle('active', isDetailsOn);
+        btnToggleDetails.setAttribute('aria-pressed', isDetailsOn.toString());
+      });
+
+      // Toggle filters
+      btnToggleFilters?.addEventListener('click', () => {
+        const isVisible = filtersBar.style.display !== 'none';
+        if (isVisible) {
+          filtersBar.style.display = 'none';
+          btnToggleFilters.classList.remove('active');
+          btnToggleFilters.setAttribute('aria-pressed', 'false');
+        } else {
+          filtersBar.style.display = 'flex';
+          btnToggleFilters.classList.add('active');
+          btnToggleFilters.setAttribute('aria-pressed', 'true');
+        }
+      });
+
+      // Filter chips handling
+      filterChips.forEach(chip => {
+        chip.addEventListener('click', () => {
+          filterChips.forEach(c => c.classList.remove('active'));
+          chip.classList.add('active');
+          const filter = chip.getAttribute('data-filter');
+
+          cards.forEach(card => {
+            const categories = card.getAttribute('data-category')?.split(' ') || [];
+            if (filter === 'all' || categories.includes(filter)) {
+              card.style.display = '';
+            } else {
+              card.style.display = 'none';
+            }
+          });
+        });
+      });
+
+      // Copy drinks list
+      btnCopyDrinks?.addEventListener('click', async () => {
+        const drinksList = Array.from(cards)
+          .map(card => {
+            const title = card.querySelector('h3')?.textContent.trim();
+            const desc = card.querySelector('p')?.textContent.trim();
+            return `• ${title}: ${desc}`;
+          })
+          .join('\n');
+
+        const copyText = `The Daily Grind - Seasonal Favorites:\n${drinksList}`;
+
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(copyText);
+          } else {
+            const textarea = document.createElement('textarea');
+            textarea.value = copyText;
+            textarea.style.position = 'fixed';
+            textarea.style.opacity = '0';
+            document.body.appendChild(textarea);
+            textarea.select();
+            document.execCommand('copy');
+            document.body.removeChild(textarea);
+          }
+          showToast('Featured drinks list copied to clipboard!');
+        } catch (err) {
+          showToast('Failed to copy drinks list');
+        }
+      });
+
+      function showToast(message) {
+        let toast = document.getElementById('toast-notification');
+        if (!toast) {
+          toast = document.createElement('div');
+          toast.id = 'toast-notification';
+          toast.className = 'toast';
+          document.body.appendChild(toast);
+        }
+        toast.textContent = message;
+        toast.classList.add('show');
+        setTimeout(() => {
+          toast.classList.remove('show');
+        }, 2500);
+      }
+    });
+  </script>
+
 </body>
 
