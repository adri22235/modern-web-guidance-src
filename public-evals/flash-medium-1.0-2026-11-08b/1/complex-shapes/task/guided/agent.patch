+      pointer-events: none;
+      contain: layout paint;
+      z-index: 1;
+      opacity: 0.9;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+
+      /* MANDATORY: Use vendor prefix for wider support in older browsers */
+      -webkit-mask-image: url(#organic-silhouette);
+      -webkit-mask-size: 100% 100%;
+      -webkit-mask-repeat: no-repeat;
+
+      /* Standard property for modern browsers */
+      mask-image: url(#organic-silhouette);
+      mask-size: 100% 100%;
+      mask-repeat: no-repeat;
+
+      /* Complementary clip-path using matching objectBoundingBox units */
+      clip-path: url(#organic-silhouette-clip);
+    }
+
+    /* Fallback for browsers that do not support masking */
+    @supports (not (mask-image: url(x))) and (not (-webkit-mask-image: url(x))) {
+      .shaped-element {
+        clip-path: inset(5% round 15px);
+      }
+    }
+
+    @media (max-width: 768px) {
+      .shaped-element {
+        right: 50%;
+        transform: translate(50%, -50%);
+        opacity: 0.25;
+        z-index: 0;
+      }
+    }
