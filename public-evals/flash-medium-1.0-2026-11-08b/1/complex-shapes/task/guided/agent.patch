+    .shaped-element {
+      position: absolute;
+      top: 50%;
+      right: 8%;
+      transform: translateY(-50%);
+      width: clamp(160px, 22vw, 280px);
+      aspect-ratio: 1 / 1;
+      background: linear-gradient(135deg, rgba(255, 171, 64, 0.85), rgba(78, 52, 46, 0.75)),
