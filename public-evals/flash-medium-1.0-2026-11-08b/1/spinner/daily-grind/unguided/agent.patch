+  <script>
+    (function () {
+      'use strict';
+
+      // Accessible screen reader announcer
+      function announce(message) {
+        const liveRegion = document.getElementById('live-announcer');
+        if (liveRegion) {
+          liveRegion.textContent = '';
+          // Ensure state change triggers screen reader notification
+          setTimeout(function () {
+            liveRegion.textContent = message;
+          }, 50);
+        }
+      }
+
+      // Drink information database for Seasonal Favorites
+      const DRINK_DETAILS = {
+        seasonal: {
+          title: 'Maple Oat Latte',
+          price: '$5.75',
+          nutrition: '220 cal • 150mg caffeine',
+          ingredients: 'House espresso, steamed organic oat milk, Vermont maple syrup, cinnamon dusting.',
+          origin: 'Fair-trade certified Ethiopian & Colombian blend.'
+        },
+        espresso: {
+          title: 'Dark Roast Espresso',
+          price: '$3.95',
+          nutrition: '5 cal • 130mg caffeine (Double shot)',
+          ingredients: 'Full-bodied slow roast with notes of dark chocolate and smoky molasses.',
+          origin: 'Direct-trade Sumatran & Guatemalan estate beans.'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          price: '$4.50',
+          nutrition: '5 cal • 200mg caffeine',
+          ingredients: 'Triple-filtered water, slow-steeped for 18 hours for maximum smoothness.',
+          origin: 'Single-origin Colombian Supremo beans.'
+        }
+      };
+
+      // Order Now interaction handler
+      function initOrderButton() {
+        const orderBtn = document.getElementById('order-now-btn');
+        const orderStatus = document.getElementById('order-status');
+        if (!orderBtn) return;
+
+        let isOrderLoading = false;
+
+        function handleOrderClick(e) {
+          if (e) e.preventDefault();
+          if (isOrderLoading) return;
+
+          isOrderLoading = true;
+
+          // Set busy state for all users and assistive tech
+          orderBtn.setAttribute('aria-busy', 'true');
+          orderBtn.setAttribute('aria-disabled', 'true');
+          orderBtn.classList.add('is-loading');
+
+          // Display loading spinner and loading text
+          orderBtn.innerHTML = '<span class="spinner loading-spinner" aria-hidden="true"></span> Starting Order...<span class="sr-only">Starting order, please wait</span>';
+
+          if (orderStatus) {
+            orderStatus.style.display = 'block';
+            orderStatus.textContent = 'Starting order session...';
+          }
+
+          announce('Starting your order, please wait.');
+
+          // Simulate starting an order asynchronously
+          setTimeout(function () {
+            isOrderLoading = false;
+
+            orderBtn.setAttribute('aria-busy', 'false');
+            orderBtn.removeAttribute('aria-disabled');
+            orderBtn.classList.remove('is-loading');
+            orderBtn.innerHTML = 'Order Now';
+
+            if (orderStatus) {
+              orderStatus.textContent = 'Order session started! Ready to select your items.';
+            }
+
+            announce('Order started successfully. Ready to select items.');
+          }, 1000);
+        }
+
+        orderBtn.addEventListener('click', handleOrderClick);
+        orderBtn.addEventListener('keydown', function (e) {
+          if (e.key === ' ' || e.key === 'Spacebar') {
+            e.preventDefault();
+            handleOrderClick(e);
+          }
+        });
+      }
+
+      // Seasonal Favorites interaction handlers
+      function initSeasonalFavorites() {
+        const seasonalSection = document.getElementById('seasonal-favorites');
+        const cards = document.querySelectorAll('.card[data-drink-id]');
+
+        cards.forEach(function (card) {
+          const drinkId = card.getAttribute('data-drink-id');
+          const btn = card.querySelector('.details-btn');
+          const detailsSlot = card.querySelector('.details-slot');
+          const drinkInfo = DRINK_DETAILS[drinkId];
+
+          if (!btn || !detailsSlot || !drinkInfo) return;
+
+          let isLoading = false;
+          let isExpanded = false;
+
+          function handleDetailsClick(e) {
+            if (e) e.preventDefault();
+            if (isLoading) return;
+
+            // Toggle hide if details are currently open
+            if (isExpanded) {
+              isExpanded = false;
+              btn.setAttribute('aria-expanded', 'false');
+              btn.textContent = 'View Details';
+              detailsSlot.innerHTML = '';
+              announce('Details collapsed for ' + drinkInfo.title + '.');
+              return;
+            }
+
+            // Start loading state
+            isLoading = true;
+
+            // Set busy state across button, card, and section
+            btn.setAttribute('aria-busy', 'true');
+            btn.setAttribute('aria-disabled', 'true');
+            btn.classList.add('is-loading');
+            card.setAttribute('aria-busy', 'true');
+            if (seasonalSection) seasonalSection.setAttribute('aria-busy', 'true');
+
+            // Show loading spinner in button
+            btn.innerHTML = '<span class="spinner loading-spinner" aria-hidden="true"></span> Loading Details...<span class="sr-only">Loading drink details, please wait</span>';
+
+            // Show loading indicator with spinner in card details slot
+            detailsSlot.innerHTML = '<div class="card-loading" aria-busy="true">' +
+              '<span class="spinner loading-spinner card-spinner" aria-hidden="true"></span>' +
+              '<span>Loading details...</span>' +
+              '</div>';
+
+            announce('Loading details for ' + drinkInfo.title + ', please wait.');
+
+            // Simulate loading drink details
+            setTimeout(function () {
+              isLoading = false;
+              isExpanded = true;
+
+              // Clear busy states
+              btn.setAttribute('aria-busy', 'false');
+              btn.removeAttribute('aria-disabled');
+              btn.classList.remove('is-loading');
+              btn.setAttribute('aria-expanded', 'true');
+              btn.textContent = 'Hide Details';
+
+              card.setAttribute('aria-busy', 'false');
+              if (seasonalSection) seasonalSection.setAttribute('aria-busy', 'false');
+
+              // Render loaded details
+              detailsSlot.innerHTML = '<div class="drink-details" id="drink-info-' + drinkId + '">' +
+                '<p><strong>Price:</strong> ' + drinkInfo.price + '</p>' +
+                '<p><strong>Nutrition:</strong> ' + drinkInfo.nutrition + '</p>' +
+                '<p><strong>Ingredients:</strong> ' + drinkInfo.ingredients + '</p>' +
+                '<p><strong>Origin:</strong> ' + drinkInfo.origin + '</p>' +
+                '</div>';
+
+              announce('Drink details loaded for ' + drinkInfo.title + '.');
+            }, 900);
+          }
+
+          btn.addEventListener('click', handleDetailsClick);
+          btn.addEventListener('keydown', function (e) {
+            if (e.key === ' ' || e.key === 'Spacebar') {
+              e.preventDefault();
+              handleDetailsClick(e);
+            }
+          });
+        });
+      }
+
+      // Initialize when DOM is ready
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', function () {
+          initOrderButton();
+          initSeasonalFavorites();
+        });
+      } else {
+        initOrderButton();
+        initSeasonalFavorites();
+      }
+    })();
+  </script>
+
