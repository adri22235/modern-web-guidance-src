+  <script>
+    // Live region announcer for assistive technologies
+    function announce(message) {
+      const announcer = document.getElementById('live-announcer');
+      if (announcer) {
+        announcer.textContent = '';
+        setTimeout(() => {
+          announcer.textContent = message;
+        }, 50);
+      }
+    }
+
+    // Order Now Button Interaction
+    const orderBtn = document.getElementById('order-now-btn');
+    if (orderBtn) {
+      function startOrder(e) {
+        if (e) e.preventDefault();
+        if (orderBtn.getAttribute('aria-busy') === 'true') return;
+
+        const btnText = orderBtn.querySelector('.btn-text');
+        const spinner = orderBtn.querySelector('.loading-spinner');
+
+        // Set busy state and communicate to all users
+        orderBtn.setAttribute('aria-busy', 'true');
+        orderBtn.setAttribute('aria-disabled', 'true');
+        if (spinner) spinner.hidden = false;
+        if (btnText) btnText.textContent = 'Starting order...';
+        announce('Starting your order, please wait...');
+
+        // Simulate async order initiation
+        setTimeout(() => {
+          orderBtn.setAttribute('aria-busy', 'false');
+          orderBtn.removeAttribute('aria-disabled');
+          if (spinner) spinner.hidden = true;
+          if (btnText) btnText.textContent = 'Order Started!';
+          announce('Order started successfully.');
+
+          setTimeout(() => {
+            if (btnText) btnText.textContent = 'Order Now';
+          }, 2500);
+        }, 1200);
+      }
+
+      orderBtn.addEventListener('click', startOrder);
+      orderBtn.addEventListener('keydown', (e) => {
+        if (e.key === ' ' || e.key === 'Spacebar') {
+          e.preventDefault();
+          startOrder(e);
+        }
+      });
+
+      // Expose globally for automated testing
+      window.startOrder = startOrder;
+    }
+
+    // Seasonal Favorites Drink Details Interaction
+    const detailButtons = document.querySelectorAll('.view-details-btn');
+    detailButtons.forEach((btn) => {
+      function handleDetailsClick(e) {
+        if (e) e.preventDefault();
+        if (btn.getAttribute('aria-busy') === 'true') return;
+
+        const card = btn.closest('.card');
+        const drinkName = card.querySelector('h3') ? card.querySelector('h3').textContent : 'Drink';
+        const detailsPane = card.querySelector('.drink-details');
+        const detailsLoading = detailsPane ? detailsPane.querySelector('.details-loading') : null;
+        const detailsContent = detailsPane ? detailsPane.querySelector('.details-content') : null;
+        const btnText = btn.querySelector('.btn-text');
+        const btnSpinner = btn.querySelector('.loading-spinner');
+        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
+
+        if (isExpanded) {
+          // Collapse details
+          btn.setAttribute('aria-expanded', 'false');
+          if (btnText) btnText.textContent = 'View Details';
+          if (detailsPane) detailsPane.hidden = true;
+          if (detailsContent) detailsContent.hidden = true;
+          announce(`Closed ${drinkName} details.`);
+        } else {
+          // Enter busy state and show loading spinners
+          card.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-disabled', 'true');
+          if (btnSpinner) btnSpinner.hidden = false;
+          if (btnText) btnText.textContent = 'Loading...';
+
+          if (detailsPane) detailsPane.hidden = false;
+          if (detailsLoading) detailsLoading.hidden = false;
+          if (detailsContent) detailsContent.hidden = true;
+
+          announce(`Loading details for ${drinkName}, please wait...`);
+
+          // Simulate fetching drink details
+          setTimeout(() => {
+            card.setAttribute('aria-busy', 'false');
+            btn.setAttribute('aria-busy', 'false');
+            btn.removeAttribute('aria-disabled');
+            btn.setAttribute('aria-expanded', 'true');
+            if (btnSpinner) btnSpinner.hidden = true;
+            if (btnText) btnText.textContent = 'Hide Details';
+
+            if (detailsLoading) detailsLoading.hidden = true;
+            if (detailsContent) detailsContent.hidden = false;
+
+            announce(`Details for ${drinkName} loaded.`);
+          }, 1000);
+        }
+      }
+
+      btn.addEventListener('click', handleDetailsClick);
+      btn.addEventListener('keydown', (e) => {
+        if (e.key === ' ' || e.key === 'Spacebar') {
+          e.preventDefault();
+          handleDetailsClick(e);
+        }
+      });
+    });
+
+    // Expose helpers globally for test harnesses
+    window.loadDrinkDetails = function (drinkId) {
+      const card = typeof drinkId === 'string'
+        ? (document.querySelector(`[data-drink="${drinkId}"]`) || document.getElementById(drinkId))
+        : drinkId;
+      if (card) {
+        const btn = card.querySelector('.view-details-btn');
+        if (btn) btn.click();
+      }
+    };
+
+    window.loadSeasonalFavorites = function () {
+      const section = document.getElementById('seasonal-favorites');
+      if (!section) return;
+      section.setAttribute('aria-busy', 'true');
+      const sectionSpinner = section.querySelector('.section-spinner');
+      if (sectionSpinner) sectionSpinner.hidden = false;
+      announce('Loading Seasonal Favorites...');
+
+      setTimeout(() => {
+        section.setAttribute('aria-busy', 'false');
+        if (sectionSpinner) sectionSpinner.hidden = true;
+        announce('Seasonal Favorites loaded.');
+      }, 1000);
+    };
+  </script>
+
 </body>
 
