+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+
+      function getResolvedScheme() {
+        const content = meta ? meta.content : 'light dark';
+        if (content === 'dark' || content === 'light') {
+          return content;
+        }
+        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+
+      function updateToggleUI(currentScheme) {
+        if (!toggle) return;
+        const nextScheme = currentScheme === 'dark' ? 'light' : 'dark';
+        toggle.setAttribute('aria-label', `Switch to ${nextScheme} theme`);
+        toggle.setAttribute('title', `Switch to ${nextScheme} theme`);
+      }
+
+      function applyTheme(scheme, persist = true) {
+        if (meta) {
+          meta.content = scheme;
+        }
+        document.documentElement.dataset.theme = scheme;
+        document.documentElement.classList.remove('light', 'dark');
+        if (scheme === 'light' || scheme === 'dark') {
+          document.documentElement.classList.add(scheme);
+        }
+        if (persist) {
+          try {
+            localStorage.setItem('color-scheme', scheme);
+          } catch (e) {}
+        }
+        updateToggleUI(scheme);
+      }
+
+      if (toggle) {
+        toggle.addEventListener('click', () => {
+          const current = getResolvedScheme();
+          const target = current === 'dark' ? 'light' : 'dark';
+          applyTheme(target, true);
+        });
+      }
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          const scheme = e.newValue || 'light dark';
+          applyTheme(scheme, false);
+          updateToggleUI(getResolvedScheme());
+        }
+      });
+
+      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
+        updateToggleUI(getResolvedScheme());
+      });
+
+      updateToggleUI(getResolvedScheme());
+    })();
+  </script>
