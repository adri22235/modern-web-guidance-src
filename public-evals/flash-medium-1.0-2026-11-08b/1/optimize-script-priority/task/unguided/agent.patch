diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,70 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Dashboard</title>
+  <!-- Elevate the priority of the critical app logic -->
+  <script src="/js/app.js" async fetchpriority="high"></script>
+  <!-- Deprioritize non-essential tracking scripts -->
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+  <style>
+    body {
+      font-family: system-ui, -apple-system, sans-serif;
+      margin: 0;
+      padding: 2rem;
+      background-color: #f8fafc;
+      color: #1e293b;
+    }
+    header {
+      margin-bottom: 2rem;
+    }
+    h1 {
+      margin: 0;
+      font-size: 1.5rem;
+    }
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+      gap: 1rem;
+    }
+    .card {
+      background: #ffffff;
+      border: 1px solid #e2e8f0;
+      border-radius: 8px;
+      padding: 1.25rem;
+    }
+    .card h2 {
+      margin: 0 0 0.5rem 0;
+      font-size: 0.875rem;
+      color: #64748b;
+      text-transform: uppercase;
+    }
+    .card .value {
+      font-size: 1.5rem;
+      font-weight: 600;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Dashboard</h1>
+  </header>
+  <main class="grid">
+    <section class="card">
+      <h2>Users</h2>
+      <div class="value">1,248</div>
+    </section>
+    <section class="card">
+      <h2>Revenue</h2>
+      <div class="value">$24,500</div>
+    </section>
+    <section class="card">
+      <h2>Conversion</h2>
+      <div class="value">3.2%</div>
+    </section>
+  </main>
+  <!-- Deprioritize late-body scripts to favor critical images or CSS -->
+  <script src="/js/legacy-widgets.js" fetchpriority="low"></script>
+</body>
+</html>
