+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        // 4. Update document title
+        if (incomingConfig) {
+          document.title = incomingConfig.title;
+        }
+
+        // 5. Update browser history
+        if (pushHistory) {
+          if (replace) {
+            window.history.replaceState({ route: targetRoute }, incomingConfig.title, targetRoute);
+          } else {
+            window.history.pushState({ route: targetRoute }, incomingConfig.title, targetRoute);
+          }
+        }
+
+        currentRoute = targetRoute;
+
+        // 6. Restore scroll position
+        const savedScroll = scrollCache.get(targetRoute) || 0;
+        window.scrollTo({ top: savedScroll, behavior: 'instant' });
+      }
+
+      // Intercept SPA navigation link clicks
+      document.addEventListener('click', function (e) {
+        const link = e.target.closest('a');
+        if (!link) return;
+
+        const href = link.getAttribute('href');
+        if (!href) return;
+
+        // Logout action
+        if (href === '/logout' || link.classList.contains('logout-link')) {
+          e.preventDefault();
+          showToast('You have been logged out.');
+          navigateTo('/');
+          return;
+        }
+
+        // External or special protocols
+        if (href.startsWith('http://') || href.startsWith('https://') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
+          return;
+        }
+
+        // Check for SPA route
+        const normalized = normalizeRoute(href);
+        if (routes[normalized] || routeAliases[href]) {
+          e.preventDefault();
+          navigateTo(href);
+        }
+      });
+
+      // Browser forward/back button handler
+      window.addEventListener('popstate', function (e) {
+        const path = (e.state && e.state.route) ? e.state.route : window.location.pathname;
+        navigateTo(path, { pushHistory: false });
+      });
+
+      // Expose router API
+      window.DailyGrind = {
+        navigateTo: navigateTo,
+        getActiveRoute: () => currentRoute,
+        routes: routes,
+        showToast: showToast
+      };
+      window.router = window.DailyGrind;
+
+      // Setup interactive view features
+      function setupInteractiveFeatures() {
+        // Menu search and category filter
+        const menuSearch = document.getElementById('menu-search-input');
+        const menuCards = document.querySelectorAll('.menu-card');
+        const categoryBtns = document.querySelectorAll('.category-btn');
+        let activeCategory = 'all';
+
+        function filterMenu() {
+          const query = (menuSearch ? menuSearch.value : '').toLowerCase().trim();
+          menuCards.forEach((card) => {
+            const title = (card.querySelector('.menu-card-title')?.textContent || '').toLowerCase();
+            const desc = (card.querySelector('.menu-card-desc')?.textContent || '').toLowerCase();
+            const category = card.getAttribute('data-category') || '';
+
+            const matchesQuery = !query || title.includes(query) || desc.includes(query);
+            const matchesCategory = activeCategory === 'all' || category === activeCategory;
+
+            card.style.display = (matchesQuery && matchesCategory) ? 'flex' : 'none';
+          });
+        }
+
+        if (menuSearch) {
+          menuSearch.addEventListener('input', filterMenu);
+        }
+
+        categoryBtns.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            categoryBtns.forEach((b) => b.classList.remove('active'));
+            btn.classList.add('active');
+            activeCategory = btn.getAttribute('data-category') || 'all';
+            filterMenu();
+          });
+        });
+
+        // Add to Order buttons
+        document.querySelectorAll('.menu-card-btn').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const itemTitle = btn.closest('.menu-card')?.querySelector('.menu-card-title')?.textContent || 'Item';
+            showToast(`Added ${itemTitle} to your order!`);
+          });
+        });
+
+        // Locations search filter
+        const locSearch = document.getElementById('location-search-input');
+        const locCards = document.querySelectorAll('.location-card');
+
+        if (locSearch) {
+          locSearch.addEventListener('input', () => {
+            const query = locSearch.value.toLowerCase().trim();
+            locCards.forEach((card) => {
+              const text = card.textContent.toLowerCase();
+              card.style.display = (!query || text.includes(query)) ? 'flex' : 'none';
+            });
+          });
+        }
+
+        // Store selection buttons
+        document.querySelectorAll('.btn-select-store').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            document.querySelectorAll('.btn-select-store').forEach((b) => {
+              b.classList.remove('selected');
+              b.textContent = 'Select as My Store';
+            });
+            btn.classList.add('selected');
+            btn.textContent = '★ Selected Store';
+            const storeName = btn.closest('.location-card')?.querySelector('.location-title')?.textContent;
+            if (storeName) {
+              showToast(`Set "${storeName}" as your favorite store!`);
+              const accSelect = document.getElementById('acc-store');
+              if (accSelect) {
+                for (let i = 0; i < accSelect.options.length; i++) {
+                  if (accSelect.options[i].text.includes(storeName) || storeName.includes(accSelect.options[i].text)) {
+                    accSelect.selectedIndex = i;
+                    break;
+                  }
+                }
+              }
+            }
+          });
+        });
+
+        // Rewards promo code entry
+        const rewardBtn = document.getElementById('reward-code-btn');
+        const rewardInput = document.getElementById('reward-code-input');
+        if (rewardBtn && rewardInput) {
+          rewardBtn.addEventListener('click', () => {
+            const code = rewardInput.value.trim().toUpperCase();
+            if (!code) {
+              showToast('Please enter a promo or receipt code.');
+              return;
+            }
+            showToast(`Code "${code}" applied! +25 Beans credited.`);
+            rewardInput.value = '';
+            const balanceEl = document.querySelector('.points-balance');
+            if (balanceEl) {
+              balanceEl.textContent = '210 Beans';
+              const progress = document.querySelector('.progress-bar');
+              if (progress) progress.style.width = '100%';
+            }
+          });
+        }
+
+        // Rewards redemption buttons
+        document.querySelectorAll('.btn-redeem').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const item = btn.getAttribute('data-item') || 'Reward';
+            showToast(`Redeemed: ${item}! Show barcode at register.`);
+          });
+        });
+
+        // Account preferences saving
+        const saveAccBtn = document.getElementById('save-account-btn');
+        if (saveAccBtn) {
+          saveAccBtn.addEventListener('click', () => {
+            const name = document.getElementById('acc-name')?.value || 'Alex';
+            showToast(`Preferences saved for ${name}!`);
+          });
+        }
+
+        // Reorder buttons
+        document.querySelectorAll('.btn-reorder').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            showToast('Items added to current cart from past order!');
+          });
+        });
+      }
+
+      // Initialize on DOM load
+      function init() {
+        setupInteractiveFeatures();
+
+        // Determine initial route from path or hash
+        let initialPath = window.location.pathname;
+        if (window.location.hash && window.location.hash.length > 1) {
+          initialPath = window.location.hash;
+        }
+        navigateTo(initialPath, { pushHistory: false, replace: true });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
 </html>
