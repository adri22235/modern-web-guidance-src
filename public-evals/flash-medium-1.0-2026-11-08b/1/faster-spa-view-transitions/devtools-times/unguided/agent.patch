@@ -0,0 +1,430 @@
+---
+import ArticleTeaser from './ArticleTeaser.astro';
+import TopStoryTeaserGrid from './TopStoryTeaserGrid.astro';
+import SimpleTeaserGrid from './SimpleTeaserGrid.astro';
+import Ad from './AdSlotBanner';
+import { getCollection, type RenderResult } from 'astro:content';
+
+export interface Props {
+  initialSection?: 'top-news' | 'world' | 'politics' | 'multimedia' | 'reports';
+}
+
+const { initialSection = 'top-news' } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+// Slicing articles for different sections
+const topArticle = articles[0];
+const topStories = articles.slice(1, 4);
+const topNewsArticles = articles.slice(4, 8); // 4 articles for the new grid
+const worldNewsArticles = articles.slice(8, 11); // 3 articles for the old grid
+const politicsArticles = articles.slice(11, 15); // 4 articles for the new grid
+
+// Add fake What's new in DevTools post in politics (same as original index.astro)
+politicsArticles[2] = {
+  id: 'public-transit-overhaul',
+  data: {
+    title: "What's new in DevTools",
+    summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+    author: 'Chrome DevTools Team',
+    date: new Date('2025-09-16T00:00:00.000Z'),
+    category: 'Web Development',
+    image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+    image_caption: '',
+    readingTime: 3
+  },
+  body: '',
+  collection: 'articles',
+  slug: 'public-transit-overhaul',
+  render: async () => '' as unknown as RenderResult,
+};
+
+const multimedia = await getCollection('multimedia');
+const reports = await getCollection('reports');
+---
+
+<div
+  id="spa-section-views"
+  data-spa-container="true"
+  data-base={baseUrl}
+  data-active-section={initialSection}
+  class="relative w-full"
+>
+  <!-- Top News Section -->
+  <section
+    id="view-top-news"
+    data-view="top-news"
+    data-section="top-news"
+    class={`spa-view w-full ${initialSection === 'top-news' ? 'active-view' : 'hidden'}`}
+    style={initialSection === 'top-news' ? 'display: block;' : 'display: none;'}
+    {...(initialSection === 'top-news' ? {} : { hidden: true, inert: true, 'aria-hidden': 'true' })}
+  >
+    <!-- Top Stories Bar -->
+    <div class="bg-white border-b border-gray-300">
+      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+          {topStories.map(article => (
+            <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+              <a href={`${baseUrl}articles/${article.id}`}>
+                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+              </a>
+              <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+
+    <!-- Main Content Area -->
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+      <ArticleTeaser article={topArticle} large={true} />
+    </div>
+
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+      <section class="p-4 md:p-6 text-center">
+        <Ad client:visible />
+      </section>
+
+      <!-- "Top News" section with the new grid variant -->
+      <TopStoryTeaserGrid title="Top News" articles={topNewsArticles} />
+    </div>
+  </section>
+
+  <!-- World Section -->
+  <section
+    id="view-world"
+    data-view="world"
+    data-section="world"
+    class={`spa-view w-full ${initialSection === 'world' ? 'active-view' : 'hidden'}`}
+    style={initialSection === 'world' ? 'display: block;' : 'display: none;'}
+    {...(initialSection === 'world' ? {} : { hidden: true, inert: true, 'aria-hidden': 'true' })}
+  >
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto mt-6">
+      <SimpleTeaserGrid title="World" articles={worldNewsArticles} />
+      <section class="p-4 md:p-6 text-center">
+        <Ad client:visible />
+      </section>
+    </div>
+  </section>
+
+  <!-- Politics Section -->
+  <section
+    id="view-politics"
+    data-view="politics"
+    data-section="politics"
+    class={`spa-view w-full ${initialSection === 'politics' ? 'active-view' : 'hidden'}`}
+    style={initialSection === 'politics' ? 'display: block;' : 'display: none;'}
+    {...(initialSection === 'politics' ? {} : { hidden: true, inert: true, 'aria-hidden': 'true' })}
+  >
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto mt-6">
+      <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />
+      <section class="p-4 md:p-6 text-center">
+        <Ad client:visible />
+      </section>
+    </div>
+  </section>
+
+  <!-- Multimedia Section -->
+  <section
+    id="view-multimedia"
+    data-view="multimedia"
+    data-section="multimedia"
+    class={`spa-view w-full ${initialSection === 'multimedia' ? 'active-view' : 'hidden'}`}
+    style={initialSection === 'multimedia' ? 'display: block;' : 'display: none;'}
+    {...(initialSection === 'multimedia' ? {} : { hidden: true, inert: true, 'aria-hidden': 'true' })}
+  >
+    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Multimedia</h1>
+      <div class="prose max-w-none">
+        <p>Watch our latest multimedia content.</p>
+        <ul class="space-y-4 mt-6">
+          {multimedia.map(item => (
+            <li class="border-b border-gray-200 pb-4">
+              <a href={`${baseUrl}multimedia/${item.slug}`} class="text-xl font-bold text-gray-900 hover:text-amber-500 hover:underline">{item.data.title}</a>
+              {item.data.description && <p class="text-gray-600 text-sm mt-1">{item.data.description}</p>}
+              {item.data.category && <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded mt-2 font-medium">{item.data.category}</span>}
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  </section>
+
+  <!-- Reports Section -->
+  <section
+    id="view-reports"
+    data-view="reports"
+    data-section="reports"
+    class={`spa-view w-full ${initialSection === 'reports' ? 'active-view' : 'hidden'}`}
+    style={initialSection === 'reports' ? 'display: block;' : 'display: none;'}
+    {...(initialSection === 'reports' ? {} : { hidden: true, inert: true, 'aria-hidden': 'true' })}
+  >
+    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Reports</h1>
+      <div class="prose max-w-none">
+        <p>Read our latest reports.</p>
+        <ul class="space-y-4 mt-6">
+          {reports.map(report => (
+            <li class="border-b border-gray-200 pb-4">
+              <a href={`${baseUrl}reports/${report.slug}`} class="text-xl font-bold text-gray-900 hover:text-amber-500 hover:underline">{report.data.title}</a>
+              {report.data.description && <p class="text-gray-600 text-sm mt-1">{report.data.description}</p>}
+              {report.data.category && <span class="inline-block bg-yellow-100 text-yellow-800 text-xs px-2 py-0.5 rounded mt-2 font-medium">{report.data.category}</span>}
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  </section>
+</div>
+
+<script>
+  (function () {
+    const TITLES: Record<string, string> = {
+      'top-news': 'The DevTools Times',
+      'world': 'World - The DevTools Times',
+      'politics': 'Politics - The DevTools Times',
+      'multimedia': 'Multimedia - The DevTools Times',
+      'reports': 'Reports - The DevTools Times',
+    };
+
+    const PATHS: Record<string, string> = {
+      'top-news': '',
+      'world': 'world',
+      'politics': 'politics',
+      'multimedia': 'multimedia',
+      'reports': 'reports',
+    };
+
+    const scrollPositions: Record<string, number> = {};
+
+    function normalizeSection(name: string | null | undefined): string | null {
+      if (!name) return null;
+      const clean = name.toLowerCase().trim().replace(/^#/, '');
+      if (clean === 'top-news' || clean === 'topnews' || clean === 'top news' || clean === 'home' || clean === 'top_news') {
+        return 'top-news';
+      }
+      if (clean === 'world') return 'world';
+      if (clean === 'politics') return 'politics';
+      if (clean === 'multimedia') return 'multimedia';
+      if (clean === 'reports') return 'reports';
+      return null;
+    }
+
+    function getBaseUrl(): string {
+      const container = document.getElementById('spa-section-views');
+      let base = container?.dataset.base || '/devtools-times/';
+      if (!base.startsWith('/')) base = '/' + base;
+      if (!base.endsWith('/')) base = base + '/';
+      return base;
+    }
+
+    function normalizeSectionFromHref(href: string): string | null {
+      try {
+        const url = new URL(href, window.location.origin);
+        if (url.origin !== window.location.origin) return null;
+        const searchSec = normalizeSection(url.searchParams.get('section'));
+        if (searchSec) return searchSec;
+        const hashSec = normalizeSection(url.hash.replace(/^#/, ''));
+        if (hashSec) return hashSec;
+
+        const path = url.pathname.replace(/\/+$/, '');
+        if (path.endsWith('/world') || path.endsWith('/category/world')) return 'world';
+        if (path.endsWith('/politics') || path.endsWith('/category/politics')) return 'politics';
+        if (path.endsWith('/multimedia')) return 'multimedia';
+        if (path.endsWith('/reports')) return 'reports';
+        if (path.endsWith('/top-news')) return 'top-news';
+
+        const base = getBaseUrl().replace(/\/+$/, '');
+        if (path === base || path === '' || path === '/') return 'top-news';
+      } catch (err) {}
+      return null;
+    }
+
+    function getSectionFromUrl(): string {
+      const search = new URLSearchParams(window.location.search);
+      const searchSec = normalizeSection(search.get('section'));
+      if (searchSec) return searchSec;
+
+      const hashSec = normalizeSection(window.location.hash.replace(/^#/, ''));
+      if (hashSec) return hashSec;
+
+      const path = window.location.pathname.replace(/\/+$/, '');
+      if (path.endsWith('/world')) return 'world';
+      if (path.endsWith('/politics')) return 'politics';
+      if (path.endsWith('/multimedia')) return 'multimedia';
+      if (path.endsWith('/reports')) return 'reports';
+      if (path.endsWith('/top-news')) return 'top-news';
+
+      return 'top-news';
+    }
+
+    function updateNavIndicators(activeSection: string) {
+      const navLinks = document.querySelectorAll<HTMLElement>('[data-section], [data-nav]');
+      navLinks.forEach((link) => {
+        const sec = normalizeSection(link.dataset.section || link.dataset.nav);
+        if (sec === activeSection) {
+          link.setAttribute('aria-current', 'page');
+          link.setAttribute('aria-selected', 'true');
+          link.classList.add('border-gray-900', 'text-gray-900', 'font-bold');
+          link.classList.remove('border-transparent', 'text-gray-600');
+        } else if (sec) {
+          link.removeAttribute('aria-current');
+          link.setAttribute('aria-selected', 'false');
+          link.classList.remove('border-gray-900', 'text-gray-900', 'font-bold');
+          link.classList.add('border-transparent', 'text-gray-600');
+        }
+      });
+    }
+
+    function switchSpaSection(targetSection: string, updateHistory = true) {
+      const normalized = normalizeSection(targetSection) || 'top-news';
+      const container = document.getElementById('spa-section-views');
+      if (!container) return;
+
+      const views = container.querySelectorAll<HTMLElement>('.spa-view');
+      let currentActive: HTMLElement | null = null;
+      views.forEach((v) => {
+        if (v.style.display !== 'none' && !v.hidden && !v.classList.contains('hidden')) {
+          currentActive = v;
+        }
+      });
+
+      const currentSection = currentActive
+        ? (normalizeSection(currentActive.dataset.section || currentActive.dataset.view) || 'top-news')
+        : null;
+
+      if (currentSection === normalized) {
+        updateNavIndicators(normalized);
+        return;
+      }
+
+      // Preserve scroll position of current active view
+      if (currentSection) {
+        scrollPositions[currentSection] = window.scrollY;
+      }
+
+      // Switch views: preserve offscreen DOM state by hiding rather than removing/destroying
+      views.forEach((v) => {
+        const sec = normalizeSection(v.dataset.section || v.dataset.view);
+        if (sec === normalized) {
+          v.style.display = 'block';
+          v.removeAttribute('hidden');
+          v.removeAttribute('inert');
+          v.setAttribute('aria-hidden', 'false');
+          v.classList.remove('hidden');
+          v.classList.add('active-view');
+        } else {
+          v.style.display = 'none';
+          v.setAttribute('hidden', '');
+          v.setAttribute('inert', '');
+          v.setAttribute('aria-hidden', 'true');
+          v.classList.add('hidden');
+          v.classList.remove('active-view');
+        }
+      });
+
+      container.dataset.activeSection = normalized;
+
+      // Restore scroll position
+      const targetScroll = scrollPositions[normalized] || 0;
+      window.scrollTo(0, targetScroll);
+
+      // Update URL history
+      if (updateHistory) {
+        const base = getBaseUrl();
+        const subpath = PATHS[normalized];
+        const targetUrl = subpath ? `${base}${subpath}` : base;
+        window.history.pushState(null, '', targetUrl);
+      }
+
+      // Update title
+      if (TITLES[normalized]) {
+        document.title = TITLES[normalized];
+      }
+
+      // Notify other components (e.g. BottomNav)
+      const event = new CustomEvent('spa-section-change', { detail: { section: normalized } });
+      window.dispatchEvent(event);
+      document.dispatchEvent(event);
+
+      // Update nav link styles in DOM
+      updateNavIndicators(normalized);
+    }
+
+    // Expose on window for direct access & debugging
+    (window as any).switchSpaSection = switchSpaSection;
+    (window as any).getCurrentSpaSection = () => {
+      const container = document.getElementById('spa-section-views');
+      return container?.dataset.activeSection || getSectionFromUrl();
+    };
+
+    function initSpaRouter() {
+      const container = document.getElementById('spa-section-views');
+      if (!container) return;
+
+      const currentSection = getSectionFromUrl();
+      switchSpaSection(currentSection, false);
+      updateNavIndicators(currentSection);
+    }
+
+    if (!(window as any).__spaRouterInitialized) {
+      (window as any).__spaRouterInitialized = true;
+
+      // Intercept popstate in capture phase so Astro ClientRouter does not reload/swap
+      window.addEventListener(
+        'popstate',
+        (e) => {
+          const container = document.getElementById('spa-section-views');
+          if (!container) return;
+
+          const targetSection = getSectionFromUrl();
+          e.stopImmediatePropagation();
+          switchSpaSection(targetSection, false);
+        },
+        true
+      );
+
+      // Intercept clicks on links pointing to our sections in capture phase
+      document.addEventListener(
+        'click',
+        (e) => {
+          const container = document.getElementById('spa-section-views');
+          if (!container) return;
+
+          const target = e.target as HTMLElement | null;
+          const link = target?.closest('a, button') as HTMLElement | null;
+          if (!link) return;
+
+          let section = normalizeSection(link.dataset.section || link.dataset.nav);
+          if (!section) {
+            const href = link.getAttribute('href');
+            if (href) {
+              const fromHref = normalizeSectionFromHref(href);
+              if (fromHref) {
+                section = fromHref;
+              }
+            }
+          }
+
+          if (section) {
+            e.preventDefault();
+            e.stopImmediatePropagation();
+            switchSpaSection(section, true);
+          }
+        },
+        true
+      );
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initSpaRouter);
+    } else {
+      initSpaRouter();
+    }
+    document.addEventListener('astro:page-load', initSpaRouter);
+  })();
+</script>
