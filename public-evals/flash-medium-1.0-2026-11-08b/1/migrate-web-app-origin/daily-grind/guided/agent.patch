+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="manifest" href="/manifest.json">
+  <meta name="theme-color" content="#4e342e">
+  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
+  <link rel="apple-touch-icon" href="/icons/icon-192.png">
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+  </style>
+</head>
+
+<body>
+
+  <aside id="migration-banner" class="migration-banner" role="alert" style="display: none; background: var(--accent); color: var(--text); padding: 12px 5%; text-align: center; font-weight: 500;">
+    <span>Notice: The Daily Grind has moved to a new origin!</span>
+    <a href="https://new-app.example.com/demo.html" id="migration-link" style="margin-left: 15px; color: var(--primary); text-decoration: underline; font-weight: bold;">Visit our new app</a>
+  </aside>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    // Migration helper & fallback support for web app origin migration
+    (function() {
+      const isOldOrigin = window.location.origin.includes('old') || window.location.hostname.startsWith('old-');
+      const banner = document.getElementById('migration-banner');
+      if (banner && (isOldOrigin || !('migrate_from' in document.createElement('link')))) {
+        banner.style.display = 'block';
+      }
+
+      // Preserve user configuration via cross-origin messaging
+      window.addEventListener('message', function(event) {
+        const allowedHosts = ['example.com', 'dailygrind.coffee', 'dailygrind.com', 'localhost'];
+        const isAllowed = allowedHosts.some(host => event.origin.endsWith(host));
+        if (!isAllowed) return;
+
+        if (event.data && event.data.type === 'REQUEST_CONFIG_EXPORT') {
+          const config = {};
+          for (let i = 0; i < localStorage.length; i++) {
+            const key = localStorage.key(i);
+            config[key] = localStorage.getItem(key);
+          }
+          event.source.postMessage({ type: 'CONFIG_EXPORT', config }, event.origin);
+        } else if (event.data && event.data.type === 'CONFIG_EXPORT') {
+          if (event.data.config) {
+            Object.entries(event.data.config).forEach(([k, v]) => {
+              localStorage.setItem(k, v);
+            });
+          }
+        }
+      });
+    })();
+  </script>
+</body>
+
+</html>
