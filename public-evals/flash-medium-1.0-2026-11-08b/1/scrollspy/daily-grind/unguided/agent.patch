+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const navLinks = document.querySelectorAll('nav ul li a[href^="#"]');
+      const sectionIds = ['menu', 'locations', 'rewards', 'account'];
+      const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);
+
+      function setActiveLink(activeId) {
+        if (!activeId) return;
+        const normalizedActiveId = (activeId === 'my-account') ? 'account' : activeId;
+
+        navLinks.forEach(link => {
+          const href = link.getAttribute('href');
+          const targetId = href ? href.replace('#', '') : '';
+          const isMatch = (targetId === normalizedActiveId) ||
+                          (normalizedActiveId === 'account' && targetId === 'my-account') ||
+                          (normalizedActiveId === 'my-account' && targetId === 'account');
+
+          if (isMatch) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveSection() {
+        const scrollPosition = window.scrollY;
+        const windowHeight = window.innerHeight;
+        const documentHeight = document.documentElement.scrollHeight;
+        const nav = document.querySelector('nav');
+        const navHeight = nav ? nav.offsetHeight : 70;
+
+        // 1. If user is at or near the very bottom of the page, highlight the last section
+        if (scrollPosition + windowHeight >= documentHeight - 50) {
+          if (sections.length > 0) {
+            setActiveLink(sections[sections.length - 1].id);
+          }
+          return;
+        }
+
+        // 2. Identify which section top has crossed into the viewport focal zone
+        const focalLine = scrollPosition + navHeight + 120;
+        let activeSectionId = null;
+
+        for (const section of sections) {
+          if (section.offsetTop <= focalLine) {
+            activeSectionId = section.id;
+          } else {
+            break;
+          }
+        }
+
+        // If above the first section (e.g. at the hero), check if the first section is visible in viewport
+        if (!activeSectionId && sections.length > 0) {
+          const firstSection = sections[0];
+          const firstRect = firstSection.getBoundingClientRect();
+          if (firstRect.top < windowHeight && firstRect.bottom > navHeight) {
+            activeSectionId = firstSection.id;
+          }
+        }
+
+        if (activeSectionId) {
+          setActiveLink(activeSectionId);
+        }
+      }
+
+      // Intersection Observer for scroll spy support
+      if ('IntersectionObserver' in window) {
+        const nav = document.querySelector('nav');
+        const navHeight = nav ? nav.offsetHeight : 70;
+
+        const observerOptions = {
+          root: null,
+          rootMargin: `-${navHeight}px 0px -40% 0px`,
+          threshold: [0, 0.25, 0.5, 0.75, 1.0]
+        };
+
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach(entry => {
+            if (entry.isIntersecting) {
+              setActiveLink(entry.target.id);
+            }
+          });
+        }, observerOptions);
+
+        sections.forEach(section => observer.observe(section));
+      }
+
+      // Smooth click handling
+      navLinks.forEach(link => {
+        link.addEventListener('click', (e) => {
+          const href = link.getAttribute('href');
+          if (href && href.startsWith('#')) {
+            const targetId = href.substring(1);
+            const targetElement = document.getElementById(targetId);
+            if (targetElement) {
+              setActiveLink(targetId);
+            }
+          }
+        });
+      });
+
+      // Event listeners for scroll and resize with requestAnimationFrame throttling
+      let ticking = false;
+      function onScrollOrResize() {
+        if (!ticking) {
+          window.requestAnimationFrame(() => {
+            updateActiveSection();
+            ticking = false;
+          });
+          ticking = true;
+        }
+      }
+
+      window.addEventListener('scroll', onScrollOrResize, { passive: true });
+      window.addEventListener('resize', onScrollOrResize, { passive: true });
+      window.addEventListener('hashchange', () => {
+        const hash = window.location.hash.replace('#', '');
+        if (hash) {
+          setActiveLink(hash);
+        } else {
+          updateActiveSection();
+        }
+      });
+
+      // Initial activation
+      const initialHash = window.location.hash.replace('#', '');
+      if (initialHash && document.getElementById(initialHash)) {
+        setActiveLink(initialHash);
+      } else {
+        updateActiveSection();
+      }
+    });
+  </script>
+
 </body>
 
