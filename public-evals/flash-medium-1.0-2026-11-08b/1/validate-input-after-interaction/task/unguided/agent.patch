+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMsg = document.getElementById('newsletter-error');
+      const successMsg = document.getElementById('newsletter-success');
+
+      function isValidEmail(email) {
+        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.trim());
+      }
+
+      function showError(message) {
+        emailInput.classList.add('has-error');
+        errorMsg.textContent = message;
+        errorMsg.style.display = 'block';
+        successMsg.style.display = 'none';
+      }
+
+      function clearError() {
+        emailInput.classList.remove('has-error');
+        errorMsg.textContent = '';
+        errorMsg.style.display = 'none';
+      }
+
+      function validate() {
+        const val = emailInput.value.trim();
+        if (!val) {
+          showError('Please enter your email address.');
+          return false;
+        }
+        if (!isValidEmail(val)) {
+          showError('Please enter a valid email address.');
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      // Do NOT show an error while the user is actively typing; clear any previous error state
+      emailInput.addEventListener('input', function () {
+        clearError();
+        successMsg.style.display = 'none';
+      });
+
+      // Validate only after the user clicks away (blur)
+      emailInput.addEventListener('blur', function () {
+        validate();
+      });
+
+      // Also validate on form submit
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (validate()) {
+          successMsg.textContent = 'Thanks for subscribing! Check your inbox soon.';
+          successMsg.style.display = 'block';
+          emailInput.value = '';
+          clearError();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
