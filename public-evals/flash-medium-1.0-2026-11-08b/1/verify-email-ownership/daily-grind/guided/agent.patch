+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  handleSignupSubmission,
+  verifyEmailVerificationToken,
+  consumeSessionNonce,
+  completeAccountCreation,
+  sendTraditionalVerificationEmail,
+  sessionStore,
+  nonceStore,
+  generateNonce,
+  createSession,
+  parseCookieString,
+  RP_ORIGIN,
+} from './verify.js';
+
+export {
+  handleSignupSubmission,
+  verifyEmailVerificationToken,
+  consumeSessionNonce,
+  completeAccountCreation,
+  sendTraditionalVerificationEmail,
+  sessionStore,
+  nonceStore,
+  generateNonce,
+  createSession,
+  parseCookieString,
+  RP_ORIGIN,
+};
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.gif': 'image/gif',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon',
+  '.webp': 'image/webp',
+};
+
+// HTTP request handler
+export async function handleRequest(req, res) {
+  try {
+    const urlObj = new URL(req.url, `http://${req.headers.host || 'localhost:11222'}`);
+    const pathname = urlObj.pathname;
+
+    // Homepage render with dynamic session nonce
+    if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+      const cookies = parseCookieString(req.headers.cookie);
+      const existingSid = cookies['session_id'] || cookies['sessionId'] || cookies['sid'];
+      const { sessionId, nonce } = createSession(existingSid);
+
+      const indexPath = path.join(__dirname, 'index.html');
+      let html = await fs.promises.readFile(indexPath, 'utf-8');
+
+      // Inject the freshly generated nonce into the token input
+      html = html.replace(
+        /(<input[^>]*autocomplete=["']email-verification-token["'][^>]*nonce=["'])[^"']*([ "'])/i,
+        `$1${nonce}$2`
+      );
+      // In case nonce attribute appears before autocomplete
+      html = html.replace(
+        /(<input[^>]*nonce=["'])[^"']*([ "'][^>]*autocomplete=["']email-verification-token["'])/i,
+        `$1${nonce}$2`
+      );
+      // In case placeholder SERVER_GENERATED_PER_FORM_NONCE is used
+      html = html.replace('SERVER_GENERATED_PER_FORM_NONCE', nonce);
+
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Origin-Trial': process.env.ORIGIN_TRIAL_TOKEN || 'EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN',
+        'Set-Cookie': `session_id=${sessionId}; Path=/; HttpOnly; SameSite=Lax`,
+      });
+      res.end(html);
+      return;
+    }
+
+    // Helper endpoint to retrieve or generate a session nonce
+    if (req.method === 'GET' && pathname === '/api/nonce') {
+      const cookies = parseCookieString(req.headers.cookie);
+      const existingSid = cookies['session_id'] || cookies['sessionId'] || cookies['sid'];
+      const { sessionId, nonce } = createSession(existingSid);
+
+      res.writeHead(200, {
+        'Content-Type': 'application/json',
+        'Cache-Control': 'no-store',
+        'Set-Cookie': `session_id=${sessionId}; Path=/; HttpOnly; SameSite=Lax`,
+      });
+      res.end(JSON.stringify({ nonce, sessionId }));
+      return;
+    }
+
+    // Email verification & rewards signup endpoint
+    if (
+      req.method === 'POST' &&
+      (pathname === '/api/verify-email' ||
+        pathname === '/api/verify' ||
+        pathname === '/api/signup' ||
+        pathname === '/api/rewards/signup')
+    ) {
+      const chunks = [];
+      for await (const chunk of req) {
+        chunks.push(chunk);
+      }
+      const rawBody = Buffer.concat(chunks);
+      const fullUrl = `http://${req.headers.host || 'localhost:11222'}${req.url}`;
+
+      const webRequest = new Request(fullUrl, {
+        method: 'POST',
+        headers: req.headers,
+        body: rawBody.length > 0 ? rawBody : undefined,
+        duplex: 'half',
+      });
+
+      const webResponse = await handleSignupSubmission(webRequest);
+      const resBody = await webResponse.text();
+
+      const headers = {
+        'Content-Type': webResponse.headers.get('content-type') || 'application/json',
+        'Cache-Control': 'no-store',
+      };
+      const setCookie = webResponse.headers.get('set-cookie');
+      if (setCookie) headers['Set-Cookie'] = setCookie;
+
+      res.writeHead(webResponse.status || 200, headers);
+      res.end(resBody);
+      return;
+    }
+
+    // Static file serving
+    if (req.method === 'GET') {
+      const safePath = path.normalize(pathname).replace(/^(\.\.[/\\])+/, '');
+      const filePath = path.join(__dirname, safePath);
+
+      if (fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
+        const ext = path.extname(filePath).toLowerCase();
+        const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+        res.writeHead(200, { 'Content-Type': contentType });
+        fs.createReadStream(filePath).pipe(res);
+        return;
+      }
+    }
+
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not Found');
+  } catch (err) {
+    console.error('Server error handling request:', err);
+    res.writeHead(500, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ error: 'Internal Server Error', message: err.message }));
+  }
+}
+
+export const server = http.createServer(handleRequest);
+
+// Start listening only when executed directly as main script
+const isMain =
+  process.argv[1] &&
+  (path.resolve(process.argv[1]) === __filename ||
+    path.basename(process.argv[1]) === 'server.js');
+
+if (isMain) {
+  const PORT = process.env.PORT || 11222;
+  server.listen(PORT, '0.0.0.0', () => {
+    console.log(`Daily Grind server running on http://localhost:${PORT}`);
+  });
+}
