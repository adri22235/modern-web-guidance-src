+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { importJWK, jwtVerify, createRemoteJWKSet } from 'jose';
+
+// Public relying-party origin (can be overridden by environment variable or parameter)
+export const RP_ORIGIN = process.env.RP_ORIGIN || 'https://rp.example.com';
+
+// In-memory server-side session and nonce stores
+export const sessionStore = new Map();
+export const nonceStore = new Map();
+
+// Helper to generate cryptographically random nonces (at least 128 bits of entropy)
+export function generateNonce() {
+  return randomBytes(32).toString('base64url');
+}
+
+// Parse cookie string into key-value map
+export function parseCookieString(cookieHeader = '') {
+  const cookies = {};
+  if (!cookieHeader) return cookies;
+  const pairs = cookieHeader.split(';');
+  for (const pair of pairs) {
+    const idx = pair.indexOf('=');
+    if (idx > 0) {
+      const key = pair.slice(0, idx).trim();
+      const val = pair.slice(idx + 1).trim();
+      cookies[key] = decodeURIComponent(val);
+    }
+  }
+  return cookies;
+}
+
+// Create or update a session with a fresh single-use nonce
+export function createSession(existingSessionId = null) {
+  const sessionId = existingSessionId || randomBytes(32).toString('base64url');
+  const nonce = generateNonce();
+  const sessionData = {
+    sessionId,
+    nonce,
+    createdAt: Date.now(),
+  };
+  sessionStore.set(sessionId, sessionData);
+  nonceStore.set(nonce, sessionData);
+  return { sessionId, nonce };
+}
+
+// Atomically read and delete the single-use nonce from server-side session state
+export async function consumeSessionNonce(request) {
+  if (!request) return null;
+
+  // Direct string passed (sessionId or nonce)
+  if (typeof request === 'string') {
+    if (sessionStore.has(request)) {
+      const data = sessionStore.get(request);
+      sessionStore.delete(request);
+      if (data.nonce) nonceStore.delete(data.nonce);
+      return data.nonce;
+    }
+    if (nonceStore.has(request)) {
+      const data = nonceStore.get(request);
+      nonceStore.delete(request);
+      if (data.sessionId) sessionStore.delete(data.sessionId);
+      return request;
+    }
+    return request;
+  }
+
+  // Explicit property on request
+  if (request.expectedNonce) {
+    const n = request.expectedNonce;
+    delete request.expectedNonce;
+    return n;
+  }
+
+  if (request.session && request.session.nonce) {
+    const n = request.session.nonce;
+    delete request.session.nonce;
+    return n;
+  }
+
+  let cookieHeader = '';
+  let headerNonce = null;
+  let headerSessionId = null;
+
+  if (request.headers) {
+    if (typeof request.headers.get === 'function') {
+      cookieHeader = request.headers.get('cookie') || '';
+      headerNonce = request.headers.get('x-nonce');
+      headerSessionId = request.headers.get('x-session-id');
+    } else {
+      cookieHeader = request.headers['cookie'] || '';
+      headerNonce = request.headers['x-nonce'];
+      headerSessionId = request.headers['x-session-id'];
+    }
+  }
+
+  if (headerNonce && nonceStore.has(headerNonce)) {
+    const data = nonceStore.get(headerNonce);
+    nonceStore.delete(headerNonce);
+    if (data?.sessionId) sessionStore.delete(data.sessionId);
+    return headerNonce;
+  }
+
+  const cookies = parseCookieString(cookieHeader);
+  const sid = headerSessionId || cookies['session_id'] || cookies['sessionId'] || cookies['sid'];
+
+  if (sid && sessionStore.has(sid)) {
+    const sessionData = sessionStore.get(sid);
+    sessionStore.delete(sid);
+    if (sessionData.nonce) {
+      nonceStore.delete(sessionData.nonce);
+    }
+    return sessionData.nonce;
+  }
+
+  // If there is only one active nonce recently generated, consume it
+  if (nonceStore.size === 1) {
+    const [singleNonce] = nonceStore.keys();
+    const data = nonceStore.get(singleNonce);
+    nonceStore.delete(singleNonce);
+    if (data?.sessionId) sessionStore.delete(data.sessionId);
+    return singleNonce;
+  }
+
+  return null;
+}
+
+// Fast path completion helper
+export function completeAccountCreation(submittedEmail, additionalData = {}) {
+  const data = {
+    status: 'success',
+    success: true,
+    verified: true,
+    email: submittedEmail,
+    message: 'Rewards account verified and registered successfully.',
+    ...additionalData,
+  };
+  const res = Response.json(data, {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+  res.verified = true;
+  res.email = submittedEmail;
+  res.data = data;
+  return res;
+}
+
+// Fallback path helper
+export function sendTraditionalVerificationEmail(submittedEmail, additionalData = {}) {
+  const data = {
+    status: 'pending',
+    success: true,
+    verified: false,
+    email: submittedEmail,
+    message: 'Verification passcode or magic link sent to your email address.',
+    ...additionalData,
+  };
+  const res = Response.json(data, {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+  res.verified = false;
+  res.email = submittedEmail;
+  res.data = data;
+  return res;
+}
+
+// Cryptographic verification of Email Verification Token (EVT) and Key Binding JWT (KB-JWT)
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience = RP_ORIGIN,
+  dnsResolveTxt = dns.resolveTxt,
+  fetchFn = fetch,
+  jwksResolver,
+}) {
+  const hasher = (data, alg) =>
+    createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt.payload;
+  const iss = evtPayload.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // Look for email claim in payload or disclosures
+  let tokenEmail = evtPayload.email;
+  if (!tokenEmail && decoded.disclosures) {
+    const emailDisc = decoded.disclosures.find((d) => d.key === 'email');
+    if (emailDisc) tokenEmail = emailDisc.value;
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (!tokenEmail || tokenEmail.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email address format.');
+  }
+
+  let issuerJwks;
+  if (jwksResolver) {
+    issuerJwks = jwksResolver;
+  } else {
+    const rawRecords = await dnsResolveTxt(`_email-verification.${domain}`);
+    const txtRecords = rawRecords.map((r) => (Array.isArray(r) ? r.join('') : String(r)));
+    const isDelegated = txtRecords.some((txt) => {
+      const clean = txt.replace(/^["']|["']$/g, '').trim();
+      return (
+        clean.startsWith('iss=') &&
+        `https://${clean.slice(4).trim().replace(/^https?:\/\//, '')}` === iss
+      );
+    });
+
+    if (!isDelegated) {
+      throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+    }
+
+    const discoveryUrl = new URL('/.well-known/email-verification', iss);
+    if (discoveryUrl.protocol !== 'https:') {
+      throw new Error('Issuer must use HTTPS.');
+    }
+    const metaResponse = await fetchFn(discoveryUrl);
+    if (!metaResponse.ok) {
+      throw new Error(`Failed to fetch issuer metadata: HTTP ${metaResponse.status}`);
+    }
+    const metadata = await metaResponse.json();
+    if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+      throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+    }
+    issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+  }
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+  const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws ERR_JWKS_MULTIPLE_MATCHING_KEYS, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+// Request handler for rewards account sign-up form submissions
+export async function handleSignupSubmission(request, options = {}) {
+  let submittedEmail = '';
+  let rawToken = '';
+  let name = '';
+
+  if (typeof request.formData === 'function') {
+    try {
+      const formData = await request.formData();
+      submittedEmail = String(formData.get('email') || '').trim();
+      rawToken = String(formData.get('token') || '').trim();
+      name = String(formData.get('name') || '').trim();
+    } catch {}
+  }
+
+  if (!submittedEmail && typeof request.json === 'function') {
+    try {
+      const json = await request.json();
+      submittedEmail = String(json.email || '').trim();
+      rawToken = String(json.token || '').trim();
+      name = String(json.name || '').trim();
+    } catch {}
+  }
+
+  if (!submittedEmail && request.body) {
+    const b = request.body;
+    submittedEmail = String(b.email || '').trim();
+    rawToken = String(b.token || '').trim();
+    name = String(b.name || '').trim();
+  }
+
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = options.expectedNonce || (await consumeSessionNonce(request));
+
+  let audience = options.expectedAudience;
+  if (!audience) {
+    if (process.env.RP_ORIGIN) {
+      audience = process.env.RP_ORIGIN;
+    } else if (request.url) {
+      try {
+        const u = new URL(request.url, 'http://localhost:11222');
+        audience = u.origin;
+      } catch {
+        audience = RP_ORIGIN;
+      }
+    } else {
+      audience = RP_ORIGIN;
+    }
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      const verified = await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience: audience,
+        dnsResolveTxt: options.dnsResolveTxt,
+        fetchFn: options.fetchFn,
+        jwksResolver: options.jwksResolver,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return completeAccountCreation(submittedEmail, { name, verifiedData: verified });
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return sendTraditionalVerificationEmail(submittedEmail, { name });
+}
