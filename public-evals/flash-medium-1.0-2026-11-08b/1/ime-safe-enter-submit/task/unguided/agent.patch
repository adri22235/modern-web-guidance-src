+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackTextarea = document.getElementById('feedback-textarea');
+    const sendButton = document.getElementById('send-button');
+
+    feedbackTextarea.addEventListener('keydown', function (event) {
+      if (event.isComposing) return;
+      if ((event.key === 'Enter' || event.keyCode === 13 || event.which === 13) && !event.shiftKey) {
+        event.preventDefault();
+        if (typeof feedbackForm.requestSubmit === 'function') {
+          try {
+            feedbackForm.requestSubmit(sendButton);
+          } catch (e) {
+            feedbackForm.requestSubmit();
+          }
+        } else {
+          sendButton.click();
+        }
+      }
+    });
+
+    feedbackForm.addEventListener('submit', function (event) {
+      event.preventDefault();
+    });
+  </script>
