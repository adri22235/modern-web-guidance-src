+/* ==========================================================================
+   Cascade Management (CSS Cascade Layers)
+   Explicit layer ordering ensures predictability and prevents specificity conflicts
+   ========================================================================== */
+@layer reset, base, layout, components, utilities;
+
+/* ==========================================================================
+   Design Tokens & CSS Custom Properties
+   ========================================================================== */
+@layer base {
+  :root {
+    /* --- Color Palette Tokens --- */
+    --color-primary-base: #4e342e;
+    --color-primary-dark: #3e2723;
+    --color-primary-light: #6d4c41;
+    --color-secondary-base: #d7ccc8;
+    --color-accent-base: #ffab40;
+    --color-accent-hover: #ff9100;
+    --color-neutral-0: #ffffff;
+    --color-neutral-50: #fafafa;
+    --color-neutral-900: #3e2723;
+    --color-overlay: rgba(0, 0, 0, 0.5);
+    --color-shadow: rgba(0, 0, 0, 0.1);
+
+    /* Semantic Tokens */
+    --color-bg-body: var(--color-neutral-50);
+    --color-bg-surface: var(--color-neutral-0);
+    --color-bg-nav: var(--color-primary-base);
+    --color-bg-footer: var(--color-secondary-base);
+    --color-text-main: var(--color-neutral-900);
+    --color-text-inverse: var(--color-neutral-0);
+    --color-border-accent: var(--color-accent-base);
+
+    /* Backward Compatibility Tokens */
+    --primary: var(--color-primary-base);
+    --secondary: var(--color-secondary-base);
+    --accent: var(--color-accent-base);
+    --text: var(--color-neutral-900);
+    --light: var(--color-neutral-50);
+
+    /* --- Logical Spacing Scale Tokens --- */
+    --space-3xs: 4px;
+    --space-2xs: 5px;
+    --space-xs: 10px;
+    --space-sm: 12px;
+    --space-md: 15px;
+    --space-lg: 20px;
+    --space-xl: 40px;
+    --space-nav-inline: 5%;
+
+    /* --- Typography Tokens --- */
+    --font-family-base: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-xs: 0.85rem;
+    --font-size-sm: 0.9rem;
+    --font-size-base: 1rem;
+    --font-size-lg: 1.25rem;
+    --font-size-xl: 1.5rem;
+    --font-size-hero: 3rem;
+    --font-weight-regular: 400;
+    --font-weight-bold: 700;
+    --line-height-tight: 1.2;
+    --line-height-base: 1.6;
+    --letter-spacing-logo: 1px;
+
+    /* --- Sizing & Layout Tokens --- */
+    --container-max-inline-size: 1100px;
+    --hero-min-block-size: 60vh;
+    --grid-min-col-inline-size: 250px;
+
+    /* --- Elevation & Radius Tokens --- */
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+    --shadow-card: 0 2px 5px var(--color-shadow);
+
+    /* --- Transitions & Z-Index Tokens --- */
+    --transition-duration-fast: 0.3s;
+    --transition-timing-standard: ease;
+    --z-index-sticky: 1000;
+  }
+
+  /* Global document typography & body styling */
+  body {
+    font-family: var(--font-family-base);
+    line-height: var(--line-height-base);
+    color: var(--color-text-main);
+    background-color: var(--color-bg-body);
+  }
+
+  :is(h1, h2, h3) {
+    line-height: var(--line-height-tight);
+  }
+}
+
+/* ==========================================================================
+   Reset Layer
+   Zero-specificity grouping with :where() for seamless overrides
+   ========================================================================== */
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+    margin-block: 0;
+    margin-inline: 0;
+    padding-block: 0;
+    padding-inline: 0;
+  }
+
+  :where(ul, ol) {
+    list-style: none;
+  }
+}
+
+/* ==========================================================================
+   Layout Layer
+   Logical properties for structural containers & responsive grid
+   ========================================================================== */
+@layer layout {
+  .container {
+    max-inline-size: var(--container-max-inline-size);
+    margin-block: var(--space-xl);
+    margin-inline: auto;
+    padding-block: 0;
+    padding-inline: var(--space-lg);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-min-col-inline-size)), 1fr));
+    gap: var(--space-lg);
+    margin-block-start: var(--space-lg);
+  }
+}
+
+/* ==========================================================================
+   Components Layer
+   Modern selector grouping, CSS nesting, and logical layout spacing
+   ========================================================================== */
+@layer components {
+  /* --- Sticky Navigation Bar --- */
+  nav {
+    background-color: var(--color-bg-nav);
+    color: var(--color-text-inverse);
+    padding-block: 1rem;
+    padding-inline: var(--space-nav-inline);
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--z-index-sticky);
+
+    & .logo {
+      font-size: var(--font-size-xl);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: var(--letter-spacing-logo);
+    }
+
+    & ul {
+      display: flex;
+      list-style: none;
+      align-items: center;
+      gap: var(--space-lg);
+
+      & li {
+        margin-inline-start: 0;
+      }
+    }
+
+    & a {
+      color: var(--color-text-inverse);
+      text-decoration: none;
+      font-size: var(--font-size-sm);
+      transition: color var(--transition-duration-fast) var(--transition-timing-standard);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-accent-base);
+      }
+    }
+
+    & .logout-link {
+      border: 1px solid var(--color-border-accent);
+      padding-block: var(--space-2xs);
+      padding-inline: var(--space-sm);
+      border-radius: var(--radius-sm);
+    }
+  }
+
+  /* Navigation selector fallbacks & grouping */
+  .logo {
+    font-size: var(--font-size-xl);
+    font-weight: var(--font-weight-bold);
+    letter-spacing: var(--letter-spacing-logo);
+  }
+
+  nav ul {
+    display: flex;
+    list-style: none;
+    align-items: center;
+    gap: var(--space-lg);
+  }
+
+  nav ul li {
+    margin-inline-start: 0;
+  }
+
+  nav a {
+    color: var(--color-text-inverse);
+    text-decoration: none;
+    font-size: var(--font-size-sm);
+    transition: color var(--transition-duration-fast) var(--transition-timing-standard);
+  }
+
+  nav a:is(:hover, :focus-visible) {
+    color: var(--color-accent-base);
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-border-accent);
+    padding-block: var(--space-2xs);
+    padding-inline: var(--space-sm);
+    border-radius: var(--radius-sm);
+  }
+
+  /* --- Hero Section ("Wake Up Your Senses") --- */
+  .hero {
+    block-size: var(--hero-min-block-size);
+    min-block-size: var(--hero-min-block-size);
+    background: linear-gradient(var(--color-overlay), var(--color-overlay)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: var(--color-text-inverse);
+    text-align: center;
+    padding-block: 0;
+    padding-inline: var(--space-lg);
+
+    & h1 {
+      font-size: var(--font-size-hero);
+      margin-block-end: 1rem;
+    }
+
+    & p {
+      margin-block: 0;
+    }
+  }
+
+  .hero h1 {
+    font-size: var(--font-size-hero);
+    margin-block-end: 1rem;
+  }
