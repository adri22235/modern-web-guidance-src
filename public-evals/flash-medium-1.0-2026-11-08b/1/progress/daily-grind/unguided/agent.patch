+  <script>
+    function setProgressState(state) {
+      const orderBar = document.getElementById('order-progress-bar');
+      const orderFill = document.getElementById('order-progress-fill');
+      const nativeProgress = document.getElementById('order-native-progress');
+      const statusPct = document.getElementById('order-status-pct');
+      const statusLabel = document.getElementById('order-status-label');
+      const btnDet = document.getElementById('btn-state-determinate');
+      const btnIndet = document.getElementById('btn-state-indeterminate');
+      const stepsList = document.getElementById('progress-steps-list');
+
+      if (!orderBar || !orderFill || !nativeProgress) return;
+
+      if (state === 'indeterminate') {
+        btnDet.classList.remove('active');
+        btnDet.setAttribute('aria-pressed', 'false');
+        btnIndet.classList.add('active');
+        btnIndet.setAttribute('aria-pressed', 'true');
+
+        orderBar.classList.remove('determinate');
+        orderBar.classList.add('indeterminate');
+        orderBar.removeAttribute('aria-valuenow');
+        orderBar.setAttribute('aria-busy', 'true');
+
+        orderFill.classList.remove('determinate');
+        orderFill.classList.add('indeterminate');
+        orderFill.style.width = '';
+
+        nativeProgress.classList.remove('determinate');
+        nativeProgress.classList.add('indeterminate');
+        nativeProgress.removeAttribute('value');
+
+        if (statusPct) statusPct.textContent = 'Estimating...';
+        if (statusLabel) statusLabel.innerHTML = 'Order Fulfillment: <em>Connecting with barista queue &amp; roaster...</em>';
+        if (stepsList) stepsList.classList.add('indeterminate-mode');
+      } else {
+        btnIndet.classList.remove('active');
+        btnIndet.setAttribute('aria-pressed', 'false');
+        btnDet.classList.add('active');
+        btnDet.setAttribute('aria-pressed', 'true');
+
+        orderBar.classList.remove('indeterminate');
+        orderBar.classList.add('determinate');
+        orderBar.setAttribute('aria-valuenow', '75');
+        orderBar.removeAttribute('aria-busy');
+
+        orderFill.classList.remove('indeterminate');
+        orderFill.classList.add('determinate');
+        orderFill.style.width = '75%';
+
+        nativeProgress.classList.remove('indeterminate');
+        nativeProgress.classList.add('determinate');
+        nativeProgress.setAttribute('value', '75');
+
+        if (statusPct) statusPct.textContent = '75% Complete';
+        if (statusLabel) statusLabel.innerHTML = 'Order Fulfillment: <strong>Brewing Maple Oat Latte</strong>';
+        if (stepsList) stepsList.classList.remove('indeterminate-mode');
+      }
+    }
+  </script>
