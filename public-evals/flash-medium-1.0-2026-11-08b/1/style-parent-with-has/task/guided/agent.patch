+  <script>
+    (function () {
+      const form = document.getElementById('contact-form');
+      if (!form) return;
+
+      const controls = form.querySelectorAll('input, textarea');
+      const dirtyState = new WeakMap();
+
+      const updateControlState = (control, force = false) => {
+        if (!control || !control.checkValidity) return;
+        const wrapper = control.closest('.field-wrapper');
+        const state = dirtyState.get(control) || { hasInteracted: false, hasBlurred: false };
+        const isValid = control.checkValidity();
+
+        // Check native :user-invalid pseudo-class if supported
+        let isUserInvalid = false;
+        try {
+          isUserInvalid = control.matches(':user-invalid');
+        } catch (e) {
+          isUserInvalid = false;
+        }
+
+        // Error state: active when :user-invalid matches or force is true (e.g. submit)
+        // or user has interacted and blurred while field is invalid
+        const shouldShowError = isUserInvalid || ((force || (state.hasInteracted && state.hasBlurred)) && !isValid);
+
+        if (shouldShowError) {
+          control.setAttribute('aria-invalid', 'true');
+          control.classList.add('user-invalid-fallback');
+          control.classList.remove('user-valid-fallback');
+          if (wrapper) wrapper.classList.add('has-error');
+        } else if (isValid) {
+          control.removeAttribute('aria-invalid');
+          control.classList.remove('user-invalid-fallback');
+          control.classList.toggle('user-valid-fallback', state.hasBlurred || isUserInvalid);
+          if (wrapper) wrapper.classList.remove('has-error');
+        } else {
+          // Untouched invalid state on initial load: do not show error prematurely
+          control.removeAttribute('aria-invalid');
+          control.classList.remove('user-invalid-fallback');
+          control.classList.remove('user-valid-fallback');
+          if (wrapper) wrapper.classList.remove('has-error');
+        }
+      };
+
+      // Track interaction events
+      form.addEventListener('input', (e) => {
+        const control = e.target;
+        if (!control.matches('input, textarea')) return;
+        const state = dirtyState.get(control) || { hasInteracted: false, hasBlurred: false };
+        state.hasInteracted = true;
+        dirtyState.set(control, state);
+
+        // Clear error immediately upon correction
+        updateControlState(control);
+      });
+
+      form.addEventListener('change', (e) => {
+        const control = e.target;
+        if (!control.matches('input, textarea')) return;
+        const state = dirtyState.get(control) || { hasInteracted: false, hasBlurred: false };
+        state.hasInteracted = true;
+        dirtyState.set(control, state);
+        updateControlState(control);
+      });
+
+      form.addEventListener('blur', (e) => {
+        const control = e.target;
+        if (!control.matches('input, textarea')) return;
+        const state = dirtyState.get(control) || { hasInteracted: false, hasBlurred: false };
+        state.hasBlurred = true;
+        state.hasInteracted = true;
+        dirtyState.set(control, state);
+        updateControlState(control);
+      }, true);
+
+      // Listen for invalid events during native form submission attempts
+      form.addEventListener('invalid', (e) => {
+        const control = e.target;
+        if (control.matches('input, textarea')) {
+          updateControlState(control, true);
+        }
+      }, true);
+
+      // Handle form submission
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        let firstInvalid = null;
+
+        controls.forEach((control) => {
+          const state = dirtyState.get(control) || { hasInteracted: false, hasBlurred: false };
+          state.hasInteracted = true;
+          state.hasBlurred = true;
+          dirtyState.set(control, state);
+
+          updateControlState(control, true);
+
+          if (!control.checkValidity() && !firstInvalid) {
+            firstInvalid = control;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        // Show success status
+        const statusEl = document.getElementById('contact-status');
+        if (statusEl) {
+          statusEl.textContent = 'Thank you! Your message has been sent successfully.';
+          statusEl.className = 'status-msg status-success';
+          statusEl.hidden = false;
+        }
+
+        form.reset();
+        controls.forEach((control) => {
+          dirtyState.delete(control);
+          control.removeAttribute('aria-invalid');
+          control.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+          const wrapper = control.closest('.field-wrapper');
+          if (wrapper) wrapper.classList.remove('has-error');
+        });
+      });
+
+      form.addEventListener('reset', () => {
+        controls.forEach((control) => {
+          dirtyState.delete(control);
+          control.removeAttribute('aria-invalid');
+          control.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+          const wrapper = control.closest('.field-wrapper');
+          if (wrapper) wrapper.classList.remove('has-error');
+        });
+        const statusEl = document.getElementById('contact-status');
+        if (statusEl) statusEl.hidden = true;
+      });
+    })();
+  </script>
+
