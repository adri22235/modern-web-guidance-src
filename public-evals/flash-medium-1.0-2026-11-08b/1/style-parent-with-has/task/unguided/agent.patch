   </footer>
 
+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const form = document.getElementById('contact-form');
+      if (!form) return;
+
+      const fields = [
+        {
+          input: document.getElementById('name'),
+          wrapper: document.getElementById('name-field-wrapper'),
+          errorElem: document.getElementById('name-error'),
+          validate(value) {
+            if (!value.trim()) {
+              return 'Please enter your name.';
+            }
+            return '';
+          }
+        },
+        {
+          input: document.getElementById('email'),
+          wrapper: document.getElementById('email-field-wrapper'),
+          errorElem: document.getElementById('email-error'),
+          validate(value) {
+            const trimmed = value.trim();
+            if (!trimmed) {
+              return 'Please enter your email address.';
+            }
+            // Standard email format validation: must have non-whitespace before and after @, and valid domain
+            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+            if (!emailRegex.test(trimmed)) {
+              return 'Please enter a valid email address (e.g., name@example.com).';
+            }
+            return '';
+          }
+        },
+        {
+          input: document.getElementById('message'),
+          wrapper: document.getElementById('message-field-wrapper'),
+          errorElem: document.getElementById('message-error'),
+          validate(value) {
+            if (!value.trim()) {
+              return 'Please enter your message.';
+            }
+            return '';
+          }
+        }
+      ];
+
+      fields.forEach(field => {
+        let touched = false;
+
+        function runValidation() {
+          const errorMessage = field.validate(field.input.value);
+          const hasError = Boolean(errorMessage);
+
+          if (hasError) {
+            field.wrapper.classList.add('error', 'has-error', 'invalid');
+            field.input.setAttribute('aria-invalid', 'true');
+            if (field.errorElem) {
+              field.errorElem.textContent = errorMessage;
+              field.errorElem.style.display = 'block';
+            }
+          } else {
+            field.wrapper.classList.remove('error', 'has-error', 'invalid');
+            field.input.setAttribute('aria-invalid', 'false');
+            if (field.errorElem) {
+              field.errorElem.textContent = '';
+              field.errorElem.style.display = 'none';
+            }
+          }
+          return !hasError;
+        }
+
+        // Trigger error highlight when user leaves a field after interaction
+        field.input.addEventListener('blur', () => {
+          touched = true;
+          runValidation();
+        });
+
+        // While interacting/typing, live-validate if already touched
+        field.input.addEventListener('input', () => {
+          if (touched) {
+            runValidation();
+          }
+        });
+
+        // Provide method to validate on form submit
+        field.validateField = () => {
+          touched = true;
+          return runValidation();
+        };
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        let isFormValid = true;
+        let firstInvalidInput = null;
+
+        fields.forEach(field => {
+          const isValid = field.validateField();
+          if (!isValid) {
+            isFormValid = false;
+            if (!firstInvalidInput) {
+              firstInvalidInput = field.input;
+            }
+          }
+        });
+
+        if (!isFormValid) {
+          if (firstInvalidInput) {
+            firstInvalidInput.focus();
+          }
+          return;
+        }
+
+        const successMessage = document.getElementById('form-success');
+        if (successMessage) {
+          successMessage.style.display = 'block';
+        }
+
+        form.reset();
+
+        fields.forEach(field => {
+          field.wrapper.classList.remove('error', 'has-error', 'invalid');
+          field.input.setAttribute('aria-invalid', 'false');
+          if (field.errorElem) {
+            field.errorElem.textContent = '';
+            field.errorElem.style.display = 'none';
+          }
+        });
+      });
+    });
+  </script>
+
 </body>
 
