+
+        setStatus('Verifying passkey registration...');
+
+        // 3. Verify the registration by POSTing to /api/register/verify
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+          },
+          body: JSON.stringify(credentialJSON),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error(`Passkey verification failed: ${verifyResponse.status} ${verifyResponse.statusText}`);
+        }
+
+        const verifyResult = await verifyResponse.json();
+        if (verifyResult && verifyResult.verified === false) {
+          throw new Error(verifyResult.message || 'Passkey verification was rejected by server.');
+        }
+
+        setStatus('Passkey registered successfully! Promotion activated.', 'success');
+      } catch (err) {
+        console.error('Passkey registration error:', err);
+        let errorMsg = err.message || 'An error occurred during passkey registration.';
+        if (err.name === 'NotAllowedError') {
+          errorMsg = 'Registration was cancelled or timed out.';
+        } else if (err.name === 'InvalidStateError') {
+          errorMsg = 'This passkey has already been registered on this authenticator.';
+        } else if (err.name === 'NotSupportedError') {
+          errorMsg = 'Passkey creation is not supported by your authenticator or device.';
+        }
+        setStatus(errorMsg, 'error');
+      } finally {
+        if (registerButton) {
+          registerButton.disabled = false;
+        }
+      }
+    }
+
+    function initPasskeyRegistration() {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      if (registerButton && !registerButton.dataset.listenerAttached) {
+        registerButton.dataset.listenerAttached = 'true';
+        registerButton.addEventListener('click', handleRegisterPasskey);
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initPasskeyRegistration);
+    } else {
+      initPasskeyRegistration();
+    }
+  </script>
