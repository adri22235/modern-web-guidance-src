+
+        if (!optionsResponse.ok) {
+          throw new Error(`Failed to fetch passkey creation options: ${optionsResponse.status} ${optionsResponse.statusText}`);
+        }
+
+        const optionsData = await optionsResponse.json();
+
+        setStatus('Creating passkey on your device...');
+
+        // 2. Handle passkey creation
