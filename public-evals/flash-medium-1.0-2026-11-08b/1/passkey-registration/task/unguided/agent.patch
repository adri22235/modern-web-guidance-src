+  <script>
+    // Utility functions for WebAuthn Base64URL conversions
+    function base64URLStringToBuffer(base64URLString) {
+      if (!base64URLString) return new ArrayBuffer(0);
+      if (base64URLString instanceof ArrayBuffer) return base64URLString;
+      if (ArrayBuffer.isView(base64URLString)) return base64URLString.buffer;
+      if (Array.isArray(base64URLString)) return new Uint8Array(base64URLString).buffer;
+      if (typeof base64URLString !== 'string') return base64URLString;
+      try {
+        const base64 = base64URLString.trim().replace(/-/g, '+').replace(/_/g, '/');
+        const padLength = (4 - (base64.length % 4)) % 4;
+        const padded = base64 + '='.repeat(padLength);
+        const binary = atob(padded);
+        const buffer = new ArrayBuffer(binary.length);
+        const bytes = new Uint8Array(buffer);
+        for (let i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return buffer;
+      } catch (e) {
+        return new TextEncoder().encode(base64URLString).buffer;
+      }
+    }
+
+    function bufferToBase64URLString(buffer) {
+      if (!buffer) return '';
+      const bytes = new Uint8Array(buffer);
+      let str = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        str += String.fromCharCode(bytes[i]);
+      }
+      return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+    }
+
+    function toPublicKeyCredentialDescriptor(descriptor) {
+      return {
+        ...descriptor,
+        id: base64URLStringToBuffer(descriptor.id),
+        transports: descriptor.transports,
+        type: descriptor.type || 'public-key',
+      };
+    }
+
+    function credentialToJSON(credential) {
+      if (typeof credential.toJSON === 'function') {
+        const json = credential.toJSON();
+        if (json.response && !json.response.transports && typeof credential.response?.getTransports === 'function') {
+          try {
+            json.response.transports = credential.response.getTransports();
+          } catch (e) {}
+        }
+        if (!json.authenticatorAttachment && credential.authenticatorAttachment) {
+          json.authenticatorAttachment = credential.authenticatorAttachment;
+        }
+        return json;
+      }
+
+      const response = credential.response;
+      let transports;
+      if (typeof response?.getTransports === 'function') {
+        try {
+          transports = response.getTransports();
+        } catch (e) {}
+      }
+
+      let publicKeyAlgorithm;
+      if (typeof response?.getPublicKeyAlgorithm === 'function') {
+        try {
+          publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        } catch (e) {}
+      }
+
+      let publicKey;
+      if (typeof response?.getPublicKey === 'function') {
+        try {
+          const pk = response.getPublicKey();
+          if (pk) {
+            publicKey = bufferToBase64URLString(pk);
+          }
+        } catch (e) {}
+      }
+
+      let authenticatorData;
+      if (typeof response?.getAuthenticatorData === 'function') {
+        try {
+          const ad = response.getAuthenticatorData();
+          if (ad) {
+            authenticatorData = bufferToBase64URLString(ad);
+          }
+        } catch (e) {}
+      }
+
+      const clientExtensionResults = typeof credential.getClientExtensionResults === 'function'
+        ? credential.getClientExtensionResults()
+        : {};
+
+      return {
+        id: credential.id,
+        rawId: bufferToBase64URLString(credential.rawId),
+        response: {
+          clientDataJSON: bufferToBase64URLString(response?.clientDataJSON),
+          attestationObject: bufferToBase64URLString(response?.attestationObject),
+          ...(transports ? { transports } : {}),
+          ...(publicKeyAlgorithm !== undefined ? { publicKeyAlgorithm } : {}),
+          ...(publicKey ? { publicKey } : {}),
+          ...(authenticatorData ? { authenticatorData } : {}),
+        },
+        type: credential.type || 'public-key',
+        clientExtensionResults,
+        ...(credential.authenticatorAttachment ? { authenticatorAttachment: credential.authenticatorAttachment } : {}),
+      };
+    }
+
+    async function startRegistration(options) {
+      const creationOptionsJSON = options?.optionsJSON || options?.options || options?.publicKey || options;
+      const rawPublicKey = creationOptionsJSON.publicKey || creationOptionsJSON;
+
+      let createOptions;
+      if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        try {
+          createOptions = PublicKeyCredential.parseCreationOptionsFromJSON(rawPublicKey);
+        } catch (err) {
+          console.warn('parseCreationOptionsFromJSON error, falling back to manual conversion', err);
+        }
+      }
+
+      if (!createOptions) {
+        const publicKey = {
+          ...rawPublicKey,
+          challenge: base64URLStringToBuffer(rawPublicKey.challenge),
+          user: {
+            ...rawPublicKey.user,
+            id: base64URLStringToBuffer(rawPublicKey.user?.id),
+          },
+        };
