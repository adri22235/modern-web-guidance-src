+  <script>
+    async function initPasskeyUI() {
+      const registerBtn = document.querySelector('[data-testid="register-button"]');
+      if (!registerBtn) return;
+
+      if (
+        !window.PublicKeyCredential ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        registerBtn.disabled = true;
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+          registerBtn.disabled = true;
+        }
+      } catch (err) {
+        console.error('Error checking passkey capabilities:', err);
+        registerBtn.disabled = true;
+      }
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const registerBtn = document.querySelector('[data-testid="register-button"]');
+      if (registerBtn && registerBtn.disabled) {
+        return;
+      }
+
+      let optionsResponse;
+      try {
+        optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ promotion: isPromotion }),
+        });
+      } catch (networkErr) {
+        console.error('Failed to fetch passkey creation options:', networkErr);
+        return;
+      }
+
+      if (!optionsResponse.ok) {
+        console.error('Passkey creation options response was not ok:', optionsResponse.status);
+        return;
+      }
+
+      const creationOptionsJSON = await optionsResponse.json();
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(
+        creationOptionsJSON.publicKey || creationOptionsJSON
+      );
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        } else {
+          console.error('Passkey creation failed:', err);
+        }
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyResponse.ok && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initPasskeyUI);
+    } else {
+      initPasskeyUI();
+    }
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    if (registerButton) {
+      registerButton.addEventListener('click', () => registerPasskey(true));
+    }
+  </script>
 </body>
 
