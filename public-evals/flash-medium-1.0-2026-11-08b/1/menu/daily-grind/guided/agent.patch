+      content: "✓";
+      color: var(--primary);
+    }
+
+    .menu-panel button[role="menuitemradio"][aria-checked="true"]::before {
+      content: "●";
+      color: var(--primary);
+      font-size: 0.75rem;
+    }
+
+    /* Trailing hint/arrow for submenus */
+    .menu-panel .hint {
+      margin-inline-start: auto;
+      font-size: 0.8rem;
+      color: #8d6e63;
