+    /* ============================================================ */
+    /* Interactive Menu Component Styles (Modern Web Guidance Compliant) */
+    /* ============================================================ */
+
+    /* Popover Top Layer Container */
+    .menu-popover {
+      padding: 0;
+      border: 1px solid var(--border-color);
+      border-radius: 8px;
+      background: #ffffff;
+      box-shadow: var(--shadow-lg);
+      min-width: 220px;
+      max-width: 320px;
+      z-index: 2000;
+      overflow: visible;
+    }
+
+    /* Anchor Positioning for Top-level and Submenus */
+    @supports (position-area: block-end span-inline-end) {
+      [popover]:has(> [focusgroup~="menu"]) {
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+        inset: auto;
+      }
+
+      [focusgroup~="menu"] > [popover] {
+        position-area: inline-end span-block-end;
+        position-try-fallbacks: flip-inline, flip-block, --below;
+      }
+
+      @position-try --below {
+        position-area: block-end span-inline-end;
+        margin-inline-start: 1rem;
+        min-inline-size: 0;
+        max-inline-size: calc(100% - 1rem);
+      }
+    }
+
+    /* Fallback positioning for browsers without native position-area */
+    @supports not (position-area: block-end span-inline-end) {
+      .menu-popover {
+        position: fixed;
+        inset: auto;
+        margin: 0;
+      }
+    }
+
+    /* Smooth Popover Open/Close Transitions */
+    @media (prefers-reduced-motion: no-preference) {
+      .menu-popover {
+        opacity: 0;
+        translate: 0 -0.25rem;
+        transition: opacity 0.15s ease, translate 0.15s ease, display 0.15s, overlay 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      .menu-popover:popover-open {
+        opacity: 1;
+        translate: 0 0;
+        transition-duration: 0.1s;
+
+        @starting-style {
+          opacity: 0;
+          translate: 0 -0.25rem;
+        }
+      }
+    }
+
+    /* Focusgroup Menu Panel */
+    .menu-panel {
