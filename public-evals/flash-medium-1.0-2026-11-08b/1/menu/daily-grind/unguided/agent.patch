+          // If clicked directly on the parent row and not a child interactive item
+          if (e.target.closest('.interactive-submenu') && e.target !== submenuParent) {
+            return; // Let the inner item handle click
+          }
+          e.stopPropagation();
+
+          const isOpen = this.classList.contains('is-submenu-open');
+          // Close sibling submenus at this depth
+          const siblingParents = this.parentElement.querySelectorAll(':scope > .interactive-menu-item.has-submenu');
+          siblingParents.forEach(sib => {
+            if (sib !== this) {
+              sib.classList.remove('is-submenu-open');
+              sib.setAttribute('aria-expanded', 'false');
+            }
+          });
+
+          if (!isOpen) {
+            this.classList.add('is-submenu-open');
+            this.setAttribute('aria-expanded', 'true');
+            const childSub = this.querySelector(':scope > .interactive-submenu');
+            if (childSub) {
