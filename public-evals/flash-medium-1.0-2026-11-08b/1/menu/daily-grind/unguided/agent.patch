+      function adjustFlyoutPositions(scope) {
+        const submenus = scope.querySelectorAll('.interactive-submenu');
+        submenus.forEach(sub => {
+          // Reset first
+          sub.classList.remove('fly-left');
+          const rect = sub.getBoundingClientRect();
+          if (rect.right > window.innerWidth - 12) {
