+  <script>
+    (function () {
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const heroImg = document.getElementById('hero');
+      const detailTitle = document.getElementById('title');
+      const detailDesc = document.getElementById('detail-desc');
+      const detailPrice = document.getElementById('detail-price');
+      const detailNotes = document.getElementById('detail-notes');
+      const backBtn = document.getElementById('back-btn');
+      const liveRegion = document.getElementById('live-region');
+
+      let activeCard = null;
+
+      const itemDetails = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          desc: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          price: '$5.75',
+          notes: 'Rich espresso combined with steamed creamy oat milk and pure Vermont maple syrup, finished with a dust of warm cinnamon.',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          desc: 'Bold, smokey, and perfect for a morning boost.',
+          price: '$4.25',
+          notes: 'An intense, full-bodied double shot extracted from dark-roasted Arabica beans with notes of bittersweet chocolate and toasted walnut.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=800&q=80'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          desc: 'Steeped for 18 hours for maximum smoothness.',
+          price: '$4.95',
+          notes: 'Coarsely ground beans slowly steeped in cold filtered water for 18 hours, resulting in an exceptionally smooth, low-acid coffee.',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=800&q=80'
+        }
+      };
+
+      function getCardData(card) {
+        const id = card.getAttribute('data-id');
+        const staticInfo = (id && itemDetails[id]) || {};
+        const titleEl = card.querySelector('h2.title, .title');
+        const title = titleEl ? titleEl.textContent.trim() : (staticInfo.title || '');
+        const imgEl = card.querySelector('img');
+        const image = imgEl ? (imgEl.getAttribute('src') || '') : (staticInfo.image || '');
+        const descEl = card.querySelector('p');
+        const desc = descEl ? descEl.textContent.trim() : (staticInfo.desc || '');
+
+        return {
+          id: id || 'item',
+          title: title,
+          desc: desc,
+          price: staticInfo.price || '$5.00',
+          notes: staticInfo.notes || desc,
+          image: image
+        };
+      }
+
+      function showDetail(card) {
+        activeCard = card;
+        const data = getCardData(card);
+        const cardTitle = card.querySelector('h2.title, .title');
+
+        function updateDOM() {
+          heroImg.src = data.image;
+          heroImg.alt = data.title;
+          detailTitle.textContent = data.title;
+          if (detailDesc) detailDesc.textContent = data.desc;
+          if (detailPrice) detailPrice.textContent = data.price;
+          if (detailNotes) detailNotes.textContent = data.notes;
+
+          listPage.hidden = true;
+          detailPage.hidden = false;
+
+          if (liveRegion) {
+            liveRegion.textContent = `Showing details for ${data.title}`;
+          }
+        }
+
+        card.style.viewTransitionName = 'hero';
+        if (cardTitle) {
+          cardTitle.style.viewTransitionName = 'title';
+        }
+
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(() => {
+            card.style.viewTransitionName = '';
+            if (cardTitle) cardTitle.style.viewTransitionName = '';
+
+            heroImg.style.viewTransitionName = 'hero';
+            detailTitle.style.viewTransitionName = 'title';
+
+            updateDOM();
+          });
+
+          transition.finished.finally(() => {
+            heroImg.style.viewTransitionName = '';
+            detailTitle.style.viewTransitionName = '';
+            if (backBtn) {
+              backBtn.focus();
+            }
+          });
+        } else {
+          updateDOM();
+          card.style.viewTransitionName = '';
+          if (cardTitle) cardTitle.style.viewTransitionName = '';
+          if (backBtn) {
+            backBtn.focus();
+          }
+        }
+      }
+
+      function showList() {
+        const card = activeCard || document.querySelector('.thumbnail');
+        const cardTitle = card ? card.querySelector('h2.title, .title') : null;
+
+        function updateDOM() {
+          detailPage.hidden = true;
+          listPage.hidden = false;
+
+          if (liveRegion) {
+            liveRegion.textContent = 'Returned to Seasonal Favorites list';
+          }
+        }
+
+        heroImg.style.viewTransitionName = 'hero';
+        detailTitle.style.viewTransitionName = 'title';
+
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(() => {
+            heroImg.style.viewTransitionName = '';
+            detailTitle.style.viewTransitionName = '';
+
+            if (card) card.style.viewTransitionName = 'hero';
+            if (cardTitle) cardTitle.style.viewTransitionName = 'title';
+
+            updateDOM();
+          });
+
+          transition.finished.finally(() => {
+            if (card) {
+              card.style.viewTransitionName = '';
+              card.focus();
+            }
+            if (cardTitle) cardTitle.style.viewTransitionName = '';
+          });
+        } else {
+          updateDOM();
+          heroImg.style.viewTransitionName = '';
+          detailTitle.style.viewTransitionName = '';
+          if (card) {
+            card.focus();
+          }
+        }
+      }
+
+      // Delegate click and keyboard on list page
+      listPage.addEventListener('click', (e) => {
+        const card = e.target.closest('.thumbnail');
+        if (card && listPage.contains(card)) {
+          showDetail(card);
+        }
+      });
+
+      listPage.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          const card = e.target.closest('.thumbnail');
+          if (card && listPage.contains(card)) {
+            e.preventDefault();
+            showDetail(card);
+          }
+        }
+      });
+
+      if (backBtn) {
+        backBtn.addEventListener('click', () => {
+          showList();
+        });
+      }
+
+      // Escape key to navigate back
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && !detailPage.hidden) {
+          showList();
+        }
+      });
+    })();
+  </script>
 </body>
 
