+  <script>
+    (() => {
+      let isTransitioning = false;
+
+      function goFromListToDetail(card) {
+        if (isTransitioning) return;
+        isTransitioning = true;
+
+        document.querySelectorAll(".thumbnail.selected").forEach((el) => {
+          el.classList.remove("selected");
+        });
+
+        card.classList.add("selected");
+
+        const titleEl = card.querySelector(".title");
+        const titleText = titleEl ? titleEl.textContent.trim() : "";
+        const imgEl = card.querySelector(".thumb-img");
+        const imgSrc = imgEl ? imgEl.src : "";
+        const imgAlt = imgEl ? imgEl.alt : titleText;
+        const descEl = card.querySelector("p");
+        const descText = descEl ? descEl.textContent.trim() : "";
+
+        const updateDOM = () => {
+          const hero = document.getElementById("hero");
+          if (hero) {
+            hero.src = imgSrc;
+            hero.alt = imgAlt;
+          }
+          const title = document.getElementById("title");
+          if (title) {
+            title.textContent = titleText;
+          }
+          const desc = document.getElementById("detail-desc");
+          if (desc) {
+            desc.textContent = descText;
+          }
+
+          document.getElementById("list-page").hidden = true;
+          document.getElementById("detail-page").hidden = false;
+          document.body.classList.add("detail");
+        };
+
+        if (!document.startViewTransition) {
+          updateDOM();
+          document.getElementById("title")?.focus();
+          isTransitioning = false;
+          return;
+        }
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          document.getElementById("title")?.focus();
+          isTransitioning = false;
+        });
+      }
+
+      function goFromDetailToList() {
+        if (isTransitioning) return;
+        isTransitioning = true;
+
+        const updateDOM = () => {
+          document.getElementById("detail-page").hidden = true;
+          document.getElementById("list-page").hidden = false;
+          document.body.classList.remove("detail");
+        };
+
+        if (!document.startViewTransition) {
+          updateDOM();
+          document.getElementById("list-heading")?.focus();
+          document.querySelectorAll(".thumbnail.selected").forEach((el) => {
+            el.classList.remove("selected");
+          });
+          isTransitioning = false;
+          return;
+        }
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          document.getElementById("list-heading")?.focus();
+          document.querySelectorAll(".thumbnail.selected").forEach((el) => {
+            el.classList.remove("selected");
+          });
+          isTransitioning = false;
+        });
+      }
+
+      document.querySelectorAll(".thumbnail").forEach((card) => {
+        card.addEventListener("click", () => goFromListToDetail(card));
+        card.addEventListener("keydown", (e) => {
+          if (e.key === "Enter" || e.key === " ") {
+            e.preventDefault();
+            goFromListToDetail(card);
+          }
+        });
+      });
+
+      const backBtn = document.getElementById("back-btn");
+      if (backBtn) {
+        backBtn.addEventListener("click", goFromDetailToList);
+      }
+
+      document.addEventListener("keydown", (e) => {
+        if (e.key === "Escape" && !document.getElementById("detail-page").hidden) {
+          goFromDetailToList();
+        }
+      });
+    })();
+  </script>
+
