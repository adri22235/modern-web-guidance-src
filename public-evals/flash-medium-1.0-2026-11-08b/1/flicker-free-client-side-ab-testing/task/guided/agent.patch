+  <!--
+    A/B Testing Experimentation Script
+    - async: Prevents HTML parser blocking so DOM construction proceeds in parallel.
+    - blocking="render": Blocks browser painting until the script executes, preventing flash of original content (FOOC).
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onerror="document.documentElement.classList.remove('ab-loading')"
+  ></script>
+
+  <!--
+    Anti-Flicker Fallback
+    Applied only in browsers that do not support native blocking="render" (e.g. Firefox).
+  -->
+  <script>
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+  </script>
