+              <div class="options-row opt-milk">
+                ${['Oat Milk', 'Whole Milk', 'Almond Milk', 'Coconut Milk', 'None'].map(m => `
+                  <button type="button" class="opt-chip ${c.milk === m ? 'selected' : ''}" data-val="${m}">${m}</button>
+                `).join('')}
+              </div>
+            </div>
+
+            <div class="drawer-group">
+              <label class="drawer-label">Sweetness</label>
+              <div class="options-row opt-sweetness">
+                ${['Standard', 'Half Sweet', 'Extra Sweet', 'Unsweetened'].map(s => `
+                  <button type="button" class="opt-chip ${c.sweetness === s ? 'selected' : ''}" data-val="${s}">${s}</button>
+                `).join('')}
+              </div>
+            </div>
+
+            <div class="drawer-group">
+              <label class="drawer-label">Temperature</label>
+              <div class="options-row opt-temp">
+                ${['Hot', 'Iced'].map(t => `
+                  <button type="button" class="opt-chip ${c.temp === t ? 'selected' : ''}" data-val="${t}">${t}</button>
+                `).join('')}
+              </div>
+            </div>
+
+            <div class="drawer-group" style="margin-top: 14px;">
+              <label class="drawer-label">Add-Ins & Options</label>
+              <div style="display: flex; flex-direction: column; gap: 8px;">
+                <label class="checkbox-row">
+                  <input type="checkbox" class="chk-extra-shot" ${c.extraShot ? 'checked' : ''} />
+                  <span>Extra Espresso Shot (+$0.80)</span>
+                </label>
+                <label class="checkbox-row">
+                  <input type="checkbox" class="chk-decaf" ${c.decaf ? 'checked' : ''} />
+                  <span>Decaf Espresso</span>
+                </label>
+                <label class="checkbox-row">
+                  <input type="checkbox" class="chk-whip" ${c.whip ? 'checked' : ''} />
+                  <span>Sweetened Whipped Cream (+$0.50)</span>
+                </label>
+              </div>
+            </div>
+
+            <div class="drawer-footer">
+              <button type="button" class="drawer-btn reset reset-recipe-btn">Reset Recipe</button>
+              <button type="button" class="drawer-btn done close-drawer-btn">Done</button>
+            </div>
+          </div>
+        `;
+
+        attachCardEvents(card, drink);
+        return card;
+      }
+
+      // Attach event listeners to a card element
+      function attachCardEvents(card, drink) {
+        const id = drink.id;
+
+        // Move Left
+        const moveLeftBtn = card.querySelector('.move-left-btn');
+        if (moveLeftBtn) {
+          moveLeftBtn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const idx = currentDrinks.findIndex(d => d.id === id);
+            if (idx > 0) reorderDrinks(idx, idx - 1);
+          });
+        }
+
+        // Move Right
+        const moveRightBtn = card.querySelector('.move-right-btn');
+        if (moveRightBtn) {
+          moveRightBtn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const idx = currentDrinks.findIndex(d => d.id === id);
+            if (idx >= 0 && idx < currentDrinks.length - 1) reorderDrinks(idx, idx + 1);
+          });
+        }
+
+        // Remove
+        const removeBtn = card.querySelector('.remove-btn');
+        if (removeBtn) {
+          removeBtn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            removeDrinkCard(id);
+          });
+        }
+
+        // Customize Drawer Toggle
+        const customBtn = card.querySelector('.btn-customize');
+        const drawer = card.querySelector('.customizer-drawer');
+        if (customBtn && drawer) {
+          customBtn.addEventListener('click', () => {
+            const isOpen = drawer.classList.contains('open');
+            if (isOpen) {
+              drawer.classList.remove('open');
+              drawer.setAttribute('aria-hidden', 'true');
+              customBtn.classList.remove('active');
+              customBtn.setAttribute('aria-expanded', 'false');
+            } else {
+              drawer.classList.add('open');
+              drawer.setAttribute('aria-hidden', 'false');
+              customBtn.classList.add('active');
+              customBtn.setAttribute('aria-expanded', 'true');
+            }
+          });
+        }
+
+        // Close drawer button
+        const closeBtn = card.querySelector('.close-drawer-btn');
+        if (closeBtn && drawer && customBtn) {
+          closeBtn.addEventListener('click', () => {
+            drawer.classList.remove('open');
+            drawer.setAttribute('aria-hidden', 'true');
+            customBtn.classList.remove('active');
+            customBtn.setAttribute('aria-expanded', 'false');
+          });
+        }
+
+        // Reset Recipe button
+        const resetRecipeBtn = card.querySelector('.reset-recipe-btn');
+        if (resetRecipeBtn) {
+          resetRecipeBtn.addEventListener('click', () => {
+            const original = defaultDrinks.find(d => d.id === id) || additionalRoster.find(d => d.id === id);
+            if (original) {
+              drink.customization = clone(original.customization);
+              syncCardCustomizations(card, drink);
+            }
+          });
+        }
+
+        // Customization chips (Size, Milk, Sweetness, Temp)
+        setupChipGroup(card, '.opt-size', (val) => { drink.customization.size = val; syncCardCustomizations(card, drink); });
+        setupChipGroup(card, '.opt-milk', (val) => { drink.customization.milk = val; syncCardCustomizations(card, drink); });
+        setupChipGroup(card, '.opt-sweetness', (val) => { drink.customization.sweetness = val; syncCardCustomizations(card, drink); });
+        setupChipGroup(card, '.opt-temp', (val) => { drink.customization.temp = val; syncCardCustomizations(card, drink); });
+
+        // Add-ins checkboxes
+        const chkExtra = card.querySelector('.chk-extra-shot');
+        if (chkExtra) {
+          chkExtra.addEventListener('change', () => {
+            drink.customization.extraShot = chkExtra.checked;
+            syncCardCustomizations(card, drink);
+          });
+        }
+
+        const chkDecaf = card.querySelector('.chk-decaf');
+        if (chkDecaf) {
+          chkDecaf.addEventListener('change', () => {
+            drink.customization.decaf = chkDecaf.checked;
+            syncCardCustomizations(card, drink);
+          });
+        }
+
+        const chkWhip = card.querySelector('.chk-whip');
+        if (chkWhip) {
+          chkWhip.addEventListener('change', () => {
+            drink.customization.whip = chkWhip.checked;
+            syncCardCustomizations(card, drink);
+          });
+        }
+
+        // Drag & Drop
+        card.addEventListener('dragstart', (e) => {
+          draggedCardId = id;
+          card.classList.add('dragging');
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', id);
+        });
+
+        card.addEventListener('dragend', () => {
+          card.classList.remove('dragging');
+          gridEl.querySelectorAll('.card').forEach(c => c.classList.remove('drag-over'));
+          draggedCardId = null;
+        });
+
+        card.addEventListener('dragover', (e) => {
+          e.preventDefault();
+          if (draggedCardId && draggedCardId !== id) {
+            e.dataTransfer.dropEffect = 'move';
+            card.classList.add('drag-over');
+          }
+        });
+
+        card.addEventListener('dragleave', () => {
+          card.classList.remove('drag-over');
+        });
+
+        card.addEventListener('drop', (e) => {
+          e.preventDefault();
+          card.classList.remove('drag-over');
+          if (!draggedCardId || draggedCardId === id) return;
+
+          const fromIdx = currentDrinks.findIndex(d => d.id === draggedCardId);
+          const toIdx = currentDrinks.findIndex(d => d.id === id);
+          if (fromIdx !== -1 && toIdx !== -1) {
+            reorderDrinks(fromIdx, toIdx);
+          }
+        });
+      }
+
+      function setupChipGroup(card, selector, onChange) {
+        const group = card.querySelector(selector);
+        if (!group) return;
+        group.querySelectorAll('.opt-chip').forEach(chip => {
+          chip.addEventListener('click', () => {
+            group.querySelectorAll('.opt-chip').forEach(c => c.classList.remove('selected'));
+            chip.classList.add('selected');
+            onChange(chip.dataset.val);
+          });
+        });
+      }
+
+      // Synchronize Card Customization Display (price, badges, form controls)
+      function syncCardCustomizations(card, drink) {
+        const c = drink.customization;
+        const priceEl = card.querySelector('.price-tag');
+        if (priceEl) {
+          const newPrice = calculatePrice(drink);
+          if (priceEl.textContent !== newPrice) {
+            priceEl.textContent = newPrice;
+            priceEl.classList.remove('updated');
+            void priceEl.offsetWidth; // Force reflow
+            priceEl.classList.add('updated');
+          }
+        }
+
+        const tagsContainer = card.querySelector('.custom-tags');
+        if (tagsContainer) {
+          tagsContainer.innerHTML = `
+            <span class="custom-pill pill-size">${c.size}</span>
+            ${c.milk !== 'None' ? `<span class="custom-pill pill-milk">${c.milk}</span>` : ''}
+            <span class="custom-pill pill-temp">${c.temp}</span>
+            <span class="custom-pill pill-sweetness">${c.sweetness}</span>
+            ${c.extraShot ? `<span class="custom-pill pill-extra">+1 Shot</span>` : ''}
+            ${c.decaf ? `<span class="custom-pill pill-extra">Decaf</span>` : ''}
+            ${c.whip ? `<span class="custom-pill pill-extra">Whip</span>` : ''}
+          `;
+        }
+
+        // Sync inputs in drawer if needed
+        syncDrawerControls(card, c);
+      }
+
+      function syncDrawerControls(card, c) {
+        const setChip = (selector, val) => {
+          const group = card.querySelector(selector);
+          if (group) {
+            group.querySelectorAll('.opt-chip').forEach(ch => {
+              if (ch.dataset.val === val) ch.classList.add('selected');
+              else ch.classList.remove('selected');
+            });
+          }
+        };
+
+        setChip('.opt-size', c.size);
+        setChip('.opt-milk', c.milk);
+        setChip('.opt-sweetness', c.sweetness);
+        setChip('.opt-temp', c.temp);
+
+        const chkExtra = card.querySelector('.chk-extra-shot');
+        if (chkExtra) chkExtra.checked = !!c.extraShot;
+
+        const chkDecaf = card.querySelector('.chk-decaf');
+        if (chkDecaf) chkDecaf.checked = !!c.decaf;
+
+        const chkWhip = card.querySelector('.chk-whip');
+        if (chkWhip) chkWhip.checked = !!c.whip;
+      }
+
+      // Self-Contained FLIP Transition Engine
+      // Allows smooth, concurrent transitions for individual cards
+      function runFlipTransition(domMutationFn) {
+        // 1. FIRST: Measure initial bounding rect of all non-removing cards
+        const cards = Array.from(gridEl.querySelectorAll('.card:not(.removing)'));
+        const firstPositions = new Map();
+        cards.forEach(card => {
+          firstPositions.set(card.dataset.id, card.getBoundingClientRect());
+        });
+
+        // 2. Perform DOM layout mutation
+        domMutationFn();
+
+        // 3. LAST: Measure new positions after mutation
+        requestAnimationFrame(() => {
+          const updatedCards = Array.from(gridEl.querySelectorAll('.card:not(.removing)'));
+          updatedCards.forEach((card, idx) => {
+            const id = card.dataset.id;
+            const firstRect = firstPositions.get(id);
+
+            // Update move buttons state
+            const moveLeft = card.querySelector('.move-left-btn');
+            const moveRight = card.querySelector('.move-right-btn');
+            if (moveLeft) moveLeft.disabled = (idx === 0);
+            if (moveRight) moveRight.disabled = (idx === updatedCards.length - 1);
+
+            if (!firstRect) return; // New card entering
+
+            const lastRect = card.getBoundingClientRect();
+            const dx = firstRect.left - lastRect.left;
+            const dy = firstRect.top - lastRect.top;
+
+            if (dx !== 0 || dy !== 0) {
+              // INVERT: Snap back to first position visually without transition
+              card.style.transition = 'none';
+              card.style.transform = `translate(${dx}px, ${dy}px)`;
+
+              // Trigger reflow
+              void card.offsetHeight;
+
+              // PLAY: Smoothly transition to new position (0, 0)
+              requestAnimationFrame(() => {
+                card.style.transition = 'transform 320ms cubic-bezier(0.2, 0, 0, 1)';
+                card.style.transform = '';
+
+                const onEnd = () => {
+                  card.style.transition = '';
+                  card.removeEventListener('transitionend', onEnd);
+                };
+                card.addEventListener('transitionend', onEnd, { once: true });
+              });
+            }
+          });
+        });
+      }
+
+      // Reorder cards with smooth FLIP
+      function reorderDrinks(fromIndex, toIndex) {
+        if (fromIndex === toIndex || fromIndex < 0 || toIndex < 0 ||
+            fromIndex >= currentDrinks.length || toIndex >= currentDrinks.length) {
+          return;
+        }
+
+        const [movedDrink] = currentDrinks.splice(fromIndex, 1);
+        currentDrinks.splice(toIndex, 0, movedDrink);
+
+        runFlipTransition(() => {
+          const cardNodes = Array.from(gridEl.querySelectorAll('.card:not(.removing)'));
+          const movedCard = cardNodes.find(c => c.dataset.id === movedDrink.id);
+          if (movedCard) {
+            if (toIndex === currentDrinks.length - 1) {
+              gridEl.appendChild(movedCard);
+            } else {
+              const targetCard = cardNodes.find(c => c.dataset.id === currentDrinks[toIndex > fromIndex ? toIndex + 1 : toIndex].id);
+              if (targetCard) {
+                gridEl.insertBefore(movedCard, targetCard);
+              } else {
+                gridEl.appendChild(movedCard);
+              }
+            }
+          }
+        });
+      }
+
+      // Remove a card with exit transition and concurrent sibling FLIP
+      function removeDrinkCard(id) {
+        const cardEl = gridEl.querySelector(`.card[data-id="${id}"]:not(.removing)`);
+        if (!cardEl) return;
+
+        // Position card absolutely during exit animation so remaining cards immediately reflow
+        const cardRect = cardEl.getBoundingClientRect();
+        const gridRect = gridEl.getBoundingClientRect();
+
+        cardEl.classList.add('removing');
+        cardEl.style.position = 'absolute';
+        cardEl.style.width = cardRect.width + 'px';
+        cardEl.style.height = cardRect.height + 'px';
+        cardEl.style.left = (cardRect.left - gridRect.left) + 'px';
+        cardEl.style.top = (cardRect.top - gridRect.top) + 'px';
+        cardEl.style.zIndex = '10';
+
+        // Remove from data array
+        currentDrinks = currentDrinks.filter(d => d.id !== id);
+
+        // Animate remaining cards into their new layout positions
+        runFlipTransition(() => {
+          // Check if all drinks are removed
+          if (currentDrinks.length === 0) {
+            renderEmptyState();
+          }
+        });
+
+        // After exit animation finishes, remove element
+        const cleanUp = () => {
+          if (cardEl.parentNode) cardEl.parentNode.removeChild(cardEl);
+        };
+        cardEl.addEventListener('transitionend', cleanUp, { once: true });
+        setTimeout(cleanUp, 350);
+      }
+
+      // Add a drink (from removed items or extra seasonal roster)
+      function addSeasonalDrink() {
+        const existingIds = new Set(currentDrinks.map(d => d.id));
+        
+        // Check if any default drinks are missing
+        let candidate = defaultDrinks.find(d => !existingIds.has(d.id));
+        
+        // Otherwise pick from additional seasonal roster
+        if (!candidate) {
+          candidate = additionalRoster.find(d => !existingIds.has(d.id));
+        }
+
+        // If all are already present, duplicate with unique timestamp
+        if (!candidate) {
+          const base = defaultDrinks[0];
+          candidate = clone(base);
+          candidate.id = base.id + '-' + Date.now();
+          candidate.name = base.name + ' (Special)';
+        } else {
+          candidate = clone(candidate);
+        }
+
+        currentDrinks.push(candidate);
+
+        // Remove empty state if present
+        const emptyState = gridEl.querySelector('.empty-state');
+        if (emptyState) emptyState.remove();
+
+        const newCard = createCardElement(candidate, currentDrinks.length - 1, currentDrinks.length);
+        newCard.classList.add('entering');
+
+        runFlipTransition(() => {
+          gridEl.appendChild(newCard);
+        });
+
+        setTimeout(() => {
+          newCard.classList.remove('entering');
+        }, 400);
+      }
+
+      // Reset all seasonal drinks to default order and recipes
+      function resetAllDrinks() {
+        currentDrinks = clone(defaultDrinks);
+        renderFullGrid();
+      }
+
+      // Render Empty State
+      function renderEmptyState() {
+        const empty = document.createElement('div');
+        empty.className = 'empty-state';
+        empty.innerHTML = `
+          <h3>All seasonal favorites removed</h3>
+          <p>Curate your list by adding items or restore the default seasonal menu.</p>
+          <button type="button" class="ctrl-btn accent" id="restore-empty-btn">Restore Seasonal Menu</button>
+        `;
+        empty.querySelector('#restore-empty-btn').addEventListener('click', resetAllDrinks);
+        gridEl.appendChild(empty);
+      }
+
+      // Full Grid Render
+      function renderFullGrid() {
+        gridEl.innerHTML = '';
+        currentDrinks.forEach((drink, idx) => {
+          const card = createCardElement(drink, idx, currentDrinks.length);
+          gridEl.appendChild(card);
+        });
+      }
+
+      // Initial Mount
+      renderFullGrid();
+
+      // Top Control Bar Events
+      if (addBtn) addBtn.addEventListener('click', addSeasonalDrink);
+      if (resetBtn) resetBtn.addEventListener('click', resetAllDrinks);
+    })();
+  </script>
 </body>
 
 </html>
