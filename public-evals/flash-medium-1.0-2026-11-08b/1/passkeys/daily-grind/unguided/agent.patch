diff --git a/css/account.css b/css/account.css
new file mode 100644
index 0000000..40ce662
--- /dev/null
+++ b/css/account.css
@@ -0,0 +1,837 @@
+/* The Daily Grind - My Account & Passkeys CSS */
+
+:root {
+  --primary-dark: #3e2723;
+  --primary-light: #5d4037;
+  --accent-hover: #ff9100;
+  --success: #2e7d32;
+  --success-bg: #e8f5e9;
+  --warning: #ef6c00;
+  --warning-bg: #fff3e0;
+  --danger: #c62828;
+  --danger-bg: #ffebee;
+  --border-color: #e0d7d3;
+  --card-bg: #ffffff;
+  --radius-sm: 6px;
+  --radius-md: 10px;
+  --radius-lg: 16px;
+  --shadow-sm: 0 2px 4px rgba(62, 39, 35, 0.08);
+  --shadow-md: 0 4px 12px rgba(62, 39, 35, 0.12);
+  --shadow-lg: 0 12px 32px rgba(62, 39, 35, 0.2);
+}
+
+/* Nav user chip */
+.nav-user-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  background: rgba(255, 255, 255, 0.15);
+  padding: 4px 12px;
+  border-radius: 20px;
+  font-size: 0.88rem;
+  border: 1px solid rgba(255, 255, 255, 0.25);
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.nav-user-chip:hover {
+  background: rgba(255, 255, 255, 0.25);
+  border-color: var(--accent);
+}
+
+.nav-user-chip .chip-avatar {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: var(--accent);
+  color: var(--primary);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: bold;
+  font-size: 0.75rem;
+}
+
+/* Modal Overlay & Backdrop */
+.account-modal-overlay {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(30, 20, 18, 0.65);
+  backdrop-filter: blur(4px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 2000;
+  padding: 20px;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 0.25s ease, visibility 0.25s ease;
+}
+
+.account-modal-overlay.active {
+  opacity: 1;
+  visibility: visible;
+}
+
+.account-modal-container {
+  background: var(--card-bg);
+  width: 100%;
+  max-width: 680px;
+  max-height: 90vh;
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-lg);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  transform: translateY(16px) scale(0.98);
+  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
+  border: 1px solid var(--border-color);
+}
+
+.account-modal-overlay.active .account-modal-container {
+  transform: translateY(0) scale(1);
+}
+
+/* Modal Header */
+.account-modal-header {
+  background: var(--primary);
+  color: white;
+  padding: 1.25rem 1.75rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border-bottom: 2px solid var(--accent);
+}
+
+.account-header-title {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.account-header-title svg {
+  fill: var(--accent);
+}
+
+.account-header-title h2 {
+  font-size: 1.35rem;
+  font-weight: 700;
+  letter-spacing: 0.5px;
+}
+
+.account-header-title p {
+  font-size: 0.82rem;
+  opacity: 0.85;
+}
+
+.modal-close-btn {
+  background: rgba(255, 255, 255, 0.12);
+  border: none;
+  color: white;
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  font-size: 1.1rem;
+  transition: background 0.2s;
+}
+
+.modal-close-btn:hover {
+  background: rgba(255, 255, 255, 0.25);
+  color: var(--accent);
+}
+
+/* Modal Body */
+.account-modal-body {
+  padding: 1.5rem 1.75rem;
+  overflow-y: auto;
+  flex: 1;
+}
+
+/* Navigation Tabs */
+.account-tabs {
+  display: flex;
+  border-bottom: 2px solid var(--secondary);
+  margin-bottom: 1.5rem;
+  gap: 8px;
+}
+
+.tab-btn {
+  background: none;
+  border: none;
+  padding: 10px 16px;
+  font-size: 0.92rem;
+  font-weight: 600;
+  color: var(--text);
+  cursor: pointer;
+  border-bottom: 3px solid transparent;
+  margin-bottom: -2px;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  transition: all 0.2s;
+  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
+}
+
+.tab-btn:hover {
+  color: var(--primary);
+  background: rgba(215, 204, 200, 0.2);
+}
+
+.tab-btn.active {
+  color: var(--primary);
+  border-bottom-color: var(--accent);
+  background: rgba(255, 171, 64, 0.1);
+}
+
+.tab-badge {
+  background: var(--accent);
+  color: var(--primary);
+  font-size: 0.72rem;
+  font-weight: 700;
+  padding: 2px 7px;
+  border-radius: 12px;
+}
+
+/* Tab Panels */
+.tab-panel {
+  display: none;
+  animation: fadeIn 0.2s ease-in-out;
+}
+
+.tab-panel.active {
+  display: block;
+}
+
+@keyframes fadeIn {
+  from { opacity: 0; transform: translateY(4px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* Passkey Banner / Explainer */
+.passkey-explainer-banner {
+  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
+  border-left: 4px solid var(--accent);
+  padding: 14px 16px;
+  border-radius: var(--radius-md);
+  margin-bottom: 1.5rem;
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+}
+
+.passkey-explainer-banner svg {
+  flex-shrink: 0;
+  width: 24px;
+  height: 24px;
+  fill: var(--primary);
+  margin-top: 2px;
+}
+
+.passkey-explainer-text h4 {
+  font-size: 0.95rem;
+  color: var(--primary);
+  margin-bottom: 4px;
+}
+
+.passkey-explainer-text p {
+  font-size: 0.84rem;
+  color: var(--text);
+  line-height: 1.4;
+}
+
+/* Forms */
+.form-group {
+  margin-bottom: 1.25rem;
+}
+
+.form-group label {
+  display: block;
+  font-size: 0.88rem;
+  font-weight: 600;
+  color: var(--primary);
+  margin-bottom: 6px;
+}
+
+.form-group .form-hint {
+  font-size: 0.78rem;
+  color: #795548;
+  margin-top: 4px;
+}
+
+.form-control {
+  width: 100%;
+  padding: 10px 14px;
+  border: 1.5px solid var(--border-color);
+  border-radius: var(--radius-md);
+  font-size: 0.95rem;
+  color: var(--text);
+  background: #fdfdfd;
+  transition: border-color 0.2s, box-shadow 0.2s;
+  font-family: inherit;
+}
+
+.form-control:focus {
+  outline: none;
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.25);
+  background: white;
+}
+
+/* Buttons */
+.btn-primary {
+  background: var(--primary);
+  color: white;
+  border: none;
+  padding: 11px 22px;
+  border-radius: var(--radius-md);
+  font-weight: 600;
+  font-size: 0.95rem;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  transition: background 0.2s, transform 0.1s;
+  box-shadow: var(--shadow-sm);
+  width: 100%;
+}
+
+.btn-primary:hover {
+  background: var(--primary-dark);
+}
+
+.btn-primary:active {
+  transform: scale(0.99);
+}
+
+.btn-secondary {
+  background: var(--secondary);
+  color: var(--primary);
+  border: none;
+  padding: 9px 18px;
+  border-radius: var(--radius-md);
+  font-weight: 600;
+  font-size: 0.88rem;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  transition: background 0.2s;
+}
+
+.btn-secondary:hover {
+  background: #c7b299;
+}
+
+.btn-outline {
+  background: transparent;
+  border: 1.5px solid var(--primary);
+  color: var(--primary);
+  padding: 8px 16px;
+  border-radius: var(--radius-md);
+  font-weight: 600;
+  font-size: 0.85rem;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  transition: all 0.2s;
+}
+
+.btn-outline:hover {
+  background: var(--primary);
+  color: white;
+}
+
+.btn-danger-outline {
+  background: transparent;
+  border: 1px solid var(--danger);
+  color: var(--danger);
+  padding: 5px 10px;
+  border-radius: var(--radius-sm);
+  font-size: 0.8rem;
+  font-weight: 600;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  transition: all 0.2s;
+}
+
+.btn-danger-outline:hover {
+  background: var(--danger);
+  color: white;
+}
+
+.btn-sm {
+  padding: 5px 12px;
+  font-size: 0.82rem;
+}
+
+/* Passkey Cards List */
+.passkeys-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 1rem;
+}
+
+.passkeys-header h3 {
+  font-size: 1.05rem;
+  color: var(--primary);
+}
+
+.passkey-card {
+  background: #ffffff;
+  border: 1.5px solid var(--border-color);
+  border-radius: var(--radius-md);
+  padding: 14px 16px;
+  margin-bottom: 12px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.passkey-card:hover {
+  border-color: #bcaaa4;
+  box-shadow: var(--shadow-sm);
+}
+
+.passkey-card.primary-passkey {
+  border-left: 4px solid var(--accent);
+}
+
+.passkey-info-wrap {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.passkey-icon-bubble {
+  width: 42px;
+  height: 42px;
+  border-radius: 50%;
+  background: rgba(255, 171, 64, 0.18);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--primary);
+  flex-shrink: 0;
+}
+
+.passkey-details h4 {
+  font-size: 0.95rem;
+  color: var(--primary);
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.passkey-tag {
+  font-size: 0.7rem;
+  background: #efebe9;
+  color: var(--primary);
+  padding: 2px 6px;
+  border-radius: 4px;
+  font-weight: 600;
+}
+
+.passkey-meta {
+  font-size: 0.78rem;
+  color: #795548;
+  margin-top: 3px;
+  display: flex;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.passkey-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+/* Inline Passkey Rename */
+.passkey-rename-form {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 6px;
+}
+
+.passkey-rename-input {
+  padding: 4px 8px;
+  font-size: 0.85rem;
+  border: 1px solid var(--accent);
+  border-radius: var(--radius-sm);
+  width: 180px;
+}
+
+/* User Account Summary Card */
+.user-profile-summary {
+  background: linear-gradient(135deg, #efebe9 0%, #d7ccc8 100%);
+  padding: 16px 20px;
+  border-radius: var(--radius-md);
+  margin-bottom: 1.5rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.summary-user-data {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.summary-avatar {
+  width: 48px;
+  height: 48px;
+  border-radius: 50%;
+  background: var(--primary);
+  color: var(--accent);
+  font-size: 1.3rem;
+  font-weight: bold;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: var(--shadow-sm);
+}
+
+.summary-user-text h3 {
+  font-size: 1.15rem;
+  color: var(--primary);
+}
+
+.summary-user-text p {
+  font-size: 0.84rem;
+  color: #5d4037;
+}
+
+.loyalty-badge {
+  background: var(--accent);
+  color: var(--primary);
+  padding: 6px 12px;
+  border-radius: 20px;
+  font-size: 0.8rem;
+  font-weight: 700;
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+
+/* Security & Reauth Card */
+.security-status-card {
+  background: white;
+  border: 1.5px solid var(--border-color);
+  border-radius: var(--radius-md);
+  padding: 16px;
+  margin-bottom: 1.25rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.security-status-info {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.security-status-icon {
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.status-verified {
+  background: var(--success-bg);
+  color: var(--success);
+}
+
+.status-warning {
+  background: var(--warning-bg);
+  color: var(--warning);
+}
+
+.security-status-text h4 {
+  font-size: 0.95rem;
+  color: var(--primary);
+}
+
+.security-status-text p {
+  font-size: 0.8rem;
+  color: #6d4c41;
+}
+
+/* Audit Log List */
+.audit-log-list {
+  list-style: none;
+  margin-top: 10px;
+}
+
+.audit-log-item {
+  padding: 10px 12px;
+  border-bottom: 1px solid #f0eae6;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 0.83rem;
+}
+
+.audit-log-item:last-child {
+  border-bottom: none;
+}
+
+.audit-log-action {
+  font-weight: 600;
+  color: var(--primary);
+}
+
+.audit-log-time {
+  color: #8d6e63;
+  font-size: 0.75rem;
+}
+
+/* Quick User Picker (Known accounts on this device) */
+.quick-accounts-section {
+  margin-bottom: 1.25rem;
+  padding-bottom: 1.25rem;
+  border-bottom: 1px dashed var(--secondary);
+}
+
+.quick-accounts-title {
+  font-size: 0.82rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  color: #795548;
+  letter-spacing: 0.5px;
+  margin-bottom: 10px;
+}
+
+.quick-account-pill {
+  background: #f5f0ec;
+  border: 1px solid var(--border-color);
+  padding: 8px 12px;
+  border-radius: var(--radius-md);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  cursor: pointer;
+  transition: all 0.2s;
+  margin-bottom: 8px;
+}
+
+.quick-account-pill:hover {
+  background: #ebe4df;
+  border-color: var(--accent);
+}
+
+.quick-account-left {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.quick-account-avatar {
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  background: var(--primary);
+  color: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 0.82rem;
+  font-weight: 700;
+}
+
+.quick-account-name {
+  font-weight: 600;
+  font-size: 0.88rem;
+  color: var(--primary);
+}
+
+.quick-account-email {
+  font-size: 0.75rem;
+  color: #8d6e63;
+}
+
+/* Toast Notifications */
+.toast-container {
+  position: fixed;
+  bottom: 24px;
+  right: 24px;
+  z-index: 3000;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  pointer-events: none;
+}
+
+.toast-msg {
+  pointer-events: auto;
+  min-width: 280px;
+  max-width: 420px;
+  padding: 12px 18px;
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow-md);
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 0.9rem;
+  font-weight: 500;
+  color: white;
+  animation: slideInUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
+  transition: opacity 0.25s, transform 0.25s;
+}
+
+.toast-msg.toast-success {
+  background: #2e7d32;
+  border-left: 5px solid #81c784;
+}
+
+.toast-msg.toast-info {
+  background: var(--primary);
+  border-left: 5px solid var(--accent);
+}
+
+.toast-msg.toast-error {
+  background: #c62828;
+  border-left: 5px solid #ef9a9a;
+}
+
+.toast-msg.toast-fadeout {
+  opacity: 0;
+  transform: translateY(12px);
+}
+
+@keyframes slideInUp {
+  from { opacity: 0; transform: translateY(16px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* Reauthentication Dedicated Modal Overlay */
+.reauth-modal-overlay {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(30, 20, 18, 0.75);
+  backdrop-filter: blur(4px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 2500;
+  padding: 20px;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 0.2s ease, visibility 0.2s ease;
+}
+
+.reauth-modal-overlay.active {
+  opacity: 1;
+  visibility: visible;
+}
+
+.reauth-dialog {
+  background: white;
+  width: 100%;
+  max-width: 480px;
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-lg);
+  padding: 24px;
+  text-align: center;
+  border: 2px solid var(--accent);
+}
+
+.reauth-icon-bubble {
+  width: 64px;
+  height: 64px;
+  border-radius: 50%;
+  background: rgba(255, 171, 64, 0.2);
+  color: var(--primary);
+  margin: 0 auto 16px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.reauth-dialog h3 {
+  font-size: 1.25rem;
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.reauth-dialog p {
+  font-size: 0.88rem;
+  color: #5d4037;
+  margin-bottom: 20px;
+  line-height: 1.5;
+}
+
+.reauth-actions {
+  display: flex;
+  gap: 12px;
+  justify-content: center;
+}
+
+.reauth-actions button {
+  flex: 1;
+}
+
+/* Hero Quick Sign-In/Account Prompt */
+.hero-account-cta {
+  margin-top: 18px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  background: rgba(255, 255, 255, 0.2);
+  backdrop-filter: blur(6px);
+  padding: 8px 16px;
+  border-radius: 30px;
+  color: white;
+  font-size: 0.88rem;
+  border: 1px solid rgba(255, 255, 255, 0.35);
+  cursor: pointer;
+  text-decoration: none;
