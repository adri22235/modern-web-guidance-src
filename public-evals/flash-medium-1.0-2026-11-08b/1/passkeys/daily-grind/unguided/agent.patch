diff --git a/js/account-store.js b/js/account-store.js
new file mode 100644
index 0000000..c3c5c96
--- /dev/null
+++ b/js/account-store.js
@@ -0,0 +1,364 @@
+/**
+ * The Daily Grind - Account Store & Persistence
+ * Manages customer accounts, saved passkey metadata, and authentication sessions in localStorage.
+ */
+
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.DailyGrindStore = factory();
+  }
+})(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  const STORAGE_KEYS = {
+    USERS: 'daily_grind_users_v1',
+    SESSION: 'daily_grind_session_v1',
+    AUDIT: 'daily_grind_audit_log_v1'
+  };
+
+  const memoryFallback = {};
+
+  // Safe localStorage helper with in-memory fallback (e.g. Node / sandboxed environments)
+  function getStorageItem(key) {
+    try {
+      if (typeof localStorage !== 'undefined') {
+        const raw = localStorage.getItem(key);
+        return raw ? JSON.parse(raw) : null;
+      }
+      return memoryFallback[key] ? JSON.parse(memoryFallback[key]) : null;
+    } catch (e) {
+      console.error('Storage read error for', key, e);
+      return null;
+    }
+  }
+
+  function setStorageItem(key, value) {
+    try {
+      const serialized = JSON.stringify(value);
+      if (typeof localStorage !== 'undefined') {
+        localStorage.setItem(key, serialized);
+      } else {
+        memoryFallback[key] = serialized;
+      }
+    } catch (e) {
+      console.error('Storage write error for', key, e);
+    }
+  }
+
+  function removeStorageItem(key) {
+    try {
+      if (typeof localStorage !== 'undefined') {
+        localStorage.removeItem(key);
+      } else {
+        delete memoryFallback[key];
+      }
+    } catch (e) {
+      console.error('Storage remove error for', key, e);
+    }
+  }
+
+  // Pre-seed demo customer if store is empty
+  function seedDefaultIfEmpty() {
+    const existing = getStorageItem(STORAGE_KEYS.USERS);
+    if (!existing || !Array.isArray(existing) || existing.length === 0) {
+      const demoUser = {
+        id: 'usr_demo_101',
+        name: 'Elena Rostova',
+        email: 'elena@dailygrind.coffee',
+        favoriteCoffee: 'Maple Oat Latte',
+        rewardsPoints: 240,
+        memberTier: 'Gold Roaster',
+        memberSince: 'October 2026',
+        createdAt: new Date(Date.now() - 14 * 86400000).toISOString(),
+        passkeys: [
+          {
+            id: 'cred_demo_touchid_01',
+            name: 'MacBook Pro (Touch ID)',
+            deviceType: 'platform',
+            createdAt: new Date(Date.now() - 14 * 86400000).toISOString(),
+            lastUsedAt: new Date(Date.now() - 3600000).toISOString(),
+            transports: ['internal'],
+            simulated: true
+          },
+          {
+            id: 'cred_demo_iphone_02',
+            name: 'iPhone 16 Pro (Face ID)',
+            deviceType: 'platform',
+            createdAt: new Date(Date.now() - 5 * 86400000).toISOString(),
+            lastUsedAt: new Date(Date.now() - 86400000).toISOString(),
+            transports: ['internal'],
+            simulated: true
+          }
+        ]
+      };
+      setStorageItem(STORAGE_KEYS.USERS, [demoUser]);
+      recordAuditLog(demoUser.id, 'Account initialized', 'Welcome to The Daily Grind with Passkeys');
+    }
+  }
+
+  function getUsers() {
+    seedDefaultIfEmpty();
+    return getStorageItem(STORAGE_KEYS.USERS) || [];
+  }
+
+  function getUserById(id) {
+    const users = getUsers();
+    return users.find(u => u.id === id) || null;
+  }
+
+  function getUserByEmail(email) {
+    if (!email) return null;
+    const clean = email.trim().toLowerCase();
+    const users = getUsers();
+    return users.find(u => u.email.toLowerCase() === clean) || null;
+  }
+
+  function getUserByPasskeyId(credId) {
+    if (!credId) return null;
+    const users = getUsers();
+    return users.find(u => u.passkeys && u.passkeys.some(p => p.id === credId)) || null;
+  }
+
+  function createUser({ name, email, favoriteCoffee = 'Maple Oat Latte', passkey }) {
+    const users = getUsers();
+    const cleanEmail = email.trim().toLowerCase();
+
+    if (users.some(u => u.email.toLowerCase() === cleanEmail)) {
+      throw new Error(`An account with email "${cleanEmail}" already exists.`);
+    }
+
+    const userId = 'usr_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 6);
+    const initialPasskey = {
+      id: passkey.id,
+      name: passkey.name || 'Primary Passkey',
+      deviceType: passkey.deviceType || 'platform',
+      createdAt: passkey.createdAt || new Date().toISOString(),
+      lastUsedAt: passkey.lastUsedAt || new Date().toISOString(),
+      transports: passkey.transports || ['internal'],
+      simulated: !!passkey.simulated
+    };
+
+    const newUser = {
+      id: userId,
+      name: name.trim(),
+      email: cleanEmail,
+      favoriteCoffee: favoriteCoffee || 'Dark Roast Espresso',
+      rewardsPoints: 50, // Welcome bonus
+      memberTier: 'Roaster Member',
+      memberSince: new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' }),
+      createdAt: new Date().toISOString(),
+      passkeys: [initialPasskey]
+    };
+
+    users.push(newUser);
+    setStorageItem(STORAGE_KEYS.USERS, users);
+    recordAuditLog(userId, 'Account Registered', `Created account with initial passkey: ${initialPasskey.name}`);
+    return newUser;
+  }
+
+  function updateUser(userId, updates) {
+    const users = getUsers();
+    const idx = users.findIndex(u => u.id === userId);
+    if (idx === -1) throw new Error('Customer account not found.');
+
+    const user = users[idx];
+
+    // Check if email changed and if it collides
+    if (updates.email && updates.email.trim().toLowerCase() !== user.email.toLowerCase()) {
+      const cleanEmail = updates.email.trim().toLowerCase();
+      if (users.some(u => u.id !== userId && u.email.toLowerCase() === cleanEmail)) {
+        throw new Error(`The email address "${cleanEmail}" is already in use by another account.`);
+      }
+      user.email = cleanEmail;
+      recordAuditLog(userId, 'Email Updated', `Changed email to ${cleanEmail}`);
+    }
+
+    if (updates.name) {
+      user.name = updates.name.trim();
+    }
+    if (updates.favoriteCoffee) {
+      user.favoriteCoffee = updates.favoriteCoffee;
+    }
+
+    users[idx] = user;
+    setStorageItem(STORAGE_KEYS.USERS, users);
+    recordAuditLog(userId, 'Profile Updated', 'Customer profile details were updated');
+    return user;
+  }
+
+  function addPasskey(userId, passkey) {
+    const users = getUsers();
+    const idx = users.findIndex(u => u.id === userId);
+    if (idx === -1) throw new Error('Customer account not found.');
+
+    const user = users[idx];
+    user.passkeys = user.passkeys || [];
+
+    // Check if passkey with same id already exists
+    if (user.passkeys.some(p => p.id === passkey.id)) {
+      throw new Error('This passkey is already registered to your account.');
+    }
+
+    const newPasskey = {
+      id: passkey.id,
+      name: passkey.name || `Passkey #${user.passkeys.length + 1}`,
+      deviceType: passkey.deviceType || 'platform',
+      createdAt: passkey.createdAt || new Date().toISOString(),
+      lastUsedAt: passkey.lastUsedAt || new Date().toISOString(),
+      transports: passkey.transports || ['internal'],
+      simulated: !!passkey.simulated
+    };
+
+    user.passkeys.push(newPasskey);
+    users[idx] = user;
+    setStorageItem(STORAGE_KEYS.USERS, users);
+    recordAuditLog(userId, 'Passkey Added', `Added passkey: ${newPasskey.name}`);
+    return newPasskey;
+  }
+
+  function renamePasskey(userId, passkeyId, newName) {
+    const users = getUsers();
+    const idx = users.findIndex(u => u.id === userId);
+    if (idx === -1) throw new Error('Customer account not found.');
+
+    const user = users[idx];
+    const passkey = (user.passkeys || []).find(p => p.id === passkeyId);
+    if (!passkey) throw new Error('Passkey not found on this account.');
+
+    const oldName = passkey.name;
+    passkey.name = newName.trim();
+    users[idx] = user;
+    setStorageItem(STORAGE_KEYS.USERS, users);
+    recordAuditLog(userId, 'Passkey Renamed', `Renamed "${oldName}" to "${passkey.name}"`);
+    return passkey;
+  }
+
+  function deletePasskey(userId, passkeyId) {
+    const users = getUsers();
+    const idx = users.findIndex(u => u.id === userId);
+    if (idx === -1) throw new Error('Customer account not found.');
+
+    const user = users[idx];
+    user.passkeys = user.passkeys || [];
+    const passkeyToDelete = user.passkeys.find(p => p.id === passkeyId);
+    if (!passkeyToDelete) throw new Error('Passkey not found on this account.');
+
+    if (user.passkeys.length <= 1) {
+      throw new Error('Cannot delete your only saved passkey. Please add another passkey first.');
+    }
+
+    user.passkeys = user.passkeys.filter(p => p.id !== passkeyId);
+    users[idx] = user;
+    setStorageItem(STORAGE_KEYS.USERS, users);
+    recordAuditLog(userId, 'Passkey Deleted', `Removed passkey: ${passkeyToDelete.name}`);
+    return true;
+  }
+
+  function recordPasskeyUsage(userId, passkeyId) {
+    const users = getUsers();
+    const user = users.find(u => u.id === userId);
+    if (!user) return;
+    const passkey = (user.passkeys || []).find(p => p.id === passkeyId);
+    if (passkey) {
+      passkey.lastUsedAt = new Date().toISOString();
+      setStorageItem(STORAGE_KEYS.USERS, users);
+    }
+  }
+
+  // Session management
+  function getCurrentSession() {
+    return getStorageItem(STORAGE_KEYS.SESSION);
+  }
+
+  function getCurrentUser() {
+    const session = getCurrentSession();
+    if (!session || !session.userId) return null;
+    return getUserById(session.userId);
+  }
+
+  function setCurrentSession(userId, passkeyId = null) {
+    const now = new Date().toISOString();
+    const session = {
+      userId,
+      passkeyId,
+      authenticatedAt: now,
+      lastReauthenticatedAt: now
+    };
+    setStorageItem(STORAGE_KEYS.SESSION, session);
+    if (passkeyId) {
+      recordPasskeyUsage(userId, passkeyId);
+    }
+    recordAuditLog(userId, 'Sign In', 'Authenticated successfully with passkey');
+    return session;
+  }
+
+  function clearSession() {
+    const current = getCurrentUser();
+    if (current) {
+      recordAuditLog(current.id, 'Logout', 'User signed out');
+    }
+    removeStorageItem(STORAGE_KEYS.SESSION);
+  }
+
+  function recordReauthentication(userId) {
+    const session = getCurrentSession();
+    if (session && session.userId === userId) {
+      session.lastReauthenticatedAt = new Date().toISOString();
+      setStorageItem(STORAGE_KEYS.SESSION, session);
+    }
+    recordAuditLog(userId, 'Reauthentication', 'Identity re-verified with passkey');
+  }
+
+  function isRecentlyReauthenticated(userId, maxAgeMinutes = 15) {
+    const session = getCurrentSession();
+    if (!session || session.userId !== userId || !session.lastReauthenticatedAt) {
+      return false;
+    }
+    const elapsedMs = Date.now() - new Date(session.lastReauthenticatedAt).getTime();
+    return elapsedMs <= maxAgeMinutes * 60 * 1000;
+  }
+
+  // Audit logging
+  function recordAuditLog(userId, action, details) {
+    const logs = getStorageItem(STORAGE_KEYS.AUDIT) || [];
+    logs.unshift({
+      id: 'log_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 4),
+      userId,
+      action,
+      details,
+      timestamp: new Date().toISOString()
+    });
+    // Keep last 50 logs
+    setStorageItem(STORAGE_KEYS.AUDIT, logs.slice(0, 50));
+  }
+
+  function getAuditLogs(userId) {
+    const logs = getStorageItem(STORAGE_KEYS.AUDIT) || [];
+    return logs.filter(l => l.userId === userId);
+  }
+
+  // Initialize
+  seedDefaultIfEmpty();
+
+  return {
+    getUsers,
+    getUserById,
+    getUserByEmail,
+    getUserByPasskeyId,
+    createUser,
+    updateUser,
+    addPasskey,
+    renamePasskey,
+    deletePasskey,
+    getCurrentUser,
+    getCurrentSession,
+    setCurrentSession,
+    clearSession,
+    recordReauthentication,
+    isRecentlyReauthenticated,
+    recordPasskeyUsage,
+    getAuditLogs
+  };
+});
