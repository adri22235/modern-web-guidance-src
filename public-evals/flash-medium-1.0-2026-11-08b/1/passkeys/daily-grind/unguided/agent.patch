+/**
+ * Verification test for The Daily Grind Passkeys implementation
+ */
+const assert = require('assert');
+const Store = require('./js/account-store.js');
+const Auth = require('./js/passkey-auth.js');
+
+async function runTests() {
+  console.log('--- 1. Testing Initial Store State ---');
+  let users = Store.getUsers();
+  assert(users.length >= 1, 'Should have initial demo user');
+  const demoUser = users[0];
+  console.log(`Initial demo user: ${demoUser.name} (${demoUser.email}) with ${demoUser.passkeys.length} passkeys`);
+
+  console.log('\n--- 2. Testing Customer Registration with Passkey ---');
+  const regEmail = 'sarah.connor@dailygrind.coffee';
+  const regPasskey = await Auth.registerPasskey({
+    userId: 'usr_sarah_1',
+    email: regEmail,
+    displayName: 'Sarah Connor',
+    passkeyName: 'iPhone 16 (Face ID)'
+  });
+
+  assert(regPasskey.id, 'Passkey must have an id');
+  assert.strictEqual(regPasskey.name, 'iPhone 16 (Face ID)', 'Passkey label should match');
+
+  const registeredUser = Store.createUser({
+    name: 'Sarah Connor',
+    email: regEmail,
+    favoriteCoffee: 'Maple Oat Latte',
+    passkey: regPasskey
+  });
+
+  assert.strictEqual(registeredUser.email, regEmail);
+  assert.strictEqual(registeredUser.passkeys.length, 1);
+  console.log(`Registered user: ${registeredUser.name} with passkey ID: ${regPasskey.id}`);
+
+  console.log('\n--- 3. Testing Sign-In Authentication with Passkey ---');
+  const authResult = await Auth.authenticatePasskey({
+    allowedPasskeys: registeredUser.passkeys,
+    userHint: registeredUser.email
+  });
+
+  assert(authResult.verified, 'Passkey authentication must succeed');
+  Store.setCurrentSession(registeredUser.id, authResult.credentialId);
+
+  const currentUser = Store.getCurrentUser();
+  assert(currentUser, 'Current user should be set');
+  assert.strictEqual(currentUser.id, registeredUser.id, 'Logged in user ID must match');
+  console.log(`Successfully authenticated as: ${currentUser.name}`);
+
+  console.log('\n--- 4. Testing Saved Passkey Management (Add, Rename, Delete) ---');
+  // Add second passkey
+  const yubikey = await Auth.registerPasskey({
+    userId: currentUser.id,
+    email: currentUser.email,
+    displayName: currentUser.name,
+    passkeyName: 'YubiKey 5 NFC'
+  });
+  Store.addPasskey(currentUser.id, yubikey);
+
+  let updatedUser = Store.getUserById(currentUser.id);
+  assert.strictEqual(updatedUser.passkeys.length, 2, 'Should now have 2 passkeys');
+  console.log(`Added second passkey: ${yubikey.name}`);
+
+  // Rename passkey
+  Store.renamePasskey(currentUser.id, yubikey.id, 'Work YubiKey 5 NFC');
+  updatedUser = Store.getUserById(currentUser.id);
+  const renamedKey = updatedUser.passkeys.find(p => p.id === yubikey.id);
+  assert.strictEqual(renamedKey.name, 'Work YubiKey 5 NFC', 'Passkey should be renamed');
+  console.log(`Renamed passkey to: ${renamedKey.name}`);
+
+  // Delete passkey
+  Store.deletePasskey(currentUser.id, yubikey.id);
+  updatedUser = Store.getUserById(currentUser.id);
+  assert.strictEqual(updatedUser.passkeys.length, 1, 'Should have 1 passkey after deletion');
+  console.log(`Successfully deleted passkey, remaining: ${updatedUser.passkeys.length}`);
+
+  // Test single passkey deletion protection
+  assert.throws(() => {
+    Store.deletePasskey(currentUser.id, regPasskey.id);
+  }, /Cannot delete your only saved passkey/, 'Should prevent deleting only passkey');
+  console.log('Single passkey deletion protection confirmed');
+
+  console.log('\n--- 5. Testing Profile Updates ---');
+  Store.updateUser(currentUser.id, {
+    name: 'Sarah J. Connor',
+    favoriteCoffee: 'Dark Roast Espresso'
+  });
+  updatedUser = Store.getUserById(currentUser.id);
+  assert.strictEqual(updatedUser.name, 'Sarah J. Connor');
+  assert.strictEqual(updatedUser.favoriteCoffee, 'Dark Roast Espresso');
+  console.log(`Updated profile: Name=${updatedUser.name}, Coffee=${updatedUser.favoriteCoffee}`);
+
+  console.log('\n--- 6. Testing Reauthentication ---');
+  // Reauth verification check
+  assert(Store.isRecentlyReauthenticated(currentUser.id), 'Should be recently reauthenticated on sign-in');
+
+  // Perform reauth
+  const reauthRes = await Auth.authenticatePasskey({
+    allowedPasskeys: updatedUser.passkeys
+  });
+  assert(reauthRes.verified, 'Reauthentication passkey verification must succeed');
+  Store.recordReauthentication(currentUser.id);
+  console.log('Reauthentication recorded successfully');
+
+  // Verify email update with reauth protection
+  const newEmail = 'sarah.updated@dailygrind.coffee';
+  Store.updateUser(currentUser.id, { email: newEmail });
+  updatedUser = Store.getUserById(currentUser.id);
+  assert.strictEqual(updatedUser.email, newEmail);
+  console.log(`Updated email after reauth to: ${updatedUser.email}`);
+
+  // Check audit log
+  const auditLogs = Store.getAuditLogs(currentUser.id);
+  assert(auditLogs.length > 0, 'Audit logs must be recorded');
+  console.log(`Audit log entries for user: ${auditLogs.length}`);
+
+  console.log('\n--- 7. Testing Logout ---');
+  Store.clearSession();
+  assert.strictEqual(Store.getCurrentUser(), null, 'Current user should be null after logout');
+  console.log('Logout successful');
+
+  console.log('\n=============================================');
+  console.log('PASSKEYS TEST SUITE: ALL VERIFICATIONS PASSED');
+  console.log('=============================================');
+}
+
+runTests().catch(err => {
+  console.error('Test failed with error:', err);
+  process.exit(1);
+});
