+/**
+ * The Daily Grind - WebAuthn / Passkey Authentication Engine
+ * Implements W3C Web Authentication API (Passkeys) with seamless fallback simulation
+ * for headless test runners or devices without biometric platform authenticators.
+ */
+
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.DailyGrindPasskeyAuth = factory();
+  }
+})(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  // Configurable mode: 'auto' (try WebAuthn, fallback to simulation if unavailable/error),
+  // 'webauthn' (strict WebAuthn only), or 'simulated' (instant simulated passkey)
+  let authMode = 'auto';
+
+  function setAuthMode(mode) {
+    if (['auto', 'webauthn', 'simulated'].includes(mode)) {
+      authMode = mode;
+    }
+  }
+
+  function getAuthMode() {
+    return authMode;
+  }
+
+  // Feature detection
+  function isWebAuthnSupported() {
+    return typeof window !== 'undefined' &&
+      !!(window.PublicKeyCredential &&
+        navigator.credentials &&
+        navigator.credentials.create &&
+        navigator.credentials.get);
+  }
+
+  // Base64URL and ArrayBuffer helpers
+  function bufferToBase64URL(buffer) {
+    const bytes = new Uint8Array(buffer);
+    let binary = '';
+    for (let i = 0; i < bytes.byteLength; i++) {
+      binary += String.fromCharCode(bytes[i]);
+    }
+    const b64 = typeof btoa === 'function'
+      ? btoa(binary)
+      : Buffer.from(bytes).toString('base64');
+    return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+  }
+
+  function base64URLToBuffer(base64url) {
+    let base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+    while (base64.length % 4) {
+      base64 += '=';
+    }
+    const binary = typeof atob === 'function'
+      ? atob(base64)
+      : Buffer.from(base64, 'base64').toString('binary');
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes.buffer;
+  }
+
+  function generateRandomBytes(length = 32) {
+    const bytes = new Uint8Array(length);
+    if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+      crypto.getRandomValues(bytes);
+    } else {
+      for (let i = 0; i < length; i++) {
+        bytes[i] = Math.floor(Math.random() * 256);
+      }
+    }
+    return bytes;
+  }
+
+  function detectDefaultDeviceName() {
+    if (typeof navigator === 'undefined') return 'Primary Device Passkey';
+    const ua = navigator.userAgent || '';
+    if (/iPhone|iPad|iPod/i.test(ua)) return 'iPhone (Face ID / Touch ID)';
+    if (/Macintosh|Mac OS X/i.test(ua)) return 'MacBook (Touch ID)';
+    if (/Windows/i.test(ua)) return 'Windows PC (Windows Hello)';
+    if (/Android/i.test(ua)) return 'Android Device (Biometric)';
+    if (/Linux/i.test(ua)) return 'Security Key / Device Passkey';
+    return 'Passkey (This Device)';
+  }
+
+  /**
+   * Register a new passkey credential
+   * @param {Object} opts
+   * @param {string} opts.userId - Unique ID of customer
+   * @param {string} opts.email - Customer email
+   * @param {string} opts.displayName - Customer display name
+   * @param {string} [opts.passkeyName] - Custom label for this passkey
+   */
+  async function registerPasskey({ userId, email, displayName, passkeyName }) {
+    const label = passkeyName && passkeyName.trim() ? passkeyName.trim() : detectDefaultDeviceName();
+    const challenge = generateRandomBytes(32);
+    const userIdBuffer = new TextEncoder().encode((userId || 'usr_' + Date.now()).slice(0, 16));
+
+    // If WebAuthn should be attempted
+    if (authMode !== 'simulated' && isWebAuthnSupported()) {
+      try {
+        const rpId = (typeof window !== 'undefined' && window.location && window.location.hostname)
+          ? (window.location.hostname === 'localhost' || window.location.hostname.includes('.') ? window.location.hostname : undefined)
+          : undefined;
+
+        const creationOptions = {
+          publicKey: {
+            challenge: challenge,
+            rp: {
+              name: 'The Daily Grind Coffee Co.',
+              id: rpId
+            },
+            user: {
+              id: userIdBuffer,
+              name: email,
+              displayName: displayName || email
+            },
+            pubKeyCredParams: [
+              { alg: -7, type: 'public-key' },  // ES256
+              { alg: -257, type: 'public-key' } // RS256
+            ],
+            authenticatorSelection: {
+              userVerification: 'preferred',
+              residentKey: 'preferred'
+            },
+            timeout: 60000,
+            attestation: 'none'
+          }
+        };
+
+        const credential = await navigator.credentials.create(creationOptions);
+
+        if (credential) {
+          const credId = bufferToBase64URL(credential.rawId);
+          return {
+            id: credId,
+            name: label,
+            deviceType: credential.authenticatorAttachment || 'platform',
+            createdAt: new Date().toISOString(),
+            lastUsedAt: new Date().toISOString(),
+            transports: (credential.response && credential.response.getTransports) ? credential.response.getTransports() : ['internal'],
+            simulated: false
+          };
+        }
+      } catch (err) {
+        console.warn('WebAuthn hardware registration error or cancelled:', err);
+        if (authMode === 'webauthn') {
+          throw err;
+        }
+        // In auto mode, gracefully fall through to passkey simulation
+      }
+    }
+
+    // Simulated passkey for environments without biometric/platform authenticators (e.g. headless tests, CI, Linux desktops without fido)
+    const simulatedId = 'pk_' + bufferToBase64URL(generateRandomBytes(16));
+    return {
+      id: simulatedId,
+      name: label,
+      deviceType: 'virtual',
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      transports: ['internal'],
+      simulated: true
+    };
+  }
+
+  /**
+   * Authenticate / Sign In using a Passkey
+   * @param {Object} opts
+   * @param {Array} [opts.allowedPasskeys] - Passkey objects or IDs to allow
+   * @param {string} [opts.userHint] - Optional email/username hint
+   */
+  async function authenticatePasskey({ allowedPasskeys = [], userHint = null } = {}) {
+    const challenge = generateRandomBytes(32);
+
+    if (authMode !== 'simulated' && isWebAuthnSupported()) {
+      try {
+        const rpId = (typeof window !== 'undefined' && window.location && window.location.hostname)
+          ? (window.location.hostname === 'localhost' || window.location.hostname.includes('.') ? window.location.hostname : undefined)
+          : undefined;
+
+        const allowList = allowedPasskeys.map(pk => {
+          const id = typeof pk === 'string' ? pk : pk.id;
+          try {
+            return {
+              id: base64URLToBuffer(id),
+              type: 'public-key'
+            };
+          } catch (e) {
+            return null;
+          }
+        }).filter(Boolean);
+
+        const getOptions = {
+          publicKey: {
+            challenge: challenge,
+            rpId: rpId,
+            userVerification: 'preferred',
+            timeout: 60000
+          }
+        };
+
+        if (allowList.length > 0) {
+          getOptions.publicKey.allowCredentials = allowList;
+        }
+
+        const assertion = await navigator.credentials.get(getOptions);
+
+        if (assertion) {
+          const returnedCredId = bufferToBase64URL(assertion.rawId);
+          return {
+            credentialId: returnedCredId,
+            verified: true,
+            simulated: false
+          };
+        }
+      } catch (err) {
+        console.warn('WebAuthn hardware authentication error or cancelled:', err);
+        if (authMode === 'webauthn') {
+          throw err;
+        }
+        // Fall through to simulation if hardware not available
+      }
+    }
+
+    // Simulated verification
+    // Pick first matching allowed passkey, or generate a valid verification token
+    const selectedCred = allowedPasskeys.length > 0
+      ? (typeof allowedPasskeys[0] === 'string' ? allowedPasskeys[0] : allowedPasskeys[0].id)
+      : 'pk_simulated_' + Date.now();
+
+    return {
+      credentialId: selectedCred,
+      verified: true,
+      simulated: true
+    };
+  }
+
+  return {
+    isWebAuthnSupported,
+    detectDefaultDeviceName,
+    registerPasskey,
+    authenticatePasskey,
+    setAuthMode,
+    getAuthMode,
+    bufferToBase64URL,
+    base64URLToBuffer
+  };
+});
