+        showToast('Identity confirmed with passkey!', 'success');
+        closeReauthModal();
+
+        if (typeof pendingReauthAction === 'function') {
+          const action = pendingReauthAction;
+          pendingReauthAction = null;
+          await action();
+        } else {
+          renderAccountModal();
+        }
+      } else {
+        throw new Error('Passkey verification was not completed.');
+      }
+    } catch (err) {
+      console.error('Reauthentication failed:', err);
+      showToast('Reauthentication failed: ' + (err.message || 'Cancelled'), 'error');
+    } finally {
+      const confirmBtn = document.getElementById('reauth-confirm-btn');
+      if (confirmBtn) {
+        confirmBtn.disabled = false;
+        confirmBtn.innerHTML = `${ICONS.key} Verify Passkey`;
+      }
+    }
+  }
