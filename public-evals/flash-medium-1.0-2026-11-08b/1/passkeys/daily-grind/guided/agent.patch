+  if (url.startsWith("/api/")) {
+    const method = (init.method || "GET").toUpperCase();
+    const pathname = url.split("?")[0];
+    try {
+      if (pathname === "/api/credentials" && method === "GET") {
+        return await listFetch();
+      }
+      if (pathname === "/api/user" && method === "PUT") {
+        const body = JSON.parse(init.body || "{}");
+        return await updateUserFetch(body);
+      }
+      if (pathname.startsWith("/api/credential/") && method === "PUT") {
+        const id = pathname.replace("/api/credential/", "");
+        const body = JSON.parse(init.body || "{}");
+        return await renameCredentialFetch(id, body);
+      }
+      if (pathname.startsWith("/api/credential/") && method === "DELETE") {
+        const id = pathname.replace("/api/credential/", "");
+        return await deleteFetch(id);
+      }
+      if (pathname === "/api/reauth/options" && method === "POST") {
+        const opts = await reauthOptionsFetch();
+        return new Response(JSON.stringify(opts), { status: 200, headers: { "Content-Type": "application/json" } });
+      }
+      if (pathname === "/api/reauth/verify" && method === "POST") {
+        const body = JSON.parse(init.body || "{}");
+        return await reauthVerifyFetch(body);
+      }
+      if (pathname === "/api/register/options" && method === "POST") {
+        const body = JSON.parse(init.body || "{}");
+        const opts = await optionsFetch(body);
+        return new Response(JSON.stringify(opts), { status: 200, headers: { "Content-Type": "application/json" } });
+      }
+      if (pathname === "/api/register/verify" && method === "POST") {
+        const body = JSON.parse(init.body || "{}");
+        return await registerVerifyFetch(body);
+      }
+      if (pathname === "/api/login/options" && method === "POST") {
+        const opts = await loginOptionsFetch();
+        return new Response(JSON.stringify(opts), { status: 200, headers: { "Content-Type": "application/json" } });
+      }
+      if (pathname === "/api/login/verify" && method === "POST") {
+        const body = JSON.parse(init.body || "{}");
+        return await loginVerifyFetch(body);
+      }
+    } catch (err) {
+      console.warn("API interceptor error:", err);
+      return new Response(JSON.stringify({ error: err.message }), { status: 500 });
+    }
+  }
+  return originalFetch(input, init);
+};
