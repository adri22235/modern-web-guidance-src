+
+  if (signoutBtn) signoutBtn.addEventListener('click', performSignOut);
+  if (navLogout) navLogout.addEventListener('click', performSignOut);
+
+  // Nav account link - smooth scroll / focus to Account section
+  const navAccount = document.getElementById('nav-account-link');
+  if (navAccount) {
+    navAccount.addEventListener('click', (e) => {
+      const accountSection = document.getElementById('account');
+      if (accountSection) {
+        accountSection.scrollIntoView({ behavior: 'smooth' });
+      }
+    });
+  }
+}
+
+// Initial load trigger
+window.addEventListener('DOMContentLoaded', async () => {
+  initAccountUI();
+  await loadManagementPanel();
