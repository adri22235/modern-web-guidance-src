+  if (!updatedName || !updatedDisplayName) return;
+
+  try {
+    const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+    if (response.ok) {
+      const data = await response.json();
+      const { rpId, userId } = data;
