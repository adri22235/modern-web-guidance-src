+// Backend & API Service for WebAuthn Passkeys adhering to modern-web-guidance
+import { getProviderInfoFromAaguid } from './aaguids.js';
+
+// Base64URL helper utilities
+export function isValidBase64Url(value) {
+  return typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export function bufferToBase64Url(buffer) {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export function stringToBase64Url(str) {
+  return bufferToBase64Url(new TextEncoder().encode(str));
+}
+
+export function generateRandomChallenge() {
+  const bytes = new Uint8Array(32);
+  crypto.getRandomValues(bytes);
+  return bufferToBase64Url(bytes);
+}
+
+// Server Relying Party configuration
+// Always configured on server and returned in options / API responses
+function getServerRpId() {
+  return window.location.hostname || 'localhost';
+}
+
+const STORAGE_KEYS = {
+  USERS: 'daily_grind_users',
+  CREDENTIALS: 'daily_grind_credentials',
+  SESSION: 'daily_grind_session',
+  CHALLENGES: 'daily_grind_challenges'
+};
+
+// Seed initial demo data with strictly valid unpadded Base64URL IDs
+function initDatabase() {
+  let users = [];
+  let credentials = [];
+
+  try {
+    const rawUsers = localStorage.getItem(STORAGE_KEYS.USERS);
+    const rawCreds = localStorage.getItem(STORAGE_KEYS.CREDENTIALS);
+    if (rawUsers && rawCreds) {
+      users = JSON.parse(rawUsers);
+      credentials = JSON.parse(rawCreds);
+    }
+  } catch (e) {
+    console.warn('Storage read warning:', e);
+  }
+
+  // Pre-seed sample user if storage is empty
+  if (!users || users.length === 0) {
+    const sampleUserId = stringToBase64Url('user-jane-doe'); // 'dXNlci1qYW5lLWRvZQ'
+    const sampleCredId = stringToBase64Url('cred-icloud-01'); // 'Y3JlZC1pY2xvdWQtMDE'
+
+    const sampleUser = {
+      id: 'user_1',
+      passkeyUserId: sampleUserId,
+      name: 'jane@dailygrind.coffee',
+      displayName: 'Jane Doe'
+    };
+
+    const providerInfo = getProviderInfoFromAaguid('dd41221f-818b-4221-a477-17637a28469d');
+    const sampleCred = {
+      id: sampleCredId,
+      passkeyUserId: sampleUser.id,
+      credentialPublicKey: stringToBase64Url('public-key-placeholder'),
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid: 'dd41221f-818b-4221-a477-17637a28469d',
+      providerIcon: providerInfo.providerIcon,
+      name: 'iCloud Keychain (MacBook Pro)',
+      transports: ['internal', 'hybrid'],
+      registeredAt: Date.now() - 86400000 * 3,
+      lastUsedAt: Date.now() - 3600000 * 2,
+      counter: 12
+    };
+
+    users = [sampleUser];
+    credentials = [sampleCred];
+    saveUsers(users);
+    saveCredentials(credentials);
+  }
+
+  return { users, credentials };
+}
+
+function getUsers() {
+  try {
+    return JSON.parse(localStorage.getItem(STORAGE_KEYS.USERS)) || [];
+  } catch {
+    return [];
+  }
+}
+
+function saveUsers(users) {
+  try {
+    localStorage.setItem(STORAGE_KEYS.USERS, JSON.stringify(users));
+  } catch (e) {
+    console.warn('saveUsers warning:', e);
+  }
+}
+
+function getCredentials() {
+  try {
+    return JSON.parse(localStorage.getItem(STORAGE_KEYS.CREDENTIALS)) || [];
+  } catch {
+    return [];
+  }
+}
+
+function saveCredentials(creds) {
+  try {
+    localStorage.setItem(STORAGE_KEYS.CREDENTIALS, JSON.stringify(creds));
+  } catch (e) {
+    console.warn('saveCredentials warning:', e);
+  }
+}
+
+export function getCurrentSessionUser() {
+  try {
+    const sessionUserId = localStorage.getItem(STORAGE_KEYS.SESSION);
+    if (!sessionUserId) return null;
+    const users = getUsers();
+    return users.find(u => u.id === sessionUserId) || null;
+  } catch {
+    return null;
+  }
+}
+
+export function setCurrentSessionUser(user) {
+  try {
+    if (user) {
+      localStorage.setItem(STORAGE_KEYS.SESSION, user.id);
+    } else {
+      localStorage.removeItem(STORAGE_KEYS.SESSION);
+    }
+  } catch (e) {
+    console.warn('setSessionUser warning:', e);
+  }
