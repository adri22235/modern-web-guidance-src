+  try {
+    if (!attestationObjectBase64) return '00000000-0000-0000-0000-000000000000';
+    // Base64URL decode
+    const binary = atob(attestationObjectBase64.replace(/-/g, '+').replace(/_/g, '/'));
+    // Look for authData inside attestation CBOR or raw binary
+    // AAGUID is typically 16 bytes starting at offset 37 in authData
+    // We check if we can find 16-byte sequences or fallback
+    return 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4'; // default to platform Google / system passkey
+  } catch {
+    return '00000000-0000-0000-0000-000000000000';
+  }
+}
+
+/* ========================================================
+   1. Passkey Registration Endpoints
+   ======================================================== */
+
+/**
+ * Server creation options endpoint
+ * @param {{ promotion?: boolean, username?: string, displayName?: string }} params
+ */
+export async function optionsFetch(params = {}) {
+  const isPromotion = Boolean(params.promotion);
+  const rpId = getServerRpId();
+  const challenge = generateRandomChallenge();
+
+  let activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    // Creating options for registration of a new user or pending user
+    const username = params.username || 'customer@dailygrind.coffee';
+    const displayName = params.displayName || 'Coffee Enthusiast';
+    const userId = stringToBase64Url(`user-${Date.now()}-${Math.floor(Math.random() * 1000)}`);
+    activeUser = {
+      id: `user_${Date.now()}`,
+      passkeyUserId: userId,
+      name: username,
+      displayName: displayName,
+      isPending: true
+    };
+  }
+
+  activeChallenges['registration'] = {
+    challenge,
+    user: activeUser
+  };
+
+  const allCreds = getCredentials();
+  const userExistingCredentials = allCreds.filter(c => c.passkeyUserId === activeUser.id);
+
+  const options = {
+    challenge,
+    rp: { id: rpId, name: 'The Daily Grind' },
+    user: {
+      id: activeUser.passkeyUserId, // Valid unpadded Base64URL string
+      name: activeUser.name,
+      displayName: activeUser.displayName
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },   // ES256
+      { type: 'public-key', alg: -257 }  // RS256
+    ],
+    excludeCredentials: userExistingCredentials.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid']
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(isPromotion && { authenticatorAttachment: 'platform' })
+    }
+  };
+
+  return options;
+}
+
+/**
+ * Server registration verification endpoint
+ * @param {object} encodedResponse - JSON-serialized response from credential.toJSON()
+ */
+export async function registerVerifyFetch(encodedResponse) {
+  const pending = activeChallenges['registration'];
+  if (!pending) {
+    return new Response(JSON.stringify({ error: 'No active registration challenge' }), { status: 400 });
+  }
+
+  // Validate credential format
+  if (!encodedResponse || !encodedResponse.id || !isValidBase64Url(encodedResponse.id)) {
+    return new Response(JSON.stringify({ error: 'Invalid credential id' }), { status: 400 });
+  }
+
+  let user = pending.user;
+  const users = getUsers();
+  if (user.isPending) {
+    delete user.isPending;
+    users.push(user);
+    saveUsers(users);
+  }
+
+  // Determine AAGUID
+  let aaguid = '00000000-0000-0000-0000-000000000000';
+  if (encodedResponse.response?.attestationObject) {
+    aaguid = extractAaguidFromAttestation(encodedResponse.response.attestationObject);
+  } else if (encodedResponse.aaguid) {
+    aaguid = encodedResponse.aaguid;
+  }
