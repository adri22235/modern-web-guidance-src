+} from './api.js';
+import { getProviderInfoFromAaguid } from './aaguids.js';
+
+// Abort controllers for WebAuthn mediation flows
+let autofillAbortController = new AbortController();
+let reauthAbortController = new AbortController();
+
+/* ========================================================
+   Capability Detection & Feature Flags
+   ======================================================== */
+
+export async function isPasskeySupported() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+export async function isConditionalGetSupported() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities.conditionalGet);
+  } catch {
+    return false;
+  }
+}
+
+/* ========================================================
+   Signal API Synchronization Helpers
+   ======================================================== */
+
+/**
+ * Synchronize all accepted credentials with password manager
+ * Uses server-provided rpId (never window.location.hostname)
+ */
+export async function syncAcceptedCredentials(rpId, userId, currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const credentialIds = currentCredentialsList.map(c => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.');
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds
+    });
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+/**
+ * Synchronize user profile updates with password manager
+ */
+export async function syncCurrentUserDetails(rpId, userId, updatedName, updatedDisplayName) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.');
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      name: updatedName,
+      displayName: updatedDisplayName
+    });
+  } catch (e) {
+    console.warn('SignalCurrentUserDetails sync warning:', e);
+  }
+}
+
+/* ========================================================
+   1. Passkey Registration
+   ======================================================== */
+
+/**
+ * Register a passkey for customer registration or from management settings
+ * @param {boolean} isPromotion - true if called immediately after signup/signin; false in management
+ * @param {{ username?: string, displayName?: string }} userInfo
+ */
+export async function registerPasskey(isPromotion = false, userInfo = {}) {
+  const statusEl = document.getElementById('account-status-msg');
+  const showStatus = (msg, isError = false) => {
+    if (statusEl) {
+      statusEl.textContent = msg;
+      statusEl.className = `status-msg ${isError ? 'error' : 'success'}`;
+    }
+  };
+
+  // Verify passkey capability and conditional UI on registration
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    showStatus('Passkeys are not supported on this browser. Please use standard password.', true);
+    return;
+  }
+
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+    showStandardPasswordFallbackUI();
+    showStatus('Passkeys are not supported on this browser. Please use standard password.', true);
+    return;
+  }
+
+  showStatus('Preparing passkey registration...');
+
+  let creationOptionsJSON;
+  try {
+    creationOptionsJSON = await optionsFetch({
+      promotion: isPromotion,
+      username: userInfo.username,
+      displayName: userInfo.displayName
+    });
+  } catch (err) {
+    console.error('Failed to fetch registration options:', err);
+    showStatus('Failed to start registration: ' + err.message, true);
+    return;
+  }
+
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showStatus('A passkey already exists for this account.', true);
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showStatus('Configuration RP ID or Secure Context error.', true);
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showStatus('Passkey registration was cancelled.', false);
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+      showStatus('Registration was aborted.', false);
+    } else {
+      console.error('WebAuthn creation error:', err);
+      showStatus('Registration error: ' + err.message, true);
+    }
+    return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+  }
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok && PublicKeyCredential.signalUnknownCredential) {
+      // Server verification failed to verify/authenticate the credential (orphaned)
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId: publicKey.rp.id, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+        credentialId: encodedResponse.id // Base64URL-encoded credential ID
+      });
+      showStatus('Server verification failed.', true);
+      return;
+    }
+
+    showStatus('Passkey registered successfully! Welcome to The Daily Grind.', false);
+    await loadManagementPanel();
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId: publicKey.rp.id, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+        credentialId: encodedResponse.id // Base64URL-encoded credential ID
+      });
+    }
+    showStatus('Server verification error. Please try again.', true);
+  }
+}
+
+function showStandardPasswordFallbackUI() {
+  const passkeyBtns = document.querySelectorAll('.passkey-only-btn');
+  passkeyBtns.forEach(btn => {
+    btn.hidden = true;
+  });
+  const fallbackNotice = document.getElementById('passkey-fallback-notice');
+  if (fallbackNotice) fallbackNotice.hidden = false;
+}
+
+/* ========================================================
+   2. Passkey Authentication (Button + Conditional UI)
+   ======================================================== */
+
+/**
+ * Initialize Conditional UI (Form Autofill suggestions)
+ */
+export async function initializeConditionalAutofill() {
+  if (getCurrentSessionUser()) {
+    // User already authenticated
+    return;
+  }
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    return;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (capabilities.conditionalGet === true) {
+      const loginOptionsJSON = await loginOptionsFetch();
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+      try {
+        // Initiate Conditional UI form autofill suggestions
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional'
+        });
+
+        if (!credential) return;
+
+        // Segregated verification fetch
+        const encoded = credential.toJSON();
+        const response = await loginVerifyFetch(encoded);
+        if (!response.ok && response.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+              credentialId: encoded.id
+            });
+          }
+          const statusEl = document.getElementById('account-status-msg');
+          if (statusEl) {
+            statusEl.textContent = 'Passkey not recognized.';
+            statusEl.className = 'status-msg error';
+          }
+          return;
+        }
+
+        if (response.ok) {
+          const statusEl = document.getElementById('account-status-msg');
+          if (statusEl) {
+            statusEl.textContent = 'Signed in with passkey successfully!';
+            statusEl.className = 'status-msg success';
+          }
+          await loadManagementPanel();
+        }
+      } catch (err) {
+        // Silently swallow expected client WebAuthn exceptions
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) {
+          return;
+        }
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+  } catch (err) {
+    console.warn('Conditional autofill init warning:', err);
+  }
+}
+
+/**
+ * Trigger explicit passkey sign-in button flow
+ */
+export async function triggerButtonAuthentication() {
+  const statusEl = document.getElementById('account-status-msg');
+  const showStatus = (msg, isError = false) => {
+    if (statusEl) {
+      statusEl.textContent = msg;
+      statusEl.className = `status-msg ${isError ? 'error' : 'success'}`;
+    }
+  };
+
+  showStatus('Signing in with passkey...');
+
+  // Abort any pending Conditional Get call to prevent passkey prompt collisions
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  let loginOptionsJSON;
+  try {
+    loginOptionsJSON = await loginOptionsFetch();
+  } catch (err) {
+    showStatus('Failed to retrieve login options.', true);
+    initializeConditionalAutofill();
+    return;
+  }
+
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      signal: autofillAbortController.signal
+    });
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      console.log('User cancelled passkey login.');
+      showStatus('Passkey sign-in was cancelled.', false);
+    } else if (err.name === 'AbortError') {
+      console.log('The authentication operation was aborted.');
+      showStatus('Passkey sign-in was aborted.', false);
+    } else {
+      console.error('WebAuthn get error:', err);
+      showStatus('Authentication error: ' + err.message, true);
+    }
+    // Re-arm Conditional autofill Suggestions after cancelled explicit button prompts
+    initializeConditionalAutofill();
+    return;
+  }
+
+  if (!credential) {
+    initializeConditionalAutofill();
+    return;
+  }
+
+  // Segregated verification try/catch (HTTP 404 trigger)
+  const encoded = credential.toJSON();
+  try {
+    const response = await loginVerifyFetch(encoded);
+    if (!response.ok && response.status === 404) {
+      if (PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+          credentialId: encoded.id // Base64URL-encoded credential ID
+        });
+      }
+      showStatus('Passkey credential not recognized on this account.', true);
+      initializeConditionalAutofill();
+      return;
+    }
+
+    if (response.ok) {
+      showStatus('Signed in successfully!', false);
+      await loadManagementPanel();
+    } else {
+      showStatus('Sign in failed. Please try again.', true);
+      initializeConditionalAutofill();
+    }
+  } catch (serverErr) {
+    console.error('Verification request error:', serverErr);
+    showStatus('Network error during verification.', true);
+    initializeConditionalAutofill();
+  }
+}
+
+/* ========================================================
+   3. Saved Passkey Management
+   ======================================================== */
+
+export async function loadManagementPanel() {
+  const activeUser = getCurrentSessionUser();
+  const unauthView = document.getElementById('account-unauth-view');
+  const authView = document.getElementById('account-auth-view');
+  const navAccount = document.getElementById('nav-account-link');
+  const navLogout = document.getElementById('nav-logout-link');
+
+  if (!activeUser) {
+    if (unauthView) unauthView.hidden = false;
+    if (authView) authView.hidden = true;
+    if (navAccount) navAccount.textContent = 'My Account';
+    if (navLogout) navLogout.hidden = true;
+    initializeConditionalAutofill();
+    return;
+  }
+
+  if (unauthView) unauthView.hidden = true;
+  if (authView) authView.hidden = false;
+  if (navAccount) navAccount.textContent = `Account (${activeUser.displayName || activeUser.name})`;
+  if (navLogout) navLogout.hidden = false;
+
+  // Populate profile fields
+  const usernameInput = document.getElementById('profile-username');
+  const displayNameInput = document.getElementById('profile-displayname');
+  const welcomeText = document.getElementById('account-welcome-text');
+
+  if (usernameInput) usernameInput.value = activeUser.name;
+  if (displayNameInput) displayNameInput.value = activeUser.displayName;
+  if (welcomeText) welcomeText.textContent = `Welcome back, ${activeUser.displayName || activeUser.name}!`;
+
+  // Check passkey creation capability to conditionally show/hide "Create passkey" button
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+  if (createPasskeyBtn) {
+    const supported = await isPasskeySupported();
+    createPasskeyBtn.hidden = !supported;
+  }
+
+  // Fetch credentials list
+  try {
+    const response = await listFetch();
+    if (!response.ok) {
+      console.warn('Failed to load passkey list:', response.status);
+      return;
+    }
+    const { rpId, userId, credentials } = await response.json();
+
+    renderCredentialsList(credentials);
+
+    // Sync accepted credentials on initial load using server-provided rpId and userId
+    await syncAcceptedCredentials(rpId, userId, credentials);
+  } catch (err) {
+    console.warn('Error loading management panel:', err);
+  }
+}
+
+function renderCredentialsList(credentials = []) {
+  const listContainer = document.getElementById('passkeys-list-container');
+  if (!listContainer) return;
+
+  if (credentials.length === 0) {
+    listContainer.innerHTML = '<div class="empty-state" data-testid="no-passkeys-msg">No passkeys found. Create one below to enable fast, passwordless sign-ins!</div>';
+    return;
+  }
+
+  listContainer.innerHTML = '';
+  const ul = document.createElement('ul');
+  ul.className = 'passkey-items-list';
+
+  credentials.forEach(cred => {
+    const li = document.createElement('li');
+    li.className = 'passkey-item card';
+    li.dataset.credentialId = cred.id;
+
+    // AAGUID lookup handling
+    let providerName = cred.name;
+    let providerIcon = cred.providerIcon;
+    if (!providerName || !providerIcon) {
+      const info = getProviderInfoFromAaguid(cred.aaguid);
+      providerName = providerName || info.name;
+      providerIcon = providerIcon || info.providerIcon;
+    }
+
+    const regDateStr = cred.registeredAt ? new Date(cred.registeredAt).toLocaleDateString(undefined, {
+      year: 'numeric', month: 'short', day: 'numeric'
+    }) : 'Unknown';
+
+    const lastUsedStr = cred.lastUsedAt ? new Date(cred.lastUsedAt).toLocaleDateString(undefined, {
