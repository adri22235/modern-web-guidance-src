+
+  const allCreds = getCredentials();
+  const userCredentials = allCreds.filter(c => c.passkeyUserId === activeUser.id);
+
+  return new Response(JSON.stringify({
+    rpId,
+    userId: activeUser.passkeyUserId, // Valid unpadded Base64URL string
+    credentials: userCredentials
+  }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Update custom nickname for a passkey
+ */
+export async function renameCredentialFetch(credentialId, { name }) {
+  const activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });
+  }
+
+  const credentials = getCredentials();
+  const cred = credentials.find(c => c.id === credentialId);
+  if (!cred || cred.passkeyUserId !== activeUser.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), { status: 404 });
+  }
+
+  cred.name = name;
+  saveCredentials(credentials);
+
+  return new Response(JSON.stringify(cred), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Delete a credential
+ */
+export async function deleteFetch(credentialId) {
+  const activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });
+  }
+
+  let credentials = getCredentials();
+  const cred = credentials.find(c => c.id === credentialId);
+  if (!cred || cred.passkeyUserId !== activeUser.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), { status: 404 });
+  }
+
+  credentials = credentials.filter(c => c.id !== credentialId);
+  saveCredentials(credentials);
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Update user profile details (username and displayName)
+ */
+export async function updateUserFetch({ name, displayName }) {
+  const activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });
+  }
+
+  const users = getUsers();
+  const user = users.find(u => u.id === activeUser.id);
+  if (!user) {
+    return new Response(JSON.stringify({ error: 'User not found' }), { status: 404 });
+  }
+
+  if (name) user.name = name;
+  if (displayName) user.displayName = displayName;
+  saveUsers(users);
+  setCurrentSessionUser(user);
+
+  return new Response(JSON.stringify({
+    ...user,
+    rpId: getServerRpId(),
+    userId: user.passkeyUserId // Valid unpadded Base64URL string
+  }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/* ========================================================
+   4. Passkey Reauthentication Endpoints
+   ======================================================== */
+
+/**
+ * Reauth options generation: strictly populates allowCredentials with signed-in user's credentials
+ */
+export async function reauthOptionsFetch() {
+  const activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });
+  }
+
+  const allCreds = getCredentials();
+  const userPasskeys = allCreds.filter(c => c.passkeyUserId === activeUser.id);
+
+  const challenge = generateRandomChallenge();
+  activeChallenges['reauth'] = {
+    challenge,
+    userId: activeUser.id
+  };
+
+  const options = {
+    challenge,
+    rpId: getServerRpId(),
+    allowCredentials: userPasskeys.map(cred => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid']
+    })),
+    userVerification: 'preferred'
+  };
+
+  return options;
+}
+
+/**
+ * Reauth verification: strictly checks credential ownership matches active user
+ */
+export async function reauthVerifyFetch(encodedCredential) {
+  const activeUser = getCurrentSessionUser();
+  if (!activeUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });
+  }
+
+  if (!encodedCredential || !encodedCredential.id) {
+    return new Response(JSON.stringify({ error: 'Invalid response' }), { status: 400 });
+  }
+
+  const credentials = getCredentials();
+  const cred = credentials.find(c => c.id === encodedCredential.id);
+
+  // If passkey is not found or belongs to a different user, reject
+  if (!cred || cred.passkeyUserId !== activeUser.id) {
+    return new Response(JSON.stringify({ error: 'Credential not verified for current user.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' }
+    });
+  }
+
+  cred.lastUsedAt = Date.now();
+  saveCredentials(credentials);
+  delete activeChallenges['reauth'];
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/* ========================================================
+   Fetch Interceptor for standard /api routes
+   ======================================================== */
+const originalFetch = window.fetch.bind(window);
+
+window.fetch = async function(input, init = {}) {
+  const url = typeof input === 'string' ? input : input instanceof URL ? input.toString() : input.url;
+
+  if (url.startsWith('/api/')) {
+    const method = (init.method || 'GET').toUpperCase();
+    const pathname = url.split('?')[0];
+
+    try {
+      if (pathname === '/api/credentials' && method === 'GET') {
+        return await listFetch();
+      }
+      if (pathname === '/api/user' && method === 'PUT') {
+        const body = JSON.parse(init.body || '{}');
+        return await updateUserFetch(body);
+      }
+      if (pathname.startsWith('/api/credential/') && method === 'PUT') {
+        const id = pathname.replace('/api/credential/', '');
+        const body = JSON.parse(init.body || '{}');
+        return await renameCredentialFetch(id, body);
+      }
+      if (pathname.startsWith('/api/credential/') && method === 'DELETE') {
+        const id = pathname.replace('/api/credential/', '');
+        return await deleteFetch(id);
+      }
+      if (pathname === '/api/reauth/options' && method === 'POST') {
+        const opts = await reauthOptionsFetch();
+        return new Response(JSON.stringify(opts), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      if (pathname === '/api/reauth/verify' && method === 'POST') {
+        const body = JSON.parse(init.body || '{}');
+        return await reauthVerifyFetch(body);
+      }
+      if (pathname === '/api/register/options' && method === 'POST') {
+        const body = JSON.parse(init.body || '{}');
+        const opts = await optionsFetch(body);
+        return new Response(JSON.stringify(opts), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      if (pathname === '/api/register/verify' && method === 'POST') {
+        const body = JSON.parse(init.body || '{}');
+        return await registerVerifyFetch(body);
+      }
+      if (pathname === '/api/login/options' && method === 'POST') {
+        const opts = await loginOptionsFetch();
+        return new Response(JSON.stringify(opts), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      if (pathname === '/api/login/verify' && method === 'POST') {
+        const body = JSON.parse(init.body || '{}');
+        return await loginVerifyFetch(body);
+      }
+    } catch (err) {
+      console.warn('API interceptor error:', err);
+      return new Response(JSON.stringify({ error: err.message }), { status: 500 });
+    }
+  }
+
+  return originalFetch(input, init);
+};
