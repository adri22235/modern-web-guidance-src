+ * @param {string} aaguid
+ * @returns {{ name: string, providerIcon: string | undefined }}
+ */
+export function getProviderInfoFromAaguid(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: DEFAULT_PASSKEY_ICON
+    };
+  }
+
+  const provider = AAGUID_REGISTRY[aaguid.toLowerCase()];
