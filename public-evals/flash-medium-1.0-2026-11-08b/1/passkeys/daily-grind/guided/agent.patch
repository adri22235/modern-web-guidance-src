+
+  let optionsJSON;
+  try {
+    optionsJSON = await reauthOptionsFetch();
+  } catch (err) {
+    showStatus('Failed to generate reauthentication challenge.');
+    return;
+  }
+
+  // Ensure allowCredentials is populated strictly with user's credentials
+  if (!optionsJSON.allowCredentials || optionsJSON.allowCredentials.length === 0) {
+    showStatus('No passkeys found for this user to reauthenticate.');
+    return;
+  }
