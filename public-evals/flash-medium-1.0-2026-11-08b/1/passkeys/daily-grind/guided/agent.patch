+    providerIcon: providerInfo.providerIcon,
+    name: providerInfo.name,
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    lastUsedAt: Date.now(),
+    registeredAt: Date.now(),
+    counter: 0
+  };
