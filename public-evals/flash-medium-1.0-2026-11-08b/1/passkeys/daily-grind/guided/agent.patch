+        statusEl.className = 'status-msg error';
+      }
+    }
+  } catch (err) {
+    console.error('Profile update error:', err);
+  }
+}
+
+/* ========================================================
+   5. Passkey Reauthentication (Step-Up Verification)
+   ======================================================== */
+
+export async function triggerButtonReauth() {
+  const reauthStatus = document.getElementById('reauth-status');
+  const showStatus = (msg, isSuccess = false) => {
+    if (reauthStatus) {
+      reauthStatus.textContent = msg;
+      reauthStatus.className = `status-msg ${isSuccess ? 'success' : 'error'}`;
+    }
+  };
+
+  showStatus('Prompting for reauthentication passkey...');
+
+  // Abort any background suggestion flows to avoid passkey prompt collisions
