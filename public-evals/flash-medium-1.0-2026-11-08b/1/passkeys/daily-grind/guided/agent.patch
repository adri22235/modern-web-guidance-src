+          rpId: publicKey.rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+          credentialId: encodedCredential.id
+        });
+        showStatus('Reauthentication failed: passkey not recognized.');
+      } else {
+        showStatus('Reauthentication verification failed.');
+      }
+    }
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      console.log('User cancelled reauthentication.');
+      showStatus('Reauthentication cancelled.');
+    } else {
+      console.error('Reauthentication error:', err);
+      showStatus('Reauthentication error: ' + err.message);
+    }
+  }
+}
+
+/* ========================================================
+   UI Setup & Event Handlers
+   ======================================================== */
+
+function escapeHtml(str) {
+  if (!str) return '';
+  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+}
