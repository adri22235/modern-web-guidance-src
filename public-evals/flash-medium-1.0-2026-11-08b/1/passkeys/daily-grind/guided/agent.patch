+  const credentials = getCredentials();
+  // Ensure no duplicate ID
+  const existingIdx = credentials.findIndex(c => c.id === newCredential.id);
+  if (existingIdx >= 0) {
+    credentials[existingIdx] = newCredential;
+  } else {
+    credentials.push(newCredential);
+  }
+  saveCredentials(credentials);
+
+  // Set session user
+  setCurrentSessionUser(user);
+  delete activeChallenges['registration'];
+
+  return new Response(JSON.stringify({ success: true, user, credential: newCredential }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/* ========================================================
+   2. Passkey Authentication Endpoints
+   ======================================================== */
+
+/**
+ * Server login options endpoint (discoverable flow)
+ */
+export async function loginOptionsFetch() {
+  const rpId = getServerRpId();
+  const challenge = generateRandomChallenge();
+
+  activeChallenges['login'] = {
+    challenge,
+    expectedUserVerification: 'preferred'
+  };
+
+  return {
+    challenge,
+    rpId,
+    allowCredentials: [], // Discoverable passkeys
+    userVerification: 'preferred'
+  };
+}
+
+/**
+ * Server login verification endpoint
+ * @param {object} encodedResponse - JSON-serialized response from credential.toJSON()
+ */
+export async function loginVerifyFetch(encodedResponse) {
+  if (!encodedResponse || !encodedResponse.id) {
+    return new Response(JSON.stringify({ error: 'Missing credential response' }), { status: 400 });
+  }
+
+  const credentials = getCredentials();
+  const cred = credentials.find(c => c.id === encodedResponse.id);
+
+  if (!cred) {
+    // Critical: Clean Server Error 404 triggers Signal API signalUnknownCredential on client
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
