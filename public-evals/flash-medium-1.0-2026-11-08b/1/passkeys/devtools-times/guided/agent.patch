+  const sessionUser = await session?.get('user');
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ user: null, rpId: getRpId(request) }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = findUserById(sessionUser.id);
+  const rpId = getRpId(request);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      rpId,
+      userId: user?.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
