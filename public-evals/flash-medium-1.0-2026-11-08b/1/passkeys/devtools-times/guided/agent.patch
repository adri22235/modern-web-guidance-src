+++ b/src/pages/api/reauth/verify.ts
@@ -0,0 +1,100 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findUserByCredentialId, findUserById, updateCredentialUsage } from '../../../utils/db';
+import { getRpId, getExpectedOrigin } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const sessionUser = await session?.get('user');
+    if (!sessionUser) {
+      return new Response(JSON.stringify({ error: 'Unauthorized: Session required for reauthentication' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const expectedChallenge = await session?.get('currentReauthChallenge');
+    if (!expectedChallenge) {
+      return new Response(JSON.stringify({ error: 'Missing or expired reauthentication challenge' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const credentialId = body.id;
+    if (!credentialId) {
+      return new Response(JSON.stringify({ error: 'Missing credential ID' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const match = findUserByCredentialId(credentialId);
+
+    // If credential not found, return explicit 404 to allow client to call signalUnknownCredential
+    if (!match) {
+      return new Response(JSON.stringify({ error: 'Credential not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { user, credential } = match;
+
+    // Delta Rule: Verify Account Ownership
+    // The verification endpoint MUST explicitly verify that the resulting authenticated credential ID
+    // returned by the client resolves to a stored credential record whose associated user ID strictly
+    // matches the active signed-in user (storedCredential.passkeyUserId === req.user.id).
+    // If a valid passkey of a different user is returned, authentication MUST be rejected immediately.
+    if (credential.passkeyUserId !== sessionUser.passkeyUserId && user.id !== sessionUser.id) {
+      return new Response(JSON.stringify({ error: 'Security violation: Credential belongs to another account' }), {
+        status: 403,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const expectedRPID = getRpId(request);
+    const expectedOrigin = getExpectedOrigin(request);
+
+    const verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID,
+      credential: {
+        id: credential.id,
+        publicKey: isoBase64URL.toBuffer(credential.credentialPublicKey),
+        counter: credential.counter,
+        transports: credential.transports as any,
+      },
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified) {
+      return new Response(JSON.stringify({ error: 'Reauthentication signature verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Update credential counter and lastUsedAt
+    updateCredentialUsage(credential.id, verification.authenticationInfo.newCounter);
+
+    // Clear reauth challenge and stamp reauth time
+    await session?.set('currentReauthChallenge', null);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(JSON.stringify({ verified: true, reauthenticatedAt: Date.now() }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Reauthentication verification error:', error);
+    return new Response(JSON.stringify({ error: error?.message || 'Server verification failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
