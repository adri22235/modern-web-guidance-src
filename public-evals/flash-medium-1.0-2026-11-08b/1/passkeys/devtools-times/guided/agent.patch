+++ b/src/utils/db.ts
@@ -0,0 +1,173 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (unpadded Base64URL)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string; // Nickname or provider name
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export interface User {
+  id: string; // Base64URL string
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // username
+  displayName: string;
+  password?: string;
+  credentials: StoredPasskeyCredential[];
+}
+
+export function isValidBase64Url(value: any): boolean {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export function generateBase64UrlId(prefix: string = ''): string {
+  const randomBytes = crypto.randomBytes(16);
+  if (prefix) {
+    const p = Buffer.from(prefix, 'utf8').toString('base64url');
+    return `${p}_${randomBytes.toString('base64url')}`;
+  }
+  return randomBytes.toString('base64url');
+}
+
+// In-memory + persistent storage
+const DB_DIR = path.resolve(process.cwd(), '.data');
+const DB_FILE = path.join(DB_DIR, 'users.json');
+
+let usersCache: Record<string, User> | null = null;
+
+function loadUsers(): Record<string, User> {
+  if (usersCache) return usersCache;
+  try {
+    if (!fs.existsSync(DB_DIR)) {
+      fs.mkdirSync(DB_DIR, { recursive: true });
+    }
+    if (fs.existsSync(DB_FILE)) {
+      const data = fs.readFileSync(DB_FILE, 'utf-8');
+      usersCache = JSON.parse(data);
+      return usersCache!;
+    }
+  } catch (err) {
+    console.warn('Failed to load users DB file, falling back to memory:', err);
+  }
+  usersCache = {};
+  return usersCache;
+}
+
+function saveUsers(): void {
+  if (!usersCache) return;
+  try {
+    if (!fs.existsSync(DB_DIR)) {
+      fs.mkdirSync(DB_DIR, { recursive: true });
+    }
+    fs.writeFileSync(DB_FILE, JSON.stringify(usersCache, null, 2), 'utf-8');
+  } catch (err) {
+    console.warn('Failed to write users DB file:', err);
+  }
+}
+
+export function findUserById(id: string): User | undefined {
+  const users = loadUsers();
+  return users[id] || Object.values(users).find(u => u.passkeyUserId === id);
+}
+
+export function findUserByUsername(username: string): User | undefined {
+  const users = loadUsers();
+  const normalized = username.trim().toLowerCase();
+  return Object.values(users).find(u => u.name.toLowerCase() === normalized);
+}
+
+export function findUserByCredentialId(credentialId: string): { user: User; credential: StoredPasskeyCredential } | undefined {
+  const users = loadUsers();
+  for (const user of Object.values(users)) {
+    const cred = user.credentials.find(c => c.id === credentialId);
+    if (cred) {
+      return { user, credential: cred };
+    }
+  }
+  return undefined;
+}
+
+export function createUser(data: { name: string; displayName?: string; password?: string }): User {
+  const users = loadUsers();
+  const base64UrlUserId = generateBase64UrlId();
+  const user: User = {
+    id: base64UrlUserId,
+    passkeyUserId: base64UrlUserId,
+    name: data.name.trim(),
+    displayName: data.displayName ? data.displayName.trim() : data.name.trim(),
+    password: data.password,
+    credentials: [],
+  };
+  users[user.id] = user;
+  saveUsers();
+  return user;
+}
+
+export function updateUserProfile(userId: string, updates: { name?: string; displayName?: string }): User | undefined {
+  const user = findUserById(userId);
+  if (!user) return undefined;
+  if (updates.name !== undefined) user.name = updates.name.trim();
+  if (updates.displayName !== undefined) user.displayName = updates.displayName.trim();
+  saveUsers();
+  return user;
+}
+
+export function addCredential(userId: string, credential: StoredPasskeyCredential): boolean {
+  const user = findUserById(userId);
+  if (!user) return false;
+  // Ensure no duplicate credential ID
+  const existingIdx = user.credentials.findIndex(c => c.id === credential.id);
+  if (existingIdx >= 0) {
+    user.credentials[existingIdx] = credential;
+  } else {
+    user.credentials.push(credential);
+  }
+  saveUsers();
+  return true;
+}
+
+export function updateCredentialName(userId: string, credentialId: string, newName: string): StoredPasskeyCredential | undefined {
+  const user = findUserById(userId);
+  if (!user) return undefined;
+  const cred = user.credentials.find(c => c.id === credentialId);
+  if (!cred) return undefined;
+  cred.name = newName.trim();
+  saveUsers();
+  return cred;
+}
+
+export function deleteCredential(userId: string, credentialId: string): boolean {
+  const user = findUserById(userId);
+  if (!user) return false;
+  const initialLength = user.credentials.length;
+  user.credentials = user.credentials.filter(c => c.id !== credentialId);
+  if (user.credentials.length !== initialLength) {
+    saveUsers();
+    return true;
+  }
+  return false;
+}
+
+export function updateCredentialUsage(credentialId: string, counter: number): void {
+  const result = findUserByCredentialId(credentialId);
+  if (!result) return;
+  result.credential.counter = counter;
+  result.credential.lastUsedAt = Date.now();
+  saveUsers();
+}
