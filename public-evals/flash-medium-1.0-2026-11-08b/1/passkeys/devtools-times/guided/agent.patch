@@ -0,0 +1,54 @@
+import type { APIRoute } from 'astro';
+import { findUserById } from '../../../utils/db';
+import { getRpId } from '../../../utils/webauthn';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const sessionUser = await session?.get('user');
+  const reauthenticatedAt = await session?.get('reauthenticatedAt');
+  const rpId = getRpId(request);
+
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ authenticated: false, user: null, rpId }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = findUserById(sessionUser.id);
+  if (!user) {
+    return new Response(JSON.stringify({ authenticated: false, user: null, rpId }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  return new Response(
+    JSON.stringify({
+      authenticated: true,
+      user: {
+        id: user.id,
+        passkeyUserId: user.passkeyUserId,
+        name: user.name,
+        displayName: user.displayName,
+        credentialsCount: (user.credentials || []).length,
+      },
+      reauthenticated: Boolean(reauthenticatedAt && Date.now() - reauthenticatedAt < 15 * 60 * 1000), // Valid for 15 mins
+      reauthenticatedAt,
+      rpId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ session }) => {
+  // Sign out
+  await session?.set('user', null);
+  await session?.set('reauthenticatedAt', null);
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/auth/register-options.ts b/src/pages/api/auth/register-options.ts
new file mode 100644
index 0000000..69ce797
--- /dev/null
+++ b/src/pages/api/auth/register-options.ts
@@ -0,0 +1,84 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { findUserById, findUserByUsername, createUser, isValidBase64Url, generateBase64UrlId } from '../../../utils/db';
+import { getRpId, RP_NAME } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { username, displayName, promotion } = body;
+
+    // Check if user is already logged in
+    let user = await session?.get('user');
+
+    if (!user) {
+      if (!username || typeof username !== 'string' || !username.trim()) {
+        return new Response(JSON.stringify({ error: 'Username is required for registration' }), {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+
+      // Check if user exists or create new
+      const existingUser = findUserByUsername(username);
+      if (existingUser) {
+        user = existingUser;
+      } else {
+        user = createUser({
+          name: username.trim(),
+          displayName: displayName || username.trim(),
+        });
+      }
+    }
+
+    const rpID = getRpId(request);
+
+    // Map existing credentials to exclude
+    const existingCredentials = (user.credentials || []).map((cred) => ({
+      id: cred.id,
+      transports: cred.transports as any,
+    }));
+
+    const isPromotionFlow = Boolean(promotion);
+
+    // Enforce discoverable credentials and appropriate attachment scope per guide:
+    // Promotion: authenticatorAttachment: "platform"
+    // Management: omit authenticatorAttachment to support external security keys
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID,
+      userName: user.name,
+      userID: Buffer.from(user.passkeyUserId, 'utf8'),
+      userDisplayName: user.displayName || user.name,
+      attestationType: 'none',
+      excludeCredentials: existingCredentials,
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(isPromotionFlow ? { authenticatorAttachment: 'platform' } : {}),
+      },
+    });
+
+    // Ensure rp.id is explicitly set so client can use publicKey.rp.id
+    if (!options.rp.id) {
+      options.rp.id = rpID;
+    }
+
+    // Save challenge and registration context in session
+    await session?.set('currentRegistrationChallenge', options.challenge);
+    await session?.set('registrationUserId', user.id);
+    await session?.set('expectedUserVerification', 'preferred');
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Registration options error:', error);
+    return new Response(JSON.stringify({ error: error?.message || 'Failed to generate registration options' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
