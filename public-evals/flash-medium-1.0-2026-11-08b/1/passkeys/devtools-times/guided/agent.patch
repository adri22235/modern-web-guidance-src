+
+/**
+ * Determine the passkey provider name and icon based on AAGUID,
+ * strictly adhering to passkey-management guidance:
+ * "Before looking up the AAGUID in the registry, check if it equals '00000000-0000-0000-0000-000000000000'.
+ * If so, skip the registry lookup and set name to a fallback (e.g. device name from user-agent,
+ * or 'Unknown passkey provider') and providerIcon to undefined. Only look up the registry for non-zeroed AAGUIDs."
+ */
+export function getPasskeyProvider(aaguid: string, userAgent?: string): { name: string; providerIcon?: string } {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    let fallbackName = 'Passkey Authenticator';
+    if (userAgent) {
+      if (/iPhone|iPad|Macintosh/i.test(userAgent)) fallbackName = 'Apple iCloud Keychain / Touch ID';
+      else if (/Android/i.test(userAgent)) fallbackName = 'Android Passkey';
+      else if (/Windows/i.test(userAgent)) fallbackName = 'Windows Hello';
+    }
+    return {
+      name: fallbackName,
+      providerIcon: undefined,
+    };
+  }
+
+  const normalized = aaguid.toLowerCase();
+  const entry = AAGUID_REGISTRY[normalized];
+  if (entry) {
+    return {
+      name: entry.name,
+      providerIcon: entry.icon_light,
+    };
+  }
+
+  return {
+    name: 'Passkey Authenticator',
+    providerIcon: PASSKEY_GENERIC_ICON,
+  };
+}
