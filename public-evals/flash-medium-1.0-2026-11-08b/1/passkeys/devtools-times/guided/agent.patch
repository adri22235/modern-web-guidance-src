@@ -0,0 +1,85 @@
+import type { APIRoute } from 'astro';
+import { findUserById, updateCredentialName, deleteCredential } from '../../../utils/db';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const sessionUser = await session?.get('user');
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const { name } = body;
+  if (!name || typeof name !== 'string' || !name.trim()) {
+    return new Response(JSON.stringify({ error: 'Name is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const updatedCred = updateCredentialName(sessionUser.id, id, name.trim());
+  if (!updatedCred) {
+    return new Response(JSON.stringify({ error: 'Credential not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  // Update session user credentials copy
+  const updatedUser = findUserById(sessionUser.id);
+  if (updatedUser) {
+    await session?.set('user', updatedUser);
+  }
+
+  return new Response(JSON.stringify(updatedCred), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const sessionUser = await session?.get('user');
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const deleted = deleteCredential(sessionUser.id, id);
+  if (!deleted) {
+    return new Response(JSON.stringify({ error: 'Credential not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  // Update session user credentials copy
+  const updatedUser = findUserById(sessionUser.id);
+  if (updatedUser) {
+    await session?.set('user', updatedUser);
+  }
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
