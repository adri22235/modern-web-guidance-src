+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,751 @@
+import React, { useState, useEffect, useRef } from 'react';
+import 'webauthn-polyfills';
+
+const baseUrl = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value: any): boolean {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+interface PasskeyCredential {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  transports: string[];
+}
+
+interface UserProfile {
+  id: string;
+  passkeyUserId: string;
+  name: string;
+  displayName: string;
+}
+
+export default function AccountSettings() {
+  const [user, setUser] = useState<UserProfile | null>(null);
+  const [credentials, setCredentials] = useState<PasskeyCredential[]>([]);
+  const [rpId, setRpId] = useState<string>('');
+  const [loading, setLoading] = useState(true);
+  const [actionLoading, setActionLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+
+  // Profile edit states
+  const [editName, setEditName] = useState('');
+  const [editDisplayName, setEditDisplayName] = useState('');
+
+  // Passkey rename states
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+
+  // Feature detection
+  const [isPasskeySupported, setIsPasskeySupported] = useState(true);
+
+  // Reauthentication states
+  const [isReauthenticated, setIsReauthenticated] = useState(false);
+  const [reauthSuccessMessage, setReauthSuccessMessage] = useState<string | null>(null);
+  const reauthAbortControllerRef = useRef<AbortController | null>(null);
+
+  // Synchronize accepted credentials via Signal API
+  const syncAcceptedCredentials = async (serverRpId: string, userId: string, credsList: PasskeyCredential[]) => {
+    if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+    const credentialIds = credsList.map((c) => c.id);
+
+    if (!serverRpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+      console.warn(
+        'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+      );
+      return;
+    }
+
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: serverRpId, // Always use server-provided rpId; DO NOT use window.location.hostname
+        userId, // Base64URL-encoded user ID from server
+        allAcceptedCredentialIds: credentialIds,
+      });
+    } catch (e) {
+      // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+      console.warn('SignalAllAcceptedCredentials sync warning:', e);
+    }
+  };
+
+  // Load account data and credentials
+  const loadAccountData = async () => {
+    try {
+      const meRes = await fetch(`${baseUrl}api/auth/me`);
+      const meData = await meRes.json();
+
+      if (!meData.authenticated || !meData.user) {
+        // Not authenticated
+        setLoading(false);
+        return;
+      }
+
+      setUser(meData.user);
+      setEditName(meData.user.name || '');
+      setEditDisplayName(meData.user.displayName || '');
+      setIsReauthenticated(Boolean(meData.reauthenticated));
+
+      const credsRes = await fetch(`${baseUrl}api/credentials`);
+      if (credsRes.ok) {
+        const credsData = await credsRes.json();
+        setRpId(credsData.rpId);
+        setCredentials(credsData.credentials || []);
+
+        // Page load Signal API sync
+        await syncAcceptedCredentials(credsData.rpId, credsData.userId, credsData.credentials || []);
+      }
+    } catch (err) {
+      console.error('Error loading account settings:', err);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    // Check passkey client capabilities
+    async function checkCapabilities() {
+      if (window.PublicKeyCredential && PublicKeyCredential.getClientCapabilities) {
+        try {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          setIsPasskeySupported(Boolean(caps.passkeyPlatformAuthenticator || caps.conditionalGet));
+        } catch {
+          setIsPasskeySupported(false);
+        }
+      }
+    }
+    checkCapabilities();
+    loadAccountData();
+  }, []);
+
+  // User Profile Rename Flow
+  const handleUpdateProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const response = await fetch(`${baseUrl}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: editName, displayName: editDisplayName }),
+      });
+
+      if (!response.ok) {
+        const data = await response.json();
+        throw new Error(data.error || 'Failed to update user profile');
+      }
+
+      const updatedUser = await response.json();
+      setUser({
+        id: updatedUser.id,
+        passkeyUserId: updatedUser.passkeyUserId || updatedUser.userId,
+        name: updatedUser.name,
+        displayName: updatedUser.displayName,
+      });
+
+      // Synchronize with password managers via Signal API
+      if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+        const serverRpId = updatedUser.rpId || rpId;
+        const validUserId = updatedUser.userId || updatedUser.passkeyUserId;
+
+        if (serverRpId && isValidBase64Url(validUserId)) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: serverRpId, // Always use server-provided rpId; DO NOT use window.location.hostname
+              userId: validUserId, // Base64URL-encoded user ID
+              name: editName,
+              displayName: editDisplayName,
+            });
+          } catch (e) {
+            console.warn('SignalCurrentUserDetails sync warning:', e);
+          }
+        } else {
+          console.warn('SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId required.');
+        }
+      }
+
+      setSuccess('Account profile updated and synchronized successfully!');
+    } catch (err: any) {
+      setError(err?.message || 'Error updating profile');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Add / Create a new passkey (Management flow: omit authenticatorAttachment)
+  const handleCreatePasskey = async () => {
+    if (!user) return;
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/auth/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: user.name,
+          displayName: user.displayName,
+          promotion: false, // Management flow supports external keys too
+        }),
+      });
+
+      if (!optionsRes.ok) {
+        const data = await optionsRes.json();
+        throw new Error(data.error || 'Failed to generate passkey options');
+      }
+
+      const creationOptionsJSON = await optionsRes.json();
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON
+        ? PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON)
+        : creationOptionsJSON;
+
+      let credential: any;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err: any) {
+        if (err.name === 'InvalidStateError') {
+          setError('A passkey already exists for this account on this device.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          setError('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        } else {
+          setError(err.message || 'Passkey creation failed.');
+        }
+        setActionLoading(false);
+        return;
+      }
+
+      if (!credential) {
+        setActionLoading(false);
+        return;
+      }
+
+      // Segregated server verification
+      const encodedResponse = credential.toJSON ? credential.toJSON() : credential;
+      try {
+        const verifyRes = await fetch(`${baseUrl}api/auth/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyRes.ok) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id, // Always use server-provided rp.id; DO NOT use window.location.hostname
+              credentialId: encodedResponse.id,
+            });
+          }
+          const errData = await verifyRes.json();
+          setError(errData.error || 'Failed to verify passkey on server.');
+          setActionLoading(false);
+          return;
+        }
+
+        setSuccess('New passkey added successfully!');
+        await loadAccountData();
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+        setError('Network failure during verification.');
+      }
+    } catch (err: any) {
+      setError(err?.message || 'Error creating passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Rename a passkey nickname
+  const handleRenameCredential = async (credentialId: string) => {
+    if (!newPasskeyName.trim()) return;
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const response = await fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: newPasskeyName.trim() }),
+      });
+
+      if (!response.ok) {
+        const data = await response.json();
+        throw new Error(data.error || 'Failed to rename passkey');
+      }
+
+      setRenamingId(null);
+      setNewPasskeyName('');
+      setSuccess('Passkey nickname updated successfully.');
+      await loadAccountData();
+    } catch (err: any) {
+      setError(err?.message || 'Error renaming passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Delete a passkey
+  const handleDeleteCredential = async (credentialId: string) => {
+    if (!confirm('Are you sure you want to delete this passkey?')) return;
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const response = await fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+        method: 'DELETE',
+      });
+
+      if (!response.ok) {
+        const data = await response.json();
+        throw new Error(data.error || 'Failed to delete passkey');
+      }
+
+      // Fetch updated list and immediately synchronize remaining credentials with Signal API
+      const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+      if (updatedResponse.ok) {
+        const { rpId: serverRpId, userId, credentials: updatedCreds } = await updatedResponse.json();
+        setCredentials(updatedCreds || []);
+        // Post-delete Signal API synchronization
+        await syncAcceptedCredentials(serverRpId, userId, updatedCreds || []);
+      }
+
+      setSuccess('Passkey deleted and synchronization updated.');
+    } catch (err: any) {
+      setError(err?.message || 'Error deleting passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Reauthentication flow (Delta Step-up verification)
+  const handleReauthenticate = async () => {
+    setError(null);
+    setReauthSuccessMessage(null);
+    setActionLoading(true);
+
+    if (reauthAbortControllerRef.current) {
+      reauthAbortControllerRef.current.abort();
+    }
+    reauthAbortControllerRef.current = new AbortController();
+
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/reauth/options`, {
+        method: 'POST',
+      });
+
+      if (!optionsRes.ok) {
+        const data = await optionsRes.json();
+        throw new Error(data.error || 'Failed to get reauthentication options');
+      }
+
+      const optionsJSON = await optionsRes.json();
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON
+        ? PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON)
+        : optionsJSON;
+
+      let credential: any;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortControllerRef.current.signal,
+        });
+      } catch (err: any) {
+        if (err.name === 'NotAllowedError') {
+          console.log('User cancelled reauthentication.');
+        } else {
+          setError(err.message || 'Reauthentication cancelled or failed.');
+        }
+        setActionLoading(false);
+        return;
+      }
+
+      if (!credential) {
+        setActionLoading(false);
+        return;
+      }
+
+      const encodedCredential = credential.toJSON ? credential.toJSON() : credential;
+      const verifyRes = await fetch(`${baseUrl}api/reauth/verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encodedCredential),
+      });
+
+      if (verifyRes.ok) {
+        setIsReauthenticated(true);
+        setReauthSuccessMessage('Identity verified via passkey! Sensitive operations unlocked.');
+      } else if (verifyRes.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId, // Always use server-provided rpId; DO NOT use window.location.hostname
+          credentialId: encodedCredential.id,
+        });
+        setError('Unknown credential presented.');
+      } else {
+        const data = await verifyRes.json();
+        setError(data.error || 'Reauthentication failed.');
+      }
+    } catch (err: any) {
+      setError(err?.message || 'Error during reauthentication');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  const handleSignOut = async () => {
+    await fetch(`${baseUrl}api/auth/me`, { method: 'POST' });
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  if (loading) {
+    return (
+      <div className="max-w-4xl mx-auto p-6 text-center text-gray-500">
+        Loading account settings...
+      </div>
+    );
+  }
+
+  if (!user) {
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <h2 className="text-xl font-bold text-gray-800 mb-2">Not Signed In</h2>
+        <p className="text-sm text-gray-600 mb-6">You must be signed in to manage your account and passkeys.</p>
+        <div className="flex justify-center space-x-3">
+          <a
+            href={`${baseUrl}signin`}
+            className="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800"
+          >
+            Sign In
+          </a>
+          <a
+            href={`${baseUrl}signup`}
+            className="px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-50"
+          >
+            Sign Up
+          </a>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto my-8 p-6 space-y-8">
+      {/* Page Header */}
+      <div className="flex flex-col md:flex-row md:items-center justify-between border-b pb-4 gap-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account Settings</h1>
+          <p className="text-sm text-gray-600">
+            Manage your credentials, passkeys, and identity verification.
+          </p>
+        </div>
+        <button
+          onClick={handleSignOut}
+          className="self-start md:self-auto px-4 py-2 text-xs font-semibold uppercase tracking-wider text-red-600 hover:text-red-800 border border-red-200 rounded-md hover:bg-red-50 transition-colors"
+        >
+          Sign Out
+        </button>
+      </div>
+
+      {/* Global Alerts */}
+      {error && (
+        <div className="p-4 text-sm text-red-700 bg-red-100 rounded-lg border border-red-200" role="alert">
+          {error}
+        </div>
+      )}
+      {success && (
+        <div className="p-4 text-sm text-green-700 bg-green-100 rounded-lg border border-green-200" role="alert">
+          {success}
+        </div>
+      )}
+
+      {/* Section 1: User Profile Settings */}
+      <div className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <h2 className="text-xl font-bold text-gray-800 mb-1">Account Profile</h2>
+        <p className="text-xs text-gray-500 mb-4">
+          Updating your name synchronizes with your passkey managers via the Signal API.
+        </p>
+
+        <form onSubmit={handleUpdateProfile} className="max-w-lg space-y-4">
+          <div>
+            <label htmlFor="profile-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              type="text"
+              id="profile-username"
+              value={editName}
+              onChange={(e) => setEditName(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
+            />
+          </div>
+
+          <div>
+            <label htmlFor="profile-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display Name
+            </label>
+            <input
+              type="text"
+              id="profile-display-name"
+              value={editDisplayName}
+              onChange={(e) => setEditDisplayName(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
+            />
+          </div>
+
+          <button
+            type="submit"
+            disabled={actionLoading}
+            className={`px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+              actionLoading ? 'opacity-75 cursor-not-allowed' : ''
+            }`}
+          >
+            {actionLoading ? 'Saving...' : 'Save Profile Changes'}
+          </button>
+        </form>
+      </div>
+
+      {/* Section 2: Passkey Management */}
+      <div className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
+          <div>
+            <h2 className="text-xl font-bold text-gray-800">Passkeys</h2>
+            <p className="text-xs text-gray-500">
+              Sign in securely without typing passwords on all your registered devices.
+            </p>
+          </div>
+
+          {/* Conditional Create Passkey Button */}
+          {isPasskeySupported && (
+            <button
+              id="create-passkey"
+              type="button"
+              onClick={handleCreatePasskey}
+              disabled={actionLoading}
+              data-testid="create-passkey-button"
+              className="inline-flex items-center space-x-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md shadow-sm transition-colors"
