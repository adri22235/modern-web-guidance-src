+export const RP_NAME = 'The DevTools Times';
+
+export function getRpId(request: Request): string {
+  const hostHeader = request.headers.get('x-forwarded-host') || request.headers.get('host');
+  if (hostHeader) {
+    const hostname = hostHeader.split(':')[0];
+    if (hostname === 'localhost' || hostname === '127.0.0.1') {
+      return 'localhost';
+    }
+    return hostname;
+  }
+  try {
+    const url = new URL(request.url);
+    if (url.hostname === 'localhost' || url.hostname === '127.0.0.1') {
+      return 'localhost';
+    }
+    return url.hostname;
+  } catch {
+    return 'localhost';
+  }
+}
+
+export function getExpectedOrigin(request: Request): string {
+  const originHeader = request.headers.get('origin');
+  if (originHeader) {
+    return originHeader;
+  }
+  const hostHeader = request.headers.get('x-forwarded-host') || request.headers.get('host');
+  const proto = request.headers.get('x-forwarded-proto') || (hostHeader?.startsWith('localhost') ? 'http' : 'https');
+  if (hostHeader) {
+    return `${proto}://${hostHeader}`;
+  }
+  try {
+    const url = new URL(request.url);
+    return `${url.protocol}//${url.host}`;
+  } catch {
+    return 'http://localhost:11224';
+  }
+}
