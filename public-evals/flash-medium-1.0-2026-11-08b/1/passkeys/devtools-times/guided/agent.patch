+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { findUserById, addCredential, type StoredPasskeyCredential } from '../../../utils/db';
+import { getRpId, getExpectedOrigin } from '../../../utils/webauthn';
+import { getPasskeyProvider } from '../../../utils/aaguids';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const expectedChallenge = await session?.get('currentRegistrationChallenge');
+    const registrationUserId = await session?.get('registrationUserId');
+
+    if (!expectedChallenge || !registrationUserId) {
+      return new Response(JSON.stringify({ error: 'Missing registration challenge or session user' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = findUserById(registrationUserId);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found for registration' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const expectedRPID = getRpId(request);
+    const expectedOrigin = getExpectedOrigin(request);
+
+    // Verify registration response
+    // When creation options specified userVerification: "preferred",
+    // requireUserVerification MUST be set to false.
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID,
+      requireUserPresence: true,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey registration verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { registrationInfo } = verification;
+    const { credential, aaguid, credentialDeviceType, credentialBackedUp } = registrationInfo;
+
+    // Look up provider metadata via AAGUID
+    const provider = getPasskeyProvider(aaguid, request.headers.get('user-agent') || undefined);
+
+    const credentialPublicKeyBase64Url = Buffer.from(credential.publicKey).toString('base64url');
+
+    const newCredential: StoredPasskeyCredential = {
+      id: credential.id, // Unpadded Base64URL string
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: credentialPublicKeyBase64Url,
+      credentialType: 'public-key',
+      credentialDeviceType: credentialDeviceType || 'singleDevice',
+      credentialBackedUp: Boolean(credentialBackedUp),
+      aaguid: aaguid || '00000000-0000-0000-0000-000000000000',
+      providerIcon: provider.providerIcon,
+      name: provider.name,
+      transports: credential.transports || [],
+      registeredAt: Date.now(),
+      counter: credential.counter || 0,
+    };
+
+    addCredential(user.id, newCredential);
+
+    // Clear challenge from session
+    await session?.set('currentRegistrationChallenge', null);
+
+    // Persist authenticated user session
+    await session?.set('user', user);
+
+    return new Response(JSON.stringify({ verified: true, user }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Registration verification error:', error);
+    return new Response(JSON.stringify({ error: error?.message || 'Server verification failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
