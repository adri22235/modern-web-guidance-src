@@ -0,0 +1,85 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findUserByCredentialId, updateCredentialUsage } from '../../../utils/db';
+import { getRpId, getExpectedOrigin } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const expectedChallenge = await session?.get('currentAuthenticationChallenge');
+
+    if (!expectedChallenge) {
+      return new Response(JSON.stringify({ error: 'Missing or expired authentication challenge' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const credentialId = body.id;
+    if (!credentialId) {
+      return new Response(JSON.stringify({ error: 'Missing credential ID' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Look up credential in database
+    const match = findUserByCredentialId(credentialId);
+
+    // Rule: Clean Server Error 404
+    // If the credential ID returned by the client is not found in the database,
+    // return an explicit HTTP 404 error so the client can trigger the Signal API.
+    if (!match) {
+      return new Response(JSON.stringify({ error: 'Credential not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { user, credential } = match;
+    const expectedRPID = getRpId(request);
+    const expectedOrigin = getExpectedOrigin(request);
+
+    const verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID,
+      credential: {
+        id: credential.id,
+        publicKey: isoBase64URL.toBuffer(credential.credentialPublicKey),
+        counter: credential.counter,
+        transports: credential.transports as any,
+      },
+      requireUserVerification: false, // Since preferred was used
+    });
+
+    if (!verification.verified) {
+      return new Response(JSON.stringify({ error: 'Authentication verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Update credential counter and lastUsedAt
+    updateCredentialUsage(credential.id, verification.authenticationInfo.newCounter);
+
+    // Clear challenge from session
+    await session?.set('currentAuthenticationChallenge', null);
+
+    // Save authenticated user in session
+    await session?.set('user', user);
+
+    return new Response(JSON.stringify({ verified: true, user }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Signin verification error:', error);
+    return new Response(JSON.stringify({ error: error?.message || 'Server verification failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
