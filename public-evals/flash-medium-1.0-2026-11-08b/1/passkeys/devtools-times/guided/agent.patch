+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRpId } from '../../../utils/webauthn';
+
+export const ALL: APIRoute = async ({ request, session }) => {
+  try {
+    const rpID = getRpId(request);
+
+    // Generate discoverable authentication options: allowCredentials: []
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials: [], // Request discoverable passkeys
+      userVerification: 'preferred',
+    });
+
+    // Ensure rpId is present on returned options
+    if (!options.rpId) {
+      options.rpId = rpID;
+    }
+
+    // Persist expected UV level and challenge to session
+    await session?.set('currentAuthenticationChallenge', options.challenge);
+    await session?.set('expectedUserVerification', 'preferred');
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Signin options error:', error);
+    return new Response(JSON.stringify({ error: error?.message || 'Failed to generate signin options' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
