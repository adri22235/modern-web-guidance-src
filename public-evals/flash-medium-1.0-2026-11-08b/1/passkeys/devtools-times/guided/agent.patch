+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { findUserById } from '../../../utils/db';
+import { getRpId } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const sessionUser = await session?.get('user');
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized: Session required for reauthentication' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = findUserById(sessionUser.id);
+  if (!user) {
+    return new Response(JSON.stringify({ error: 'User not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const userPasskeys = user.credentials || [];
+  if (userPasskeys.length === 0) {
+    return new Response(JSON.stringify({ error: 'No passkeys registered for this user' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const rpID = getRpId(request);
+
+  // Delta Flow Architecture: Constrain credentials strictly to the user's pre-registered passkeys
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials: userPasskeys.map((cred) => ({
+      id: cred.id,
+      type: 'public-key',
+      transports: cred.transports as any,
+    })),
+    userVerification: 'preferred',
+  });
+
+  if (!options.rpId) {
+    options.rpId = rpID;
+  }
+
+  await session?.set('currentReauthChallenge', options.challenge);
+  await session?.set('expectedUserVerification', 'preferred');
+
+  return new Response(JSON.stringify(options), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
