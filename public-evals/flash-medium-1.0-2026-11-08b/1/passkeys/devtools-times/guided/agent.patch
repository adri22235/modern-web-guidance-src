+import type { APIRoute } from 'astro';
+import { findUserById, updateUserProfile } from '../../utils/db';
+import { getRpId } from '../../utils/webauthn';
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const sessionUser = await session?.get('user');
+  if (!sessionUser) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const { name, displayName } = body;
+
+  const updatedUser = updateUserProfile(sessionUser.id, { name, displayName });
+  if (!updatedUser) {
+    return new Response(JSON.stringify({ error: 'User not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  await session?.set('user', updatedUser);
+
+  const rpId = getRpId(request);
+
+  return new Response(
+    JSON.stringify({
+      ...updatedUser,
+      rpId,
+      userId: updatedUser.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
