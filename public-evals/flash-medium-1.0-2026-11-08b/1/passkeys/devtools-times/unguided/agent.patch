@@ -0,0 +1,40 @@
+export function getWebAuthnConfig(request: Request) {
+  const url = new URL(request.url);
+  const hostHeader = request.headers.get('host') || url.host;
+  const hostname = hostHeader.split(':')[0];
+  const originHeader = request.headers.get('origin') || request.headers.get('referer');
+  
+  let origin = originHeader ? new URL(originHeader).origin : url.origin;
+  const rpID = hostname || 'localhost';
+
+  const expectedOrigin = [
+    origin,
+    `http://${hostHeader}`,
+    `https://${hostHeader}`,
+    'http://localhost:11224',
+    'http://localhost:4321',
+    'http://127.0.0.1:11224',
+    'http://127.0.0.1:4321',
+    'https://chrome.dev',
+    'https://astro-news-pytrpecapa-uc.a.run.app',
+    'https://astro-news-1026410574114.us-central1.run.app',
+  ];
+
+  const expectedRPID = [
+    rpID,
+    hostname,
+    'localhost',
+    '127.0.0.1',
+    'chrome.dev',
+    'astro-news-pytrpecapa-uc.a.run.app',
+    'astro-news-1026410574114.us-central1.run.app',
+  ];
+
+  return {
+    rpName: 'The DevTools Times',
+    rpID,
+    origin,
+    expectedOrigin: Array.from(new Set(expectedOrigin)),
+    expectedRPID: Array.from(new Set(expectedRPID)),
+  };
+}
