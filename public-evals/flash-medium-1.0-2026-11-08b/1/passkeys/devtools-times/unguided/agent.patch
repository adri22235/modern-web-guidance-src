+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { passkeysDb } from '../../../utils/passkeysDb';
+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username, response } = body;
+
+    if (!username || !response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Username and response are required for reauthentication' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = passkeysDb.getUser(username);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkey = user.passkeys.find(pk => pk.id === response.id);
+    if (!passkey) {
+      return new Response(JSON.stringify({ error: 'Passkey not recognized for this user' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const config = getWebAuthnConfig(request);
+
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: (challenge) => passkeysDb.verifyAndConsumeChallenge(challenge, user.username),
+      expectedOrigin: config.expectedOrigin,
+      expectedRPID: config.expectedRPID,
+      credential: {
+        id: passkey.id,
+        publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64')),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+      requireUserVerification: true,
+    });
+
+    if (!verification.verified || !verification.authenticationInfo) {
+      return new Response(JSON.stringify({ error: 'Reauthentication verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    passkeysDb.recordReauth(user.username);
+    passkeysDb.recordPasskeyUsage(user.username, passkey.id, verification.authenticationInfo.newCounter);
+
+    const reauthenticatedAt = new Date().toISOString();
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        reauthenticatedAt,
+        passkeyUsed: {
+          id: passkey.id,
+          name: passkey.name,
+        },
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    console.error('[reauth-verify] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Passkey reauthentication failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
