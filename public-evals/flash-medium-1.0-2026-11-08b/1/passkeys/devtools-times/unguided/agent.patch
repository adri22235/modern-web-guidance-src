+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { passkeysDb } from '../../../utils/passkeysDb';
+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username } = body;
+
+    if (!username) {
+      return new Response(JSON.stringify({ error: 'Username is required for reauthentication' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = passkeysDb.getUser(username);
+    if (!user || user.passkeys.length === 0) {
+      return new Response(JSON.stringify({ error: 'No passkeys found for this user' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const config = getWebAuthnConfig(request);
+
+    const options = await generateAuthenticationOptions({
+      rpID: config.rpID,
+      allowCredentials: user.passkeys.map(pk => ({
+        id: pk.id,
+        transports: pk.transports as any,
+      })),
+      userVerification: 'required',
+    });
+
+    passkeysDb.saveChallenge(options.challenge, user.username);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    console.error('[reauth-options] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Failed to generate reauthentication options' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
