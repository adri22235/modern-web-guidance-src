+++ b/src/pages/api/passkeys/auth-options.ts
@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { passkeysDb } from '../../../utils/passkeysDb';
+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    let username: string | undefined;
+    try {
+      const body = await request.json();
+      if (body && typeof body.username === 'string' && body.username.trim()) {
+        username = body.username.trim();
+      }
+    } catch {
+      // Optional body for autofill / discoverable authentication
+    }
+
+    const config = getWebAuthnConfig(request);
+    let allowCredentials = undefined;
+
+    if (username) {
+      const user = passkeysDb.getUser(username);
+      if (user && user.passkeys.length > 0) {
+        allowCredentials = user.passkeys.map(pk => ({
+          id: pk.id,
+          transports: pk.transports as any,
+        }));
+      }
+    }
+
+    const options = await generateAuthenticationOptions({
+      rpID: config.rpID,
+      allowCredentials,
+      userVerification: 'preferred',
+    });
+
+    passkeysDb.saveChallenge(options.challenge, username);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    console.error('[auth-options] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Failed to generate authentication options' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
diff --git a/src/pages/api/passkeys/auth-verify.ts b/src/pages/api/passkeys/auth-verify.ts
new file mode 100644
index 0000000..44ed927
--- /dev/null
+++ b/src/pages/api/passkeys/auth-verify.ts
@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { passkeysDb } from '../../../utils/passkeysDb';
+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username: givenUsername, response } = body;
+
+    if (!response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Authentication response is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Try finding user by credential ID (discoverable / autofill passkey), or by given username
+    let user = passkeysDb.getUserByCredentialId(response.id);
+    if (!user && givenUsername) {
+      user = passkeysDb.getUser(givenUsername);
+    }
+
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'No user found for this passkey' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkey = user.passkeys.find(pk => pk.id === response.id);
+    if (!passkey) {
+      return new Response(JSON.stringify({ error: 'Passkey not found for this account' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const config = getWebAuthnConfig(request);
+
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: (challenge) => passkeysDb.verifyAndConsumeChallenge(challenge, user.username),
+      expectedOrigin: config.expectedOrigin,
+      expectedRPID: config.expectedRPID,
+      credential: {
+        id: passkey.id,
+        publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64')),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.authenticationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey authentication failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    passkeysDb.recordPasskeyUsage(user.username, passkey.id, verification.authenticationInfo.newCounter);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+        },
+        passkeyUsed: {
+          id: passkey.id,
+          name: passkey.name,
+        },
+        token: `dtt_token_${user.id}_${Date.now()}`,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    console.error('[auth-verify] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Passkey authentication failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
