+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username, displayName } = body;
+
+    if (!username || typeof username !== 'string') {
+      return new Response(JSON.stringify({ error: 'Username is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const config = getWebAuthnConfig(request);
+    const user = passkeysDb.getOrCreateUser(username, displayName);
+
+    const options = await generateRegistrationOptions({
+      rpName: config.rpName,
+      rpID: config.rpID,
+      userID: new TextEncoder().encode(user.id),
+      userName: user.username,
+      userDisplayName: user.displayName || user.username,
+      attestationType: 'none',
+      authenticatorSelection: {
+        residentKey: 'preferred',
+        userVerification: 'preferred',
+      },
+      excludeCredentials: user.passkeys.map(pk => ({
+        id: pk.id,
+        transports: pk.transports as any,
+      })),
+    });
+
+    passkeysDb.saveChallenge(options.challenge, user.username);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    console.error('[register-options] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Failed to generate registration options' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
