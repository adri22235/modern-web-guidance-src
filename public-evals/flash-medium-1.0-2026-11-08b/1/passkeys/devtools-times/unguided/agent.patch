+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  startRegistration,
+  startAuthentication,
+  browserSupportsPasskeys,
+} from '@simplewebauthn/browser';
+import {
+  FingerPrintIcon,
+  KeyIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  ArrowRightOnRectangleIcon,
+  UserCircleIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+  LockClosedIcon,
+  ArrowPathIcon,
+} from '@heroicons/react/24/outline';
+import {
+  getCurrentUser,
+  setCurrentUser,
+  clearCurrentUser,
+  setReauthenticated,
+  isRecentlyReauthenticated,
+  type ClientUser,
+} from '../utils/clientAuth';
+
+interface PasskeyItem {
+  id: string;
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  transports?: string[];
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export default function AccountSettings() {
+  const [user, setUser] = useState<ClientUser | null>(null);
+  const [passkeys, setPasskeys] = useState<PasskeyItem[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [actionLoading, setActionLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+
+  // New Passkey state
+  const [showAddModal, setShowAddModal] = useState(false);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+
+  // Rename modal state
+  const [renamingPasskey, setRenamingPasskey] = useState<PasskeyItem | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+
+  // Delete modal state
+  const [deletingPasskey, setDeletingPasskey] = useState<PasskeyItem | null>(null);
+
+  // Reauth state
+  const [isReauthed, setIsReauthed] = useState(false);
+  const [reauthTime, setReauthTime] = useState<string | null>(null);
+  const [showReauthModal, setShowReauthModal] = useState(false);
+  const [pendingSensitiveAction, setPendingSensitiveAction] = useState<(() => void) | null>(null);
+
+  // Fallback username for demo / when not signed in
+  const [tempUsername, setTempUsername] = useState('');
+
+  const baseUrl = import.meta.env.BASE_URL.endsWith('/')
+    ? import.meta.env.BASE_URL
+    : `${import.meta.env.BASE_URL}/`;
+
+  const fetchPasskeys = useCallback(async (username: string) => {
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys/list?username=${encodeURIComponent(username)}`);
+      if (res.ok) {
+        const data = await res.json();
+        setPasskeys(data.passkeys || []);
+      }
+    } catch (err) {
+      console.error('Failed to load passkeys:', err);
+    }
+  }, [baseUrl]);
+
+  useEffect(() => {
+    const currentUser = getCurrentUser();
+    setUser(currentUser);
+    setIsReauthed(isRecentlyReauthenticated());
+    if (currentUser?.lastReauthAt) {
+      setReauthTime(currentUser.lastReauthAt);
+    }
+
+    if (currentUser?.username) {
+      fetchPasskeys(currentUser.username).finally(() => setLoading(false));
+    } else {
+      setLoading(false);
+    }
+
+    const handleAuthChange = (e: any) => {
+      const updated = e.detail as ClientUser | null;
+      setUser(updated);
+      setIsReauthed(isRecentlyReauthenticated());
+      if (updated?.username) {
+        fetchPasskeys(updated.username);
+      } else {
+        setPasskeys([]);
+      }
+    };
+
+    window.addEventListener('dtt_auth_change', handleAuthChange);
+    return () => window.removeEventListener('dtt_auth_change', handleAuthChange);
+  }, [fetchPasskeys]);
+
+  // Handle manual login/load in account page
+  const handleLoadUser = (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!tempUsername.trim()) return;
+    const newUser: ClientUser = { username: tempUsername.trim() };
+    setCurrentUser(newUser);
+    setUser(newUser);
+    fetchPasskeys(newUser.username);
+  };
+
+  // Reauthentication flow
+  const handleReauthenticate = async (onSuccessCallback?: () => void) => {
+    if (!user) return;
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/passkeys/reauth-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: user.username }),
+      });
+
+      const options = await optionsRes.json();
+      if (!optionsRes.ok) {
+        throw new Error(options.error || 'Failed to start reauthentication');
+      }
+
+      const authResponse = await startAuthentication({ optionsJSON: options });
+
+      const verifyRes = await fetch(`${baseUrl}api/passkeys/reauth-verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: user.username,
+          response: authResponse,
+        }),
+      });
+
+      const verifyData = await verifyRes.json();
+      if (!verifyRes.ok) {
+        throw new Error(verifyData.error || 'Reauthentication verification failed');
+      }
+
+      setReauthenticated(verifyData.reauthenticatedAt);
+      setIsReauthed(true);
+      setReauthTime(verifyData.reauthenticatedAt);
+      setSuccess('Identity verified via Passkey! Elevated permissions granted.');
+      setShowReauthModal(false);
+
+      if (onSuccessCallback) {
+        onSuccessCallback();
+      } else if (pendingSensitiveAction) {
+        pendingSensitiveAction();
+        setPendingSensitiveAction(null);
+      }
+    } catch (err: any) {
+      console.error('Reauth error:', err);
+      if (err.name === 'NotAllowedError') {
+        setError('Reauthentication cancelled.');
+      } else {
+        setError(err.message || 'Passkey reauthentication failed.');
+      }
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Guard for sensitive actions (requires reauth within last 15 min)
+  const requireReauthFor = (action: () => void) => {
+    if (isRecentlyReauthenticated()) {
+      action();
+    } else {
+      setPendingSensitiveAction(() => action);
+      setShowReauthModal(true);
+    }
+  };
+
+  // Register New Passkey
+  const handleAddPasskey = async () => {
+    if (!user) return;
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/passkeys/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: user.username }),
+      });
+
+      const options = await optionsRes.json();
+      if (!optionsRes.ok) {
+        throw new Error(options.error || 'Failed to obtain registration options');
+      }
+
+      const regResponse = await startRegistration({ optionsJSON: options });
+
+      const verifyRes = await fetch(`${baseUrl}api/passkeys/register-verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: user.username,
+          response: regResponse,
+          name: newPasskeyName.trim() || undefined,
+        }),
+      });
+
+      const verifyData = await verifyRes.json();
+      if (!verifyRes.ok) {
+        throw new Error(verifyData.error || 'Failed to verify new passkey');
+      }
+
+      await fetchPasskeys(user.username);
+      setShowAddModal(false);
+      setNewPasskeyName('');
+      setSuccess(`New passkey "${verifyData.passkey?.name || 'Passkey'}" added successfully!`);
+    } catch (err: any) {
+      console.error('Add passkey error:', err);
+      if (err.name === 'NotAllowedError') {
+        setError('Passkey creation cancelled.');
+      } else {
+        setError(err.message || 'Failed to register passkey.');
+      }
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Rename Passkey
+  const handleRename = async () => {
+    if (!user || !renamingPasskey || !renameValue.trim()) return;
+    setError(null);
+    setActionLoading(true);
+
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys/rename`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: user.username,
+          credentialId: renamingPasskey.id,
+          newName: renameValue.trim(),
+        }),
+      });
+
+      const data = await res.json();
+      if (!res.ok) {
+        throw new Error(data.error || 'Failed to rename passkey');
+      }
+
+      await fetchPasskeys(user.username);
+      setRenamingPasskey(null);
+      setRenameValue('');
+      setSuccess(`Passkey renamed to "${data.name}".`);
+    } catch (err: any) {
+      setError(err.message || 'Failed to rename passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Delete Passkey (protected by reauth check)
+  const executeDeletePasskey = async (passkeyId: string) => {
+    if (!user) return;
+    setError(null);
+    setActionLoading(true);
+
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys/delete`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: user.username,
+          credentialId: passkeyId,
+        }),
+      });
+
+      const data = await res.json();
+      if (!res.ok) {
+        throw new Error(data.error || 'Failed to delete passkey');
+      }
+
+      await fetchPasskeys(user.username);
+      setDeletingPasskey(null);
+      setSuccess('Passkey removed successfully.');
+    } catch (err: any) {
+      setError(err.message || 'Failed to delete passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  const handleSignOut = () => {
+    clearCurrentUser();
+    setUser(null);
+    setPasskeys([]);
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  if (loading) {
+    return (
+      <div className="max-w-4xl mx-auto p-12 text-center text-gray-500">
+        <ArrowPathIcon className="w-8 h-8 animate-spin mx-auto mb-2 text-gray-400" />
+        <p>Loading account details...</p>
+      </div>
+    );
+  }
+
+  // If user is not logged in, provide sign-in options or quick account finder
+  if (!user) {
+    return (
+      <div className="max-w-lg mx-auto mt-8 p-8 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <UserCircleIcon className="w-16 h-16 text-gray-400 mx-auto mb-3" />
+        <h2 className="text-2xl font-bold text-gray-900 mb-2">Account Settings</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          Please sign in to manage your passkeys and account security preferences.
+        </p>
+        <div className="flex flex-col sm:flex-row justify-center gap-3">
+          <a
+            href={`${baseUrl}signin`}
+            className="px-4 py-2.5 bg-gray-900 text-white rounded-md text-sm font-semibold hover:bg-gray-800"
+          >
+            Sign in with Passkey
+          </a>
+          <a
+            href={`${baseUrl}signup`}
+            className="px-4 py-2.5 bg-white text-gray-800 border border-gray-300 rounded-md text-sm font-semibold hover:bg-gray-50"
+          >
+            Create an Account
+          </a>
+        </div>
+
+        <div className="mt-8 pt-6 border-t border-gray-200 text-left">
+          <p className="text-xs text-gray-500 mb-2 font-medium">Already have an account? Enter username to inspect passkeys:</p>
+          <form onSubmit={handleLoadUser} className="flex gap-2">
+            <input
+              type="text"
+              value={tempUsername}
+              onChange={(e) => setTempUsername(e.target.value)}
+              placeholder="Username"
+              className="flex-1 px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-900"
+            />
+            <button
+              type="submit"
+              className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-800 rounded-md hover:bg-gray-700"
+            >
+              Load Account
+            </button>
+          </form>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto space-y-6">
+      {/* Top Banner / User Header */}
+      <div className="bg-white p-6 border border-gray-200 rounded-lg shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
+        <div className="flex items-center space-x-4">
+          <div className="w-14 h-14 bg-gray-900 text-white rounded-full flex items-center justify-center font-bold text-xl uppercase">
+            {user.username.charAt(0)}
+          </div>
+          <div>
+            <h1 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
+              <span>{user.username}</span>
+              {isReauthed && (
+                <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
+                  <ShieldCheckIcon className="w-3.5 h-3.5 mr-1" />
+                  Verified Session
+                </span>
+              )}
+            </h1>
+            <p className="text-xs text-gray-500 mt-0.5">
+              The DevTools Times Reader &bull; Passkey Security Enabled
+            </p>
+          </div>
+        </div>
+
+        <div className="flex items-center space-x-3">
+          <button
+            onClick={handleSignOut}
+            className="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
+          >
+            <ArrowRightOnRectangleIcon className="w-4 h-4 mr-1 text-gray-500" />
+            Sign Out
+          </button>
+        </div>
+      </div>
+
+      {/* Notifications */}
+      {error && (
+        <div className="p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm flex items-start">
+          <ExclamationTriangleIcon className="w-5 h-5 mr-2 text-red-500 flex-shrink-0 mt-0.5" />
+          <span>{error}</span>
+        </div>
+      )}
+
+      {success && (
+        <div className="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm flex items-start">
+          <CheckCircleIcon className="w-5 h-5 mr-2 text-green-600 flex-shrink-0 mt-0.5" />
+          <span>{success}</span>
+        </div>
+      )}
+
+      {/* Reauthentication Section */}
+      <div className="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-4 pb-4 border-b border-gray-200">
+          <div>
+            <h2 className="text-lg font-bold text-gray-900 flex items-center">
+              <ShieldCheckIcon className="w-5 h-5 mr-2 text-blue-600" />
+              Reauthentication & Session Verification
+            </h2>
+            <p className="text-xs text-gray-500 mt-1">
+              Verify your identity with your passkey to authorize high-security operations such as removing credentials or deleting your account.
+            </p>
+          </div>
+
+          <div>
+            {isReauthed ? (
+              <div className="flex items-center space-x-2 text-xs text-green-700 bg-green-50 px-3 py-1.5 rounded-md border border-green-200 font-medium">
+                <CheckCircleIcon className="w-4 h-4 text-green-600" />
+                <span>
+                  Reauthenticated {reauthTime ? new Date(reauthTime).toLocaleTimeString() : 'recently'}
+                </span>
+              </div>
+            ) : (
+              <button
+                onClick={() => handleReauthenticate()}
+                disabled={actionLoading || passkeys.length === 0}
+                className="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-md shadow-sm hover:bg-blue-700 disabled:opacity-50"
+              >
+                <LockClosedIcon className="w-4 h-4 mr-1.5" />
+                <span>{actionLoading ? 'Verifying...' : 'Reauthenticate with Passkey'}</span>
+              </button>
+            )}
+          </div>
+        </div>
+
+        <div className="mt-4 flex items-center text-xs text-gray-600">
+          <span className="font-semibold text-gray-800 mr-2">Security Level:</span>
+          {isReauthed ? (
+            <span className="text-green-700 font-medium">
+              Elevated access active. Sensitive management actions unlocked.
+            </span>
+          ) : (
+            <span className="text-amber-700 font-medium">
+              Standard session. Modifying or deleting security credentials will prompt for passkey verification.
+            </span>
+          )}
+        </div>
+      </div>
+
+      {/* Passkey Management Section */}
+      <div className="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-4 pb-4 border-b border-gray-200">
+          <div>
+            <h2 className="text-lg font-bold text-gray-900 flex items-center">
+              <FingerPrintIcon className="w-5 h-5 mr-2 text-gray-800" />
+              Registered Passkeys
+            </h2>
+            <p className="text-xs text-gray-500 mt-1">
+              Manage cryptographic passkeys stored on your devices or cloud keychains.
+            </p>
+          </div>
+
+          <button
+            onClick={() => setShowAddModal(true)}
+            className="inline-flex items-center px-4 py-2 bg-gray-900 text-white text-xs font-semibold rounded-md shadow-sm hover:bg-gray-800"
+          >
+            <PlusIcon className="w-4 h-4 mr-1.5" />
+            <span>Add a Passkey</span>
+          </button>
+        </div>
+
+        {/* Passkeys List */}
+        <div className="mt-6 divide-y divide-gray-100">
+          {passkeys.length === 0 ? (
+            <div className="text-center py-10 bg-gray-50 rounded-lg border border-dashed border-gray-300">
+              <KeyIcon className="w-12 h-12 text-gray-400 mx-auto mb-2" />
+              <p className="text-sm font-semibold text-gray-700">No passkeys registered yet</p>
+              <p className="text-xs text-gray-500 max-w-sm mx-auto mt-1 mb-4">
+                Register a passkey to experience instant, password-free sign-ins using Touch ID, Face ID, or Windows Hello.
+              </p>
+              <button
+                onClick={() => setShowAddModal(true)}
+                className="px-4 py-2 bg-gray-900 text-white text-xs font-semibold rounded-md shadow hover:bg-gray-800"
+              >
+                Create Your First Passkey
+              </button>
+            </div>
+          ) : (
+            passkeys.map((pk) => (
+              <div key={pk.id} className="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
+                <div className="flex items-start space-x-3">
+                  <div className="p-2.5 bg-gray-100 text-gray-700 rounded-lg mt-0.5">
+                    <FingerPrintIcon className="w-6 h-6" />
+                  </div>
+                  <div>
+                    <div className="flex items-center space-x-2">
+                      <h3 className="text-sm font-bold text-gray-900">{pk.name}</h3>
+                      <span
+                        className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${
+                          pk.deviceType === 'multiDevice'
+                            ? 'bg-purple-100 text-purple-800'
+                            : 'bg-gray-100 text-gray-800'
+                        }`}
+                      >
+                        {pk.deviceType === 'multiDevice' ? 'Synced Passkey' : 'Hardware Key'}
+                      </span>
+                      {pk.backedUp && (
+                        <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800">
+                          Cloud Backed-up
+                        </span>
+                      )}
+                    </div>
+                    <div className="text-xs text-gray-500 mt-1 space-x-3">
+                      <span>Added: {new Date(pk.createdAt).toLocaleDateString()}</span>
+                      <span>&bull;</span>
+                      <span>
+                        Last used: {pk.lastUsedAt ? new Date(pk.lastUsedAt).toLocaleDateString() : 'Never'}
+                      </span>
+                    </div>
+                    <div className="text-[11px] font-mono text-gray-400 mt-0.5">
+                      ID: {pk.id.slice(0, 16)}...
+                    </div>
+                  </div>
+                </div>
+
+                <div className="flex items-center space-x-2 self-end sm:self-auto">
+                  <button
+                    onClick={() => {
+                      setRenamingPasskey(pk);
+                      setRenameValue(pk.name);
+                    }}
+                    title="Rename Passkey"
+                    className="p-1.5 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-md border border-gray-200"
+                  >
+                    <PencilSquareIcon className="w-4 h-4" />
+                  </button>
+                  <button
+                    onClick={() => {
+                      setDeletingPasskey(pk);
+                    }}
+                    title="Delete Passkey"
+                    className="p-1.5 text-red-500 hover:text-red-700 hover:bg-red-50 rounded-md border border-gray-200"
+                  >
+                    <TrashIcon className="w-4 h-4" />
+                  </button>
+                </div>
+              </div>
+            ))
+          )}
+        </div>
+      </div>
+
+      {/* Add Passkey Modal */}
+      {showAddModal && (
+        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
+          <div className="bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
+            <div className="flex items-center space-x-2 text-gray-900">
+              <FingerPrintIcon className="w-6 h-6 text-gray-800" />
+              <h3 className="text-lg font-bold">Register a New Passkey</h3>
+            </div>
+            <p className="text-xs text-gray-600">
+              Your browser will prompt you to use your device biometric sensor (Touch ID, Face ID, Windows Hello) or an external security key.
+            </p>
+
+            <div>
+              <label htmlFor="passkey-name" className="block text-xs font-semibold text-gray-700 mb-1">
+                Passkey Label (Optional)
+              </label>
+              <input
+                id="passkey-name"
+                type="text"
+                value={newPasskeyName}
+                onChange={(e) => setNewPasskeyName(e.target.value)}
+                placeholder="e.g. MacBook Pro Touch ID, YubiKey 5"
+                className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+
+            <div className="flex justify-end space-x-2 pt-2">
+              <button
+                type="button"
+                onClick={() => setShowAddModal(false)}
+                className="px-4 py-2 text-xs font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md"
+              >
+                Cancel
+              </button>
