--- /dev/null
+++ b/src/components/AuthNav.tsx
@@ -0,0 +1,83 @@
+import React, { useState, useEffect } from 'react';
+import { getCurrentUser, clearCurrentUser, type ClientUser } from '../utils/clientAuth';
+import { FingerPrintIcon, UserCircleIcon } from '@heroicons/react/24/outline';
+
+interface AuthNavProps {
+  baseUrl: string;
+}
+
+export default function AuthNav({ baseUrl }: AuthNavProps) {
+  const [user, setUser] = useState<ClientUser | null>(null);
+  const [isMounted, setIsMounted] = useState(false);
+
+  useEffect(() => {
+    setIsMounted(true);
+    setUser(getCurrentUser());
+
+    const handleAuthChange = (e: any) => {
+      setUser(e.detail as ClientUser | null);
+    };
+
+    window.addEventListener('dtt_auth_change', handleAuthChange);
+    return () => window.removeEventListener('dtt_auth_change', handleAuthChange);
+  }, []);
+
+  const handleSignOut = () => {
+    clearCurrentUser();
+    setUser(null);
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  // Before hydration, render default buttons
+  if (!isMounted || !user) {
+    return (
+      <div className="flex items-center space-x-3">
+        <a
+          href={`${baseUrl}signup`}
+          data-skip-tracking="true"
+          className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700 flex items-center space-x-1"
+        >
+          <FingerPrintIcon className="w-3.5 h-3.5 text-blue-400 inline" />
+          <span>Sign up</span>
+        </a>
+        <a
+          href={`${baseUrl}signin`}
+          data-skip-tracking="true"
+          className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+        >
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-3">
+      <a
+        href={`${baseUrl}account`}
+        data-skip-tracking="true"
+        className="flex items-center space-x-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-1.5 px-3 rounded border border-gray-300 transition-colors"
+      >
+        <UserCircleIcon className="w-4 h-4 text-gray-600" />
+        <span className="max-w-[100px] truncate">{user.username}</span>
+      </a>
+
+      <a
+        href={`${baseUrl}account`}
+        data-skip-tracking="true"
+        className="bg-gray-900 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-800 flex items-center space-x-1"
+      >
+        <FingerPrintIcon className="w-3.5 h-3.5 text-blue-400" />
+        <span>Passkeys & Account</span>
+      </a>
+
+      <button
+        onClick={handleSignOut}
+        data-skip-tracking="true"
+        className="text-gray-500 hover:text-gray-800 text-xs font-medium py-1 px-2"
+      >
+        Sign out
+      </button>
+    </div>
+  );
+}
