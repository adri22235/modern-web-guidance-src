--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,92 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { passkeysDb } from '../../../utils/passkeysDb';
+import { getWebAuthnConfig } from '../../../utils/webauthnConfig';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username, response, name } = body;
+
+    if (!username || !response) {
+      return new Response(JSON.stringify({ error: 'Username and registration response are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = passkeysDb.getUser(username);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const config = getWebAuthnConfig(request);
+
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: (challenge) => passkeysDb.verifyAndConsumeChallenge(challenge, user.username),
+      expectedOrigin: config.expectedOrigin,
+      expectedRPID: config.expectedRPID,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+    const passkeyName = (name && typeof name === 'string' && name.trim())
+      ? name.trim()
+      : `Passkey ${user.passkeys.length + 1} (${credentialDeviceType === 'multiDevice' ? 'Synced' : 'Security Key'})`;
+
+    const storedPasskey = {
+      id: credential.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64'),
+      counter: credential.counter,
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      transports: (credential.transports as string[]) || [],
+      name: passkeyName,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+    };
+
+    passkeysDb.addPasskey(user.username, storedPasskey);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+        },
+        passkey: {
+          id: storedPasskey.id,
+          name: storedPasskey.name,
+          deviceType: storedPasskey.deviceType,
+          backedUp: storedPasskey.backedUp,
+          createdAt: storedPasskey.createdAt,
+        },
+        token: `dtt_token_${user.id}_${Date.now()}`,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    console.error('[register-verify] Error:', err);
+    return new Response(JSON.stringify({ error: err.message || 'Passkey registration verification failed' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
