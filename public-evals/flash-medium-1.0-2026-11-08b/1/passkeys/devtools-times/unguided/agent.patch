diff --git a/src/utils/clientAuth.ts b/src/utils/clientAuth.ts
new file mode 100644
index 0000000..1d3f9f0
--- /dev/null
+++ b/src/utils/clientAuth.ts
@@ -0,0 +1,55 @@
+export interface ClientUser {
+  id?: string;
+  username: string;
+  displayName?: string;
+  token?: string;
+  lastReauthAt?: string;
+}
+
+const AUTH_STORAGE_KEY = 'dtt_user';
+
+export function getCurrentUser(): ClientUser | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(AUTH_STORAGE_KEY);
+    return raw ? JSON.parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+export function setCurrentUser(user: ClientUser): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.setItem(AUTH_STORAGE_KEY, JSON.stringify(user));
+    window.dispatchEvent(new CustomEvent('dtt_auth_change', { detail: user }));
+  } catch (err) {
+    console.error('Failed to store user:', err);
+  }
+}
+
+export function clearCurrentUser(): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.removeItem(AUTH_STORAGE_KEY);
+    window.dispatchEvent(new CustomEvent('dtt_auth_change', { detail: null }));
+  } catch (err) {
+    console.error('Failed to clear user:', err);
+  }
+}
+
+export function setReauthenticated(timestamp: string = new Date().toISOString()): void {
+  const current = getCurrentUser();
+  if (current) {
+    current.lastReauthAt = timestamp;
+    setCurrentUser(current);
+  }
+}
+
+export function isRecentlyReauthenticated(maxAgeMinutes = 15): boolean {
+  const user = getCurrentUser();
+  if (!user || !user.lastReauthAt) return false;
+  const reauthTime = new Date(user.lastReauthAt).getTime();
+  const now = Date.now();
+  return now - reauthTime < maxAgeMinutes * 60 * 1000;
+}
diff --git a/src/utils/passkeysDb.ts b/src/utils/passkeysDb.ts
new file mode 100644
index 0000000..19b4d5d
--- /dev/null
+++ b/src/utils/passkeysDb.ts
@@ -0,0 +1,216 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+export interface StoredPasskey {
+  id: string; // Base64URL credential ID
+  publicKey: string; // Base64 encoded public key
+  counter: number;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  transports?: string[];
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface StoredUser {
+  id: string;
+  username: string;
+  displayName?: string;
+  passkeys: StoredPasskey[];
+  currentChallenge?: string;
+  createdAt: string;
+  lastReauthAt?: string;
+}
+
+interface DatabaseSchema {
+  users: Record<string, StoredUser>;
+}
+
+const DB_FILE = path.resolve(process.cwd(), 'data/passkeys.json');
+
+// In-memory active challenges map: challenge -> { challenge, username, createdAt }
+const activeChallenges = new Map<string, { challenge: string; username?: string; createdAt: number }>();
+
+// Clean up challenges older than 5 minutes
+function purgeExpiredChallenges() {
+  const now = Date.now();
+  for (const [challenge, record] of activeChallenges.entries()) {
+    if (now - record.createdAt > 5 * 60 * 1000) {
+      activeChallenges.delete(challenge);
+    }
+  }
+}
+
+class PasskeysDb {
+  private data: DatabaseSchema = { users: {} };
+  private initialized = false;
+
+  private init() {
+    if (this.initialized) return;
+    try {
+      if (fs.existsSync(DB_FILE)) {
+        const raw = fs.readFileSync(DB_FILE, 'utf-8');
+        this.data = JSON.parse(raw);
+      } else {
+        fs.mkdirSync(path.dirname(DB_FILE), { recursive: true });
+        this.save();
+      }
+    } catch (err) {
+      console.error('[PasskeysDb] Error loading database, using memory store:', err);
+    }
+    this.initialized = true;
+  }
+
+  private save() {
+    try {
+      fs.mkdirSync(path.dirname(DB_FILE), { recursive: true });
+      fs.writeFileSync(DB_FILE, JSON.stringify(this.data, null, 2), 'utf-8');
+    } catch (err) {
+      console.error('[PasskeysDb] Error saving database:', err);
+    }
+  }
+
+  getUser(username: string): StoredUser | null {
+    this.init();
+    const normalized = username.trim().toLowerCase();
+    return this.data.users[normalized] || null;
+  }
+
+  getUserById(id: string): StoredUser | null {
+    this.init();
+    for (const user of Object.values(this.data.users)) {
+      if (user.id === id) return user;
+    }
+    return null;
+  }
+
+  getUserByCredentialId(credentialId: string): StoredUser | null {
+    this.init();
+    for (const user of Object.values(this.data.users)) {
+      if (user.passkeys.some(pk => pk.id === credentialId)) {
+        return user;
+      }
+    }
+    return null;
+  }
+
+  getOrCreateUser(username: string, displayName?: string): StoredUser {
+    this.init();
+    const normalized = username.trim().toLowerCase();
+    if (!this.data.users[normalized]) {
+      this.data.users[normalized] = {
+        id: `user_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`,
+        username: username.trim(),
+        displayName: displayName || username.trim(),
+        passkeys: [],
+        createdAt: new Date().toISOString(),
+      };
+      this.save();
+    }
+    return this.data.users[normalized];
+  }
+
+  saveUser(user: StoredUser): void {
+    this.init();
+    const normalized = user.username.trim().toLowerCase();
+    this.data.users[normalized] = user;
+    this.save();
+  }
+
+  saveChallenge(challenge: string, username?: string): void {
+    purgeExpiredChallenges();
+    activeChallenges.set(challenge, {
+      challenge,
+      username: username ? username.trim().toLowerCase() : undefined,
+      createdAt: Date.now(),
+    });
+    if (username) {
+      const user = this.getUser(username);
+      if (user) {
+        user.currentChallenge = challenge;
+        this.saveUser(user);
+      }
+    }
+  }
+
+  verifyAndConsumeChallenge(challenge: string, username?: string): boolean {
+    purgeExpiredChallenges();
+    const record = activeChallenges.get(challenge);
+    if (record) {
+      activeChallenges.delete(challenge);
+      if (username) {
+        const user = this.getUser(username);
+        if (user && user.currentChallenge) {
+          user.currentChallenge = undefined;
+          this.saveUser(user);
+        }
+      }
+      if (username && record.username && record.username !== username.trim().toLowerCase()) {
+        return false;
+      }
+      return true;
+    }
+    if (username) {
+      const user = this.getUser(username);
+      if (user && user.currentChallenge === challenge) {
+        user.currentChallenge = undefined;
+        this.saveUser(user);
+        return true;
+      }
+    }
+    return false;
+  }
+
+  addPasskey(username: string, passkey: StoredPasskey): StoredUser {
+    const user = this.getOrCreateUser(username);
+    // Remove if already exists with same id (overwrite)
+    user.passkeys = user.passkeys.filter(pk => pk.id !== passkey.id);
+    user.passkeys.push(passkey);
+    this.saveUser(user);
+    return user;
+  }
+
+  updatePasskey(username: string, credentialId: string, updates: Partial<StoredPasskey>): StoredUser | null {
+    const user = this.getUser(username);
+    if (!user) return null;
+    const target = user.passkeys.find(pk => pk.id === credentialId);
+    if (!target) return null;
+    Object.assign(target, updates);
+    this.saveUser(user);
+    return user;
+  }
+
+  deletePasskey(username: string, credentialId: string): boolean {
+    const user = this.getUser(username);
+    if (!user) return false;
+    const initialLen = user.passkeys.length;
+    user.passkeys = user.passkeys.filter(pk => pk.id !== credentialId);
+    if (user.passkeys.length !== initialLen) {
+      this.saveUser(user);
+      return true;
+    }
+    return false;
+  }
+
+  recordPasskeyUsage(username: string, credentialId: string, newCounter: number): void {
+    const user = this.getUser(username);
+    if (!user) return;
+    const passkey = user.passkeys.find(pk => pk.id === credentialId);
+    if (passkey) {
+      passkey.counter = newCounter;
+      passkey.lastUsedAt = new Date().toISOString();
+      this.saveUser(user);
+    }
+  }
+
+  recordReauth(username: string): void {
+    const user = this.getUser(username);
+    if (user) {
+      user.lastReauthAt = new Date().toISOString();
+      this.saveUser(user);
+    }
+  }
+}
+
+export const passkeysDb = new PasskeysDb();
