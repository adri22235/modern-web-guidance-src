+
+    .scroller {
+      --card-width: 280px;
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      -webkit-overflow-scrolling: touch;
+      padding-block: 2.5rem;
+      padding-inline: max(1.5rem, calc(50% - (var(--card-width) / 2)));
+      list-style: none;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller::-webkit-scrollbar {
+      height: 8px;
+    }
+
+    .scroller::-webkit-scrollbar-track {
+      background: var(--secondary);
+      border-radius: 4px;
+    }
+
+    .scroller::-webkit-scrollbar-thumb {
+      background: var(--primary);
+      border-radius: 4px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      width: var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 10px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
+      display: flex;
+      flex-direction: column;
+      overflow: hidden;
+      text-align: left;
+      transform-origin: center center;
+    }
+
+    .product-card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .product-card-body {
+      padding: 18px;
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+    }
+
+    .product-badge {
+      display: inline-block;
+      align-self: flex-start;
+      background: var(--secondary);
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      margin-bottom: 8px;
+    }
+
+    .product-card-body h3 {
+      font-size: 1.2rem;
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .product-card-body p {
+      font-size: 0.88rem;
+      color: #5d4037;
+      margin-bottom: 16px;
+      flex-grow: 1;
+      line-height: 1.45;
+    }
+
+    .product-card-footer {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-top: auto;
+      padding-top: 12px;
+      border-top: 1px solid #efebe9;
+    }
+
+    .product-price {
+      font-size: 1.2rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .product-card-footer .btn {
+      margin-top: 0;
+      padding: 8px 16px;
+      font-size: 0.88rem;
+    }
+
+    /* Scroll-driven animation for carousel cards */
+    @keyframes scale-card {
+      0% {
+        scale: 0.75;
+      }
+      50% {
+        scale: 1;
+      }
+      100% {
+        scale: 0.75;
+      }
+    }
+
+    /* Only runs the effect when the user has no reduced-motion preference */
+    @media (prefers-reduced-motion: no-preference) {
+      /* Include (animation-range: entry) to exclude browsers with partial scroll-driven animation support */
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .scroller > * {
+          /* Applies the animation using an auto duration */
+          animation: scale-card auto linear both;
+          /* Sets the animation timeline to use an anonymous view progress timeline, tracking the element's progress through the scroller on the inline axis */
+          animation-timeline: view(inline);
+        }
+      }
+    }
