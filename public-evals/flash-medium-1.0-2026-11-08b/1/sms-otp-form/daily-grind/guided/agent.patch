+        e.preventDefault();
+        clearPhoneError();
+
+        const rawPhone = phoneInput.value.trim();
+        const digits = rawPhone.replace(/\D/g, '');
+        if (digits.length < 10) {
+          phoneInput.setAttribute('aria-invalid', 'true');
+          phoneError.textContent = 'Please enter a valid 10-digit mobile phone number.';
+          phoneError.hidden = false;
+          phoneInput.focus();
+          return;
+        }
+
+        activePhone = rawPhone;
+        currentOtpCode = generateOtpCode();
+        goToOtpStep();
+      });
+
+      phoneInput.addEventListener('input', () => {
+        if (phoneInput.getAttribute('aria-invalid') === 'true') {
+          clearPhoneError();
+        }
+      });
+
+      // Change phone number button
+      changePhoneBtn.addEventListener('click', () => {
+        stopSmsOtpListener();
+        stepOtp.hidden = true;
+        stepSuccess.hidden = true;
+        stepPhone.hidden = false;
+        phoneInput.focus();
+      });
+
+      // Resend OTP button
+      resendOtpBtn.addEventListener('click', () => {
+        // Abort previous in-flight WebOTP request before generating a new code
+        stopSmsOtpListener();
+
+        currentOtpCode = generateOtpCode();
+        updateSmsPreview();
+        otpInput.value = '';
+        clearOtpError();
+
+        otpStatusBanner.textContent = `A new 6-digit code has been texted to ${activePhone}.`;
+        otpStatusBanner.hidden = false;
+
+        otpInput.focus();
+        startSmsOtpListener();
+      });
+
+      // Simulated auto-fill button (helps test automatic extraction flow)
+      simulateSmsBtn.addEventListener('click', () => {
+        stopSmsOtpListener();
+        otpInput.value = currentOtpCode;
+        clearOtpError();
+        otpForm.requestSubmit();
+      });
+
+      // OTP input paste handling: allow pasting 6 digits seamlessly
+      otpInput.addEventListener('paste', (e) => {
+        const text = (e.clipboardData || window.clipboardData).getData('text');
+        const extracted = text.replace(/\D/g, '').slice(0, 6);
+        if (extracted.length === 6) {
+          e.preventDefault();
+          otpInput.value = extracted;
+          clearOtpError();
+        }
+      });
+
+      otpInput.addEventListener('input', () => {
+        // Filter non-digits
+        const filtered = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (otpInput.value !== filtered) {
+          otpInput.value = filtered;
+        }
+        if (otpInput.getAttribute('aria-invalid') === 'true') {
+          clearOtpError();
+        }
+      });
+
+      // Step 2: OTP Form submission
+      otpForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+
+        const code = otpInput.value.trim();
+        if (!/^\d{6}$/.test(code)) {
+          setOtpError('Please enter the complete 6-digit numeric verification code.');
+          return;
+        }
+
+        // Disable submit button after valid submission is clicked to prevent double-posts
+        otpSubmitBtn.disabled = true;
+        otpSubmitBtn.textContent = 'Verifying...';
+
+        setTimeout(() => {
+          showSuccess();
+        }, 350);
+      });
+
+      function showSuccess() {
+        const purpose = getSelectedPurpose();
+        stepOtp.hidden = true;
+        stepPhone.hidden = true;
+        stepSuccess.hidden = false;
+
+        if (purpose === 'order') {
+          successHeading.textContent = 'Online Order Verified!';
+          successMessage.textContent = 'Your order #DG-9241 has been confirmed and queued for immediate brewing.';
+          successDetails.innerHTML = `
+            <dl>
+              <dt>Order Number:</dt>
+              <dd>#DG-9241</dd>
+              <dt>Verified Phone:</dt>
+              <dd>${activePhone}</dd>
+              <dt>Pickup Location:</dt>
+              <dd>Downtown Artisanal Roastery</dd>
+              <dt>Estimated Prep:</dt>
+              <dd>8–12 minutes</dd>
+            </dl>
+          `;
+        } else {
+          successHeading.textContent = 'Rewards Sign-In Verified!';
+          successMessage.textContent = 'Welcome back to Daily Grind Rewards! Your perks and mobile ordering balance are ready.';
+          successDetails.innerHTML = `
+            <dl>
+              <dt>Member Phone:</dt>
+              <dd>${activePhone}</dd>
+              <dt>Loyalty Tier:</dt>
+              <dd>Gold Bean Member</dd>
+              <dt>Star Balance:</dt>
+              <dd>420 Stars (Free Drink Ready)</dd>
+              <dt>Next Reward:</dt>
+              <dd>80 Stars to Free Pastry</dd>
+            </dl>
+          `;
+        }
+
+        newVerificationBtn.focus();
+      }
+
+      // Reset / Verify another
+      newVerificationBtn.addEventListener('click', () => {
+        stopSmsOtpListener();
+        otpForm.reset();
+        phoneForm.reset();
+        phoneInput.value = '(555) 234-5678';
+        clearOtpError();
+        clearPhoneError();
+        otpSubmitBtn.disabled = false;
+        otpSubmitBtn.textContent = 'Verify Code';
+        otpStatusBanner.hidden = true;
+
+        stepSuccess.hidden = true;
+        stepOtp.hidden = true;
+        stepPhone.hidden = false;
+        phoneInput.focus();
+      });
+
+      // Nav and Hero action link integration
+      const rewardsLink = document.querySelector('nav a[href="/rewards"]');
+      if (rewardsLink) {
+        rewardsLink.addEventListener('click', (e) => {
+          e.preventDefault();
+          const r = document.getElementById('purpose-rewards');
+          if (r) r.checked = true;
+          document.getElementById('verification-section').scrollIntoView({ behavior: 'smooth' });
+          if (!stepOtp.hidden) {
+            otpInput.focus();
+          } else {
+            phoneInput.focus();
+          }
+        });
+      }
+
+      const orderLink = document.querySelector('.hero a[href="/order-online"]');
+      if (orderLink) {
+        orderLink.addEventListener('click', (e) => {
+          e.preventDefault();
+          const o = document.getElementById('purpose-order');
+          if (o) o.checked = true;
+          document.getElementById('verification-section').scrollIntoView({ behavior: 'smooth' });
+          if (!stepOtp.hidden) {
+            otpInput.focus();
+          } else {
+            phoneInput.focus();
+          }
+        });
+      }
+
+      // Initialize preview on page load
+      updateSmsPreview();
+    });
+  </script>
 </body>
 
