@@ -0,0 +1,60 @@
+import type { APIRoute } from 'astro';
+import { verifyOtp } from '../../utils/otpStore.ts';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { phone, code } = body;
+
+    if (!phone || !code) {
+      return new Response(
+        JSON.stringify({
+          error: 'Missing fields',
+          message: 'Phone number and verification code are required.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const result = verifyOtp(phone, code);
+
+    if (!result.valid) {
+      return new Response(
+        JSON.stringify({
+          error: 'Verification failed',
+          message: result.error || 'Invalid verification code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        message: 'Phone number verified successfully.',
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Server error',
+        message: 'Failed to verify code.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
diff --git a/src/utils/otpStore.ts b/src/utils/otpStore.ts
new file mode 100644
index 0000000..0bf73a9
--- /dev/null
+++ b/src/utils/otpStore.ts
@@ -0,0 +1,63 @@
+interface StoredOtp {
+  code: string;
+  expiresAt: number;
+}
+
+// In-memory store for active verification codes
+const otpStore = new Map<string, StoredOtp>();
+
+export function normalizePhone(phone: string): string {
+  // Strip whitespace, dashes, parentheses
+  return phone.replace(/[\s\-()]/g, '');
+}
+
+export function cleanHostDomain(rawDomain: string): string {
+  // Use only the host domain: no protocol, port, or path
+  return rawDomain
+    .trim()
+    .replace(/^https?:\/\//i, '')
+    .split('/')[0]
+    .split(':')[0]
+    .toLowerCase();
+}
+
+export function generateSmsMessage(code: string, domain: string): string {
+  const host = cleanHostDomain(domain);
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+export function createOtp(phone: string, domain: string): { code: string; smsMessage: string } {
+  const normalized = normalizePhone(phone);
+  // Generate 6-digit numeric OTP with leading zeros preserved as string
+  const num = Math.floor(Math.random() * 1000000);
+  const code = num.toString().padStart(6, '0');
+  const expiresAt = Date.now() + 10 * 60 * 1000; // 10 minutes
+
+  otpStore.set(normalized, { code, expiresAt });
+
+  const smsMessage = generateSmsMessage(code, domain);
+  return { code, smsMessage };
+}
+
+export function verifyOtp(phone: string, inputCode: string): { valid: boolean; error?: string } {
+  const normalized = normalizePhone(phone);
+  const stored = otpStore.get(normalized);
+
+  if (!stored) {
+    return { valid: false, error: 'No verification code found for this phone number. Please request a new code.' };
+  }
+
+  if (Date.now() > stored.expiresAt) {
+    otpStore.delete(normalized);
+    return { valid: false, error: 'Verification code has expired. Please request a new code.' };
+  }
+
+  const cleanInput = inputCode.trim();
+  if (stored.code !== cleanInput) {
+    return { valid: false, error: 'Incorrect verification code. Please check the code and try again.' };
+  }
+
+  // Code verified successfully, consume it
+  otpStore.delete(normalized);
+  return { valid: true };
+}
