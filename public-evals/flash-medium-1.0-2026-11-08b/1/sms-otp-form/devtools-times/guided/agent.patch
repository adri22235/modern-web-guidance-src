+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { createOtp, cleanHostDomain } from '../../utils/otpStore.ts';
+
+export const POST: APIRoute = async ({ request, url }) => {
+  try {
+    const body = await request.json();
+    const { phone, domain } = body;
+
+    if (!phone || typeof phone !== 'string' || phone.trim().length < 7) {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid phone number',
+          message: 'Please provide a valid phone number.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const hostHeader = request.headers.get('host');
+    const hostDomain = domain
+      ? cleanHostDomain(domain)
+      : cleanHostDomain(hostHeader || url.hostname || 'localhost');
+
+    const { code, smsMessage } = createOtp(phone, hostDomain);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'One-time passcode sent successfully via SMS.',
+        smsMessage,
+        code,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Server error',
+        message: 'Failed to send verification code.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
