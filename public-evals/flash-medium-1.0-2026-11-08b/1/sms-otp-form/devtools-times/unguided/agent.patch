index 0000000..7b589a9
--- /dev/null
+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,54 @@
+import type { APIRoute } from 'astro';
+import { verifyOtpCode, normalizePhoneNumber } from '../../utils/otpStore';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { phoneNumber, code } = body || {};
+
+    if (!phoneNumber || typeof phoneNumber !== 'string') {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (!code || typeof code !== 'string') {
+      return new Response(
+        JSON.stringify({ error: 'Please enter the 6-digit one-time passcode.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const normalized = normalizePhoneNumber(phoneNumber);
+    const result = verifyOtpCode(normalized, code);
+
+    if (!result.success) {
+      return new Response(
+        JSON.stringify({ error: result.error || 'Verification failed.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (session) {
+      await session.set('verifiedPhone', normalized);
+      await session.set('pendingOtp', null);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        phoneNumber: normalized,
+        message: 'Phone number successfully verified.',
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    console.error('Error in verify-otp:', err);
+    return new Response(
+      JSON.stringify({ error: err.message || 'Verification error occurred.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/utils/otpStore.ts b/src/utils/otpStore.ts
new file mode 100644
index 0000000..5293b7b
--- /dev/null
+++ b/src/utils/otpStore.ts
@@ -0,0 +1,110 @@
+import crypto from 'node:crypto';
+
+interface StoredOtp {
+  code: string;
+  phoneNumber: string;
+  expiresAt: number;
+  attempts: number;
+}
+
+// In-memory store persistent across SSR requests in the Node server
+const g = globalThis as unknown as { __otpStore?: Map<string, StoredOtp> };
+if (!g.__otpStore) {
+  g.__otpStore = new Map<string, StoredOtp>();
+}
+
+export const otpStore = g.__otpStore;
+
+/**
+ * Normalizes phone number to digits with optional leading '+'
+ */
+export function normalizePhoneNumber(phoneNumber: string): string {
+  if (!phoneNumber) return '';
+  const trimmed = phoneNumber.trim();
+  const hasPlus = trimmed.startsWith('+');
+  const digits = trimmed.replace(/\D/g, '');
+  return hasPlus ? `+${digits}` : digits;
+}
+
+/**
+ * Validates whether the given string is a valid phone number.
+ * Accepts international (E.164) and local phone numbers (7 to 15 digits).
+ */
+export function isValidPhoneNumber(phoneNumber: string): boolean {
+  const normalized = normalizePhoneNumber(phoneNumber);
+  const digitsOnly = normalized.replace(/\D/g, '');
+  return digitsOnly.length >= 7 && digitsOnly.length <= 15;
+}
+
+/**
+ * Generates a 6-digit OTP code and origin-bound SMS message complying with the WebOTP API spec.
+ */
+export function createOtp(phoneNumber: string, host = 'localhost') {
+  const normalized = normalizePhoneNumber(phoneNumber);
+  // Generate random 6-digit numeric OTP
+  const code = crypto.randomInt(100000, 1000000).toString();
+  const ttlMs = 5 * 60 * 1000; // 5 minutes
+  const expiresAt = Date.now() + ttlMs;
+
+  otpStore.set(normalized, {
+    code,
+    phoneNumber: normalized,
+    expiresAt,
+    attempts: 0,
+  });
+
+  // Strip port from host for origin-bound format if needed, or keep domain per WebOTP spec
+  const domain = host.split(':')[0];
+  const smsText = `Your DevTools Times verification code is: ${code}\n\n@${domain} #${code}`;
+
+  return {
+    code,
+    normalizedPhone: normalized,
+    expiresAt,
+    smsText,
+  };
+}
+
+/**
+ * Verifies a provided OTP against the stored code for the phone number.
+ */
+export function verifyOtpCode(phoneNumber: string, inputCode: string): { success: boolean; error?: string } {
+  const normalized = normalizePhoneNumber(phoneNumber);
+  const record = otpStore.get(normalized);
+
+  if (!record) {
+    return {
+      success: false,
+      error: 'No active verification code found for this phone number. Please request a new code.',
+    };
+  }
+
+  if (Date.now() > record.expiresAt) {
+    otpStore.delete(normalized);
+    return {
+      success: false,
+      error: 'The verification code has expired. Please request a new code.',
+    };
+  }
+
+  if (record.attempts >= 5) {
+    otpStore.delete(normalized);
+    return {
+      success: false,
+      error: 'Too many incorrect attempts. Please request a new verification code.',
+    };
+  }
+
+  record.attempts += 1;
+
+  if (record.code !== inputCode.trim()) {
+    return {
+      success: false,
+      error: 'Invalid verification code. Please check the code sent to your phone and try again.',
+    };
+  }
+
+  // Code is valid! Invalidate so it cannot be reused.
+  otpStore.delete(normalized);
+  return { success: true };
+}
