--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,58 @@
+import type { APIRoute } from 'astro';
+import { createOtp, isValidPhoneNumber, normalizePhoneNumber } from '../../utils/otpStore';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json();
+    const rawPhoneNumber = body?.phoneNumber;
+
+    if (!rawPhoneNumber || typeof rawPhoneNumber !== 'string') {
+      return new Response(
+        JSON.stringify({ error: 'Please provide a valid phone number.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (!isValidPhoneNumber(rawPhoneNumber)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid phone number with 7 to 15 digits (e.g. +1 555-0100).',
+        }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const host = request.headers.get('host') || url.host || 'localhost';
+    const otpData = createOtp(rawPhoneNumber, host);
+
+    if (session) {
+      await session.set('pendingOtp', {
+        phoneNumber: otpData.normalizedPhone,
+        code: otpData.code,
+        expiresAt: otpData.expiresAt,
+      });
+    }
+
+    // Log the WebOTP-formatted SMS for debugging and DevTools testing
+    console.info(`[SMS Dispatch] Delivered SMS to ${otpData.normalizedPhone}:\n${otpData.smsText}`);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: `One-time passcode sent to ${otpData.normalizedPhone}`,
+        phoneNumber: otpData.normalizedPhone,
+        expiresAt: otpData.expiresAt,
+        // Provided for DevTools emulation, testing, and local simulation
+        smsMessage: otpData.smsText,
+        code: otpData.code,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    console.error('Error in send-otp:', err);
+    return new Response(
+      JSON.stringify({ error: err.message || 'Failed to send one-time passcode.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/verify-otp.ts b/src/pages/api/verify-otp.ts
