+  <script type="module">
+    // Graceful fallback for browsers without native Interest Invokers (interestfor)
+    if (!('interestForElement' in HTMLButtonElement.prototype || 'interestForElement' in HTMLAnchorElement.prototype)) {
+      document.querySelectorAll('a[interestfor]').forEach(trigger => {
+        const popoverId = trigger.getAttribute('interestfor');
+        const popover = document.getElementById(popoverId);
+        if (!popover || typeof popover.showPopover !== 'function') return;
+
+        let hideTimeout;
+        const positionFallback = () => {
+          if (!CSS.supports || !CSS.supports('position-area: block-end')) {
+            const rect = trigger.getBoundingClientRect();
+            popover.style.position = 'fixed';
+            popover.style.inset = 'auto';
+            popover.style.margin = '0';
+            popover.style.top = `${rect.bottom + 8}px`;
+            const maxLeft = window.innerWidth - popover.offsetWidth - 16;
+            popover.style.left = `${Math.max(16, Math.min(rect.left, maxLeft))}px`;
+          }
+        };
+
+        const show = () => {
+          clearTimeout(hideTimeout);
+          try {
+            if (!popover.matches(':popover-open')) {
+              positionFallback();
+              popover.showPopover();
+            }
+          } catch (e) {}
+        };
+
+        const hide = () => {
+          hideTimeout = setTimeout(() => {
+            try {
+              if (popover.matches(':popover-open')) {
+                popover.hidePopover();
+              }
+            } catch (e) {}
+          }, 150);
+        };
+
+        trigger.addEventListener('mouseenter', show);
+        trigger.addEventListener('mouseleave', hide);
+        trigger.addEventListener('focus', show);
+        trigger.addEventListener('blur', hide);
+
+        popover.addEventListener('mouseenter', show);
+        popover.addEventListener('mouseleave', hide);
+      });
+    }
+  </script>
+
