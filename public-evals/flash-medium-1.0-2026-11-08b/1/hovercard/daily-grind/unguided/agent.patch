+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const hovercardWrappers = document.querySelectorAll('.hovercard-wrapper');
+
+      hovercardWrappers.forEach(wrapper => {
+        const trigger = wrapper.querySelector('.hovercard-trigger');
+        const hovercard = wrapper.querySelector('.hovercard');
+        const card = wrapper.closest('.card');
+        if (!trigger || !hovercard) return;
+
+        let openTimeout = null;
+        let closeTimeout = null;
+
+        const showHovercard = () => {
+          clearTimeout(closeTimeout);
+          openTimeout = setTimeout(() => {
+            // Position adjustment: check if clipping top of viewport
+            const rect = trigger.getBoundingClientRect();
+            const cardHeight = hovercard.offsetHeight || 380;
+            if (rect.top - cardHeight < 15) {
+              hovercard.classList.add('placement-bottom');
+            } else {
+              hovercard.classList.remove('placement-bottom');
+            }
+
+            hovercard.classList.add('is-visible');
+            trigger.setAttribute('aria-expanded', 'true');
+            if (card) card.classList.add('has-active-hovercard');
+          }, 120);
+        };
+
+        const hideHovercard = () => {
+          clearTimeout(openTimeout);
+          closeTimeout = setTimeout(() => {
+            hovercard.classList.remove('is-visible');
+            trigger.setAttribute('aria-expanded', 'false');
+            if (card) card.classList.remove('has-active-hovercard');
+          }, 240);
+        };
+
+        // Trigger events
+        trigger.addEventListener('mouseenter', showHovercard);
+        trigger.addEventListener('mouseleave', hideHovercard);
+        trigger.addEventListener('focus', showHovercard);
+        trigger.addEventListener('blur', hideHovercard);
+
+        // Hovercard events (allows moving cursor into hovercard without closing)
+        hovercard.addEventListener('mouseenter', () => {
+          clearTimeout(closeTimeout);
+        });
+        hovercard.addEventListener('mouseleave', hideHovercard);
+
+        // Close on Escape key
+        wrapper.addEventListener('keydown', (e) => {
+          if (e.key === 'Escape') {
+            clearTimeout(openTimeout);
+            clearTimeout(closeTimeout);
+            hovercard.classList.remove('is-visible');
+            trigger.setAttribute('aria-expanded', 'false');
+            if (card) card.classList.remove('has-active-hovercard');
+            trigger.focus();
+          }
+        });
+
+        // Interactive size selector chips inside hovercard
+        const sizeButtons = hovercard.querySelectorAll('.size-btn');
+        const priceBadge = hovercard.querySelector('.badge-price');
+        const basePrice = parseFloat(priceBadge ? priceBadge.dataset.basePrice || priceBadge.textContent.replace('$', '') : 0);
+
+        sizeButtons.forEach(btn => {
+          btn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            sizeButtons.forEach(b => b.classList.remove('active'));
+            btn.classList.add('active');
+            const delta = parseFloat(btn.dataset.priceDelta || 0);
+            if (priceBadge && basePrice) {
+              const newPrice = (basePrice + delta).toFixed(2);
+              priceBadge.textContent = `$${newPrice}`;
+              const quickAddBtn = hovercard.querySelector('.hovercard-btn-secondary');
+              if (quickAddBtn) {
+                quickAddBtn.textContent = `Quick Add · $${newPrice}`;
+              }
+            }
+          });
+        });
+
+        // Quick add feedback
+        const quickAdd = hovercard.querySelector('.hovercard-btn-secondary');
+        if (quickAdd) {
+          quickAdd.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            const originalText = quickAdd.textContent;
+            quickAdd.textContent = 'Added! ✓';
+            quickAdd.style.background = '#c8e6c9';
+            quickAdd.style.color = '#2e7d32';
+            quickAdd.style.borderColor = '#81c784';
+            setTimeout(() => {
+              quickAdd.textContent = originalText;
+              quickAdd.style.background = '';
+              quickAdd.style.color = '';
+              quickAdd.style.borderColor = '';
+            }, 1800);
+          });
+        }
+      });
+    });
+  </script>
+
 </body>
 
