+          '&': '&amp;',
+          '<': '&lt;',
+          '>': '&gt;',
+          "'": '&#39;',
+          '"': '&quot;'
+        }[tag] || tag));
+      }
+
+      // Quantity adjustments and removal
+      cartItemsList.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-action]');
+        if (!btn) return;
+
+        const action = btn.dataset.action;
+        const index = parseInt(btn.dataset.index, 10);
+        if (isNaN(index) || !cartItems[index]) return;
+
+        if (action === 'increase') {
+          cartItems[index].quantity += 1;
+        } else if (action === 'decrease') {
+          cartItems[index].quantity -= 1;
+          if (cartItems[index].quantity <= 0) {
+            cartItems.splice(index, 1);
+          }
+        } else if (action === 'remove') {
+          cartItems.splice(index, 1);
+        }
+
+        renderCart();
+      });
+
+      // Quick add buttons
+      document.querySelectorAll('.quick-add-btn').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const name = btn.dataset.name;
+          const basePrice = parseFloat(btn.dataset.price) || 4.00;
+
+          const selectedSizeOption = sizeSelect.options[sizeSelect.selectedIndex];
+          const sizeExtra = parseFloat(selectedSizeOption.dataset.extra) || 0;
+          const size = selectedSizeOption.value;
+          const milk = milkSelect.value;
+          const unitPrice = basePrice + sizeExtra;
+
+          // Check if identical item exists in cart
+          const existingItem = cartItems.find(
+            item => item.name === name && item.size === size && item.milk === milk
+          );
+
+          if (existingItem) {
+            existingItem.quantity += 1;
+          } else {
+            cartItems.push({
+              id: 'item-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),
+              name: name,
+              size: size,
+              milk: milk,
+              unitPrice: unitPrice,
+              quantity: 1
+            });
+          }
+
+          // Reset order confirmation if visible
+          orderConfirmation.style.display = 'none';
+          cartFooter.style.display = 'flex';
+
+          renderCart();
+        });
+      });
+
+      // Clear cart
+      clearCartBtn.addEventListener('click', () => {
+        cartItems = [];
+        renderCart();
+      });
+
+      // Checkout / Place Order
+      checkoutBtn.addEventListener('click', () => {
+        if (cartItems.length === 0) return;
+
+        const orderNum = Math.floor(1000 + Math.random() * 9000);
+        confirmationDetails.textContent = `Order #${orderNum} received! Our baristas are preparing your drinks. Estimated pickup in 7-10 minutes.`;
+
+        cartFooter.style.display = 'none';
+        orderConfirmation.style.display = 'flex';
+      });
+
+      // New Order button after checkout
+      newOrderBtn.addEventListener('click', () => {
+        cartItems = [];
+        orderConfirmation.style.display = 'none';
+        cartFooter.style.display = 'flex';
+        renderCart();
+      });
+
+      // Minimize/Expand Panel toggle
+      minimizeBtn.addEventListener('click', () => {
+        const isMin = draggable.classList.toggle('is-minimized');
+        if (isMin) {
+          minimizeIcon.textContent = '+';
+          minimizeBtn.setAttribute('aria-label', 'Expand cart panel');
+          minimizeBtn.setAttribute('title', 'Expand panel');
+        } else {
+          minimizeIcon.textContent = '−';
+          minimizeBtn.setAttribute('aria-label', 'Minimize cart panel');
+          minimizeBtn.setAttribute('title', 'Minimize panel');
+        }
+
+        // Re-clamp position after size change
+        const rect = draggable.getBoundingClientRect();
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+        draggable.style.left = `${Math.max(0, Math.min(rect.left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(rect.top, maxTop))}px`;
+      });
+
+      // Initial render
+      renderCart();
+    })();
+  </script>
 </body>
 
