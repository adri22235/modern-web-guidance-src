+        }
+
+        isDragging = true;
+        handle.setPointerCapture(e.pointerId);
+
+        const rect = panel.getBoundingClientRect();
+        panel.style.left = rect.left + 'px';
+        panel.style.top = rect.top + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+
+        startX = e.clientX;
+        startY = e.clientY;
+        initialLeft = rect.left;
+        initialTop = rect.top;
+
+        panel.classList.add('dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', (e) => {
+        if (!isDragging) return;
+
+        const dx = e.clientX - startX;
+        const dy = e.clientY - startY;
+
+        let newLeft = initialLeft + dx;
+        let newTop = initialTop + dy;
+
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+
+        newLeft = Math.min(Math.max(0, newLeft), maxLeft);
+        newTop = Math.min(Math.max(0, newTop), maxTop);
+
+        panel.style.left = newLeft + 'px';
+        panel.style.top = newTop + 'px';
+      });
+
+      const endDrag = (e) => {
+        if (!isDragging) return;
+        isDragging = false;
+        panel.classList.remove('dragging');
+        try {
+          handle.releasePointerCapture(e.pointerId);
+        } catch (err) {}
+      };
+
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      // Reset Position Button
+      btnResetPos.addEventListener('click', (e) => {
+        e.stopPropagation();
+        panel.style.left = '';
+        panel.style.top = '';
+        panel.style.right = '24px';
+        panel.style.bottom = '24px';
+      });
+
+      // Collapse / Expand Toggle
+      btnToggleCollapse.addEventListener('click', (e) => {
+        e.stopPropagation();
+        const isCollapsed = panel.classList.toggle('collapsed');
+        btnToggleCollapse.textContent = isCollapsed ? '+' : '−';
+        btnToggleCollapse.title = isCollapsed ? 'Expand panel' : 'Collapse panel';
+        btnToggleCollapse.setAttribute('aria-label', isCollapsed ? 'Expand panel' : 'Collapse panel');
+      });
+
+      // ==========================================
+      // TABS LOGIC
+      // ==========================================
+      tabButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          tabButtons.forEach((b) => {
+            b.classList.remove('active');
+            b.setAttribute('aria-selected', 'false');
+          });
+          document.querySelectorAll('.tab-content').forEach((tc) => tc.classList.remove('active'));
+
+          btn.classList.add('active');
+          btn.setAttribute('aria-selected', 'true');
+          const targetTabId = btn.getAttribute('data-tab');
+          const targetTab = document.getElementById(targetTabId);
+          if (targetTab) targetTab.classList.add('active');
+        });
+      });
+
+      function switchToTab(tabId) {
+        const btn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
+        if (btn) btn.click();
+      }
+
+      // ==========================================
+      // ITEM SELECTION & CUSTOMIZER
+      // ==========================================
+      function renderQuickItems() {
+        quickItemsContainer.innerHTML = '';
+        MENU_ITEMS.forEach((item) => {
+          const card = document.createElement('div');
+          card.className = `quick-item-card ${item.id === selectedMenuItem.id ? 'selected' : ''}`;
+          card.setAttribute('role', 'button');
+          card.setAttribute('tabindex', '0');
+          card.innerHTML = `
+            <img src="${item.image}" alt="${item.name}">
+            <div class="quick-item-name">${item.name}</div>
+            <div class="quick-item-price">$${item.basePrice.toFixed(2)}</div>
+          `;
+          card.addEventListener('click', () => selectMenuItem(item));
+          card.addEventListener('keydown', (e) => {
+            if (e.key === 'Enter' || e.key === ' ') {
+              e.preventDefault();
+              selectMenuItem(item);
+            }
+          });
+          quickItemsContainer.appendChild(card);
+        });
+      }
+
+      function selectMenuItem(item) {
+        selectedMenuItem = item;
+        currentQuantity = 1;
+        qtyInput.value = currentQuantity;
+        customizerTitle.textContent = `Customize: ${item.name}`;
+
+        if (item.category === 'pastry') {
+          sizeGroup.style.display = 'none';
+          milkGroup.style.display = 'none';
+          addonsGroup.style.display = 'none';
+        } else {
+          sizeGroup.style.display = 'block';
+          milkGroup.style.display = 'block';
+          addonsGroup.style.display = 'block';
+        }
+
+        renderQuickItems();
+        updateAddButtonPrice();
+      }
+
+      function calculateCurrentUnitPrice() {
+        let price = selectedMenuItem.basePrice;
+        if (selectedMenuItem.category !== 'pastry') {
+          const selectedSizeOption = sizeSelect.options[sizeSelect.selectedIndex];
+          const sizePrice = parseFloat(selectedSizeOption.getAttribute('data-price') || '0');
+          price += sizePrice;
+
+          if (addonShot.checked) {
+            price += parseFloat(addonShot.getAttribute('data-price') || '0');
+          }
+          if (addonSyrup.checked) {
+            price += parseFloat(addonSyrup.getAttribute('data-price') || '0');
+          }
+        }
+        return price;
+      }
+
+      function updateAddButtonPrice() {
+        const unit = calculateCurrentUnitPrice();
+        const total = unit * currentQuantity;
+        btnAddPrice.textContent = `$${total.toFixed(2)}`;
+      }
+
+      sizeSelect.addEventListener('change', updateAddButtonPrice);
+      addonShot.addEventListener('change', updateAddButtonPrice);
+      addonSyrup.addEventListener('change', updateAddButtonPrice);
+
+      btnQtyMinus.addEventListener('click', () => {
+        if (currentQuantity > 1) {
+          currentQuantity--;
+          qtyInput.value = currentQuantity;
+          updateAddButtonPrice();
+        }
+      });
+
+      btnQtyPlus.addEventListener('click', () => {
+        if (currentQuantity < 20) {
+          currentQuantity++;
+          qtyInput.value = currentQuantity;
+          updateAddButtonPrice();
+        }
+      });
+
+      btnAddToCart.addEventListener('click', () => {
+        const isPastry = selectedMenuItem.category === 'pastry';
+        const sizeOption = sizeSelect.options[sizeSelect.selectedIndex];
+        const size = isPastry ? 'Standard' : sizeOption.value;
+        const sizePrice = isPastry ? 0 : parseFloat(sizeOption.getAttribute('data-price') || '0');
+        const milk = isPastry ? null : milkSelect.value;
+
+        const addons = [];
+        let addonsPrice = 0;
+        if (!isPastry) {
+          if (addonShot.checked) {
+            addons.push('Extra Shot');
+            addonsPrice += parseFloat(addonShot.getAttribute('data-price') || '0');
+          }
+          if (addonSyrup.checked) {
+            addons.push('Vanilla Syrup');
+            addonsPrice += parseFloat(addonSyrup.getAttribute('data-price') || '0');
+          }
+        }
+
+        const unitPrice = selectedMenuItem.basePrice + sizePrice + addonsPrice;
+
+        cart.push({
+          id: 'item-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),
+          menuItemId: selectedMenuItem.id,
+          name: selectedMenuItem.name,
+          basePrice: selectedMenuItem.basePrice,
+          size,
+          sizePrice,
+          milk,
+          addons,
+          addonsPrice,
+          unitPrice,
+          quantity: currentQuantity
+        });
+
+        // Reset inputs
+        currentQuantity = 1;
+        qtyInput.value = 1;
+        addonShot.checked = false;
+        addonSyrup.checked = false;
+        orderSuccessContainer.innerHTML = '';
+        updateAddButtonPrice();
+        renderCart();
+
+        // Visual flash feedback on button
+        const originalText = btnAddToCart.innerHTML;
+        btnAddToCart.style.background = '#2e7d32';
+        btnAddToCart.innerHTML = '<span>✓ Added!</span>';
+        setTimeout(() => {
+          btnAddToCart.style.background = '';
+          btnAddToCart.innerHTML = originalText;
+          updateAddButtonPrice();
+        }, 800);
+      });
+
+      // ==========================================
+      // CART RENDERING & OPERATIONS
+      // ==========================================
+      function renderCart() {
+        const totalItemsCount = cart.reduce((sum, item) => sum + item.quantity, 0);
+        cartBadge.textContent = totalItemsCount;
+        tabCartCount.textContent = totalItemsCount;
+
+        if (cart.length === 0) {
+          cartItemsList.innerHTML = `
+            <div class="empty-cart-msg">
+              <div style="font-size: 1.8rem;">☕</div>
+              <p>Your coffee cart is empty.<br>Select a roast or pastry from Quick Order!</p>
+            </div>
+          `;
+          summarySubtotal.textContent = '$0.00';
+          summaryTax.textContent = '$0.00';
+          summaryTotal.textContent = '$0.00';
+          btnCheckout.disabled = true;
+          return;
+        }
+
+        btnCheckout.disabled = false;
+        cartItemsList.innerHTML = '';
+
+        let subtotal = 0;
+
+        cart.forEach((item, index) => {
+          const itemTotal = item.unitPrice * item.quantity;
+          subtotal += itemTotal;
+
+          const row = document.createElement('div');
+          row.className = 'cart-item-row';
+
+          let details = [];
+          if (item.size && item.size !== 'Standard') details.push(item.size);
+          if (item.milk) details.push(item.milk);
+          if (item.addons && item.addons.length > 0) details.push(item.addons.join(', '));
+          const metaText = details.join(' • ');
+
+          row.innerHTML = `
+            <div class="cart-item-info">
+              <div class="cart-item-title">${item.quantity}x ${item.name}</div>
+              ${metaText ? `<div class="cart-item-meta">${metaText}</div>` : ''}
+            </div>
+            <div class="cart-item-price-ctrl">
+              <div class="item-subtotal">$${itemTotal.toFixed(2)}</div>
+              <button type="button" class="remove-btn" data-index="${index}" aria-label="Remove ${item.name}">Remove</button>
+            </div>
+          `;
+
+          row.querySelector('.remove-btn').addEventListener('click', () => {
+            cart.splice(index, 1);
+            renderCart();
+          });
+
+          cartItemsList.appendChild(row);
+        });
+
+        const tax = subtotal * 0.08;
+        const total = subtotal + tax;
+
+        summarySubtotal.textContent = `$${subtotal.toFixed(2)}`;
+        summaryTax.textContent = `$${tax.toFixed(2)}`;
+        summaryTotal.textContent = `$${total.toFixed(2)}`;
+      }
+
+      btnClearCart.addEventListener('click', () => {
+        cart = [];
+        orderSuccessContainer.innerHTML = '';
+        renderCart();
+      });
+
+      btnCheckout.addEventListener('click', () => {
+        if (cart.length === 0) return;
+
+        const orderNum = Math.floor(1000 + Math.random() * 9000);
+        const total = summaryTotal.textContent;
+
+        orderSuccessContainer.innerHTML = `
+          <div class="order-success-banner">
+            <h4>🎉 Order Placed! (#DG-${orderNum})</h4>
+            <p>Total: <strong>${total}</strong></p>
+            <p>Your barista is preparing your order at the counter. Estimated pickup in <strong>6–8 minutes</strong>.</p>
+          </div>
+        `;
+
+        cart = [];
+        renderCart();
+      });
+
+      // ==========================================
+      // INTEGRATION WITH HOMEPAGE BUTTONS
+      // ==========================================
+      // Hero "Order Now" button opens and un-collapses quick order
+      const heroOrderBtn = document.querySelector('.hero .btn');
+      if (heroOrderBtn) {
+        heroOrderBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          panel.classList.remove('collapsed');
+          btnToggleCollapse.textContent = '−';
+          switchToTab('order-tab');
+        });
+      }
+
+      // Seasonal cards' "View Details" selects matching item
+      const seasonalCards = document.querySelectorAll('.grid .card');
+      const seasonalMapping = [
+        'maple-oat-latte',
+        'dark-roast-espresso',
+        'cold-brew'
+      ];
+
+      seasonalCards.forEach((card, idx) => {
+        const btn = card.querySelector('.btn');
+        if (btn && seasonalMapping[idx]) {
+          btn.addEventListener('click', (e) => {
+            e.preventDefault();
+            const targetItem = MENU_ITEMS.find((m) => m.id === seasonalMapping[idx]);
+            if (targetItem) {
+              panel.classList.remove('collapsed');
+              btnToggleCollapse.textContent = '−';
+              switchToTab('order-tab');
+              selectMenuItem(targetItem);
+            }
+          });
+        }
+      });
+
+      // Initial Render
+      renderQuickItems();
+      selectMenuItem(MENU_ITEMS[0]);
+      renderCart();
+    })();
+  </script>
 </body>
 
 </html>
