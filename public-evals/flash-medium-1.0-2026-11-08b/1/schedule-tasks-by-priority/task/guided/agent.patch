+  <script>
+    (function () {
+      const PRIORITY_ORDER = {
+        'user-blocking': 1,
+        'user-visible': 2,
+        'background': 3
+      };
+
+      let taskCounter = 0;
+      let clickCounter = 0;
+      let pendingQueue = [];
+      let isProcessing = false;
+      let currentTask = null;
+      let totalCompleted = 0;
+
+      const hasScheduler = typeof window !== 'undefined' && 'scheduler' in window && 'postTask' in window.scheduler;
+      const hasYield = typeof window !== 'undefined' && 'scheduler' in window && 'yield' in window.scheduler;
+
+      // DOM Elements
+      const apiBadge = document.getElementById('api-support-badge');
+      const testClicksEl = document.getElementById('test-clicks-counter');
+      const testBtn = document.getElementById('test-responsive-btn');
+      const urgentBtn = document.getElementById('btn-urgent-checkout');
+      const standardBtn = document.getElementById('btn-standard-menu');
+      const backgroundBtn = document.getElementById('btn-background-telemetry');
+      const batchBtn = document.getElementById('btn-batch-mixed');
+      const clearBtn = document.getElementById('btn-clear-logs');
+
+      const countUrgentEl = document.getElementById('count-urgent');
+      const countStandardEl = document.getElementById('count-standard');
+      const countBackgroundEl = document.getElementById('count-background');
+      const countCompletedEl = document.getElementById('count-completed');
+
+      const activeTaskTitle = document.getElementById('active-task-title');
+      const activeTaskDesc = document.getElementById('active-task-desc');
+      const activeTaskPriority = document.getElementById('active-task-priority');
+      const progressBarFill = document.getElementById('progress-bar-fill');
+      const logContainer = document.getElementById('execution-log');
+
+      // Display API support status
+      if (apiBadge) {
+        if (hasScheduler && hasYield) {
+          apiBadge.textContent = 'Native scheduler.postTask & scheduler.yield Active';
+          apiBadge.className = 'api-badge';
+        } else if (hasScheduler) {
+          apiBadge.textContent = 'Native scheduler.postTask Active (yield fallback: setTimeout)';
+          apiBadge.className = 'api-badge';
+        } else {
+          apiBadge.textContent = 'Priority Queue & setTimeout cooperative yield active (cross-browser fallback)';
+          apiBadge.className = 'api-badge fallback';
+        }
+      }
+
+      // UI Responsiveness test button listener (increments instantly without lag)
+      testBtn.addEventListener('click', () => {
+        clickCounter++;
+        testClicksEl.textContent = clickCounter;
+      });
+
+      function log(message, badgeText = 'system', badgeClass = 'system') {
+        const now = new Date();
+        const timeStr = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');
+        const entry = document.createElement('div');
+        entry.className = 'log-entry';
+        entry.innerHTML = `
+          <span class="log-time">${timeStr}</span>
+          <span class="log-badge ${badgeClass}">${badgeText}</span>
+          <span class="log-msg">${message}</span>
+        `;
+        logContainer.appendChild(entry);
+        logContainer.scrollTop = logContainer.scrollHeight;
+      }
+
+      function updateQueueUI() {
+        const urgent = pendingQueue.filter(t => t.priority === 'user-blocking').length;
+        const standard = pendingQueue.filter(t => t.priority === 'user-visible').length;
+        const background = pendingQueue.filter(t => t.priority === 'background').length;
+
+        countUrgentEl.textContent = urgent;
+        countStandardEl.textContent = standard;
+        countBackgroundEl.textContent = background;
+        countCompletedEl.textContent = totalCompleted;
+
+        if (!isProcessing) {
+          activeTaskTitle.textContent = 'Idle';
+          activeTaskDesc.textContent = 'Queue is clear. Ready for tasks.';
+          activeTaskPriority.textContent = 'None';
+          activeTaskPriority.className = 'priority-badge';
+          progressBarFill.style.width = '0%';
+        }
+      }
+
+      // Cooperative yielding to prevent blocking the main thread
+      async function yieldToBrowser(deadlineRef) {
+        if (performance.now() >= deadlineRef.deadline) {
+          if (hasYield) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadlineRef.deadline = performance.now() + 50; // 50ms budget
+        }
+      }
+
+      // Task Execution Runner
+      async function executeTask(task) {
+        isProcessing = true;
+        currentTask = task;
+        const startTime = performance.now();
+
+        activeTaskTitle.textContent = task.name;
+        activeTaskDesc.textContent = task.description;
+        activeTaskPriority.textContent = task.priority;
+        activeTaskPriority.className = `priority-badge priority-${task.badgeType}`;
+
+        log(`Started: ${task.name}`, task.priority, task.badgeType);
+
+        let deadlineRef = { deadline: performance.now() + 50 }; // 50ms budget
+
+        for (let step = 1; step <= task.steps; step++) {
+          // Perform computational chunk
+          let sum = 0;
+          for (let j = 0; j < task.chunkWork; j++) {
+            sum += Math.sqrt(j * 1.5) * Math.sin(j);
+          }
+
+          const pct = Math.round((step / task.steps) * 100);
+          progressBarFill.style.width = `${pct}%`;
+
+          // Yield periodically to keep UI responsive
+          await yieldToBrowser(deadlineRef);
+        }
+
+        const duration = (performance.now() - startTime).toFixed(1);
+        totalCompleted++;
+        log(`Completed: ${task.name} (${duration}ms)`, task.priority, task.badgeType);
+
+        currentTask = null;
+        isProcessing = false;
+        updateQueueUI();
+      }
+
+      // Process Next Task from the Prioritized Queue
+      async function processQueue() {
+        if (isProcessing || pendingQueue.length === 0) return;
+
+        // Ensure tasks are sorted by priority (user-blocking > user-visible > background)
+        pendingQueue.sort((a, b) => PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority]);
+
+        const nextTask = pendingQueue.shift();
+        updateQueueUI();
+
+        if (hasScheduler) {
+          scheduler.postTask(async () => {
+            await executeTask(nextTask);
+            processQueue();
+          }, { priority: nextTask.priority });
+        } else {
+          setTimeout(async () => {
+            await executeTask(nextTask);
+            processQueue();
+          }, 0);
+        }
+      }
+
+      function enqueueTask(task, shouldProcess = true) {
+        pendingQueue.push(task);
+        // Prioritize immediately
+        pendingQueue.sort((a, b) => PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority]);
+        updateQueueUI();
+        log(`Enqueued: ${task.name} [Priority: ${task.priority}]`, task.priority, task.badgeType);
+        if (shouldProcess) {
+          processQueue();
+        }
+      }
+
+      // Task Creators
+      function createUrgentCheckoutTask() {
+        taskCounter++;
+        return {
+          id: taskCounter,
+          name: `Urgent Checkout #${taskCounter}`,
+          description: 'Express POS payment authorization & customer receipt printing',
+          priority: 'user-blocking',
+          badgeType: 'urgent',
+          steps: 40,
+          chunkWork: 16000
+        };
+      }
+
+      function createStandardMenuTask() {
+        taskCounter++;
+        return {
+          id: taskCounter,
+          name: `Menu Update #${taskCounter}`,
+          description: 'Seasonal inventory pricing sync & digital menu board refresh',
+          priority: 'user-visible',
+          badgeType: 'standard',
+          steps: 45,
+          chunkWork: 18000
+        };
+      }
+
+      function createBackgroundTelemetryTask() {
+        taskCounter++;
+        return {
+          id: taskCounter,
+          name: `Telemetry Logging #${taskCounter}`,
+          description: 'Boiler temperature telemetry, grinder burr RPM & diagnostic logging',
+          priority: 'background',
+          badgeType: 'background',
+          steps: 55,
+          chunkWork: 20000
+        };
+      }
+
+      // Event Listeners for Queue Simulator Controls
+      urgentBtn.addEventListener('click', () => {
+        enqueueTask(createUrgentCheckoutTask());
+      });
+
+      standardBtn.addEventListener('click', () => {
+        enqueueTask(createStandardMenuTask());
+      });
+
+      backgroundBtn.addEventListener('click', () => {
+        enqueueTask(createBackgroundTelemetryTask());
+      });
+
+      batchBtn.addEventListener('click', () => {
+        log('Submitting mixed batch of 6 tasks in reverse/mixed order...', 'BATCH', 'system');
+
+        // Mixed/reverse submission order to demonstrate priority queue reorganization
+        const mixedBatch = [
+          createBackgroundTelemetryTask(),
+          createStandardMenuTask(),
+          createUrgentCheckoutTask(),
+          createBackgroundTelemetryTask(),
+          createUrgentCheckoutTask(),
+          createStandardMenuTask()
+        ];
+
+        for (const task of mixedBatch) {
+          pendingQueue.push(task);
+        }
+
+        // Sort by priority order: user-blocking first, user-visible second, background third
+        pendingQueue.sort((a, b) => PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority]);
+        updateQueueUI();
+
+        log('Batch prioritized: Urgent checkout tasks (user-blocking) scheduled ahead of menu updates and telemetry.', 'BATCH', 'system');
+        processQueue();
+      });
+
