+        </div>
+        <div class="responsiveness-tester">
+          <button id="btn-test-click" class="btn-test" type="button" title="Click to verify the UI does not freeze during task execution">
+            ⚡ Test UI Responsiveness (Clicks: <span id="click-counter">0</span>)
+          </button>
+          <button id="btn-clear-history" class="btn-reset" type="button" title="Clear completed tasks and reset counters">
+            Clear Completed
+          </button>
+        </div>
+      </div>
+
+      <!-- Simulator Execution Panels -->
+      <div class="ops-grid">
+        <!-- Left: Active Task & Queue -->
+        <div class="ops-panel">
+          <h3>
+            <span>Active Worker</span>
+            <span id="worker-status-badge" class="ops-badge" style="background:#eee; color:#666;">Idle</span>
+          </h3>
+
+          <div class="active-task-container" id="active-task-box">
+            <div class="active-task-header">
+              <span class="active-task-title" id="active-task-title">No task currently running</span>
+              <span id="active-task-badge" class="ops-badge" style="display:none;"></span>
+            </div>
+            <div class="progress-bar-bg">
+              <div class="progress-bar-fill" id="active-task-progress"></div>
+            </div>
+            <div class="active-task-subtext">
+              <span id="active-task-step">Ready for incoming operations</span>
+              <span id="active-task-percent">0%</span>
+            </div>
+          </div>
+
+          <h3>
+            <span>Pending Priority Queue</span>
+            <span id="queue-count" class="ops-badge" style="background:#e0d7d2; color:#4e342e;">0 queued</span>
+          </h3>
+          <ul class="queue-list" id="queue-list">
+            <li class="empty-state" id="queue-empty-msg">No pending tasks. Click any button above to enqueue operations.</li>
+          </ul>
+        </div>
+
+        <!-- Right: Operations History / Completed -->
+        <div class="ops-panel">
+          <h3>
+            <span>Completed Operations</span>
+            <span id="history-count" class="ops-badge" style="background:#c8e6c9; color:#2e7d32;">0 finished</span>
+          </h3>
+          <ul class="history-list" id="history-list">
+            <li class="empty-state" id="history-empty-msg">Completed tasks will appear here in execution order.</li>
+          </ul>
+        </div>
+      </div>
+    </section>
+
+    <script>
+      (function() {
+        // Priority Definitions (Lower number = Higher execution priority)
+        const PRIORITIES = {
+          URGENT: {
+            level: 1,
+            label: 'Urgent Checkout',
+            badgeClass: 'badge-urgent',
+            color: '#c62828',
+            stepDuration: 80,
+            steps: 10
+          },
+          STANDARD: {
+            level: 2,
+            label: 'Standard Menu',
+            badgeClass: 'badge-standard',
+            color: '#e65100',
+            stepDuration: 120,
+            steps: 10
+          },
+          BACKGROUND: {
+            level: 3,
+            label: 'Telemetry Log',
+            badgeClass: 'badge-background',
+            color: '#1565c0',
+            stepDuration: 160,
+            steps: 10
+          }
+        };
+
+        // Task name templates
+        const TASK_TEMPLATES = {
+          URGENT: [
+            'Express POS Checkout - Terminal #1',
+            'Mobile Order Checkout - Customer #204',
+            'Card Authorization Settlement - Front Counter',
+            'Curbside Pickup Checkout - Order #318'
+          ],
+          STANDARD: [
+            'Sync Cold Brew Inventory & Stock Levels',
+            'Update Seasonal Maple Latte Prices',
+            'Refresh Barista Recipe & Drink Display',
+            'Publish Oat Milk Supply Availability'
+          ],
+          BACKGROUND: [
+            'Log Burr Grinder RPM & Temperature Diagnostics',
+            'Upload Hourly Store Foot-Traffic Telemetry',
+            'Archive Espresso Boiler PSI Pressure Logs',
+            'Sync Daily Machine Cleaning Telemetry'
+          ]
+        };
+
+        let taskIdCounter = 1;
+        const queue = [];
+        const completedTasks = [];
+        let isProcessing = false;
+
+        // UI Element References
+        const queueListEl = document.getElementById('queue-list');
+        const queueEmptyMsgEl = document.getElementById('queue-empty-msg');
+        const queueCountEl = document.getElementById('queue-count');
+        const historyListEl = document.getElementById('history-list');
+        const historyEmptyMsgEl = document.getElementById('history-empty-msg');
+        const historyCountEl = document.getElementById('history-count');
+        const workerStatusBadge = document.getElementById('worker-status-badge');
+        const activeTaskTitle = document.getElementById('active-task-title');
+        const activeTaskBadge = document.getElementById('active-task-badge');
+        const activeTaskProgress = document.getElementById('active-task-progress');
+        const activeTaskStep = document.getElementById('active-task-step');
+        const activeTaskPercent = document.getElementById('active-task-percent');
+        const clickCounterEl = document.getElementById('click-counter');
+        const btnTestClick = document.getElementById('btn-test-click');
+        const fpsDisplayEl = document.getElementById('fps-display');
+
+        // Task Factory
+        function createTask(priorityKey, customName) {
+          const priority = PRIORITIES[priorityKey];
+          const templates = TASK_TEMPLATES[priorityKey];
+          const name = customName || templates[Math.floor(Math.random() * templates.length)];
+          const id = taskIdCounter++;
+          return {
+            id,
+            name,
+            priorityKey,
+            priority,
+            createdAt: new Date(),
+            progress: 0
+          };
+        }
+
+        // Priority Queue Insertion (Sort by priority.level ascending, then FIFO by id)
+        function enqueueTask(task) {
+          queue.push(task);
+          queue.sort((a, b) => {
+            if (a.priority.level !== b.priority.level) {
+              return a.priority.level - b.priority.level;
+            }
+            return a.id - b.id;
+          });
+          renderQueue();
+          triggerProcessQueue();
+        }
+
+        // Render Queue UI
+        function renderQueue() {
+          queueCountEl.textContent = `${queue.length} queued`;
+          queueListEl.innerHTML = '';
+
+          if (queue.length === 0) {
+            queueListEl.appendChild(queueEmptyMsgEl);
+            return;
+          }
+
+          queue.forEach((task, index) => {
+            const li = document.createElement('li');
+            li.className = `queue-item priority-${task.priorityKey.toLowerCase()}`;
+            li.innerHTML = `
+              <div class="queue-item-info">
+                <span class="queue-item-name">#${index + 1} - ${task.name}</span>
+                <span class="queue-item-meta">Task ID: ${task.id} &bull; Queued: ${task.createdAt.toLocaleTimeString()}</span>
+              </div>
+              <span class="ops-badge ${task.priority.badgeClass}">${task.priority.label}</span>
+            `;
+            queueListEl.appendChild(li);
+          });
+        }
+
+        // Add to Completed History
+        function addToHistory(task, durationMs) {
+          completedTasks.unshift({ task, durationMs, completedAt: new Date() });
+          historyCountEl.textContent = `${completedTasks.length} finished`;
+
+          if (historyEmptyMsgEl.parentNode === historyListEl) {
+            historyListEl.removeChild(historyEmptyMsgEl);
+          }
+
+          const li = document.createElement('li');
+          li.className = 'history-item';
+          li.innerHTML = `
+            <div class="history-item-left">
+              <span class="ops-badge ${task.priority.badgeClass}">${task.priority.label}</span>
+              <span style="font-weight: 600; color: #3e2723;">${task.name}</span>
+            </div>
+            <span class="history-item-time">${durationMs}ms &bull; ${new Date().toLocaleTimeString()}</span>
+          `;
+
+          historyListEl.insertBefore(li, historyListEl.firstChild);
+        }
+
+        // Non-blocking Yield helper to keep UI thread fluid and responsive
+        function yieldToMain(ms) {
+          return new Promise(resolve => setTimeout(resolve, ms));
+        }
+
+        // Worker execution loop
+        async function triggerProcessQueue() {
+          if (isProcessing) return;
+          isProcessing = true;
+
+          while (queue.length > 0) {
+            const currentTask = queue.shift();
+            renderQueue();
+
+            // Update Active Task UI
+            workerStatusBadge.textContent = 'Processing';
+            workerStatusBadge.style.background = '#ffe082';
+            workerStatusBadge.style.color = '#e65100';
+
+            activeTaskTitle.textContent = currentTask.name;
+            activeTaskBadge.style.display = 'inline-block';
+            activeTaskBadge.className = `ops-badge ${currentTask.priority.badgeClass}`;
+            activeTaskBadge.textContent = currentTask.priority.label;
+            activeTaskProgress.style.width = '0%';
+            activeTaskProgress.style.background = `linear-gradient(90deg, ${currentTask.priority.color}, #ffab40)`;
+            activeTaskPercent.textContent = '0%';
+            activeTaskStep.textContent = `Starting ${currentTask.priority.label}...`;
+
+            const startTime = performance.now();
+            const totalSteps = currentTask.priority.steps;
+            const stepDuration = currentTask.priority.stepDuration;
+
+            // Execute long-running task in prioritized, non-blocking time-sliced chunks
+            for (let step = 1; step <= totalSteps; step++) {
+              // Yield execution to the browser event loop so clicks, animations, and repaints are never delayed
+              await yieldToMain(stepDuration);
+
+              // If window.scheduler.yield is supported, yield additionally
+              if (window.scheduler && typeof window.scheduler.yield === 'function') {
+                await window.scheduler.yield();
+              }
+
+              const percent = Math.round((step / totalSteps) * 100);
+              activeTaskProgress.style.width = `${percent}%`;
+              activeTaskPercent.textContent = `${percent}%`;
+              activeTaskStep.textContent = `Processing chunk ${step}/${totalSteps} (Yielded UI thread)`;
+            }
+
+            const endTime = performance.now();
+            const durationMs = Math.round(endTime - startTime);
+            addToHistory(currentTask, durationMs);
+
+            // Small breathing yield between tasks
+            await yieldToMain(40);
+          }
+
+          // Reset Active Task UI when queue empties
+          isProcessing = false;
+          workerStatusBadge.textContent = 'Idle';
+          workerStatusBadge.style.background = '#eee';
+          workerStatusBadge.style.color = '#666';
+          activeTaskTitle.textContent = 'No task currently running';
+          activeTaskBadge.style.display = 'none';
+          activeTaskProgress.style.width = '0%';
+          activeTaskPercent.textContent = '0%';
+          activeTaskStep.textContent = 'Ready for incoming operations';
+        }
+
+        // Button Event Listeners
+        document.getElementById('btn-urgent-task').addEventListener('click', () => {
+          enqueueTask(createTask('URGENT'));
+        });
+
+        document.getElementById('btn-standard-task').addEventListener('click', () => {
+          enqueueTask(createTask('STANDARD'));
+        });
+
+        document.getElementById('btn-background-task').addEventListener('click', () => {
+          enqueueTask(createTask('BACKGROUND'));
+        });
+
+        // Batch execution button: enqueues mixed tasks to demonstrate automatic priority reordering
+        document.getElementById('btn-batch-tasks').addEventListener('click', () => {
+          // Add mixed tasks deliberately in non-priority sequence:
+          // Background -> Standard -> Urgent -> Background -> Urgent -> Standard
+          const batchOrder = ['BACKGROUND', 'STANDARD', 'URGENT', 'BACKGROUND', 'URGENT', 'STANDARD'];
+          batchOrder.forEach(priorityKey => {
+            const task = createTask(priorityKey);
+            queue.push(task);
+          });
+
+          // Sort queue by priority: Urgent (1) -> Standard (2) -> Background (3)
+          queue.sort((a, b) => {
+            if (a.priority.level !== b.priority.level) {
+              return a.priority.level - b.priority.level;
+            }
+            return a.id - b.id;
+          });
+
+          renderQueue();
+          triggerProcessQueue();
+        });
+
+        // Interactive Responsiveness Tester Button
+        let clickCount = 0;
+        btnTestClick.addEventListener('click', () => {
+          clickCount++;
+          clickCounterEl.textContent = clickCount;
+          btnTestClick.style.transform = 'scale(0.96)';
+          setTimeout(() => {
+            btnTestClick.style.transform = 'scale(1)';
+          }, 100);
+        });
+
+        // Clear History
