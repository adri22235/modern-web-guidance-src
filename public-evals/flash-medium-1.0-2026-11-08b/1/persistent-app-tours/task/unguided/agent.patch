+  <script>
+    (function () {
+      const feature = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('tour-close-btn');
+
+      let isTourOpen = true;
+
+      function updatePosition() {
+        if (!isTourOpen || !feature || !tourStep) return;
+
+        const rect = feature.getBoundingClientRect();
+        const stepWidth = tourStep.offsetWidth || 280;
+
+        // Position vertically below the feature link
+        const top = rect.bottom + 10;
+
+        // Position horizontally centered relative to the feature link
+        let left = rect.left + (rect.width / 2) - (stepWidth / 2);
+
+        // Keep within viewport boundaries
+        const padding = 10;
+        if (left < padding) {
+          left = padding;
+        } else if (left + stepWidth > window.innerWidth - padding) {
+          left = window.innerWidth - stepWidth - padding;
+        }
+
+        tourStep.style.top = top + 'px';
+        tourStep.style.left = left + 'px';
+
+        const arrow = tourStep.querySelector('.tour-step-arrow');
+        if (arrow) {
+          const arrowWidth = 12;
+          const targetCenter = rect.left + (rect.width / 2);
+          let arrowLeft = targetCenter - left - (arrowWidth / 2);
+          arrowLeft = Math.max(12, Math.min(stepWidth - 12 - arrowWidth, arrowLeft));
+          arrow.style.left = arrowLeft + 'px';
+        }
+      }
+
+      function closeTour() {
+        isTourOpen = false;
+        if (tourStep) {
+          tourStep.style.display = 'none';
+        }
+      }
+
+      if (closeBtn) {
+        closeBtn.addEventListener('click', closeTour);
+      }
+
+      if (tourStep) {
+        tourStep.querySelectorAll('button').forEach(function (btn) {
+          btn.addEventListener('click', closeTour);
+        });
+      }
+
+      if (feature) {
+        feature.addEventListener('click', function (e) {
+          if (isTourOpen) {
+            e.preventDefault();
+          }
+        });
+      }
+
+      function trackLoop() {
+        if (isTourOpen) {
+          updatePosition();
+          requestAnimationFrame(trackLoop);
+        }
+      }
+
+      updatePosition();
+      window.addEventListener('scroll', updatePosition, { passive: true });
+      window.addEventListener('resize', updatePosition);
+
+      if (window.ResizeObserver) {
+        const ro = new ResizeObserver(updatePosition);
+        ro.observe(document.body);
+        if (feature) ro.observe(feature);
+      }
+
+      requestAnimationFrame(trackLoop);
+    })();
+  </script>
 </body>
 
