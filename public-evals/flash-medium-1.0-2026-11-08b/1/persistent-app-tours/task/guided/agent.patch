+  <script type="module">
+    if (!CSS.supports || !CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning").catch(() => {});
+    }
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill").catch(() => {});
+    }
+  </script>
+
+  <script>
+    (function () {
+      const tourStep = document.getElementById('tour-step');
+      const featureLink = document.getElementById('feature');
+      const closeBtn = tourStep ? tourStep.querySelector('button') : null;
+
+      let tourActive = true;
+
+      function isTourActive() {
+        if (!tourActive) return false;
+        if (tourStep && typeof tourStep.matches === 'function') {
+          try {
+            return tourStep.matches(':popover-open') || tourStep.matches('.\\:popover-open') || tourStep.hasAttribute('open');
+          } catch {
+            return tourActive;
+          }
+        }
+        return tourActive;
+      }
+
+      if (tourStep) {
+        // Open by default
+        if (typeof tourStep.showPopover === 'function') {
+          try {
+            tourStep.showPopover();
+          } catch (e) {
+            tourStep.setAttribute('open', '');
+          }
+        } else {
+          tourStep.setAttribute('open', '');
+        }
+
+        tourStep.addEventListener('toggle', (event) => {
+          if (event.newState === 'closed') {
+            tourActive = false;
+          }
+        });
+
+        if (closeBtn) {
+          closeBtn.addEventListener('click', () => {
+            tourActive = false;
+            if (typeof tourStep.hidePopover === 'function' && tourStep.matches && tourStep.matches(':popover-open')) {
+              tourStep.hidePopover();
+            } else {
+              tourStep.removeAttribute('open');
+              tourStep.style.display = 'none';
+            }
+          });
+        }
+
+        // Automatic fallback positioning if CSS anchor positioning is not supported natively
+        if (!CSS.supports || !CSS.supports('anchor-name: --a')) {
+          function updateFallbackPosition() {
+            if (!isTourActive() || !featureLink) return;
+            const rect = featureLink.getBoundingClientRect();
+            tourStep.style.position = 'fixed';
+            tourStep.style.top = (rect.bottom + 12) + 'px';
+            tourStep.style.left = (rect.left + rect.width / 2) + 'px';
+            tourStep.style.transform = 'translateX(-50%)';
+          }
+          updateFallbackPosition();
+          window.addEventListener('resize', updateFallbackPosition);
+          window.addEventListener('scroll', updateFallbackPosition);
+        }
+      }
+
+      if (featureLink) {
+        featureLink.addEventListener('click', (event) => {
+          if (isTourActive()) {
+            event.preventDefault();
+          }
+        });
+      }
+    })();
+  </script>
+
 </body>
 
