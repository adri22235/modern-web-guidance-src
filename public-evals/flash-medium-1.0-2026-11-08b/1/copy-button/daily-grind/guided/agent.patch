+  <script>
+    const timers = new WeakMap();
+    let lastMessage = '';
+
+    function report(button, ok) {
+      const tip = button.nextElementSibling;
+      if (!tip) return;
+      clearTimeout(timers.get(button));
+      button.removeAttribute('data-copied');
+      button.removeAttribute('data-failed');
+      let message = ok ? 'Copied' : 'Copy failed';
+      if (message === lastMessage) message += '\u00A0';
+      lastMessage = message;
+
+      tip.textContent = '';
+      void button.offsetWidth;
+      button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+      requestAnimationFrame(() => (tip.textContent = message));
+      timers.set(button, setTimeout(() => {
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.textContent = '';
+      }, 2000));
+    }
+
+    function legacyCopy(text) {
+      const field = Object.assign(document.createElement('textarea'), { value: text });
+      field.setAttribute('readonly', '');
+      field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
+      document.body.append(field);
+      field.select();
+      try {
+        return document.execCommand('copy');
+      } catch {
+        return false;
+      } finally {
+        field.remove();
+      }
+    }
+
+    async function copy(button, target, command = '--copy') {
+      if (!button || !target) return;
+      const rawText = target.matches('input, textarea') ? target.value : (target.innerText || target.textContent || '');
+      const text = rawText.trim();
+      if (!text) return;
+      try {
+        await navigator.clipboard.writeText(text);
+        report(button, true);
+      } catch {
+        if (legacyCopy(text)) {
+          report(button, true);
+        } else {
+          report(button, false);
+        }
+      }
+    }
+
+    document.addEventListener('command', (event) => {
+      if (event.command && event.command.startsWith('--copy')) {
+        copy(event.source, event.target, event.command);
+      }
+    }, true);
+
+    if (!('CommandEvent' in window)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[command^="--copy"]');
+        if (!button) return;
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        if (target) copy(button, target, button.getAttribute('command'));
+      });
+    }
+  </script>
+
