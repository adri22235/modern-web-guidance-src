+  <script>
+    const timers = new WeakMap();
+    let lastMessage = '';
+
+    function report(button, ok) {
+      const tip = button.nextElementSibling;
+      if (!tip) return;
+      clearTimeout(timers.get(button));
+      button.removeAttribute('data-copied');
+      button.removeAttribute('data-failed');
+      let message = ok ? 'Copied' : 'Copy failed';
+      if (message === lastMessage) message += '\u00A0';
+      lastMessage = message;
+      tip.textContent = '';
+      void button.offsetWidth;
+      button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+      requestAnimationFrame(() => {
+        tip.textContent = message;
+      });
+      timers.set(button, setTimeout(() => {
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.textContent = '';
+      }, 2000));
+    }
+
+    function legacyCopy(text) {
+      const field = Object.assign(document.createElement('textarea'), { value: text });
+      field.setAttribute('readonly', '');
+      field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
+      document.body.append(field);
+      field.select();
+      try {
+        return document.execCommand('copy');
+      } catch {
+        return false;
+      } finally {
+        field.remove();
+      }
+    }
+
+    async function copy(button, target, command = '--copy') {
+      const text = target.matches('input, textarea')
+        ? target.value
+        : (target.innerText || target.textContent || '').trim();
+      if (!text) return;
+      try {
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          await navigator.clipboard.writeText(text);
+          report(button, true);
+        } else {
+          if (legacyCopy(text)) {
+            report(button, true);
+          } else {
+            report(button, false);
+          }
+        }
+      } catch {
+        if (legacyCopy(text)) {
+          report(button, true);
+        } else {
+          report(button, false);
+        }
+      }
+    }
+
+    // `command` events do not bubble: listen in the capture phase on document.
+    // event.source is the clicked button; event.target is the commandfor element.
+    document.addEventListener('command', (event) => {
+      if (event.command && event.command.startsWith('--copy')) {
+        copy(event.source, event.target, event.command);
+      }
+    }, true);
+
+    // Progressive enhancement click fallback for browsers without Invoker Commands
+    if (!('CommandEvent' in window)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[command^="--copy"]');
+        if (!button) return;
+        const commandFor = button.getAttribute('commandfor');
+        const target = commandFor ? document.getElementById(commandFor) : null;
+        if (target) {
+          copy(button, target, button.getAttribute('command'));
+        }
+      });
+    }
+  </script>
+
