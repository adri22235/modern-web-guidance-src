+  <script>
+    function setupCopyButtons() {
+      const copyButtons = document.querySelectorAll('.card .copy-btn, .copy-btn');
+      copyButtons.forEach(button => {
+        button.addEventListener('click', async () => {
+          let textToCopy = '';
+
+          const targetSelector = button.getAttribute('data-clipboard-target') || button.getAttribute('data-target');
+          if (targetSelector) {
+            const targetEl = document.querySelector(targetSelector);
+            if (targetEl) {
+              textToCopy = targetEl.textContent.trim();
+            }
+          }
+
+          if (!textToCopy) {
+            const card = button.closest('.card');
+            if (card) {
+              const descEl = card.querySelector('p');
+              if (descEl) {
+                textToCopy = descEl.textContent.trim();
+              }
+            }
+          }
+
+          if (!textToCopy) {
+            textToCopy = button.getAttribute('data-clipboard-text') || '';
+          }
+
+          if (!textToCopy) return;
+
+          let copied = false;
+          try {
+            if (navigator.clipboard && navigator.clipboard.writeText) {
+              await navigator.clipboard.writeText(textToCopy);
+              copied = true;
+            }
+          } catch (err) {
+            console.warn('navigator.clipboard.writeText failed, trying fallback', err);
+          }
+
+          if (!copied) {
+            try {
+              const textArea = document.createElement('textarea');
+              textArea.value = textToCopy;
+              textArea.style.position = 'fixed';
+              textArea.style.left = '-9999px';
+              textArea.style.top = '0';
+              document.body.appendChild(textArea);
+              textArea.focus();
+              textArea.select();
+              copied = document.execCommand('copy');
+              document.body.removeChild(textArea);
+            } catch (fallbackErr) {
+              console.error('Fallback copy failed', fallbackErr);
+            }
+          }
+
+          const originalText = button.textContent;
+          button.textContent = 'Copied!';
+          button.classList.add('copied');
+          setTimeout(() => {
+            button.textContent = originalText;
+            button.classList.remove('copied');
+          }, 2000);
+        });
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', setupCopyButtons);
+    } else {
+      setupCopyButtons();
+    }
+  </script>
+
