diff --git a/src/components/ArticleUtilities.tsx b/src/components/ArticleUtilities.tsx
new file mode 100644
index 0000000..e07a461
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,368 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleData {
+  id: string;
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+}
+
+export interface RelatedArticleData {
+  id: string;
+  title: string;
+  summary: string;
+  category: string;
+}
+
+interface Props {
+  article: ArticleData;
+  relatedArticles: RelatedArticleData[];
+}
+
+const FONT_SIZES = ['small', 'medium', 'large', 'x-large'] as const;
+type FontSize = (typeof FONT_SIZES)[number];
+
+const CITATION_FORMATS = ['markdown', 'apa', 'mla', 'chicago'] as const;
+type CitationFormat = (typeof CITATION_FORMATS)[number];
+
+export default function ArticleUtilities({ article, relatedArticles }: Props) {
+  const [fontSize, setFontSize] = useState<FontSize>('medium');
+  const [isReaderMode, setIsReaderMode] = useState(false);
+  const [copiedStatus, setCopiedStatus] = useState<string | null>(null);
+
+  // Apply font size changes to .prose element
+  useEffect(() => {
+    const proseEl = document.querySelector('.prose') as HTMLElement | null;
+    if (!proseEl) return;
+
+    if (fontSize === 'small') {
+      proseEl.style.fontSize = '0.9rem';
+      proseEl.style.lineHeight = '1.6';
+    } else if (fontSize === 'medium') {
+      proseEl.style.fontSize = '1.05rem';
+      proseEl.style.lineHeight = '1.75';
+    } else if (fontSize === 'large') {
+      proseEl.style.fontSize = '1.25rem';
+      proseEl.style.lineHeight = '1.85';
+    } else if (fontSize === 'x-large') {
+      proseEl.style.fontSize = '1.45rem';
+      proseEl.style.lineHeight = '1.95';
+    }
+  }, [fontSize]);
+
+  // Apply reader mode changes
+  useEffect(() => {
+    if (isReaderMode) {
+      document.body.classList.add('reader-mode-active');
+    } else {
+      document.body.classList.remove('reader-mode-active');
+    }
+    return () => {
+      document.body.classList.remove('reader-mode-active');
+    };
+  }, [isReaderMode]);
+
+  // Helper to format citation
+  const generateCitation = (format: CitationFormat = 'markdown'): string => {
+    const year = new Date(article.date).getFullYear() || 2026;
+    const formattedDate = new Date(article.date).toLocaleDateString('en-US', {
+      year: 'numeric',
+      month: 'long',
+      day: 'numeric',
+    });
+    const url = typeof window !== 'undefined' ? window.location.href : '';
+
+    switch (format) {
+      case 'apa':
+        return `${article.author}. (${year}). ${article.title}. The DevTools Times. ${url}`;
+      case 'mla':
+        return `${article.author}. "${article.title}." The DevTools Times, ${formattedDate}, ${url}.`;
+      case 'chicago':
+        return `${article.author}. "${article.title}." The DevTools Times. ${formattedDate}. ${url}.`;
+      case 'markdown':
+      default:
+        return `[${article.title}](${url}) by ${article.author} (${year})`;
+    }
+  };
+
+  // Tool 1: get-current-article
+  useWebMCP({
+    name: 'get-current-article',
+    description: 'Retrieves the complete content, metadata, and plain text of the currently displayed article. Use to read, analyze, or summarize this article.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute() {
+      const proseEl = document.querySelector('.prose');
+      const textContent = proseEl?.textContent?.trim() || '';
+
+      return {
+        id: article.id,
+        slug: article.slug,
+        title: article.title,
+        summary: article.summary,
+        author: article.author,
+        date: article.date,
+        category: article.category,
+        readingTime: article.readingTime,
+        url: window.location.href,
+        content: textContent,
+      };
+    },
+  });
+
+  // Tool 2: get-reading-stats
+  useWebMCP({
+    name: 'get-reading-stats',
+    description: 'Calculates reading statistics such as word count, character count, and estimated reading time for the currently viewed article.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute() {
+      const proseEl = document.querySelector('.prose');
+      const text = proseEl?.textContent?.trim() || '';
+      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
+      const characters = text.length;
+      const paragraphs = proseEl ? proseEl.querySelectorAll('p').length : 0;
+      const estimatedMinutes = Math.max(1, Math.ceil(words / 200));
+
+      return {
+        wordCount: words,
+        characterCount: characters,
+        paragraphCount: paragraphs,
+        estimatedReadingTimeMinutes: estimatedMinutes,
+      };
+    },
+  });
+
+  // Tool 3: get-article-citation
+  useWebMCP({
+    name: 'get-article-citation',
+    description: 'Generates a citation for the current article in various citation formats (markdown, apa, mla, chicago). Use when citing or sharing a reference to this article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        format: {
+          type: 'string',
+          enum: CITATION_FORMATS,
+          default: 'markdown',
+          description: 'Citation style format (markdown, apa, mla, or chicago)',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute({ format = 'markdown' }: { format?: string } = {}) {
+      const selectedFormat = (CITATION_FORMATS.includes(format as CitationFormat) ? format : 'markdown') as CitationFormat;
+      const citation = generateCitation(selectedFormat);
+      return {
+        format: selectedFormat,
+        citation,
+      };
+    },
+  });
+
+  // Tool 4: adjust-font-size
+  useWebMCP({
+    name: 'adjust-font-size',
+    description: 'Adjusts the reading font size of the article body text for comfortable readability.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        size: {
+          type: 'string',
+          enum: FONT_SIZES,
+          description: 'Font size to apply to the article body text ("small", "medium", "large", or "x-large")',
+        },
+      },
+      required: ['size'],
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    execute({ size }: { size: string }) {
+      if (!FONT_SIZES.includes(size as FontSize)) {
+        return {
+          error: `Invalid size "${size}". Supported sizes: ${FONT_SIZES.join(', ')}`,
+          supportedSizes: FONT_SIZES,
+        };
+      }
+      setFontSize(size as FontSize);
+      return {
+        success: true,
+        size,
+        message: `Article font size set to ${size}.`,
+      };
+    },
+  });
+
+  // Tool 5: toggle-reader-mode
+  useWebMCP({
+    name: 'toggle-reader-mode',
+    description: 'Toggles distraction-free reader mode on the current article page, hiding surrounding headers and advertisements.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        enabled: {
+          type: 'boolean',
+          description: 'Optional explicit boolean state: true to enable reader mode, false to disable',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    execute({ enabled }: { enabled?: boolean } = {}) {
+      const nextState = typeof enabled === 'boolean' ? enabled : !isReaderMode;
+      setIsReaderMode(nextState);
+      return {
+        success: true,
+        readerMode: nextState,
+        message: nextState ? 'Reader mode enabled.' : 'Reader mode disabled.',
+      };
+    },
+  });
+
+  // Tool 6: get-related-articles
+  useWebMCP({
+    name: 'get-related-articles',
+    description: 'Retrieves articles related to the currently viewed article. Use to recommend further reading on this topic.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute() {
+      return {
+        currentArticleSlug: article.slug,
+        count: relatedArticles.length,
+        relatedArticles: relatedArticles.map(a => ({
+          id: a.id,
+          title: a.title,
+          summary: a.summary,
+          category: a.category,
+          url: `${window.location.origin}${import.meta.env.BASE_URL}articles/${a.id}`,
+        })),
+      };
+    },
+  });
+
+  // Tool 7: copy-article-link
+  useWebMCP({
+    name: 'copy-article-link',
+    description: 'Copies the permalink URL and title for the current article to the clipboard. Use when sharing the article.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute() {
+      const url = window.location.href;
+      const title = article.title;
+      try {
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          await navigator.clipboard.writeText(url);
+        }
+      } catch {
+        // Ignore clipboard write permission errors
+      }
+      return {
+        success: true,
+        url,
+        title,
+        markdown: `[${title}](${url})`,
+      };
+    },
+  });
+
+  const handleCopyCitation = async () => {
+    const citation = generateCitation('markdown');
+    try {
+      if (navigator.clipboard && navigator.clipboard.writeText) {
+        await navigator.clipboard.writeText(citation);
+        setCopiedStatus('Citation copied!');
+        setTimeout(() => setCopiedStatus(null), 2500);
+      }
+    } catch {
+      setCopiedStatus('Could not copy to clipboard');
+      setTimeout(() => setCopiedStatus(null), 2500);
+    }
+  };
+
+  const handleFontSizeCycle = () => {
+    const currentIndex = FONT_SIZES.indexOf(fontSize);
+    const nextIndex = (currentIndex + 1) % FONT_SIZES.length;
+    setFontSize(FONT_SIZES[nextIndex]);
+  };
+
+  return (
+    <aside aria-label="Article utilities" className="my-4 p-3 bg-gray-50 border border-gray-200 rounded-lg flex flex-wrap items-center justify-between gap-3 text-xs text-gray-700">
+      <div className="flex items-center space-x-2">
+        <span className="font-semibold text-gray-500 uppercase tracking-wider text-[10px]">Article Tools:</span>
+        {article.readingTime && (
+          <span className="bg-gray-200 text-gray-800 px-2 py-0.5 rounded-full font-medium">
+            {article.readingTime} min read
+          </span>
+        )}
+      </div>
+
+      <div className="flex items-center space-x-2">
+        {/* Font size toggle */}
+        <button
+          onClick={handleFontSizeCycle}
+          className="flex items-center space-x-1 px-2.5 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100 transition-colors cursor-pointer"
+          title={`Cycle font size (currently ${fontSize})`}
+          aria-label={`Cycle font size (currently ${fontSize})`}
+        >
+          <span className="font-bold text-sm">A</span>
+          <span className="text-[10px] text-gray-500 uppercase font-medium">{fontSize}</span>
+        </button>
+
+        {/* Copy citation */}
+        <button
+          onClick={handleCopyCitation}
+          className="px-2.5 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100 transition-colors cursor-pointer flex items-center space-x-1"
+          title="Copy Markdown citation"
+          aria-label="Copy Markdown citation"
+        >
+          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
+          </svg>
+          <span>Cite</span>
+        </button>
+
+        {/* Reader mode toggle */}
+        <button
+          onClick={() => setIsReaderMode(!isReaderMode)}
+          className={`px-2.5 py-1 rounded transition-colors cursor-pointer border ${isReaderMode ? 'bg-amber-400 text-gray-900 border-amber-500 font-semibold' : 'bg-white border-gray-300 hover:bg-gray-100'}`}
+          title={isReaderMode ? 'Exit distraction-free reader mode' : 'Enter distraction-free reader mode'}
+          aria-label={isReaderMode ? 'Exit distraction-free reader mode' : 'Enter distraction-free reader mode'}
+        >
+          {isReaderMode ? 'Exit Reader Mode' : 'Reader Mode'}
+        </button>
+
+        {copiedStatus && (
+          <span className="text-amber-600 font-semibold animate-pulse">{copiedStatus}</span>
+        )}
+      </div>
+    </aside>
+  );
+}
