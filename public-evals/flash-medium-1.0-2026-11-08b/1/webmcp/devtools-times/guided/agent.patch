@@ -0,0 +1,105 @@
+import React from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export default function GlobalArticleTools() {
+  // Tool: get-article
+  useWebMCP({
+    name: 'get-article',
+    description: 'Retrieves metadata and summary for any DevTools Times article by its slug identifier. Use when looking up information about a specific article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The slug identifier of the article (e.g., "urban-cycling", "coffee-alchemy")',
+        },
+      },
+      required: ['slug'],
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute({ slug }: { slug: string }, { signal }) {
+      if (!slug || typeof slug !== 'string') {
+        return { error: 'Please provide a valid article slug.' };
+      }
+
+      const cleanSlug = slug.trim().replace(/^\//, '');
+
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+        if (!response.ok) {
+          return { error: `Failed to fetch articles (status ${response.status}).` };
+        }
+
+        const articles: Array<{ slug: string; title: string; summary: string; image?: string }> = await response.json();
+        const article = articles.find(a => a.slug === cleanSlug);
+
+        if (!article) {
+          return {
+            error: `Article with slug "${cleanSlug}" was not found.`,
+            availableSlugs: articles.map(a => a.slug),
+          };
+        }
+
+        return {
+          slug: article.slug,
+          title: article.title,
+          summary: article.summary,
+          url: `${window.location.origin}${import.meta.env.BASE_URL}articles/${article.slug}`,
+        };
+      } catch (err) {
+        if (signal.aborted) throw err;
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  // Tool: list-articles
+  useWebMCP({
+    name: 'list-articles',
+    description: 'Lists articles published across The DevTools Times, optionally filtered by category. Use to browse or discover available stories.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: {
+          type: 'string',
+          description: 'Optional category name to filter articles by (e.g., "lifestyle", "sports", "tech")',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute({ category }: { category?: string } = {}, { signal }) {
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+        if (!response.ok) {
+          return { error: `Failed to fetch articles (status ${response.status}).` };
+        }
+
+        let articles: Array<{ slug: string; title: string; summary: string; category?: string }> = await response.json();
+
+        if (category && typeof category === 'string') {
+          const cat = category.toLowerCase().trim();
+          articles = articles.filter(a => (a.category || '').toLowerCase() === cat);
+        }
+
+        return {
+          total: articles.length,
+          articles: articles.map(a => ({
+            slug: a.slug,
+            title: a.title,
+            summary: a.summary,
+            url: `${window.location.origin}${import.meta.env.BASE_URL}articles/${a.slug}`,
+          })),
+        };
+      } catch (err) {
+        if (signal.aborted) throw err;
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  return null;
+}
