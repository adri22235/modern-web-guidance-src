+/**
+ * Client-side article utilities and WebMCP tools for article pages
+ * Enables AI agents to inspect, read, summarize, and interact with the active article.
+ */
+
+import { ensureWebModelContext, readingListUtilities } from './webmcp';
+
+export interface ArticleDetails {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime: number;
+  wordCount: number;
+  content: string;
+  url: string;
+  image?: string;
+  imageCaption?: string;
+}
+
+export function extractCurrentArticle(): ArticleDetails | null {
+  const container = document.getElementById('article-container');
+  if (!container) return null;
+
+  const slug = container.getAttribute('data-slug') || window.location.pathname.split('/').filter(Boolean).pop() || '';
+  const title = container.getAttribute('data-title') || document.querySelector('h1')?.textContent?.trim() || '';
+  const summary =
+    container.getAttribute('data-summary') ||
+    document.querySelector('article > p')?.textContent?.trim() ||
+    '';
+  const author = container.getAttribute('data-author') || '';
+  const date = container.getAttribute('data-date') || '';
+  const category = container.getAttribute('data-category') || '';
+  const readingTime = Number(container.getAttribute('data-reading-time') || 0);
+
+  const proseElement = container.querySelector('.prose');
+  const content = proseElement ? (proseElement.textContent || '').trim().replace(/\s+/g, ' ') : '';
+  const wordCount = content ? content.split(/\s+/).length : 0;
+
+  const imgEl = container.querySelector('figure img') as HTMLImageElement | null;
+  const image = imgEl ? imgEl.src : undefined;
+
+  const captionEl = container.querySelector('figure figcaption');
+  const imageCaption = captionEl ? captionEl.textContent?.trim() : undefined;
+
+  return {
+    slug,
+    title,
+    summary,
+    author,
+    date,
+    category,
+    readingTime: readingTime || Math.max(1, Math.ceil(wordCount / 200)),
+    wordCount,
+    content,
+    url: window.location.href,
+    image,
+    imageCaption,
+  };
+}
+
+export function extractRelatedArticles(): Array<{ title: string; summary: string; url: string }> {
+  const relatedSection = document.getElementById('related-articles-section');
+  if (!relatedSection) return [];
+
+  const articles: Array<{ title: string; summary: string; url: string }> = [];
+  const teasers = relatedSection.querySelectorAll('article');
+
+  teasers.forEach((teaser) => {
+    const titleEl = teaser.querySelector('h3');
+    const summaryEl = teaser.querySelector('p');
+    const linkEl = teaser.querySelector('a[href*="/articles/"]') as HTMLAnchorElement | null;
+
+    if (titleEl && linkEl) {
+      articles.push({
+        title: titleEl.textContent?.trim() || '',
+        summary: summaryEl?.textContent?.trim() || '',
+        url: linkEl.href,
+      });
+    }
+  });
+
+  return articles;
+}
+
+export const articleUtilities = {
+  getCurrentArticle(): ArticleDetails {
+    const article = extractCurrentArticle();
+    if (!article) {
+      throw new Error('Not currently on an article page');
+    }
+    return article;
+  },
+
+  getArticleContent(): string {
+    const article = extractCurrentArticle();
+    if (!article) {
+      throw new Error('Not currently on an article page');
+    }
+    return article.content;
+  },
+
+  getArticleSummary(): { title: string; summary: string } {
+    const article = extractCurrentArticle();
+    if (!article) {
+      throw new Error('Not currently on an article page');
+    }
+    return {
+      title: article.title,
+      summary: article.summary,
+    };
+  },
+
+  getArticleMetadata(): Omit<ArticleDetails, 'content'> {
+    const article = extractCurrentArticle();
+    if (!article) {
+      throw new Error('Not currently on an article page');
+    }
+    const { content, ...metadata } = article;
+    return metadata;
+  },
+
+  getRelatedArticles(): Array<{ title: string; summary: string; url: string }> {
+    return extractRelatedArticles();
+  },
+
+  async bookmarkCurrentArticle(): Promise<{ bookmarked: boolean; readingList: string[] }> {
+    const article = extractCurrentArticle();
+    if (!article || !article.slug) {
+      throw new Error('Not currently on an article page or slug not found');
+    }
+    return await readingListUtilities.toggleReadingList(article.slug);
+  },
+
+  estimateReadingTime(text?: string): { words: number; readingTimeMinutes: number } {
+    let targetText = text;
+    if (!targetText) {
+      const article = extractCurrentArticle();
+      targetText = article ? article.content : '';
+    }
+    const words = targetText.trim() ? targetText.trim().split(/\s+/).length : 0;
+    const readingTimeMinutes = Math.max(1, Math.ceil(words / 200));
+    return { words, readingTimeMinutes };
+  },
+
+  shareArticle(platform?: string): { url: string; platform?: string; shareUrl?: string } {
+    const url = window.location.href;
+    const title = document.querySelector('h1')?.textContent?.trim() || document.title;
+
+    let shareUrl: string | undefined;
+    switch (platform?.toLowerCase()) {
+      case 'x':
+      case 'twitter':
+        shareUrl = `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
+        break;
+      case 'facebook':
+        shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
+        break;
+      case 'whatsapp':
+        shareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${url}`)}`;
+        break;
+      case 'email':
+        shareUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
+        break;
+      case 'copy':
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(url).catch(() => {});
+        }
+        break;
+    }
+
+    return { url, platform, shareUrl };
+  },
+};
+
+const ARTICLE_TOOL_NAMES = [
+  'get_current_article',
+  'get_article_content',
+  'read_article',
+  'get_article_summary',
+  'summarize_article',
+  'get_article_metadata',
+  'bookmark_current_article',
+  'get_related_articles',
+  'estimate_reading_time',
+  'share_current_article',
+];
+
+export async function registerArticleTools() {
+  const container = document.getElementById('article-container');
+  if (!container) return;
+
+  const context = ensureWebModelContext();
+  if (!context || typeof context.registerTool !== 'function') return;
+
+  // Expose on window
+  (window as any).articleUtilities = articleUtilities;
+
+  // 1. Get Current Article
+  await context.registerTool({
+    name: 'get_current_article',
+    description:
+      'Get full details of the article currently being viewed on The DevTools Times, including title, summary, author, category, publication date, reading time, and body content.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return articleUtilities.getCurrentArticle();
+    },
+  });
+
+  // 2. Get Article Content
+  const articleContentTool = {
+    name: 'get_article_content',
+    description: 'Get the full body text of the article currently being viewed on the page.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return {
+        content: articleUtilities.getArticleContent(),
+      };
+    },
+  };
+  await context.registerTool(articleContentTool);
+
+  // Alias: read_article
+  await context.registerTool({
+    ...articleContentTool,
+    name: 'read_article',
+    description: 'Read the full text content of the article currently being viewed.',
+  });
+
+  // 3. Get Article Summary
+  const articleSummaryTool = {
+    name: 'get_article_summary',
+    description: 'Get the summary and headline of the article currently being viewed.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return articleUtilities.getArticleSummary();
+    },
+  };
+  await context.registerTool(articleSummaryTool);
+
+  // Alias: summarize_article
+  await context.registerTool({
+    ...articleSummaryTool,
+    name: 'summarize_article',
+    description: 'Summarize the article currently being viewed.',
+  });
+
+  // 4. Get Article Metadata
+  await context.registerTool({
+    name: 'get_article_metadata',
+    description:
+      'Get metadata of the current article including title, author, category, publication date, reading time, and image caption.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return articleUtilities.getArticleMetadata();
+    },
+  });
+
+  // 5. Bookmark Current Article
+  await context.registerTool({
+    name: 'bookmark_current_article',
+    description:
+      'Toggle the bookmark / reading list status for the article currently being viewed.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return await articleUtilities.bookmarkCurrentArticle();
+    },
+  });
+
+  // 6. Get Related Articles
+  await context.registerTool({
+    name: 'get_related_articles',
+    description: 'Get the list of related articles displayed on the current article page.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      return {
+        relatedArticles: articleUtilities.getRelatedArticles(),
+      };
+    },
+  });
+
+  // 7. Estimate Reading Time
+  await context.registerTool({
+    name: 'estimate_reading_time',
+    description:
+      'Estimate reading time in minutes for the current article or a provided piece of text (calculated at ~200 WPM).',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        text: {
+          type: 'string',
+          description: 'Optional custom text to estimate reading time for. Defaults to current article text.',
+        },
+      },
+    },
+    execute: async ({ text }: { text?: string } = {}) => {
+      return articleUtilities.estimateReadingTime(text);
+    },
+  });
+
+  // 8. Share Current Article
+  await context.registerTool({
+    name: 'share_current_article',
+    description: 'Get share URL or copy link for the current article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        platform: {
+          type: 'string',
+          enum: ['x', 'facebook', 'whatsapp', 'email', 'copy'],
+          description: 'Platform to share on.',
+        },
+      },
+    },
+    execute: async ({ platform }: { platform?: string } = {}) => {
+      return articleUtilities.shareArticle(platform);
+    },
+  });
+}
+
+export async function unregisterArticleTools() {
+  const context = ensureWebModelContext();
+  if (!context || typeof context.unregisterTool !== 'function') return;
+
+  for (const name of ARTICLE_TOOL_NAMES) {
+    try {
+      await context.unregisterTool(name);
+    } catch {
+      // ignore
+    }
+  }
+}
+
+// Auto-register on article page load
+if (typeof window !== 'undefined') {
+  const init = () => {
+    if (document.getElementById('article-container')) {
+      registerArticleTools().catch((err) => console.error('Failed to register article tools:', err));
+    } else {
+      unregisterArticleTools().catch(() => {});
+    }
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+
+  document.addEventListener('astro:page-load', init);
+}
