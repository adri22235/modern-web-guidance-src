+/**
+ * WebMCP (Web Model Context Protocol) initialization and client-side browser tools
+ * Enables AI agents in the browser to discover and invoke client-side tools and forms.
+ */
+
+export interface ModelContextTool {
+  name: string;
+  description: string;
+  inputSchema?: Record<string, any>;
+  execute: (input?: any, options?: any) => Promise<any> | any;
+}
+
+export class WebModelContext extends EventTarget {
+  private _tools = new Map<string, ModelContextTool>();
+  public ontoolchange: ((event: Event) => void) | null = null;
+
+  async registerTool(tool: ModelContextTool, _options?: any): Promise<void> {
+    if (!tool.name || typeof tool.name !== 'string') {
+      throw new Error('Tool name is required and must be a string');
+    }
+    if (!tool.description || typeof tool.description !== 'string') {
+      throw new Error('Tool description is required and must be a string');
+    }
+    if (typeof tool.execute !== 'function') {
+      throw new Error('Tool execute must be a function');
+    }
+
+    this._tools.set(tool.name, tool);
+    this._dispatchToolChange();
+  }
+
+  async unregisterTool(name: string): Promise<boolean> {
+    const existed = this._tools.delete(name);
+    if (existed) {
+      this._dispatchToolChange();
+    }
+    return existed;
+  }
+
+  async getTools(_options?: any): Promise<ModelContextTool[]> {
+    const toolsMap = new Map<string, ModelContextTool>(this._tools);
+
+    // Discover declarative form tools from the DOM
+    if (typeof document !== 'undefined') {
+      const forms = document.querySelectorAll<HTMLFormElement>('form[toolname]');
+      forms.forEach((form) => {
+        const toolname = form.getAttribute('toolname');
+        const tooldescription = form.getAttribute('tooldescription') || '';
+        if (!toolname) return;
+
+        // Skip if an imperative tool with this name already exists
+        if (toolsMap.has(toolname)) return;
+
+        const properties: Record<string, any> = {};
+        const required: string[] = [];
+
+        const elements = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
+          'input[name], select[name], textarea[name]'
+        );
+
+        elements.forEach((el) => {
+          const name = el.name;
+          if (!name) return;
+
+          const paramDesc =
+            el.getAttribute('toolparamdescription') ||
+            el.getAttribute('placeholder') ||
+            el.getAttribute('aria-label') ||
+            '';
+          const paramTitle = el.getAttribute('toolparamtitle') || name;
+          const type = el.type === 'number' ? 'number' : el.type === 'checkbox' ? 'boolean' : 'string';
+
+          properties[name] = {
+            type,
+            title: paramTitle,
+            description: paramDesc,
+          };
+
+          if (el.hasAttribute('required')) {
+            required.push(name);
+          }
+        });
+
+        toolsMap.set(toolname, {
+          name: toolname,
+          description: tooldescription,
+          inputSchema: {
+            type: 'object',
+            properties,
+            required,
+          },
+          execute: async (input: Record<string, any> = {}) => {
+            // Populate form fields
+            Object.entries(input).forEach(([key, val]) => {
+              const field = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
+              if (field) {
+                if (field.type === 'checkbox') {
+                  (field as HTMLInputElement).checked = Boolean(val);
+                } else {
+                  field.value = String(val);
+                }
+                field.dispatchEvent(new Event('input', { bubbles: true }));
+                field.dispatchEvent(new Event('change', { bubbles: true }));
+              }
+            });
+
+            // Submit form
+            if (typeof form.requestSubmit === 'function') {
+              form.requestSubmit();
+            } else {
+              form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
+            }
+
+            return {
+              success: true,
+              message: `Form tool "${toolname}" executed with provided parameters.`,
+              input,
+            };
+          },
+        });
+      });
+    }
+
+    return Array.from(toolsMap.values());
+  }
+
+  async executeTool(toolOrName: ModelContextTool | string, inputObject: any = {}, _options?: any): Promise<any> {
+    const name = typeof toolOrName === 'string' ? toolOrName : toolOrName.name;
+    const tools = await this.getTools();
+    const tool = tools.find((t) => t.name === name);
+
+    if (!tool) {
+      throw new Error(`Tool "${name}" not found`);
+    }
+
+    return await tool.execute(inputObject, _options);
+  }
+
+  async clearContext(): Promise<void> {
+    this._tools.clear();
+    this._dispatchToolChange();
+  }
+
+  private _dispatchToolChange() {
+    const event = new Event('toolchange');
+    this.dispatchEvent(event);
+    if (this.ontoolchange) {
+      try {
+        this.ontoolchange(event);
+      } catch (err) {
+        console.error('Error in ontoolchange handler:', err);
+      }
+    }
+  }
+}
+
+/**
+ * Initialize WebMCP on document and navigator
+ */
+export function ensureWebModelContext(): WebModelContext | any {
+  if (typeof window === 'undefined') return null;
+
+  let context = document.modelContext || (navigator as any).modelContext || (window as any).modelContext;
+
+  if (!context) {
+    context = new WebModelContext();
+    try {
+      Object.defineProperty(document, 'modelContext', {
+        value: context,
+        writable: true,
+        configurable: true,
+      });
+    } catch {
+      (document as any).modelContext = context;
+    }
+
+    try {
+      Object.defineProperty(navigator, 'modelContext', {
+        value: context,
+        writable: true,
+        configurable: true,
+      });
+    } catch {
+      (navigator as any).modelContext = context;
+    }
+
+    (window as any).modelContext = context;
+  } else {
+    // If native or already defined, ensure both document and navigator have it
+    if (!document.modelContext) (document as any).modelContext = context;
+    if (!(navigator as any).modelContext) (navigator as any).modelContext = context;
+  }
+
+  return context;
+}
+
+/**
+ * Global Search & Reading List Utilities
+ */
+export const searchUtilities = {
+  async searchArticles(query: string) {
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/articles.json`);
+    const articles = await response.json();
+    const normalized = (query || '').toLowerCase().trim();
+
+    if (!normalized) {
+      return { query, count: articles.length, articles };
+    }
+
+    const filtered = articles.filter(
+      (a: any) =>
+        (a.title && a.title.toLowerCase().includes(normalized)) ||
+        (a.summary && a.summary.toLowerCase().includes(normalized))
+    );
+
+    return { query, count: filtered.length, articles: filtered };
+  },
+
+  async getAllArticles() {
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/articles.json`);
+    return await response.json();
+  },
+};
+
+export const readingListUtilities = {
+  async getReadingList(): Promise<string[]> {
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/reading-list.json`);
+    const data = await response.json();
+    return data.readingList || [];
+  },
+
+  async addToReadingList(slug: string): Promise<{ success: boolean; readingList: string[] }> {
+    const list = await this.getReadingList();
+    if (list.includes(slug)) {
+      return { success: true, readingList: list };
+    }
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/reading-list.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug }),
+    });
+    const data = await response.json();
+    window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList: data.readingList } }));
+    return { success: true, readingList: data.readingList };
+  },
+
+  async removeFromReadingList(slug: string): Promise<{ success: boolean; readingList: string[] }> {
+    const list = await this.getReadingList();
+    if (!list.includes(slug)) {
+      return { success: true, readingList: list };
+    }
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/reading-list.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug }),
+    });
+    const data = await response.json();
+    window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList: data.readingList } }));
+    return { success: true, readingList: data.readingList };
+  },
+
+  async toggleReadingList(slug: string): Promise<{ bookmarked: boolean; readingList: string[] }> {
+    const baseUrl = import.meta.env.BASE_URL;
+    const response = await fetch(`${baseUrl}api/reading-list.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug }),
+    });
+    const data = await response.json();
+    const bookmarked = data.readingList.includes(slug);
+    window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList: data.readingList } }));
+    return { bookmarked, readingList: data.readingList };
+  },
+};
+
+/**
+ * Register global client-side tools across DevTools Times
+ */
+export async function registerGlobalTools() {
+  const context = ensureWebModelContext();
+  if (!context || typeof context.registerTool !== 'function') return;
+
+  // Expose utilities on window for direct access
+  (window as any).searchUtilities = searchUtilities;
+  (window as any).readingListUtilities = readingListUtilities;
+
+  // 1. Search Articles
+  const searchToolDefinition = {
+    name: 'search_articles',
+    description: 'Search published articles across The DevTools Times by keyword or topic.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: {
+          type: 'string',
+          description: 'The search query or keyword to find articles.',
+        },
+      },
+      required: ['query'],
+    },
+    execute: async ({ query }: { query: string }) => {
+      const result = await searchUtilities.searchArticles(query);
+      return result;
+    },
+  };
+  await context.registerTool(searchToolDefinition);
+
+  // Alias: search
+  await context.registerTool({
+    ...searchToolDefinition,
+    name: 'search',
+  });
+
+  // 2. Get Reading List
+  await context.registerTool({
+    name: 'get_reading_list',
+    description: "Get the current user's reading list of saved article slugs.",
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      const readingList = await readingListUtilities.getReadingList();
+      return { readingList };
+    },
+  });
+
+  // 3. Add to Reading List
+  await context.registerTool({
+    name: 'add_to_reading_list',
+    description: 'Add an article to the reading list by its unique slug identifier.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug identifier of the article to add.',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      return await readingListUtilities.addToReadingList(slug);
+    },
+  });
+
+  // 4. Remove from Reading List
+  await context.registerTool({
+    name: 'remove_from_reading_list',
+    description: 'Remove an article from the reading list by its unique slug identifier.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug identifier of the article to remove.',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      return await readingListUtilities.removeFromReadingList(slug);
+    },
+  });
+
+  // 5. Toggle Reading List (Bookmark)
+  await context.registerTool({
+    name: 'toggle_reading_list',
+    description: 'Toggle an article in the reading list by its slug (adds if missing, removes if present).',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug identifier of the article to toggle.',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      return await readingListUtilities.toggleReadingList(slug);
+    },
+  });
+
+  // Alias: bookmark_article
+  await context.registerTool({
+    name: 'bookmark_article',
+    description: 'Bookmark or unbookmark an article in the reading list by slug.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug identifier of the article to bookmark.',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      return await readingListUtilities.toggleReadingList(slug);
+    },
+  });
+
+  // Alias: reading_list
+  await context.registerTool({
+    name: 'reading_list',
+    description: 'Manage reading list: get, add, or remove an article by its slug.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        action: {
+          type: 'string',
+          enum: ['get', 'add', 'remove', 'toggle'],
+          description: 'The action to perform on the reading list (defaults to "get").',
+        },
+        slug: {
+          type: 'string',
+          description: 'The article slug (required for add, remove, toggle).',
+        },
+      },
+    },
+    execute: async ({ action = 'get', slug }: { action?: string; slug?: string } = {}) => {
+      if (action === 'add' && slug) return await readingListUtilities.addToReadingList(slug);
+      if (action === 'remove' && slug) return await readingListUtilities.removeFromReadingList(slug);
+      if (action === 'toggle' && slug) return await readingListUtilities.toggleReadingList(slug);
+      return { readingList: await readingListUtilities.getReadingList() };
+    },
+  });
+
+  // 6. Get Article by Slug
+  await context.registerTool({
+    name: 'get_article',
+    description: 'Fetch summary and information of an article by its slug from The DevTools Times.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug of the article to retrieve.',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      const articles = await searchUtilities.getAllArticles();
+      const article = articles.find((a: any) => a.slug === slug);
+      if (!article) {
+        throw new Error(`Article with slug "${slug}" not found`);
+      }
+      return article;
+    },
+  });
+
+  // 7. List All Articles
+  await context.registerTool({
+    name: 'list_articles',
+    description: 'List published articles available on The DevTools Times.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+      additionalProperties: false,
+    },
+    execute: async () => {
+      const articles = await searchUtilities.getAllArticles();
+      return { count: articles.length, articles };
+    },
+  });
+}
+
+// Auto-register on page load
+if (typeof window !== 'undefined') {
+  ensureWebModelContext();
+
+  const init = () => {
+    registerGlobalTools().catch((err) => console.error('Failed to register global WebMCP tools:', err));
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+
+  document.addEventListener('astro:page-load', init);
+}
