+  <!-- Client-side Interactive Ordering & WebMCP Tool Registration Script -->
+  <script>
+    (function () {
+      'use strict';
+
+      // Application Order State
+      const orderHistory = [];
+
+      // Base pricing tables
+      const PRICING = {
+        'Maple Oat Latte': {
+          sizes: { 'Small': 5.25, 'Medium': 5.75, 'Large': 6.25 },
+          milks: { 'Oat Milk': 0.0, 'Almond Milk': 0.50, 'Whole Milk': 0.0, 'Soy Milk': 0.50 }
+        },
+        'Dark Roast Espresso': {
+          shots: { 'Single': 3.50, 'Double': 4.25, 'Triple': 5.00 },
+          styles: { 'Straight': 0.0, 'Macchiato': 0.50, 'Cortado': 0.50, 'Americano': 0.0 }
+        },
+        'Cold Brew': {
+          sizes: { 'Small': 4.50, 'Medium': 4.95, 'Large': 5.50 },
+          flavors: { 'None': 0.0, 'Vanilla': 0.50, 'Caramel': 0.50, 'Maple': 0.50 }
+        }
+      };
+
+      /**
+       * Core ordering business logic.
+       * Updates UI and returns structured result payload.
+       */
+      function placeCoffeeOrder(item, options = {}) {
+        const qty = parseInt(options.quantity || 1, 10);
+        if (isNaN(qty) || qty < 1) {
+          return { error: 'Quantity must be a positive number of drinks.' };
+        }
+
+        let unitPrice = 0;
+        let detailsSummary = '';
+        let cardStatusId = '';
+
+        if (item === 'Maple Oat Latte') {
+          const size = options.size || 'Medium';
+          const milk = options.milk || 'Oat Milk';
+          const base = PRICING[item].sizes[size] ?? PRICING[item].sizes['Medium'];
+          const milkAddon = PRICING[item].milks[milk] ?? 0;
+          unitPrice = base + milkAddon;
+          detailsSummary = `Size: ${size}, Milk: ${milk}`;
+          cardStatusId = 'status-maple-oat-latte';
+        } else if (item === 'Dark Roast Espresso') {
+          const shots = options.shots || 'Double';
+          const style = options.style || 'Straight';
+          const base = PRICING[item].shots[shots] ?? PRICING[item].shots['Double'];
+          const styleAddon = PRICING[item].styles[style] ?? 0;
+          unitPrice = base + styleAddon;
+          detailsSummary = `Shots: ${shots}, Style: ${style}`;
+          cardStatusId = 'status-dark-roast-espresso';
+        } else if (item === 'Cold Brew') {
+          const size = options.size || 'Medium';
+          const ice = options.ice || 'Regular Ice';
+          const flavor = options.flavor || 'None';
+          const base = PRICING[item].sizes[size] ?? PRICING[item].sizes['Medium'];
+          const flavorAddon = PRICING[item].flavors[flavor] ?? 0;
+          unitPrice = base + flavorAddon;
+          detailsSummary = `Size: ${size}, Ice: ${ice}${flavor !== 'None' ? ', Flavor: ' + flavor : ''}`;
+          cardStatusId = 'status-cold-brew';
+        } else {
+          return {
+            error: `Unknown coffee item "${item}". Available items: Maple Oat Latte, Dark Roast Espresso, Cold Brew.`,
+            availableItems: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']
+          };
+        }
+
+        if (options.specialInstructions && options.specialInstructions.trim()) {
+          detailsSummary += ` (Note: ${options.specialInstructions.trim()})`;
+        }
+
+        const totalPrice = unitPrice * qty;
+        const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+        const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+
+        const orderRecord = {
+          orderId,
+          item,
+          quantity: qty,
+          details: detailsSummary,
+          unitPrice: '$' + unitPrice.toFixed(2),
+          totalPrice: '$' + totalPrice.toFixed(2),
+          totalPriceNum: totalPrice,
+          status: 'Confirmed',
+          timestamp
+        };
+
+        orderHistory.push(orderRecord);
+
+        // Update in-card visual feedback
+        if (cardStatusId) {
+          const statusEl = document.getElementById(cardStatusId);
+          if (statusEl) {
+            statusEl.textContent = `✓ Ordered ${qty}x (${orderRecord.totalPrice}) #${orderId}`;
+            setTimeout(() => {
+              if (statusEl.textContent.includes(orderId)) {
+                statusEl.textContent = '';
+              }
+            }, 6000);
+          }
+        }
+
+        // Render in Live Order Summary section
+        renderOrderSummary();
+
+        return {
+          success: true,
+          orderId,
+          item,
+          quantity: qty,
+          details: detailsSummary,
+          totalPrice: '$' + totalPrice.toFixed(2),
+          status: 'Confirmed',
+          message: `Successfully ordered ${qty}x ${item} [${detailsSummary}]. Total: $${totalPrice.toFixed(2)}. Order #${orderId} is being prepared.`
+        };
+      }
+
+      function renderOrderSummary() {
+        const emptyText = document.getElementById('empty-orders-text');
+        const orderList = document.getElementById('order-list');
+        const badge = document.getElementById('order-count-badge');
+        const totalBar = document.getElementById('order-total-bar');
+        const grandTotalEl = document.getElementById('order-grand-total');
+
+        if (!orderList || !badge) return;
+
+        if (orderHistory.length === 0) {
+          if (emptyText) emptyText.style.display = 'block';
+          if (totalBar) totalBar.style.display = 'none';
+          badge.textContent = '0 items';
+          orderList.innerHTML = '';
+          return;
+        }
+
+        if (emptyText) emptyText.style.display = 'none';
+        if (totalBar) totalBar.style.display = 'flex';
+
+        let grandTotal = 0;
+        let totalCount = 0;
+
+        orderList.innerHTML = orderHistory.map((order) => {
+          grandTotal += order.totalPriceNum;
+          totalCount += order.quantity;
+          return `
+            <div class="order-item" id="order-${order.orderId}">
+              <div class="order-item-details">
+                <strong>${order.quantity}x ${order.item}</strong>
+                <div class="order-item-options">${order.details}</div>
+                <div class="order-item-meta">Order #${order.orderId} &bull; Placed at ${order.timestamp}</div>
+              </div>
+              <div class="order-item-price">
+                ${order.totalPrice}
+              </div>
+            </div>
+          `;
+        }).join('');
+
+        badge.textContent = `${totalCount} item${totalCount === 1 ? '' : 's'}`;
+        if (grandTotalEl) {
+          grandTotalEl.textContent = '$' + grandTotal.toFixed(2);
+        }
+      }
+
+      // Attach Declarative Form Handlers (handling both user submit and agentInvoked)
+      function attachFormHandlers() {
+        const latteForm = document.getElementById('form-maple-oat-latte');
+        if (latteForm) {
+          latteForm.addEventListener('submit', (event) => {
+            event.preventDefault();
+            const formData = new FormData(latteForm);
+            const result = placeCoffeeOrder('Maple Oat Latte', {
+              size: formData.get('size'),
+              milk: formData.get('milk'),
+              quantity: formData.get('quantity'),
+              specialInstructions: formData.get('specialInstructions')
+            });
+
+            if (event.agentInvoked && typeof event.respondWith === 'function') {
+              event.respondWith(Promise.resolve(result));
+            }
+          });
+        }
+
+        const espressoForm = document.getElementById('form-dark-roast-espresso');
+        if (espressoForm) {
+          espressoForm.addEventListener('submit', (event) => {
+            event.preventDefault();
+            const formData = new FormData(espressoForm);
+            const result = placeCoffeeOrder('Dark Roast Espresso', {
+              shots: formData.get('shots'),
+              style: formData.get('style'),
+              quantity: formData.get('quantity'),
+              specialInstructions: formData.get('specialInstructions')
+            });
+
+            if (event.agentInvoked && typeof event.respondWith === 'function') {
+              event.respondWith(Promise.resolve(result));
+            }
+          });
+        }
+
+        const coldBrewForm = document.getElementById('form-cold-brew');
+        if (coldBrewForm) {
+          coldBrewForm.addEventListener('submit', (event) => {
+            event.preventDefault();
+            const formData = new FormData(coldBrewForm);
+            const result = placeCoffeeOrder('Cold Brew', {
+              size: formData.get('size'),
+              ice: formData.get('ice'),
+              flavor: formData.get('flavor'),
+              quantity: formData.get('quantity'),
+              specialInstructions: formData.get('specialInstructions')
+            });
+
+            if (event.agentInvoked && typeof event.respondWith === 'function') {
+              event.respondWith(Promise.resolve(result));
+            }
+          });
+        }
+      }
+
+      // WebMCP Imperative Registration & Fallback Compatibility Layer
+      async function setupWebMCP() {
+        // Provide standard document.modelContext surface if not natively supplied by browser
+        if (!('modelContext' in document)) {
+          const registeredTools = new Map();
+          const eventListeners = new Map();
+
+          document.modelContext = {
+            async registerTool(toolDef, options = {}) {
+              if (registeredTools.has(toolDef.name)) {
+                throw new DOMException(`Tool with name "${toolDef.name}" is already registered.`, 'InvalidStateError');
+              }
+              registeredTools.set(toolDef.name, { ...toolDef, options });
+              if (options.signal) {
+                options.signal.addEventListener('abort', () => registeredTools.delete(toolDef.name));
+              }
+              this.dispatchEvent(new CustomEvent('toolchange'));
+              return toolDef;
+            },
+            async getTools() {
+              return Array.from(registeredTools.values()).map((t) => ({
+                name: t.name,
+                description: t.description,
+                inputSchema: JSON.parse(JSON.stringify(t.inputSchema || { type: 'object', properties: {} })),
+                annotations: t.annotations || {}
+              }));
+            },
+            async executeTool(toolOrName, input = {}, options = {}) {
+              const name = typeof toolOrName === 'string' ? toolOrName : toolOrName?.name;
+              const tool = registeredTools.get(name);
+              if (!tool) {
+                throw new Error(`Tool "${name}" not found in modelContext.`);
+              }
+              const parsedInput = typeof input === 'string' ? JSON.parse(input) : input;
+              const result = await tool.execute(parsedInput, options);
+              return typeof result === 'string' ? result : JSON.stringify(result);
+            },
+            addEventListener(type, listener) {
+              if (!eventListeners.has(type)) eventListeners.set(type, new Set());
+              eventListeners.get(type).add(listener);
+            },
+            removeEventListener(type, listener) {
+              eventListeners.get(type)?.delete(listener);
+            },
+            dispatchEvent(event) {
+              eventListeners.get(event.type)?.forEach((cb) => {
+                try { cb(event); } catch (e) { console.error(e); }
+              });
+              return true;
+            }
+          };
+        }
+
+        // Define client-side tools for AI Agents
+        const toolsToRegister = [
+          {
+            name: 'order_maple_oat_latte',
+            description: 'Orders a Maple Oat Latte from the Seasonal Favorites menu with custom size, milk choice, and quantity.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                size: {
+                  type: 'string',
+                  enum: ['Small', 'Medium', 'Large'],
+                  default: 'Medium',
+                  description: 'Cup serving size.'
+                },
+                milk: {
+                  type: 'string',
+                  enum: ['Oat Milk', 'Almond Milk', 'Whole Milk', 'Soy Milk'],
+                  default: 'Oat Milk',
+                  description: 'Choice of milk.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: 'Number of drinks to order.'
+                },
+                specialInstructions: {
+                  type: 'string',
+                  description: 'Optional preparation requests, e.g., extra hot or half sweet.'
+                }
+              }
+            },
+            execute({ size = 'Medium', milk = 'Oat Milk', quantity = 1, specialInstructions = '' } = {}, { signal } = {}) {
+              if (signal?.aborted) throw new Error('Order execution cancelled.');
+              const allowedSizes = ['Small', 'Medium', 'Large'];
+              if (!allowedSizes.includes(size)) {
+                return { error: `Invalid size "${size}". Allowed values: ${allowedSizes.join(', ')}.` };
+              }
+              return placeCoffeeOrder('Maple Oat Latte', { size, milk, quantity, specialInstructions });
+            },
+            annotations: {
+              readOnlyHint: false
+            }
+          },
+          {
+            name: 'order_dark_roast_espresso',
+            description: 'Orders a Dark Roast Espresso from the Seasonal Favorites menu with shot count, serving style, and quantity.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                shots: {
+                  type: 'string',
+                  enum: ['Single', 'Double', 'Triple'],
+                  default: 'Double',
+                  description: 'Number of espresso shots.'
+                },
+                style: {
+                  type: 'string',
+                  enum: ['Straight', 'Macchiato', 'Cortado', 'Americano'],
+                  default: 'Straight',
+                  description: 'Serving style.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: 'Number of drinks to order.'
+                },
+                specialInstructions: {
+                  type: 'string',
+                  description: 'Optional preparation requests.'
+                }
+              }
+            },
+            execute({ shots = 'Double', style = 'Straight', quantity = 1, specialInstructions = '' } = {}, { signal } = {}) {
+              if (signal?.aborted) throw new Error('Order execution cancelled.');
+              const allowedShots = ['Single', 'Double', 'Triple'];
+              if (!allowedShots.includes(shots)) {
+                return { error: `Invalid shots "${shots}". Allowed values: ${allowedShots.join(', ')}.` };
+              }
+              return placeCoffeeOrder('Dark Roast Espresso', { shots, style, quantity, specialInstructions });
+            },
+            annotations: {
+              readOnlyHint: false
+            }
+          },
+          {
+            name: 'order_cold_brew',
+            description: 'Orders an 18-hour slow-steeped Cold Brew from the Seasonal Favorites menu with custom size, ice level, flavor, and quantity.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                size: {
+                  type: 'string',
+                  enum: ['Small', 'Medium', 'Large'],
+                  default: 'Medium',
+                  description: 'Cup serving size.'
+                },
+                ice: {
+                  type: 'string',
+                  enum: ['Regular Ice', 'Light Ice', 'Extra Ice', 'No Ice'],
+                  default: 'Regular Ice',
+                  description: 'Ice level preference.'
+                },
+                flavor: {
+                  type: 'string',
+                  enum: ['None', 'Vanilla', 'Caramel', 'Maple'],
+                  default: 'None',
+                  description: 'Optional flavor syrup.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: 'Number of drinks to order.'
+                },
+                specialInstructions: {
+                  type: 'string',
+                  description: 'Optional preparation requests.'
+                }
+              }
+            },
+            execute({ size = 'Medium', ice = 'Regular Ice', flavor = 'None', quantity = 1, specialInstructions = '' } = {}, { signal } = {}) {
+              if (signal?.aborted) throw new Error('Order execution cancelled.');
+              const allowedSizes = ['Small', 'Medium', 'Large'];
+              if (!allowedSizes.includes(size)) {
+                return { error: `Invalid size "${size}". Allowed values: ${allowedSizes.join(', ')}.` };
+              }
+              return placeCoffeeOrder('Cold Brew', { size, ice, flavor, quantity, specialInstructions });
+            },
+            annotations: {
+              readOnlyHint: false
+            }
+          },
+          {
+            name: 'order_coffee',
+            description: 'Orders any coffee item from the Seasonal Favorites section by item name and customization options.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                item: {
+                  type: 'string',
+                  enum: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'],
+                  description: 'The seasonal coffee favorite to order.'
+                },
+                size: {
+                  type: 'string',
+                  description: 'Cup size (Small, Medium, Large) or shot count (Single, Double, Triple).'
+                },
+                options: {
+                  type: 'string',
+                  description: 'Milk choice, serving style, ice level, or flavor syrup.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  default: 1,
+                  description: 'Number of drinks to order.'
+                },
+                specialInstructions: {
+                  type: 'string',
+                  description: 'Optional preparation instructions.'
+                }
+              },
+              required: ['item']
+            },
+            execute({ item, size, options, quantity = 1, specialInstructions = '' } = {}, { signal } = {}) {
+              if (signal?.aborted) throw new Error('Order execution cancelled.');
+              const itemNorm = (item || '').trim().toLowerCase();
+              if (itemNorm.includes('maple') || itemNorm.includes('latte')) {
+                return placeCoffeeOrder('Maple Oat Latte', { size: size || 'Medium', milk: options || 'Oat Milk', quantity, specialInstructions });
+              } else if (itemNorm.includes('espresso') || itemNorm.includes('dark roast')) {
+                return placeCoffeeOrder('Dark Roast Espresso', { shots: size || 'Double', style: options || 'Straight', quantity, specialInstructions });
+              } else if (itemNorm.includes('cold brew')) {
+                return placeCoffeeOrder('Cold Brew', { size: size || 'Medium', ice: options || 'Regular Ice', flavor: 'None', quantity, specialInstructions });
+              }
+              return {
+                error: `Unknown coffee item "${item}". Available items: Maple Oat Latte, Dark Roast Espresso, Cold Brew.`,
+                availableItems: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']
+              };
+            },
+            annotations: {
+              readOnlyHint: false
+            }
+          },
+          {
+            name: 'get_seasonal_menu',
+            description: 'Retrieves the list of Seasonal Favorites coffee items, pricing, and available customizations.',
+            inputSchema: {
+              type: 'object',
+              properties: {}
+            },
+            execute() {
+              return [
+                {
+                  item: 'Maple Oat Latte',
+                  basePrice: 5.25,
+                  sizes: ['Small ($5.25)', 'Medium ($5.75)', 'Large ($6.25)'],
+                  milks: ['Oat Milk', 'Almond Milk (+$0.50)', 'Whole Milk', 'Soy Milk (+$0.50)']
+                },
+                {
+                  item: 'Dark Roast Espresso',
+                  basePrice: 3.50,
+                  shots: ['Single ($3.50)', 'Double ($4.25)', 'Triple ($5.00)'],
+                  styles: ['Straight', 'Macchiato (+$0.50)', 'Cortado (+$0.50)', 'Americano']
+                },
+                {
+                  item: 'Cold Brew',
+                  basePrice: 4.50,
+                  sizes: ['Small ($4.50)', 'Medium ($4.95)', 'Large ($5.50)'],
+                  iceLevels: ['Regular Ice', 'Light Ice', 'Extra Ice', 'No Ice'],
+                  flavors: ['None', 'Vanilla (+$0.50)', 'Caramel (+$0.50)', 'Maple (+$0.50)']
+                }
+              ];
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          },
+          {
+            name: 'get_orders',
+            description: 'Retrieves the list of all active coffee orders placed during this session.',
+            inputSchema: {
+              type: 'object',
+              properties: {}
+            },
+            execute() {
+              return {
+                orders: orderHistory,
+                totalOrders: orderHistory.length
+              };
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          }
+        ];
+
+        // Register all tools concurrently
+        await Promise.allSettled(
+          toolsToRegister.map(async (tool) => {
+            try {
+              await document.modelContext.registerTool(tool);
+            } catch (err) {
+              console.warn(`WebMCP tool ${tool.name} notice:`, err?.message || err);
+            }
+          })
+        );
+
+        // Listen for WebMCP lifecycle events
+        const targetFor = (type, listener, options) => {
+          const target = ('on' + type in (document.modelContext ?? {}))
+            ? document.modelContext
+            : (typeof window !== 'undefined' && typeof window.addEventListener === 'function' ? window : null);
+          if (target && typeof target.addEventListener === 'function') {
+            target.addEventListener(type, listener, options);
+          }
+        };
+
+        targetFor('toolactivated', ({ toolName }) => {
+          console.info(`WebMCP Agent tool activated: ${toolName}`);
+        });
+
+        targetFor('toolcancel', ({ toolName }) => {
+          console.info(`WebMCP Agent tool cancelled: ${toolName}`);
+        });
+      }
+
+      // Initialize on DOM ready
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', () => {
+          attachFormHandlers();
+          setupWebMCP();
+        });
+      } else {
+        attachFormHandlers();
+        setupWebMCP();
+      }
+    })();
+  </script>
