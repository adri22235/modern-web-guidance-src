+              ice: { type: "string", enum: ["regular", "light", "extra", "none"] },
+              addIn: { type: "string", enum: ["none", "sweet cream", "oat milk", "vanilla sweet cream"] },
+              instructions: { type: "string" }
+            }
+          },
+          execute: async (args = {}) => {
+            return placeCoffeeOrder("Cold Brew", {
+              size: args.size || "medium",
+              quantity: args.quantity || 1,
+              ice: args.ice || "regular",
+              addIn: args.addIn || args.addin || "none",
+              instructions: args.instructions || ""
+            });
+          }
+        },
+        {
+          name: "order_coffee",
+          description: "Order any seasonal coffee drink (Maple Oat Latte, Dark Roast Espresso, or Cold Brew).",
+          inputSchema: {
+            type: "object",
+            properties: {
+              drink: {
+                type: "string",
+                enum: ["Maple Oat Latte", "Dark Roast Espresso", "Cold Brew"],
+                description: "The coffee drink to order."
+              },
+              size: {
+                type: "string",
+                description: "Size or shot selection (small, medium, large, single, double, triple)."
+              },
+              quantity: {
+                type: "integer",
+                minimum: 1,
+                description: "Quantity of drinks (default 1)."
+              },
+              options: {
+                type: "object",
+                description: "Optional drink customizations such as milk, sweetness, ice, serving, or add-ins."
+              },
+              instructions: {
+                type: "string",
+                description: "Special instructions."
+              }
+            },
+            required: ["drink"]
+          },
+          parameters: {
+            type: "object",
+            properties: {
+              drink: { type: "string", description: "Coffee drink to order" },
+              size: { type: "string", description: "Size or shot selection" },
+              quantity: { type: "integer", description: "Quantity" },
+              options: { type: "object", description: "Options" },
+              instructions: { type: "string", description: "Instructions" }
+            },
+            required: ["drink"]
+          },
+          execute: async (args = {}) => {
+            let drinkName = args.drink || args.item || "";
+            const lower = drinkName.toLowerCase();
+            if (lower.includes("maple") || lower.includes("latte")) {
+              drinkName = "Maple Oat Latte";
+            } else if (lower.includes("espresso") || lower.includes("dark roast")) {
+              drinkName = "Dark Roast Espresso";
+            } else if (lower.includes("cold brew")) {
+              drinkName = "Cold Brew";
+            } else {
+              throw new Error(`Unknown seasonal coffee: "${args.drink}". Available seasonal favorites: Maple Oat Latte, Dark Roast Espresso, Cold Brew.`);
+            }
+            const opts = Object.assign({}, args.options || {}, args);
+            delete opts.drink;
+            delete opts.options;
+            return placeCoffeeOrder(drinkName, opts);
+          }
+        },
+        {
+          name: "get_seasonal_menu",
+          description: "Get the current Seasonal Favorites coffee menu, prices, and available customization options.",
+          inputSchema: { type: "object", properties: {} },
+          parameters: { type: "object", properties: {} },
+          execute: async () => {
+            return {
+              success: true,
+              menu: MENU,
+              content: [
+                {
+                  type: "text",
+                  text: JSON.stringify(MENU, null, 2)
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: "get_orders",
+          description: "Get all orders placed in the current session and the grand total.",
+          inputSchema: { type: "object", properties: {} },
+          parameters: { type: "object", properties: {} },
+          execute: async () => {
+            const grandTotal = state.orders.reduce((sum, o) => sum + o.totalPrice, 0);
+            return {
+              success: true,
+              orders: state.orders,
+              totalOrders: state.orders.length,
+              grandTotal: parseFloat(grandTotal.toFixed(2)),
+              content: [
+                {
+                  type: "text",
+                  text: `Current session orders: ${state.orders.length} items. Total: $${grandTotal.toFixed(2)}.`
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: "clear_orders",
+          description: "Clear all coffee orders from the current session.",
+          inputSchema: { type: "object", properties: {} },
+          parameters: { type: "object", properties: {} },
+          execute: async () => {
+            return clearAllOrders();
+          }
+        }
+      ];
+
+      // Provide call, run, and handler aliases for each tool definition
+      toolDefinitions.forEach(tool => {
+        tool.call = tool.execute;
+        tool.run = tool.execute;
+        tool.handler = tool.execute;
+      });
+
+      // -------------------------------------------------------------
+      // 8. WebMCP Registry & Polyfill Implementation
+      // -------------------------------------------------------------
+      class ModelContextRegistry {
+        constructor() {
+          this._tools = new Map();
+        }
+
+        registerTool(tool) {
+          if (!tool || !tool.name) throw new Error("Tool must provide a valid 'name'");
+          this._tools.set(tool.name, tool);
+
+          // Support camelCase alias
+          const camel = tool.name.replace(/_([a-z])/g, (_, letter) => letter.toUpperCase());
+          if (camel !== tool.name && !this._tools.has(camel)) {
+            this._tools.set(camel, tool);
+          }
+          return tool;
+        }
+
+        unregisterTool(name) {
+          this._tools.delete(name);
+        }
+
+        getTool(name) {
+          return this._tools.get(name);
+        }
+
+        getTools() {
+          return Array.from(new Set(this._tools.values()));
+        }
+
+        listTools() {
+          return this.getTools();
+        }
+
+        hasTool(name) {
+          return this._tools.has(name);
+        }
+
+        async executeTool(name, params) {
+          const tool = this._tools.get(name);
+          if (!tool) throw new Error(`Tool "${name}" not found in model context`);
+          if (typeof tool.execute === 'function') return await tool.execute(params);
+          if (typeof tool.call === 'function') return await tool.call(params);
+          if (typeof tool.run === 'function') return await tool.run(params);
+          if (typeof tool.handler === 'function') return await tool.handler(params);
+          throw new Error(`Tool "${name}" has no callable handler`);
+        }
+      }
+
+      // Initialize or adapt ModelContext on navigator, document, and window
+      const modelContext = new ModelContextRegistry();
+
+      // Register tools into our registry
+      toolDefinitions.forEach(t => modelContext.registerTool(t));
+
+      // Hook into native navigator.modelContext if provided by the browser (WebMCP origin trial)
+      try {
+        if (typeof navigator !== 'undefined') {
+          if (navigator.modelContext && typeof navigator.modelContext.registerTool === 'function') {
+            toolDefinitions.forEach(t => {
+              try { navigator.modelContext.registerTool(t); } catch (e) { /* ignore native constraints */ }
+            });
+          } else {
+            Object.defineProperty(navigator, 'modelContext', {
+              value: modelContext,
+              writable: true,
+              configurable: true
+            });
+          }
+        }
+      } catch (err) {
+        // Fallback for restricted navigator object
+        navigator.modelContext = modelContext;
+      }
+
+      try {
+        if (typeof document !== 'undefined') {
+          if (!document.modelContext) {
+            document.modelContext = modelContext;
+          }
+        }
+      } catch (err) {}
+
+      // -------------------------------------------------------------
+      // 9. Global Window Discovery Hooks for AI Agents
+      // -------------------------------------------------------------
+      window.modelContext = modelContext;
+      window.tools = toolDefinitions;
+      window.agentTools = toolDefinitions;
+      window.__TOOLS__ = toolDefinitions;
+      window.aiTools = {
+        tools: toolDefinitions,
+        getTools: () => modelContext.getTools(),
+        executeTool: (name, args) => modelContext.executeTool(name, args),
+        orderMapleOatLatte: (args) => placeCoffeeOrder("Maple Oat Latte", args),
+        orderDarkRoastEspresso: (args) => placeCoffeeOrder("Dark Roast Espresso", args),
+        orderColdBrew: (args) => placeCoffeeOrder("Cold Brew", args),
+        orderCoffee: (drink, args) => placeCoffeeOrder(drink, args)
+      };
+
+      // Direct functions on window
+      window.orderMapleOatLatte = async (opts) => placeCoffeeOrder("Maple Oat Latte", opts);
+      window.orderDarkRoastEspresso = async (opts) => placeCoffeeOrder("Dark Roast Espresso", opts);
+      window.orderColdBrew = async (opts) => placeCoffeeOrder("Cold Brew", opts);
+      window.orderCoffee = async (drinkOrOpts, maybeOpts) => {
+        if (typeof drinkOrOpts === 'string') {
+          return placeCoffeeOrder(drinkOrOpts, maybeOpts || {});
+        }
+        return toolDefinitions.find(t => t.name === 'order_coffee').execute(drinkOrOpts);
+      };
+      window.getSeasonalMenu = async () => ({ success: true, menu: MENU });
+      window.getOrders = async () => ({ success: true, orders: state.orders });
+      window.clearOrders = clearAllOrders;
+      window.clearAllOrders = clearAllOrders;
+
+      // -------------------------------------------------------------
+      // 10. Custom DOM Event Invocation Support
+      // -------------------------------------------------------------
+      function handleToolCallEvent(e) {
+        const detail = e.detail || {};
+        const toolName = detail.name || detail.tool;
+        const params = detail.params || detail.arguments || detail.args || {};
+        if (toolName && modelContext.hasTool(toolName)) {
+          modelContext.executeTool(toolName, params)
+            .then(result => {
+              if (typeof detail.callback === 'function') detail.callback(null, result);
+              window.dispatchEvent(new CustomEvent('ai:tool-result', { detail: { name: toolName, result } }));
+            })
+            .catch(err => {
+              if (typeof detail.callback === 'function') detail.callback(err);
+              window.dispatchEvent(new CustomEvent('ai:tool-error', { detail: { name: toolName, error: err.message } }));
+            });
+        }
+      }
+
+      window.addEventListener('ai:tool-call', handleToolCallEvent);
+      document.addEventListener('tool-call', handleToolCallEvent);
+
+      // Initialize on DOM ready
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', () => {
+          setupDynamicCardPricing();
+          setupFormSubmissions();
+          renderOrders();
+        });
+      } else {
+        setupDynamicCardPricing();
+        setupFormSubmissions();
+        renderOrders();
+      }
+
+    })();
+  </script>
 </body>
 
 </html>
