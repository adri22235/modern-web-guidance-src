diff --git a/components/toast-notification.js b/components/toast-notification.js
new file mode 100644
index 0000000..bb5e3cb
--- /dev/null
+++ b/components/toast-notification.js
@@ -0,0 +1,171 @@
+/**
+ * ToastNotification - Accessible status notification component.
+ * Uses role="status" and aria-live="polite" to announce cart additions
+ * and favorite updates to assistive technology.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      position: fixed;
+      bottom: 24px;
+      right: 24px;
+      z-index: 9999;
+      pointer-events: none;
+      font-family: inherit;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    .toast-list {
+      display: flex;
+      flex-direction: column;
+      gap: 10px;
+      list-style: none;
+    }
+
+    .toast {
+      pointer-events: auto;
+      background: #3e2723;
+      color: #ffffff;
+      padding: 12px 18px;
+      border-radius: 8px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
+      border-left: 4px solid var(--accent, #ffab40);
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      min-width: 280px;
+      max-width: 380px;
+      font-size: 0.95rem;
+      animation: slide-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+      transition: opacity 0.3s ease, transform 0.3s ease;
+    }
+
+    .toast.dismissing {
+      opacity: 0;
+      transform: translateY(10px);
+    }
+
+    .toast-icon {
+      flex-shrink: 0;
+      color: var(--accent, #ffab40);
+      display: flex;
+      align-items: center;
+    }
+
+    .toast-msg {
+      flex-grow: 1;
+      line-height: 1.4;
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
+      color: rgba(255, 255, 255, 0.7);
+      cursor: pointer;
+      font-size: 1.2rem;
+      padding: 0 4px;
+      line-height: 1;
+      border-radius: 4px;
+    }
+
+    .toast-close:hover {
+      color: #ffffff;
+    }
+
+    .toast-close:focus-visible {
+      outline: 2px solid var(--accent, #ffab40);
+    }
+
+    @keyframes slide-in {
+      from {
+        opacity: 0;
+        transform: translateY(20px);
+      }
+      to {
+        opacity: 1;
+        transform: translateY(0);
+      }
+    }
+  </style>
+
+  <ul class="toast-list" id="toast-list" role="status" aria-live="polite"></ul>
+`;
+
+export class ToastNotification extends HTMLElement {
+  #list;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.append(template.content.cloneNode(true));
+    this.#list = this.shadowRoot.getElementById('toast-list');
+  }
+
+  connectedCallback() {
+    window.addEventListener('coffee-order', this.#onOrder);
+    window.addEventListener('coffee-favorite', this.#onFavorite);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('coffee-order', this.#onOrder);
+    window.removeEventListener('coffee-favorite', this.#onFavorite);
+  }
+
+  #onOrder = (e) => {
+    const item = e.detail;
+    const title = item?.title || 'Coffee';
+    const qty = item?.quantity || 1;
+    this.show(`Added ${qty}× ${title} to your order!`, 'order');
+  };
+
+  #onFavorite = (e) => {
+    const { title, favorited } = e.detail || {};
+    const name = title || 'Coffee';
+    if (favorited) {
+      this.show(`Saved ${name} to your favorites!`, 'favorite');
+    } else {
+      this.show(`Removed ${name} from your favorites.`, 'favorite');
+    }
+  };
+
+  show(message, type = 'info', duration = 3500) {
+    const li = document.createElement('li');
+    li.className = 'toast';
+
+    const iconSvg =
+      type === 'favorite'
+        ? `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`
+        : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>`;
+
+    li.innerHTML = `
+      <span class="toast-icon">${iconSvg}</span>
+      <span class="toast-msg">${message}</span>
+      <button type="button" class="toast-close" aria-label="Dismiss notification">&times;</button>
+    `;
+
+    const closeBtn = li.querySelector('.toast-close');
+    const dismiss = () => {
+      li.classList.add('dismissing');
+      setTimeout(() => li.remove(), 300);
+    };
+
+    closeBtn.addEventListener('click', dismiss);
+    const timer = setTimeout(dismiss, duration);
+
+    li.addEventListener('mouseenter', () => clearTimeout(timer));
+
+    this.#list.appendChild(li);
+  }
+}
+
+if (!customElements.get('toast-notification')) {
+  customElements.define('toast-notification', ToastNotification);
+}
