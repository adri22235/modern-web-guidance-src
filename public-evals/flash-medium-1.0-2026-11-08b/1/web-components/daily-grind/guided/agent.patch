+
+    // Parse base price
+    const priceStr = coffee.price || '$4.50';
+    const num = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 4.5;
+    this.#basePriceNum = num;
+
+    this.#title.textContent = coffee.title || 'Artisanal Coffee';
+    this.#desc.textContent = coffee.description || '';
+    this.#price.textContent = `$${this.#basePriceNum.toFixed(2)}`;
+
+    if (coffee.image) {
+      this.#img.src = coffee.image;
+      this.#img.alt = coffee.imageAlt || coffee.title || '';
+      this.#img.parentElement.style.display = 'block';
+    } else {
+      this.#img.parentElement.style.display = 'none';
+    }
+
+    // Reset checkboxes
+    this.#extraShot.checked = false;
+    this.#syrupShot.checked = false;
+
+    // Reset size radio
+    const mediumRadio = this.shadowRoot.querySelector('input[name="size"][value="Medium (16oz)"]');
+    if (mediumRadio) mediumRadio.checked = true;
+
+    this.#updateTotal();
+
+    this.#dialog.showModal();
+  }
+
+  close() {
+    if (this.#dialog.open) {
+      this.#dialog.close();
+      // Return focus to invoker if available
+      this.#invoker?.focus?.();
+    }
+  }
+
+  #onMinus = () => {
+    if (this.#quantity > 1) {
+      this.#quantity--;
+      this.#qtyVal.textContent = String(this.#quantity);
+      this.#updateTotal();
+    }
+  };
+
+  #onPlus = () => {
+    if (this.#quantity < 20) {
+      this.#quantity++;
+      this.#qtyVal.textContent = String(this.#quantity);
+      this.#updateTotal();
+    }
+  };
+
+  #calculateUnitTotal() {
+    let total = this.#basePriceNum;
+
+    const selectedSize = this.shadowRoot.querySelector('input[name="size"]:checked');
+    if (selectedSize) {
+      total += parseFloat(selectedSize.dataset.diff || '0');
+    }
+
+    const selectedMilk = this.shadowRoot.querySelector('input[name="milk"]:checked');
+    if (selectedMilk) {
+      total += parseFloat(selectedMilk.dataset.diff || '0');
+    }
+
+    if (this.#extraShot.checked) total += 1.0;
+    if (this.#syrupShot.checked) total += 0.75;
+
+    return Math.max(0, total);
+  }
+
+  #updateTotal() {
+    const unitPrice = this.#calculateUnitTotal();
+    const grandTotal = unitPrice * this.#quantity;
+    this.#totalPriceText.textContent = `$${grandTotal.toFixed(2)}`;
+  }
+
+  #onSubmitOrder = () => {
+    const size = this.shadowRoot.querySelector('input[name="size"]:checked')?.value || 'Medium (16oz)';
+    const milk = this.shadowRoot.querySelector('input[name="milk"]:checked')?.value || 'Oat Milk';
+    const total = (this.#calculateUnitTotal() * this.#quantity).toFixed(2);
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-order', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          ...this.#currentCoffee,
+          size,
+          milk,
+          extraShot: this.#extraShot.checked,
+          syrupShot: this.#syrupShot.checked,
+          quantity: this.#quantity,
+          finalPrice: `$${total}`
+        }
+      })
+    );
+
+    this.close();
+  };
+}
+
+if (!customElements.get('coffee-modal')) {
+  customElements.define('coffee-modal', CoffeeModal);
+}
