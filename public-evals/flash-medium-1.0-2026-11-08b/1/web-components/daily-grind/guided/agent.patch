+
+export class CoffeeCatalog extends HTMLElement {
+  #tablist;
+  #tabs;
+  #statusRegion;
+  #activeCategory = 'all';
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.append(template.content.cloneNode(true));
+
+    this.#tablist = this.shadowRoot.querySelector('.filter-bar');
+    this.#tabs = Array.from(this.shadowRoot.querySelectorAll('.filter-btn'));
+    this.#statusRegion = this.shadowRoot.getElementById('status-region');
+  }
+
+  connectedCallback() {
+    this.#tablist.addEventListener('click', this.#onTabClick);
+    this.#tablist.addEventListener('keydown', this.#onTabKeydown);
+
+    // Filter cards once elements are assigned to slot
+    const slot = this.shadowRoot.querySelector('slot:not([name])');
+    slot?.addEventListener('slotchange', () => this.filterCategory(this.#activeCategory));
+
+    // Initial filter run
+    this.filterCategory(this.#activeCategory);
+  }
+
+  disconnectedCallback() {
+    this.#tablist.removeEventListener('click', this.#onTabClick);
+    this.#tablist.removeEventListener('keydown', this.#onTabKeydown);
+  }
+
+  #onTabClick = (e) => {
+    const btn = e.target.closest('.filter-btn');
+    if (!btn) return;
+    const category = btn.dataset.category || 'all';
+    this.selectTab(btn);
+    this.filterCategory(category);
+  };
+
+  #onTabKeydown = (e) => {
+    const currentTab = e.target.closest('.filter-btn');
+    if (!currentTab) return;
+
+    const index = this.#tabs.indexOf(currentTab);
+    let nextIndex = index;
+
+    switch (e.key) {
+      case 'ArrowRight':
+        nextIndex = (index + 1) % this.#tabs.length;
+        break;
+      case 'ArrowLeft':
+        nextIndex = (index - 1 + this.#tabs.length) % this.#tabs.length;
+        break;
+      case 'Home':
+        nextIndex = 0;
+        break;
+      case 'End':
+        nextIndex = this.#tabs.length - 1;
+        break;
+      default:
+        return;
+    }
+
+    e.preventDefault();
+    const targetTab = this.#tabs[nextIndex];
+    this.selectTab(targetTab);
+    targetTab.focus();
+    this.filterCategory(targetTab.dataset.category || 'all');
+  };
+
+  selectTab(selectedTab) {
+    for (const tab of this.#tabs) {
+      const isSelected = tab === selectedTab;
+      tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+    }
+  }
+
+  filterCategory(category) {
+    this.#activeCategory = category;
+    const cards = Array.from(this.querySelectorAll('coffee-card, .card'));
+    let visibleCount = 0;
+
+    for (const card of cards) {
+      const cardCategory = (
+        card.getAttribute('category') ||
+        card.dataset.category ||
+        ''
+      ).toLowerCase();
+
+      const match =
+        category === 'all' ||
+        cardCategory.includes(category) ||
+        (category === 'hot' && (cardCategory.includes('espresso') || cardCategory.includes('hot') || cardCategory.includes('latte')));
+
+      if (match) {
+        card.removeAttribute('hidden');
+        card.style.display = '';
+        visibleCount++;
+      } else {
+        card.setAttribute('hidden', '');
+        card.style.display = 'none';
+      }
+    }
+
+    // Update screen reader status announcement
+    const categoryName = this.#tabs.find((t) => t.dataset.category === category)?.textContent.trim() || category;
+    if (this.#statusRegion) {
+      this.#statusRegion.textContent = `Showing ${visibleCount} items in ${categoryName}.`;
+    }
+
+    // Dispatch catalog filter event
+    this.dispatchEvent(
+      new CustomEvent('catalog-filter', {
+        bubbles: true,
+        composed: true,
+        detail: { category, visibleCount }
+      })
+    );
+  }
+}
+
+if (!customElements.get('coffee-catalog')) {
+  customElements.define('coffee-catalog', CoffeeCatalog);
+}
