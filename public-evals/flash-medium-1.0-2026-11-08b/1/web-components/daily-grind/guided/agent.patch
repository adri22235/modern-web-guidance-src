+      const { count } = e.detail;
+      if (count === 0) {
+        toast?.show('Your order is currently empty. Pick a drink to get started!', 'info');
+      } else {
+        toast?.show(`You have ${count} ${count === 1 ? 'item' : 'items'} in your order. Ready for checkout!`, 'info');
+      }
+    });
+  </script>
