+        padding: 6px 12px;
+        font-size: 0.82rem;
+      }
+    }
+  </style>
+
+  <section class="catalog-section" part="section" aria-labelledby="catalog-heading">
+    <div class="catalog-header" part="header">
+      <h2 class="catalog-title" id="catalog-heading" part="title">
+        <slot name="title">Seasonal Favorites</slot>
+      </h2>
+      <p class="catalog-subtitle" part="subtitle">
+        <slot name="subtitle">Hand-crafted beverages made with precision and single-origin beans.</slot>
+      </p>
+
+      <div class="filter-wrapper" part="filter-wrapper">
+        <div class="filter-bar" part="filter-bar" role="tablist" aria-label="Coffee categories">
+          <button
+            type="button"
+            class="filter-btn"
+            part="filter-btn"
+            role="tab"
+            aria-selected="true"
+            tabindex="0"
+            data-category="all"
+            id="tab-all"
+          >
+            All Drinks
+          </button>
+          <button
+            type="button"
+            class="filter-btn"
+            part="filter-btn"
+            role="tab"
+            aria-selected="false"
+            tabindex="-1"
+            data-category="seasonal"
+            id="tab-seasonal"
+          >
+            Seasonal
+          </button>
+          <button
+            type="button"
+            class="filter-btn"
+            part="filter-btn"
+            role="tab"
+            aria-selected="false"
+            tabindex="-1"
+            data-category="hot"
+            id="tab-hot"
+          >
+            Hot Brews
+          </button>
+          <button
+            type="button"
+            class="filter-btn"
+            part="filter-btn"
+            role="tab"
+            aria-selected="false"
+            tabindex="-1"
+            data-category="cold"
+            id="tab-cold"
