+          <button
+            type="button"
+            class="filter-btn"
+            part="filter-btn"
+            role="tab"
+            aria-selected="false"
+            tabindex="-1"
+            data-category="espresso"
+            id="tab-espresso"
+          >
+            Espresso
+          </button>
+        </div>
+      </div>
+    </div>
+
+    <!-- Live status region for screen reader feedback -->
+    <div class="sr-only" role="status" aria-live="polite" id="status-region"></div>
+
+    <div class="grid" part="grid">
+      <slot></slot>
+    </div>
+  </section>
