+/**
+ * CoffeeCard - Accessible, reusable Web Component for coffee drink cards.
+ * Uses Shadow DOM encapsulation, ElementInternals custom states, container queries,
+ * and ::part theming hooks.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      container-type: inline-size;
+      font-family: inherit;
+      color: var(--card-color, inherit);
+      --_primary: var(--primary, #4e342e);
+      --_secondary: var(--secondary, #d7ccc8);
+      --_accent: var(--accent, #ffab40);
+      --_text: var(--text, #3e2723);
+      --_bg: var(--card-bg, #ffffff);
+      --_radius: var(--card-radius, 12px);
+      --_shadow: var(--card-shadow, 0 4px 14px rgba(62, 39, 35, 0.08));
+      --_shadow-hover: var(--card-shadow-hover, 0 10px 24px rgba(62, 39, 35, 0.16));
+      --_transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    .card {
+      background: var(--_bg);
+      border-radius: var(--_radius);
+      box-shadow: var(--_shadow);
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      overflow: hidden;
+      transition: var(--_transition);
+      border: 1px solid rgba(215, 204, 200, 0.4);
+      position: relative;
+    }
+
+    .card:hover {
+      box-shadow: var(--_shadow-hover);
+      transform: translateY(-3px);
+    }
+
+    /* Media Region */
+    .media-wrap {
+      position: relative;
+      width: 100%;
+      aspect-ratio: 16 / 10;
+      background: #efebe9;
+      overflow: hidden;
+    }
+
+    .image {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+      transition: transform 0.4s ease;
+    }
+
+    .card:hover .image {
+      transform: scale(1.04);
+    }
+
+    .badge-slot-wrap {
+      position: absolute;
+      top: 12px;
+      left: 12px;
+      z-index: 2;
+    }
+
+    .badge {
+      display: inline-flex;
+      align-items: center;
+      background: var(--_primary);
+      color: #ffffff;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 4px 10px;
+      border-radius: 999px;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    /* Favorite Toggle Button */
+    .favorite-btn {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      z-index: 2;
+      width: 38px;
+      height: 38px;
+      border-radius: 50%;
+      background: rgba(255, 255, 255, 0.9);
+      backdrop-filter: blur(4px);
+      border: 1px solid rgba(215, 204, 200, 0.6);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      cursor: pointer;
+      color: #8d6e63;
+      transition: var(--_transition);
+      padding: 0;
+      font: inherit;
+    }
+
+    .favorite-btn:hover {
+      background: #ffffff;
+      color: #e53935;
+      transform: scale(1.1);
+    }
+
+    .favorite-btn:focus-visible {
+      outline: 2px solid var(--_accent);
+      outline-offset: 2px;
+    }
+
+    .heart-icon {
+      width: 20px;
+      height: 20px;
+      stroke: currentColor;
+      stroke-width: 2;
+      fill: transparent;
+      transition: fill 0.2s ease, stroke 0.2s ease;
+    }
+
+    /* Style based on custom state or class */
+    :host(:state(favorited)) .favorite-btn,
+    .favorite-btn[aria-pressed="true"] {
+      color: #e53935;
+    }
+
+    :host(:state(favorited)) .heart-icon,
+    .favorite-btn[aria-pressed="true"] .heart-icon {
+      fill: #e53935;
+      stroke: #e53935;
+    }
+
+    /* Body Region */
+    .body {
+      padding: 1.25rem;
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+      gap: 0.75rem;
+    }
+
+    .header-row {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 0.5rem;
+    }
+
+    .title {
+      font-size: 1.25rem;
+      font-weight: 700;
+      color: var(--_primary);
+      line-height: 1.3;
+    }
+
+    .price {
+      font-size: 1.15rem;
+      font-weight: 700;
+      color: var(--_primary);
+      white-space: nowrap;
+    }
+
+    .description {
+      font-size: 0.95rem;
+      line-height: 1.5;
+      color: #5d4037;
+      flex-grow: 1;
+    }
+
+    /* Actions Region */
+    .actions {
+      display: flex;
+      flex-direction: column;
+      gap: 0.6rem;
+      margin-top: auto;
+      padding-top: 0.5rem;
+    }
+
+    .btn {
+      font: inherit;
+      color: inherit;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      padding: 0.65rem 1rem;
+      font-size: 0.92rem;
+      font-weight: 600;
+      border-radius: 6px;
+      cursor: pointer;
+      text-decoration: none;
+      transition: var(--_transition);
+      border: 1px solid transparent;
+      text-align: center;
+      width: 100%;
+    }
+
+    .btn:focus-visible {
+      outline: 2px solid var(--_accent);
+      outline-offset: 2px;
+    }
+
+    .btn-primary {
+      background: var(--_primary);
+      color: #ffffff;
+      border-color: var(--_primary);
+    }
+
+    .btn-primary:hover {
+      background: #3e2723;
+      border-color: #3e2723;
+    }
+
+    .btn-outline {
+      background: transparent;
+      color: var(--_primary);
+      border-color: var(--_primary);
+    }
+
+    .btn-outline:hover {
+      background: rgba(78, 52, 46, 0.08);
+      border-color: #3e2723;
+      color: #3e2723;
+    }
+
+    /* Container Queries for responsive adaptation within arbitrary parent layouts */
+    @container (min-width: 320px) {
+      .actions {
+        flex-direction: row;
+      }
+
+      .btn {
+        flex: 1;
+      }
+    }
+
+    @container (min-width: 480px) {
+      .body {
+        padding: 1.5rem;
+      }
+      .title {
+        font-size: 1.35rem;
+      }
+    }
+  </style>
+
+  <article class="card" part="card">
+    <div class="media-wrap" part="media-wrap">
+      <div class="badge-slot-wrap">
+        <slot name="badge">
+          <span class="badge" part="badge" id="badge-el" hidden></span>
+        </slot>
+      </div>
+      <slot name="image">
+        <img class="image" part="image" id="image-el" src="" alt="" loading="lazy" />
+      </slot>
+      <button
+        type="button"
+        class="favorite-btn"
+        part="favorite-btn"
+        id="fav-btn"
+        aria-label="Add to favorites"
+        aria-pressed="false"
+      >
+        <svg class="heart-icon" part="heart-icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+        </svg>
+      </button>
+    </div>
+
+    <div class="body" part="body">
+      <div class="header-row">
+        <h3 class="title" part="title">
+          <slot name="title"><span id="title-text"></span></slot>
+        </h3>
+        <span class="price" part="price">
+          <slot name="price"><span id="price-text"></span></slot>
+        </span>
+      </div>
+
+      <div class="description" part="description">
+        <slot name="description">
+          <slot><span id="desc-text"></span></slot>
+        </slot>
+      </div>
+
+      <div class="actions" part="actions">
+        <slot name="actions">
+          <button type="button" class="btn btn-outline" part="btn btn-details" id="details-btn">
+            View Details
+          </button>
+          <button type="button" class="btn btn-primary" part="btn btn-order" id="order-btn">
+            Quick Add
+          </button>
+        </slot>
+      </div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  #internals;
+  #favBtn;
+  #detailsBtn;
+  #orderBtn;
+  #imageEl;
+  #badgeEl;
+  #titleText;
+  #priceText;
+  #descText;
+
+  static get observedAttributes() {
+    return [
+      'title',
+      'name',
+      'price',
+      'description',
+      'image',
+      'image-alt',
+      'badge',
+      'category',
+      'href',
+      'favorited',
+      'coffee-id'
+    ];
+  }
+
+  constructor() {
+    super();
+    // ElementInternals for state and accessibility
+    this.#internals = this.attachInternals ? this.attachInternals() : null;
+
+    // Attach open shadow DOM
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.append(template.content.cloneNode(true));
+
+    // Cache element references
+    this.#favBtn = this.shadowRoot.getElementById('fav-btn');
+    this.#detailsBtn = this.shadowRoot.getElementById('details-btn');
+    this.#orderBtn = this.shadowRoot.getElementById('order-btn');
+    this.#imageEl = this.shadowRoot.getElementById('image-el');
+    this.#badgeEl = this.shadowRoot.getElementById('badge-el');
+    this.#titleText = this.shadowRoot.getElementById('title-text');
+    this.#priceText = this.shadowRoot.getElementById('price-text');
+    this.#descText = this.shadowRoot.getElementById('desc-text');
+  }
+
+  connectedCallback() {
+    this.#favBtn.addEventListener('click', this.#onFavClick);
+    this.#detailsBtn?.addEventListener('click', this.#onDetailsClick);
+    this.#orderBtn?.addEventListener('click', this.#onOrderClick);
+
+    this.#syncAll();
+  }
+
+  disconnectedCallback() {
+    this.#favBtn.removeEventListener('click', this.#onFavClick);
+    this.#detailsBtn?.removeEventListener('click', this.#onDetailsClick);
+    this.#orderBtn?.removeEventListener('click', this.#onOrderClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this.#syncAttribute(name);
+  }
+
+  // Public Properties
+  get coffeeTitle() {
+    return this.getAttribute('title') || this.getAttribute('name') || '';
+  }
+  set coffeeTitle(val) {
+    this.setAttribute('title', val);
+  }
+
+  get price() {
+    return this.getAttribute('price') || '';
+  }
+  set price(val) {
+    this.setAttribute('price', val);
+  }
+
+  get description() {
+    return this.getAttribute('description') || '';
+  }
+  set description(val) {
+    this.setAttribute('description', val);
+  }
+
+  get image() {
+    return this.getAttribute('image') || '';
+  }
+  set image(val) {
+    this.setAttribute('image', val);
+  }
+
+  get imageAlt() {
+    return this.getAttribute('image-alt') || this.coffeeTitle;
+  }
+  set imageAlt(val) {
+    this.setAttribute('image-alt', val);
+  }
+
+  get badge() {
+    return this.getAttribute('badge') || '';
+  }
+  set badge(val) {
+    this.setAttribute('badge', val);
+  }
+
+  get category() {
+    return this.getAttribute('category') || 'seasonal';
+  }
+  set category(val) {
+    this.setAttribute('category', val);
+  }
+
+  get coffeeId() {
+    return this.getAttribute('coffee-id') || this.coffeeTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-');
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(val) {
+    if (Boolean(val)) {
+      this.setAttribute('favorited', '');
+    } else {
+      this.removeAttribute('favorited');
+    }
+  }
+
+  get coffeeData() {
+    return {
+      id: this.coffeeId,
+      title: this.coffeeTitle,
+      price: this.price,
+      description: this.description,
+      image: this.image,
+      imageAlt: this.imageAlt,
+      badge: this.badge,
+      category: this.category,
+      href: this.getAttribute('href') || '#',
+      favorited: this.favorited
+    };
+  }
+
+  // Methods
+  toggleFavorite() {
+    this.favorited = !this.favorited;
+    const isFav = this.favorited;
+
+    // Dispatch custom bubbling composed event
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          id: this.coffeeId,
+          title: this.coffeeTitle,
+          favorited: isFav
+        }
+      })
+    );
+  }
+
+  #onFavClick = (e) => {
+    e.stopPropagation();
+    this.toggleFavorite();
+  };
+
+  #onDetailsClick = (e) => {
+    e.stopPropagation();
+    this.dispatchEvent(
+      new CustomEvent('coffee-details', {
+        bubbles: true,
+        composed: true,
+        detail: this.coffeeData
+      })
+    );
+  };
+
+  #onOrderClick = (e) => {
+    e.stopPropagation();
+    this.dispatchEvent(
+      new CustomEvent('coffee-order', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          ...this.coffeeData,
+          quantity: 1,
+          size: 'Medium (16oz)'
+        }
+      })
+    );
+  };
+
+  #syncAll() {
+    this.#syncAttribute('title');
+    this.#syncAttribute('price');
+    this.#syncAttribute('description');
+    this.#syncAttribute('image');
+    this.#syncAttribute('badge');
+    this.#syncAttribute('favorited');
+  }
+
+  #syncAttribute(name) {
+    switch (name) {
+      case 'title':
+      case 'name': {
+        const title = this.coffeeTitle;
+        if (this.#titleText) this.#titleText.textContent = title;
+        if (this.#imageEl && !this.getAttribute('image-alt')) {
+          this.#imageEl.alt = title;
+        }
+        this.#updateFavLabel();
+        if (this.#detailsBtn) {
+          this.#detailsBtn.setAttribute('aria-label', `View details for ${title}`);
+        }
+        if (this.#orderBtn) {
+          this.#orderBtn.setAttribute('aria-label', `Quick add ${title} to order`);
+        }
+        break;
+      }
+      case 'price':
+        if (this.#priceText) this.#priceText.textContent = this.price;
+        break;
+      case 'description':
+        if (this.#descText) this.#descText.textContent = this.description;
+        break;
+      case 'image':
+        if (this.#imageEl) {
+          const img = this.image;
+          this.#imageEl.src = img;
+          this.#imageEl.style.display = img ? 'block' : 'none';
+        }
+        break;
+      case 'image-alt':
+        if (this.#imageEl) this.#imageEl.alt = this.imageAlt;
+        break;
+      case 'badge':
+        if (this.#badgeEl) {
+          const badge = this.badge;
+          if (badge) {
+            this.#badgeEl.textContent = badge;
+            this.#badgeEl.removeAttribute('hidden');
+          } else {
+            this.#badgeEl.setAttribute('hidden', '');
+          }
+        }
+        break;
+      case 'favorited': {
+        const isFav = this.favorited;
+        if (this.#internals?.states) {
+          if (isFav) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+        if (this.#favBtn) {
+          this.#favBtn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+        }
+        this.#updateFavLabel();
+        break;
+      }
+    }
+  }
+
+  #updateFavLabel() {
+    if (!this.#favBtn) return;
+    const title = this.coffeeTitle || 'coffee';
+    const isFav = this.favorited;
+    this.#favBtn.setAttribute(
+      'aria-label',
+      isFav ? `Remove ${title} from favorites` : `Add ${title} to favorites`
+    );
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
