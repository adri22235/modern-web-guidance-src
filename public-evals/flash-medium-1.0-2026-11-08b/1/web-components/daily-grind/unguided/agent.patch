@@ -0,0 +1,178 @@
+/**
+ * Accessible Toast Notification Web Component
+ * <toast-notification></toast-notification>
+ */
+class ToastNotification extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._timeout = null;
+  }
+
+  connectedCallback() {
+    this.render();
+    this._handleToastEvent = this._handleToastEvent.bind(this);
+    window.addEventListener('show-toast', this._handleToastEvent);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('show-toast', this._handleToastEvent);
+    if (this._timeout) clearTimeout(this._timeout);
+  }
+
+  _handleToastEvent(event) {
+    if (event.detail && event.detail.message) {
+      this.show(event.detail.message, event.detail.type || 'success', event.detail.duration || 3500);
+    }
+  }
+
+  show(message, type = 'success', duration = 3500) {
+    const container = this.shadowRoot.querySelector('.toast');
+    const messageEl = this.shadowRoot.querySelector('.toast-message');
+    const iconEl = this.shadowRoot.querySelector('.toast-icon');
+
+    if (this._timeout) {
+      clearTimeout(this._timeout);
+    }
+
+    messageEl.textContent = message;
+    container.className = `toast toast--${type} is-visible`;
+
+    iconEl.textContent = type === 'success' ? '✓' : type === 'warning' ? '⚠' : 'ℹ';
+
+    this._timeout = setTimeout(() => {
+      this.dismiss();
+    }, duration);
+  }
+
+  dismiss() {
+    const container = this.shadowRoot.querySelector('.toast');
+    if (container) {
+      container.classList.remove('is-visible');
+    }
+    if (this._timeout) {
+      clearTimeout(this._timeout);
+      this._timeout = null;
+    }
+  }
+
+  render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          position: fixed;
+          bottom: 24px;
+          right: 24px;
+          z-index: 9999;
+          pointer-events: none;
+          font-family: inherit;
+        }
+
+        .toast {
+          display: flex;
+          align-items: center;
+          gap: 12px;
+          min-width: 280px;
+          max-width: 420px;
+          padding: 14px 18px;
+          background: #2b1d1a;
+          color: #fafafa;
+          border-radius: 8px;
+          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+          border-left: 5px solid #ffab40;
+          opacity: 0;
+          transform: translateY(20px) scale(0.96);
+          transition: opacity 0.25s ease, transform 0.25s ease;
+          pointer-events: auto;
+        }
+
+        .toast.is-visible {
+          opacity: 1;
+          transform: translateY(0) scale(1);
+        }
+
+        .toast--success {
+          border-left-color: #4caf50;
+        }
+
+        .toast--warning {
+          border-left-color: #ff9800;
+        }
+
+        .toast--info {
+          border-left-color: #ffab40;
+        }
+
+        .toast-icon {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          width: 24px;
+          height: 24px;
+          border-radius: 50%;
+          background: rgba(255, 255, 255, 0.15);
+          font-weight: bold;
+          font-size: 14px;
+          flex-shrink: 0;
+        }
+
+        .toast-message {
+          flex: 1;
+          font-size: 0.95rem;
+          line-height: 1.4;
+        }
+
+        .toast-close {
+          background: transparent;
+          border: none;
+          color: rgba(255, 255, 255, 0.7);
+          font-size: 1.2rem;
+          cursor: pointer;
+          padding: 0 4px;
+          line-height: 1;
+          border-radius: 4px;
+          transition: color 0.2s, background-color 0.2s;
+        }
+
+        .toast-close:hover {
+          color: #fff;
+          background: rgba(255, 255, 255, 0.1);
+        }
+
+        .toast-close:focus-visible {
+          outline: 2px solid #ffab40;
+          outline-offset: 2px;
+        }
+
+        @media (max-width: 600px) {
+          :host {
+            bottom: 16px;
+            right: 16px;
+            left: 16px;
+          }
+          .toast {
+            width: 100%;
+            max-width: none;
+          }
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          .toast {
+            transition: opacity 0.1s linear;
+          }
+        }
+      </style>
+      <div class="toast" role="status" aria-live="polite">
+        <span class="toast-icon" aria-hidden="true">✓</span>
+        <span class="toast-message">Notification</span>
+        <button type="button" class="toast-close" aria-label="Dismiss notification">×</button>
+      </div>
+    `;
+
+    const closeBtn = this.shadowRoot.querySelector('.toast-close');
+    closeBtn.addEventListener('click', () => this.dismiss());
+  }
+}
+
+customElements.define('toast-notification', ToastNotification);
+export default ToastNotification;
