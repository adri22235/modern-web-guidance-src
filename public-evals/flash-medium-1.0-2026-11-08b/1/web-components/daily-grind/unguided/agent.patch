+              <li><a href="/account">My Account</a></li>
+              <li><a href="/logout" class="logout-link">Logout</a></li>
+            </slot>
+          </ul>
+        </div>
+      </nav>
+    `;
+  }
+}
+
+customElements.define('site-navigation', SiteNavigation);
+export default SiteNavigation;
