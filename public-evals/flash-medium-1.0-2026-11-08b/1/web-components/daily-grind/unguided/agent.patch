+          cursor: pointer;
+          font-size: 0.85rem;
+          margin-top: 10px;
+          display: inline-block;
+        }
+      </style>
+
+      <section class="newsletter-card" aria-labelledby="club-heading">
+        <h2 id="club-heading" class="heading">Join The Daily Grind Club</h2>
+        <p class="desc">
+          Receive exclusive single-origin drops, 15% off your first online order, and barista brew guides delivered to your inbox weekly.
+        </p>
+
+        ${
+          this._status === 'success'
+            ? `
+          <div class="feedback--success" role="status" aria-live="polite">
+            <h4>☕ You're in!</h4>
+            <p>We just sent your 15% welcome code. Enjoy fresh roasts on us.</p>
+            <button type="button" id="subscribe-another" class="btn-link">Register another email</button>
+          </div>
+        `
+            : `
+          <form id="newsletter-form" class="form" novalidate>
+            <div class="input-group">
+              <label for="email-input" class="sr-only">Your email address</label>
+              <input
+                type="email"
+                id="email-input"
+                class="email-input ${this._status === 'error' ? 'has-error' : ''}"
+                placeholder="Enter your email address"
+                required
+                aria-required="true"
+                aria-invalid="${this._status === 'error'}"
+                aria-describedby="email-error-msg"
+              />
+              <div id="email-error-msg" class="feedback-msg feedback--error" role="alert" aria-live="polite">
+                ${this._status === 'error' ? this._errorMessage : ''}
+              </div>
+            </div>
+            <div>
+              <button
+                type="submit"
+                class="btn-submit"
+                ${this._status === 'submitting' ? 'disabled' : ''}
+              >
+                ${this._status === 'submitting' ? 'Joining...' : 'Get 15% Off'}
+              </button>
+            </div>
+          </form>
+        `
+        }
+      </section>
+    `;
+  }
+}
+
+customElements.define('newsletter-section', NewsletterSection);
+export default NewsletterSection;
