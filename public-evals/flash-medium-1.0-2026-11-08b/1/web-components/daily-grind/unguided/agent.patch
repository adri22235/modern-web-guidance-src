+/**
+ * Accessible Order / Cart Drawer Web Component
+ * <cart-drawer></cart-drawer>
+ */
+class CartDrawer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._isOpen = false;
+    this._items = [];
+    this._triggerElement = null;
+  }
+
+  connectedCallback() {
+    this.render();
+    this._setupGlobalListeners();
+  }
+
+  disconnectedCallback() {
+    this._teardownGlobalListeners();
+  }
+
+  _setupGlobalListeners() {
+    this._onAddToCart = (e) => {
+      this.addItem(e.detail);
+    };
+
+    this._onCartToggle = (e) => {
+      if (this._isOpen) {
+        this.close();
+      } else {
+        this.open(e.target);
+      }
+    };
+
+    this._onKeyDown = (e) => {
+      if (!this._isOpen) return;
+
+      if (e.key === 'Escape') {
+        e.preventDefault();
+        this.close();
+        return;
+      }
+
+      if (e.key === 'Tab') {
+        this._trapFocus(e);
+      }
+    };
+
+    window.addEventListener('coffee-add-to-cart', this._onAddToCart);
+    window.addEventListener('cart-toggle', this._onCartToggle);
+    window.addEventListener('keydown', this._onKeyDown);
+  }
+
+  _teardownGlobalListeners() {
+    window.removeEventListener('coffee-add-to-cart', this._onAddToCart);
+    window.removeEventListener('cart-toggle', this._onCartToggle);
+    window.removeEventListener('keydown', this._onKeyDown);
+  }
+
+  _trapFocus(e) {
+    const focusable = this.shadowRoot.querySelectorAll(
+      'button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
+    );
+    if (!focusable.length) return;
+
+    const first = focusable[0];
+    const last = focusable[focusable.length - 1];
+
+    if (e.shiftKey && this.shadowRoot.activeElement === first) {
+      e.preventDefault();
+      last.focus();
+    } else if (!e.shiftKey && this.shadowRoot.activeElement === last) {
+      e.preventDefault();
+      first.focus();
+    }
+  }
+
+  addItem(item) {
+    const unitPrice = parseFloat(item.unitPrice || item.basePrice || (item.price || '4.50').replace(/[^0-9.]/g, '')) || 4.5;
+    const existingIndex = this._items.findIndex(
+      (i) => i.name === item.name && i.size === item.size && i.milk === item.milk && i.syrup === item.syrup
+    );
+
+    if (existingIndex > -1) {
+      this._items[existingIndex].quantity += item.quantity || 1;
+    } else {
+      this._items.push({
+        id: Date.now() + Math.random().toString(36).substr(2, 5),
+        name: item.name,
+        unitPrice: unitPrice,
+        size: item.size || 'Medium (16oz)',
+        milk: item.milk || 'Whole Milk',
+        syrup: item.syrup || 'Standard',
+        quantity: item.quantity || 1,
+        image: item.image || ''
+      });
+    }
+
+    this._notifyCartUpdate();
+    this.render();
+  }
+
+  removeItem(id) {
+    this._items = this._items.filter((i) => i.id !== id);
+    this._notifyCartUpdate();
+    this.render();
+  }
+
+  updateQuantity(id, delta) {
+    const item = this._items.find((i) => i.id === id);
+    if (item) {
+      item.quantity += delta;
+      if (item.quantity <= 0) {
+        this.removeItem(id);
+        return;
+      }
+    }
+    this._notifyCartUpdate();
+    this.render();
+  }
+
+  clearCart() {
+    this._items = [];
+    this._notifyCartUpdate();
+    this.render();
+  }
+
+  _notifyCartUpdate() {
+    const totalCount = this._items.reduce((sum, item) => sum + item.quantity, 0);
+    const subtotal = this._items.reduce((sum, item) => sum + item.unitPrice * item.quantity, 0);
+
+    window.dispatchEvent(
+      new CustomEvent('cart-updated', {
+        detail: { totalCount, subtotal },
+        bubbles: true,
+        composed: true
+      })
+    );
+  }
+
+  open(triggerElement = null) {
+    this._isOpen = true;
+    this._triggerElement = triggerElement;
+    this.render();
+
+    const drawer = this.shadowRoot.querySelector('.drawer-backdrop');
+    if (drawer) {
+      drawer.classList.add('is-open');
+    }
+    document.body.style.overflow = 'hidden';
+
+    setTimeout(() => {
+      const closeBtn = this.shadowRoot.querySelector('.drawer-close');
+      if (closeBtn) closeBtn.focus();
+    }, 50);
+  }
+
+  close() {
+    if (!this._isOpen) return;
+    this._isOpen = false;
+
+    const drawer = this.shadowRoot.querySelector('.drawer-backdrop');
+    if (drawer) {
+      drawer.classList.remove('is-open');
+    }
+    document.body.style.overflow = '';
+
+    if (this._triggerElement && typeof this._triggerElement.focus === 'function') {
+      this._triggerElement.focus();
+      this._triggerElement = null;
+    }
+  }
+
+  _handleCheckout() {
+    if (!this._items.length) return;
+
+    const checkoutBtn = this.shadowRoot.querySelector('.btn-checkout');
+    if (checkoutBtn) {
+      checkoutBtn.textContent = 'Preparing Order...';
+      checkoutBtn.disabled = true;
+    }
+
+    setTimeout(() => {
+      window.dispatchEvent(
+        new CustomEvent('show-toast', {
+          detail: {
+            message: 'Order received! Your coffee is being handcrafted now.',
+            type: 'success'
+          }
+        })
+      );
+      this.clearCart();
+      this.close();
+    }, 900);
+  }
+
+  render() {
+    const totalCount = this._items.reduce((sum, item) => sum + item.quantity, 0);
+    const subtotal = this._items.reduce((sum, item) => sum + item.unitPrice * item.quantity, 0);
+    const tax = subtotal * 0.0825;
+    const total = subtotal + tax;
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
+          position: fixed;
+          top: 0;
+          left: 0;
+          width: 100%;
+          height: 100%;
+          z-index: 9995;
+          pointer-events: none;
+          font-family: inherit;
+        }
+
+        .drawer-backdrop {
+          position: fixed;
+          top: 0;
+          left: 0;
+          width: 100%;
+          height: 100%;
+          background: rgba(30, 20, 18, 0.6);
+          backdrop-filter: blur(2px);
+          opacity: 0;
+          visibility: hidden;
+          transition: opacity 0.3s ease, visibility 0.3s ease;
+          pointer-events: auto;
+          display: flex;
+          justify-content: flex-end;
+        }
+
+        .drawer-backdrop.is-open {
+          opacity: 1;
+          visibility: visible;
+        }
+
+        .drawer-panel {
+          width: 100%;
+          max-width: 440px;
+          height: 100%;
+          background: #ffffff;
+          box-shadow: -8px 0 24px rgba(0, 0, 0, 0.2);
+          display: flex;
+          flex-direction: column;
+          transform: translateX(100%);
+          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+          color: var(--text, #3e2723);
+        }
+
+        .drawer-backdrop.is-open .drawer-panel {
+          transform: translateX(0);
+        }
+
+        .drawer-header {
+          padding: 20px 24px;
+          border-bottom: 1px solid #efebe9;
+          display: flex;
+          align-items: center;
+          justify-content: space-between;
+          background: #fbf9f8;
+        }
+
+        .drawer-title {
+          font-size: 1.3rem;
+          font-weight: 800;
+          color: var(--primary, #4e342e);
+          margin: 0;
+          display: flex;
+          align-items: center;
+          gap: 8px;
+        }
+
+        .drawer-close {
+          background: transparent;
+          border: none;
+          font-size: 1.4rem;
+          cursor: pointer;
+          color: #5d4037;
+          width: 36px;
+          height: 36px;
+          border-radius: 50%;
+          display: flex;
+          align-items: center;
+          justify-content: center;
+          transition: background-color 0.2s;
+        }
+
+        .drawer-close:hover {
+          background: #efebe9;
+        }
+
+        .drawer-close:focus-visible {
+          outline: 2px solid var(--accent, #ffab40);
+          outline-offset: 2px;
+        }
+
+        .drawer-body {
+          flex: 1;
+          overflow-y: auto;
+          padding: 20px 24px;
+        }
+
+        .empty-cart {
+          text-align: center;
+          padding: 60px 20px;
+          color: #8d6e63;
+        }
+
+        .empty-cart-icon {
+          font-size: 3rem;
+          margin-bottom: 12px;
+          opacity: 0.6;
+        }
+
+        .item-list {
+          list-style: none;
+          margin: 0;
+          padding: 0;
+          display: flex;
+          flex-direction: column;
+          gap: 16px;
+        }
+
+        .cart-item {
+          display: flex;
+          gap: 14px;
+          padding-bottom: 16px;
+          border-bottom: 1px solid #f1ece8;
+        }
+
+        .item-thumb {
+          width: 68px;
+          height: 68px;
+          border-radius: 8px;
+          object-fit: cover;
+          background: #eee;
+          flex-shrink: 0;
+        }
+
+        .item-details {
+          flex: 1;
+        }
+
+        .item-name {
+          font-weight: 700;
+          color: var(--primary, #4e342e);
+          margin: 0 0 4px 0;
+          font-size: 1rem;
+        }
+
+        .item-specs {
+          font-size: 0.8rem;
+          color: #795548;
+          margin: 0 0 8px 0;
+          line-height: 1.3;
+        }
+
+        .item-price {
+          font-weight: 700;
+          color: #3e2723;
+          font-size: 0.95rem;
+        }
+
+        .item-controls {
+          display: flex;
+          align-items: center;
+          justify-content: space-between;
+          margin-top: 6px;
+        }
+
+        .qty-pills {
+          display: inline-flex;
+          align-items: center;
+          border: 1px solid #d7ccc8;
+          border-radius: 6px;
+          overflow: hidden;
+        }
+
+        .btn-qty {
+          background: #efebe9;
+          border: none;
+          width: 28px;
+          height: 28px;
+          font-weight: bold;
+          cursor: pointer;
+          font-size: 1rem;
+          color: #4e342e;
+        }
+
+        .btn-qty:hover {
+          background: #d7ccc8;
+        }
+
+        .item-qty-num {
+          padding: 0 10px;
+          font-size: 0.85rem;
+          font-weight: 600;
+        }
+
+        .btn-remove {
+          background: transparent;
+          border: none;
+          color: #c62828;
+          font-size: 0.8rem;
+          cursor: pointer;
+          text-decoration: underline;
+          padding: 2px 4px;
+        }
+
+        .drawer-footer {
+          padding: 20px 24px;
+          border-top: 1px solid #efebe9;
+          background: #fbf9f8;
+        }
+
+        .summary-row {
+          display: flex;
+          justify-content: space-between;
+          margin-bottom: 8px;
+          font-size: 0.9rem;
+          color: #6d4c41;
+        }
+
+        .summary-total {
+          display: flex;
+          justify-content: space-between;
+          font-size: 1.2rem;
+          font-weight: 800;
+          color: var(--primary, #4e342e);
+          margin-top: 12px;
+          padding-top: 12px;
+          border-top: 1.5px dashed #d7ccc8;
+        }
+
+        .btn-checkout {
+          width: 100%;
+          background: var(--primary, #4e342e);
+          color: #ffffff;
+          border: none;
+          border-radius: 8px;
+          padding: 14px;
+          font-size: 1rem;
+          font-weight: 700;
+          margin-top: 16px;
+          cursor: pointer;
+          transition: background-color 0.2s;
+        }
+
+        .btn-checkout:hover:not(:disabled) {
+          background: #3e2723;
+        }
+
+        .btn-checkout:focus-visible {
+          outline: 2px solid var(--accent, #ffab40);
+          outline-offset: 2px;
+        }
+
+        .btn-checkout:disabled {
+          opacity: 0.6;
+          cursor: not-allowed;
+        }
+
+        .btn-clear {
+          background: transparent;
+          border: none;
+          color: #8d6e63;
+          font-size: 0.85rem;
+          cursor: pointer;
+          width: 100%;
+          text-align: center;
+          margin-top: 8px;
+          text-decoration: underline;
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          .drawer-backdrop, .drawer-panel {
+            transition: none !important;
+          }
+        }
+      </style>
+
+      <div class="drawer-backdrop ${this._isOpen ? 'is-open' : ''}" role="dialog" aria-modal="true" aria-labelledby="cart-title">
+        <div class="drawer-panel">
+          <header class="drawer-header">
+            <h2 id="cart-title" class="drawer-title">
+              <span>Your Daily Grind Order</span>
+              <span>(${totalCount})</span>
+            </h2>
+            <button type="button" class="drawer-close" aria-label="Close order drawer">✕</button>
+          </header>
+
+          <div class="drawer-body">
+            ${
+              this._items.length === 0
+                ? `
+              <div class="empty-cart">
+                <div class="empty-cart-icon">☕</div>
+                <h3>Your cup is empty</h3>
+                <p>Explore our seasonal favorites or customize your favorite roast to get started.</p>
+              </div>
+            `
+                : `
+              <ul class="item-list">
+                ${this._items
+                  .map(
+                    (item) => `
+                  <li class="cart-item">
+                    ${
+                      item.image
+                        ? `<img src="${item.image}" alt="${item.name}" class="item-thumb" />`
+                        : ''
+                    }
+                    <div class="item-details">
+                      <div class="item-name">${item.name}</div>
+                      <div class="item-specs">${item.size} • ${item.milk}</div>
+                      <div class="item-price">$${(item.unitPrice * item.quantity).toFixed(2)}</div>
+                      <div class="item-controls">
+                        <div class="qty-pills">
+                          <button type="button" class="btn-qty btn-dec-item" data-id="${item.id}" aria-label="Decrease quantity for ${item.name}">−</button>
+                          <span class="item-qty-num">${item.quantity}</span>
+                          <button type="button" class="btn-qty btn-inc-item" data-id="${item.id}" aria-label="Increase quantity for ${item.name}">+</button>
+                        </div>
+                        <button type="button" class="btn-remove" data-id="${item.id}" aria-label="Remove ${item.name} from order">Remove</button>
+                      </div>
+                    </div>
+                  </li>
+                `
+                  )
+                  .join('')}
+              </ul>
+            `
+            }
+          </div>
+
+          ${
+            this._items.length > 0
+              ? `
+            <footer class="drawer-footer">
+              <div class="summary-row">
+                <span>Subtotal</span>
+                <span>$${subtotal.toFixed(2)}</span>
+              </div>
+              <div class="summary-row">
+                <span>Estimated Tax (8.25%)</span>
+                <span>$${tax.toFixed(2)}</span>
+              </div>
+              <div class="summary-total">
+                <span>Estimated Total</span>
+                <span>$${total.toFixed(2)}</span>
+              </div>
+              <button type="button" class="btn-checkout">Proceed to Checkout</button>
+              <button type="button" class="btn-clear">Clear Order</button>
+            </footer>
+          `
+              : ''
+          }
+        </div>
+      </div>
+    `;
+
+    // Connect event listeners
+    const closeBtn = this.shadowRoot.querySelector('.drawer-close');
+    if (closeBtn) closeBtn.addEventListener('click', () => this.close());
+
+    const backdrop = this.shadowRoot.querySelector('.drawer-backdrop');
+    if (backdrop) {
+      backdrop.addEventListener('click', (e) => {
+        if (e.target === backdrop) this.close();
+      });
+    }
+
+    const decBtns = this.shadowRoot.querySelectorAll('.btn-dec-item');
+    decBtns.forEach((btn) => {
+      btn.addEventListener('click', () => this.updateQuantity(btn.dataset.id, -1));
+    });
+
+    const incBtns = this.shadowRoot.querySelectorAll('.btn-inc-item');
+    incBtns.forEach((btn) => {
+      btn.addEventListener('click', () => this.updateQuantity(btn.dataset.id, 1));
+    });
+
+    const removeBtns = this.shadowRoot.querySelectorAll('.btn-remove');
+    removeBtns.forEach((btn) => {
+      btn.addEventListener('click', () => this.removeItem(btn.dataset.id));
+    });
+
+    const checkoutBtn = this.shadowRoot.querySelector('.btn-checkout');
+    if (checkoutBtn) {
+      checkoutBtn.addEventListener('click', () => this._handleCheckout());
+    }
+
+    const clearBtn = this.shadowRoot.querySelector('.btn-clear');
+    if (clearBtn) {
+      clearBtn.addEventListener('click', () => this.clearCart());
+    }
+  }
+}
+
+customElements.define('cart-drawer', CartDrawer);
+export default CartDrawer;
diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..f8aed25
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,547 @@
+/**
+ * Reusable, Accessible Coffee Card Web Component
+ * <coffee-card>
+ */
+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'name',
+      'price',
+      'description',
+      'image',
+      'image-alt',
+      'badge',
+      'roast',
+      'category',
+      'href',
+      'cta-text'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._isFavorite = false;
+  }
+
+  connectedCallback() {
+    this.render();
+    this._setupListeners();
+  }
+
+  disconnectedCallback() {
+    this._teardownListeners();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.shadowRoot && this.shadowRoot.hasChildNodes()) {
+      this.render();
+      this._setupListeners();
+    }
+  }
+
+  // Getters and Setters
+  get name() {
+    return this.getAttribute('name') || 'Artisanal Coffee';
+  }
+  set name(val) {
+    this.setAttribute('name', val);
+  }
+
+  get price() {
+    return this.getAttribute('price') || '$4.50';
+  }
+  set price(val) {
+    this.setAttribute('price', val);
+  }
+
+  get description() {
+    return this.getAttribute('description') || '';
+  }
+  set description(val) {
+    this.setAttribute('description', val);
+  }
+
+  get image() {
+    return this.getAttribute('image') || '';
+  }
+  set image(val) {
+    this.setAttribute('image', val);
+  }
+
+  get imageAlt() {
+    return this.getAttribute('image-alt') || this.name;
+  }
+  set imageAlt(val) {
+    this.setAttribute('image-alt', val);
+  }
+
+  get badge() {
+    return this.getAttribute('badge') || '';
+  }
+  set badge(val) {
+    this.setAttribute('badge', val);
+  }
+
+  get roast() {
+    return this.getAttribute('roast') || '';
+  }
+  set roast(val) {
+    this.setAttribute('roast', val);
+  }
+
+  get category() {
+    return this.getAttribute('category') || 'all';
+  }
+  set category(val) {
+    this.setAttribute('category', val);
+  }
+
+  get href() {
+    return this.getAttribute('href') || '#';
+  }
+  set href(val) {
+    this.setAttribute('href', val);
+  }
+
+  get ctaText() {
+    return this.getAttribute('cta-text') || 'View Details';
+  }
+  set ctaText(val) {
+    this.setAttribute('cta-text', val);
+  }
+
+  get coffeeData() {
+    return {
+      name: this.name,
+      price: this.price,
+      description: this.description,
+      image: this.image,
+      badge: this.badge,
+      roast: this.roast,
+      category: this.category,
+      href: this.href
+    };
+  }
+
+  _setupListeners() {
+    const quickViewBtn = this.shadowRoot.querySelector('.btn-quick-view');
+    if (quickViewBtn) {
+      quickViewBtn.addEventListener('click', this._onQuickViewClick.bind(this));
+    }
+
+    const orderBtn = this.shadowRoot.querySelector('.btn-add-order');
+    if (orderBtn) {
+      orderBtn.addEventListener('click', this._onAddOrderClick.bind(this));
+    }
+
+    const favBtn = this.shadowRoot.querySelector('.btn-favorite');
+    if (favBtn) {
+      favBtn.addEventListener('click', this._onFavoriteClick.bind(this));
+    }
+  }
+
+  _teardownListeners() {
+    // Handlers cleaned up on re-render
+  }
+
+  _onQuickViewClick(e) {
+    e.preventDefault();
+    this.dispatchEvent(
+      new CustomEvent('coffee-quick-view', {
+        detail: {
+          ...this.coffeeData,
+          triggerElement: e.currentTarget
+        },
+        bubbles: true,
+        composed: true
+      })
+    );
+  }
+
+  _onAddOrderClick(e) {
+    e.preventDefault();
+    this.dispatchEvent(
+      new CustomEvent('coffee-add-to-cart', {
+        detail: {
+          ...this.coffeeData,
+          size: '16oz (Medium)',
+          quantity: 1,
+          customizations: 'Standard'
+        },
+        bubbles: true,
+        composed: true
+      })
+    );
+
+    // Provide visual feedback on button
+    const btn = e.currentTarget;
+    const originalText = btn.innerHTML;
+    btn.innerHTML = '✓ Added!';
+    btn.classList.add('btn--success');
+    setTimeout(() => {
+      btn.innerHTML = originalText;
+      btn.classList.remove('btn--success');
+    }, 1200);
+  }
+
+  _onFavoriteClick(e) {
+    e.preventDefault();
+    this._isFavorite = !this._isFavorite;
+    const btn = e.currentTarget;
+    btn.setAttribute('aria-pressed', String(this._isFavorite));
+    btn.classList.toggle('is-favorited', this._isFavorite);
+    btn.setAttribute(
+      'aria-label',
+      this._isFavorite
+        ? `Remove ${this.name} from favorites`
+        : `Save ${this.name} to favorites`
