+          white-space: nowrap;
+          transition: all 0.2s ease;
+          font-family: inherit;
+        }
+
+        .tab-btn:hover {
+          background: #efebe9;
+          color: var(--primary-color);
+        }
+
+        .tab-btn.is-active {
+          background: var(--primary-color);
+          color: #ffffff;
+          box-shadow: 0 2px 6px rgba(78, 52, 46, 0.25);
+        }
+
+        .tab-btn:focus-visible {
+          outline: 2px solid var(--accent-color);
+          outline-offset: 2px;
+        }
+
+        /* Search input */
+        .search-container {
+          position: relative;
+          min-width: 240px;
