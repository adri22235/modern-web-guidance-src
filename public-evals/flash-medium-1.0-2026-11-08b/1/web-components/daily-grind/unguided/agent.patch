+
+            <div class="option-group">
+              <label class="option-label" for="syrup-select">Sweetener & Flavor</label>
+              <select id="syrup-select" class="form-select">
+                <option value="Standard (2 pumps)">Standard Sweetness (2 pumps)</option>
+                <option value="Extra Sweet (4 pumps)">Extra Sweet (4 pumps)</option>
+                <option value="Light Sweetness (1 pump)">Light Sweetness (1 pump)</option>
+                <option value="Sugar-Free Vanilla">Sugar-Free Vanilla</option>
+                <option value="Unsweetened">Unsweetened</option>
+              </select>
+            </div>
+
+            <div class="qty-row">
+              <span class="option-label" style="margin-bottom:0;">Quantity</span>
+              <div class="qty-stepper">
