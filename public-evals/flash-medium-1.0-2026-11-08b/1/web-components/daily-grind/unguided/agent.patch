+/**
+ * Accessible Newsletter & Coffee Club Web Component
+ * <newsletter-section>
+ */
+class NewsletterSection extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._status = 'idle'; // idle | submitting | success | error
+    this._errorMessage = '';
+  }
+
+  connectedCallback() {
+    this.render();
+    this._setupForm();
+  }
+
+  _setupForm() {
+    const form = this.shadowRoot.querySelector('#newsletter-form');
+    if (!form) return;
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const input = this.shadowRoot.querySelector('#email-input');
+      const email = input ? input.value.trim() : '';
+
+      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+      if (!email || !emailRegex.test(email)) {
+        this._status = 'error';
+        this._errorMessage = 'Please enter a valid email address.';
+        this.render();
+        this._setupForm();
+        const inputAfter = this.shadowRoot.querySelector('#email-input');
+        if (inputAfter) inputAfter.focus();
+        return;
+      }
+
+      this._status = 'submitting';
+      this.render();
+
+      setTimeout(() => {
+        this._status = 'success';
+        this.render();
+        this._setupForm();
+
+        window.dispatchEvent(
+          new CustomEvent('show-toast', {
+            detail: {
+              message: 'Welcome to The Daily Grind Coffee Club! Check your inbox.',
+              type: 'success'
+            }
+          })
+        );
+      }, 600);
+    });
+
+    const resetBtn = this.shadowRoot.querySelector('#subscribe-another');
+    if (resetBtn) {
+      resetBtn.addEventListener('click', () => {
+        this._status = 'idle';
+        this.render();
+        this._setupForm();
+      });
+    }
+  }
+
+  render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
+          --primary-color: var(--primary, #4e342e);
+          --accent-color: var(--accent, #ffab40);
+          --secondary-color: var(--secondary, #d7ccc8);
+          font-family: inherit;
+        }
+
+        .newsletter-card {
+          background: linear-gradient(135deg, #4e342e 0%, #32201b 100%);
+          color: #ffffff;
+          border-radius: 16px;
+          padding: 48px 32px;
+          margin: 60px auto 20px auto;
+          max-width: 900px;
+          text-align: center;
+          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
+          position: relative;
+          overflow: hidden;
+        }
+
+        .newsletter-card::after {
+          content: '☕';
+          position: absolute;
+          right: -20px;
+          bottom: -30px;
+          font-size: 10rem;
+          opacity: 0.05;
+          pointer-events: none;
+        }
+
+        .heading {
+          font-size: clamp(1.6rem, 3.5vw, 2.2rem);
+          font-weight: 800;
+          margin: 0 0 12px 0;
+          color: #ffffff;
+        }
+
+        .desc {
+          font-size: 1.05rem;
+          color: var(--secondary-color);
+          max-width: 580px;
+          margin: 0 auto 28px auto;
+          line-height: 1.5;
+        }
+
+        .form {
+          display: flex;
+          justify-content: center;
+          gap: 12px;
+          max-width: 500px;
+          margin: 0 auto;
+          flex-wrap: wrap;
+        }
+
+        .input-group {
+          flex: 1;
+          min-width: 240px;
+          text-align: left;
+        }
+
+        .sr-only {
+          position: absolute;
+          width: 1px;
+          height: 1px;
+          padding: 0;
+          margin: -1px;
+          overflow: hidden;
+          clip: rect(0, 0, 0, 0);
+          border: 0;
+        }
+
+        .email-input {
+          width: 100%;
+          padding: 14px 18px;
+          border-radius: 8px;
+          border: 2px solid transparent;
+          font-size: 1rem;
+          font-family: inherit;
+          box-sizing: border-box;
+          background: #ffffff;
+          color: #3e2723;
+        }
+
+        .email-input:focus {
+          outline: none;
+          border-color: var(--accent-color);
+          box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+        }
+
+        .email-input.has-error {
+          border-color: #ef5350;
+        }
+
+        .btn-submit {
+          background: var(--accent-color);
+          color: #2e1c14;
+          font-weight: 700;
+          font-size: 1rem;
+          padding: 14px 24px;
+          border: none;
+          border-radius: 8px;
+          cursor: pointer;
+          font-family: inherit;
+          transition: background-color 0.2s, transform 0.15s;
+        }
+
+        .btn-submit:hover:not(:disabled) {
+          background: #ffa000;
+          transform: translateY(-1px);
+        }
+
+        .btn-submit:focus-visible {
+          outline: 2px solid #ffffff;
+          outline-offset: 3px;
+        }
+
+        .btn-submit:disabled {
+          opacity: 0.7;
+          cursor: not-allowed;
+        }
+
+        .feedback-msg {
+          margin-top: 10px;
+          font-size: 0.9rem;
+          min-height: 20px;
+        }
+
+        .feedback--error {
+          color: #ff8a80;
+        }
+
+        .feedback--success {
+          background: rgba(255, 255, 255, 0.1);
+          padding: 18px;
+          border-radius: 8px;
+          border-left: 4px solid #81c784;
