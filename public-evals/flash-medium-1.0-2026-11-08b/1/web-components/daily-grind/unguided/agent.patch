+          clearBtn.style.display = this._searchQuery ? 'block' : 'none';
+        }
+        this._filterCards();
+      });
+    }
+
+    if (clearBtn) {
+      clearBtn.addEventListener('click', () => {
+        if (searchInput) {
+          searchInput.value = '';
+          this._searchQuery = '';
+          clearBtn.style.display = 'none';
+          this._filterCards();
+          searchInput.focus();
+        }
+      });
+    }
+
+    const resetBtn = this.shadowRoot.querySelector('#reset-filters-btn');
+    if (resetBtn) {
+      resetBtn.addEventListener('click', () => {
+        const allTab = this.shadowRoot.querySelector('[data-category="all"]');
+        if (allTab) this._selectTab(allTab);
+        if (searchInput) {
+          searchInput.value = '';
+          this._searchQuery = '';
