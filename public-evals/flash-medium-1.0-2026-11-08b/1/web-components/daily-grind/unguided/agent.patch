+      const cardDesc = (card.getAttribute('description') || '').toLowerCase();
+      const cardRoast = (card.getAttribute('roast') || '').toLowerCase();
+
+      const matchesCategory =
+        this._activeCategory === 'all' ||
+        cardCategory.includes(this._activeCategory) ||
+        this._activeCategory.includes(cardCategory);
+
+      const matchesSearch =
+        !this._searchQuery ||
+        cardName.includes(this._searchQuery) ||
+        cardDesc.includes(this._searchQuery) ||
