+      <script>
+        (function () {
+          function initTargetScroll() {
+            const container = document.querySelector('.scroll-container');
+            const target = document.querySelector('.target');
+            if (!target) return;
+
+            if (container) {
+              container.style.scrollBehavior = 'auto';
+              if (target.offsetParent === container) {
+                container.scrollTop = target.offsetTop;
+              } else {
+                container.scrollTop = target.offsetTop - container.offsetTop;
+              }
+              const cRect = container.getBoundingClientRect();
+              const tRect = target.getBoundingClientRect();
+              if (cRect && tRect && (tRect.top !== 0 || cRect.top !== 0)) {
+                container.scrollTop += (tRect.top - cRect.top);
+              }
+            }
+
+            target.scrollIntoView({ behavior: 'instant', block: 'start' });
+          }
+
+          // Execute immediately on parse so it is already in position on initial load
+          initTargetScroll();
+
+          if (document.readyState === 'loading') {
+            document.addEventListener('DOMContentLoaded', initTargetScroll);
+          }
+          window.addEventListener('load', initTargetScroll);
+        })();
+      </script>
