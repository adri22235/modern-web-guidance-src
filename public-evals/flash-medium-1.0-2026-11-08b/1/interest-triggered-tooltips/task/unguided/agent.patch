+  <script>
+    (function () {
+      function initTooltips() {
+        const containers = document.querySelectorAll('.tooltip-container');
+        const supportsAnchor = typeof CSS !== 'undefined' &&
+          typeof CSS.supports === 'function' &&
+          (CSS.supports('anchor-name', '--a') || CSS.supports('anchor-name: --a'));
+
+        containers.forEach(function (container) {
+          const btn = container.querySelector('.btn');
+          const tooltip = container.querySelector('.tooltip');
+          if (!btn || !tooltip) return;
+
+          function positionFallback() {
+            if (supportsAnchor) return;
+            const btnRect = btn.getBoundingClientRect();
+            const tooltipRect = tooltip.getBoundingClientRect();
+            // Fallback placement: position above button, or flip below if viewport constrained
+            if (btnRect.top - (tooltipRect.height || 160) - 12 < 0) {
+              tooltip.style.bottom = 'auto';
+              tooltip.style.top = 'calc(100% + 12px)';
+              tooltip.classList.add('flipped');
+            } else {
+              tooltip.style.top = 'auto';
+              tooltip.style.bottom = 'calc(100% + 12px)';
+              tooltip.classList.remove('flipped');
+            }
+          }
+
+          function show() {
+            tooltip.classList.add('is-active', 'visible');
+            tooltip.setAttribute('aria-hidden', 'false');
+            positionFallback();
+          }
+
+          function hide() {
+            tooltip.classList.remove('is-active', 'visible');
+            tooltip.setAttribute('aria-hidden', 'true');
+          }
+
+          // Hover listeners
+          btn.addEventListener('mouseenter', show);
+          btn.addEventListener('mouseleave', hide);
+
+          // Focus listeners
+          btn.addEventListener('focus', show);
+          btn.addEventListener('blur', hide);
+
+          // Keep popup open while pointer is over it
+          tooltip.addEventListener('mouseenter', show);
+          tooltip.addEventListener('mouseleave', hide);
+
+          // Keyboard dismiss
+          btn.addEventListener('keydown', function (e) {
+            if (e.key === 'Escape') {
+              hide();
+            }
+          });
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initTooltips);
+      } else {
+        initTooltips();
+      }
+    })();
+  </script>
+
