+    /* Base popup & tooltip styling (and fallback positioning for older browsers) */
+    .tooltip,
+    .popup {
+      position: absolute;
+      bottom: calc(100% + 12px);
+      left: 50%;
+      transform: translateX(-50%);
+      width: 260px;
+      background: var(--text);
+      color: #ffffff;
+      padding: 12px 14px;
+      border-radius: 8px;
