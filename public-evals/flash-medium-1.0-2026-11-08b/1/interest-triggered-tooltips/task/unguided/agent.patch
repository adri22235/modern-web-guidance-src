+      font-size: 0.82rem;
+      line-height: 1.45;
+      text-align: left;
+      z-index: 1000;
+      pointer-events: none;
+      opacity: 0;
+      visibility: hidden;
+      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
+    }
+
+    /* Arrow indicator pointing toward action button */
+    .tooltip::after,
+    .popup::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border-width: 6px;
+      border-style: solid;
+      border-color: var(--text) transparent transparent transparent;
+    }
+
+    .tooltip.flipped::after,
+    .popup.flipped::after {
+      top: auto;
+      bottom: 100%;
+      border-color: transparent transparent var(--text) transparent;
+    }
+
