+    .btn:hover + .tooltip,
+    .btn:focus + .tooltip,
+    .btn:focus-visible + .tooltip,
+    .btn:hover ~ .tooltip,
+    .btn:focus ~ .tooltip,
+    .btn:focus-visible ~ .tooltip,
