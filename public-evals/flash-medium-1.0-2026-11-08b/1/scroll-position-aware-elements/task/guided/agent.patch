+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTopBtn = document.querySelector('.back-to-top');
+
+    // Smooth scroll back to top when button is clicked
+    if (backToTopBtn && scroller) {
+      backToTopBtn.addEventListener('click', () => {
+        scroller.scrollTo({
+          top: 0,
+          behavior: 'smooth'
+        });
+
+        // Accessible focus management: move focus cleanly to top navigation or scroller
+        const topTarget = document.querySelector('nav') || scroller;
+        if (topTarget) {
+          if (!topTarget.hasAttribute('tabindex')) {
+            topTarget.setAttribute('tabindex', '-1');
+          }
+          topTarget.focus({ preventScroll: true });
+        }
+      });
+    }
+
+    // Advanced fallback: IntersectionObserver for browsers without container scroll-state query support
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const sentinel = document.querySelector('.scroll-sentinel');
+
+      if (sentinel && scroller) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            // If sentinel is NOT intersecting, it means the user has scrolled down
+            if (!entry.isIntersecting) {
+              scroller.classList.add('scrolled');
+            } else {
+              scroller.classList.remove('scrolled');
+            }
+          });
+        }, { root: scroller });
+
+        observer.observe(sentinel);
+      }
+    }
+  </script>
+
