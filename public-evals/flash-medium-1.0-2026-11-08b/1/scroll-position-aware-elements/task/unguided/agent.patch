+  <script>
+    (function () {
+      const scroller = document.querySelector('.scroller');
+      const backToTopBtn = document.querySelector('.back-to-top');
+      const sentinel = document.querySelector('.scroll-sentinel');
+
+      if (!scroller || !backToTopBtn) return;
+
+      function setButtonVisible(visible) {
+        if (visible) {
+          backToTopBtn.classList.add('visible', 'show');
+          scroller.classList.add('scrolled');
+          scroller.setAttribute('data-scrolled', 'true');
+          backToTopBtn.setAttribute('tabindex', '0');
+          backToTopBtn.removeAttribute('aria-hidden');
+        } else {
+          backToTopBtn.classList.remove('visible', 'show');
+          scroller.classList.remove('scrolled');
+          scroller.removeAttribute('data-scrolled');
+          backToTopBtn.setAttribute('tabindex', '-1');
+          backToTopBtn.setAttribute('aria-hidden', 'true');
+        }
+      }
+
+      // Initial state is hidden
+      setButtonVisible(false);
+
+      // Performant scroll tracking using IntersectionObserver (no continuous scroll event listeners)
+      if (sentinel && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            // When sentinel intersects at top, user is at top -> button hidden
+            const isAtTop = entry.isIntersecting;
+            setButtonVisible(!isAtTop);
+          }
+        }, {
+          root: scroller,
+          threshold: 0
+        });
+
+        observer.observe(sentinel);
+
+        // Fallback viewport observer if window is scrolled instead of container
+        const viewportObserver = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            if (!entry.isIntersecting) {
+              setButtonVisible(true);
+            }
+          }
+        }, {
+          root: null,
+          threshold: 0
+        });
+
+        viewportObserver.observe(sentinel);
+      }
+
+      // Smooth scroll back to top when activated
+      backToTopBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        scroller.scrollTo({ top: 0, behavior: 'smooth' });
+        window.scrollTo({ top: 0, behavior: 'smooth' });
+        document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
+        backToTopBtn.blur();
+      });
+    })();
+  </script>
