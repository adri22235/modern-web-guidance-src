+  <script>
+    (function () {
+      const domContainer = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const promoOffers = [
+        {
+          badge: 'Limited Time',
+          title: 'Afternoon Refresher - 50% Off',
+          desc: 'Half-price iced teas and cold brews every weekday between 2 PM and 5 PM.',
+          btnText: 'Claim Offer'
+        },
+        {
+          badge: 'Member Exclusive',
+          title: 'Double Grind Points',
+          desc: 'Earn 2x rewards points on all whole-bean single origin bag purchases this week.',
+          btnText: 'Shop Beans'
+        },
+        {
+          badge: 'Weekend Special',
+          title: 'Brunch Pastry Bundle',
+          desc: 'Complimentary artisan croissant with any signature pour-over or seasonal latte.',
+          btnText: 'Get Voucher'
+        },
+        {
+          badge: 'New Flavor',
+          title: 'Vanilla Bean Cold Foam',
+          desc: 'Free flavor upgrade to handcrafted vanilla bean cold foam on any cold brew drink.',
+          btnText: 'Try It Free'
+        },
+        {
+          badge: 'Subscription Perk',
+          title: 'First Bag Free',
+          desc: 'Subscribe to our monthly roaster selection and get your first 12oz bag on us.',
+          btnText: 'Subscribe Now'
+        }
+      ];
+
+      let promoIndex = 0;
+
+      function createPromoCard() {
+        const offer = promoOffers[promoIndex % promoOffers.length];
+        promoIndex++;
+
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML = `
+          <span class="promo-badge">${offer.badge}</span>
+          <h3>${offer.title}</h3>
+          <p>${offer.desc}</p>
+          <a href="/menu" class="btn">${offer.btnText}</a>
+        `;
+        return card;
+      }
+
+      function animateEntry(card) {
+        card.classList.remove('card-exiting', 'card-exit');
+        card.classList.add('card-entering');
+
+        let finished = false;
+        const finish = () => {
+          if (finished) return;
+          finished = true;
+          card.classList.remove('card-entering', 'card-enter');
+        };
+
+        card.addEventListener('animationend', finish, { once: true });
+        card.addEventListener('transitionend', finish, { once: true });
+        setTimeout(finish, 400);
+      }
+
+      function animateExit(card, callback) {
+        if (card.classList.contains('card-exiting')) return;
+        card.classList.remove('card-entering', 'card-enter');
+        card.classList.add('card-exiting');
+
+        let finished = false;
+        const finish = () => {
+          if (finished) return;
+          finished = true;
+          card.classList.remove('card-exiting', 'card-exit');
+          if (callback) callback();
+        };
+
+        card.addEventListener('animationend', finish, { once: true });
+        card.addEventListener('transitionend', finish, { once: true });
+        setTimeout(finish, 400);
+      }
+
+      // Add Button: Appends a new promo card with entry animation
+      addBtn.addEventListener('click', () => {
+        const newCard = createPromoCard();
+        domContainer.appendChild(newCard);
+        animateEntry(newCard);
+      });
+
+      // Remove Button: Animates and removes the last card
+      removeBtn.addEventListener('click', () => {
+        const cards = Array.from(domContainer.querySelectorAll('.card:not(.card-exiting)'));
+        if (cards.length === 0) return;
+
+        const visibleCards = cards.filter(c => c.style.display !== 'none');
+        const targetCard = visibleCards.length > 0 ? visibleCards[visibleCards.length - 1] : cards[cards.length - 1];
+
+        animateExit(targetCard, () => {
+          targetCard.style.display = 'none';
+          targetCard.remove();
+        });
+      });
+
+      // Toggle Button: Toggles the default promo card (#toggleCard)
+      toggleBtn.addEventListener('click', () => {
+        if (toggleCard.classList.contains('card-exiting')) {
+          toggleCard.classList.remove('card-exiting', 'card-exit');
+          toggleCard.style.display = '';
+          if (!domContainer.contains(toggleCard)) {
+            domContainer.prepend(toggleCard);
+          }
+          animateEntry(toggleCard);
+          return;
+        }
+
+        const isVisible = domContainer.contains(toggleCard) && toggleCard.style.display !== 'none';
+
+        if (isVisible) {
+          animateExit(toggleCard, () => {
+            toggleCard.style.display = 'none';
+            toggleCard.remove();
+          });
+        } else {
+          toggleCard.style.display = '';
+          if (!domContainer.contains(toggleCard)) {
+            domContainer.prepend(toggleCard);
+          }
+          animateEntry(toggleCard);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
