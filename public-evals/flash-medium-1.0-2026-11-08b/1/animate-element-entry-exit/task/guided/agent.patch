+  <script>
+    (() => {
+      const domContainer = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const defaultToggleCard = document.getElementById('toggleCard');
+
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      async function hideElement(el) {
+        if (canTransitionDisplay()) {
+          el.hidden = true;
+        } else {
+          el.setAttribute('data-closing', '');
+        }
+
+        // Force style recalculation so transitions start
+        void el.offsetHeight;
+
+        const animations = typeof el.getAnimations === 'function' ? el.getAnimations() : [];
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        } else {
+          await new Promise((resolve) => {
+            let done = false;
+            const onEnd = (e) => {
+              if (e.target === el && !done) {
+                done = true;
+                el.removeEventListener('transitionend', onEnd);
+                resolve();
+              }
+            };
+            el.addEventListener('transitionend', onEnd);
+            setTimeout(() => {
+              if (!done) {
+                done = true;
+                el.removeEventListener('transitionend', onEnd);
+                resolve();
+              }
+            }, 450);
+          });
+        }
+
+        if (el.hasAttribute('data-closing')) {
+          el.removeAttribute('data-closing');
+          el.hidden = true;
+        }
+      }
+
+      function showElement(el) {
+        el.removeAttribute('data-closing');
+        el.hidden = false;
+        el.style.display = '';
+      }
+
+      async function removeElement(el) {
+        el.setAttribute('data-removing', '');
+        await hideElement(el);
+        el.remove();
+      }
+
+      const promoTemplates = [
+        {
+          title: 'Maple Cinnamon Cold Foam',
+          desc: 'Buy any seasonal cold brew beverage and get a second one at 50% off.',
+          badge: 'Seasonal Perk',
+          img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80',
+          alt: 'Iced coffee with cold foam'
+        },
+        {
+          title: 'Artisan Bakery Bundle',
+          desc: 'Receive a complimentary warm almond croissant with any large pour-over.',
+          badge: 'Morning Treat',
+          img: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80',
+          alt: 'Freshly baked croissant and coffee'
+        },
+        {
+          title: "Roaster's Subscription",
+          desc: 'Save 30% on your first month of fresh, locally roasted whole beans delivered weekly.',
+          badge: 'Member Exclusive',
+          img: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80',
+          alt: 'Roasted coffee beans'
+        },
+        {
+          title: 'Nitro Cold Brew Flight',
+          desc: 'Sample 3 of our finest single-origin nitro cold brews on tap for only $10.',
+          badge: 'Tasting Special',
+          img: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+          alt: 'Glass of smooth nitro cold brew'
+        }
+      ];
+
+      let promoIndex = 0;
+
+      addBtn.addEventListener('click', () => {
+        const template = promoTemplates[promoIndex % promoTemplates.length];
+        promoIndex++;
+
+        const newCard = document.createElement('div');
+        newCard.className = 'card';
+        newCard.innerHTML = `
+          <img src="${template.img}" alt="${template.alt}" class="promo-img" loading="lazy">
+          <span class="badge">${template.badge}</span>
+          <h3>${template.title}</h3>
+          <p>${template.desc}</p>
+          <a href="/menu/seasonal" class="btn">Claim Offer</a>
+        `;
+
+        domContainer.appendChild(newCard);
+      });
+
+      removeBtn.addEventListener('click', async () => {
+        const cards = Array.from(domContainer.querySelectorAll('.card:not([data-removing])'));
+        if (cards.length > 0) {
+          const lastCard = cards[cards.length - 1];
+          await removeElement(lastCard);
+        }
+      });
+
+      toggleBtn.addEventListener('click', async () => {
+        const card = document.getElementById('toggleCard') || defaultToggleCard;
+        if (!domContainer.contains(card)) {
+          domContainer.prepend(card);
+          showElement(card);
+        } else if (card.hidden || card.hasAttribute('data-closing') || getComputedStyle(card).display === 'none') {
+          showElement(card);
+        } else {
+          await hideElement(card);
+        }
+      });
+    })();
+  </script>
+
