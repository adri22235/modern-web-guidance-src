+      // Native fetch interceptor to stream realistic server HTML responses
+      const originalFetch = window.fetch;
+      window.fetch = async function (input, init) {
+        const urlString = typeof input === 'string' ? input : (input && input.url ? input.url : '');
+        if (urlString.includes('/api/menu/seasonal')) {
+          const url = new URL(urlString, window.location.href);
+          const season = url.searchParams.get('season') || 'autumn';
+          const type = url.searchParams.get('type') || 'cards';
+          const seasonContent = seasonalData[season] || seasonalData.autumn;
+          const htmlContent = seasonContent[type] || seasonContent.cards;
+
+          // Return streaming HTML response
+          const stream = new ReadableStream({
+            start(controller) {
+              const encoder = new TextEncoder();
+              // Split content into chunks to emulate incremental server streaming
+              const chunks = [
+                htmlContent.slice(0, Math.floor(htmlContent.length / 2)),
+                htmlContent.slice(Math.floor(htmlContent.length / 2))
+              ];
+              chunks.forEach(chunk => controller.enqueue(encoder.encode(chunk)));
+              controller.close();
+            }
+          });
+
+          return new Response(stream, {
+            status: 200,
+            headers: { 'Content-Type': 'text/html; charset=utf-8' }
+          });
+        }
+        return originalFetch.apply(this, arguments);
+      };
+
+      // -----------------------------------------------------------------------
+      // 4. In-Place Menu Refresh using Native Browser Capabilities
+      // -----------------------------------------------------------------------
+      async function refreshSeasonalMenu(season) {
+        const statusEl = document.getElementById('refresh-status');
+        const cardsGrid = document.getElementById('seasonal-cards-grid');
+        const reviewsContainer = document.getElementById('customer-reviews-container');
+        const promoContainer = document.getElementById('cms-promo-container');
+
+        if (statusEl) statusEl.textContent = 'Streaming fresh menu...';
+
+        try {
+          // A) Fetch & stream fresh coffee cards directly into the DOM using native streamHTMLUnsafe
+          const cardsResponse = await fetch(`/api/menu/seasonal?type=cards&season=${encodeURIComponent(season)}`);
+          if (typeof cardsResponse.textStream === 'function' && 'streamHTMLUnsafe' in Element.prototype) {
+            await cardsResponse.textStream().pipeTo(cardsGrid.streamHTMLUnsafe({ runScripts: true }));
+          } else {
+            const cardsHtml = await cardsResponse.text();
+            cardsGrid.setHTMLUnsafe(cardsHtml, { runScripts: true });
+          }
+
+          // B) Fetch customer-submitted reviews and sanitize using native setHTML with built-in Sanitizer
+          const reviewsResponse = await fetch(`/api/menu/seasonal?type=reviews&season=${encodeURIComponent(season)}`);
+          const reviewsHtml = await reviewsResponse.text();
+          // Safe insertion: strips any untrusted script tags or event handlers from user-submitted reviews
+          reviewsContainer.setHTML(reviewsHtml);
+
+          // C) Fetch promo block from CMS with embedded widget script and insert with setHTMLUnsafe { runScripts: true }
+          const promoResponse = await fetch(`/api/menu/seasonal?type=promo&season=${encodeURIComponent(season)}`);
+          const promoHtml = await promoResponse.text();
+          // Trusted CMS insertion: explicitly run embedded widget scripts
+          promoContainer.setHTMLUnsafe(promoHtml, { runScripts: true });
+
+          if (statusEl) {
+            statusEl.textContent = `Updated: ${season.toUpperCase()}`;
+            setTimeout(() => { statusEl.textContent = ''; }, 3000);
+          }
+        } catch (err) {
+          console.error('Failed to refresh seasonal menu:', err);
+          if (statusEl) statusEl.textContent = 'Refresh failed.';
+        }
+      }
+
+      // Event listeners for menu season selection & refresh button
+      const selectEl = document.getElementById('seasonal-menu-select');
+      const refreshBtn = document.getElementById('refresh-menu-btn');
+
+      if (selectEl) {
+        selectEl.addEventListener('change', (e) => {
+          refreshSeasonalMenu(e.target.value);
+        });
+      }
+
+      if (refreshBtn && selectEl) {
+        refreshBtn.addEventListener('click', () => {
+          refreshSeasonalMenu(selectEl.value);
+        });
+      }
+    })();
+  </script>
