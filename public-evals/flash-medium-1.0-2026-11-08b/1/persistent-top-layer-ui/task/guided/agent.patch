+  <button type="button" id="floating-feedback-btn" class="floating-feedback-btn" command="show-modal" commandfor="feedback-modal" aria-label="Give Feedback">
+    Feedback
+  </button>
+
+  <script>
+    (function () {
+      const sections = [
+        { id: 'hero-section', label: '<header id="hero-section">' },
+        { id: 'main-section', label: '<main id="main-section">' },
+        { id: 'footer-section', label: '<footer id="footer-section">' }
+      ];
+
+      const dialog = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const parentDisplay = document.getElementById('current-parent-display');
+      const feedbackForm = document.getElementById('feedback-form');
+
+      function updateLocationDisplay() {
+        const parent = dialog.parentElement;
+        if (parentDisplay) {
+          if (parent && parent.id) {
+            parentDisplay.textContent = `<${parent.tagName.toLowerCase()} id="${parent.id}">`;
+          } else if (parent) {
+            parentDisplay.textContent = `<${parent.tagName.toLowerCase()}>`;
+          } else {
+            parentDisplay.textContent = 'Detached';
+          }
+        }
+      }
+
+      function moveModal() {
+        const currentParent = dialog.parentElement;
+        const currentIndex = sections.findIndex(s => document.getElementById(s.id) === currentParent);
+        const nextIndex = (currentIndex + 1) % sections.length;
+        const nextParent = document.getElementById(sections[nextIndex].id);
+
+        if (!nextParent) return;
+
+        // Reparent open top-layer dialog while keeping it open and active across reparenting.
+        // MANDATORY: Use moveBefore to ensure the <dialog> stays open.
+        if ('moveBefore' in Element.prototype) {
+          nextParent.moveBefore(dialog, null);
+        } else {
+          // Fallback: traditional move. Note: This closes <dialog> in unsupported browsers.
+          const wasOpen = dialog.hasAttribute('open');
+          nextParent.insertBefore(dialog, null);
+          if (wasOpen && typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          }
+        }
+
+        updateLocationDisplay();
+      }
+
+      if (moveBtn) {
+        moveBtn.addEventListener('click', moveModal);
+      }
+
+      // Feature detection & fallbacks for declarative Invoker commands ('command' / 'commandfor')
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        document.querySelectorAll('button[command="show-modal"]').forEach(btn => {
+          const targetId = btn.getAttribute('commandfor');
+          btn.addEventListener('click', () => {
+            const target = document.getElementById(targetId);
+            if (target && typeof target.showModal === 'function') {
+              target.showModal();
+            }
+          });
+        });
+
+        document.querySelectorAll('button[command="close"]').forEach(btn => {
+          const targetId = btn.getAttribute('commandfor');
+          btn.addEventListener('click', () => {
+            const target = document.getElementById(targetId);
+            if (target && typeof target.close === 'function') {
+              target.close();
+            }
+          });
+        });
+      }
+
+      // Fallback for closedby="any" (light dismiss on backdrop click)
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e, dlg) => {
+          const r = dlg.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+          let pressedOutside = false;
+          dlg.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dlg); });
+          dlg.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dlg)) dlg.close(); });
+        }
+      }
+
+      // Reset returnValue on close to avoid stale values leaking
+      dialog.addEventListener('close', () => {
+        if (dialog.returnValue === 'submit') {
+          alert('Thank you for sharing your feedback!');
+          feedbackForm.reset();
+        }
+        dialog.returnValue = '';
+      });
+
+      updateLocationDisplay();
+    })();
+  </script>
+
