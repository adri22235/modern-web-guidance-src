+    // Polyfill Node.prototype.moveBefore and Element.prototype.moveBefore if not supported
+    (function () {
+      if (typeof Element !== 'undefined' && !Element.prototype.moveBefore) {
+        const movePolyfill = function (node, referenceNode) {
+          const isDialog = node.tagName === 'DIALOG';
+          const wasOpen = isDialog && node.open;
+          const activeEl = document.activeElement;
+
+          this.insertBefore(node, referenceNode);
+
+          if (isDialog && wasOpen && !node.open && typeof node.showModal === 'function') {
+            node.showModal();
+          }
+          if (activeEl && node.contains(activeEl)) {
+            activeEl.focus();
+          }
+          return node;
+        };
+        Element.prototype.moveBefore = movePolyfill;
+        if (typeof Node !== 'undefined' && !Node.prototype.moveBefore) {
+          Node.prototype.moveBefore = movePolyfill;
+        }
+      }
+    })();
+
+    document.addEventListener('DOMContentLoaded', () => {
