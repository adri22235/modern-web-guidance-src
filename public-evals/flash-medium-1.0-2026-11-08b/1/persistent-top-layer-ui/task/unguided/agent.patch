+      const currentSectionDisplay = document.getElementById('current-section-display');
+      const reparentStatus = document.getElementById('reparent-status');
+      const feedbackForm = document.getElementById('feedback-form');
+      const closeModalX = document.getElementById('close-modal-x');
+      const closeFeedbackBtn = document.getElementById('close-feedback-btn');
+      const openTriggers = [
+        document.getElementById('nav-feedback-btn'),
+        document.getElementById('floating-feedback-btn'),
+        document.getElementById('footer-feedback-link')
+      ].filter(Boolean);
+
+      function getPageSections() {
+        const sections = Array.from(document.querySelectorAll('section.page-section, section'));
+        return [...new Set(sections)];
+      }
+
+      function openModal() {
+        if (!feedbackModal.open) {
+          feedbackModal.showModal();
+        }
+      }
+
+      function closeModal() {
+        if (feedbackModal.open) {
+          feedbackModal.close();
+        }
+      }
+
+      function updateLocationUI(targetSection) {
+        const currentParent = targetSection || feedbackModal.parentElement;
+        const sections = getPageSections();
+        const sectionName = currentParent.getAttribute('data-section-name') ||
+          currentParent.id ||
+          currentParent.tagName.toLowerCase();
+
+        if (currentSectionDisplay) {
+          currentSectionDisplay.textContent = sectionName;
+        }
+
+        if (sectionSelect && currentParent.id) {
+          sectionSelect.value = currentParent.id;
+        }
+
+        sections.forEach(sec => {
+          if (sec === currentParent) {
+            sec.setAttribute('data-has-modal', 'true');
+          } else {
+            sec.removeAttribute('data-has-modal');
+          }
+        });
+      }
+
+      function relocateModal(targetSection) {
+        const sections = getPageSections();
+        if (sections.length < 2) return;
+
+        const currentParent = feedbackModal.parentElement;
+
+        if (!targetSection) {
+          const currentIndex = sections.indexOf(currentParent);
+          const nextIndex = (currentIndex + 1) % sections.length;
+          targetSection = sections[nextIndex];
+        }
+
+        if (targetSection === currentParent) return;
+
+        const activeEl = document.activeElement;
+        const wasMoveBtnActive = activeEl === moveBtn;
+
+        // Atomically relocate using moveBefore to keep open state and focus active across reparenting
+        if (typeof targetSection.moveBefore === 'function') {
+          targetSection.moveBefore(feedbackModal, null);
+        } else {
+          const wasOpen = feedbackModal.open;
+          targetSection.appendChild(feedbackModal);
+          if (wasOpen && !feedbackModal.open && typeof feedbackModal.showModal === 'function') {
+            feedbackModal.showModal();
+          }
+        }
+
+        // Restore focus to keep element active
+        if (wasMoveBtnActive) {
+          moveBtn.focus();
+        } else if (activeEl && feedbackModal.contains(activeEl)) {
+          activeEl.focus();
+        }
+
+        const targetName = targetSection.getAttribute('data-section-name') || targetSection.id;
+        if (reparentStatus) {
+          reparentStatus.textContent = `Moved to "${targetName}" (#${targetSection.id})`;
+          reparentStatus.style.color = '#2e7d32';
+        }
+
+        updateLocationUI(targetSection);
+
+        // Dispatch custom event for programmatic tracking
