diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..fb7ad43
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,538 @@
+/**
+ * StarRating Web Component
+ * Form-associated custom element for star ratings.
+ * 
+ * Features:
+ * - Native form submission (ElementInternals.setFormValue)
+ * - Required constraint validation (ElementInternals.setValidity)
+ * - Form reset participation (formResetCallback)
+ * - Disabled fieldset participation (formDisabledCallback)
+ * - Browser state restoration (formStateRestoreCallback)
+ * - Full ARIA radiogroup accessibility and keyboard navigation
+ */
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+
+  static get observedAttributes() {
+    return ['value', 'max', 'disabled', 'required', 'name'];
+  }
+
+  constructor() {
+    super();
+    this._internals = this.attachInternals();
+    this._value = 0;
+    this._hoverValue = 0;
+    this._max = 5;
+    this._disabled = false;
+    this._required = false;
+    this._defaultValue = '';
+
+    this.attachShadow({ mode: 'open' });
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('max')) {
+      const m = parseInt(this.getAttribute('max'), 10);
+      if (!isNaN(m) && m > 0) this._max = m;
+    }
+    if (this.hasAttribute('value')) {
+      const v = parseInt(this.getAttribute('value'), 10);
+      if (!isNaN(v) && v > 0) {
+        this._value = Math.min(Math.max(v, 1), this._max);
+      }
+      this._defaultValue = this.getAttribute('value');
+    }
+    this._required = this.hasAttribute('required');
+    this._disabled = this.hasAttribute('disabled');
+
+    this._render();
+    this._updateFormValue();
+    this._updateValidity();
+  }
+
+  // --- Form Association Callbacks ---
+
+  formAssociatedCallback(form) {
+    this._updateValidity();
+  }
+
+  formDisabledCallback(disabled) {
+    // Called when disabled attribute changes or when an ancestor <fieldset> is disabled/enabled
+    this._disabled = Boolean(disabled);
+    this._updateDisabledState();
+    this._updateValidity();
+  }
+
+  formResetCallback() {
+    // Reset to default value (from initial attribute, or 0)
+    const initialAttr = this.getAttribute('value');
+    if (initialAttr !== null && initialAttr !== '') {
+      const parsed = parseInt(initialAttr, 10);
+      this._value = (!isNaN(parsed) && parsed > 0) ? Math.min(Math.max(parsed, 1), this._max) : 0;
+    } else if (this._defaultValue !== '') {
+      const parsed = parseInt(this._defaultValue, 10);
+      this._value = (!isNaN(parsed) && parsed > 0) ? Math.min(Math.max(parsed, 1), this._max) : 0;
+    } else {
+      this._value = 0;
+    }
+    this._hoverValue = 0;
+    this._updateFormValue();
+    this._updateValidity();
+    this._updateDisplay();
+  }
+
+  formStateRestoreCallback(state, mode) {
+    // Called by browser on session restore, back/forward navigation, or autocomplete
+    if (state !== null && state !== undefined && state !== '') {
+      const parsed = parseInt(state, 10);
+      if (!isNaN(parsed) && parsed > 0) {
+        this._value = Math.min(Math.max(parsed, 1), this._max);
+      } else {
+        this._value = 0;
+      }
+    } else {
+      this._value = 0;
+    }
+    this._hoverValue = 0;
+    this._updateFormValue();
+    this._updateValidity();
+    this._updateDisplay();
+  }
+
+  // --- Observed Attributes Callback ---
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+
+    switch (name) {
+      case 'value':
+        if (newValue !== null && newValue !== '') {
+          const parsed = parseInt(newValue, 10);
+          this._value = (!isNaN(parsed) && parsed > 0) ? Math.min(Math.max(parsed, 1), this._max) : 0;
+        } else {
+          this._value = 0;
+        }
+        this._updateFormValue();
+        this._updateValidity();
+        this._updateDisplay();
+        break;
+      case 'max': {
+        const m = parseInt(newValue, 10);
+        this._max = (!isNaN(m) && m > 0) ? m : 5;
+        this._render();
+        break;
+      }
+      case 'disabled':
+        this._disabled = newValue !== null;
+        this._updateDisabledState();
+        this._updateValidity();
+        break;
+      case 'required':
+        this._required = newValue !== null;
+        this._updateValidity();
+        break;
+      case 'name':
+        // name attribute updated
+        break;
+    }
+  }
+
+  // --- Standard Properties & Constraint Validation APIs ---
+
+  get value() {
+    return this._value > 0 ? String(this._value) : '';
+  }
+
+  set value(val) {
+    const parsed = parseInt(val, 10);
+    if (!isNaN(parsed) && parsed > 0) {
+      this._value = Math.min(Math.max(parsed, 1), this._max);
+    } else {
+      this._value = 0;
+    }
+    this._hoverValue = 0;
+    this._updateFormValue();
+    this._updateValidity();
+    this._updateDisplay();
+  }
+
+  get defaultValue() {
+    return this._defaultValue;
+  }
+
+  set defaultValue(val) {
+    this._defaultValue = val ? String(val) : '';
+  }
+
+  get name() {
+    return this.getAttribute('name') || '';
+  }
+
+  set name(val) {
+    if (val) this.setAttribute('name', val);
+    else this.removeAttribute('name');
+  }
+
+  get type() {
+    return 'star-rating';
+  }
+
+  get form() {
+    return this._internals.form;
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(val) {
+    if (val) this.setAttribute('disabled', '');
+    else this.removeAttribute('disabled');
+  }
+
+  get required() {
+    return this.hasAttribute('required');
+  }
+
+  set required(val) {
+    if (val) this.setAttribute('required', '');
+    else this.removeAttribute('required');
+  }
+
+  get max() {
+    return this._max;
+  }
+
+  set max(val) {
+    const m = parseInt(val, 10);
+    this._max = (!isNaN(m) && m > 0) ? m : 5;
+    this._render();
+  }
+
+  get validity() {
+    return this._internals.validity;
+  }
+
+  get validationMessage() {
+    return this._internals.validationMessage;
+  }
+
+  get willValidate() {
+    return this._internals.willValidate;
+  }
+
+  checkValidity() {
+    return this._internals.checkValidity();
+  }
+
+  reportValidity() {
+    return this._internals.reportValidity();
+  }
+
+  setCustomValidity(message) {
+    if (message) {
+      this._internals.setValidity({ customError: true }, message, this._getAnchor());
+    } else {
+      this._updateValidity();
+    }
+  }
+
+  // --- Internal Helpers ---
+
+  _getAnchor() {
+    return this.shadowRoot?.querySelector('.star-btn') || this;
+  }
+
+  _updateFormValue() {
+    const strVal = this._value > 0 ? String(this._value) : '';
+    // Set form value for submission and state restoration
+    this._internals.setFormValue(strVal || null, strVal || null);
+  }
+
+  _updateValidity() {
+    if (this._required && (!this._value || this._value <= 0)) {
+      this._internals.setValidity(
+        { valueMissing: true },
+        'Please select a star rating.',
+        this._getAnchor()
+      );
+    } else {
+      this._internals.setValidity({});
+    }
+  }
+
+  _getRatingLabel(val) {
+    switch (val) {
+      case 1: return '1 star - Poor';
+      case 2: return '2 stars - Fair';
+      case 3: return '3 stars - Good';
+      case 4: return '4 stars - Very Good';
+      case 5: return '5 stars - Exceptional';
+      default: return val > 0 ? `${val} of ${this._max} stars` : 'Select a rating';
+    }
+  }
+
+  _selectStar(val) {
+    if (this._disabled) return;
+    this.value = val;
+    this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+  }
+
+  _handleKeyDown(e, index) {
+    if (this._disabled) return;
+
+    let targetIndex = null;
+    if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+      e.preventDefault();
+      targetIndex = this._value < this._max ? (this._value || 0) + 1 : 1;
+    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+      e.preventDefault();
+      targetIndex = this._value > 1 ? this._value - 1 : this._max;
+    } else if (e.key === 'Home') {
+      e.preventDefault();
+      targetIndex = 1;
+    } else if (e.key === 'End') {
+      e.preventDefault();
+      targetIndex = this._max;
+    } else if (e.key >= '1' && e.key <= String(this._max)) {
+      e.preventDefault();
+      targetIndex = parseInt(e.key, 10);
+    } else if (e.key === ' ' || e.key === 'Enter') {
+      e.preventDefault();
+      this._selectStar(index);
+      return;
+    }
+
+    if (targetIndex !== null) {
+      this._selectStar(targetIndex);
+      const targetBtn = this.shadowRoot?.querySelector(`.star-btn[data-value="${targetIndex}"]`);
+      if (targetBtn) targetBtn.focus();
+    }
+  }
+
+  _updateDisabledState() {
+    if (!this.shadowRoot) return;
+    const container = this.shadowRoot.querySelector('.rating-widget');
+    if (container) {
+      if (this._disabled) {
+        container.classList.add('disabled');
+        container.setAttribute('aria-disabled', 'true');
+      } else {
+        container.classList.remove('disabled');
+        container.removeAttribute('aria-disabled');
+      }
+    }
+    const buttons = this.shadowRoot.querySelectorAll('.star-btn');
+    buttons.forEach(btn => {
+      btn.disabled = this._disabled;
+      if (this._disabled) {
+        btn.setAttribute('tabindex', '-1');
+      }
+    });
+    if (!this._disabled) {
+      this._updateDisplay();
+    }
+  }
+
+  _updateDisplay() {
+    if (!this.shadowRoot) return;
+    const effectiveVal = this._hoverValue || this._value;
+    const buttons = this.shadowRoot.querySelectorAll('.star-btn');
+    
+    buttons.forEach((btn) => {
+      const starIndex = parseInt(btn.getAttribute('data-value'), 10);
+      const isFilled = starIndex <= effectiveVal;
+      const isSelected = starIndex === this._value;
+
+      btn.classList.toggle('filled', isFilled);
+      btn.classList.toggle('hovered', Boolean(this._hoverValue && starIndex <= this._hoverValue));
+      btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
+
+      // Roving tabindex: selected star is tabbable, or first star if none selected
+      if (!this._disabled) {
+        if (this._value > 0) {
+          btn.setAttribute('tabindex', isSelected ? '0' : '-1');
+        } else {
+          btn.setAttribute('tabindex', starIndex === 1 ? '0' : '-1');
+        }
+      }
+    });
+
+    const statusText = this.shadowRoot.querySelector('.rating-status-text');
+    if (statusText) {
+      statusText.textContent = this._getRatingLabel(effectiveVal);
+      statusText.classList.toggle('has-value', effectiveVal > 0);
+    }
+  }
+
+  _render() {
+    const starSvg = `
+      <svg class="star-icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
+        <path class="star-fill" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
+      </svg>
+    `;
+
+    let starsHtml = '';
+    for (let i = 1; i <= this._max; i++) {
+      const isSelected = i === this._value;
+      const tabIndex = (!this._disabled && ((this._value === 0 && i === 1) || isSelected)) ? '0' : '-1';
+      const disabledAttr = this._disabled ? 'disabled' : '';
+      starsHtml += `
+        <button
+          type="button"
+          role="radio"
+          class="star-btn ${i <= this._value ? 'filled' : ''}"
+          data-value="${i}"
+          aria-label="${i} of ${this._max} stars"
+          aria-checked="${isSelected ? 'true' : 'false'}"
+          tabindex="${tabIndex}"
+          ${disabledAttr}
+        >
+          ${starSvg}
+        </button>
+      `;
+    }
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: inline-block;
+          font-family: inherit;
+          user-select: none;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        .rating-widget {
+          display: inline-flex;
+          flex-direction: column;
+          gap: 6px;
+        }
+
+        .rating-widget.disabled {
+          opacity: 0.55;
+          cursor: not-allowed;
+          pointer-events: none;
+        }
+
+        .stars-container {
+          display: inline-flex;
+          align-items: center;
+          gap: 6px;
+        }
+
+        .star-btn {
+          background: transparent;
+          border: 1px solid transparent;
+          border-radius: 6px;
+          padding: 4px;
+          margin: 0;
+          cursor: pointer;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          color: #d7ccc8;
+          transition: transform 0.15s ease, color 0.15s ease;
+          line-height: 0;
+        }
+
+        .star-btn:focus-visible {
+          outline: 2px solid #ffab40;
+          outline-offset: 2px;
+          background-color: rgba(255, 171, 64, 0.12);
+        }
+
+        .star-btn:not(:disabled):hover {
+          transform: scale(1.18);
+        }
+
+        .star-btn:not(:disabled):active {
+          transform: scale(0.95);
+        }
+
+        .star-icon {
+          width: 30px;
+          height: 30px;
+          display: block;
+          stroke: #8d6e63;
+          stroke-width: 1.2;
