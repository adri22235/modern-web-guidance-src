+
+        .star-btn.filled .star-icon,
+        .star-btn.hovered .star-icon {
+          fill: #ffab40;
+          stroke: #e65100;
+          filter: drop-shadow(0 1px 3px rgba(255, 171, 64, 0.4));
+        }
+
+        .star-btn.hovered:not(.filled) .star-icon {
+          fill: #ffd54f;
+          stroke: #ffab40;
+        }
+
+        .rating-status-text {
+          font-size: 0.88rem;
+          color: #5d4037;
+          font-weight: 500;
+          min-height: 1.3em;
+          transition: color 0.2s ease;
+        }
+
+        .rating-status-text.has-value {
+          color: #3e2723;
+          font-weight: 600;
+        }
+      </style>
+      <div class="rating-widget ${this._disabled ? 'disabled' : ''}" ${this._disabled ? 'aria-disabled="true"' : ''}>
+        <div class="stars-container" role="radiogroup" aria-label="Coffee star rating">
+          ${starsHtml}
+        </div>
+        <div class="rating-status-text ${this._value > 0 ? 'has-value' : ''}" aria-live="polite">
+          ${this._getRatingLabel(this._value)}
+        </div>
+      </div>
+    `;
+
+    // Attach event listeners
+    const container = this.shadowRoot.querySelector('.stars-container');
+    const buttons = this.shadowRoot.querySelectorAll('.star-btn');
+
+    buttons.forEach(btn => {
+      const val = parseInt(btn.getAttribute('data-value'), 10);
+
+      btn.addEventListener('pointerenter', () => {
+        if (this._disabled) return;
+        this._hoverValue = val;
+        this._updateDisplay();
+      });
+
+      btn.addEventListener('click', (e) => {
+        e.preventDefault();
+        this._selectStar(val);
+      });
+
+      btn.addEventListener('keydown', (e) => {
+        this._handleKeyDown(e, val);
+      });
+    });
+
+    container.addEventListener('pointerleave', () => {
+      if (this._disabled) return;
+      this._hoverValue = 0;
+      this._updateDisplay();
+    });
+  }
+}
+
+if (!customElements.get('star-rating')) {
+  customElements.define('star-rating', StarRating);
+}
