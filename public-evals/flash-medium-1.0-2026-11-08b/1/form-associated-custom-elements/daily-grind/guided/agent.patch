+/**
+ * StarRating - Form-Associated Custom Element (FACE)
+ * Represents a custom star-rating component that participates natively in HTML form submission,
+ * constraint validation, form reset, disabled fieldset state, and browser state restoration.
+ */
+class StarRating extends HTMLElement {
+  // Opt in to Form-Associated Custom Element lifecycle and ElementInternals form APIs
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled', 'max', 'name'];
+
+  #internals;
+  #value = '';
+  #defaultValue = '';
+  #disabled = false;
+  #max = 5;
+  #starButtons = [];
+  #wrapper = null;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+  }
+
+  connectedCallback() {
+    // Preserve initial default value for formResetCallback
+    if (this.#defaultValue === '' && this.hasAttribute('value')) {
+      this.#defaultValue = this.getAttribute('value') || '';
+      if (!this.#value) {
+        this.#value = this.#defaultValue;
+      }
+    }
+
+    if (this.hasAttribute('max')) {
+      const parsedMax = parseInt(this.getAttribute('max'), 10);
+      if (!isNaN(parsedMax) && parsedMax > 0) {
+        this.#max = parsedMax;
+      }
+    }
+
+    this.#render();
+    this.#updateDisabled();
+    this.#internals.setFormValue(this.#value ? this.#value : null, this.#value ? this.#value : null);
+    this.#validate();
+  }
+
+  // --- Form Association Standard Properties ---
+  get form() {
+    return this.#internals.form;
+  }
+
+  get name() {
+    return this.getAttribute('name') || '';
+  }
+
+  set name(val) {
+    if (val != null) {
+      this.setAttribute('name', val);
+    } else {
+      this.removeAttribute('name');
+    }
+  }
+
+  get type() {
+    return 'star-rating';
+  }
+
+  get value() {
+    return this.#value;
+  }
+
+  set value(val) {
+    const nextVal = val != null && val !== '' ? String(val) : '';
+    if (this.#value === nextVal) return;
+    this.#value = nextVal;
+    // Set form value with restoration state token
+    this.#internals.setFormValue(this.#value ? this.#value : null, this.#value ? this.#value : null);
+    this.#updateVisuals();
+    this.#validate();
+  }
+
+  get required() {
+    return this.hasAttribute('required');
+  }
+
+  set required(val) {
+    this.toggleAttribute('required', Boolean(val));
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(val) {
+    this.toggleAttribute('disabled', Boolean(val));
+  }
+
+  get max() {
+    return this.#max;
+  }
+
+  set max(val) {
+    const num = parseInt(val, 10);
+    if (!isNaN(num) && num > 0) {
+      this.setAttribute('max', String(num));
+    }
+  }
+
+  // --- Constraint Validation Standard Properties & Methods ---
+  get validity() {
+    return this.#internals.validity;
+  }
+
+  get validationMessage() {
+    return this.#internals.validationMessage;
+  }
+
+  get willValidate() {
+    return this.#internals.willValidate;
+  }
+
+  checkValidity() {
+    return this.#internals.checkValidity();
+  }
+
+  reportValidity() {
+    return this.#internals.reportValidity();
+  }
+
+  // --- FACE Lifecycle Callbacks ---
+
+  /**
+   * Called when the owning form is reset.
+   * Restores the component to its default value and updates validity.
+   */
+  formResetCallback() {
+    this.value = this.#defaultValue;
+  }
+
+  /**
+   * Called when the element or an ancestor <fieldset disabled> is toggled.
+   * Disables internal controls without setting `disabled` on the host, preventing
+   * ancestor <fieldset disabled> toggle lockups.
+   */
+  formDisabledCallback(disabled) {
+    this.#disabled = Boolean(disabled);
+    this.#updateDisabled();
+    this.#validate();
+  }
+
+  /**
+   * Called when the browser restores form state (history traversal or session restore).
+   */
+  formStateRestoreCallback(state, mode) {
+    this.value = state != null ? String(state) : '';
+  }
+
+  // --- Attribute Changes ---
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'value') {
+      this.value = newVal ?? '';
+    } else if (name === 'required') {
+      this.#validate();
+    } else if (name === 'disabled') {
+      this.#updateDisabled();
+      this.#validate();
+    } else if (name === 'max') {
+      const parsed = parseInt(newVal, 10);
+      if (!isNaN(parsed) && parsed > 0) {
+        this.#max = parsed;
+        this.#render();
+        this.#updateVisuals();
+        this.#updateDisabled();
+        this.#validate();
+      }
+    }
+  }
+
+  // --- Internal Logic & Validation ---
+  #validate() {
+    if (!this.isConnected) return;
+    const isRequired = this.hasAttribute('required');
+    const isDisabled = this.#disabled || this.hasAttribute('disabled');
+    const isEmpty = !this.#value || this.#value === '0';
+
+    if (isRequired && isEmpty && !isDisabled) {
+      const anchor = this.shadowRoot.querySelector('button[tabindex="0"]') || this.shadowRoot.querySelector('button');
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please select a star rating.',
+        anchor
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #updateDisabled() {
+    const isDisabled = this.#disabled || this.hasAttribute('disabled');
+    if (this.#wrapper) {
+      this.#wrapper.setAttribute('aria-disabled', String(isDisabled));
+    }
+    for (const btn of this.#starButtons) {
+      btn.disabled = isDisabled;
+    }
+  }
+
+  #updateVisuals(hoverIndex = null) {
+    const currentNum = parseInt(this.#value, 10) || 0;
+    const activeThreshold = hoverIndex !== null ? hoverIndex : currentNum;
+
+    this.#starButtons.forEach((btn, idx) => {
+      const starNum = idx + 1;
+      const isActive = starNum <= activeThreshold;
+      btn.classList.toggle('active', isActive);
+      btn.setAttribute('aria-checked', String(this.#value === String(starNum)));
+
+      // Roving tabindex: active star or 1st star gets 0, others get -1
+      if (currentNum > 0) {
+        btn.setAttribute('tabindex', starNum === currentNum ? '0' : '-1');
+      } else {
+        btn.setAttribute('tabindex', starNum === 1 ? '0' : '-1');
+      }
+    });
+  }
+
+  #selectRating(num) {
+    if (this.#disabled || this.hasAttribute('disabled')) return;
+    this.value = String(num);
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: inline-flex;
+          align-items: center;
+          vertical-align: middle;
+          font-family: inherit;
+        }
+        :host(:disabled),
+        :host([disabled]) {
+          opacity: 0.5;
+          cursor: not-allowed;
+          pointer-events: none;
+        }
+        .stars-wrapper {
+          display: inline-flex;
+          align-items: center;
+          gap: 4px;
+        }
+        .star-btn {
+          background: none;
+          border: none;
+          padding: 4px;
+          margin: 0;
+          cursor: pointer;
+          color: #d7ccc8;
+          border-radius: 4px;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          line-height: 1;
+          transition: color 0.15s ease, transform 0.1s ease;
+        }
+        .star-btn:not(:disabled):hover {
+          transform: scale(1.18);
+        }
+        .star-btn:focus-visible {
+          outline: 2px solid #ffab40;
+          outline-offset: 2px;
+        }
+        .star-btn.active {
+          color: #ffab40;
+        }
+        .star-btn:disabled {
+          cursor: not-allowed;
+          color: #d7ccc8;
+        }
+        .star-icon {
+          width: 32px;
+          height: 32px;
+          fill: currentColor;
+          pointer-events: none;
+        }
+      </style>
+      <div class="stars-wrapper" role="radiogroup" aria-label="Star rating"></div>
+    `;
+
+    this.#wrapper = this.shadowRoot.querySelector('.stars-wrapper');
+    this.#starButtons = [];
+
+    for (let i = 1; i <= this.#max; i++) {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.className = 'star-btn';
+      btn.setAttribute('role', 'radio');
+      btn.setAttribute('data-value', String(i));
+      btn.setAttribute('aria-label', `${i} star${i > 1 ? 's' : ''}`);
+      btn.setAttribute('tabindex', i === 1 ? '0' : '-1');
+      btn.setAttribute('aria-checked', 'false');
+
+      btn.innerHTML = `
+        <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
+        </svg>
+      `;
+
+      btn.addEventListener('mouseenter', () => {
+        if (!this.#disabled && !this.hasAttribute('disabled')) {
+          this.#updateVisuals(i);
+        }
+      });
+
+      btn.addEventListener('click', () => {
+        this.#selectRating(i);
+      });
+
+      btn.addEventListener('keydown', (e) => {
+        if (this.#disabled || this.hasAttribute('disabled')) return;
+        let targetIndex = null;
+        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          targetIndex = i < this.#max ? i : 0;
+        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          targetIndex = i > 1 ? i - 2 : this.#max - 1;
+        } else if (e.key === 'Home') {
+          e.preventDefault();
+          targetIndex = 0;
+        } else if (e.key === 'End') {
+          e.preventDefault();
+          targetIndex = this.#max - 1;
+        }
+
+        if (targetIndex !== null && this.#starButtons[targetIndex]) {
+          const nextBtn = this.#starButtons[targetIndex];
+          nextBtn.focus();
+          this.#selectRating(targetIndex + 1);
+        }
+      });
+
+      this.#starButtons.push(btn);
+      this.#wrapper.appendChild(btn);
+    }
+
+    this.#wrapper.addEventListener('mouseleave', () => {
+      this.#updateVisuals();
+    });
+
+    this.#updateVisuals();
+  }
+}
+
+if (typeof customElements !== 'undefined' && !customElements.get('star-rating')) {
+  customElements.define('star-rating', StarRating);
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { StarRating };
+}
