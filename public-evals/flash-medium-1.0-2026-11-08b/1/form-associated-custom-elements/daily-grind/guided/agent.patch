+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const feedbackForm = document.getElementById('coffee-feedback-form');
+      const starRating = document.getElementById('coffee-rating');
+      const ratingDisplay = document.getElementById('rating-value-display');
+      const ratingFieldset = document.getElementById('rating-fieldset');
+      const disableCheckbox = document.getElementById('disable-rating-fieldset');
+      const formMsg = document.getElementById('form-feedback-message');
+
+      const ratingDescriptions = {
+        '1': '1 star - Needs improvement',
+        '2': '2 stars - Fair',
+        '3': '3 stars - Good cup',
+        '4': '4 stars - Very good roast',
+        '5': '5 stars - Exceptional brew!'
+      };
+
+      const updateRatingDisplay = () => {
+        const val = starRating.value;
+        ratingDisplay.textContent = ratingDescriptions[val] || '';
+      };
+
+      starRating.addEventListener('change', updateRatingDisplay);
+      starRating.addEventListener('input', updateRatingDisplay);
+
+      // Toggle fieldset disabled state to demonstrate formDisabledCallback
+      disableCheckbox.addEventListener('change', () => {
+        ratingFieldset.disabled = disableCheckbox.checked;
+      });
+
+      // Handle form reset
+      feedbackForm.addEventListener('reset', () => {
+        setTimeout(() => {
+          updateRatingDisplay();
+          formMsg.textContent = '';
+          formMsg.className = 'form-message';
+          disableCheckbox.checked = false;
+          ratingFieldset.disabled = false;
+        }, 0);
+      });
+
+      // Handle form submission
+      feedbackForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const formData = new FormData(feedbackForm);
+        const coffee = formData.get('coffee');
+        const rating = formData.get('rating');
+        const name = formData.get('name') || 'Friend';
+
+        formMsg.className = 'form-message success';
+        formMsg.innerHTML = `<strong>Thank you, ${name}!</strong> Your feedback for <em>${coffee || 'our coffee'}</em> has been submitted${rating ? ` with a rating of <strong>${rating} / 5 stars</strong>` : ''}.`;
+      });
+    });
+  </script>
+
