+  <script>
+    function fitPosterHeading() {
+      const lockup = document.querySelector('.poster-lockup');
+      if (!lockup) return;
+      const lines = lockup.querySelectorAll('.poster-line');
+      if (!lines.length) return;
+
+      const targetWidth = lockup.clientWidth || lockup.getBoundingClientRect().width;
+      if (!targetWidth) return;
+
+      lines.forEach(line => {
+        let low = 8;
+        let high = 400;
+        let best = low;
+
+        for (let i = 0; i < 22; i++) {
+          const mid = (low + high) / 2;
+          line.style.fontSize = mid + 'px';
+          const range = document.createRange();
+          range.selectNodeContents(line);
+          const rect = range.getBoundingClientRect();
+          if (rect.width <= targetWidth) {
+            best = mid;
+            low = mid;
+          } else {
+            high = mid;
+          }
+        }
+        line.style.fontSize = best + 'px';
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', fitPosterHeading);
+    } else {
+      fitPosterHeading();
+    }
+    window.addEventListener('load', fitPosterHeading);
+    window.addEventListener('resize', fitPosterHeading);
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(fitPosterHeading);
+    }
+  </script>
