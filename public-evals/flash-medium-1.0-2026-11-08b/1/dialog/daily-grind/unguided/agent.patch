+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          tagline: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          description: 'Handcrafted espresso combined with silky steamed organic oat milk and infused with 100% pure Vermont maple syrup. Lightly dusted with cinnamon.',
+          price: '$5.50',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          defaults: {
+            drink: 'maple-oat-latte',
+            size: 'Medium (16oz)',
+            milk: 'oat',
+            sweetness: 'regular',
+            temperature: 'hot',
+            shots: '0',
+            quantity: '1',
+            instructions: ''
+          }
+        },
+        'dark-roast-espresso': {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          tagline: 'Bold, smokey, and perfect for a morning boost.',
+          description: 'A rich, concentrated double shot pulled from our artisanal dark roast blend of Colombian and Sumatran beans. Features notes of dark chocolate and toasted walnut with thick golden crema.',
+          price: '$3.75',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          defaults: {
+            drink: 'dark-roast-espresso',
+            size: 'Medium (16oz)',
+            milk: 'none',
+            sweetness: 'unsweetened',
+            temperature: 'hot',
+            shots: '0',
+            quantity: '1',
+            instructions: ''
+          }
+        },
+        'cold-brew': {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          tagline: 'Steeped for 18 hours for maximum smoothness.',
+          description: 'Coarsely ground single-origin Arabica beans steeped in cold triple-filtered water for 18 hours. Ultra-smooth, low in acidity, naturally sweet, and served over ice.',
+          price: '$4.50',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=800&q=80',
+          defaults: {
+            drink: 'cold-brew',
+            size: 'Medium (16oz)',
+            milk: 'none',
+            sweetness: 'unsweetened',
+            temperature: 'iced',
+            shots: '0',
+            quantity: '1',
+            instructions: ''
+          }
+        }
+      };
+
+      const modal = document.getElementById('drink-order-modal');
+      const modalTitle = document.getElementById('modal-drink-title');
+      const modalDesc = document.getElementById('modal-drink-desc');
+      const modalPrice = document.getElementById('modal-drink-price');
+      const modalImg = document.getElementById('modal-drink-img');
+      const orderForm = document.getElementById('order-options-form');
+      const drinkSelect = document.getElementById('order-drink-select');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const discardBtn = document.getElementById('modal-discard-btn');
+      const submitBtn = document.getElementById('modal-submit-btn');
+      const discardWarning = document.getElementById('discard-warning');
+
+      let currentDrinkId = 'maple-oat-latte';
+      let initialFormState = '';
+      let hasChanged = false;
+
+      function getOrderFormState() {
+        if (!orderForm) return '';
+        const formData = new FormData(orderForm);
+        const data = {};
+        for (const [key, value] of formData.entries()) {
+          data[key] = value;
+        }
+        return JSON.stringify(data);
+      }
+
+      function updateDrinkDisplay(drinkId) {
+        const drink = DRINKS[drinkId] || DRINKS['maple-oat-latte'];
+        modalTitle.textContent = drink.name;
+        modalDesc.textContent = drink.description;
+        modalPrice.textContent = drink.price;
+        modalImg.src = drink.image;
+        modalImg.alt = drink.name;
+      }
+
+      function setFormValues(values) {
+        if (!values) return;
+        if (values.drink) document.getElementById('order-drink-select').value = values.drink;
+        if (values.size) document.getElementById('order-size-select').value = values.size;
+        if (values.milk) document.getElementById('order-milk-select').value = values.milk;
+        if (values.sweetness) document.getElementById('order-sweetness-select').value = values.sweetness;
+        if (values.temperature) document.getElementById('order-temperature-select').value = values.temperature;
+        if (values.shots) document.getElementById('order-shots-select').value = values.shots;
+        if (values.quantity) document.getElementById('order-quantity').value = values.quantity;
+        document.getElementById('order-instructions').value = values.instructions || '';
+      }
+
+      function openModal(drinkId) {
+        currentDrinkId = drinkId && DRINKS[drinkId] ? drinkId : 'maple-oat-latte';
+        updateDrinkDisplay(currentDrinkId);
+        setFormValues(DRINKS[currentDrinkId].defaults);
+
+        initialFormState = getOrderFormState();
+        hasChanged = false;
+
+        discardBtn.style.display = 'none';
+        discardWarning.style.display = 'none';
+
+        if (typeof modal.showModal === 'function') {
+          modal.showModal();
+        } else {
+          modal.setAttribute('open', '');
+        }
+      }
+
+      function closeModal() {
+        if (typeof modal.close === 'function') {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+        hasChanged = false;
+        discardBtn.style.display = 'none';
+        discardWarning.style.display = 'none';
+      }
+
+      function checkFormChanged() {
+        const currentState = getOrderFormState();
+        hasChanged = (currentState !== initialFormState);
+        if (hasChanged) {
+          discardBtn.style.display = 'inline-block';
+        } else {
+          discardBtn.style.display = 'none';
+          discardWarning.style.display = 'none';
+        }
+      }
+
+      function showDiscardPrompt() {
+        discardWarning.style.display = 'block';
+        discardBtn.style.display = 'inline-block';
+        discardBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+        discardBtn.focus();
+      }
+
+      function handleDismissAttempt(e) {
+        if (e) e.preventDefault();
+        if (hasChanged) {
+          showDiscardPrompt();
+        } else {
+          closeModal();
+        }
+      }
+
+      // Handle drink dropdown change
+      drinkSelect.addEventListener('change', function (e) {
+        const selectedId = e.target.value;
+        if (DRINKS[selectedId]) {
+          updateDrinkDisplay(selectedId);
+        }
+        checkFormChanged();
+      });
+
+      // Track order option changes
+      orderForm.addEventListener('input', checkFormChanged);
+      orderForm.addEventListener('change', checkFormChanged);
+
+      // Dismiss attempt handlers
+      closeBtn.addEventListener('click', handleDismissAttempt);
+      cancelBtn.addEventListener('click', handleDismissAttempt);
+
+      // Escape key handlers
+      modal.addEventListener('cancel', function (e) {
+        if (hasChanged) {
+          e.preventDefault();
+          showDiscardPrompt();
+        }
+      });
+
+      modal.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && hasChanged) {
+          e.preventDefault();
+          showDiscardPrompt();
+        }
+      });
+
+      // Backdrop click handler
+      modal.addEventListener('click', function (e) {
+        if (e.target === modal) {
+          if (hasChanged) {
+            showDiscardPrompt();
+          } else {
+            closeModal();
+          }
+        }
+      });
+
+      // Discard changes button - confirms discarding and dismisses dialog
+      discardBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        if (DRINKS[currentDrinkId]) {
+          setFormValues(DRINKS[currentDrinkId].defaults);
+          updateDrinkDisplay(currentDrinkId);
+        } else {
+          orderForm.reset();
+        }
+        hasChanged = false;
+        discardBtn.style.display = 'none';
+        discardWarning.style.display = 'none';
+        closeModal();
+      });
+
+      // Form submission / Add to Order
+      orderForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        hasChanged = false;
+        closeModal();
+      });
+
+      submitBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        hasChanged = false;
+        closeModal();
+      });
+
+      // Open modal from buttons
+      document.addEventListener('click', function (e) {
+        const heroBtn = e.target.closest('#hero-order-btn, .hero .btn');
+        if (heroBtn) {
+          e.preventDefault();
+          openModal('maple-oat-latte');
+          return;
+        }
+
+        const cardBtn = e.target.closest('.view-details-btn, .card .btn');
+        if (cardBtn) {
+          e.preventDefault();
+          const drink = cardBtn.getAttribute('data-drink');
+          if (drink) {
+            openModal(drink);
+            return;
+          }
+          const card = cardBtn.closest('.card');
+          const title = card ? (card.querySelector('h3')?.textContent || '').toLowerCase() : '';
+          if (title.includes('maple')) {
+            openModal('maple-oat-latte');
+          } else if (title.includes('espresso')) {
+            openModal('dark-roast-espresso');
+          } else if (title.includes('cold brew')) {
+            openModal('cold-brew');
+          } else {
+            openModal('maple-oat-latte');
+          }
+        }
+      });
+    })();
+  </script>
+
 </body>
 
