+        description: 'Bold, smokey, and perfect for a morning boost.',
+        notes: 'Double shot of slow-roasted Sumatra and Colombian beans with golden crema.',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+        defaults: {
+          drink: 'dark-roast-espresso',
+          size: 'medium',
+          milk: 'none',
+          sweetness: 'none',
+          ice: 'standard',
+          quantity: '1',
+          notes: ''
+        }
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
