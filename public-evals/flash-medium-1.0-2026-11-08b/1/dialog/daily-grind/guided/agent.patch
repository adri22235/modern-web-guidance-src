+        description: 'Steeped for 18 hours for maximum smoothness.',
+        notes: 'Steeped cold for 18 hours for exceptionally smooth, low-acidity coffee.',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+        defaults: {
+          drink: 'cold-brew',
+          size: 'medium',
+          milk: 'none',
+          sweetness: 'regular',
+          ice: 'standard',
+          quantity: '1',
+          notes: ''
+        }
+      }
+    };
+
+    const modal = document.getElementById('order-dialog');
+    const orderForm = document.getElementById('order-form');
+    const modalDrinkTitle = document.getElementById('modal-drink-title');
+    const modalDrinkImg = document.getElementById('modal-drink-img');
+    const modalDrinkPrice = document.getElementById('modal-drink-price');
+    const modalDrinkDesc = document.getElementById('modal-drink-desc');
+    const modalDrinkNotes = document.getElementById('modal-drink-notes');
+
+    const drinkSelect = document.getElementById('order-drink');
+    const sizeSelect = document.getElementById('order-size');
+    const milkSelect = document.getElementById('order-milk');
+    const sweetnessSelect = document.getElementById('order-sweetness');
+    const iceSelect = document.getElementById('order-ice');
+    const quantityInput = document.getElementById('order-quantity');
+    const notesInput = document.getElementById('order-notes');
+
+    const unsavedBanner = document.getElementById('unsaved-changes-banner');
+    const discardBtn = document.getElementById('discard-changes-btn');
+    const cancelBtn = document.getElementById('cancel-order-btn');
+    const closeBtn = document.getElementById('modal-close-btn');
+
+    let initialFormState = null;
+
+    function getFormState() {
+      return {
+        drink: drinkSelect.value,
+        size: sizeSelect.value,
+        milk: milkSelect.value,
+        sweetness: sweetnessSelect.value,
+        ice: iceSelect.value,
+        quantity: quantityInput.value,
+        notes: notesInput.value.trim()
+      };
+    }
+
+    function setFormState(state) {
+      if (!state) return;
+      drinkSelect.value = state.drink || 'maple-oat-latte';
+      sizeSelect.value = state.size || 'medium';
+      milkSelect.value = state.milk || 'oat';
+      sweetnessSelect.value = state.sweetness || 'regular';
+      iceSelect.value = state.ice || 'standard';
+      quantityInput.value = state.quantity || '1';
+      notesInput.value = state.notes || '';
+    }
+
+    function renderDrinkDetails(drinkKey) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      modalDrinkTitle.textContent = drink.name;
+      modalDrinkPrice.textContent = drink.price;
+      modalDrinkDesc.textContent = drink.description;
+      modalDrinkNotes.textContent = drink.notes;
+      modalDrinkImg.src = drink.image;
+      modalDrinkImg.alt = drink.name;
+    }
+
+    function isFormDirty() {
+      if (!initialFormState) return false;
+      const current = getFormState();
+      return Object.keys(initialFormState).some(key => current[key] !== initialFormState[key]);
+    }
+
+    function updateDirtyState() {
+      const dirty = isFormDirty();
+      if (dirty) {
+        modal.setAttribute('closedby', 'none');
+        unsavedBanner.classList.add('visible');
+      } else {
+        modal.setAttribute('closedby', 'any');
+        unsavedBanner.classList.remove('visible');
+      }
+      return dirty;
+    }
+
+    function promptDiscard() {
+      updateDirtyState();
+      unsavedBanner.classList.add('visible');
+      unsavedBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      discardBtn.focus();
+    }
+
+    function openModalForDrink(drinkKey) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      renderDrinkDetails(drinkKey);
+      setFormState(drink.defaults);
+      initialFormState = getFormState();
+      unsavedBanner.classList.remove('visible');
+      modal.setAttribute('closedby', 'any');
+      modal.showModal();
+    }
+
+    function confirmDiscardAndClose() {
+      if (initialFormState) {
+        setFormState(initialFormState);
+        renderDrinkDetails(initialFormState.drink);
+      }
+      unsavedBanner.classList.remove('visible');
+      modal.setAttribute('closedby', 'any');
+      initialFormState = null;
+      nativeClose.call(modal, 'discarded');
+    }
+
+    // Intercept native modal.close to prevent dismissal when dirty
+    const nativeClose = modal.close;
+    modal.close = function (returnValue) {
+      if (isFormDirty() && returnValue !== 'discarded' && returnValue !== 'ordered') {
+        promptDiscard();
+        return;
+      }
+      return nativeClose.call(this, returnValue);
+    };
+
+    // When coffee selection is changed in form, update the drink details view
+    drinkSelect.addEventListener('change', () => {
+      renderDrinkDetails(drinkSelect.value);
+    });
+
+    // Monitor changes on the form
+    orderForm.addEventListener('input', updateDirtyState);
+    orderForm.addEventListener('change', updateDirtyState);
+
+    // Prevent dismiss on Escape when dirty
+    modal.addEventListener('cancel', (e) => {
+      if (isFormDirty()) {
+        e.preventDefault();
+        promptDiscard();
+      }
+    });
+
+    // Backdrop click / light-dismiss
+    modal.addEventListener('click', (e) => {
+      if (e.target === modal) {
+        const rect = modal.getBoundingClientRect();
+        const isInDialog = (
+          rect.top <= e.clientY &&
+          e.clientY <= rect.top + rect.height &&
+          rect.left <= e.clientX &&
+          e.clientX <= rect.left + rect.width
+        );
+        if (!isInDialog) {
+          if (isFormDirty()) {
+            e.stopPropagation();
+            promptDiscard();
+          } else {
+            modal.close();
+          }
+        }
+      }
+    });
+
+    // Close button & Cancel button
+    closeBtn.addEventListener('click', (e) => {
+      e.preventDefault();
+      if (isFormDirty()) {
+        promptDiscard();
+      } else {
+        modal.close();
+      }
+    });
+
+    cancelBtn.addEventListener('click', (e) => {
+      e.preventDefault();
+      if (isFormDirty()) {
+        promptDiscard();
+      } else {
+        modal.close();
+      }
+    });
+
+    // Discard changes button confirms discarding and dismisses the dialog
+    discardBtn.addEventListener('click', (e) => {
+      e.preventDefault();
+      confirmDiscardAndClose();
+    });
+
+    // Form submit
+    orderForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      initialFormState = null;
+      unsavedBanner.classList.remove('visible');
+      modal.setAttribute('closedby', 'any');
+      nativeClose.call(modal, 'ordered');
+    });
+
+    // Wire up buttons: Hero "Order Now" and Card "View Details"
+    document.querySelectorAll('.view-details-btn, .order-hero-btn, [data-drink]').forEach((btn) => {
+      btn.addEventListener('click', (e) => {
+        e.preventDefault();
+        const drinkKey = btn.dataset.drink || 'maple-oat-latte';
+        openModalForDrink(drinkKey);
+      });
+    });
+
+    // Delegated click listener as fallback
+    document.addEventListener('click', (e) => {
+      const btn = e.target.closest('.view-details-btn, .order-hero-btn, [data-drink]');
+      if (btn && !modal.open) {
+        e.preventDefault();
+        const drinkKey = btn.dataset.drink || 'maple-oat-latte';
+        openModalForDrink(drinkKey);
+      }
+    });
