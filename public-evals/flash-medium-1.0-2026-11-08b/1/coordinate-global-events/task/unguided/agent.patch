+                  <div class="time-primary">${formattedTime}</div>
+                  <div class="date-secondary">${targetDateFormatted}</div>
+                </div>
+
+                <div class="tz-meta">
+                  <span class="badge-meta">${tzAbbr}</span>
+                  <span class="badge-meta">${targetOffsetStr}</span>
+                  <span class="badge-dst ${targetDst.badgeClass}">${targetDst.icon} ${targetDst.label}</span>
+                </div>
+              </div>
+
+              <div class="cupping-vibe">
+                <div class="vibe-header">
+                  <span>${vibe.icon}</span> ${vibe.title}
+                </div>
+                <div>${vibe.desc}</div>
+                <div class="bean-notes">&ldquo;${target.notes}&rdquo;</div>
+              </div>
+            </div>
+          `;
+        }).join('');
+
+        grid.innerHTML = cardsHtml;
+      }
+
+      // Time Display Formatter
+      function formatTimeDisplay(hour, minute, is24h) {
+        const m = String(minute).padStart(2, "0");
+        if (is24h) {
+          const h = String(hour).padStart(2, "0");
+          return `${h}:${m}`;
+        }
+        const period = hour >= 12 ? "PM" : "AM";
+        const h12 = hour % 12 === 0 ? 12 : hour % 12;
+        return `${h12}:${m} ${period}`;
+      }
+
+      // Event Listeners for inputs
+      dateInput.addEventListener('input', updateCoordinator);
+      dateInput.addEventListener('change', updateCoordinator);
+      timeInput.addEventListener('input', updateCoordinator);
+      timeInput.addEventListener('change', updateCoordinator);
+      hostTzSelect.addEventListener('change', updateCoordinator);
+
+      // Quick-fix button listener
+      errorQuickFixBtn.addEventListener('click', applySuggestedFix);
+
+      // 12h / 24h Toggle Listeners
+      btn12h.addEventListener('click', function () {
+        use24Hour = false;
+        btn12h.classList.add('active');
+        btn24h.classList.remove('active');
+        updateCoordinator();
+      });
+
+      btn24h.addEventListener('click', function () {
+        use24Hour = true;
+        btn24h.classList.add('active');
+        btn12h.classList.remove('active');
+        updateCoordinator();
+      });
+
+      // Preset 1: New York DST Spring Forward Gap (2026-03-08 02:30 AM)
+      presetNyDst.addEventListener('click', function () {
+        dateInput.value = "2026-03-08";
+        timeInput.value = "02:30";
+        hostTzSelect.value = "America/New_York";
+        updateCoordinator();
+      });
+
+      // Preset 2: London DST Spring Forward Gap (2026-03-29 01:30 AM)
+      presetLondonDst.addEventListener('click', function () {
+        dateInput.value = "2026-03-29";
+        timeInput.value = "01:30";
+        hostTzSelect.value = "Europe/London";
+        updateCoordinator();
+      });
+
+      // Preset 3: Sydney DST Spring Forward Gap (2026-10-04 02:30 AM)
+      presetSydneyDst.addEventListener('click', function () {
+        dateInput.value = "2026-10-04";
+        timeInput.value = "02:30";
+        hostTzSelect.value = "Australia/Sydney";
+        updateCoordinator();
+      });
+
+      // Preset 4: Valid Prime Global Cupping Time
+      presetPrimeCupping.addEventListener('click', function () {
+        const tomorrow = new Date();
+        tomorrow.setDate(tomorrow.getDate() + 1);
+        const y = tomorrow.getFullYear();
+        const m = String(tomorrow.getMonth() + 1).padStart(2, "0");
+        const d = String(tomorrow.getDate()).padStart(2, "0");
+
+        dateInput.value = `${y}-${m}-${d}`;
+        timeInput.value = "14:00";
+        hostTzSelect.value = "America/New_York";
+        updateCoordinator();
+      });
+
+      // Initialization on Page Load
+      function init() {
+        // Set sensible default date and time
+        const now = new Date();
+        // Set default to next day 14:00
+        const defaultDate = new Date(now.getTime() + 86400000);
+        const y = defaultDate.getFullYear();
+        const m = String(defaultDate.getMonth() + 1).padStart(2, "0");
+        const d = String(defaultDate.getDate()).padStart(2, "0");
+
+        dateInput.value = `${y}-${m}-${d}`;
+        timeInput.value = "14:00";
+
+        // Try to match user local timezone if in select, otherwise default to America/New_York
+        try {
+          const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
+          const hasOption = Array.from(hostTzSelect.options).some(opt => opt.value === userTz);
+          if (hasOption) {
+            hostTzSelect.value = userTz;
+          } else {
+            hostTzSelect.value = "America/New_York";
+          }
+        } catch (e) {
+          hostTzSelect.value = "America/New_York";
+        }
+
+        updateCoordinator();
+      }
+
+      init();
+    })();
+  </script>
 </body>
 
 </html>
