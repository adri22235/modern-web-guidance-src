+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const dropdown = document.getElementById('roast-dropdown');
+      if (!dropdown) return;
+
+      const trigger = dropdown.querySelector('.dropdown-trigger');
+      const triggerContent = trigger.querySelector('.trigger-content');
+      const menu = dropdown.querySelector('.dropdown-menu');
+      const options = dropdown.querySelectorAll('.dropdown-option');
+      const hiddenInput = document.getElementById('selected-roast-input');
+      const orderBtn = document.querySelector('.hero .btn');
+
+      function toggleDropdown(forceState) {
+        const isOpen = forceState !== undefined ? forceState : !dropdown.classList.contains('open');
+        dropdown.classList.toggle('open', isOpen);
+        trigger.setAttribute('aria-expanded', String(isOpen));
+      }
+
+      trigger.addEventListener('click', (e) => {
+        e.stopPropagation();
+        toggleDropdown();
+      });
+
+      function selectOption(option) {
+        const value = option.getAttribute('data-value');
+        const title = option.querySelector('.option-title').textContent.trim();
+        const iconSvg = option.querySelector('.option-icon').innerHTML;
+
+        options.forEach(opt => {
+          opt.classList.remove('selected');
+          opt.setAttribute('aria-selected', 'false');
+        });
+        option.classList.add('selected');
+        option.setAttribute('aria-selected', 'true');
+
+        if (hiddenInput) {
+          hiddenInput.value = value;
+          hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+
+        if (orderBtn) {
+          orderBtn.href = `/order-online?roast=${encodeURIComponent(value)}`;
+        }
+
+        triggerContent.innerHTML = `
+          <span class="trigger-icon">${iconSvg}</span>
+          <span class="trigger-text">${title}</span>
+        `;
+
+        toggleDropdown(false);
+        trigger.focus();
+      }
+
+      options.forEach(option => {
+        option.addEventListener('click', (e) => {
+          e.stopPropagation();
+          selectOption(option);
+        });
+
+        option.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            selectOption(option);
+          }
+        });
+      });
+
+      // Close when clicking outside
+      document.addEventListener('click', (e) => {
+        if (!dropdown.contains(e.target)) {
+          toggleDropdown(false);
+        }
+      });
+
+      // Keyboard handling
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && dropdown.classList.contains('open')) {
+          toggleDropdown(false);
+          trigger.focus();
+        }
+      });
+
+      trigger.addEventListener('keydown', (e) => {
+        if ((e.key === 'ArrowDown' || e.key === 'Down') && !dropdown.classList.contains('open')) {
+          e.preventDefault();
+          toggleDropdown(true);
+          options[0]?.focus();
+        }
+      });
+
+      menu.addEventListener('keydown', (e) => {
+        const focused = document.activeElement;
+        const index = Array.from(options).indexOf(focused);
+
+        if (e.key === 'ArrowDown' || e.key === 'Down') {
+          e.preventDefault();
+          const next = options[index + 1] || options[0];
+          next?.focus();
+        } else if (e.key === 'ArrowUp' || e.key === 'Up') {
+          e.preventDefault();
+          const prev = options[index - 1] || options[options.length - 1];
+          prev?.focus();
+        }
+      });
+    });
+  </script>
+
