+    }
+
+    select.roast-select option:last-child {
+      margin-bottom: 0;
+    }
+
+    select.roast-select option:hover {
+      background-color: rgba(255, 171, 64, 0.2);
+    }
+
+    select.roast-select option::checkmark {
