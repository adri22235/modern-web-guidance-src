+    #accordion-toggle,
+    .accordion-toggle {
+      inline-size: 100%;
+      background: white;
+      color: var(--primary);
+      border: none;
+      padding-block: 16px;
+      padding-inline: 20px;
+      font-size: 1.1rem;
+      font-weight: 600;
+      text-align: start;
