+    /* Accordion / FAQ Section */
+    /* Note: Directly transitioning between different intrinsic keyword sizes isn't supported in CSS. Transitions must be between an intrinsic keyword/calc-size and a definite length-percentage or identical keyword basis. */
+    .accordion-section {
+      margin-block-start: 40px;
+    }
+
+    .accordion-item {
+      background: white;
