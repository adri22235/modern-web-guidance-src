diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,92 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Page scrollbar colors */
+      --scrollbar-track: var(--secondary);
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-thumb-hover: #2e1b17;
+      --scrollbar-border: var(--secondary);
     }
 
+    /* Scrollbar adaptation for high contrast preferences */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #212121;
+        --scrollbar-border: #000000;
+      }
+
+      ::-webkit-scrollbar-track {
+        border-left: 1px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-radius: 0;
+        border: 2px solid #000000;
+      }
+    }
+
+    @media (prefers-contrast: more) and (prefers-color-scheme: dark) {
+      :root {
+        --scrollbar-track: #000000;
+        --scrollbar-thumb: #ffffff;
+        --scrollbar-thumb-hover: #e0e0e0;
+        --scrollbar-border: #ffffff;
+      }
+
+      ::-webkit-scrollbar-track {
+        border-left: 1px solid #ffffff;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-radius: 0;
+        border: 2px solid #ffffff;
+      }
+    }
+
+    @media (forced-colors: active) {
+      :root {
+        --scrollbar-track: Canvas;
+        --scrollbar-thumb: Highlight;
+        --scrollbar-thumb-hover: Highlight;
+        --scrollbar-border: CanvasText;
+      }
+
+      html {
+        scrollbar-color: Highlight Canvas;
+      }
+    }
+
+    /* Standard CSS Scrollbars */
+    html {
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      scrollbar-width: auto;
+    }
+
+    /* WebKit / Chromium / Safari custom scrollbars */
+    ::-webkit-scrollbar {
+      width: 14px;
+      height: 14px;
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border-radius: 7px;
+      border: 3px solid var(--scrollbar-border);
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
