+  <script>
+    // Fallback affordance hint management for browsers without scroll-state container queries or scroll-driven animations
+    if (!CSS.supports('container-type', 'scroll-state') && !CSS.supports('animation-timeline', 'scroll()')) {
+      const scroller = document.querySelector('.reviews-scroller');
+      if (scroller) {
+        const updateHints = () => {
+          const hasScrolledDown = scroller.scrollTop > 0;
+          const canScrollDownFurther = Math.ceil(scroller.scrollTop + scroller.clientHeight) < scroller.scrollHeight;
+          scroller.classList.toggle('more-start', hasScrolledDown);
+          scroller.classList.toggle('more-end', canScrollDownFurther);
+        };
+        scroller.addEventListener('scroll', updateHints, { passive: true });
+        updateHints();
+        window.addEventListener('resize', updateHints, { passive: true });
+      }
+    }
+  </script>
