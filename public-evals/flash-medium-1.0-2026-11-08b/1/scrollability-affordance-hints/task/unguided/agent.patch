+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviewsScrollContainer');
+      const hintTop = document.getElementById('scrollHintTop');
+      const hintBottom = document.getElementById('scrollHintBottom');
+
+      if (!scrollContainer || !hintTop || !hintBottom) return;
+
+      function updateScrollHints() {
+        const scrollTop = scrollContainer.scrollTop;
+        const scrollHeight = scrollContainer.scrollHeight;
+        const clientHeight = scrollContainer.clientHeight;
+        const maxScroll = scrollHeight - clientHeight;
+
+        // Content has vertical scrollable room
+        const hasScrollableContent = maxScroll > 2;
+
+        // The top hint should only appear when the user has scrolled down
+        if (hasScrollableContent && scrollTop > 2) {
+          hintTop.classList.add('visible');
+        } else {
+          hintTop.classList.remove('visible');
+        }
+
+        // The bottom hint should only appear when the user can scroll down further
+        if (hasScrollableContent && Math.ceil(scrollTop) < maxScroll - 2) {
+          hintBottom.classList.add('visible');
+        } else {
+          hintBottom.classList.remove('visible');
+        }
+      }
+
+      scrollContainer.addEventListener('scroll', updateScrollHints, { passive: true });
+      window.addEventListener('resize', updateScrollHints);
+      window.addEventListener('load', updateScrollHints);
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const resizeObserver = new ResizeObserver(updateScrollHints);
+        resizeObserver.observe(scrollContainer);
+      }
+
+      // Initial check
+      updateScrollHints();
+    })();
+  </script>
+
