+  <script>
+    (function () {
+      const PREFERENCE_KEY = 'daily_grind_dark_mode';
+
+      function applyPreference(isDark) {
+        if (isDark) {
+          document.body.classList.add('dark-mode');
+          document.documentElement.setAttribute('data-theme', 'dark');
+        } else {
+          document.body.classList.remove('dark-mode');
+          document.documentElement.setAttribute('data-theme', 'light');
+        }
+
+        const toggles = document.querySelectorAll('.preference-toggle-input');
+        toggles.forEach(function (toggle) {
+          toggle.checked = isDark;
+          toggle.setAttribute('aria-checked', isDark ? 'true' : 'false');
+        });
+
+        const states = document.querySelectorAll('.toggle-state');
+        states.forEach(function (state) {
+          state.textContent = isDark ? 'ON' : 'OFF';
+        });
+
+        try {
+          localStorage.setItem(PREFERENCE_KEY, isDark ? 'on' : 'off');
+        } catch (e) {
+          // Local storage unavailable or restricted
+        }
+      }
+
+      function initPreference() {
+        let isDark = false;
+        try {
+          const stored = localStorage.getItem(PREFERENCE_KEY);
+          if (stored !== null) {
+            isDark = stored === 'on';
+          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
+            isDark = true;
+          }
+        } catch (e) {
+          isDark = false;
+        }
+
+        applyPreference(isDark);
+
+        document.querySelectorAll('.preference-toggle-input').forEach(function (input) {
+          input.addEventListener('change', function (e) {
+            applyPreference(e.target.checked);
+          });
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPreference);
+      } else {
+        initPreference();
+      }
+    })();
+  </script>
