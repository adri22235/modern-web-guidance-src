+  <script>
+    const themeToggles = document.querySelectorAll('input[type="checkbox"][switch][name="theme-preference"]');
+    const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function getSystemScheme() {
+      return mediaQuery.matches ? 'dark' : 'light';
+    }
+
+    function getRenderedScheme() {
+      const stored = localStorage.getItem('color-scheme');
+      if (stored === 'dark' || stored === 'light') {
+        return stored;
+      }
+      return getSystemScheme();
+    }
+
+    function syncToggleUI() {
+      const isDark = getRenderedScheme() === 'dark';
+      themeToggles.forEach((toggle) => {
+        toggle.checked = isDark;
+      });
+    }
+
+    function handleToggleChange() {
+      const currentRendered = getRenderedScheme();
+      const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
+      const systemScheme = getSystemScheme();
+
+      if (targetScheme === systemScheme) {
+        localStorage.removeItem('color-scheme');
+        metaColorScheme.content = 'light dark';
+        metaColorScheme.setAttribute('content', 'light dark');
+      } else {
+        localStorage.setItem('color-scheme', targetScheme);
+        metaColorScheme.content = targetScheme;
+        metaColorScheme.setAttribute('content', targetScheme);
+      }
+
+      syncToggleUI();
+    }
+
+    themeToggles.forEach((toggle) => {
+      toggle.addEventListener('change', handleToggleChange);
+    });
+
+    syncToggleUI();
+
+    mediaQuery.addEventListener('change', () => {
+      const stored = localStorage.getItem('color-scheme');
+      if (!stored || stored === 'light dark') {
+        syncToggleUI();
+      }
+    });
+
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'color-scheme') {
+        const scheme = event.newValue ?? 'light dark';
+        metaColorScheme.content = scheme;
+        metaColorScheme.setAttribute('content', scheme);
+        syncToggleUI();
+      }
+    });
+  </script>
+
