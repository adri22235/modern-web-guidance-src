+  <script type="importmap">
+    {
+      "imports": {
+        "input-switch-polyfill": "./node_modules/input-switch-polyfill/input-switch-polyfill.js"
+      }
+    }
+  </script>
+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+  </script>
+  <script>
+    (() => {
+      const toggle = document.querySelector('#preference-toggle');
+      if (!toggle) return;
+
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function syncUI() {
+        let stored = null;
+        try {
+          stored = localStorage.getItem('color-scheme');
+        } catch (e) {}
+
+        const isDark = stored === 'dark' || (!stored && prefersDark.matches);
+        toggle.checked = isDark;
+      }
+
+      syncUI();
+
+      toggle.addEventListener('change', () => {
+        const targetScheme = toggle.checked ? 'dark' : 'light';
+        try {
+          localStorage.setItem('color-scheme', targetScheme);
+        } catch (e) {}
+        meta.content = targetScheme;
+        document.documentElement.setAttribute('data-theme', targetScheme);
+      });
+
+      prefersDark.addEventListener('change', () => {
+        try {
+          if (!localStorage.getItem('color-scheme')) {
+            syncUI();
+          }
+        } catch (e) {
+          syncUI();
+        }
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          const saved = e.newValue ?? 'light dark';
+          meta.content = saved;
+          if (saved === 'dark') {
+            document.documentElement.setAttribute('data-theme', 'dark');
+            toggle.checked = true;
+          } else if (saved === 'light') {
+            document.documentElement.setAttribute('data-theme', 'light');
+            toggle.checked = false;
+          } else {
+            document.documentElement.removeAttribute('data-theme');
+            toggle.checked = prefersDark.matches;
+          }
+        }
+      });
+    })();
+  </script>
