diff --git a/conditionally-load-polyfill.js b/conditionally-load-polyfill.js
new file mode 100644
--- a/conditionally-load-polyfill.js
+++ b/conditionally-load-polyfill.js
@@ -0,0 +1,13 @@
+// Check if the feature is missing before doing work.
+// Prefer checking HTMLElement.prototype for DOM attributes/properties.
+if (typeof HTMLElement !== 'undefined' && !('popover' in HTMLElement.prototype)) {
+  // Use top-level await to pause the execution of any module that imports this file
+  // until the polyfill finishes downloading and executing.
+  try {
+    await import('@oddbird/popover-polyfill');
+  } catch {
+    await import('./vendor/popover.js');
+  }
+}
+
+export const polyfillLoaded = true;
