+  <script>
+    (function () {
+      // Feature detection for CSS Scroll-Driven Animations
+      var supportsScrollTimeline = false;
+      try {
+        supportsScrollTimeline = !!(
+          window.CSS &&
+          typeof CSS.supports === 'function' &&
+          (CSS.supports('animation-timeline', 'scroll()') || CSS.supports('animation-timeline: scroll()'))
+        );
+      } catch (e) {
+        supportsScrollTimeline = false;
+      }
+
+      // If native scroll-driven animations are supported, let CSS handle it
+      if (supportsScrollTimeline) {
+        return;
+      }
+
+      // Fallback solution for older browsers:
+      // Smoothly update navigation bar styles directly linked to the scroll position
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var logo = nav.querySelector('.logo');
+      var logoutLink = nav.querySelector('.logout-link');
+      var maxScroll = 120; // Scroll distance in pixels over which the nav shrinks
+      var ticking = false;
+
+      var raf = window.requestAnimationFrame ||
+        window.webkitRequestAnimationFrame ||
+        window.mozRequestAnimationFrame ||
+        function (cb) { return setTimeout(cb, 16); };
+
+      function updateNavOnScroll() {
+        var scrollY = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
+        var progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
+
+        // Interpolate padding: 1rem (16px) down to 0.4rem (6.4px)
+        var paddingY = 1 - (0.6 * progress);
+        nav.style.paddingTop = paddingY + 'rem';
+        nav.style.paddingBottom = paddingY + 'rem';
+
+        // Interpolate logo font size: 1.5rem down to 1.15rem
+        if (logo) {
+          var logoSize = 1.5 - (0.35 * progress);
+          logo.style.fontSize = logoSize + 'rem';
+        }
+
+        // Interpolate logout button padding: 5px 12px down to 3px 10px
+        if (logoutLink) {
+          var padY = 5 - (2 * progress);
+          var padX = 12 - (2 * progress);
+          logoutLink.style.padding = padY + 'px ' + padX + 'px';
+        }
+
+        // Interpolate box-shadow opacity
+        var shadowAlpha = 0.25 * progress;
+        nav.style.boxShadow = '0 4px 12px rgba(0, 0, 0, ' + shadowAlpha + ')';
+
+        // Helper class for older browsers / CSS hooks
+        if (progress > 0) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        ticking = false;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          raf(updateNavOnScroll);
+          ticking = true;
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+
+      // Run on initialization in case the page is refreshed or loaded already scrolled
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', updateNavOnScroll);
+      } else {
+        updateNavOnScroll();
+      }
+    })();
+  </script>
