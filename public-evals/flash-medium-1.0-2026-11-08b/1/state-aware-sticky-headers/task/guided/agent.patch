+  <script>
+    (function () {
+      const containers = document.querySelectorAll('.sticky-container');
+      if (!containers.length) return;
+
+      function updateStuckStates() {
+        containers.forEach(container => {
+          const rect = container.getBoundingClientRect();
+          const topOffset = parseFloat(getComputedStyle(container).top) || 0;
+          const isStuckAtTop = rect.top <= (topOffset + 1);
+          const parent = container.parentElement;
+          const parentRect = parent ? parent.getBoundingClientRect() : rect;
+          const isWithinParent = parentRect.bottom > (topOffset + rect.height);
+          container.classList.toggle('is-stuck', isStuckAtTop && isWithinParent);
+        });
+      }
+
+      // IntersectionObserver fallback targeting document/viewport as scroll root
+      if ('IntersectionObserver' in window) {
+        containers.forEach(container => {
+          const topOffset = parseFloat(getComputedStyle(container).top) || 0;
+          const observer = new IntersectionObserver(
+            ([entry]) => {
+              const isStuck = entry.intersectionRatio < 1 && entry.boundingClientRect.top <= (topOffset + 1);
+              const parent = entry.target.parentElement;
+              const parentRect = parent ? parent.getBoundingClientRect() : entry.boundingClientRect;
+              const isWithinParent = parentRect.bottom > (topOffset + entry.boundingClientRect.height);
+              entry.target.classList.toggle('is-stuck', isStuck && isWithinParent);
+            },
+            {
+              root: null, // document/viewport is the scroll root
+              threshold: [1],
+              rootMargin: `-${topOffset + 1}px 0px 0px 0px`
+            }
+          );
+          observer.observe(container);
+        });
+      }
+
+      window.addEventListener('scroll', updateStuckStates, { passive: true });
+      window.addEventListener('resize', updateStuckStates, { passive: true });
+      document.addEventListener('DOMContentLoaded', updateStuckStates);
+      updateStuckStates();
+    })();
+  </script>
+
