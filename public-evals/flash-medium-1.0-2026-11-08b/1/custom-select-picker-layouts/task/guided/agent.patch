+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const roastSelect = document.getElementById('roast-select');
+      if (roastSelect) {
+        roastSelect.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
+            const options = Array.from(roastSelect.options);
+            const currentIndex = roastSelect.selectedIndex;
+            if (e.key === 'ArrowRight' && currentIndex < options.length - 1) {
+              roastSelect.selectedIndex = currentIndex + 1;
+              roastSelect.dispatchEvent(new Event('change', { bubbles: true }));
+              e.preventDefault();
+            } else if (e.key === 'ArrowLeft' && currentIndex > 0) {
+              roastSelect.selectedIndex = currentIndex - 1;
+              roastSelect.dispatchEvent(new Event('change', { bubbles: true }));
+              e.preventDefault();
+            }
+          }
+        });
+      }
+    });
+  </script>
