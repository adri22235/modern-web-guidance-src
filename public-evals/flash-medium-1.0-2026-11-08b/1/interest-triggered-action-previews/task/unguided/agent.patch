+  <script>
+    (function () {
+      const preview = document.getElementById('seasonal-preview');
+      if (!preview) return;
+
+      const defaultText = 'Select a drink to preview';
+
+      function showPreview(source) {
+        if (!source) return;
+        const drink = source.dataset.drink || source.closest('.card')?.querySelector('h3')?.textContent?.trim() || '';
+        const color = source.dataset.accentColor || source.dataset.color || 'var(--accent)';
+        preview.textContent = drink;
+        preview.style.borderLeftColor = color;
+        preview.style.borderColor = color;
+        preview.setAttribute('data-preview-drink', drink);
+      }
+
+      function resetPreview() {
+        preview.textContent = defaultText;
+        preview.style.borderLeftColor = '';
+        preview.style.borderColor = '';
+        preview.removeAttribute('data-preview-drink');
+      }
+
+      // Native Interest Invoker API support
+      preview.addEventListener('interest', (event) => {
+        showPreview(event.source);
+      });
+
+      preview.addEventListener('loseinterest', () => {
+        resetPreview();
+      });
+
+      // Delegated event handling for declarative interestfor/interesttarget triggers
+      // (avoids attaching hover/focus listeners to each button)
+      let activeInvoker = null;
+
+      function getInvoker(target) {
+        if (!target || !target.closest) return null;
+        return target.closest('[interestfor="seasonal-preview"], [interesttarget="seasonal-preview"]');
+      }
+
+      // Hover / Pointer events
+      document.addEventListener('pointerover', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          activeInvoker = invoker;
+          showPreview(invoker);
+        }
+      });
+
+      document.addEventListener('mouseover', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          activeInvoker = invoker;
+          showPreview(invoker);
+        }
+      });
+
+      document.addEventListener('pointerout', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          if (e.relatedTarget && invoker.contains(e.relatedTarget)) return;
+          if (activeInvoker === invoker) {
+            activeInvoker = null;
+            resetPreview();
+          }
+        }
+      });
+
+      document.addEventListener('mouseout', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          if (e.relatedTarget && invoker.contains(e.relatedTarget)) return;
+          if (activeInvoker === invoker) {
+            activeInvoker = null;
+            resetPreview();
+          }
+        }
+      });
+
+      // Focus / Blur events (capture phase ensures focus/blur are captured)
+      document.addEventListener('focus', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          activeInvoker = invoker;
+          showPreview(invoker);
+        }
+      }, true);
+
+      document.addEventListener('blur', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker && activeInvoker === invoker) {
+          activeInvoker = null;
+          resetPreview();
+        }
+      }, true);
+
+      // Long press / Touch / Pointer down events
+      document.addEventListener('pointerdown', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          activeInvoker = invoker;
+          showPreview(invoker);
+        }
+      });
+
+      document.addEventListener('touchstart', (e) => {
+        const invoker = getInvoker(e.target);
+        if (invoker) {
+          activeInvoker = invoker;
+          showPreview(invoker);
+        }
+      }, { passive: true });
+
+      document.addEventListener('touchmove', (e) => {
+        if (!activeInvoker) return;
+        const touch = e.touches[0];
+        if (touch) {
+          const element = document.elementFromPoint(touch.clientX, touch.clientY);
+          if (!element || !activeInvoker.contains(element)) {
+            activeInvoker = null;
+            resetPreview();
+          }
+        }
+      }, { passive: true });
+    })();
+  </script>
+
 </body>
 
