+  <script type="module">
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      try {
+        await import("./vendor/interestfor.min.js");
+      } catch {
+        await import("https://unpkg.com/interestfor@latest");
+      }
+    }
+  </script>
+
+  <script>
+    (function () {
+      const seasonalPreview = document.getElementById("seasonal-preview");
+      if (!seasonalPreview) return;
+
+      const defaultHTML = '<p class="preview-placeholder">Select a drink to preview</p>';
+
+      seasonalPreview.addEventListener("interest", function (event) {
+        const source = event.source || event.detail?.source || (event.target !== seasonalPreview ? event.target : null);
+        const drink = source?.dataset?.drink || source?.closest(".card")?.querySelector("h3")?.textContent || "Drink Preview";
+        const accent = source?.dataset?.accent || "#ffab40";
+        const desc = source?.dataset?.description || source?.closest(".card")?.querySelector("p")?.textContent || "";
+        const image = source?.dataset?.image || "";
+
+        seasonalPreview.dataset.preview = drink;
+        seasonalPreview.style.setProperty("--preview-accent", accent);
+        seasonalPreview.style.borderColor = accent;
+
+        seasonalPreview.innerHTML = `
+          <div class="preview-content">
+            ${image ? `<img src="${image}" alt="${drink}" class="preview-thumb" />` : ""}
+            <div class="preview-info">
+              <span class="preview-badge" style="background-color: ${accent}; color: #fff;">Preview</span>
+              <h3 class="preview-title" style="color: ${accent};">${drink}</h3>
+              ${desc ? `<p class="preview-desc">${desc}</p>` : ""}
+            </div>
+          </div>
+        `;
+      });
+
+      seasonalPreview.addEventListener("loseinterest", function () {
+        delete seasonalPreview.dataset.preview;
+        seasonalPreview.style.removeProperty("--preview-accent");
+        seasonalPreview.style.borderColor = "";
+        seasonalPreview.innerHTML = defaultHTML;
+      });
+    })();
+  </script>
+
