+  <script>
+    (function () {
+      const menubar = document.querySelector('[role="menubar"]');
+      if (!menubar) return;
+
+      const rootTriggers = [...menubar.querySelectorAll(':scope > button[commandfor]')];
+
+      function menuFor(trigger) {
+        const id = trigger.getAttribute('commandfor');
+        return id ? document.getElementById(id) : null;
+      }
+
+      function isOpen(menu) {
+        return menu && (menu.matches(':popover-open') || menu.classList.contains(':popover-open'));
+      }
+
+      function positionMenuIfNeeded(trigger, menu) {
+        if (window.CSS && CSS.supports && CSS.supports('position-area', 'block-end span-inline-end')) return;
+        const rect = trigger.getBoundingClientRect();
+        menu.style.position = 'fixed';
+        menu.style.inset = 'auto';
+        menu.style.margin = '0';
+        menu.style.top = `${rect.bottom + 4}px`;
+        menu.style.left = `${rect.left}px`;
+      }
+
+      function getMenuItems(menu) {
+        const group = menu.querySelector('[focusgroup]');
+        if (!group) return [];
+        return [...group.querySelectorAll('button, a')].filter(el => !el.disabled && el.getAttribute('aria-disabled') !== 'true');
+      }
+
+      function focusFirstItem(menu) {
+        const items = getMenuItems(menu);
+        if (items.length > 0) items[0].focus({ preventScroll: true });
+      }
+
+      function focusLastItem(menu) {
+        const items = getMenuItems(menu);
+        if (items.length > 0) items[items.length - 1].focus({ preventScroll: true });
+      }
+
+      function closeAndRestore(menu) {
+        const trigger = rootTriggers.find(t => menuFor(t) === menu);
+        if (trigger) trigger.focus({ preventScroll: true });
+        if (isOpen(menu)) menu.hidePopover();
+      }
+
+      function moveToRootTrigger(from, direction) {
+        const next = rootTriggers[(rootTriggers.indexOf(from) + direction + rootTriggers.length) % rootTriggers.length];
+        rootTriggers.forEach(trigger => { trigger.tabIndex = trigger === next ? 0 : -1; });
+        rootTriggers.map(menuFor).filter(isOpen).forEach(menu => menu.hidePopover());
+        next.focus({ preventScroll: true });
+      }
+
+      let isWindowBlur = false;
+      window.addEventListener('blur', () => { isWindowBlur = true; });
+      window.addEventListener('focus', () => { setTimeout(() => { isWindowBlur = false; }, 50); });
+
+      const enterOnOpen = new WeakSet();
+
+      rootTriggers.forEach(trigger => {
+        const menu = menuFor(trigger);
+        if (!menu) return;
+
+        menu.addEventListener('toggle', (event) => {
+          const open = event.newState === 'open';
+          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
+          if (open) {
+            positionMenuIfNeeded(trigger, menu);
+            if (enterOnOpen.has(menu)) {
+              enterOnOpen.delete(menu);
+              focusFirstItem(menu);
+            }
+          }
+        });
+
+        trigger.addEventListener('pointerenter', () => {
+          const anyOpen = rootTriggers.some(t => isOpen(menuFor(t)));
+          if (anyOpen && !isOpen(menu)) {
+            rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+            rootTriggers.forEach(t => { t.tabIndex = t === trigger ? 0 : -1; });
+            trigger.focus({ preventScroll: true });
+          }
+        });
+
+        trigger.addEventListener('focus', (e) => {
+          if (isWindowBlur) return;
+          if (e.relatedTarget && menu.contains(e.relatedTarget)) return;
+
+          if (!isOpen(menu)) {
+            try {
+              menu.showPopover({ source: trigger });
+            } catch (err) {
+              menu.showPopover();
+            }
+          }
+        });
+
+        trigger.addEventListener('blur', () => {
+          setTimeout(() => {
+            if (isOpen(menu) && !menu.contains(document.activeElement) && document.activeElement !== trigger) {
+              if (!menubar.contains(document.activeElement)) {
+                menu.hidePopover();
+              }
+            }
+          }, 10);
+        });
+
+        trigger.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowRight') {
+            e.preventDefault();
+            moveToRootTrigger(trigger, 1);
+          } else if (e.key === 'ArrowLeft') {
+            e.preventDefault();
+            moveToRootTrigger(trigger, -1);
+          } else if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            if (isOpen(menu)) {
+              focusFirstItem(menu);
+            } else {
+              enterOnOpen.add(menu);
+              if ('commandForElement' in HTMLButtonElement.prototype) {
+                trigger.click();
+              } else {
+                try { menu.showPopover({ source: trigger }); } catch { menu.showPopover(); }
+              }
+            }
+          } else if (e.key === 'Home') {
+            e.preventDefault();
+            if (!isOpen(menu)) {
+              try { menu.showPopover({ source: trigger }); } catch { menu.showPopover(); }
+            }
+            focusFirstItem(menu);
+          } else if (e.key === 'End') {
+            e.preventDefault();
+            if (!isOpen(menu)) {
+              try { menu.showPopover({ source: trigger }); } catch { menu.showPopover(); }
+            }
+            focusLastItem(menu);
+          }
+        });
+
+        menu.addEventListener('keydown', (e) => {
+          if (e.key === 'Escape') {
+            e.preventDefault();
+            e.stopPropagation();
+            closeAndRestore(menu);
+          } else if (e.key === 'ArrowRight') {
+            e.preventDefault();
+            moveToRootTrigger(trigger, 1);
+          } else if (e.key === 'ArrowLeft') {
+            e.preventDefault();
+            moveToRootTrigger(trigger, -1);
+          } else if (e.key === 'Tab') {
+            rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+          }
+        });
+
+        menu.addEventListener('pointermove', (e) => {
+          const item = e.target.closest('a, button');
+          if (item && menu.contains(item) && item !== document.activeElement) {
+            item.focus({ preventScroll: true });
+          }
+        });
+
+        menu.addEventListener('click', (e) => {
+          const item = e.target.closest('a, button');
+          if (item) {
+            menu.hidePopover();
+          }
+        });
+      });
+
+      // Invoker command fallback for engines without native commandfor support
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        rootTriggers.forEach(trigger => {
+          trigger.addEventListener('click', (e) => {
+            e.preventDefault();
+            const menu = menuFor(trigger);
+            if (!menu) return;
+            if (isOpen(menu)) {
+              closeAndRestore(menu);
+            } else {
+              try {
+                menu.showPopover({ source: trigger });
+              } catch {
+                menu.showPopover();
+              }
+            }
+          });
+        });
+      }
+
+      // Focusgroup fallback for browsers without native focusgroup support
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+          group.setAttribute('role', 'menu');
+          group.querySelectorAll('button:not([role]), a:not([role])').forEach(item => {
+            item.setAttribute('role', 'menuitem');
+          });
+          group.addEventListener('keydown', (event) => {
+            if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+            const items = [...group.querySelectorAll('button, a')]
+              .filter(item => item.closest('[focusgroup]') === group)
+              .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+            const current = items.indexOf(document.activeElement);
+            if (current < 0) return;
+            const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+              (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            items[next].focus({ preventScroll: true });
+          }, true);
+        });
+      }
+
+      // Close open menus when focus leaves menubar system
+      document.addEventListener('focusin', (e) => {
+        if (!menubar.contains(e.target) && !rootTriggers.some(t => menuFor(t)?.contains(e.target))) {
+          rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+        }
+      });
+    })();
+  </script>
+
 </body>
 
