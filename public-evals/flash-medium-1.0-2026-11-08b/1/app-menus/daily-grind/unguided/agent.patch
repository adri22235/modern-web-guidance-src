+  <script>
+    (function () {
+      const menubar = document.getElementById('app-menubar');
+      if (!menubar) return;
+
+      const groups = Array.from(menubar.querySelectorAll('.menubar-group'));
+      const triggers = groups.map(g => g.querySelector('.menubar-trigger'));
+      const menus = groups.map(g => g.querySelector('.dropdown-menu'));
+
+      let closeTimer = null;
+
+      function openMenu(index, focusFirst = false) {
+        if (closeTimer) {
+          clearTimeout(closeTimer);
+          closeTimer = null;
+        }
+
+        triggers.forEach((trigger, i) => {
+          if (i === index) {
+            trigger.setAttribute('aria-expanded', 'true');
+            trigger.setAttribute('tabindex', '0');
+            menus[i].removeAttribute('hidden');
+            if (focusFirst) {
+              const firstItem = menus[i].querySelector('[role="menuitem"]');
+              if (firstItem) firstItem.focus();
+            }
+          } else {
+            trigger.setAttribute('aria-expanded', 'false');
+            trigger.setAttribute('tabindex', '-1');
+            menus[i].setAttribute('hidden', '');
+          }
+        });
+      }
+
+      function closeMenu(index, returnFocus = false) {
+        if (triggers[index] && menus[index]) {
+          triggers[index].setAttribute('aria-expanded', 'false');
+          menus[index].setAttribute('hidden', '');
+          if (returnFocus) {
+            triggers[index].focus();
+          }
+        }
+      }
+
+      function closeAllMenus(returnFocusIndex = null) {
+        if (closeTimer) {
+          clearTimeout(closeTimer);
+          closeTimer = null;
+        }
+
+        triggers.forEach((trigger, i) => {
+          trigger.setAttribute('aria-expanded', 'false');
+          menus[i].setAttribute('hidden', '');
+        });
+
+        if (returnFocusIndex !== null && triggers[returnFocusIndex]) {
+          triggers[returnFocusIndex].focus();
+        }
+      }
+
+      function isMenuOpen(index) {
+        return triggers[index] && triggers[index].getAttribute('aria-expanded') === 'true';
+      }
+
+      function anyMenuOpen() {
+        return triggers.some(t => t.getAttribute('aria-expanded') === 'true');
+      }
+
+      // Trigger buttons setup
+      triggers.forEach((trigger, index) => {
+        trigger.addEventListener('click', (e) => {
+          e.stopPropagation();
+          if (isMenuOpen(index)) {
+            closeMenu(index, true);
+          } else {
+            openMenu(index, false);
+          }
+        });
+
+        trigger.addEventListener('keydown', (e) => {
+          let targetIndex;
+          switch (e.key) {
+            case 'ArrowRight':
+              e.preventDefault();
+              targetIndex = (index + 1) % triggers.length;
+              triggers[targetIndex].focus();
+              triggers.forEach((t, i) => t.setAttribute('tabindex', i === targetIndex ? '0' : '-1'));
+              if (anyMenuOpen()) {
+                openMenu(targetIndex, false);
+              }
+              break;
+
+            case 'ArrowLeft':
+              e.preventDefault();
+              targetIndex = (index - 1 + triggers.length) % triggers.length;
+              triggers[targetIndex].focus();
+              triggers.forEach((t, i) => t.setAttribute('tabindex', i === targetIndex ? '0' : '-1'));
+              if (anyMenuOpen()) {
+                openMenu(targetIndex, false);
+              }
+              break;
+
+            case 'ArrowDown':
+            case 'Enter':
+            case ' ':
+              e.preventDefault();
+              openMenu(index, true);
+              break;
+
+            case 'ArrowUp':
+              e.preventDefault();
+              openMenu(index, false);
+              const items = menus[index].querySelectorAll('[role="menuitem"]');
+              if (items.length > 0) {
+                items[items.length - 1].focus();
+              }
+              break;
+
+            case 'Home':
+              e.preventDefault();
+              triggers[0].focus();
+              triggers.forEach((t, i) => t.setAttribute('tabindex', i === 0 ? '0' : '-1'));
+              break;
+
+            case 'End':
+              e.preventDefault();
+              triggers[triggers.length - 1].focus();
+              triggers.forEach((t, i) => t.setAttribute('tabindex', i === triggers.length - 1 ? '0' : '-1'));
+              break;
+
+            case 'Escape':
+              if (isMenuOpen(index)) {
+                e.preventDefault();
+                closeMenu(index, true);
+              }
+              break;
+          }
+        });
+      });
+
+      // Dropdown menus and menuitems setup
+      menus.forEach((menu, menuIndex) => {
+        const items = Array.from(menu.querySelectorAll('[role="menuitem"]'));
+
+        items.forEach((item, itemIndex) => {
+          item.addEventListener('keydown', (e) => {
+            switch (e.key) {
+              case 'ArrowDown':
+                e.preventDefault();
+                const nextIndex = (itemIndex + 1) % items.length;
+                items[nextIndex].focus();
+                break;
+
+              case 'ArrowUp':
+                e.preventDefault();
+                const prevIndex = (itemIndex - 1 + items.length) % items.length;
+                items[prevIndex].focus();
+                break;
+
+              case 'ArrowRight':
+                e.preventDefault();
+                const nextMenuIndex = (menuIndex + 1) % triggers.length;
+                openMenu(nextMenuIndex, true);
+                break;
+
+              case 'ArrowLeft':
+                e.preventDefault();
+                const prevMenuIndex = (menuIndex - 1 + triggers.length) % triggers.length;
+                openMenu(prevMenuIndex, true);
+                break;
+
+              case 'Escape':
+                e.preventDefault();
+                closeMenu(menuIndex, true);
+                break;
+
+              case 'Home':
+                e.preventDefault();
+                items[0].focus();
+                break;
+
+              case 'End':
+                e.preventDefault();
+                items[items.length - 1].focus();
+                break;
+
+              case 'Tab':
+                closeAllMenus();
+                break;
+            }
+          });
+        });
+      });
+
+      // Hover interactions for mouse users
+      groups.forEach((group, index) => {
+        group.addEventListener('mouseenter', () => {
+          if (closeTimer) {
+            clearTimeout(closeTimer);
+            closeTimer = null;
+          }
+          openMenu(index, false);
+        });
+
+        group.addEventListener('mouseleave', () => {
+          closeTimer = setTimeout(() => {
+            closeMenu(index);
+          }, 250);
+        });
+      });
+
+      // Close when clicking anywhere outside
+      document.addEventListener('click', (e) => {
+        if (!menubar.contains(e.target)) {
+          closeAllMenus();
+        }
+      });
+
+      // Close when focus moves outside
+      document.addEventListener('focusin', (e) => {
+        if (!menubar.contains(e.target)) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
