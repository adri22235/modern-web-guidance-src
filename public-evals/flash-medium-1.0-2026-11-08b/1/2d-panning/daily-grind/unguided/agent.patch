+        if (e.key === 'ArrowUp') {
+          mapViewport.scrollBy({ top: -step, behavior: 'smooth' });
+          e.preventDefault();
+        } else if (e.key === 'ArrowDown') {
+          mapViewport.scrollBy({ top: step, behavior: 'smooth' });
+          e.preventDefault();
+        } else if (e.key === 'ArrowLeft') {
+          mapViewport.scrollBy({ left: -step, behavior: 'smooth' });
+          e.preventDefault();
+        } else if (e.key === 'ArrowRight') {
+          mapViewport.scrollBy({ left: step, behavior: 'smooth' });
+          e.preventDefault();
+        }
+      });
+
+      // Directional D-Pad Navigation Controls (Supports 8 directions including diagonal panning)
+      const dpadStep = 320;
+      document.querySelectorAll('.dpad-btn').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.stopPropagation();
+          const dir = btn.getAttribute('data-dir');
+          let dx = 0;
+          let dy = 0;
+          switch (dir) {
+            case 'nw': dx = -dpadStep; dy = -dpadStep; break;
+            case 'n':  dx = 0;         dy = -dpadStep; break;
+            case 'ne': dx = dpadStep;  dy = -dpadStep; break;
+            case 'w':  dx = -dpadStep; dy = 0;         break;
+            case 'center': centerOnLocation(1120, 580, true); return;
+            case 'e':  dx = dpadStep;  dy = 0;         break;
+            case 'sw': dx = -dpadStep; dy = dpadStep;  break;
+            case 's':  dx = 0;         dy = dpadStep;  break;
+            case 'se': dx = dpadStep;  dy = dpadStep;  break;
+          }
+          mapViewport.scrollBy({ left: dx, top: dy, behavior: 'smooth' });
+        });
+      });
+
+      // Select Cafe Function
+      function selectCafe(cafeId, smooth = true) {
+        const pin = document.querySelector(`.map-pin[data-cafe="${cafeId}"]`);
+        if (!pin) return;
+
+        document.querySelectorAll('.map-pin').forEach((p) => p.classList.remove('active'));
+        document.querySelectorAll('.quick-nav-pill').forEach((btn) => btn.classList.remove('active'));
+
+        pin.classList.add('active');
+        const pill = document.querySelector(`.quick-nav-pill[data-cafe="${cafeId}"]`);
+        if (pill) pill.classList.add('active');
+
+        const pinX = parseFloat(pin.style.left);
+        const pinY = parseFloat(pin.style.top);
+        centerOnLocation(pinX, pinY, smooth);
+      }
+
+      // Quick Navigation Selector Pills
+      document.querySelectorAll('.quick-nav-pill').forEach((pill) => {
+        pill.addEventListener('click', () => {
+          const cafeId = pill.getAttribute('data-cafe');
+          if (cafeId === 'center') {
+            document.querySelectorAll('.map-pin').forEach((p) => p.classList.remove('active'));
+            document.querySelectorAll('.quick-nav-pill').forEach((b) => b.classList.remove('active'));
+            pill.classList.add('active');
+            centerOnLocation(1120, 580, true);
+          } else {
+            selectCafe(cafeId, true);
+          }
+        });
+      });
+
+      // Pin Click Handling (Distinguishes between dragging and clicking)
+      document.querySelectorAll('.map-pin').forEach((pin) => {
+        pin.addEventListener('click', (e) => {
+          if (hasMoved) return; // Ignore clicks if user was panning/dragging
+          e.stopPropagation();
+          const cafeId = pin.getAttribute('data-cafe');
+          const wasActive = pin.classList.contains('active');
+
+          document.querySelectorAll('.map-pin').forEach((p) => p.classList.remove('active'));
+          document.querySelectorAll('.quick-nav-pill').forEach((b) => b.classList.remove('active'));
+
+          if (!wasActive) {
+            pin.classList.add('active');
+            const pill = document.querySelector(`.quick-nav-pill[data-cafe="${cafeId}"]`);
+            if (pill) pill.classList.add('active');
+          }
+        });
+
+        // Also allow Enter/Space key to activate focused pin
+        pin.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            pin.click();
+          }
+        });
+      });
+
+      // Close Popup Buttons
+      document.querySelectorAll('.popup-close-btn').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.stopPropagation();
+          const pin = btn.closest('.map-pin');
+          if (pin) pin.classList.remove('active');
+          document.querySelectorAll('.quick-nav-pill').forEach((b) => b.classList.remove('active'));
+        });
+      });
+
+      // Click on background map surface (when not dragging) closes open popups
+      mapSurface.addEventListener('click', (e) => {
+        if (hasMoved) return;
+        if (!e.target.closest('.map-pin')) {
+          document.querySelectorAll('.map-pin').forEach((p) => p.classList.remove('active'));
+          document.querySelectorAll('.quick-nav-pill').forEach((b) => b.classList.remove('active'));
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
