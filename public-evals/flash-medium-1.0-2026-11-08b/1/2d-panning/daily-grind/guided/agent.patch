+      // Modern Web Guidance: 2d-panning fallback
+      // When scroll-axis-lock is unsupported, provide JS wheel & pointer drag fallback
+      if (!CSS.supports('scroll-axis-lock', 'none')) {
+        let fallbackPointer = null;
+
+        // 1. Trackpad and mouse wheel fallback
+        viewport.addEventListener(
+          'wheel',
+          (e) => {
+            if (e.ctrlKey) return; // Ctrl+wheel and trackpad pinch zoom the page
+            e.preventDefault();
+            viewport.scrollLeft += e.deltaX;
+            viewport.scrollTop += e.deltaY;
+          },
+          { passive: false }
+        );
+
