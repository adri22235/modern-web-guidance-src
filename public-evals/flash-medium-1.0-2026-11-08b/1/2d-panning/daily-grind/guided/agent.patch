+      // Center the map viewport initially
+      const centerMap = (smooth = false) => {
+        const targetLeft = Math.max(0, (viewport.scrollWidth - viewport.clientWidth) / 2);
+        const targetTop = Math.max(0, (viewport.scrollHeight - viewport.clientHeight) / 2);
+        if (smooth) {
+          viewport.scrollTo({ left: targetLeft, top: targetTop, behavior: 'smooth' });
