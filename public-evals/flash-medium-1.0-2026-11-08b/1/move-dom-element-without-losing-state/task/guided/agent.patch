+  <script>
+    function initTheaterMode() {
+      const heroSection = document.getElementById('hero') || document.querySelector('.hero');
+      const videoSection = document.getElementById('video-section') || document.querySelector('.video-section');
+      const videoContainer = document.getElementById('video-container');
+      const videoElement = document.getElementById('video-element') || document.querySelector('.video-element') || document.querySelector('iframe');
+      const toggleBtn = document.getElementById('theater-toggle-btn') || document.querySelector('.theater-toggle-btn');
+      const heroToggleBtn = document.getElementById('hero-theater-toggle-btn');
+      const heroControls = document.getElementById('hero-theater-controls');
+      const liveRegion = document.getElementById('video-live-region');
+
+      if (!heroSection || !videoContainer || !videoElement || !toggleBtn) {
+        return;
+      }
+
+      let isTheaterMode = false;
+
+      function moveNode(targetParent, nodeToMove, referenceNode = null) {
+        if (typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(nodeToMove, referenceNode);
+        } else {
+          targetParent.insertBefore(nodeToMove, referenceNode);
+        }
+      }
+
+      function toggleTheaterMode() {
+        isTheaterMode = !isTheaterMode;
+
+        if (isTheaterMode) {
+          heroSection.classList.add('theater-mode');
+          if (videoSection) videoSection.classList.add('theater-active');
+
+          moveNode(heroSection, videoElement, heroControls || null);
+
+          toggleBtn.setAttribute('aria-pressed', 'true');
+          toggleBtn.textContent = 'Exit Theater Mode';
+
+          if (heroToggleBtn) {
+            heroToggleBtn.setAttribute('aria-pressed', 'true');
+          }
+          if (liveRegion) {
+            liveRegion.textContent = 'Video player moved to hero section in theater mode';
+          }
+
+          heroSection.scrollIntoView({ behavior: 'smooth' });
+        } else {
+          heroSection.classList.remove('theater-mode');
+          if (videoSection) videoSection.classList.remove('theater-active');
+
+          moveNode(videoContainer, videoElement, null);
+
+          toggleBtn.setAttribute('aria-pressed', 'false');
+          toggleBtn.textContent = 'Toggle Theater Mode';
+
+          if (heroToggleBtn) {
+            heroToggleBtn.setAttribute('aria-pressed', 'false');
+          }
+          if (liveRegion) {
+            liveRegion.textContent = 'Video player returned to video section';
+          }
+
+          if (videoSection) videoSection.scrollIntoView({ behavior: 'smooth' });
+        }
+      }
+
+      toggleBtn.addEventListener('click', toggleTheaterMode);
+      if (heroToggleBtn) {
+        heroToggleBtn.addEventListener('click', toggleTheaterMode);
+      }
+
+      window.toggleTheaterMode = toggleTheaterMode;
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initTheaterMode);
+    } else {
+      initTheaterMode();
+    }
+  </script>
+
