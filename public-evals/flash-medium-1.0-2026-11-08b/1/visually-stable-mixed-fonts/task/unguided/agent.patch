diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,105 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Typography Normalization & Theme Metric Overrides</title>
+  <link rel="stylesheet" href="style.css">
+  <style>
+    /* ==========================================================================
+       Embedded CSS fallback and direct specification
+       ========================================================================== */
+
+    /* Mixed Fonts Container: Automatically normalizes visual height */
+    #mixed-fonts-container {
+      font-family: Georgia, Cambria, 'Times New Roman', serif;
+      font-size: 1.125rem;
+      line-height: 1.7;
+      background-color: #ffffff;
+      border: 1px solid #e2e8f0;
+      border-radius: 12px;
+      padding: 2rem;
+      margin-bottom: 2.5rem;
+      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
+
+      /* Modern CSS to automatically normalize visual height of mixed fonts */
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: 'Courier New', Courier, ui-monospace, monospace;
+      font-size-adjust: from-font;
+      background-color: #f1f5f9;
+      color: #0f172a;
+      padding: 0.15em 0.4em;
+      border-radius: 4px;
+      border: 1px solid #e2e8f0;
+    }
+
+    /* Independent Theme Container: Numeric metric override locks proportions */
+    #independent-theme-container {
+      --theme-bg: #0f172a;
+      --theme-text: #f8fafc;
+      --theme-accent: #38bdf8;
+      --theme-border: #334155;
+      --theme-code-bg: #1e293b;
+      --theme-code-border: #475569;
+
+      background-color: var(--theme-bg);
+      color: var(--theme-text);
+      border: 1px solid var(--theme-border);
+      border-radius: 12px;
+      padding: 2rem;
+      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
+      font-size: 1.05rem;
+      line-height: 1.7;
+      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
+
+      /* Specific numeric metric override to lock down visual proportions */
+      font-size-adjust: 0.52;
+      font-size-adjust: ex-height 0.52;
+    }
+
+    #independent-theme-container code {
+      font-family: 'Fira Code', 'Cascadia Code', Consolas, monospace;
+      font-size-adjust: ex-height 0.52;
+      background-color: var(--theme-code-bg);
+      color: var(--theme-accent);
+      padding: 0.15em 0.4em;
+      border-radius: 4px;
+      border: 1px solid var(--theme-code-border);
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Typography Normalization &amp; Theme Metrics</h1>
+    <p>Demonstrating modern CSS font size adjustments for mixed fonts and independent themes.</p>
+  </header>
+
+  <main>
+    <!-- Mixed Fonts Container -->
+    <section id="mixed-fonts-container">
+      <h2>Mixed Fonts with Automatic Normalization</h2>
+      <p>
+        In this block, regular serif prose (using Georgia) is interspersed with inline code snippets like <code>const status = "operational";</code>, <code>npm run build</code>, and <code>Array.prototype.reduce()</code>.
+      </p>
+      <p>
+        By applying the modern CSS property <code>font-size-adjust: from-font;</code>, the browser extracts the x-height metric from the primary font family and automatically scales the monospace inline code font so that lowercase letters match the visual height of the surrounding text seamlessly.
+      </p>
+    </section>
+
+    <!-- Independent Theme Container -->
+    <section id="independent-theme-container">
+      <h2>Independent Theme: Metric Override</h2>
+      <p class="theme-meta">Dark Studio Theme &bull; Locked Visual Proportions</p>
+      <p>
+        This container showcases an independent theme with its own typographic scale, color palette, and visual hierarchy. To guarantee stable visual proportions regardless of font swapping or system font variations, a specific numeric metric override is applied.
+      </p>
+      <p>
+        With <code>font-size-adjust: ex-height 0.52;</code>, the visual lowercase proportion is locked to an exact ratio of <code>0.52</code> across all child elements and inline code snippets like <code>theme.setMode('dark')</code> and <code>--accent-color: #38bdf8;</code>.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
