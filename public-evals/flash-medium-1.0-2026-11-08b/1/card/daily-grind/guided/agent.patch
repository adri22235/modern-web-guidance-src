+
+      // Fallback for browsers lacking :has()
+      if (!CSS.supports('selector(:has(*))')) {
+        document.querySelectorAll('.card').forEach(card => {
+          if (card.querySelector('img')) card.classList.add('has-img');
+          if (card.querySelector('.card-badge')) card.classList.add('has-badge');
+        });
+
+        document.querySelectorAll('.size-option input[type="radio"]').forEach(radio => {
+          const syncClass = () => {
+            const fieldset = radio.closest('fieldset');
+            fieldset.querySelectorAll('.size-option').forEach(opt => {
+              const r = opt.querySelector('input');
+              opt.classList.toggle('is-selected', r && r.checked);
+            });
+          };
+          radio.addEventListener('change', syncClass);
+          syncClass();
+        });
+      }
+    });
