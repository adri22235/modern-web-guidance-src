+  <script>
+    (function () {
+      let cartCount = 0;
+      const cartCountEl = document.getElementById('cart-count');
+
+      document.querySelectorAll('.card').forEach(function (card) {
+        const orderBtn = card.querySelector('.btn-add-order');
+        const feedbackEl = card.querySelector('.order-feedback');
+        const drinkName = card.dataset.drink || 'Drink';
+
+        if (!orderBtn) return;
+
+        orderBtn.addEventListener('click', function () {
+          const selectedInput = card.querySelector('input[type="radio"]:checked');
+          const size = selectedInput ? selectedInput.value : 'medium';
+          const sizeCapitalized = size.charAt(0).toUpperCase() + size.slice(1);
+
+          // Update total cart count
+          cartCount += 1;
+          if (cartCountEl) {
+            cartCountEl.textContent = cartCount;
+          }
+
+          // Visual button feedback
+          const originalLabel = orderBtn.querySelector('.btn-label').textContent;
+          const originalIcon = orderBtn.querySelector('.btn-icon').textContent;
+          orderBtn.querySelector('.btn-label').textContent = 'Added to Order!';
+          orderBtn.querySelector('.btn-icon').textContent = '✓';
+
+          // Status message on card
+          if (feedbackEl) {
+            feedbackEl.textContent = `Added ${sizeCapitalized} ${drinkName} to your order!`;
+            feedbackEl.classList.add('visible');
+          }
+
+          // Reset button and message after 2.2 seconds
+          setTimeout(function () {
+            orderBtn.querySelector('.btn-label').textContent = originalLabel;
+            orderBtn.querySelector('.btn-icon').textContent = originalIcon;
+            if (feedbackEl) {
+              feedbackEl.classList.remove('visible');
+            }
+          }, 2200);
+        });
+      });
+    })();
