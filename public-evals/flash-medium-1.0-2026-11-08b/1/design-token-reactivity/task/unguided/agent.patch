+  <script>
+    (function () {
+      const toggleSpacious = document.getElementById('toggle-spacious');
+      const targetContainer = document.getElementById('target-container');
+
+      if (toggleSpacious && targetContainer) {
+        toggleSpacious.addEventListener('click', function () {
+          const current = (targetContainer.style.getPropertyValue('--card-density') ||
+            getComputedStyle(targetContainer).getPropertyValue('--card-density') || '').trim();
+          const next = current === 'spacious' ? 'normal' : 'spacious';
+          targetContainer.style.setProperty('--card-density', next);
+        });
+      }
+    })();
