+      <div style="text-align: center; margin-top: 10px;">
+        <button type="button" id="toggle-spacious" class="btn" aria-pressed="false">Toggle Spacious Density</button>
+      </div>
+      <div class="grid" id="target-container">
+        <div class="card" id="target-item">
           <h3>Maple Oat Latte</h3>
           <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
           <a href="/menu/seasonal" class="btn">View Details</a>
         </div>
@@ -206,7 +262,27 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const toggleSpaciousBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleSpaciousBtn && targetContainer) {
+      toggleSpaciousBtn.addEventListener('click', () => {
+        const currentDensity = targetContainer.style.getPropertyValue('--card-density') ||
+          getComputedStyle(targetContainer).getPropertyValue('--card-density').trim();
+        const isSpacious = currentDensity === 'spacious';
+        if (isSpacious) {
+          targetContainer.style.setProperty('--card-density', 'normal');
+          toggleSpaciousBtn.setAttribute('aria-pressed', 'false');
+        } else {
+          targetContainer.style.setProperty('--card-density', 'spacious');
+          toggleSpaciousBtn.setAttribute('aria-pressed', 'true');
+        }
+      });
+    }
+  </script>
+
