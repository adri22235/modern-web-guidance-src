@@ -134,8 +135,60 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    #target-container {
+      container-name: target-container;
+      --card-density: normal;
+    }
+
+    #toggle-spacious {
+      display: none;
+      cursor: pointer;
+      border: none;
+      font-family: inherit;
+      font-size: 0.95rem;
+    }
+
+    /* Style query feature support detection */
+    @container style(--style-queries-supported: check) {
+      body {
+        --style-queries-supported: yes;
+      }
+
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    @container style(--style-queries-supported) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
