+          ALLOWED_ATTR: allowedAttributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      } catch (err) {
+        console.error('DOMPurify sanitization fallback failed, displaying textContent:', err);
