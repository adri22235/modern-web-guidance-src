+        header.className = 'review-card-header';
+
+        const metaLeft = document.createElement('div');
+        metaLeft.className = 'review-meta-left';
+
+        const badge = document.createElement('span');
+        badge.className = 'review-drink-badge';
+        badge.textContent = review.drink;
+
+        const author = document.createElement('span');
+        author.className = 'review-author';
+        author.textContent = review.author;
+
+        const stars = document.createElement('span');
+        stars.className = 'review-rating-stars';
+        stars.textContent = getStars(review.rating);
+        stars.setAttribute('aria-label', `${review.rating} out of 5 stars`);
+
+        metaLeft.append(badge, author, stars);
+
+        const date = document.createElement('span');
+        date.className = 'review-date';
+        date.textContent = review.date;
+
+        header.append(metaLeft, date);
+
+        const contentEl = document.createElement('div');
+        contentEl.className = 'review-content';
+
+        // Safely parse and sanitize the untrusted rich HTML markup
+        await safeSetHTML(contentEl, review.content);
+
+        card.append(header, contentEl);
+        container.appendChild(card);
+      }
+    }
+
+    // Attach form and interaction event listeners
+    const form = document.getElementById('review-form');
+    const contentTextarea = document.getElementById('review-content');
+    const previewContainer = document.getElementById('review-preview');
+    const filterSelect = document.getElementById('drink-filter');
+    const drinkSelect = document.getElementById('review-drink');
+
+    // Live preview on input
+    contentTextarea.addEventListener('input', () => {
+      updatePreview(previewContainer, contentTextarea.value);
+    });
+
+    // Formatting helper buttons
+    document.querySelectorAll('.html-helper-toolbar .tool-btn').forEach(button => {
+      button.addEventListener('click', () => {
+        const tag = button.getAttribute('data-tag');
+        const start = contentTextarea.selectionStart;
+        const end = contentTextarea.selectionEnd;
+        const selected = contentTextarea.value.substring(start, end);
+        let replacement = '';
+
+        if (tag === 'ul') {
+          replacement = `<ul>\n  <li>${selected || 'Item'}</li>\n</ul>`;
+        } else {
+          replacement = `<${tag}>${selected || 'text'}</${tag}>`;
+        }
+
+        contentTextarea.setRangeText(replacement, start, end, 'select');
+        contentTextarea.focus();
+        updatePreview(previewContainer, contentTextarea.value);
+      });
+    });
+
+    // Review form submission
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+
+      const drink = drinkSelect.value;
+      const author = document.getElementById('review-author').value.trim();
+      const rating = parseInt(document.getElementById('review-rating').value, 10) || 5;
+      const content = contentTextarea.value.trim();
+
+      if (!drink || !author || !content) return;
+
+      const newReview = {
+        id: Date.now(),
+        drink,
+        author,
+        rating,
+        date: 'Just now',
+        content
+      };
+
+      reviews.unshift(newReview);
+
+      // Re-render reviews list with newly added review
+      await renderReviews();
+
+      // Reset form
+      form.reset();
+      updatePreview(previewContainer, '');
+
+      // Scroll smoothly to reviews display
+      const listEl = document.getElementById('reviews-list');
+      if (listEl) {
+        listEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      }
+    });
+
+    // Filter change
+    filterSelect.addEventListener('change', () => {
+      renderReviews();
+    });
+
+    // Quick review buttons on seasonal drink cards
+    document.querySelectorAll('.quick-review-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const drink = btn.getAttribute('data-drink');
+        if (drink && drinkSelect) {
+          drinkSelect.value = drink;
+        }
+        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        contentTextarea.focus();
+      });
+    });
+
+    // Initial render
+    renderReviews();
+  </script>
 </body>
 
 </html>
