+  <script type="module">
+    // Modern HTML Sanitization Module
+    // Uses native Sanitizer API (Element.prototype.setHTML and Document.parseHTML)
+    // with DOMPurify fallback when native browser support is absent.
+
+    const allowedElements = [
+      'p', 'b', 'i', 'strong', 'em', 'span', 'ul', 'ol', 'li',
+      'blockquote', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'br',
+      'hr', 'a', 'small', 'mark', 'sub', 'sup', 'code', 'pre', '#text'
+    ];
+    const allowedAttributes = ['class', 'href', 'title', 'target'];
