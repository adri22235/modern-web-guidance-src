+    function loadDOMPurify() {
+      if (!domPurifyPromise) {
+        domPurifyPromise = import('dompurify')
+          .catch(() => import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm'))
+          .then((mod) => {
+            const purifyExport = mod.default ?? mod;
+            if (typeof purifyExport === 'function' && typeof purifyExport.sanitize !== 'function' && typeof window !== 'undefined') {
+              return purifyExport(window);
+            }
+            return purifyExport;
+          });
+      }
+      return domPurifyPromise;
+    }
+
+    /**
+     * Safely parses and sanitizes untrusted HTML before rendering into the target element.
+     * Strips dangerous elements (like <script>, <iframe>) and attributes (like on* handlers).
+     * @param {HTMLElement} el Target container element
+     * @param {string} html Untrusted HTML markup string
+     */
+    export async function safeSetHTML(el, html) {
+      if (!el) return;
+      const content = html || '';
+
+      // 1. Primary native Sanitizer API method
+      if ('setHTML' in Element.prototype) {
+        try {
+          el.setHTML(content);
+          return;
+        } catch (err) {
+          console.warn('Element.prototype.setHTML threw, falling back:', err);
+        }
+      }
+
+      // 2. Native Document.parseHTML() parsing
+      if (typeof Document !== 'undefined' && 'parseHTML' in Document) {
+        try {
+          const doc = Document.parseHTML(content);
+          el.replaceChildren(...doc.body.childNodes);
+          return;
+        } catch (err) {
+          console.warn('Document.parseHTML threw, falling back:', err);
+        }
+      }
