+  <script>
+    (async function initWorldCalendarConverter() {
+      // Ensure Temporal API is available
+      if (typeof Temporal === 'undefined') {
+        try {
+          const mod = await import('https://esm.sh/temporal-polyfill/full');
+          globalThis.Temporal = mod.Temporal;
+        } catch (e) {
+          console.warn('Temporal fallback import failed:', e);
+        }
+      }
+
+      function resolveCalendarId(calendarKey) {
+        if (calendarKey === 'islamic') {
+          try {
+            Temporal.Now.plainDateISO().withCalendar('islamic');
+            return 'islamic';
+          } catch {
+            const candidates = ['islamic-civil', 'islamic-umalqura', 'islamic-tbla'];
+            for (const cand of candidates) {
+              try {
+                Temporal.Now.plainDateISO().withCalendar(cand);
+                return cand;
+              } catch {}
+            }
+          }
+        }
+        return calendarKey;
+      }
+
+      function getCalendarData(targetPlainDate, calendarKey) {
+        const calId = resolveCalendarId(calendarKey);
+        const calDate = targetPlainDate.withCalendar(calId);
+
+        const localized = calDate.toLocaleString('en-u-ca-' + calDate.calendarId, {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric',
+          era: 'long'
+        });
+
+        const convertedYear = calDate.year;
+        const numericMonth = calDate.month;
+        const monthCode = calDate.monthCode;
+        const monthsInYear = calDate.monthsInYear;
+
+        const todayInCal = Temporal.Now.plainDateISO().withCalendar(calId);
+        const comp = Temporal.PlainDate.compare(calDate, todayInCal);
+        const timeline = comp < 0 ? 'Past' : comp > 0 ? 'Future' : 'Today';
+
+        const breakdown = [];
+        for (let m = 1; m <= calDate.monthsInYear; m++) {
+          const mDate = calDate.with({ month: m, day: 1 });
+          breakdown.push({
+            month: m,
+            monthCode: mDate.monthCode,
+            daysInMonth: mDate.daysInMonth
+          });
+        }
+
+        const result = {
+          calendarKey,
+          calId: calDate.calendarId,
+          localized,
+          convertedYear,
+          numericMonth,
+          monthCode,
+          monthsInYear,
+          timeline,
+          breakdown
+        };
+
+        if (calendarKey === 'japanese') {
+          const eraStr = calDate.era ? (calDate.era.charAt(0).toUpperCase() + calDate.era.slice(1)) : '';
+          result.era = eraStr ? `${eraStr} (Year ${calDate.eraYear})` : '';
+        }
+
+        return result;
+      }
+
+      function updateCard(calendarKey, data) {
+        const prefix = calendarKey;
+
+        const localizedEl = document.getElementById(`${prefix}-localized-date`);
+        if (localizedEl) localizedEl.textContent = data.localized;
+
+        const yearEl = document.getElementById(`${prefix}-converted-year`);
+        if (yearEl) yearEl.textContent = data.convertedYear;
+
+        const monthEl = document.getElementById(`${prefix}-numeric-month`);
+        if (monthEl) monthEl.textContent = data.numericMonth;
+
+        const monthCodeEl = document.getElementById(`${prefix}-month-code`);
+        if (monthCodeEl) monthCodeEl.textContent = data.monthCode;
+
+        const totalMonthsEl = document.getElementById(`${prefix}-total-months`);
+        if (totalMonthsEl) totalMonthsEl.textContent = data.monthsInYear;
+
+        const timelineEl = document.getElementById(`${prefix}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = data.timeline;
+          timelineEl.className = `meta-value timeline-status timeline-${data.timeline.toLowerCase()}`;
+        }
+
+        if (calendarKey === 'japanese') {
+          const eraEl = document.getElementById('japanese-era-name');
+          if (eraEl) eraEl.textContent = data.era || 'N/A';
+        }
+
+        const breakdownEl = document.getElementById(`${prefix}-breakdown`);
+        if (breakdownEl) {
+          breakdownEl.innerHTML = '';
+          data.breakdown.forEach(item => {
+            const badge = document.createElement('div');
+            badge.className = 'breakdown-badge';
+            badge.innerHTML = `<span class="breakdown-code">${item.monthCode}</span><span class="breakdown-days">${item.daysInMonth} days</span>`;
+            breakdownEl.appendChild(badge);
+          });
+        }
+      }
+
+      function updateAll(isoString) {
+        if (!isoString) return;
+        try {
+          const plainDate = Temporal.PlainDate.from(isoString);
+          for (const cal of ['islamic', 'hebrew', 'japanese']) {
+            const data = getCalendarData(plainDate, cal);
+            updateCard(cal, data);
+          }
+        } catch (e) {
+          console.error('Invalid date or conversion error:', e);
+        }
+      }
+
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayBtn = document.getElementById('calendar-today-btn');
+
+      if (dateInput) {
+        const todayIso = Temporal.Now.plainDateISO().toString();
+        dateInput.value = todayIso;
+        updateAll(todayIso);
+
+        dateInput.addEventListener('input', (e) => {
+          updateAll(e.target.value);
+        });
+
+        dateInput.addEventListener('change', (e) => {
+          updateAll(e.target.value);
+        });
+      }
+
+      if (todayBtn && dateInput) {
+        todayBtn.addEventListener('click', () => {
+          const todayIso = Temporal.Now.plainDateISO().toString();
+          dateInput.value = todayIso;
+          updateAll(todayIso);
+        });
+      }
+    })();
+  </script>
