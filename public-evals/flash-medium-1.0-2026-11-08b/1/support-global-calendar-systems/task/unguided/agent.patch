+  <script src="./temporal.umd.js"></script>
+  <script>
+    (function () {
+      if (typeof Temporal === 'undefined' && typeof temporal !== 'undefined' && temporal.Temporal) {
+        window.Temporal = temporal.Temporal;
+      }
+
+      var T = window.Temporal || (typeof temporal !== 'undefined' ? temporal.Temporal : null);
+      var datePicker = document.getElementById('date-picker');
+
+      function getTodayISO() {
+        if (T && T.Now) {
+          try {
+            return T.Now.plainDateISO().toString();
+          } catch (e) {}
+        }
+        var now = new Date();
+        var y = now.getFullYear();
+        var m = String(now.getMonth() + 1).padStart(2, '0');
+        var d = String(now.getDate()).padStart(2, '0');
+        return y + '-' + m + '-' + d;
+      }
+
+      function updateCalendars(dateStr) {
+        if (!dateStr) return;
+
+        var todayStr = getTodayISO();
+        var timeframe = "Today";
+        if (dateStr < todayStr) {
+          timeframe = "Past";
+        } else if (dateStr > todayStr) {
+          timeframe = "Future";
+        }
+
+        var calendars = [
+          { id: 'islamic', containerId: 'islamic-card' },
+          { id: 'hebrew', containerId: 'hebrew-card' },
+          { id: 'japanese', containerId: 'japanese-card' }
+        ];
+
+        calendars.forEach(function (cal) {
+          var cardEl = document.getElementById(cal.containerId);
+          if (!cardEl) return;
+
+          var localizedDate = "";
+          var convertedYear = "";
+          var numericMonth = "";
+          var monthCode = "";
+          var totalMonths = 12;
+          var breakdown = [];
+          var currentMonthNum = null;
+
+          if (T && T.PlainDate) {
+            try {
+              var plainDate = T.PlainDate.from(dateStr);
+              var calDate = plainDate.withCalendar(cal.id);
+
+              localizedDate = calDate.toLocaleString("en-US-u-ca-" + cal.id, { dateStyle: "full" });
+
+              if (cal.id === "japanese") {
+                var eraName = calDate.era ? (calDate.era.charAt(0).toUpperCase() + calDate.era.slice(1)) : "";
+                convertedYear = calDate.eraYear + " (" + eraName + " " + calDate.eraYear + " / " + calDate.year + ")";
+              } else if (cal.id === "islamic") {
+                convertedYear = calDate.year + " AH";
+              } else {
+                convertedYear = String(calDate.year);
+              }
+
+              numericMonth = calDate.month;
+              monthCode = calDate.monthCode;
+              totalMonths = calDate.monthsInYear;
+              currentMonthNum = calDate.month;
+
+              for (var m = 1; m <= totalMonths; m++) {
+                var mDate = calDate.with({ month: m, day: 1 });
+                var mName = mDate.toLocaleString("en-US-u-ca-" + cal.id, { month: "long" });
+                breakdown.push({
+                  month: m,
+                  name: mName,
+                  code: mDate.monthCode,
+                  days: mDate.daysInMonth
+                });
+              }
+            } catch (err) {
+              console.error("Temporal calculation error for " + cal.id, err);
+            }
+          }
+
+          if (!localizedDate) {
+            try {
+              var partsArr = dateStr.split('-').map(Number);
+              var jsDate = new Date(Date.UTC(partsArr[0], partsArr[1] - 1, partsArr[2], 12));
+              localizedDate = new Intl.DateTimeFormat("en-US", { calendar: cal.id, dateStyle: "full" }).format(jsDate);
+              var parts = new Intl.DateTimeFormat("en-US", { calendar: cal.id, dateStyle: "full" }).formatToParts(jsDate);
+              var yPart = "";
+              var ePart = "";
+              parts.forEach(function (p) {
+                if (p.type === "year") yPart = p.value;
+                if (p.type === "era") ePart = p.value;
+              });
+              convertedYear = ePart ? (yPart + " " + ePart) : yPart;
+              numericMonth = partsArr[1];
+              monthCode = "M" + String(partsArr[1]).padStart(2, '0');
+              totalMonths = 12;
+            } catch (e) {
+              localizedDate = dateStr;
+            }
+          }
+
+          var locDateEl = cardEl.querySelector('.localized-date');
+          if (locDateEl) locDateEl.textContent = localizedDate;
+
+          var yearEl = cardEl.querySelector('.converted-year');
+          if (yearEl) yearEl.textContent = convertedYear;
+
+          var monthEl = cardEl.querySelector('.numeric-month');
+          if (monthEl) monthEl.textContent = numericMonth;
+
+          var codeEl = cardEl.querySelector('.month-code');
+          if (codeEl) codeEl.textContent = monthCode;
+
+          var totalEl = cardEl.querySelector('.total-months');
+          if (totalEl) totalEl.textContent = totalMonths;
+
+          var statusEl = cardEl.querySelector('.date-status');
+          if (statusEl) {
+            statusEl.textContent = timeframe;
+            statusEl.className = 'date-status status timeframe status-badge info-value ' + timeframe.toLowerCase();
+          }
+
+          var breakdownEl = cardEl.querySelector('.months-breakdown');
+          if (breakdownEl) {
+            if (breakdown.length > 0) {
+              var tableHtml = '<table class="breakdown-table"><thead><tr><th>Month</th><th>Code</th><th>Days</th></tr></thead><tbody>';
+              breakdown.forEach(function (item) {
+                var isCurrent = item.month === currentMonthNum;
+                tableHtml += '<tr class="month-row' + (isCurrent ? ' current-month' : '') + '" data-month-code="' + item.code + '" data-days="' + item.days + '">' +
+                  '<td class="month-name-cell">' + item.month + ' (' + item.name + ')</td>' +
+                  '<td class="month-code-cell"><code class="month-code-badge">' + item.code + '</code></td>' +
+                  '<td class="month-days-cell"><span class="day-count">' + item.days + '</span> days</td>' +
+                  '</tr>';
+              });
+              tableHtml += '</tbody></table>';
+              breakdownEl.innerHTML = tableHtml;
+            } else {
+              breakdownEl.innerHTML = '<p style="color: #8d6e63; font-size: 0.85rem;">Breakdown unavailable</p>';
+            }
+          }
+        });
+      }
+
+      var initialDate = getTodayISO();
+      if (datePicker) {
+        datePicker.value = initialDate;
+        datePicker.addEventListener('input', function () {
+          updateCalendars(datePicker.value);
+        });
+        datePicker.addEventListener('change', function () {
+          updateCalendars(datePicker.value);
+        });
+      }
+
+      updateCalendars(initialDate);
+    })();
+  </script>
+
 </body>
 
