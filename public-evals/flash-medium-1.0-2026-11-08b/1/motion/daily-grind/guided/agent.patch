+    // 1. ATTACH JAVASCRIPT ANIMATION AND TRANSITION EVENT LISTENERS
+    // Inspects the triggered animation object directly from the event to update data-last-animation-state on body
+    function handleAnimationOrTransitionEvent(event) {
+      // PREFERRED: Directly access the exact Animation object via event.animation per modern web standards
+      const animation = event.animation || (
+        'animationName' in event
+          ? event.target?.getAnimations?.()?.find?.((a) => a.animationName === event.animationName)
+          : event.target?.getAnimations?.()?.find?.((a) => a.transitionProperty === event.propertyName)
+      );
+
+      let state = animation?.playState;
+      if (!state) {
+        if (event.type.endsWith('end')) {
+          state = 'finished';
+        } else if (event.type.endsWith('cancel')) {
+          state = 'idle';
+        } else {
+          state = 'running';
+        }
+      }
+
+      document.body.setAttribute('data-last-animation-state', state);
+    }
+
+    const animationAndTransitionEvents = [
+      'animationstart',
+      'animationiteration',
+      'animationend',
+      'animationcancel',
+      'transitionrun',
+      'transitionstart',
+      'transitionend',
+      'transitioncancel'
+    ];
+
+    animationAndTransitionEvents.forEach((eventType) => {
+      document.addEventListener(eventType, handleAnimationOrTransitionEvent, { passive: true });
+    });
+
+    // 2. DAILY ROAST BANNER PAUSE / RESUME CONTROL
+    const roastBanner = document.querySelector('.daily-roast-banner');
+    const bannerToggle = document.getElementById('roast-banner-toggle');
