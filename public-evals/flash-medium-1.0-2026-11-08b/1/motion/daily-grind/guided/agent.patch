+
+    if (bannerToggle && roastBanner && tickerTrack) {
+      bannerToggle.addEventListener('click', () => {
+        const isCurrentlyPaused = roastBanner.getAttribute('data-paused') === 'true';
+        const anims = tickerTrack.getAnimations();
+        const tickerAnim = anims && anims.length > 0 ? anims[0] : null;
+
+        if (isCurrentlyPaused) {
+          // Resume ticker animation
+          roastBanner.setAttribute('data-paused', 'false');
+          bannerToggle.setAttribute('aria-pressed', 'false');
+          bannerToggle.setAttribute('aria-label', 'Pause daily roast banner');
+          bannerToggle.innerHTML = '<span class="control-icon" aria-hidden="true">⏸</span> <span class="control-text">Pause</span>';
+          if (tickerAnim) {
