+export const aaguidRegistry: Record<string, AaguidEntry> = {
+  // Google Password Manager
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': {
+    name: 'Google Password Manager',
+    icon_light: googleSvg,
+  },
+  'ad5934e0-9888-4140-ade0-88e404b067a9': {
+    name: 'Google Password Manager (Android)',
+    icon_light: googleSvg,
+  },
+
+  // Apple iCloud Keychain
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': {
+    name: 'iCloud Keychain',
+    icon_light: appleSvg,
+  },
+  'fbfc3007-154e-4ecc-8c0b-6e0200579f37': {
+    name: 'Apple Passkey',
+    icon_light: appleSvg,
+  },
+
+  // 1Password
+  'b0d5661d-752d-42a5-b544-6dd88e146034': {
+    name: '1Password',
+    icon_light: onePasswordSvg,
+  },
+
+  // Bitwarden
+  '5380b34d-3568-4734-a50b-4f107fbc1005': {
+    name: 'Bitwarden',
+    icon_light: bitwardenSvg,
+  },
+
+  // Windows Hello
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': {
+    name: 'Windows Hello',
+    icon_light: windowsHelloSvg,
+  },
+  '9f76c374-2e98-444a-9b5e-4c7b640c495e': {
+    name: 'Windows Hello',
+    icon_light: windowsHelloSvg,
+  },
+
+  // YubiKey
+  'cb69481e-8ff7-4039-93ec-0a2729a100ae': {
+    name: 'YubiKey 5 Series',
+    icon_light: yubikeySvg,
+  },
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': {
+    name: 'YubiKey 5 NFC',
+    icon_light: yubikeySvg,
+  },
+};
+
+/**
+ * Determine passkey provider details from AAGUID according to Modern Web Guidance:
+ * - Check if aaguid equals '00000000-0000-0000-0000-000000000000'
+ * - If so, skip registry lookup and set name to fallback and providerIcon to undefined
+ * - Only look up registry for non-zeroed AAGUIDs
+ */
+export function getPasskeyProviderInfo(aaguid?: string): { name: string; providerIcon?: string } {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+
+  const provider = aaguidRegistry[aaguid.toLowerCase()];
+  if (provider) {
+    return {
+      name: provider.name,
+      providerIcon: provider.icon_light,
+    };
+  }
+
+  return {
+    name: 'Passkey Provider',
+    providerIcon: undefined,
+  };
+}
diff --git a/src/lib/passkeysStore.ts b/src/lib/passkeysStore.ts
new file mode 100644
index 0000000..e7ab57c
--- /dev/null
+++ b/src/lib/passkeysStore.ts
@@ -0,0 +1,217 @@
+export interface StoredPasskeyCredential {
+  id: string; // Valid unpadded Base64URL string
+  name: string; // Custom nickname or provider name
+  aaguid: string; // Authenticator AAGUID UUID
+  registeredAt: number; // Raw epoch timestamp (ms)
+  lastUsedAt?: number; // Raw epoch timestamp (ms)
+  transports?: string[];
+  passkeyUserId: string; // Valid unpadded Base64URL string
+}
+
+export interface UserProfile {
+  id: string;
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // Username / login
+  displayName: string;
+  email: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export function toBase64Url(str: string): string {
+  const b64 = Buffer.from(str).toString('base64url');
+  return b64;
+}
+
+// Default seeded reader profile
+// passkeyUserId must be genuine unpadded Base64URL string
+const DEFAULT_USER_ID = 'usr_devtools_reader_01';
+const DEFAULT_PASSKEY_USER_ID = Buffer.from('devtools-reader-user-01').toString('base64url'); // 'ZGV2dG9vbHMtcmVhZGVyLXVzZXItMDE'
+
+const defaultUserProfile: UserProfile = {
+  id: DEFAULT_USER_ID,
+  passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+  name: 'reader@devtoolstimes.com',
+  displayName: 'Alex Morgan',
+  email: 'reader@devtoolstimes.com',
+};
+
+// Seed credentials with valid unpadded Base64URL IDs
+const defaultCredentials: StoredPasskeyCredential[] = [
+  {
+    id: Buffer.from('cred-devtools-01').toString('base64url'), // 'Y3JlZC1kZXZ0b29scy0wMQ'
+    name: 'Personal MacBook (Chrome)',
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', // Google Password Manager
+    registeredAt: Date.now() - 30 * 24 * 60 * 60 * 1000,
+    lastUsedAt: Date.now() - 2 * 24 * 60 * 60 * 1000,
+    transports: ['internal', 'hybrid'],
+    passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+  },
+  {
+    id: Buffer.from('cred-devtools-02').toString('base64url'), // 'Y3JlZC1kZXZ0b29scy0wMg'
+    name: 'iPhone 16 Pro',
+    aaguid: 'dd4ec289-e01d-41c9-bb89-70fa845d4bf2', // iCloud Keychain
+    registeredAt: Date.now() - 14 * 24 * 60 * 60 * 1000,
+    lastUsedAt: Date.now() - 1 * 24 * 60 * 60 * 1000,
+    transports: ['internal', 'hybrid'],
+    passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+  },
+  {
+    id: Buffer.from('cred-devtools-03').toString('base64url'), // 'Y3JlZC1kZXZ0b29scy0wMw'
+    name: 'Work YubiKey 5C',
+    aaguid: 'fa2b99dc-9e39-4257-8f92-4a30d23c4118', // YubiKey 5 NFC
+    registeredAt: Date.now() - 60 * 24 * 60 * 60 * 1000,
+    lastUsedAt: Date.now() - 10 * 24 * 60 * 60 * 1000,
+    transports: ['usb', 'nfc'],
+    passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+  },
+];
+
+// In-memory state
+let currentUser: UserProfile = { ...defaultUserProfile };
+let credentialsList: StoredPasskeyCredential[] = [...defaultCredentials];
+
+export function getRpId(request?: Request): string {
+  if (process.env.RP_ID) {
+    return process.env.RP_ID;
+  }
+  if (request) {
+    try {
+      const url = new URL(request.url);
+      const host = url.hostname;
+      if (host && host !== '0.0.0.0') {
+        return host;
+      }
+    } catch {}
+  }
+  return 'localhost';
+}
+
+export async function getUserProfile(session?: any): Promise<UserProfile> {
+  if (session) {
+    const sessionUser = await session.get('user');
+    if (sessionUser) return sessionUser;
+  }
+  return currentUser;
+}
+
+export async function updateUserProfile(
+  updates: { name?: string; displayName?: string },
+  session?: any
+): Promise<UserProfile> {
+  const current = await getUserProfile(session);
+  const updated: UserProfile = {
+    ...current,
+    name: updates.name?.trim() || current.name,
+    displayName: updates.displayName?.trim() || current.displayName,
+  };
+
+  currentUser = updated;
+  if (session) {
+    await session.set('user', updated);
+  }
+  return updated;
+}
+
+export async function getCredentials(userId: string, session?: any): Promise<StoredPasskeyCredential[]> {
+  if (session) {
+    const sessionCreds = await session.get('credentials');
+    if (Array.isArray(sessionCreds)) {
+      return sessionCreds.filter((c: StoredPasskeyCredential) => c.passkeyUserId === userId);
+    }
+  }
+  return credentialsList.filter((c) => c.passkeyUserId === userId);
+}
+
+export async function findCredentialById(
+  id: string,
+  session?: any
+): Promise<StoredPasskeyCredential | undefined> {
+  const all = await getCredentials(currentUser.passkeyUserId, session);
+  return all.find((c) => c.id === id);
+}
+
+export async function updateCredentialName(
+  id: string,
+  name: string,
+  session?: any
+): Promise<StoredPasskeyCredential | null> {
+  let found: StoredPasskeyCredential | null = null;
+  credentialsList = credentialsList.map((cred) => {
+    if (cred.id === id) {
+      found = { ...cred, name: name.trim() };
+      return found;
+    }
+    return cred;
+  });
+
+  if (session && found) {
+    const sessionCreds = (await session.get('credentials')) || credentialsList;
+    const updatedSessionCreds = sessionCreds.map((c: StoredPasskeyCredential) =>
+      c.id === id ? { ...c, name: name.trim() } : c
+    );
+    await session.set('credentials', updatedSessionCreds);
+  }
+
+  return found;
+}
+
+export async function deleteCredential(id: string, session?: any): Promise<boolean> {
+  const initialLength = credentialsList.length;
+  credentialsList = credentialsList.filter((c) => c.id !== id);
+
+  if (session) {
+    const sessionCreds = (await session.get('credentials')) || credentialsList;
+    await session.set(
+      'credentials',
+      sessionCreds.filter((c: StoredPasskeyCredential) => c.id !== id)
+    );
+  }
+
+  return credentialsList.length < initialLength;
+}
+
+export async function addCredential(
+  cred: {
+    id?: string;
+    name?: string;
+    aaguid?: string;
+    transports?: string[];
+  },
+  session?: any
+): Promise<StoredPasskeyCredential> {
+  const user = await getUserProfile(session);
+  let id = cred.id;
+  if (!id || !isValidBase64Url(id)) {
+    // Generate valid unpadded Base64URL
+    id = Buffer.from(`cred-dt-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`).toString('base64url');
+  }
+
+  const newCred: StoredPasskeyCredential = {
+    id,
+    name: cred.name?.trim() || 'New Passkey',
+    aaguid: cred.aaguid || '00000000-0000-0000-0000-000000000000',
+    registeredAt: Date.now(),
+    lastUsedAt: Date.now(),
+    transports: cred.transports || ['internal'],
+    passkeyUserId: user.passkeyUserId,
+  };
+
+  credentialsList.unshift(newCred);
+
+  if (session) {
+    const sessionCreds = (await session.get('credentials')) || credentialsList;
+    sessionCreds.unshift(newCred);
+    await session.set('credentials', sessionCreds);
+  }
+
+  return newCred;
+}
