+
+const windowsHelloSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="%230078D4" d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.551H10.949M0 12.6h9.75V22.05L0 20.7m10.949-8.1H24V24l-13.051-1.8"/></svg>`;
+
+const yubikeySvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="%2384BD00"/><path fill="%23FFFFFF" d="M7 6h3.2l2.3 5.4L14.8 6H18l-4.2 8.7V18h-2.8v-3.3L7 6z"/></svg>`;
+
+const bitwardenSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="%23175DDC" d="M12 2L4 5v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V5l-8-3zm0 2.18l6 2.25v4.57c0 4.47-3.05 8.65-6 9.8-2.95-1.15-6-5.33-6-9.8V6.43l6-2.25zM12 6a4 4 0 0 0-4 4v2h1v-2a3 3 0 0 1 6 0v2h1v-2a4 4 0 0 0-4-4zm-3 7v4h6v-4H9z"/></svg>`;
