+const appleSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 170 170"><path fill="%23000000" d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.72-7.89-12.06-14.56-6.1-9.35-10.95-20.13-14.54-32.34-3.6-12.21-5.4-23.75-5.4-34.62 0-14.67 3.7-26.79 11.1-36.35 7.4-9.56 16.71-14.45 27.93-14.67 4.7 0 10.12 1.25 16.27 3.75 6.15 2.5 10.05 3.8 11.69 3.92 1.63 0 5.8-1.42 12.52-4.25 6.72-2.83 12.43-4.07 17.13-3.73 13.06.65 23.47 5.75 31.24 15.31-11.53 6.96-17.18 16.53-16.96 28.71.22 9.57 3.86 17.61 10.92 24.14 7.07 6.52 15.67 10.33 25.8 11.41-2.39 7.4-5.38 14.74-8.98 22.03zM119.22 31.84c0-7.39 2.67-14.57 8.01-21.53 5.34-6.96 11.96-11.41 19.86-13.36.43 1.96.65 3.91.65 5.87 0 7.39-2.77 14.73-8.32 22.02-5.55 7.29-12.23 11.58-20.04 12.89-.11-1.74-.16-3.7-.16-5.89z"/></svg>`;
