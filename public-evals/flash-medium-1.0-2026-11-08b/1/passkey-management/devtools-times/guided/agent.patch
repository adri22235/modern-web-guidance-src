+import type { APIRoute } from 'astro';
+import {
+  getUserProfile,
+  getCredentials,
+  getRpId,
+  addCredential,
+} from '../../../lib/passkeysStore.ts';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const user = await getUserProfile(session);
+  const rpId = getRpId(request);
+  const credentials = await getCredentials(user.passkeyUserId, session);
+
+  return new Response(
+    JSON.stringify({
+      rpId,
+      userId: user.passkeyUserId,
+      credentials,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const newCred = await addCredential(body, session);
+
+    return new Response(JSON.stringify(newCred), {
+      status: 201,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to create credential' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
