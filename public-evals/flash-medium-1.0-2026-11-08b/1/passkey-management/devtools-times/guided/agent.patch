+import type { APIRoute } from 'astro';
+import {
+  getUserProfile,
+  updateUserProfile,
+  getRpId,
+} from '../../../lib/passkeysStore.ts';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const user = await getUserProfile(session);
+  const rpId = getRpId(request);
+
+  return new Response(
+    JSON.stringify({
+      ...user,
+      rpId,
+      userId: user.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  try {
+    const { name, displayName } = await request.json();
+    const updatedUser = await updateUserProfile({ name, displayName }, session);
+    const rpId = getRpId(request);
+
+    return new Response(
+      JSON.stringify({
+        ...updatedUser,
+        rpId,
+        userId: updatedUser.passkeyUserId,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to update user profile' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
