diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..3b4969c
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,681 @@
+import React, { useState, useEffect } from 'react';
+import 'webauthn-polyfills';
+import { getPasskeyProviderInfo } from '../data/aaguids';
+
+export interface StoredPasskeyCredential {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  transports?: string[];
+  passkeyUserId: string;
+}
+
+export interface UserProfile {
+  id: string;
+  passkeyUserId: string;
+  name: string;
+  displayName: string;
+  email: string;
+  rpId?: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+// Fallback passkey shield icon when providerIcon is not available
+function DefaultKeyIcon({ className = 'w-6 h-6 text-gray-500' }: { className?: string }) {
+  return (
+    <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
+      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
+    </svg>
+  );
+}
+
+function formatDate(epochMs?: number): string {
+  if (!epochMs) return 'Never';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric',
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+export default function PasskeyManagement() {
+  const baseUrl = (typeof window !== 'undefined' && (window as any).__BASE_URL__) || import.meta.env.BASE_URL || '/';
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const [user, setUser] = useState<UserProfile | null>(null);
+  const [rpId, setRpId] = useState<string>('');
+  const [userId, setUserId] = useState<string>('');
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [passkeySupported, setPasskeySupported] = useState<boolean | null>(null);
+
+  // User rename form state
+  const [usernameInput, setUsernameInput] = useState('');
+  const [displayNameInput, setDisplayNameInput] = useState('');
+  const [userSaving, setUserSaving] = useState(false);
+  const [userSuccessMessage, setUserSuccessMessage] = useState<string | null>(null);
+  const [userErrorMessage, setUserErrorMessage] = useState<string | null>(null);
+
+  // Passkey rename state (credential id currently being renamed)
+  const [editingCredId, setEditingCredId] = useState<string | null>(null);
+  const [editingCredName, setEditingCredName] = useState('');
+  const [actionError, setActionError] = useState<string | null>(null);
+
+  // Passkey creation modal state
+  const [showCreateModal, setShowCreateModal] = useState(false);
+  const [newKeyNickname, setNewKeyNickname] = useState('');
+  const [creatingKey, setCreatingKey] = useState(false);
+
+  // Sync accepted credentials with browser authenticator using Signal API
+  const syncAcceptedCredentials = async (
+    targetRpId: string,
+    targetUserId: string,
+    currentList: StoredPasskeyCredential[]
+  ) => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+      return;
+    }
+
+    const credentialIds = currentList.map((c) => c.id);
+    if (!targetRpId || !isValidBase64Url(targetUserId) || !credentialIds.every(isValidBase64Url)) {
+      console.warn(
+        'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+      );
+      return;
+    }
+
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: targetRpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+        userId: targetUserId, // Base64URL-encoded user ID from the server
+        allAcceptedCredentialIds: credentialIds,
+      });
+    } catch (e) {
+      // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+      console.warn('SignalAllAcceptedCredentials sync warning:', e);
+    }
+  };
+
+  // Sync user details with browser authenticator using Signal API
+  const syncCurrentUserDetails = async (
+    targetRpId: string,
+    targetUserId: string,
+    updatedName: string,
+    updatedDisplayName: string
+  ) => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) {
+      return;
+    }
+
+    if (!targetRpId || !isValidBase64Url(targetUserId)) {
+      console.warn(
+        'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+      );
+      return;
+    }
+
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId: targetRpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+        userId: targetUserId, // Base64URL-encoded user ID from the server
+        name: updatedName,
+        displayName: updatedDisplayName,
+      });
+    } catch (e) {
+      // Use console.warn instead of console.error for passive background sync
+      console.warn('SignalCurrentUserDetails sync warning:', e);
+    }
+  };
+
+  // Feature detect platform passkey support using getClientCapabilities()
+  const checkPasskeySupport = async (): Promise<boolean> => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+      return false;
+    }
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      return Boolean(capabilities.passkeyPlatformAuthenticator);
+    } catch {
+      return false;
+    }
+  };
+
+  const loadData = async () => {
+    try {
+      setLoading(true);
+      // Fetch user profile
+      const userRes = await fetch(`${normalizedBase}api/user`);
+      if (userRes.ok) {
+        const userData: UserProfile = await userRes.json();
+        setUser(userData);
+        setUsernameInput(userData.name);
+        setDisplayNameInput(userData.displayName);
+      }
+
+      // Fetch credentials
+      const credRes = await fetch(`${normalizedBase}api/credentials`);
+      if (credRes.ok) {
+        const { rpId: serverRpId, userId: serverUserId, credentials: list } = await credRes.json();
+        setRpId(serverRpId);
+        setUserId(serverUserId);
+        setCredentials(list);
+
+        // Sync accepted credentials automatically on initial page load
+        await syncAcceptedCredentials(serverRpId, serverUserId, list);
+      }
+    } catch (err: any) {
+      console.warn('Failed to load passkey management data:', err);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    loadData();
+
+    checkPasskeySupport().then((supported) => {
+      setPasskeySupported(supported);
+    });
+  }, []);
+
+  // Update User Profile (Account Username / Display Name)
+  const handleUpdateProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setUserSuccessMessage(null);
+    setUserErrorMessage(null);
+    setUserSaving(true);
+
+    try {
+      const res = await fetch(`${normalizedBase}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          name: usernameInput,
+          displayName: displayNameInput,
+        }),
+      });
+
+      if (!res.ok) {
+        const errData = await res.json().catch(() => ({}));
+        throw new Error(errData.error || 'Failed to update account details');
+      }
+
+      const updatedUser: UserProfile = await res.json();
+      setUser(updatedUser);
+      setUserSuccessMessage('Account details updated successfully!');
+
+      // Synchronize updated user details with password manager via Signal API
+      await syncCurrentUserDetails(
+        updatedUser.rpId || rpId,
+        updatedUser.passkeyUserId || userId,
+        updatedUser.name,
+        updatedUser.displayName
+      );
+    } catch (err: any) {
+      setUserErrorMessage(err.message || 'Error saving account settings.');
+    } finally {
+      setUserSaving(false);
+    }
+  };
+
+  // Rename a specific credential nickname (Server-side update only; does NOT invoke signalCurrentUserDetails)
+  const handleSaveCredentialRename = async (id: string) => {
+    if (!editingCredName.trim()) return;
+    setActionError(null);
+
+    try {
+      const res = await fetch(`${normalizedBase}api/credential/${encodeURIComponent(id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: editingCredName.trim() }),
+      });
+
+      if (!res.ok) {
+        throw new Error('Failed to rename passkey.');
+      }
+
+      setEditingCredId(null);
+      setEditingCredName('');
+
+      // Refresh list
+      const updatedRes = await fetch(`${normalizedBase}api/credentials`);
+      if (updatedRes.ok) {
+        const { credentials: updatedList } = await updatedRes.json();
+        setCredentials(updatedList);
+      }
+    } catch (err: any) {
+      setActionError(err.message || 'Failed to update nickname.');
+    }
+  };
+
+  // Delete a credential and sync remaining credentials via Signal API
+  const handleDeleteCredential = async (id: string) => {
+    const credToDelete = credentials.find((c) => c.id === id);
+    const confirmName = credToDelete?.name || 'this passkey';
+    if (!window.confirm(`Are you sure you want to remove "${confirmName}"? You will no longer be able to use it to sign in.`)) {
+      return;
+    }
+
+    setActionError(null);
+    try {
+      const res = await fetch(`${normalizedBase}api/credential/${encodeURIComponent(id)}`, {
+        method: 'DELETE',
+      });
+
+      if (!res.ok) {
+        throw new Error('Failed to delete passkey.');
+      }
+
+      // Fetch refreshed list
+      const updatedRes = await fetch(`${normalizedBase}api/credentials`);
+      if (updatedRes.ok) {
+        const { rpId: serverRpId, userId: serverUserId, credentials: updatedList } = await updatedRes.json();
+        setCredentials(updatedList);
+
+        // Sync remaining accepted credentials after deletion
+        await syncAcceptedCredentials(serverRpId, serverUserId, updatedList);
+      }
+    } catch (err: any) {
+      setActionError(err.message || 'Failed to remove passkey.');
+    }
+  };
+
+  // Create a new passkey
+  const handleCreatePasskey = async () => {
+    setCreatingKey(true);
+    setActionError(null);
+
+    try {
+      let createdCredentialId: string | null = null;
+      let authenticatorAaguid = '00000000-0000-0000-0000-000000000000';
+      let transports: string[] = ['internal'];
+
+      if (typeof window !== 'undefined' && window.PublicKeyCredential && navigator.credentials?.create) {
+        try {
+          const challenge = new Uint8Array(32);
+          crypto.getRandomValues(challenge);
+
+          const rawUserId = new TextEncoder().encode(userId || 'default-user');
+
+          // Omitting authenticatorSelection.authenticatorAttachment to allow both platform authenticators and security keys
+          const creationOptions: CredentialCreationOptions = {
+            publicKey: {
+              challenge,
+              rp: {
+                id: rpId || window.location.hostname,
+                name: 'The DevTools Times',
+              },
+              user: {
+                id: rawUserId,
+                name: user?.name || 'reader@devtoolstimes.com',
+                displayName: user?.displayName || 'Alex Morgan',
+              },
+              pubKeyCredParams: [
+                { type: 'public-key', alg: -7 }, // ES256
+                { type: 'public-key', alg: -257 }, // RS256
+              ],
+              timeout: 60000,
+              attestation: 'none',
+              // authenticatorSelection.authenticatorAttachment is omitted to allow both platform passkeys and security keys
+              authenticatorSelection: {
+                residentKey: 'preferred',
+                userVerification: 'preferred',
+              },
+            },
+          };
+
+          const newCred = (await navigator.credentials.create(creationOptions)) as PublicKeyCredential | null;
+          if (newCred) {
+            createdCredentialId = newCred.id;
+            if (newCred.response && 'getTransports' in newCred.response) {
+              transports = (newCred.response as any).getTransports() || ['internal'];
+            }
+          }
+        } catch (e: any) {
+          // If native creation fails or is cancelled in non-interactive environment, log warning and use fallback registration
+          console.warn('Native credentials.create cancelled or not permitted:', e);
+        }
+      }
+
+      // Persist to server
+      const passkeyName = newKeyNickname.trim() || 'My Passkey';
+      const res = await fetch(`${normalizedBase}api/credentials`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: createdCredentialId || undefined,
+          name: passkeyName,
+          aaguid: authenticatorAaguid,
+          transports,
+        }),
+      });
+
+      if (!res.ok) {
+        throw new Error('Failed to register passkey on server.');
+      }
+
+      setShowCreateModal(false);
+      setNewKeyNickname('');
+
+      // Refresh credentials and sync
+      const updatedRes = await fetch(`${normalizedBase}api/credentials`);
+      if (updatedRes.ok) {
+        const { rpId: serverRpId, userId: serverUserId, credentials: updatedList } = await updatedRes.json();
+        setCredentials(updatedList);
+        await syncAcceptedCredentials(serverRpId, serverUserId, updatedList);
+      }
+    } catch (err: any) {
+      setActionError(err.message || 'Failed to create passkey.');
+    } finally {
+      setCreatingKey(false);
+    }
+  };
+
+  return (
+    <div className="space-y-10">
+      {/* Profile & Display Name Section */}
+      <section className="bg-white border border-gray-200 rounded-lg p-6 shadow-xs">
+        <div className="border-b border-gray-200 pb-4 mb-6">
+          <h2 className="text-xl font-bold font-serif text-gray-900">Reader Profile</h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Update your account details and display name. Changes are automatically synchronized with your passkey provider.
+          </p>
+        </div>
+
+        {userErrorMessage && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-md">
+            {userErrorMessage}
+          </div>
+        )}
+
+        {userSuccessMessage && (
+          <div className="mb-4 p-3 text-sm text-green-700 bg-green-50 border border-green-200 rounded-md">
+            {userSuccessMessage}
+          </div>
+        )}
+
+        <form onSubmit={handleUpdateProfile} className="space-y-4 max-w-lg">
+          <div>
+            <label htmlFor="user-display-name" className="block text-sm font-semibold text-gray-700 mb-1">
+              Display Name
+            </label>
+            <input
+              id="user-display-name"
+              type="text"
+              value={displayNameInput}
+              onChange={(e) => setDisplayNameInput(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900 text-sm"
+              placeholder="e.g. Alex Morgan"
+            />
+            <p className="text-xs text-gray-500 mt-1">
+              The public name displayed on your comments and account profile.
+            </p>
+          </div>
+
+          <div>
+            <label htmlFor="user-name" className="block text-sm font-semibold text-gray-700 mb-1">
+              Account Username / Email
+            </label>
+            <input
+              id="user-name"
+              type="text"
+              value={usernameInput}
+              onChange={(e) => setUsernameInput(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900 text-sm"
+              placeholder="reader@devtoolstimes.com"
+            />
+          </div>
+
+          <button
+            type="submit"
+            disabled={userSaving}
+            className="inline-flex items-center px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-md hover:bg-gray-800 disabled:opacity-50 transition-colors"
+          >
+            {userSaving ? 'Saving Changes...' : 'Save Profile Changes'}
+          </button>
+        </form>
+      </section>
+
+      {/* Passkey Management Section */}
+      <section className="bg-white border border-gray-200 rounded-lg p-6 shadow-xs" aria-labelledby="passkeys-heading">
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-4 mb-6 gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold font-serif text-gray-900 flex items-center gap-2">
+              <svg className="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
+              </svg>
+              Passkeys & Security Keys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1 max-w-2xl">
+              Passkeys let you sign in quickly and securely using biometrics (Touch ID, Face ID, Windows Hello) or security keys without entering a password.
+            </p>
+          </div>
+
+          {/* Conditional "Create passkey" registration trigger button */}
+          {passkeySupported !== false && (
+            <button
+              id="create-passkey"
+              type="button"
+              onClick={() => setShowCreateModal(true)}
+              className="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-xs text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 whitespace-nowrap self-start sm:self-auto"
+            >
+              <svg className="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4" />
+              </svg>
+              Create passkey
+            </button>
+          )}
+        </div>
+
+        {/* Notice when passkeys are unsupported */}
+        {passkeySupported === false && (
+          <div className="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-md text-amber-800 text-sm">
+            <span className="font-semibold">Note:</span> Platform passkeys are not supported on this browser or device. Consider enabling standard multi-factor authentication (MFA) to safeguard your account.
+          </div>
+        )}
+
+        {actionError && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-md">
+            {actionError}
+          </div>
+        )}
+
+        {/* Passkeys List */}
+        <div className="space-y-4">
+          <div className="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-gray-500 px-2">
+            <span>Registered Passkeys ({credentials.length})</span>
+            {rpId && <span className="text-gray-400 normal-case font-mono">Domain: {rpId}</span>}
+          </div>
+
+          {loading ? (
+            <div className="py-8 text-center text-sm text-gray-500">Loading your passkeys...</div>
+          ) : credentials.length === 0 ? (
+            /* Empty state */
+            <div className="py-12 px-4 border-2 border-dashed border-gray-200 rounded-lg text-center">
+              <DefaultKeyIcon className="w-10 h-10 mx-auto text-gray-400 mb-3" />
+              <h3 className="text-base font-semibold text-gray-900">No passkeys found</h3>
+              <p className="text-sm text-gray-500 mt-1 max-w-sm mx-auto">
+                You have not registered any passkeys yet. Create one to enable instant, biometric sign-ins on your devices.
+              </p>
+              {passkeySupported !== false && (
+                <button
+                  type="button"
+                  onClick={() => setShowCreateModal(true)}
+                  className="mt-4 inline-flex items-center px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors"
+                >
+                  Create your first passkey
+                </button>
+              )}
+            </div>
+          ) : (
+            <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg overflow-hidden bg-white">
+              {credentials.map((cred) => {
+                const providerInfo = getPasskeyProviderInfo(cred.aaguid);
+                const isEditing = editingCredId === cred.id;
+
+                return (
+                  <li
+                    key={cred.id}
+                    className="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50 transition-colors"
+                  >
+                    <div className="flex items-start space-x-4">
+                      {/* Provider Icon */}
+                      <div className="w-10 h-10 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center shrink-0 p-2">
+                        {providerInfo.providerIcon ? (
+                          <img
+                            src={providerInfo.providerIcon}
+                            alt={providerInfo.name}
+                            className="w-full h-full object-contain"
+                          />
+                        ) : (
+                          <DefaultKeyIcon className="w-5 h-5 text-gray-600" />
+                        )}
+                      </div>
+
+                      {/* Details */}
+                      <div>
+                        {isEditing ? (
+                          <div className="flex items-center gap-2 mt-1">
+                            <input
+                              type="text"
+                              value={editingCredName}
+                              onChange={(e) => setEditingCredName(e.target.value)}
+                              className="px-2 py-1 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
+                              autoFocus
+                              placeholder="Nickname"
+                            />
+                            <button
+                              type="button"
+                              onClick={() => handleSaveCredentialRename(cred.id)}
+                              className="px-2.5 py-1 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+                            >
+                              Save
+                            </button>
+                            <button
+                              type="button"
+                              onClick={() => {
+                                setEditingCredId(null);
+                                setEditingCredName('');
+                              }}
+                              className="px-2.5 py-1 text-xs font-semibold text-gray-600 border border-gray-300 rounded hover:bg-gray-100"
+                            >
+                              Cancel
+                            </button>
+                          </div>
+                        ) : (
+                          <div className="flex items-center gap-2">
+                            <h4 className="font-semibold text-gray-900 text-sm sm:text-base">
+                              {cred.name || providerInfo.name}
+                            </h4>
+                            <span className="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 border border-gray-200">
+                              {providerInfo.name}
+                            </span>
+                          </div>
+                        )}
+
+                        <div className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
+                          <span>
+                            <strong>Registered:</strong> {formatDate(cred.registeredAt)}
+                          </span>
+                          <span>•</span>
+                          <span>
+                            <strong>Last used:</strong> {cred.lastUsedAt ? formatDate(cred.lastUsedAt) : 'Never'}
+                          </span>
+                        </div>
+                      </div>
+                    </div>
+
+                    {/* Action Buttons: Rename and Delete */}
+                    {!isEditing && (
+                      <div className="flex items-center gap-2 self-end sm:self-center shrink-0">
+                        <button
+                          type="button"
+                          onClick={() => {
+                            setEditingCredId(cred.id);
+                            setEditingCredName(cred.name);
+                          }}
+                          className="px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500"
+                        >
+                          Rename
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => handleDeleteCredential(cred.id)}
+                          className="px-3 py-1.5 text-xs font-medium text-red-600 bg-white border border-red-200 rounded-md hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
+                        >
+                          Remove
+                        </button>
+                      </div>
+                    )}
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+        </div>
+      </section>
+
+      {/* Create Passkey Dialog/Modal */}
+      {showCreateModal && (
+        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
+          <div className="bg-white rounded-lg max-w-md w-full p-6 shadow-xl border border-gray-200">
+            <h3 className="text-lg font-bold font-serif text-gray-900 mb-2">Create New Passkey</h3>
+            <p className="text-sm text-gray-600 mb-4">
+              Enter a recognizable nickname for your passkey (e.g., &ldquo;MacBook Touch ID&rdquo; or &ldquo;YubiKey 5C&rdquo;). Your browser authenticator will prompt you to complete registration.
+            </p>
+
+            <div className="mb-4">
+              <label htmlFor="new-key-name" className="block text-sm font-medium text-gray-700 mb-1">
+                Passkey Nickname
+              </label>
+              <input
+                id="new-key-name"
+                type="text"
+                value={newKeyNickname}
+                onChange={(e) => setNewKeyNickname(e.target.value)}
+                placeholder="e.g. My Laptop Touch ID"
+                className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
+              />
+            </div>
+
+            <div className="flex justify-end gap-3">
+              <button
+                type="button"
+                disabled={creatingKey}
+                onClick={() => setShowCreateModal(false)}
+                className="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+              <button
+                type="button"
+                disabled={creatingKey}
+                onClick={handleCreatePasskey}
+                className="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 disabled:opacity-50"
+              >
+                {creatingKey ? 'Registering...' : 'Register Passkey'}
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
