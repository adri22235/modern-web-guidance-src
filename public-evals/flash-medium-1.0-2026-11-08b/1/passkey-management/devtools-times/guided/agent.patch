--- /dev/null
+++ b/src/pages/api/credential/[id].ts
@@ -0,0 +1,73 @@
+import type { APIRoute } from 'astro';
+import {
+  getUserProfile,
+  findCredentialById,
+  updateCredentialName,
+  deleteCredential,
+} from '../../../lib/passkeysStore.ts';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = await getUserProfile(session);
+  const existing = await findCredentialById(id, session);
+  if (!existing || existing.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  try {
+    const { name } = await request.json();
+    if (typeof name !== 'string' || !name.trim()) {
+      return new Response(JSON.stringify({ error: 'Valid credential name is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const updated = await updateCredentialName(id, name, session);
+    return new Response(JSON.stringify(updated), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Invalid request body' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = await getUserProfile(session);
+  const existing = await findCredentialById(id, session);
+  if (!existing || existing.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  await deleteCredential(id, session);
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
