+          <div className="p-2.5 bg-white border border-gray-200 rounded">
+            <span className="text-gray-500 block">signalUnknownCredential</span>
+            <span
+              className={`font-semibold inline-flex items-center mt-1 ${
+                capabilities.signalUnknownCredential ? 'text-emerald-700' : 'text-gray-600'
