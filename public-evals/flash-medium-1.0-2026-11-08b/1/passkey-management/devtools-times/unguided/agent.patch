@@ -0,0 +1,139 @@
+import type { APIRoute } from 'astro';
+import type { Passkey, ReaderProfile } from '../../utils/webauthnSignals';
+
+export const DEFAULT_USER: ReaderProfile = {
+  userId: 'dXNlcl9kZXZ0b29sc19yZWFkZXI', // base64url of "user_devtools_reader"
+  username: 'reader@devtoolstimes.com',
+  displayName: 'DevTools Reader',
+};
+
+export const DEFAULT_PASSKEYS: Passkey[] = [
+  {
+    id: 'dBjftJeZ4CVP-8OnIclAtGg6xI9z3I3N3q1y0-vL_qI',
+    displayName: 'MacBook Pro (Touch ID)',
+    createdAt: '2026-09-15T09:30:00Z',
+    lastUsedAt: '2026-11-08T18:42:00Z',
+    deviceType: 'Platform Authenticator',
+    synced: true,
+    aaguid: '00000000-0000-0000-0000-000000000000',
+    transports: ['internal'],
+  },
+  {
+    id: 'T7y_G8wX2mK9vL5pQ1rS4uV7xZ0aC3eF6hI9kM2oP5s',
+    displayName: 'Pixel 9 (Google Password Manager)',
+    createdAt: '2026-10-02T14:15:00Z',
+    lastUsedAt: '2026-11-05T11:20:00Z',
+    deviceType: 'Platform Authenticator',
+    synced: true,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'aB3cD4eF5gH6iJ7kL8mN9oP0qR1sT2uV3wX4yZ5aB6c',
+    displayName: 'YubiKey 5C NFC',
+    createdAt: '2026-08-10T12:00:00Z',
+    lastUsedAt: '2026-10-18T16:05:00Z',
+    deviceType: 'Security Key',
+    synced: false,
+    aaguid: 'cb69481e-8ff7-4039-93ec-0a2729a1e67d',
+    transports: ['usb', 'nfc'],
+  },
+];
+
+export const GET: APIRoute = async ({ session }) => {
+  let user: ReaderProfile = (await session?.get('user')) || DEFAULT_USER;
+  let passkeys: Passkey[] = (await session?.get('passkeys')) || DEFAULT_PASSKEYS;
+
+  return new Response(JSON.stringify({ user, passkeys }), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action } = body;
+
+    let user: ReaderProfile = (await session?.get('user')) || { ...DEFAULT_USER };
+    let passkeys: Passkey[] = (await session?.get('passkeys')) || [...DEFAULT_PASSKEYS];
+
+    switch (action) {
+      case 'update_user_display_name': {
+        const { displayName } = body;
+        if (typeof displayName === 'string' && displayName.trim()) {
+          user.displayName = displayName.trim();
+          await session?.set('user', user);
+        }
+        break;
+      }
+
+      case 'update_passkey_name': {
+        const { id, displayName } = body;
+        if (id && typeof displayName === 'string' && displayName.trim()) {
+          passkeys = passkeys.map((k) => (k.id === id ? { ...k, displayName: displayName.trim() } : k));
+          await session?.set('passkeys', passkeys);
+        }
+        break;
+      }
+
+      case 'remove_passkey': {
+        const { id } = body;
+        if (id) {
+          passkeys = passkeys.filter((k) => k.id !== id);
+          await session?.set('passkeys', passkeys);
+        }
+        break;
+      }
+
+      case 'add_passkey': {
+        const { passkey } = body;
+        if (passkey && passkey.id) {
+          // If already exists, replace; else prepend
+          const exists = passkeys.some((k) => k.id === passkey.id);
+          if (exists) {
+            passkeys = passkeys.map((k) => (k.id === passkey.id ? passkey : k));
+          } else {
+            passkeys = [passkey, ...passkeys];
+          }
+          await session?.set('passkeys', passkeys);
+        }
+        break;
+      }
+
+      case 'login': {
+        if (body.user) {
+          user = {
+            userId: body.user.userId || DEFAULT_USER.userId,
+            username: body.user.username || DEFAULT_USER.username,
+            displayName: body.user.displayName || body.user.username || DEFAULT_USER.displayName,
+          };
+          await session?.set('user', user);
+        }
+        break;
+      }
+
+      case 'reset_default': {
+        user = { ...DEFAULT_USER };
+        passkeys = [...DEFAULT_PASSKEYS];
+        await session?.set('user', user);
+        await session?.set('passkeys', passkeys);
+        break;
+      }
+
+      default:
+        return new Response(JSON.stringify({ error: `Unknown action: ${action}` }), {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        });
+    }
+
+    return new Response(JSON.stringify({ success: true, user, passkeys }), {
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
