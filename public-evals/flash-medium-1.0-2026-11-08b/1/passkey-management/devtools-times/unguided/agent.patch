diff --git a/src/components/HeaderAccountNav.tsx b/src/components/HeaderAccountNav.tsx
new file mode 100644
index 0000000..8e52576
--- /dev/null
+++ b/src/components/HeaderAccountNav.tsx
@@ -0,0 +1,94 @@
+import React, { useState, useEffect } from 'react';
+
+interface HeaderAccountNavProps {
+  baseUrl: string;
+}
+
+export default function HeaderAccountNav({ baseUrl }: HeaderAccountNavProps) {
+  const [user, setUser] = useState<{ displayName: string; username: string } | null>(null);
+
+  useEffect(() => {
+    const checkUser = () => {
+      try {
+        const stored = localStorage.getItem('user');
+        if (stored) {
+          const parsed = JSON.parse(stored);
+          if (parsed && (parsed.displayName || parsed.username)) {
+            setUser(parsed);
+            return;
+          }
+        }
+      } catch {
+        // fallback
+      }
+      setUser(null);
+    };
+
+    checkUser();
+    window.addEventListener('storage', checkUser);
+    return () => window.removeEventListener('storage', checkUser);
+  }, []);
+
+  const handleSignOut = async (e: React.MouseEvent) => {
+    e.preventDefault();
+    localStorage.removeItem('user');
+    setUser(null);
+    try {
+      await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset_default' }),
+      });
+    } catch {
+      // ignore
+    }
+    window.location.href = `${baseUrl}`;
+  };
+
+  return (
+    <div className="flex items-center space-x-2">
+      <a
+        href={`${baseUrl}account/settings`}
+        data-skip-tracking="true"
+        className="bg-gray-100 text-gray-800 text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-200 border border-gray-300 flex items-center space-x-1.5 transition"
+        title="Manage account settings and passkeys"
+      >
+        <svg className="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+          <path
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            strokeWidth="2"
+            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
+          />
+        </svg>
+        <span>{user ? user.displayName || user.username : 'Account Settings'}</span>
+      </a>
+
+      {user ? (
+        <button
+          onClick={handleSignOut}
+          className="text-gray-500 hover:text-gray-700 text-xs font-semibold py-2 px-2 hover:underline"
+        >
+          Sign out
+        </button>
+      ) : (
+        <>
+          <a
+            href={`${baseUrl}signup`}
+            data-skip-tracking="true"
+            className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+          >
+            Sign up
+          </a>
+          <a
+            href={`${baseUrl}signin`}
+            data-skip-tracking="true"
+            className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+          >
+            Sign in
+          </a>
+        </>
+      )}
+    </div>
+  );
+}
