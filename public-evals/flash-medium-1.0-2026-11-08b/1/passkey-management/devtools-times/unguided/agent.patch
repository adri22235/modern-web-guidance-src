+                  capabilities.signalAllAcceptedCredentials ? 'bg-emerald-500' : 'bg-gray-400'
+                }`}
+              ></span>
+              {capabilities.signalAllAcceptedCredentials ? 'Active / Supported' : 'Simulated / Safe Fallback'}
+            </span>
+          </div>
+
+          <div className="p-2.5 bg-white border border-gray-200 rounded">
