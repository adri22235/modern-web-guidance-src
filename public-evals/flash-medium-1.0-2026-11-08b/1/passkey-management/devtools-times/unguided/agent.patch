+                        : 'bg-gray-100 text-gray-600'
+                    }`}
+                  >
+                    {log.method}
+                  </span>
+                  <span className="text-gray-600">{log.details}</span>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      </section>
+    </div>
+  );
+}
