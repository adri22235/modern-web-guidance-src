+            >
+              <span
+                className={`w-2 h-2 rounded-full mr-1.5 ${
+                  capabilities.signalUnknownCredential ? 'bg-emerald-500' : 'bg-gray-400'
+                }`}
+              ></span>
+              {capabilities.signalUnknownCredential ? 'Active / Supported' : 'Simulated / Safe Fallback'}
+            </span>
+          </div>
+        </div>
+
+        {/* Signal Activity Log */}
+        <div className="mt-4">
+          <h4 className="text-xs font-semibold text-gray-700 mb-2">WebAuthn Signal Activity Log:</h4>
+          {signalLogs.length === 0 ? (
+            <p className="text-xs text-gray-400 italic">
+              No signal events triggered yet in this session. Updating display names or removing keys
+              will log WebAuthn Signal calls here.
+            </p>
+          ) : (
+            <div className="max-h-40 overflow-y-auto space-y-1.5 border border-gray-200 rounded bg-white p-2">
+              {signalLogs.map((log) => (
+                <div
+                  key={log.id}
+                  className="text-[11px] font-mono flex items-start space-x-2 text-gray-700"
+                >
+                  <span className="text-gray-400 shrink-0">[{log.timestamp}]</span>
+                  <span
+                    className={`px-1 py-0.2 rounded font-bold shrink-0 text-[10px] ${
