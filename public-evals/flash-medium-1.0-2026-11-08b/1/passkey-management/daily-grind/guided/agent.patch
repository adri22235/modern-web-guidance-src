+
+/**
+ * Determine provider name and icon from AAGUID according to modern web guidance:
+ * Before looking up the AAGUID in the registry, check if it equals '00000000-0000-0000-0000-000000000000'.
+ * If so, skip the registry lookup and set name to a fallback and providerIcon to undefined/fallback.
+ */
+export function getProviderInfo(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Security Key (Hardware Authenticator)',
+      icon: DEFAULT_PASSKEY_ICON
+    };
+  }
+  const provider = aaguids[aaguid];
+  if (provider) {
+    return {
+      name: provider.name,
+      icon: provider.icon_light || provider.icon_dark || DEFAULT_PASSKEY_ICON
+    };
+  }
+  return {
+    name: 'Unknown passkey provider',
+    icon: DEFAULT_PASSKEY_ICON
+  };
+}
+
+export default aaguids;
