+++ b/passkey-management.js
@@ -0,0 +1,519 @@
+/**
+ * passkey-management.js
+ * Passkey Management UI with WebAuthn Signal API synchronization.
+ * Compliant with modern web standards and guidelines.
+ */
+
+import {
+  listFetch,
+  renameCredentialFetch,
+  deleteFetch,
+  updateUserFetch,
+  saveNewCredentialFetch,
+  isValidBase64Url,
+} from './api.js';
+import { getProviderInfo } from './aaguids.js';
+
+// Cached server state
+let serverRpId = '';
+let serverUserId = '';
+let currentCredentials = [];
+let pendingActionCredentialId = null;
+
+/**
+ * Format raw epoch timestamp into a human-readable date and time.
+ */
+function formatDate(timestamp) {
+  if (!timestamp) return 'Never';
+  try {
+    const d = new Date(timestamp);
+    if (isNaN(d.getTime())) return 'Unknown date';
+    return new Intl.DateTimeFormat(undefined, {
+      dateStyle: 'medium',
+      timeStyle: 'short',
+    }).format(d);
+  } catch {
+    return new Date(timestamp).toLocaleDateString();
+  }
+}
+
+/**
+ * Synchronize accepted credentials with the user's password manager via Signal API.
+ * Uses the server-provided rpId (never window.location.hostname directly).
+ */
+export async function syncAcceptedCredentials(rpId, userId, currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    return;
+  }
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    // Non-fatal background sync: use console.warn to avoid Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+/**
+ * Perform credential rename on the server.
+ * Note: Renaming a passkey's nickname updates the server record only and does NOT invoke signalCurrentUserDetails().
+ */
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, { name: newCredentialName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const data = await updatedResponse.json();
+    currentCredentials = data.credentials || [];
+    renderUI(currentCredentials);
+    showToast('Passkey renamed successfully');
+  } else {
+    showToast('Failed to rename passkey', 'error');
+  }
+}
+
+/**
+ * Perform credential deletion and synchronize remaining credentials with the browser/authenticator.
+ */
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const data = await updatedResponse.json();
+    serverRpId = data.rpId || serverRpId;
+    serverUserId = data.userId || serverUserId;
+    currentCredentials = data.credentials || [];
+
+    renderUI(currentCredentials);
+    showToast('Passkey removed and authenticator synced');
+
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(serverRpId, serverUserId, currentCredentials);
+  } else {
+    showToast('Failed to delete passkey', 'error');
+  }
+}
+
+/**
+ * Update user account name/displayName and synchronize details with the passkey provider.
+ */
+export async function performUserRename(updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({
+    name: updatedName,
+    displayName: updatedDisplayName,
+  });
+  if (response.ok) {
+    showToast('Account details updated');
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      const data = await response.json();
+      const rpId = data.rpId || serverRpId;
+      const userId = data.userId || serverUserId;
+      if (!rpId || !isValidBase64Url(userId)) {
+        console.warn(
+          'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+        );
+        return;
+      }
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId, // Always use server-provided rpId
+          userId, // Base64URL-encoded user ID
+          name: updatedName,
+          displayName: updatedDisplayName,
+        });
+      } catch (e) {
+        console.warn('SignalCurrentUserDetails sync warning:', e);
+      }
+    }
+  } else {
+    showToast('Failed to update account details', 'error');
+  }
+}
+
+/**
+ * Feature detection for passkey support using getClientCapabilities().
+ */
+export async function isPasskeySupported() {
+  if (!window.PublicKeyCredential) {
+    return false;
+  }
+  if (PublicKeyCredential.getClientCapabilities) {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      return Boolean(capabilities?.passkeyPlatformAuthenticator);
+    } catch {
+      return false;
+    }
+  }
+  if (PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable) {
+    try {
+      return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+/**
+ * Register a new passkey using navigator.credentials.create().
+ * Omits authenticatorSelection.authenticatorAttachment to support both platform passkeys and security keys.
+ */
+export async function createPasskey() {
+  if (!window.PublicKeyCredential) {
+    showToast('WebAuthn is not supported in this browser', 'error');
+    return;
+  }
+
+  const challenge = new Uint8Array(32);
+  crypto.getRandomValues(challenge);
+
+  // Derive binary user ID from Base64URL string or generate
+  const userBytes = new TextEncoder().encode(serverUserId || 'default-user');
+
+  const creationOptions = {
+    publicKey: {
+      challenge,
+      rp: {
+        name: 'The Daily Grind',
+        id: serverRpId || window.location.hostname || 'localhost',
+      },
+      user: {
+        id: userBytes,
+        name: document.getElementById('account-username')?.value || 'customer@dailygrind.com',
+        displayName:
+          document.getElementById('account-display-name')?.value || 'Daily Grind Customer',
+      },
+      pubKeyCredParams: [
+        { alg: -7, type: 'public-key' }, // ES256
+        { alg: -257, type: 'public-key' }, // RS256
+      ],
+      timeout: 60000,
+      authenticatorSelection: {
+        // Omitting authenticatorAttachment to allow security keys as well as platform authenticators
+        userVerification: 'preferred',
+        residentKey: 'preferred',
+      },
+      attestation: 'none',
+    },
+  };
+
+  try {
+    const cred = await navigator.credentials.create(creationOptions);
+    if (cred) {
+      // Encode credential ID as unpadded Base64URL
+      const rawId = new Uint8Array(cred.rawId);
+      let binary = '';
+      for (let i = 0; i < rawId.byteLength; i++) {
+        binary += String.fromCharCode(rawId[i]);
+      }
+      const base64urlId = btoa(binary)
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+
+      // Check AAGUID if present in response
+      let aaguid = '00000000-0000-0000-0000-000000000000';
+      if (cred.response && cred.response.getAuthenticatorData) {
+        try {
+          const authData = new Uint8Array(cred.response.getAuthenticatorData());
+          if (authData.length >= 53) {
+            // AAGUID is 16 bytes at offset 37
+            const aaguidBytes = authData.slice(37, 53);
+            const hex = Array.from(aaguidBytes, (b) => b.toString(16).padStart(2, '0')).join('');
+            aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+          }
+        } catch {}
+      }
+
+      const providerInfo = getProviderInfo(aaguid);
+      const nickname = prompt('Enter a nickname for your new passkey:', providerInfo.name) || providerInfo.name;
+
+      const newRecord = {
+        id: base64urlId,
+        name: nickname,
+        aaguid,
+        registeredAt: Date.now(),
+        lastUsedAt: Date.now(),
+      };
+
+      await saveNewCredentialFetch(newRecord);
+      const updatedResponse = await listFetch();
+      const data = await updatedResponse.json();
+      currentCredentials = data.credentials || [];
+      renderUI(currentCredentials);
+      showToast('Passkey created successfully!');
+
+      await syncAcceptedCredentials(serverRpId, serverUserId, currentCredentials);
+    }
+  } catch (err) {
+    if (err.name !== 'NotAllowedError') {
+      console.warn('Passkey creation error:', err);
+      showToast('Passkey creation cancelled or failed', 'error');
+    }
+  }
+}
+
+/**
+ * Render the list of passkeys into the container.
+ */
+export function renderUI(credentials) {
+  const container = document.getElementById('passkeys-list-container');
+  const emptyState = document.getElementById('passkeys-empty-state');
+  if (!container) return;
+
+  if (!credentials || credentials.length === 0) {
+    container.innerHTML = '';
+    if (emptyState) {
+      emptyState.hidden = false;
+    } else {
+      container.innerHTML = '<p class="empty-state">No passkeys found</p>';
+    }
+    return;
+  }
+
+  if (emptyState) {
+    emptyState.hidden = true;
+  }
+
+  const listHtml = credentials
+    .map((cred) => {
+      const provider = getProviderInfo(cred.aaguid);
+      const iconSrc = cred.providerIcon || provider.icon;
+      const providerName = provider.name;
+      const registeredDate = formatDate(cred.registeredAt);
+      const lastUsedDate = formatDate(cred.lastUsedAt);
+
+      return `
+      <div class="passkey-row" data-id="${escapeHtml(cred.id)}">
+        <div class="passkey-main-info">
+          <img class="provider-icon" src="${escapeHtml(iconSrc)}" alt="${escapeHtml(providerName)} icon" width="32" height="32" />
+          <div class="passkey-details">
+            <div class="passkey-name-line">
+              <strong class="passkey-name">${escapeHtml(cred.name || providerName)}</strong>
+              <span class="passkey-provider-badge">${escapeHtml(providerName)}</span>
+            </div>
+            <div class="passkey-meta">
+              <span class="meta-item">Created: <time datetime="${new Date(cred.registeredAt || Date.now()).toISOString()}">${escapeHtml(registeredDate)}</time></span>
+              <span class="meta-separator">&bull;</span>
+              <span class="meta-item">Last used: <time>${escapeHtml(lastUsedDate)}</time></span>
+            </div>
+          </div>
+        </div>
+        <div class="passkey-actions">
+          <button type="button" class="btn btn-secondary btn-rename" data-id="${escapeHtml(cred.id)}" data-name="${escapeHtml(cred.name || providerName)}">
+            Rename
+          </button>
+          <button type="button" class="btn btn-danger btn-delete" data-id="${escapeHtml(cred.id)}" data-name="${escapeHtml(cred.name || providerName)}">
+            Delete
+          </button>
+        </div>
+      </div>
+    `;
+    })
+    .join('');
+
+  container.innerHTML = listHtml;
+}
+
+function escapeHtml(str) {
+  if (typeof str !== 'string') return '';
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#039;');
+}
+
+function showToast(message, type = 'success') {
+  const toast = document.getElementById('passkey-toast');
+  if (!toast) return;
+  toast.textContent = message;
+  toast.className = `toast toast-${type} toast-visible`;
+  setTimeout(() => {
+    toast.className = 'toast toast-hidden';
+  }, 3500);
+}
+
+/**
+ * Initialize Passkey Management panel on page load.
+ */
+export async function loadManagementPanel() {
+  try {
+    const response = await listFetch();
+    const data = await response.json();
+    serverRpId = data.rpId;
+    serverUserId = data.userId;
+    currentCredentials = data.credentials || [];
+
+    // Pre-fill user profile fields if available
+    const usernameInput = document.getElementById('account-username');
+    const displayNameInput = document.getElementById('account-display-name');
+    if (usernameInput && !usernameInput.value) {
+      usernameInput.value = 'alex.chen@example.com';
+    }
+    if (displayNameInput && !displayNameInput.value) {
+      displayNameInput.value = 'Alex Chen';
+    }
+
+    renderUI(currentCredentials);
+
+    // Feature detect platform passkey support for Create Passkey button
+    const createButton = document.getElementById('create-passkey');
+    const unsupportedNotice = document.getElementById('passkey-unsupported-notice');
+    const passkeySupported = await isPasskeySupported();
+    if (!passkeySupported) {
+      if (createButton) createButton.hidden = true;
+      if (unsupportedNotice) unsupportedNotice.hidden = false;
+    } else {
+      if (createButton) createButton.hidden = false;
+      if (unsupportedNotice) unsupportedNotice.hidden = true;
+    }
+
+    // Sync accepted credentials on initial load using server-provided rpId and userId
+    await syncAcceptedCredentials(serverRpId, serverUserId, currentCredentials);
+  } catch (err) {
+    console.warn('Failed to load passkeys management panel:', err);
+  }
+}
+
+/**
+ * Setup event listeners for the passkey management UI.
+ */
+export function setupEventListeners() {
+  const container = document.getElementById('passkeys-list-container');
+  const createButton = document.getElementById('create-passkey');
+  const renameDialog = document.getElementById('rename-dialog');
+  const renameForm = document.getElementById('rename-form');
+  const renameInput = document.getElementById('rename-input');
+  const renameCancelBtn = document.getElementById('rename-cancel-btn');
+
+  const deleteDialog = document.getElementById('delete-dialog');
+  const deleteForm = document.getElementById('delete-form');
+  const deleteCancelBtn = document.getElementById('delete-cancel-btn');
+  const deletePasskeyNameSpan = document.getElementById('delete-passkey-name');
+
+  const userAccountForm = document.getElementById('user-account-form');
+
+  // Event delegation on credential rows
+  if (container) {
+    container.addEventListener('click', (e) => {
+      const target = e.target;
+      if (!(target instanceof HTMLElement)) return;
+
+      const renameBtn = target.closest('.btn-rename');
+      if (renameBtn) {
+        const id = renameBtn.getAttribute('data-id');
+        const name = renameBtn.getAttribute('data-name') || '';
+        pendingActionCredentialId = id;
+        if (renameDialog && renameInput) {
+          renameInput.value = name;
+          renameDialog.showModal();
+        } else {
+          const newName = prompt('Enter new nickname for this passkey:', name);
+          if (newName && newName.trim()) {
+            performCredentialRename(id, newName.trim());
+          }
+        }
+        return;
+      }
+
+      const deleteBtn = target.closest('.btn-delete');
+      if (deleteBtn) {
+        const id = deleteBtn.getAttribute('data-id');
+        const name = deleteBtn.getAttribute('data-name') || 'this passkey';
+        pendingActionCredentialId = id;
+        if (deleteDialog) {
+          if (deletePasskeyNameSpan) deletePasskeyNameSpan.textContent = `"${name}"`;
+          deleteDialog.showModal();
+        } else {
+          if (confirm(`Are you sure you want to delete passkey "${name}"?`)) {
+            performDelete(id);
+          }
+        }
+      }
+    });
+  }
+
+  // Rename Dialog actions
+  if (renameForm && renameDialog) {
+    renameForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const newName = renameInput?.value?.trim();
+      if (pendingActionCredentialId && newName) {
+        performCredentialRename(pendingActionCredentialId, newName);
+      }
+      renameDialog.close();
+      pendingActionCredentialId = null;
+    });
+
+    if (renameCancelBtn) {
+      renameCancelBtn.addEventListener('click', () => {
+        renameDialog.close();
+        pendingActionCredentialId = null;
+      });
+    }
+  }
+
+  // Delete Dialog actions
+  if (deleteForm && deleteDialog) {
+    deleteForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (pendingActionCredentialId) {
+        performDelete(pendingActionCredentialId);
+      }
+      deleteDialog.close();
+      pendingActionCredentialId = null;
+    });
+
+    if (deleteCancelBtn) {
+      deleteCancelBtn.addEventListener('click', () => {
+        deleteDialog.close();
+        pendingActionCredentialId = null;
+      });
+    }
+  }
+
+  // Create passkey button
+  if (createButton) {
+    createButton.addEventListener('click', () => {
+      createPasskey();
+    });
+  }
+
+  // User profile rename form
+  if (userAccountForm) {
+    userAccountForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const usernameInput = document.getElementById('account-username');
+      const displayNameInput = document.getElementById('account-display-name');
+      const updatedName = usernameInput?.value?.trim();
+      const updatedDisplayName = displayNameInput?.value?.trim();
+      if (updatedName && updatedDisplayName) {
+        performUserRename(updatedName, updatedDisplayName);
+      }
+    });
+  }
+}
+
+// Auto-initialize when DOM is ready
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', () => {
+    setupEventListeners();
+    loadManagementPanel();
+  });
+} else {
+  setupEventListeners();
+  loadManagementPanel();
+}
