@@ -0,0 +1,225 @@
+/**
+ * api.js - Passkey & User Credentials API client
+ * Conforms to modern WebAuthn Passkey Management specification.
+ */
+
+export function isValidBase64Url(value) {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+const STORAGE_KEY_CREDS = 'daily_grind_passkey_credentials';
+const STORAGE_KEY_USER = 'daily_grind_user_account';
+
+function getDefaultRpId() {
+  if (typeof window !== 'undefined' && window.location && window.location.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+function getInitialUser() {
+  return {
+    userId: 'dXNlcl9kZ19jdXN0b21lcl80Mg', // unpadded Base64URL string
+    name: 'alex.chen@example.com',
+    displayName: 'Alex Chen',
+  };
+}
+
+function getInitialCredentials() {
+  return [
+    {
+      id: 'Y3JlZF9tYWNib29rX3RvdWNoaWQ', // unpadded Base64URL string
+      name: 'MacBook Touch ID',
+      aaguid: 'dd482d74-5e03-4734-90cf-bda8e6739c42',
+      registeredAt: 1704067200000,
+      lastUsedAt: 1709251200000,
+    },
+    {
+      id: 'Y3JlZF9waXhlbF9maW5nZXJwcmludA', // unpadded Base64URL string
+      name: 'Pixel 8 Pro',
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: 1706745600000,
+      lastUsedAt: 1709164800000,
+    },
+  ];
+}
+
+class LocalCredentialStore {
+  constructor() {
+    this._load();
+  }
+
+  _load() {
+    if (typeof localStorage === 'undefined') {
+      this.user = getInitialUser();
+      this.credentials = getInitialCredentials();
+      return;
+    }
+    try {
+      const storedUser = localStorage.getItem(STORAGE_KEY_USER);
+      this.user = storedUser ? JSON.parse(storedUser) : getInitialUser();
+    } catch {
+      this.user = getInitialUser();
+    }
+    try {
+      const storedCreds = localStorage.getItem(STORAGE_KEY_CREDS);
+      this.credentials = storedCreds ? JSON.parse(storedCreds) : getInitialCredentials();
+    } catch {
+      this.credentials = getInitialCredentials();
+    }
+  }
+
+  _save() {
+    if (typeof localStorage === 'undefined') return;
+    try {
+      localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(this.user));
+      localStorage.setItem(STORAGE_KEY_CREDS, JSON.stringify(this.credentials));
+    } catch (e) {
+      console.warn('LocalStorage save failed:', e);
+    }
+  }
+
+  getPayload() {
+    return {
+      rpId: getDefaultRpId(),
+      userId: this.user.userId,
+      credentials: [...this.credentials],
+    };
+  }
+
+  renameCredential(id, newName) {
+    const cred = this.credentials.find((c) => c.id === id);
+    if (!cred) return null;
+    cred.name = newName;
+    this._save();
+    return { ...cred };
+  }
+
+  deleteCredential(id) {
+    const initialLen = this.credentials.length;
+    this.credentials = this.credentials.filter((c) => c.id !== id);
+    this._save();
+    return this.credentials.length < initialLen;
+  }
+
+  updateUser(name, displayName) {
+    if (name) this.user.name = name;
+    if (displayName) this.user.displayName = displayName;
+    this._save();
+    return {
+      ...this.user,
+      rpId: getDefaultRpId(),
+    };
+  }
+
+  addCredential(cred) {
+    this.credentials.push(cred);
+    this._save();
+    return { ...cred };
+  }
+}
+
+export const mockStore = new LocalCredentialStore();
+
+function jsonResponse(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+/**
+ * Fetch all registered passkeys for the signed-in user alongside server rpId and userId.
+ */
+export async function listFetch() {
+  try {
+    const res = await fetch('/api/credentials');
+    if (res.ok) return res;
+  } catch (err) {
+    // Network error or offline - fallback to mock store
+  }
+  return jsonResponse(mockStore.getPayload());
+}
+
+/**
+ * Update the custom nickname of a specific credential.
+ * Renaming an individual passkey is a server-side label change and does NOT invoke signalCurrentUserDetails().
+ */
+export async function renameCredentialFetch(id, { name }) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(id)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+    if (res.ok) return res;
+  } catch (err) {
+    // Fallback to mock store
+  }
+  const updated = mockStore.renameCredential(id, name);
+  if (!updated) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  return jsonResponse(updated);
+}
+
+/**
+ * Delete a credential by ID.
+ */
+export async function deleteFetch(id) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(id)}`, {
+      method: 'DELETE',
+    });
+    if (res.ok) return res;
+  } catch (err) {
+    // Fallback to mock store
+  }
+  const deleted = mockStore.deleteCredential(id);
+  if (!deleted) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  return jsonResponse({ success: true });
+}
+
+/**
+ * Update user account name and displayName.
+ * Synchronizes with password managers via PublicKeyCredential.signalCurrentUserDetails().
+ */
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    const res = await fetch('/api/user', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name, displayName }),
+    });
+    if (res.ok) return res;
+  } catch (err) {
+    // Fallback to mock store
+  }
+  const updated = mockStore.updateUser(name, displayName);
+  return jsonResponse(updated);
+}
+
+/**
+ * Register a newly created passkey in the store.
+ */
+export async function saveNewCredentialFetch(credential) {
+  try {
+    const res = await fetch('/api/credentials', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credential),
+    });
+    if (res.ok) return res;
+  } catch (err) {
+    // Fallback to mock store
+  }
+  const saved = mockStore.addCredential(credential);
+  return jsonResponse(saved);
+}
