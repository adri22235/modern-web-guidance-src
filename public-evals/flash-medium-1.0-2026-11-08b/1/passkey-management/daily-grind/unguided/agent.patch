+      /**
+       * Core WebAuthn Signal API Synchronization
+       * Keeps the browser's passkey authenticator in sync when credentials are deleted or updated.
+       */
+      async function syncAuthenticator(remainingPasskeys, deletedKeyId = null, actionDescription = "Sync") {
+        const now = new Date();
+        const timeFormatted = now.toLocaleTimeString();
+        const allAcceptedCredentialIds = remainingPasskeys.map(k => k.id);
+        const rpId = effectiveRpId;
+        const userId = CURRENT_CUSTOMER.id;
+
+        const audit = {
+          timestamp: now.toISOString(),
+          timeFormatted: timeFormatted,
+          action: actionDescription,
+          rpId: rpId,
+          userId: userId,
+          remainingCount: allAcceptedCredentialIds.length,
+          remainingIds: allAcceptedCredentialIds,
+          deletedKeyId: deletedKeyId,
+          signalAllAcceptedCredentialsCalled: false,
+          signalUnknownCredentialCalled: false,
+          signalCurrentUserDetailsCalled: false,
+          supported: false,
+          status: "completed"
+        };
+
+        // Check WebAuthn Signal API support
+        if (typeof window !== "undefined" && window.PublicKeyCredential) {
+          audit.supported = true;
+
+          // 1. Check client capabilities if available
+          if (typeof PublicKeyCredential.getClientCapabilities === "function") {
+            try {
+              const caps = await PublicKeyCredential.getClientCapabilities();
+              audit.capabilities = caps;
+            } catch (capErr) {
+              console.debug("WebAuthn getClientCapabilities note:", capErr);
+            }
+          }
+
+          // 2. Authoritative sync via signalAllAcceptedCredentials
+          // When a passkey is deleted on the server/site, the RP provides the full list of remaining
+          // valid credential IDs for this user so the authenticator purges any stale credentials.
+          if (typeof PublicKeyCredential.signalAllAcceptedCredentials === "function") {
+            try {
+              audit.signalAllAcceptedCredentialsCalled = true;
+              await PublicKeyCredential.signalAllAcceptedCredentials({
+                rpId: rpId,
+                userId: userId,
+                allAcceptedCredentialIds: allAcceptedCredentialIds
+              });
+              console.info("[WebAuthn Signal API] signalAllAcceptedCredentials successfully synchronized", {
+                rpId,
+                userId,
+                allAcceptedCredentialIds
+              });
+            } catch (signalErr) {
+              console.warn("[WebAuthn Signal API] signalAllAcceptedCredentials notice:", signalErr);
+              audit.signalAllAcceptedCredentialsError = signalErr.message || String(signalErr);
+            }
+          }
+
+          // 3. If a specific credential was deleted, also send signalUnknownCredential
+          // so authenticators that support targeted credential eviction remove it immediately.
+          if (deletedKeyId && typeof PublicKeyCredential.signalUnknownCredential === "function") {
+            try {
+              audit.signalUnknownCredentialCalled = true;
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId,
+                credentialId: deletedKeyId
+              });
+              console.info("[WebAuthn Signal API] signalUnknownCredential signaled for deleted credential:", deletedKeyId);
+            } catch (unknownErr) {
+              console.warn("[WebAuthn Signal API] signalUnknownCredential notice:", unknownErr);
+              audit.signalUnknownCredentialError = unknownErr.message || String(unknownErr);
+            }
+          }
+
+          // 4. Signal updated user details if needed
+          if (typeof PublicKeyCredential.signalCurrentUserDetails === "function") {
+            try {
+              audit.signalCurrentUserDetailsCalled = true;
+              await PublicKeyCredential.signalCurrentUserDetails({
+                rpId: rpId,
+                userId: userId,
+                name: CURRENT_CUSTOMER.email,
+                displayName: CURRENT_CUSTOMER.name
+              });
+            } catch (userErr) {
+              console.debug("[WebAuthn Signal API] signalCurrentUserDetails notice:", userErr);
+            }
+          }
+        }
+
+        // Store latest sync results and dispatch event for programmatic checks
+        window.latestPasskeySync = audit;
+        window.dispatchEvent(new CustomEvent("passkey-authenticator-synced", { detail: audit }));
+        appendAuditLog(audit);
+
+        // Update UI banner text
+        if (syncStatusMessage) {
+          syncStatusMessage.textContent = `— Synced with authenticator at ${timeFormatted}`;
+        }
+        if (syncDetailsText) {
+          syncDetailsText.textContent = `${allAcceptedCredentialIds.length} valid passkey(s) acknowledged by Relying Party (${rpId}). Authenticator in sync.`;
+        }
+
+        return audit;
+      }
+
+      // Render Audit Log entries
+      function renderAuditLogs() {
+        if (!syncAuditBody) return;
+        const logs = loadAuditLogs();
+        if (logs.length === 0) {
+          syncAuditBody.innerHTML = `<div style="color: #a1887f;">No synchronization signals sent yet in this session.</div>`;
+          return;
+        }
+
+        syncAuditBody.innerHTML = logs.slice(0, 15).map(log => {
+          const methods = [];
+          if (log.signalAllAcceptedCredentialsCalled) methods.push("signalAllAcceptedCredentials");
+          if (log.signalUnknownCredentialCalled) methods.push(`signalUnknownCredential(${log.deletedKeyId ? log.deletedKeyId.substring(0, 8) + '...' : ''})`);
+          if (log.signalCurrentUserDetailsCalled) methods.push("signalCurrentUserDetails");
