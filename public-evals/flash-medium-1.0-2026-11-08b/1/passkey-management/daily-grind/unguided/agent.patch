+          const methodsStr = methods.length ? methods.join(", ") : "WebAuthn Signal API (emulated / ready)";
+
+          return `
+            <div class="sync-log-entry">
+              <span class="sync-log-time">[${log.timeFormatted || 'Recent'}]</span>
+              <span style="color: #ffab40; font-weight:600;">${escapeHtml(log.action)}:</span>
