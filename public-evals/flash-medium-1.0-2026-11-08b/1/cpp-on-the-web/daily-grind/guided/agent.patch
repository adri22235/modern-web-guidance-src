diff --git a/build-wasm.sh b/build-wasm.sh
new file mode 100755
index 0000000..3f321e4
--- /dev/null
+++ b/build-wasm.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -e
+
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$DIR"
+
+echo "Building smallpt WebAssembly..."
+
+C2WASM_DIR="$DIR/node_modules/c2wasm"
+
+# Ensure wasm-ld symlink exists
+if [ -f "$C2WASM_DIR/linux/dist/bin/lld" ] && [ ! -f "$C2WASM_DIR/linux/dist/bin/wasm-ld" ]; then
+  ln -sf lld "$C2WASM_DIR/linux/dist/bin/wasm-ld"
+fi
+
+export PATH="$C2WASM_DIR/linux/dist/bin:$PATH"
+
+"$C2WASM_DIR/c2wasm.sh" -O3 \
+  -Wl,--export=get_image_buffer \
+  -Wl,--export=get_current_samples \
+  -Wl,--export=reset_accumulation \
+  -Wl,--export=reset_to_default_colors \
+  -Wl,--export=randomize_sphere_colors \
+  -Wl,--export=set_sphere_rgb \
+  -Wl,--export=get_sphere_color \
+  -Wl,--export=begin_pass \
+  -Wl,--export=render_rows \
+  -Wl,-z,stack-size=1048576 \
+  -Wl,--initial-memory=33554432 \
+  -o smallpt.wasm smallpt.cpp
+
+echo "smallpt.wasm built successfully: $(ls -lh smallpt.wasm | awk '{print $5}')"
+
+# Create base64 fallback script so index.html works with both fetch() and file://
+node -e '
+const fs = require("fs");
+const b64 = fs.readFileSync("smallpt.wasm").toString("base64");
+fs.writeFileSync("smallpt-wasm-base64.js", `// Embedded smallpt WebAssembly binary fallback for offline or file:// protocol\n(typeof window !== "undefined" ? window : globalThis).SMALLPT_WASM_BASE64 = "${b64}";\n`);
+console.log("smallpt-wasm-base64.js generated successfully");
+'
