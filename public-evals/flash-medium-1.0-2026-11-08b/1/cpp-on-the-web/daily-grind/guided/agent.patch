+    // DOM Elements
+    const statusDot = document.getElementById('status-indicator');
+    const statusText = document.getElementById('status-text');
+    const statSamples = document.getElementById('stat-samples');
+    const statTime = document.getElementById('stat-time');
+    const statPass = document.getElementById('stat-pass');
+    const resBadge = document.getElementById('resolution-badge');
+
+    const btnRandomize = document.getElementById('btn-randomize');
+    const btnReset = document.getElementById('btn-reset');
+    const btnPause = document.getElementById('btn-pause');
+    const btnSave = document.getElementById('btn-save');
+    const pauseIcon = document.getElementById('pause-icon');
+    const pauseText = document.getElementById('pause-text');
+    const selectRes = document.getElementById('select-resolution');
+    const selectSpp = document.getElementById('select-spp');
+
+    // Material Swatches
+    const chipLeft = document.getElementById('chip-left');
+    const chipRight = document.getElementById('chip-right');
+    const chipBack = document.getElementById('chip-back');
+    const chipMirror = document.getElementById('chip-mirror');
+    const chipGlass = document.getElementById('chip-glass');
+
+    async function loadWebAssembly() {
+      let wasmBytes = null;
+
+      // 1. Try direct fetch for HTTP/HTTPS environments
+      try {
+        const resp = await fetch('smallpt.wasm');
+        if (resp.ok) {
+          wasmBytes = await resp.arrayBuffer();
+        }
+      } catch (err) {
+        console.warn('Direct fetch failed (likely file:// protocol):', err);
+      }
+
+      // 2. Fall back to embedded base64 if fetch fails
+      if (!wasmBytes && window.SMALLPT_WASM_BASE64) {
+        const binaryStr = atob(window.SMALLPT_WASM_BASE64);
+        const len = binaryStr.length;
+        const bytes = new Uint8Array(len);
+        for (let i = 0; i < len; i++) {
+          bytes[i] = binaryStr.charCodeAt(i);
+        }
+        wasmBytes = bytes.buffer;
+      }
+
+      if (!wasmBytes) {
+        throw new Error('WebAssembly module could not be loaded via fetch or base64 fallback.');
+      }
+
+      const { instance } = await WebAssembly.instantiate(wasmBytes);
+      return instance.exports;
+    }
+
+    function updateSphereSwatches() {
+      if (!wasm) return;
+      const getRgb = (id) => {
+        const r = Math.min(255, Math.max(0, Math.round(wasm.get_sphere_color(id, 0) * 255)));
+        const g = Math.min(255, Math.max(0, Math.round(wasm.get_sphere_color(id, 1) * 255)));
+        const b = Math.min(255, Math.max(0, Math.round(wasm.get_sphere_color(id, 2) * 255)));
+        return `rgb(${r}, ${g}, ${b})`;
+      };
+
+      chipLeft.style.background = getRgb(0);
+      chipRight.style.background = getRgb(1);
+      chipBack.style.background = getRgb(2);
+      chipMirror.style.background = getRgb(6);
+      chipGlass.style.background = getRgb(7);
+    }
+
+    function copyBufferToCanvas() {
+      const ptr = wasm.get_image_buffer();
+      const mem = new Uint8ClampedArray(wasm.memory.buffer, ptr, width * height * 4);
+      const imgData = new ImageData(mem, width, height);
+      ctx.putImageData(imgData, 0, 0);
+    }
+
+    function updateStats(done = false) {
+      const elapsed = ((performance.now() - startTime) / 1000).toFixed(1);
+      statTime.textContent = `${elapsed}s`;
+      statSamples.textContent = wasm.get_current_samples();
+      statPass.textContent = `${currentPass} / ${targetPasses}`;
+
+      if (done) {
+        statusDot.className = 'status-dot';
+        statusText.textContent = `Completed (${wasm.get_current_samples()} SPP in ${elapsed}s)`;
+        scanline.style.display = 'none';
+      } else {
+        statusDot.className = 'status-dot busy';
+        statusText.textContent = `Tracing pass ${currentPass + 1} of ${targetPasses}...`;
+        scanline.style.display = 'block';
+        const canvasRect = canvas.getBoundingClientRect();
+        const yPct = (currentRow / height);
+        scanline.style.top = `${yPct * 100}%`;
+      }
+    }
+
+    function renderLoop() {
+      if (!isRendering || isPaused) return;
 
+      const rowsToRender = Math.min(ROWS_PER_CHUNK, height - currentRow);
+      const seedOffset = (currentSeed + currentPass * 1000 + currentRow) >>> 0;
+
+      wasm.render_rows(currentRow, rowsToRender, width, height, passSamples, seedOffset);
+      currentRow += rowsToRender;
+
+      copyBufferToCanvas();
+      updateStats(false);
+
+      if (currentRow >= height) {
+        currentPass++;
+        currentRow = 0;
+
+        if (currentPass < targetPasses) {
+          wasm.begin_pass(passSamples);
+          animFrameId = requestAnimationFrame(renderLoop);
+        } else {
+          isRendering = false;
+          updateStats(true);
+        }
+      } else {
+        animFrameId = requestAnimationFrame(renderLoop);
+      }
+    }
+
+    function startRendering() {
+      if (animFrameId) cancelAnimationFrame(animFrameId);
+      isRendering = true;
+      isPaused = false;
+      pauseIcon.textContent = '⏸';
+      pauseText.textContent = 'Pause';
+
+      currentPass = 0;
+      currentRow = 0;
+      startTime = performance.now();
+
+      wasm.reset_accumulation(width, height);
+      wasm.begin_pass(passSamples);
+
+      updateStats(false);
+      renderLoop();
+    }
+
+    // Button: Run Again with Randomized Colors
+    btnRandomize.addEventListener('click', () => {
+      currentSeed = (Math.random() * 0xFFFFFFFF) >>> 0;
+      wasm.randomize_sphere_colors(currentSeed);
+      updateSphereSwatches();
+      startRendering();
+    });
+
+    // Button: Reset to Classic Cornell Box
+    btnReset.addEventListener('click', () => {
+      wasm.reset_to_default_colors();
+      updateSphereSwatches();
+      startRendering();
+    });
+
+    // Button: Pause / Resume
+    btnPause.addEventListener('click', () => {
+      if (!isRendering) {
+        // Restart if done
+        startRendering();
+        return;
+      }
+      isPaused = !isPaused;
+      if (isPaused) {
+        pauseIcon.textContent = '▶';
+        pauseText.textContent = 'Resume';
+        statusDot.className = 'status-dot';
+        statusText.textContent = 'Rendering paused';
+        scanline.style.display = 'none';
+      } else {
+        pauseIcon.textContent = '⏸';
+        pauseText.textContent = 'Pause';
+        renderLoop();
+      }
+    });
+
+    // Button: Save PNG
+    btnSave.addEventListener('click', () => {
+      const link = document.createElement('a');
+      link.download = `smallpt-cornell-box-${width}x${height}-${wasm.get_current_samples()}spp.png`;
+      link.href = canvas.toDataURL('image/png');
+      link.click();
+    });
+
+    // Select Resolution
+    selectRes.addEventListener('change', (e) => {
+      const [w, h] = e.target.value.split('x').map(Number);
+      width = w;
+      height = h;
+      canvas.width = w;
+      canvas.height = h;
+      resBadge.textContent = `${w} × ${h}`;
+      startRendering();
+    });
+
+    // Select SPP
+    selectSpp.addEventListener('change', (e) => {
+      const spp = Number(e.target.value);
+      targetPasses = Math.max(1, Math.round(spp / passSamples));
+      startRendering();
+    });
+
+    // Initialization on page load
+    async function init() {
+      try {
+        wasm = await loadWebAssembly();
+        wasm.reset_to_default_colors();
+        updateSphereSwatches();
+        startRendering();
+      } catch (err) {
+        console.error('Failed to initialize smallpt WebAssembly:', err);
+        statusDot.className = 'status-dot';
+        statusDot.style.background = '#ef4444';
+        statusText.textContent = 'Error: ' + err.message;
+      }
+    }
+
+    window.addEventListener('DOMContentLoaded', init);
+  </script>
+</body>
 </html>
