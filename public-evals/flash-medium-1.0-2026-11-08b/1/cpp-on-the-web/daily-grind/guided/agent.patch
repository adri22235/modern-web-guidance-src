@@ -0,0 +1,261 @@
+/**
+ * smallpt WebAssembly Port
+ * Original path tracer: (c) Kevin Beason (http://www.kevinbeason.com/smallpt/)
+ * 
+ * Global Illumination in ~99 lines of C++ compiled to client-side WebAssembly.
+ * Features:
+ * - Monte Carlo path tracing
+ * - Diffuse, Specular (mirror), and Dielectric Refraction (Fresnel equations, Snell's law)
+ * - Explicit Russian Roulette path termination
+ * - Progressive multi-pass accumulation buffer
+ * - Fast chunked row rendering for smooth browser UI
+ * - Dynamic color randomization
+ */
+
+#include <math.h>
+#include <stdint.h>
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x, y+b.y, z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x, y-b.y, z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b, y*b, z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x, y*b.y, z*b.z); }
+  Vec& norm(){ return *this = *this * (1.0 / sqrt(x*x + y*y + z*z)); }
+  double dot(const Vec &b) const { return x*b.x + y*b.y + z*b.z; }
+  Vec operator%(const Vec &b) const { return Vec(y*b.z - z*b.y, z*b.x - x*b.z, x*b.y - y*b.x); }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b*b - op.dot(op) + rad*rad;
+    if (det < 0) return 0; else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+// Scene definition (Cornell Box)
+static Sphere spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),// 0: Left (Red)
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),// 1: Right (Blue)
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),// 2: Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),// 3: Front
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),// 4: Bottom
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),// 5: Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),// 6: Mirror
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),// 7: Glass
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) // 8: Light
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x), 1.0/2.2)*255.0 + 0.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+  for(int i = int(n); i--;) {
+    if((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+// 48-bit linear congruential generator equivalent to POSIX erand48
+static inline double my_rand(unsigned short Xi[3]) {
+  uint64_t x = ((uint64_t)Xi[2] << 32) | ((uint64_t)Xi[1] << 16) | Xi[0];
+  x = x * 0x5DEECE66DULL + 0xBULL;
+  Xi[0] = x & 0xFFFF;
+  Xi[1] = (x >> 16) & 0xFFFF;
+  Xi[2] = (x >> 32) & 0xFFFF;
+  return (double)(x & 0xFFFFFFFFFFFFULL) / (double)0x1000000000000ULL;
+}
+
+// Recursive path-tracing radiance estimator
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d*t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n*-1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z; // Max surface reflectance
+
+  // Russian Roulette termination
+  if (++depth > 5) {
+    if (depth > 22 || my_rand(Xi) >= p) return obj.e;
+    f = f * (1.0 / p);
+  }
+
+  if (obj.refl == DIFF) { // Ideal diffuse reflection (cosine-weighted hemisphere sampling)
+    double r1 = 2 * M_PI * my_rand(Xi), r2 = my_rand(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > 0.1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1.0 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC) { // Ideal specular reflection (mirror)
+    return obj.e + f.mult(radiance(Ray(x, r.d - n*2.0*n.dot(r.d)), depth, Xi));
+  }
+
+  // Ideal dielectric refraction (glass)
+  Ray reflRay(x, r.d - n*2.0*n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1.0, nt = 1.5, nnt = into ? nc/nt : nt/nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1.0 - nnt*nnt*(1.0 - ddn*ddn)) < 0) // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+
+  Vec tdir = (r.d*nnt - n*((into ? 1.0 : -1.0)*(ddn*nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a*a / (b*b), c = 1.0 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1.0 - R0)*c*c*c*c*c, Tr = 1.0 - Re, P = 0.25 + 0.5*Re, RP = Re/P, TP = Tr/(1.0 - P);
+
+  return obj.e + f.mult(depth > 2 ? (my_rand(Xi) < P ?
+    radiance(reflRay, depth, Xi)*RP : radiance(Ray(x, tdir), depth, Xi)*TP) :
+    radiance(reflRay, depth, Xi)*Re + radiance(Ray(x, tdir), depth, Xi)*Tr);
+}
+
+// Memory layout in WebAssembly linear memory:
+// Offset 1048576 (1MB): RGBA uint8 output buffer (up to 1024x1024x4 = 4MB)
+// Offset 5242880: Accumulation vector buffer (up to 1024x1024x24 = 24MB)
+#define RGBA_OFFSET 1048576
+#define ACCUM_OFFSET (1048576 + 1024*1024*4)
+static uint8_t* const rgba_buf = (uint8_t*)RGBA_OFFSET;
+static Vec* const accum_buf = (Vec*)ACCUM_OFFSET;
+static int current_samples = 0;
+
+extern "C" {
+
+uint8_t* get_image_buffer() {
+  return rgba_buf;
+}
+
+int get_current_samples() {
+  return current_samples;
+}
+
+void reset_accumulation(int w, int h) {
+  int total = w * h;
+  for (int i = 0; i < total; i++) {
+    accum_buf[i] = Vec(0, 0, 0);
+  }
+  current_samples = 0;
+}
+
+void reset_to_default_colors() {
+  spheres[0].c = Vec(.75,.25,.25); // Left: Red
+  spheres[1].c = Vec(.25,.25,.75); // Right: Blue
+  spheres[2].c = Vec(.75,.75,.75); // Back: Grey/White
+  spheres[3].c = Vec(0,0,0);       // Front: Black
+  spheres[4].c = Vec(.75,.75,.75); // Bottom
+  spheres[5].c = Vec(.75,.75,.75); // Top
+  spheres[6].c = Vec(1,1,1)*.999;  // Mirror
+  spheres[7].c = Vec(1,1,1)*.999;  // Glass
+  spheres[8].c = Vec(0,0,0);       // Light
+}
+
+void randomize_sphere_colors(uint32_t seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)(seed ^ 0xCAFE)
+  };
+
+  // Generate harmonious randomized colors
+  // Left wall
+  spheres[0].c = Vec(0.2 + 0.75 * my_rand(Xi), 0.15 + 0.75 * my_rand(Xi), 0.15 + 0.75 * my_rand(Xi));
+  // Right wall
+  spheres[1].c = Vec(0.15 + 0.75 * my_rand(Xi), 0.15 + 0.75 * my_rand(Xi), 0.2 + 0.75 * my_rand(Xi));
+  // Back wall
+  spheres[2].c = Vec(0.25 + 0.65 * my_rand(Xi), 0.25 + 0.65 * my_rand(Xi), 0.25 + 0.65 * my_rand(Xi));
+
+  // Mirror sphere tint
+  double m_intensity = 0.88 + 0.11 * my_rand(Xi);
+  Vec m_tint = Vec(0.4 + 0.6 * my_rand(Xi), 0.4 + 0.6 * my_rand(Xi), 0.4 + 0.6 * my_rand(Xi)).norm();
+  spheres[6].c = m_tint * m_intensity;
+
+  // Glass sphere tint
+  double g_intensity = 0.88 + 0.11 * my_rand(Xi);
+  Vec g_tint = Vec(0.4 + 0.6 * my_rand(Xi), 0.4 + 0.6 * my_rand(Xi), 0.4 + 0.6 * my_rand(Xi)).norm();
+  spheres[7].c = g_tint * g_intensity;
+
+  // Floor and ceiling
+  spheres[4].c = Vec(0.35 + 0.55 * my_rand(Xi), 0.35 + 0.55 * my_rand(Xi), 0.35 + 0.55 * my_rand(Xi));
+  spheres[5].c = Vec(0.35 + 0.55 * my_rand(Xi), 0.35 + 0.55 * my_rand(Xi), 0.35 + 0.55 * my_rand(Xi));
+}
+
+void set_sphere_rgb(int id, double r, double g, double b) {
+  if (id >= 0 && id < 9) {
+    spheres[id].c = Vec(r, g, b);
+  }
+}
+
+double get_sphere_color(int id, int channel) {
+  if (id >= 0 && id < 9) {
+    if (channel == 0) return spheres[id].c.x;
+    if (channel == 1) return spheres[id].c.y;
+    if (channel == 2) return spheres[id].c.z;
+  }
+  return 0.0;
+}
+
+void begin_pass(int pass_samples) {
+  current_samples += pass_samples;
+}
+
+// Render a batch of rows with progressive accumulation into image buffer
+void render_rows(int start_y, int num_rows, int w, int h, int pass_samples, uint32_t seed_offset) {
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h, 0, 0);
+  Vec cy = (cx % cam.d).norm() * .5135;
+
+  double inv_total_samples = 1.0 / (current_samples > 0 ? current_samples : 1);
+
+  for (int y = start_y; y < start_y + num_rows && y < h; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(y * 7 + seed_offset),
+      (unsigned short)(y * y * 13 + current_samples * 17),
+      (unsigned short)(y * y * y * 19 + seed_offset * 23 + 12345)
+    };
+
+    for (int x = 0; x < w; x++) {
+      int idx = y * w + x;
+      Vec pass_acc(0, 0, 0);
+
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r(0, 0, 0);
+          for (int s = 0; s < pass_samples; s++) {
+            double r1 = 2 * my_rand(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * my_rand(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2.0 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2.0 + (h - y - 1)) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi);
+          }
+          pass_acc = pass_acc + r * 0.25;
+        }
+      }
+
+      accum_buf[idx] = accum_buf[idx] + pass_acc;
+      Vec pixel = accum_buf[idx] * inv_total_samples;
+
+      int pix_idx = idx * 4;
+      rgba_buf[pix_idx + 0] = toInt(pixel.x);
+      rgba_buf[pix_idx + 1] = toInt(pixel.y);
+      rgba_buf[pix_idx + 2] = toInt(pixel.z);
+      rgba_buf[pix_idx + 3] = 255;
+    }
+  }
+}
+
+} // extern "C"
