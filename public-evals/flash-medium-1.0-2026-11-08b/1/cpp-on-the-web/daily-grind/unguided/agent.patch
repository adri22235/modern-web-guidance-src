+static int total_accumulated_samples = 0;
+
+extern "C" {
+
+void reset_scene() {
+  spheres[0] = Sphere(1e5,  Vec(1e5 + 1.0, 40.8, 81.6),  Vec(),            Vec(0.75, 0.25, 0.25), DIFF); // Left
+  spheres[1] = Sphere(1e5,  Vec(-1e5 + 99.0, 40.8, 81.6), Vec(),            Vec(0.25, 0.25, 0.75), DIFF); // Right
+  spheres[2] = Sphere(1e5,  Vec(50, 40.8, 1e5),          Vec(),            Vec(0.75, 0.75, 0.75), DIFF); // Back
+  spheres[3] = Sphere(1e5,  Vec(50, 40.8, -1e5 + 170.0), Vec(),            Vec(),                 DIFF); // Front
+  spheres[4] = Sphere(1e5,  Vec(50, 1e5, 81.6),          Vec(),            Vec(0.75, 0.75, 0.75), DIFF); // Bottom
+  spheres[5] = Sphere(1e5,  Vec(50, -1e5 + 81.6, 81.6),  Vec(),            Vec(0.75, 0.75, 0.75), DIFF); // Top
+  spheres[6] = Sphere(16.5, Vec(27, 16.5, 47),           Vec(),            Vec(1, 1, 1) * 0.999,  SPEC); // Mirror
+  spheres[7] = Sphere(16.5, Vec(73, 16.5, 78),           Vec(),            Vec(1, 1, 1) * 0.999,  REFR); // Glass
+  spheres[8] = Sphere(600,  Vec(50, 681.6 - 0.27, 81.6), Vec(12, 12, 12),  Vec(),                 DIFF); // Light
+}
+
+void init_scene() {
+  reset_scene();
+}
+
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 1103515245 + 12345) & 0xFFFF)
+  };
+
+  // Helper lambda for random in range
+  #define RAND_VAL(min_val, max_val) ((min_val) + ((max_val) - (min_val)) * erand48(Xi))
+
+  // Randomize Left wall (vibrant color)
+  spheres[0].c = Vec(RAND_VAL(0.15, 0.85), RAND_VAL(0.1, 0.8), RAND_VAL(0.1, 0.8));
+  // Randomize Right wall (vibrant contrasting color)
+  spheres[1].c = Vec(RAND_VAL(0.1, 0.8), RAND_VAL(0.15, 0.85), RAND_VAL(0.15, 0.85));
+  // Randomize Back wall (room tone)
+  spheres[2].c = Vec(RAND_VAL(0.3, 0.85), RAND_VAL(0.3, 0.85), RAND_VAL(0.3, 0.85));
+
+  // Randomize Mirror sphere tint (specular reflection color)
+  spheres[6].c = Vec(RAND_VAL(0.3, 0.99), RAND_VAL(0.3, 0.99), RAND_VAL(0.3, 0.99));
+
+  // Randomize Glass sphere tint (dielectric transmission color)
+  spheres[7].c = Vec(RAND_VAL(0.4, 0.99), RAND_VAL(0.4, 0.99), RAND_VAL(0.4, 0.99));
+}
+
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < NUM_SPHERES) {
+    spheres[id].c = Vec(r, g, b);
+  }
+}
+
+double get_sphere_color_r(int id) { return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.x : 0; }
+double get_sphere_color_g(int id) { return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.y : 0; }
+double get_sphere_color_b(int id) { return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.z : 0; }
+
+unsigned int* get_buffer() {
+  return pixel_buffer;
+}
+
+void clear_accumulation(int w, int h) {
+  if (w > MAX_WIDTH) w = MAX_WIDTH;
+  if (h > MAX_HEIGHT) h = MAX_HEIGHT;
+  int count = w * h;
+  for (int i = 0; i < count; i++) {
+    accum_buffer[i] = Vec(0, 0, 0);
+  }
+  total_accumulated_samples = 0;
+}
+
+int get_total_samples() {
+  return total_accumulated_samples;
+}
+
+// Progressive pass: renders `samps` samples per subpixel (total samps*4 spp added)
+void render_pass(int w, int h, int samps, unsigned int seed) {
+  if (w > MAX_WIDTH) w = MAX_WIDTH;
+  if (h > MAX_HEIGHT) h = MAX_HEIGHT;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * 0.5135 / h);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+
+  int spp_this_pass = samps * 4;
+  total_accumulated_samples += spp_this_pass;
+  double inv_total = 1.0 / (double)total_accumulated_samples;
+
+  for (int y = 0; y < h; y++) {
+    int y_cam = h - 1 - y;
+    unsigned short Xi[3] = {
+      (unsigned short)((seed + total_accumulated_samples * 17) & 0xFFFF),
+      (unsigned short)((y * 13 + total_accumulated_samples * 31) & 0xFFFF),
+      (unsigned short)((y_cam * y_cam * y_cam + seed) & 0xFFFF)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      Vec pass_col(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r(0, 0, 0);
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2.0 * erand48(Xi), dx = r1 < 1.0 ? sqrt(r1) - 1.0 : 1.0 - sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi), dy = r2 < 1.0 ? sqrt(r2) - 1.0 : 1.0 - sqrt(2.0 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2.0 + y_cam) / h - 0.5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi);
+          }
+          pass_col = pass_col + r;
+        }
+      }
+      int idx = y * w + x;
+      accum_buffer[idx] = accum_buffer[idx] + pass_col;
+      Vec avg = accum_buffer[idx] * inv_total;
+
+      int ir = toInt(avg.x);
+      int ig = toInt(avg.y);
+      int ib = toInt(avg.z);
+      pixel_buffer[idx] = ((unsigned int)255 << 24) |
+                          ((unsigned int)ib << 16) |
+                          ((unsigned int)ig << 8) |
+                          ((unsigned int)ir);
+    }
+  }
+}
+
+// Single-pass slice render for line-by-line / synchronous render
+void render_lines(int w, int h, int samps, int start_y, int end_y, unsigned int seed) {
+  if (w > MAX_WIDTH) w = MAX_WIDTH;
+  if (h > MAX_HEIGHT) h = MAX_HEIGHT;
+  if (start_y < 0) start_y = 0;
+  if (end_y > h) end_y = h;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * 0.5135 / h);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+
+  for (int y = start_y; y < end_y; y++) {
+    int y_cam = h - 1 - y;
+    unsigned short Xi[3] = {
+      (unsigned short)(seed & 0xFFFF),
+      (unsigned short)((seed >> 16) & 0xFFFF),
+      (unsigned short)(y_cam * y_cam * y_cam + seed)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      Vec col(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r(0, 0, 0);
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2.0 * erand48(Xi), dx = r1 < 1.0 ? sqrt(r1) - 1.0 : 1.0 - sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi), dy = r2 < 1.0 ? sqrt(r2) - 1.0 : 1.0 - sqrt(2.0 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2.0 + y_cam) / h - 0.5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+          }
+          col = col + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * 0.25;
+        }
+      }
+      int ir = toInt(col.x);
+      int ig = toInt(col.y);
+      int ib = toInt(col.z);
+      pixel_buffer[y * w + x] = ((unsigned int)255 << 24) |
+                                ((unsigned int)ib << 16) |
+                                ((unsigned int)ig << 8) |
+                                ((unsigned int)ir);
+    }
+  }
+}
+
+}
