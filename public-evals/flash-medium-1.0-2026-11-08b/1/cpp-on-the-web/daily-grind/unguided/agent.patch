diff --git a/build.sh b/build.sh
new file mode 100755
index 0000000..a0e4cc0
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -e
+
+# Find clang++
+CLANG_BIN=""
+if command -v /opt/llvm/bin/clang++ >/dev/null 2>&1; then
+  CLANG_BIN="/opt/llvm/bin/clang++"
+elif command -v clang++ >/dev/null 2>&1; then
+  CLANG_BIN="clang++"
+else
+  echo "Error: clang++ not found"
+  exit 1
+fi
+
+echo "Compiling smallpt.cpp to WebAssembly using $CLANG_BIN..."
+"$CLANG_BIN" --target=wasm32 -O3 -nostdlib \
+  -Wl,--no-entry \
+  -Wl,--allow-undefined \
+  -Wl,--export=init_scene \
+  -Wl,--export=reset_scene \
+  -Wl,--export=randomize_sphere_colors \
+  -Wl,--export=set_sphere_color \
+  -Wl,--export=get_sphere_color_r \
+  -Wl,--export=get_sphere_color_g \
+  -Wl,--export=get_sphere_color_b \
+  -Wl,--export=get_buffer \
+  -Wl,--export=clear_accumulation \
+  -Wl,--export=get_total_samples \
+  -Wl,--export=render_pass \
+  -Wl,--export=render_lines \
+  -o smallpt.wasm smallpt.cpp
+
+echo "smallpt.wasm successfully built! ($(ls -lh smallpt.wasm | awk '{print $5}'))"
