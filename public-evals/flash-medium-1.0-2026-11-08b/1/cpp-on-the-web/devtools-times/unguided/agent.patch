+</head>
+<body>
+  <div class="container">
+    <header>
+      <h1>smallpt WebAssembly Path Tracer</h1>
+      <p class="subtitle">
+        Kevin Beason's open-source 99-line C++ global illumination path tracer compiled to WebAssembly, running 100% client-side in your browser.
+      </p>
+      <div class="badge">
+        <span class="dot"></span>
+        <span id="wasm-badge">Initializing WebAssembly...</span>
+      </div>
+    </header>
+
+    <div class="main-grid">
+      <!-- Viewport / Canvas Area -->
+      <div class="card viewport-card">
+        <div class="canvas-wrapper">
+          <canvas id="pt-canvas" width="256" height="192"></canvas>
+        </div>
+
+        <div class="progress-container">
+          <div class="progress-bar-bg">
+            <div id="progress-fill" class="progress-bar-fill"></div>
+          </div>
+          <div class="status-row">
