+
+  <script>
+    // Embedded WASM bytecode fallback for file:// protocol or standalone environments
+    const WASM_FALLBACK_BASE64 = "";
+
+    const canvas = document.getElementById("pt-canvas");
+    const ctx = canvas.getContext("2d");
+    const statusText = document.getElementById("status-text");
+    const timingText = document.getElementById("timing-text");
+    const progressFill = document.getElementById("progress-fill");
+    const wasmBadge = document.getElementById("wasm-badge");
+
+    const btnRandomize = document.getElementById("btn-randomize");
+    const btnRerender = document.getElementById("btn-rerender");
+    const btnReset = document.getElementById("btn-reset");
+    const btnDownload = document.getElementById("btn-download");
+    const resSelect = document.getElementById("resolution-select");
+    const sampsSelect = document.getElementById("samples-select");
+
+    const swatchLeft = document.getElementById("swatch-left");
+    const swatchRight = document.getElementById("swatch-right");
+    const swatchMirror = document.getElementById("swatch-mirror");
+    const swatchGlass = document.getElementById("swatch-glass");
+
+    let wasmInstance = null;
+    let isRendering = false;
+    let cancelRender = false;
+    let currentSeed = 1337;
+
+    // Load and instantiate WebAssembly
+    async function initWasm() {
+      const importObject = {
+        env: {
+          js_pow: Math.pow
+        }
+      };
+
+      try {
+        const resp = await fetch("smallpt.wasm");
+        if (resp.ok) {
+          const buf = await resp.arrayBuffer();
+          const { instance } = await WebAssembly.instantiate(buf, importObject);
+          wasmInstance = instance;
+          wasmBadge.textContent = "WebAssembly Ready (smallpt.wasm)";
+          return;
+        }
+      } catch (err) {
+        console.warn("fetch smallpt.wasm failed (likely file:// protocol), using embedded bytecode:", err);
+      }
+
+      // Decode base64
+      const binary = atob(WASM_FALLBACK_BASE64);
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      const { instance } = await WebAssembly.instantiate(bytes.buffer, importObject);
+      wasmInstance = instance;
+      wasmBadge.textContent = "WebAssembly Ready (Client-Side WASM)";
+    }
+
+    function setSphereColor(id, r, g, b) {
+      if (!wasmInstance) return;
+      wasmInstance.exports.set_sphere_color(id, r, g, b);
+    }
+
+    function randomizeColors() {
+      if (!wasmInstance) return;
+      const rnd = () => Math.random();
+      
+      // Randomize Left Wall (0), Right Wall (1), Back Wall (2)
+      const lR = 0.2 + 0.7 * rnd(), lG = 0.1 + 0.6 * rnd(), lB = 0.1 + 0.6 * rnd();
+      const rR = 0.1 + 0.6 * rnd(), rG = 0.1 + 0.6 * rnd(), rB = 0.2 + 0.7 * rnd();
+      const bR = 0.3 + 0.6 * rnd(), bG = 0.3 + 0.6 * rnd(), bB = 0.3 + 0.6 * rnd();
+
+      // Mirror (6) and Glass (7) tints
+      const mR = 0.6 + 0.39 * rnd(), mG = 0.6 + 0.39 * rnd(), mB = 0.6 + 0.39 * rnd();
+      const gR = 0.6 + 0.39 * rnd(), gG = 0.6 + 0.39 * rnd(), gB = 0.6 + 0.39 * rnd();
+
+      setSphereColor(0, lR, lG, lB);
+      setSphereColor(1, rR, rG, rB);
+      setSphereColor(2, bR, bG, bB);
+      setSphereColor(6, mR, mG, mB);
+      setSphereColor(7, gR, gG, gB);
+
+      swatchLeft.style.backgroundColor = "rgb(" + Math.round(lR*255) + "," + Math.round(lG*255) + "," + Math.round(lB*255) + ")";
+      swatchRight.style.backgroundColor = "rgb(" + Math.round(rR*255) + "," + Math.round(rG*255) + "," + Math.round(rB*255) + ")";
+      swatchMirror.style.backgroundColor = "rgb(" + Math.round(mR*255) + "," + Math.round(mG*255) + "," + Math.round(mB*255) + ")";
+      swatchGlass.style.backgroundColor = "rgb(" + Math.round(gR*255) + "," + Math.round(gG*255) + "," + Math.round(gB*255) + ")";
+    }
+
+    function resetColors() {
+      if (!wasmInstance) return;
+      wasmInstance.exports.reset_sphere_colors();
+      swatchLeft.style.backgroundColor = "rgb(191, 64, 64)";
+      swatchRight.style.backgroundColor = "rgb(64, 64, 191)";
+      swatchMirror.style.backgroundColor = "rgb(255, 255, 255)";
+      swatchGlass.style.backgroundColor = "rgb(255, 255, 255)";
+    }
+
+    async function startRender() {
+      if (!wasmInstance || isRendering) return;
+      isRendering = true;
+      cancelRender = false;
+      btnRandomize.disabled = true;
+      btnRerender.disabled = true;
+      btnReset.disabled = true;
+
+      const [wStr, hStr] = resSelect.value.split("x");
+      const width = parseInt(wStr, 10);
+      const height = parseInt(hStr, 10);
+      const samps = parseInt(sampsSelect.value, 10);
+
+      canvas.width = width;
+      canvas.height = height;
+
+      statusText.textContent = "Rendering " + width + "×" + height + " (" + samps + " spp)...";
+      progressFill.style.width = "0%";
+      const startTime = performance.now();
+
+      currentSeed = (currentSeed * 1664525 + 1013904223) >>> 0;
+
+      const memPtr = wasmInstance.exports.get_image_buffer();
+      const linesPerFrame = Math.max(2, Math.floor(height / 24));
+      let currentY = 0;
+
+      function renderBatch() {
+        if (cancelRender) {
+          isRendering = false;
+          btnRandomize.disabled = false;
+          btnRerender.disabled = false;
+          btnReset.disabled = false;
+          statusText.textContent = "Cancelled";
+          return;
+        }
+
+        const endY = Math.min(currentY + linesPerFrame, height);
+        for (; currentY < endY; currentY++) {
+          wasmInstance.exports.render_row(currentY, width, height, samps, currentSeed);
+        }
+
+        // Blit to canvas
+        const pixelData = new Uint8ClampedArray(
+          wasmInstance.exports.memory.buffer,
+          memPtr,
+          width * height * 4
+        );
+        const imgData = new ImageData(pixelData, width, height);
+        ctx.putImageData(imgData, 0, 0);
+
+        const pct = Math.floor((currentY / height) * 100);
+        progressFill.style.width = pct + "%";
+        timingText.textContent = Math.round(performance.now() - startTime) + " ms";
+
+        if (currentY < height) {
+          requestAnimationFrame(renderBatch);
+        } else {
+          isRendering = false;
+          btnRandomize.disabled = false;
+          btnRerender.disabled = false;
+          btnReset.disabled = false;
+          const totalTime = Math.round(performance.now() - startTime);
+          statusText.textContent = "Done in " + totalTime + " ms (" + width + "×" + height + ", " + samps + " spp)";
+          progressFill.style.width = "100%";
+        }
+      }
+
+      requestAnimationFrame(renderBatch);
+    }
+
+    btnRandomize.addEventListener("click", () => {
+      randomizeColors();
+      startRender();
+    });
+
+    btnRerender.addEventListener("click", () => {
+      startRender();
+    });
+
+    btnReset.addEventListener("click", () => {
+      resetColors();
+      startRender();
+    });
+
+    resSelect.addEventListener("change", () => {
+      startRender();
+    });
+
+    sampsSelect.addEventListener("change", () => {
+      startRender();
+    });
+
+    btnDownload.addEventListener("click", () => {
+      const link = document.createElement("a");
+      link.download = "smallpt-" + canvas.width + "x" + canvas.height + ".png";
+      link.href = canvas.toDataURL("image/png");
+      link.click();
+    });
+
+    // Initialize and run initial render
+    initWasm().then(() => {
+      startRender();
+    });
+  </script>
