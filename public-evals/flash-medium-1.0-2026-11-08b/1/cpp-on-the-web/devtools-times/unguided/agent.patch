new file mode 100755
index 0000000..5a665b5
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+set -e
+
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CLANG="${CLANG:-/usr/local/bin/clang}"
+
+echo "Compiling smallpt.cpp to WebAssembly with clang..."
+"$CLANG" --target=wasm32 \
+    -O3 \
+    -nostdlib \
+    -Wl,--no-entry \
+    -Wl,--export-all \
+    -Wl,--allow-undefined \
+    -Wl,--initial-memory=16777216 \
+    -o "$DIR/smallpt.wasm" \
+    "$DIR/smallpt.cpp"
+
+# Copy to public directory as well if present
+if [ -d "$DIR/public" ]; then
+    cp "$DIR/smallpt.wasm" "$DIR/public/smallpt.wasm"
+fi
+
+# Update base64 string in index.html if generator is present
+base64 -w 0 "$DIR/smallpt.wasm" > /tmp/smallpt.wasm.b64
+if [ -f "$DIR/scripts/generate_html.cjs" ]; then
+    node "$DIR/scripts/generate_html.cjs"
+fi
+
+echo "Successfully generated smallpt.wasm ($(stat -c%s "$DIR/smallpt.wasm") bytes)"
