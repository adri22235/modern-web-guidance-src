+              <span>Mirror</span>
+            </div>
+            <div class="swatch-item">
+              <div id="swatch-glass" class="swatch" style="background-color: rgb(255, 255, 255);"></div>
+              <span>Glass</span>
+            </div>
+          </div>
+        </div>
+
+        <div class="control-group">
+          <button id="btn-download" class="btn-secondary" title="Save current canvas image as PNG">
+            💾 Save PNG Image
+          </button>
+        </div>
+      </div>
+    </div>
+
+    <!-- Technical Details Card -->
+    <div class="info-card">
+      <h3>
+        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
+          <circle cx="12" cy="12" r="10"></circle>
+          <line x1="12" y1="16" x2="12" y2="12"></line>
+          <line x1="12" y1="8" x2="12.01" y2="8"></line>
+        </svg>
+        About This WebAssembly Port
+      </h3>
+      <p>
+        <strong>smallpt</strong> was created by <a href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">Kevin Beason</a> as an educational C++ global illumination renderer supporting diffuse reflection, specular mirrors, Fresnel refraction (dielectric glass), and soft lighting via Monte Carlo path tracing.
+      </p>
+      <div class="info-grid">
+        <div class="info-item">
+          <span>Source Language</span>
+          <strong>C++ (smallpt.cpp)</strong>
+        </div>
+        <div class="info-item">
+          <span>Compiler</span>
+          <strong>LLVM Clang (wasm32)</strong>
+        </div>
+        <div class="info-item">
+          <span>Execution</span>
+          <strong>WebAssembly in Browser</strong>
+        </div>
+        <div class="info-item">
+          <span>Binary Size</span>
+          <strong>9.6 KB (.wasm)</strong>
+        </div>
+      </div>
+    </div>
