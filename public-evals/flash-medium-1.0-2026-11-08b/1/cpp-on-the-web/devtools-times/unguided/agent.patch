+    while (x < -PI) x += TWO_PI;
+    double x2 = x * x;
+    return x * (1.0 + x2 * (-1.0/6.0 + x2 * (1.0/120.0 + x2 * (-1.0/5040.0 + x2 * (1.0/362880.0)))));
+}
+
+static inline double my_cos(double x) {
+    return my_sin(x + 1.57079632679489661923);
+}
+
+// Pseudo-random generator (erand48 equivalent)
+static inline double erand48_step(unsigned short Xi[3]) {
+    unsigned long long x = ((unsigned long long)Xi[0]) |
+                           (((unsigned long long)Xi[1]) << 16) |
+                           (((unsigned long long)Xi[2]) << 32);
+    x = (x * 0x5DEECE66DULL + 0xBULL) & 0xFFFFFFFFFFFFULL;
+    Xi[0] = (unsigned short)(x & 0xFFFF);
+    Xi[1] = (unsigned short)((x >> 16) & 0xFFFF);
+    Xi[2] = (unsigned short)((x >> 32) & 0xFFFF);
+    return (double)x / (double)(1ULL << 48);
+}
+
+struct Vec {
+    double x, y, z;
+    Vec(double x_=0, double y_=0, double z_=0) : x(x_), y(y_), z(z_) {}
+    Vec operator+(const Vec &b) const { return Vec(x+b.x, y+b.y, z+b.z); }
+    Vec operator-(const Vec &b) const { return Vec(x-b.x, y-b.y, z-b.z); }
+    Vec operator*(double b) const { return Vec(x*b, y*b, z*b); }
+    Vec mult(const Vec &b) const { return Vec(x*b.x, y*b.y, z*b.z); }
+    Vec& norm() {
+        double d = my_sqrt(x*x + y*y + z*z);
+        double inv = d > 0 ? 1.0 / d : 1.0;
+        return *this = *this * inv;
+    }
+    double dot(const Vec &b) const { return x*b.x + y*b.y + z*b.z; }
+    Vec operator%(const Vec &b) const {
+        return Vec(y*b.z - z*b.y, z*b.x - x*b.z, x*b.y - y*b.x);
+    }
+};
+
+struct Ray {
+    Vec o, d;
+    Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+    double rad;
+    Vec p, e, c;
+    Refl_t refl;
+    Sphere() : rad(0), p(), e(), c(), refl(DIFF) {}
+    Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_) :
+        rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+
+    double intersect(const Ray &r) const {
+        Vec op = p - r.o;
+        double t, eps = 1e-4, b = op.dot(r.d);
+        double det = b*b - op.dot(op) + rad*rad;
+        if (det < 0) return 0;
+        else det = my_sqrt(det);
+        return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+    }
+};
+
+// Scene definition (Cornell box)
+static Sphere spheres[] = {
+    Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF), // 0: Left wall
+    Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF), // 1: Right wall
+    Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF), // 2: Back wall
+    Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF), // 3: Front wall
+    Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF), // 4: Bottom / Floor
+    Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF), // 5: Top / Ceiling
+    Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC), // 6: Mirror sphere
+    Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR), // 7: Glass sphere
+    Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF)  // 8: Light source
+};
+
+static const Vec default_colors[] = {
+    Vec(.75,.25,.25),
+    Vec(.25,.25,.75),
+    Vec(.75,.75,.75),
+    Vec(0,0,0),
+    Vec(.75,.75,.75),
+    Vec(.75,.75,.75),
+    Vec(.999,.999,.999),
+    Vec(.999,.999,.999),
+    Vec(0,0,0)
+};
+
+static inline double clamp(double x) { return x < 0 ? 0 : (x > 1 ? 1 : x); }
+
+static inline int toInt(double x) {
+    // Gamma 2.2 correction
+    return (int)(js_pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5);
+}
+
+static inline bool intersect(const Ray &r, double &t, int &id) {
+    int n = sizeof(spheres) / sizeof(Sphere);
+    double d, inf = 1e20;
+    t = inf;
+    for (int i = n; i--;) {
+        if ((d = spheres[i].intersect(r)) && d < t) {
+            t = d;
+            id = i;
+        }
+    }
+    return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+    double t;
+    int id = 0;
+    if (!intersect(r, t, id)) return Vec();
+    const Sphere &obj = spheres[id];
+    Vec x = r.o + r.d * t;
+    Vec n = (x - obj.p).norm();
+    Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+    Vec f = obj.c;
+    double p = f.x > f.y && f.x > f.z ? f.x : (f.y > f.z ? f.y : f.z);
+    if (++depth > 5) {
+        if (erand48_step(Xi) < p) f = f * (1.0 / p);
+        else return obj.e;
+    }
+    if (obj.refl == DIFF) {
+        double r1 = 2 * M_PI * erand48_step(Xi);
+        double r2 = erand48_step(Xi);
+        double r2s = my_sqrt(r2);
+        Vec w = nl;
+        Vec u = ((my_fabs(w.x) > 0.1 ? Vec(0, 1, 0) : Vec(1, 0, 0)) % w).norm();
+        Vec v = w % u;
+        Vec d = (u * my_cos(r1) * r2s + v * my_sin(r1) * r2s + w * my_sqrt(1 - r2)).norm();
+        return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+    } else if (obj.refl == SPEC) {
+        return obj.e + f.mult(radiance(Ray(x, r.d - n * 2.0 * n.dot(r.d)), depth, Xi));
+    }
+    Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+    bool into = n.dot(nl) > 0;
+    double nc = 1.0, nt = 1.5;
+    double nnt = into ? nc / nt : nt / nc;
+    double ddn = r.d.dot(nl);
+    double cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn);
+    if (cos2t < 0) {
+        return obj.e + f.mult(radiance(reflRay, depth, Xi));
+    }
+    Vec tdir = (r.d * nnt - n * ((into ? 1.0 : -1.0) * (ddn * nnt + my_sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc;
+    double R0 = (a * a) / (b * b);
+    double c = 1.0 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1.0 - R0) * c * c * c * c * c;
+    double Tr = 1.0 - Re;
+    double P = 0.25 + 0.5 * Re;
+    double RP = Re / P;
+    double TP = Tr / (1.0 - P);
+    return obj.e + f.mult(depth > 2 ? (erand48_step(Xi) < P ?
+        radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+        radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+// Memory buffer for rendered RGBA pixels: max 1024x768 * 4 bytes
+#define MAX_W 1024
+#define MAX_H 768
+static unsigned char image_pixels[MAX_W * MAX_H * 4];
+
+extern "C" {
+
+unsigned char* get_image_buffer() {
+    return image_pixels;
+}
+
+int get_num_spheres() {
+    return sizeof(spheres) / sizeof(Sphere);
+}
+
+void set_sphere_color(int id, double r, double g, double b) {
+    int n = sizeof(spheres) / sizeof(Sphere);
+    if (id >= 0 && id < n) {
+        spheres[id].c = Vec(r, g, b);
+    }
+}
+
+void get_sphere_color(int id, double* rgb) {
+    int n = sizeof(spheres) / sizeof(Sphere);
+    if (id >= 0 && id < n) {
+        rgb[0] = spheres[id].c.x;
+        rgb[1] = spheres[id].c.y;
+        rgb[2] = spheres[id].c.z;
+    }
+}
+
+void reset_sphere_colors() {
+    int n = sizeof(spheres) / sizeof(Sphere);
+    for (int i = 0; i < n; i++) {
+        spheres[i].c = default_colors[i];
+    }
+}
+
+// Simple LCG random generator for color randomization
+void randomize_colors(unsigned int seed) {
+    unsigned int state = seed ? seed : 123456789;
+    auto rnd = [&state]() -> double {
+        state = state * 1664525u + 1013904223u;
+        return (double)(state >> 8) / (double)(1u << 24);
+    };
+
+    // Randomize Left Wall (0), Right Wall (1), Back Wall (2)
+    spheres[0].c = Vec(0.2 + 0.7 * rnd(), 0.1 + 0.6 * rnd(), 0.1 + 0.6 * rnd());
+    spheres[1].c = Vec(0.1 + 0.6 * rnd(), 0.1 + 0.6 * rnd(), 0.2 + 0.7 * rnd());
+    spheres[2].c = Vec(0.4 + 0.5 * rnd(), 0.4 + 0.5 * rnd(), 0.4 + 0.5 * rnd());
+
+    // Randomize Mirror sphere tint (6) and Glass sphere tint (7)
+    spheres[6].c = Vec(0.7 + 0.299 * rnd(), 0.7 + 0.299 * rnd(), 0.7 + 0.299 * rnd());
+    spheres[7].c = Vec(0.7 + 0.299 * rnd(), 0.7 + 0.299 * rnd(), 0.7 + 0.299 * rnd());
+
+    // Floor (4) and Ceiling (5)
+    spheres[4].c = Vec(0.3 + 0.6 * rnd(), 0.3 + 0.6 * rnd(), 0.3 + 0.6 * rnd());
+    spheres[5].c = Vec(0.3 + 0.6 * rnd(), 0.3 + 0.6 * rnd(), 0.3 + 0.6 * rnd());
+}
+
+void render_row(int y, int w, int h, int samps, int seed) {
+    if (w > MAX_W) w = MAX_W;
+    if (h > MAX_H) h = MAX_H;
+    Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+    Vec cx = Vec(w * 0.5135 / h);
+    Vec cy = (cx % cam.d).norm() * 0.5135;
+
+    unsigned short Xi[3] = {
+        (unsigned short)(seed & 0xFFFF),
+        (unsigned short)((seed >> 16) ^ (y * 33)),
+        (unsigned short)(y * y * y + seed)
+    };
+
+    for (int x = 0; x < w; x++) {
+        int i = (h - y - 1) * w + x;
+        Vec r(0, 0, 0);
+        for (int sy = 0; sy < 2; sy++) {
+            for (int sx = 0; sx < 2; sx++) {
+                Vec sub_r(0, 0, 0);
+                for (int s = 0; s < samps; s++) {
+                    double r1 = 2.0 * erand48_step(Xi);
+                    double dx = r1 < 1.0 ? my_sqrt(r1) - 1.0 : 1.0 - my_sqrt(2.0 - r1);
+                    double r2 = 2.0 * erand48_step(Xi);
+                    double dy = r2 < 1.0 ? my_sqrt(r2) - 1.0 : 1.0 - my_sqrt(2.0 - r2);
+                    Vec d = cx * ((((sx + 0.5 + dx) / 2.0 + x) / w) - 0.5) +
+                            cy * ((((sy + 0.5 + dy) / 2.0 + y) / h) - 0.5) + cam.d;
+                    sub_r = sub_r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+                }
+                r = r + Vec(clamp(sub_r.x), clamp(sub_r.y), clamp(sub_r.z)) * 0.25;
+            }
+        }
+        int p = i * 4;
+        image_pixels[p + 0] = (unsigned char)toInt(r.x);
+        image_pixels[p + 1] = (unsigned char)toInt(r.y);
+        image_pixels[p + 2] = (unsigned char)toInt(r.z);
+        image_pixels[p + 3] = 255;
+    }
+}
+
+void render(int w, int h, int samps, int seed) {
+    if (w > MAX_W) w = MAX_W;
+    if (h > MAX_H) h = MAX_H;
+    for (int y = 0; y < h; y++) {
+        render_row(y, w, h, samps, seed);
+    }
+}
+
+}
