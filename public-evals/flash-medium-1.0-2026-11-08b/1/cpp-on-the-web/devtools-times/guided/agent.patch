+#include <cheerp/clientlib.h>
+#include <cheerp/client.h>
+#include <cmath>
+#include <cstdlib>
+#include <cstdint>
+
+struct Vec {
+    double x, y, z;
+    Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+    Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+    Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+    Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+    Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+    Vec& norm(){ return *this = *this * (1.0/sqrt(x*x+y*y+z*z)); }
+    double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+    Vec operator%(const Vec &b) const { return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x); }
+};
+
+struct Ray {
+    Vec o, d;
+    Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+    double rad;
+    Vec p, e, c;
+    Refl_t refl;
+    Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+        rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+    double intersect(const Ray &r) const {
+        Vec op = p-r.o;
+        double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+        if (det<0) return 0; else det=sqrt(det);
+        return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+    }
+};
+
+static Sphere spheres[] = {
+    Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF), // 0: Left wall
+    Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF), // 1: Right wall
+    Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF), // 2: Back wall
+    Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF), // 3: Front wall
+    Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF), // 4: Bottom floor
+    Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF), // 5: Top ceiling
+    Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC), // 6: Mirror sphere
+    Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR), // 7: Glass sphere
+    Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF)  // 8: Overhead light
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1.0/2.2)*255.0+0.5); }
+
+// High quality LCG pseudo-random number generator for wasm
+inline double rnd(unsigned short *Xi) {
+    uint32_t x = (uint32_t)Xi[0] | ((uint32_t)Xi[1] << 16);
+    x = x * 1664525u + 1013904223u;
+    Xi[0] = (unsigned short)(x & 0xffff);
+    Xi[1] = (unsigned short)((x >> 16) & 0xffff);
+    Xi[2] = (unsigned short)((x >> 8) & 0xffff);
+    return (double)(x & 0x00FFFFFF) / 16777216.0;
+}
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+    double n = sizeof(spheres)/sizeof(Sphere), d, inf = t = 1e20;
+    for (int i = int(n); i--;) {
+        if ((d = spheres[i].intersect(r)) && d < t) {
+            t = d;
+            id = i;
+        }
+    }
+    return t < inf;
+}
+
+[[cheerp::wasm]]
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+    double t;
+    int id = 0;
+    if (!intersect(r, t, id)) return Vec();
+    const Sphere &obj = spheres[id];
+    Vec x = r.o + r.d * t;
+    Vec n = (x - obj.p).norm();
+    Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+    Vec f = obj.c;
+    double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+    if (++depth > 5) {
+        if (rnd(Xi) < p) f = f * (1.0 / p);
+        else return obj.e;
+    }
+    if (obj.refl == DIFF) {
+        double r1 = 2 * M_PI * rnd(Xi), r2 = rnd(Xi), r2s = sqrt(r2);
+        Vec w = nl, u = ((fabs(w.x) > 0.1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+        Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+        return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+    } else if (obj.refl == SPEC) {
+        return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+    }
+    Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+    bool into = n.dot(nl) > 0;
+    double nc = 1.0, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+    if ((cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn)) < 0)
+        return obj.e + f.mult(radiance(reflRay, depth, Xi));
+    Vec tdir = (r.d * nnt - n * ((into ? 1.0 : -1.0) * (ddn * nnt + sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1.0 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1.0 - R0) * c * c * c * c * c, Tr = 1.0 - Re, P = 0.25 + 0.5 * Re, RP = Re / P, TP = Tr / (1.0 - P);
+    return obj.e + f.mult(depth > 2 ? (rnd(Xi) < P ?
+        radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+        radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static const int MAX_W = 1024;
+static const int MAX_H = 768;
+static uint32_t line_buffer[MAX_W];
+
+[[cheerp::wasm]]
+void render_line(int y, int w, int h, int samps) {
+    if (w > MAX_W || h > MAX_H || y < 0 || y >= h) return;
+    Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+    Vec cx = Vec(w * 0.5135 / h), cy = (cx % cam.d).norm() * 0.5135;
+    
+    // In smallpt coordinates, y=0 is bottom, y=h-1 is top.
+    // Canvas y=0 is top, y=h-1 is bottom.
+    int smallpt_y = h - 1 - y;
+    unsigned short Xi[3] = { (unsigned short)(smallpt_y), (unsigned short)(smallpt_y * 11), (unsigned short)(smallpt_y * smallpt_y * smallpt_y + 1) };
+
+    for (int x = 0; x < w; x++) {
+        Vec r;
+        for (int sy = 0; sy < 2; sy++) {
+            for (int sx = 0; sx < 2; sx++) {
+                Vec sub_r;
+                for (int s = 0; s < samps; s++) {
+                    double r1 = 2 * rnd(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+                    double r2 = 2 * rnd(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+                    Vec d = cx * ( ( (sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                            cy * ( ( (sy + 0.5 + dy) / 2.0 + smallpt_y) / h - 0.5) + cam.d;
+                    sub_r = sub_r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1.0 / samps);
+                }
+                r = r + sub_r * 0.25;
+            }
+        }
+        int ir = toInt(r.x);
+        int ig = toInt(r.y);
+        int ib = toInt(r.z);
+        line_buffer[x] = 0xFF000000u | ((uint32_t)ib << 16) | ((uint32_t)ig << 8) | (uint32_t)ir;
+    }
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+void reset_default_colors() {
+    spheres[0].c = Vec(.75, .25, .25);       // Left: red
+    spheres[1].c = Vec(.25, .25, .75);       // Right: blue
+    spheres[2].c = Vec(.75, .75, .75);       // Back: grey
+    spheres[3].c = Vec(0, 0, 0);             // Front: black
+    spheres[4].c = Vec(.75, .75, .75);       // Bottom: grey
+    spheres[5].c = Vec(.75, .75, .75);       // Top: grey
+    spheres[6].c = Vec(1, 1, 1) * 0.999;     // Mirror
+    spheres[7].c = Vec(1, 1, 1) * 0.999;     // Glass
+    spheres[8].c = Vec(0, 0, 0);             // Light
+    spheres[8].e = Vec(12, 12, 12);
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+void randomize_sphere_colors(int seed) {
+    unsigned short Xi[3] = {(unsigned short)seed, (unsigned short)(seed >> 16), (unsigned short)(seed ^ 0xA55A)};
+    // Left wall: warm random color
+    spheres[0].c = Vec(0.25 + 0.65 * rnd(Xi), 0.05 + 0.45 * rnd(Xi), 0.05 + 0.45 * rnd(Xi));
+    // Right wall: cool random color
+    spheres[1].c = Vec(0.05 + 0.45 * rnd(Xi), 0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi));
+    // Back wall: pastel / neutral color
+    spheres[2].c = Vec(0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi));
+    // Floor
+    spheres[4].c = Vec(0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi));
+    // Ceiling
+    spheres[5].c = Vec(0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi), 0.25 + 0.65 * rnd(Xi));
+    // Mirror sphere tint (specular reflection tint)
+    spheres[6].c = Vec(0.6 + 0.399 * rnd(Xi), 0.6 + 0.399 * rnd(Xi), 0.6 + 0.399 * rnd(Xi));
+    // Glass sphere tint (dielectric transmission tint)
+    spheres[7].c = Vec(0.6 + 0.399 * rnd(Xi), 0.6 + 0.399 * rnd(Xi), 0.6 + 0.399 * rnd(Xi));
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+double get_sphere_color_r(int id) {
+    if (id < 0 || id >= 9) return 0;
+    return spheres[id].c.x;
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+double get_sphere_color_g(int id) {
+    if (id < 0 || id >= 9) return 0;
+    return spheres[id].c.y;
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+double get_sphere_color_b(int id) {
+    if (id < 0 || id >= 9) return 0;
+    return spheres[id].c.z;
+}
+
+[[cheerp::wasm]]
+[[cheerp::jsexport]]
+void set_sphere_color(int id, double r, double g, double b) {
+    if (id < 0 || id >= 9) return;
+    spheres[id].c = Vec(r, g, b);
+}
+
+[[cheerp::genericjs]]
+[[cheerp::jsexport]]
+void render_line_to_js(int y, int w, int h, int samps, client::Uint8ClampedArray* dest) {
+    render_line(y, w, h, samps);
+    int dest_offset = y * w * 4;
+    for (int x = 0; x < w; x++) {
+        uint32_t pixel = line_buffer[x];
+        int idx = dest_offset + x * 4;
+        (*dest)[idx]     = (uint8_t)(pixel & 0xFF);
+        (*dest)[idx + 1] = (uint8_t)((pixel >> 8) & 0xFF);
+        (*dest)[idx + 2] = (uint8_t)((pixel >> 16) & 0xFF);
+        (*dest)[idx + 3] = 255;
+    }
+}
+
+int main() {
+    return 0;
+}
