+</head>
+<body>
+  <header>
+    <h1>smallpt in WebAssembly</h1>
+    <p class="subtitle">Kevin Beason's 99-line C++ Global Illumination Path Tracer running client-side in your browser</p>
+    <div class="badge" aria-label="Runtime environment">WebAssembly (WASM) &bull; Client-Side</div>
+  </header>
+
+  <main>
+    <section class="card viewport-container" aria-labelledby="viewport-heading">
+      <h2 id="viewport-heading" class="sr-only" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0);">Path Tracer Viewport</h2>
+      
+      <div class="canvas-wrapper">
+        <canvas id="viewport" width="320" height="240" role="img" aria-label="Rendered smallpt Cornell Box with spheres">
+          Your browser does not support the HTML5 canvas element.
+        </canvas>
+      </div>
+
+      <div class="progress-bar-container" aria-hidden="true">
+        <div id="progress-fill" class="progress-bar-fill"></div>
+      </div>
+
+      <div id="status-text" class="status-text" role="status" aria-live="polite">
+        Initializing WebAssembly path tracer module...
+      </div>
+    </section>
+
+    <section class="card controls-card" aria-label="Renderer Controls">
+      <div class="controls-grid">
+        <div class="action-buttons">
+          <button id="btn-randomize" class="btn-randomize" type="button" aria-label="Run smallpt again with randomized sphere colors">
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
+            <span>Run Again with Randomized Sphere Colors</span>
+          </button>
+          
+          <button id="btn-reset" class="btn-secondary" type="button" aria-label="Reset to default Cornell Box sphere colors">
+            <span>Reset Colors</span>
+          </button>
+        </div>
+
+        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
+          <div class="setting-group">
+            <label for="select-resolution">Resolution:</label>
+            <select id="select-resolution">
+              <option value="240x180">240 &times; 180 (Fast)</option>
+              <option value="320x240" selected>320 &times; 240 (Default)</option>
+              <option value="400x300">400 &times; 300 (Crisp)</option>
+            </select>
+          </div>
+
+          <div class="setting-group">
+            <label for="select-samples">Quality:</label>
+            <select id="select-samples">
+              <option value="1">4 SPP (Preview)</option>
+              <option value="2" selected>8 SPP (Balanced)</option>
+              <option value="4">16 SPP (High Quality)</option>
+            </select>
+          </div>
+        </div>
+      </div>
+
+      <div class="scene-legend" id="scene-legend" aria-label="Scene Spheres and Materials">
+        <div class="legend-item">
+          <div class="swatch" id="swatch-left"></div>
+          <div class="legend-text">
+            <span class="legend-label">Left Wall</span>
+            <span class="legend-desc" id="desc-left">Diffuse (Lambertian)</span>
+          </div>
+        </div>
+        <div class="legend-item">
+          <div class="swatch" id="swatch-right"></div>
+          <div class="legend-text">
+            <span class="legend-label">Right Wall</span>
+            <span class="legend-desc" id="desc-right">Diffuse (Lambertian)</span>
+          </div>
+        </div>
+        <div class="legend-item">
+          <div class="swatch" id="swatch-back"></div>
+          <div class="legend-text">
+            <span class="legend-label">Back Wall &amp; Room</span>
+            <span class="legend-desc" id="desc-back">Diffuse (Lambertian)</span>
+          </div>
+        </div>
+        <div class="legend-item">
+          <div class="swatch" id="swatch-mirror"></div>
+          <div class="legend-text">
+            <span class="legend-label">Left Sphere</span>
+            <span class="legend-desc" id="desc-mirror">Specular (Mirror)</span>
+          </div>
+        </div>
+        <div class="legend-item">
+          <div class="swatch" id="swatch-glass"></div>
+          <div class="legend-text">
+            <span class="legend-label">Right Sphere</span>
+            <span class="legend-desc" id="desc-glass">Refractive (Glass)</span>
+          </div>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <p>Based on <a href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a> by Kevin Beason &bull; Compiled to WebAssembly using Cheerp C++ compiler</p>
+  </footer>
+
+  <script type="module">
+    import loadSmallpt from "./smallpt.js";
+    import { SMALLPT_WASM_BASE64 } from "./smallpt-wasm-base64.js";
+
+    const canvas = document.getElementById("viewport");
+    const ctx = canvas.getContext("2d", { willReadFrequently: true });
+    const progressFill = document.getElementById("progress-fill");
+    const statusText = document.getElementById("status-text");
+    const btnRandomize = document.getElementById("btn-randomize");
+    const btnReset = document.getElementById("btn-reset");
+    const selectResolution = document.getElementById("select-resolution");
+    const selectSamples = document.getElementById("select-samples");
+
+    let smallpt = null;
+    let isRendering = false;
+    let cancelRender = false;
+    let seedCounter = Math.floor(Math.random() * 100000) + 1;
+
+    // Load WebAssembly module with fallback for file:// or offline URLs
+    async function initWasm() {
+      try {
+        statusText.textContent = "Loading WebAssembly module...";
+        try {
+          smallpt = await loadSmallpt();
+        } catch (fetchErr) {
+          console.warn("Fetch failed, falling back to embedded WASM binary:", fetchErr);
+          const binaryString = atob(SMALLPT_WASM_BASE64);
+          const len = binaryString.length;
+          const bytes = new Uint8Array(len);
+          for (let i = 0; i < len; i++) {
+            bytes[i] = binaryString.charCodeAt(i);
+          }
+          smallpt = await loadSmallpt({ buffer: bytes.buffer });
+        }
+        statusText.textContent = "WebAssembly module ready. Starting initial render...";
+        updateSwatches();
+        startRender();
+      } catch (err) {
+        console.error("Failed to load WebAssembly module:", err);
+        statusText.textContent = "Error loading WebAssembly module: " + err.message;
+      }
+    }
+
+    function vecToRgb(r, g, b) {
+      const ir = Math.min(255, Math.max(0, Math.round(r * 255)));
+      const ig = Math.min(255, Math.max(0, Math.round(g * 255)));
+      const ib = Math.min(255, Math.max(0, Math.round(b * 255)));
+      return `rgb(${ir}, ${ig}, ${ib})`;
+    }
+
+    function updateSwatches() {
+      if (!smallpt) return;
+      const leftR = smallpt.get_sphere_color_r(0);
+      const leftG = smallpt.get_sphere_color_g(0);
+      const leftB = smallpt.get_sphere_color_b(0);
+      document.getElementById("swatch-left").style.backgroundColor = vecToRgb(leftR, leftG, leftB);
+
+      const rightR = smallpt.get_sphere_color_r(1);
+      const rightG = smallpt.get_sphere_color_g(1);
+      const rightB = smallpt.get_sphere_color_b(1);
+      document.getElementById("swatch-right").style.backgroundColor = vecToRgb(rightR, rightG, rightB);
+
+      const backR = smallpt.get_sphere_color_r(2);
+      const backG = smallpt.get_sphere_color_g(2);
+      const backB = smallpt.get_sphere_color_b(2);
+      document.getElementById("swatch-back").style.backgroundColor = vecToRgb(backR, backG, backB);
+
+      const mirR = smallpt.get_sphere_color_r(6);
+      const mirG = smallpt.get_sphere_color_g(6);
+      const mirB = smallpt.get_sphere_color_b(6);
+      document.getElementById("swatch-mirror").style.backgroundColor = vecToRgb(mirR, mirG, mirB);
+
+      const glsR = smallpt.get_sphere_color_r(7);
+      const glsG = smallpt.get_sphere_color_g(7);
+      const glsB = smallpt.get_sphere_color_b(7);
+      document.getElementById("swatch-glass").style.backgroundColor = vecToRgb(glsR, glsG, glsB);
+    }
+
+    async function startRender() {
+      if (!smallpt) return;
+      if (isRendering) {
+        cancelRender = true;
+        // Wait briefly for current frame to stop
+        await new Promise(r => setTimeout(r, 40));
+      }
+
+      const [w, h] = selectResolution.value.split("x").map(Number);
+      const samples = parseInt(selectSamples.value, 10);
+      const totalSpp = samples * 4;
+
+      if (canvas.width !== w || canvas.height !== h) {
+        canvas.width = w;
+        canvas.height = h;
+      }
+
+      const imageData = ctx.createImageData(w, h);
+      // Pre-fill alpha channel
+      for (let i = 3; i < imageData.data.length; i += 4) {
+        imageData.data[i] = 255;
+      }
+
+      isRendering = true;
+      cancelRender = false;
+      btnRandomize.disabled = true;
+      btnReset.disabled = true;
+
+      const startTime = performance.now();
+      progressFill.style.width = "0%";
+      statusText.textContent = `Rendering (${w}×${h}, ${totalSpp} SPP)...`;
+
+      // Render progressively line-by-line in batches for smooth frame rates
+      const linesPerBatch = Math.max(1, Math.floor(h / 30));
+      let currentY = 0;
+
+      function renderBatch() {
+        if (cancelRender) {
+          isRendering = false;
+          btnRandomize.disabled = false;
+          btnReset.disabled = false;
+          return;
+        }
+
+        const endY = Math.min(h, currentY + linesPerBatch);
+        for (let y = currentY; y < endY; y++) {
+          smallpt.render_line_to_js(y, w, h, samples, imageData.data);
+        }
+
+        ctx.putImageData(imageData, 0, 0);
+        currentY = endY;
+        const progress = Math.round((currentY / h) * 100);
+        progressFill.style.width = `${progress}%`;
+
+        if (currentY < h) {
+          statusText.textContent = `Rendering (${w}×${h}, ${totalSpp} SPP) — ${progress}%`;
+          requestAnimationFrame(renderBatch);
+        } else {
+          const duration = Math.round(performance.now() - startTime);
+          statusText.textContent = `Render completed in ${duration} ms (${w}×${h}, ${totalSpp} SPP)`;
+          progressFill.style.width = "100%";
+          isRendering = false;
+          btnRandomize.disabled = false;
+          btnReset.disabled = false;
+        }
+      }
+
+      requestAnimationFrame(renderBatch);
+    }
+
+    btnRandomize.addEventListener("click", () => {
+      if (!smallpt || isRendering) return;
+      seedCounter = (seedCounter * 1664525 + 1013904223) & 0x7FFFFFFF;
+      smallpt.randomize_sphere_colors(seedCounter);
+      updateSwatches();
+      startRender();
+    });
+
+    btnReset.addEventListener("click", () => {
+      if (!smallpt || isRendering) return;
+      smallpt.reset_default_colors();
+      updateSwatches();
+      startRender();
+    });
+
+    selectResolution.addEventListener("change", () => {
+      if (!smallpt || isRendering) return;
+      startRender();
+    });
+
+    selectSamples.addEventListener("change", () => {
+      if (!smallpt || isRendering) return;
+      startRender();
+    });
+
+    initWasm();
+  </script>
+</body>
+</html>
