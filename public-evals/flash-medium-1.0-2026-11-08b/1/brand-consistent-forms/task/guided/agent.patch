+
+      // Sync slider progress for WebKit background fill gradient & update roast labels
+      function updateRoastSlider() {
+        const val = roastSlider.value;
+        const min = Number(roastSlider.min) || 1;
+        const max = Number(roastSlider.max) || 5;
+        const percent = ((val - min) / (max - min)) * 100;
+
+        roastSlider.style.setProperty('--slider-progress', `${percent}%`);
+
+        const profile = roastProfiles[val] || roastProfiles['3'];
+        roastBadge.textContent = profile.title;
+        roastSlider.setAttribute('aria-valuetext', profile.ariaText);
+        roastFlavorNote.innerHTML = `<strong>Flavor Notes:</strong> ${profile.notes}`;
+      }
+
+      // Dynamically calculate setup completion status across all 5 elements
+      function updateSubscriptionProgress() {
+        let completedSteps = 0;
+        const totalSteps = 5;
+
+        // 1. Delivery frequency selected
+        const freqSelected = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (freqSelected) completedSteps++;
+
+        // 2. Roast preference set
+        if (roastSlider.value) completedSteps++;
+
+        // 3. Email notifications preference confirmed
+        if (emailCheckbox.checked) completedSteps++;
+
+        // 4. Name entered
+        if (nameInput.value.trim().length > 0) completedSteps++;
+
+        // 5. Valid email entered
+        const emailValid = emailInput.value.trim().length > 0 && emailInput.checkValidity();
+        if (emailValid) completedSteps++;
+
+        const percent = Math.round((completedSteps / totalSteps) * 100);
+        progressBar.value = percent;
+        progressBar.textContent = `${percent}%`;
+        progressPercentText.textContent = `${percent}% Completed`;
+
+        if (percent === 100) {
+          progressHint.textContent = '🎉 All steps completed! You are ready to start your subscription.';
+        } else {
