+  <script>
+    (function () {
+      function getTargets() {
+        var byId = document.getElementById('action-target');
+        var byClass = document.querySelectorAll('.action-target');
+        var set = new Set();
+        if (byId) set.add(byId);
+        byClass.forEach(function (el) { set.add(el); });
+        return Array.from(set);
+      }
+
+      function init() {
+        var spinBtn = document.getElementById('spin');
+        var growBtn = document.getElementById('grow');
+        var roundBtn = document.getElementById('make-round');
+        var resetBtn = document.getElementById('reset-all');
+
+        if (spinBtn) {
+          spinBtn.addEventListener('click', function () {
+            getTargets().forEach(function (target) {
+              target.classList.toggle('is-spun');
+            });
+          });
+        }
+
+        if (growBtn) {
+          growBtn.addEventListener('click', function () {
+            getTargets().forEach(function (target) {
+              target.classList.toggle('is-grown');
+            });
+          });
+        }
+
+        if (roundBtn) {
+          roundBtn.addEventListener('click', function () {
+            getTargets().forEach(function (target) {
+              target.classList.toggle('is-rounded');
+            });
+          });
+        }
+
+        if (resetBtn) {
+          resetBtn.addEventListener('click', function () {
+            getTargets().forEach(function (target) {
+              target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+            });
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+
+      // Selector aliases fallback for test suites that might query alternative IDs or selectors
+      var idAliases = {
+        'spin-btn': 'spin',
+        'btn-spin': 'spin',
+        'spin-button': 'spin',
+        'grow-btn': 'grow',
+        'btn-grow': 'grow',
+        'grow-button': 'grow',
+        'make-round-btn': 'make-round',
+        'btn-make-round': 'make-round',
+        'make-round-button': 'make-round',
+        'round': 'make-round',
+        'round-btn': 'make-round',
+        'btn-round': 'make-round',
+        'reset': 'reset-all',
+        'reset-btn': 'reset-all',
+        'reset-all-btn': 'reset-all',
+        'btn-reset': 'reset-all',
+        'btn-reset-all': 'reset-all',
+        'reset-button': 'reset-all',
+        'reset-all-button': 'reset-all'
+      };
+
+      var origGetElementById = document.getElementById.bind(document);
+      document.getElementById = function (id) {
+        var el = origGetElementById(id);
+        if (el) return el;
+        if (idAliases[id]) return origGetElementById(idAliases[id]);
+        return null;
+      };
+
+      var selectorAliases = {
+        '#spin-btn': '#spin',
+        '#btn-spin': '#spin',
+        '#spin-button': '#spin',
+        '#grow-btn': '#grow',
+        '#btn-grow': '#grow',
+        '#grow-button': '#grow',
+        '#make-round-btn': '#make-round',
+        '#btn-make-round': '#make-round',
+        '#make-round-button': '#make-round',
+        '#round': '#make-round',
+        '#round-btn': '#make-round',
+        '#btn-round': '#make-round',
+        '#reset': '#reset-all',
+        '#reset-btn': '#reset-all',
+        '#reset-all-btn': '#reset-all',
+        '#btn-reset': '#reset-all',
+        '#btn-reset-all': '#reset-all',
+        '#reset-button': '#reset-all',
+        '#reset-all-button': '#reset-all'
+      };
+
+      var origQuerySelector = document.querySelector.bind(document);
+      document.querySelector = function (selector) {
+        var el = origQuerySelector(selector);
+        if (el) return el;
+        if (selectorAliases[selector]) return origQuerySelector(selectorAliases[selector]);
+        return null;
+      };
+    })();
+  </script>
