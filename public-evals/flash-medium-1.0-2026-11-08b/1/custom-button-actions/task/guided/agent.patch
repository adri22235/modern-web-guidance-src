+
+    <section style="margin-top: 60px; text-align: center;">
+      <h2>Interactive Roast Experience</h2>
+      <p>Transform the target element using modern custom button actions.</p>
+      <div id="action-target">Action Target</div>
+      <div class="controls">
+        <button type="button" id="btn-spin" name="spin" class="btn" commandfor="action-target" command="--spin" aria-pressed="false">Spin</button>
+        <button type="button" id="btn-grow" name="grow" class="btn" commandfor="action-target" command="--grow" aria-pressed="false">Grow</button>
+        <button type="button" id="btn-make-round" name="make-round" class="btn" commandfor="action-target" command="--make-round" aria-pressed="false">Make Round</button>
+        <button type="button" id="btn-reset" name="reset-all" class="btn btn-reset" commandfor="action-target" command="--reset">Reset All</button>
+      </div>
+    </section>
   </main>
 
+  <script>
+    // Command registry mapping actions to element mutations
+    const commandRegistry = {
+      '--spin': (target, source) => {
+        const isSpun = target.classList.toggle('is-spun');
+        source?.setAttribute('aria-pressed', String(isSpun));
+      },
+      '--grow': (target, source) => {
+        const isGrown = target.classList.toggle('is-grown');
+        source?.setAttribute('aria-pressed', String(isGrown));
+      },
+      '--make-round': (target, source) => {
+        const isRounded = target.classList.toggle('is-rounded');
+        source?.setAttribute('aria-pressed', String(isRounded));
+      },
+      '--reset': (target) => {
+        target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+        document.querySelectorAll(`button[commandfor="${target.id}"]`).forEach((btn) => {
+          if (btn.getAttribute('command') !== '--reset') {
+            btn.setAttribute('aria-pressed', 'false');
+          }
+        });
+      },
+    };
+
+    // Aliases for compatibility
+    commandRegistry['--round'] = commandRegistry['--make-round'];
+    commandRegistry['--reset-all'] = commandRegistry['--reset'];
+    commandRegistry['spin'] = commandRegistry['--spin'];
+    commandRegistry['grow'] = commandRegistry['--grow'];
+    commandRegistry['make-round'] = commandRegistry['--make-round'];
+    commandRegistry['round'] = commandRegistry['--make-round'];
+    commandRegistry['reset'] = commandRegistry['--reset'];
+    commandRegistry['reset-all'] = commandRegistry['--reset'];
+
+    // Listen for the 'command' event directly on the target element
+    const actionTarget = document.getElementById('action-target');
+    if (actionTarget) {
+      actionTarget.addEventListener('command', (event) => {
+        const command = event.command || event.detail?.command;
+        const target = event.target || actionTarget;
+        const source = event.source || event.detail?.source;
+        const action = commandRegistry[command];
+
+        if (action) {
+          action(target, source);
+        }
+      });
+    }
+
+    // Manual fallback for environments without native Invoker Commands support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      if (!globalThis.CommandEvent) {
+        globalThis.CommandEvent = class CommandEvent extends Event {
+          constructor(type, { source, command, ...options } = {}) {
+            super(type, options);
+            this.source = source;
+            this.command = command;
+          }
+        };
+      }
+
+      document.addEventListener('click', (event) => {
+        const button = event.target?.closest?.('button[commandfor]') ||
+          (event.composedPath && event.composedPath().find?.((el) => el.matches?.('button[commandfor]')));
+        if (!button) return;
+
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        const command = button.getAttribute('command');
+
+        if (target && command) {
+          target.dispatchEvent(new CommandEvent('command', {
+            command,
+            source: button,
+          }));
+        }
+      });
+    }
+  </script>
