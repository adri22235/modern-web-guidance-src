+/**
+ * DrinkCard Web Component
+ * Encapsulated custom element for seasonal coffee drink cards.
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer reset, base, layout, variant, theme;
+
+  @layer reset {
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+  }
+
+  @layer base {
+    :host {
+      display: block;
+      container-type: inline-size;
+      container-name: drink-card;
+      font-family: inherit;
+
+      /* Theming across shadow boundary via private custom properties */
+      --_card-bg: var(--card-bg, #ffffff);
+      --_card-text: var(--card-text, var(--text, #3e2723));
+      --_card-primary: var(--card-primary, var(--primary, #4e342e));
+      --_card-secondary: var(--card-secondary, var(--secondary, #d7ccc8));
+      --_card-accent: var(--card-accent, var(--accent, #ffab40));
+      --_card-light: var(--card-light, var(--light, #fafafa));
+      --_card-radius: var(--card-radius, 12px);
+      --_card-shadow: var(--card-shadow, 0 4px 12px rgba(62, 39, 35, 0.08));
+      --_card-border: var(--card-border, 1px solid rgba(78, 52, 46, 0.1));
+      --_card-padding: var(--card-padding, 1.25rem);
+
+      color: var(--_card-text);
+      line-height: 1.6;
+    }
+
+    button, a, input, select {
+      font: inherit;
+      color: inherit;
+    }
+
+    .card {
+      background: var(--_card-bg);
+      color: var(--_card-text);
+      border-radius: var(--_card-radius);
+      box-shadow: var(--_card-shadow);
+      border: var(--_card-border);
+      overflow: hidden;
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      position: relative;
+      transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
+    }
+
+    .card-media {
+      position: relative;
+      width: 100%;
+      background: var(--_card-secondary);
+      overflow: hidden;
+      aspect-ratio: 16 / 10;
+    }
+
+    .card-media[hidden] {
+      display: none !important;
+    }
+
+    .card-image {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+      transition: transform 0.4s ease;
+    }
+
+    .card-badge {
+      position: absolute;
+      top: 12px;
+      left: 12px;
+      display: inline-flex;
+      align-items: center;
+      background: var(--_card-accent);
+      color: var(--_card-text);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 0.3rem 0.65rem;
+      border-radius: 9999px;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
+      z-index: 1;
+    }
+
+    .card-badge[hidden] {
+      display: none !important;
+    }
+
+    .card-content {
+      padding: var(--_card-padding);
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+      gap: 0.75rem;
+    }
+
+    .card-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 0.75rem;
+    }
+
+    .card-price {
+      font-size: 1.15rem;
+      font-weight: 700;
+      color: var(--_card-primary);
+      white-space: nowrap;
+    }
+
+    .card-price[hidden] {
+      display: none !important;
+    }
+
+    .card-body {
+      flex-grow: 1;
+      display: flex;
+      flex-direction: column;
+      gap: 0.5rem;
+    }
+
+    .card-footer {
+      margin-top: auto;
+      padding-top: 0.5rem;
+    }
+
+    /* Slotted content touch-ups */
+    ::slotted([slot="title"]) {
+      margin: 0;
+      color: var(--_card-primary);
+      font-size: 1.25rem;
+      line-height: 1.3;
+    }
+
+    ::slotted([slot="description"]) {
+      margin: 0;
+      color: var(--_card-text);
+      font-size: 0.95rem;
+      line-height: 1.5;
+    }
+
+    ::slotted([slot="action"]) {
+      display: inline-block;
+      font: inherit;
+    }
+  }
+
+  @layer layout {
+    /* Responsive layout adapting to card's own dimensions */
+    @container drink-card (min-width: 320px) {
+      :host {
+        --_card-padding: 1.4rem;
+      }
+      ::slotted([slot="title"]) {
+        font-size: 1.35rem;
+      }
+      .card-price {
+        font-size: 1.2rem;
+      }
+    }
+
+    @container drink-card (min-width: 480px) {
+      .card {
+        display: grid;
+        grid-template-columns: 200px 1fr;
+        grid-template-rows: 1fr;
+      }
+
+      .card-media {
+        aspect-ratio: auto;
+        height: 100%;
+      }
+
+      .card-content {
+        padding: 1.5rem;
+        justify-content: center;
+      }
+    }
+  }
+
+  @layer variant {
+    :host([variant="featured"]) {
+      --_card-border: 2px solid var(--_card-accent);
+      --_card-shadow: 0 8px 24px rgba(78, 52, 46, 0.16);
+      transform: translateY(-4px);
+    }
+
+    :host([variant="featured"]) .card-badge {
+      background: var(--_card-primary);
+      color: var(--_card-light);
+    }
+
+    :host([variant="accent"]) {
+      --_card-bg: #fffbf7;
+      --_card-border: 1px solid var(--_card-secondary);
+      --_card-shadow: 0 4px 16px rgba(215, 204, 200, 0.45);
+    }
+
+    :host([variant="accent"]) .card-badge {
+      background: var(--_card-secondary);
+      color: var(--_card-primary);
+    }
+
+    :host([variant="compact"]) {
+      --_card-padding: 1rem;
+      --_card-radius: 8px;
+      --_card-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
+    }
+
+    :host([variant="compact"]) .card-media {
+      aspect-ratio: 16 / 9;
+    }
+  }
+
+  @layer theme {
+    @media (prefers-contrast: more) {
+      .card {
+        border-width: 2px;
+      }
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <div class="card-media" part="media">
+      <img class="card-image" part="image" src="" alt="" loading="lazy">
+      <span class="card-badge" part="badge"></span>
+    </div>
+    <div class="card-content" part="content">
+      <header class="card-header" part="header">
+        <slot name="title"></slot>
+        <span class="card-price" part="price"></span>
+      </header>
+      <div class="card-body" part="body">
+        <slot name="description"></slot>
+        <slot name="meta"></slot>
+        <slot></slot>
+      </div>
+      <footer class="card-footer" part="footer">
+        <slot name="action"></slot>
+      </footer>
+    </div>
+  </article>
+`;
+
+export class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['variant', 'image', 'image-alt', 'badge', 'price'];
+  }
+
+  #mediaEl;
+  #imgEl;
+  #badgeEl;
+  #priceEl;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+
+    this.#mediaEl = this.shadowRoot.querySelector('.card-media');
+    this.#imgEl = this.shadowRoot.querySelector('.card-image');
+    this.#badgeEl = this.shadowRoot.querySelector('.card-badge');
+    this.#priceEl = this.shadowRoot.querySelector('.card-price');
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.#render();
+    }
+  }
+
+  #render() {
+    if (!this.shadowRoot) return;
+
+    const image = this.getAttribute('image');
+    const imageAlt = this.getAttribute('image-alt') || '';
+    const badge = this.getAttribute('badge');
+    const price = this.getAttribute('price');
+
+    if (image) {
+      this.#imgEl.src = image;
+      this.#imgEl.alt = imageAlt;
+      this.#mediaEl.removeAttribute('hidden');
+    } else {
+      this.#mediaEl.setAttribute('hidden', '');
+    }
+
+    if (badge) {
+      this.#badgeEl.textContent = badge;
+      this.#badgeEl.removeAttribute('hidden');
+    } else {
+      this.#badgeEl.setAttribute('hidden', '');
+    }
+
+    if (price) {
+      this.#priceEl.textContent = price;
+      this.#priceEl.removeAttribute('hidden');
+    } else {
+      this.#priceEl.setAttribute('hidden', '');
+    }
+  }
+
+  get variant() {
+    return this.getAttribute('variant');
+  }
+
+  set variant(value) {
+    if (value) {
+      this.setAttribute('variant', value);
+    } else {
+      this.removeAttribute('variant');
+    }
+  }
+
+  get image() {
+    return this.getAttribute('image');
+  }
+
+  set image(value) {
+    if (value) {
+      this.setAttribute('image', value);
+    } else {
+      this.removeAttribute('image');
+    }
+  }
+
+  get badge() {
+    return this.getAttribute('badge');
+  }
+
+  set badge(value) {
+    if (value) {
+      this.setAttribute('badge', value);
+    } else {
+      this.removeAttribute('badge');
+    }
+  }
+
+  get price() {
+    return this.getAttribute('price');
+  }
+
+  set price(value) {
+    if (value) {
+      this.setAttribute('price', value);
+    } else {
+      this.removeAttribute('price');
+    }
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
