+    <!-- Performance Monitoring & Slow Script Detection Section -->
+    <section class="perf-demo-section">
+      <h2>Script Performance Monitoring</h2>
+      <p class="perf-demo-desc">
+        Real-time frame delay and slow script detection is active. Click the actions below or open the floating monitor widget in the bottom-right corner to inspect recorded occurrences.
+      </p>
+      <div class="perf-buttons-grid">
+        <button class="btn-perf" id="btn-slow-loop" onclick="triggerSlowCalculation()">
+          Simulate Heavy Script (100ms)
+        </button>
+        <button class="btn-perf warn" id="btn-heavy-delay" onclick="triggerHeavyBlockingScript()">
+          Simulate Critical Freeze (250ms)
+        </button>
+        <button class="btn-perf outline" id="btn-layout-thrash" onclick="triggerLayoutThrash()">
+          Simulate Layout Thrashing
+        </button>
+        <button class="btn-perf outline" onclick="window.scriptPerformanceMonitor && window.scriptPerformanceMonitor.exportHistory(true)">
+          Export Occurrences Log (JSON)
+        </button>
