   </main>
 
+  <script>
+    function triggerSlowCalculation() {
+      const btn = document.getElementById('btn-slow-loop');
+      btn.textContent = 'Processing...';
+      setTimeout(() => {
+        // Block main thread for ~100ms
+        const start = performance.now();
+        while (performance.now() - start < 100) {
+          Math.sin(Math.random());
+        }
+        btn.textContent = 'Simulate Heavy Script (100ms)';
+      }, 10);
+    }
+
+    function triggerHeavyBlockingScript() {
+      const btn = document.getElementById('btn-heavy-delay');
+      btn.textContent = 'Blocking Main Thread...';
+      setTimeout(() => {
+        // Block main thread for ~250ms
+        const start = performance.now();
+        while (performance.now() - start < 250) {
+          Math.sqrt(Math.random() * 999999);
+        }
+        btn.textContent = 'Simulate Critical Freeze (250ms)';
+      }, 10);
+    }
+
+    function triggerLayoutThrash() {
+      const btn = document.getElementById('btn-layout-thrash');
+      btn.textContent = 'Thrashing DOM...';
+      setTimeout(() => {
+        const dummy = document.createElement('div');
+        dummy.style.position = 'absolute';
+        dummy.style.visibility = 'hidden';
+        document.body.appendChild(dummy);
+        for (let i = 0; i < 80; i++) {
+          dummy.style.width = (100 + (i % 20)) + 'px';
+          // Force reflow
+          const w = dummy.offsetWidth;
+        }
+        document.body.removeChild(dummy);
+        btn.textContent = 'Simulate Layout Thrashing';
+      }, 10);
+    }
+  </script>
