+  <script>
+    (function () {
+      const roastSelector = document.getElementById('roast-selector');
+      const roastBtn = document.getElementById('roast-select-btn');
+      const roastDropdown = document.getElementById('roast-dropdown-list');
+      const selectedText = document.getElementById('selected-roast-text');
+      const options = Array.from(roastDropdown.querySelectorAll('.roast-option'));
+      const nativeSelect = document.getElementById('roast-select');
+
+      function openDropdown() {
+        roastSelector.classList.add('open');
+        roastDropdown.classList.add('open');
+        roastBtn.setAttribute('aria-expanded', 'true');
+      }
+
+      function closeDropdown() {
+        roastSelector.classList.remove('open');
+        roastDropdown.classList.remove('open');
+        roastBtn.setAttribute('aria-expanded', 'false');
+      }
+
+      function toggleDropdown() {
+        if (roastSelector.classList.contains('open')) {
+          closeDropdown();
+        } else {
+          openDropdown();
+        }
+      }
+
+      function selectRoast(val) {
+        options.forEach(opt => {
+          const isSelected = opt.getAttribute('data-value') === val;
+          opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+          if (isSelected) {
+            opt.classList.add('selected');
+            selectedText.textContent = opt.querySelector('.option-label').textContent;
+          } else {
+            opt.classList.remove('selected');
+          }
+        });
+
+        if (nativeSelect && nativeSelect.value !== val) {
+          nativeSelect.value = val;
+          nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+
+        closeDropdown();
+        roastBtn.focus();
+      }
+
+      roastBtn.addEventListener('click', toggleDropdown);
+
+      roastBtn.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          openDropdown();
+          const currentSelected = roastDropdown.querySelector('.selected') || options[0];
+          currentSelected.focus();
+        }
+      });
+
+      options.forEach((opt, idx) => {
+        opt.addEventListener('click', () => {
+          selectRoast(opt.getAttribute('data-value'));
+        });
+
+        opt.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            const next = options[(idx + 1) % options.length];
+            next.focus();
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            const prev = options[(idx - 1 + options.length) % options.length];
+            prev.focus();
+          } else if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            selectRoast(opt.getAttribute('data-value'));
+          } else if (e.key === 'Escape') {
+            closeDropdown();
+            roastBtn.focus();
+          }
+        });
+      });
+
+      if (nativeSelect) {
+        nativeSelect.addEventListener('change', () => {
+          selectRoast(nativeSelect.value);
+        });
+      }
+
+      document.addEventListener('click', (e) => {
+        if (!roastSelector.contains(e.target)) {
+          closeDropdown();
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          closeDropdown();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
