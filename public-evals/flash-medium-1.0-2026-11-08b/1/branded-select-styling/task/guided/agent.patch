+    /* Coffee Roast Selector */
+    .roast-selector-container {
+      margin: 1.25rem 0;
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+    }
+
+    .roast-label {
+      font-size: 1rem;
+      font-weight: 600;
+      color: var(--accent);
+      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
+    }
+
+    /* Customizable Select Opt-in */
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    /* Style the visible trigger button */
+    .roast-select {
+      font-family: inherit;
+      font-size: 1rem;
+      background-color: #4e342e;
+      color: #fafafa;
+      border: 2px solid #ffab40;
+      border-radius: 6px;
+      padding: 8px 16px;
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      min-width: 170px;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    .roast-select:focus-visible {
+      outline: 2px solid #ffab40;
+      outline-offset: 2px;
+    }
+
+    .roast-select button {
+      background: transparent;
+      border: none;
+      color: inherit;
+      font: inherit;
+      padding: 0;
+      cursor: pointer;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+    }
+
+    /* Dropdown list picker */
+    .roast-select::picker(select) {
+      background-color: #4e342e;
+      border: 2px solid #ffab40;
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
+      color: #fafafa;
+      margin-top: 4px;
+    }
+
+    /* Arrow icon */
+    .roast-select::picker-icon,
+    .roast-select button::picker-icon {
+      color: #ffab40;
+      transition: transform 0.2s ease;
+    }
+
+    .roast-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    /* Checkmark indicator */
+    .roast-select option::checkmark {
+      color: #ffab40;
+    }
+
+    /* Option items and hover states */
+    .roast-select option {
+      padding: 8px 12px;
+      border-radius: 4px;
+      color: #fafafa;
+      cursor: pointer;
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus {
+      background-color: #ffab40;
+      color: #4e342e;
+    }
+
+    .roast-select option:hover::checkmark,
+    .roast-select option:focus::checkmark {
+      color: #4e342e;
+    }
+
+    .roast-select option:checked {
+      font-weight: 600;
+      background-color: rgba(255, 171, 64, 0.15);
+      color: #ffab40;
+    }
+
