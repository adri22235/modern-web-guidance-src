+  <script>
+    (function () {
+      function initCarousel() {
+        const carousel = document.querySelector('.carousel');
+        if (!carousel) return;
+
+        const viewport = carousel.querySelector('.carousel-viewport');
+        const cards = Array.from(carousel.querySelectorAll('.card'));
+        const prevBtn = carousel.querySelector('#prev-btn');
+        const nextBtn = carousel.querySelector('#next-btn');
+
+        if (!cards.length || !prevBtn || !nextBtn) return;
+
+        let currentIndex = cards.findIndex(c => c.classList.contains('active'));
+        if (currentIndex === -1) {
+          currentIndex = 0;
+          cards[0].classList.add('active');
+        }
+
+        // Initialize state
+        cards.forEach((card, idx) => {
+          if (idx === currentIndex) {
+            card.classList.add('active');
+            card.setAttribute('aria-hidden', 'false');
+          } else {
+            card.classList.remove('active', 'slide-in-right', 'slide-in-left', 'slide-out-left', 'slide-out-right');
+            card.setAttribute('aria-hidden', 'true');
+          }
+        });
+
+        let currentCleanup = null;
+
+        function navigate(direction) {
+          if (cards.length <= 1) return;
+
+          // If an animation is currently running, complete it immediately
+          if (currentCleanup) {
+            currentCleanup();
+          }
+
+          const targetIndex = direction === 'next'
+            ? (currentIndex + 1) % cards.length
+            : (currentIndex - 1 + cards.length) % cards.length;
+
+          const outgoingCard = cards[currentIndex];
+          const incomingCard = cards[targetIndex];
+
+          const outClass = direction === 'next' ? 'slide-out-left' : 'slide-out-right';
+          const inClass = direction === 'next' ? 'slide-in-right' : 'slide-in-left';
+
+          // Lock height of viewport to prevent layout shift during transition
+          if (viewport) {
+            viewport.style.height = `${viewport.offsetHeight}px`;
+          }
+
+          // Immediately update active status for accessibility & test state
+          outgoingCard.classList.remove('active');
+          outgoingCard.setAttribute('aria-hidden', 'true');
+          outgoingCard.classList.add(outClass);
+
+          incomingCard.classList.add('active', inClass);
+          incomingCard.setAttribute('aria-hidden', 'false');
+
+          let finished = false;
+          const cleanup = () => {
+            if (finished) return;
+            finished = true;
+            clearTimeout(safetyTimer);
+            incomingCard.removeEventListener('animationend', onEnd);
+
+            outgoingCard.classList.remove(outClass);
+            incomingCard.classList.remove(inClass);
+
+            if (viewport) {
+              viewport.style.height = '';
+            }
+            currentIndex = targetIndex;
+            currentCleanup = null;
+          };
+
+          currentCleanup = cleanup;
+
+          const onEnd = (e) => {
+            if (!e || e.target === incomingCard) {
+              cleanup();
+            }
+          };
+
+          incomingCard.addEventListener('animationend', onEnd);
+          const safetyTimer = setTimeout(cleanup, 450);
+        }
+
+        nextBtn.addEventListener('click', () => navigate('next'));
+        prevBtn.addEventListener('click', () => navigate('prev'));
+
+        document.addEventListener('keydown', (e) => {
+          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) {
+            return;
+          }
+          if (e.key === 'ArrowRight') {
+            navigate('next');
+          } else if (e.key === 'ArrowLeft') {
+            navigate('prev');
+          }
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initCarousel);
+      } else {
+        initCarousel();
+      }
+    })();
+  </script>
+
 </body>
 
