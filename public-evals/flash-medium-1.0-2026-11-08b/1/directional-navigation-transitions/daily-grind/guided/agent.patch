+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.carousel-card-wrapper .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      let currentIndex = 0;
+
+      function applyFallbackAnimation(direction) {
+        const wrapper = document.getElementById('carousel-card-wrapper');
+        if (!wrapper) return;
+        wrapper.classList.remove('fallback-forward', 'fallback-backward');
+        void wrapper.offsetWidth;
+        wrapper.classList.add(direction === 'forward' ? 'fallback-forward' : 'fallback-backward');
+      }
+
+      function navigate(updateDOM, direction) {
+        document.documentElement.dataset.transitionDirection = direction;
+
+        // Feature detect for browsers that do not support View Transitions
+        if (!document.startViewTransition) {
+          updateDOM();
+          applyFallbackAnimation(direction);
+          delete document.documentElement.dataset.transitionDirection;
+          return;
+        }
+
+        try {
+          const transition = document.startViewTransition({
+            update: updateDOM,
+            types: [direction] // Matches the CSS :active-view-transition-type() selectors
+          });
+          transition.ready?.catch(() => {});
+          transition.finished?.finally(() => {
+            delete document.documentElement.dataset.transitionDirection;
+          });
+        } catch (err) {
+          try {
+            const transition = document.startViewTransition(updateDOM);
+            transition.ready?.catch(() => {});
+            transition.finished?.finally(() => {
+              delete document.documentElement.dataset.transitionDirection;
+            });
+          } catch (e) {
+            updateDOM();
+            applyFallbackAnimation(direction);
+            delete document.documentElement.dataset.transitionDirection;
+          }
+        }
+      }
+
+      function showCard(newIndex, direction) {
+        if (newIndex === currentIndex) return;
+
+        function updateDOM() {
+          cards[currentIndex].classList.remove('active');
+          cards[currentIndex].hidden = true;
+          currentIndex = newIndex;
+          cards[currentIndex].classList.add('active');
+          cards[currentIndex].hidden = false;
+        }
+
+        navigate(updateDOM, direction);
+      }
+
+      function nextCard() {
+        const newIndex = (currentIndex + 1) % cards.length;
+        showCard(newIndex, 'forward');
+      }
+
+      function prevCard() {
+        const newIndex = (currentIndex - 1 + cards.length) % cards.length;
+        showCard(newIndex, 'backward');
+      }
+
+      nextBtn.addEventListener('click', nextCard);
+      prevBtn.addEventListener('click', prevCard);
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowRight') {
+          nextCard();
+        } else if (e.key === 'ArrowLeft') {
+          prevCard();
+        }
+      });
+    })();
+  </script>
