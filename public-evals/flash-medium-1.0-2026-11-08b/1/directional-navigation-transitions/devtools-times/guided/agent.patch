+import React, { useState, useRef } from 'react';
+
+export interface Story {
+  id: string;
+  title: string;
+  date: string;
+  url: string;
+  category?: string;
+}
+
+export interface TopStoriesCarouselProps {
+  stories: Story[];
+}
+
+export default function TopStoriesCarousel({ stories }: TopStoriesCarouselProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [fallbackAnim, setFallbackAnim] = useState<'forward' | 'backward' | null>(null);
+  const isTransitioningRef = useRef(false);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const navigate = (newIndex: number, direction: 'forward' | 'backward') => {
+    if (isTransitioningRef.current) return;
+
+    // Feature detect for browsers that support View Transitions with types
+    if (typeof document !== 'undefined' && 'startViewTransition' in document) {
+      try {
+        isTransitioningRef.current = true;
+        const transition = (document as any).startViewTransition({
+          update: () => {
+            setCurrentIndex(newIndex);
+          },
+          types: [direction],
+        });
+
+        transition.finished.finally(() => {
+          isTransitioningRef.current = false;
+        });
+        return;
+      } catch {
+        isTransitioningRef.current = false;
+      }
+    }
+
+    // Fallback for browsers without View Transitions / types support
+    setFallbackAnim(direction);
+    setCurrentIndex(newIndex);
+  };
+
+  const goToNext = () => {
+    const nextIndex = (currentIndex + 1) % stories.length;
+    navigate(nextIndex, 'forward');
+  };
+
+  const goToPrev = () => {
+    const prevIndex = (currentIndex - 1 + stories.length) % stories.length;
+    navigate(prevIndex, 'backward');
+  };
+
+  const currentStory = stories[currentIndex];
+  const fallbackClass =
+    fallbackAnim === 'forward'
+      ? 'carousel-slide-forward'
+      : fallbackAnim === 'backward'
+      ? 'carousel-slide-backward'
+      : '';
+
+  return (
+    <div
+      className="bg-white border-b border-gray-300"
+      role="region"
+      aria-roledescription="carousel"
+      aria-label="Top Stories"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
+        <div className="flex items-center justify-between gap-3 sm:gap-6">
+          {/* Top Story Section Tag & Active Story */}
+          <div className="flex items-center gap-3 sm:gap-4 flex-1 min-w-0 overflow-hidden">
+            <div className="flex items-center gap-2 shrink-0">
+              <span className="uppercase text-xs font-bold tracking-wider text-amber-500 bg-amber-50 px-2 py-1 rounded border border-amber-200">
+                Top Story
+              </span>
+              <span className="text-xs text-gray-400 hidden sm:inline" aria-live="polite">
+                {currentIndex + 1} of {stories.length}
+              </span>
+            </div>
+
+            {/* Carousel slide container with clipping */}
+            <div className="flex-1 min-w-0 overflow-hidden">
+              <div
+                key={currentStory.id}
+                className={`top-story-slide ${fallbackClass}`}
+                onAnimationEnd={() => setFallbackAnim(null)}
+              >
+                <div className="flex flex-col sm:flex-row sm:items-center sm:gap-3 truncate">
+                  <a
+                    href={currentStory.url}
+                    className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base truncate transition-colors"
+                  >
+                    {currentStory.title}
+                  </a>
+                  <span className="text-xs text-gray-500 shrink-0">
+                    {currentStory.date}
+                  </span>
+                </div>
+              </div>
+            </div>
+          </div>
+
+          {/* Navigation Buttons: Previous and Next */}
+          <div className="flex items-center space-x-2 shrink-0" aria-label="Carousel navigation">
+            <button
+              type="button"
+              onClick={goToPrev}
+              aria-label="Previous story"
+              className="inline-flex items-center justify-center px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 hover:text-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer transition-colors shadow-2xs"
+            >
+              <svg
+                className="w-3.5 h-3.5 mr-1"
+                fill="none"
+                viewBox="0 0 24 24"
+                strokeWidth="2.5"
+                stroke="currentColor"
+                aria-hidden="true"
+              >
+                <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
+              </svg>
+              Previous
+            </button>
+            <button
+              type="button"
+              onClick={goToNext}
+              aria-label="Next story"
+              className="inline-flex items-center justify-center px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 hover:text-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer transition-colors shadow-2xs"
+            >
+              Next
+              <svg
+                className="w-3.5 h-3.5 ml-1"
+                fill="none"
+                viewBox="0 0 24 24"
+                strokeWidth="2.5"
+                stroke="currentColor"
+                aria-hidden="true"
+              >
+                <path strokeLinecap="round" strokeLinejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
+              </svg>
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
