+}
+
+/* Directional Navigation Transitions for Top Stories Carousel */
+.top-story-slide {
+  view-transition-name: top-story-slide;
+}
+
+/* Shared animation settings for the carousel transition group */
+::view-transition-group(top-story-slide) {
+  animation: 0.35s ease-in-out both;
+  overflow: clip;
+}
+
+::view-transition-image-pair(top-story-slide) {
+  overflow: clip;
+}
+
+/* Suppress root transition when navigating the carousel */
+html:active-view-transition-type(forward)::view-transition-group(root),
+html:active-view-transition-type(backward)::view-transition-group(root) {
+  animation: none;
+}
+
+/* Keyframes: Animate transform instead of inset properties for better performance */
+@keyframes slide-to-left {
+  to { transform: translateX(-100%); }
+}
+
+@keyframes slide-from-right {
+  from { transform: translateX(100%); }
+  to { transform: translateX(0); }
+}
+
+@keyframes slide-to-right {
+  to { transform: translateX(100%); }
+}
+
+@keyframes slide-from-left {
+  from { transform: translateX(-100%); }
+  to { transform: translateX(0); }
+}
+
+/* Forward navigation: click Next slides new story in from right and old story out to left */
+html:active-view-transition-type(forward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-left;
+}
+html:active-view-transition-type(forward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-right;
+}
+
+/* Backward navigation: click Previous slides new story in from left and old story out to right */
+html:active-view-transition-type(backward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-right;
+}
+html:active-view-transition-type(backward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-left;
+}
+
+/* Accessibility: Respect user preference for reduced motion */
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(top-story-slide) {
+    animation: none !important;
+  }
+  .carousel-slide-forward,
+  .carousel-slide-backward {
+    animation: none !important;
+  }
+}
+
+/* Fallback animations for browsers without View Transitions / active-view-transition-type support */
+.carousel-slide-forward {
+  animation: slide-from-right 0.35s ease-in-out both;
+}
+
+.carousel-slide-backward {
+  animation: slide-from-left 0.35s ease-in-out both;
+}
