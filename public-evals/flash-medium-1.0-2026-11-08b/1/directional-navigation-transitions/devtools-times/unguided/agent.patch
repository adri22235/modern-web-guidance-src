+import React, { useState, useEffect } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/20/solid';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  date: string;
+  category?: string;
+  summary?: string;
+}
+
+export interface TopStoriesCarouselProps {
+  stories: TopStoryItem[];
+  baseUrl?: string;
+}
+
+export default function TopStoriesCarousel({ stories = [], baseUrl = '/' }: TopStoriesCarouselProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [prevIndex, setPrevIndex] = useState<number | null>(null);
+  const [animating, setAnimating] = useState(false);
+  const [direction, setDirection] = useState<'next' | 'prev'>('next');
+
+  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const handleNext = () => {
+    if (stories.length <= 1) return;
+    setDirection('next');
+    setPrevIndex(currentIndex);
+    setCurrentIndex((prev) => (prev + 1) % stories.length);
+    setAnimating(true);
+  };
+
+  const handlePrev = () => {
+    if (stories.length <= 1) return;
+    setDirection('prev');
+    setPrevIndex(currentIndex);
+    setCurrentIndex((prev) => (prev - 1 + stories.length) % stories.length);
+    setAnimating(true);
+  };
+
+  const handleAnimationEnd = (e: React.AnimationEvent) => {
+    if (e.target === e.currentTarget) {
+      setAnimating(false);
+      setPrevIndex(null);
+    }
+  };
+
+  // Fallback timeout in case onAnimationEnd doesn't fire
+  useEffect(() => {
+    if (!animating) return;
+    const timer = setTimeout(() => {
+      setAnimating(false);
+      setPrevIndex(null);
+    }, 400);
+    return () => clearTimeout(timer);
+  }, [animating, currentIndex]);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const currentStory = stories[currentIndex];
+  const previousStory = prevIndex !== null ? stories[prevIndex] : null;
+
+  return (
+    <div
+      className="flex flex-col sm:flex-row sm:items-center justify-between gap-3"
+      data-testid="top-stories-carousel"
+      data-current-index={currentIndex}
+      data-direction={direction}
+    >
+      {/* Left: Badge & Story Slide */}
+      <div className="flex items-center gap-3 flex-1 min-w-0">
+        <span className="bg-amber-400 text-gray-900 text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-xs flex-shrink-0 select-none">
+          Top Stories
+        </span>
+
+        {/* Carousel Slide Track */}
+        <div
+          className="relative overflow-hidden flex-1 min-w-0 min-h-[40px] flex items-center"
+          aria-live="polite"
+        >
+          {/* Outgoing slide during animation */}
+          {animating && previousStory && (
+            <div
+              key={`outgoing-${prevIndex}-${direction}`}
+              className={`absolute inset-0 w-full flex items-center pointer-events-none ${
+                direction === 'next' ? 'animate-slide-out-left' : 'animate-slide-out-right'
+              }`}
+              aria-hidden="true"
+            >
+              <div className="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 w-full">
+                <a
+                  href={`${normalizedBaseUrl}articles/${previousStory.id}`}
+                  tabIndex={-1}
+                  className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base leading-snug"
+                >
+                  <h3>{previousStory.title}</h3>
+                </a>
+                <span className="text-xs text-gray-500 whitespace-nowrap">
+                  {previousStory.date}
+                </span>
+              </div>
+            </div>
+          )}
+
+          {/* Current / Incoming slide */}
+          <div
+            key={`incoming-${currentIndex}-${animating ? direction : 'static'}`}
+            className={`w-full flex items-center ${
+              animating
+                ? direction === 'next'
+                  ? 'animate-slide-in-right'
+                  : 'animate-slide-in-left'
+                : ''
+            }`}
+            onAnimationEnd={handleAnimationEnd}
+            data-story-id={currentStory.id}
+          >
+            <div className="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 w-full">
+              <a
+                href={`${normalizedBaseUrl}articles/${currentStory.id}`}
+                className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base leading-snug"
+              >
+                <h3>{currentStory.title}</h3>
+              </a>
+              <span className="text-xs text-gray-500 whitespace-nowrap">
+                {currentStory.date}
+              </span>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      {/* Right: Next and Previous Buttons */}
+      <div className="flex items-center justify-end space-x-2 flex-shrink-0">
+        <span className="text-xs text-gray-400 font-mono select-none mr-1">
+          {currentIndex + 1} / {stories.length}
+        </span>
+        <button
+          type="button"
+          onClick={handlePrev}
+          aria-label="Previous"
+          data-action="previous"
+          className="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 border border-gray-300 rounded shadow-xs transition-colors cursor-pointer select-none"
+        >
+          <ChevronLeftIcon className="w-3.5 h-3.5 mr-1" aria-hidden="true" />
+          <span>Previous</span>
+        </button>
+        <button
+          type="button"
+          onClick={handleNext}
+          aria-label="Next"
+          data-action="next"
+          className="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 border border-gray-300 rounded shadow-xs transition-colors cursor-pointer select-none"
+        >
+          <span>Next</span>
+          <ChevronRightIcon className="w-3.5 h-3.5 ml-1" aria-hidden="true" />
+        </button>
+      </div>
+    </div>
+  );
+}
