+  <script>
+    (function () {
+      function loadMedia(media) {
+        // If the poster is deferred
+        if (media.dataset.poster) {
+          media.poster = media.dataset.poster;
+        }
+
+        // If the media element has a deferred src
+        if (media.dataset.src) {
+          media.src = media.dataset.src;
+        }
+
+        // If child <source> elements have deferred src
+        const sources = media.querySelectorAll('source');
+        sources.forEach(function (source) {
+          if (source.dataset.src) {
+            source.src = source.dataset.src;
+          }
+        });
+
+        // Set preload to auto now that player approaches viewport
+        media.preload = 'auto';
+
+        // Trigger loading of media resource
+        if (typeof media.load === 'function') {
+          media.load();
+        }
+
+        media.classList.add('loaded');
+      }
+
+      function initLazyMedia() {
+        const lazyElements = document.querySelectorAll(
+          '.lazy-media, video[data-src], video[data-poster], audio[data-src]'
+        );
+
+        if ('IntersectionObserver' in window) {
+          const mediaObserver = new IntersectionObserver(
+            function (entries, observer) {
+              entries.forEach(function (entry) {
+                if (entry.isIntersecting) {
+                  loadMedia(entry.target);
+                  observer.unobserve(entry.target);
+                }
+              });
+            },
+            {
+              rootMargin: '200px 0px',
+              threshold: 0
+            }
+          );
+
+          lazyElements.forEach(function (element) {
+            mediaObserver.observe(element);
+            // Safeguard: if element is played prior to scroll, load immediately
+            element.addEventListener('play', function () {
+              loadMedia(element);
+            }, { once: true });
+          });
+        } else {
+          // Fallback if IntersectionObserver is not supported
+          lazyElements.forEach(function (element) {
+            loadMedia(element);
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initLazyMedia);
+      } else {
+        initLazyMedia();
+      }
+    })();
+  </script>
