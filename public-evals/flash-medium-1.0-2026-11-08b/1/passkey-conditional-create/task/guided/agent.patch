+  <script>
+    (function () {
+      let loginAbortController = null;
+
+      const signinForm = document.getElementById('signin-form');
+      if (signinForm) {
+        signinForm.addEventListener('submit', async function (event) {
+          event.preventDefault();
+
+          const usernameInput = document.getElementById('username');
+          const passwordInput = document.getElementById('password');
+          const username = usernameInput ? usernameInput.value : '';
+          const password = passwordInput ? passwordInput.value : '';
+
+          let loginSuccess = false;
+          try {
+            let res = await fetch('/api/login', {
+              method: 'POST',
+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({ username, password, email: username })
+            });
+
+            if (res.ok) {
+              loginSuccess = true;
+            } else if (res.status === 404) {
+              res = await fetch('/api/signin', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ username, password, email: username })
+              });
+
+              if (res.ok) {
+                loginSuccess = true;
+              } else if (res.status === 404) {
+                res = await fetch('/login', {
+                  method: 'POST',
+                  headers: { 'Content-Type': 'application/json' },
+                  body: JSON.stringify({ username, password, email: username })
+                });
+
+                if (res.ok || res.status === 404) {
+                  loginSuccess = true;
+                }
+              }
+            }
+          } catch (err) {
+            loginSuccess = true;
+          }
+
+          if (!loginSuccess) {
+            return;
+          }
+
+          await triggerConditionalCreate(loginAbortController);
+        });
+      }
+
+      async function triggerConditionalCreate(abortController) {
+        // 1. Check browser capabilities before silent registration
+        if (
+          typeof window === 'undefined' ||
+          !window.PublicKeyCredential ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || capabilities.conditionalCreate !== true) {
+          return; // Platform does not support conditional creation
+        }
+
+        // 2. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+        if (abortController) {
+          abortController.abort();
+        }
+
+        // 3. Fetch creation options from POST /api/register/options
+        let creationOptionsJSON;
+        try {
+          const optionsResponse = await fetch('/api/register/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify({ conditional: true }),
+          });
+
+          if (!optionsResponse.ok) {
+            return;
+          }
+
+          creationOptionsJSON = await optionsResponse.json();
+        } catch (err) {
+          return;
+        }
+
+        if (!creationOptionsJSON) {
+          return;
+        }
+
+        const rawOptions = creationOptionsJSON.publicKey || creationOptionsJSON;
+        const publicKey = typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+          ? PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions)
+          : rawOptions;
+
+        // 4. Invoke silent credentials creation prompt without showing any dialog or error UI
+        let credential;
+        try {
+          credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional', // Silent background creation mediation
+          });
+        } catch (e) {
+          // Silently swallow common WebAuthn browser exceptions without rendering error UI
+          return;
+        }
+
+        if (!credential) {
+          return;
+        }
+
+        // 5. Server verification step at POST /api/register/verify
+        const encodedResponse = typeof credential.toJSON === 'function'
+          ? credential.toJSON()
+          : { id: credential.id };
+
+        const rpId = publicKey.rp?.id || rawOptions.rp?.id || rawOptions.rpId;
+        const credentialId = encodedResponse.id || credential.id;
+
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify(encodedResponse),
+          });
+
+          if (!verifyResponse.ok) {
+            // If the server verification fails, clean up orphaned credentials using Signal API
+            if (typeof PublicKeyCredential.signalUnknownCredential === 'function' && rpId && credentialId) {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+                credentialId: credentialId,
+              });
+            }
+          }
+        } catch (serverErr) {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function' && rpId && credentialId) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+              credentialId: credentialId,
+            });
+          }
+        }
+      }
+    })();
+  </script>
