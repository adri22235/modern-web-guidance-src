+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = document.querySelectorAll('.toc-sidebar .toc-link');
+      if (!panel || !tocLinks.length) return;
+
+      const headers = Array.from(panel.querySelectorAll('.drink-section h3[id], .drink-header[id]'));
+
+      function setActiveLink(id) {
+        if (!id) return;
+        tocLinks.forEach((link) => {
+          const href = link.getAttribute('href');
+          const isMatch = href === `#${id}` || href === `#section-${id}` || href.endsWith(id);
+          if (isMatch) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function resolveHeaderId(element) {
+        if (!element) return null;
+        if (element.id && document.querySelector(`.toc-sidebar a[href="#${element.id}"]`)) {
+          return element.id;
+        }
+        const h3 = element.querySelector('h3[id]') || element.closest('.drink-section')?.querySelector('h3[id]');
+        if (h3) return h3.id;
+        if (element.id) {
+          const stripped = element.id.replace('section-', '');
+          if (document.querySelector(`.toc-sidebar a[href="#${stripped}"]`)) {
+            return stripped;
+          }
+        }
+        return null;
+      }
+
+      // Smooth scrolling and keyboard focus when clicking TOC link
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetEl = document.getElementById(targetId);
+          if (!targetEl) return;
+
+          event.preventDefault();
+
+          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          targetEl.scrollIntoView({
+            behavior: prefersReducedMotion ? 'auto' : 'smooth',
+            block: 'start'
+          });
+
+          // Set focus for accessibility so keyboard users can navigate from target
+          targetEl.focus({ preventScroll: true });
+          history.pushState(null, '', `#${targetId}`);
+          setActiveLink(targetId);
+        });
+      });
+
+      // Native scrollsnapchange event for modern browsers (Chrome 129+, Edge 129+)
+      let supportsScrollSnapChange = false;
+      if ('onscrollsnapchange' in panel || 'onscrollsnapchange' in window || 'onscrollsnapchange' in HTMLElement.prototype) {
+        try {
+          panel.addEventListener('scrollsnapchange', (event) => {
+            const snapped = event.snapTargetBlock || event.snapTargetInline;
+            const targetId = resolveHeaderId(snapped);
+            if (targetId) {
+              setActiveLink(targetId);
+            }
+          });
+          supportsScrollSnapChange = true;
+        } catch (e) {
+          supportsScrollSnapChange = false;
+        }
+      }
+
+      // Fallback using IntersectionObserver if scrollsnapchange is not supported
+      if (!supportsScrollSnapChange && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            let currentTopHeader = null;
+            let minDistance = Infinity;
+
+            headers.forEach((header) => {
+              const rect = header.getBoundingClientRect();
+              const distance = Math.abs(rect.top - panelRect.top);
+              if (rect.bottom >= panelRect.top && rect.top <= panelRect.bottom) {
+                if (distance < minDistance) {
+                  minDistance = distance;
+                  currentTopHeader = header;
+                }
+              }
+            });
+
+            if (currentTopHeader) {
+              const id = resolveHeaderId(currentTopHeader);
+              if (id) setActiveLink(id);
+            }
+          },
+          { root: panel, threshold: [0, 0.25, 0.5, 0.75, 1.0] }
+        );
+
+        headers.forEach((h) => observer.observe(h));
+      }
+
+      // Synchronize with URL hash on initial load if present
+      if (window.location.hash) {
+        const hashId = window.location.hash.slice(1);
+        const target = document.getElementById(hashId);
+        if (target) {
+          setActiveLink(hashId);
+          target.scrollIntoView({ block: 'start' });
+        }
+      }
+    })();
+  </script>
