+  <script>
+    (function () {
+      function initSeasonalFavorites() {
+        const tocSidebar = document.querySelector('.toc-sidebar');
+        const seasonalPanel = document.querySelector('.seasonal-panel');
+        if (!tocSidebar || !seasonalPanel) return;
+
+        const tocLinks = tocSidebar.querySelectorAll('a');
+        const drinkSections = seasonalPanel.querySelectorAll('.drink-section');
+
+        let isClickScrolling = false;
+        let scrollTimer = null;
+
+        function setActive(activeId) {
+          if (!activeId) return;
+
+          tocLinks.forEach(link => {
+            const href = link.getAttribute('href');
+            const targetId = href ? href.replace(/^#/, '') : '';
+            const isMatch = targetId === activeId;
+
+            if (isMatch) {
+              link.classList.add('active');
+              link.setAttribute('aria-current', 'true');
+            } else {
+              link.classList.remove('active');
+              link.removeAttribute('aria-current');
+            }
+          });
+
+          drinkSections.forEach(section => {
+            const isMatch = section.id === activeId;
+            if (isMatch) {
+              section.classList.add('active');
+              section.setAttribute('aria-current', 'true');
+            } else {
+              section.classList.remove('active');
+              section.removeAttribute('aria-current');
+            }
+          });
+        }
+
+        function getActiveSection() {
+          const panelRect = seasonalPanel.getBoundingClientRect();
+          if (panelRect.height > 0) {
+            let closest = null;
+            let minDistance = Infinity;
+
+            drinkSections.forEach(section => {
+              const rect = section.getBoundingClientRect();
+              const distance = Math.abs(rect.top - panelRect.top);
+              if (distance < minDistance) {
+                minDistance = distance;
+                closest = section;
+              }
+            });
+
+            if (closest && closest.id) {
+              return closest;
+            }
+          }
+
+          // Fallback: compare section offsetTop with panel scrollTop
+          const scrollTop = seasonalPanel.scrollTop;
+          let closest = drinkSections[0];
+          let minDiff = Infinity;
+
+          drinkSections.forEach(section => {
+            const diff = Math.abs(section.offsetTop - scrollTop);
+            if (diff < minDiff) {
+              minDiff = diff;
+              closest = section;
+            }
+          });
+
+          return closest;
+        }
+
+        function onSectionSettled() {
+          if (isClickScrolling) return;
+          const current = getActiveSection();
+          if (current && current.id) {
+            setActive(current.id);
+          }
+        }
+
+        // Smooth scroll on TOC link click
+        tocLinks.forEach(link => {
+          link.addEventListener('click', (e) => {
+            e.preventDefault();
+            const href = link.getAttribute('href');
+            if (!href || !href.startsWith('#')) return;
+            const targetId = href.slice(1);
+            const targetSection = document.getElementById(targetId);
+            if (!targetSection) return;
+
+            isClickScrolling = true;
+            clearTimeout(scrollTimer);
+            setActive(targetId);
+
+            // Smooth scroll into view
+            if (typeof targetSection.scrollIntoView === 'function') {
+              targetSection.scrollIntoView({
+                behavior: 'smooth',
+                block: 'start'
+              });
+            }
+
+            // Also explicitly scroll seasonalPanel
+            let targetTop = targetSection.offsetTop;
+            if (targetSection.offsetParent !== seasonalPanel && seasonalPanel.offsetParent) {
+              targetTop = targetSection.offsetTop - seasonalPanel.offsetTop;
+            }
+
+            if (typeof seasonalPanel.scrollTo === 'function') {
+              seasonalPanel.scrollTo({
+                top: targetTop,
+                behavior: 'smooth'
+              });
+            } else {
+              seasonalPanel.scrollTop = targetTop;
+            }
+
+            if (history.pushState) {
+              history.pushState(null, '', `#${targetId}`);
+            }
+
+            // Release click lock after smooth scroll animation completes
+            setTimeout(() => {
+              isClickScrolling = false;
+            }, 800);
+          });
+        });
+
+        // Scroll listener for when section settles into view
+        seasonalPanel.addEventListener('scroll', () => {
+          if (isClickScrolling) return;
+
+          clearTimeout(scrollTimer);
+          scrollTimer = setTimeout(() => {
+            onSectionSettled();
+          }, 60);
+        }, { passive: true });
+
+        // Native scrollend event when supported
+        seasonalPanel.addEventListener('scrollend', () => {
+          isClickScrolling = false;
+          onSectionSettled();
+        });
+
+        // IntersectionObserver for additional settling support
+        if ('IntersectionObserver' in window) {
+          const observer = new IntersectionObserver((entries) => {
+            if (isClickScrolling) return;
+
+            const visibleEntries = entries.filter(e => e.isIntersecting);
+            if (visibleEntries.length > 0) {
+              visibleEntries.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
+              if (visibleEntries[0].target && visibleEntries[0].target.id) {
+                setActive(visibleEntries[0].target.id);
+              }
+            }
+          }, {
+            root: seasonalPanel,
+            threshold: [0.5, 0.75, 1.0]
+          });
+
+          drinkSections.forEach(section => observer.observe(section));
+        }
+
+        // Initial setup from hash or first drink
+        if (window.location.hash) {
+          const hashId = window.location.hash.slice(1);
+          if (document.getElementById(hashId)) {
+            setActive(hashId);
+            const target = document.getElementById(hashId);
+            if (target) {
+              let targetTop = target.offsetTop;
+              if (target.offsetParent !== seasonalPanel && seasonalPanel.offsetParent) {
+                targetTop = target.offsetTop - seasonalPanel.offsetTop;
+              }
+              seasonalPanel.scrollTop = targetTop;
+            }
+          } else if (drinkSections.length > 0) {
+            setActive(drinkSections[0].id);
+          }
+        } else if (drinkSections.length > 0) {
+          setActive(drinkSections[0].id);
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSeasonalFavorites);
+      } else {
+        initSeasonalFavorites();
+      }
+    })();
+  </script>
 </body>
 
