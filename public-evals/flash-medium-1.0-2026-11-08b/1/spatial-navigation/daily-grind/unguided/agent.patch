+/**
+ * Spatial Navigation for Card Grid
+ * Accessible 2D arrow-key navigation supporting dynamic layout modes
+ * (Grid, List, Compact, Responsive) with WAI-ARIA roving tabindex.
+ */
+
+(function (root, factory) {
+  if (typeof define === 'function' && define.amd) {
+    define([], factory);
+  } else if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.SpatialNavigationGrid = factory();
+  }
+}(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  class SpatialNavigationGrid {
+    constructor(container, options = {}) {
+      if (!container) {
+        throw new Error('SpatialNavigationGrid: Container element is required.');
+      }
+
+      this.container = container;
+      this.options = Object.assign({
+        itemSelector: '.card',
+        rowSelector: '.grid-row',
+        actionSelector: '.btn',
+        defaultLayout: 'grid',
+        liveRegionId: 'layout-announcer',
+        toolbarSelector: '.layout-controls',
+        layoutBtnSelector: '.layout-btn',
+        onLayoutChange: null,
+        onFocusChange: null
+      }, options);
+
+      this.activeCard = null;
+      this.currentLayout = this.container.dataset.layout || this.options.defaultLayout;
+      this._boundKeyDown = this._onKeyDown.bind(this);
+      this._boundFocusIn = this._onFocusIn.bind(this);
+      this._boundClick = this._onClick.bind(this);
+      this._boundResize = this._onResize.bind(this);
+
+      this.init();
+    }
+
+    init() {
+      // Ensure ARIA semantics on grid container
+      if (!this.container.getAttribute('role')) {
+        this.container.setAttribute('role', 'grid');
+      }
+      if (!this.container.getAttribute('aria-label') && !this.container.getAttribute('aria-labelledby')) {
+        this.container.setAttribute('aria-label', 'Card Grid');
+      }
+
+      // Initial layout setup
+      this.container.dataset.layout = this.currentLayout;
+      this._updateContainerLayoutClass(this.currentLayout);
+
+      // Setup cards
