+        if (target && target.matches('.card, .card .btn, .card a')) {
+          updateRovingTabindex(container, target);
+        }
+      });
+
+      // Pointer activation on card
+      container.addEventListener('click', (e) => {
+        const card = e.target.closest('.card');
+        if (card && !e.target.closest('a, button')) {
+          const link = card.querySelector('a, button');
+          if (link) link.click();
+        }
+      });
+
+      // Initial roving tabindex state
+      const initialCards = Array.from(container.querySelectorAll('.card'));
+      if (initialCards.length > 0) {
+        updateRovingTabindex(container, initialCards[0]);
+      }
+    })();
