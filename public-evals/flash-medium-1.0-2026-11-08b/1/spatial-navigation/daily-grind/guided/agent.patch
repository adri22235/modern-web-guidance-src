+  <script>
+    (function () {
+      const container = document.querySelector('.grid');
+      if (!container) return;
+
+      const layoutButtons = document.querySelectorAll('.layout-btn');
+
+      // Layout mode switcher
+      function setLayoutMode(mode) {
+        container.dataset.layout = mode;
+        container.classList.remove('layout-grid', 'layout-list', 'layout-compact');
+        container.classList.add(`layout-${mode}`);
+
+        layoutButtons.forEach(btn => {
+          const isActive = btn.dataset.layout === mode;
+          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
+          btn.classList.toggle('active', isActive);
+        });
+      }
+
+      layoutButtons.forEach(btn => {
+        btn.addEventListener('click', () => {
+          setLayoutMode(btn.dataset.layout);
+        });
+      });
+
+      // Spatial navigation helpers
+      function isVisible(el) {
+        if (!el) return false;
+        if (typeof el.checkVisibility === 'function' && !el.checkVisibility()) {
+          return false;
+        }
+        const rect = el.getBoundingClientRect();
+        return rect.width > 0 && rect.height > 0;
+      }
+
+      function getCandidates(grid) {
+        const active = document.activeElement;
+        const cards = Array.from(grid.querySelectorAll('.card')).filter(isVisible);
+        const btns = Array.from(grid.querySelectorAll('.card .btn, .card a')).filter(isVisible);
+
+        if (active && btns.includes(active)) {
+          return btns;
+        }
+        return cards;
+      }
+
+      function updateRovingTabindex(grid, activeItem) {
+        const cards = Array.from(grid.querySelectorAll('.card'));
+        const btns = Array.from(grid.querySelectorAll('.card .btn, .card a'));
+        const isBtn = btns.includes(activeItem);
+
+        const activeCard = isBtn ? activeItem.closest('.card') : activeItem;
+        const activeBtn = isBtn ? activeItem : activeCard?.querySelector('.btn, a');
+
+        cards.forEach(card => {
+          if (card === activeCard) {
+            card.setAttribute('tabindex', '0');
+          } else {
+            card.setAttribute('tabindex', '-1');
+          }
+        });
+
+        if (isBtn) {
+          btns.forEach(btn => {
+            if (btn === activeBtn) {
+              btn.setAttribute('tabindex', '0');
+            } else {
+              btn.setAttribute('tabindex', '-1');
+            }
+          });
+        }
+      }
+
+      function findSpatialCandidate(current, candidates, direction, tolerance = 1, weight = 2.5) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+        const passing = [];
+
+        for (const cand of candidates) {
+          if (cand === current) continue;
+          const candRect = cand.getBoundingClientRect();
+          if (candRect.width === 0 && candRect.height === 0) continue;
+
+          let inDirection = false;
+          let gap = 0;
+          let overlaps = false;
+          let perpOffset = 0;
+          const candCenterX = (candRect.left + candRect.right) / 2;
+          const candCenterY = (candRect.top + candRect.bottom) / 2;
+
+          if (direction === 'ArrowRight') {
+            inDirection = candRect.left >= currentRect.right - tolerance;
+            if (inDirection) {
+              gap = Math.max(0, candRect.left - currentRect.right);
+              overlaps = candRect.bottom > currentRect.top + tolerance && candRect.top < currentRect.bottom - tolerance;
+              perpOffset = Math.abs(candCenterY - currentCenterY);
+            }
+          } else if (direction === 'ArrowLeft') {
+            inDirection = candRect.right <= currentRect.left + tolerance;
+            if (inDirection) {
+              gap = Math.max(0, currentRect.left - candRect.right);
+              overlaps = candRect.bottom > currentRect.top + tolerance && candRect.top < currentRect.bottom - tolerance;
+              perpOffset = Math.abs(candCenterY - currentCenterY);
+            }
+          } else if (direction === 'ArrowDown') {
+            inDirection = candRect.top >= currentRect.bottom - tolerance;
+            if (inDirection) {
+              gap = Math.max(0, candRect.top - currentRect.bottom);
+              overlaps = candRect.right > currentRect.left + tolerance && candRect.left < currentRect.right - tolerance;
+              perpOffset = Math.abs(candCenterX - currentCenterX);
+            }
+          } else if (direction === 'ArrowUp') {
+            inDirection = candRect.bottom <= currentRect.top + tolerance;
+            if (inDirection) {
+              gap = Math.max(0, currentRect.top - candRect.bottom);
+              overlaps = candRect.right > currentRect.left + tolerance && candRect.left < currentRect.right - tolerance;
+              perpOffset = Math.abs(candCenterX - currentCenterX);
+            }
+          }
+
+          if (inDirection) {
+            passing.push({ element: cand, gap, overlaps, perpOffset });
+          }
+        }
+
+        if (passing.length === 0) {
+          // No candidate: return null without preventDefault(), allowing browser native scrolling.
+          return null;
+        }
+
+        const overlapping = passing.filter(p => p.overlaps);
+        if (overlapping.length > 0) {
+          // Aligned candidates first: smallest gap on navigation axis, breaking ties with perpendicular centre offset
+          overlapping.sort((a, b) => {
+            const gapDiff = a.gap - b.gap;
+            if (Math.abs(gapDiff) > tolerance) return gapDiff;
+            return a.perpOffset - b.perpOffset;
+          });
+          return overlapping[0].element;
+        }
+
+        // Fallback scoring: gap + weight * perpendicularCentreOffset
+        passing.sort((a, b) => {
+          const scoreA = a.gap + weight * a.perpOffset;
+          const scoreB = b.gap + weight * b.perpOffset;
+          return scoreA - scoreB;
+        });
+        return passing[0].element;
+      }
