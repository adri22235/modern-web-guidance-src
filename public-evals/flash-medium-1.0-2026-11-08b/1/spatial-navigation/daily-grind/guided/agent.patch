+        }
+
+        const target = e.composedPath()[0];
+        if (!target || !(target instanceof Element)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+          return;
+        }
+
+        const candidates = getCandidates(container);
+        const current = document.activeElement;
+        if (!current || !candidates.includes(current)) return;
+
+        const next = findSpatialCandidate(current, candidates, e.key);
+        if (next) {
+          e.preventDefault();
+          updateRovingTabindex(container, next);
+          next.focus();
+          next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      });
+
+      // Synchronize roving tabindex on focusin
