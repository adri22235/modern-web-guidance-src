+  <!-- Optional Progressive Enhancement: Updates dynamic total price and provides class toggling for legacy browsers -->
+  <script>
+    (function () {
+      document.querySelectorAll('.card').forEach(function (card) {
+        var basePriceEl = card.querySelector('.base-price');
+        if (!basePriceEl) return;
+        var basePrice = parseFloat(basePriceEl.getAttribute('data-base-price') || '0');
+        var checkboxes = card.querySelectorAll('.custom-checkbox-input');
+
+        function updateDrinkCard() {
+          var total = basePrice;
+          checkboxes.forEach(function (cb) {
+            var item = cb.closest('.custom-checkbox-item');
+            if (item) {
+              item.classList.toggle('is-checked', cb.checked);
+            }
+            if (cb.checked) {
+              var price = parseFloat(cb.getAttribute('data-price') || '0');
+              total += price;
+            }
+          });
+          basePriceEl.textContent = '$' + total.toFixed(2);
+        }
+
+        checkboxes.forEach(function (cb) {
+          cb.addEventListener('change', updateDrinkCard);
+        });
+
+        // Run once on load
+        updateDrinkCard();
+      });
+    })();
+  </script>
