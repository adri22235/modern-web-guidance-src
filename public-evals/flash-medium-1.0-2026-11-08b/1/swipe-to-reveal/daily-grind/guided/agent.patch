+  <div id="toast" class="toast" role="status" aria-live="polite"></div>
+
+  <script>
+    // Toast notification helper
+    function showToast(message) {
+      const toast = document.getElementById('toast');
+      if (!toast) return;
+      toast.textContent = message;
+      toast.classList.add('show');
+      clearTimeout(toast._timeout);
+      toast._timeout = setTimeout(() => {
+        toast.classList.remove('show');
+      }, 3000);
+    }
+
+    // Modern Web Guidance: Snap focusable content panes back into view on keyboard focus
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({
+            block: 'nearest',
+            inline: 'start',
+          });
+        }
+      });
+
+      // Tapping or clicking the content while the action panel is open snaps it back closed
+      content.addEventListener('click', (event) => {
+        const scroller = content.closest('.SwipeReveal');
+        if (scroller && scroller.scrollLeft > 20 && !event.target.closest('a, button')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+
+    // Handle contextual action buttons
+    document.querySelectorAll('.SwipeReveal-panel button').forEach((button) => {
+      button.addEventListener('click', (e) => {
+        const card = button.closest('.SwipeReveal');
+        const drinkName = card.querySelector('h3')?.textContent || 'Drink';
+        const action = button.dataset.action;
+
+        if (action === 'order') {
+          showToast(`⚡ Added ${drinkName} to your quick order!`);
+        } else if (action === 'favorite') {
+          const isFav = button.classList.toggle('active');
+          const label = button.querySelector('.action-label');
+          if (label) label.textContent = isFav ? 'Saved' : 'Favorite';
+          showToast(isFav ? `♥ Saved ${drinkName} to favorites!` : `Removed ${drinkName} from favorites.`);
+        } else if (action === 'customize') {
+          showToast(`⚙ Customizing ${drinkName}...`);
+        }
+
+        // Return card to resting position after user explicitly executes an action
+        const content = card.querySelector('.SwipeReveal-content');
+        if (content) {
+          setTimeout(() => {
+            content.scrollIntoView({ block: 'nearest', inline: 'start' });
+          }, 400);
+        }
+      });
+    });
+
+    // Fallback for browsers without scroll-initial-target support
+    if (!CSS.supports('scroll-initial-target', 'nearest')) {
+      window.addEventListener('load', () => {
+        for (const scroller of document.querySelectorAll('.SwipeReveal')) {
+          scroller.scrollTo({ left: 0, behavior: 'instant' });
+        }
+      });
+    }
+
+    // Progressive enhancement: support mouse drag on desktop without interfering with native touch scroll
+    for (const scroller of document.querySelectorAll('.card.SwipeReveal')) {
+      let isDown = false;
+      let startX = 0;
+      let scrollStart = 0;
+      let moved = false;
+
+      scroller.addEventListener('pointerdown', (e) => {
+        if (e.pointerType !== 'mouse') return;
+        if (e.target.closest('.SwipeReveal-panel')) return;
+        isDown = true;
+        moved = false;
+        startX = e.clientX;
+        scrollStart = scroller.scrollLeft;
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!isDown || e.pointerType !== 'mouse') return;
+        const dx = e.clientX - startX;
+        if (Math.abs(dx) > 5) {
+          moved = true;
+          scroller.scrollLeft = scrollStart - dx;
+        }
+      });
+
+      window.addEventListener('pointerup', (e) => {
+        if (!isDown || e.pointerType !== 'mouse') return;
+        isDown = false;
+      });
+
+      scroller.addEventListener('click', (e) => {
+        if (moved) {
+          e.preventDefault();
+          e.stopPropagation();
+          moved = false;
+        }
+      }, true);
+    }
+  </script>
