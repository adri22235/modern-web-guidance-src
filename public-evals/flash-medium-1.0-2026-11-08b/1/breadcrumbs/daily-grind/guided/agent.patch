+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const breadcrumbList = document.querySelector('.breadcrumb ol');
+      const cards = document.querySelectorAll('.card');
+
+      cards.forEach(card => {
+        const titleEl = card.querySelector('h3');
+        const btn = card.querySelector('.btn');
+        if (!titleEl || !btn) return;
+
+        const itemName = titleEl.textContent.trim();
+        const itemHref = btn.getAttribute('href');
+
+        btn.addEventListener('click', (e) => {
+          if (window.location.pathname === '/' || window.location.pathname.endsWith('index.html')) {
+            e.preventDefault();
+            history.pushState({ item: itemName, href: itemHref }, '', '#' + encodeURIComponent(itemName.toLowerCase().replace(/\s+/g, '-')));
+            updateBreadcrumb(itemName, itemHref);
+          }
+        });
+      });
+
+      function updateBreadcrumb(itemName, itemHref) {
+        if (!breadcrumbList) return;
+        breadcrumbList.innerHTML = `
+          <li><a href="/">Home</a></li>
+          <li><a href="/menu">Menu</a></li>
+          <li><a href="/menu/seasonal">Seasonal Favorites</a></li>
+          <li><a href="${itemHref}" aria-current="page">${itemName}</a></li>
+        `;
+        const seasonalLink = breadcrumbList.querySelector('a[href="/menu/seasonal"]');
+        if (seasonalLink) {
+          seasonalLink.addEventListener('click', (e) => {
+            e.preventDefault();
+            resetBreadcrumb();
+            history.pushState({}, '', window.location.pathname);
+          });
+        }
+      }
+
+      function resetBreadcrumb() {
+        if (!breadcrumbList) return;
+        breadcrumbList.innerHTML = `
+          <li><a href="/">Home</a></li>
+          <li><a href="/menu">Menu</a></li>
+          <li><a href="/menu/seasonal" aria-current="page">Seasonal Favorites</a></li>
+        `;
+      }
+
+      window.addEventListener('popstate', (e) => {
+        if (e.state && e.state.item) {
+          updateBreadcrumb(e.state.item, e.state.href || '/menu/seasonal');
+        } else {
+          resetBreadcrumb();
+        }
+      });
+    });
+  </script>
+
 </body>
 
 </html>
