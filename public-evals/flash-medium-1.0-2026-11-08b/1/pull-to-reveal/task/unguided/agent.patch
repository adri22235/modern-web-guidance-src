+  <script>
+    (function () {
+      const searchContainer = document.getElementById('search-container');
+      if (!searchContainer) return;
+
+      let userHasScrolled = false;
+
+      function alignToNavigation() {
+        if (userHasScrolled || window.location.hash) return;
+        const searchHeight = searchContainer.offsetHeight;
+        if (searchHeight > 0) {
+          const scrollContainer = document.scrollingElement || document.documentElement;
+          scrollContainer.scrollTop = searchHeight;
+          window.scrollTo({ top: searchHeight, behavior: 'instant' });
+        }
+      }
+
+      // Synchronously position the scroll container before first paint to eliminate flicker/jump
+      alignToNavigation();
+
+      // Track if the user scrolls away from the initial position
+      window.addEventListener('scroll', function () {
+        const searchHeight = searchContainer.offsetHeight;
+        if (Math.abs(window.scrollY - searchHeight) > 5) {
+          userHasScrolled = true;
+        }
+      }, { passive: true });
+
+      // Handle pages loaded from bfcache or asynchronous layout stabilization
+      window.addEventListener('pageshow', function (event) {
+        if (!event.persisted) {
+          alignToNavigation();
+        }
+      });
+
+      window.addEventListener('DOMContentLoaded', alignToNavigation);
+
+      // Re-align on resize only if the user hasn't scrolled away yet
+      window.addEventListener('resize', function () {
+        if (!userHasScrolled && !window.location.hash) {
+          alignToNavigation();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
