+
+/* Container query setup for sections */
+section,
+[data-section-type],
+[data-context],
+.featured-section,
+.standard-section {
+  container-type: normal;
+  container-name: section;
+}
+
+/* Base / Default styling for Promotional Badge (Subtle default presentation: Hidden) */
+.promotional-badge {
+  display: none;
+}
+
+/* Base / Default styling for Action Button (Subtle default presentation: Outlined button) */
+.action-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background-color: transparent;
+  color: #374151; /* gray-700 */
+  border: 1px solid #d1d5db; /* gray-300 */
+  font-weight: 500;
+  border-radius: 0.375rem;
+  padding: 0.375rem 0.75rem;
+  font-size: 0.875rem;
+  line-height: 1.25rem;
+  transition: all 0.15s ease-in-out;
+  cursor: pointer;
+  text-decoration: none;
+}
+
+.action-button:hover {
+  background-color: #f3f4f6; /* gray-100 */
+  color: #111827; /* gray-900 */
+  border-color: #9ca3af; /* gray-400 */
+}
+
+/* Base / Default styling for Teaser Card */
+.teaser-card {
+  transition: all 0.2s ease-in-out;
+}
+
+/* ==========================================================================
+   FEATURED PRESENTATION (Prominent)
+   Triggered by semantic context of parent section:
+   - CSS Container Style Query: @container section style(--section-context: featured)
+   - Parent selectors: section[data-context="featured"], section[data-section-type="featured"],
+     section.featured-section, section.featured, [data-featured="true"]
+   ========================================================================== */
+
+/* 1. Container Style Query */
+@container section style(--section-context: featured) {
+  .promotional-badge {
+    display: inline-flex !important;
+  }
+
+  .action-button {
+    background-color: #fbbf24 !important; /* amber-400 */
