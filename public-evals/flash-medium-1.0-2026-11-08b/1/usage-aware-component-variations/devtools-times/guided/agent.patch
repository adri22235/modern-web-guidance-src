diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..9c6fdf8 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,103 @@
 @import "tailwindcss";
 
+:root {
+  --brand-accent: #b45309;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* 1. Set the context on a layout container */
+.featured,
+[data-surface="featured"] {
+  --surface: featured; /* Semantic context flag for children */
+}
+
+/* 2. Component reacts to inherited flag */
+.button,
+.action-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0.25rem 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  line-height: 1rem;
+  border-radius: 0.25rem;
+  text-decoration: none;
+  cursor: pointer;
+  transition: all 0.15s ease-in-out;
+
+  /* Default: Outlined informational style */
+  background: transparent;
+  border: 1px solid currentColor;
+  color: #374151;
+}
+
+.button:hover,
+.action-button:hover {
+  color: var(--brand-accent);
+  border-color: var(--brand-accent);
+}
+
+.badge,
+.promotional-badge {
+  /* Default: Hidden — only revealed in featured surfaces */
+  display: none;
+
+  font-size: 0.625rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background-color: #fef3c7;
+  color: #92400e;
+  border: 1px solid #fde68a;
+  white-space: nowrap;
+}
+
+/* Selector-based contextual styles — broad browser support */
+:where(.featured, [data-surface="featured"]) .button,
+:where(.featured, [data-surface="featured"]) .action-button {
+  background: var(--brand-accent);
+  color: white;
+  border: none;
+}
+
+:where(.featured, [data-surface="featured"]) .button:hover,
+:where(.featured, [data-surface="featured"]) .action-button:hover {
+  background: #92400e;
+  color: white;
+}
+
+:where(.featured, [data-surface="featured"]) .badge,
+:where(.featured, [data-surface="featured"]) .promotional-badge {
+  display: block;
+}
+
+/* Progressive enhancement: style queries override when supported */
+@container style(--surface: featured) {
+  .button,
+  .action-button {
+    /* Automatic switch to Filled promotional style */
+    background: var(--brand-accent);
+    color: white;
+    border: none;
+  }
+
+  .button:hover,
+  .action-button:hover {
+    background: #92400e;
+    color: white;
+  }
+
+  .badge,
+  .promotional-badge {
+    /* Reveal decorative elements only in featured context */
+    display: block;
+  }
+}
