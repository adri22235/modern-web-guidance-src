+  <section id="roasting-widget" aria-label="Real-time Coffee Roasting Simulator">
+    <div class="roast-header">
+      <div class="roast-title-group">
+        <span class="roast-badge">Live Micro-Roastery</span>
+        <h2>Drum Roaster Chamber</h2>
