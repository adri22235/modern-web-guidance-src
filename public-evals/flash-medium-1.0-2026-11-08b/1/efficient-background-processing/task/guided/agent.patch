+
+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueElem = document.getElementById('roast-temp-value');
+      const phaseValueElem = document.getElementById('roast-phase-value');
+      const statusElem = document.getElementById('roast-status-indicator');
+      const statusTextElem = statusElem ? statusElem.querySelector('.status-text') : null;
+
+      if (!widget || !canvas) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+
+      // Simulated Temperature State
+      let currentTemp = 414.2;
+      let tempDirection = 1;
+
+      function updateTemperature() {
+        const drift = (Math.random() - 0.48) * 0.8;
+        currentTemp += drift;
+        if (currentTemp > 438) tempDirection = -1;
+        if (currentTemp < 404) tempDirection = 1;
+        currentTemp += tempDirection * 0.15;
+
+        if (tempValueElem) {
+          tempValueElem.textContent = currentTemp.toFixed(1) + '°F';
+        }
+
+        if (phaseValueElem) {
+          if (currentTemp < 410) {
+            phaseValueElem.textContent = 'Yellowing / Maillard Phase';
+          } else if (currentTemp < 426) {
+            phaseValueElem.textContent = 'First Crack (Exothermic)';
+          } else {
+            phaseValueElem.textContent = 'Development / Caramelization';
+          }
+        }
+      }
+
+      // Bean Color mapping based on roast progression (0.0 = green, 1.0 = dark espresso)
+      function getBeanColor(progress) {
+        if (progress < 0.25) {
+          return { fill: '#8f9a5b', highlight: '#a4b06f', crease: '#556030' };
+        } else if (progress < 0.5) {
+          return { fill: '#ad7648', highlight: '#c48e5e', crease: '#6c4323' };
+        } else if (progress < 0.75) {
+          return { fill: '#734424', highlight: '#8a5632', crease: '#422411' };
+        } else {
+          return { fill: '#331c12', highlight: '#4d2c1c', crease: '#1a0c06' };
+        }
+      }
+
+      // Coffee Bean Model
+      class CoffeeBean {
+        constructor(w, h, initial) {
+          this.reset(w, h, initial);
+        }
+
+        reset(w, h, initial = false) {
+          this.x = initial ? Math.random() * (w - 80) + 40 : 40 + Math.random() * 40;
+          this.y = initial ? Math.random() * (h - 50) + 25 : h - 35;
+          this.rx = 9 + Math.random() * 4;
+          this.ry = 5.5 + Math.random() * 2.5;
+          this.angle = Math.random() * Math.PI * 2;
+          this.angularVelocity = (Math.random() - 0.5) * 0.08;
+          this.vx = (Math.random() - 0.4) * 2.5;
+          this.vy = initial ? (Math.random() - 0.5) * 2 : -(2.5 + Math.random() * 3.5);
+          this.roastProgress = initial ? Math.random() * 0.8 : 0.1;
+        }
+
+        update(w, h) {
+          this.roastProgress = Math.min(1, this.roastProgress + 0.0002);
+          this.vy += 0.12; // gravity
+          this.x += this.vx;
+          this.y += this.vy;
+          this.angle += this.angularVelocity;
+
+          const floor = h - 22;
+          const left = 25;
+          const right = w - 25;
+
+          if (this.y > floor) {
+            this.y = floor;
+            // Drum paddle lifts and flings beans upward
+            this.vy = -(2.4 + Math.random() * 4.0);
+            this.vx = (Math.random() - 0.35) * 3;
+            this.angularVelocity = (Math.random() - 0.5) * 0.12;
+          }
+          if (this.y < 20) {
+            this.y = 20;
+            this.vy = Math.abs(this.vy) * 0.5;
+          }
+          if (this.x < left) {
+            this.x = left;
+            this.vx = Math.abs(this.vx) * 0.7;
+          }
+          if (this.x > right) {
+            this.x = right;
+            this.vx = -Math.abs(this.vx) * 0.7;
+          }
+        }
+
+        draw(context) {
+          context.save();
+          context.translate(this.x, this.y);
+          context.rotate(this.angle);
+
+          const color = getBeanColor(this.roastProgress);
+
+          // Bean body
+          context.beginPath();
+          context.ellipse(0, 0, this.rx, this.ry, 0, 0, Math.PI * 2);
+          context.fillStyle = color.fill;
+          context.fill();
+
+          // 3D Highlight
+          context.beginPath();
+          context.ellipse(0, -this.ry * 0.28, this.rx * 0.72, this.ry * 0.32, 0, Math.PI, Math.PI * 2);
+          context.fillStyle = color.highlight;
+          context.fill();
+
+          // Signature bean center crack
+          context.beginPath();
+          context.moveTo(-this.rx * 0.75, 0);
+          context.bezierCurveTo(
+            -this.rx * 0.2, -this.ry * 0.35,
+            this.rx * 0.2, this.ry * 0.35,
+            this.rx * 0.75, 0
+          );
+          context.strokeStyle = color.crease;
+          context.lineWidth = 1.5;
+          context.lineCap = 'round';
+          context.stroke();
+
+          context.restore();
+        }
+      }
+
+      // Heat / Steam Particle Model
+      class HeatParticle {
+        constructor(w, h, initial) {
+          this.reset(w, h, initial);
+        }
+
+        reset(w, h, initial = false) {
+          this.x = Math.random() * (w - 80) + 40;
+          this.y = initial ? Math.random() * (h - 40) + 20 : h - 30;
+          this.vy = -(0.4 + Math.random() * 0.8);
+          this.vx = (Math.random() - 0.5) * 0.4;
+          this.radius = 3 + Math.random() * 6;
+          this.life = initial ? Math.random() : 1.0;
+          this.decay = 0.006 + Math.random() * 0.006;
+        }
+
+        update(w, h) {
+          this.x += this.vx;
+          this.y += this.vy;
+          this.radius += 0.12;
+          this.life -= this.decay;
+          if (this.life <= 0 || this.y < 10) {
+            this.reset(w, h, false);
+          }
+        }
+
+        draw(context) {
+          context.save();
+          context.beginPath();
+          context.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
+          context.fillStyle = 'rgba(235, 220, 205, ' + Math.max(0, this.life * 0.18) + ')';
+          context.fill();
+          context.restore();
+        }
+      }
+
+      function resizeCanvas() {
+        const rect = canvas.getBoundingClientRect();
+        const dpr = window.devicePixelRatio || 1;
+        const w = Math.round(rect.width) || 1000;
+        const h = Math.round(rect.height) || 220;
+        if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
+          canvas.width = w * dpr;
+          canvas.height = h * dpr;
+          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        }
+      }
+
+      let width = 1000;
+      let height = 220;
+      const beans = [];
+      const particles = [];
+      let drumAngle = 0;
+
+      function initSimulation() {
+        resizeCanvas();
+        const rect = canvas.getBoundingClientRect();
+        width = rect.width || 1000;
+        height = rect.height || 220;
+
+        beans.length = 0;
+        particles.length = 0;
+
+        const beanCount = 45;
+        for (let i = 0; i < beanCount; i++) {
+          beans.push(new CoffeeBean(width, height, true));
+        }
+
+        const particleCount = 20;
+        for (let i = 0; i < particleCount; i++) {
+          particles.push(new HeatParticle(width, height, true));
+        }
+      }
+
+      function renderDrumBackground(w, h) {
+        // Bottom burner heat glow
+        const glow = ctx.createLinearGradient(0, h - 50, 0, h);
+        glow.addColorStop(0, 'rgba(255, 140, 0, 0)');
+        glow.addColorStop(1, 'rgba(255, 100, 0, 0.22)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, h - 50, w, 50);
+
+        // Faint rotating drum spokes in background
+        ctx.save();
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.08)';
+        ctx.lineWidth = 2;
+        drumAngle += 0.008;
+        const centerX = w / 2;
+        const centerY = h / 2;
+        const radius = Math.min(w, h) * 0.9;
+        for (let i = 0; i < 4; i++) {
+          const a = drumAngle + (i * Math.PI) / 2;
+          ctx.beginPath();
+          ctx.moveTo(centerX, centerY);
+          ctx.lineTo(centerX + Math.cos(a) * radius, centerY + Math.sin(a) * (radius * 0.4));
+          ctx.stroke();
+        }
+        ctx.restore();
+      }
+
+      function renderLoop() {
+        const rect = canvas.getBoundingClientRect();
+        width = rect.width || 1000;
+        height = rect.height || 220;
+
+        ctx.clearRect(0, 0, width, height);
+
+        renderDrumBackground(width, height);
+
+        // Render heat smoke particles
+        for (let i = 0; i < particles.length; i++) {
+          particles[i].update(width, height);
+          particles[i].draw(ctx);
+        }
+
+        // Render coffee beans
+        for (let i = 0; i < beans.length; i++) {
+          beans[i].update(width, height);
+          beans[i].draw(ctx);
+        }
+
+        if (isRunning) {
+          animationFrameId = requestAnimationFrame(renderLoop);
+        }
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+
+        if (beans.length === 0) {
+          initSimulation();
+        }
+
+        // Start simulated temperature interval
+        if (!tempIntervalId) {
+          tempIntervalId = setInterval(updateTemperature, 750);
+        }
+
+        // Start canvas animation loop
+        if (!animationFrameId) {
+          animationFrameId = requestAnimationFrame(renderLoop);
+        }
+
+        // Update UI status indicator
+        if (statusElem) {
+          statusElem.classList.remove('paused');
+          if (statusTextElem) statusTextElem.textContent = 'Roasting Active';
+        }
+      }
+
+      function stopSimulation() {
+        if (!isRunning) return;
+        isRunning = false;
+
+        // Automatically pause canvas animation loop
+        if (animationFrameId) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+
+        // Automatically pause temperature interval
+        if (tempIntervalId) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+
+        // Update UI status indicator
+        if (statusElem) {
+          statusElem.classList.add('paused');
+          if (statusTextElem) statusTextElem.textContent = 'Paused (Off-Screen)';
+        }
+      }
+
+      window.addEventListener('resize', () => {
+        if (isRunning) {
+          resizeCanvas();
+        }
+      });
+
+      // Visibility state management:
+      // Uses native contentvisibilityautostatechange event when supported (content-visibility: auto),
+      // with a robust IntersectionObserver fallback for older browsers lacking native rendering state change support.
+      const isContentVisibilitySupported = 'contentVisibility' in document.documentElement.style;
+
+      if (isContentVisibilitySupported) {
+        // Direct event listener on the element with content-visibility: auto
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          if (event.skipped) {
+            stopSimulation();
+          } else {
+            startSimulation();
+          }
+        });
+
+        // Determine initial rendering state
+        if (typeof widget.checkVisibility === 'function') {
+          try {
+            if (widget.checkVisibility({ contentVisibilityAuto: true })) {
+              startSimulation();
+            }
+          } catch (e) {
+            startSimulation();
+          }
+        } else {
+          startSimulation();
+        }
+      } else if ('IntersectionObserver' in window) {
+        // Robust fallback for older browsers
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(widget);
+      } else {
+        // Secondary fallback for legacy environments lacking IntersectionObserver
+        function checkViewportFallback() {
+          const rect = widget.getBoundingClientRect();
+          const inView = rect.top < window.innerHeight + 200 && rect.bottom > -200;
+          if (inView) {
+            startSimulation();
+          } else {
+            stopSimulation();
+          }
+        }
+        window.addEventListener('scroll', checkViewportFallback, { passive: true });
+        window.addEventListener('resize', checkViewportFallback, { passive: true });
+        checkViewportFallback();
+      }
+    })();
+  </script>
