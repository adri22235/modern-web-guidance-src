@@ -0,0 +1,52 @@
+import React, { useEffect } from 'react';
+import DeveloperDiagnosticsWidget from './DeveloperDiagnosticsWidget';
+
+interface Props {
+  onClose: () => void;
+}
+
+export default function DiagnosticsFlyout({ onClose }: Props) {
+  useEffect(() => {
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [onClose]);
+
+  return (
+    <div
+      className="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-[99999] flex justify-center items-start p-4 pt-[6vh] overflow-y-auto"
+      onClick={onClose}
+    >
+      <div
+        className="bg-white shadow-2xl w-full max-w-5xl relative rounded-lg border border-gray-300 my-auto"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <button
+          onClick={onClose}
+          aria-label="Close diagnostics dialog"
+          className="absolute -top-3 -right-3 bg-gray-900 text-white rounded-full p-1.5 shadow-md hover:bg-amber-400 hover:text-gray-900 hover:scale-110 transition-transform z-10 cursor-pointer"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="h-5 w-5"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2.5}
+          >
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+
+        <DeveloperDiagnosticsWidget />
+      </div>
+    </div>
+  );
+}
