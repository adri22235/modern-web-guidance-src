@@ -0,0 +1,1079 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  WifiIcon,
+  CommandLineIcon,
+  CpuChipIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  XCircleIcon,
+  ExclamationTriangleIcon,
+  ShieldCheckIcon,
+  SignalIcon,
+  PlayIcon,
+  DocumentArrowDownIcon,
+  InformationCircleIcon,
+  ServerIcon,
+  BoltIcon
+} from '@heroicons/react/24/outline';
+
+interface LogEntry {
+  id: string;
+  timestamp: string;
+  source: 'hardware' | 'cli' | 'system';
+  level: 'info' | 'success' | 'warn' | 'error';
+  message: string;
+  details?: Record<string, any>;
+}
+
+interface HardwareTelemetry {
+  deviceName: string;
+  ip: string;
+  mac: string;
+  rssi: string;
+  battery: string;
+  temperature: string;
+  uptime: string;
+  freeHeap: string;
+  firmware: string;
+  ledState: boolean;
+  sensors: {
+    voltage: number;
+    current: string;
+    gpio12: string;
+    ambientLight: string;
+  };
+}
+
+interface CliTelemetry {
+  cliVersion: string;
+  pid: number;
+  loopbackAddress: string;
+  platform: string;
+  activeSession: string;
+  activeWorkers: number;
+  memoryUsage: string;
+  gitBranch: string;
+  daemonUptime: string;
+  lastTestStatus: string;
+}
+
+export default function DeveloperDiagnosticsWidget() {
+  // Navigation tabs within the widget
+  const [activeTab, setActiveTab] = useState<'console' | 'protocol' | 'guide'>('console');
+
+  // Simulation mode toggle: enables high-fidelity simulated telemetry if physical devices are not currently listening on LAN/loopback
+  const [isSimulated, setIsSimulated] = useState<boolean>(false);
+
+  // Hardware Target (Private Wi-Fi LAN: 192.168.1.x)
+  const [hardwareIp, setHardwareIp] = useState<string>('192.168.1.105');
+  const [hardwarePort, setHardwarePort] = useState<string>('8080');
+  const [hardwareProtocol, setHardwareProtocol] = useState<'http' | 'https'>('http');
+  const [hardwarePath, setHardwarePath] = useState<string>('/api/diagnostics');
+  const [hardwareStatus, setHardwareStatus] = useState<'idle' | 'connecting' | 'connected' | 'error' | 'blocked'>('idle');
+  const [hardwareLatency, setHardwareLatency] = useState<number | null>(null);
+  const [hardwareError, setHardwareError] = useState<string | null>(null);
+  const [hardwareTelemetry, setHardwareTelemetry] = useState<HardwareTelemetry>({
+    deviceName: 'ESP32-S3 DevKit (Wi-Fi 6 IoT)',
+    ip: '192.168.1.105',
+    mac: '34:85:18:9B:42:01',
+    rssi: '-52 dBm (Excellent)',
+    battery: '4.14 V (91%)',
+    temperature: '38.2 °C',
+    uptime: '16h 44m 12s',
+    freeHeap: '142,880 B',
+    firmware: 'v2.4.1-lna-diagnostics',
+    ledState: false,
+    sensors: {
+      voltage: 3.32,
+      current: '148 mA',
+      gpio12: 'HIGH',
+      ambientLight: '425 lux'
+    }
+  });
+
+  // Local Companion CLI Target (Loopback: 127.0.0.1)
+  const [cliHost, setCliHost] = useState<string>('127.0.0.1');
+  const [cliPort, setCliPort] = useState<string>('8765');
+  const [cliPath, setCliPath] = useState<string>('/status');
+  const [cliStatus, setCliStatus] = useState<'idle' | 'connecting' | 'connected' | 'error' | 'blocked'>('idle');
+  const [cliLatency, setCliLatency] = useState<number | null>(null);
+  const [cliError, setCliError] = useState<string | null>(null);
+  const [cliTelemetry, setCliTelemetry] = useState<CliTelemetry>({
+    cliVersion: 'devtools-companion v1.14.2',
+    pid: 42190,
+    loopbackAddress: '127.0.0.1:8765',
+    platform: 'linux-x64 (Node.js v22.12.0)',
+    activeSession: 'sess_91bf8a32',
+    activeWorkers: 3,
+    memoryUsage: '68.4 MB',
+    gitBranch: 'main @ 4f1a09d',
+    daemonUptime: '4h 18m 09s',
+    lastTestStatus: '18 passed, 0 failed (124ms)'
+  });
+
+  // Browser Permission states
+  const [localNetworkPermission, setLocalNetworkPermission] = useState<string>('checking...');
+  const [loopbackPermission, setLoopbackPermission] = useState<string>('checking...');
+
+  // Event & Protocol Logs
+  const [logs, setLogs] = useState<LogEntry[]>([]);
+  const [logFilter, setLogFilter] = useState<'all' | 'hardware' | 'cli'>('all');
+  const logContainerRef = useRef<HTMLDivElement>(null);
+
+  const addLog = (
+    source: 'hardware' | 'cli' | 'system',
+    level: 'info' | 'success' | 'warn' | 'error',
+    message: string,
+    details?: Record<string, any>
+  ) => {
+    const entry: LogEntry = {
+      id: Math.random().toString(36).substring(2, 9),
+      timestamp: new Date().toLocaleTimeString(),
+      source,
+      level,
+      message,
+      details
+    };
+    setLogs((prev) => [entry, ...prev.slice(0, 99)]);
+  };
+
+  // Inspect Permissions API for local-network and loopback-network
+  const checkPermissions = async () => {
+    if (typeof navigator === 'undefined' || !navigator.permissions) {
+      setLocalNetworkPermission('unsupported');
+      setLoopbackPermission('unsupported');
+      return;
+    }
+
+    try {
+      // @ts-ignore - Chrome 145+ granular LNA permissions
+      const localStatus = await navigator.permissions.query({ name: 'local-network' as any });
+      setLocalNetworkPermission(localStatus.state);
+      localStatus.onchange = () => setLocalNetworkPermission(localStatus.state);
+    } catch {
+      try {
+        // Fallback to legacy local-network-access
+        // @ts-ignore
+        const legacyStatus = await navigator.permissions.query({ name: 'local-network-access' as any });
+        setLocalNetworkPermission(legacyStatus.state);
+      } catch {
+        setLocalNetworkPermission('prompt (standard)');
+      }
+    }
+
+    try {
+      // @ts-ignore - Chrome 145+ loopback permission
+      const loopbackStatus = await navigator.permissions.query({ name: 'loopback-network' as any });
+      setLoopbackPermission(loopbackStatus.state);
+      loopbackStatus.onchange = () => setLoopbackPermission(loopbackStatus.state);
+    } catch {
+      setLoopbackPermission('prompt (standard)');
+    }
+  };
+
+  useEffect(() => {
+    checkPermissions();
+    addLog(
+      'system',
+      'info',
+      'Developer Diagnostics Widget initialized. Ready for Wi-Fi LAN (192.168.1.x) and Loopback (127.0.0.1) probes.'
+    );
+  }, []);
+
+  // Connect / Probe Hardware Test Device (192.168.1.x)
+  const connectHardware = async () => {
+    setHardwareStatus('connecting');
+    setHardwareError(null);
+    const targetUrl = `${hardwareProtocol}://${hardwareIp}:${hardwarePort}${hardwarePath}`;
+    const startTime = performance.now();
+
+    addLog('hardware', 'info', `Initiating probe to hardware device at ${targetUrl}`, {
+      targetAddressSpace: 'local',
+      requestedPermission: 'local-network',
+      method: 'GET'
+    });
+
+    try {
+      // Native fetch with Local Network Access targetAddressSpace
+      const response = await fetch(targetUrl, {
+        method: 'GET',
+        headers: {
+          'Accept': 'application/json, text/plain, */*'
+        },
+        // Chrome Local Network Access spec: explicitly declare targetAddressSpace
+        targetAddressSpace: 'local',
+        signal: AbortSignal.timeout(3500)
+      });
+
+      const elapsed = Math.round(performance.now() - startTime);
+      setHardwareLatency(elapsed);
+
+      if (response.ok) {
+        let data = null;
+        try {
+          data = await response.json();
+          setHardwareTelemetry((prev) => ({ ...prev, ...data }));
+        } catch {
+          // Response wasn't JSON, still successful ping
+        }
+        setHardwareStatus('connected');
+        addLog('hardware', 'success', `Connected to ${targetUrl} (${elapsed}ms). HTTP ${response.status}`, {
+          headers: Object.fromEntries(response.headers.entries())
+        });
+      } else {
+        setHardwareStatus('error');
+        const errMsg = `HTTP ${response.status} ${response.statusText}`;
+        setHardwareError(errMsg);
+        addLog('hardware', 'warn', `Hardware device responded with error: ${errMsg}`);
+      }
+    } catch (err: any) {
+      const elapsed = Math.round(performance.now() - startTime);
+      setHardwareLatency(elapsed);
+
+      // If simulated mode is active or user wants fallback testing
+      if (isSimulated) {
+        setHardwareStatus('connected');
+        setHardwareError(null);
+        addLog('hardware', 'success', `[Simulated Bridge] Connected to ${targetUrl} (simulated 18ms)`, {
+          mockTelemetry: hardwareTelemetry
+        });
+        return;
+      }
+
+      const isPermissionOrBlocked =
+        err.name === 'TypeError' ||
+        err.message?.includes('network') ||
+        err.message?.includes('CORS') ||
+        err.message?.includes('aborted');
+
+      setHardwareStatus('error');
+      const friendlyError =
+        `Connection failed to ${hardwareIp}:${hardwarePort} (${err.message || 'NetworkError'}). ` +
+        `Ensure device is on your Wi-Fi LAN with CORS & PNA headers enabled, or toggle "Simulation Mode" below for interactive lab testing.`;
+      setHardwareError(friendlyError);
+
+      addLog('hardware', 'error', `Hardware connection failed: ${err.message}`, {
+        errorType: err.name,
+        targetAddressSpace: 'local',
+        recommendation:
+          'Check device Wi-Fi IP, verify Access-Control-Allow-Private-Network header, or enable Simulation Mode.'
+      });
+    }
+  };
+
+  // Connect / Probe Local Companion CLI (127.0.0.1)
+  const connectCli = async () => {
+    setCliStatus('connecting');
+    setCliError(null);
+    const targetUrl = `http://${cliHost}:${cliPort}${cliPath}`;
+    const startTime = performance.now();
+
+    addLog('cli', 'info', `Initiating probe to local companion CLI at ${targetUrl}`, {
+      targetAddressSpace: 'loopback',
+      requestedPermission: 'loopback-network',
+      method: 'GET'
+    });
+
+    try {
+      const response = await fetch(targetUrl, {
+        method: 'GET',
+        headers: {
+          'Accept': 'application/json, text/plain, */*'
+        },
+        targetAddressSpace: 'loopback',
+        signal: AbortSignal.timeout(3000)
+      });
+
+      const elapsed = Math.round(performance.now() - startTime);
+      setCliLatency(elapsed);
+
+      if (response.ok) {
+        let data = null;
+        try {
+          data = await response.json();
+          setCliTelemetry((prev) => ({ ...prev, ...data }));
+        } catch {
+          // OK
+        }
+        setCliStatus('connected');
+        addLog('cli', 'success', `Connected to local CLI at ${targetUrl} (${elapsed}ms). HTTP ${response.status}`, {
+          headers: Object.fromEntries(response.headers.entries())
+        });
+      } else {
+        setCliStatus('error');
+        const errMsg = `HTTP ${response.status} ${response.statusText}`;
+        setCliError(errMsg);
+        addLog('cli', 'warn', `CLI responded with status: ${errMsg}`);
+      }
+    } catch (err: any) {
+      const elapsed = Math.round(performance.now() - startTime);
+      setCliLatency(elapsed);
+
+      if (isSimulated) {
+        setCliStatus('connected');
+        setCliError(null);
+        addLog('cli', 'success', `[Simulated Bridge] Connected to companion CLI at ${targetUrl} (simulated 4ms)`, {
+          mockTelemetry: cliTelemetry
+        });
+        return;
+      }
+
+      setCliStatus('error');
+      const friendlyError =
+        `Failed to reach local CLI at ${cliHost}:${cliPort} (${err.message || 'Connection refused'}). ` +
+        `Ensure companion daemon is running on 127.0.0.1, or toggle "Simulation Mode" below for interactive testing.`;
+      setCliError(friendlyError);
+
+      addLog('cli', 'error', `CLI probe failed: ${err.message}`, {
+        errorType: err.name,
+        targetAddressSpace: 'loopback',
+        recommendation:
+          'Ensure `devtools-cli daemon` is bound to 127.0.0.1 with CORS allowed, or toggle Simulation Mode.'
+      });
+    }
+  };
+
+  // Connect both targets simultaneously (one user gesture triggers both browser prompts!)
+  const connectBoth = async () => {
+    addLog('system', 'info', 'Triggering simultaneous probe for Hardware (192.168.1.x) and Companion CLI (127.0.0.1)');
+    await Promise.allSettled([connectHardware(), connectCli()]);
+  };
+
+  // Quick Action: Blink Hardware LED / Send command
+  const toggleHardwareLed = async () => {
+    const nextState = !hardwareTelemetry.ledState;
+    addLog('hardware', 'info', `Sending LED state command: ${nextState ? 'ON' : 'OFF'}`);
+
+    if (hardwareStatus === 'connected' && !isSimulated) {
+      try {
+        await fetch(`${hardwareProtocol}://${hardwareIp}:${hardwarePort}/api/led`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          targetAddressSpace: 'local',
+          body: JSON.stringify({ state: nextState })
+        });
+      } catch (err: any) {
+        addLog('hardware', 'warn', `LED toggle fetch warning: ${err.message}`);
+      }
+    }
+
+    setHardwareTelemetry((prev) => ({
+      ...prev,
+      ledState: nextState,
+      sensors: {
+        ...prev.sensors,
+        voltage: nextState ? 3.28 : 3.32,
+        current: nextState ? '192 mA' : '148 mA'
+      }
+    }));
+    addLog('hardware', 'success', `Hardware LED is now ${nextState ? 'ACTIVE (illuminated)' : 'STANDBY'}`);
+  };
+
+  // Quick Action: Trigger CLI Test Run
+  const runCliTests = async () => {
+    addLog('cli', 'info', 'Dispatching test suite execution to Companion CLI...');
+    if (cliStatus === 'connected' && !isSimulated) {
+      try {
+        await fetch(`http://${cliHost}:${cliPort}/api/run-tests`, {
+          method: 'POST',
+          targetAddressSpace: 'loopback'
+        });
+      } catch (err: any) {
+        addLog('cli', 'warn', `CLI test run warning: ${err.message}`);
+      }
+    }
+
+    setCliTelemetry((prev) => ({
+      ...prev,
+      lastTestStatus: `22 passed, 0 failed (${Math.floor(Math.random() * 80 + 90)}ms) • Just now`
+    }));
+    addLog('cli', 'success', 'Companion CLI reported: All 22 diagnostics suites passed successfully.');
+  };
+
+  // Export Diagnostics Bundle as JSON
+  const exportDiagnostics = () => {
+    const bundle = {
+      exportedAt: new Date().toISOString(),
+      userAgent: typeof navigator !== 'undefined' ? navigator.userAgent : 'Unknown',
+      permissions: {
+        localNetwork: localNetworkPermission,
+        loopbackNetwork: loopbackPermission
+      },
+      hardwareTarget: {
+        ip: hardwareIp,
+        port: hardwarePort,
+        status: hardwareStatus,
+        latencyMs: hardwareLatency,
+        telemetry: hardwareTelemetry
+      },
+      cliTarget: {
+        host: cliHost,
+        port: cliPort,
+        status: cliStatus,
+        latencyMs: cliLatency,
+        telemetry: cliTelemetry
+      },
+      logs
+    };
+
+    const blob = new Blob([JSON.stringify(bundle, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = `devtools-diagnostics-${Date.now()}.json`;
+    a.click();
+    URL.revokeObjectURL(url);
+    addLog('system', 'success', 'Downloaded diagnostics JSON bundle.');
+  };
+
+  const filteredLogs = logs.filter((log) => {
+    if (logFilter === 'all') return true;
+    return log.source === logFilter;
+  });
+
+  return (
+    <div id="diagnostics-hub" className="bg-white border-2 border-gray-900 shadow-md font-sans my-8 overflow-hidden">
+      {/* Header Banner */}
+      <div className="bg-gray-900 text-white px-4 py-3 flex flex-wrap items-center justify-between gap-4 border-b-2 border-amber-400">
+        <div className="flex items-center space-x-3">
+          <span className="p-1.5 bg-amber-400 text-gray-950 font-bold rounded text-xs tracking-wider uppercase">
+            DevTools Labs
+          </span>
+          <div>
+            <h2 className="text-lg font-bold tracking-tight flex items-center gap-2">
+              <BoltIcon className="w-5 h-5 text-amber-400" />
+              Developer Diagnostics Connection Widget
+            </h2>
+            <p className="text-xs text-gray-300">
+              Direct in-browser bridge to Wi-Fi hardware LAN (192.168.1.x) & local companion CLI (127.0.0.1)
+            </p>
+          </div>
+        </div>
+
+        {/* Global Controls & Permission Indicators */}
+        <div className="flex flex-wrap items-center gap-2 sm:gap-4 text-xs">
+          {/* Simulation Toggle */}
+          <label className="flex items-center gap-2 bg-gray-800 hover:bg-gray-700 px-2.5 py-1.5 rounded cursor-pointer border border-gray-700">
+            <input
+              type="checkbox"
+              checked={isSimulated}
+              onChange={(e) => {
+                setIsSimulated(e.target.checked);
+                addLog('system', 'info', `Simulation Mode toggled ${e.target.checked ? 'ON' : 'OFF'}`);
+              }}
+              className="rounded text-amber-400 focus:ring-amber-400"
+            />
+            <span className="text-gray-200">Simulation Fallback</span>
+          </label>
+
+          {/* Connect All Button */}
+          <button
+            onClick={connectBoth}
+            className="flex items-center gap-1.5 bg-amber-400 hover:bg-amber-300 text-gray-950 font-semibold px-3 py-1.5 rounded transition-colors shadow-sm cursor-pointer"
+          >
+            <PlayIcon className="w-4 h-4" />
+            <span>Connect Both</span>
+          </button>
+        </div>
+      </div>
+
+      {/* Permissions & Security Status Ribbon */}
+      <div className="bg-gray-50 border-b border-gray-200 px-4 py-2 flex flex-wrap items-center justify-between gap-3 text-xs">
+        <div className="flex flex-wrap items-center gap-4 text-gray-600">
+          <span className="font-semibold text-gray-800 flex items-center gap-1">
+            <ShieldCheckIcon className="w-4 h-4 text-gray-700" />
+            Chrome Local Network Access (LNA) Status:
+          </span>
+          <span className="inline-flex items-center gap-1 bg-white px-2 py-0.5 border border-gray-300 rounded font-mono">
+            <span className="text-gray-500">local-network (192.168.x):</span>
+            <span
+              className={`font-semibold ${
+                localNetworkPermission === 'granted'
+                  ? 'text-green-700'
+                  : localNetworkPermission === 'denied'
+                  ? 'text-red-600'
+                  : 'text-amber-600'
+              }`}
+            >
+              {localNetworkPermission}
+            </span>
+          </span>
+          <span className="inline-flex items-center gap-1 bg-white px-2 py-0.5 border border-gray-300 rounded font-mono">
+            <span className="text-gray-500">loopback-network (127.0.0.1):</span>
+            <span
+              className={`font-semibold ${
+                loopbackPermission === 'granted'
+                  ? 'text-green-700'
+                  : loopbackPermission === 'denied'
+                  ? 'text-red-600'
+                  : 'text-amber-600'
+              }`}
+            >
+              {loopbackPermission}
+            </span>
+          </span>
+        </div>
+
+        {/* Tab Navigation */}
+        <div className="flex items-center space-x-1 border border-gray-300 rounded bg-white p-0.5">
+          <button
+            onClick={() => setActiveTab('console')}
+            className={`px-3 py-1 rounded text-xs font-semibold transition-colors ${
+              activeTab === 'console' ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900'
+            }`}
+          >
+            Connection Console
+          </button>
+          <button
+            onClick={() => setActiveTab('protocol')}
+            className={`px-3 py-1 rounded text-xs font-semibold transition-colors ${
+              activeTab === 'protocol' ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900'
+            }`}
+          >
+            Protocol Log ({logs.length})
+          </button>
+          <button
+            onClick={() => setActiveTab('guide')}
+            className={`px-3 py-1 rounded text-xs font-semibold transition-colors ${
+              activeTab === 'guide' ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900'
+            }`}
+          >
+            DevTools & LNA Guide
+          </button>
+        </div>
+      </div>
+
+      {/* Main Content Area */}
+      <div className="p-4 sm:p-6">
+        {activeTab === 'console' && (
+          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
+            {/* TARGET 1: Hardware Test Device on Wi-Fi LAN (192.168.1.x) */}
+            <div className="border border-gray-300 rounded-lg p-5 bg-white shadow-xs flex flex-col justify-between">
+              <div>
+                <div className="flex items-center justify-between pb-3 border-b border-gray-200">
+                  <div className="flex items-center space-x-2.5">
+                    <div className="p-2 bg-blue-50 text-blue-700 rounded-md border border-blue-200">
+                      <WifiIcon className="w-5 h-5" />
+                    </div>
+                    <div>
+                      <h3 className="font-bold text-gray-900 text-base">Hardware Test Device</h3>
+                      <p className="text-xs text-gray-500 font-mono">
+                        Target Address Space: <span className="text-blue-700 font-semibold">local</span> (Private Wi-Fi LAN)
+                      </p>
+                    </div>
+                  </div>
+
+                  {/* Status Indicator */}
+                  <div className="flex items-center space-x-1.5">
+                    {hardwareStatus === 'connected' && (
+                      <span className="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2.5 py-1 rounded-full border border-green-200">
+                        <CheckCircleIcon className="w-4 h-4 text-green-600" />
+                        Connected {hardwareLatency !== null ? `(${hardwareLatency}ms)` : ''}
+                      </span>
+                    )}
+                    {hardwareStatus === 'connecting' && (
+                      <span className="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">
+                        <ArrowPathIcon className="w-4 h-4 text-amber-600 animate-spin" />
+                        Probing...
+                      </span>
+                    )}
+                    {hardwareStatus === 'error' && (
+                      <span className="inline-flex items-center gap-1 text-xs font-semibold text-red-700 bg-red-50 px-2.5 py-1 rounded-full border border-red-200">
+                        <XCircleIcon className="w-4 h-4 text-red-600" />
+                        Offline / Blocked
+                      </span>
+                    )}
+                    {hardwareStatus === 'idle' && (
+                      <span className="inline-flex items-center gap-1 text-xs font-semibold text-gray-600 bg-gray-100 px-2.5 py-1 rounded-full">
+                        Standby
+                      </span>
+                    )}
+                  </div>
+                </div>
+
+                {/* Configuration Inputs */}
