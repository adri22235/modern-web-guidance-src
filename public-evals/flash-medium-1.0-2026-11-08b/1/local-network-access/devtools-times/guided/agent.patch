+/**
+ * Local Network Access (LNA) Utilities
+ * Implements W3C Local Network Access specifications:
+ * - Granular permissions: 'local-network' and 'loopback-network'
+ * - Target address space declaration in fetch: targetAddressSpace: 'local' | 'loopback'
+ * - WebSocket protocol adherence (subprotocol string/array only, no options object)
+ * - Safe permission queries (never queries legacy 'local-network-access' to avoid renderer crash)
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type LnaPermissionState = 'granted' | 'prompt' | 'denied' | 'unsupported';
+
+/**
+ * Cross-browser safe permission query for granular LNA permissions.
+ * Never queries legacy 'local-network-access', which can crash older Chrome renderer processes.
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<LnaPermissionState> {
+  if (typeof window === 'undefined' || !navigator.permissions?.query) {
+    return 'unsupported';
+  }
+
+  try {
+    const status = await navigator.permissions.query({ name: permissionName as any });
+    return status.state as LnaPermissionState;
+  } catch {
+    // If the browser doesn't recognize 'local-network' or 'loopback-network',
+    // treat the state as 'prompt' so user click still attempts the request.
+    return 'prompt';
+  }
+}
+
+/**
+ * Watches for permission state changes (e.g. user toggles in Chrome site settings).
+ * Returns an unwatch callback.
+ */
+export function watchLnaPermission(
+  permissionName: LnaPermissionName,
+  onChange: (state: LnaPermissionState) => void
+): () => void {
+  if (typeof window === 'undefined' || !navigator.permissions?.query) {
+    return () => {};
+  }
+
+  let active = true;
+  let statusObj: PermissionStatus | null = null;
+  const listener = () => {
+    if (active && statusObj) {
+      onChange(statusObj.state as LnaPermissionState);
+    }
+  };
+
+  navigator.permissions
+    .query({ name: permissionName as any })
+    .then((status) => {
+      if (!active) return;
+      statusObj = status;
+      onChange(status.state as LnaPermissionState);
+      status.addEventListener('change', listener);
+    })
+    .catch(() => {
+      if (active) {
+        onChange('prompt');
+      }
+    });
+
+  return () => {
+    active = false;
+    if (statusObj) {
+      statusObj.removeEventListener('change', listener);
+    }
+  };
+}
+
+export interface DiagnosticLogEntry {
+  id: string;
+  timestamp: string;
+  target: 'local-lan' | 'loopback-cli';
+  targetAddressSpace: 'local' | 'loopback';
+  url: string;
+  method: string;
+  status: 'pending' | 'success' | 'error' | 'simulated';
+  statusCode?: number;
+  durationMs: number;
+  message: string;
+  details?: any;
+}
+
+export interface FetchLnaOptions {
+  method?: string;
+  headers?: Record<string, string>;
+  body?: any;
+  timeoutMs?: number;
+}
+
+/**
+ * Initiates an HTTP request to a private LAN device (e.g., 192.168.1.x, 10.x, .local)
+ * declaring targetAddressSpace: 'local'.
+ */
+export async function fetchLocalDevice(
+  deviceUrl: string,
+  options: FetchLnaOptions = {}
+): Promise<{ ok: boolean; status: number; data: any; durationMs: number }> {
+  const start = performance.now();
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), options.timeoutMs ?? 5000);
+
+  try {
+    const request = new Request(deviceUrl, {
+      method: options.method || 'GET',
+      headers: {
+        Accept: 'application/json, text/plain, */*',
+        ...(options.headers || {}),
+      },
+      body: options.body ? JSON.stringify(options.body) : undefined,
+      mode: 'cors',
+      signal: controller.signal,
+      targetAddressSpace: 'local',
+    } as RequestInit);
+
+    const response = await fetch(request);
+    clearTimeout(timeoutId);
+    const durationMs = Math.round(performance.now() - start);
+
+    let data: any;
+    const contentType = response.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      data = await response.json();
+    } else {
+      data = await response.text();
+    }
+
+    return {
+      ok: response.ok,
+      status: response.status,
+      data,
+      durationMs,
+    };
+  } catch (err: any) {
+    clearTimeout(timeoutId);
+    const durationMs = Math.round(performance.now() - start);
+    throw {
+      name: err.name,
+      message: err.name === 'AbortError' ? 'Connection timed out (5s)' : err.message,
+      durationMs,
+      originalError: err,
+    };
+  }
+}
+
+/**
+ * Initiates an HTTP request to a local companion CLI running on 127.0.0.1 / localhost
+ * declaring targetAddressSpace: 'loopback'.
+ */
+export async function fetchLoopbackCLI(
+  cliUrl: string,
+  options: FetchLnaOptions = {}
+): Promise<{ ok: boolean; status: number; data: any; durationMs: number }> {
+  const start = performance.now();
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), options.timeoutMs ?? 5000);
+
+  try {
+    const request = new Request(cliUrl, {
+      method: options.method || 'GET',
+      headers: {
+        Accept: 'application/json, text/plain, */*',
+        ...(options.headers || {}),
+      },
+      body: options.body ? JSON.stringify(options.body) : undefined,
+      mode: 'cors',
+      signal: controller.signal,
+      targetAddressSpace: 'loopback',
+    } as RequestInit);
+
+    const response = await fetch(request);
+    clearTimeout(timeoutId);
+    const durationMs = Math.round(performance.now() - start);
+
+    let data: any;
+    const contentType = response.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      data = await response.json();
+    } else {
+      data = await response.text();
+    }
+
+    return {
+      ok: response.ok,
+      status: response.status,
+      data,
+      durationMs,
+    };
+  } catch (err: any) {
+    clearTimeout(timeoutId);
+    const durationMs = Math.round(performance.now() - start);
+    throw {
+      name: err.name,
+      message: err.name === 'AbortError' ? 'Connection timed out (5s)' : err.message,
+      durationMs,
+      originalError: err,
+    };
+  }
+}
+
+/**
+ * Opens a WebSocket connection to a local or loopback endpoint.
+ * Note: WebSocket constructor only takes protocols as second arg (never options object).
+ */
+export function openLocalWebSocket(wsUrl: string, protocols?: string | string[]): WebSocket {
+  // Browsers exempt ws:// from mixed content when host is private/loopback IP literal or localhost
+  return protocols ? new WebSocket(wsUrl, protocols) : new WebSocket(wsUrl);
+}
+
