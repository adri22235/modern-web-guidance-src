@@ -0,0 +1,1029 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  type LnaPermissionState,
+  type DiagnosticLogEntry,
+  queryLnaPermissionSafe,
+  watchLnaPermission,
+  fetchLocalDevice,
+  fetchLoopbackCLI,
+  openLocalWebSocket,
+  generateMockLanResponse,
+  generateMockCliResponse,
+} from '../utils/lna';
+
+interface Props {
+  isOpen: boolean;
+  initialTab?: 'lan' | 'cli' | 'logs' | 'specs';
+  onClose: () => void;
+}
+
+export default function DiagnosticsWidget({ isOpen, initialTab = 'lan', onClose }: Props) {
+  const [activeTab, setActiveTab] = useState<'lan' | 'cli' | 'logs' | 'specs'>(initialTab);
+
+  // Permission states
+  const [lanPermission, setLanPermission] = useState<LnaPermissionState>('prompt');
+  const [cliPermission, setCliPermission] = useState<LnaPermissionState>('prompt');
+
+  // LAN target states
+  const [lanUrl, setLanUrl] = useState('http://192.168.1.120:8080/api/status');
+  const [lanLoading, setLanLoading] = useState(false);
+  const [lanData, setLanData] = useState<any>(null);
+  const [lanError, setLanError] = useState<string | null>(null);
+  const [lanWsActive, setLanWsActive] = useState(false);
+  const [lanWsMessages, setLanWsMessages] = useState<string[]>([]);
+  const wsRef = useRef<WebSocket | null>(null);
+
+  // CLI loopback target states
+  const [cliUrl, setCliUrl] = useState('http://127.0.0.1:8765/health');
+  const [cliLoading, setCliLoading] = useState(false);
+  const [cliData, setCliData] = useState<any>(null);
+  const [cliError, setCliError] = useState<string | null>(null);
+  const [cliCommand, setCliCommand] = useState('devtools --status');
+  const [cliOutput, setCliOutput] = useState<string[]>([]);
+
+  // Logs
+  const [logs, setLogs] = useState<DiagnosticLogEntry[]>([]);
+  const [logFilter, setLogFilter] = useState<'all' | 'local-lan' | 'loopback-cli'>('all');
+  const [copiedLogs, setCopiedLogs] = useState(false);
+
+  // Helper to add log entry
+  const addLog = (entry: Omit<DiagnosticLogEntry, 'id' | 'timestamp'>) => {
+    const newEntry: DiagnosticLogEntry = {
+      ...entry,
+      id: Math.random().toString(36).substring(2, 9),
+      timestamp: new Date().toLocaleTimeString(),
+    };
+    setLogs((prev) => [newEntry, ...prev]);
+  };
+
+  // Watch permission changes
+  useEffect(() => {
+    if (!isOpen) return;
+
+    if (initialTab) {
+      setActiveTab(initialTab);
+    }
+
+    queryLnaPermissionSafe('local-network').then(setLanPermission);
+    queryLnaPermissionSafe('loopback-network').then(setCliPermission);
+
+    const unwatchLan = watchLnaPermission('local-network', setLanPermission);
+    const unwatchCli = watchLnaPermission('loopback-network', setCliPermission);
+
+    return () => {
+      unwatchLan();
+      unwatchCli();
+    };
+  }, [isOpen]);
+
+  // Handle ESC key
+  useEffect(() => {
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape' && isOpen) {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+    return () => window.removeEventListener('keydown', handleKeyDown);
+  }, [isOpen, onClose]);
+
+  // Cleanup WebSocket on unmount
+  useEffect(() => {
+    return () => {
+      if (wsRef.current) {
+        wsRef.current.close();
+      }
+    };
+  }, []);
+
+  if (!isOpen) return null;
+
+  // Handler: Connect to LAN hardware device (Private Network)
+  const handleConnectLan = async () => {
+    setLanLoading(true);
+    setLanError(null);
+
+    addLog({
+      target: 'local-lan',
+      targetAddressSpace: 'local',
+      url: lanUrl,
+      method: 'GET',
+      status: 'pending',
+      durationMs: 0,
+      message: `Initiating fetch to LAN hardware with targetAddressSpace: 'local'`,
+    });
+
+    try {
+      const res = await fetchLocalDevice(lanUrl, { timeoutMs: 3500 });
+      setLanData(res.data);
+      setLanPermission('granted');
+
+      addLog({
+        target: 'local-lan',
+        targetAddressSpace: 'local',
+        url: lanUrl,
+        method: 'GET',
+        status: 'success',
+        statusCode: res.status,
+        durationMs: res.durationMs,
+        message: `HTTP ${res.status} OK from private LAN device (${res.durationMs}ms)`,
+        details: res.data,
+      });
+    } catch (err: any) {
+      setLanError(err.message || 'Connection failed');
+
+      addLog({
+        target: 'local-lan',
+        targetAddressSpace: 'local',
+        url: lanUrl,
+        method: 'GET',
+        status: 'error',
+        durationMs: err.durationMs || 0,
+        message: `LAN Connection error: ${err.message}`,
+        details: err,
+      });
+    } finally {
+      setLanLoading(false);
+    }
+  };
+
+  // Handler: Use simulated LAN device
+  const handleSimulateLan = () => {
+    const mock = generateMockLanResponse(lanUrl);
+    setLanData(mock);
+    setLanError(null);
+    addLog({
+      target: 'local-lan',
+      targetAddressSpace: 'local',
+      url: lanUrl,
+      method: 'GET',
+      status: 'simulated',
+      durationMs: 12,
+      message: 'Simulated response loaded for offline reader preview',
+      details: mock,
+    });
+  };
+
+  // Handler: Toggle WebSocket telemetry stream for LAN device
+  const handleToggleLanWs = () => {
+    if (lanWsActive && wsRef.current) {
+      wsRef.current.close();
+      wsRef.current = null;
+      setLanWsActive(false);
+      return;
+    }
+
+    try {
+      // Convert http:// to ws://
+      const wsUrl = lanUrl.replace(/^http/, 'ws').replace(/\/api\/status$/, '/stream');
+      addLog({
+        target: 'local-lan',
+        targetAddressSpace: 'local',
+        url: wsUrl,
+        method: 'WS',
+        status: 'pending',
+        durationMs: 0,
+        message: `Opening WebSocket to ${wsUrl} (subprotocol: ['v1.telemetry'])`,
+      });
+
+      const socket = openLocalWebSocket(wsUrl, ['v1.telemetry']);
+      wsRef.current = socket;
+      setLanWsActive(true);
+
+      socket.onopen = () => {
+        setLanWsMessages((prev) => [`[${new Date().toLocaleTimeString()}] WebSocket connected to LAN device`, ...prev]);
+        addLog({
+          target: 'local-lan',
+          targetAddressSpace: 'local',
+          url: wsUrl,
+          method: 'WS',
+          status: 'success',
+          durationMs: 15,
+          message: 'WebSocket stream established with LAN device',
+        });
+      };
+
+      socket.onmessage = (event) => {
+        setLanWsMessages((prev) => [`[${new Date().toLocaleTimeString()}] Data: ${event.data}`, ...prev.slice(0, 30)]);
+      };
+
+      socket.onerror = (e) => {
+        setLanWsMessages((prev) => [`[${new Date().toLocaleTimeString()}] WebSocket error or offline endpoint`, ...prev]);
+        addLog({
+          target: 'local-lan',
+          targetAddressSpace: 'local',
+          url: wsUrl,
+          method: 'WS',
+          status: 'error',
+          durationMs: 0,
+          message: 'WebSocket error on LAN target',
+        });
+        setLanWsActive(false);
+      };
+
+      socket.onclose = () => {
+        setLanWsActive(false);
+      };
+    } catch (e: any) {
+      setLanWsActive(false);
+      setLanError(`WS init error: ${e.message}`);
+    }
+  };
+
+  // Handler: Connect & Run command on Local Companion CLI (127.0.0.1)
+  const handleRunCliCommand = async (cmdToRun: string = cliCommand) => {
+    setCliLoading(true);
+    setCliError(null);
+
+    const fullUrl = `${cliUrl.replace(/\/health$/, '')}/exec?cmd=${encodeURIComponent(cmdToRun)}`;
+
+    addLog({
+      target: 'loopback-cli',
+      targetAddressSpace: 'loopback',
+      url: fullUrl,
+      method: 'POST',
+      status: 'pending',
+      durationMs: 0,
+      message: `Executing CLI command [${cmdToRun}] on 127.0.0.1 with targetAddressSpace: 'loopback'`,
+    });
+
+    try {
+      const res = await fetchLoopbackCLI(fullUrl, {
+        method: 'POST',
+        body: { command: cmdToRun },
+        timeoutMs: 3500,
+      });
+
+      setCliData(res.data);
+      setCliPermission('granted');
+      setCliOutput((prev) => [
+        `$ ${cmdToRun}`,
+        JSON.stringify(res.data, null, 2),
+        ...prev,
+      ]);
+
+      addLog({
+        target: 'loopback-cli',
+        targetAddressSpace: 'loopback',
+        url: fullUrl,
+        method: 'POST',
+        status: 'success',
+        statusCode: res.status,
+        durationMs: res.durationMs,
+        message: `HTTP ${res.status} OK from companion CLI (${res.durationMs}ms)`,
+        details: res.data,
+      });
+    } catch (err: any) {
+      setCliError(err.message || 'CLI daemon unreachable on loopback');
+
+      addLog({
+        target: 'loopback-cli',
+        targetAddressSpace: 'loopback',
+        url: fullUrl,
+        method: 'POST',
+        status: 'error',
+        durationMs: err.durationMs || 0,
+        message: `Loopback CLI error: ${err.message}`,
+        details: err,
+      });
+    } finally {
+      setCliLoading(false);
+    }
+  };
+
+  // Handler: Simulate CLI output
+  const handleSimulateCli = (cmdToRun: string = cliCommand) => {
+    const mock = generateMockCliResponse(cmdToRun);
+    setCliData(mock);
+    setCliError(null);
+    setCliOutput((prev) => [
+      `$ ${cmdToRun}`,
+      JSON.stringify(mock, null, 2),
+      ...prev,
+    ]);
+
+    addLog({
+      target: 'loopback-cli',
+      targetAddressSpace: 'loopback',
+      url: `${cliUrl}?mock=${cmdToRun}`,
+      method: 'POST',
+      status: 'simulated',
+      durationMs: 8,
+      message: `Simulated CLI output for [${cmdToRun}]`,
+      details: mock,
+    });
+  };
+
+  // Helper badge color
+  const getBadgeClass = (state: LnaPermissionState) => {
+    switch (state) {
+      case 'granted':
+        return 'bg-emerald-100 text-emerald-800 border-emerald-300';
+      case 'denied':
+        return 'bg-rose-100 text-rose-800 border-rose-300';
+      case 'prompt':
+        return 'bg-amber-100 text-amber-800 border-amber-300';
+      default:
+        return 'bg-gray-100 text-gray-700 border-gray-300';
+    }
+  };
+
+  const filteredLogs = logs.filter((log) => {
+    if (logFilter === 'all') return true;
+    return log.target === logFilter;
+  });
+
+  const handleCopyLogs = () => {
+    navigator.clipboard.writeText(JSON.stringify(logs, null, 2));
+    setCopiedLogs(true);
+    setTimeout(() => setCopiedLogs(false), 2000);
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99999] flex justify-center items-start p-3 sm:p-6 overflow-y-auto"
+      onClick={onClose}
+    >
+      <div
+        className="bg-white rounded-xl shadow-2xl w-full max-w-4xl border border-gray-200 overflow-hidden my-auto flex flex-col max-h-[92vh]"
+        onClick={(e) => e.stopPropagation()}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="diagnostics-title"
+      >
+        {/* Header bar */}
+        <div className="bg-slate-900 text-white px-5 py-4 flex items-center justify-between border-b border-slate-800">
+          <div className="flex items-center space-x-3">
+            <div className="w-8 h-8 rounded-lg bg-amber-400 text-slate-900 flex items-center justify-center font-mono font-bold text-lg">
+              ⚡
+            </div>
+            <div>
+              <h2 id="diagnostics-title" className="text-base sm:text-lg font-bold flex items-center gap-2">
+                Developer Diagnostics Bridge
+                <span className="text-[10px] font-mono tracking-wider uppercase px-2 py-0.5 rounded bg-amber-400/20 text-amber-300 border border-amber-400/30">
+                  LNA Standard
+                </span>
+              </h2>
+              <p className="text-xs text-slate-400">
+                Direct browser connections to private Wi-Fi hardware and 127.0.0.1 CLI
+              </p>
+            </div>
+          </div>
+
+          <div className="flex items-center space-x-3">
+            {/* Permission Indicators */}
+            <div className="hidden md:flex items-center space-x-2 text-xs">
+              <span className="text-slate-400 font-mono text-[11px]">LAN:</span>
+              <span className={`px-2 py-0.5 rounded-full border text-[11px] font-mono font-medium ${getBadgeClass(lanPermission)}`}>
+                {lanPermission}
