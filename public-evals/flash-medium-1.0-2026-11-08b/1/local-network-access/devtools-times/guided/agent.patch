+import React, { useState, useEffect } from 'react';
+import { queryLnaPermissionSafe, type LnaPermissionState } from '../utils/lna';
+
+export default function DiagnosticsBanner() {
+  const [lanState, setLanState] = useState<LnaPermissionState>('prompt');
+  const [cliState, setCliState] = useState<LnaPermissionState>('prompt');
+
+  useEffect(() => {
+    queryLnaPermissionSafe('local-network').then(setLanState);
+    queryLnaPermissionSafe('loopback-network').then(setCliState);
+  }, []);
+
+  const openTab = (tab: 'lan' | 'cli') => {
+    window.dispatchEvent(new CustomEvent('open-diagnostics', { detail: { tab } }));
+  };
+
+  const getPill = (state: LnaPermissionState) => {
+    if (state === 'granted') return 'bg-emerald-100 text-emerald-800 border-emerald-300';
+    if (state === 'denied') return 'bg-rose-100 text-rose-800 border-rose-300';
+    return 'bg-amber-100 text-amber-800 border-amber-300';
+  };
+
+  return (
+    <div className="bg-slate-900 text-white rounded-xl shadow-lg border border-slate-800 overflow-hidden my-6">
+      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center p-6 sm:p-8">
+        <div className="lg:col-span-8 space-y-4">
+          <div className="flex flex-wrap items-center gap-2">
+            <span className="bg-amber-400 text-slate-950 text-xs font-mono font-bold px-2.5 py-0.5 rounded uppercase tracking-wider">
+              Developer Diagnostics
+            </span>
+            <span className="text-xs text-slate-400 font-mono">
+              Local Network Access (LNA) Bridge
+            </span>
+          </div>
+
+          <h2 className="text-2xl sm:text-3xl font-bold font-brand tracking-tight text-white">
+            Connect Browser to LAN Hardware & Loopback CLI
+          </h2>
+
+          <p className="text-sm text-slate-300 max-w-2xl leading-relaxed">
+            Directly test connection payloads to your private Wi-Fi hardware devices (e.g.{' '}
+            <code className="text-amber-300 font-mono text-xs">192.168.1.x</code>) and your local companion
+            CLI daemon (<code className="text-emerald-300 font-mono text-xs">127.0.0.1</code>) without leaving
+            The DevTools Times. Powered by granular <code className="text-amber-200 font-mono text-xs">targetAddressSpace</code>{' '}
+            controls and real-time permission status.
+          </p>
+
+          <div className="flex flex-wrap items-center gap-4 pt-1">
+            <button
+              onClick={() => openTab('lan')}
+              className="px-4 py-2 bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs sm:text-sm font-semibold rounded-lg flex items-center gap-2 shadow-sm transition cursor-pointer"
+            >
+              <svg className="w-4 h-4 text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"
+                />
+              </svg>
+              Connect Hardware (192.168.1.x)
+            </button>
+
+            <button
+              onClick={() => openTab('cli')}
+              className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 text-xs sm:text-sm font-semibold rounded-lg flex items-center gap-2 transition cursor-pointer"
+            >
+              <svg className="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
+                />
+              </svg>
+              Connect Companion CLI (127.0.0.1)
+            </button>
+          </div>
+
+          <div className="flex flex-wrap items-center gap-4 text-xs font-mono pt-2 text-slate-400">
+            <div className="flex items-center gap-1.5">
+              <span>local-network:</span>
+              <span className={`px-2 py-0.5 rounded-full border text-[10px] font-semibold ${getPill(lanState)}`}>
+                {lanState}
+              </span>
+            </div>
+            <div className="flex items-center gap-1.5">
+              <span>loopback-network:</span>
+              <span className={`px-2 py-0.5 rounded-full border text-[10px] font-semibold ${getPill(cliState)}`}>
+                {cliState}
+              </span>
+            </div>
+            <span className="text-slate-500 hidden sm:inline">•</span>
+            <span className="text-slate-400 hidden sm:inline">Shortcut: Ctrl+Shift+D</span>
+          </div>
+        </div>
+
+        <div className="lg:col-span-4 flex justify-center">
+          <div className="relative rounded-lg overflow-hidden border border-slate-700 shadow-xl max-w-xs w-full bg-slate-950">
+            <img
+              src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80"
+              alt="Hardware test bench circuitry"
+              className="w-full h-44 object-cover opacity-80"
+              loading="lazy"
+            />
+            <div className="p-3 bg-slate-950/90 border-t border-slate-800 text-[11px] font-mono text-slate-300 flex justify-between items-center">
+              <span className="text-amber-400 font-semibold">Bench Diagnostics</span>
+              <span className="text-emerald-400 text-[10px]">LNA Bridge Active</span>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
