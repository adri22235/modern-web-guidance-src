@@ -0,0 +1,91 @@
+import React, { useState, useEffect } from 'react';
+import DiagnosticsWidget from './DiagnosticsWidget';
+import { queryLnaPermissionSafe, type LnaPermissionState } from '../utils/lna';
+
+export default function DiagnosticsButton() {
+  const [isOpen, setIsOpen] = useState(false);
+  const [activeTab, setActiveTab] = useState<'lan' | 'cli' | 'logs' | 'specs'>('lan');
+  const [lanStatus, setLanStatus] = useState<LnaPermissionState>('prompt');
+  const [cliStatus, setCliStatus] = useState<LnaPermissionState>('prompt');
+
+  useEffect(() => {
+    queryLnaPermissionSafe('local-network').then(setLanStatus);
+    queryLnaPermissionSafe('loopback-network').then(setCliStatus);
+
+    // Global custom event listener
+    const handleOpenCustom = (e: Event) => {
+      const customEvent = e as CustomEvent<{ tab?: 'lan' | 'cli' | 'logs' | 'specs' }>;
+      if (customEvent.detail?.tab) {
+        setActiveTab(customEvent.detail.tab);
+      }
+      setIsOpen(true);
+    };
+
+    // Global keyboard shortcut: Ctrl+Shift+D or Cmd+Shift+D
+    const handleGlobalKeyDown = (e: KeyboardEvent) => {
+      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'D' || e.key === 'd')) {
+        e.preventDefault();
+        setIsOpen((prev) => !prev);
+      }
+    };
+
+    window.addEventListener('open-diagnostics', handleOpenCustom);
+    window.addEventListener('keydown', handleGlobalKeyDown);
+    return () => {
+      window.removeEventListener('open-diagnostics', handleOpenCustom);
+      window.removeEventListener('keydown', handleGlobalKeyDown);
+    };
+  }, []);
+
+  const hasActiveAccess = lanStatus === 'granted' || cliStatus === 'granted';
+
+  return (
+    <>
+      <button
+        onClick={() => setIsOpen(true)}
+        className="group relative flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold text-gray-700 hover:text-amber-600 hover:bg-amber-50/80 border border-gray-200 transition-all cursor-pointer shadow-2xs"
+        title="Open Developer Diagnostics Connection Widget (Private Wi-Fi LAN & 127.0.0.1 CLI) [Ctrl+Shift+D]"
+        aria-label="Developer Diagnostics Connection Widget"
+      >
+        <span className="relative flex h-2 w-2">
+          {hasActiveAccess && (
+            <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
+          )}
+          <span
+            className={`relative inline-flex rounded-full h-2 w-2 ${
+              hasActiveAccess ? 'bg-emerald-500' : 'bg-amber-400'
+            }`}
+          ></span>
+        </span>
+
+        {/* Terminal / Chip Diagnostics Icon */}
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          className="h-4 w-4 text-gray-600 group-hover:text-amber-500 transition-colors"
+          fill="none"
+          viewBox="0 0 24 24"
+          stroke="currentColor"
+          strokeWidth={2}
+        >
+          <path
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
+          />
+        </svg>
+
+        <span className="hidden sm:inline font-mono text-[11px] font-medium tracking-tight text-gray-700 group-hover:text-amber-600">
+          Diagnostics
+        </span>
+      </button>
+
+      {isOpen && (
+        <DiagnosticsWidget
+          isOpen={isOpen}
+          initialTab={activeTab}
+          onClose={() => setIsOpen(false)}
+        />
+      )}
+    </>
+  );
+}
