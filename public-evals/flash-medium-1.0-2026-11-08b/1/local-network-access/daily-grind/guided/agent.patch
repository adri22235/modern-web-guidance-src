@@ -0,0 +1,581 @@
+/**
+ * The Daily Grind - Interactive Equipment Connection Module
+ * 
+ * Implements Local Network Access (LNA) standards for connecting to:
+ * 1. Private LAN Wi-Fi Coffee Brewer (RFC 1918 / 192.168.1.x) with targetAddressSpace: 'local'
+ * 2. Companion Desktop Brewing Helper (127.0.0.1 / loopback) with targetAddressSpace: 'loopback'
+ */
+
+// Global state
+const state = {
+  brewer: {
+    connected: false,
+    isSimulated: false,
+    status: 'idle', // idle, preheating, ready, brewing, flushing
+    temp: 93.4,
+    targetTemp: 93.5,
+    pressure: 0.0,
+    waterLevel: 88,
+    flowRate: 0.0,
+    brewTimer: null,
+    brewSeconds: 0,
+    timerInterval: null,
+    ws: null,
+  },
+  companion: {
+    connected: false,
+    isSimulated: false,
+    status: 'offline', // offline, connected, syncing
+    daemonVersion: 'v2.4.1',
+    scaleName: 'Acaia Lunar [BLE]',
+    scaleWeight: 0.0,
+    grindSize: 240, // microns
+    activeRecipe: 'Daily Grind Signature Blend (18.5g in, 37g out, 28s)',
+  },
+};
+
+/**
+ * Cross-browser permission check for the granular LNA permissions.
+ * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+ * @param {'local-network' | 'loopback-network'} permissionName
+ */
+export async function queryLnaPermissionSafe(permissionName) {
+  if (!navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName });
+    status.addEventListener('change', () => {
+      updatePermissionUI(permissionName, status.state);
+      logMessage(`[Permission] '${permissionName}' state changed to: ${status.state}`, 'info');
+    });
+    return status.state;
+  } catch (err) {
+    // Unrecognized permission name in this browser; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Synchronizes the permission status indicator and actionable remediation UI.
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {string} permState
+ */
+export function updatePermissionUI(permissionName, permState) {
+  const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+  const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+  
+  if (statusBadge) {
+    statusBadge.textContent = permState.toUpperCase();
+    statusBadge.className = `status-pill status-${permState.toLowerCase()}`;
+  }
+  if (remediationBox) {
+    // Show remediation instructions whenever permission is explicitly denied
+    remediationBox.hidden = permState !== 'denied';
+  }
+}
+
+/**
+ * Appends formatted message to the diagnostic log panel.
+ * @param {string} message
+ * @param {'info' | 'success' | 'warn' | 'error'} type
+ */
+export function logMessage(message, type = 'info') {
+  const logConsole = document.getElementById('equipment-log');
+  if (!logConsole) return;
+
+  const entry = document.createElement('div');
+  entry.className = `log-entry log-${type}`;
+  const now = new Date().toLocaleTimeString();
+  entry.innerHTML = `<span class="log-time">[${now}]</span> <span class="log-text">${escapeHtml(message)}</span>`;
+  logConsole.appendChild(entry);
+  logConsole.scrollTop = logConsole.scrollHeight;
+}
+
+function escapeHtml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+/**
+ * Connects to the local network Wi-Fi coffee brewer over HTTP.
+ * Declares targetAddressSpace: 'local' for RFC 1918 / .local LAN address space.
+ * @param {string} deviceUrl
+ */
+export async function fetchLocalDeviceStatus(deviceUrl) {
+  const endpoint = `${deviceUrl.replace(/\/+$/, '')}/api/status`;
+  const request = new Request(endpoint, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to the companion brewing helper daemon running on the user's loopback interface.
+ * Declares targetAddressSpace: 'loopback' for 127.0.0.1, [::1], or localhost.
+ * @param {string} daemonUrl
+ */
+export async function fetchLoopbackDaemon(daemonUrl) {
+  const endpoint = `${daemonUrl.replace(/\/+$/, '')}/health`;
+  const request = new Request(endpoint, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion helper responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Dispatches a recipe synchronization payload to the loopback companion daemon.
+ * @param {string} daemonUrl
+ * @param {object} recipeData
+ */
+export async function syncRecipesToLoopback(daemonUrl, recipeData) {
+  const endpoint = `${daemonUrl.replace(/\/+$/, '')}/api/recipes/sync`;
+  const request = new Request(endpoint, {
+    method: 'POST',
+    mode: 'cors',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify(recipeData),
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion recipe sync responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Opens a WebSocket connection to the brewer's real-time telemetry stream.
+ * Pass only subprotocol string(s) as the second argument (never an options object).
+ * @param {string} wsUrl
+ */
+export function openLocalWebSocket(wsUrl) {
+  // Pass only subprotocol string(s) as the second argument (never an options object).
+  // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+  // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+  const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+  return socket;
+}
+
+// ----------------------------------------------------
+// UI Controllers & Interactive Simulation
+// ----------------------------------------------------
+
+export function initEquipmentPanel() {
+  // Initialize permission state checks
+  queryLnaPermissionSafe('local-network').then((state) => {
+    updatePermissionUI('local-network', state);
+    logMessage(`Initial 'local-network' permission state: ${state}`, 'info');
+  });
+
+  queryLnaPermissionSafe('loopback-network').then((state) => {
+    updatePermissionUI('loopback-network', state);
+    logMessage(`Initial 'loopback-network' permission state: ${state}`, 'info');
+  });
+
+  setupBrewerControls();
+  setupCompanionControls();
+  setupLogControls();
+}
+
+function setupBrewerControls() {
+  const connectBtn = document.getElementById('brewer-connect-btn');
+  const wsBtn = document.getElementById('brewer-ws-btn');
+  const demoBtn = document.getElementById('brewer-demo-btn');
+  const preheatBtn = document.getElementById('brewer-preheat-btn');
+  const brewBtn = document.getElementById('brewer-brew-btn');
+  const flushBtn = document.getElementById('brewer-flush-btn');
+  const disconnectBtn = document.getElementById('brewer-disconnect-btn');
+
+  connectBtn?.addEventListener('click', async () => {
+    const urlInput = document.getElementById('brewer-url');
+    const deviceUrl = urlInput?.value.trim() || 'http://192.168.1.120:8080';
+    
+    logMessage(`[Brewer] Initiating request to ${deviceUrl}/api/status with targetAddressSpace: 'local'...`, 'info');
+    connectBtn.disabled = true;
+    connectBtn.textContent = 'Connecting...';
+
+    try {
+      const data = await fetchLocalDeviceStatus(deviceUrl);
+      logMessage(`[Brewer] Connected successfully: ${JSON.stringify(data)}`, 'success');
+      state.brewer.connected = true;
+      state.brewer.isSimulated = false;
+      state.brewer.status = data.status || 'ready';
+      if (data.temp) state.brewer.temp = data.temp;
+      if (data.pressure) state.brewer.pressure = data.pressure;
+      if (data.waterLevel) state.brewer.waterLevel = data.waterLevel;
+      updateBrewerUI();
+    } catch (err) {
+      logMessage(`[Brewer] Connection attempt failed: ${err.message}`, 'error');
+      logMessage(`[Brewer Tip] If physical brewer at ${deviceUrl} is unreachable on this network, click "Interactive Demo Mode" to preview real-time controls!`, 'warn');
+      alertDeviceOffline('brewer', deviceUrl);
+    } finally {
+      connectBtn.disabled = false;
+      connectBtn.textContent = 'Connect via HTTP';
+    }
+  });
+
+  wsBtn?.addEventListener('click', () => {
+    const wsInput = document.getElementById('brewer-ws-url');
+    const wsUrl = wsInput?.value.trim() || 'ws://192.168.1.120:8080/stream';
+    logMessage(`[Brewer WS] Connecting to ${wsUrl} with subprotocol ['v1.telemetry']...`, 'info');
+
+    try {
+      if (state.brewer.ws) {
+        state.brewer.ws.close();
+      }
+      const ws = openLocalWebSocket(wsUrl);
+      state.brewer.ws = ws;
+
+      ws.addEventListener('open', () => {
+        logMessage(`[Brewer WS] Telemetry stream established with ${wsUrl}`, 'success');
+        state.brewer.connected = true;
+        updateBrewerUI();
+      });
+
+      ws.addEventListener('message', (event) => {
+        try {
+          const telemetry = JSON.parse(event.data);
+          logMessage(`[Brewer Telemetry] Temp: ${telemetry.temp}°C, Pressure: ${telemetry.pressure} bar`, 'info');
+          if (telemetry.temp) state.brewer.temp = telemetry.temp;
+          if (telemetry.pressure) state.brewer.pressure = telemetry.pressure;
+          updateBrewerUI();
+        } catch {
+          logMessage(`[Brewer Telemetry] Stream data: ${event.data}`, 'info');
+        }
+      });
+
+      ws.addEventListener('error', () => {
+        logMessage(`[Brewer WS] Telemetry stream error on ${wsUrl}. Verify device endpoint and subprotocol.`, 'error');
+      });
+
+      ws.addEventListener('close', () => {
+        logMessage(`[Brewer WS] Telemetry connection closed.`, 'warn');
+      });
+    } catch (err) {
+      logMessage(`[Brewer WS] Error: ${err.message}`, 'error');
+    }
+  });
+
+  demoBtn?.addEventListener('click', () => {
+    state.brewer.connected = true;
+    state.brewer.isSimulated = true;
+    state.brewer.status = 'ready';
+    state.brewer.temp = 93.5;
+    state.brewer.pressure = 0.0;
+    state.brewer.waterLevel = 92;
+    logMessage(`[Brewer Demo] Interactive simulation activated for 192.168.1.120 (Dual Boiler Artisanal Brewer).`, 'success');
+    updateBrewerUI();
+  });
+
+  preheatBtn?.addEventListener('click', () => {
+    if (!state.brewer.connected) {
+      logMessage(`[Brewer] Please connect to brewer first or enable Demo Mode.`, 'warn');
+      return;
+    }
+    state.brewer.status = 'preheating';
+    logMessage(`[Brewer] Preheating group head and steam boiler...`, 'info');
+    updateBrewerUI();
+
+    let heatStep = 0;
+    const heatInterval = setInterval(() => {
+      heatStep++;
+      state.brewer.temp = +(state.brewer.temp + 0.3).toFixed(1);
+      if (state.brewer.temp >= 93.5 || heatStep >= 5) {
+        state.brewer.temp = 93.5;
+        state.brewer.status = 'ready';
+        clearInterval(heatInterval);
+        logMessage(`[Brewer] Temperature stabilized at ${state.brewer.temp}°C. Ready to brew!`, 'success');
+      }
+      updateBrewerUI();
+    }, 600);
+  });
+
+  brewBtn?.addEventListener('click', () => {
+    if (!state.brewer.connected) {
+      logMessage(`[Brewer] Please connect to brewer first or enable Demo Mode.`, 'warn');
+      return;
+    }
+    if (state.brewer.status === 'brewing') return;
+
+    state.brewer.status = 'brewing';
+    state.brewer.brewSeconds = 0;
+    state.brewer.pressure = 9.2;
+    state.brewer.flowRate = 2.1;
+    logMessage(`[Brewer] Starting 9-bar espresso extraction (Double Shot)...`, 'info');
+    updateBrewerUI();
+
+    if (state.brewer.timerInterval) clearInterval(state.brewer.timerInterval);
+    state.brewer.timerInterval = setInterval(() => {
+      state.brewer.brewSeconds++;
+      state.brewer.waterLevel = Math.max(10, state.brewer.waterLevel - 1);
+      
+      // Slight pressure variance simulation
+      state.brewer.pressure = +(9.1 + Math.random() * 0.25).toFixed(1);
+
+      if (state.brewer.brewSeconds >= 28) {
+        clearInterval(state.brewer.timerInterval);
+        state.brewer.status = 'ready';
+        state.brewer.pressure = 0.0;
+        state.brewer.flowRate = 0.0;
+        logMessage(`[Brewer] Double Shot extraction complete (38g out in 28s). Crema: Rich hazelnut.`, 'success');
+      }
+      updateBrewerUI();
+    }, 1000);
+  });
+
+  flushBtn?.addEventListener('click', () => {
+    if (!state.brewer.connected) {
+      logMessage(`[Brewer] Please connect to brewer first or enable Demo Mode.`, 'warn');
+      return;
+    }
+    state.brewer.status = 'flushing';
+    state.brewer.pressure = 3.5;
+    state.brewer.flowRate = 4.8;
+    logMessage(`[Brewer] Purging group head (3s flush)...`, 'info');
+    updateBrewerUI();
+
+    setTimeout(() => {
+      state.brewer.status = 'ready';
+      state.brewer.pressure = 0.0;
+      state.brewer.flowRate = 0.0;
+      logMessage(`[Brewer] Group head flush finished. Surface clean.`, 'info');
+      updateBrewerUI();
+    }, 3000);
+  });
+
+  disconnectBtn?.addEventListener('click', () => {
+    if (state.brewer.timerInterval) clearInterval(state.brewer.timerInterval);
+    if (state.brewer.ws) {
+      state.brewer.ws.close();
+      state.brewer.ws = null;
+    }
+    state.brewer.connected = false;
+    state.brewer.status = 'idle';
+    state.brewer.pressure = 0.0;
+    state.brewer.flowRate = 0.0;
+    logMessage(`[Brewer] Disconnected from Wi-Fi brewer.`, 'info');
+    updateBrewerUI();
+  });
+}
+
+function setupCompanionControls() {
+  const connectBtn = document.getElementById('companion-connect-btn');
+  const demoBtn = document.getElementById('companion-demo-btn');
+  const syncBtn = document.getElementById('companion-sync-btn');
+  const calibrateBtn = document.getElementById('companion-calibrate-btn');
+  const disconnectBtn = document.getElementById('companion-disconnect-btn');
+  const grindSlider = document.getElementById('companion-grind-slider');
+  const recipeSelect = document.getElementById('companion-recipe-select');
+
+  connectBtn?.addEventListener('click', async () => {
+    const urlInput = document.getElementById('companion-url');
+    const daemonUrl = urlInput?.value.trim() || 'http://127.0.0.1:45678';
+    
+    logMessage(`[Companion] Checking health at ${daemonUrl}/health with targetAddressSpace: 'loopback'...`, 'info');
+    connectBtn.disabled = true;
+    connectBtn.textContent = 'Connecting...';
+
+    try {
+      const data = await fetchLoopbackDaemon(daemonUrl);
+      logMessage(`[Companion] Desktop helper connected: ${JSON.stringify(data)}`, 'success');
+      state.companion.connected = true;
+      state.companion.isSimulated = false;
+      state.companion.status = 'connected';
+      if (data.version) state.companion.daemonVersion = data.version;
+      if (data.scaleWeight !== undefined) state.companion.scaleWeight = data.scaleWeight;
+      updateCompanionUI();
+    } catch (err) {
+      logMessage(`[Companion] Connection error: ${err.message}`, 'error');
+      logMessage(`[Companion Tip] If desktop helper is not running locally on 127.0.0.1:45678, try "Interactive Demo Mode"!`, 'warn');
+      alertDeviceOffline('companion', daemonUrl);
+    } finally {
+      connectBtn.disabled = false;
+      connectBtn.textContent = 'Connect via HTTP';
+    }
+  });
+
+  demoBtn?.addEventListener('click', () => {
+    state.companion.connected = true;
+    state.companion.isSimulated = true;
+    state.companion.status = 'connected';
+    state.companion.scaleWeight = 36.4;
+    logMessage(`[Companion Demo] Interactive desktop helper simulation active (127.0.0.1 bridge established).`, 'success');
+    updateCompanionUI();
+  });
+
+  syncBtn?.addEventListener('click', async () => {
+    if (!state.companion.connected) {
+      logMessage(`[Companion] Please connect to desktop helper first or enable Demo Mode.`, 'warn');
+      return;
+    }
+    const daemonUrl = document.getElementById('companion-url')?.value.trim() || 'http://127.0.0.1:45678';
+    const recipeName = recipeSelect?.value || state.companion.activeRecipe;
+    const grindMicrons = grindSlider?.value || state.companion.grindSize;
+
+    const payload = {
+      timestamp: Date.now(),
+      recipe: recipeName,
+      burrGapMicrons: Number(grindMicrons),
+      targetYieldGrams: 37.0,
+      targetTimeSeconds: 28,
+      source: 'The Daily Grind Web Hub',
+    };
+
+    logMessage(`[Companion] Syncing recipe '${recipeName}' (${grindMicrons}µm) to desktop helper...`, 'info');
+    
+    if (state.companion.isSimulated) {
+      setTimeout(() => {
+        state.companion.activeRecipe = recipeName;
+        state.companion.grindSize = Number(grindMicrons);
+        logMessage(`[Companion] Recipe synced to local helper daemon and synced with Acaia Bluetooth scale!`, 'success');
+        updateCompanionUI();
+      }, 500);
+    } else {
+      try {
+        const result = await syncRecipesToLoopback(daemonUrl, payload);
+        logMessage(`[Companion] Sync succeeded: ${JSON.stringify(result)}`, 'success');
+        state.companion.activeRecipe = recipeName;
+        updateCompanionUI();
+      } catch (err) {
+        logMessage(`[Companion] Recipe sync failed: ${err.message}`, 'error');
+      }
+    }
+  });
+
+  calibrateBtn?.addEventListener('click', () => {
+    if (!state.companion.connected) {
+      logMessage(`[Companion] Please connect to desktop helper first or enable Demo Mode.`, 'warn');
+      return;
+    }
+    logMessage(`[Companion] Zeroing Acaia Lunar scale tare...`, 'info');
+    state.companion.scaleWeight = 0.0;
+    updateCompanionUI();
+    setTimeout(() => {
+      logMessage(`[Companion] Scale tared to 0.00g. Burr zero-point calibrated.`, 'success');
+    }, 700);
+  });
+
+  grindSlider?.addEventListener('input', (e) => {
+    const val = e.target.value;
+    const valDisplay = document.getElementById('grind-val');
+    if (valDisplay) valDisplay.textContent = `${val} µm`;
+  });
+
+  disconnectBtn?.addEventListener('click', () => {
+    state.companion.connected = false;
+    state.companion.status = 'offline';
+    logMessage(`[Companion] Disconnected from desktop brewing helper.`, 'info');
+    updateCompanionUI();
+  });
+}
+
+function setupLogControls() {
+  const clearBtn = document.getElementById('clear-log-btn');
+  clearBtn?.addEventListener('click', () => {
+    const logConsole = document.getElementById('equipment-log');
+    if (logConsole) {
+      logConsole.innerHTML = '<div class="log-entry log-info"><span class="log-time">[' + new Date().toLocaleTimeString() + ']</span> <span class="log-text">Log cleared. Ready for equipment events.</span></div>';
+    }
+  });
+}
+
+function updateBrewerUI() {
+  const statusEl = document.getElementById('brewer-status');
+  const tempEl = document.getElementById('brewer-temp');
+  const pressureEl = document.getElementById('brewer-pressure');
+  const waterEl = document.getElementById('brewer-water');
+  const waterBar = document.getElementById('brewer-water-bar');
+  const controlsDiv = document.getElementById('brewer-active-controls');
+  const timerBadge = document.getElementById('brewer-timer-badge');
+
+  if (statusEl) {
+    statusEl.textContent = state.brewer.status.toUpperCase();
+    statusEl.className = `status-pill status-${state.brewer.status}`;
+  }
+  if (tempEl) tempEl.textContent = `${state.brewer.temp.toFixed(1)} °C`;
+  if (pressureEl) pressureEl.textContent = `${state.brewer.pressure.toFixed(1)} bar`;
+  if (waterEl) waterEl.textContent = `${state.brewer.waterLevel}%`;
+  if (waterBar) waterBar.style.width = `${state.brewer.waterLevel}%`;
+
+  if (controlsDiv) {
+    controlsDiv.style.opacity = state.brewer.connected ? '1' : '0.5';
+    controlsDiv.style.pointerEvents = state.brewer.connected ? 'auto' : 'none';
+  }
+
+  if (timerBadge) {
+    if (state.brewer.status === 'brewing') {
+      timerBadge.hidden = false;
+      timerBadge.textContent = `Extracting: ${state.brewer.brewSeconds}s / 28s`;
+    } else {
+      timerBadge.hidden = true;
+    }
+  }
+}
+
+function updateCompanionUI() {
+  const statusEl = document.getElementById('companion-status');
+  const versionEl = document.getElementById('companion-version');
+  const scaleEl = document.getElementById('companion-scale');
+  const weightEl = document.getElementById('companion-weight');
+  const controlsDiv = document.getElementById('companion-active-controls');
+
+  if (statusEl) {
+    statusEl.textContent = state.companion.connected ? 'CONNECTED' : 'OFFLINE';
+    statusEl.className = `status-pill status-${state.companion.connected ? 'ready' : 'idle'}`;
+  }
+  if (versionEl) versionEl.textContent = state.companion.daemonVersion;
+  if (scaleEl) scaleEl.textContent = state.companion.scaleName;
+  if (weightEl) weightEl.textContent = `${state.companion.scaleWeight.toFixed(1)} g`;
+
+  if (controlsDiv) {
+    controlsDiv.style.opacity = state.companion.connected ? '1' : '0.5';
+    controlsDiv.style.pointerEvents = state.companion.connected ? 'auto' : 'none';
+  }
+}
+
+function alertDeviceOffline(deviceType, url) {
+  const name = deviceType === 'brewer' ? 'Wi-Fi Coffee Brewer' : 'Desktop Helper Daemon';
+  const suggestion = deviceType === 'brewer'
+    ? 'Ensure your device is connected to the shop Wi-Fi (192.168.1.x) and the brewer server is listening.'
+    : 'Ensure your helper daemon is running on 127.0.0.1:45678.';
+
+  const logConsole = document.getElementById('equipment-log');
+  if (logConsole) {
+    const alertBox = document.createElement('div');
+    alertBox.className = 'log-entry log-warn';
+    alertBox.innerHTML = `<strong>⚠️ ${name} unreachable at ${escapeHtml(url)}</strong><br>${suggestion}<br>Tip: Use <em>Demo Mode</em> to interact with the full telemetry UI immediately.`;
+    logConsole.appendChild(alertBox);
+    logConsole.scrollTop = logConsole.scrollHeight;
+  }
+}
+
+// Auto initialize when DOM is ready
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', initEquipmentPanel);
+} else {
+  initEquipmentPanel();
+}
