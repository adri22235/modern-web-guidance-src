diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..ac07bd6
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,607 @@
+// On-device Translation Utility using the built-in Translator API
+// Follows modern web platform guidance:
+// - Exclusively uses global `self.Translator` (never deprecated `window.ai.translator`)
+// - Identical options passed to availability() and create()
+// - Model download progress monitoring via monitor(m) and 'downloadprogress' event
+// - User gesture handling for downloadable/downloading states
+
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+  nativeName: string;
+  flag: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'en', name: 'English (Original)', nativeName: 'English', flag: '🇺🇸' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español', flag: '🇪🇸' },
+  { code: 'fr', name: 'French', nativeName: 'Français', flag: '🇫🇷' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch', flag: '🇩🇪' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語', flag: '🇯🇵' },
+  { code: 'zh', name: 'Chinese (Simplified)', nativeName: '简体中文', flag: '🇨🇳' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)', nativeName: '繁體中文', flag: '🇹🇼' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português', flag: '🇵🇹' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano', flag: '🇮🇹' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी', flag: '🇮🇳' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어', flag: '🇰🇷' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands', flag: '🇳🇱' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский', flag: '🇷🇺' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية', flag: '🇸🇦' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe', flag: '🇹🇷' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski', flag: '🇵🇱' },
+  { code: 'uk', name: 'Ukrainian', nativeName: 'Українська', flag: '🇺🇦' },
+  { code: 'vi', name: 'Vietnamese', nativeName: 'Tiếng Việt', flag: '🇻🇳' },
+];
+
+export type TranslationStatus =
+  | 'idle'
+  | 'checking'
+  | 'ready'
+  | 'downloadable'
+  | 'downloading'
+  | 'translating'
+  | 'translated'
+  | 'error'
+  | 'unsupported';
+
+export interface TranslationState {
+  isSupported: boolean;
+  targetLanguage: string;
+  sourceLanguage: string;
+  status: TranslationStatus;
+  progress: number; // 0 to 100
+  statusMessage: string;
+  translatedCount: number;
+}
+
+// Global in-memory cache for translator instances
+const translatorInstances = new Map<string, any>();
+const translatedCache = new Map<string, string>();
+
+// Reactive state and subscribers
+let currentState: TranslationState = {
+  isSupported: typeof self !== 'undefined' && 'Translator' in self,
+  targetLanguage: 'es',
+  sourceLanguage: 'en',
+  status: 'idle',
+  progress: 0,
+  statusMessage: '',
+  translatedCount: 0,
+};
+
+const listeners = new Set<(state: TranslationState) => void>();
+
+export function getTranslationState(): TranslationState {
+  if (typeof self !== 'undefined') {
+    currentState.isSupported = 'Translator' in self;
+  }
+  return { ...currentState };
+}
+
+export function updateTranslationState(partial: Partial<TranslationState>) {
+  currentState = { ...currentState, ...partial };
+  listeners.forEach((listener) => {
+    try {
+      listener({ ...currentState });
+    } catch (e) {
+      console.error('Translation listener error:', e);
+    }
+  });
+}
+
+export function subscribeTranslationState(listener: (state: TranslationState) => void): () => void {
+  listeners.add(listener);
+  listener({ ...currentState });
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/**
+ * Check if the built-in on-device Translator API is supported in the current browser.
+ * Mandated: check `Translator in self`, never use deprecated `window.ai.translator`.
+ */
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+/**
+ * Checks model availability for a given language pair.
+ * Mandated: pass identical configuration options object containing sourceLanguage and targetLanguage
+ * to both Translator.availability(options) and Translator.create(options).
+ */
+export async function checkLanguagePairAvailability(
+  targetLanguage: string,
+  sourceLanguage: string = 'en'
+): Promise<'available' | 'downloadable' | 'downloading' | 'unavailable'> {
+  if (!isTranslatorSupported()) {
+    return 'unavailable';
+  }
+
+  try {
+    const options = {
+      sourceLanguage,
+      targetLanguage,
+    };
+    const availability = await (self as any).Translator.availability(options);
+    return availability;
+  } catch (err) {
+    console.warn('Error checking Translator availability:', err);
+    return 'unavailable';
+  }
+}
+
+/**
+ * Obtains or creates an on-device Translator instance with download progress monitoring.
+ * Must be triggered by user gesture if availability was 'downloadable' or 'downloading'.
+ */
+export async function getOrCreateTranslator(
+  targetLanguage: string,
+  sourceLanguage: string = 'en',
+  onProgress?: (progressPercent: number) => void
+): Promise<any | null> {
+  if (!isTranslatorSupported()) {
+    return null;
+  }
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+  if (translatorInstances.has(cacheKey)) {
+    return translatorInstances.get(cacheKey);
+  }
+
+  const options: any = {
+    sourceLanguage,
+    targetLanguage,
+  };
+
+  options.monitor = (m: any) => {
+    m.addEventListener('downloadprogress', (e: any) => {
+      const percent = Math.round((e.loaded ?? 0) * 100);
+      updateTranslationState({
+        status: 'downloading',
+        progress: percent,
+        statusMessage: `Downloading on-device language pack (${percent}%)...`,
+      });
+      onProgress?.(percent);
+    });
+  };
+
+  try {
+    const translator = await (self as any).Translator.create(options);
+    translatorInstances.set(cacheKey, translator);
+    return translator;
+  } catch (err) {
+    console.error('Failed to create Translator instance:', err);
+    throw err;
+  }
+}
+
+/**
+ * Translates a single text string using the on-device model or fallback.
+ */
+export async function translateString(
+  text: string,
+  targetLanguage: string,
+  sourceLanguage: string = 'en',
+  onProgress?: (progressPercent: number) => void
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed || targetLanguage === sourceLanguage) {
+    return text;
+  }
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}::${trimmed}`;
+  if (translatedCache.has(cacheKey)) {
+    return translatedCache.get(cacheKey)!;
+  }
+
+  if (isTranslatorSupported()) {
+    try {
+      const translator = await getOrCreateTranslator(targetLanguage, sourceLanguage, onProgress);
+      if (translator) {
+        const result = await translator.translate(trimmed);
+        translatedCache.set(cacheKey, result);
+        return result;
+      }
+    } catch (e) {
+      console.warn('On-device translation failed, using fallback:', e);
+    }
+  }
+
+  // Graceful fallback for browsers or environments without Chrome 138+ on-device Gemini Nano
+  const fallback = getFallbackTranslation(trimmed, targetLanguage);
+  translatedCache.set(cacheKey, fallback);
+  return fallback;
+}
+
+/**
+ * Translates all translatable DOM elements inside a container element.
+ * Preserves original text in dataset.originalText so it can be restored anytime.
+ */
+export async function translateElementTree(
+  container: HTMLElement,
+  targetLanguage: string,
+  sourceLanguage: string = 'en'
+): Promise<number> {
+  if (targetLanguage === sourceLanguage) {
+    restoreElementTree(container);
+    return 0;
+  }
+
+  // Select all translatable text nodes / elements
+  // We exclude script, style, pre, code, svg, and anything marked [data-no-translate]
+  const selector = [
+    '[data-translate-title]',
+    '[data-translate-summary]',
+    '[data-translate-caption]',
+    '[data-translate-body] p',
+    '[data-translate-body] h1',
+    '[data-translate-body] h2',
+    '[data-translate-body] h3',
+    '[data-translate-body] h4',
+    '[data-translate-body] h5',
+    '[data-translate-body] h6',
+    '[data-translate-body] li',
+    '[data-translate-body] blockquote',
+  ].join(', ');
+
+  const elements = Array.from(container.querySelectorAll<HTMLElement>(selector));
+
+  // If container itself has a translate attribute
+  if (
+    container.hasAttribute('data-translate-title') ||
+    container.hasAttribute('data-translate-summary') ||
+    container.hasAttribute('data-translate-caption')
+  ) {
+    elements.unshift(container);
+  }
+
+  let count = 0;
+  for (const el of elements) {
+    // Avoid translating code blocks or scripts inside
+    if (el.closest('pre') || el.closest('code') || el.closest('[data-no-translate]')) {
+      continue;
+    }
+
+    // Save original text if not already saved
+    if (!el.dataset.originalText) {
+      el.dataset.originalText = el.textContent || '';
+    }
+
+    const sourceText = el.dataset.originalText;
+    if (!sourceText.trim()) continue;
+
+    try {
+      const translated = await translateString(sourceText, targetLanguage, sourceLanguage);
+      el.textContent = translated;
+      el.setAttribute('data-translated', 'true');
+      el.setAttribute('lang', targetLanguage);
+      count++;
+    } catch (err) {
+      console.error('Error translating element:', err);
+    }
+  }
+
+  return count;
+}
+
+/**
+ * Restores original text to all translated elements in a container.
+ */
+export function restoreElementTree(container: HTMLElement): number {
+  const elements = Array.from(container.querySelectorAll<HTMLElement>('[data-translated="true"]'));
+  if (container.hasAttribute('data-translated')) {
+    elements.unshift(container);
+  }
+
+  let restored = 0;
+  for (const el of elements) {
+    if (el.dataset.originalText !== undefined) {
+      el.textContent = el.dataset.originalText;
+      delete el.dataset.originalText;
+    }
+    el.removeAttribute('data-translated');
+    el.removeAttribute('lang');
+    restored++;
+  }
+  return restored;
+}
+
+/**
+ * Translates a single teaser by its article ID or container element.
+ */
+export async function translateTeaser(
+  articleId: string,
+  targetLanguage: string
+): Promise<boolean> {
+  const teaserEl = document.querySelector<HTMLElement>(`[data-article-id="${articleId}"]`);
+  if (!teaserEl) return false;
+
+  if (targetLanguage === 'en') {
+    restoreTeaser(articleId);
+    return true;
+  }
+
+  await translateElementTree(teaserEl, targetLanguage, 'en');
+  teaserEl.setAttribute('data-teaser-translated-lang', targetLanguage);
+  return true;
+}
+
+/**
+ * Restores a teaser back to original English.
+ */
+export function restoreTeaser(articleId: string): boolean {
+  const teaserEl = document.querySelector<HTMLElement>(`[data-article-id="${articleId}"]`);
+  if (!teaserEl) return false;
+
+  restoreElementTree(teaserEl);
+  teaserEl.removeAttribute('data-teaser-translated-lang');
+  return true;
+}
+
+/**
+ * Checks if a specific teaser is currently translated.
+ */
+export function isTeaserTranslated(articleId: string): boolean {
+  const teaserEl = document.querySelector<HTMLElement>(`[data-article-id="${articleId}"]`);
+  return Boolean(teaserEl?.hasAttribute('data-teaser-translated-lang'));
+}
+
+/**
+ * Translates the current page (all teasers and article content if present).
+ */
+export async function translatePage(targetLanguage: string): Promise<number> {
+  if (targetLanguage === 'en') {
+    return restorePage();
+  }
+
+  updateTranslationState({
+    targetLanguage,
+    status: 'checking',
+    statusMessage: `Checking translation model for ${getLanguageName(targetLanguage)}...`,
+    progress: 10,
+  });
+
+  try {
+    if (isTranslatorSupported()) {
+      const avail = await checkLanguagePairAvailability(targetLanguage, 'en');
+      if (avail === 'downloadable' || avail === 'downloading') {
+        updateTranslationState({
+          status: 'downloading',
+          statusMessage: `Downloading on-device ${getLanguageName(targetLanguage)} language pack...`,
+          progress: 25,
+        });
+      } else if (avail === 'unavailable') {
+        updateTranslationState({
+          status: 'unsupported',
+          statusMessage: `Language pair English -> ${getLanguageName(targetLanguage)} unavailable on this device. Using preview fallback.`,
+        });
+      }
+    }
+
+    updateTranslationState({
+      status: 'translating',
+      statusMessage: `Translating page to ${getLanguageName(targetLanguage)}...`,
+      progress: 50,
+    });
+
+    // 1. Check for article page
+    const articleContainer = document.querySelector<HTMLElement>('#article-content, [data-article-content]');
+    let totalTranslated = 0;
+
+    if (articleContainer) {
+      const count = await translateElementTree(articleContainer, targetLanguage, 'en');
+      totalTranslated += count;
+    }
+
+    // 2. Check for all teasers
+    const teasers = Array.from(document.querySelectorAll<HTMLElement>('[data-article-id]'));
+    for (const teaser of teasers) {
+      await translateElementTree(teaser, targetLanguage, 'en');
+      teaser.setAttribute('data-teaser-translated-lang', targetLanguage);
+      totalTranslated++;
+    }
+
+    updateTranslationState({
+      status: 'translated',
+      statusMessage: `Translated to ${getLanguageName(targetLanguage)} (${totalTranslated} elements)`,
+      progress: 100,
+      translatedCount: totalTranslated,
+    });
+
+    return totalTranslated;
+  } catch (error: any) {
+    updateTranslationState({
+      status: 'error',
+      statusMessage: error?.message || 'Translation failed',
+      progress: 0,
+    });
+    return 0;
+  }
+}
+
+/**
+ * Restores the entire page to original English.
+ */
+export function restorePage(): number {
+  let restored = 0;
+
+  const articleContainer = document.querySelector<HTMLElement>('#article-content, [data-article-content]');
+  if (articleContainer) {
+    restored += restoreElementTree(articleContainer);
+  }
+
+  const teasers = Array.from(document.querySelectorAll<HTMLElement>('[data-article-id]'));
+  for (const teaser of teasers) {
+    restored += restoreElementTree(teaser);
+    teaser.removeAttribute('data-teaser-translated-lang');
+  }
+
+  updateTranslationState({
+    targetLanguage: 'en',
+    status: 'idle',
+    statusMessage: 'Original English restored',
+    progress: 0,
+    translatedCount: 0,
+  });
+
+  return restored;
+}
+
+export function getLanguageName(code: string): string {
+  const lang = SUPPORTED_LANGUAGES.find((l) => l.code === code);
+  return lang ? lang.name : code;
+}
