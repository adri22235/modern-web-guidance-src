+interface TranslationDownloadProgressEvent extends Event {
+  loaded: number;
+  total?: number;
+}
+
+interface TranslationDownloadMonitor extends EventTarget {
+  addEventListener(
+    type: 'downloadprogress',
+    listener: (event: TranslationDownloadProgressEvent) => void,
+    options?: boolean | AddEventListenerOptions
+  ): void;
+  removeEventListener(
+    type: 'downloadprogress',
+    listener: (event: TranslationDownloadProgressEvent) => void,
+    options?: boolean | EventListenerOptions
+  ): void;
+}
+
+interface TranslatorOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+  monitor?: (monitor: TranslationDownloadMonitor) => void;
+}
+
+interface TranslatorInstance {
+  translate(input: string): Promise<string>;
+  translateStreaming(input: string): AsyncIterable<string>;
+  destroy?(): void;
+}
+
+interface TranslatorAPI {
+  availability(options: TranslatorOptions): Promise<'available' | 'downloadable' | 'downloading' | 'unavailable'>;
+  create(options: TranslatorOptions): Promise<TranslatorInstance>;
+}
