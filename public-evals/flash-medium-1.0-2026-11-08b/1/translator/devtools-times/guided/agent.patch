diff --git a/src/components/HeaderTranslationControl.tsx b/src/components/HeaderTranslationControl.tsx
new file mode 100644
index 0000000..7391cce
--- /dev/null
+++ b/src/components/HeaderTranslationControl.tsx
@@ -0,0 +1,189 @@
+import React, { useState, useEffect } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  translatePage,
+  restorePage,
+  subscribeTranslationState,
+  updateTranslationState,
+  isTranslatorSupported,
+  checkLanguagePairAvailability,
+  getOrCreateTranslator,
+  getLanguageName,
+} from '../utils/translator';
+import { LanguageIcon, ArrowPathIcon, CheckCircleIcon, SparklesIcon } from '@heroicons/react/24/outline';
+
+export default function HeaderTranslationControl() {
+  const [targetLang, setTargetLang] = useState('es');
+  const [status, setStatus] = useState<string>('idle');
+  const [progress, setProgress] = useState<number>(0);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [hasOnDeviceApi, setHasOnDeviceApi] = useState<boolean>(false);
+  const [isOpen, setIsOpen] = useState(false);
+
+  useEffect(() => {
+    setHasOnDeviceApi(isTranslatorSupported());
+
+    const unsubscribe = subscribeTranslationState((state) => {
+      setTargetLang(state.targetLanguage);
+      setStatus(state.status);
+      setProgress(state.progress);
+      setStatusMessage(state.statusMessage);
+      setHasOnDeviceApi(state.isSupported);
+    });
+
+    return () => unsubscribe();
+  }, []);
+
+  const handleLanguageSelect = (code: string) => {
+    setTargetLang(code);
+    updateTranslationState({ targetLanguage: code });
+    setIsOpen(false);
+  };
+
+  const handleTranslateClick = async () => {
+    if (status === 'downloading' || status === 'translating') return;
+
+    if (targetLang === 'en') {
+      restorePage();
+      return;
+    }
+
+    // Modern Web Guidance User Gesture Requirement:
+    // If the language pair is downloadable or downloading, initiating create() strictly requires a user gesture.
+    // Triggering here directly inside the click event fulfills this requirement.
+    if (isTranslatorSupported()) {
+      try {
+        const avail = await checkLanguagePairAvailability(targetLang, 'en');
+        if (avail === 'downloadable' || avail === 'downloading') {
+          updateTranslationState({
+            status: 'downloading',
+            progress: 1,
+            statusMessage: `Downloading ${getLanguageName(targetLang)} on-device model...`,
+          });
+          await getOrCreateTranslator(targetLang, 'en', (loadedPercent) => {
+            setProgress(loadedPercent);
+          });
+        }
+      } catch (e) {
+        console.warn('Pre-warming language model:', e);
+      }
+    }
+
+    await translatePage(targetLang);
+  };
+
+  const handleResetClick = () => {
+    restorePage();
+  };
+
+  const selectedLanguage = SUPPORTED_LANGUAGES.find((l) => l.code === targetLang) || SUPPORTED_LANGUAGES[1];
+  const isTranslated = status === 'translated' && targetLang !== 'en';
+  const isBusy = status === 'downloading' || status === 'translating' || status === 'checking';
+
+  return (
+    <div className="relative inline-flex items-center text-xs">
+      <div className="flex items-center bg-gray-50 border border-gray-300 rounded-lg p-1 shadow-2xs space-x-1.5">
+        {/* On-device AI indicator pill */}
+        <div
+          className="hidden sm:flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-100 text-amber-900"
+          title={
+            hasOnDeviceApi
+              ? 'On-Device Translation: Powered by Built-in AI (Gemini Nano in Chrome/Edge)'
+              : 'On-device built-in AI Translator requires Chrome 138+ or Edge 148+. Running fallback preview.'
+          }
+        >
+          <SparklesIcon className="w-3 h-3 mr-1 text-amber-600" />
+          <span>{hasOnDeviceApi ? 'On-Device AI' : 'AI Translate'}</span>
+        </div>
+
+        {/* Language selector toggle */}
+        <div className="relative">
+          <button
+            type="button"
+            onClick={() => setIsOpen(!isOpen)}
+            className="flex items-center space-x-1 px-2 py-1 bg-white border border-gray-200 rounded hover:bg-gray-50 text-gray-800 font-medium transition"
+            aria-haspopup="listbox"
+            aria-expanded={isOpen}
+          >
+            <span className="text-sm leading-none">{selectedLanguage.flag}</span>
+            <span className="max-w-[70px] sm:max-w-none truncate">{selectedLanguage.name.split(' ')[0]}</span>
+            <svg
+              className="w-3 h-3 text-gray-400"
+              fill="none"
+              stroke="currentColor"
+              viewBox="0 0 24 24"
+            >
+              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
+            </svg>
+          </button>
+
+          {/* Dropdown Menu */}
+          {isOpen && (
+            <div className="absolute left-0 mt-1 w-48 bg-white border border-gray-200 rounded-md shadow-lg z-50 py-1 max-h-60 overflow-y-auto">
+              <div className="px-3 py-1 text-[10px] font-semibold text-gray-400 uppercase tracking-wider border-b border-gray-100">
+                Select Language
+              </div>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <button
+                  key={lang.code}
+                  type="button"
+                  onClick={() => handleLanguageSelect(lang.code)}
+                  className={`w-full text-left px-3 py-1.5 flex items-center space-x-2 text-xs hover:bg-amber-50 transition-colors ${
+                    targetLang === lang.code ? 'bg-amber-100 text-amber-900 font-semibold' : 'text-gray-700'
+                  }`}
+                >
+                  <span>{lang.flag}</span>
+                  <span className="flex-1">{lang.name}</span>
+                  {targetLang === lang.code && <CheckCircleIcon className="w-4 h-4 text-amber-600" />}
+                </button>
+              ))}
+            </div>
+          )}
+        </div>
+
+        {/* Action Button: Translate or Reset */}
+        {isTranslated ? (
+          <button
+            type="button"
+            onClick={handleResetClick}
+            className="px-2.5 py-1 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded font-medium flex items-center space-x-1 transition"
+            title="Restore original English text"
+          >
+            <span>Original</span>
+          </button>
+        ) : (
+          <button
+            type="button"
+            onClick={handleTranslateClick}
+            disabled={isBusy}
+            className="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white rounded font-medium flex items-center space-x-1 transition disabled:opacity-50"
+            title={`Translate page articles & teasers to ${selectedLanguage.name}`}
+          >
+            {isBusy ? (
+              <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+            ) : (
+              <LanguageIcon className="w-3.5 h-3.5" />
+            )}
+            <span>{isBusy ? 'Translating...' : 'Translate'}</span>
+          </button>
+        )}
+      </div>
+
+      {/* Progress / Status banner if downloading model or translating */}
+      {isBusy && (
+        <div className="absolute top-full left-0 mt-1 w-64 bg-white border border-gray-200 rounded p-2 shadow-md z-40">
+          <div className="text-[11px] font-medium text-gray-700 mb-1 flex justify-between items-center">
+            <span className="truncate">{statusMessage || 'Translating...'}</span>
+            {status === 'downloading' && <span>{progress}%</span>}
+          </div>
+          <div className="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 transition-all duration-300"
+              style={{ width: `${Math.max(5, progress)}%` }}
+            ></div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/TeaserTranslateButton.tsx b/src/components/TeaserTranslateButton.tsx
new file mode 100644
index 0000000..8cc60a0
--- /dev/null
+++ b/src/components/TeaserTranslateButton.tsx
@@ -0,0 +1,103 @@
+import React, { useState, useEffect } from 'react';
+import {
+  translateTeaser,
+  restoreTeaser,
+  isTeaserTranslated,
+  subscribeTranslationState,
+  getTranslationState,
+  getLanguageName,
+} from '../utils/translator';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  articleId: string;
+}
+
+export default function TeaserTranslateButton({ articleId }: Props) {
+  const [isTranslated, setIsTranslated] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [targetLang, setTargetLang] = useState('es');
+
+  useEffect(() => {
+    // Check initial state
+    setIsTranslated(isTeaserTranslated(articleId));
+
+    // Subscribe to global translation state changes
+    const unsubscribe = subscribeTranslationState((state) => {
+      setTargetLang(state.targetLanguage);
+      setIsTranslated(isTeaserTranslated(articleId));
+    });
+
+    return () => {
+      unsubscribe();
+    };
+  }, [articleId]);
+
+  const handleToggle = async (e: React.MouseEvent) => {
+    e.preventDefault();
+    e.stopPropagation();
+
+    if (loading) return;
+
+    setLoading(true);
+    try {
+      if (isTranslated) {
+        restoreTeaser(articleId);
+        setIsTranslated(false);
+      } else {
+        const langToUse = targetLang === 'en' ? 'es' : targetLang;
+        await translateTeaser(articleId, langToUse);
+        setIsTranslated(true);
+      }
+    } catch (err) {
+      console.error('Failed to translate teaser:', err);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const titleTooltip = isTranslated
+    ? 'Restore original English teaser'
+    : `Translate teaser to ${getLanguageName(targetLang === 'en' ? 'es' : targetLang)} (on-device)`;
+
+  return (
+    <button
+      onClick={handleToggle}
+      className={`p-1 rounded transition-colors flex items-center justify-center ${
+        isTranslated
+          ? 'text-amber-600 bg-amber-50 hover:bg-amber-100'
+          : 'text-gray-400 hover:text-gray-700 hover:bg-gray-100'
+      }`}
+      title={titleTooltip}
+      aria-label={titleTooltip}
+      disabled={loading}
+    >
+      {loading ? (
+        <svg
+          className="animate-spin h-5 w-5 text-amber-500"
+          xmlns="http://www.w3.org/2000/svg"
+          fill="none"
+          viewBox="0 0 24 24"
+        >
+          <circle
+            className="opacity-25"
+            cx="12"
+            cy="12"
+            r="10"
+            stroke="currentColor"
+            strokeWidth="4"
+          ></circle>
+          <path
+            className="opacity-75"
+            fill="currentColor"
+            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
+          ></path>
+        </svg>
+      ) : (
+        <LanguageIcon
+          className={`h-5 w-5 ${isTranslated ? 'text-amber-600' : 'text-gray-400'}`}
+        />
+      )}
+    </button>
+  );
+}
