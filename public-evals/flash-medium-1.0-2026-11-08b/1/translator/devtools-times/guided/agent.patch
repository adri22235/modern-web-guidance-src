+function getFallbackTranslation(text: string, targetLang: string): string {
+  const dict = DICTIONARY[targetLang];
+  if (dict && dict[text]) {
+    return dict[text];
+  }
+
+  // Language prefixes for simulated fallback in demo mode
+  const prefixes: Record<string, string> = {
+    es: ' [ES] ',
+    fr: ' [FR] ',
+    de: ' [DE] ',
+    ja: '【翻訳】',
+    zh: '【译】',
+    it: ' [IT] ',
+    pt: ' [PT] ',
+    hi: ' [HI] ',
+    ko: ' [KO] ',
+    nl: ' [NL] ',
+    ru: ' [RU] ',
+    ar: ' [AR] ',
+  };
+
+  const prefix = prefixes[targetLang] || ` [${targetLang.toUpperCase()}] `;
+  // Replace common English words if available
+  let translated = text;
+  if (dict) {
+    for (const [enWord, transWord] of Object.entries(dict)) {
+      if (translated.includes(enWord)) {
+        translated = translated.split(enWord).join(transWord);
+      }
+    }
+  }
+
+  if (translated !== text) {
+    return translated;
+  }
+
+  return `${prefix}${text}`;
+}
