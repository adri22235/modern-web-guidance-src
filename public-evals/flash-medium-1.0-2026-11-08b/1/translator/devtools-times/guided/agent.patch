diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..55c30b2
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,224 @@
+import React, { useState, useEffect } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  translatePage,
+  restorePage,
+  subscribeTranslationState,
+  updateTranslationState,
+  isTranslatorSupported,
+  checkLanguagePairAvailability,
+  getOrCreateTranslator,
+  getLanguageName,
+} from '../utils/translator';
+import {
+  LanguageIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  ShieldCheckIcon,
+  InformationCircleIcon,
+  ArrowRightIcon,
+} from '@heroicons/react/24/outline';
+
+export default function ArticleTranslationControl() {
+  const [targetLang, setTargetLang] = useState('es');
+  const [sourceLang] = useState('en');
+  const [status, setStatus] = useState<string>('idle');
+  const [progress, setProgress] = useState<number>(0);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [hasOnDeviceApi, setHasOnDeviceApi] = useState<boolean>(false);
+  const [modelAvailability, setModelAvailability] = useState<string>('checking');
+
+  useEffect(() => {
+    const supported = isTranslatorSupported();
+    setHasOnDeviceApi(supported);
+
+    if (supported) {
+      checkLanguagePairAvailability(targetLang, sourceLang).then((avail) => {
+        setModelAvailability(avail);
+      });
+    } else {
+      setModelAvailability('unsupported');
+    }
+
+    const unsubscribe = subscribeTranslationState((state) => {
+      setTargetLang(state.targetLanguage);
+      setStatus(state.status);
+      setProgress(state.progress);
+      setStatusMessage(state.statusMessage);
+      setHasOnDeviceApi(state.isSupported);
+    });
+
+    return () => unsubscribe();
+  }, []);
+
+  const handleLanguageChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newLang = e.target.value;
+    setTargetLang(newLang);
+    updateTranslationState({ targetLanguage: newLang });
+
+    if (isTranslatorSupported()) {
+      const avail = await checkLanguagePairAvailability(newLang, sourceLang);
+      setModelAvailability(avail);
+    }
+  };
+
+  const handleTranslate = async () => {
+    if (status === 'downloading' || status === 'translating') return;
+
+    if (targetLang === 'en') {
+      restorePage();
+      return;
+    }
+
+    // Modern Web Guidance User Gesture Requirement:
+    // If the language pair is downloadable or downloading, initiating create() strictly requires a user gesture.
+    if (isTranslatorSupported()) {
+      try {
+        const avail = await checkLanguagePairAvailability(targetLang, sourceLang);
+        if (avail === 'downloadable' || avail === 'downloading') {
+          updateTranslationState({
+            status: 'downloading',
+            progress: 1,
+            statusMessage: `Downloading ${getLanguageName(targetLang)} on-device model...`,
+          });
+          await getOrCreateTranslator(targetLang, sourceLang, (percent) => {
+            setProgress(percent);
+          });
+        }
+      } catch (err) {
+        console.warn('Error during on-device model initialization:', err);
+      }
+    }
+
+    await translatePage(targetLang);
+  };
+
+  const handleRestore = () => {
+    restorePage();
+  };
+
+  const isTranslated = status === 'translated' && targetLang !== 'en';
+  const isBusy = status === 'downloading' || status === 'translating' || status === 'checking';
+  const currentLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === targetLang) || SUPPORTED_LANGUAGES[1];
+
+  return (
+    <div className="bg-gradient-to-r from-amber-50/70 to-orange-50/50 border border-amber-200/80 rounded-xl p-4 my-6 shadow-xs font-sans">
+      <div className="flex flex-col md:flex-row md:items-center justify-between gap-3">
+        {/* Left: Title & Info */}
+        <div className="flex items-start space-x-3">
+          <div className="p-2 bg-amber-500 text-white rounded-lg shadow-2xs mt-0.5">
+            <LanguageIcon className="w-5 h-5" />
+          </div>
+          <div>
+            <div className="flex items-center space-x-2">
+              <h2 className="text-sm font-bold text-gray-900 tracking-tight">
+                On-Device Article Translation
+              </h2>
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-100 text-amber-800 border border-amber-300/60">
+                <ShieldCheckIcon className="w-3.5 h-3.5 mr-1 text-amber-600" />
+                {hasOnDeviceApi ? 'Gemini Nano (Local AI)' : 'Preview Mode'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-600 mt-0.5">
+              {hasOnDeviceApi
+                ? 'Translate this article instantly and privately inside your browser without sending text to the cloud.'
+                : 'Built-in Translator API is available in Chrome 138+ & Edge 148+. Running in client fallback mode.'}
+            </p>
+          </div>
+        </div>
+
+        {/* Right: Controls */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source indicator */}
+          <div className="flex items-center space-x-1 text-xs text-gray-500 font-medium bg-white/80 border border-gray-200 px-2 py-1.5 rounded-lg">
+            <span>🇺🇸</span>
+            <span>EN</span>
+            <ArrowRightIcon className="w-3 h-3 text-gray-400" />
+          </div>
+
+          {/* Target language selector */}
+          <div className="relative">
+            <select
+              value={targetLang}
+              onChange={handleLanguageChange}
+              disabled={isBusy}
+              className="appearance-none bg-white border border-gray-300 text-gray-900 text-xs font-semibold rounded-lg pl-2.5 pr-8 py-1.5 shadow-2xs hover:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 cursor-pointer disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.filter((l) => l.code !== 'en').map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+            <div className="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
+              <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
+              </svg>
+            </div>
+          </div>
+
+          {/* Buttons */}
+          {isTranslated ? (
+            <button
+              type="button"
+              onClick={handleRestore}
+              className="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 text-gray-800 text-xs font-semibold rounded-lg border border-gray-300 shadow-2xs transition"
+            >
+              Show Original
+            </button>
+          ) : (
+            <button
+              type="button"
+              onClick={handleTranslate}
+              disabled={isBusy}
+              className="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white text-xs font-semibold rounded-lg shadow-2xs transition flex items-center space-x-1.5 disabled:opacity-50 cursor-pointer"
+            >
+              {isBusy ? (
+                <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+              ) : (
+                <LanguageIcon className="w-3.5 h-3.5" />
+              )}
+              <span>{isBusy ? 'Translating...' : `Translate to ${currentLangObj.name.split(' ')[0]}`}</span>
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress & Status Feedback */}
+      {(isBusy || statusMessage || isTranslated) && (
+        <div className="mt-3 pt-2.5 border-t border-amber-200/60 flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-2">
+          <div className="flex items-center space-x-2 text-gray-700">
+            {isBusy && <ArrowPathIcon className="w-3.5 h-3.5 text-amber-600 animate-spin flex-shrink-0" />}
+            {isTranslated && <CheckCircleIcon className="w-4 h-4 text-emerald-600 flex-shrink-0" />}
+            <span className="font-medium text-gray-800">
+              {statusMessage || (isTranslated ? `Article translated to ${currentLangObj.name}` : '')}
+            </span>
+            {hasOnDeviceApi && modelAvailability === 'available' && !isBusy && !isTranslated && (
+              <span className="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[10px] font-medium border border-emerald-200">
+                Model cached on-device
+              </span>
+            )}
+            {hasOnDeviceApi && (modelAvailability === 'downloadable' || modelAvailability === 'downloading') && !isBusy && (
+              <span className="text-amber-800 bg-amber-100 px-2 py-0.5 rounded text-[10px] font-medium">
+                Model download needed (~25MB)
+              </span>
+            )}
+          </div>
+
+          {/* Model download progress bar */}
+          {status === 'downloading' && (
+            <div className="w-full sm:w-48 flex items-center space-x-2">
+              <div className="flex-1 bg-gray-200 rounded-full h-1.5 overflow-hidden">
+                <div
+                  className="bg-amber-500 h-1.5 transition-all duration-300"
+                  style={{ width: `${Math.max(5, progress)}%` }}
+                ></div>
+              </div>
+              <span className="text-[11px] font-semibold text-gray-600 w-8 text-right">{progress}%</span>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
