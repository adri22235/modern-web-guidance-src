+  "The Silent Architects of Earth": {
+    "es": "Los arquitectos silenciosos de la Tierra",
+    "fr": "Les architectes silencieux de la Terre",
+    "de": "Die stillen Baumeister der Erde",
+    "ja": "地球の静かなる建築家たち：植物が育む生命の土台",
+    "zh": "地球的无声筑造者：植物与生命的绿色基石",
