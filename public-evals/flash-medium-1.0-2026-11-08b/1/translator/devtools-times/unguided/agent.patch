+import React, { useState, useEffect } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  detectTranslatorEngine,
+  translateTeasersDOM,
+  restoreTeasersDOM,
+  type TranslatorEngineInfo,
+} from '../utils/translator';
+import { getStoredLanguage, setStoredLanguage, subscribeToLanguageChange } from '../utils/translationStore';
+import { SparklesIcon, LanguageIcon, ArrowPathIcon, CheckIcon } from '@heroicons/react/24/outline';
+
+export default function TeaserTranslationBar() {
+  const [currentLang, setCurrentLang] = useState('en');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [statusMessage, setStatusMessage] = useState('');
+  const [engineInfo, setEngineInfo] = useState<TranslatorEngineInfo>({
+    type: 'on-device-fallback',
+    available: true,
+    name: 'On-Device Engine',
+    description: 'Local In-Browser AI',
+  });
+
+  useEffect(() => {
+    detectTranslatorEngine('en', 'es').then(setEngineInfo);
+    setCurrentLang(getStoredLanguage());
+
+    const unsubscribe = subscribeToLanguageChange((newLang) => {
+      setCurrentLang(newLang);
+    });
+
+    return () => unsubscribe();
+  }, []);
+
+  const handleTranslate = async (langCode: string) => {
+    if (isTranslating) return;
+    setIsTranslating(true);
+    setCurrentLang(langCode);
+    setStoredLanguage(langCode);
+
+    if (langCode === 'en') {
+      restoreTeasersDOM(document);
+      setStatusMessage('Showing original English teasers');
+      setIsTranslating(false);
+      return;
+    }
+
+    setStatusMessage(`Translating news teasers on-device...`);
+
+    try {
+      const res = await translateTeasersDOM(document, langCode, (status) => {
+        setStatusMessage(status.message);
+      });
+
+      const langObj = SUPPORTED_LANGUAGES.find((l) => l.code === langCode);
+      setStatusMessage(`Translated ${res.count} teasers to ${langObj?.nativeName || langCode} (${res.engine})`);
+    } catch (e) {
+      console.error('Teaser translation error:', e);
+      setStatusMessage('Translation error.');
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  const handleRestore = () => {
+    restoreTeasersDOM(document);
+    setCurrentLang('en');
+    setStoredLanguage('en');
+    setStatusMessage('Showing original English teasers');
+  };
+
+  const activeLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];
+
+  return (
+    <div
+      data-translation-control="teasers"
+      className="bg-stone-50 border-y border-gray-200 px-4 py-2.5 my-2 transition-all"
+    >
+      <div className="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2.5">
+        <div className="flex items-center space-x-2">
+          <div className="p-1 bg-amber-100 text-amber-900 rounded">
+            <LanguageIcon className="w-4 h-4" />
+          </div>
+          <span className="text-xs font-semibold text-gray-800">
+            Translate news teasers on-device:
+          </span>
+          <span className="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
+            <SparklesIcon className="w-2.5 h-2.5 mr-0.5 inline" />
+            {engineInfo.name}
+          </span>
+        </div>
+
+        <div className="flex items-center space-x-2">
+          <select
+            aria-label="Select teaser translation language"
+            value={currentLang}
+            onChange={(e) => handleTranslate(e.target.value)}
+            disabled={isTranslating}
+            className="text-xs bg-white border border-gray-300 rounded px-2.5 py-1 text-gray-800 font-medium focus:ring-1 focus:ring-amber-400 focus:outline-hidden cursor-pointer"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.flag} {lang.nativeName} ({lang.name})
+              </option>
+            ))}
+          </select>
+
+          {currentLang !== 'en' && (
+            <button
+              onClick={handleRestore}
+              disabled={isTranslating}
+              className="text-xs text-gray-600 hover:text-amber-800 underline font-medium"
+            >
+              Original
+            </button>
+          )}
+
+          <button
+            onClick={() => handleTranslate(currentLang === 'en' ? 'es' : currentLang)}
+            disabled={isTranslating}
+            className="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded bg-gray-900 text-white hover:bg-gray-800 disabled:opacity-50 transition-colors shadow-2xs"
+          >
+            {isTranslating ? (
+              <>
+                <ArrowPathIcon className="w-3 h-3 mr-1 animate-spin" />
+                Translating...
+              </>
+            ) : currentLang !== 'en' ? (
+              <>
+                <CheckIcon className="w-3 h-3 mr-1 text-emerald-400" />
+                Translated
+              </>
+            ) : (
+              <>
+                <SparklesIcon className="w-3 h-3 mr-1 text-amber-300" />
+                Translate All
+              </>
+            )}
+          </button>
+        </div>
+      </div>
+
+      {statusMessage && (
+        <div className="max-w-6xl mx-auto mt-1 text-[11px] text-gray-500 flex items-center">
+          {isTranslating && <span className="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping mr-1.5 inline-block" />}
+          {statusMessage}
+        </div>
+      )}
+    </div>
+  );
+}
