+import { EXACT_TEXT_MATCHES, COMMON_PHRASES, ARTICLE_TRANSLATIONS } from './translationsData';
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName: string;
+  flag: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English', nativeName: 'English', flag: '🇬🇧' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español', flag: '🇪🇸' },
+  { code: 'fr', name: 'French', nativeName: 'Français', flag: '🇫🇷' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch', flag: '🇩🇪' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語', flag: '🇯🇵' },
+  { code: 'zh', name: 'Chinese', nativeName: '中文', flag: '🇨🇳' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português', flag: '🇵🇹' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano', flag: '🇮🇹' },
+];
+
+export interface TranslatorEngineInfo {
+  type: 'chrome-builtin' | 'on-device-fallback';
+  available: boolean;
+  name: string;
+  description: string;
+}
+
+const textCache = new Map<string, string>();
+const translatorInstances = new Map<string, any>();
+
+/**
+ * Detect available on-device translation capabilities in the current browser.
+ */
+export async function detectTranslatorEngine(sourceLang = 'en', targetLang = 'es'): Promise<TranslatorEngineInfo> {
+  if (typeof window === 'undefined') {
+    return {
+      type: 'on-device-fallback',
+      available: true,
+      name: 'On-Device Engine',
+      description: 'Local In-Browser Translation Engine',
+    };
+  }
+
+  // 1. Check window.Translator (Standard Chrome Translator API with Gemini Nano)
+  if ('Translator' in window && window.Translator?.create) {
+    try {
+      let availability = 'available';
+      if (typeof window.Translator.availability === 'function') {
+        availability = await window.Translator.availability({ sourceLanguage: sourceLang, targetLanguage: targetLang });
+      } else if (typeof window.Translator.canTranslate === 'function') {
+        const can = await window.Translator.canTranslate({ sourceLanguage: sourceLang, targetLanguage: targetLang });
+        availability = can === 'no' ? 'no' : 'available';
+      }
+
+      if (availability !== 'no') {
+        return {
+          type: 'chrome-builtin',
+          available: true,
+          name: 'Chrome Built-in AI',
+          description: 'Gemini Nano On-Device Translator API',
+        };
+      }
+    } catch (e) {
+      console.warn('Translator availability check error:', e);
+    }
+  }
+
+  // 2. Check window.translation (Draft Translation API)
+  if (window.translation && typeof window.translation.createTranslator === 'function') {
+    return {
+      type: 'chrome-builtin',
+      available: true,
+      name: 'Chrome Built-in AI',
+      description: 'Chrome On-Device Translation API',
+    };
+  }
+
+  // 3. Check window.ai?.translator
+  if (window.ai?.translator && typeof window.ai.translator.create === 'function') {
+    return {
+      type: 'chrome-builtin',
+      available: true,
+      name: 'Chrome Built-in AI',
+      description: 'Window AI On-Device Translator',
+    };
+  }
+
+  // 4. Default to local on-device engine
+  return {
+    type: 'on-device-fallback',
+    available: true,
+    name: 'On-Device Engine',
+    description: 'Local In-Browser Translation Engine',
+  };
+}
+
+/**
+ * Acquire or initialize a native Chrome Translator instance if available.
+ */
+async function getChromeTranslator(
+  sourceLang: string,
+  targetLang: string,
+  onProgress?: (progress: { loaded: number; total: number }) => void
+): Promise<any | null> {
+  const pairKey = `${sourceLang}->${targetLang}`;
+  if (translatorInstances.has(pairKey)) {
+    return translatorInstances.get(pairKey);
+  }
+
+  if (typeof window === 'undefined') return null;
+
+  // Pattern 1: window.Translator.create(...)
+  if ('Translator' in window && typeof window.Translator?.create === 'function') {
+    try {
+      const translator = await window.Translator.create({
+        sourceLanguage: sourceLang,
+        targetLanguage: targetLang,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e: any) => {
+            if (onProgress && e.total) {
+              onProgress({ loaded: e.loaded, total: e.total });
+            }
+          });
+        },
+      });
+
+      if (translator.ready) {
+        await translator.ready;
+      }
+
+      translatorInstances.set(pairKey, translator);
+      return translator;
+    } catch (err) {
+      console.warn('Failed to create Translator via window.Translator.create:', err);
+    }
+  }
+
+  // Pattern 2: window.translation.createTranslator(...)
+  if (window.translation && typeof window.translation.createTranslator === 'function') {
+    try {
+      const translator = await window.translation.createTranslator({
+        sourceLanguage: sourceLang,
+        targetLanguage: targetLang,
+      });
+      translatorInstances.set(pairKey, translator);
+      return translator;
+    } catch (err) {
+      console.warn('Failed to create Translator via window.translation:', err);
+    }
+  }
+
+  // Pattern 3: window.ai.translator.create(...)
+  if (window.ai?.translator && typeof window.ai.translator.create === 'function') {
+    try {
+      const translator = await window.ai.translator.create({
+        sourceLanguage: sourceLang,
+        targetLanguage: targetLang,
+      });
+      translatorInstances.set(pairKey, translator);
+      return translator;
+    } catch (err) {
+      console.warn('Failed to create Translator via window.ai.translator:', err);
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Local fallback translator for on-device translation when native AI is not present or pair is unsupported.
+ */
+function fallbackTranslate(text: string, targetLang: string): string {
+  if (!text || targetLang === 'en') return text;
+
+  const trimmed = text.trim();
+
+  // 1. Direct exact match in dataset
+  if (EXACT_TEXT_MATCHES[trimmed]?.[targetLang]) {
+    return EXACT_TEXT_MATCHES[trimmed][targetLang];
+  }
+
+  // 2. Direct phrase match
+  if (COMMON_PHRASES[targetLang]?.[trimmed]) {
+    return COMMON_PHRASES[targetLang][trimmed];
+  }
+
+  // 3. Normalization without trailing punctuation
+  const cleanPunctuation = trimmed.replace(/[.:;!?"“”'’]+$/, '');
+  const trailingPunctuation = trimmed.slice(cleanPunctuation.length);
+  if (EXACT_TEXT_MATCHES[cleanPunctuation]?.[targetLang]) {
+    return EXACT_TEXT_MATCHES[cleanPunctuation][targetLang] + trailingPunctuation;
+  }
+  if (COMMON_PHRASES[targetLang]?.[cleanPunctuation]) {
+    return COMMON_PHRASES[targetLang][cleanPunctuation] + trailingPunctuation;
+  }
+
+  // 4. Case-insensitive lookup
+  for (const [orig, map] of Object.entries(EXACT_TEXT_MATCHES)) {
+    if (orig.toLowerCase() === trimmed.toLowerCase() && map[targetLang]) {
+      return map[targetLang];
+    }
+  }
+  for (const [orig, map] of Object.entries(COMMON_PHRASES[targetLang] || {})) {
+    if (orig.toLowerCase() === trimmed.toLowerCase()) {
+      return map;
+    }
+  }
+
+  // 5. Look for partial phrase replacements
+  let replaced = trimmed;
+  if (COMMON_PHRASES[targetLang]) {
+    for (const [phrase, translated] of Object.entries(COMMON_PHRASES[targetLang])) {
+      if (replaced.includes(phrase)) {
+        replaced = replaced.split(phrase).join(translated);
+      }
+    }
+  }
+
+  return replaced;
+}
+
+/**
+ * Translate a single piece of text directly on-device.
+ */
+export async function translateText(
+  text: string,
+  targetLang: string,
+  sourceLang = 'en',
+  onProgress?: (progress: { loaded: number; total: number }) => void
+): Promise<string> {
+  if (!text || targetLang === sourceLang || targetLang === 'en') {
+    return text;
+  }
+
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  const cacheKey = `${sourceLang}->${targetLang}:${trimmed}`;
+  if (textCache.has(cacheKey)) {
+    return textCache.get(cacheKey)!;
+  }
+
+  // Try native Chrome Translator API
+  if (typeof window !== 'undefined') {
+    try {
+      const translator = await getChromeTranslator(sourceLang, targetLang, onProgress);
+      if (translator && typeof translator.translate === 'function') {
+        const translated = await translator.translate(trimmed);
+        if (translated && translated.trim()) {
+          textCache.set(cacheKey, translated);
+          return translated;
+        }
+      }
+    } catch (e) {
+      console.warn('Native Translator.translate failed, falling back:', e);
+    }
+  }
+
+  // Fallback to local on-device translation
+  const fallback = fallbackTranslate(trimmed, targetLang);
+  textCache.set(cacheKey, fallback);
+  return fallback;
+}
+
+/**
+ * Translate the main article DOM on the article page.
+ */
+export async function translateArticleDOM(
+  articleContainer: HTMLElement,
+  targetLang: string,
+  onStatusUpdate?: (status: { message: string; completed: number; total: number }) => void
+): Promise<{ success: boolean; count: number; engine: string }> {
+  if (!articleContainer) return { success: false, count: 0, engine: '' };
+
+  const engineInfo = await detectTranslatorEngine('en', targetLang);
+
+  if (targetLang === 'en') {
+    restoreArticleDOM(articleContainer);
+    return { success: true, count: 0, engine: engineInfo.name };
+  }
+
+  // Collect translatable elements
+  const elementsToTranslate: HTMLElement[] = [];
+
+  const headline = articleContainer.querySelector<HTMLElement>('[data-translatable="headline"], #article-headline, h1');
+  if (headline) elementsToTranslate.push(headline);
+
+  const summary = articleContainer.querySelector<HTMLElement>('[data-translatable="summary"], #article-summary, article > p.text-lg, article > p.text-xl');
+  if (summary) elementsToTranslate.push(summary);
+
+  const caption = articleContainer.querySelector<HTMLElement>('[data-translatable="caption"], figcaption');
+  if (caption) elementsToTranslate.push(caption);
+
+  const bodyEl = articleContainer.querySelector<HTMLElement>('#article-body, .prose');
+  if (bodyEl) {
+    const bodyParagraphs = bodyEl.querySelectorAll<HTMLElement>('p, h2, h3, h4, li, blockquote');
+    bodyParagraphs.forEach((el) => {
+      // Don't translate code, scripts, or empty elements
+      if (el.closest('script, style, pre, code')) return;
+      if (!el.textContent?.trim()) return;
+      elementsToTranslate.push(el);
+    });
+  }
+
+  const total = elementsToTranslate.length;
+  let completed = 0;
+
+  for (const el of elementsToTranslate) {
+    // Preserve original text if not already saved
+    if (!el.hasAttribute('data-original-text')) {
+      el.setAttribute('data-original-text', el.innerText.trim());
+    }
+
+    const originalText = el.getAttribute('data-original-text') || el.innerText.trim();
+    if (!originalText) continue;
+
+    onStatusUpdate?.({
+      message: `Translating (${completed + 1}/${total})...`,
+      completed,
+      total,
+    });
+
+    try {
+      const translated = await translateText(originalText, targetLang, 'en');
+      el.innerText = translated;
+      el.setAttribute('lang', targetLang);
+      el.classList.add('transition-colors', 'duration-300');
+    } catch (e) {
+      console.error('Error translating element:', e);
+    }
+
+    completed++;
+  }
+
+  articleContainer.setAttribute('lang', targetLang);
+
+  onStatusUpdate?.({
+    message: `Completed (${completed}/${total})`,
+    completed,
+    total,
+  });
+
+  return { success: true, count: completed, engine: engineInfo.name };
+}
+
+/**
+ * Restore original English text on the article page.
+ */
+export function restoreArticleDOM(articleContainer: HTMLElement): void {
+  if (!articleContainer) return;
+
+  const elements = articleContainer.querySelectorAll<HTMLElement>('[data-original-text]');
+  elements.forEach((el) => {
+    const original = el.getAttribute('data-original-text');
+    if (original !== null) {
+      el.innerText = original;
+      el.removeAttribute('lang');
+    }
+  });
+
+  articleContainer.removeAttribute('lang');
+}
+
+/**
+ * Translate all teasers on the current page or within a container.
+ */
+export async function translateTeasersDOM(
+  root: Document | HTMLElement = document,
+  targetLang: string,
+  onStatusUpdate?: (status: { message: string; completed: number; total: number }) => void
+): Promise<{ success: boolean; count: number; engine: string }> {
+  const engineInfo = await detectTranslatorEngine('en', targetLang);
+
+  if (targetLang === 'en') {
+    restoreTeasersDOM(root);
+    return { success: true, count: 0, engine: engineInfo.name };
+  }
+
+  // Find all translatable titles and summaries in teasers
+  const translatableElements = root.querySelectorAll<HTMLElement>('[data-translatable="title"], [data-translatable="summary"], .translatable-title, .translatable-summary');
+  const total = translatableElements.length;
+  let completed = 0;
+
+  for (const el of Array.from(translatableElements)) {
+    if (!el.hasAttribute('data-original-text')) {
+      el.setAttribute('data-original-text', el.innerText.trim());
+    }
+
+    const originalText = el.getAttribute('data-original-text') || el.innerText.trim();
+    if (!originalText) continue;
+
+    onStatusUpdate?.({
+      message: `Translating teasers (${completed + 1}/${total})...`,
+      completed,
+      total,
+    });
+
+    try {
+      const translated = await translateText(originalText, targetLang, 'en');
+      el.innerText = translated;
+      el.setAttribute('lang', targetLang);
+    } catch (e) {
+      console.error('Error translating teaser element:', e);
+    }
+
+    completed++;
+  }
+
+  onStatusUpdate?.({
+    message: `Teasers translated (${completed}/${total})`,
+    completed,
+    total,
+  });
+
+  return { success: true, count: completed, engine: engineInfo.name };
+}
+
+/**
+ * Restore original text for all teasers on the page.
+ */
+export function restoreTeasersDOM(root: Document | HTMLElement = document): void {
+  const elements = root.querySelectorAll<HTMLElement>('[data-original-text]');
+  elements.forEach((el) => {
+    // Only restore if it's a teaser element or outside full article body
+    if (el.closest('#article-body')) return;
+    const original = el.getAttribute('data-original-text');
+    if (original !== null) {
+      el.innerText = original;
+      el.removeAttribute('lang');
+    }
+  });
+}
+
+/**
+ * Translate a single teaser container.
+ */
+export async function translateSingleTeaserDOM(
+  teaserEl: HTMLElement,
+  targetLang: string
+): Promise<boolean> {
+  if (!teaserEl) return false;
+
+  if (targetLang === 'en') {
+    restoreSingleTeaserDOM(teaserEl);
+    return true;
+  }
+
+  const elements = teaserEl.querySelectorAll<HTMLElement>('[data-translatable="title"], [data-translatable="summary"], .translatable-title, .translatable-summary');
+  for (const el of Array.from(elements)) {
+    if (!el.hasAttribute('data-original-text')) {
+      el.setAttribute('data-original-text', el.innerText.trim());
+    }
+    const orig = el.getAttribute('data-original-text') || el.innerText.trim();
+    if (orig) {
+      const translated = await translateText(orig, targetLang, 'en');
+      el.innerText = translated;
+      el.setAttribute('lang', targetLang);
+    }
+  }
+
+  teaserEl.setAttribute('lang', targetLang);
+  return true;
+}
+
+/**
+ * Restore a single teaser container.
+ */
+export function restoreSingleTeaserDOM(teaserEl: HTMLElement): void {
+  if (!teaserEl) return;
+  const elements = teaserEl.querySelectorAll<HTMLElement>('[data-original-text]');
+  elements.forEach((el) => {
+    const orig = el.getAttribute('data-original-text');
+    if (orig !== null) {
+      el.innerText = orig;
+      el.removeAttribute('lang');
+    }
+  });
+  teaserEl.removeAttribute('lang');
+}
