diff --git a/src/components/HeaderTranslationControl.tsx b/src/components/HeaderTranslationControl.tsx
new file mode 100644
index 0000000..e9b95d8
--- /dev/null
+++ b/src/components/HeaderTranslationControl.tsx
@@ -0,0 +1,186 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  detectTranslatorEngine,
+  type TranslatorEngineInfo,
+} from '../utils/translator';
+import {
+  getStoredLanguage,
+  translateActivePage,
+  restoreActivePage,
+  subscribeToLanguageChange,
+} from '../utils/translationStore';
+import { LanguageIcon, SparklesIcon, CheckIcon, ArrowPathIcon, XMarkIcon } from '@heroicons/react/24/outline';
+
+export default function HeaderTranslationControl() {
+  const [isOpen, setIsOpen] = useState(false);
+  const [currentLang, setCurrentLang] = useState('en');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [statusText, setStatusText] = useState('');
+  const [engineInfo, setEngineInfo] = useState<TranslatorEngineInfo>({
+    type: 'on-device-fallback',
+    available: true,
+    name: 'On-Device Engine',
+    description: 'Local In-Browser AI',
+  });
+  const menuRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    detectTranslatorEngine('en', 'es').then(setEngineInfo);
+    setCurrentLang(getStoredLanguage());
+
+    const unsubscribe = subscribeToLanguageChange((newLang) => {
+      setCurrentLang(newLang);
+    });
+
+    const handleClickOutside = (e: MouseEvent) => {
+      if (menuRef.current && !menuRef.current.contains(e.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => {
+      unsubscribe();
+      document.removeEventListener('mousedown', handleClickOutside);
+    };
+  }, []);
+
+  const handleSelectLanguage = async (code: string) => {
+    if (isTranslating) return;
+    setIsTranslating(true);
+    setCurrentLang(code);
+    setStatusText(`Translating with ${engineInfo.name}...`);
+
+    try {
+      const res = await translateActivePage(code, (status) => {
+        setStatusText(status.message);
+      });
+
+      const langObj = SUPPORTED_LANGUAGES.find((l) => l.code === code);
+      if (code === 'en') {
+        setStatusText('Restored to original English');
+      } else {
+        setStatusText(`Translated ${res.count} items to ${langObj?.nativeName || code}`);
+      }
+    } catch (e) {
+      console.error('Header translation error:', e);
+      setStatusText('Translation encountered an error.');
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  const handleRestore = () => {
+    restoreActivePage();
+    setCurrentLang('en');
+    setStatusText('Restored to original English');
+  };
+
+  const activeLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];
+
+  return (
+    <div className="relative inline-block text-left" ref={menuRef}>
+      <button
+        onClick={() => setIsOpen(!isOpen)}
+        className={`flex items-center space-x-1.5 p-1.5 rounded-md text-xs font-semibold transition-colors ${
+          currentLang !== 'en'
+            ? 'bg-amber-100 text-amber-900 border border-amber-300'
+            : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
+        }`}
+        title="On-device article & teaser translation"
+        aria-label="Translate page"
+        aria-expanded={isOpen}
+      >
+        <LanguageIcon className="h-5 w-5 text-gray-600" />
+        <span className="hidden md:inline">
+          {currentLang !== 'en' ? activeLangObj.flag + ' ' + activeLangObj.code.toUpperCase() : 'Translate'}
+        </span>
+        {currentLang !== 'en' && (
+          <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block" title="Translated on-device" />
+        )}
+      </button>
+
+      {isOpen && (
+        <div className="origin-top-left absolute left-0 mt-2 w-80 md:w-96 rounded-lg shadow-xl bg-white border border-gray-200 ring-1 ring-black ring-opacity-5 z-50 p-4 focus:outline-hidden">
+          {/* Header */}
+          <div className="flex items-start justify-between pb-3 border-b border-gray-100">
+            <div>
+              <div className="flex items-center space-x-2">
+                <span className="font-brand font-bold text-gray-900 text-base">On-Device Translation</span>
+                <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
+                  <SparklesIcon className="w-2.5 h-2.5 mr-0.5 inline" />
+                  {engineInfo.name}
+                </span>
+              </div>
+              <p className="text-xs text-gray-500 mt-0.5">
+                Translate news articles and teasers directly in your browser.
+              </p>
+            </div>
+            <button
+              onClick={() => setIsOpen(false)}
+              className="p-1 text-gray-400 hover:text-gray-600 rounded"
+              aria-label="Close translation menu"
+            >
+              <XMarkIcon className="w-4 h-4" />
+            </button>
+          </div>
+
+          {/* Language Options Grid */}
+          <div className="py-3">
+            <span className="text-[11px] font-semibold text-gray-500 uppercase tracking-wider block mb-2">
+              Choose Language:
+            </span>
+            <div className="grid grid-cols-2 gap-1.5">
+              {SUPPORTED_LANGUAGES.map((lang) => {
+                const isSelected = currentLang === lang.code;
+                return (
+                  <button
+                    key={lang.code}
+                    onClick={() => handleSelectLanguage(lang.code)}
+                    disabled={isTranslating}
+                    className={`flex items-center justify-between px-3 py-2 text-xs rounded-md font-medium text-left transition-colors ${
+                      isSelected
+                        ? 'bg-amber-100 text-amber-900 font-bold border border-amber-300'
+                        : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
+                    }`}
+                  >
+                    <span className="flex items-center space-x-2 truncate">
+                      <span className="text-base">{lang.flag}</span>
+                      <span className="truncate">{lang.nativeName}</span>
+                    </span>
+                    {isSelected && <CheckIcon className="w-4 h-4 text-amber-800 flex-shrink-0" />}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+
+          {/* Status and Action Buttons */}
+          <div className="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
+            <div className="text-gray-500 truncate mr-2">
+              {isTranslating ? (
+                <span className="flex items-center text-amber-700 font-medium">
+                  <ArrowPathIcon className="w-3.5 h-3.5 mr-1 animate-spin" />
+                  {statusText || 'Translating on-device...'}
+                </span>
+              ) : (
+                <span>{statusText || (currentLang !== 'en' ? `Viewing in ${activeLangObj.name}` : 'Original English')}</span>
+              )}
+            </div>
+
+            {currentLang !== 'en' && (
+              <button
+                onClick={handleRestore}
+                disabled={isTranslating}
+                className="text-gray-600 hover:text-amber-800 font-semibold underline text-xs whitespace-nowrap"
+              >
+                Reset to English
+              </button>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/TeaserTranslateButton.tsx b/src/components/TeaserTranslateButton.tsx
new file mode 100644
index 0000000..98a80d7
--- /dev/null
+++ b/src/components/TeaserTranslateButton.tsx
@@ -0,0 +1,82 @@
+import React, { useState, useEffect } from 'react';
+import { translateSingleTeaserDOM, restoreSingleTeaserDOM } from '../utils/translator';
+import { getStoredLanguage, subscribeToLanguageChange } from '../utils/translationStore';
+import { LanguageIcon, CheckIcon, ArrowPathIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  articleId?: string;
+}
+
+export default function TeaserTranslateButton({ articleId }: Props) {
+  const [isTranslated, setIsTranslated] = useState(false);
+  const [isLoading, setIsLoading] = useState(false);
+  const [targetLang, setTargetLang] = useState('es');
+
+  useEffect(() => {
+    const saved = getStoredLanguage();
+    if (saved && saved !== 'en') {
+      setTargetLang(saved);
+      setIsTranslated(true);
+    }
+
+    const unsubscribe = subscribeToLanguageChange((newLang) => {
+      if (newLang === 'en') {
+        setIsTranslated(false);
+      } else {
+        setTargetLang(newLang);
+        setIsTranslated(true);
+      }
+    });
+
+    return () => unsubscribe();
+  }, []);
+
+  const handleClick = async (e: React.MouseEvent<HTMLButtonElement>) => {
+    e.preventDefault();
+    e.stopPropagation();
+
+    // Find closest teaser container
+    const button = e.currentTarget;
+    const teaserContainer = button.closest<HTMLElement>('[data-translatable-teaser="true"], article, .group, .flex-col');
+    if (!teaserContainer) return;
+
+    if (isTranslated) {
+      restoreSingleTeaserDOM(teaserContainer);
+      setIsTranslated(false);
+    } else {
+      setIsLoading(true);
+      try {
+        const lang = targetLang === 'en' ? 'es' : targetLang;
+        await translateSingleTeaserDOM(teaserContainer, lang);
+        setIsTranslated(true);
+      } catch (err) {
+        console.error('Failed to translate single teaser:', err);
+      } finally {
+        setIsLoading(false);
+      }
+    }
+  };
+
+  return (
+    <button
+      onClick={handleClick}
+      disabled={isLoading}
+      className={`p-1 rounded hover:bg-gray-100 transition-colors ${
+        isTranslated ? 'text-amber-600' : 'text-gray-400 hover:text-gray-600'
+      }`}
+      title={isTranslated ? 'Restore original English teaser' : 'Translate teaser on-device'}
+      aria-label={isTranslated ? 'Restore teaser' : 'Translate teaser'}
+    >
+      {isLoading ? (
+        <ArrowPathIcon className="h-4 w-4 animate-spin text-amber-500" />
+      ) : isTranslated ? (
+        <span className="flex items-center text-[11px] font-bold text-amber-700">
+          <LanguageIcon className="h-4 w-4 mr-0.5" />
+          <span className="uppercase text-[9px]">{targetLang}</span>
+        </span>
+      ) : (
+        <LanguageIcon className="h-4 w-4" />
+      )}
+    </button>
+  );
+}
