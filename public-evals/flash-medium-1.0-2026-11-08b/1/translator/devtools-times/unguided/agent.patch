diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..e57b97d
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,224 @@
+import React, { useState, useEffect } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  detectTranslatorEngine,
+  translateArticleDOM,
+  restoreArticleDOM,
+  translateTeasersDOM,
+  restoreTeasersDOM,
+  type TranslatorEngineInfo,
+} from '../utils/translator';
+import { getStoredLanguage, setStoredLanguage, subscribeToLanguageChange } from '../utils/translationStore';
+import { LanguageIcon, SparklesIcon, ArrowPathIcon, CheckIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  articleId?: string;
+  title?: string;
+  summary?: string;
+  caption?: string;
+}
+
+export default function ArticleTranslationControl({ articleId, title, summary, caption }: Props) {
+  const [selectedLang, setSelectedLang] = useState<string>('en');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [engineInfo, setEngineInfo] = useState<TranslatorEngineInfo>({
+    type: 'on-device-fallback',
+    available: true,
+    name: 'On-Device Engine',
+    description: 'Local In-Browser Translation',
+  });
+  const [lastDurationMs, setLastDurationMs] = useState<number | null>(null);
+  const [translatedCount, setTranslatedCount] = useState<number>(0);
+
+  useEffect(() => {
+    // Detect engine
+    detectTranslatorEngine('en', 'es').then(setEngineInfo);
+
+    // Initial language from store
+    const initialLang = getStoredLanguage();
+    setSelectedLang(initialLang);
+
+    // Listen to store updates
+    const unsubscribe = subscribeToLanguageChange((newLang) => {
+      setSelectedLang(newLang);
+    });
+
+    return () => unsubscribe();
+  }, []);
+
+  const handleTranslate = async (targetLang: string) => {
+    if (isTranslating) return;
+    setSelectedLang(targetLang);
+    setStoredLanguage(targetLang);
+
+    const articleEl = document.querySelector<HTMLElement>('article.max-w-3xl, #article-container');
+    if (!articleEl) return;
+
+    if (targetLang === 'en') {
+      restoreArticleDOM(articleEl);
+      restoreTeasersDOM(document);
+      setStatusMessage('Showing original English text');
+      setLastDurationMs(null);
+      return;
+    }
+
+    setIsTranslating(true);
+    setStatusMessage('Initializing on-device model...');
+    const startTime = performance.now();
+
+    try {
+      const result = await translateArticleDOM(articleEl, targetLang, (status) => {
+        setStatusMessage(status.message);
+      });
+
+      // Also translate related article teasers at bottom of page
+      await translateTeasersDOM(document, targetLang);
+
+      const endTime = performance.now();
+      const duration = Math.round(endTime - startTime);
+      setLastDurationMs(duration);
+      setTranslatedCount(result.count);
+
+      const langObj = SUPPORTED_LANGUAGES.find((l) => l.code === targetLang);
+      setStatusMessage(`Translated to ${langObj?.nativeName || targetLang} (${duration}ms · ${result.engine})`);
+    } catch (e) {
+      console.error('Translation error:', e);
+      setStatusMessage('Translation failed. Please try again.');
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  const handleRestore = () => {
+    const articleEl = document.querySelector<HTMLElement>('article.max-w-3xl, #article-container');
+    if (articleEl) {
+      restoreArticleDOM(articleEl);
+      restoreTeasersDOM(document);
+    }
+    setSelectedLang('en');
+    setStoredLanguage('en');
+    setStatusMessage('Showing original English text');
+    setLastDurationMs(null);
+  };
+
+  const currentLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === selectedLang) || SUPPORTED_LANGUAGES[0];
+
+  return (
+    <div
+      data-translation-control="article"
+      className="my-6 p-4 bg-gradient-to-r from-amber-50/80 to-stone-50 border border-amber-200/90 rounded-lg shadow-xs transition-all"
+    >
+      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-amber-200/60">
+        <div className="flex items-center space-x-2">
+          <div className="p-1.5 bg-amber-100 text-amber-800 rounded-md">
+            <LanguageIcon className="w-5 h-5" />
+          </div>
+          <div>
+            <div className="flex items-center space-x-2">
+              <span className="font-brand font-bold text-gray-900 text-base">On-Device Article Translation</span>
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
+                <SparklesIcon className="w-3 h-3 mr-1 inline" />
+                {engineInfo.name}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Runs directly in your browser with local AI · Private, secure & offline
+            </p>
+          </div>
+        </div>
+
+        {selectedLang !== 'en' && (
+          <button
+            onClick={handleRestore}
+            className="self-start sm:self-auto text-xs text-gray-600 hover:text-amber-800 underline font-medium flex items-center"
+            title="Restore original English version"
+          >
+            <ArrowPathIcon className="w-3.5 h-3.5 mr-1" />
+            Show Original
+          </button>
+        )}
+      </div>
+
+      {/* Control row */}
+      <div className="mt-3 flex flex-wrap items-center gap-3">
+        <label htmlFor="article-language-select" className="text-xs font-semibold text-gray-700 whitespace-nowrap">
+          Translate to:
+        </label>
+
+        <select
+          id="article-language-select"
+          aria-label="Select article translation language"
+          value={selectedLang}
+          onChange={(e) => handleTranslate(e.target.value)}
+          disabled={isTranslating}
+          className="text-sm bg-white border border-gray-300 rounded-md px-3 py-1.5 text-gray-800 font-medium focus:ring-2 focus:ring-amber-400 focus:outline-hidden cursor-pointer"
+        >
+          {SUPPORTED_LANGUAGES.map((lang) => (
+            <option key={lang.code} value={lang.code}>
+              {lang.flag} {lang.nativeName} ({lang.name})
+            </option>
+          ))}
+        </select>
+
+        {/* Quick action buttons for popular languages */}
+        <div className="flex items-center space-x-1.5">
+          {SUPPORTED_LANGUAGES.slice(1, 6).map((lang) => (
+            <button
+              key={lang.code}
+              onClick={() => handleTranslate(lang.code)}
+              disabled={isTranslating}
+              className={`px-2 py-1 text-xs font-medium rounded transition-colors ${
+                selectedLang === lang.code
+                  ? 'bg-amber-600 text-white font-bold'
+                  : 'bg-white border border-gray-200 text-gray-700 hover:bg-amber-100 hover:text-amber-900'
+              }`}
+              title={`Translate to ${lang.name}`}
+            >
+              {lang.flag} {lang.code.toUpperCase()}
+            </button>
+          ))}
+        </div>
+
+        {/* Translate button */}
+        <button
+          onClick={() => handleTranslate(selectedLang === 'en' ? 'es' : selectedLang)}
+          disabled={isTranslating}
+          className="ml-auto inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md bg-gray-900 text-white hover:bg-gray-800 disabled:opacity-50 transition-colors shadow-xs"
+        >
+          {isTranslating ? (
+            <>
+              <ArrowPathIcon className="w-3.5 h-3.5 mr-1.5 animate-spin" />
+              Translating...
+            </>
+          ) : selectedLang !== 'en' ? (
+            <>
+              <CheckIcon className="w-3.5 h-3.5 mr-1.5 text-emerald-400" />
+              Translated
+            </>
+          ) : (
+            <>
+              <SparklesIcon className="w-3.5 h-3.5 mr-1.5 text-amber-300" />
+              Translate Article
+            </>
+          )}
+        </button>
+      </div>
+
+      {/* Status banner */}
+      {(statusMessage || isTranslating) && (
+        <div className="mt-2.5 pt-2 border-t border-amber-200/40 flex items-center justify-between text-xs text-gray-600">
+          <span className="flex items-center">
+            {isTranslating && <span className="w-2 h-2 rounded-full bg-amber-500 animate-ping mr-2 inline-block" />}
+            {statusMessage}
+          </span>
+          {lastDurationMs !== null && (
+            <span className="text-[11px] text-gray-500">
+              ⚡ {lastDurationMs}ms latency · In-Browser
+            </span>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
