diff --git a/src/utils/translationStore.ts b/src/utils/translationStore.ts
new file mode 100644
index 0000000..9528e76
--- /dev/null
+++ b/src/utils/translationStore.ts
@@ -0,0 +1,100 @@
+import { translateArticleDOM, translateTeasersDOM, restoreArticleDOM, restoreTeasersDOM, SUPPORTED_LANGUAGES } from './translator';
+
+const STORAGE_KEY = 'devtools_times_reading_lang';
+
+export function getStoredLanguage(): string {
+  if (typeof window === 'undefined') return 'en';
+  try {
+    return localStorage.getItem(STORAGE_KEY) || 'en';
+  } catch {
+    return 'en';
+  }
+}
+
+export function setStoredLanguage(lang: string): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.setItem(STORAGE_KEY, lang);
+  } catch (e) {
+    console.warn('Failed to save language to localStorage:', e);
+  }
+
+  window.dispatchEvent(new CustomEvent('devtools-times:language-change', { detail: { lang } }));
+}
+
+export function subscribeToLanguageChange(callback: (lang: string) => void): () => void {
+  if (typeof window === 'undefined') return () => {};
+
+  const handler = (e: Event) => {
+    const custom = e as CustomEvent<{ lang: string }>;
+    callback(custom.detail?.lang || 'en');
+  };
+
+  window.addEventListener('devtools-times:language-change', handler);
+  return () => {
+    window.removeEventListener('devtools-times:language-change', handler);
+  };
+}
+
+/**
+ * Translate everything on the active page (both article and teasers if present).
+ */
+export async function translateActivePage(
+  lang: string,
+  onStatusUpdate?: (status: { message: string; completed: number; total: number }) => void
+): Promise<{ success: boolean; count: number; engine: string }> {
+  if (typeof document === 'undefined') return { success: false, count: 0, engine: '' };
+
+  setStoredLanguage(lang);
+
+  if (lang === 'en') {
+    restoreActivePage();
+    return { success: true, count: 0, engine: 'Original' };
+  }
+
+  let totalCount = 0;
+  let engineUsed = '';
+
+  // 1. If on an article page, translate article
+  const articleEl = document.querySelector<HTMLElement>('article.max-w-3xl, #article-container, article[data-translatable="article"]');
+  if (articleEl) {
+    const res = await translateArticleDOM(articleEl, lang, onStatusUpdate);
+    totalCount += res.count;
+    engineUsed = res.engine;
+  }
+
+  // 2. Also translate all teasers on the page
+  const teasersRes = await translateTeasersDOM(document, lang, onStatusUpdate);
+  totalCount += teasersRes.count;
+  if (!engineUsed) engineUsed = teasersRes.engine;
+
+  return { success: true, count: totalCount, engine: engineUsed };
+}
+
+/**
+ * Restore original English content on the active page.
+ */
+export function restoreActivePage(): void {
+  if (typeof document === 'undefined') return;
+  setStoredLanguage('en');
+
+  const articleEl = document.querySelector<HTMLElement>('article.max-w-3xl, #article-container, article[data-translatable="article"]');
+  if (articleEl) {
+    restoreArticleDOM(articleEl);
+  }
+
+  restoreTeasersDOM(document);
+}
+
+// Client-side auto-apply on navigation with Astro ClientRouter
+if (typeof window !== 'undefined') {
+  document.addEventListener('astro:page-load', () => {
+    const savedLang = getStoredLanguage();
+    if (savedLang && savedLang !== 'en') {
+      // Small tick to ensure DOM is ready
+      setTimeout(() => {
+        translateActivePage(savedLang);
+      }, 50);
+    }
