+          }
+        } catch (err) {
+          console.debug('Native window.translation check skipped:', err);
+        }
+      } else if (typeof window !== 'undefined' && window.ai && window.ai.translator) {
+        try {
+          const capabilities = await window.ai.translator.capabilities();
+          if (capabilities && capabilities.available !== 'no') {
+            return await window.ai.translator.create({
+              sourceLanguage: 'en',
+              targetLanguage: targetLang
+            });
+          }
+        } catch (err) {
+          console.debug('window.ai.translator check skipped:', err);
+        }
+      }
+      return null;
+    }
+
+    /**
+     * Translates all elements on the page with data-i18n attributes.
+     */
+    async function translatePage(targetLang) {
+      const statusBadge = document.getElementById('translation-status');
+      if (statusBadge) {
+        statusBadge.classList.add('translating');
+        statusBadge.textContent = 'Translating...';
+      }
+
+      document.documentElement.lang = targetLang;
+      localStorage.setItem('daily_grind_lang', targetLang);
+
+      // Try Chrome built-in on-device AI translator first if available
+      let nativeTranslator = null;
+      if (targetLang !== 'en') {
+        nativeTranslator = await getOnDeviceTranslator(targetLang);
+      }
+
+      const elements = document.querySelectorAll('[data-i18n]');
+      for (const el of elements) {
+        const key = el.getAttribute('data-i18n');
+        let translatedText = null;
+
+        // Try AI translator if ready
+        if (nativeTranslator) {
+          const original = el.getAttribute('data-original') || translations.en[key] || el.textContent.trim();
+          try {
+            translatedText = await nativeTranslator.translate(original);
+          } catch (e) {
+            console.warn('Native translation error, falling back to local dictionary:', e);
+          }
+        }
+
+        // Fallback or standard on-device dictionary
+        if (!translatedText) {
+          translatedText = translations[targetLang]?.[key] || translations.en[key];
+        }
+
+        if (translatedText) {
+          el.textContent = translatedText;
+        }
+      }
+
+      if (statusBadge) {
+        statusBadge.classList.remove('translating');
+        statusBadge.textContent = nativeTranslator ? 'On-device (AI)' : 'On-device';
+        statusBadge.title = nativeTranslator
+          ? 'Translated directly in browser using Chrome on-device AI'
+          : 'Translated directly in browser using on-device dictionary';
+      }
+    }
+
+    // Initialize on DOM load
+    document.addEventListener('DOMContentLoaded', () => {
+      // Cache original text for each translatable element
+      document.querySelectorAll('[data-i18n]').forEach(el => {
+        if (!el.hasAttribute('data-original')) {
+          el.setAttribute('data-original', el.textContent.trim());
+        }
+      });
+
+      const selector = document.getElementById('language-select');
+      const savedLang = localStorage.getItem('daily_grind_lang') || 'en';
+
+      if (selector) {
+        selector.value = savedLang;
+        selector.addEventListener('change', (e) => {
+          translatePage(e.target.value);
+        });
+      }
+
+      if (savedLang !== 'en') {
+        translatePage(savedLang);
+      }
+    });
+  </script>
+
 </body>
 
