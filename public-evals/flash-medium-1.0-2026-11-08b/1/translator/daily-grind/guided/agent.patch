+          maple_oat: '浓郁的燕麦奶，带有一抹佛蒙特枫糖浆的风味。',
+          espresso: '浓烈、醇厚烟熏，是开启清晨活力的完美之选。',
+          cold_brew: '经过18小时慢速萃取，口感醇滑至极。',
+          story_text: 'The Daily Grind 创立于2018年，最初只是街角的一个小小咖啡手推车，秉承着纯粹的使命：为社区带来符合道德采购、精心烘焙的优质咖啡。每一颗咖啡豆都精选自可持续发展的家族农场，小批量烘焙以锁住其独特的风味与醇香。从清晨的第一杯手冲到您的日常习惯，我们坚信每一杯咖啡都承载着匠心与温情的故事。'
+        }
+      };
+
+      const langSelect = document.getElementById('lang-select');
+      const statusEl = document.getElementById('translation-status');
+      const badgeEl = document.getElementById('ai-badge');
+
+      // Translator instance cache
+      const translatorInstances = new Map();
+
+      function updateStatus(message, isError = false) {
+        if (statusEl) {
+          statusEl.textContent = message;
+          statusEl.style.color = isError ? '#ff8a80' : 'var(--secondary)';
+        }
+      }
+
+      function applyFallbackTranslations(targetLang) {
+        const translations = fallbackTranslations[targetLang];
+        if (!translations) return false;
+
+        translatableElements.forEach((el) => {
+          const key = el.dataset.translateKey;
+          if (translations[key]) {
+            el.textContent = translations[key];
+          }
+        });
+        return true;
+      }
+
+      function restoreOriginals() {
+        translatableElements.forEach((el) => {
+          if (el.dataset.original) {
+            el.textContent = el.dataset.original;
+          }
+        });
+      }
+
+      async function translateContent(targetLang) {
+        const langName = langSelect.options[langSelect.selectedIndex]?.text || targetLang;
+
+        if (targetLang === 'en') {
+          restoreOriginals();
+          document.documentElement.lang = 'en';
+          updateStatus('Language reset to English (Original).');
+          return;
+        }
+
+        updateStatus(`Preparing translation to ${langName}...`);
+
+        // Check for modern Translator API availability exclusively on window.Translator
+        if ('Translator' in window && typeof window.Translator?.availability === 'function') {
+          const options = {
+            sourceLanguage: 'en',
+            targetLanguage: targetLang,
+          };
+
+          try {
+            const availability = await window.Translator.availability(options);
+
+            if (availability === 'available' || availability === 'downloadable' || availability === 'downloading') {
+              let translator = translatorInstances.get(targetLang);
+
+              if (!translator) {
+                if (availability === 'downloadable' || availability === 'downloading') {
+                  updateStatus(`Downloading on-device translation model for ${langName}...`);
+                }
+
+                // Mandatory options matching availability() with download progress monitoring
+                translator = await window.Translator.create({
+                  ...options,
+                  monitor(m) {
+                    m.addEventListener('downloadprogress', (e) => {
+                      const percent = Math.round(e.loaded * 100);
+                      updateStatus(`Downloading model (${langName}): ${percent}%`);
+                    });
+                  },
+                });
+                translatorInstances.set(targetLang, translator);
+              }
+
+              updateStatus(`Translating on-device to ${langName}...`);
+              await Promise.all(
+                translatableElements.map(async (el) => {
+                  const originalText = el.dataset.original;
+                  const translatedText = await translator.translate(originalText);
+                  el.textContent = translatedText;
+                })
+              );
+
+              document.documentElement.lang = targetLang;
+              updateStatus(`Translated directly on-device to ${langName}.`);
+              return;
+            } else {
+              console.warn(`Translator API returned availability: '${availability}' for ${targetLang}.`);
+            }
+          } catch (err) {
+            console.error('Translator API error occurred during translation:', err);
+          }
+        }
+
+        // Fallback strategy for unsupported environments or unavailable models
+        const fallbackSuccess = applyFallbackTranslations(targetLang);
+        if (fallbackSuccess) {
+          document.documentElement.lang = targetLang;
+          const isNativeSupported = 'Translator' in window;
+          updateStatus(
+            isNativeSupported
+              ? `Translated to ${langName} (Fallback: Model currently unavailable on device).`
+              : `Translated to ${langName} (Note: Browser does not support on-device Translator API).`
+          );
+        } else {
+          updateStatus(`Translation model is unavailable for ${langName}.`, true);
+        }
+      }
+
+      // User gesture triggers translation / model download
+      langSelect.addEventListener('change', (e) => {
+        translateContent(e.target.value);
+      });
+
+      // Update badge if Translator API is not supported in current environment
+      if (!('Translator' in window)) {
+        if (badgeEl) {
+          badgeEl.textContent = 'Translation Ready';
+          badgeEl.title = 'On-device Translator API not detected; fallback translation ready.';
+        }
+      }
+    })();
+  </script>
