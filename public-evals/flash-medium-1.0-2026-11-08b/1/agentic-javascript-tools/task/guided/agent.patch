diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,157 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const controller = new AbortController();
+
+      const defaultMenuItems = [
+        {
+          name: "Maple Oat Latte",
+          description: "Creamy oat milk with a hint of Vermont maple syrup.",
+          category: "Seasonal Favorites",
+          url: "/menu/seasonal"
+        },
+        {
+          name: "Dark Roast Espresso",
+          description: "Bold, smokey, and perfect for a morning boost.",
+          category: "Seasonal Favorites",
+          url: "/menu/espresso"
+        },
+        {
+          name: "Cold Brew",
+          description: "Steeped for 18 hours for maximum smoothness.",
+          category: "Seasonal Favorites",
+          url: "/menu/cold-brew"
+        }
+      ];
+
+      function getMenuItems() {
+        const cards = document.querySelectorAll(".card");
+        if (cards.length > 0) {
+          const items = Array.from(cards).map(card => ({
+            name: card.querySelector("h3")?.textContent?.trim() || "",
+            description: card.querySelector("p")?.textContent?.trim() || "",
+            category: card.closest("section")?.querySelector("h2")?.textContent?.trim() || "Seasonal Favorites",
+            url: card.querySelector("a")?.getAttribute("href") || ""
+          })).filter(item => item.name);
+          if (items.length > 0) {
+            return items;
+          }
+        }
+        return defaultMenuItems;
+      }
+
+      function findMenuItem(inputName) {
+        if (!inputName || typeof inputName !== "string") return null;
+        const query = inputName.trim().toLowerCase();
+        const items = getMenuItems();
+
+        // Exact match
+        let match = items.find(item => item.name.toLowerCase() === query);
+        if (match) return match;
+
+        // Substring match
+        match = items.find(item => {
+          const itemName = item.name.toLowerCase();
+          return itemName.includes(query) || query.includes(itemName);
+        });
+        return match || null;
+      }
+
+      async function registerMenuTool() {
+        if (!('modelContext' in document) || !document.modelContext?.registerTool) {
+          return;
+        }
+
+        try {
+          await document.modelContext.registerTool({
+            name: "get_menu_item_details",
+            description: "Looks up and returns details for a coffee or beverage menu item by name. Use when the user asks for details, ingredients, or options for items like Maple Oat Latte, Dark Roast Espresso, or Cold Brew.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                name: {
+                  type: "string",
+                  description: "The name of the menu item to look up (e.g., 'Maple Oat Latte', 'Dark Roast Espresso', or 'Cold Brew')."
+                }
+              },
+              required: ["name"]
+            },
+            execute(input, { signal } = {}) {
+              if (signal?.aborted) {
+                if (typeof signal.throwIfAborted === "function") {
+                  signal.throwIfAborted();
+                } else {
+                  throw new DOMException("Execution aborted", "AbortError");
+                }
+              }
+
+              const rawName = typeof input === "string" ? input : (input?.name ?? input?.itemName ?? "");
+              if (!rawName || typeof rawName !== "string" || !rawName.trim()) {
+                return {
+                  error: "Please provide a valid menu item name.",
+                  availableItems: getMenuItems().map(item => item.name)
+                };
+              }
+
+              const item = findMenuItem(rawName);
+              if (!item) {
+                return {
+                  error: `Menu item "${rawName.trim()}" not found.`,
+                  availableItems: getMenuItems().map(item => item.name)
+                };
+              }
+
+              return item;
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          }, { signal: controller.signal });
+        } catch (err) {
+          if (!controller.signal.aborted) {
+            console.error("Failed to register menu item tool:", err);
+          }
+        }
+      }
+
+      function cleanup() {
+        if (!controller.signal.aborted) {
+          controller.abort();
+        }
+      }
+
+      window.addEventListener("pagehide", cleanup);
+      window.addEventListener("beforeunload", cleanup);
+      window.addEventListener("unload", cleanup);
+
+      if (document.readyState === "loading") {
+        document.addEventListener("DOMContentLoaded", registerMenuTool);
+      } else {
+        registerMenuTool();
+      }
+
+      if (!('modelContext' in document)) {
+        let retries = 0;
+        const interval = setInterval(() => {
+          retries++;
+          if ('modelContext' in document && document.modelContext?.registerTool) {
+            clearInterval(interval);
+            registerMenuTool();
+          } else if (retries >= 20) {
+            clearInterval(interval);
+          }
+        }, 50);
+      }
+
+      window.__menuToolController = controller;
+      window.__registerMenuTool = registerMenuTool;
+      window.__cleanupMenuTool = cleanup;
+    })();
+  </script>
+
 </body>
 
 </html>
