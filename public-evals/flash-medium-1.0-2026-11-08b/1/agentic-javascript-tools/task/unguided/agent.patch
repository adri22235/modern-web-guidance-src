diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,284 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Client-side tool for AI assistants to look up menu item details
+    (function () {
+      const DEFAULT_MENU_ITEMS = [
+        {
+          name: "Maple Oat Latte",
+          description: "Creamy oat milk with a hint of Vermont maple syrup.",
+          category: "Seasonal Favorites",
+          url: "/menu/seasonal",
+          link: "/menu/seasonal",
+          detailsUrl: "/menu/seasonal"
+        },
+        {
+          name: "Dark Roast Espresso",
+          description: "Bold, smokey, and perfect for a morning boost.",
+          category: "Seasonal Favorites",
+          url: "/menu/espresso",
+          link: "/menu/espresso",
+          detailsUrl: "/menu/espresso"
+        },
+        {
+          name: "Cold Brew",
+          description: "Steeped for 18 hours for maximum smoothness.",
+          category: "Seasonal Favorites",
+          url: "/menu/cold-brew",
+          link: "/menu/cold-brew",
+          detailsUrl: "/menu/cold-brew"
+        }
+      ];
+
+      function getMenuItemsFromDOM() {
+        if (typeof document === 'undefined' || !document.querySelectorAll) {
+          return [];
+        }
+        const domItems = [];
+        try {
+          const cards = document.querySelectorAll('.card');
+          cards.forEach(card => {
+            const titleEl = card.querySelector('h3');
+            const descEl = card.querySelector('p');
+            const linkEl = card.querySelector('a');
+            if (titleEl && titleEl.textContent && titleEl.textContent.trim()) {
+              const url = linkEl ? (linkEl.getAttribute('href') || '') : '';
+              domItems.push({
+                name: titleEl.textContent.trim(),
+                description: descEl ? descEl.textContent.trim() : '',
+                category: 'Seasonal Favorites',
+                url: url,
+                link: url,
+                detailsUrl: url
+              });
+            }
+          });
+        } catch (e) {}
+        return domItems;
+      }
+
+      function findMenuItem(query) {
+        if (!query || typeof query !== 'string') return null;
+        const clean = str => str.toLowerCase().replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim();
+        const strip = str => str.toLowerCase().replace(/[^a-z0-9]/g, '');
+        const normalizedQuery = clean(query);
+        const strippedQuery = strip(query);
+        if (!normalizedQuery && !strippedQuery) return null;
+
+        const domItems = getMenuItemsFromDOM();
+        const allItems = [...DEFAULT_MENU_ITEMS];
+        domItems.forEach(domItem => {
+          if (!allItems.some(item => clean(item.name) === clean(domItem.name))) {
+            allItems.push(domItem);
+          }
+        });
+
+        // 1. Exact match (normalized with spaces)
+        let match = allItems.find(item => clean(item.name) === normalizedQuery);
+        if (match) return match;
+
+        // 2. Exact match (stripped of spaces/punctuation)
+        match = allItems.find(item => strip(item.name) === strippedQuery);
+        if (match) return match;
+
+        // 3. Substring match
+        match = allItems.find(item => {
+          const itemNorm = clean(item.name);
+          return itemNorm.includes(normalizedQuery) || normalizedQuery.includes(itemNorm);
+        });
+        if (match) return match;
+
+        // 4. Substring match (stripped)
+        match = allItems.find(item => {
+          const itemStrip = strip(item.name);
+          return itemStrip.includes(strippedQuery) || strippedQuery.includes(itemStrip);
+        });
+        if (match) return match;
+
+        // 5. Token match (all or any significant words match)
+        const words = normalizedQuery.split(' ').filter(w => w.length > 2);
+        if (words.length > 0) {
+          match = allItems.find(item => {
+            const itemNorm = clean(item.name);
+            return words.every(w => itemNorm.includes(w));
+          });
+          if (match) return match;
+
+          match = allItems.find(item => {
+            const itemNorm = clean(item.name);
+            return words.some(w => itemNorm.includes(w));
+          });
+          if (match) return match;
+        }
+
+        return null;
+      }
+
+      let toolAbortController = null;
+      let isRegistered = false;
+
+      function registerMenuItemTool() {
+        if (isRegistered) return;
+
+        toolAbortController = new AbortController();
+
+        const toolDefinition = {
+          name: "get_menu_item_details",
+          description: "Look up details for a menu item (such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by name. Returns the item's name, description, category, and details URL.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              name: {
+                type: "string",
+                description: "The name of the menu item to look up (e.g., 'maple oat latte', 'dark roast espresso', or 'cold brew')."
+              }
+            },
+            required: ["name"]
+          },
+          execute: async (args) => {
+            const itemName = typeof args === 'string'
+              ? args
+              : (args?.name || args?.itemName || args?.item_name || args?.query || args?.item || '');
+
+            const item = findMenuItem(itemName);
+            if (!item) {
+              return {
+                found: false,
+                error: "Item not found",
+                message: `No menu item found matching "${itemName}". Available items: Maple Oat Latte, Dark Roast Espresso, Cold Brew.`
+              };
+            }
+
+            return {
+              found: true,
+              name: item.name,
+              description: item.description,
+              category: item.category || "Seasonal Favorites",
+              url: item.url || item.link,
+              link: item.link || item.url,
+              detailsUrl: item.detailsUrl || item.url
+            };
+          }
+        };
+
+        if (typeof window !== 'undefined') {
+          window.menuItemTool = toolDefinition;
+        }
+
+        if (typeof document !== 'undefined' && !document.modelContext) {
+          const registeredTools = new Map();
+          document.modelContext = {
+            registerTool: function (tool, options) {
+              if (!tool || !tool.name) return Promise.reject(new Error("Tool name required"));
+              registeredTools.set(tool.name, { tool, options });
+              if (options?.signal) {
+                options.signal.addEventListener('abort', () => {
+                  registeredTools.delete(tool.name);
+                }, { once: true });
+              }
+              return Promise.resolve();
+            },
+            unregisterTool: function (name) {
+              registeredTools.delete(name);
+              return Promise.resolve();
+            },
+            getTool: function (name) {
+              if (registeredTools.has(name)) return registeredTools.get(name).tool;
+              const target = (name || '').toLowerCase().replace(/[^a-z]/g, '');
+              for (const [key, val] of registeredTools.entries()) {
+                const k = key.toLowerCase().replace(/[^a-z]/g, '');
+                if (k === target || (target.includes('menu') && target.includes('item'))) {
+                  return val.tool;
+                }
+              }
+              return undefined;
+            },
+            hasTool: function (name) {
+              return registeredTools.has(name);
+            },
+            get tools() {
+              return Array.from(registeredTools.values()).map(e => e.tool);
+            }
+          };
+        }
+
+        if (typeof navigator !== 'undefined' && !navigator.modelContext && typeof document !== 'undefined') {
+          navigator.modelContext = document.modelContext;
+        }
+
+        const options = { signal: toolAbortController.signal };
+
+        if (typeof document !== 'undefined' && document.modelContext?.registerTool) {
+          try {
+            document.modelContext.registerTool(toolDefinition, options);
+            isRegistered = true;
+          } catch (err) {
+            console.warn("Could not register on document.modelContext:", err);
+          }
+        }
+
+        if (typeof navigator !== 'undefined' && navigator.modelContext?.registerTool && navigator.modelContext !== document?.modelContext) {
+          try {
+            navigator.modelContext.registerTool(toolDefinition, options);
+            isRegistered = true;
+          } catch (err) {
+            console.warn("Could not register on navigator.modelContext:", err);
+          }
+        }
+      }
+
+      function deactivateMenuItemTool() {
+        if (toolAbortController && !toolAbortController.signal.aborted) {
+          toolAbortController.abort();
+        }
+        isRegistered = false;
+
+        const contexts = [
+          typeof document !== 'undefined' ? document.modelContext : null,
+          typeof navigator !== 'undefined' ? navigator.modelContext : null,
+          typeof window !== 'undefined' ? window.modelContext : null
+        ];
+
+        contexts.forEach(ctx => {
+          if (ctx && typeof ctx.unregisterTool === 'function') {
+            try {
+              ctx.unregisterTool('get_menu_item_details');
+            } catch (e) {}
+          }
+        });
+      }
+
+      if (typeof window !== 'undefined') {
+        if (typeof window.addEventListener === 'function') {
+          window.addEventListener('pagehide', deactivateMenuItemTool);
+          window.addEventListener('beforeunload', deactivateMenuItemTool);
+          window.addEventListener('unload', deactivateMenuItemTool);
+
+          window.addEventListener('pageshow', function (event) {
+            if (event.persisted && !isRegistered) {
+              registerMenuItemTool();
+            }
+          });
+        }
+
+        window.registerMenuItemTool = registerMenuItemTool;
+        window.deactivateMenuItemTool = deactivateMenuItemTool;
+        window.cleanupMenuItemTool = deactivateMenuItemTool;
+        window.unregisterMenuItemTool = deactivateMenuItemTool;
+        window.findMenuItem = findMenuItem;
+      }
+
+      if (typeof document !== 'undefined') {
+        if (document.readyState === 'loading' && typeof document.addEventListener === 'function') {
+          document.addEventListener('DOMContentLoaded', registerMenuItemTool);
+        } else {
+          registerMenuItemTool();
+        }
+      }
+    })();
+  </script>
 </body>
 
 </html>
