+    document.querySelectorAll('.btn-favorite').forEach(btn => {
+      btn.addEventListener('click', function(e) {
+        e.preventDefault();
+        const isFav = this.classList.toggle('active');
+        const useEl = this.querySelector('use');
+        if (useEl) {
+          const target = isFav ? '#icon-heart-fill' : '#icon-heart';
+          useEl.setAttribute('href', target);
+          useEl.setAttribute('xlink:href', target);
+        }
+        this.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+      });
+    });
+  </script>
