+  <script>
+    function ensureCardContentWrapper() {
+      document.querySelectorAll('.card').forEach(card => {
+        const img = card.querySelector('img');
+        if (img && !card.querySelector('.card-content')) {
+          const wrapper = document.createElement('div');
+          wrapper.className = 'card-content';
+          Array.from(card.childNodes).forEach(node => {
+            if (node !== img) wrapper.appendChild(node);
+          });
+          card.appendChild(wrapper);
+        }
+      });
+    }
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', ensureCardContentWrapper);
+    } else {
+      ensureCardContentWrapper();
+    }
+    new MutationObserver(ensureCardContentWrapper).observe(document.body, { childList: true, subtree: true });
+  </script>
