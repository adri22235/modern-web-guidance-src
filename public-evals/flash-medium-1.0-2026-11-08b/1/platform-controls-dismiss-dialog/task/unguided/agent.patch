+  <script>
+    (function () {
+      let lastFocusedElement = null;
+      let activeCloseWatcher = null;
+      let isHandlingPopstate = false;
+
+      function openModal(dialog, trigger) {
+        if (!dialog) return;
+
+        lastFocusedElement = trigger || document.activeElement;
+
+        // Open modal dialog
+        if (typeof dialog.showModal === 'function') {
+          try {
+            dialog.showModal();
+          } catch (e) {
+            dialog.setAttribute('open', '');
+          }
+        } else {
+          dialog.setAttribute('open', '');
+        }
+
+        // 1. CloseWatcher API support (standard platform close request for desktop Esc & mobile back gesture)
+        if ('CloseWatcher' in window) {
+          try {
+            if (activeCloseWatcher) {
+              activeCloseWatcher.destroy();
+            }
+            activeCloseWatcher = new CloseWatcher();
+            activeCloseWatcher.onclose = function () {
+              closeModal(dialog);
+            };
+          } catch (e) {
+            // CloseWatcher initialization fallback
+          }
+        }
+
+        // 2. History popstate support (for mobile back gesture dismissal fallback)
+        try {
+          history.pushState({ modalOpen: true, dialogId: dialog.id }, '');
+        } catch (e) {}
+
+        // Focus close button or first focusable element for accessibility
+        const closeBtn = dialog.querySelector('.modal-close, button, [tabindex]');
+        if (closeBtn && typeof closeBtn.focus === 'function') {
+          closeBtn.focus();
+        }
+      }
+
+      function closeModal(dialog) {
+        if (!dialog) return;
+        if (dialog.hasAttribute('open') || dialog.open) {
+          if (typeof dialog.close === 'function') {
+            try {
+              dialog.close();
+            } catch (e) {
+              dialog.removeAttribute('open');
+              dialog.dispatchEvent(new Event('close'));
+            }
+          } else {
+            dialog.removeAttribute('open');
+            dialog.dispatchEvent(new Event('close'));
+          }
+        }
+      }
+
+      function handleDialogClose(dialog) {
+        // Clean up CloseWatcher
+        if (activeCloseWatcher) {
+          try {
+            activeCloseWatcher.destroy();
+          } catch (e) {}
+          activeCloseWatcher = null;
+        }
+
+        // Synchronize browser history if closed via controls other than back gesture
+        if (!isHandlingPopstate && history.state && history.state.modalOpen) {
+          try {
+            history.back();
+          } catch (e) {}
+        }
+
+        // Restore focus to trigger element for accessibility
+        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
+          try {
+            lastFocusedElement.focus();
+          } catch (e) {}
+        }
+      }
+
+      // Initialize all dialogs
+      const dialogs = document.querySelectorAll('dialog.coffee-modal');
+      dialogs.forEach(function (dialog) {
+        dialog.addEventListener('close', function () {
+          handleDialogClose(dialog);
+        });
+
+        dialog.addEventListener('cancel', function (e) {
+          // Native cancel event (e.g. Escape key)
+        });
+
+        // Close on clicking backdrop (outside modal-content)
+        dialog.addEventListener('click', function (e) {
+          if (e.target === dialog) {
+            closeModal(dialog);
+          }
+        });
+
+        // Trap focus inside modal when tabbing
+        dialog.addEventListener('keydown', function (e) {
+          if (e.key === 'Tab') {
+            const focusables = dialog.querySelectorAll(
+              'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
+            );
+            if (!focusables || focusables.length === 0) return;
+            const first = focusables[0];
+            const last = focusables[focusables.length - 1];
+
+            if (e.shiftKey) {
+              if (document.activeElement === first || document.activeElement === dialog) {
+                e.preventDefault();
+                last.focus();
+              }
+            } else {
+              if (document.activeElement === last) {
+                e.preventDefault();
+                first.focus();
+              }
+            }
+          }
+        });
+      });
+
+      // Event delegation for opening cards' modal dialogs
+      document.addEventListener('click', function (e) {
+        const trigger = e.target.closest('.card .btn, .card [data-modal], [data-dialog-target]');
+        if (trigger && !trigger.closest('dialog')) {
+          e.preventDefault();
+          const targetId = trigger.getAttribute('data-modal') ||
+            trigger.getAttribute('aria-controls') ||
+            trigger.getAttribute('data-dialog-target');
+          let dialog = null;
+          if (targetId) {
+            dialog = document.getElementById(targetId);
+          }
+          if (!dialog) {
+            const card = trigger.closest('.card');
+            if (card) {
+              dialog = card.querySelector('dialog');
+            }
+          }
+          if (dialog) {
+            openModal(dialog, trigger);
+          }
+        }
+
+        // Close buttons inside modal
+        if (e.target.closest('.modal-close') || e.target.closest('.modal-close-btn')) {
+          e.preventDefault();
+          const dialog = e.target.closest('dialog');
+          if (dialog) {
+            closeModal(dialog);
+          }
+        }
+      });
+
+      // Platform control: Escape key on desktop
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') {
+          const openDialogs = document.querySelectorAll('dialog[open]');
+          openDialogs.forEach(function (dialog) {
+            closeModal(dialog);
+          });
+        }
+      });
+
+      // Platform control: Back gesture on mobile (browser back / history popstate)
+      window.addEventListener('popstate', function () {
+        const openDialogs = document.querySelectorAll('dialog[open]');
+        if (openDialogs.length > 0) {
+          isHandlingPopstate = true;
+          openDialogs.forEach(function (dialog) {
+            closeModal(dialog);
+          });
+          isHandlingPopstate = false;
+        }
+      });
+    })();
+  </script>
