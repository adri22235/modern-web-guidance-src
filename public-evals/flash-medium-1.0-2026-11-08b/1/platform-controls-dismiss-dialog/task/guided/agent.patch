+  <script>
+    // Fallback for Invoker Commands (command="show-modal" / command="close")
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.querySelectorAll('button[command="show-modal"]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const targetId = btn.getAttribute('commandfor');
+          const dialog = document.getElementById(targetId);
+          if (dialog && typeof dialog.showModal === 'function' && !dialog.open) {
+            dialog.showModal();
+          }
+        });
+      });
+      document.querySelectorAll('button[command="close"]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const targetId = btn.getAttribute('commandfor');
+          const dialog = document.getElementById(targetId);
+          if (dialog && typeof dialog.close === 'function' && dialog.open) {
+            dialog.close();
+          }
+        });
+      });
+    }
+
+    // Fallback for light-dismiss (closedby="any") in browsers without native closedBy support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      document.querySelectorAll('dialog[closedby="any"]').forEach(dialog => {
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          const rect = dialog.getBoundingClientRect();
+          const isInside = (
+            rect.top <= event.clientY &&
+            event.clientY <= rect.top + rect.height &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.left + rect.width
+          );
+          if (!isInside && typeof dialog.close === 'function') {
+            dialog.close();
+          }
+        });
+      });
+    }
+  </script>
