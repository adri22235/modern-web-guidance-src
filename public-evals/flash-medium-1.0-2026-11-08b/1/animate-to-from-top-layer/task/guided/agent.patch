+  <script>
+    // Detect discrete display transition support
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(element) {
+      if (!element) return;
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations?.({ subtree: true }) || [];
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 400)),
+          ]);
+        } else {
+          await new Promise((r) => setTimeout(r, 300));
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+
+      if (element instanceof HTMLDialogElement && element.open) {
+        element.close();
+      } else if (element.hidePopover && element.matches?.(':is(:popover-open, .\\:popover-open)')) {
+        element.hidePopover();
+      }
+    }
+
+    // Dialog controls
+    const openDialogBtn = document.getElementById('open-dialog-btn');
+    const closeDialogBtn = document.getElementById('close-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    openDialogBtn?.addEventListener('click', (e) => {
+      e.preventDefault();
+      logoutDialog?.showModal();
+    });
+
+    closeDialogBtn?.addEventListener('click', (e) => {
+      e.preventDefault();
+      closeTopLayer(logoutDialog);
+    });
+
+    logoutDialog?.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeTopLayer(logoutDialog);
+    });
+
+    // closedby fallback for browsers lacking closedBy on HTMLDialogElement
+    if (!('closedBy' in HTMLDialogElement.prototype) && logoutDialog) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      logoutDialog.addEventListener('pointerdown', (e) => {
+        pressedOutside = outside(e, logoutDialog);
+      });
+      logoutDialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e, logoutDialog)) {
+          closeTopLayer(logoutDialog);
+        }
+      });
+    }
+
+    // Floating notice controls
+    const foobarBtn = document.getElementById('foobar');
+    const floatingNotice = document.getElementById('floating-notice');
+
+    floatingNotice?.querySelectorAll('[popovertargetaction="hide"]').forEach((btn) => {
+      btn.addEventListener('click', (e) => {
+        if (!supportsTopLayerExit()) {
+          e.preventDefault();
+          closeTopLayer(floatingNotice);
+        }
+      });
+    });
+
+    foobarBtn?.addEventListener('click', (e) => {
+      if (floatingNotice?.matches?.(':is(:popover-open, .\\:popover-open)') && !supportsTopLayerExit()) {
+        e.preventDefault();
+        closeTopLayer(floatingNotice);
+      }
+    });
+
+    // Fallback for environments lacking native popover API
+    if (!('showPopover' in HTMLElement.prototype) && floatingNotice) {
+      floatingNotice.showPopover = function() {
+        this.classList.add(':popover-open');
+      };
+      floatingNotice.hidePopover = function() {
+        this.classList.remove(':popover-open');
+      };
+      foobarBtn?.addEventListener('click', (e) => {
+        e.preventDefault();
+        if (floatingNotice.classList.contains(':popover-open')) {
+          closeTopLayer(floatingNotice);
+        } else {
+          floatingNotice.showPopover();
+        }
+      });
+    }
+  </script>
