+
+      let noticeCloseTimeout = null;
+
+      function openFloatingNotice() {
+        if (!notice) return;
+
+        if (noticeCloseTimeout) {
+          clearTimeout(noticeCloseTimeout);
+          noticeCloseTimeout = null;
+        }
+
+        if (notice.classList.contains('is-open') && !notice.classList.contains('is-closing')) {
+          notice.classList.remove('notice-pulse');
+          void notice.offsetHeight;
+          notice.classList.add('notice-pulse');
+          return;
+        }
+
+        notice.classList.remove('is-closing');
+        notice.removeAttribute('hidden');
+        notice.style.display = 'flex';
+
+        // Force browser reflow to guarantee CSS entry transition triggers
+        void notice.offsetHeight;
+
+        requestAnimationFrame(() => {
+          notice.classList.add('is-open');
+          if (noticeBtn) {
+            noticeBtn.setAttribute('aria-expanded', 'true');
+          }
+        });
+      }
+
+      function closeFloatingNotice() {
