+  <script>
+    (function () {
+      // Confirmation Dialog
+      const dialog = document.getElementById('confirmation-dialog');
+      const openDialogBtn = document.getElementById('open-dialog-btn');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+      const dialogHeaderClose = document.getElementById('dialog-header-close');
+
+      let dialogCloseTimeout = null;
+
+      function openConfirmationDialog() {
+        if (!dialog) return;
+        if (dialogCloseTimeout) {
+          clearTimeout(dialogCloseTimeout);
+          dialogCloseTimeout = null;
+        }
+
+        dialog.classList.remove('is-closing');
+
+        if (typeof dialog.showModal === 'function') {
+          try {
+            if (!dialog.open) {
+              dialog.showModal();
+            }
+          } catch (e) {
+            dialog.setAttribute('open', '');
+          }
+        } else {
+          dialog.setAttribute('open', '');
+        }
+
+        // Force browser reflow to guarantee CSS entry transition triggers
+        void dialog.offsetHeight;
+
+        requestAnimationFrame(() => {
+          dialog.classList.add('is-open');
+          if (closeDialogBtn) {
+            closeDialogBtn.focus();
+          }
+        });
+      }
+
+      function closeConfirmationDialog() {
+        if (!dialog) return;
+        if (!dialog.hasAttribute('open') && !dialog.open && !dialog.classList.contains('is-open')) {
+          return;
+        }
+
+        dialog.classList.remove('is-open');
+        dialog.classList.add('is-closing');
+
+        const finalizeClose = () => {
+          if (dialogCloseTimeout) {
+            clearTimeout(dialogCloseTimeout);
+            dialogCloseTimeout = null;
+          }
+          dialog.removeEventListener('transitionend', onTransitionEnd);
+
+          if (typeof dialog.close === 'function') {
+            try {
+              if (dialog.open) {
+                dialog.close();
+              }
+            } catch (e) {
+              dialog.removeAttribute('open');
+            }
+          } else {
+            dialog.removeAttribute('open');
+          }
+
+          dialog.classList.remove('is-closing');
+          if (openDialogBtn) {
+            openDialogBtn.focus();
+          }
+        };
+
+        const onTransitionEnd = (e) => {
+          if (e.target === dialog) {
+            finalizeClose();
+          }
+        };
+
+        dialog.addEventListener('transitionend', onTransitionEnd);
+        dialogCloseTimeout = setTimeout(finalizeClose, 280);
+      }
+
+      if (openDialogBtn) {
+        openDialogBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          openConfirmationDialog();
+        });
+      }
+
+      if (closeDialogBtn) {
+        closeDialogBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          closeConfirmationDialog();
+        });
+      }
+
+      if (dialogHeaderClose) {
+        dialogHeaderClose.addEventListener('click', (e) => {
+          e.preventDefault();
+          closeConfirmationDialog();
+        });
+      }
+
+      // Close dialog when clicking backdrop outside dialog content
+      if (dialog) {
+        dialog.addEventListener('click', (e) => {
+          const rect = dialog.getBoundingClientRect();
+          const isInDialog = (
+            rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
+            rect.left <= e.clientX && e.clientX <= rect.left + rect.width
+          );
+          if (!isInDialog) {
+            closeConfirmationDialog();
+          }
+        });
+
+        // Intercept ESC key cancel event to animate exit transition
+        dialog.addEventListener('cancel', (e) => {
+          e.preventDefault();
+          closeConfirmationDialog();
+        });
+      }
+
+      // Dismissible Floating Notice
