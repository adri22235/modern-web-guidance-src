+        if (!notice.classList.contains('is-open') && notice.style.display === 'none') {
+          return;
+        }
+
+        notice.classList.remove('is-open');
+        notice.classList.add('is-closing');
+
+        const finalizeNoticeClose = () => {
+          if (noticeCloseTimeout) {
+            clearTimeout(noticeCloseTimeout);
+            noticeCloseTimeout = null;
+          }
+          notice.removeEventListener('transitionend', onNoticeTransitionEnd);
+          notice.classList.remove('is-closing');
