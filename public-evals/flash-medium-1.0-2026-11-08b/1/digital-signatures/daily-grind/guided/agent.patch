@@ -0,0 +1,132 @@
+import assert from 'node:assert';
+import {
+  supportsPostQuantumSignatures,
+  supportsEd25519,
+  generateSigningKeyPair,
+  signPayload,
+  verifyPayload,
+  canonicalJsonStringify,
+  bytesToBase64,
+  base64ToBytes,
+  getFingerprint,
+  importVerifierKey,
+  CONTEXTS,
+} from '../js/crypto-signatures.js';
+
+async function runTests() {
+  console.log('=== THE DAILY GRIND CRYPTOGRAPHIC VERIFICATION SUITE ===\n');
+
+  // 1. Detection
+  console.log('1. Checking Cryptographic Capabilities:');
+  const pqSupported = supportsPostQuantumSignatures();
+  const edSupported = supportsEd25519();
+  console.log(`   - SubtleCrypto.supports('sign', 'ML-DSA-65'): ${pqSupported}`);
+  console.log(`   - SubtleCrypto.supports('sign', 'Ed25519'):   ${edSupported}`);
+  assert.ok(pqSupported || edSupported, 'At least one signature algorithm must be supported');
+
+  // 2. Base64 helper test
+  console.log('\n2. Testing Base64 Encoding/Decoding:');
+  const testBytes = new Uint8Array([0, 1, 2, 253, 254, 255, 42, 128]);
+  const b64 = bytesToBase64(testBytes);
+  const roundtrip = base64ToBytes(b64);
+  assert.deepStrictEqual(Array.from(roundtrip), Array.from(testBytes));
+  console.log('   ✓ Base64 roundtrip matches exactly');
+
+  // 3. Test suites: Run with both ML-DSA-65 and Ed25519
+  const algorithmsToTest = [];
+  if (pqSupported) algorithmsToTest.push('ML-DSA-65');
+  if (edSupported) algorithmsToTest.push('Ed25519');
+
+  for (const algo of algorithmsToTest) {
+    console.log(`\n3. Testing Digital Signatures with [${algo}]:`);
+    const isPq = algo === 'ML-DSA-65';
+    const keyPair = await generateSigningKeyPair(algo);
+
+    assert.strictEqual(keyPair.suite, algo);
+    assert.strictEqual(keyPair.isPostQuantum, isPq);
+    if (isPq) {
+      assert.strictEqual(keyPair.publicKeyBytes.byteLength, 1952, 'ML-DSA-65 raw-public key must be 1952 bytes');
+      assert.strictEqual(keyPair.keyFormat, 'raw-public');
+    } else {
+      assert.strictEqual(keyPair.publicKeyBytes.byteLength, 32, 'Ed25519 raw key must be 32 bytes');
+      assert.strictEqual(keyPair.keyFormat, 'raw');
+    }
+
+    const fingerprint = await getFingerprint(keyPair.publicKeyBytes);
+    console.log(`   ✓ Key generated. Public key bytes: ${keyPair.publicKeyBytes.byteLength}, Fingerprint: ${fingerprint.substring(0, 23)}...`);
+
+    // Coffee Receipt Test
+    console.log(`   - Signing Coffee Order Receipt with context '${CONTEXTS.RECEIPT}'...`);
+    const receiptPayload = {
+      orderId: 'ORD-20261109-8821',
+      store: 'The Daily Grind - Artisanal Roastery #01',
+      customer: 'Alex Rivera',
+      timestamp: '2026-11-09T10:00:00.000Z',
+      items: [
+        { name: 'Maple Oat Latte', size: 'Regular (16oz)', milk: 'Organic Oat Milk', qty: 2, unitPrice: 7.10, subtotal: 14.20 },
+      ],
+      financials: { subtotal: 14.20, tax: 1.17, total: 15.37 },
+    };
+    const canonicalReceipt = canonicalJsonStringify(receiptPayload);
+    const receiptSig = await signPayload(algo, keyPair.keyPair.privateKey, canonicalReceipt, CONTEXTS.RECEIPT);
+    const receiptSigB64 = bytesToBase64(receiptSig);
+
+    const isReceiptValid = await verifyPayload(keyPair.publicKeyBase64, receiptSigB64, canonicalReceipt, CONTEXTS.RECEIPT, algo);
+    assert.strictEqual(isReceiptValid, true, 'Original receipt must be verified as authentic');
+    console.log('     ✓ Original receipt signature verified successfully');
+
+    // Receipt Tampering Test
+    const tamperedReceiptPayload = { ...receiptPayload, financials: { ...receiptPayload.financials, total: 0.01 } };
+    const canonicalTamperedReceipt = canonicalJsonStringify(tamperedReceiptPayload);
+    const isTamperedReceiptValid = await verifyPayload(keyPair.publicKeyBase64, receiptSigB64, canonicalTamperedReceipt, CONTEXTS.RECEIPT, algo);
+    assert.strictEqual(isTamperedReceiptValid, false, 'Tampered receipt must be rejected');
+    console.log('     ✓ Tampered receipt ($0.01 total modification) rejected as invalid');
+
+    // Gift Voucher Test
+    console.log(`   - Signing Gift Voucher with context '${CONTEXTS.VOUCHER}'...`);
+    const voucherPayload = {
+      voucherCode: 'GRIND-2026-9901-XK92',
+      issuer: 'The Daily Grind Artisanal Coffee Co.',
+      recipientName: 'Taylor Smith',
+      recipientEmail: 'taylor@example.com',
+      senderName: 'Alex Rivera',
+      amount: 25.00,
+      currency: 'USD',
+      issuedAt: '2026-11-09T10:00:00.000Z',
+      expiresAt: '2027-11-09T10:00:00.000Z',
+      message: 'Enjoy your coffee!',
+    };
+    const canonicalVoucher = canonicalJsonStringify(voucherPayload);
+    const voucherSig = await signPayload(algo, keyPair.keyPair.privateKey, canonicalVoucher, CONTEXTS.VOUCHER);
+    const voucherSigB64 = bytesToBase64(voucherSig);
+
+    const isVoucherValid = await verifyPayload(keyPair.publicKeyBase64, voucherSigB64, canonicalVoucher, CONTEXTS.VOUCHER, algo);
+    assert.strictEqual(isVoucherValid, true, 'Original gift voucher must be verified as authentic');
+    console.log('     ✓ Original gift voucher signature verified successfully');
+
+    // Gift Voucher Tampering Test
+    const tamperedVoucherPayload = { ...voucherPayload, amount: 500.00 };
+    const canonicalTamperedVoucher = canonicalJsonStringify(tamperedVoucherPayload);
+    const isTamperedVoucherValid = await verifyPayload(keyPair.publicKeyBase64, voucherSigB64, canonicalTamperedVoucher, CONTEXTS.VOUCHER, algo);
+    assert.strictEqual(isTamperedVoucherValid, false, 'Tampered voucher amount must be rejected');
+    console.log('     ✓ Tampered voucher ($500.00 amount modification) rejected as invalid');
+
+    // Cross-Protocol / Domain Separation Replay Attack Test
+    console.log('   - Testing Domain Separation Replay Attack:');
+    // Attempt to verify receipt signature under voucher context:
+    const receiptUnderVoucherContext = await verifyPayload(keyPair.publicKeyBase64, receiptSigB64, canonicalReceipt, CONTEXTS.VOUCHER, algo);
+    assert.strictEqual(receiptUnderVoucherContext, false, 'Receipt signature evaluated with voucher context must fail');
+
+    // Attempt to verify voucher signature under receipt context:
+    const voucherUnderReceiptContext = await verifyPayload(keyPair.publicKeyBase64, voucherSigB64, canonicalVoucher, CONTEXTS.RECEIPT, algo);
+    assert.strictEqual(voucherUnderReceiptContext, false, 'Voucher signature evaluated with receipt context must fail');
+    console.log('     ✓ Domain separation prevents cross-protocol replay attacks');
+  }
+
+  console.log('\n=== ALL CRYPTOGRAPHIC TESTS COMPLETED SUCCESSFULLY ===');
+}
+
+runTests().catch(err => {
+  console.error('Test suite failed:', err);
+  process.exit(1);
+});
