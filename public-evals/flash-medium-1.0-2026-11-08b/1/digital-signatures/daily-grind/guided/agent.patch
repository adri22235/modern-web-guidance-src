+// Initialize Cryptographic Authority
+async function initCryptoAuthority(algorithm = 'ML-DSA-65') {
+  const isPqAvailable = supportsPostQuantumSignatures();
+  const selectedAlgo = (algorithm === 'ML-DSA-65' && isPqAvailable) ? 'ML-DSA-65' : 'Ed25519';
+
+  state.activeAlgorithm = selectedAlgo;
+
+  try {
+    state.activeKeypair = await generateSigningKeyPair(selectedAlgo);
+    updateAuthorityUI();
+  } catch (err) {
+    console.error('Error initializing cryptographic keypair:', err);
+    // Fall back to Ed25519
+    state.activeAlgorithm = 'Ed25519';
+    state.activeKeypair = await generateSigningKeyPair('Ed25519');
+    updateAuthorityUI();
+  }
