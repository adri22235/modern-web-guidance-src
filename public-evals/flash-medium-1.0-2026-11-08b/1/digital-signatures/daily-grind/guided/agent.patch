+// Order Total Calculation
+function calculateOrderTotals() {
+  const coffeeSelect = document.getElementById('order-coffee');
+  const sizeSelect = document.getElementById('order-size');
+  const milkSelect = document.getElementById('order-milk');
+  const qtyInput = document.getElementById('order-qty');
+
+  const selectedCoffee = MENU_ITEMS.find(i => i.id === coffeeSelect?.value) || MENU_ITEMS[0];
+  const selectedSize = SIZE_MODIFIERS[sizeSelect?.value] || SIZE_MODIFIERS.regular;
+  const selectedMilk = MILK_MODIFIERS[milkSelect?.value] || MILK_MODIFIERS.oat;
+
+  let unitPrice = selectedCoffee.basePrice + selectedSize.delta + selectedMilk.delta;
+
+  const extraShot = document.getElementById('order-extra-shot')?.checked;
+  const vanilla = document.getElementById('order-extra-vanilla')?.checked;
+  const cinnamon = document.getElementById('order-extra-cinnamon')?.checked;
+
+  if (extraShot) unitPrice += EXTRA_MODIFIERS.extraShot.delta;
+  if (vanilla) unitPrice += EXTRA_MODIFIERS.vanilla.delta;
+  if (cinnamon) unitPrice += EXTRA_MODIFIERS.cinnamon.delta;
+
+  const qty = Math.max(1, parseInt(qtyInput?.value || '1', 10));
+  const subtotal = unitPrice * qty;
+  const tax = subtotal * 0.0825;
+  const total = subtotal + tax;
+
+  const subtotalEl = document.getElementById('order-subtotal');
+  const taxEl = document.getElementById('order-tax');
+  const totalEl = document.getElementById('order-total');
+
+  if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
+  if (taxEl) taxEl.textContent = `$${tax.toFixed(2)}`;
+  if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
+
+  return {
+    item: selectedCoffee.name,
+    size: selectedSize.name,
+    milk: selectedMilk.name,
+    extras: [
+      extraShot ? 'Extra Espresso Shot' : null,
+      vanilla ? 'Madagascar Vanilla' : null,
+      cinnamon ? 'Ceylon Cinnamon' : null,
+    ].filter(Boolean),
+    qty,
+    unitPrice: parseFloat(unitPrice.toFixed(2)),
+    subtotal: parseFloat(subtotal.toFixed(2)),
+    tax: parseFloat(tax.toFixed(2)),
+    total: parseFloat(total.toFixed(2)),
+  };
