+/**
+ * Digital Signatures Module for The Daily Grind
+ * Supporting NIST FIPS 204 ML-DSA-65 (Quantum-Resistant) and Classical Ed25519
+ * Conforms to modern-web-guidance for digital-signatures.
+ */
+
+export const CONTEXTS = {
+  RECEIPT: 'coffee-order-receipt-v1',
+  VOUCHER: 'gift-voucher-v1',
+};
+
+export const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
+
+/**
+ * Check if the runtime supports post-quantum ML-DSA signatures.
+ * Note: Must probe SubtleCrypto constructor statically, not crypto.subtle.
+ */
+export function supportsPostQuantumSignatures() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', 'ML-DSA-65')
+  );
+}
+
+/**
+ * Check if the runtime supports classical Ed25519 signatures.
+ */
+export function supportsEd25519() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', 'Ed25519')
+  );
+}
+
+/**
+ * Convert Uint8Array to Base64 string.
+ */
+export function bytesToBase64(bytes) {
+  let binary = '';
+  const len = bytes.byteLength;
+  for (let i = 0; i < len; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary);
+}
+
+/**
+ * Convert Base64 string to Uint8Array.
+ */
+export function base64ToBytes(base64) {
+  const clean = base64.replace(/\s+/g, '');
+  const binary = atob(clean);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Compute SHA-256 fingerprint formatted as XX:XX:XX...
+ */
+export async function getFingerprint(bytesOrBase64) {
+  const bytes = typeof bytesOrBase64 === 'string' ? base64ToBytes(bytesOrBase64) : bytesOrBase64;
+  const hash = await crypto.subtle.digest('SHA-256', bytes);
+  const hashArray = Array.from(new Uint8Array(hash));
+  return hashArray.map(b => b.toString(16).padStart(2, '0')).join(':').toUpperCase();
+}
+
+/**
+ * Length-prefixed domain separation frame for classical algorithms like Ed25519
+ * that do not accept ContextParams.
+ */
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+/**
+ * Deterministic JSON stringifier to guarantee identical canonical byte representation.
+ */
+export function canonicalJsonStringify(obj) {
+  if (obj === null || typeof obj !== 'object') {
+    return JSON.stringify(obj);
+  }
+  if (Array.isArray(obj)) {
+    return '[' + obj.map(canonicalJsonStringify).join(',') + ']';
+  }
+  const sortedKeys = Object.keys(obj).sort();
+  return '{' + sortedKeys.map(k => JSON.stringify(k) + ':' + canonicalJsonStringify(obj[k])).join(',') + '}';
+}
+
+/**
+ * Generate signing key pair for chosen suite ('ML-DSA-65' or 'Ed25519').
+ * If ML-DSA-65 is requested but unsupported, falls back gracefully to Ed25519.
+ */
+export async function generateSigningKeyPair(requestedSuite = 'ML-DSA-65') {
+  const isPqSupported = supportsPostQuantumSignatures();
+  const suite = (requestedSuite === 'ML-DSA-65' && isPqSupported) ? 'ML-DSA-65' : 'Ed25519';
+
+  if (suite === 'ML-DSA-65') {
+    // Generate ML-DSA-65 keypair with ['sign', 'verify'] usages
+    const keyPair = await crypto.subtle.generateKey('ML-DSA-65', true, ['sign', 'verify']);
+    // ML-DSA requires 'raw-public' (legacy 'raw' throws NotSupportedError)
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    const fingerprint = await getFingerprint(publicKeyBytes);
+    return {
+      suite: 'ML-DSA-65',
+      isPostQuantum: true,
+      keyFormat: 'raw-public',
+      keyPair,
+      publicKeyBytes,
+      publicKeyBase64: bytesToBase64(publicKeyBytes),
+      fingerprint,
+    };
+  }
+
+  // Classical fallback: Ed25519
+  const keyPair = await crypto.subtle.generateKey('Ed25519', true, ['sign', 'verify']);
+  // Classical Ed25519 exports as 'raw'
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  const fingerprint = await getFingerprint(publicKeyBytes);
+  return {
+    suite: 'Ed25519',
+    isPostQuantum: false,
+    keyFormat: 'raw',
+    keyPair,
+    publicKeyBytes,
+    publicKeyBase64: bytesToBase64(publicKeyBytes),
+    fingerprint,
+  };
+}
+
+/**
+ * Import a public key for verification from bytes or Base64.
+ * Usage must be ['verify'] only.
+ */
+export async function importVerifierKey(publicKeyOrBytes, explicitSuite = null) {
+  if (publicKeyOrBytes instanceof CryptoKey) {
+    return publicKeyOrBytes;
+  }
+  const bytes = typeof publicKeyOrBytes === 'string'
+    ? base64ToBytes(publicKeyOrBytes)
+    : publicKeyOrBytes instanceof Uint8Array
+      ? publicKeyOrBytes
+      : new Uint8Array(publicKeyOrBytes);
+
+  let suite = explicitSuite;
+  if (!suite) {
+    suite = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength] || 'Ed25519';
+  }
+
+  if (suite.startsWith('ML-DSA')) {
+    return await crypto.subtle.importKey('raw-public', bytes, suite, true, ['verify']);
+  }
+  return await crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+}
+
+/**
+ * Sign payload with domain separation context.
+ */
+export async function signPayload(
+  suite,
+  privateKey,
+  payloadBytes,
+  contextBytes = new Uint8Array(0),
+) {
+  const enc = new TextEncoder();
+  const pBytes = typeof payloadBytes === 'string' ? enc.encode(payloadBytes) : payloadBytes;
+  const cBytes = typeof contextBytes === 'string' ? enc.encode(contextBytes) : contextBytes;
+
+  if (suite.startsWith('ML-DSA')) {
+    const sig = await crypto.subtle.sign(
+      { name: suite, context: cBytes },
+      privateKey,
+      pBytes,
+    );
+    return new Uint8Array(sig);
+  }
+
+  const framed = frameFallbackInput(pBytes, cBytes);
+  const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+  return new Uint8Array(sig);
+}
+
+/**
+ * Verify payload signature with domain separation context.
+ */
+export async function verifyPayload(
+  publicKeyOrBytes,
+  signatureBytes,
+  payloadBytes,
+  contextBytes = new Uint8Array(0),
+  explicitSuite = null,
+) {
+  const enc = new TextEncoder();
+  const pBytes = typeof payloadBytes === 'string' ? enc.encode(payloadBytes) : payloadBytes;
+  const cBytes = typeof contextBytes === 'string' ? enc.encode(contextBytes) : contextBytes;
+  const sBytes = typeof signatureBytes === 'string' ? base64ToBytes(signatureBytes) : signatureBytes;
+
+  const publicKey = await importVerifierKey(publicKeyOrBytes, explicitSuite);
+
+  if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+    return await crypto.subtle.verify(
+      { name: publicKey.algorithm.name, context: cBytes },
+      publicKey,
+      sBytes,
+      pBytes,
+    );
+  }
+
+  const framed = frameFallbackInput(pBytes, cBytes);
+  return await crypto.subtle.verify('Ed25519', publicKey, sBytes, framed);
+}
