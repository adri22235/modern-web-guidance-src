+
+  async function generateClassicalKeyPair(algoKey = 'ECDSA-P256') {
+    const config = CLASSICAL_ALGORITHMS[algoKey] || CLASSICAL_ALGORITHMS['ECDSA-P256'];
+    const keyPair = await subtle.generateKey(config.keygenParams, true, ['sign', 'verify']);
