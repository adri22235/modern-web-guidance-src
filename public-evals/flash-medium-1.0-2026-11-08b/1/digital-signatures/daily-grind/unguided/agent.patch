+    for (let i = 0; i < steps; i++) {
+      curr = await sha256(curr);
+    }
+    return curr;
+  }
+
+  async function generateQuantumResistantKeyPair() {
+    const privParts = [];
+    const pubParts = [];
+
+    for (let i = 0; i < WOTS_L; i++) {
+      const sk = new Uint8Array(32);
+      cryptoObj.getRandomValues(sk);
+      privParts.push(bytesToHex(sk));
+      const pk = await hashChain(sk, WOTS_W - 1);
+      pubParts.push(bytesToHex(pk));
+    }
