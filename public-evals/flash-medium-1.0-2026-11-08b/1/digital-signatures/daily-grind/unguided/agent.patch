+    return activeAuthorityKeyPair;
+  }
+
+  return {
+    canonicalizeJSON,
+    sha256,
+    bytesToHex,
+    hexToBytes,
+    bytesToBase64,
+    base64ToBytes,
+    generateClassicalKeyPair,
+    generateQuantumResistantKeyPair,
+    signCoffeeReceipt,
+    signGiftVoucher,
+    verifyDocument,
+    initializeAuthorityKeys,
+    getActiveAuthorityKeyPair,
+    CLASSICAL_ALGORITHMS
+  };
+});
