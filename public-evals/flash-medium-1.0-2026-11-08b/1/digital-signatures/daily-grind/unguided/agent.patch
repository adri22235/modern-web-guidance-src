+      type: 'classical',
+      displayName: 'Classical ECDSA (NIST P-256 + SHA-256)',
+      keygenParams: { name: 'ECDSA', namedCurve: 'P-256' },
+      signParams: { name: 'ECDSA', hash: { name: 'SHA-256' } },
+      importParams: { name: 'ECDSA', namedCurve: 'P-256' }
+    },
+    'RSA-PSS-2048': {
+      name: 'RSA-PSS-2048-SHA256',
+      type: 'classical',
+      displayName: 'Classical RSA-PSS (2048-bit + SHA-256)',
+      keygenParams: {
+        name: 'RSA-PSS',
+        modulusLength: 2048,
+        publicExponent: new Uint8Array([1, 0, 1]),
+        hash: 'SHA-256'
