+/**
+ * The Daily Grind - Test Suite
+ * Validates Digital Signing & Verification for Coffee Order Receipts and Gift Vouchers
+ * Covers Classical (ECDSA P-256, RSA-PSS) and Quantum-Resistant (W-OTS+) Asymmetric Keys.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const assert = require('assert');
+const DailyGrindCrypto = require('./crypto-signer.js');
+
+async function runTests() {
+  console.log('====================================================');
+  console.log('Running The Daily Grind Cryptographic Test Suite');
+  console.log('====================================================\n');
+
+  let passedTests = 0;
+
+  // 1. Classical ECDSA Tests
+  console.log('TEST 1: Classical ECDSA (NIST P-256 + SHA-256) Key Generation');
+  const ecdsaKeys = await DailyGrindCrypto.initializeAuthorityKeys('ECDSA-P256');
+  assert(ecdsaKeys.privateKey, 'ECDSA privateKey must exist');
+  assert(ecdsaKeys.publicKey, 'ECDSA publicKey must exist');
+  assert(ecdsaKeys.fingerprint.length > 8, 'Fingerprint must be non-empty');
+  assert(ecdsaKeys.algorithm === 'ECDSA-P256-SHA256', 'Algorithm must match');
+  console.log('  ✓ Key generated successfully:', ecdsaKeys.keyId);
+  passedTests++;
+
+  // 2. Receipt Signing & Verification (Classical ECDSA)
+  console.log('TEST 2: Coffee Order Receipt Digital Signing & Verification (Classical ECDSA)');
+  const receiptPayload = {
+    receiptId: 'DG-REC-2026-9901',
+    issuedAt: '2026-11-09T09:50:00Z',
+    storeLocation: 'The Daily Grind Flagship #01 - Downtown Roastery',
+    cashier: 'Barista Maya (ID: DG-402)',
+    customerName: 'Alex Mercer',
+    orderType: 'Dine-in',
+    items: [
+      { id: 'latte', name: 'Maple Oat Latte', unitPrice: 5.50, qty: 2, total: 11.00 },
+      { id: 'croissant', name: 'Almond Croissant', unitPrice: 4.00, qty: 1, total: 4.00 }
+    ],
+    subtotal: 15.00,
+    tax: 1.20,
+    total: 16.20,
+    currency: 'USD',
+    paymentMethod: 'Daily Grind Card'
+  };
+
+  const signedReceipt = await DailyGrindCrypto.signCoffeeReceipt(receiptPayload, ecdsaKeys);
+  assert(signedReceipt.signature && signedReceipt.signature.value, 'Receipt must have signature value');
+  assert(signedReceipt.type === 'coffee_order_receipt', 'Type must be coffee_order_receipt');
+
+  const verifyReceiptValid = await DailyGrindCrypto.verifyDocument(signedReceipt);
+  assert(verifyReceiptValid.valid === true, 'Untampered receipt must verify as true');
+  assert(verifyReceiptValid.digestMatches === true, 'Digest must match');
+  console.log('  ✓ Untampered receipt verified as authentic');
+  passedTests++;
+
+  // 3. Receipt Tamper Detection (Price modification fraud)
+  console.log('TEST 3: Receipt Tamper Detection (Detecting fraudulent price edit)');
+  const tamperedReceipt = JSON.parse(JSON.stringify(signedReceipt));
+  tamperedReceipt.payload.total = 0.50; // Malicious reduction of total
+  const verifyReceiptTampered = await DailyGrindCrypto.verifyDocument(tamperedReceipt);
+  assert(verifyReceiptTampered.valid === false, 'Tampered receipt must NOT verify');
+  console.log('  ✓ Tampered receipt successfully caught and rejected');
+  passedTests++;
+
+  // 4. Receipt Tamper Detection (Customer name modification)
+  console.log('TEST 4: Receipt Tamper Detection (Detecting customer identity swap)');
+  const tamperedReceipt2 = JSON.parse(JSON.stringify(signedReceipt));
+  tamperedReceipt2.payload.customerName = 'Mallory Malicious';
+  const verifyReceiptTampered2 = await DailyGrindCrypto.verifyDocument(tamperedReceipt2);
+  assert(verifyReceiptTampered2.valid === false, 'Customer-tampered receipt must NOT verify');
+  console.log('  ✓ Customer identity tampering caught and rejected');
+  passedTests++;
+
+  // 5. Gift Voucher Signing & Verification (Classical ECDSA)
+  console.log('TEST 5: Gift Voucher Digital Signing & Verification (Classical ECDSA)');
+  const voucherPayload = {
+    voucherCode: 'DG-VOUCH-5512-ARTISAN',
+    recipientName: 'Jordan Lee',
+    recipientEmail: 'jordan@example.com',
+    senderName: 'The Daily Grind Loyalty Club',
+    message: 'Enjoy handcrafted specialty coffee!',
+    amount: 50.00,
+    currency: 'USD',
+    issuedAt: '2026-11-09T09:50:00Z',
+    expiresAt: '2027-11-09T09:50:00Z',
+    terms: 'Valid at all Daily Grind locations.'
+  };
+
+  const signedVoucher = await DailyGrindCrypto.signGiftVoucher(voucherPayload, ecdsaKeys);
+  assert(signedVoucher.type === 'gift_voucher', 'Type must be gift_voucher');
+  assert(signedVoucher.signature && signedVoucher.signature.value, 'Voucher must have signature value');
+
+  const verifyVoucherValid = await DailyGrindCrypto.verifyDocument(signedVoucher);
+  assert(verifyVoucherValid.valid === true, 'Untampered voucher must verify as true');
+  console.log('  ✓ Untampered voucher verified as authentic');
+  passedTests++;
+
+  // 6. Gift Voucher Tamper Detection (Amount inflation fraud)
+  console.log('TEST 6: Gift Voucher Tamper Detection (Detecting amount inflation to $500.00)');
+  const tamperedVoucher = JSON.parse(JSON.stringify(signedVoucher));
+  tamperedVoucher.payload.amount = 500.00;
+  const verifyVoucherTampered = await DailyGrindCrypto.verifyDocument(tamperedVoucher);
+  assert(verifyVoucherTampered.valid === false, 'Tampered voucher must NOT verify');
+  console.log('  ✓ Inflated voucher successfully caught and rejected');
+  passedTests++;
+
+  // 7. Classical RSA-PSS Asymmetric Signing & Verification
+  console.log('TEST 7: Classical RSA-PSS (2048-bit + SHA-256) Signing & Verification');
+  const rsaKeys = await DailyGrindCrypto.initializeAuthorityKeys('RSA-PSS-2048');
+  assert(rsaKeys.algorithm === 'RSA-PSS-2048-SHA256', 'Algorithm must be RSA-PSS');
+
+  const signedRsaReceipt = await DailyGrindCrypto.signCoffeeReceipt(receiptPayload, rsaKeys);
+  const verifyRsa = await DailyGrindCrypto.verifyDocument(signedRsaReceipt);
+  assert(verifyRsa.valid === true, 'RSA-PSS signed receipt must verify as true');
+  console.log('  ✓ RSA-PSS signed receipt verified as authentic');
+  passedTests++;
+
+  // 8. Quantum-Resistant W-OTS+ Hash-Based Asymmetric Signing & Verification
+  console.log('TEST 8: Quantum-Resistant W-OTS+ Asymmetric Signing & Verification');
+  const pqKeys = await DailyGrindCrypto.initializeAuthorityKeys('W-OTS-PLUS');
+  assert(pqKeys.keyType === 'quantum-resistant', 'Key type must be quantum-resistant');
+
+  const signedPqVoucher = await DailyGrindCrypto.signGiftVoucher(voucherPayload, pqKeys);
+  const verifyPq = await DailyGrindCrypto.verifyDocument(signedPqVoucher);
+  assert(verifyPq.valid === true, 'Quantum-resistant signed voucher must verify as true');
+  console.log('  ✓ Quantum-resistant voucher verified as authentic');
+  passedTests++;
+
+  // 9. Quantum-Resistant Tamper Detection
+  console.log('TEST 9: Quantum-Resistant Tamper Detection');
+  const tamperedPqVoucher = JSON.parse(JSON.stringify(signedPqVoucher));
+  tamperedPqVoucher.payload.recipientName = 'Eve Attacker';
+  const verifyPqTampered = await DailyGrindCrypto.verifyDocument(tamperedPqVoucher);
+  assert(verifyPqTampered.valid === false, 'Tampered PQ voucher must NOT verify');
+  console.log('  ✓ Tampered quantum-resistant voucher successfully caught and rejected');
+  passedTests++;
+
+  // 10. Verification with Overriding / External Public Key
+  console.log('TEST 10: Verification with Explicit Public Key Override');
+  const separateKeys = await DailyGrindCrypto.generateClassicalKeyPair('ECDSA-P256');
+  const verifyWithWrongKey = await DailyGrindCrypto.verifyDocument(signedReceipt, separateKeys.publicJwk);
+  assert(verifyWithWrongKey.valid === false, 'Verification with unauthorized public key must fail');
+  console.log('  ✓ Unauthorized public key verification correctly rejected');
+  passedTests++;
+
+  // 11. Static HTML & File Integrity
+  console.log('TEST 11: Daily Grind Homepage Structure and Asset Verification');
+  const htmlPath = path.join(__dirname, 'index.html');
+  const htmlContent = fs.readFileSync(htmlPath, 'utf8');
+
+  assert(htmlContent.includes('crypto-signer.js'), 'HTML must include crypto-signer.js');
+  assert(htmlContent.includes('app.js'), 'HTML must include app.js');
+  assert(htmlContent.includes('receipt-section'), 'HTML must have receipt-section');
+  assert(htmlContent.includes('voucher-section'), 'HTML must have voucher-section');
+  assert(htmlContent.includes('verify-authenticity'), 'HTML must have verify-authenticity');
+  assert(htmlContent.includes('security-authority'), 'HTML must have security-authority');
+  assert(htmlContent.includes('btn-sign-receipt'), 'HTML must have btn-sign-receipt');
+  assert(htmlContent.includes('btn-sign-voucher'), 'HTML must have btn-sign-voucher');
+  assert(htmlContent.includes('btn-verify-doc'), 'HTML must have btn-verify-doc');
+  console.log('  ✓ All required sections and elements present in index.html');
+  passedTests++;
+
+  console.log('\n====================================================');
+  console.log(`ALL ${passedTests} TESTS PASSED! DIGITAL TRUST COMPLETE.`);
+  console.log('====================================================');
+}
+
+runTests().catch(err => {
+  console.error('\n❌ Test Failure:', err);
+  process.exit(1);
+});
