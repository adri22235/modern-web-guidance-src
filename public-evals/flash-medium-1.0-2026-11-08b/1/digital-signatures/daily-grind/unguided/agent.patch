+   * Foundational to NIST FIPS 205 (SPHINCS+) and RFC 8391.
+   * Completely immune to Shor's algorithm as it relies strictly on collision/pre-image resistance of SHA-256.
+   */
+  const WOTS_W = 16; // base 16 nibbles
+  const WOTS_L1 = 64; // 32 bytes * 2 nibbles
+  const WOTS_L2 = 3;  // checksum nibbles
+  const WOTS_L = WOTS_L1 + WOTS_L2; // 67 total chains
+
+  async function hashChain(value, steps) {
