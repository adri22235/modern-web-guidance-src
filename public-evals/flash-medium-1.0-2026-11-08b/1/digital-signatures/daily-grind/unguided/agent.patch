+/**
+ * The Daily Grind - Interactive Digital Signing & Verification Application
+ */
+
+(function () {
+  'use strict';
+
+  const Crypto = window.DailyGrindCrypto;
+  if (!Crypto) {
+    console.error('DailyGrindCrypto engine not found.');
+    return;
+  }
+
+  // --- State ---
+  let activeKeyPair = null;
+  let latestSignedReceipt = null;
+  let latestSignedVoucher = null;
+  let currentVerifierDoc = null;
+
+  // Predefined Coffee Menu
+  const MENU_ITEMS = [
+    { id: 'latte', name: 'Maple Oat Latte', price: 5.50, defaultQty: 1 },
+    { id: 'espresso', name: 'Dark Roast Espresso', price: 3.75, defaultQty: 0 },
+    { id: 'coldbrew', name: 'Artisanal Cold Brew', price: 4.50, defaultQty: 1 },
+    { id: 'croissant', name: 'Warm Almond Croissant', price: 4.00, defaultQty: 1 },
+    { id: 'bun', name: 'Cardamom Cinnamon Bun', price: 4.25, defaultQty: 0 }
+  ];
+
+  // DOM Elements
+  const elKeyAlgoSelect = document.getElementById('key-algo-select');
+  const elBtnGenKeys = document.getElementById('btn-gen-keys');
+  const elBtnExportPub = document.getElementById('btn-export-pub');
+  const elKeyStatusBadge = document.getElementById('key-status-badge');
+  const elKeyIdDisplay = document.getElementById('key-id-display');
+  const elKeyFpDisplay = document.getElementById('key-fp-display');
+  const elKeyPubPreview = document.getElementById('key-pub-preview');
+
+  // Receipt Elements
+  const elReceiptCustomer = document.getElementById('receipt-customer');
+  const elReceiptOrderType = document.getElementById('receipt-order-type');
+  const elReceiptStore = document.getElementById('receipt-store');
+  const elReceiptBarista = document.getElementById('receipt-barista');
+  const elReceiptItemsContainer = document.getElementById('receipt-items-container');
+  const elReceiptSubtotal = document.getElementById('receipt-subtotal');
+  const elReceiptTax = document.getElementById('receipt-tax');
+  const elReceiptTotal = document.getElementById('receipt-total');
+  const elBtnSignReceipt = document.getElementById('btn-sign-receipt');
+  const elReceiptCard = document.getElementById('receipt-card');
+  const elBtnReceiptToVerifier = document.getElementById('btn-receipt-to-verifier');
+  const elBtnCopyReceiptJson = document.getElementById('btn-copy-receipt-json');
+  const elBtnDownloadReceipt = document.getElementById('btn-download-receipt');
+
+  // Voucher Elements
+  const elVoucherRecipient = document.getElementById('voucher-recipient');
+  const elVoucherEmail = document.getElementById('voucher-email');
+  const elVoucherSender = document.getElementById('voucher-sender');
+  const elVoucherMessage = document.getElementById('voucher-message');
+  const elVoucherAmountInput = document.getElementById('voucher-amount-input');
+  const elBtnSignVoucher = document.getElementById('btn-sign-voucher');
+  const elVoucherCard = document.getElementById('voucher-card');
+  const elBtnVoucherToVerifier = document.getElementById('btn-voucher-to-verifier');
+  const elBtnCopyVoucherJson = document.getElementById('btn-copy-voucher-json');
+  const elBtnDownloadVoucher = document.getElementById('btn-download-voucher');
+
+  // Verifier Elements
+  const elVerifierPayloadInput = document.getElementById('verifier-payload-input');
+  const elVerifierPubkeyInput = document.getElementById('verifier-pubkey-input');
+  const elBtnVerifyDoc = document.getElementById('btn-verify-doc');
+  const elBtnTamperTotal = document.getElementById('btn-tamper-total');
+  const elBtnTamperName = document.getElementById('btn-tamper-name');
+  const elBtnResetTamper = document.getElementById('btn-reset-tamper');
+  const elVerificationResult = document.getElementById('verification-result');
+
+  // --- Initialize Keys ---
+  async function initKeys(algo) {
+    elKeyStatusBadge.textContent = 'Generating Keypair...';
+    elKeyStatusBadge.className = 'badge badge-warning';
+
+    activeKeyPair = await Crypto.initializeAuthorityKeys(algo || elKeyAlgoSelect.value);
+
+    elKeyStatusBadge.textContent = 'Active & Secure (' + activeKeyPair.keyType.toUpperCase() + ')';
+    elKeyStatusBadge.className = 'badge badge-success';
+    elKeyIdDisplay.textContent = activeKeyPair.keyId;
+    elKeyFpDisplay.textContent = activeKeyPair.fingerprint;
+
+    const pubString = activeKeyPair.publicJwk
+      ? JSON.stringify(activeKeyPair.publicJwk, null, 2)
+      : JSON.stringify(activeKeyPair.publicKey, null, 2);
+    elKeyPubPreview.textContent = pubString;
+
+    // Refresh any signed documents if already present
+    await signCurrentReceipt();
+    await signCurrentVoucher();
+  }
+
+  // --- Order Calculation ---
+  function calculateOrder() {
+    let subtotal = 0;
+    const items = [];
+    MENU_ITEMS.forEach(item => {
+      const qtyInput = document.getElementById('item-qty-' + item.id);
+      const qty = qtyInput ? parseInt(qtyInput.value, 10) || 0 : 0;
+      if (qty > 0) {
+        const lineTotal = parseFloat((qty * item.price).toFixed(2));
+        subtotal += lineTotal;
+        items.push({
+          id: item.id,
+          name: item.name,
+          unitPrice: item.price,
+          qty: qty,
+          total: lineTotal
+        });
+      }
+    });
+
+    const tax = parseFloat((subtotal * 0.08).toFixed(2));
+    const total = parseFloat((subtotal + tax).toFixed(2));
+
+    elReceiptSubtotal.textContent = '$' + subtotal.toFixed(2);
+    elReceiptTax.textContent = '$' + tax.toFixed(2);
+    elReceiptTotal.textContent = '$' + total.toFixed(2);
+
+    return { items, subtotal, tax, total };
+  }
+
+  function renderMenuItems() {
+    elReceiptItemsContainer.innerHTML = '';
+    MENU_ITEMS.forEach(item => {
+      const row = document.createElement('div');
+      row.className = 'menu-item-row';
+      row.innerHTML = `
+        <div class="menu-item-info">
+          <span class="menu-item-name">${item.name}</span>
+          <span class="menu-item-price">$${item.price.toFixed(2)}</span>
+        </div>
+        <div class="menu-item-qty-wrap">
+          <button type="button" class="qty-btn" data-action="dec" data-id="${item.id}">-</button>
+          <input type="number" id="item-qty-${item.id}" class="qty-input" min="0" max="20" value="${item.defaultQty}" />
+          <button type="button" class="qty-btn" data-action="inc" data-id="${item.id}">+</button>
+        </div>
+      `;
+      elReceiptItemsContainer.appendChild(row);
+    });
+
+    elReceiptItemsContainer.addEventListener('click', (e) => {
+      if (e.target.classList.contains('qty-btn')) {
+        const id = e.target.getAttribute('data-id');
+        const action = e.target.getAttribute('data-action');
+        const input = document.getElementById('item-qty-' + id);
+        if (input) {
+          let val = parseInt(input.value, 10) || 0;
+          if (action === 'inc') val = Math.min(20, val + 1);
+          if (action === 'dec') val = Math.max(0, val - 1);
+          input.value = val;
+          calculateOrder();
+        }
+      }
+    });
+
+    elReceiptItemsContainer.addEventListener('input', () => {
+      calculateOrder();
+    });
+  }
+
+  // --- Sign Coffee Receipt ---
+  async function signCurrentReceipt() {
+    if (!activeKeyPair) return;
+
+    const { items, subtotal, tax, total } = calculateOrder();
+    const receiptData = {
+      receiptId: 'DG-REC-' + new Date().getFullYear() + '-' + Math.floor(10000 + Math.random() * 90000),
+      issuedAt: new Date().toISOString(),
+      storeLocation: elReceiptStore.value,
+      cashier: elReceiptBarista.value,
+      customerName: elReceiptCustomer.value || 'Valued Guest',
+      orderType: elReceiptOrderType.value,
+      items: items.length > 0 ? items : [{ id: 'latte', name: 'Maple Oat Latte', unitPrice: 5.50, qty: 1, total: 5.50 }],
+      subtotal: items.length > 0 ? subtotal : 5.50,
+      tax: items.length > 0 ? tax : 0.44,
+      total: items.length > 0 ? total : 5.94,
+      currency: 'USD',
+      paymentMethod: 'Daily Grind Card •••• 4118'
+    };
+
+    latestSignedReceipt = await Crypto.signCoffeeReceipt(receiptData, activeKeyPair);
+    renderReceiptCard(latestSignedReceipt);
+    return latestSignedReceipt;
+  }
+
+  function renderReceiptCard(signedReceipt) {
+    const p = signedReceipt.payload;
+    const s = signedReceipt.signature;
+
+    const itemsHtml = p.items.map(item => `
+      <div class="receipt-line">
+        <span>${item.qty}x ${item.name}</span>
+        <span>$${item.total.toFixed(2)}</span>
+      </div>
+    `).join('');
+
+    elReceiptCard.innerHTML = `
+      <div class="receipt-header">
+        <div class="receipt-logo">☕ THE DAILY GRIND ☕</div>
+        <div class="receipt-sub">Artisanal Roastery & Café</div>
+        <div class="receipt-meta">${p.storeLocation}</div>
+        <div class="receipt-meta">${p.cashier}</div>
+        <div class="receipt-divider">================================</div>
+      </div>
+      <div class="receipt-body">
+        <div class="receipt-line"><span>RECEIPT #:</span><span><strong>${p.receiptId}</strong></span></div>
+        <div class="receipt-line"><span>DATE:</span><span>${new Date(p.issuedAt).toLocaleString()}</span></div>
+        <div class="receipt-line"><span>CUSTOMER:</span><span>${p.customerName} (${p.orderType})</span></div>
+        <div class="receipt-divider">--------------------------------</div>
+        ${itemsHtml}
+        <div class="receipt-divider">--------------------------------</div>
+        <div class="receipt-line"><span>SUBTOTAL:</span><span>$${p.subtotal.toFixed(2)}</span></div>
+        <div class="receipt-line"><span>TAX (8%):</span><span>$${p.tax.toFixed(2)}</span></div>
+        <div class="receipt-line receipt-total-line"><span>TOTAL:</span><span>$${p.total.toFixed(2)}</span></div>
+        <div class="receipt-line"><span>PAYMENT:</span><span>${p.paymentMethod}</span></div>
+      </div>
+      <div class="receipt-security-seal">
+        <div class="security-badge">
+          <span class="seal-icon">🔒</span>
+          <strong>CRYPTOGRAPHICALLY SIGNED</strong>
+        </div>
+        <div class="seal-meta">Algorithm: <code>${s.algorithm}</code> (${s.keyType})</div>
+        <div class="seal-meta">Signer ID: <code>${s.keyId}</code></div>
+        <div class="seal-meta">Key Fingerprint: <code>${s.keyFingerprint}</code></div>
+        <div class="seal-meta">Signature: <code title="${s.value}">${s.value.substring(0, 32)}...</code></div>
+        <div class="receipt-barcode">|||| | ||||| ||| ||||||| ||| ||||</div>
+      </div>
+    `;
+  }
+
+  // --- Sign Gift Voucher ---
+  async function signCurrentVoucher() {
+    if (!activeKeyPair) return;
+
+    const amount = parseFloat(elVoucherAmountInput.value) || 25.00;
+    const now = new Date();
+    const expiry = new Date(now.getTime() + 365 * 24 * 60 * 60 * 1000);
+
+    const voucherData = {
+      voucherCode: 'DG-VOUCH-' + Math.floor(1000 + Math.random() * 9000) + '-ARTISAN',
+      recipientName: elVoucherRecipient.value || 'Coffee Enthusiast',
+      recipientEmail: elVoucherEmail.value || 'guest@example.com',
+      senderName: elVoucherSender.value || 'The Daily Grind Loyalty Club',
+      message: elVoucherMessage.value || 'Enjoy freshly roasted artisanal coffee on us!',
+      amount: parseFloat(amount.toFixed(2)),
+      currency: 'USD',
+      issuedAt: now.toISOString(),
+      expiresAt: expiry.toISOString(),
+      terms: 'Valid at all Daily Grind locations and online store. Guaranteed authentic via digital signature.'
+    };
+
+    latestSignedVoucher = await Crypto.signGiftVoucher(voucherData, activeKeyPair);
+    renderVoucherCard(latestSignedVoucher);
+    return latestSignedVoucher;
+  }
+
+  function renderVoucherCard(signedVoucher) {
+    const p = signedVoucher.payload;
+    const s = signedVoucher.signature;
+
+    elVoucherCard.innerHTML = `
+      <div class="voucher-top">
+        <div class="voucher-brand">THE DAILY GRIND</div>
+        <div class="voucher-tag">DIGITAL GIFT CARD</div>
+      </div>
+      <div class="voucher-value-box">
+        <span class="currency">$</span>
+        <span class="amount">${p.amount.toFixed(2)}</span>
+        <span class="currency-code">USD</span>
+      </div>
+      <div class="voucher-code">${p.voucherCode}</div>
+      <div class="voucher-details">
+        <div class="v-line"><strong>To:</strong> ${p.recipientName}</div>
+        <div class="v-line"><strong>From:</strong> ${p.senderName}</div>
+        <div class="v-line v-msg"><em>"${p.message}"</em></div>
+        <div class="v-line v-exp">Valid through: ${new Date(p.expiresAt).toLocaleDateString()}</div>
+      </div>
+      <div class="voucher-seal">
+        <div class="seal-badge">
+          <span>🛡️</span> AUTHENTIC ASYMMETRIC DIGITAL SEAL
+        </div>
+        <div class="seal-meta">Algo: <code>${s.algorithm}</code> | Signer: <code>${s.keyId}</code></div>
+        <div class="seal-meta">Fingerprint: <code>${s.keyFingerprint}</code></div>
+      </div>
+    `;
+  }
+
+  // --- Verifier Tool ---
+  function loadIntoVerifier(doc) {
+    currentVerifierDoc = JSON.parse(JSON.stringify(doc));
+    elVerifierPayloadInput.value = JSON.stringify(currentVerifierDoc, null, 2);
+
+    const pubKey = currentVerifierDoc.publicKey;
+    elVerifierPubkeyInput.value = JSON.stringify(pubKey, null, 2);
+
+    elVerificationResult.className = 'verify-status-box';
+    elVerificationResult.innerHTML = `
+      <div class="status-placeholder">
+        Document loaded into verifier. Click <strong>Verify Digital Signature</strong> to inspect cryptographic authenticity and integrity.
+      </div>
+    `;
+
+    // Scroll to verifier section smoothly
+    const verifierSection = document.getElementById('verify-authenticity');
+    if (verifierSection) {
+      verifierSection.scrollIntoView({ behavior: 'smooth' });
+    }
+  }
+
+  async function performVerification() {
+    let docString = elVerifierPayloadInput.value.trim();
+    let pubKeyString = elVerifierPubkeyInput.value.trim();
+
+    if (!docString) {
+      elVerificationResult.className = 'verify-status-box verify-failed';
+      elVerificationResult.innerHTML = `<strong>Error:</strong> Please provide a signed document JSON.`;
+      return;
+    }
+
+    let parsedDoc = null;
+    try {
+      parsedDoc = JSON.parse(docString);
+    } catch (e) {
+      elVerificationResult.className = 'verify-status-box verify-failed';
+      elVerificationResult.innerHTML = `<strong>JSON Parsing Error:</strong> ${e.message}`;
+      return;
+    }
+
+    let overridePubKey = null;
+    if (pubKeyString) {
+      try {
+        overridePubKey = JSON.parse(pubKeyString);
+      } catch (e) {
+        console.warn('Could not parse custom public key JSON, using document key');
+      }
+    }
+
+    const res = await Crypto.verifyDocument(parsedDoc, overridePubKey);
+
+    if (res.valid) {
+      elVerificationResult.className = 'verify-status-box verify-success';
+      elVerificationResult.innerHTML = `
+        <div class="status-header">
+          <span class="status-icon">✓</span>
+          <div class="status-title-group">
+            <h3>AUTHENTIC & UNTAMPERED</h3>
+            <p>Cryptographic asymmetric signature is strictly valid. Document integrity and authenticity are guaranteed.</p>
+          </div>
+        </div>
+        <div class="verify-details-grid">
+          <div class="v-grid-item">
+            <span class="v-label">Document Type:</span>
+            <span class="v-val"><code>${res.documentType.replace(/_/g, ' ').toUpperCase()}</code></span>
+          </div>
+          <div class="v-grid-item">
+            <span class="v-label">Signature Algorithm:</span>
+            <span class="v-val"><code>${res.algorithm}</code> (${res.keyType})</span>
+          </div>
+          <div class="v-grid-item">
+            <span class="v-label">Signer Authority Key ID:</span>
+            <span class="v-val"><code>${res.keyId}</code></span>
+          </div>
+          <div class="v-grid-item">
+            <span class="v-label">Key Fingerprint:</span>
+            <span class="v-val"><code>${res.keyFingerprint}</code></span>
+          </div>
+          <div class="v-grid-item">
+            <span class="v-label">SHA-256 Digest:</span>
+            <span class="v-val"><code>${res.computedDigestSha256.substring(0, 24)}...</code></span>
+          </div>
+          <div class="v-grid-item">
+            <span class="v-label">Verification Time:</span>
+            <span class="v-val"><strong>${res.verificationTimeMs} ms</strong></span>
+          </div>
+        </div>
+        <div class="verify-guarantee-note">
+          Security Guarantee: Signed using an asymmetric private key. The payload has not undergone even a single bit of modification since issuance.
+        </div>
+      `;
+    } else {
+      elVerificationResult.className = 'verify-status-box verify-failed';
+      elVerificationResult.innerHTML = `
+        <div class="status-header">
+          <span class="status-icon">✕</span>
+          <div class="status-title-group">
+            <h3>SIGNATURE VERIFICATION FAILED!</h3>
+            <p>TAMPERING DETECTED OR INVALID SIGNATURE: Document integrity has been compromised or signed with an unauthorized key.</p>
+          </div>
+        </div>
+        <div class="verify-failure-body">
+          <p><strong>Reason:</strong> ${res.error}</p>
+          <div class="verify-details-grid">
+            <div class="v-grid-item">
+              <span class="v-label">Computed SHA-256 Digest:</span>
+              <span class="v-val"><code>${res.computedDigestSha256 ? res.computedDigestSha256.substring(0, 24) + '...' : 'N/A'}</code></span>
+            </div>
+            <div class="v-grid-item">
+              <span class="v-label">Original Signed Digest:</span>
+              <span class="v-val"><code>${res.originalDigestSha256 ? res.originalDigestSha256.substring(0, 24) + '...' : 'N/A'}</code></span>
+            </div>
+            <div class="v-grid-item">
+              <span class="v-label">Digest Integrity Match:</span>
+              <span class="v-val" style="color: #d32f2f;"><strong>${res.digestMatches ? 'YES' : 'NO (Payload Altered!)'}</strong></span>
+            </div>
+          </div>
+        </div>
+      `;
+    }
+  }
+
+  // --- Tampering Simulation ---
+  function tamperWithDocument(tamperFn) {
+    let docString = elVerifierPayloadInput.value.trim();
+    if (!docString) return;
+
+    try {
+      const doc = JSON.parse(docString);
+      tamperFn(doc);
+      elVerifierPayloadInput.value = JSON.stringify(doc, null, 2);
+      performVerification();
+    } catch (e) {
+      alert('Could not tamper: ' + e.message);
+    }
+  }
+
+  // --- Event Listeners ---
+  elKeyAlgoSelect.addEventListener('change', () => {
+    initKeys(elKeyAlgoSelect.value);
+  });
+
+  elBtnGenKeys.addEventListener('click', () => {
+    initKeys(elKeyAlgoSelect.value);
+  });
+
+  elBtnExportPub.addEventListener('click', () => {
+    if (!activeKeyPair) return;
+    const pub = activeKeyPair.publicJwk || activeKeyPair.publicKey;
+    const blob = new Blob([JSON.stringify(pub, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = activeKeyPair.keyId + '-public-key.json';
+    a.click();
+    URL.revokeObjectURL(url);
+  });
+
+  elBtnSignReceipt.addEventListener('click', async () => {
+    await signCurrentReceipt();
+  });
+
+  elBtnReceiptToVerifier.addEventListener('click', () => {
+    if (latestSignedReceipt) {
+      loadIntoVerifier(latestSignedReceipt);
+    }
+  });
+
+  elBtnCopyReceiptJson.addEventListener('click', () => {
+    if (latestSignedReceipt) {
+      navigator.clipboard.writeText(JSON.stringify(latestSignedReceipt, null, 2))
+        .then(() => alert('Signed receipt JSON copied to clipboard!'))
+        .catch(() => prompt('Copy JSON:', JSON.stringify(latestSignedReceipt)));
+    }
+  });
+
+  elBtnDownloadReceipt.addEventListener('click', () => {
+    if (!latestSignedReceipt) return;
+    const blob = new Blob([JSON.stringify(latestSignedReceipt, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = latestSignedReceipt.payload.receiptId + '.json';
+    a.click();
+    URL.revokeObjectURL(url);
+  });
+
+  elBtnSignVoucher.addEventListener('click', async () => {
+    await signCurrentVoucher();
+  });
+
+  elBtnVoucherToVerifier.addEventListener('click', () => {
+    if (latestSignedVoucher) {
+      loadIntoVerifier(latestSignedVoucher);
+    }
+  });
+
+  elBtnCopyVoucherJson.addEventListener('click', () => {
+    if (latestSignedVoucher) {
+      navigator.clipboard.writeText(JSON.stringify(latestSignedVoucher, null, 2))
+        .then(() => alert('Signed voucher JSON copied to clipboard!'))
+        .catch(() => prompt('Copy JSON:', JSON.stringify(latestSignedVoucher)));
+    }
+  });
+
+  elBtnDownloadVoucher.addEventListener('click', () => {
+    if (!latestSignedVoucher) return;
+    const blob = new Blob([JSON.stringify(latestSignedVoucher, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = latestSignedVoucher.payload.voucherCode + '.json';
+    a.click();
+    URL.revokeObjectURL(url);
+  });
+
+  // Voucher amount quick buttons
+  document.querySelectorAll('.amount-preset-btn').forEach(btn => {
+    btn.addEventListener('click', () => {
+      document.querySelectorAll('.amount-preset-btn').forEach(b => b.classList.remove('active'));
+      btn.classList.add('active');
+      const amt = btn.getAttribute('data-amount');
+      elVoucherAmountInput.value = amt;
+      signCurrentVoucher();
+    });
+  });
+
+  elBtnVerifyDoc.addEventListener('click', performVerification);
+
+  elBtnTamperTotal.addEventListener('click', () => {
+    tamperWithDocument(doc => {
+      if (doc.payload && doc.payload.total !== undefined) {
+        doc.payload.total = 0.50; // Change to $0.50
+      } else if (doc.payload && doc.payload.amount !== undefined) {
+        doc.payload.amount = 500.00; // Change voucher amount to $500
+      }
+    });
+  });
+
+  elBtnTamperName.addEventListener('click', () => {
+    tamperWithDocument(doc => {
+      if (doc.payload && doc.payload.customerName) {
+        doc.payload.customerName = 'Mallory Malicious';
+      } else if (doc.payload && doc.payload.recipientName) {
+        doc.payload.recipientName = 'Eve Attacker';
+      }
+    });
+  });
+
+  elBtnResetTamper.addEventListener('click', () => {
+    if (currentVerifierDoc) {
+      loadIntoVerifier(currentVerifierDoc);
+    }
+  });
+
+  // Mode selectors for Verifier
+  document.getElementById('tab-verify-receipt').addEventListener('click', (e) => {
