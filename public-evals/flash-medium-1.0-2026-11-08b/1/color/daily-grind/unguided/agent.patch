+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theme-toggle');
+      if (!toggleBtn) return;
+
+      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function applyTheme(theme) {
+        if (theme === 'dark') {
+          document.documentElement.setAttribute('data-theme', 'dark');
+        } else if (theme === 'light') {
+          document.documentElement.setAttribute('data-theme', 'light');
+        } else {
+          document.documentElement.removeAttribute('data-theme');
+        }
+      }
+
+      // Check saved setting
+      const savedTheme = localStorage.getItem('daily-grind-theme');
+      if (savedTheme) {
+        applyTheme(savedTheme);
+      }
+
+      toggleBtn.addEventListener('click', function () {
+        const currentExplicit = document.documentElement.getAttribute('data-theme');
+        let nextTheme;
+        if (currentExplicit) {
+          nextTheme = currentExplicit === 'dark' ? 'light' : 'dark';
+        } else {
+          nextTheme = prefersDark.matches ? 'light' : 'dark';
+        }
+        applyTheme(nextTheme);
+        localStorage.setItem('daily-grind-theme', nextTheme);
+      });
+
+      prefersDark.addEventListener('change', function (e) {
+        if (!localStorage.getItem('daily-grind-theme')) {
+          document.documentElement.removeAttribute('data-theme');
+        }
+      });
+    })();
+  </script>
+
