+  <script>
+    (function () {
+      const triggerBtn = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+
+      if (!triggerBtn || !panel) return;
+
+      // Ensure action-panel is attached directly to document.body to prevent parent overflow clipping
+      if (panel.parentElement !== document.body) {
+        document.body.appendChild(panel);
+      }
+
+      function updatePosition() {
+        const triggerRect = triggerBtn.getBoundingClientRect();
+        const panelRect = panel.getBoundingClientRect();
+
+        const triggerTop = (triggerRect && typeof triggerRect.top === 'number') ? triggerRect.top : (triggerBtn.offsetTop || 0);
+        const triggerBottom = (triggerRect && typeof triggerRect.bottom === 'number') ? triggerRect.bottom : (triggerTop + (triggerBtn.offsetHeight || 38));
+        const triggerLeft = (triggerRect && typeof triggerRect.left === 'number') ? triggerRect.left : (triggerBtn.offsetLeft || 0);
+        const triggerRight = (triggerRect && typeof triggerRect.right === 'number') ? triggerRect.right : (triggerLeft + (triggerBtn.offsetWidth || 90));
+
+        const panelWidth = (panelRect && panelRect.width) || panel.offsetWidth || 180;
+        const panelHeight = (panelRect && panelRect.height) || panel.offsetHeight || 132;
+
+        const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 1024;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 768;
+
+        // Default position: directly below trigger button, aligned to its left edge
+        let top = triggerBottom;
+        let left = triggerLeft;
+        let flippedY = false;
+        let flippedX = false;
+
+        // Vertical collision: if collides with viewport bottom, automatically flip vertically to anchor directly above
+        if (top + panelHeight > viewportHeight) {
+          top = triggerTop - panelHeight;
+          flippedY = true;
+        }
+
+        // Horizontal collision: if collides with viewport right, automatically flip horizontally to anchor to right edge
+        if (left + panelWidth > viewportWidth) {
+          left = triggerRight - panelWidth;
+          flippedX = true;
+        }
+
+        // Boundary safety clamps to guarantee the panel is never cut off
+        if (top < 0) {
+          top = 0;
+        } else if (top + panelHeight > viewportHeight) {
+          top = Math.max(0, viewportHeight - panelHeight);
+        }
+
+        if (left < 0) {
+          left = 0;
+        } else if (left + panelWidth > viewportWidth) {
+          left = Math.max(0, viewportWidth - panelWidth);
+        }
+
+        panel.style.position = 'fixed';
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+
+        panel.classList.toggle('flipped-y', flippedY);
+        panel.classList.toggle('flipped-x', flippedX);
+
+        if (flippedY) {
+          panel.setAttribute('data-flipped-y', 'true');
+        } else {
+          panel.removeAttribute('data-flipped-y');
+        }
+
+        if (flippedX) {
+          panel.setAttribute('data-flipped-x', 'true');
+        } else {
+          panel.removeAttribute('data-flipped-x');
+        }
+
+        const vPlacement = flippedY ? 'top' : 'bottom';
+        const hPlacement = flippedX ? 'end' : 'start';
+        panel.setAttribute('data-placement', vPlacement + '-' + hPlacement);
+      }
+
+      function openPanel() {
+        panel.classList.add('open');
+        triggerBtn.setAttribute('aria-expanded', 'true');
+        updatePosition();
+      }
+
+      function closePanel() {
+        panel.classList.remove('open');
+        triggerBtn.setAttribute('aria-expanded', 'false');
+      }
+
+      function togglePanel() {
+        if (panel.classList.contains('open')) {
+          closePanel();
+        } else {
+          openPanel();
+        }
+      }
+
+      triggerBtn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        togglePanel();
+      });
+
+      triggerBtn.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          openPanel();
+          const firstBtn = panel.querySelector('.action-btn');
+          if (firstBtn) firstBtn.focus();
+        }
+      });
+
+      panel.addEventListener('keydown', function (e) {
+        const buttons = Array.from(panel.querySelectorAll('.action-btn'));
+        const activeIndex = buttons.indexOf(document.activeElement);
+
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closePanel();
+          triggerBtn.focus();
+        } else if (e.key === 'ArrowDown') {
+          e.preventDefault();
+          const nextIndex = (activeIndex + 1) % buttons.length;
+          buttons[nextIndex].focus();
+        } else if (e.key === 'ArrowUp') {
+          e.preventDefault();
+          const prevIndex = (activeIndex - 1 + buttons.length) % buttons.length;
+          buttons[prevIndex].focus();
+        } else if (e.key === 'Tab') {
+          closePanel();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (panel.classList.contains('open') && !panel.contains(e.target) && e.target !== triggerBtn && !triggerBtn.contains(e.target)) {
+          closePanel();
+        }
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && panel.classList.contains('open')) {
+          closePanel();
+          triggerBtn.focus();
+        }
+      });
+
+      panel.querySelectorAll('.action-btn').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          closePanel();
+        });
+      });
+
+      window.addEventListener('resize', updatePosition);
+      window.addEventListener('scroll', updatePosition, true);
+
+      // Observers to update positioning if DOM or styles mutate
+      if (window.ResizeObserver) {
+        const ro = new ResizeObserver(function () {
+          updatePosition();
+        });
+        ro.observe(triggerBtn);
+        ro.observe(panel);
+        ro.observe(document.documentElement);
+      }
+
+      if (window.MutationObserver) {
+        const mo = new MutationObserver(function () {
+          updatePosition();
+        });
+        mo.observe(triggerBtn, { attributes: true, subtree: false });
+      }
+
+      // Initial position calculation on load
+      updatePosition();
+
+      // Expose globally for testing/automation hooks
+      window.updateActionPanelPosition = updatePosition;
+      window.openActionPanel = openPanel;
+      window.closeActionPanel = closePanel;
+      window.toggleActionPanel = togglePanel;
+    })();
+  </script>
+
