+    /* Spring effect: overshoots target scale and settles like a real spring */
+    .card.spring,
+    .spring {
+      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
+      will-change: transform;
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within,
+    .spring:hover,
+    .spring:focus-within {
+      transform: scale(1.05);
+      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
+    }
+
+    /* Bounce effect: playful bounce animation on hover */
+    @keyframes bounce {
+      0%, 100% {
+        transform: translateY(0);
+      }
+      20% {
+        transform: translateY(-12px);
+      }
+      40% {
+        transform: translateY(0);
+      }
+      60% {
+        transform: translateY(-6px);
+      }
+      80% {
+        transform: translateY(0);
+      }
+    }
+
+    .card.bounce,
+    .bounce {
+      transition: transform 0.3s ease, box-shadow 0.3s ease;
+      will-change: transform;
+    }
+
+    .card.bounce:hover,
+    .card.bounce:focus-within,
+    .bounce:hover,
+    .bounce:focus-within {
+      animation: bounce 0.6s ease-in-out;
+      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
+    }
+
+    /* Accessibility: Respect prefers-reduced-motion */
+    @media (prefers-reduced-motion: reduce) {
+      .card,
+      .card.spring,
+      .card.bounce,
+      .spring,
+      .bounce {
+        transition: none !important;
+        animation: none !important;
+        transform: none !important;
+      }
+
+      .card.spring:hover,
+      .card.spring:focus-within,
+      .card.bounce:hover,
+      .card.bounce:focus-within,
+      .spring:hover,
+      .spring:focus-within,
+      .bounce:hover,
+      .bounce:focus-within {
+        transform: none !important;
+        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+      }
+    }
