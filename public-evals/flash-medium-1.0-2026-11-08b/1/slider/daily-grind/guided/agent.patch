+  <script>
+    (function () {
+      const STRENGTHS = [
+        {
+          name: "Mild",
+          title: "Mild Roast",
+          desc: "Light and delicate with vibrant floral and citrus notes. Gentle acidity for an easy-drinking cup.",
+          rec: "Pour-over, Chemex",
+          icon: "🌱"
+        },
+        {
+          name: "Medium",
+          title: "Medium Roast",
+          desc: "Smooth, balanced, and rounded with notes of milk chocolate, toasted hazelnut, and caramel sweetness.",
+          rec: "Classic Drip, Aeropress",
+          icon: "☕"
+        },
+        {
+          name: "Bold",
+          title: "Bold Roast",
+          desc: "Rich, full-bodied, and robust with deep dark cacao, molasses, and a satisfying, lingering finish.",
+          rec: "French Press, Moka Pot",
+          icon: "🔥"
+        },
+        {
+          name: "Extra Bold",
+          title: "Extra Bold Roast",
+          desc: "Intense, smoky, and deeply concentrated. Maximum roast depth for an uncompromising morning jolt.",
+          rec: "Double Espresso, Cold Brew",
+          icon: "⚡"
+        }
+      ];
+
+      const slider = document.getElementById("brew-strength-slider");
+      const display = document.getElementById("strength-display");
+      const titleEl = document.getElementById("strength-title");
+      const descEl = document.getElementById("strength-desc");
+      const recEl = document.getElementById("strength-rec");
+      const iconEl = document.getElementById("strength-icon");
+      const stepBtns = document.querySelectorAll(".step-btn");
+
+      function syncSlider() {
+        if (!slider) return;
+        const val = parseInt(slider.value, 10);
+        const idx = Math.min(Math.max(isNaN(val) ? 1 : val, 0), STRENGTHS.length - 1);
+        const strength = STRENGTHS[idx];
+
+        // Sync CSS custom properties for track fill & progress computation
+        slider.style.setProperty("--control-value", idx);
+        slider.style.setProperty("--attr-min", slider.min || "0");
+        slider.style.setProperty("--attr-max", slider.max || "3");
+
+        // Accessibility: update aria attributes
+        slider.setAttribute("aria-valuenow", idx);
+        slider.setAttribute("aria-valuetext", strength.name);
+
+        // Update visual display elements
+        if (display) display.textContent = strength.name;
+        if (titleEl) titleEl.textContent = strength.title;
+        if (descEl) descEl.textContent = strength.desc;
+        if (recEl) recEl.textContent = strength.rec;
+        if (iconEl) iconEl.textContent = strength.icon;
+
+        // Update step buttons active states
+        stepBtns.forEach((btn, i) => {
+          const isActive = i === idx;
+          btn.classList.toggle("active", isActive);
+          btn.setAttribute("aria-current", isActive ? "true" : "false");
+        });
+      }
+
+      if (slider) {
+        slider.addEventListener("input", syncSlider);
+        slider.addEventListener("change", syncSlider);
+
+        // Allow clicking on named strength labels to jump directly to that step
+        stepBtns.forEach((btn) => {
+          btn.addEventListener("click", () => {
+            const targetIndex = btn.getAttribute("data-index");
+            if (targetIndex !== null) {
+              slider.value = targetIndex;
+              syncSlider();
+              slider.focus();
+            }
+          });
+        });
+
+        // Initialize state
+        syncSlider();
+      }
+    })();
+  </script>
