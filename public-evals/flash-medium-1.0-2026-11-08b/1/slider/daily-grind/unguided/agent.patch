+  <script>
+    (function () {
+      const STRENGTHS = [
+        {
+          name: 'Mild',
+          roast: 'Light Roast',
+          flavor: 'Jasmine, Sweet Citrus, Golden Honey',
+          method: 'Pour Over / Chemex',
+          caffeine: 'Gentle & Uplifting',
+          description: 'A delicate and bright roast preserving the bean’s origin flavors with refreshing acidity and crisp floral aromatics.',
+          dots: 1,
+          cta: 'Order Mild Roast'
+        },
+        {
+          name: 'Medium',
+          roast: 'Medium Roast',
+          flavor: 'Milk Chocolate, Toasted Caramel, Hazelnut',
+          method: 'Drip Coffee / Aeropress',
+          caffeine: 'Balanced & Smooth',
+          description: 'Our signature everyday roast with a rich, harmonious body, pleasant sweetness, and a silky chocolate finish.',
+          dots: 2,
+          cta: 'Order Medium Roast'
+        },
+        {
+          name: 'Bold',
+          roast: 'Dark Roast',
+          flavor: 'Dark Cocoa, Roasted Walnut, Warm Spices',
+          method: 'French Press / Espresso',
+          caffeine: 'Strong & Robust',
+          description: 'Full-bodied and deeply aromatic with low acidity and rich, lingering cocoa notes that cut through milk beautifully.',
+          dots: 3,
+          cta: 'Order Bold Roast'
+        },
+        {
+          name: 'Extra Bold',
+          roast: 'French Dark Roast',
+          flavor: 'Smoky Oak, Bittersweet Cacao, Molasses',
+          method: 'Moka Pot / Cold Brew Concentrate',
+          caffeine: 'Maximum Intensity',
+          description: 'An intense, unapologetic roast crafted for serious coffee lovers. Smoky, thick crema, and a powerful punch to start your day.',
+          dots: 4,
+          cta: 'Order Extra Bold Roast'
+        }
+      ];
+
+      const slider = document.getElementById('brew-strength-slider');
+      const display = document.getElementById('strength-display');
+      const dotsContainer = document.getElementById('intensity-dots');
+      const detailRoast = document.getElementById('detail-roast');
+      const detailFlavor = document.getElementById('detail-flavor');
+      const detailMethod = document.getElementById('detail-method');
+      const detailCaffeine = document.getElementById('detail-caffeine');
+      const detailDesc = document.getElementById('detail-description');
+      const detailCta = document.getElementById('strength-cta');
+      const stepBtns = document.querySelectorAll('.step-btn');
+
+      function updateStrength(index) {
+        const idx = Math.max(0, Math.min(STRENGTHS.length - 1, parseInt(index, 10) || 0));
+        const strength = STRENGTHS[idx];
+        const percent = (idx / (STRENGTHS.length - 1)) * 100;
+
+        // Update slider value & fill progress CSS variable
+        slider.value = idx;
+        slider.style.setProperty('--fill-progress', percent + '%');
+        slider.setAttribute('aria-valuenow', idx);
+        slider.setAttribute('aria-valuetext', strength.name);
+
+        // Update text displays
+        if (display) display.textContent = strength.name;
+        if (detailRoast) detailRoast.textContent = strength.roast;
+        if (detailFlavor) detailFlavor.textContent = strength.flavor;
+        if (detailMethod) detailMethod.textContent = strength.method;
+        if (detailCaffeine) detailCaffeine.textContent = strength.caffeine;
+        if (detailDesc) detailDesc.textContent = strength.description;
+        if (detailCta) {
+          detailCta.textContent = strength.cta;
+          detailCta.href = '/menu/' + encodeURIComponent(strength.name.toLowerCase().replace(/\s+/g, '-'));
+        }
+
+        // Update intensity dots
+        if (dotsContainer) {
+          const dots = dotsContainer.querySelectorAll('.dot');
+          dots.forEach((dot, i) => {
+            if (i < strength.dots) {
+              dot.classList.add('active');
+            } else {
+              dot.classList.remove('active');
+            }
+          });
+          dotsContainer.setAttribute('aria-label', `Intensity ${strength.dots} of 4`);
+        }
+
+        // Update step buttons active state
+        stepBtns.forEach((btn, i) => {
+          const isActive = (i === idx);
+          btn.classList.toggle('active', isActive);
+          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
+        });
+      }
+
+      slider.addEventListener('input', (e) => {
+        updateStrength(e.target.value);
+      });
+
+      slider.addEventListener('change', (e) => {
+        updateStrength(e.target.value);
+      });
+
+      stepBtns.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const step = btn.getAttribute('data-step');
+          updateStrength(step);
+        });
+      });
+
+      // Initialize
+      updateStrength(slider.value);
+    })();
+  </script>
+
 </body>
 
