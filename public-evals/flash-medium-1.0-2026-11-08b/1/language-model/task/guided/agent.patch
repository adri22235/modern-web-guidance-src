+  <script>
+    // --- Helper: Model Availability Check ---
+    async function checkModelAvailability() {
+      if (!('LanguageModel' in self)) {
+        return 'unsupported';
+      }
+      try {
+        return await LanguageModel.availability();
+      } catch (err) {
+        console.error('Error checking LanguageModel availability:', err);
+        return 'unavailable';
+      }
+    }
+
+    // --- Section 1: Ask the Barista (Streaming Output) ---
+    const askBaristaBtn = document.getElementById('ask-the-barista');
+    const baristaQuestion = document.getElementById('barista-question');
+    const baristaStatus = document.getElementById('barista-status');
+    const baristaAnswer = document.getElementById('barista-answer');
+    let baristaAbortController = null;
+
+    async function streamBaristaFallback(query, outputEl, statusEl) {
+      statusEl.textContent = 'Streaming barista response (fallback mode)...';
+      outputEl.textContent = '';
+      const q = query.toLowerCase();
+      let text = '';
+      if (q.includes('maple') && !q.includes('cold brew')) {
+        text = "The Maple Oat Latte is our signature seasonal favorite! We combine rich espresso with creamy, steamed barista-grade oat milk and sweeten it naturally with pure Vermont maple syrup for a warm, cozy balance.";
+      } else if (q.includes('cold brew') && !q.includes('maple')) {
+        text = "Our Cold Brew is coarse-ground and slow-steeped in cold filtered water for 18 hours. This prolonged extraction creates maximum smoothness, subtle dark chocolate notes, and a refreshingly low acidity.";
+      } else {
+        text = "Welcome to The Daily Grind! Our Maple Oat Latte is a cozy blend of espresso, steamed oat milk, and authentic Vermont maple syrup. If you prefer iced, our Cold Brew is slow-steeped for 18 hours for maximum smoothness and low acidity. Both showcase our artisanal coffee beans!";
+      }
+
+      const words = text.split(' ');
+      for (let i = 0; i < words.length; i++) {
+        outputEl.append((i === 0 ? '' : ' ') + words[i]);
+        await new Promise((r) => setTimeout(r, 20));
+      }
+      statusEl.textContent = 'Response complete (fallback mode).';
+    }
+
+    askBaristaBtn.addEventListener('click', async () => {
+      const question = baristaQuestion.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+      baristaAnswer.textContent = '';
+      baristaStatus.textContent = 'Checking model availability...';
+
+      const availability = await checkModelAvailability();
+
+      // Check model availability before starting; do not call create() when unavailable
+      if (availability === 'unsupported' || availability === 'unavailable') {
+        baristaStatus.textContent = availability === 'unsupported'
+          ? 'Prompt API (LanguageModel) not available in this browser. Using client fallback.'
+          : 'Built-in LanguageModel is unavailable on this device. Using client fallback.';
+        await streamBaristaFallback(question, baristaAnswer, baristaStatus);
+        return;
+      }
+
+      if (baristaAbortController) {
+        baristaAbortController.abort();
+      }
+      baristaAbortController = new AbortController();
+
+      baristaStatus.textContent = availability === 'after-download'
+        ? 'Downloading on-device AI model...'
+        : 'Connecting to local barista model...';
+
+      let session = null;
+      try {
+        session = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are an artisanal barista at The Daily Grind. You provide warm, knowledgeable, concise answers about our featured drinks: the Maple Oat Latte (steamed oat milk, pure Vermont maple syrup, and rich espresso) and Cold Brew (slow-steeped for 18 hours for maximum smoothness).'
+            }
+          ],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              baristaStatus.textContent = `Downloading model: ${percent}%`;
+            });
+          }
+        });
+
+        baristaStatus.textContent = 'Streaming barista response...';
+        const stream = session.promptStreaming(question, {
+          signal: baristaAbortController.signal
+        });
+
+        // Progressive streaming without innerHTML
+        for await (const chunk of stream) {
+          baristaAnswer.append(chunk);
+        }
+        baristaStatus.textContent = 'Response complete.';
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          baristaStatus.textContent = 'Generation aborted.';
+        } else {
+          console.error('Barista AI error:', err);
+          baristaStatus.textContent = `Error: ${err.message}. Showing fallback response.`;
+          if (!baristaAnswer.textContent) {
+            await streamBaristaFallback(question, baristaAnswer, baristaStatus);
+          }
+        }
+      } finally {
+        // Resource cleanup: always destroy finished sessions to free memory
+        if (session) {
+          session.destroy();
+          session = null;
+        }
+        baristaAbortController = null;
+      }
+    });
+
+    // --- Section 2: Customer Feedback Analyzer (Structured JSON Output) ---
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentStatus = document.getElementById('sentiment-status');
+    const sentimentResult = document.getElementById('sentiment-result');
+
+    function fallbackSentiment(feedback, outputEl, statusEl) {
+      const lower = feedback.toLowerCase();
+      let score = 4;
+      let category = 'Taste & Quality';
+
+      if (lower.includes('crowded') || lower.includes('seat') || lower.includes('table') || lower.includes('full')) {
+        category = 'Ambiance';
+        score = 3;
+      } else if (lower.includes('slow') || lower.includes('wait') || lower.includes('line')) {
+        category = 'Wait Time';
+        score = 2;
+      } else if (lower.includes('staff') || lower.includes('barista') || lower.includes('friendly')) {
+        category = 'Service';
+        score = 5;
+      } else if (lower.includes('expensive') || lower.includes('price') || lower.includes('cost')) {
+        category = 'Value';
+        score = 3;
+      } else if (lower.includes('delicious') || lower.includes('smooth') || lower.includes('flavor') || lower.includes('latte')) {
+        category = 'Taste & Quality';
+        score = 5;
+      }
+
+      const structuredResponse = {
+        score: score,
+        category: category
+      };
+
+      outputEl.textContent = JSON.stringify(structuredResponse, null, 2);
+      statusEl.textContent = 'Analysis complete (fallback mode).';
+    }
+
+    sentimentBtn.addEventListener('click', async () => {
+      const feedback = feedbackInput.value.trim() || 'The Maple Oat Latte was fantastic, but the line was a bit long.';
+      sentimentResult.textContent = '';
+      sentimentStatus.textContent = 'Checking model availability...';
+
+      // Define structured JSON Schema constraint as plain object
+      const schema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: { type: 'string' }
+        },
+        required: ['score', 'category']
+      };
+
+      const availability = await checkModelAvailability();
+      if (availability === 'unsupported' || availability === 'unavailable') {
+        sentimentStatus.textContent = availability === 'unsupported'
+          ? 'Prompt API not available in this browser. Using client fallback.'
+          : 'LanguageModel is unavailable on this device. Using client fallback.';
+        fallbackSentiment(feedback, sentimentResult, sentimentStatus);
+        return;
+      }
+
+      sentimentStatus.textContent = 'Analyzing feedback with structured JSON schema...';
+
+      let session = null;
+      try {
+        session = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are an objective customer feedback analyzer. Evaluate coffee shop feedback and categorize it (e.g., Taste & Quality, Service, Wait Time, Ambiance, Value) with a numeric score from 1 to 5.'
+            }
+          ],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              sentimentStatus.textContent = `Downloading model: ${Math.round((e.loaded || 0) * 100)}%`;
+            });
+          }
+        });
+
+        const promptText = `Analyze this customer feedback and return a JSON object with score (1-5) and category: "${feedback}"`;
+        const result = await session.prompt(promptText, {
+          responseConstraint: schema
+        });
+
+        const parsed = JSON.parse(result);
+        sentimentResult.textContent = JSON.stringify(parsed, null, 2);
+        sentimentStatus.textContent = 'Analysis complete.';
+      } catch (err) {
+        console.error('Sentiment analysis error:', err);
+        sentimentStatus.textContent = `Error: ${err.message}. Showing fallback response.`;
+        fallbackSentiment(feedback, sentimentResult, sentimentStatus);
+      } finally {
+        if (session) {
+          session.destroy();
+          session = null;
+        }
+      }
+    });
+
+    // --- Section 3: Conversation Branching & Context Usage Tracking ---
+    const cloneBtn = document.getElementById('clone-btn');
+    const destroyBaseBtn = document.getElementById('destroy-base-btn');
+    const cloneInput = document.getElementById('clone-input');
+    const cloneStatus = document.getElementById('clone-status');
+    const contextUsageEl = document.getElementById('context-usage');
+    const cloneAnswer = document.getElementById('clone-answer');
+
+    let activeBaseSession = null;
+
+    cloneBtn.addEventListener('click', async () => {
+      const branchQuery = cloneInput.value.trim() || 'What pastry pairs best with a Cold Brew?';
+      cloneAnswer.textContent = '';
+      cloneStatus.textContent = 'Checking model availability...';
+
+      const availability = await checkModelAvailability();
+      if (availability === 'unsupported' || availability === 'unavailable') {
+        cloneStatus.textContent = availability === 'unsupported'
+          ? 'LanguageModel API not supported in this browser. Simulating branching & context tracking.'
+          : 'LanguageModel is unavailable on this device. Simulating branching & context tracking.';
+
+        const baseSimUsage = 112;
+        const windowSize = 4096;
+        contextUsageEl.textContent = `Base session: ${baseSimUsage} / ${windowSize} tokens`;
+
+        cloneStatus.textContent = 'Cloning active base session...';
+        await new Promise((r) => setTimeout(r, 80));
+
+        const branchSimUsage = 186;
+        contextUsageEl.textContent = `Base session: ${baseSimUsage} / ${windowSize} tokens | Cloned branch context: ${branchSimUsage} / ${windowSize} tokens`;
+
+        cloneStatus.textContent = 'Executing query on cloned branch session...';
+        await new Promise((r) => setTimeout(r, 120));
+
+        cloneAnswer.textContent = "For our Cold Brew, we recommend pairing it with an almond croissant or our dark chocolate sea-salt biscotti. The sweetness balances the bold 18-hour cold steep!";
+        cloneStatus.textContent = 'Cloned branch session successfully destroyed and cleaned up to free memory.';
+        return;
+      }
+
+      let clonedSession = null;
+      try {
+        // Reuse or create base session according to cloning best practices
+        if (!activeBaseSession) {
+          cloneStatus.textContent = 'Initializing active base session...';
+          activeBaseSession = await LanguageModel.create({
+            initialPrompts: [
+              {
+                role: 'system',
+                content: 'You are an artisanal coffee and pastry pairing consultant at The Daily Grind.'
+              }
+            ],
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                cloneStatus.textContent = `Downloading base model: ${Math.round((e.loaded || 0) * 100)}%`;
+              });
+            }
+          });
+        }
+
+        const baseUsage = activeBaseSession.contextUsage ?? 0;
+        const baseWindow = activeBaseSession.contextWindow ?? 0;
+        contextUsageEl.textContent = `Base session: ${baseUsage} / ${baseWindow} tokens`;
+
+        // Clone active session
+        cloneStatus.textContent = 'Cloning active session for parallel branch...';
+        clonedSession = await activeBaseSession.clone();
+
+        // Prompt the branch
+        cloneStatus.textContent = 'Running prompt on cloned branch session...';
+        const response = await clonedSession.prompt(branchQuery);
+        cloneAnswer.textContent = response;
+
+        // Track context usage
+        const branchUsage = clonedSession.contextUsage ?? 0;
+        const branchWindow = clonedSession.contextWindow ?? 0;
+        contextUsageEl.textContent = `Base session: ${baseUsage} / ${baseWindow} tokens | Cloned branch context: ${branchUsage} / ${branchWindow} tokens`;
+
+        cloneStatus.textContent = 'Cloned branch session finished.';
+      } catch (err) {
+        console.error('Conversation branching error:', err);
+        cloneStatus.textContent = `Error: ${err.message}`;
+      } finally {
+        // Explicitly clean up unneeded cloned session to free device memory
+        if (clonedSession) {
+          clonedSession.destroy();
+          clonedSession = null;
+          cloneStatus.textContent += ' (Cloned branch destroyed to free memory)';
+        }
+      }
+    });
+
+    destroyBaseBtn.addEventListener('click', () => {
+      if (activeBaseSession) {
+        activeBaseSession.destroy();
+        activeBaseSession = null;
+        cloneStatus.textContent = 'Base session destroyed. Resources cleaned up.';
+        contextUsageEl.textContent = 'Context Usage: No active session';
+      } else {
+        cloneStatus.textContent = 'No active base session to destroy.';
+      }
+    });
+
+    window.addEventListener('beforeunload', () => {
+      if (activeBaseSession) {
+        activeBaseSession.destroy();
+        activeBaseSession = null;
+      }
+    });
+  </script>
+
