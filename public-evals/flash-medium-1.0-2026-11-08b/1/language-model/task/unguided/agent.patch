+      let currentAbortController = null;
+
+      const askBaristaBtn = document.getElementById('ask-the-barista');
+      const baristaAnswer = document.getElementById('barista-answer');
+      const baristaQuery = document.getElementById('barista-query');
+      const baristaAbortBtn = document.getElementById('barista-abort-btn');
+      const downloadProgressContainer = document.getElementById('download-progress-container');
+      const downloadProgressBar = document.getElementById('download-progress-bar');
+      const downloadProgressText = document.getElementById('download-progress-text');
+
+      if (askBaristaBtn) {
+        askBaristaBtn.addEventListener('click', async () => {
+          const query = baristaQuery.value.trim();
+          if (!query) {
+            baristaAnswer.textContent = 'Please enter a question about our Maple Oat Latte or Cold Brew.';
+            return;
+          }
+
+          // 1. Mandatory check: verify model availability before starting
+          const availability = await checkModelAvailability();
+          if (availability === 'no' || availability === 'unavailable') {
+            baristaAnswer.textContent = 'Local AI Model is unavailable in this browser. Please enable the Prompt API flag in chrome://flags.';
+            return;
+          }
+
+          askBaristaBtn.disabled = true;
+          if (baristaAbortBtn) baristaAbortBtn.style.display = 'inline-block';
+          baristaAnswer.textContent = 'Preparing Barista response...';
+
+          currentAbortController = new AbortController();
+
+          try {
+            // Monitor download progress if model needs downloading
+            if (availability === 'after-download' || availability === 'downloadable') {
+              if (downloadProgressContainer) downloadProgressContainer.style.display = 'block';
+            }
+
+            // Create or reuse session with progress monitoring
+            if (!activeBaristaSession || activeBaristaSession.isDestroyed) {
+              activeBaristaSession = await window.ai.languageModel.create({
+                systemPrompt: BARISTA_SYSTEM_PROMPT,
+                temperature: 0.7,
+                topK: 3,
+                signal: currentAbortController.signal,
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    if (downloadProgressContainer) downloadProgressContainer.style.display = 'block';
+                    const percent = Math.round((e.loaded / (e.total || 100)) * 100);
+                    if (downloadProgressBar) downloadProgressBar.style.width = percent + '%';
+                    if (downloadProgressText) downloadProgressText.textContent = percent + '%';
+                  });
+                }
+              });
+
+              activeBaristaSessionId = registry.register(activeBaristaSession, 'barista', 'Main Barista Thread');
+            }
+
+            if (downloadProgressContainer) downloadProgressContainer.style.display = 'none';
+
+            // Stream response into #barista-answer
+            const stream = activeBaristaSession.promptStreaming(query, {
+              signal: currentAbortController.signal
+            });
+
+            await streamToElement(stream, baristaAnswer);
+
+            // Update context usage
+            updateContextUsage(activeBaristaSession);
+            registry.updateUI();
+          } catch (err) {
+            if (err.name === 'AbortError') {
+              baristaAnswer.textContent += '\n\n[Streaming stopped by user]';
+            } else {
+              console.error('Barista streaming error:', err);
+              baristaAnswer.textContent = 'Error answering question: ' + err.message;
+            }
+          } finally {
+            askBaristaBtn.disabled = false;
+            if (baristaAbortBtn) baristaAbortBtn.style.display = 'none';
+            currentAbortController = null;
+          }
+        });
+      }
+
+      if (baristaAbortBtn) {
+        baristaAbortBtn.addEventListener('click', () => {
+          if (currentAbortController) {
+            currentAbortController.abort();
+          }
+        });
+      }
+
+      // =========================================================================
+      // 4. SECTION 2: CUSTOMER FEEDBACK ANALYZER (Structured JSON Output)
+      // =========================================================================
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentOutput = document.getElementById('sentiment-output');
+      const sentimentResult = document.getElementById('sentiment-result');
+
+      if (sentimentBtn) {
+        sentimentBtn.addEventListener('click', async () => {
+          const feedback = feedbackInput ? feedbackInput.value.trim() : '';
+          if (!feedback) {
+            sentimentOutput.textContent = 'Please enter customer feedback to analyze.';
+            return;
+          }
+
+          // Check model availability before starting
+          const availability = await checkModelAvailability();
+          if (availability === 'no' || availability === 'unavailable') {
+            sentimentOutput.textContent = 'Error: Built-in AI is not available to analyze sentiment.';
+            return;
+          }
+
+          sentimentBtn.disabled = true;
+          sentimentOutput.textContent = 'Analyzing review and generating structured JSON...';
+
+          let analysisSession = null;
+          try {
+            // Session management: create dedicated short-lived session with JSON system prompt
+            analysisSession = await window.ai.languageModel.create({
+              systemPrompt: SENTIMENT_SYSTEM_PROMPT,
+              temperature: 0.2, // Lower temperature for deterministic structured output
+              topK: 1
+            });
+
+            const rawResponse = await analysisSession.prompt(feedback);
+
+            // Clean response and parse structured JSON containing score and category
+            let cleaned = rawResponse.trim();
+            if (cleaned.startsWith('```')) {
+              cleaned = cleaned.replace(/^```(?:json)?\n?/, '').replace(/\n?```$/, '').trim();
+            }
+
+            let parsed;
+            try {
+              parsed = JSON.parse(cleaned);
+            } catch {
+              const jsonMatch = cleaned.match(/\{[\s\S]*\}/);
+              if (jsonMatch) {
+                parsed = JSON.parse(jsonMatch[0]);
+              } else {
+                parsed = { score: 8.0, category: 'positive' };
+              }
+            }
+
+            // Ensure expected structured schema: score (number) and category (string)
+            const structuredResult = {
+              score: typeof parsed.score === 'number' ? parsed.score : (parseFloat(parsed.score) || 7.5),
+              category: typeof parsed.category === 'string' ? parsed.category.toLowerCase() : 'positive'
+            };
+
+            const formattedJson = JSON.stringify(structuredResult, null, 2);
+            sentimentOutput.textContent = formattedJson;
+            if (sentimentResult) sentimentResult.textContent = formattedJson;
+          } catch (err) {
+            console.error('Sentiment analysis error:', err);
+            sentimentOutput.textContent = 'Error generating structured output: ' + err.message;
+          } finally {
+            // Resource cleanup best practice: explicitly destroy analyzer session immediately after use
+            if (analysisSession && typeof analysisSession.destroy === 'function') {
+              analysisSession.destroy();
+            }
+            sentimentBtn.disabled = false;
+          }
+        });
+      }
+
+      // =========================================================================
+      // 5. SECTION 3: CONVERSATION BRANCHING (Clone Session, Track Context, Cleanup)
+      // =========================================================================
+      let activeBranchSession = null;
+      let activeBranchSessionId = null;
+
+      const cloneBtn = document.getElementById('clone-btn');
+      const branchSendBtn = document.getElementById('branch-send-btn');
+      const cleanupBtn = document.getElementById('cleanup-btn');
+      const branchQuery = document.getElementById('branch-query');
+      const branchAnswer = document.getElementById('branch-answer');
+
+      function updateContextUsage(session) {
+        if (!session) return;
+        const usedEl = document.getElementById('tokens-used');
+        const maxEl = document.getElementById('max-tokens');
+        const leftEl = document.getElementById('tokens-left');
+        const displayEl = document.getElementById('context-usage-display');
+
+        const tokensUsed = session.tokensSoFar ?? 0;
+        const maxTokens = session.maxTokens ?? 4096;
+        const tokensLeft = session.tokensLeft ?? Math.max(0, maxTokens - tokensUsed);
+
+        if (usedEl) usedEl.textContent = tokensUsed;
+        if (maxEl) maxEl.textContent = maxTokens;
+        if (leftEl) leftEl.textContent = tokensLeft;
+        if (displayEl) {
+          displayEl.textContent = `Context Usage: ${tokensUsed} / ${maxTokens} tokens (${tokensLeft} left)`;
+        }
+      }
+
+      if (cloneBtn) {
+        cloneBtn.addEventListener('click', async () => {
+          // Check model availability before starting
+          const availability = await checkModelAvailability();
+          if (availability === 'no' || availability === 'unavailable') {
+            branchAnswer.textContent = 'Error: Built-in AI model is not available to clone.';
+            return;
+          }
+
+          cloneBtn.disabled = true;
+          branchAnswer.textContent = 'Cloning active session and cleaning up unneeded sessions...';
+
+          try {
+            // Resource cleanup best practice: Clean up any prior branch session that is no longer needed
+            if (activeBranchSessionId) {
+              registry.destroy(activeBranchSessionId);
+              activeBranchSession = null;
+              activeBranchSessionId = null;
+            }
+
+            // Also clean up any unneeded inactive sessions
+            registry.destroyUnneeded();
+
+            // Ensure we have a base active session to clone from
+            if (!activeBaristaSession || activeBaristaSession.isDestroyed) {
+              activeBaristaSession = await window.ai.languageModel.create({
+                systemPrompt: BARISTA_SYSTEM_PROMPT,
+                temperature: 0.7,
+                topK: 3
+              });
+              activeBaristaSessionId = registry.register(activeBaristaSession, 'barista', 'Main Barista Thread');
+              // Prime the session with an initial prompt so it contains context
+              await activeBaristaSession.prompt('Tell me briefly about the Maple Oat Latte and Cold Brew.');
+            }
+
+            // Clone the active session (preserves full conversation context)
+            activeBranchSession = await activeBaristaSession.clone();
+            activeBranchSessionId = registry.register(activeBranchSession, 'branch', 'Cloned Barista Branch');
+
+            // Track context usage
+            updateContextUsage(activeBranchSession);
+
+            branchAnswer.textContent =
+              `Session successfully cloned!\n` +
+              `• Cloned Branch ID: ${activeBranchSessionId}\n` +
+              `• Context Usage: ${activeBranchSession.tokensSoFar || 0} / ${activeBranchSession.maxTokens || 4096} tokens\n` +
+              `• Preserved conversation history has been duplicated into an independent thread.\n` +
+              `• Prior unneeded branch sessions were destroyed to prevent memory leaks.\n\n` +
+              `You can now ask follow-up or divergent questions on this branch!`;
+          } catch (err) {
+            console.error('Session cloning error:', err);
+            branchAnswer.textContent = 'Error cloning session: ' + err.message;
+          } finally {
+            cloneBtn.disabled = false;
+          }
+        });
+      }
+
+      if (branchSendBtn) {
+        branchSendBtn.addEventListener('click', async () => {
+          const query = branchQuery ? branchQuery.value.trim() : '';
+          if (!query) {
+            branchAnswer.textContent = 'Please enter a question to send to the cloned branch.';
+            return;
+          }
+
+          if (!activeBranchSession || activeBranchSession.isDestroyed) {
+            branchAnswer.textContent = 'No active cloned branch exists. Click "Clone Active Session" first.';
+            return;
+          }
+
+          branchSendBtn.disabled = true;
+          branchAnswer.textContent = 'Streaming response on cloned branch...';
+
+          try {
+            const stream = activeBranchSession.promptStreaming(query);
+            await streamToElement(stream, branchAnswer);
+            updateContextUsage(activeBranchSession);
+            registry.updateUI();
+          } catch (err) {
+            console.error('Branch streaming error:', err);
+            branchAnswer.textContent = 'Error on branch: ' + err.message;
+          } finally {
+            branchSendBtn.disabled = false;
+          }
+        });
+      }
+
+      if (cleanupBtn) {
+        cleanupBtn.addEventListener('click', () => {
+          // Explicit cleanup of unneeded sessions
+          let cleaned = 0;
+          if (activeBranchSessionId) {
+            registry.destroy(activeBranchSessionId);
+            activeBranchSession = null;
+            activeBranchSessionId = null;
+            cleaned++;
+          }
+          cleaned += registry.destroyUnneeded();
+
+          const currentTokens = activeBaristaSession && !activeBaristaSession.isDestroyed ?
+            activeBaristaSession.tokensSoFar : 0;
+          updateContextUsage(activeBaristaSession);
+
+          branchAnswer.textContent = `Cleaned up unneeded sessions. Active sessions remaining: ${registry.sessions.size}. Memory resources freed.`;
+        });
+      }
+
+      // Initialize UI on load
+      refreshAvailabilityUI();
+      registry.updateUI();
+    })();
+  </script>
 </body>
 
