+  <script type="module">
+    async function initCountdownTimer() {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/temporal-polyfill');
+          globalThis.Temporal = module.Temporal;
+          if (module.toTemporalInstant) {
+            Date.prototype.toTemporalInstant = module.toTemporalInstant;
+          }
+        } catch (e) {
+          console.warn('Temporal polyfill could not be loaded; using standard Date fallback.', e);
+        }
+      }
+
+      updateSeasonalTimer();
+    }
+
+    function updateSeasonalTimer() {
+      const remainingEl = document.getElementById('maple-latte-remaining');
+      const elapsedEl = document.getElementById('maple-latte-elapsed');
+      const timerContainer = document.getElementById('maple-latte-timer');
+      if (!remainingEl || !elapsedEl) return;
+
+      const startDateStr = '2026-01-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      if (typeof Temporal !== 'undefined') {
+        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
+        const now = window.__MOCK_NOW__
+          ? Temporal.ZonedDateTime.from(window.__MOCK_NOW__)
+          : Temporal.Now.zonedDateTimeISO(tz);
+
+        // Chain Temporal methods rather than interpolating ISO strings
+        const start = Temporal.PlainDate.from(startDateStr)
+          .toPlainDateTime(startTimeStr)
+          .toZonedDateTime(tz);
+        const end = Temporal.PlainDate.from(endDateStr)
+          .toPlainDateTime(endTimeStr)
+          .toZonedDateTime(tz);
+
+        // Balance units to days and hours
+        const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+        const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+        const formatter = typeof Intl !== 'undefined' && Intl.DurationFormat
+          ? new Intl.DurationFormat(undefined, { style: 'long' })
+          : null;
+
+        const format = (d) => {
+          if (formatter) return formatter.format(d);
+          if (typeof d.toLocaleString === 'function') {
+            try {
+              const str = d.toLocaleString(undefined, { style: 'long' });
+              if (str && !str.startsWith('P')) return str;
+            } catch {}
+          }
+          const days = Math.abs(d.days || 0);
+          const hours = Math.abs(d.hours || 0);
+          return `${days} ${days === 1 ? 'day' : 'days'}, ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+        };
+
+        const isExpired = timeRemaining.sign < 0;
+        const remainingText = isExpired
+          ? '0 days, 0 hours left (Offer ended)'
+          : `${format(timeRemaining)} left`;
+        const elapsedText = `${format(timeActive)} elapsed`;
+
+        remainingEl.textContent = remainingText;
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+
+        elapsedEl.textContent = elapsedText;
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+
+        if (timerContainer) {
+          timerContainer.dataset.remainingDays = String(timeRemaining.days);
+          timerContainer.dataset.remainingHours = String(timeRemaining.hours);
+          timerContainer.dataset.elapsedDays = String(timeActive.days);
+          timerContainer.dataset.elapsedHours = String(timeActive.hours);
+          timerContainer.dataset.isExpired = String(isExpired);
+          timerContainer.dataset.timeZone = tz;
+          timerContainer.dataset.endDate = `${endDateStr}T${endTimeStr}`;
+          timerContainer.dataset.startDate = `${startDateStr}T${startTimeStr}`;
+        }
+      } else {
+        // Fallback for environments lacking Temporal
+        const now = new Date();
+        const start = new Date(2026, 0, 1, 0, 0, 0);
+        const end = new Date(2026, 2, 1, 0, 0, 0);
+
+        const msUntilEnd = end.getTime() - now.getTime();
+        const isExpired = msUntilEnd <= 0;
+
+        const remainingDays = isExpired ? 0 : Math.floor(msUntilEnd / (1000 * 60 * 60 * 24));
+        const remainingHours = isExpired ? 0 : Math.floor((msUntilEnd % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
+
+        const msSinceStart = Math.max(0, now.getTime() - start.getTime());
+        const elapsedDays = Math.floor(msSinceStart / (1000 * 60 * 60 * 24));
+        const elapsedHours = Math.floor((msSinceStart % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
+
+        const remStr = `${remainingDays} ${remainingDays === 1 ? 'day' : 'days'}, ${remainingHours} ${remainingHours === 1 ? 'hour' : 'hours'} left`;
+        const elapStr = `${elapsedDays} ${elapsedDays === 1 ? 'day' : 'days'}, ${elapsedHours} ${elapsedHours === 1 ? 'hour' : 'hours'} elapsed`;
+
+        remainingEl.textContent = isExpired ? '0 days, 0 hours left (Offer ended)' : remStr;
+        elapsedEl.textContent = elapStr;
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initCountdownTimer);
+    } else {
+      initCountdownTimer();
+    }
+  </script>
+
 </body>
 
