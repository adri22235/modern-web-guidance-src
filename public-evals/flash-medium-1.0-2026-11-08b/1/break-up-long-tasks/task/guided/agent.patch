diff --git a/coffee-sim-core.js b/coffee-sim-core.js
new file mode 100644
--- a/coffee-sim-core.js
+++ b/coffee-sim-core.js
@@ -0,0 +1,284 @@
+/**
+ * Coffee Flavor Profile Simulation Core Engine
+ * Simulates large batches of coffee blend recipes, origin proportions,
+ * roast kinetics, and flavor extractions.
+ */
+(function(global) {
+  'use strict';
+
+  const ORIGINS = {
+    ethiopia: {
+      id: 'ethiopia',
+      name: 'Ethiopian Yirgacheffe',
+      country: 'Ethiopia',
+      elevation: '2,100m',
+      acidity: 90,
+      sweetness: 80,
+      body: 58,
+      bitterness: 30,
+      aroma: 94,
+      notes: ['Bergamot', 'Jasmine', 'Meyer Lemon', 'Peach']
+    },
+    colombia: {
+      id: 'colombia',
+      name: 'Colombian Supremo',
+      country: 'Colombia',
+      elevation: '1,750m',
+      acidity: 68,
+      sweetness: 84,
+      body: 76,
+      bitterness: 48,
+      aroma: 78,
+      notes: ['Caramel', 'Red Apple', 'Toasted Walnut', 'Honey']
+    },
+    sumatra: {
+      id: 'sumatra',
+      name: 'Sumatran Mandheling',
+      country: 'Indonesia',
+      elevation: '1,400m',
+      acidity: 38,
+      sweetness: 62,
+      body: 94,
+      bitterness: 74,
+      aroma: 66,
+      notes: ['Dark Chocolate', 'Earthy Cedar', 'Brown Sugar', 'Herbal']
+    },
+    brazil: {
+      id: 'brazil',
+      name: 'Brazilian Santos',
+      country: 'Brazil',
+      elevation: '1,100m',
+      acidity: 48,
+      sweetness: 82,
+      body: 80,
+      bitterness: 52,
+      aroma: 70,
+      notes: ['Milk Chocolate', 'Hazelnut', 'Toffee', 'Malt']
+    },
+    kenya: {
+      id: 'kenya',
+      name: 'Kenyan AA',
+      country: 'Kenya',
+      elevation: '1,900m',
+      acidity: 94,
+      sweetness: 76,
+      body: 72,
+      bitterness: 42,
+      aroma: 88,
+      notes: ['Blackcurrant', 'Grapefruit', 'Cane Sugar', 'Winey']
+    },
+    guatemala: {
+      id: 'guatemala',
+      name: 'Guatemalan Antigua',
+      country: 'Guatemala',
+      elevation: '1,650m',
+      acidity: 66,
+      sweetness: 82,
+      body: 74,
+      bitterness: 54,
+      aroma: 82,
+      notes: ['Spiced Cocoa', 'Apple Crisp', 'Nutmeg', 'Orange Zest']
+    }
+  };
+
+  const ROAST_PROFILES = {
+    light: {
+      id: 'light',
+      label: 'Light Roast (Cinnamon/City)',
+      tempC: 202,
+      acidityDelta: +14,
+      sweetnessDelta: -4,
+      bodyDelta: -12,
+      bitternessDelta: -14,
+      aromaDelta: +12,
+      scoreBonus: 2.2
+    },
+    medium: {
+      id: 'medium',
+      label: 'Medium Roast (City+)',
+      tempC: 216,
+      acidityDelta: +4,
+      sweetnessDelta: +8,
+      bodyDelta: +4,
+      bitternessDelta: +0,
+      aromaDelta: +6,
+      scoreBonus: 3.5
+    },
+    'medium-dark': {
+      id: 'medium-dark',
+      label: 'Medium-Dark (Full City)',
+      tempC: 224,
+      acidityDelta: -10,
+      sweetnessDelta: +4,
+      bodyDelta: +14,
+      bitternessDelta: +14,
+      aromaDelta: -2,
+      scoreBonus: 2.0
+    },
+    dark: {
+      id: 'dark',
+      label: 'Dark Roast (Vienna/French)',
+      tempC: 235,
+      acidityDelta: -22,
+      sweetnessDelta: -12,
+      bodyDelta: +18,
+      bitternessDelta: +28,
+      aromaDelta: -12,
+      scoreBonus: -1.0
+    }
+  };
+
+  const BLEND_PREFIXES = ['Dawn', 'Velvet', 'Highland', 'Amber', 'Copper', 'Solstice', 'Andean', 'Misty', 'Golden', 'Heritage', 'Rustic', 'Timber', 'Canyon', 'Harbor', 'Obsidian'];
+  const BLEND_SUFFIXES = ['Crema', 'Hearth', 'Roast', 'Sunrise', 'Reserve', 'Peak', 'Crown', 'Drift', 'Canopy', 'Elixir', 'Nectar', 'Brew', 'Valley', 'Bloom', 'Horizon'];
+
+  function clamp(val, min, max) {
+    return Math.max(min, Math.min(max, val));
+  }
+
+  function simulateSingleBlend(blendIndex, config) {
+    const selectedOriginKeys = (config.origins && config.origins.length > 0)
+      ? config.origins
+      : Object.keys(ORIGINS);
+    const selectedRoastKeys = (config.roasts && config.roasts.length > 0)
+      ? config.roasts
+      : Object.keys(ROAST_PROFILES);
+
+    // Pick 1 to 3 origins
+    const numOrigins = Math.min(selectedOriginKeys.length, ((blendIndex % 3) + 1));
+    const blendOrigins = [];
+    let remainingPct = 100;
+
+    for (let o = 0; o < numOrigins; o++) {
+      const originKey = selectedOriginKeys[(blendIndex + o * 2) % selectedOriginKeys.length];
+      const isLast = (o === numOrigins - 1);
+      let pct;
+      if (isLast) {
+        pct = remainingPct;
+      } else {
+        const share = Math.floor(remainingPct * (0.35 + ((blendIndex * 7 + o * 13) % 40) / 100));
+        pct = Math.max(10, Math.min(remainingPct - 10, share));
+        remainingPct -= pct;
+      }
+      blendOrigins.push({
+        origin: ORIGINS[originKey] || ORIGINS.colombia,
+        ratio: pct
+      });
+    }
+
+    // Pick roast
+    const roastKey = selectedRoastKeys[(blendIndex + Math.floor(blendIndex / 7)) % selectedRoastKeys.length];
+    const roast = ROAST_PROFILES[roastKey] || ROAST_PROFILES.medium;
+
+    // Weighted base flavor profile from origins
+    let baseAcidity = 0;
+    let baseSweetness = 0;
+    let baseBody = 0;
+    let baseBitterness = 0;
+    let baseAroma = 0;
+    const allNotes = [];
+
+    for (const item of blendOrigins) {
+      const weight = item.ratio / 100;
+      baseAcidity += item.origin.acidity * weight;
+      baseSweetness += item.origin.sweetness * weight;
+      baseBody += item.origin.body * weight;
+      baseBitterness += item.origin.bitterness * weight;
+      baseAroma += item.origin.aroma * weight;
+      allNotes.push(...item.origin.notes);
+    }
+
+    // Extraction simulation kinetics (multi-stage extraction curve)
+    // Simulates solubles dissolution, organic acids yield, and Maillard development
+    const grindMicrons = 350 + ((blendIndex * 17) % 450); // 350 - 800 um
+    const waterTemp = 90 + ((blendIndex * 3) % 6); // 90 - 95 C
+    const brewRatio = 15.0 + ((blendIndex * 5) % 30) / 10; // 1:15 to 1:18
+
+    let acidExtraction = 0;
+    let sugarExtraction = 0;
+    let bodyExtraction = 0;
+    let heavyCompoundExtraction = 0;
+
+    // Kinetic iterative steps (computational loop representing brew yield)
+    const steps = 80;
+    for (let s = 1; s <= steps; s++) {
+      const rate = 1 / (1 + (grindMicrons / 500) * 0.2);
+      const tempFactor = (waterTemp - 85) / 10;
+      // Fast dissolving acids
+      acidExtraction += Math.exp(-s * 0.12 * rate) * tempFactor * 1.8;
+      // Mid-stage caramel sugars
+      sugarExtraction += Math.sin((s / steps) * Math.PI) * tempFactor * 1.5;
+      // Lipid and colloid emulsification
+      bodyExtraction += (s / steps) * (baseBody / 100) * 1.2;
+      // Late stage heavy tannins/bitterness
+      heavyCompoundExtraction += Math.pow(s / steps, 2.5) * (roast.tempC / 200) * 2.1;
+    }
+
+    // Synthesize final flavor metrics
+    const finalAcidity = clamp(Math.round(baseAcidity + roast.acidityDelta + (acidExtraction * 0.22) - (grindMicrons > 600 ? 5 : 0)), 15, 98);
+    const finalSweetness = clamp(Math.round(baseSweetness + roast.sweetnessDelta + (sugarExtraction * 0.24)), 20, 98);
+    const finalBody = clamp(Math.round(baseBody + roast.bodyDelta + (bodyExtraction * 0.25)), 20, 98);
+    const finalBitterness = clamp(Math.round(baseBitterness + roast.bitternessDelta + (heavyCompoundExtraction * 0.22)), 15, 95);
+    const finalAroma = clamp(Math.round(baseAroma + roast.aromaDelta + (acidExtraction * 0.1)), 25, 98);
+
+    // Cupping Score calculation (SCA specialty scale 75 - 95)
+    // Quality scoring evaluates balance, clean cup, sweetness, and complexity
+    const balancePenalty = Math.abs(finalAcidity - finalSweetness) * 0.12 + Math.max(0, finalBitterness - 70) * 0.25;
+    const baseCupping = 80.0 + (finalSweetness * 0.06) + (finalAroma * 0.05) + (finalBody * 0.04) + roast.scoreBonus - balancePenalty;
+    const cuppingScore = Math.min(94.8, Math.max(76.0, Math.round(baseCupping * 10) / 10));
+
+    // Target Profile Match calculation
+    let targetMatch = 0;
+    const target = config.targetProfile || 'balanced';
+    if (target === 'balanced') {
+      const dev = Math.abs(finalAcidity - 70) + Math.abs(finalSweetness - 80) + Math.abs(finalBody - 75) + Math.abs(finalBitterness - 45);
+      targetMatch = Math.max(10, Math.round(100 - (dev * 0.6)));
+    } else if (target === 'bright') {
+      targetMatch = Math.max(10, Math.round((finalAcidity * 0.55 + finalAroma * 0.35 + finalSweetness * 0.1) - (finalBitterness * 0.3)));
+    } else if (target === 'chocolaty') {
+      targetMatch = Math.max(10, Math.round((finalBody * 0.4 + finalSweetness * 0.35 + (100 - Math.abs(finalBitterness - 58)) * 0.25)));
+    } else if (target === 'earthy') {
+      targetMatch = Math.max(10, Math.round((finalBody * 0.5 + finalBitterness * 0.3 + (100 - finalAcidity) * 0.2)));
+    } else if (target === 'high-score') {
+      targetMatch = Math.max(10, Math.round(((cuppingScore - 75) / 20) * 100));
+    } else {
+      targetMatch = Math.round((cuppingScore / 95) * 100);
+    }
+    targetMatch = clamp(targetMatch, 15, 99);
+
+    // Blend naming & selected unique flavor tags
+    const prefix = BLEND_PREFIXES[blendIndex % BLEND_PREFIXES.length];
+    const suffix = BLEND_SUFFIXES[(blendIndex * 3 + Math.floor(blendIndex / 5)) % BLEND_SUFFIXES.length];
+    const blendName = `${prefix} ${suffix} #${blendIndex + 1}`;
+
+    const uniqueNotes = Array.from(new Set(allNotes));
+    const offset = blendIndex % uniqueNotes.length;
+    const rotated = uniqueNotes.slice(offset).concat(uniqueNotes.slice(0, offset));
+    const selectedNotes = rotated.slice(0, 3);
+
+    return {
+      id: blendIndex + 1,
+      name: blendName,
+      origins: blendOrigins.map(o => ({ name: o.origin.name, ratio: o.ratio, country: o.origin.country })),
+      roast: roast.label,
+      roastId: roast.id,
+      acidity: finalAcidity,
+      sweetness: finalSweetness,
+      body: finalBody,
+      bitterness: finalBitterness,
+      aroma: finalAroma,
+      cuppingScore: cuppingScore,
+      targetMatch: targetMatch,
+      notes: selectedNotes,
+      grindMicrons: grindMicrons,
+      waterTempC: waterTemp,
+      brewRatio: `1:${brewRatio.toFixed(1)}`
+    };
+  }
+
+  global.CoffeeSimCore = {
+    ORIGINS,
+    ROAST_PROFILES,
+    simulateSingleBlend
+  };
+
+})(typeof self !== 'undefined' ? self : this);
