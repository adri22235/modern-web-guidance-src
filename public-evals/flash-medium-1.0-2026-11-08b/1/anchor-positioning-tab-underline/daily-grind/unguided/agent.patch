   </footer>
 
+  <script>
+    function initNavIndicator() {
+      const navList = document.querySelector('nav ul');
+      const navItems = Array.from(document.querySelectorAll('nav ul li a')).filter(
+        link => !link.classList.contains('logout-link')
+      );
+      let indicator = document.querySelector('.nav-indicator');
+
+      if (!indicator && navList) {
+        indicator = document.createElement('li');
+        indicator.className = 'nav-indicator';
+        indicator.setAttribute('aria-hidden', 'true');
+        navList.appendChild(indicator);
+      }
+
+      function updateIndicator(targetLink, animate = true) {
+        if (!targetLink || !indicator || !navList) return;
+
+        const navRect = navList.getBoundingClientRect();
+        const targetRect = targetLink.getBoundingClientRect();
+        const left = targetRect.left - navRect.left;
+        const width = targetRect.width;
+
+        if (!animate) {
+          indicator.style.transition = 'none';
+        } else {
+          indicator.style.transition = 'left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
+        }
+
+        indicator.style.left = `${left}px`;
+        indicator.style.width = `${width}px`;
+
+        if (!animate) {
+          indicator.offsetHeight; // Force layout reflow
+          indicator.style.transition = '';
+        }
+      }
+
+      let activeLink = navItems.find(link => link.classList.contains('active')) || navItems[0];
+      if (activeLink) {
+        if (!activeLink.classList.contains('active')) {
+          activeLink.classList.add('active');
+        }
+        activeLink.setAttribute('aria-current', 'page');
+      }
+
+      // Initial positioning without animation
+      updateIndicator(activeLink, false);
+      requestAnimationFrame(() => updateIndicator(activeLink, false));
+
+      navItems.forEach(link => {
+        link.addEventListener('click', (e) => {
+          e.preventDefault();
+
+          if (activeLink && activeLink !== link) {
+            activeLink.classList.remove('active');
+            activeLink.removeAttribute('aria-current');
+          }
+
+          link.classList.add('active');
+          link.setAttribute('aria-current', 'page');
+          activeLink = link;
+
+          updateIndicator(activeLink, true);
+        });
+      });
+
+      window.addEventListener('resize', () => {
+        if (activeLink) {
+          updateIndicator(activeLink, false);
+        }
+      });
+
+      window.addEventListener('load', () => {
+        if (activeLink) {
+          updateIndicator(activeLink, false);
+        }
+      });
+
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(() => {
+          if (activeLink) {
+            updateIndicator(activeLink, false);
+          }
+        });
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initNavIndicator);
+    } else {
+      initNavIndicator();
+    }
+  </script>
