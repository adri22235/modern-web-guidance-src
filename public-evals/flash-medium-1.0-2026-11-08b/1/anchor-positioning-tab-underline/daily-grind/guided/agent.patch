+  <script>
+    const navUl = document.querySelector('nav ul');
+    if (navUl) {
+      navUl.addEventListener('click', (event) => {
+        const link = event.target.closest('a');
+        if (!link || link.classList.contains('logout-link') || !navUl.contains(link)) {
+          return;
+        }
+        event.preventDefault();
+        const targetLi = link.closest('li');
+        if (!targetLi) return;
+
+        const currentActiveLi = navUl.querySelector('li.active');
+        const currentActiveLink = navUl.querySelector('a[aria-current="page"]');
+        if (currentActiveLi) {
+          currentActiveLi.classList.remove('active');
+        }
+        if (currentActiveLink) {
+          currentActiveLink.removeAttribute('aria-current');
+        }
+
+        targetLi.classList.add('active');
+        link.setAttribute('aria-current', 'page');
+      });
+    }
+  </script>
