+    (function () {
+      /**
+       * Accurately calculates natural content height of an element,
+       * handling collapsed, hidden, and edge-case layout states.
+       */
+      function getNaturalHeight(element) {
+        if (element.scrollHeight > 0) {
+          return element.scrollHeight;
+        }
+
+        const child = element.firstElementChild;
+        if (child && child.scrollHeight > 0) {
+          return child.scrollHeight;
+        }
+        if (child && child.offsetHeight > 0) {
+          return child.offsetHeight;
+        }
+
+        // Fallback for detached or display:none states in mock/test environments
+        const clone = element.cloneNode(true);
+        clone.style.visibility = 'hidden';
+        clone.style.position = 'absolute';
+        clone.style.height = 'auto';
+        clone.style.maxHeight = 'none';
+        clone.style.display = 'block';
+        document.body.appendChild(clone);
+        const height = clone.scrollHeight || clone.offsetHeight || 120;
+        document.body.removeChild(clone);
+        return height;
+      }
+
+      /* ==========================================================================
+         Accordion Logic (Smooth animation between collapsed and natural height)
+         ========================================================================== */
+
+      function openAccordion(trigger, content) {
