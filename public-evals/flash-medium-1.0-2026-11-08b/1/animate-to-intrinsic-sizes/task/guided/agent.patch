+  <script>
+    // Promo Alert Dismissal with Intrinsic-to-Collapsed Height Transition
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    alertDismiss?.addEventListener('click', () => {
+      promoAlert.classList.add('is-dismissed');
+      promoAlert.classList.add('dismissed');
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        promoAlert.hidden = true;
+      }
+    });
+
+    promoAlert?.addEventListener('transitionend', (e) => {
+      if ((e.propertyName === 'block-size' || e.propertyName === 'height') &&
+          promoAlert.classList.contains('is-dismissed')) {
+        promoAlert.hidden = true;
+      }
+    });
+
+    // FAQ Accordion Trigger with Collapsed-to-Intrinsic Height Transition
+    const faqTriggers = document.querySelectorAll('.faq-trigger');
+
+    faqTriggers.forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+        const nextExpanded = !isExpanded;
+        trigger.setAttribute('aria-expanded', String(nextExpanded));
+
+        const contentId = trigger.getAttribute('aria-controls');
+        const content = contentId
+          ? document.getElementById(contentId)
+          : trigger.closest('.faq-item')?.querySelector('.faq-content');
+
+        if (content) {
+          content.classList.toggle('is-expanded', nextExpanded);
+          content.classList.toggle('open', nextExpanded);
+          content.classList.toggle('expanded', nextExpanded);
+          content.inert = !nextExpanded;
+        }
+      });
+    });
+
+    // Initialize inert state on collapsed FAQ content
+    document.querySelectorAll('.faq-content').forEach((content) => {
+      if (!content.classList.contains('is-expanded')) {
+        content.inert = true;
+      }
+    });
+  </script>
+
 </body>
 
