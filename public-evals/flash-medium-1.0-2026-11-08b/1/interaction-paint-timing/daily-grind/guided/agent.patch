@@ -0,0 +1,536 @@
+/**
+ * Daily Grind - Client-Side Performance Monitoring
+ *
+ * Measures how long it takes for clicks on the navigation bar, "Order Now" button,
+ * and "Seasonal Favorites" cards, as well as client-side view switches, to finish
+ * painting visual updates on the page.
+ *
+ * Implements modern web guidance standards:
+ * - InteractionContentfulPaint ('interaction-contentful-paint')
+ * - PerformanceSoftNavigation ('soft-navigation')
+ * - Event Timing ('event')
+ * - Double requestAnimationFrame / paint lifecycle fallbacks
+ */
+
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.DailyGrindPerf = factory();
+  }
+})(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  // Metrics repository
+  const metricsStore = [];
+  const metricListeners = [];
+  let metricCounter = 0;
+
+  // Active interaction tracking
+  const activeInteractions = new Map();
+  let latestViewSwitch = null;
+
+  /**
+   * Helper: classify DOM element into target category
+   */
+  function classifyTarget(target) {
+    if (!target || !(target instanceof Element)) {
+      return { category: 'other', label: 'Unknown' };
+    }
+
+    // 1. Navigation Bar
+    const nav = target.closest('nav');
+    if (nav) {
+      const link = target.closest('a');
+      const logo = target.closest('.logo');
+      let navLabel = 'Navigation Bar';
+      if (link) {
+        navLabel = `Navigation: ${link.textContent.trim()}`;
+      } else if (logo) {
+        navLabel = 'Navigation: Logo (Home)';
+      }
+      return {
+        category: 'navigation-bar',
+        label: navLabel,
+        selector: link ? `nav a[href="${link.getAttribute('href')}"]` : 'nav'
+      };
+    }
+
+    // 2. Order Now Button
+    const orderBtn =
+      target.closest('a[href="/order-online"]') ||
+      target.closest('.hero a.btn') ||
+      target.closest('a.order-now-btn') ||
+      target.closest('button.order-now-btn');
+    const isOrderText = target.textContent.trim().toLowerCase() === 'order now';
+    if (orderBtn || (target.tagName === 'A' && isOrderText)) {
+      return {
+        category: 'order-now',
+        label: 'Order Now Button',
+        selector: orderBtn ? (orderBtn.getAttribute('href') ? `a[href="${orderBtn.getAttribute('href')}"]` : '.hero .btn') : 'a.btn'
+      };
+    }
+
+    // 3. Seasonal Favorites Cards
+    const card = target.closest('.card') || target.closest('[data-seasonal-card]');
+    if (card) {
+      const title = card.querySelector('h3')?.textContent.trim() || 'Card';
+      const link = card.querySelector('a');
+      return {
+        category: 'seasonal-favorites-card',
+        label: `Seasonal Favorites: ${title}`,
+        selector: link ? `.card a[href="${link.getAttribute('href')}"]` : '.card'
+      };
+    }
+
+    // Secondary check for links that might belong to seasonal items
+    const seasonalLink = target.closest('a[href^="/menu/seasonal"], a[href^="/menu/espresso"], a[href^="/menu/cold-brew"]');
+    if (seasonalLink) {
+      return {
+        category: 'seasonal-favorites-card',
+        label: `Seasonal Favorites: ${seasonalLink.textContent.trim()}`,
+        selector: `a[href="${seasonalLink.getAttribute('href')}"]`
+      };
+    }
+
+    return { category: 'other', label: target.tagName.toLowerCase() };
+  }
+
+  /**
+   * Save, log, and emit a finalized performance metric
+   */
+  function recordMetric(metric) {
+    // Avoid duplicate records with same ID
+    const existingIndex = metricsStore.findIndex((m) => m.id === metric.id);
+    if (existingIndex >= 0) {
+      metricsStore[existingIndex] = { ...metricsStore[existingIndex], ...metric };
+      metric = metricsStore[existingIndex];
+    } else {
+      metricsStore.push(metric);
+    }
+
+    // Console logging for field telemetry / debugging
+    const durationFormatted = typeof metric.duration === 'number' ? `${metric.duration.toFixed(2)}ms` : 'N/A';
+    console.log(
