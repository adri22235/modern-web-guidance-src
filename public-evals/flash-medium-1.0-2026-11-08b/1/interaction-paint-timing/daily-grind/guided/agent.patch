+  /**
+   * Execute client-side view switch and coordinate with performance monitor
+   */
+  function switchView(path, options = {}) {
+    const startTime = performance.now();
+    const cleanPath = path.split('?')[0].split('#')[0] || '/';
+
+    // Normalize path
+    const targetPath = cleanPath === '' ? '/' : cleanPath;
+    const viewRenderer = views[targetPath] || views['/about'] || views['/'];
+
+    // Update browser URL history if requested
+    if (options.pushState !== false && window.location.pathname !== targetPath) {
+      try {
+        window.history.pushState({ path: targetPath }, '', targetPath);
+      } catch (_) {}
+    }
+
+    // Measure view switch via performance monitor
+    if (window.dailyGrindPerf && typeof window.dailyGrindPerf.measureViewSwitch === 'function') {
+      window.dailyGrindPerf.measureViewSwitch({
+        url: targetPath,
+        startTime,
+        initiator: options.initiator || 'client-side-router'
+      });
+    }
+
+    // Toggle hero header visibility
+    if (heroHeader) {
+      heroHeader.style.display = targetPath === '/' ? 'flex' : 'none';
+    }
+
+    // Update active class on nav links
+    document.querySelectorAll('nav a').forEach((link) => {
+      const href = link.getAttribute('href');
+      if (href === targetPath) {
+        link.classList.add('active');
+        link.style.color = 'var(--accent)';
+      } else {
+        link.classList.remove('active');
+        link.style.color = 'white';
+      }
+    });
+
+    // Render view DOM
+    if (mainContainer) {
+      mainContainer.innerHTML = viewRenderer();
+      bindViewEvents();
+      window.scrollTo(0, 0);
+    }
+  }
+
+  /**
+   * Bind event handlers to dynamic view elements
+   */
+  function bindViewEvents() {
+    // Add to order buttons in order view
+    document.querySelectorAll('.add-to-order').forEach((btn) => {
+      btn.addEventListener('click', (e) => {
+        const item = btn.getAttribute('data-item') || 'Item';
+        const statusBox = document.getElementById('order-status');
+        const statusText = document.getElementById('order-status-text');
+        if (statusBox && statusText) {
+          statusText.textContent = `${item} has been added to your pickup cart.`;
+          statusBox.style.display = 'block';
+        }
+      });
+    });
+
+    // Make cards clickable
+    document.querySelectorAll('.card').forEach((card) => {
+      card.style.cursor = 'pointer';
+      card.addEventListener('click', (e) => {
+        // If not directly clicking on a button or link, trigger the primary link
+        if (!e.target.closest('a') && !e.target.closest('button')) {
+          const primaryLink = card.querySelector('a.btn, a');
+          if (primaryLink) {
+            primaryLink.click();
+          }
+        }
+      });
+    });
+  }
+
+  /**
+   * Initialize client-side navigation
+   */
+  function initRouter() {
+    heroHeader = document.querySelector('header.hero');
+    mainContainer = document.querySelector('main.container');
+
+    if (mainContainer) {
+      homeMainHTML = mainContainer.innerHTML;
+    }
+
+    // Make logo navigate to home
+    const logo = document.querySelector('nav .logo');
+    if (logo) {
+      logo.style.cursor = 'pointer';
+      logo.addEventListener('click', () => {
+        switchView('/', { initiator: 'logo' });
+      });
+    }
+
+    // Global click interceptor for internal links
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a');
+      if (!link) return;
+
+      const href = link.getAttribute('href');
+      // Only intercept internal relative or root-relative links
+      if (href && href.startsWith('/') && !href.startsWith('//')) {
+        event.preventDefault();
+        const initiator = link.closest('nav') ? 'nav' : link.closest('.hero') ? 'order-now-btn' : 'card-or-body';
+        switchView(href, { initiator });
+      }
+    });
+
+    // Handle browser back / forward navigation
+    window.addEventListener('popstate', (event) => {
+      const path = (event.state && event.state.path) || window.location.pathname;
+      switchView(path, { pushState: false, initiator: 'popstate' });
+    });
+
+    // Bind events on initial page load
+    bindViewEvents();
+
+    // If starting on a non-root path, render it
+    if (window.location.pathname && window.location.pathname !== '/' && views[window.location.pathname]) {
+      switchView(window.location.pathname, { pushState: false, initiator: 'initial-load' });
+    }
+  }
+
+  // Expose router functions on window
+  window.switchView = switchView;
+  window.navigateTo = switchView;
+
+  // Initialize once DOM is ready
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initRouter);
+  } else {
+    initRouter();
+  }
+})();
