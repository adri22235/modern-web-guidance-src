+  function switchView(viewName, options = {}) {
+    const targetView = views[viewName] ? viewName : 'home';
+
+    return measureInteraction('view-switch', targetView, targetView, () => {
+      currentView = targetView;
+
+      // Update Nav active classes
+      document.querySelectorAll('nav a').forEach((a) => {
+        const href = a.getAttribute('href');
+        if (href && pathToView(href) === targetView) {
+          a.classList.add('active');
+        } else {
+          a.classList.remove('active');
+        }
+      });
+
+      // Update browser history if supported
+      try {
+        const newPath = targetView === 'home' ? '/' : `/${targetView}`;
+        if (window.location && window.location.pathname !== newPath) {
+          history.pushState({ view: targetView }, '', newPath);
+        }
+      } catch (e) {}
+
+      // Update Hero
+      renderHero(targetView, options);
+
+      // Render view content into container
+      const main = document.querySelector('main.container');
+      if (main) {
+        main.innerHTML = views[targetView](options);
+      }
+
+      // Update document title
+      const titleMap = {
+        home: 'The Daily Grind | Artisanal Coffee',
+        menu: 'Artisanal Menu | The Daily Grind',
+        locations: 'Our Locations | The Daily Grind',
+        rewards: 'Rewards Club | The Daily Grind',
