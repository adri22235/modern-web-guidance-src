+  function pathToView(path) {
+    if (!path || path === '/' || path === '/home' || path === 'home') return 'home';
+    const clean = path.split('?')[0].split('#')[0].replace(/^\//, '');
+    if (clean === 'menu') return 'menu';
+    if (clean.startsWith('menu/')) return 'seasonal-detail';
+    if (clean === 'locations') return 'locations';
+    if (clean === 'rewards') return 'rewards';
+    if (clean === 'account' || clean === 'my-account') return 'account';
+    if (clean === 'order-online' || clean === 'order') return 'order-online';
+    if (clean === 'logout') return 'logout';
+    if (clean === 'about') return 'about';
+    if (clean === 'careers') return 'careers';
+    if (clean === 'contact') return 'contact';
+    if (clean === 'privacy-policy' || clean === 'privacy') return 'privacy';
+    return 'home';
+  }
+
+  function getItemKeyFromHrefOrTitle(href, title) {
+    const h = (href || '').toLowerCase();
+    const t = (title || '').toLowerCase();
+    if (h.includes('seasonal') || t.includes('maple') || t.includes('latte')) return 'maple-oat-latte';
+    if (h.includes('espresso') || t.includes('espresso') || t.includes('dark roast')) return 'dark-roast-espresso';
+    if (h.includes('cold-brew') || t.includes('cold brew')) return 'cold-brew';
+    return 'maple-oat-latte';
+  }
