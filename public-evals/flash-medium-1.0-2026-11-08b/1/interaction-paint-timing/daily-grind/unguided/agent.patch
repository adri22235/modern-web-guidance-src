+
+  /**
+   * Measures the time from the start of an interaction/update until
+   * visual updates finish painting on the page.
+   */
+  function measureInteraction(category, name, target, actionFn) {
+    const startTime = perf.now();
+    const id = ++metricCounter;
+    const startMark = `${category}-start-${id}`;
+    const endMark = `${category}-paint-${id}`;
+
+    try {
+      perf.mark(startMark);
+      perf.mark(`${category}-start`);
+    } catch (e) {}
+
+    // Execute DOM changes synchronously
+    if (typeof actionFn === 'function') {
+      actionFn();
+    }
+
+    return new Promise((resolve) => {
+      waitForNextPaint((paintTime) => {
+        const duration = Math.max(0, paintTime - startTime);
+
+        try {
+          perf.mark(endMark);
+          perf.mark(`${category}-paint`);
+          perf.mark(`${category}-end`);
+        } catch (e) {}
+
+        const measureNames = getMeasureNamesForCategory(category, name);
+        measureNames.forEach((mName) => {
+          try {
+            perf.measure(mName, startMark, endMark);
+          } catch (err) {
+            try {
+              perf.measure(mName, {
+                start: startTime,
+                end: paintTime,
+                detail: { category, name, duration }
