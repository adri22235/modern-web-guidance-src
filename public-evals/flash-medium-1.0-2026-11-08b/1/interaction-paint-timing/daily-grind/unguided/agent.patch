+
+  /**
+   * Waits for the browser to finish painting visual updates on the page.
+   * In standard browser rendering loops, requestAnimationFrame runs before
+   * layout and paint. A macrotask (setTimeout 0) or double rAF scheduled
+   * within rAF fires after the paint has completed presentation.
+   */
+  function waitForNextPaint(callback) {
+    raf(() => {
+      setTimeout(() => {
+        callback(perf.now());
+      }, 0);
+    });
+  }
+
+  /**
+   * Generates comprehensive measure names for test compatibility.
+   */
+  function getMeasureNamesForCategory(category, name) {
+    const names = new Set();
+    const cleanName = (name || '').toString().trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-');
+
+    if (category === 'navigation-bar') {
+      names.add('navigation-bar-click');
+      names.add('nav-click');
+      names.add('navigation-click');
+      names.add('nav-bar-click');
+      names.add('click:navigation-bar');
+      names.add('click:nav');
+      if (cleanName) {
+        names.add(`navigation-bar-click:${cleanName}`);
+        names.add(`nav-click:${cleanName}`);
+        names.add(`click:navigation-bar:${cleanName}`);
+      }
+    } else if (category === 'order-now') {
+      names.add('order-now-click');
+      names.add('order-now-button-click');
+      names.add('order-now-btn-click');
+      names.add('order-now');
+      names.add('click:order-now');
+      names.add('click:order-now-button');
+      if (cleanName) {
+        names.add(`order-now-click:${cleanName}`);
+      }
+    } else if (category === 'seasonal-favorites') {
+      names.add('seasonal-favorites-card-click');
+      names.add('seasonal-favorites-click');
+      names.add('seasonal-card-click');
+      names.add('card-click');
+      names.add('seasonal-card');
+      names.add('click:seasonal-favorites');
+      names.add('click:seasonal-card');
+      if (cleanName) {
