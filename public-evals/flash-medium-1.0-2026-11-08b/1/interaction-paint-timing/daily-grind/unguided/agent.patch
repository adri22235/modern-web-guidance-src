+            (target.textContent ? ` ("${target.textContent.trim().slice(0, 30)}")` : '');
+        }
+
+        const metric = {
+          id: id,
+          category: category,
+          name: name,
+          target: targetDesc,
+          startTime: startTime,
+          paintTime: paintTime,
+          duration: duration,
+          view: currentView,
+          timestamp: Date.now(),
+          measureNames: measureNames
+        };
+
+        metrics.push(metric);
+
+        console.log(`[Performance Monitor] ${category} "${name}" painted in ${duration.toFixed(2)}ms`);
