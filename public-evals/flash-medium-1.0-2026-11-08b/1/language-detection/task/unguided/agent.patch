+        for (const word of words) {
+          for (const [lang, profile] of Object.entries(langProfiles)) {
+            if (profile.words.has(word)) scores[lang] += 3;
+          }
+        }
+
+        for (const [lang, profile] of Object.entries(langProfiles)) {
+          if (profile.patterns) {
+            for (const pattern of profile.patterns) {
+              const matches = normalized.match(pattern);
+              if (matches) scores[lang] += matches.length * 2;
+            }
+          }
+        }
+
+        let bestLang = null;
+        let maxScore = 0;
+        for (const [lang, score] of Object.entries(scores)) {
+          if (score > maxScore) {
+            maxScore = score;
+            bestLang = lang;
+          }
+        }
+
+        if (maxScore > 0 && bestLang) return bestLang;
+
+        if (/^[a-zA-Z0-9\s.,!?'\"-]+$/.test(trimmed)) return 'English';
+
+        return 'Unknown';
