+
+    <section class="feedback-section" id="customer-feedback">
+      <h2 style="text-align: center;">Customer Feedback</h2>
+      <div class="card feedback-card">
+        <label for="feedback-message">Share Your Feedback</label>
+        <textarea
+          id="feedback-message"
+          name="message"
+          class="feedback-textarea"
+          rows="5"
+          placeholder="Tell us about your coffee experience..."
+        ></textarea>
+        <div class="feedback-actions">
+          <button type="button" id="detect-btn" class="btn">Detect</button>
+          <span id="detection-status" class="detection-status" role="status" aria-live="polite"></span>
+        </div>
+        <div id="detection-result" class="detection-result" style="display: none;" role="region" aria-live="polite">
+          <strong>Detected Language: </strong><span id="detected-language"></span>
+        </div>
+      </div>
+    </section>
   </main>
 
+  <script>
+    (function () {
+      const messageInput = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const statusEl = document.getElementById('detection-status');
+      const resultEl = document.getElementById('detection-result');
+      const detectedLanguageEl = document.getElementById('detected-language');
+
+      function getLanguageName(langCode) {
+        try {
+          const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+          return displayNames.of(langCode) || langCode;
+        } catch (e) {
+          return langCode;
+        }
+      }
+
+      function displayResult(langCode, confidence) {
+        const langName = getLanguageName(langCode);
+        const confidencePct = Math.round(confidence * 100);
+        resultEl.style.display = 'block';
+        detectedLanguageEl.textContent = `${langName} (${langCode}) - ${confidencePct}% confidence`;
+      }
+
+      function detectLanguageFallback(text) {
+        // Script-based detection
+        if (/[\u3040-\u309F\u30A0-\u30FF]/.test(text)) {
+          return { detectedLanguage: 'ja', confidence: 0.95 };
+        }
+        if (/[\u4E00-\u9FFF]/.test(text)) {
+          return { detectedLanguage: 'zh', confidence: 0.95 };
+        }
+        if (/[\uAC00-\uD7AF\u1100-\u11FF]/.test(text)) {
+          return { detectedLanguage: 'ko', confidence: 0.95 };
+        }
+        if (/[\u0400-\u04FF]/.test(text)) {
+          return { detectedLanguage: 'ru', confidence: 0.95 };
+        }
+        if (/[\u0600-\u06FF]/.test(text)) {
+          return { detectedLanguage: 'ar', confidence: 0.95 };
+        }
+
+        const lower = text.toLowerCase();
+        const tokens = lower.match(/\b[\wà-öø-ÿ]+\b/g) || [];
+
+        const dictionaries = {
+          en: ['the', 'is', 'and', 'to', 'of', 'in', 'it', 'you', 'that', 'was', 'for', 'on', 'are', 'as', 'with', 'be', 'this', 'have', 'from', 'coffee', 'great', 'good', 'love', 'really', 'delicious', 'service', 'best', 'place', 'cup'],
+          es: ['el', 'la', 'los', 'las', 'de', 'del', 'y', 'un', 'una', 'en', 'que', 'es', 'por', 'con', 'para', 'café', 'muy', 'gracias', 'bueno', 'buena', 'excelente', 'muchas', 'este', 'esta'],
+          fr: ['le', 'la', 'les', 'de', 'du', 'des', 'et', 'un', 'une', 'dans', 'ce', 'cette', 'est', 'pour', 'avec', 'café', 'très', 'merci', 'bon', 'bonne', 'excellent', 'votre', 'service'],
+          de: ['der', 'die', 'das', 'den', 'dem', 'des', 'und', 'ist', 'in', 'ein', 'eine', 'einen', 'einem', 'einer', 'mit', 'für', 'nicht', 'kaffee', 'sehr', 'danke', 'gut', 'gute', 'schmeckt'],
+          it: ['il', 'lo', 'la', 'i', 'gli', 'le', 'di', 'del', 'della', 'e', 'un', 'una', 'in', 'con', 'per', 'non', 'che', 'caffè', 'molto', 'grazie', 'buono', 'buona', 'ottimo', 'gentile'],
+          pt: ['o', 'a', 'os', 'as', 'de', 'do', 'da', 'dos', 'das', 'e', 'um', 'uma', 'em', 'com', 'para', 'não', 'que', 'café', 'muito', 'muita', 'obrigado', 'obrigada', 'bom', 'boa', 'ótimo']
+        };
+
+        const scores = { en: 0, es: 0, fr: 0, de: 0, it: 0, pt: 0 };
+
+        for (const token of tokens) {
+          for (const [lang, words] of Object.entries(dictionaries)) {
+            if (words.includes(token)) {
+              scores[lang] += 1;
+            }
+          }
+        }
+
+        // Language-specific character hints
+        if (/[áéíóúñ¿¡]/.test(lower)) scores.es += 2;
+        if (/[àèêçœ]/.test(lower)) scores.fr += 2;
+        if (/[äöüß]/.test(lower)) scores.de += 2;
+        if (/[ãõ]/.test(lower)) scores.pt += 2;
+
+        let bestLang = 'en';
+        let maxScore = -1;
+        for (const [lang, score] of Object.entries(scores)) {
+          if (score > maxScore) {
+            maxScore = score;
+            bestLang = lang;
+          }
+        }
+
+        const confidence = maxScore > 0 ? Math.min(0.99, 0.6 + maxScore * 0.1) : 0.5;
+        return { detectedLanguage: bestLang, confidence };
+      }
+
+      async function init() {
+        let detectorAvailable = false;
+
+        if ('LanguageDetector' in self) {
+          try {
+            const availability = await self.LanguageDetector.availability();
+            if (availability !== 'unavailable') {
+              detectorAvailable = true;
+            } else {
+              statusEl.textContent = 'Language detector model unavailable.';
+            }
+          } catch (e) {
+            console.warn('Availability check failed:', e);
+          }
+        }
+
+        detectBtn.addEventListener('click', async () => {
+          const text = messageInput.value.trim();
+          if (!text) {
+            resultEl.style.display = 'block';
+            detectedLanguageEl.textContent = 'Please enter a message to detect.';
+            return;
+          }
+
+          if (detectorAvailable || ('LanguageDetector' in self)) {
+            try {
+              statusEl.textContent = 'Detecting...';
+              const detector = await self.LanguageDetector.create({
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    statusEl.textContent = `Downloading language model: ${Math.round(e.loaded * 100)}%`;
+                  });
+                },
+              });
+              const results = await detector.detect(text);
+              statusEl.textContent = '';
+              if (results && results.length > 0) {
+                displayResult(results[0].detectedLanguage, results[0].confidence);
+                return;
+              }
+            } catch (err) {
+              console.warn('LanguageDetector failed, falling back:', err);
+              statusEl.textContent = '';
+            }
+          }
+
+          const fallback = detectLanguageFallback(text);
+          displayResult(fallback.detectedLanguage, fallback.confidence);
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+
