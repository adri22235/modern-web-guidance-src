+    <script is:inline>
+      // Ensure visible page content is stable and visually complete before transition animates
+      document.addEventListener('astro:before-preparation', (event) => {
+        const originalLoader = event.loader;
+        event.loader = async function () {
+          await originalLoader();
+
+          if (!event.newDocument) return;
+
+          // 1. Wait for web fonts so text does not flash or shift during the transition
+          const fontsPromise = document.fonts ? document.fonts.ready : Promise.resolve();
+
+          // 2. Preload and decode images in the incoming document before view transition animates
+          const docImages = Array.from(event.newDocument.querySelectorAll('img'));
+          const imagePromises = docImages.map((docImg) => {
+            const src = docImg.currentSrc || docImg.src || docImg.getAttribute('src');
+            if (!src) return Promise.resolve();
+
+            return new Promise((resolve) => {
+              const img = new Image();
+              if (docImg.srcset) img.srcset = docImg.srcset;
+              if (docImg.sizes) img.sizes = docImg.sizes;
+              if (docImg.crossOrigin) img.crossOrigin = docImg.crossOrigin;
+              img.src = src;
+
+              const onFinish = () => {
+                if (typeof img.decode === 'function') {
+                  img.decode().then(resolve).catch(resolve);
+                } else {
+                  resolve();
+                }
+              };
+
+              if (img.complete && img.naturalWidth > 0) {
+                onFinish();
+              } else {
+                img.onload = onFinish;
+                img.onerror = resolve; // Continue on failed images
+              }
+            });
+          });
+
+          // Safeguard timeout (2.5s) so slow external assets never block navigation
+          await Promise.race([
+            Promise.all([fontsPromise, ...imagePromises]),
+            new Promise((resolve) => setTimeout(resolve, 2500))
+          ]);
+        };
+      });
+
+      document.addEventListener('astro:before-swap', (event) => {
+        const originalSwap = event.swap;
+        event.swap = () => {
+          originalSwap();
+          // Force layout calculation on the newly swapped DOM to ensure complete
+          // styles and geometry before View Transition captures the 'new' snapshot
+          document.body.offsetHeight;
+        };
+      });
+    </script>
