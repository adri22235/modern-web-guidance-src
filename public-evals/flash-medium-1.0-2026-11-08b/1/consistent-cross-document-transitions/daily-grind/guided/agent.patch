+      @view-transition {
+        navigation: none;
+      }
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/" style="color: inherit; text-decoration: none;">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero" id="hero">
+    <h1>Our Story</h1>
+    <p>Passion in every pour, dedicated to sourcing direct-trade beans worldwide.</p>
+  </header>
+
+  <main class="container" id="about-content">
