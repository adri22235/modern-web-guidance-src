+          cardEl.nextElementSibling?.querySelector('.btn-remove') ??
+          cardEl.previousElementSibling?.querySelector('.btn-remove') ??
+          addSelectedBtn ??
+          selectEl;
+
+        runTransition(() => {
+          cardEl.remove();
+          updateUI();
+          if (hadFocus) {
+            nextFocusTarget?.focus();
+          }
+        });
+      }
+
+      function addBean(beanId) {
+        const bean = BEAN_CATALOG[beanId];
+        if (!bean) return;
+
+        const card = createBeanCard(bean);
+
+        runTransition(() => {
+          gridEl.appendChild(card);
+          updateUI();
+        });
+      }
+
+      function updateUI() {
+        const count = gridEl.querySelectorAll('.bean-card').length;
+        if (count === 0) {
+          statusEl.textContent = '0 roasts selected';
+          emptyStateEl.style.display = 'block';
+        } else {
+          statusEl.textContent = `${count} roast${count === 1 ? '' : 's'} selected${count >= 3 ? ' (Free Shipping!)' : ''}`;
+          emptyStateEl.style.display = 'none';
+        }
+      }
+
+      function populateDefaults() {
+        const defaults = ['ethiopian-yirgacheffe', 'colombian-supremo', 'sumatran-mandheling'];
+        runTransition(() => {
+          gridEl.innerHTML = '';
+          defaults.forEach(id => {
+            const bean = BEAN_CATALOG[id];
+            if (bean) {
+              gridEl.appendChild(createBeanCard(bean));
+            }
+          });
+          updateUI();
+        });
+      }
+
+      // Attach remove listeners to existing SSR / static cards
+      gridEl.querySelectorAll('.bean-card').forEach(card => {
+        card.querySelector('.btn-remove')?.addEventListener('click', () => {
+          removeBean(card);
+        });
+      });
+
+      // Build quick add chips
+      Object.values(BEAN_CATALOG).forEach(bean => {
+        const chip = document.createElement('button');
+        chip.type = 'button';
+        chip.className = 'chip-btn';
+        chip.innerHTML = `+ ${bean.name}`;
+        chip.setAttribute('aria-label', `Add ${bean.name} to box`);
+        chip.addEventListener('click', () => {
+          addBean(bean.id);
+        });
+        quickAddChipsEl.appendChild(chip);
+      });
+
+      addSelectedBtn.addEventListener('click', () => {
+        addBean(selectEl.value);
+      });
+
+      resetBtn.addEventListener('click', () => {
+        populateDefaults();
+      });
+
+      emptyAddDefaultsBtn.addEventListener('click', () => {
+        populateDefaults();
+      });
+    })();
+  </script>
 </body>
 
 </html>
