+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      if (!scroller || !status) return;
+
+      const beans = Array.from(scroller.querySelectorAll('.bean-card'));
+
+      function getBeanName(beanEl) {
+        if (!beanEl) return '';
+        return beanEl.dataset.bean ||
+               beanEl.dataset.name ||
+               beanEl.querySelector('h3')?.textContent?.trim() ||
+               beanEl.getAttribute('aria-label') ||
+               '';
+      }
+
+      function getVisibleBean() {
+        if (!beans.length) return null;
+
+        const scrollerRect = scroller.getBoundingClientRect();
+
+        // Check if layout metrics are available (browser rendering)
+        if (scrollerRect.width > 0 && scrollerRect.height > 0) {
+          let bestBean = null;
+          let maxVisibleRatio = -1;
+          let minDistanceToCenter = Infinity;
+
+          const scrollerCenterX = scrollerRect.left + scrollerRect.width / 2;
+          const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+
+          for (const bean of beans) {
+            const rect = bean.getBoundingClientRect();
+            const visibleWidth = Math.max(0, Math.min(rect.right, scrollerRect.right) - Math.max(rect.left, scrollerRect.left));
+            const visibleHeight = Math.max(0, Math.min(rect.bottom, scrollerRect.bottom) - Math.max(rect.top, scrollerRect.top));
+            const visibleArea = visibleWidth * visibleHeight;
+            const totalArea = (rect.width * rect.height) || 1;
+            const visibleRatio = visibleArea / totalArea;
+
+            const beanCenterX = rect.left + rect.width / 2;
+            const beanCenterY = rect.top + rect.height / 2;
+            const dist = Math.hypot(beanCenterX - scrollerCenterX, beanCenterY - scrollerCenterY);
+
+            if (visibleRatio > maxVisibleRatio || (Math.abs(visibleRatio - maxVisibleRatio) < 0.1 && dist < minDistanceToCenter)) {
+              maxVisibleRatio = visibleRatio;
+              minDistanceToCenter = dist;
+              bestBean = bean;
+            }
+          }
+          if (bestBean) return bestBean;
+        }
+
+        // Fallback for non-layout environments (e.g. headless tests without full layout or JSDOM)
+        const scrollLeft = scroller.scrollLeft || 0;
+        const scrollTop = scroller.scrollTop || 0;
+        const clientWidth = scroller.clientWidth || 0;
+        const clientHeight = scroller.clientHeight || 0;
+
+        const scrollerCenterX = scrollLeft + clientWidth / 2;
+        const scrollerCenterY = scrollTop + clientHeight / 2;
+
+        let bestBean = beans[0];
+        let minDistance = Infinity;
+
+        for (const bean of beans) {
+          const beanCenterX = (bean.offsetLeft || 0) + ((bean.offsetWidth || 0) / 2);
+          const beanCenterY = (bean.offsetTop || 0) + ((bean.offsetHeight || 0) / 2);
+          const dist = Math.hypot(beanCenterX - scrollerCenterX, beanCenterY - scrollerCenterY);
+          if (dist < minDistance) {
+            minDistance = dist;
+            bestBean = bean;
+          }
+        }
+
+        return bestBean;
+      }
+
+      function updateVisibleBean() {
+        const visibleBean = getVisibleBean();
+        if (visibleBean) {
+          const name = getBeanName(visibleBean);
+          status.textContent = name;
+          status.setAttribute('data-visible-bean', name);
+          status.setAttribute('data-scrolling', 'false');
+          status.setAttribute('data-status', 'idle');
+        }
+      }
+
+      let scrollTimeout = null;
+
+      function onScroll() {
+        // Fast update: indicate active scrolling immediately without triggering reflows
+        if (status.textContent !== 'Scrolling...') {
+          status.textContent = 'Scrolling...';
+          status.setAttribute('data-scrolling', 'true');
+          status.setAttribute('data-status', 'scrolling');
+        }
+
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(onScrollEnd, 100);
+      }
+
+      function onScrollEnd() {
+        clearTimeout(scrollTimeout);
+        updateVisibleBean();
+      }
+
+      // Attach passive scroll listener for smooth, lag-free scrolling during movement
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      scroller.addEventListener('scrollend', onScrollEnd);
+
+      window.addEventListener('resize', updateVisibleBean, { passive: true });
+      window.addEventListener('load', updateVisibleBean);
+
+      // Initial visible bean detection
+      updateVisibleBean();
+    })();
+  </script>
+
