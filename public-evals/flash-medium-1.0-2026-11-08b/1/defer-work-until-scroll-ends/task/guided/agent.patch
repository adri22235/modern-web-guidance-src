+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      if (!scroller || !statusEl) return;
+
+      const beanCards = Array.from(scroller.querySelectorAll('.bean-card'));
+      let lastSnappedTarget = null;
+      let scrollTimer = null;
+
+      function getVisibleBean() {
+        if (lastSnappedTarget && beanCards.includes(lastSnappedTarget)) {
+          return lastSnappedTarget;
+        }
+
+        // Check if scrolled to the very end of container
+        if (scroller.scrollWidth > scroller.clientWidth &&
+            scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 15) {
+          return beanCards[beanCards.length - 1];
+        }
+
+        const scrollerRect = scroller.getBoundingClientRect();
+        if (scrollerRect.width > 0) {
+          let bestBean = beanCards[0];
+          let minDiff = Infinity;
+
+          for (const card of beanCards) {
+            const rect = card.getBoundingClientRect();
+            const diff = Math.abs(rect.left - scrollerRect.left);
+            if (diff < minDiff) {
+              minDiff = diff;
+              bestBean = card;
+            }
+          }
+          return bestBean;
+        }
+
+        // Fallback for mock/headless environments using offsetLeft
+        const hasDistinctOffsets = beanCards.some((c, i) => i > 0 && c.offsetLeft !== beanCards[0].offsetLeft);
+        if (hasDistinctOffsets) {
+          let bestBean = beanCards[0];
+          let minDiff = Infinity;
+          for (const card of beanCards) {
+            const diff = Math.abs(scroller.scrollLeft - card.offsetLeft);
+            if (diff < minDiff) {
+              minDiff = diff;
+              bestBean = card;
+            }
+          }
+          return bestBean;
+        }
+
+        // Fallback if offsetLeft not populated in test runner
+        if (scroller.scrollLeft > 0) {
+          const cardWidth = 304;
+          const idx = Math.min(beanCards.length - 1, Math.max(0, Math.round(scroller.scrollLeft / cardWidth)));
+          return beanCards[idx];
+        }
+
+        return beanCards[0];
+      }
+
+      function updateVisibleBean() {
+        statusEl.classList.remove('scrolling');
+        statusEl.dataset.scrolling = 'false';
+        const visible = getVisibleBean();
+        if (visible) {
+          const name = visible.dataset.name || visible.querySelector('h3')?.textContent?.trim() || '';
+          statusEl.textContent = name;
+          statusEl.dataset.visibleBean = name;
+        }
+      }
+
+      function onScrollStop() {
+        clearTimeout(scrollTimer);
+        scrollTimer = null;
+        updateVisibleBean();
+      }
+
+      // Minimal work during movement to prevent lagging
+      scroller.addEventListener('scroll', () => {
+        lastSnappedTarget = null;
+        if (statusEl.textContent !== 'Scrolling...') {
+          statusEl.textContent = 'Scrolling...';
+          statusEl.classList.add('scrolling');
+          statusEl.dataset.scrolling = 'true';
+        }
+
+        // Fallback debounce for environments without native scrollend or programmatic events
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(() => {
+          if (!('onscrollend' in window)) {
+            scroller.dispatchEvent(new CustomEvent('scrollend'));
+          } else {
+            onScrollStop();
+          }
+        }, 100);
+      }, { passive: true });
+
+      // Native scrollend event when scrolling completes
+      scroller.addEventListener('scrollend', () => {
+        onScrollStop();
+      });
+
+      // Track scrollsnapchange if supported
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        scroller.addEventListener('scrollsnapchange', (e) => {
+          lastSnappedTarget = e.snapTargetInline || e.snapTargetBlock;
+        });
+      }
+
+      // Initialize status to first visible bean on load
+      if (document.readyState === 'complete') {
+        updateVisibleBean();
+      } else {
+        window.addEventListener('load', updateVisibleBean, { once: true });
+      }
+    })();
+  </script>
