+  <script>
+    document.querySelectorAll('.iced-checkbox').forEach(checkbox => {
+      const updateCard = (cb) => {
+        const card = cb.closest('.card');
+        if (card) {
+          if (cb.checked) {
+            card.classList.add('iced', 'is-iced');
+            card.setAttribute('data-iced', 'true');
+          } else {
+            card.classList.remove('iced', 'is-iced');
+            card.removeAttribute('data-iced');
+          }
+        }
+      };
+
+      updateCard(checkbox);
+
+      checkbox.addEventListener('change', function () {
+        updateCard(this);
+      });
+      checkbox.addEventListener('input', function () {
+        updateCard(this);
+      });
+    });
+  </script>
