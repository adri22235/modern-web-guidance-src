+  <script>
+    (function () {
+      let initialized = false;
+
+      function initNewsletter() {
+        if (initialized) return;
+        const form = document.getElementById('newsletter-form');
+        const emailInput = document.getElementById('newsletter-email');
+        const errorEl = document.getElementById('newsletter-error');
+        const successEl = document.getElementById('newsletter-success');
+        const submitBtn = document.getElementById('newsletter-submit');
+
+        if (!form || !emailInput || !errorEl) return;
+        initialized = true;
+
+        let hasInteracted = false;
+
+        const emailPattern = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;
+
+        function isValid(email) {
+          const val = (email || '').trim();
+          if (!val) return false;
+          if (!emailPattern.test(val)) return false;
+          if (typeof emailInput.checkValidity === 'function' && !emailInput.checkValidity()) {
+            return false;
+          }
+          return true;
+        }
+
+        function getMessage(email) {
+          const val = (email || '').trim();
+          if (!val) {
+            return 'Please enter a valid email address.';
+          }
+          return 'Please enter a valid email address.';
+        }
+
+        function showError(msg) {
+          errorEl.textContent = msg;
+          errorEl.hidden = false;
+          errorEl.style.display = 'block';
+          errorEl.classList.add('visible');
+          emailInput.classList.add('input-error');
+          emailInput.setAttribute('aria-invalid', 'true');
+          emailInput.setAttribute('aria-describedby', errorEl.id);
+          if (successEl) {
+            successEl.hidden = true;
+            successEl.style.display = 'none';
+            successEl.classList.remove('visible');
+            successEl.textContent = '';
+          }
+        }
+
+        function clearError() {
+          errorEl.textContent = '';
+          errorEl.hidden = true;
+          errorEl.style.display = 'none';
+          errorEl.classList.remove('visible');
+          emailInput.classList.remove('input-error');
+          emailInput.setAttribute('aria-invalid', 'false');
+          emailInput.removeAttribute('aria-describedby');
+        }
+
+        function handleSubmit(e) {
+          if (e) e.preventDefault();
+          hasInteracted = true;
+          if (!isValid(emailInput.value)) {
+            showError(getMessage(emailInput.value));
+            emailInput.focus();
+          } else {
+            clearError();
+            if (successEl) {
+              successEl.textContent = 'Thank you for subscribing to The Daily Grind!';
+              successEl.hidden = false;
+              successEl.style.display = 'block';
+              successEl.classList.add('visible');
+            }
+          }
+        }
+
+        // Clear error as soon as email becomes valid, or show if already interacted
+        emailInput.addEventListener('input', () => {
+          if (isValid(emailInput.value)) {
+            clearError();
+          } else if (hasInteracted) {
+            showError(getMessage(emailInput.value));
+          }
+        });
+
+        // Trigger post-interaction validation when user blurs field
+        emailInput.addEventListener('blur', () => {
+          hasInteracted = true;
+          if (isValid(emailInput.value)) {
+            clearError();
+          } else {
+            showError(getMessage(emailInput.value));
+          }
+        });
+
+        // Trigger post-interaction validation on change
+        emailInput.addEventListener('change', () => {
+          hasInteracted = true;
+          if (isValid(emailInput.value)) {
+            clearError();
+          } else {
+            showError(getMessage(emailInput.value));
+          }
+        });
+
+        // Intercept native HTML5 invalid event
+        emailInput.addEventListener('invalid', (e) => {
+          e.preventDefault();
+          hasInteracted = true;
+          showError(getMessage(emailInput.value));
+        });
+
+        // Validate post-interaction on form submission and button click
+        form.addEventListener('submit', handleSubmit);
+        if (submitBtn) {
+          submitBtn.addEventListener('click', handleSubmit);
+        }
+
+        // Reset listener
+        form.addEventListener('reset', () => {
+          hasInteracted = false;
+          clearError();
+          if (successEl) {
+            successEl.hidden = true;
+            successEl.style.display = 'none';
+            successEl.classList.remove('visible');
+            successEl.textContent = '';
+          }
+        });
+      }
+
+      initNewsletter();
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initNewsletter);
+      }
+    })();
+  </script>
 </body>
 
