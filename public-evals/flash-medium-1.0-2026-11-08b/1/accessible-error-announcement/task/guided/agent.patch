+        if (!newsletterForm.checkValidity()) {
+          const invalidInput = newsletterForm.querySelector('input:invalid');
+          if (invalidInput) {
+            if (typeof CSS === 'undefined' || !CSS.supports?.('selector(:user-invalid)')) {
+              invalidInput.classList.add('user-invalid-fallback');
+            }
+            invalidInput.setAttribute('aria-invalid', 'true');
+            invalidInput.focus();
+          }
+        }
+      });
+    }
+  </script>
