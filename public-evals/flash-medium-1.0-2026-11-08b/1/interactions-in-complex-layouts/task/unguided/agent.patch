+      // Barista Order Store
+      // Column subscriptions ensure that column rendering is strictly isolated:
+      // when a card moves from status A to status B, only columns A and B re-render.
+      class BaristaStore {
+        constructor(orders = []) {
+          this.orders = [...orders];
+          this.subscribers = {
+            queued: new Set(),
+            brewing: new Set(),
+            ready: new Set()
+          };
+          this.orderSequence = 108;
+        }
+
+        getOrders() {
+          return [...this.orders];
+        }
+
+        getOrdersByStatus(status) {
+          return this.orders.filter(function (order) {
+            return order.status === status;
+          });
+        }
+
+        getOrder(id) {
+          for (let i = 0; i < this.orders.length; i++) {
+            if (this.orders[i].id === id) return this.orders[i];
+          }
+          return null;
+        }
+
+        subscribe(status, callback) {
+          if (!this.subscribers[status]) {
+            this.subscribers[status] = new Set();
+          }
+          this.subscribers[status].add(callback);
+          // Initial invocation for this isolated column
+          callback(this.getOrdersByStatus(status));
+          const self = this;
+          return function unsubscribe() {
+            self.subscribers[status].delete(callback);
+          };
+        }
+
+        notifyColumn(status) {
+          if (this.subscribers[status]) {
+            const columnOrders = this.getOrdersByStatus(status);
+            this.subscribers[status].forEach(function (callback) {
+              callback(columnOrders);
+            });
+          }
+        }
+
+        moveOrder(orderId, targetStatus) {
+          const order = this.getOrder(orderId);
+          if (!order) return false;
+          if (order.status === targetStatus) return false;
+
+          const sourceStatus = order.status;
+          order.status = targetStatus;
+          order.updatedAt = new Date();
+
+          // ISOLATED RENDERING: Only trigger notifications for affected columns
+          this.notifyColumn(sourceStatus);
+          this.notifyColumn(targetStatus);
+          return true;
+        }
+
+        addOrder(orderData) {
+          const newOrder = {
+            id: 'ord-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
+            orderNumber: '#' + (this.orderSequence++),
+            customerName: (orderData && orderData.customerName) ? orderData.customerName.trim() : 'Guest',
+            drinkName: (orderData && orderData.drinkName) ? orderData.drinkName : 'House Coffee',
+            customization: (orderData && orderData.customization && orderData.customization.trim()) ? orderData.customization.trim() : 'Standard recipe',
+            status: 'queued',
+            timeAgo: 'Just now',
+            createdAt: new Date()
+          };
+
+          this.orders.push(newOrder);
+
+          // ISOLATED RENDERING: Only notify queued column
+          this.notifyColumn('queued');
+          return newOrder;
+        }
+      }
