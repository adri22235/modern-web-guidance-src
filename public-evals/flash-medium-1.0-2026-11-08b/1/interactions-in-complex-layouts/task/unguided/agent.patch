+              <strong>${escapeHTML(order.customerName)}</strong>
+            </div>
+            <div class="order-notes">
+              <span>${escapeHTML(order.customization)}</span>
+            </div>
+          `;
+
+          // Card Actions (Quick stage transitions)
+          const actions = document.createElement('div');
+          actions.className = 'order-card-actions';
+
+          const store = this.store;
+          if (this.status === 'queued') {
+            const brewBtn = document.createElement('button');
+            brewBtn.type = 'button';
+            brewBtn.className = 'card-btn next-action-btn';
+            brewBtn.textContent = 'Start Brewing →';
+            brewBtn.title = 'Move order to Brewing';
+            brewBtn.addEventListener('click', function (e) {
+              e.stopPropagation();
+              store.moveOrder(order.id, 'brewing');
+            });
+            actions.appendChild(brewBtn);
+          } else if (this.status === 'brewing') {
+            const requeueBtn = document.createElement('button');
+            requeueBtn.type = 'button';
+            requeueBtn.className = 'card-btn prev-action-btn';
+            requeueBtn.textContent = '← Requeue';
+            requeueBtn.title = 'Move back to Queued';
+            requeueBtn.addEventListener('click', function (e) {
+              e.stopPropagation();
+              store.moveOrder(order.id, 'queued');
+            });
+
+            const readyBtn = document.createElement('button');
+            readyBtn.type = 'button';
+            readyBtn.className = 'card-btn next-action-btn ready-btn';
+            readyBtn.textContent = 'Mark Ready ✓';
+            readyBtn.title = 'Move order to Ready';
+            readyBtn.addEventListener('click', function (e) {
+              e.stopPropagation();
+              store.moveOrder(order.id, 'ready');
+            });
+
+            actions.appendChild(requeueBtn);
+            actions.appendChild(readyBtn);
+          } else if (this.status === 'ready') {
+            const brewBackBtn = document.createElement('button');
+            brewBackBtn.type = 'button';
+            brewBackBtn.className = 'card-btn prev-action-btn';
+            brewBackBtn.textContent = '← Back to Brewing';
+            brewBackBtn.title = 'Move back to Brewing';
+            brewBackBtn.addEventListener('click', function (e) {
+              e.stopPropagation();
+              store.moveOrder(order.id, 'brewing');
+            });
+            actions.appendChild(brewBackBtn);
+          }
+
+          card.appendChild(header);
+          card.appendChild(body);
+          card.appendChild(actions);
+
+          // Card Drag Events
+          const currentStatus = this.status;
+          card.addEventListener('dragstart', function (e) {
+            window.__draggedOrderId = order.id;
+            card.classList.add('is-dragging');
+            if (e.dataTransfer) {
+              try {
+                e.dataTransfer.setData('text/plain', order.id);
+                e.dataTransfer.setData('text/order-id', order.id);
+                e.dataTransfer.setData('text/status', currentStatus);
+                e.dataTransfer.effectAllowed = 'move';
+              } catch (_) {}
+            }
+          });
+
+          card.addEventListener('dragend', function () {
+            card.classList.remove('is-dragging');
+            window.__draggedOrderId = null;
+            document.querySelectorAll('.board-column').forEach(function (col) {
+              col.classList.remove('drag-over');
+            });
+          });
+
+          return card;
+        }
+      }
+
+      // Initialize Board
+      function init() {
+        const store = new BaristaStore(initialOrders);
+
+        const queuedColEl = document.getElementById('column-queued');
+        const brewingColEl = document.getElementById('column-brewing');
+        const readyColEl = document.getElementById('column-ready');
+
+        const columns = {
+          queued: new BoardColumn('queued', 'Queued', store, queuedColEl),
+          brewing: new BoardColumn('brewing', 'Brewing', store, brewingColEl),
+          ready: new BoardColumn('ready', 'Ready', store, readyColEl)
+        };
+
+        // Order creation form
+        const form = document.getElementById('new-order-form');
+        const nameInput = document.getElementById('customer-name-input');
+        const drinkSelect = document.getElementById('drink-select');
+        const notesInput = document.getElementById('order-notes-input');
+
+        if (form) {
+          form.addEventListener('submit', function (e) {
+            e.preventDefault();
+            const customerName = nameInput.value;
+            const drinkName = drinkSelect.value;
+            const customization = notesInput.value;
+
+            store.addOrder({
+              customerName: customerName,
+              drinkName: drinkName,
+              customization: customization
+            });
+
+            form.reset();
+            nameInput.focus();
+          });
+        }
+
+        // Quick add preset buttons
+        const presetButtons = document.querySelectorAll('.preset-btn');
+        presetButtons.forEach(function (btn) {
+          btn.addEventListener('click', function () {
+            store.addOrder({
+              customerName: btn.getAttribute('data-customer') || 'Guest',
+              drinkName: btn.getAttribute('data-drink') || 'House Coffee',
+              customization: btn.getAttribute('data-notes') || ''
+            });
+          });
+        });
+
+        // Global references for programmatic access and automated testing
+        window.baristaStore = store;
+        window.baristaColumns = columns;
+        window.baristaBoard = {
+          store: store,
+          columns: columns,
+          renderColumn: function (status) {
+            if (columns[status]) {
+              columns[status].render(store.getOrdersByStatus(status));
+            }
+          }
+        };
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
 </html>
