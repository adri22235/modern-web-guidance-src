+  <script>
+    (function () {
+      let draggedCard = null;
+      let nextOrderId = 108;
+
+      const columns = document.querySelectorAll('.board-column');
+      const dialog = document.getElementById('new-order-dialog');
+      const openDialogBtn = document.getElementById('open-new-order-btn');
+      const cancelDialogBtn = document.getElementById('cancel-order-btn');
+      const newOrderForm = document.getElementById('new-order-form');
+
+      function updateAllColumnCounts() {
+        columns.forEach(col => {
+          const status = col.dataset.status;
+          const count = col.querySelectorAll('.card').length;
+          const badge = document.getElementById(`count-${status}`);
+          if (badge) {
+            badge.textContent = count;
+          }
+        });
+      }
+
+      function updateCardStatus(card, status) {
+        card.dataset.status = status;
+        const footer = card.querySelector('.card-footer');
+        if (!footer) return;
+
+        let statusTagHtml = '';
+        let actionsHtml = '';
+
+        if (status === 'queued') {
+          statusTagHtml = '<span class="status-tag status-queued-tag">Queued</span>';
+          actionsHtml = '<button type="button" class="action-btn" data-action="brew" title="Move to Brewing">➔ Start Brew</button>';
+        } else if (status === 'brewing') {
+          statusTagHtml = '<span class="status-tag status-brewing-tag">Brewing ♨</span>';
+          actionsHtml = `
+            <button type="button" class="action-btn" data-action="queue" title="Move back to Queue">← Queue</button>
+            <button type="button" class="action-btn" data-action="ready" title="Move to Ready">➔ Ready</button>
+          `;
+        } else if (status === 'ready') {
+          statusTagHtml = '<span class="status-tag status-ready-tag">Ready ✓</span>';
+          actionsHtml = `
+            <button type="button" class="action-btn" data-action="brew" title="Return to Brewing">← Brew</button>
+            <button type="button" class="action-btn complete-btn" data-action="complete" title="Mark Picked Up">✓ Picked Up</button>
+          `;
+        }
+
+        footer.innerHTML = `
+          ${statusTagHtml}
+          <div class="card-actions">${actionsHtml}</div>
+        `;
+      }
+
+      function getDragAfterElement(container, y) {
+        const draggableElements = [...container.querySelectorAll('.card:not(.dragging)')];
+
+        return draggableElements.reduce((closest, child) => {
+          const box = child.getBoundingClientRect();
+          const offset = y - box.top - box.height / 2;
+          if (offset < 0 && offset > closest.offset) {
+            return { offset: offset, element: child };
+          } else {
+            return closest;
+          }
+        }, { offset: Number.NEGATIVE_INFINITY }).element;
+      }
+
+      function attachCardEvents(card) {
+        card.addEventListener('dragstart', (e) => {
+          draggedCard = card;
+          card.classList.add('dragging');
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.dataset.orderId || '');
+        });
+
+        card.addEventListener('dragend', () => {
+          card.classList.remove('dragging');
+          draggedCard = null;
+          columns.forEach(col => col.classList.remove('drag-over'));
+          updateAllColumnCounts();
+        });
+
+        card.addEventListener('click', (e) => {
+          const btn = e.target.closest('.action-btn');
+          if (!btn) return;
+
+          const action = btn.dataset.action;
+          if (action === 'brew') {
+            const list = document.getElementById('list-brewing');
+            list.appendChild(card);
+            updateCardStatus(card, 'brewing');
+            updateAllColumnCounts();
+          } else if (action === 'ready') {
+            const list = document.getElementById('list-ready');
+            list.appendChild(card);
+            updateCardStatus(card, 'ready');
+            updateAllColumnCounts();
+          } else if (action === 'queue') {
+            const list = document.getElementById('list-queued');
+            list.appendChild(card);
+            updateCardStatus(card, 'queued');
+            updateAllColumnCounts();
+          } else if (action === 'complete') {
+            card.style.opacity = '0';
+            card.style.transform = 'scale(0.9)';
+            setTimeout(() => {
+              card.remove();
+              updateAllColumnCounts();
+            }, 200);
+          }
+        });
+      }
+
+      // Initialize existing cards
+      document.querySelectorAll('.board-column .card').forEach(attachCardEvents);
+
+      // Setup drop zones for each column
+      columns.forEach(col => {
+        col.addEventListener('dragover', (e) => {
+          e.preventDefault();
+          e.dataTransfer.dropEffect = 'move';
+          col.classList.add('drag-over');
+        });
+
+        col.addEventListener('dragleave', (e) => {
+          if (!col.contains(e.relatedTarget)) {
+            col.classList.remove('drag-over');
+          }
+        });
+
+        col.addEventListener('drop', (e) => {
+          e.preventDefault();
+          col.classList.remove('drag-over');
+          if (draggedCard) {
+            const list = col.querySelector('.card-list');
+            const afterElement = getDragAfterElement(list, e.clientY);
+            if (afterElement == null) {
+              list.appendChild(draggedCard);
+            } else {
+              list.insertBefore(draggedCard, afterElement);
+            }
+            updateCardStatus(draggedCard, col.dataset.status);
+            updateAllColumnCounts();
+          }
+        });
+      });
+
+      // Dialog Controls
+      if (openDialogBtn && dialog) {
+        openDialogBtn.addEventListener('click', () => {
+          dialog.showModal();
+        });
+      }
+
+      if (cancelDialogBtn && dialog) {
+        cancelDialogBtn.addEventListener('click', () => {
+          dialog.close();
+        });
+      }
+
+      if (dialog) {
+        dialog.addEventListener('click', (e) => {
+          const rect = dialog.getBoundingClientRect();
+          const inDialog = (
+            rect.top <= e.clientY &&
+            e.clientY <= rect.top + rect.height &&
+            rect.left <= e.clientX &&
+            e.clientX <= rect.left + rect.width
+          );
+          if (!inDialog) {
+            dialog.close();
+          }
+        });
+      }
+
+      if (newOrderForm) {
+        newOrderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const custName = document.getElementById('cust-name').value.trim();
+          const drink = document.getElementById('drink-select').value;
+          const customs = document.getElementById('drink-customs').value.trim() || 'Standard Build';
+
+          const card = document.createElement('div');
+          card.className = 'card order-card';
+          card.draggable = true;
+          card.dataset.orderId = nextOrderId;
+          card.dataset.status = 'queued';
+
+          card.innerHTML = `
+            <div class="card-top">
+              <span class="order-id">#${nextOrderId++}</span>
+              <span class="order-time">Just now</span>
+            </div>
+            <div class="customer-name">${custName}</div>
+            <div class="drink-name">☕ ${drink}</div>
+            <div class="customizations">${customs}</div>
+            <div class="card-footer">
+              <span class="status-tag status-queued-tag">Queued</span>
+              <div class="card-actions">
+                <button type="button" class="action-btn" data-action="brew" title="Move to Brewing">➔ Start Brew</button>
+              </div>
+            </div>
+          `;
+
+          attachCardEvents(card);
+          document.getElementById('list-queued').appendChild(card);
+          updateAllColumnCounts();
+
+          newOrderForm.reset();
+          dialog.close();
+        });
+      }
+
+      updateAllColumnCounts();
+    })();
+  </script>
