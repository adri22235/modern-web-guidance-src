+  <!-- Toast Notification Container -->
+  <div class="toast-container" id="toast-container" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    (function () {
+      let toastCounter = 0;
+
+      const ICONS = {
+        success: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>',
+        info: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>',
+        warning: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>',
+        error: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>'
+      };
+
+      function getToastContainer() {
+        let container = document.getElementById('toast-container') || document.querySelector('.toast-container');
+        if (!container) {
+          container = document.createElement('div');
+          container.id = 'toast-container';
+          container.className = 'toast-container';
+          container.setAttribute('aria-live', 'polite');
+          container.setAttribute('aria-atomic', 'true');
+          document.body.appendChild(container);
+        }
+        return container;
+      }
+
+      function dismissToast(toast) {
+        if (!toast || toast.classList.contains('toast-hiding')) return;
+        toast.classList.remove('toast-shown');
+        toast.classList.add('toast-hiding');
+
+        let removed = false;
+        const removeElement = () => {
+          if (removed) return;
+          removed = true;
+          if (toast.parentNode) {
+            toast.parentNode.removeChild(toast);
+          }
+        };
+
+        toast.addEventListener('transitionend', removeElement, { once: true });
+        setTimeout(removeElement, 350); // Fallback if transition event doesn't fire
+      }
+
+      function showToast(options) {
+        if (typeof options === 'string') {
+          options = { message: options };
+        }
+        const {
+          message = 'Notification',
+          type = 'info',
+          title = '',
+          duration = 4000
+        } = options || {};
+
+        const toastId = 'toast-' + (++toastCounter);
+        const container = getToastContainer();
+
+        const toast = document.createElement('div');
+        toast.className = 'toast toast-' + type;
+        toast.id = toastId;
+        toast.setAttribute('role', 'status');
+        toast.style.setProperty('--toast-duration', duration + 'ms');
+
+        const iconMarkup = ICONS[type] || ICONS.info;
+        const titleMarkup = title ? '<div class="toast-title">' + escapeHTML(title) + '</div>' : '';
+
+        toast.innerHTML =
+          '<div class="toast-icon">' + iconMarkup + '</div>' +
+          '<div class="toast-content">' +
+            titleMarkup +
+            '<div class="toast-message">' + escapeHTML(message) + '</div>' +
+          '</div>' +
+          '<button type="button" class="toast-close" aria-label="Close notification" popovertarget="' + toastId + '" popovertargetaction="hide">' +
+            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
+              '<line x1="18" y1="6" x2="6" y2="18"></line>' +
+              '<line x1="6" y1="6" x2="18" y2="18"></line>' +
+            '</svg>' +
+          '</button>' +
+          '<div class="toast-progress"></div>';
+
+        const closeBtn = toast.querySelector('.toast-close');
+        if (closeBtn) {
+          closeBtn.addEventListener('click', function (e) {
+            e.stopPropagation();
+            dismissToast(toast);
+          });
+        }
+
+        // Auto dismissal with hover pause
+        let remainingTime = duration;
+        let startTime = Date.now();
+        let timerId = null;
+
+        const startTimer = () => {
+          startTime = Date.now();
+          timerId = setTimeout(() => {
+            dismissToast(toast);
+          }, remainingTime);
+        };
+
+        const pauseTimer = () => {
+          clearTimeout(timerId);
+          remainingTime -= (Date.now() - startTime);
+        };
+
+        toast.addEventListener('mouseenter', pauseTimer);
+        toast.addEventListener('mouseleave', () => {
+          if (remainingTime > 0) {
+            startTimer();
+          }
+        });
+
+        // Trigger entrance animation
+        toast.classList.add('toast-entering');
+        container.appendChild(toast);
+
+        // Force reflow and reveal
+        requestAnimationFrame(() => {
+          toast.classList.remove('toast-entering');
+          toast.classList.add('toast-shown');
+        });
+
+        startTimer();
+        return toast;
+      }
+
+      function escapeHTML(str) {
+        if (!str) return '';
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      }
+
+      // Event delegation for any .toast-trigger element
+      document.addEventListener('click', function (e) {
+        const trigger = e.target.closest('.toast-trigger');
+        if (!trigger) return;
+
+        // Prevent default navigation for buttons and internal links
+        if (trigger.tagName === 'A' || trigger.tagName === 'BUTTON') {
+          e.preventDefault();
+        }
+
+        const message = trigger.getAttribute('data-toast-message') ||
+                        trigger.getAttribute('data-message') ||
+                        trigger.getAttribute('data-toast') ||
+                        trigger.dataset.toastMessage ||
+                        trigger.dataset.message ||
+                        trigger.dataset.toast ||
+                        trigger.textContent.trim() ||
+                        'Action completed!';
+
+        const type = trigger.getAttribute('data-toast-type') ||
+                     trigger.getAttribute('data-type') ||
+                     trigger.dataset.toastType ||
+                     trigger.dataset.type ||
+                     'info';
+
+        const title = trigger.getAttribute('data-toast-title') ||
+                      trigger.getAttribute('data-title') ||
+                      trigger.dataset.toastTitle ||
+                      trigger.dataset.title ||
+                      '';
+
+        showToast({ message, type, title });
+      });
+
+      // Expose helper globally
+      window.showToast = showToast;
+      window.createToast = showToast;
+    })();
+  </script>
 </body>
 
