@@ -0,0 +1,18 @@
+import cjs from './origin-validation.js';
+
+export const Origin = cjs.Origin;
+export const extractOrigin = cjs.extractOrigin;
+export const isTrustedSameOrigin = cjs.isTrustedSameOrigin;
+export const isAllowedSameSiteUrl = cjs.isAllowedSameSiteUrl;
+export const isSameSiteUrl = cjs.isSameSiteUrl;
+export const isExternalLink = cjs.isExternalLink;
+export const validateRedirectUrl = cjs.validateRedirectUrl;
+export const handleSandboxedWidgetMessage = cjs.handleSandboxedWidgetMessage;
+export const resetSandboxPin = cjs.resetSandboxPin;
+export const setTrustedOrderingOrigin = cjs.setTrustedOrderingOrigin;
+export const setAppOrigin = cjs.setAppOrigin;
+export const TRUSTED_ORIGIN = cjs.TRUSTED_ORIGIN;
+export const TRUSTED_ORDERING_ORIGIN = cjs.TRUSTED_ORDERING_ORIGIN;
+export const APP_ORIGIN = cjs.APP_ORIGIN;
+
+export default cjs;
