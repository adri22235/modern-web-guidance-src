+/**
+ * Origin and site validation for The Daily Grind.
+ * Implements modern web platform specifications for Origin and schemeful same-site validation.
+ */
+
+// Fallback / Polyfill for environments where window.Origin is not natively available (e.g., Node/JSDOM)
+const KNOWN_PUBLIC_SUFFIXES = new Set([
+  'co.uk', 'org.uk', 'gov.uk', 'ac.uk', 'net.uk', 'ltd.uk', 'me.uk', 'plc.uk',
+  'github.io', 'gitlab.io',
+  'com.au', 'net.au', 'org.au', 'edu.au', 'gov.au',
+  'co.nz', 'net.nz', 'org.nz', 'govt.nz',
+  'co.jp', 'ne.jp', 'or.jp', 'go.jp', 'ac.jp',
+  'com.br', 'net.br', 'org.br', 'gov.br',
+  'co.in', 'net.in', 'org.in', 'gen.in',
+  'com.sg', 'edu.sg', 'gov.sg',
+  'co.za', 'org.za', 'gov.za',
+  'com.tr', 'edu.tr', 'gov.tr',
+  'com.mx', 'org.mx', 'gob.mx'
+]);
+
+function getRegistrableDomain(hostname) {
+  if (!hostname) return '';
+  const host = hostname.toLowerCase();
+  const parts = host.split('.');
+  if (parts.length <= 1) return host;
+
+  if (parts.length >= 2) {
+    const twoPart = parts.slice(-2).join('.');
+    if (KNOWN_PUBLIC_SUFFIXES.has(twoPart)) {
+      if (parts.length >= 3) {
+        return parts.slice(-3).join('.');
+      }
+      return host;
+    }
+  }
+
+  if (parts.length >= 3) {
+    const threePart = parts.slice(-3).join('.');
+    if (KNOWN_PUBLIC_SUFFIXES.has(threePart)) {
+      if (parts.length >= 4) {
+        return parts.slice(-4).join('.');
+      }
+      return host;
+    }
+  }
+
+  return parts.slice(-2).join('.');
+}
+
+const windowOpaqueOrigins = new WeakMap();
+
+function getOpaqueOriginForSource(source) {
+  if (!source || typeof source !== 'object') {
+    return new Origin();
+  }
+  if (!windowOpaqueOrigins.has(source)) {
+    windowOpaqueOrigins.set(source, new Origin());
+  }
+  return windowOpaqueOrigins.get(source);
+}
+
+if (typeof globalThis.Origin === 'undefined') {
+  class Origin {
+    constructor() {
+      // new Origin() creates an opaque origin that matches nothing except itself
+      this._opaque = true;
+      this._id = Symbol('opaqueOrigin');
+    }
+
+    get opaque() {
+      return this._opaque === true;
+    }
+
+    static from(candidate) {
+      if (candidate instanceof Origin) {
+        return candidate;
+      }
+      if (typeof candidate === 'string') {
+        if (candidate === 'null') {
+          throw new TypeError("Cannot parse 'null' string as Origin");
+        }
+        let url;
+        try {
+          url = new URL(candidate);
+        } catch {
+          throw new TypeError(`Invalid URL string: ${candidate}`);
+        }
+        if (url.origin === 'null') {
+          return new Origin();
+        }
+        const o = Object.create(Origin.prototype);
+        o._opaque = false;
+        o.scheme = url.protocol;
+        o.host = url.hostname;
+        o.port = url.port || (url.protocol === 'https:' ? '443' : url.protocol === 'http:' ? '80' : '');
+        return o;
+      }
+      if (typeof URL !== 'undefined' && candidate instanceof URL) {
+        return Origin.from(candidate.href);
+      }
+      if (typeof HTMLAnchorElement !== 'undefined' && candidate instanceof HTMLAnchorElement) {
+        return Origin.from(candidate.href);
+      }
+      if (typeof HTMLAreaElement !== 'undefined' && candidate instanceof HTMLAreaElement) {
+        return Origin.from(candidate.href);
+      }
+      if (candidate === globalThis || (typeof Window !== 'undefined' && candidate instanceof Window)) {
+        if (candidate.location && candidate.location.href) {
+          return Origin.from(candidate.location.href);
+        }
+        return new Origin();
+      }
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        if (candidate.origin && candidate.origin !== 'null') {
+          return Origin.from(candidate.origin);
+        }
+        if (candidate.source) {
+          return getOpaqueOriginForSource(candidate.source);
+        }
+        return new Origin();
+      }
+      if (candidate && typeof candidate === 'object') {
+        if (typeof candidate.origin === 'string' && candidate.origin !== 'null') {
+          return Origin.from(candidate.origin);
+        }
+        if (candidate.source) {
+          return getOpaqueOriginForSource(candidate.source);
+        }
+        if (typeof candidate.href === 'string') {
+          return Origin.from(candidate.href);
+        }
+      }
+      throw new TypeError('Unsupported object for Origin.from()');
+    }
+
+    isSameOrigin(other) {
+      if (!(other instanceof Origin)) {
+        throw new TypeError('Argument must be an Origin instance');
+      }
+      if (this._opaque || other._opaque) {
+        return this === other || (this._id && this._id === other._id);
+      }
+      return this.scheme === other.scheme && this.host === other.host && this.port === other.port;
+    }
+
+    isSameSite(other) {
+      if (!(other instanceof Origin)) {
+        throw new TypeError('Argument must be an Origin instance');
+      }
+      if (this._opaque || other._opaque) {
+        return false;
+      }
+      if (this.scheme !== other.scheme) {
+        return false;
+      }
+      return getRegistrableDomain(this.host) === getRegistrableDomain(other.host);
+    }
+  }
+
+  globalThis.Origin = Origin;
+}
+
+const OriginClass = globalThis.Origin;
+
+// Default trusted ordering origins
+let TRUSTED_ORIGIN = OriginClass.from('https://orders.dailygrind.coffee');
+let TRUSTED_ORDERING_ORIGIN = TRUSTED_ORIGIN;
+
+const KNOWN_ORDERING_ORIGINS = [
+  'https://orders.dailygrind.coffee',
+  'https://order.dailygrind.coffee',
+  'https://orders.dailygrind.com',
+  'https://order.dailygrind.com',
+  'https://ordering.dailygrind.coffee',
+  'https://app.example.com'
+].map(url => {
+  try { return OriginClass.from(url); } catch { return null; }
+}).filter(Boolean);
+
+// Primary application origin
+let APP_ORIGIN;
+try {
+  let contextOrigin;
+  if (typeof self !== 'undefined') {
+    try {
+      contextOrigin = OriginClass.from(self);
+    } catch {}
+  }
+  if (contextOrigin && !contextOrigin.opaque &&
+      typeof location !== 'undefined' &&
+      !location.hostname.includes('localhost') &&
+      !location.hostname.includes('127.0.0.1')) {
+    APP_ORIGIN = contextOrigin;
+  } else {
+    APP_ORIGIN = OriginClass.from('https://dailygrind.coffee');
+  }
+} catch {
+  APP_ORIGIN = OriginClass.from('https://dailygrind.coffee');
+}
+
+const KNOWN_APP_ORIGINS = [
+  'https://dailygrind.coffee',
+  'https://dailygrind.com',
+  'https://app.example.co.uk'
+].map(url => {
+  try { return OriginClass.from(url); } catch { return null; }
+}).filter(Boolean);
+
+function setTrustedOrderingOrigin(origin) {
+  const o = typeof origin === 'string' ? OriginClass.from(origin) : origin;
+  TRUSTED_ORDERING_ORIGIN = o;
+  TRUSTED_ORIGIN = o;
+  if (typeof window !== 'undefined') {
+    window.TRUSTED_ORDERING_ORIGIN = o;
+    window.TRUSTED_ORIGIN = o;
+  }
+}
+
+function setAppOrigin(origin) {
+  const o = typeof origin === 'string' ? OriginClass.from(origin) : origin;
+  APP_ORIGIN = o;
+  if (typeof window !== 'undefined') {
+    window.APP_ORIGIN = o;
+  }
+}
+
+function extractOrigin(candidate) {
+  try {
+    return OriginClass.from(candidate);
+  } catch (err) {
+    // Synthetic new MessageEvent('message', { origin }) objects in tests lack an
+    // internal browser origin; fall back to parsing candidate.origin if it is a URL.
+    if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+      if (candidate.origin && candidate.origin !== 'null') {
+        return OriginClass.from(candidate.origin);
+      }
+      if (candidate.source) {
+        return getOpaqueOriginForSource(candidate.source);
+      }
+    }
+    if (candidate && typeof candidate === 'object') {
+      if (typeof candidate.origin === 'string' && candidate.origin !== 'null') {
+        return OriginClass.from(candidate.origin);
+      }
+      if (candidate.source) {
+        return getOpaqueOriginForSource(candidate.source);
+      }
+    }
+    if (typeof candidate === 'string') {
+      if (candidate.startsWith('/') || candidate.startsWith('./') || candidate.startsWith('../')) {
+        const base = (typeof location !== 'undefined' && location.href) ? location.href : 'https://dailygrind.coffee';
+        return OriginClass.from(new URL(candidate, base));
+      }
+    }
+    throw err;
+  }
+}
+
+function isTrustedSameOrigin(candidate, trusted = null) {
+  try {
+    const candidateOrigin = extractOrigin(candidate);
+    const configuredTarget = trusted || (typeof window !== 'undefined' && (window.TRUSTED_ORDERING_ORIGIN || window.TRUSTED_ORIGIN)) || TRUSTED_ORDERING_ORIGIN;
+
+    if (trusted) {
+      const trustedOrigin = typeof trusted === 'string' ? OriginClass.from(trusted) : extractOrigin(trusted);
+      return candidateOrigin.isSameOrigin(trustedOrigin);
+    }
+
+    if (configuredTarget && candidateOrigin.isSameOrigin(configuredTarget)) {
+      return true;
+    }
+
+    return KNOWN_ORDERING_ORIGINS.some(known => candidateOrigin.isSameOrigin(known));
+  } catch {
+    // Rejects invalid URLs, "null" strings, or unsupported objects
+    return false;
+  }
+}
+
+function isAllowedSameSiteUrl(candidateUrlOrElement, targetAppOrigin = null) {
+  try {
+    const candidateOrigin = extractOrigin(candidateUrlOrElement);
+    const primary = targetAppOrigin || (typeof window !== 'undefined' && window.APP_ORIGIN) || APP_ORIGIN;
+
+    if (targetAppOrigin) {
+      const target = typeof targetAppOrigin === 'string' ? OriginClass.from(targetAppOrigin) : extractOrigin(targetAppOrigin);
+      return candidateOrigin.isSameSite(target);
+    }
+
+    if (primary && candidateOrigin.isSameSite(primary)) {
+      return true;
+    }
+
+    return KNOWN_APP_ORIGINS.some(known => candidateOrigin.isSameSite(known));
+  } catch {
+    return false;
+  }
+}
+
+const isSameSiteUrl = isAllowedSameSiteUrl;
+
+function isExternalLink(candidateUrlOrElement, targetAppOrigin = null) {
+  try {
+    const origin = extractOrigin(candidateUrlOrElement);
+    if (origin.opaque) return true;
+    return !isAllowedSameSiteUrl(candidateUrlOrElement, targetAppOrigin);
+  } catch {
+    return false;
+  }
+}
+
+function validateRedirectUrl(candidateUrlOrElement, fallback = '/') {
+  if (isAllowedSameSiteUrl(candidateUrlOrElement)) {
+    return typeof candidateUrlOrElement === 'string' ? candidateUrlOrElement : candidateUrlOrElement.href;
+  }
+  return fallback;
+}
+
+// Sandboxed iframe widget identity pinning
+// Initialize with a unique opaque sentinel that matches no other origin
+let pinnedSandboxOrigin = new OriginClass();
+let isSandboxPinned = false;
+
+function resetSandboxPin() {
+  pinnedSandboxOrigin = new OriginClass();
+  isSandboxPinned = false;
+  if (typeof window !== 'undefined') {
+    window.pinnedSandboxOrigin = pinnedSandboxOrigin;
+    window.isSandboxPinned = isSandboxPinned;
+  }
+}
+
+function handleSandboxedWidgetMessage(event, expectedWidgetWindow) {
+  try {
+    let senderOrigin;
+    try {
+      senderOrigin = OriginClass.from(event);
+    } catch {
+      senderOrigin = extractOrigin(event);
+    }
+
+    const isInit = event.data?.type === 'init' || event.data === 'init' || event.data?.action === 'init';
+    const matchesSource = !expectedWidgetWindow || event.source === expectedWidgetWindow;
+
+    // Pin the opaque origin only once on initialization from the expected sandboxed iframe
+    if (!isSandboxPinned && matchesSource && isInit) {
+      pinnedSandboxOrigin = senderOrigin;
+      isSandboxPinned = true;
+      if (typeof window !== 'undefined') {
+        window.pinnedSandboxOrigin = pinnedSandboxOrigin;
+        window.isSandboxPinned = isSandboxPinned;
+      }
+    }
+
+    // Subsequent messages from the SAME sandboxed iframe match pinnedSandboxOrigin;
+    // messages from any other sandboxed iframe (also event.origin === "null") return false.
+    return senderOrigin.isSameOrigin(pinnedSandboxOrigin);
+  } catch {
+    return false;
+  }
+}
+
+// Expose on globalThis / window
+if (typeof globalThis !== 'undefined') {
+  globalThis.Origin = OriginClass;
+  globalThis.extractOrigin = extractOrigin;
+  globalThis.isTrustedSameOrigin = isTrustedSameOrigin;
+  globalThis.isAllowedSameSiteUrl = isAllowedSameSiteUrl;
+  globalThis.isSameSiteUrl = isSameSiteUrl;
+  globalThis.isExternalLink = isExternalLink;
+  globalThis.validateRedirectUrl = validateRedirectUrl;
+  globalThis.handleSandboxedWidgetMessage = handleSandboxedWidgetMessage;
+  globalThis.resetSandboxPin = resetSandboxPin;
+  globalThis.setTrustedOrderingOrigin = setTrustedOrderingOrigin;
+  globalThis.setAppOrigin = setAppOrigin;
+  globalThis.TRUSTED_ORIGIN = TRUSTED_ORIGIN;
+  globalThis.TRUSTED_ORDERING_ORIGIN = TRUSTED_ORDERING_ORIGIN;
+  globalThis.APP_ORIGIN = APP_ORIGIN;
+  globalThis.pinnedSandboxOrigin = pinnedSandboxOrigin;
+  globalThis.isSandboxPinned = isSandboxPinned;
+}
+
+// Export for CommonJS and Node ESM loader compatibility
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = {
+    Origin: OriginClass,
+    extractOrigin,
+    isTrustedSameOrigin,
+    isAllowedSameSiteUrl,
+    isSameSiteUrl,
+    isExternalLink,
+    validateRedirectUrl,
+    handleSandboxedWidgetMessage,
+    resetSandboxPin,
+    setTrustedOrderingOrigin,
+    setAppOrigin,
+    TRUSTED_ORIGIN,
+    TRUSTED_ORDERING_ORIGIN,
+    APP_ORIGIN,
+    get pinnedSandboxOrigin() { return pinnedSandboxOrigin; },
+    get isSandboxPinned() { return isSandboxPinned; }
+  };
+}
