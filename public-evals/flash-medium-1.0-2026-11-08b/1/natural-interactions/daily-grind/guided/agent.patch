+  <script type="module">
+    // Conditional Polyfill check for older browsers lacking native Popover API
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Horizontal scroller arrow navigation
+    const scroller = document.querySelector('.scroller');
+    const scrollPrev = document.getElementById('scroll-prev');
+    const scrollNext = document.getElementById('scroll-next');
+
+    if (scroller && scrollPrev && scrollNext) {
+      scrollPrev.addEventListener('click', () => {
+        scroller.scrollBy({ left: -300, behavior: 'smooth' });
+      });
+
+      scrollNext.addEventListener('click', () => {
+        scroller.scrollBy({ left: 300, behavior: 'smooth' });
+      });
+
+      // Keyboard arrow scrolling support when scroller region is focused
+      scroller.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowLeft') {
+          e.preventDefault();
+          scroller.scrollBy({ left: -260, behavior: 'smooth' });
+        } else if (e.key === 'ArrowRight') {
+          e.preventDefault();
+          scroller.scrollBy({ left: 260, behavior: 'smooth' });
+        }
+      });
+    }
+
+    // Smooth expansion of detail views right out of the trigger button
+    const detailButtons = document.querySelectorAll('.view-details-btn');
+    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    detailButtons.forEach(btn => {
+      btn.addEventListener('click', (e) => {
+        const targetId = btn.getAttribute('popovertarget');
+        const popover = document.getElementById(targetId);
+        if (!popover) return;
+
+        // Remember which button triggered this popover for accessible focus return
+        popover._triggerButton = btn;
+        btn.setAttribute('aria-expanded', 'true');
+
+        const btnRect = btn.getBoundingClientRect();
+
+        // If not already shown, open it
+        if (!popover.matches(':popover-open')) {
+          try { popover.showPopover(); } catch {}
+        }
+
+        // Compute relative origin coordinates so CSS transform-origin anchors to the button
+        const popRect = popover.getBoundingClientRect();
+        const originX = (btnRect.left + btnRect.width / 2) - popRect.left;
+        const originY = (btnRect.top + btnRect.height / 2) - popRect.top;
+
+        popover.style.setProperty('--btn-x', `${originX}px`);
+        popover.style.setProperty('--btn-y', `${originY}px`);
+        popover.style.transformOrigin = `${originX}px ${originY}px`;
+
+        // Smoothly expand right out of the button's exact position & dimensions
+        if (!prefersReducedMotion.matches && typeof popover.animate === 'function') {
+          const deltaX = (btnRect.left + btnRect.width / 2) - (popRect.left + popRect.width / 2);
+          const deltaY = (btnRect.top + btnRect.height / 2) - (popRect.top + popRect.height / 2);
+          const scaleX = Math.max(0.12, btnRect.width / popRect.width);
+          const scaleY = Math.max(0.12, btnRect.height / popRect.height);
+
+          popover.animate([
+            {
+              transform: `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})`,
+              opacity: 0.1,
+              borderRadius: '6px'
+            },
+            {
+              transform: 'translate(0, 0) scale(1)',
+              opacity: 1,
+              borderRadius: '16px'
+            }
+          ], {
+            duration: 300,
+            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
+            fill: 'both'
+          });
+        }
+      });
+    });
+
+    // Handle closing and focus management for detail popovers
+    document.querySelectorAll('.detail-popover').forEach(popover => {
+      popover.addEventListener('toggle', (e) => {
+        if (e.newState === 'closed') {
+          const trigger = popover._triggerButton || document.querySelector(`[popovertarget="${popover.id}"]`);
+          if (trigger) {
+            trigger.setAttribute('aria-expanded', 'false');
+            // Return focus to the trigger button for seamless keyboard navigation
+            trigger.focus();
+          }
+        }
+      });
+
+      // Intercept close button to smoothly shrink back into trigger button
+      const closeBtn = popover.querySelector('.close-btn');
+      if (closeBtn) {
+        closeBtn.addEventListener('click', (e) => {
+          const trigger = popover._triggerButton || document.querySelector(`[popovertarget="${popover.id}"]`);
+          if (trigger && !prefersReducedMotion.matches && typeof popover.animate === 'function') {
+            e.preventDefault();
+            const btnRect = trigger.getBoundingClientRect();
+            const popRect = popover.getBoundingClientRect();
+            const deltaX = (btnRect.left + btnRect.width / 2) - (popRect.left + popRect.width / 2);
+            const deltaY = (btnRect.top + btnRect.height / 2) - (popRect.top + popRect.height / 2);
+            const scaleX = Math.max(0.12, btnRect.width / popRect.width);
+            const scaleY = Math.max(0.12, btnRect.height / popRect.height);
+
+            const anim = popover.animate([
+              {
+                transform: 'translate(0, 0) scale(1)',
+                opacity: 1,
+                borderRadius: '16px'
+              },
+              {
+                transform: `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})`,
+                opacity: 0,
+                borderRadius: '6px'
+              }
+            ], {
+              duration: 220,
+              easing: 'ease-in',
+              fill: 'forwards'
+            });
+
+            anim.onfinish = () => {
