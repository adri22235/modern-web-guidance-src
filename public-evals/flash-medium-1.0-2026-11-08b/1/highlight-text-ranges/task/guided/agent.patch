+  <script>
+    (function () {
+      const searchInput = document.getElementById('search-input');
+      const cards = document.querySelectorAll('.grid .card');
+
+      function escapeRegExp(string) {
+        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      }
+
+      function clearHighlights(card) {
+        const marks = card.querySelectorAll('mark.highlight, mark, .highlight');
+        marks.forEach(mark => {
+          const parent = mark.parentNode;
+          if (parent) {
+            while (mark.firstChild) {
+              parent.insertBefore(mark.firstChild, mark);
+            }
+            parent.removeChild(mark);
+          }
+        });
+        card.normalize();
+      }
+
+      function highlightCard(card, query) {
+        const escaped = escapeRegExp(query);
+        const splitRegex = new RegExp(`(${escaped})`, 'gi');
+        const testRegex = new RegExp(`^${escaped}$`, 'i');
+        const containsRegex = new RegExp(escaped, 'i');
+
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT, null, false);
+        const textNodes = [];
+        let currentNode;
+        while ((currentNode = walker.nextNode())) {
+          textNodes.push(currentNode);
+        }
+
+        textNodes.forEach(node => {
+          const text = node.textContent;
+          if (!text || !containsRegex.test(text)) {
+            return;
+          }
+
+          const parts = text.split(splitRegex);
+          if (parts.length <= 1) return;
+
+          const fragment = document.createDocumentFragment();
+          let hasMatch = false;
+
+          parts.forEach(part => {
+            if (!part) return;
+            if (testRegex.test(part)) {
+              const mark = document.createElement('mark');
+              mark.className = 'highlight';
+              mark.style.backgroundColor = 'gold';
+              mark.textContent = part;
+              fragment.appendChild(mark);
+              hasMatch = true;
+            } else {
+              fragment.appendChild(document.createTextNode(part));
+            }
+          });
+
+          if (hasMatch && node.parentNode) {
+            node.parentNode.replaceChild(fragment, node);
+          }
+        });
+      }
+
+      function handleSearch() {
+        cards.forEach(clearHighlights);
+
+        const query = searchInput.value.trim();
+        if (!query) {
+          return;
+        }
+
+        cards.forEach(card => highlightCard(card, query));
+      }
+
+      if (searchInput) {
+        searchInput.addEventListener('input', handleSearch);
+        searchInput.addEventListener('keyup', handleSearch);
+        if (searchInput.value) {
+          handleSearch();
+        }
+      }
+    })();
+  </script>
+
