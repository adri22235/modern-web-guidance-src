@@ -0,0 +1,300 @@
+/**
+ * FavoriteToggle Custom Element
+ * A reusable toggle switch component for marking items as favorites.
+ */
+class FavoriteToggle extends HTMLElement {
+  static get observedAttributes() {
+    return ['favorited', 'active', 'checked', 'drink-name'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this._favorited = false;
+    this._drinkName = '';
+  }
+
+  connectedCallback() {
+    // Determine drink name from attribute or closest card heading
+    if (!this._drinkName) {
+      this._drinkName = this.getAttribute('drink-name') ||
+                        this.getAttribute('drink') ||
+                        this.closest('.card')?.querySelector('h3')?.textContent?.trim() ||
+                        '';
+    }
+
+    // Determine initial favorite state
+    if (this.hasAttribute('favorited') || this.hasAttribute('active') || this.hasAttribute('checked')) {
+      const val = this.getAttribute('favorited') ?? this.getAttribute('active') ?? this.getAttribute('checked');
+      this._favorited = val !== 'false';
+    } else if (this._drinkName) {
+      try {
+        const stored = localStorage.getItem(`daily_grind_fav_${this._drinkName}`);
+        if (stored !== null) {
+          this._favorited = stored === 'true';
+        }
+      } catch (e) {
+        // Ignore localStorage restrictions
+      }
+    }
+
+    this.render();
+    this.setupListeners();
+    this.syncAttributes();
+  }
+
+  get favorited() {
+    return this._favorited;
+  }
+
+  set favorited(val) {
+    const nextVal = Boolean(val);
+    if (this._favorited !== nextVal) {
+      this._favorited = nextVal;
+      this.updateState(true);
+    }
+  }
+
+  // Convenience aliases for switch / toggle conventions
+  get checked() {
+    return this._favorited;
+  }
+
+  set checked(val) {
+    this.favorited = val;
+  }
+
+  get active() {
+    return this._favorited;
+  }
+
+  set active(val) {
+    this.favorited = val;
+  }
+
+  get drinkName() {
+    return this._drinkName;
+  }
+
+  set drinkName(val) {
+    this._drinkName = val || '';
+    this.setAttribute('drink-name', this._drinkName);
+    this.updateAccessibility();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+
+    if (name === 'favorited' || name === 'active' || name === 'checked') {
+      const isFav = newValue !== null && newValue !== 'false';
+      if (this._favorited !== isFav) {
+        this._favorited = isFav;
+        this.updateState(false);
+      }
+    } else if (name === 'drink-name') {
+      this._drinkName = newValue || '';
+      this.updateAccessibility();
+    }
+  }
+
+  toggle() {
+    this._favorited = !this._favorited;
+    this.updateState(true);
+  }
+
+  updateState(dispatchEvents = true) {
+    this.syncAttributes();
+    this.persist();
+    this.updateUI();
+
+    if (dispatchEvents) {
+      const detail = { favorited: this._favorited, drinkName: this._drinkName };
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail
+      }));
+      this.dispatchEvent(new CustomEvent('change', {
+        bubbles: true,
+        composed: true,
+        detail
+      }));
+    }
+  }
+
+  syncAttributes() {
+    if (this._favorited) {
+      if (!this.hasAttribute('favorited')) {
+        this.setAttribute('favorited', '');
+      }
+      this.setAttribute('aria-pressed', 'true');
+    } else {
+      if (this.hasAttribute('favorited')) {
+        this.removeAttribute('favorited');
+      }
+      this.setAttribute('aria-pressed', 'false');
+    }
+  }
+
+  persist() {
+    if (this._drinkName) {
+      try {
+        localStorage.setItem(`daily_grind_fav_${this._drinkName}`, String(this._favorited));
+      } catch (e) {
+        // Storage might be unavailable
+      }
+    }
+  }
+
+  updateAccessibility() {
+    if (!this.shadowRoot) return;
+    const btn = this.shadowRoot.querySelector('button');
+    if (btn) {
+      const drinkTitle = this._drinkName || 'this drink';
+      const label = this._favorited
+        ? `Remove ${drinkTitle} from favorites`
+        : `Mark ${drinkTitle} as favorite`;
+      btn.setAttribute('aria-label', label);
+      btn.setAttribute('aria-pressed', String(this._favorited));
+      btn.setAttribute('aria-checked', String(this._favorited));
+    }
+  }
+
+  updateUI() {
+    if (!this.shadowRoot) return;
+    const btn = this.shadowRoot.querySelector('.fav-toggle-btn');
+    const label = this.shadowRoot.querySelector('.fav-label');
+    const icon = this.shadowRoot.querySelector('.heart-icon');
+
+    if (!btn || !label || !icon) return;
+
+    if (this._favorited) {
+      btn.classList.add('is-favorite');
+      label.textContent = 'Favorited';
+      icon.innerHTML = `<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>`;
+    } else {
+      btn.classList.remove('is-favorite');
+      label.textContent = 'Favorite';
+      icon.innerHTML = `<path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/>`;
+    }
+
+    this.updateAccessibility();
+  }
+
+  setupListeners() {
+    const btn = this.shadowRoot.querySelector('button');
+    if (btn) {
+      btn.addEventListener('click', (e) => {
+        e.stopPropagation();
+        this.toggle();
+      });
+    }
+
+    // Allow calling .click() on the host element as well
+    this.addEventListener('click', (e) => {
+      if (e.target === this) {
+        this.toggle();
+      }
+    });
+
+    // Support keyboard activation on the host element if focused
+    this.addEventListener('keydown', (e) => {
+      if ((e.key === 'Enter' || e.key === ' ') && e.target === this) {
+        e.preventDefault();
+        this.toggle();
+      }
+    });
+  }
+
+  render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: inline-block;
+          margin: 12px 0 6px 0;
+        }
+
+        .fav-toggle-btn {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 6px;
+          background-color: transparent;
+          color: var(--primary, #4e342e);
+          border: 1.5px solid var(--primary, #4e342e);
+          border-radius: 20px;
+          padding: 6px 14px;
+          font-family: inherit;
+          font-size: 0.875rem;
+          font-weight: 600;
+          cursor: pointer;
+          transition: all 0.2s ease-in-out;
+          outline: none;
+          user-select: none;
+          line-height: 1.2;
+        }
+
+        .fav-toggle-btn:hover {
+          background-color: rgba(78, 52, 46, 0.08);
+          border-color: #3e2723;
+          transform: translateY(-1px);
+        }
+
+        .fav-toggle-btn:focus-visible {
+          box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.5);
+        }
+
+        .fav-toggle-btn.is-favorite {
+          background-color: #d32f2f;
+          border-color: #d32f2f;
+          color: #ffffff;
+        }
+
+        .fav-toggle-btn.is-favorite:hover {
+          background-color: #b71c1c;
+          border-color: #b71c1c;
+        }
+
+        .heart-icon {
+          width: 16px;
+          height: 16px;
+          fill: currentColor;
+          display: inline-block;
+          vertical-align: middle;
+          transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
+        }
+
+        .fav-toggle-btn.is-favorite .heart-icon {
+          transform: scale(1.15);
+        }
+
+        .fav-label {
+          display: inline-block;
+        }
+      </style>
+      <button type="button" class="fav-toggle-btn" role="switch" aria-checked="false" aria-pressed="false">
+        <svg class="heart-icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/>
+        </svg>
+        <span class="fav-label">Favorite</span>
+      </button>
+    `;
+
+    this.updateUI();
+  }
+}
+
+// Register custom element
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
+
+// Also register favorite-button alias for maximum compatibility
+if (!customElements.get('favorite-button')) {
+  customElements.define('favorite-button', class extends FavoriteToggle {});
+}
+
+// Export for module environments if needed
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { FavoriteToggle };
+}
