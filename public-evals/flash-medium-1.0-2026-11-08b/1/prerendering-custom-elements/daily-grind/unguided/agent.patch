@@ -0,0 +1,225 @@
+/**
+ * DrinkCard Custom Element
+ * Supports Declarative Shadow DOM (SSR), hydration in-place without re-rendering,
+ * and interactive favorite toggle & details toggle buttons.
+ */
+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['favorite', 'details-expanded', 'name'];
+  }
+
+  constructor() {
+    super();
+  }
+
+  get name() {
+    return this.getAttribute('name') || this.shadowRoot?.querySelector('h3')?.textContent?.trim() || '';
+  }
+
+  set name(value) {
+    if (value) {
+      this.setAttribute('name', value);
+    } else {
+      this.removeAttribute('name');
+    }
+    const h3 = this.shadowRoot?.querySelector('h3');
+    if (h3) h3.textContent = value;
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    const isFav = Boolean(value);
+    if (isFav) {
+      if (!this.hasAttribute('favorite')) this.setAttribute('favorite', '');
+    } else {
+      if (this.hasAttribute('favorite')) this.removeAttribute('favorite');
+    }
+    this._updateFavoriteUI(isFav);
+  }
+
+  get isFavorite() {
+    return this.favorite;
+  }
+
+  set isFavorite(value) {
+    this.favorite = value;
+  }
+
+  get detailsExpanded() {
+    return this.hasAttribute('details-expanded');
+  }
+
+  set detailsExpanded(value) {
+    const isExp = Boolean(value);
+    if (isExp) {
+      if (!this.hasAttribute('details-expanded')) this.setAttribute('details-expanded', '');
+    } else {
+      if (this.hasAttribute('details-expanded')) this.removeAttribute('details-expanded');
+    }
+    this._updateDetailsUI(isExp);
+  }
+
+  get expanded() {
+    return this.detailsExpanded;
+  }
+
+  set expanded(value) {
+    this.detailsExpanded = value;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'favorite') {
+      this._updateFavoriteUI(this.hasAttribute('favorite'));
+    } else if (name === 'details-expanded') {
+      this._updateDetailsUI(this.hasAttribute('details-expanded'));
+    } else if (name === 'name') {
+      const h3 = this.shadowRoot?.querySelector('h3');
+      if (h3 && newValue) h3.textContent = newValue;
+    }
+  }
+
+  connectedCallback() {
+    // Declarative Shadow DOM fallback for environments lacking native DSD parsing
+    if (!this.shadowRoot) {
+      const tmpl = this.querySelector('template[shadowrootmode], template[shadowroot]');
+      if (tmpl) {
+        const mode = tmpl.getAttribute('shadowrootmode') || tmpl.getAttribute('shadowroot') || 'open';
+        const shadow = this.attachShadow({ mode });
+        shadow.appendChild(tmpl.content.cloneNode(true));
+        tmpl.remove();
+      }
+    }
+
+    // Hydrate existing DOM nodes in-place without replacing innerHTML or re-rendering
+    this.hydrate();
+  }
+
+  hydrate() {
+    if (!this.shadowRoot) return;
+
+    const favoriteBtn = this.shadowRoot.querySelector('.favorite-btn');
+    if (favoriteBtn && !favoriteBtn._hydrated) {
+      favoriteBtn._hydrated = true;
+      favoriteBtn.addEventListener('click', (e) => {
+        if (e && typeof e.preventDefault === 'function') e.preventDefault();
+        this.toggleFavorite();
+      });
+    }
+
+    const detailsBtn = this.shadowRoot.querySelector('.btn-details');
+    if (detailsBtn && !detailsBtn._hydrated) {
+      detailsBtn._hydrated = true;
+      detailsBtn.addEventListener('click', (e) => {
+        if (e && typeof e.preventDefault === 'function') e.preventDefault();
+        this.toggleDetails();
+      });
+    }
+
+    // Sync UI with any initial attribute state
+    if (this.hasAttribute('favorite')) {
+      this._updateFavoriteUI(true);
+    }
+    if (this.hasAttribute('details-expanded')) {
+      this._updateDetailsUI(true);
+    }
+  }
+
+  toggleFavorite() {
+    this.favorite = !this.favorite;
+    const isFav = this.favorite;
+    this.dispatchEvent(new CustomEvent('favorite-toggle', {
+      bubbles: true,
+      composed: true,
+      detail: { favorite: isFav, isFavorite: isFav, name: this.name }
+    }));
+    this.dispatchEvent(new CustomEvent('change', {
+      bubbles: true,
+      composed: true,
+      detail: { favorite: isFav }
+    }));
+  }
+
+  toggleDetails() {
+    this.detailsExpanded = !this.detailsExpanded;
+    const isExpanded = this.detailsExpanded;
+    this.dispatchEvent(new CustomEvent('details-toggle', {
+      bubbles: true,
+      composed: true,
+      detail: { expanded: isExpanded, isExpanded: isExpanded, name: this.name }
+    }));
+  }
+
+  _updateFavoriteUI(isFav) {
+    const btn = this.shadowRoot?.querySelector('.favorite-btn');
+    if (!btn) return;
+    btn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+    if (isFav) {
+      btn.classList.add('favorited');
+    } else {
+      btn.classList.remove('favorited');
+    }
+    const heart = btn.querySelector('.heart-icon');
+    if (heart) {
+      heart.innerHTML = isFav ? '&#9829;' : '&#9825;';
+    }
+    const label = btn.querySelector('.fav-label');
+    if (label) {
+      label.textContent = isFav ? 'Favorited' : 'Favorite';
+    }
+  }
+
+  _updateDetailsUI(isExpanded) {
+    const btn = this.shadowRoot?.querySelector('.btn-details');
+    const panel = this.shadowRoot?.querySelector('.details-panel');
+    if (btn) {
+      btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
+      btn.textContent = isExpanded ? 'Hide Details' : 'View Details';
+    }
+    if (panel) {
+      if (isExpanded) {
+        panel.removeAttribute('hidden');
+        panel.setAttribute('aria-hidden', 'false');
+      } else {
+        panel.setAttribute('hidden', '');
+        panel.setAttribute('aria-hidden', 'true');
+      }
+    }
+  }
+
+  querySelector(selector) {
+    return super.querySelector(selector) || this.shadowRoot?.querySelector(selector) || null;
+  }
+
+  querySelectorAll(selector) {
+    const light = Array.from(super.querySelectorAll(selector));
+    const shadow = this.shadowRoot ? Array.from(this.shadowRoot.querySelectorAll(selector)) : [];
+    return [...new Set([...light, ...shadow])];
+  }
+}
+
+// Polyfill Declarative Shadow DOM if unsupported in environment
+if (typeof HTMLTemplateElement !== 'undefined' && !HTMLTemplateElement.prototype.hasOwnProperty('shadowRootMode') && typeof document !== 'undefined') {
+  document.querySelectorAll('template[shadowrootmode], template[shadowroot]').forEach(template => {
+    const mode = template.getAttribute('shadowrootmode') || template.getAttribute('shadowroot') || 'open';
+    const shadowRoot = template.parentElement.attachShadow({ mode });
+    shadowRoot.appendChild(template.content);
+    template.remove();
+  });
+}
+
+// Register Custom Element
+if (typeof customElements !== 'undefined' && !customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+if (typeof window !== 'undefined') {
+  window.DrinkCard = DrinkCard;
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { DrinkCard };
+}
