@@ -0,0 +1,138 @@
+class DrinkCard extends HTMLElement {
+  #internals;
+
+  constructor() {
+    super();
+
+    if (typeof this.attachInternals === 'function') {
+      try {
+        this.#internals = this.attachInternals();
+      } catch (e) {
+        // Ignore if attachInternals is unsupported or already called
+      }
+    }
+
+    // Reuse the server-rendered Declarative Shadow DOM root if present; only create one if absent.
+    if (!this.shadowRoot) {
+      // Fallback for browsers that don't natively parse shadowrootmode
+      const dsdTemplate = this.querySelector('template[shadowrootmode]') || this.querySelector('template[shadowroot]');
+      if (dsdTemplate) {
+        const mode = dsdTemplate.getAttribute('shadowrootmode') || dsdTemplate.getAttribute('shadowroot') || 'open';
+        const shadowRoot = this.attachShadow({ mode });
+        shadowRoot.appendChild(dsdTemplate.content);
+        dsdTemplate.remove();
+      } else {
+        this.attachShadow({ mode: 'open' });
+      }
+    }
+
+    // Hydrate in place: attach listeners once against existing markup (not unguarded
+    // in connectedCallback, which re-runs if the element moves in the DOM), and do
+    // NOT re-render; that would discard the server's DOM and flash.
+    this.#hydrate();
+  }
+
+  #hydrate() {
+    const favBtn = this.shadowRoot?.getElementById('favorite-btn');
+    if (favBtn && !favBtn.dataset.hydrated) {
+      favBtn.dataset.hydrated = 'true';
+      favBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        this.toggleFavorite();
+      });
+    }
+
+    const detailsBtn = this.shadowRoot?.getElementById('toggle-details-btn');
+    if (detailsBtn && !detailsBtn.dataset.hydrated) {
+      detailsBtn.dataset.hydrated = 'true';
+      detailsBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        this.toggleDetails();
+      });
+    }
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+
+  set favorited(val) {
+    this.toggleAttribute('favorited', Boolean(val));
+  }
+
+  get detailsOpen() {
+    return this.hasAttribute('details-open');
+  }
+
+  set detailsOpen(val) {
+    this.toggleAttribute('details-open', Boolean(val));
+  }
+
+  static get observedAttributes() {
+    return ['favorited', 'details-open'];
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+
+    if (name === 'favorited') {
+      const isFav = newVal !== null;
+      const favBtn = this.shadowRoot?.getElementById('favorite-btn');
+      if (favBtn) {
+        favBtn.setAttribute('aria-pressed', String(isFav));
+        const title = this.querySelector('[slot="title"]')?.textContent?.trim() || 'drink';
+        favBtn.setAttribute('aria-label', isFav ? `Unfavorite ${title}` : `Favorite ${title}`);
+      }
+      if (this.#internals?.states) {
+        if (isFav) this.#internals.states.add('favorited');
+        else this.#internals.states.delete('favorited');
+      }
+    } else if (name === 'details-open') {
+      const isOpen = newVal !== null;
+      const detailsBtn = this.shadowRoot?.getElementById('toggle-details-btn');
+      const detailsSection = this.shadowRoot?.getElementById('details-section');
+      if (detailsBtn) {
+        detailsBtn.setAttribute('aria-expanded', String(isOpen));
+        detailsBtn.textContent = isOpen ? 'Hide Details' : 'View Details';
+      }
+      if (detailsSection) {
+        detailsSection.hidden = !isOpen;
+      }
+      if (this.#internals?.states) {
+        if (isOpen) this.#internals.states.add('expanded');
+        else this.#internals.states.delete('expanded');
+      }
+    }
+  }
+
+  toggleFavorite() {
+    this.favorited = !this.favorited;
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      detail: { favorited: this.favorited },
+      bubbles: true,
+      composed: true
+    }));
+  }
+
+  toggleDetails() {
+    this.detailsOpen = !this.detailsOpen;
+    this.dispatchEvent(new CustomEvent('details-toggle', {
+      detail: { open: this.detailsOpen },
+      bubbles: true,
+      composed: true
+    }));
+  }
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('drink-card')) {
+    customElements.define('drink-card', DrinkCard);
+  }
+  if (!customElements.get('seasonal-drink-card')) {
+    customElements.define('seasonal-drink-card', DrinkCard);
+  }
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { DrinkCard };
+}
