+  <script>
+    // Theme selector control logic
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+
+      function applyTheme(theme) {
+        if (theme === 'light' || theme === 'dark') {
+          try {
+            localStorage.setItem('color-scheme', theme);
+          } catch (e) {}
+          if (metaColorScheme) metaColorScheme.content = theme;
+          document.documentElement.style.colorScheme = theme;
+          if (themeSelect) themeSelect.value = theme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch (e) {}
+          if (metaColorScheme) metaColorScheme.content = 'light dark';
+          document.documentElement.style.colorScheme = 'light dark';
+          if (themeSelect) themeSelect.value = 'light dark';
+        }
+      }
+
+      // Initialize dropdown to reflect current state
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          applyTheme(stored);
+        } else {
+          applyTheme('light dark');
+        }
+      } catch (e) {
+        applyTheme('light dark');
+      }
+
+      if (themeSelect) {
+        themeSelect.addEventListener('change', function () {
+          applyTheme(this.value);
+        });
+      }
+
+      // Cross-tab synchronization
+      window.addEventListener('storage', function (e) {
+        if (e.key === 'color-scheme') {
+          const newVal = e.newValue;
+          if (newVal === 'light' || newVal === 'dark') {
+            applyTheme(newVal);
+          } else {
+            applyTheme('light dark');
+          }
+        }
+      });
+    })();
+  </script>
