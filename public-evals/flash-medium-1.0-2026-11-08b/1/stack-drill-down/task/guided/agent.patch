diff --git a/build.js b/build.js
new file mode 100644
--- a/build.js
+++ b/build.js
@@ -0,0 +1,19 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+const routes = [
+  'menu/seasonal',
+  'menu/espresso',
+  'menu/cold-brew',
+  'menu/maple-oat-latte',
+  'menu/dark-roast-espresso'
+];
+
+const source = fs.readFileSync('index.html', 'utf8');
+
+for (const r of routes) {
+  fs.mkdirSync(r, { recursive: true });
+  fs.writeFileSync(path.join(r, 'index.html'), source);
+}
+
+console.log('Build completed: generated deep link entry points for ' + routes.join(', '));
