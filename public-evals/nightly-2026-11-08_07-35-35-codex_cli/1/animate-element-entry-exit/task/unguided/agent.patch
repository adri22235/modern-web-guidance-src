   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let promoCount = 0;
+    let removing = false;
+    let toggling = false;
+
+    async function animateCard(card, entering) {
+      if (reducedMotion.matches || !card.animate) return;
+      const frames = [
+        { opacity: 0, transform: 'scale(0.92)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const animation = card.animate(entering ? frames : frames.slice().reverse(), {
+        duration: 280,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+      try {
+        await animation.finished;
+      } finally {
+        animation.cancel();
+      }
+    }
+
+    function updateControls() {
+      removeBtn.disabled = removing || toggling || !domContainer.lastElementChild;
+      toggleBtn.disabled = toggling || !toggleCard.isConnected ||
+        (removing && domContainer.lastElementChild === toggleCard);
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special #${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Make your next visit a little sweeter. Explore our freshly roasted coffee and bakery favorites.';
+      const link = document.createElement('a');
+      link.className = 'btn';
+      link.href = '/menu';
+      link.textContent = 'Find Your Favorite';
+      card.append(heading, description, link);
+      domContainer.append(card);
+      animateCard(card, true);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.lastElementChild;
+      if (!card || removing || toggling) return;
+      removing = true;
+      updateControls();
+      if (!card.hidden) await animateCard(card, false);
+      card.remove();
+      removing = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (toggling || !toggleCard.isConnected) return;
+      toggling = true;
+      updateControls();
+      if (toggleCard.hidden) {
+        toggleCard.hidden = false;
+        await animateCard(toggleCard, true);
+      } else {
+        await animateCard(toggleCard, false);
+        toggleCard.hidden = true;
+      }
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+      toggling = false;
+      updateControls();
+    });
+  </script>
+
 </body>
 
