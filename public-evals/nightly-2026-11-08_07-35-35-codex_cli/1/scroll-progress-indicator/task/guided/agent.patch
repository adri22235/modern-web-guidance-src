   </footer>
 
+  <script>
+    (function () {
+      var progress = document.querySelector('.scroll-progress');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeTimeline = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      var pendingFrame = null;
+
+      function updateProgress() {
+        pendingFrame = null;
+        if (nativeTimeline && !reducedMotion.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        var root = document.documentElement;
+        var scrollable = root.scrollHeight - root.clientHeight;
+        var position = window.pageYOffset || root.scrollTop || 0;
+        var fraction = scrollable > 0 ? position / scrollable : 0;
+        progress.style.transform = 'scaleX(' + Math.min(1, Math.max(0, fraction)) + ')';
+      }
+
+      function scheduleUpdate() {
+        if (pendingFrame === null && (!nativeTimeline || reducedMotion.matches)) {
+          pendingFrame = window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', updateProgress);
+      } else {
+        reducedMotion.addListener(updateProgress);
+      }
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.body);
+      }
+      updateProgress();
+    }());
+  </script>
 </body>
 
