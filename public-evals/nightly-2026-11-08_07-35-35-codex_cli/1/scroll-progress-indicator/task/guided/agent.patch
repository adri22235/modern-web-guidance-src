+    /* Keep reading progress above the sticky navigation without intercepting clicks. */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      z-index: 1001;
