+  <script>
+    const shopSelect = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+
+    function validateShop() {
+      const invalid = !shopSelect.validity.valid;
+      shopError.hidden = !invalid;
+      if (invalid) {
+        shopSelect.setAttribute('aria-invalid', 'true');
+        shopSelect.setAttribute('aria-describedby', 'local-shop-error');
+      } else {
+        shopSelect.removeAttribute('aria-invalid');
+        shopSelect.removeAttribute('aria-describedby');
+      }
+    }
+
+    shopSelect.addEventListener('blur', validateShop);
+    shopSelect.addEventListener('change', validateShop);
+    // Native validation fires this event when an empty selection blocks submission.
+    shopSelect.addEventListener('invalid', validateShop);
+  </script>
