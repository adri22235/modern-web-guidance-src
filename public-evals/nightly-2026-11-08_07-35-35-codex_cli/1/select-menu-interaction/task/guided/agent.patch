+  <script>
+    const localShop = document.getElementById('local-shop');
+
+    // Keep assistive technology in sync with the browser's interaction state.
+    const syncShopValidity = () => {
+      localShop.setAttribute('aria-invalid', String(localShop.matches(':user-invalid')));
+    };
+
+    localShop.addEventListener('blur', () => requestAnimationFrame(syncShopValidity));
+    localShop.addEventListener('change', () => requestAnimationFrame(syncShopValidity));
+    localShop.addEventListener('input', () => {
+      if (localShop.validity.valid) localShop.removeAttribute('aria-invalid');
+    });
+    localShop.addEventListener('invalid', () => localShop.setAttribute('aria-invalid', 'true'));
+  </script>
