+  <script>
+    const loadingStatus = document.getElementById('loading-status');
+    const loadingLinks = [...document.querySelectorAll('[data-loading-message]')].map(link => ({
+      link,
+      label: link.querySelector('.btn-label'),
+      spinner: link.querySelector('.spinner'),
+      originalText: link.querySelector('.btn-label').textContent,
+      originalAriaLabel: link.getAttribute('aria-label')
+    }));
+
+    for (const { link, label, spinner } of loadingLinks) {
+      link.addEventListener('click', event => {
+        // Preserve native links, including opening a destination in a new tab.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
+            event.shiftKey || event.altKey || link.hasAttribute('download') ||
+            (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.setAttribute('aria-label', link.dataset.loadingMessage);
+        spinner.hidden = false;
+        label.textContent = link.pathname === '/order-online' ? 'Starting order…' : 'Loading details…';
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+    }
+
+    // Back/forward cache restores the document with its previous DOM state.
+    window.addEventListener('pageshow', () => {
+      for (const { link, label, spinner, originalText, originalAriaLabel } of loadingLinks) {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        if (originalAriaLabel === null) link.removeAttribute('aria-label');
+        else link.setAttribute('aria-label', originalAriaLabel);
+        label.textContent = originalText;
+        spinner.hidden = true;
+      }
+      loadingStatus.textContent = '';
+    });
+  </script>
