+  <script>
+    const loadingLinks = document.querySelectorAll('a[data-loading-message]');
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+
+    function resetLoading() {
+      for (const link of loadingLinks) {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('.loading-spinner').hidden = true;
+        const label = link.querySelector('[data-label]');
+        if (label.dataset.originalLabel) label.textContent = label.dataset.originalLabel;
+      }
+      seasonalFavorites.removeAttribute('aria-busy');
+      loadingStatus.textContent = '';
+    }
+
+    for (const link of loadingLinks) {
+      const label = link.querySelector('[data-label]');
+      label.dataset.originalLabel = label.textContent;
+      link.addEventListener('click', (event) => {
+        // Leave new-tab/window gestures and native navigation intact.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey) return;
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('.loading-spinner').hidden = false;
+        label.textContent = seasonalFavorites.contains(link) ? 'Loading details…' : 'Starting order…';
+        if (seasonalFavorites.contains(link)) seasonalFavorites.setAttribute('aria-busy', 'true');
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+    }
+
+    // A page restored from the back/forward cache must be ready to use again.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
