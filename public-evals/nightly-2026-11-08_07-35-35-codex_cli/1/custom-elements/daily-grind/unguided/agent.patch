+++ b/coffee-card.js
@@ -0,0 +1,133 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    :host([hidden]) { display: none; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .featured { color: var(--primary, #4e342e); font-weight: bold; }
+    .price { margin-top: 10px; font-weight: bold; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+  </style>
+  <article>
+    <p class="featured" hidden>Featured</p>
+    <h3></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+/** A self-contained coffee card. Prices are optional, nonnegative USD amounts. */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this._heading = this.shadowRoot.querySelector('h3');
+    this._description = this.shadowRoot.querySelector('.description');
+    this._price = this.shadowRoot.querySelector('.price');
+    this._featured = this.shadowRoot.querySelector('.featured');
+    this._link = this.shadowRoot.querySelector('a');
+    this._onClick = (event) => {
+      const accepted = this.dispatchEvent(new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        cancelable: true,
+        detail: { name: this.name, href: this.href, price: this.price, featured: this.featured },
+      }));
+      if (!accepted) event.preventDefault();
+    };
+  }
+
+  connectedCallback() {
+    // Replay properties assigned before the browser registered this element.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.prototype.hasOwnProperty.call(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this._render();
+    this._link.addEventListener('click', this._onClick);
+  }
+
+  disconnectedCallback() {
+    this._link.removeEventListener('click', this._onClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this._render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.setAttribute('description', String(value)); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.setAttribute('href', String(value)); }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    const value = raw === null || raw.trim() === '' ? NaN : Number(raw);
+    return Number.isFinite(value) && value >= 0 ? value : null;
+  }
+
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const amount = Number(value);
+    if (!Number.isFinite(amount) || amount < 0 || String(value).trim() === '') {
+      throw new RangeError('price must be a finite, nonnegative number or null');
+    }
+    this.setAttribute('price', String(amount));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  _render() {
+    this._heading.textContent = this.name;
+    this._description.textContent = this.description;
+    this._featured.hidden = !this.featured;
+    this._price.hidden = this.price === null;
+    this._price.textContent = this.price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+
+    // Keep navigation local or HTTP(S), including when properties come from data.
+    let safeHref = '';
+    try {
+      const url = new URL(this.href, this.ownerDocument.baseURI);
+      if (this.href.trim() && ['http:', 'https:'].includes(url.protocol)) safeHref = this.href;
+    } catch { /* An invalid destination leaves the card without a link. */ }
+    if (safeHref) this._link.setAttribute('href', safeHref);
+    else this._link.removeAttribute('href');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/coffee-card.test.js b/coffee-card.test.js
new file mode 100644
index 0000000..d89b80f
--- /dev/null
+++ b/coffee-card.test.js
@@ -0,0 +1,123 @@
+import assert from 'node:assert/strict';
+import { test, afterEach } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window({ url: 'https://daily-grind.example/' });
+for (const key of ['document', 'HTMLElement', 'customElements', 'CustomEvent']) {
+  globalThis[key] = window[key];
+}
+const { CoffeeCard } = await import('./coffee-card.js');
+afterEach(() => document.body.replaceChildren());
+
+test('registers an autonomous element and renders declarative attributes', () => {
+  document.body.innerHTML = '<coffee-card name="Cold Brew" description="Smooth." href="/menu/cold-brew"></coffee-card>';
+  const card = document.body.firstElementChild;
+  assert.ok(card instanceof CoffeeCard);
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, 'Cold Brew');
+  assert.equal(card.shadowRoot.querySelector('.description').textContent, 'Smooth.');
+  assert.equal(card.shadowRoot.querySelector('a').getAttribute('href'), '/menu/cold-brew');
+});
+
+test('string properties and attributes reflect in both directions, including removal', () => {
+  const card = new CoffeeCard();
+  for (const property of ['name', 'description', 'href']) {
+    card[property] = 'First';
+    assert.equal(card.getAttribute(property), 'First');
+    card.setAttribute(property, 'Second');
+    assert.equal(card[property], 'Second');
+    card.removeAttribute(property);
+    assert.equal(card[property], '');
+  }
+  card.name = '<img src=x onerror=alert(1)>';
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+  assert.equal(card.shadowRoot.querySelector('img'), null);
+});
+
+test('numeric prices reflect and render, with explicit handling of absent and invalid values', () => {
+  const card = new CoffeeCard();
+  assert.equal(card.price, null);
+  card.price = 4.5;
+  assert.equal(card.getAttribute('price'), '4.5');
+  assert.equal(card.shadowRoot.querySelector('.price').textContent, '$4.50');
+  card.setAttribute('price', '0');
+  assert.equal(card.price, 0);
+  assert.equal(card.shadowRoot.querySelector('.price').hidden, false);
+  for (const value of ['', 'invalid', '-1', 'Infinity']) {
+    card.setAttribute('price', value);
+    assert.equal(card.price, null);
+    assert.equal(card.shadowRoot.querySelector('.price').hidden, true);
+  }
+  for (const value of [-1, NaN, Infinity, '']) {
+    assert.throws(() => { card.price = value; }, RangeError);
+  }
+  card.price = null;
+  assert.equal(card.hasAttribute('price'), false);
+});
+
+test('boolean reflection follows attribute presence, including featured="false"', () => {
+  const card = new CoffeeCard();
+  assert.equal(card.featured, false);
+  card.featured = true;
+  assert.equal(card.getAttribute('featured'), '');
+  assert.equal(card.shadowRoot.querySelector('.featured').hidden, false);
+  card.setAttribute('featured', 'false');
+  assert.equal(card.featured, true);
+  card.featured = false;
+  assert.equal(card.hasAttribute('featured'), false);
+  assert.equal(card.shadowRoot.querySelector('.featured').hidden, true);
+});
+
+test('connection adds one listener, disconnection cleans it up, and reconnection restores it', () => {
+  const card = new CoffeeCard();
+  card.name = 'Latte';
+  card.href = '/menu/latte';
+  card.price = 5;
+  card.featured = true;
+  const link = card.shadowRoot.querySelector('a');
+  let count = 0;
+  document.body.addEventListener('coffee-select', (event) => {
+    count++;
+    assert.deepEqual(event.detail, { name: 'Latte', href: '/menu/latte', price: 5, featured: true });
+    event.preventDefault();
+  });
+  const click = () => link.dispatchEvent(new window.MouseEvent('click', { cancelable: true }));
+  document.body.append(card);
+  assert.equal(click(), false);
+  assert.equal(count, 1);
+  card.remove();
+  let detachedCount = 0;
+  card.addEventListener('coffee-select', () => detachedCount++);
+  click();
+  assert.equal(detachedCount, 0);
+  document.body.append(card);
+  assert.equal(click(), false);
+  assert.equal(count, 2);
+  assert.equal(detachedCount, 1);
+});
+
+test('connection replays properties assigned before element upgrade', () => {
+  const card = new CoffeeCard();
+  // Before definition, property assignments create own properties on HTMLElement.
+  Object.defineProperty(card, 'name', { value: 'Early latte', configurable: true, writable: true });
+  Object.defineProperty(card, 'price', { value: 3, configurable: true, writable: true });
+  Object.defineProperty(card, 'featured', { value: true, configurable: true, writable: true });
+  document.body.append(card);
+  assert.equal(Object.hasOwn(card, 'name'), false);
+  assert.equal(card.getAttribute('name'), 'Early latte');
+  assert.equal(card.getAttribute('price'), '3');
+  assert.equal(card.hasAttribute('featured'), true);
+});
+
+test('removing attributes clears rendered state and unsafe destinations cannot navigate', () => {
+  const card = new CoffeeCard();
+  document.body.append(card);
+  card.name = 'Latte';
+  card.removeAttribute('name');
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, '');
+  for (const href of ['javascript:alert(1)', 'data:text/html,hello', '']) {
+    card.href = href;
+    assert.equal(card.shadowRoot.querySelector('a').hasAttribute('href'), false);
+  }
+  card.href = '/menu';
+  assert.equal(card.shadowRoot.querySelector('a').getAttribute('href'), '/menu');
+});
