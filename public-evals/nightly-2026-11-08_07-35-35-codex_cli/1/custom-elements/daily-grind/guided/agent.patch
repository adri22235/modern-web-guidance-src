@@ -0,0 +1,40 @@
+# The Daily Grind
+
+Coffee cards are autonomous `<coffee-card>` custom elements, registered by the
+browser module `coffee-card.js`. Existing light DOM provides readable content and
+links if JavaScript fails to load. New cards can also be created with
+`document.createElement('coffee-card')`.
+
+| Attribute / property | Type | Default / behavior |
+| --- | --- | --- |
+| `name` | string | Empty string; renders the heading |
+| `description` | string | Empty string; renders the description |
+| `href` | string | Empty string; relative or HTTP(S) details URL |
+| `price` | number | `0`; optional USD price, hidden when attribute is absent |
+| `featured` | boolean | `false`; shows a badge and highlighted border |
+| `disabled` | boolean | `false`; disables details navigation and removes the link from tab order |
+
+Properties reflect to attributes, and attribute edits update properties and the
+card immediately. Assigning `null` or `undefined` removes string or numeric
+attributes. Invalid, negative, or infinite prices read as `0`; property assignments
+also serialize them as `0`. Boolean attributes use HTML presence semantics:
+`disabled="false"` still disables the card. Set `card.disabled = false` or remove
+the attribute to enable it.
+
+```js
+const card = document.createElement('coffee-card');
+card.name = 'Maple Oat Latte';
+card.description = 'Creamy oat milk with Vermont maple syrup.';
+card.href = '/menu/seasonal';
+card.price = 5.5;
+card.featured = true;
+document.querySelector('.grid').append(card);
+```
+
+Connection initializes or reuses the markup and attaches the click handler.
+Disconnection removes the handler; reconnecting retains nodes and reflected state.
+Properties assigned before registration are recovered during connection.
+Styles remain in `index.html` so static fallback markup shares the same layout.
+
+Run the DOM-based regression suite with `pnpm test`. It does not start a server
+or browser.
diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..18e2ea3
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,125 @@
+/** A progressively enhanced, autonomous coffee card. Attributes own public state. */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured', 'disabled'];
+
+  #elements;
+  #preventDisabledNavigation = (event) => {
+    if (this.disabled) event.preventDefault();
+  };
+
+  connectedCallback() {
+    // Recover properties assigned before customElements.define() upgraded this node.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+
+    if (!this.#elements) {
+      const ensure = (selector, tag, className) => {
+        let element = this.querySelector(`:scope > ${selector}`);
+        if (!element) {
+          element = this.ownerDocument.createElement(tag);
+          if (className) element.className = className;
+          this.append(element);
+        }
+        return element;
+      };
+
+      // Reuse the static fallback; empty, script-created cards work as well.
+      this.#elements = {
+        name: ensure('h3', 'h3'),
+        description: ensure('p:not(.card-price):not(.card-featured)', 'p'),
+        featured: ensure('.card-featured', 'p', 'card-featured'),
+        price: ensure('.card-price', 'p', 'card-price'),
+        link: ensure('a', 'a', 'btn'),
+      };
+      this.#elements.link.textContent = 'View Details';
+      // Keep the same order for both static and programmatic instances.
+      this.append(...Object.values(this.#elements));
+    }
+
+    this.#elements.link.addEventListener('click', this.#preventDisabledNavigation);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#elements?.link.removeEventListener('click', this.#preventDisabledNavigation);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#reflectString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#reflectString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#reflectString('href', value); }
+
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    this.setAttribute('price', String(Number.isFinite(number) && number >= 0 ? number : 0));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  #reflectString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  #render() {
+    if (!this.#elements) return;
+    const { name, description, featured, price, link } = this.#elements;
+    name.textContent = this.name;
+    description.textContent = this.description;
+    featured.textContent = 'Seasonal favorite';
+    featured.hidden = !this.featured;
+    price.textContent = new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+    price.hidden = !this.hasAttribute('price');
+
+    // Only permit ordinary web navigation, even when attributes come from data.
+    let safeHref = '';
+    try {
+      const url = new URL(this.href, this.ownerDocument.baseURI);
+      if (this.href && ['http:', 'https:'].includes(url.protocol)) safeHref = this.href;
+    } catch {
+      // An invalid URL has the same unavailable state as a missing destination.
+    }
+    const unavailable = this.disabled || !safeHref;
+    if (unavailable) link.removeAttribute('href');
+    else link.setAttribute('href', safeHref);
+    if (unavailable) {
+      link.setAttribute('aria-disabled', 'true');
+      link.setAttribute('tabindex', '-1');
+    } else {
+      link.removeAttribute('aria-disabled');
+      link.removeAttribute('tabindex');
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
diff --git a/coffee-card.test.js b/coffee-card.test.js
new file mode 100644
index 0000000..ed657f4
--- /dev/null
+++ b/coffee-card.test.js
@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window({ url: 'https://daily-grind.example/' });
+const { document } = window;
+globalThis.HTMLElement = window.HTMLElement;
+globalThis.customElements = window.customElements;
+await import('./coffee-card.js');
+
+function card() {
+  const element = document.createElement('coffee-card');
+  document.body.append(element);
+  return element;
+}
+
+test('existing cards retain content, links, and child nodes across reconnects', async () => {
+  const html = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+  const fragment = document.createElement('div');
+  fragment.innerHTML = html.match(/<div class="grid">([\s\S]*?)<\/section>/)[1];
+  document.body.append(fragment);
+  const cards = fragment.querySelectorAll('coffee-card');
+  assert.equal(cards.length, 3);
+  for (const element of cards) {
+    assert.equal(element.querySelector('h3').textContent, element.name);
+    assert.equal(element.querySelector('p').textContent, element.description);
+    assert.equal(element.querySelector('a').getAttribute('href'), element.href);
+    const children = [...element.children];
+    element.remove();
+    fragment.append(element);
+    assert.deepEqual([...element.children], children);
+    assert.equal(element.querySelector('.card-price').hidden, true);
+  }
+});
+
+test('string properties reflect both ways and render as text', () => {
+  const element = card();
+  element.name = '<img src=x onerror=alert(1)>';
+  element.description = 'Freshly roasted';
+  element.href = '/menu/test';
+  assert.equal(element.getAttribute('name'), element.name);
+  assert.equal(element.querySelector('h3').textContent, element.name);
+  assert.equal(element.querySelector('img'), null);
+  element.setAttribute('description', 'Updated description');
+  assert.equal(element.description, 'Updated description');
+  assert.equal(element.querySelector('p').textContent, element.description);
+  element.name = null;
+  assert.equal(element.hasAttribute('name'), false);
+  assert.equal(element.name, '');
+  element.href = 'javascript:alert(1)';
+  assert.equal(element.querySelector('a').hasAttribute('href'), false);
+});
+
+test('numeric price handles updates, zero, removal, and invalid values', () => {
+  const element = card();
+  element.price = 4.5;
+  assert.equal(element.getAttribute('price'), '4.5');
+  assert.equal(element.price, 4.5);
+  assert.equal(element.querySelector('.card-price').textContent, '$4.50');
+  element.setAttribute('price', '0');
+  assert.equal(element.price, 0);
+  assert.equal(element.querySelector('.card-price').hidden, false);
+  for (const invalid of ['oops', 'Infinity', '-5']) {
+    element.setAttribute('price', invalid);
+    assert.equal(element.price, 0);
+    assert.equal(element.querySelector('.card-price').textContent, '$0.00');
+  }
+  element.price = NaN;
+  assert.equal(element.getAttribute('price'), '0');
+  element.price = null;
+  assert.equal(element.hasAttribute('price'), false);
+  assert.equal(element.querySelector('.card-price').hidden, true);
+});
+
+test('boolean attributes use presence and disabled navigation is restored', () => {
+  const element = card();
+  element.href = '/menu/test';
+  element.setAttribute('featured', 'false');
+  assert.equal(element.featured, true);
+  assert.equal(element.querySelector('.card-featured').hidden, false);
+  element.featured = false;
+  assert.equal(element.hasAttribute('featured'), false);
+  element.disabled = true;
+  const link = element.querySelector('a');
+  assert.equal(link.getAttribute('aria-disabled'), 'true');
+  assert.equal(link.getAttribute('tabindex'), '-1');
+  assert.equal(link.hasAttribute('href'), false);
+  const click = new window.MouseEvent('click', { cancelable: true });
+  assert.equal(link.dispatchEvent(click), false);
+  element.removeAttribute('disabled');
+  assert.equal(element.disabled, false);
+  assert.equal(link.getAttribute('href'), '/menu/test');
+  assert.equal(link.hasAttribute('tabindex'), false);
+});
+
+test('disconnect removes listeners and reconnect reattaches them exactly once', () => {
+  const element = card();
+  element.disabled = true;
+  const link = element.querySelector('a');
+  const click = () => new window.MouseEvent('click', { cancelable: true });
+  element.remove();
+  assert.equal(link.dispatchEvent(click()), true);
+  element.name = 'Changed while detached';
+  document.body.append(element);
+  assert.equal(link.dispatchEvent(click()), false);
+  assert.equal(element.querySelector('h3').textContent, 'Changed while detached');
+  assert.equal(element.querySelectorAll('a').length, 1);
+});
+
+test('pre-upgrade own properties are passed through reflected setters', () => {
+  const element = document.createElement('coffee-card');
+  // Model own properties left on an element created before registration.
+  Object.defineProperty(element, 'name', { configurable: true, value: 'Early name' });
+  Object.defineProperty(element, 'price', { configurable: true, value: 3.75 });
+  Object.defineProperty(element, 'featured', { configurable: true, value: true });
+  document.body.append(element);
+  assert.equal(Object.hasOwn(element, 'name'), false);
+  assert.equal(element.getAttribute('name'), 'Early name');
+  assert.equal(element.price, 3.75);
+  assert.equal(element.featured, true);
+});
