+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var temperatureValue = document.getElementById('roast-temp-value');
+      var context = canvas.getContext('2d');
+      var frameId = null;
+      var intervalId = null;
+      var lastFrame = null;
+      var elapsed = 0;
+      var temperature = 180;
+      var inView = false;
+      var renderingSkipped = false;
+      var pageActive = true;
+      var running = false;
+      var beans = [];
+
+      for (var i = 0; i < 48; i++) {
+        beans.push({
+          x: Math.random() * canvas.width,
+          y: 35 + Math.random() * (canvas.height - 70),
+          phase: Math.random() * Math.PI * 2,
+          speed: 25 + Math.random() * 35,
+          size: 9 + Math.random() * 6
+        });
+      }
+
+      function draw() {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        var roast = (temperature - 180) / 45;
+        beans.forEach(function (bean) {
+          var x = (bean.x + elapsed * bean.speed) % (canvas.width + 40) - 20;
+          var y = bean.y + Math.sin(elapsed * 2 + bean.phase) * 17;
+          context.save();
+          context.translate(x, y);
+          context.rotate(bean.phase + elapsed * 1.3);
+          context.scale(bean.size, bean.size * 0.65);
+          context.beginPath();
+          context.arc(0, 0, 1, 0, Math.PI * 2);
+          context.fillStyle = 'rgb(' + Math.round(155 - roast * 65) + ', ' +
+            Math.round(95 - roast * 50) + ', ' + Math.round(50 - roast * 25) + ')';
+          context.fill();
+          context.beginPath();
+          context.moveTo(-0.65, 0);
+          context.bezierCurveTo(-0.2, -0.35, 0.2, 0.35, 0.65, 0);
+          context.strokeStyle = '#382016';
+          context.lineWidth = 0.13;
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        frameId = null;
+        if (!running) return;
+        if (lastFrame !== null) elapsed += Math.min((timestamp - lastFrame) / 1000, 0.05);
+        lastFrame = timestamp;
+        draw();
+        frameId = window.requestAnimationFrame(animate);
+      }
+
+      function syncActivity() {
+        var shouldRun = inView && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        if (running) {
+          lastFrame = null;
+          if (context) frameId = window.requestAnimationFrame(animate);
+          intervalId = window.setInterval(function () {
+            temperature = Math.max(180, Math.min(225, temperature + (Math.random() - 0.35) * 3));
+            temperatureValue.textContent = Math.round(temperature);
+          }, 1000);
+        } else {
+          if (frameId !== null) window.cancelAnimationFrame(frameId);
+          if (intervalId !== null) window.clearInterval(intervalId);
+          frameId = intervalId = lastFrame = null;
+        }
+      }
+
+      function checkViewport() {
+        var rect = widget.getBoundingClientRect();
+        inView = rect.bottom > 0 && rect.right > 0 &&
+          rect.top < window.innerHeight && rect.left < window.innerWidth;
+        syncActivity();
+      }
+
+      // Native rendering-state events also stop work when CSS skips this subtree.
+      // Viewport detection remains necessary: auto rendering can begin offscreen.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            inView = entry.isIntersecting && entry.intersectionRatio > 0;
+          });
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Older browsers: no persistent polling timer or offscreen animation loop.
+        document.addEventListener('scroll', checkViewport, true);
+        window.addEventListener('resize', checkViewport);
+        window.addEventListener('load', checkViewport);
+      }
+
+      document.addEventListener('visibilitychange', checkViewport);
+      window.addEventListener('pagehide', function () {
+        pageActive = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', function () {
+        pageActive = true;
+        checkViewport();
+      });
+      checkViewport();
+    }());
+  </script>
+
