+  <script>
+    (() => {
+      const panel = document.getElementById('coffee-cart');
+      const handle = document.getElementById('cart-handle');
+      const minimize = document.getElementById('cart-minimize');
+      const launcher = document.getElementById('cart-launcher');
+      const form = document.getElementById('quick-order');
+      const drink = document.getElementById('cart-drink');
+      const quantity = document.getElementById('quantity');
+      const down = document.getElementById('quantity-down');
+      const up = document.getElementById('quantity-up');
+      const add = document.getElementById('add-to-bag');
+      const status = document.getElementById('cart-status');
+      const items = document.getElementById('bag-items');
+      const next = document.getElementById('continue-order');
+      const prices = { 'maple-oat-latte': 550, 'dark-roast-espresso': 350, 'cold-brew': 450 };
+      const sizePrices = { Small: -50, Medium: 0, Large: 75 };
+      const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+      const bag = [];
+      let count = 1;
+      let offsetX = 0;
+      let offsetY = 0;
+      let activePointer = null;
+      const selectedPrice = () => prices[drink.value] + sizePrices[form.elements.size.value];
+
+      function updateSelection() {
+        const isColdBrew = drink.value === 'cold-brew';
+        const isEspresso = drink.value === 'dark-roast-espresso';
+        form.querySelector('[name="temperature"][value="Hot"]').disabled = isColdBrew;
+        form.querySelector('[name="temperature"][value="Iced"]').disabled = isEspresso;
+        if (isColdBrew) form.elements.temperature.value = 'Iced';
+        if (isEspresso) form.elements.temperature.value = 'Hot';
+        quantity.value = String(count);
+        down.disabled = count === 1;
+        up.disabled = count === 10;
+        add.textContent = `Add to bag · ${money(selectedPrice() * count)}`;
+      }
+      function renderBag() {
+        items.replaceChildren();
+        let total = 0;
+        let itemCount = 0;
+        bag.forEach((item, index) => {
+          total += item.price * item.quantity;
+          itemCount += item.quantity;
+          const row = document.createElement('li');
+          row.className = 'bag-item';
+          const description = document.createElement('div');
+          description.textContent = `${item.quantity} × ${item.name}`;
+          const details = document.createElement('small');
+          details.textContent = `${item.size} · ${item.temperature}`;
+          description.append(details);
+          const price = document.createElement('span');
+          price.textContent = money(item.price * item.quantity);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${item.name}, ${item.size}, ${item.temperature}`);
+          remove.addEventListener('click', () => {
+            bag.splice(index, 1);
+            renderBag();
+            status.textContent = `${item.name} removed from your bag.`;
+            const remainingButtons = items.querySelectorAll('button');
+            (remainingButtons[Math.min(index, remainingButtons.length - 1)] || add).focus();
+          });
+          row.append(description, price, remove);
+          items.append(row);
+        });
+        document.getElementById('bag-count').textContent = String(itemCount);
+        document.getElementById('launcher-count').textContent = String(itemCount);
+        document.getElementById('cart-total').textContent = money(total);
+        document.getElementById('bag-empty').hidden = bag.length > 0;
+        next.hidden = bag.length === 0;
+        next.href = '/order-online?' + new URLSearchParams({ items: JSON.stringify(bag) });
+        reclamp();
+      }
+      form.addEventListener('change', updateSelection);
+      down.addEventListener('click', () => { count = Math.max(1, count - 1); updateSelection(); });
+      up.addEventListener('click', () => { count = Math.min(10, count + 1); updateSelection(); });
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const name = drink.selectedOptions[0].textContent;
+        const size = form.elements.size.value;
+        const temperature = form.elements.temperature.value;
+        const existing = bag.find(item => item.drink === drink.value && item.size === size && item.temperature === temperature);
+        if (existing) existing.quantity += count;
+        else bag.push({ drink: drink.value, name, size, temperature, quantity: count, price: selectedPrice() });
+        status.textContent = `${count} × ${name} added to your bag.`;
+        renderBag();
+      });
+
+      function moveTo(left, top) {
+        const inset = 12;
+        const maxLeft = Math.max(inset, window.innerWidth - panel.offsetWidth - inset);
+        const maxTop = Math.max(inset, window.innerHeight - panel.offsetHeight - inset);
+        panel.style.left = `${Math.max(inset, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(inset, Math.min(top, maxTop))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      }
+      function reclamp() {
+        if (panel.hidden) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+      handle.classList.add('ready');
+      handle.tabIndex = 0;
+      handle.setAttribute('role', 'group');
+      handle.setAttribute('aria-label', 'Move coffee cart. Drag or use the arrow keys.');
+      handle.addEventListener('pointerdown', event => {
+        if (event.button !== 0 || !event.isPrimary || activePointer !== null) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        activePointer = event.pointerId;
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('dragging');
+        handle.focus({ preventScroll: true });
+        event.preventDefault();
+      });
+      handle.addEventListener('pointermove', event => {
+        if (event.pointerId !== activePointer || !handle.hasPointerCapture(event.pointerId)) return;
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      function endDrag(event) {
+        if (event.pointerId !== activePointer) return;
+        activePointer = null;
+        handle.classList.remove('dragging');
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', endDrag);
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        if (!directions[event.key]) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        const [x, y] = directions[event.key];
+        moveTo(rect.left + x, rect.top + y);
+      });
+      minimize.addEventListener('click', () => {
+        panel.hidden = true;
+        launcher.hidden = false;
+        launcher.setAttribute('aria-expanded', 'false');
+        launcher.focus();
+      });
+      launcher.addEventListener('click', () => {
+        panel.hidden = false;
+        launcher.hidden = true;
+        launcher.setAttribute('aria-expanded', 'true');
+        reclamp();
+        handle.focus({ preventScroll: true });
+      });
+      window.addEventListener('resize', reclamp);
+      if ('ResizeObserver' in window) new ResizeObserver(reclamp).observe(panel);
+      document.getElementById('quantity-control').hidden = false;
+      document.getElementById('bag-section').hidden = false;
+      minimize.hidden = false;
+      updateSelection();
+      reclamp();
+    })();
+  </script>
+
