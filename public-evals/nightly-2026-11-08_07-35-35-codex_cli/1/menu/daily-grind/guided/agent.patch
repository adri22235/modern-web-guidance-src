+          }
+        });
+        return menu;
+      }
+
+      const menuTrigger = document.createElement('button');
+      menuTrigger.className = 'nav-menu-trigger';
+      menuTrigger.innerHTML = 'Menu <span class="chevron" aria-hidden="true">▾</span>';
