+      }
+      document.addEventListener('keydown', event => {
+        if (!['Tab', 'Escape'].includes(event.key)) return;
+        const root = roots.find(menu => isOpen(menu) && (menu.contains(event.target) || owners.get(menu) === event.target));
+        if (!root) return;
+        if (event.key === 'Escape') {
+          event.preventDefault(); event.stopPropagation();
+          const deepest = [...menus].reverse().find(menu => isOpen(menu) && rootFor(menu) === root);
