+      const nativeFocusgroup = 'focusGroup' in HTMLElement.prototype;
+      const anchored = CSS.supports('position-area: block-end');
+      const menus = [];
+      const roots = [];
+      const owners = new Map();
+      const enterOnOpen = new Map();
+      const status = document.getElementById('order-status');
+      let sequence = 0;
+      let orderCount = 0;
+      let selectionTimer;
+      const drinks = {
+        maple: { name: 'Maple Oat Latte', path: 'seasonal', size: 'Medium', milk: 'Oat milk', sweetness: 'Regular sweetness', saved: false },
+        espresso: { name: 'Dark Roast Espresso', path: 'espresso', size: 'Small', milk: 'No milk', sweetness: 'Unsweetened', saved: false },
+        'cold-brew': { name: 'Cold Brew', path: 'cold-brew', size: 'Medium', milk: 'No milk', sweetness: 'Unsweetened', saved: false }
+      };
+      const link = (label, href) => ({ label, href });
+      const branch = (label, children) => ({ label, children });
+      const isOpen = menu => nativePopover ? menu.matches(':popover-open') : menu.hasAttribute('data-open');
+      const groupFor = menu => menu.firstElementChild;
+      const itemsFor = menu => [...groupFor(menu).children].filter(item => item.matches('.menu-item'));
+      const rootFor = menu => menu.closest('[data-root-menu]');
+      const announce = message => { status.textContent = message; };
+
+      function sync(menu, open) {
+        owners.get(menu).setAttribute('aria-expanded', String(open));
+        if (open) {
+          position(menu);
+          if (enterOnOpen.has(menu)) {
+            const items = itemsFor(menu);
+            items[enterOnOpen.get(menu) === 'last' ? items.length - 1 : 0]?.focus({ preventScroll: true });
+            enterOnOpen.delete(menu);
+          }
+        } else {
+          enterOnOpen.delete(menu);
+        }
+      }
+
+      function close(menu, restore = false) {
+        if (restore) owners.get(menu).focus({ preventScroll: true });
+        [...menus].reverse().filter(child => child !== menu && menu.contains(child)).forEach(child => close(child));
+        if (!isOpen(menu)) return;
+        if (nativePopover) menu.hidePopover();
+        else { menu.removeAttribute('data-open'); sync(menu, false); }
+      }
+
+      function open(menu, entry) {
+        clearTimeout(selectionTimer);
+        if (entry) enterOnOpen.set(menu, entry);
+        if (isOpen(menu)) { sync(menu, true); return; }
+        const parent = menu.parentElement.closest('.action-menu');
+        menus.filter(other => other !== menu && isOpen(other) && other.parentElement.closest('.action-menu') === parent)
+          .forEach(other => close(other));
