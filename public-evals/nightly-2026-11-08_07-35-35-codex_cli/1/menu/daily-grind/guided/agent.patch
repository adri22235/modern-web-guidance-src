+        }));
+        const trigger = document.createElement('button');
+        trigger.className = 'btn';
+        trigger.innerHTML = 'Choose options <span class="chevron" aria-hidden="true">▾</span>';
+        trigger.setAttribute('aria-label', `Choose options for ${drink.name}`);
+        document.querySelector(`[data-drink="${id}"]`).replaceChildren(trigger);
+        createMenu(trigger, [
+          link('View drink details', `/menu/${drink.path}`),
+          branch('Customize drink', [
+            branch('Size', choices('size', ['Small', 'Medium', 'Large'])),
+            branch('Milk', [
+              ...choices('milk', ['No milk', 'Whole milk']),
+              branch('Dairy-free', choices('milk', ['Oat milk', 'Almond milk', 'Soy milk']))
+            ]),
+            branch('Sweetness', choices('sweetness', ['Unsweetened', 'Light sweetness', 'Regular sweetness']))
+          ]),
+          { label: 'Save as favorite', check: () => drink.saved, action: () => {
+            drink.saved = !drink.saved; announce(`${drink.name} ${drink.saved ? 'saved to' : 'removed from'} your favorites for this visit.`);
+          } },
+          { separator: true },
+          { label: 'Add to order', action: () => {
+            orderCount++;
+            announce(`Added ${drink.name} (${drink.size}, ${drink.milk}, ${drink.sweetness}). Your order has ${orderCount} ${orderCount === 1 ? 'drink' : 'drinks'}.`);
+          } }
