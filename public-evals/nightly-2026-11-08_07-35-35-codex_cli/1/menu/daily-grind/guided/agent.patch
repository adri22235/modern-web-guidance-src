+      function position(menu) {
+        if (anchored && nativePopover) return;
+        const trigger = owners.get(menu);
+        const rect = trigger.getBoundingClientRect();
+        const parent = menu.parentElement.closest('.action-menu');
+        menu.style.maxHeight = '';
+        const width = menu.offsetWidth;
+        const height = menu.offsetHeight;
+        const viewportWidth = document.documentElement.clientWidth;
+        const viewportHeight = window.innerHeight;
+        let left = parent ? rect.right + 4 : rect.left;
+        let top = parent ? rect.top : rect.bottom + 4;
+        if (left + width > viewportWidth - 12) left = parent ? rect.left - width - 4 : rect.right - width;
+        if (parent && left < 12) {
