+          left = rect.left + 16;
+          top = rect.bottom + 4;
+        } else if (top + height > viewportHeight - 12) {
+          top = parent ? viewportHeight - height - 12 : rect.top - height - 4;
+        }
+        left = Math.max(12, Math.min(left, viewportWidth - width - 12));
+        top = Math.max(12, top);
+        menu.style.maxHeight = `${Math.max(44, viewportHeight - top - 12)}px`;
+        menu.style.setProperty('--menu-left', `${left}px`);
+        menu.style.setProperty('--menu-top', `${top}px`);
+        // Popover-less browsers must also override any supported anchor rules.
+        if (!nativePopover) {
+          menu.style.positionArea = 'none';
+          menu.style.left = `${left}px`;
+          menu.style.top = `${top}px`;
+          menu.style.margin = '0';
+          menu.style.inset = `${top}px auto auto ${left}px`;
+        }
+      }
+
+      function createMenu(trigger, entries, root = false) {
+        const id = `actions-${++sequence}`;
+        trigger.id ||= `${id}-trigger`;
+        trigger.type = 'button';
+        trigger.setAttribute('aria-haspopup', 'menu');
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.setAttribute('aria-controls', id);
+        trigger.setAttribute('commandfor', id);
+        trigger.setAttribute('command', 'toggle-popover');
+        const menu = document.createElement('div');
+        menu.id = id;
+        menu.className = 'action-menu';
+        menu.setAttribute('popover', 'auto');
+        if (root) { menu.dataset.rootMenu = ''; roots.push(menu); }
+        const group = document.createElement('div');
+        group.setAttribute('focusgroup', 'menu nomemory');
+        group.setAttribute('aria-labelledby', trigger.id);
+        if (!nativeFocusgroup) group.setAttribute('role', 'menu');
+        menu.append(group);
+        trigger.after(menu);
+        owners.set(menu, trigger);
+        menus.push(menu);
+        // Explicit anchors cover implementations lacking showPopover({ source }).
+        trigger.style.anchorName = `--${id}`;
+        menu.style.positionAnchor = `--${id}`;
+        for (const entry of entries) {
+          if (entry.separator) { group.append(document.createElement('hr')); continue; }
+          const item = document.createElement(entry.href ? 'a' : 'button');
+          item.className = 'menu-item';
+          item.textContent = entry.label;
+          item.tabIndex = nativeFocusgroup ? 0 : -1;
+          if (entry.href) item.href = entry.href;
