+        roots.filter(isOpen).forEach(menu => {
+          if (!menu.contains(event.target) && owners.get(menu) !== event.target) close(menu);
+        });
+      });
+      window.addEventListener('resize', () => menus.filter(isOpen).forEach(position));
+      window.addEventListener('scroll', () => menus.filter(isOpen).forEach(position), true);
+    })();
+  </script>
