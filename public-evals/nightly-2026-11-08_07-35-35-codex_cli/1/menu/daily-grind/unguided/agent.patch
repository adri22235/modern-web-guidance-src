     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <div class="toast" role="status" aria-live="polite" aria-atomic="true" id="order-status"></div>
+  <script>
+    let nextMenuId = 0;
+    let itemCount = 0;
+    const order = [];
+    const roots = [];
+    const status = document.getElementById('order-status');
+    let toastTimer;
+
+    // Every submenu uses the same component and focus behavior.
+    function closeMenu(button, restoreFocus = false) {
+      const panel = document.getElementById(button.getAttribute('aria-controls'));
+      panel.querySelectorAll('[aria-expanded="true"]').forEach(child => closeMenu(child));
+      panel.hidden = true;
+      button.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) button.focus();
+    }
+
+    function menuItems(panel) {
+      return [...panel.children].filter(el => el.classList.contains('menu-entry')).map(el => el.firstElementChild);
+    }
+
+    function openMenu(button, last = false) {
+      const panel = document.getElementById(button.getAttribute('aria-controls'));
+      const parentPanel = button.closest('[role="menu"]');
+      if (parentPanel) {
+        menuItems(parentPanel).filter(item => item !== button && item.getAttribute('aria-expanded') === 'true').forEach(item => closeMenu(item));
+      } else {
+        roots.filter(root => root !== button).forEach(root => closeMenu(root));
+      }
+      panel.hidden = false;
+      button.setAttribute('aria-expanded', 'true');
+      panel.classList.remove('opens-left');
+      if (parentPanel && panel.getBoundingClientRect().right > window.innerWidth - 12) panel.classList.add('opens-left');
+      const items = menuItems(panel);
+      (last ? items.at(-1) : items[0])?.focus();
+    }
+
+    function buildMenu(anchor, label, entries, root = true, buttonClass = '') {
+      const id = `action-menu-${++nextMenuId}`;
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.className = root ? buttonClass : 'menu-item';
+      button.textContent = label;
+      button.setAttribute('aria-haspopup', 'menu');
+      button.setAttribute('aria-expanded', 'false');
+      button.setAttribute('aria-controls', id);
+      const arrow = document.createElement('span');
+      arrow.className = 'chevron';
+      arrow.setAttribute('aria-hidden', 'true');
+      arrow.textContent = root ? '▾' : '›';
+      button.append(arrow);
+      const panel = document.createElement('div');
+      panel.id = id;
+      panel.className = 'menu-panel';
+      panel.role = 'menu';
+      panel.setAttribute('aria-label', label);
+      panel.hidden = true;
+      anchor.append(button, panel);
+      if (root) roots.push(button);
+      else { button.role = 'menuitem'; button.tabIndex = -1; }
+      button.addEventListener('click', () => panel.hidden ? openMenu(button) : closeMenu(button, true));
+      button.addEventListener('keydown', event => {
+        if (root && ['ArrowDown', 'ArrowUp'].includes(event.key)) {
+          event.preventDefault(); openMenu(button, event.key === 'ArrowUp');
+        }
+      });
+      entries.forEach(entry => {
+        if (entry.label || entry.divider) {
+          const text = document.createElement('div');
+          text.className = entry.divider ? 'menu-divider' : 'menu-label';
+          text.textContent = entry.label || '';
+          text.role = 'presentation';
+          panel.append(text);
+          return;
+        }
+        const wrapper = document.createElement('div');
+        wrapper.className = 'menu-entry';
+        wrapper.role = 'none';
+        panel.append(wrapper);
+        if (entry.children) { buildMenu(wrapper, entry.name, entry.children, false); return; }
+        const item = document.createElement(entry.href ? 'a' : 'button');
+        if (entry.href) item.href = entry.href;
+        else item.type = 'button';
+        item.className = 'menu-item';
+        item.textContent = entry.name;
+        item.tabIndex = -1;
+        item.role = entry.role || 'menuitem';
+        if (entry.checked !== undefined) item.setAttribute('aria-checked', String(entry.checked));
+        item.addEventListener('click', () => {
+          entry.action?.(item, panel);
+          if (!entry.keepOpen) closeMenu(roots.find(rootButton => document.getElementById(rootButton.getAttribute('aria-controls')).contains(item)), true);
+        });
+        wrapper.append(item);
+      });
+      let search = '';
+      let searchTimer;
+      panel.addEventListener('keydown', event => {
+        if (event.target.closest('[role="menu"]') !== panel) return;
+        const items = menuItems(panel);
+        const current = items.indexOf(document.activeElement);
+        let destination;
+        if (event.key === 'ArrowDown') destination = items[(current + 1) % items.length];
+        if (event.key === 'ArrowUp') destination = items[(current - 1 + items.length) % items.length];
+        if (event.key === 'Home') destination = items[0];
+        if (event.key === 'End') destination = items.at(-1);
+        if (event.key === 'ArrowRight' && document.activeElement.hasAttribute('aria-haspopup')) openMenu(document.activeElement);
+        else if (event.key === 'ArrowLeft' || event.key === 'Escape') closeMenu(button, true);
+        else if (event.key === 'Tab') {
+          const rootButton = roots.find(trigger => document.getElementById(trigger.getAttribute('aria-controls')).contains(panel));
+          rootButton.focus();
+          roots.forEach(trigger => closeMenu(trigger));
+          return;
+        }
+        else if (event.key === ' ' && document.activeElement.tagName === 'A') document.activeElement.click();
+        else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey && event.key !== ' ') {
+          search += event.key.toLowerCase();
+          clearTimeout(searchTimer);
+          searchTimer = setTimeout(() => search = '', 600);
+          destination = [...items.slice(current + 1), ...items.slice(0, current + 1)].find(item => item.textContent.toLowerCase().startsWith(search));
+        } else if (!destination) return;
+        event.preventDefault();
+        event.stopPropagation();
+        destination?.focus();
+      });
+      return button;
+    }
+
+    buildMenu(document.getElementById('drinks-menu'), 'Menu', [
+      { label: 'Find your daily ritual' },
+      { name: 'Coffee & espresso', children: [
+        { name: 'Espresso classics', children: [
+          { name: 'Espresso', href: '/menu/espresso' },
+          { name: 'Latte & cappuccino', href: '/menu/latte' },
+          { name: 'Americano', href: '/menu/americano' }
+        ] },
+        { name: 'Brewed coffee', href: '/menu/coffee' },
+        { name: 'Cold coffee', children: [
+          { name: 'Cold brew', href: '/menu/cold-brew' },
+          { name: 'Iced latte', href: '/menu/iced-latte' }
+        ] }
+      ] },
+      { name: 'Tea & more', children: [
+        { name: 'Tea & matcha', href: '/menu/tea' },
+        { name: 'Hot chocolate', href: '/menu/hot-chocolate' }
+      ] },
+      { name: 'Seasonal favorites', href: '/menu/seasonal' },
+      { divider: true },
+      { name: 'View full menu', href: '/menu' },
+      { name: 'Start an order', href: '/order-online' }
+    ], true, 'nav-trigger');
+
+    document.querySelectorAll('.drink-options').forEach(anchor => {
+      const drink = anchor.dataset.drink;
+      const selection = { size: 'Regular', milk: drink === 'Maple Oat Latte' ? 'Oat milk' : 'No milk', extras: new Set() };
+      const summary = anchor.parentElement.querySelector('.order-summary');
+      const updateSummary = () => summary.textContent = [selection.size, selection.milk, ...selection.extras].join(' · ');
+      const choices = (key, values) => values.map(value => ({
+        name: value, role: 'menuitemradio', checked: selection[key] === value, keepOpen: true,
+        action: (item, panel) => {
+          selection[key] = value;
+          panel.querySelectorAll('[role="menuitemradio"]').forEach(option => option.setAttribute('aria-checked', String(option === item)));
+          updateSummary();
+        }
+      }));
+      buildMenu(anchor, 'Drink options', [
+        { label: drink },
+        { name: 'View details', href: `/menu/${anchor.dataset.slug}` },
+        { name: 'Customize drink', children: [
+          { name: 'Size', children: choices('size', ['Small', 'Regular', 'Large']) },
+          { name: 'Milk', children: choices('milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk']) },
+          { name: 'Extras', children: ['Extra espresso shot', 'Vanilla syrup', 'Caramel syrup'].map(extra => ({
+            name: extra, role: 'menuitemcheckbox', checked: false, keepOpen: true,
+            action: item => {
+              if (selection.extras.has(extra)) selection.extras.delete(extra);
+              else selection.extras.add(extra);
+              item.setAttribute('aria-checked', String(selection.extras.has(extra)));
+              updateSummary();
+            }
+          })) }
+        ] },
+        { divider: true },
+        { name: 'Add to order', action: () => {
+          order.push({ drink: anchor.dataset.slug, size: selection.size, milk: selection.milk, extras: [...selection.extras] });
+          itemCount++;
+          const count = document.getElementById('order-count');
+          count.textContent = itemCount;
+          count.setAttribute('aria-label', `${itemCount} ${itemCount === 1 ? 'item' : 'items'} in order`);
+          document.getElementById('order-link').href = `/order-online?items=${encodeURIComponent(JSON.stringify(order))}`;
+          status.textContent = `${drink} added to your order. ${summary.textContent}.`;
+          clearTimeout(toastTimer);
+          toastTimer = setTimeout(() => status.textContent = '', 5000);
+        } }
+      ], true, 'btn');
+      anchor.firstElementChild.setAttribute('aria-label', `Drink options for ${drink}`);
+    });
+
+    document.addEventListener('click', event => {
+      roots.forEach(button => { if (!button.parentElement.contains(event.target)) closeMenu(button); });
+    });
+    document.addEventListener('focusin', event => {
+      roots.forEach(button => { if (!button.parentElement.contains(event.target)) closeMenu(button); });
+    });
+    window.addEventListener('resize', () => roots.forEach(button => closeMenu(button)));
+  </script>
 </body>
 
