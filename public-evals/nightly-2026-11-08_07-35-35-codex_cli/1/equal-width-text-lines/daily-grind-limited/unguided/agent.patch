+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    let fittedWidth;
+
+    function fitHeroHeading() {
+      const width = heroHeading.clientWidth;
+      if (!width || width === fittedWidth) return;
+      fittedWidth = width;
+
+      // Measure natural text widths, then size the letters to fill each line.
+      for (const line of heroHeading.children) {
+        line.style.fontSize = '100px';
+        const naturalWidth = line.getBoundingClientRect().width;
+        line.style.fontSize = `${100 * width / naturalWidth}px`;
+      }
+    }
+
+    fitHeroHeading();
+    new ResizeObserver(fitHeroHeading).observe(heroHeading);
+    document.fonts.ready.then(() => {
+      fittedWidth = undefined;
+      fitHeroHeading();
+    });
+  </script>
