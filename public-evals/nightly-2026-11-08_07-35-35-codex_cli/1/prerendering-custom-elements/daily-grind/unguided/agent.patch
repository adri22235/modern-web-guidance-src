new file mode 100644
index 0000000..8e178a4
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,24 @@
+// Content and styles arrive in the HTML. Upgrade only attaches behavior to
+// existing light DOM nodes; it never replaces markup or creates a shadow root.
+class DrinkCard extends HTMLElement {
+  connectedCallback() {
+    const button = this.querySelector('.favorite-toggle');
+    if (!button) return;
+
+    button.addEventListener('click', this);
+    button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.querySelector('.favorite-toggle')?.removeEventListener('click', this);
+  }
+
+  handleEvent(event) {
+    const button = event.currentTarget;
+    button.setAttribute('aria-pressed', String(button.getAttribute('aria-pressed') !== 'true'));
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
