+      line-height: 1.2;
+      margin: 12px 0 16px;
+    }
+
+    .story-layout {
+      display: grid;
+      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+      gap: clamp(20px, 6vw, 80px);
+      /* Expose each text timeline to the sibling visual branch only. */
+      timeline-scope: --coffee-source, --coffee-roast, --coffee-brew;
+    }
+
+    #tracked > section,
+    #animated > section {
+      min-height: 75svh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      padding-block: 32px;
+    }
+
+    #tracked h3 {
+      font-size: clamp(1.25rem, 3vw, 2rem);
+      line-height: 1.25;
+      margin: 12px 0 20px;
+    }
+
+    #tracked p {
+      max-width: 38ch;
+    }
+
+    #animated img {
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 5;
+      max-height: 48svh;
+      object-fit: cover;
+      border-radius: 8px;
+      background: var(--secondary);
+    }
+
+    #animated h3 {
+      margin-top: 16px;
+      font-size: 0.85rem;
+      font-weight: 500;
+      color: var(--primary);
+    }
+
+    /* No script, scroll listener, or animation polyfill is needed. */
+    @supports (animation-timeline: view()) and (animation-range: 0% 100%) and (timeline-scope: --coffee-source) {
+      @media (prefers-reduced-motion: no-preference) {
+        #tracked > section:nth-child(1) { view-timeline: --coffee-source block; }
+        #tracked > section:nth-child(2) { view-timeline: --coffee-roast block; }
+        #tracked > section:nth-child(3) { view-timeline: --coffee-brew block; }
+
+        #animated {
+          position: sticky;
+          top: 6rem;
+          align-self: start;
+          height: calc(100svh - 8rem);
+          display: grid;
+        }
+
+        #animated > section {
+          grid-area: 1 / 1;
+          min-height: 0;
+          /* Set timeline and range AFTER the animation shorthand. */
+          animation: coffee-reveal auto linear both;
+          animation-range: cover 0% cover 100%;
+        }
+
+        #animated > section:nth-child(1) { animation-timeline: --coffee-source; }
+        #animated > section:nth-child(2) { animation-timeline: --coffee-roast; }
+        #animated > section:nth-child(3) { animation-timeline: --coffee-brew; }
+      }
+    }
+
+    @keyframes coffee-reveal {
+      0% { opacity: 0; transform: translateY(24px); }
+      25%, 75% { opacity: 1; transform: translateY(0); }
+      100% { opacity: 0; transform: translateY(-24px); }
+    }
+
+    @media (max-width: 600px) {
+      .story-layout { gap: 20px; }
+      #tracked p { font-size: 0.9rem; }
+      #animated h3 { font-size: 0.75rem; }
+    }
+
