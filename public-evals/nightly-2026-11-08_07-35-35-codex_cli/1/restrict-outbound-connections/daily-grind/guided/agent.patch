+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('./', import.meta.url);
+const signupFile = resolve(process.env.NEWSLETTER_FILE || fileURLToPath(new URL('./.data/newsletter.jsonl', root)));
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+// Apply to every response, including worker requests and errors, without
+// varying by Sec-Fetch-Dest. Redirects and WebRTC stay blocked by default.
+export const connectionAllowlist = '(response-origin "https://images.unsplash.com")';
+
+export async function handleRequest(req, res) {
+  const nonce = randomBytes(18).toString('base64');
+  res.setHeader('Connection-Allowlist', connectionAllowlist);
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}'`,
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+  ].join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('X-DNS-Prefetch-Control', 'off');
+  res.setHeader('Cache-Control', 'no-store');
+
+  function send(code, body, type = 'text/plain; charset=utf-8') {
+    res.writeHead(code, { 'Content-Type': type });
+    res.end(req.method === 'HEAD' ? undefined : body);
+  }
+
+  try {
+    const pathname = new URL(req.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      const wantsJSON = req.headers.accept?.includes('application/json');
+      const reply = (code, ok, message) => {
+        if (wantsJSON) {
+          send(code, JSON.stringify({ ok, message }), 'application/json; charset=utf-8');
+        } else {
+          // Messages are fixed strings; never reflect submitted customer data.
+          send(code, `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Daily Grind newsletter</title><h1>Daily Grind newsletter</h1><p>${message}</p><a href="/">Back to Daily Grind</a></html>`, 'text/html; charset=utf-8');
+        }
+      };
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        reply(405, false, 'Please submit the newsletter form on our homepage.');
+        return;
+      }
+      if (req.headers['sec-fetch-site'] && req.headers['sec-fetch-site'] !== 'same-origin') {
+        reply(403, false, 'Please submit the newsletter form on our homepage.');
+        return;
+      }
+      const contentType = req.headers['content-type']?.split(';')[0].trim();
+      if (contentType !== 'application/x-www-form-urlencoded') {
+        reply(415, false, 'Please submit the newsletter form on our homepage.');
+        return;
+      }
+      req.setEncoding('utf8');
+      let body = '';
+      let bytes = 0;
+      for await (const chunk of req) {
+        bytes += Buffer.byteLength(chunk);
+        if (bytes > 4096) {
+          reply(413, false, 'Your signup is too large. Please try again with just your email address.');
+          return;
+        }
+        body += chunk.toString();
+      }
+      const fields = new URLSearchParams(body);
+      const email = fields.get('email')?.trim();
+      if (fields.getAll('email').length !== 1 || !email || email.length > 254 ||
+          !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+        reply(400, false, 'Please enter a valid email address and try again.');
+        return;
+      }
+      try {
+        await mkdir(dirname(signupFile), { recursive: true, mode: 0o700 });
+        await appendFile(signupFile, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      } catch {
+        reply(503, false, 'We couldn’t save your signup. Please try again later.');
+        return;
+      }
+      reply(201, true, 'You’re subscribed! Thanks for joining the Daily Grind newsletter.');
+      return;
+    }
+
+    const asset = assets.get(pathname);
+    if (!asset) return send(404, 'Page not found.');
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'Method not allowed.');
+    }
+    let content = await readFile(new URL(asset[0], root), 'utf8');
+    if (asset[0] === 'index.html') content = content.replace('{{SCRIPT_NONCE}}', nonce);
+    send(200, content, asset[1]);
+  } catch {
+    if (!res.headersSent) send(500, 'We couldn’t complete your request. Please try again later.');
+    else res.end();
+  }
+}
