diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..2d08ec4
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,47 @@
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#newsletter-status');
+const button = form.querySelector('button');
+let pending = false;
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (pending || !form.reportValidity()) return;
+
+  pending = true;
+  button.disabled = true;
+  button.textContent = 'Subscribing…';
+  form.setAttribute('aria-busy', 'true');
+  status.dataset.state = 'pending';
+  status.textContent = 'Sending your signup…';
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10000);
+
+  try {
+    const response = await fetch(form.action, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
+      body: new URLSearchParams({ email: form.elements.email.value.trim() }),
+      mode: 'same-origin',
+      credentials: 'same-origin',
+      redirect: 'error',
+      signal: controller.signal,
+    });
+    if (!response.ok) throw new Error('Signup failed');
+    const result = await response.json();
+    if (result.ok !== true) throw new Error('Signup failed');
+
+    status.dataset.state = 'success';
+    status.textContent = 'You’re subscribed! Thanks for joining the Daily Grind newsletter.';
+    form.reset();
+  } catch {
+    status.dataset.state = 'error';
+    status.textContent = 'We couldn’t send your signup. The request may be blocked or the connection unavailable. Please try again.';
+  } finally {
+    clearTimeout(timeout);
+    pending = false;
+    button.disabled = false;
+    button.textContent = 'Subscribe';
+    form.removeAttribute('aria-busy');
+  }
+});
