+import { createServer } from 'node:http';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const signupFile = resolve(process.env.NEWSLETTER_FILE || resolve(root, 'data/newsletter.jsonl'));
+const policy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+function reply(res, code, body, type = 'text/plain; charset=utf-8') {
+  res.writeHead(code, { 'Content-Type': type });
+  res.end(body);
+}
+
+async function signup(req, res) {
+  // Only the same origin may submit; no CORS headers are exposed.
+  if (req.headers['sec-fetch-site'] === 'cross-site') {
+    reply(res, 403, 'This request was blocked. Please return to the homepage and try again.');
+    return;
+  }
+  const type = (req.headers['content-type'] || '').split(';')[0].trim();
+  if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+    reply(res, 415, 'Unsupported request format. Please try again from the homepage.');
+    return;
+  }
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 4096) {
+      reply(res, 413, 'The signup request is too large. Please try again.');
+      return;
+    }
+    chunks.push(chunk);
+  }
+  let email;
+  try {
+    const body = Buffer.concat(chunks).toString('utf8');
+    email = type === 'application/json' ? JSON.parse(body).email : new URLSearchParams(body).get('email');
+  } catch {
+    reply(res, 400, 'Invalid signup request. Please try again.');
+    return;
+  }
+  if (typeof email !== 'string' || email.trim().length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email.trim())) {
+    reply(res, 400, 'Please enter a valid email address and try again.');
+    return;
+  }
+  await mkdir(dirname(signupFile), { recursive: true, mode: 0o700 });
+  await appendFile(signupFile, JSON.stringify({ email: email.trim(), subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+  if (type === 'application/json') {
+    reply(res, 201, JSON.stringify({ message: 'Thanks for signing up! You’re on the list.' }), 'application/json; charset=utf-8');
+  } else {
+    reply(res, 201, 'Thanks for signing up! You’re on the list.');
+  }
+}
+
+const server = createServer(async (req, res) => {
+  res.setHeader('Content-Security-Policy', policy);
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Cache-Control', 'no-store');
+  try {
+    const pathname = new URL(req.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        reply(res, 405, 'Please submit the signup form from the homepage.');
+        return;
+      }
+      await signup(req, res);
+      return;
+    }
+    const asset = assets.get(pathname);
+    if (!asset) {
+      reply(res, 404, 'Page not found.');
+      return;
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      reply(res, 405, 'Method not allowed.');
+      return;
+    }
+    const content = await readFile(resolve(root, asset[0]));
+    reply(res, 200, req.method === 'HEAD' ? undefined : content, asset[1]);
+  } catch {
+    reply(res, 500, 'We couldn’t complete your request. Please try again later.');
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..da07447
--- /dev/null
