+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const cards = [...document.querySelectorAll('.thumbnail')];
+    const motion = matchMedia('(prefers-reduced-motion: reduce)');
+    const stories = {
+      'maple-oat-latte': 'Our signature espresso meets silky steamed oat milk and Vermont maple syrup. Gently sweet and wonderfully cozy, it’s a little taste of the season in every sip.',
+      'dark-roast-espresso': 'A carefully roasted blend with deep cocoa notes and a lingering, smoky finish. Pulled fresh for a rich crema and a beautifully bold cup.',
+      'cold-brew': 'Good things take time. We steep our coffee in cool water for 18 hours, then serve it over ice for a mellow, refreshing cup with a naturally smooth finish.'
+    };
+    let current = null;
+    let activeTransition = null;
+    let request = 0;
+    let requestedCard = routeCard();
+    let listScroll = 0;
+
+    function routeCard() {
+      return cards.find(card => card.hash === location.hash) || null;
+    }
+
+    function render(card) {
+      if (card) {
+        hero.style.setProperty('--coffee-image', card.style.getPropertyValue('--coffee-image'));
+        hero.setAttribute('aria-label', card.querySelector('.title').textContent);
+        title.textContent = card.querySelector('.title').textContent;
+        document.querySelector('#detail-eyebrow').textContent = card.querySelector('.eyebrow').textContent;
+        document.querySelector('#detail-description').textContent = card.querySelector('.card-description').textContent;
+        document.querySelector('#detail-story').textContent = stories[card.dataset.coffee];
+      }
+      listPage.hidden = Boolean(card);
+      detailPage.hidden = !card;
+      current = card;
+      document.title = card ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function focusHeading() {
+      (current ? title : document.querySelector('#list-heading')).focus({ preventScroll: true });
+    }
+
+    async function navigate(card) {
+      if (card === requestedCard) return;
+      requestedCard = card;
+      const ticket = ++request;
+      if (activeTransition) {
+        activeTransition.skipTransition();
+        await activeTransition.finished.catch(() => {});
+      }
+      if (ticket !== request || card === current) return;
+      if (!current) listScroll = window.scrollY;
+      const sharedCard = card || current;
+      const elements = [sharedCard, sharedCard.querySelector('.title'), hero, title];
+      const clean = () => {
+        elements.forEach(element => element.style.removeProperty('view-transition-name'));
+        document.documentElement.classList.remove('is-transitioning');
+      };
+      const update = () => {
+        elements.forEach(element => element.style.removeProperty('view-transition-name'));
+        render(card);
+        const imageTarget = card ? hero : sharedCard;
+        const titleTarget = card ? title : sharedCard.querySelector('.title');
+        imageTarget.style.viewTransitionName = 'coffee-image';
+        titleTarget.style.viewTransitionName = 'coffee-title';
+        window.scrollTo({ top: card ? Math.max(0, detailPage.offsetTop - document.querySelector('nav').offsetHeight - 16) : listScroll, behavior: 'instant' });
+        focusHeading();
+      };
+      if (!document.startViewTransition || motion.matches) {
+        update();
+        clean();
+        return;
+      }
+      const imageSource = current ? hero : sharedCard;
+      const titleSource = current ? title : sharedCard.querySelector('.title');
+      imageSource.style.viewTransitionName = 'coffee-image';
+      titleSource.style.viewTransitionName = 'coffee-title';
+      document.documentElement.classList.add('is-transitioning');
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+      try {
+        await transition.finished;
+      } catch {
+        // A skipped snapshot still applies the navigation callback.
+        await transition.updateCallbackDone.catch(() => {});
+      } finally {
+        clean();
+        activeTransition = null;
+      }
+    }
+
+    cards.forEach(card => card.addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      history.pushState({ seasonalDetail: true }, '', card.hash);
+      navigate(card);
+    }));
+    document.querySelector('#back-link').addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      if (history.state?.seasonalDetail) history.back();
+      else {
+        history.pushState(null, '', location.pathname + location.search);
+        navigate(null);
+      }
+    });
+    window.addEventListener('popstate', () => navigate(routeCard()));
+    window.addEventListener('hashchange', () => navigate(routeCard()));
+    motion.addEventListener('change', () => {
+      if (motion.matches) activeTransition?.skipTransition();
+    });
+    history.scrollRestoration = 'manual';
+    render(routeCard());
+    if (current) focusHeading();
+  </script>
