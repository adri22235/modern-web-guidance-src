index 0000000..408689b
--- /dev/null
+++ b/browser-tools.js
@@ -0,0 +1,143 @@
+(() => {
+  // Read the same menu visitors see, so tool results and cards stay in sync.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map((card) => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const form = document.querySelector('#order-form');
+  const drinkSelect = document.querySelector('#order-drink');
+  const quantityInput = document.querySelector('#order-quantity');
+  const status = document.querySelector('#order-status');
+
+  for (const drink of menu) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    drinkSelect.append(option);
+  }
+
+  const drinkIds = menu.map((drink) => drink.id);
+  const drinkProperty = {
+    type: 'string', enum: drinkIds,
+    description: 'The seasonal drink to select.',
+  };
+  const invalidInput = (message) => ({ ok: false, error: message });
+  const isObject = (input) => input !== null && typeof input === 'object' && !Array.isArray(input);
+  const hasOnlyKeys = (input, keys) => isObject(input) && Object.keys(input).every((key) => keys.includes(key));
+
+  function highlightDrink(drinkId) {
+    for (const card of cards) {
+      card.dataset.selected = String(card.dataset.drinkId === drinkId);
+    }
+    drinkSelect.value = drinkId;
+  }
+
+  function selectDrink(input) {
+    if (!hasOnlyKeys(input, ['drinkId']) || !drinkIds.includes(input.drinkId)) {
+      return { ...invalidInput('Choose a drink from the seasonal menu.'), availableDrinkIds: drinkIds };
+    }
+    const drink = menu.find((item) => item.id === input.drinkId);
+    highlightDrink(drink.id);
+    status.textContent = `${drink.name} selected. Choose a quantity and place your demo order.`;
+    return { ok: true, selectedDrink: { ...drink } };
+  }
+
+  function orderDrink(input) {
+    if (!hasOnlyKeys(input, ['drinkId', 'quantity']) || !drinkIds.includes(input.drinkId)) {
+      return { ...invalidInput('Choose a drink from the seasonal menu.'), availableDrinkIds: drinkIds };
+    }
+    const quantity = input.quantity === undefined ? 1 : input.quantity;
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      return invalidInput('Quantity must be a whole number between 1 and 10.');
+    }
+    const drink = menu.find((item) => item.id === input.drinkId);
+    highlightDrink(drink.id);
+    quantityInput.value = String(quantity);
+    status.textContent = `Demo order ready: ${quantity} × ${drink.name}. No payment taken or order sent.`;
+    return { ok: true, order: { drinkId: drink.id, drinkName: drink.name, quantity, status: 'demo' } };
+  }
+
+  // Human controls and agents use the same validated actions.
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const result = orderDrink({ drinkId: drinkSelect.value, quantity: quantityInput.valueAsNumber });
+    if (!result.ok) status.textContent = result.error;
+  });
+  drinkSelect.addEventListener('change', () => selectDrink({ drinkId: drinkSelect.value }));
+  for (const button of document.querySelectorAll('[data-order-drink]')) {
+    button.addEventListener('click', () => {
+      selectDrink({ drinkId: button.dataset.orderDrink });
+      form.scrollIntoView({ block: 'center' });
+      drinkSelect.focus({ preventScroll: true });
+    });
+  }
+
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Daily Grind Seasonal Favorites menu to find drinks and their descriptions.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { query: { type: 'string', maxLength: 200, default: '', description: 'Words to match in a drink name or description.' } },
+      },
+      execute(input = {}) {
+        if (!hasOnlyKeys(input, ['query'])) return invalidInput('Provide an object with an optional query.');
+        const query = input.query === undefined ? '' : input.query;
+        if (typeof query !== 'string' || query.length > 200) return invalidInput('Query must be text of at most 200 characters.');
+        const matches = menu.filter((drink) => `${drink.name} ${drink.description}`.toLowerCase().includes(query.trim().toLowerCase()));
+        return { ok: true, category: 'Seasonal Favorites', drinks: matches.map((drink) => ({ ...drink })) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'select_drink',
+      description: 'Highlight a seasonal drink on the page and select it in the order form.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { drinkId: drinkProperty }, required: ['drinkId'],
+      },
+      execute: selectDrink,
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'order_drink',
+      description: 'Create a demo drink order and display its summary on the homepage. Replaces the previous demo order; no payment or café submission occurs.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          drinkId: drinkProperty,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to prepare in the demo order.' },
+        },
+        required: ['drinkId'],
+      },
+      execute: orderDrink,
+      annotations: { readOnlyHint: false, consequentialHint: false },
+    },
+  ];
+
+  // Unsupported browsers retain all ordinary controls. Never overwrite a native API.
+  let registration;
+  async function registerTools() {
+    if (!document.modelContext?.registerTool || registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of tools) {
+        await document.modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      if (registration === controller) registration = undefined;
+      console.warn('Daily Grind browser tools could not be registered.', error);
+    }
+  }
+  window.addEventListener('pagehide', () => {
+    registration?.abort();
+    registration = undefined;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
