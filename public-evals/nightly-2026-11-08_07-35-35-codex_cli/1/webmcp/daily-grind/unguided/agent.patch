new file mode 100644
index 0000000..ac6fecf
--- /dev/null
+++ b/browser-tools.js
@@ -0,0 +1,133 @@
+(() => {
+  'use strict';
+
+  // Read the displayed menu so agent responses stay aligned with the page.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const dialog = document.querySelector('#order-dialog');
+  const form = document.querySelector('#order-form');
+  const drinkInput = document.querySelector('#order-drink');
+  const quantityInput = document.querySelector('#order-quantity');
+  const status = document.querySelector('#order-status');
+  let orderCount = 0;
+
+  for (const drink of menu) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    drinkInput.append(option);
+  }
+
+  function validateInput(input, allowedKeys) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      throw new Error('Input must be an object.');
+    }
+    if (Object.keys(input).some(key => !allowedKeys.includes(key))) {
+      throw new Error('Unknown input property.');
+    }
+  }
+
+  function findDrink(id) {
+    const drink = menu.find(item => item.id === id);
+    if (!drink) throw new Error(`Unknown drink. Use one of: ${menu.map(item => item.id).join(', ')}.`);
+    return drink;
+  }
+
+  function openOrder(id, quantity = 1) {
+    const drink = findDrink(id);
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      throw new Error('Quantity must be an integer between 1 and 10.');
+    }
+    drinkInput.value = drink.id;
+    quantityInput.value = String(quantity);
+    if (!dialog.open) dialog.showModal();
+    drinkInput.focus();
+    return { status: 'awaiting_confirmation', drink, quantity,
+      message: 'Order dialog opened. The user can edit and add this local order. No payment or café submission is made.' };
+  }
+
+  document.querySelector('#order-now').addEventListener('click', () => openOrder(menu[0].id));
+  document.querySelectorAll('[data-order-drink]').forEach(button => {
+    button.addEventListener('click', () => openOrder(button.dataset.orderDrink));
+  });
+  document.querySelector('#cancel-order').addEventListener('click', () => dialog.close());
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    if (!form.reportValidity()) return;
+    const drink = findDrink(drinkInput.value);
+    const quantity = Number(quantityInput.value);
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) return;
+    orderCount += 1;
+    status.textContent = `Order #${orderCount} added on this page: ${quantity} × ${drink.name}. No payment or café submission was made.`;
+    dialog.close();
+  });
+
+  const drinkIdSchema = { type: 'string', enum: menu.map(drink => drink.id), description: 'Seasonal drink ID returned by get_seasonal_menu.' };
+  const result = data => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+  const safeExecute = action => async (input = {}) => {
+    try {
+      return result(action(input));
+    } catch (error) {
+      return { ...result({ error: error.message }), isError: true };
+    }
+  };
+
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Daily Grind Seasonal Favorites menu. Returns drink IDs, names, descriptions, and detail links. Optionally filter by name or description.',
+      inputSchema: { type: 'object', properties: { query: { type: 'string', description: 'Case-insensitive text to search for. Omit to list all seasonal drinks.' } }, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: safeExecute(input => {
+        validateInput(input, ['query']);
+        if (input.query !== undefined && typeof input.query !== 'string') throw new Error('Query must be a string.');
+        const query = (input.query ?? '').trim().toLowerCase();
+        return { section: 'Seasonal Favorites', drinks: menu.filter(drink => `${drink.name} ${drink.description}`.toLowerCase().includes(query)) };
+      }),
+    },
+    {
+      name: 'order_drink',
+      description: 'Open the interactive order dialog for a seasonal drink and quantity. Returns awaiting_confirmation; the user can edit, add, or cancel the local order. Does not charge or submit to a café.',
+      inputSchema: { type: 'object', properties: { drink_id: drinkIdSchema, quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1 } }, required: ['drink_id'], additionalProperties: false },
+      execute: safeExecute(input => {
+        validateInput(input, ['drink_id', 'quantity']);
+        return openOrder(input.drink_id, input.quantity === undefined ? 1 : input.quantity);
+      }),
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight a seasonal drink card and scroll it into view. Set highlighted to false to clear that drink’s highlight.',
+      inputSchema: { type: 'object', properties: { drink_id: drinkIdSchema, highlighted: { type: 'boolean', default: true } }, required: ['drink_id'], additionalProperties: false },
+      execute: safeExecute(input => {
+        validateInput(input, ['drink_id', 'highlighted']);
+        const drink = findDrink(input.drink_id);
+        const highlighted = input.highlighted === undefined ? true : input.highlighted;
+        if (typeof highlighted !== 'boolean') throw new Error('Highlighted must be a boolean.');
+        const card = cards.find(item => item.dataset.drinkId === drink.id);
+        card.dataset.highlighted = String(highlighted);
+        if (highlighted) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        return { drink_id: drink.id, highlighted };
+      }),
+    },
+  ];
+
+  // Prefer the standard surface; retain compatibility with early WebMCP browsers.
+  const modelContext = typeof document.modelContext?.registerTool === 'function'
+    ? document.modelContext : navigator.modelContext;
+  if (typeof modelContext?.registerTool === 'function') {
+    for (const tool of tools) {
+      try {
+        Promise.resolve(modelContext.registerTool(tool)).catch(error => {
+          console.warn(`Could not register Daily Grind tool ${tool.name}:`, error);
+        });
+      } catch (error) {
+        console.warn(`Could not register Daily Grind tool ${tool.name}:`, error);
+      }
+    }
+  }
+})();
