diff --git a/tests/browser-tools.test.cjs b/tests/browser-tools.test.cjs
new file mode 100644
index 0000000..20d00ed
--- /dev/null
+++ b/tests/browser-tools.test.cjs
@@ -0,0 +1,100 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const source = readFileSync(new URL('../browser-tools.js', `file://${__filename}`), 'utf8');
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+
+function setup(surface = 'document') {
+  const element = () => ({
+    dataset: {}, value: '', listeners: {}, children: [],
+    addEventListener(name, handler) { this.listeners[name] = handler; },
+    append(child) { this.children.push(child); },
+    focus() {}, scrollIntoView() { this.scrolled = true; },
+    showModal() { this.open = true; }, close() { this.open = false; },
+    reportValidity() { return true; },
+  });
+  // Use the real HTML as the menu fixture, including any future copy changes.
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)">\s*<h3>([^<]+)<\/h3>\s*<p>([^<]+)<\/p>\s*<a href="([^"]+)"/g)].map(match => {
+    const card = element();
+    card.dataset.drinkId = match[1];
+    card.querySelector = selector => ({ textContent: selector === 'h3' ? match[2] : match[3], getAttribute: () => match[4] });
+    return card;
+  });
+  assert.equal(cards.length, 3);
+  const ids = ['order-dialog', 'order-form', 'order-drink', 'order-quantity', 'order-status', 'order-now', 'cancel-order'];
+  const elements = Object.fromEntries(ids.map(id => [`#${id}`, element()]));
+  const buttons = cards.map(card => Object.assign(element(), { dataset: { orderDrink: card.dataset.drinkId } }));
+  const registered = new Map();
+  const context = { registerTool(tool) { registered.set(tool.name, tool); } };
+  const document = {
+    querySelector: selector => elements[selector],
+    querySelectorAll: selector => selector === '[data-drink-id]' ? cards : buttons,
+    createElement: element,
+  };
+  const navigator = {};
+  if (surface === 'document') document.modelContext = context;
+  if (surface === 'navigator') navigator.modelContext = context;
+  vm.runInNewContext(source, { document, navigator, console });
+  const call = async (name, input) => {
+    const response = await registered.get(name).execute(input);
+    return { ...response, data: JSON.parse(response.content[0].text) };
+  };
+  return { registered, call, elements, cards, buttons };
+}
+
+test('registers discoverable tools on current and legacy APIs; works without WebMCP', () => {
+  for (const surface of ['document', 'navigator']) {
+    const app = setup(surface);
+    assert.equal(app.registered.size, 3);
+    for (const tool of app.registered.values()) {
+      assert.ok(tool.description);
+      assert.equal(tool.inputSchema.type, 'object');
+    }
+  }
+  const app = setup('unsupported');
+  app.buttons[0].listeners.click();
+  assert.equal(app.elements['#order-dialog'].open, true);
+});
+
+test('menu queries reflect visible content and reject malformed inputs', async () => {
+  const { call } = setup();
+  assert.equal((await call('get_seasonal_menu')).data.drinks.length, 3);
+  assert.equal((await call('get_seasonal_menu', { query: 'MAPLE' })).data.drinks[0].id, 'maple-oat-latte');
+  assert.equal((await call('get_seasonal_menu', { query: 'absent' })).data.drinks.length, 0);
+  assert.equal((await call('get_seasonal_menu', { query: 42 })).isError, true);
+  assert.equal((await call('get_seasonal_menu', { unexpected: true })).isError, true);
+});
+
+test('orders open a prefilled dialog, require confirmation, and allow cancellation', async () => {
+  const { call, elements } = setup();
+  const response = await call('order_drink', { drink_id: 'cold-brew', quantity: 2 });
+  assert.equal(response.data.status, 'awaiting_confirmation');
+  assert.equal(elements['#order-dialog'].open, true);
+  assert.equal(elements['#order-drink'].value, 'cold-brew');
+  assert.equal(elements['#order-quantity'].value, '2');
+  assert.equal(elements['#order-status'].textContent, undefined);
+  elements['#cancel-order'].listeners.click();
+  assert.equal(elements['#order-dialog'].open, false);
+  await call('order_drink', { drink_id: 'cold-brew' });
+  assert.equal(elements['#order-quantity'].value, '1');
+  elements['#order-form'].listeners.submit({ preventDefault() {} });
+  assert.match(elements['#order-status'].textContent, /1 × Cold Brew/);
+  assert.equal(elements['#order-dialog'].open, false);
+});
+
+test('invalid orders and UI updates return errors without changing the page', async () => {
+  const { call, elements, cards } = setup();
+  for (const input of [{ drink_id: 'missing' }, { drink_id: 'cold-brew', quantity: 0 }, { drink_id: 'cold-brew', quantity: 1.5 }, { drink_id: 'cold-brew', quantity: '2' }, { drink_id: 'cold-brew', quantity: null }]) {
+    assert.equal((await call('order_drink', input)).isError, true);
+  }
+  assert.equal(elements['#order-dialog'].open, undefined);
+  assert.equal((await call('highlight_drink', { drink_id: 'cold-brew' })).data.highlighted, true);
+  assert.equal(cards[2].dataset.highlighted, 'true');
+  assert.equal(cards[2].scrolled, true);
+  await call('highlight_drink', { drink_id: 'cold-brew', highlighted: false });
+  assert.equal(cards[2].dataset.highlighted, 'false');
+  assert.equal((await call('highlight_drink', { drink_id: 'cold-brew', highlighted: 'yes' })).isError, true);
+  assert.equal(cards[2].dataset.highlighted, 'false');
+});
