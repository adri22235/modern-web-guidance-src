--- /dev/null
+++ b/src/scripts/browser-tools.ts
@@ -0,0 +1,10 @@
+import { registerArticleTools, type ModelContext } from '../utils/browser-tools';
+
+// Support both the current API and early navigator-based implementations.
+const context = (document as Document & { modelContext?: ModelContext }).modelContext
+  ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+
+registerArticleTools(context, import.meta.env.BASE_URL)
+  .catch(error => console.warn('Article tools could not be registered:', error));
+// Astro's ClientRouter preserves the document and this module's registrations.
+// The tools read live session data and do not retain references to swapped DOM.
diff --git a/src/utils/article-client.ts b/src/utils/article-client.ts
new file mode 100644
index 0000000..adac43d
--- /dev/null
+++ b/src/utils/article-client.ts
@@ -0,0 +1,46 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJSON<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, init);
+  if (!response.ok) throw new Error(`Request failed (${response.status})`);
+  return response.json();
+}
+
+export function filterArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    `${article.title}\n${article.summary}`.toLowerCase().includes(term)) : [];
+}
+
+export async function getReadingList(base: string): Promise<string[]> {
+  const data = await requestJSON<{ readingList: string[] }>(`${base}api/reading-list.json`);
+  return data.readingList;
+}
+
+export function notifyReadingList(readingList: string[]) {
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: readingList }));
+}
+
+export async function toggleBookmark(base: string, slug: string) {
+  const data = await requestJSON<{ readingList: string[] }>(`${base}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  notifyReadingList(data.readingList);
+  return data.readingList;
+}
+
+// React's synthetic submit event wraps the browser's WebMCP SubmitEvent.
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submit = event as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  };
+  if (submit.agentInvoked && submit.respondWith) submit.respondWith(result);
+}
diff --git a/src/utils/browser-tools.ts b/src/utils/browser-tools.ts
new file mode 100644
index 0000000..ba25e78
--- /dev/null
+++ b/src/utils/browser-tools.ts
@@ -0,0 +1,96 @@
+import { filterArticles, getReadingList, requestJSON, toggleBookmark } from './article-client.ts';
+import type { Article } from './article-client.ts';
+
+type Input = Record<string, unknown>;
+export interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint: boolean };
+  execute: (input: Input) => Promise<unknown>;
+}
+export interface ModelContext {
+  registerTool: (tool: BrowserTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+function requiredString(input: Input, name: string) {
+  const value = input[name];
+  if (typeof value !== 'string' || !value.trim()) throw new Error(`${name} must be a nonempty string`);
+  return value.trim();
+}
+
+export function createArticleTools(base: string): BrowserTool[] {
+  const articles = () => requestJSON<Article[]>(`${base}api/articles.json`);
+  const withURL = (article: Article) => ({ ...article, url: `${base}articles/${encodeURIComponent(article.slug)}` });
+  const schema = (properties: Record<string, unknown>, required: string[] = []) => ({
+    type: 'object', properties, required, additionalProperties: false,
+  });
+  const slug = { type: 'string', description: 'Article slug returned by find_articles.' };
+  return [
+    {
+      name: 'find_articles',
+      description: 'Find DevTools Times articles by title or summary. Returns article details and links.',
+      inputSchema: schema({ query: { type: 'string', minLength: 1 } }, ['query']),
+      annotations: { readOnlyHint: true },
+      execute: async input => filterArticles(await articles(), requiredString(input, 'query')).map(withURL),
+    },
+    {
+      name: 'get_article',
+      description: 'Look up an article title, summary, image and link by its slug.',
+      inputSchema: schema({ slug }, ['slug']),
+      annotations: { readOnlyHint: true },
+      execute: async input => {
+        const id = requiredString(input, 'slug');
+        const article = (await articles()).find(article => article.slug === id);
+        if (!article) throw new Error('Article not found');
+        return withURL(article);
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Get the articles saved to the current browser session reading list.',
+      inputSchema: schema({}),
+      annotations: { readOnlyHint: true },
+      execute: async () => {
+        const [all, saved] = await Promise.all([articles(), getReadingList(base)]);
+        return all.filter(article => saved.includes(article.slug)).map(withURL);
+      },
+    },
+    {
+      name: 'set_article_saved',
+      description: 'Save an article to or remove it from the current session reading list. Repeating the same request preserves the desired state.',
+      inputSchema: schema({ slug, saved: { type: 'boolean' } }, ['slug', 'saved']),
+      annotations: { readOnlyHint: false },
+      execute: async input => {
+        const id = requiredString(input, 'slug');
+        if (typeof input.saved !== 'boolean') throw new Error('saved must be a boolean');
+        if (!(await articles()).some(article => article.slug === id)) throw new Error('Article not found');
+        const current = await getReadingList(base);
+        const readingList = current.includes(id) === input.saved ? current : await toggleBookmark(base, id);
+        return { slug: id, saved: readingList.includes(id), readingList };
+      },
+    },
+  ];
+}
+
+// Register once per document, rather than once per hydrated React island.
+export async function registerArticleTools(context: ModelContext | undefined, base: string) {
+  if (!context) return () => {};
+  const controller = new AbortController();
+  const registered: string[] = [];
+  const cleanup = () => {
+    controller.abort();
+    for (const name of registered) context.unregisterTool?.(name);
+  };
+  try {
+    for (const tool of createArticleTools(base)) {
+      await context.registerTool(tool, { signal: controller.signal });
+      registered.push(tool.name);
+    }
+  } catch (error) {
+    cleanup();
+    throw error;
+  }
+  return cleanup;
+}
diff --git a/tests/browser-tools.test.mjs b/tests/browser-tools.test.mjs
new file mode 100644
index 0000000..9c0a3e6
--- /dev/null
+++ b/tests/browser-tools.test.mjs
@@ -0,0 +1,107 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { createArticleTools, registerArticleTools } from '../src/utils/browser-tools.ts';
+import { respondToAgent } from '../src/utils/article-client.ts';
+
+const originalFetch = globalThis.fetch;
+const originalWindow = globalThis.window;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  globalThis.window = originalWindow;
+});
+const articles = [{ slug: 'coffee', title: 'Coffee Alchemy', summary: 'Roasting science' }];
+const tool = name => createArticleTools('/devtools-times/').find(tool => tool.name === name);
+
+test('search and article lookup use the configured base and validate input', async () => {
+  globalThis.fetch = async url => {
+    assert.equal(url, '/devtools-times/api/articles.json');
+    return Response.json(articles);
+  };
+  const found = await tool('find_articles').execute({ query: ' SCIENCE ' });
+  assert.equal(found[0].url, '/devtools-times/articles/coffee');
+  assert.deepEqual(await tool('find_articles').execute({ query: 'missing' }), []);
+  assert.equal((await tool('get_article').execute({ slug: 'coffee' })).title, 'Coffee Alchemy');
+  await assert.rejects(tool('get_article').execute({ slug: 'unknown' }), /not found/);
+  await assert.rejects(tool('find_articles').execute({ query: ' ' }), /nonempty/);
+});
+
+test('save and remove preserve desired state and notify UI only on change', async () => {
+  let saved = [];
+  let writes = 0;
+  let notifications = 0;
+  globalThis.window = { dispatchEvent(event) {
+    assert.equal(event.type, 'reading-list-changed');
+    notifications++;
+  } };
+  globalThis.fetch = async (url, init) => {
+    if (url.endsWith('articles.json')) return Response.json(articles);
+    assert.equal(url, '/devtools-times/api/reading-list.json');
+    if (init?.method === 'POST') {
+      const { slug } = JSON.parse(init.body);
+      saved = saved.includes(slug) ? saved.filter(id => id !== slug) : [...saved, slug];
+      writes++;
+    }
+    return Response.json({ readingList: saved });
+  };
+  const save = tool('set_article_saved');
+  await save.execute({ slug: 'coffee', saved: true });
+  await save.execute({ slug: 'coffee', saved: true });
+  assert.equal((await tool('get_reading_list').execute({}))[0].slug, 'coffee');
+  await save.execute({ slug: 'coffee', saved: false });
+  await save.execute({ slug: 'coffee', saved: false });
+  assert.equal(writes, 2);
+  assert.equal(notifications, 2);
+  assert.deepEqual(saved, []);
+  await assert.rejects(save.execute({ slug: 'unknown', saved: true }), /not found/);
+  await assert.rejects(save.execute({ slug: 'coffee', saved: 'false' }), /boolean/);
+  assert.equal(writes, 2);
+});
+
+test('failed HTTP requests reject instead of returning success', async () => {
+  globalThis.fetch = async () => new Response('unavailable', { status: 503 });
+  await assert.rejects(tool('get_reading_list').execute({}), /503/);
+});
+
+test('registration handles unsupported browsers and cleans up partial failures', async () => {
+  const noop = await registerArticleTools(undefined, '/');
+  noop();
+  const registered = [];
+  const removed = [];
+  let signal;
+  await assert.rejects(registerArticleTools({
+    registerTool(tool, options) {
+      signal = options.signal;
+      if (registered.length === 2) throw new Error('registration failed');
+      registered.push(tool.name);
+    },
+    unregisterTool(name) { removed.push(name); },
+  }, '/'), /registration failed/);
+  assert.deepEqual(removed, registered);
+  assert.equal(signal.aborted, true);
+});
+
+test('form responses are handed to WebMCP only for agent submissions', async () => {
+  let result;
+  respondToAgent({ agentInvoked: true, respondWith(value) { result = value; } }, Promise.resolve({ matches: articles }));
+  assert.deepEqual(await result, { matches: articles });
+  respondToAgent({}, Promise.resolve([]));
+});
+
+test('successful registration exposes all tools and releases only its own registrations', async () => {
+  const names = [];
+  const removed = [];
+  const signals = [];
+  const cleanup = await registerArticleTools({
+    registerTool(tool, options) {
+      names.push(tool.name);
+      signals.push(options.signal);
+      assert.equal(tool.inputSchema.additionalProperties, false);
+    },
+    unregisterTool(name) { removed.push(name); },
+  }, '/devtools-times/');
+  assert.deepEqual(names, ['find_articles', 'get_article', 'get_reading_list', 'set_article_saved']);
+  assert.equal(signals.every(signal => !signal.aborted), true);
+  cleanup();
+  assert.deepEqual(removed, names);
+  assert.equal(signals.every(signal => signal.aborted), true);
+});
