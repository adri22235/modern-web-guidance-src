diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..2eec2c3
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,38 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJSON<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please retry.`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) => requestJSON<Article[]>('articles.json', { signal });
+export const getReadingList = (signal?: AbortSignal) => requestJSON<{ readingList: string[] }>('reading-list.json', { signal });
+export async function toggleReadingList(slug: string, signal?: AbortSignal) {
+  const data = await requestJSON<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: data.readingList }));
+  return data;
+}
+
+// React wraps the browser SubmitEvent; read WebMCP extensions from nativeEvent.
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as SubmitEvent & { agentInvoked?: boolean; respondWith?: (result: Promise<string>) => void };
+  if (submission.agentInvoked && submission.respondWith) {
+    submission.respondWith(result.then(value => JSON.stringify(value)));
+  }
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article => `${article.title} ${article.summary}`.toLowerCase().includes(term)) : [];
+}
