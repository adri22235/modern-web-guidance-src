@@ -0,0 +1,65 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { getArticles, getReadingList } from '../lib/articles';
+
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false } as const;
+
+export default function ArticleTools() {
+  useWebMCP({
+    name: 'list_articles',
+    description: 'List article titles, summaries, and slugs in The DevTools Times to choose an article to read.',
+    inputSchema: emptySchema,
+    async execute(_input, { signal }) {
+      try { return { articles: await getArticles(signal) }; }
+      catch (error) {
+        if (signal.aborted) throw error;
+        return { error: String(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_article',
+    description: 'Read the full text and metadata of a DevTools Times article.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', minLength: 1, description: 'Article slug returned by search or list_articles.' } },
+      required: ['slug'],
+      additionalProperties: false,
+    } as const,
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) return { error: 'Provide an article slug.' };
+      try {
+        const article = (await getArticles(signal)).find(article => article.slug === slug);
+        if (!article) return { error: 'Article not found. Use list_articles to find a valid slug.' };
+        const url = new URL(`${import.meta.env.BASE_URL}articles/${slug}`, location.origin);
+        const response = await fetch(url, { signal });
+        if (!response.ok) return { error: `Article request failed (${response.status}). Please retry.` };
+        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
+        signal.throwIfAborted();
+        const body = page.querySelector('[data-article-body]');
+        if (!body) return { error: 'Article text unavailable. Please retry.' };
+        return { ...article, url: url.href, text: body.textContent?.trim() };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: String(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_reading_list',
+    description: 'Read the articles saved in the current session’s reading list.',
+    inputSchema: emptySchema,
+    async execute(_input, { signal }) {
+      try {
+        const [articles, { readingList }] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+        return { articles: articles.filter(article => readingList.includes(article.slug)) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: String(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  return null;
+}
