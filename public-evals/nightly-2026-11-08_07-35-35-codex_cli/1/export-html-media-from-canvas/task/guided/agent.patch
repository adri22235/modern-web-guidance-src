+  <script src="vendor/html2canvas.min.js"></script>
+  <script>
+    (() => {
+      const canvas = document.getElementById('gift-canvas');
+      const card = document.getElementById('export_element');
+      const context = canvas.getContext('2d');
+      const name = document.getElementById('gift-name');
+      const message = document.getElementById('gift-message');
+      const color = document.getElementById('gift-color');
+      const button = document.getElementById('export-gift');
+      const status = document.getElementById('gift-status');
+      const swatches = document.querySelectorAll('input[name="card-color"]');
+      const nativeRendering = 'content' in HTMLCanvasElement.prototype &&
+        typeof context?.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+      let rendering;
+      let dirty = false;
+      let ready = false;
+
+      if (!nativeRendering) {
+        const staging = document.createElement('div');
+        staging.className = 'gift-source-staging';
+        staging.setAttribute('aria-hidden', 'true');
+        document.body.append(staging);
+        staging.append(card);
+      }
+
+      function updateCard() {
+        document.getElementById('card-recipient').textContent = name.value.trim() ? `For ${name.value.trim()}` : 'For someone special';
+        document.getElementById('card-message').textContent = message.value.trim() || 'A little pick-me-up, just for you.';
+        card.style.backgroundColor = color.value;
+        // Use relative luminance to keep text readable on any custom color.
+        const rgb = color.value.match(/[a-f\d]{2}/gi).map(value => {
+          const channel = parseInt(value, 16) / 255;
+          return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
+        });
+        card.style.color = rgb[0] * 0.2126 + rgb[1] * 0.7152 + rgb[2] * 0.0722 > 0.179 ? '#241b16' : '#ffffff';
+        // Fit even long unbroken names and messages within the card.
+        const text = document.getElementById('card-message');
+        let size = 28;
+        text.style.fontSize = `${size}px`;
+        while (text.offsetTop + text.offsetHeight > 292 && size > 16) {
+          text.style.fontSize = `${--size}px`;
+        }
+        canvas.setAttribute('aria-label', `Gift card. ${document.getElementById('card-recipient').textContent}. ${text.textContent}`);
+      }
+
+      function paintNative() {
+        return new Promise((resolve, reject) => {
+          const timeout = setTimeout(() => reject(new Error('Preview timed out')), 5000);
+          canvas.onpaint = () => {
+            try {
+              context.setTransform(canvas.width / 600, 0, 0, canvas.height / 360, 0, 0);
+              context.clearRect(0, 0, 600, 360);
+              context.drawElementImage(card, 0, 0);
+              clearTimeout(timeout);
+              resolve();
+            } catch (error) { clearTimeout(timeout); reject(error); }
+          };
+          canvas.requestPaint();
+        });
+      }
+
+      function render() {
+        dirty = true;
+        if (rendering) return rendering;
+        rendering = (async () => {
+          try {
+            await document.fonts.ready;
+            do {
+              dirty = false;
+              updateCard();
+              if (!context) throw new Error('Canvas unavailable');
+              if (nativeRendering) {
+                await paintNative();
+              } else {
+                const snapshot = await html2canvas(card, {
+                  backgroundColor: null, scale: 2, width: 600, height: 360, logging: false
+                });
+                context.setTransform(1, 0, 0, 1, 0, 0);
+                context.clearRect(0, 0, canvas.width, canvas.height);
+                context.drawImage(snapshot, 0, 0, canvas.width, canvas.height);
+              }
+            } while (dirty);
+            ready = true;
+            button.disabled = false;
+            status.textContent = '';
+          } catch (error) {
+            ready = false;
+            button.disabled = true;
+            status.textContent = 'The preview could not be rendered. Edit your design to retry, or reload the page.';
+          } finally { rendering = null; }
+        })();
+        return rendering;
+      }
+
+      [name, message, color].forEach(input => input.addEventListener('input', () => {
+        if (input === color) swatches.forEach(swatch => { swatch.checked = swatch.value === color.value; });
+        render();
+      }));
+      swatches.forEach(swatch => swatch.addEventListener('change', () => {
+        color.value = swatch.value;
+        render();
+      }));
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        button.textContent = 'Preparing image…';
+        try {
+          await render();
+          if (!ready) return;
+          const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Image unavailable');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.download = 'daily-grind-gift-card.png';
+          link.href = url;
+          document.body.append(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 10000);
+          status.textContent = 'Your gift card image is ready. Enjoy sharing a little coffee love!';
+        } catch (error) {
+          status.textContent = 'The image could not be exported. Please try again.';
+        } finally {
+          button.disabled = !ready;
+          button.textContent = 'Export gift card ↓';
+        }
+      });
+
+      new ResizeObserver(() => {
+        const scale = Math.max(2, window.devicePixelRatio || 1);
+        const width = Math.max(1200, Math.round(canvas.clientWidth * scale));
+        if (canvas.width !== width) {
+          canvas.width = width;
+          canvas.height = Math.round(width * 3 / 5);
+        }
+        render();
+      }).observe(canvas);
+      render();
+    })();
+  </script>
 </body>
 
