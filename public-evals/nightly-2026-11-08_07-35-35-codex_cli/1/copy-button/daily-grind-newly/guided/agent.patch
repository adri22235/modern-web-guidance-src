+  <script>
+    const copyTimers = new WeakMap();
+    let lastCopyMessage = '';
+
+    function reportCopy(button, succeeded) {
+      const status = button.nextElementSibling;
+      clearTimeout(copyTimers.get(button));
+      let message = succeeded ? 'Copied!' : 'Copy failed. Please try again or copy the description manually.';
+      if (message === lastCopyMessage) message += '\u00a0';
+      lastCopyMessage = message;
+      status.textContent = message;
+      copyTimers.set(button, setTimeout(() => {
+        status.textContent = '';
+      }, succeeded ? 2500 : 6000));
+    }
+
+    async function copyDescription(button, target) {
+      try {
+        await navigator.clipboard.writeText(target.innerText.trim());
+        reportCopy(button, true);
+      } catch {
+        reportCopy(button, false);
+      }
+    }
+
+    // Command events do not bubble; capture them at the document instead.
+    document.addEventListener('command', (event) => {
+      if (event.command === '--copy' && event.source.matches('.copy-button')) {
+        copyDescription(event.source, event.target);
+      }
+    }, true);
+  </script>
+
