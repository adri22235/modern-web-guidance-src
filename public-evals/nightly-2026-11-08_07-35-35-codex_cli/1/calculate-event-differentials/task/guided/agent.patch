+  <script type="module">
+    const remainingOutput = document.getElementById('promotion-remaining');
+    const elapsedOutput = document.getElementById('promotion-elapsed');
+
+    try {
+      // Load only when needed; Temporal is not available in every browser yet.
+      const temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+      const now = temporal.Now.zonedDateTimeISO();
+      // The promotion start is assumed to be January 1; both endpoints are
+      // wall-clock midnights in the visitor's current system time zone.
+      const start = temporal.PlainDate.from('2026-01-01')
+        .toZonedDateTime({ timeZone: now.timeZoneId, plainTime: '00:00' });
+      const end = temporal.PlainDate.from('2026-03-01')
+        .toZonedDateTime({ timeZone: now.timeZoneId, plainTime: '00:00' });
+      const options = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+      const zero = temporal.Duration.from({ days: 0, hours: 0 });
+      const ended = temporal.ZonedDateTime.compare(now, end) >= 0;
+      const notStarted = temporal.ZonedDateTime.compare(now, start) < 0;
+      const remaining = ended ? zero : now.until(end, options);
+      const elapsed = notStarted ? zero : now.since(start, options);
+      const formatter = typeof Intl.DurationFormat === 'function'
+        ? new Intl.DurationFormat(undefined, {
+            style: 'long', days: 'long', hours: 'long',
+            daysDisplay: 'always', hoursDisplay: 'always'
+          })
+        : null;
+      const format = (duration) => formatter
+        ? formatter.format({ days: duration.days, hours: duration.hours })
+        : `${duration.days} ${duration.days === 1 ? 'day' : 'days'}, ${duration.hours} ${duration.hours === 1 ? 'hour' : 'hours'}`;
+
+      remainingOutput.textContent = `${ended ? 'Offer ended · ' : notStarted ? 'Coming soon · ' : ''}${format(remaining)} left`;
+      elapsedOutput.textContent = `${format(elapsed)} elapsed since promotion start${notStarted ? ' (not started yet)' : ''}.`;
+    } catch (error) {
+      remainingOutput.textContent = 'Countdown unavailable. See offer dates below.';
+    }
+  </script>
+
