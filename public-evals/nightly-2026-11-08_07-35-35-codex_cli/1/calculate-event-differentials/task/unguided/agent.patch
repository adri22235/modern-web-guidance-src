+  <script>
+    // Component arguments create dates in the visitor's local time zone.
+    // No start date was supplied; assume January 1, 2026 at local midnight.
+    const promotionStart = new Date(2026, 0, 1, 0, 0, 0);
+    const promotionEnd = new Date(2026, 2, 1, 0, 0, 0);
+    const now = Date.now();
+    const hourInMilliseconds = 60 * 60 * 1000;
+
+    function formatDuration(milliseconds) {
+      const totalHours = Math.floor(Math.max(0, milliseconds) / hourInMilliseconds);
+      const days = Math.floor(totalHours / 24);
+      const hours = totalHours % 24;
+      return `${days} ${days === 1 ? 'day' : 'days'} ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+    }
+
+    const remaining = formatDuration(promotionEnd - now);
+    document.getElementById('promotion-remaining').textContent = now >= promotionEnd
+      ? `Offer ended · ${remaining} remaining`
+      : now < promotionStart
+        ? `Promotion starts in ${formatDuration(promotionStart - now)}`
+        : `${remaining} remaining`;
+    document.getElementById('promotion-elapsed').textContent =
+      `${formatDuration(now - promotionStart)} elapsed since promotion start.`;
+  </script>
