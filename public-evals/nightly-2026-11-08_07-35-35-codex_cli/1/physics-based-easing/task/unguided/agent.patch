@@ -114,8 +114,55 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    .card.spring {
+      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+      transition-timing-function: linear(
+        0, 0.45 12%, 0.9 25%, 1.16 40%, 1.08 55%,
+        0.97 70%, 1.02 85%, 1
+      );
+    }
+
+    .card.bounce {
+      transition: transform 0.75s ease-out;
+      transition-timing-function: linear(
+        0, 0.06 9%, 0.25 18%, 0.56 27%, 1 36%,
+        0.81 45%, 0.75 54%, 0.81 63%, 1 72%,
+        0.94 81%, 1 90%, 0.98 95%, 1
+      );
+    }
+
+    .card.spring:focus-within {
+      transform: scale(1.04);
+    }
+
+    .card.bounce:focus-within {
+      transform: translateY(-8px);
+    }
+
+    @media (hover: hover) {
+      .card.spring:hover {
+        transform: scale(1.04);
+      }
+
+      .card.bounce:hover {
+        transform: translateY(-8px);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+      }
+
+      .card.spring:is(:hover, :focus-within),
+      .card.bounce:is(:hover, :focus-within) {
+        transform: none;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
