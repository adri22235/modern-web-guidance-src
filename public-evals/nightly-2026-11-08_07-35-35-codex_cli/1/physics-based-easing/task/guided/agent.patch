       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Keep the cards still unless the user allows motion. */
+    @media (prefers-reduced-motion: no-preference) {
+      .card.spring {
+        /* Overshoot, recoil, and settle at the target scale. */
+        --spring-easing: linear(
+          0, 0.12 4%, 0.39 8%, 0.7 12%, 0.95 16%,
+          1.12 20%, 1.2 24%, 1.21 28%, 1.16 32%, 1.09 36%,
+          1.02 40%, 0.97 44%, 0.95 48%, 0.95 52%, 0.97 60%,
+          1.01 72%, 1.01 80%, 1
+        );
+        transition: transform 0.7s var(--spring-easing);
+      }
+
+      .card.spring:is(:hover, :focus-within) {
+        transform: scale(1.04);
+      }
+
+      .card.bounce {
+        /* Each rebound loses energy until the card comes to rest. */
+        --bounce-easing: linear(
+          0, 0.214 14.7%, 0.386 23.7%, 0.598 31.9%,
+          0.999 44.7%, 0.807 52.6%, 0.762 56%, 0.747 59.4%,
+          0.758 62.4%, 0.793 65.6%, 0.999 77.4%, 0.961 81.2%,
+          0.949 84.8%, 0.956 88%, 0.993 95.5%, 1
+        );
+        transform-origin: center bottom;
+        transition: transform 0.75s var(--bounce-easing);
+      }
+
+      .card.bounce:is(:hover, :focus-within) {
+        transform: scale(1.045);
+      }
+    }
+
