\ No newline at end of file
+}
+:focus-visible {
+  outline: 3px solid #92400e;
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  z-index: 100;
+  padding: .75rem 1rem;
+  background: white;
+  color: black;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.overlay-dialog {
+  width: min(42rem, calc(100% - 2rem));
+  max-height: calc(100dvh - 2rem);
+  margin: auto;
+  padding: 0;
+  border: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.overlay-dialog::backdrop {
+  background: rgb(255 255 255 / .3);
+  backdrop-filter: blur(4px);
+}
+
+body:has(dialog:modal) { overflow: hidden; }
+
+.flyout-menu {
+  position: fixed;
+  inset: auto 0;
+  top: 8rem;
+  width: min(100%, 72rem);
+  max-height: min(70dvh, 40rem);
+  margin: 0 auto;
+  padding: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
