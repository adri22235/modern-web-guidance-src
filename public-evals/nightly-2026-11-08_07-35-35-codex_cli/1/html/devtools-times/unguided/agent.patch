diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..24da6f5
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,46 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** The native modal provides focus containment, Escape dismissal and focus return. */
+export default function Modal({ id, title, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const opener = document.activeElement as HTMLElement | null;
+    dialog.showModal();
+    return () => {
+      if (dialog.open) dialog.close();
+      if (opener?.isConnected) opener.focus();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={`${id}-title`}
+      className="overlay-dialog bg-white shadow-xl"
+      onClose={onClose}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <div className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 tabIndex={-1} id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <button type="button" onClick={() => dialogRef.current?.close()} aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+      </div>
+      {children}
+    </dialog>
+  );
+}
