new file mode 100644
index 0000000..a5170e9
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,29 @@
+import { useEffect, useId, useRef, type ReactNode } from 'react';
+
+export default function Modal({ title, onClose, children, focusClose = false }: {
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+  focusClose?: boolean;
+}) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const titleId = useId();
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    dialog.showModal();
+    return () => dialog.close();
+  }, []);
+
+  return (
+    <dialog ref={dialogRef} aria-labelledby={titleId} closedBy="any" onClose={onClose} className="site-dialog bg-white shadow-xl">
+      <div className="flex items-center justify-between gap-4 border-b border-gray-200 p-4">
+        <h2 id={titleId} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <form method="dialog">
+          <button autoFocus={focusClose} className="p-2 text-gray-700 hover:text-amber-700" aria-label={`Close ${title.toLowerCase()}`}>Close</button>
+        </form>
+      </div>
+      {children}
+    </dialog>
+  );
+}
