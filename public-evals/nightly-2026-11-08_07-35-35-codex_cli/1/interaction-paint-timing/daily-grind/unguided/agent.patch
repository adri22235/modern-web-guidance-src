diff --git a/performance-monitor.js b/performance-monitor.js
new file mode 100644
index 0000000..f403225
--- /dev/null
+++ b/performance-monitor.js
@@ -0,0 +1,143 @@
+/* Local-only interaction timings. See PERFORMANCE.md for the integration API. */
+(() => {
+  'use strict';
+  if (window.dailyGrindPerformance) return;
+
+  const limit = 100;
+  const records = [];
+  const pending = new Set();
+  const clicks = new Map();
+  const generations = new WeakMap();
+  let generation = 0;
+  let sequence = 0;
+
+  function publish(record, updated = false) {
+    const index = records.findIndex(item => item.id === record.id);
+    if (index < 0) records.push(record);
+    else records[index] = record;
+    if (records.length > limit) records.shift();
+    try {
+      // Keep the browser's User Timing buffer bounded too.
+      performance.clearMeasures(`daily-grind:${record.id}`);
+      performance.measure(`daily-grind:${record.id}`, {
+        start: record.startTime,
+        duration: record.duration,
+        detail: record,
+      });
+      if (record.id > limit) performance.clearMeasures(`daily-grind:${record.id - limit}`);
+    } catch { /* Older User Timing implementations still get the custom event. */ }
+    window.dispatchEvent(new CustomEvent('daily-grind:performance', {
+      detail: { ...record, updated },
+    }));
+  }
+
+  function begin(kind, name, startTime = performance.now()) {
+    const record = { id: ++sequence, kind, name, startTime };
+    generations.set(record, document.visibilityState === 'visible' ? generation : -1);
+    return record;
+  }
+
+  // rAF runs BEFORE paint. A second frame gives the first frame a paint
+  // opportunity; this is an estimate, never proof that pixels reached a screen.
+  function afterPaintOpportunity(record) {
+    if (document.visibilityState !== 'visible' || generations.get(record) !== generation) return Promise.resolve();
+    return new Promise(resolve => {
+      const job = { first: 0, second: 0, resolve };
+      pending.add(job);
+      job.first = requestAnimationFrame(() => {
+        job.second = requestAnimationFrame(() => {
+          pending.delete(job);
+          if (document.visibilityState === 'visible' && record.source !== 'event-timing') {
+            record.duration = Math.max(0, performance.now() - record.startTime);
+            record.source = 'animation-frame-estimate';
+            publish({ ...record });
+          }
+          resolve();
+        });
+      });
+    });
+  }
+
+  function cancelPending() {
+    generation++;
+    for (const job of pending) {
+      cancelAnimationFrame(job.first);
+      cancelAnimationFrame(job.second);
+      job.resolve();
+    }
+    pending.clear();
+    clicks.clear();
+  }
+
+  document.addEventListener('click', event => {
+    if (document.visibilityState !== 'visible') return;
+    const target = event.target instanceof Element ? event.target : event.target?.parentElement;
+    if (!target) return;
+    const navLink = target.closest('nav a');
+    const order = target.closest('.hero .btn');
+    const card = target.closest('[data-performance-section="seasonal-favorites"] .card');
+    if (!navLink && !order && !card) return;
+    const kind = navLink ? 'navigation' : order ? 'order' : 'seasonal-card';
+    const name = navLink ? navLink.textContent.trim() : order ? 'Order Now' : card.querySelector('h3')?.textContent.trim();
+    // Some older browsers use epoch timestamps rather than the time origin.
+    const timestamp = event.timeStamp > performance.now() + 60000
+      ? event.timeStamp - performance.timeOrigin : event.timeStamp;
+    const record = begin(kind, name || kind, timestamp);
+    clicks.set(record.id, record);
+    if (clicks.size > limit) clicks.delete(clicks.keys().next().value);
+    void afterPaintOpportunity(record);
+  }, { capture: true, passive: true });
+
+  if (window.PerformanceObserver?.supportedEntryTypes?.includes('event')) {
+    try {
+      new PerformanceObserver(list => {
+        for (const entry of list.getEntries()) {
+          if (entry.name !== 'click') continue;
+          const record = [...clicks.values()].find(item => Math.abs(item.startTime - entry.startTime) < 1);
+          if (!record) continue;
+          const updated = records.some(item => item.id === record.id);
+          record.duration = entry.duration;
+          record.source = 'event-timing';
+          record.interactionId = entry.interactionId;
+          publish({ ...record }, updated);
+          clicks.delete(record.id);
+        }
+      }).observe({ type: 'event', durationThreshold: 16 });
+    } catch { /* Frame estimates remain available if observation is refused. */ }
+  }
+
+  async function measureViewSwitch(name, update) {
+    const record = begin('view-switch', String(name));
+    const result = await update();
+    // The update promise must resolve after the view's DOM commit.
+    await afterPaintOpportunity(record);
+    return result;
+  }
+
+  // Automatically cover synchronous History API view changes. Async routers
+  // should use measureViewSwitch to include their data loading and DOM commit.
+  for (const method of ['pushState', 'replaceState']) {
+    const original = history[method];
+    history[method] = function (...args) {
+      const record = begin('view-switch', method);
+      const result = Reflect.apply(original, this, args);
+      void afterPaintOpportunity(record);
+      return result;
+    };
+  }
+  window.addEventListener('popstate', () => {
+    void afterPaintOpportunity(begin('view-switch', 'popstate'));
+  });
+  window.addEventListener('hashchange', () => {
+    void afterPaintOpportunity(begin('view-switch', 'hashchange'));
+  });
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState !== 'visible') cancelPending();
+  });
+  window.addEventListener('pagehide', cancelPending);
+
+  window.dailyGrindPerformance = Object.freeze({
+    getRecords: () => records.map(record => ({ ...record })),
+    measureViewSwitch,
+  });
+})();
diff --git a/performance-monitor.test.cjs b/performance-monitor.test.cjs
new file mode 100644
index 0000000..1cf7e71
--- /dev/null
+++ b/performance-monitor.test.cjs
@@ -0,0 +1,189 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const source = readFileSync(`${__dirname}/performance-monitor.js`, 'utf8');
+
+function setup({ eventTiming = true, refuseObserver = false } = {}) {
+  let now = 100;
+  let nextFrame = 0;
+  let observer;
+  const frames = new Map();
+  const measures = new Map();
+  const emitted = [];
+  const listeners = new Map();
+  const on = (type, callback) => {
+    if (!listeners.has(type)) listeners.set(type, []);
+    listeners.get(type).push(callback);
+  };
+  const fire = (type, event = {}) => {
+    for (const callback of listeners.get(type) || []) callback(event);
+  };
+  class Element {
+    constructor(kind) { this.kind = kind; this.textContent = 'Menu'; }
+    closest(selector) {
+      return (this.kind === 'navigation' && selector === 'nav a') ||
+        (this.kind === 'order' && selector === '.hero .btn') ||
+        (this.kind === 'card' && selector.includes('[data-performance-section')) ? this : null;
+    }
+    querySelector() { return { textContent: 'Cold Brew' }; }
+  }
+  class PerformanceObserver {
+    static supportedEntryTypes = eventTiming ? ['event'] : [];
+    constructor(callback) { observer = callback; }
+    observe(options) {
+      assert.equal(options.durationThreshold, 16);
+      if (refuseObserver) throw new Error('unsupported');
+    }
+  }
+  const window = {
+    PerformanceObserver,
+    addEventListener: on,
+    dispatchEvent: event => { emitted.push(event.detail); return true; },
+  };
+  const document = { visibilityState: 'visible', addEventListener: on };
+  const history = {
+    pushState(...args) { this.lastArgs = args; return 'push-result'; },
+    replaceState() { return 'replace-result'; },
+  };
+  const context = vm.createContext({
+    window, document, history, Element, PerformanceObserver,
+    CustomEvent: class { constructor(type, { detail }) { this.type = type; this.detail = detail; } },
+    performance: {
+      now: () => now, timeOrigin: 1000000,
+      measure: (name, options) => measures.set(name, options),
+      clearMeasures: name => measures.delete(name),
+    },
+    requestAnimationFrame: callback => { frames.set(++nextFrame, callback); return nextFrame; },
+    cancelAnimationFrame: id => frames.delete(id),
+  });
+  vm.runInContext(source, context);
+  function frame() {
+    now += 16;
+    const callbacks = [...frames.values()];
+    frames.clear();
+    callbacks.forEach(callback => callback(now));
+  }
+  return {
+    api: window.dailyGrindPerformance, emitted, measures, document, history, fire, frame,
+    rerun: () => vm.runInContext(source, context),
+    click(kind, timeStamp = now) { fire('click', { target: new Element(kind), timeStamp }); },
+    entry(entry) { observer({ getEntries: () => [entry] }); },
+  };
+}
+
+test('all requested click targets wait for a paint opportunity; unrelated clicks are ignored', () => {
+  const app = setup({ eventTiming: false });
+  for (const kind of ['navigation', 'order', 'card', 'footer']) app.click(kind);
+  app.frame();
+  assert.equal(app.api.getRecords().length, 0);
+  app.frame();
+  const records = app.api.getRecords();
+  assert.equal(records.length, 3);
+  assert.deepEqual(Array.from(records, record => record.kind), ['navigation', 'order', 'seasonal-card']);
+  assert.equal(records[2].name, 'Cold Brew');
+  for (const record of records) {
+    assert.equal(record.duration, 32);
+    assert.equal(record.source, 'animation-frame-estimate');
+  }
+});
+
+test('Event Timing replaces the matching estimate without duplicating a record', () => {
+  const app = setup();
+  app.click('navigation');
+  app.frame(); app.frame();
+  app.entry({ name: 'pointerdown', startTime: 100, duration: 24 });
+  app.entry({ name: 'click', startTime: 99, duration: 24 });
+  assert.equal(app.emitted.length, 1);
+  app.entry({ name: 'click', startTime: 100, duration: 24, interactionId: 7 });
+  assert.equal(app.api.getRecords().length, 1);
+  assert.equal(app.api.getRecords()[0].source, 'event-timing');
+  assert.equal(app.api.getRecords()[0].duration, 24);
+  assert.equal(app.emitted[1].updated, true);
+  assert.equal(app.measures.size, 1);
+});
+
+test('an early Event Timing entry prevents a later frame estimate', () => {
+  const app = setup();
+  app.click('order');
+  app.entry({ name: 'click', startTime: 100, duration: 48, interactionId: 8 });
+  app.frame(); app.frame();
+  assert.equal(app.emitted.length, 1);
+  assert.equal(app.api.getRecords()[0].duration, 48);
+});
+
+test('view switch timing includes asynchronous work and preserves results and errors', async () => {
+  const app = setup();
+  let commit;
+  const work = app.api.measureViewSwitch('menu', () => new Promise(resolve => { commit = resolve; }));
+  app.frame(); app.frame();
+  assert.equal(app.api.getRecords().length, 0);
+  commit('rendered');
+  await new Promise(resolve => setImmediate(resolve));
+  app.frame();
+  assert.equal(app.api.getRecords().length, 0);
+  app.frame();
+  assert.equal(await work, 'rendered');
+  assert.equal(app.api.getRecords()[0].duration, 64);
+  await assert.rejects(app.api.measureViewSwitch('broken', () => { throw new Error('render failed'); }), /render failed/);
+  assert.equal(app.api.getRecords().length, 1);
+});
+
+test('history and traversal monitoring preserve native method behavior', () => {
+  const app = setup();
+  assert.equal(app.history.pushState({ menu: true }, '', '/menu'), 'push-result');
+  assert.equal(app.history.lastArgs[2], '/menu');
+  assert.equal(app.history.replaceState({}, '', '/menu'), 'replace-result');
+  app.fire('popstate');
+  app.fire('hashchange');
+  app.frame(); app.frame();
+  assert.deepEqual(Array.from(app.api.getRecords(), record => record.name), ['pushState', 'replaceState', 'popstate', 'hashchange']);
+});
+
+test('hidden pages and page exits discard pending timings, including asynchronous switches', async () => {
+  const app = setup();
+  let commit;
+  const work = app.api.measureViewSwitch('menu', () => new Promise(resolve => { commit = resolve; }));
+  app.click('order');
+  app.frame();
+  app.document.visibilityState = 'hidden';
+  app.fire('visibilitychange');
+  app.click('navigation');
+  app.document.visibilityState = 'visible';
+  commit();
+  await work;
+  app.frame(); app.frame();
+  assert.equal(app.api.getRecords().length, 0);
+  app.click('card');
+  app.fire('pagehide');
+  app.frame(); app.frame();
+  assert.equal(app.api.getRecords().length, 0);
+  app.document.visibilityState = 'hidden';
+  const hiddenWork = app.api.measureViewSwitch('hidden-start', () => new Promise(resolve => { commit = resolve; }));
+  app.document.visibilityState = 'visible';
+  commit();
+  await hiddenWork;
+  assert.equal(app.api.getRecords().length, 0);
+});
+
+test('observation failure falls back; records and timeline stay bounded; initialization is idempotent', () => {
+  const app = setup({ refuseObserver: true });
+  app.rerun();
+  for (let i = 0; i < 105; i++) {
+    app.click('navigation');
+    app.frame(); app.frame();
+  }
+  const records = app.api.getRecords();
+  assert.equal(records.length, 100);
+  assert.equal(records[0].id, 6);
+  assert.equal(app.measures.size, 100);
+  records[0].name = 'changed';
+  assert.equal(app.api.getRecords()[0].name, 'Menu');
+});
+
+test('epoch click timestamps are normalized to the performance time origin', () => {
+  const app = setup({ eventTiming: false });
+  app.click('order', 1000100);
+  app.frame(); app.frame();
+  assert.equal(app.api.getRecords()[0].duration, 32);
+});
