+.select-wrap > span {
+  position: absolute;
+  right: 13px;
+  top: 7px;
+  color: #777e6d;
+  pointer-events: none;
+}
+select {
+  appearance: none;
+  border: 1px solid #dcded3;
+  background: #f6f6ef;
+  border-radius: 5px;
+  width: 100%;
+  padding: 10px 13px;
+  font-size: 11px;
+  color: #444c3d;
+  cursor: pointer;
+}
+.quality-hint {
+  font-size: 9px;
+  line-height: 1.5;
+  color: #979b8d;
+  margin: 12px 0 0;
+}
+.render-actions {
+  margin-top: auto;
+  padding-top: 23px;
+}
+.primary-button {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  background: var(--orange);
+  border: 1px solid var(--orange);
+  color: #fff;
+  border-radius: 5px;
+  width: 100%;
+  padding: 13px 13px;
+  font-size: 12px;
+  box-shadow: 0 2px 2px #92381810;
+  transition:
+    background 0.2s,
+    transform 0.2s;
+}
+.primary-button:hover {
+  background: #bf4a28;
+  transform: translateY(-1px);
+}
+.primary-button > svg {
+  width: 18px;
+  height: 18px;
+}
+.button-arrow {
+  margin-left: auto;
+  font-size: 16px;
+  opacity: 0.8;
+}
+.secondary-actions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 17px 2px;
+}
+.secondary-actions button {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 10px;
+  color: #7b816f;
+  border: 0;
+  background: none;
+  padding: 0;
+}
+.secondary-actions button:hover {
+  color: var(--orange);
+}
+.secondary-actions svg {
+  width: 14px;
+  height: 14px;
+}
+.secondary-actions > span {
+  height: 12px;
+  width: 1px;
+  background: var(--line);
+}
+.local-note {
+  margin-top: 3px;
+  padding-top: 17px;
+  border-top: 1px solid var(--line);
+  font-size: 8px;
+  color: #9a9e8f;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  white-space: nowrap;
+}
+.local-note svg {
+  width: 11px;
+  height: 11px;
+}
+.under-workspace {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-top: 13px;
+}
+.under-workspace p {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 10px;
+  color: #888d7e;
+  margin: 0;
+}
+.under-workspace .status-dot {
+  width: 5px;
+  height: 5px;
+}
+.under-workspace > span {
+  font:
+    8px "DM Mono",
+    monospace;
+  letter-spacing: 0.75px;
+  color: #9a9e90;
+}
+.explain-section {
+  display: grid;
+  grid-template-columns: 1.2fr 1fr 1fr 1fr;
+  gap: 0;
+  margin-top: 58px;
+  padding: 33px 0 36px;
+  border-top: 1px solid var(--line);
+  scroll-margin-top: 25px;
+}
+.explain-intro {
+  padding-right: 25px;
+}
+.explain-intro .eyebrow {
+  font-size: 8px;
+  color: #95998a;
+  letter-spacing: 1.35px;
+}
+.explain-intro h2 {
+  font-size: 25px;
+  font-weight: 500;
+  letter-spacing: -0.8px;
+  line-height: 1.22;
+  margin: 15px 0 19px;
+}
+.explain-intro h2 em {
+  font-family: "Instrument Serif", Georgia, serif;
+  font-size: 1.15em;
+  font-weight: 400;
+  color: #8d927f;
+  letter-spacing: -0.3px;
+}
+.explain-intro > a {
+  font-size: 9px;
+  color: #757d68;
+}
+.explain-intro > a span {
+  margin-left: 8px;
+}
+.explain-card {
+  border-left: 1px solid var(--line);
+  padding: 0 24px 0 28px;
+}
+.card-number {
+  display: block;
+  font:
+    8px "DM Mono",
+    monospace;
+  letter-spacing: 1px;
+  color: #9b9e90;
+}
+.card-icon {
+  display: block;
+  width: 34px;
+  height: 34px;
+  color: #7d856f;
+  margin: 17px 0 10px;
+}
+.code-icon {
+  font:
+    27px "DM Mono",
+    monospace;
+  letter-spacing: -4px;
+  line-height: 34px;
+}
+.explain-card h3 {
+  font-size: 12px;
+  font-weight: 500;
+  letter-spacing: -0.2px;
+  margin: 0 0 9px;
+}
+.explain-card p {
+  font-size: 10px;
+  line-height: 1.85;
+  color: #8c9181;
+  margin: 0;
+  max-width: 220px;
+}
+.site-footer {
+  border-top: 1px solid var(--line);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 22px 0 27px;
+  color: #999d90;
+  font-size: 9px;
+}
+.site-footer p {
+  margin: 0;
+}
+.site-footer p:last-child {
+  display: flex;
+  gap: 6px;
+}
+.site-footer p:last-child > span {
+  margin-inline: 6px;
+}
+.site-footer a:hover,
+.explain-intro > a:hover {
+  color: var(--orange);
+}
+@keyframes pulse {
+  50% {
+    opacity: 0.35;
+  }
+}
+@media (min-width: 1500px) {
+  .page-width {
+    width: min(1320px, calc(100% - 140px));
+  }
+  .intro {
+    padding-block: 64px 50px;
+  }
+  .control-panel {
+    padding: 29px;
+  }
+  .control-section {
+    margin-top: 30px;
+    padding-top: 28px;
+  }
+  .quality-section label {
+    margin-top: 22px;
+  }
+  .palette {
+    margin-top: 22px;
+  }
+  .color-swatch {
+    height: 46px;
+    width: 46px;
+  }
+  .control-description {
+    font-size: 12px;
+  }
+  .local-note {
+    font-size: 9px;
+  }
+  .explain-card p {
+    font-size: 11px;
+  }
+  .explain-card h3 {
+    font-size: 13px;
+  }
+}
