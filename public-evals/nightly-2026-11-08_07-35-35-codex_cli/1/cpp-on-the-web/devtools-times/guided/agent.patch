index 0000000..016bb65
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+obj_file=$(mktemp /tmp/smallpt-XXXXXX.o)
+trap 'rm -f "$obj_file"' EXIT
+em++ -c renderer/smallpt.cpp -o "$obj_file" -O3 -flto -fno-exceptions -Wall -Werror
+em++ "$obj_file" -o public/wasm/smallpt.js -O3 -flto -fno-exceptions \
+  -sSTRICT -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB -sFILESYSTEM=0 \
+  -sEXPORTED_FUNCTIONS=_begin_render,_render_rows,_scene_color \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+cp renderer/smallpt.original.cpp public/wasm/smallpt.original.cpp
+cp renderer/LICENSE.txt public/wasm/LICENSE.txt
