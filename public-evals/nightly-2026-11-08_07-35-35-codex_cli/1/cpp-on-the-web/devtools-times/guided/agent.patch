+  }
+  .palette {
+    justify-content: flex-start;
+    gap: 24px;
+    margin-top: 18px;
+  }
+  .palette > div {
+    font-size: 10px;
+    gap: 9px;
+  }
+  .color-swatch {
+    width: 48px;
