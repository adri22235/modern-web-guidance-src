+    font-size: 16px;
+  }
+  .control-description {
+    font-size: 10px;
+  }
+  .control-section {
+    margin-top: 17px;
+    padding-top: 15px;
+  }
+  .palette {
+    margin-top: 13px;
+  }
+  .palette-hint {
+    margin-top: 12px;
+  }
+  .color-swatch {
+    width: 36px;
+    height: 31px;
+  }
+  .palette > div {
+    font-size: 8px;
+  }
+  .quality-section label {
+    margin-top: 12px;
+  }
+  .render-actions {
+    padding-top: 17px;
+  }
+  .local-note {
+    font-size: 7px;
+    padding-top: 13px;
+  }
