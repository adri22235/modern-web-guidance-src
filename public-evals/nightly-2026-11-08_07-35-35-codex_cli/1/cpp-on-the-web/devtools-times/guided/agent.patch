+    font-size: 8px;
+  }
+  .render-actions {
+    padding-top: 18px;
+  }
+  .explain-card {
+    padding-inline: 20px;
+  }
+  .explain-card h3 {
+    font-size: 11px;
+  }
+  .scene-tag {
+    display: none;
+  }
+}
+@media (max-width: 850px) {
