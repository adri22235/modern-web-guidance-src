+static unsigned char* pixels = nullptr;
+static int width = 640, height = 480;
+static unsigned int sceneSeed = 1;
+extern "C" {
+unsigned char* setup(int w, int h, unsigned int seed, const float* colors) {
+  width = w; height = h; sceneSeed = seed;
+  free(pixels);
+  pixels = (unsigned char*)calloc(width * height * 4, 1);
+  if (!pixels) abort();
+  const int ids[] = {0, 1, 6, 7};
+  for (int i=0; i<4; ++i)
+    spheres[ids[i]].c = Vec(colors[i*3], colors[i*3+1], colors[i*3+2]);
+  return pixels;
+}
