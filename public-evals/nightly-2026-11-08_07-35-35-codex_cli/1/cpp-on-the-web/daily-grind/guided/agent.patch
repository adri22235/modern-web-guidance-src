@@ -0,0 +1,26 @@
+// Exercise the actual compiled renderer without a browser or HTTP server.
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import initSmallpt from '../public/smallpt.js';
+const bytes = await readFile(new URL('../public/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(bytes), 'WebAssembly binary must validate');
+const originalFetch = globalThis.fetch;
+globalThis.fetch = async () => new Response(bytes, { headers: { 'Content-Type': 'application/wasm' } });
+const wasm = await initSmallpt();
+globalThis.fetch = originalFetch;
+const original = [.75,.25,.25,.25,.25,.75,.999,.999,.999,.999,.999,.999];
+const changed = [.3,.8,.4,.8,.4,.2,.7,.9,.6,.9,.6,.8];
+function render(colors) {
+  const colorPtr = wasm._malloc(48);
+  wasm.HEAPF32.set(colors, colorPtr / 4);
+  const ptr = wasm._setup(64, 48, 123, colorPtr);
+  wasm._free(colorPtr);
+  for (let row = 0; row < 48; row += 8) wasm._render_rows(row, 8, 16);
+  return wasm.HEAPU8.slice(ptr, ptr + 64 * 48 * 4);
+}
+const image = render(original);
+assert(image.some((v, i) => i % 4 !== 3 && v > 0), 'Renderer must produce lit pixels');
+assert(image.every((v, i) => i % 4 !== 3 || v === 255), 'Every output pixel must be opaque');
+assert.notDeepEqual(render(changed), image, 'Color changes must alter the traced image');
+assert.deepEqual(render(original), image, 'Reset must restore the original scene');
+console.log('PASS: WASM validation, actual rendering, randomized colors, and deterministic reset.');
