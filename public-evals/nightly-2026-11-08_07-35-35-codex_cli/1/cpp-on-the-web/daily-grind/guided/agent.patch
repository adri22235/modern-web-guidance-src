+            +cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+          r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+        }
+        color=color+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      int i=(row*width+x)*4;
+      pixels[i]=toInt(color.x); pixels[i+1]=toInt(color.y);
+      pixels[i+2]=toInt(color.z); pixels[i+3]=255;
+    }
+  }
+}
+}
+#ifdef SMALLPT_PREVIEW
+int main() {
+  float colors[]={.75,.25,.25, .25,.25,.75, .999,.999,.999, .999,.999,.999};
+  setup(640,480,1,colors);
+  render_rows(0,480,256);
+  FILE* f=fopen("/tmp/smallpt-preview.ppm","wb");
+  if (!f) return 1;
+  fprintf(f,"P6\n%d %d\n255\n",width,height);
+  for (int i=0;i<width*height;++i) fwrite(pixels+i*4,1,3,f);
+  fclose(f);
+}
+#endif
