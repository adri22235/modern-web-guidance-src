diff --git a/worker.js b/worker.js
new file mode 100644
index 0000000..e09044d
--- /dev/null
+++ b/worker.js
@@ -0,0 +1,27 @@
+import initSmallpt from './public/smallpt.js';
+let wasm;
+const ready = initSmallpt().then(module => { wasm = module; });
+self.onmessage = async ({ data }) => {
+  try {
+    await ready;
+    const { width, height, samples, seed, colors } = data;
+    const colorPtr = wasm._malloc(48);
+    if (!colorPtr) throw new Error('Unable to allocate scene colors.');
+    let ptr;
+    try {
+      wasm.HEAPF32.set(colors, colorPtr / 4);
+      ptr = wasm._setup(width, height, seed, colorPtr);
+    } finally { wasm._free(colorPtr); }
+    const started = performance.now();
+    for (let row = 0; row < height; row += 8) {
+      const count = Math.min(8, height - row);
+      wasm._render_rows(row, count, samples);
+      // Read the heap after the call: memory growth can replace its buffer.
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, ptr + row * width * 4, count * width * 4).slice();
+      self.postMessage({ type: 'rows', row, width, count, pixels, progress: (row + count) / height, elapsed: performance.now() - started }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done', elapsed: performance.now() - started });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message || 'The renderer could not start.' });
+  }
+};
