new file mode 100644
index 0000000..f458916
--- /dev/null
+++ b/app.js
@@ -0,0 +1,117 @@
+const $ = id => document.getElementById(id);
+const canvas = $('canvas');
+const ctx = canvas.getContext('2d');
+const original = [.75,.25,.25, .25,.25,.75, .999,.999,.999, .999,.999,.999];
+let colors = [...original];
+let worker;
+let busy = false;
+let hasFrame = false;
+let currentSamples = 32;
+
+function setStatus(text, error = false) {
+  $('status-text').textContent = text;
+  $('render-status').style.color = error ? '#efa890' : '';
+  $('render-status').querySelector('.dot').style.background = error ? '#efa890' : '';
+}
+function updatePalette() {
+  [...$('palette').children].forEach((swatch, i) => {
+    swatch.style.setProperty('--swatch', `rgb(${colors.slice(i * 3, i * 3 + 3).map(c => Math.round(c * 255)).join(' ')})`);
+  });
+}
+function setBusy(value) {
+  busy = value;
+  $('randomize').disabled = value;
+  $('reset').disabled = value;
+  $('samples').disabled = value;
+  $('resolution').disabled = value;
+  canvas.setAttribute('aria-busy', String(value));
+}
+function fail(message) {
+  setBusy(false);
+  setStatus('Renderer unavailable — try again', true);
+  $('render-status').title = message;
+  worker?.terminate();
+  worker = undefined;
+  console.error('smallpt:', message);
+}
+function startRender() {
+  if (busy) return;
+  if (!ctx || !('WebAssembly' in window) || !('Worker' in window)) {
+    fail('This browser needs WebAssembly, canvas, and Web Worker support.');
+    return;
+  }
+  setBusy(true);
+  setStatus('Tracing light…');
+  $('progress-bar').style.width = '0%';
+  $('elapsed').textContent = '0.0 s';
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  currentSamples = Number($('samples').value);
+  // Preserve the previous image while the new rows arrive.
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width;
+  previous.height = canvas.height;
+  previous.getContext('2d').drawImage(canvas, 0, 0);
+  canvas.width = width;
+  canvas.height = height;
+  if (hasFrame) ctx.drawImage(previous, 0, 0, width, height);
+  $('meta-resolution').textContent = `${width} × ${height}`;
+  $('meta-samples').textContent = `${currentSamples} samples / pixel`;
+  try {
+    if (!worker) {
+      worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+      worker.onerror = event => { event.preventDefault(); fail(event.message || 'Worker loading failed.'); };
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'error') { fail(data.message); return; }
+        if (data.type === 'rows') {
+          ctx.putImageData(new ImageData(data.pixels, data.width, data.count), 0, data.row);
+          $('progress-bar').style.width = `${data.progress * 100}%`;
+          $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+          hasFrame = true;
+        }
+        if (data.type === 'done') {
+          setBusy(false);
+          setStatus('Render complete');
+          $('preview').style.visibility = 'hidden';
+          $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+        }
+      };
+    }
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({ width, height, samples: currentSamples, seed, colors });
+  } catch (error) { fail(error.message); }
+}
+$('randomize').addEventListener('click', () => {
+  const random = crypto.getRandomValues(new Uint32Array(12));
+  colors = [...random].map((value, i) => (i < 6 ? .22 : .58) + value / 4294967295 * (i < 6 ? .62 : .4));
+  $('palette-label').textContent = 'Randomized';
+  updatePalette();
+  startRender();
+});
+$('reset').addEventListener('click', () => {
+  colors = [...original];
+  $('palette-label').textContent = 'Original';
+  updatePalette();
+  startRender();
+});
+$('samples').addEventListener('change', startRender);
+$('resolution').addEventListener('change', startRender);
+$('download').addEventListener('click', () => {
+  const exportCanvas = document.createElement('canvas');
+  exportCanvas.width = canvas.width;
+  exportCanvas.height = canvas.height;
+  const exportContext = exportCanvas.getContext('2d');
+  const preview = $('preview');
+  if (preview.complete && preview.naturalWidth) exportContext.drawImage(preview, 0, 0, canvas.width, canvas.height);
+  exportContext.drawImage(canvas, 0, 0);
+  exportCanvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${$('palette-label').textContent.toLowerCase()}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+startRender();
