+++ b/src/renderer.cpp
@@ -0,0 +1,48 @@
+// Browser adapter for Kevin Beason's smallpt. Original source and MIT license
+// are preserved in vendor/. The path integration code is used unchanged.
+#define main smallpt_original_main
+#include "../vendor/smallpt.cpp"
+#undef main
+#include <stdint.h>
+#include <vector>
+
+static int width, height;
+static uint32_t sceneSeed;
+static std::vector<Vec> accumulated;
+static std::vector<unsigned char> pixels;
+
+extern "C" {
+void initialize(int w, int h, uint32_t seed) {
+  width = w; height = h; sceneSeed = seed;
+  accumulated.assign(w*h*4, Vec());
+  pixels.assign(w*h*4, 0);
+}
+void set_color(int sphere, double r, double g, double b) {
+  if (sphere == 6 || sphere == 7) spheres[sphere].c = Vec(r,g,b);
+}
+unsigned char* pixel_buffer() { return pixels.data(); }
+// Each pass adds one sample to each of the original 2x2 subpixels: 4 spp.
+void render_rows(int start, int count, int pass) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int y=start; y<start+count && y<height; y++) {
+    uint32_t seed = sceneSeed ^ (uint32_t(y+1)*747796405u) ^ (uint32_t(pass+1)*2891336453u);
+    unsigned short Xi[3] = { (unsigned short)seed, (unsigned short)(seed>>16), (unsigned short)(seed*31+17) };
+    for (int x=0; x<width; x++) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for (int sy=0; sy<2; sy++) for (int sx=0; sx<2; sx++) {
+        double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1 : 1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1 : 1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        int sub=i*4+sy*2+sx;
+        accumulated[sub]=accumulated[sub]+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec average=accumulated[sub]*(1./(pass+1));
+        color=color+Vec(clamp(average.x),clamp(average.y),clamp(average.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z); pixels[i*4+3]=255;
+    }
+  }
+}
+}
