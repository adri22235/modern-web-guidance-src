+emcc src/renderer.cpp -O3 --no-entry -Wno-main-return-type -Wno-narrowing \
+  -s WASM=1 -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=web,worker,node \
+  -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=2097152 -s FILESYSTEM=0 \
+  -s EXPORTED_FUNCTIONS='["_initialize","_set_color","_pixel_buffer","_render_rows"]' \
+  -o public/smallpt.js
