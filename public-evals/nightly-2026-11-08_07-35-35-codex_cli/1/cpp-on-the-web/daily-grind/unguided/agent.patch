--- /dev/null
+++ b/scripts/check.mjs
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import createSmallpt from '../public/smallpt.js';
+const engine = await createSmallpt({ wasmBinary: await readFile(new URL('../public/smallpt.wasm', import.meta.url)) });
+function render(color, tileSize = 6, seed = 42) {
+  engine._initialize(40, 30, seed);
+  engine._set_color(6, ...color);
+  engine._set_color(7, 0.86, 0.92, 0.91);
+  for (let pass = 0; pass < 4; pass++) {
+    for (let y = 0; y < 30; y += tileSize) engine._render_rows(y, Math.min(tileSize, 30 - y), pass);
+  }
+  const ptr = engine._pixel_buffer();
+  return engine.HEAPU8.slice(ptr, ptr + 40 * 30 * 4);
+}
+const warm = render([0.95, 0.89, 0.83]);
+assert.equal(warm.length, 4800);
+assert(warm.every((value, index) => index % 4 !== 3 || value === 255), 'Every pixel must be opaque');
+const channels = warm.filter((_, index) => index % 4 !== 3);
+assert(channels.some((v) => v > 200) && channels.some((v) => v < 30), 'Scene must contain highlights and shadows');
+const blue = render([0.42, 0.6, 0.98]);
+assert.notDeepEqual(warm, blue, 'Sphere colors must change the render');
+assert.deepEqual(warm, render([0.95, 0.89, 0.83], 30), 'Tiling must not alter deterministic output');
+assert.notDeepEqual(warm, render([0.95, 0.89, 0.83], 6, 77), 'Different seeds must generate new samples');
+console.log('PASS: WASM loads, produces RGBA light transport, responds to sphere colors and seeds, and renders consistently across tile sizes.');
