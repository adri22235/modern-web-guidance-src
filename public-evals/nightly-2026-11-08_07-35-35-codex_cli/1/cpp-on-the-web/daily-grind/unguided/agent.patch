diff --git a/README.md b/README.md
new file mode 100644
index 0000000..7d9675d
--- /dev/null
+++ b/README.md
@@ -0,0 +1,35 @@
+# smallpt studio
+
+A static browser playground for [Kevin Beason’s smallpt](https://www.kevinbeason.com/smallpt/). The original C++ integrator runs as a real WebAssembly module inside a module Web Worker. The page renders automatically; Randomize & render changes both sphere colors and starts a fresh render. You can also edit colors, choose quality and resolution, reset the scene, and download the current image.
+
+## Build
+
+Requires Emscripten (`emcc` on PATH). No npm dependencies are needed.
+
+```sh
+npm run build
+```
+
+The generated `public/smallpt.js` and `public/smallpt.wasm` are committed so the page works without a compiler. Deploy this directory to any static HTTP(S) host, preserving the file structure. Module workers require HTTP(S), rather than opening `index.html` with a `file:` URL. Serve `.wasm` as `application/wasm` when possible. No application server, cross-origin isolation, or GPU is required.
+
+## Checks and initial preview
+
+```sh
+node scripts/check.mjs
+node scripts/preview.mjs
+```
+
+The check loads and executes the compiled WASM in Node, verifies RGBA output and changes from sphere colors and random seeds, and checks that tile boundaries do not affect results. The preview script uses the same WASM renderer to generate the initial 640 × 480 PNG; it is a build-time image, replaced by live browser output. Neither command starts a server or opens a browser.
+
+## Files
+
+- `vendor/smallpt.cpp`: original unmodified C++ source.
+- `vendor/LICENSE.txt`: Kevin Beason’s MIT license.
+- `src/renderer.cpp`: in-memory, progressive render adapter with color controls.
+- `public/render-worker.js`: runs progressive passes without blocking the UI.
+- `app.js`: canvas display and controls, worker cancellation, PNG export.
+- `index.html` and `style.css`: responsive studio interface.
+
+The adapter preserves the original scene, path integration, Russian roulette, Fresnel reflection/refraction, 2 × 2 subpixel sampling, tent filter, and gamma conversion. Each progressive pass adds four samples per pixel; it accumulates linear radiance separately per subpixel before clamping, as the original renderer does. Rendering is CPU intensive; quality and resolution affect time. Starting a new render terminates the previous worker.
+
+Original smallpt © 2006–2008 Kevin Beason, distributed under the MIT license retained in `vendor/LICENSE.txt`.
diff --git a/app.js b/app.js
new file mode 100644
index 0000000..7339ea1
--- /dev/null
+++ b/app.js
@@ -0,0 +1,127 @@
+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+const defaults = { mirror: '#f2e4d4', glass: '#dcebe8', samples: '64', resolution: '640' };
+let worker;
+let renderId = 0;
+let hasImage = false;
+let imageReady = false;
+
+function updateColors() {
+  for (const name of ['mirror', 'glass']) {
+    const value = $(`${name}-color`).value;
+    $(`${name}-swatch`).style.setProperty('--swatch', value);
+    $(`${name}-hex`).textContent = value.toUpperCase();
+  }
+}
+function rgb(hex) {
+  return [1, 3, 5].map((start) => Math.min(0.999, parseInt(hex.slice(start, start + 2), 16) / 255));
+}
+function setStatus(text, state = '') {
+  $('render-status').textContent = text;
+  $('status-dot').className = `status-dot ${state}`;
+}
+function render() {
+  worker?.terminate();
+  const id = ++renderId;
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  const samples = Number($('samples').value);
+  const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  updateColors();
+  imageReady = false;
+  $('download').disabled = true;
+  $('download').title = 'Available after the first rendered sample';
+  $('image-size').textContent = `${width} × ${height}`;
+  $('sample-count').textContent = `0 / ${samples} spp`;
+  $('elapsed').textContent = '0.0 s';
+  $('progress-fill').style.width = '0%';
+  document.querySelector('.progress-track').setAttribute('aria-valuenow', '0');
+  setStatus('Tracing light…', 'busy');
+  try {
+    if (!('WebAssembly' in window) || !('Worker' in window)) throw new Error('WebAssembly and Web Workers are required.');
+    worker = new Worker(new URL('./public/render-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.id !== renderId) return;
+      if (data.error) { fail(data.error); return; }
+      if (data.pixels) {
+        if (canvas.width !== data.width || canvas.height !== data.height) {
+          canvas.width = data.width; canvas.height = data.height;
+        }
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+        canvas.classList.add('has-render');
+        hasImage = true;
+        imageReady = true;
+        $('download').disabled = false;
+        $('download').title = 'Download the current render as a PNG';
+        $('sample-count').textContent = `${data.spp} / ${samples} spp`;
+      }
+      const percent = Math.min(100, Math.round(data.progress * 100));
+      $('progress-fill').style.width = `${percent}%`;
+      document.querySelector('.progress-track').setAttribute('aria-valuenow', String(percent));
+      $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+      if (data.done) {
+        setStatus('Render complete');
+        worker.terminate();
+        worker = null;
+      }
+    };
+    worker.onerror = (event) => { event.preventDefault(); fail('The renderer could not load. Press Randomize & render to retry.'); };
+    worker.postMessage({ id, width, height, samples, seed,
+      colors: [rgb($('mirror-color').value), rgb($('glass-color').value)] });
+  } catch (error) { fail(error.message); }
+}
+function fail(message) {
+  worker?.terminate();
+  worker = null;
+  setStatus('Render unavailable', 'error');
+  $('render-status').title = message;
+  $('viewport').setAttribute('aria-description', message);
+  // A previous completed image can still be saved after a failed rerender.
+  if (hasImage) { imageReady = true; $('download').disabled = false; }
+}
+function randomColor() {
+  // Lift the minimum channel so light can still travel through tinted glass.
+  const bytes = crypto.getRandomValues(new Uint8Array(3));
+  const dominant = bytes[0] % 3;
+  return '#' + [...bytes].map((n, i) => (i === dominant ? 244 : 130 + n % 100).toString(16).padStart(2, '0')).join('');
+}
+$('randomize').addEventListener('click', () => {
+  $('mirror-color').value = randomColor();
+  $('glass-color').value = randomColor();
+  render();
+});
+for (const name of ['mirror', 'glass']) {
+  $(`${name}-color`).addEventListener('input', updateColors);
+  $(`${name}-color`).addEventListener('change', render);
+}
+$('samples').addEventListener('change', render);
+$('resolution').addEventListener('change', render);
+$('reset').addEventListener('click', () => {
+  $('mirror-color').value = defaults.mirror;
+  $('glass-color').value = defaults.glass;
+  $('samples').value = defaults.samples;
+  $('resolution').value = defaults.resolution;
+  render();
+});
+$('download').addEventListener('click', () => {
+  if (!imageReady) return;
+  canvas.toBlob((blob) => {
+    if (!blob) return;
+    const link = document.createElement('a');
+    const url = URL.createObjectURL(blob);
+    link.href = url;
+    link.download = `smallpt-${Date.now()}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+const about = $('about-dialog');
+$('about-button').addEventListener('click', () => about.showModal());
+about.querySelector('.close-dialog').addEventListener('click', () => about.close());
+about.addEventListener('click', (event) => { if (event.target === about) {
+  const box = about.getBoundingClientRect();
+  if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) about.close();
+} });
+updateColors();
+render();
