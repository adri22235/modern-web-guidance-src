+// Build-time preview, rendered by exactly the same WASM engine as the page.
+import { readFile, writeFile } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import createSmallpt from '../public/smallpt.js';
+const engine = await createSmallpt({ wasmBinary: await readFile(new URL('../public/smallpt.wasm', import.meta.url)) });
+const w = 640, h = 480, samples = 128;
+engine._initialize(w, h, 42);
+engine._set_color(6, 242/255, 228/255, 212/255);
+engine._set_color(7, 220/255, 235/255, 232/255);
+for (let p = 0; p < samples/4; p++) {
+  engine._render_rows(0, h, p);
+  if (p % 8 === 7) console.log(`Preview: ${(p+1)*4} spp`);
+}
+const ptr = engine._pixel_buffer();
+const pixels = engine.HEAPU8.slice(ptr, ptr + w*h*4);
+const raw = Buffer.alloc((w*4+1)*h);
+for(let y=0;y<h;y++) raw.set(pixels.subarray(y*w*4,(y+1)*w*4),y*(w*4+1)+1);
+function crc32(buffer) {
+  let crc = 0xffffffff;
+  for (const byte of buffer) {
+    crc ^= byte;
+    for (let i=0;i<8;i++) crc = (crc>>>1)^((crc&1)?0xedb88320:0);
+  }
+  return (crc^0xffffffff)>>>0;
+}
+function chunk(type, data) {
+  const body = Buffer.concat([Buffer.from(type), data]);
+  const size = Buffer.alloc(4); size.writeUInt32BE(data.length);
+  const crc = Buffer.alloc(4); crc.writeUInt32BE(crc32(body));
+  return Buffer.concat([size, body, crc]);
+}
+const header = Buffer.alloc(13);
+header.writeUInt32BE(w); header.writeUInt32BE(h,4); header[8]=8; header[9]=6;
+await writeFile(new URL('../public/preview.png', import.meta.url), Buffer.concat([
+  Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR',header), chunk('IDAT',deflateSync(raw)), chunk('IEND',Buffer.alloc(0))
+]));
+console.log('Saved public/preview.png');
