+  <script type="module">
+    // Serve pinned polyfills locally, and only load missing platform features.
+    const nativePopover = Object.hasOwn(HTMLElement.prototype, 'popover');
+    if (!nativePopover) {
+      await import('./vendor/popover-0.7.3.min.js');
+    }
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement')) {
+      await import('./vendor/interestfor-1.0.12.min.js');
+    }
+
+    const previews = [...document.querySelectorAll('.drink-preview')];
+    const isOpen = (preview) => preview.classList.contains(':popover-open') ||
+      (nativePopover && preview.matches(':popover-open'));
+
+    // Older engines use measured positioning instead of CSS anchors.
+    function positionPreview(preview) {
+      if (CSS.supports('position-area: block-end') || !isOpen(preview)) return;
+      const trigger = document.querySelector(`[interestfor="${preview.id}"]`);
+      const rect = trigger.getBoundingClientRect();
+      const gap = 8;
+      const edge = 12;
+      const { width, height } = preview.getBoundingClientRect();
+      const below = rect.bottom + gap;
+      const top = below + height <= innerHeight - edge ? below : rect.top - gap - height;
+      preview.style.margin = '0';
+      preview.style.inset = 'auto';
+      preview.style.left = `${Math.max(edge, Math.min(rect.left, innerWidth - width - edge))}px`;
+      preview.style.top = `${Math.max(edge, Math.min(top, innerHeight - height - edge))}px`;
+    }
+
+    for (const preview of previews) {
+      preview.addEventListener('beforetoggle', (event) => {
+        if (event.newState !== 'open') return;
+        // Also covers engines that interpret hint as a manual popover.
+        for (const other of previews) {
+          if (other !== preview && isOpen(other)) other.hidePopover();
+        }
+      });
+      preview.addEventListener('toggle', () => positionPreview(preview));
+      preview.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') preview.querySelector('details').open = false;
+      });
+      preview.querySelector('details').addEventListener('toggle', () => positionPreview(preview));
+    }
+    const reposition = () => previews.forEach(positionPreview);
+    window.addEventListener('resize', reposition);
+    window.addEventListener('scroll', reposition, { passive: true, capture: true });
+  </script>
 </body>
 
