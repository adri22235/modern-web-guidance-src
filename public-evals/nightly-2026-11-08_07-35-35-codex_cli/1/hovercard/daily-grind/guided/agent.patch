+    [interestfor] {
+      --interest-delay-start: 0.25s;
+      --interest-delay-end: 0.35s;
+      interest-delay: var(--interest-delay-start) var(--interest-delay-end);
+    }
+
+    .drink-preview {
+      display: none;
+      position: fixed;
+      width: min(340px, calc(100vw - 24px));
+      max-height: calc(100dvh - 24px);
+      overflow: auto;
+      padding: 22px;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 10px;
+      background: white;
+      color: var(--text);
+      text-align: left;
+      box-shadow: 0 12px 36px rgb(62 39 35 / 20%);
+    }
+
+    .drink-preview:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .drink-preview .eyebrow {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .drink-preview h4 {
+      margin: 4px 0 8px;
+      font-size: 1.25rem;
+    }
+
+    .drink-preview details {
+      margin-top: 16px;
+      padding-top: 12px;
+      border-top: 1px solid var(--secondary);
+    }
+
+    .drink-preview summary {
+      cursor: pointer;
+      font-weight: 600;
+      padding: 4px 0;
+    }
+
+    .drink-preview dl {
+      display: grid;
+      grid-template-columns: auto 1fr;
+      gap: 6px 16px;
+      margin-top: 10px;
+      font-size: 0.9rem;
+    }
+
+    .drink-preview dt { font-weight: 600; }
+
+    .btn:focus-visible,
+    .drink-preview summary:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @supports (position-area: block-end) {
+      .drink-preview {
+        inset: auto;
+        margin: 8px 0;
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .drink-preview {
+        transition: opacity 0.15s, display 0.15s, overlay 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      @starting-style {
+        .drink-preview:is(:popover-open, .\:popover-open) { opacity: 0; }
+      }
+    }
+
