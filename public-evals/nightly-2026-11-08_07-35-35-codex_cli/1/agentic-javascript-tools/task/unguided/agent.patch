--- a/index.html
+++ b/index.html
@@ -206,7 +206,79 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Prefer the current WebMCP API, with support for older implementations.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+      const tool = {
+        name: 'get_menu_item',
+        description: 'Look up a Daily Grind menu item and return its name, description, and details link. Use when a user asks about a specific drink.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              description: 'The menu item to look up, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew. Matching ignores case and extra whitespace.',
+              minLength: 1
+            }
+          },
+          required: ['itemName'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        execute(input) {
+          if (!input || typeof input.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty itemName to look up a menu item.' };
+          }
+
+          // Read the displayed menu so returned details stay in sync with the page.
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find((entry) => normalizeName(entry.name) === normalizeName(input.itemName));
+          return item ?? {
+            error: `Menu item "${input.itemName}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        }
+      };
+
+      let registration;
+
+      async function registerMenuTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = undefined;
+          if (!controller.signal.aborted) console.warn('Menu tool registration failed:', error);
+        }
+      }
+
+      function cleanupMenuTool() {
+        if (!registration) return;
+        registration.abort();
+        registration = undefined;
+        // Older navigator.modelContext implementations use explicit removal.
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(tool.name);
+        }
+      }
+
+      window.addEventListener('pagehide', cleanupMenuTool);
+      window.addEventListener('pageshow', registerMenuTool);
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
