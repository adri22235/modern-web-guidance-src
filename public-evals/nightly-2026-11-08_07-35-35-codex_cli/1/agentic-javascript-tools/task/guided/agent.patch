         <div class="card">
           <h3>Maple Oat Latte</h3>
           <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
           <a href="/menu/seasonal" class="btn">View Details</a>
@@ -206,7 +206,79 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const modelContext = document.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      let registrationController;
+
+      async function registerMenuTool() {
+        if (registrationController) return;
+        const controller = new AbortController();
+        registrationController = controller;
+
+        try {
+          await modelContext.registerTool({
+            name: 'get_menu_item',
+            description: 'Look up a menu item and return its description and details link. Use when someone asks about a drink on the menu.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                itemName: {
+                  type: 'string',
+                  minLength: 1,
+                  description: 'The menu item’s displayed name, such as Maple Oat Latte. Matching ignores letter case and surrounding spaces.'
+                }
+              },
+              required: ['itemName'],
+              additionalProperties: false
+            },
+            execute(input) {
+              if (!input || typeof input !== 'object' || Array.isArray(input) ||
+                  typeof input.itemName !== 'string' || !input.itemName.trim() ||
+                  Object.keys(input).some((key) => key !== 'itemName')) {
+                return { error: 'Provide a non-empty itemName containing the menu item’s name.' };
+              }
+
+              // Read the displayed menu so tool results stay in sync with the page.
+              const items = Array.from(document.querySelectorAll('#menu-items .card'), (card) => ({
+                name: card.querySelector('h3').textContent.trim(),
+                description: card.querySelector('p').textContent.trim(),
+                detailsUrl: card.querySelector('a').href
+              }));
+              const requestedName = input.itemName.trim().toLowerCase();
+              const item = items.find((entry) => entry.name.toLowerCase() === requestedName);
+
+              return item ?? {
+                error: `Menu item "${input.itemName.trim()}" not found.`,
+                availableItems: items.map((entry) => entry.name)
+              };
+            },
+            annotations: { readOnlyHint: true }
+          }, { signal: controller.signal });
+        } catch (error) {
+          if (!controller.signal.aborted) {
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+          controller.abort();
+          if (registrationController === controller) registrationController = undefined;
+        }
+      }
+
+      window.addEventListener('pagehide', () => {
+        registrationController?.abort();
+        registrationController = undefined;
+      });
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuTool();
+      });
+
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
