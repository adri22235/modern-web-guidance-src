+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </article>
+  </template>
+
+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const menuStatus = document.getElementById('menu-status');
+
+    // If native patching already ran, the placeholders are gone. Otherwise,
+    // clone only this document's authored template for older browsers.
+    const initialCards = document.querySelector('template[data-initial-seasonal]');
+    if (cards.querySelector('.placeholder') && initialCards) {
+      cards.replaceChildren(document.importNode(initialCards.content, true));
+      initialCards.remove();
+    }
+
+    /* Server contract (all URLs are same-origin):
+       GET /api/menu/seasonal: text/html, card children only, no page wrapper.
+       GET /api/menu/events: text/event-stream; send event: menu-changed after
+         each menu change. EventSource reconnects; on open we also catch up.
+       GET /api/reviews: text/html containing customer-submitted review markup.
+       GET /api/cms/seasonal-promo: text/html from our trusted CMS ONLY, including
+         its widget <script>. Never mix customer content into this endpoint.
+       Serve fragments with an HTML Content-Type and non-2xx on errors.
+       This static repository supplies no API implementations.
+    */
+    async function fetchHTML(url) {
+      const response = await fetch(url, {
+        headers: { Accept: 'text/html' },
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        signal: AbortSignal.timeout(15000),
+      });
+      if (!response.ok || !/^text\/html(?:;|$)/i.test(response.headers.get('Content-Type') || '')) {
+        throw new Error('HTML fragment unavailable');
+      }
+      return response;
+    }
+
+    // Serialize and coalesce notifications so an older response cannot replace
+    // a newer menu. Keep the section, heading, and grid element in place.
+    let refreshing = false;
+    let refreshPending = false;
+    async function refreshSeasonalMenu() {
+      refreshPending = true;
+      if (refreshing) return;
+      refreshing = true;
+      try {
+        while (refreshPending) {
+          refreshPending = false;
+          if (typeof cards.streamHTML !== 'function' && typeof cards.setHTML !== 'function') {
+            menuStatus.textContent = 'Use the seasonal menu link for the latest favorites.';
+            break;
+          }
+          const previousCards = Array.from(cards.childNodes, node => node.cloneNode(true));
+          const focusedLink = cards.contains(document.activeElement)
+            ? document.activeElement.getAttribute('href') : null;
+          cards.setAttribute('aria-busy', 'true');
+          menuStatus.textContent = 'Refreshing seasonal favorites…';
+          try {
+            const response = await fetchHTML('/api/menu/seasonal');
+            if (response.body && typeof cards.streamHTML === 'function' && 'TextDecoderStream' in window) {
+              // Safe native streaming strips scripts and unsafe attributes.
+              await response.body.pipeThrough(new TextDecoderStream()).pipeTo(cards.streamHTML());
+            } else {
+              cards.setHTML(await response.text());
+            }
+            menuStatus.textContent = 'Seasonal favorites are up to date.';
+          } catch {
+            cards.replaceChildren(...previousCards);
+            menuStatus.textContent = 'Unable to refresh favorites. Please use the seasonal menu link.';
+          } finally {
+            cards.setAttribute('aria-busy', 'false');
+            // Restore focus only if replacement removed the focused link and
+            // the visitor has not moved focus elsewhere during the request.
+            if (focusedLink && document.activeElement === document.body) {
+              const replacement = Array.from(cards.querySelectorAll('a'))
+                .find(link => link.getAttribute('href') === focusedLink);
+              replacement?.focus();
+            }
+          }
+        }
+      } finally {
+        refreshing = false;
+      }
+    }
+
+    // Existing app code can also notify us without opening another connection.
+    document.addEventListener('menu:changed', refreshSeasonalMenu);
+    if ('EventSource' in window) {
+      let menuEvents;
+      function connectMenuEvents() {
+        menuEvents = new EventSource('/api/menu/events');
+        menuEvents.addEventListener('menu-changed', refreshSeasonalMenu);
+        menuEvents.addEventListener('open', refreshSeasonalMenu);
+        menuEvents.addEventListener('error', () => {
+          menuStatus.textContent = 'Live menu updates are reconnecting. You can also use the seasonal menu link.';
+        });
+      }
+      connectMenuEvents();
+      window.addEventListener('pagehide', () => menuEvents.close());
+      window.addEventListener('pageshow', event => {
+        if (event.persisted) connectMenuEvents();
+      });
+    } else {
+      refreshSeasonalMenu();
+    }
+
+    async function loadReviews() {
+      const reviews = document.getElementById('customer-reviews');
+      const status = document.getElementById('reviews-status');
+      try {
+        // Customer HTML is always untrusted. The safe setter uses the native
+        // sanitizer; never fall back to innerHTML or a script-enabled setter.
+        if (typeof reviews.setHTML !== 'function') throw new Error('Safe HTML insertion unavailable');
+        const response = await fetchHTML('/api/reviews');
+        reviews.setHTML(await response.text());
+      } catch {
+        reviews.textContent = 'Customer reviews are available through the link below.';
+        status.textContent = 'Reviews could not be loaded here.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    async function loadPromo() {
+      const promo = document.getElementById('cms-promo');
+      const status = document.getElementById('promo-status');
+      try {
+        if (typeof promo.setHTMLUnsafe !== 'function') throw new Error('HTML insertion unavailable');
+        // This fixed endpoint is a code trust boundary: only our CMS editors
+        // may publish here. Script execution is explicitly enabled only here.
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        promo.setHTMLUnsafe(await response.text(), { runScripts: true });
+      } catch {
+        promo.textContent = 'Discover our latest offers through the rewards link below.';
+        status.textContent = 'The latest offer could not be loaded here.';
+      } finally {
+        promo.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    loadReviews();
+    loadPromo();
+  </script>
