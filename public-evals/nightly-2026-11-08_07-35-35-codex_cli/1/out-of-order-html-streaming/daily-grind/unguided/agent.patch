+  <!--
+    In a streaming server response, flush the shell above before waiting for the
+    menu. Emit this trusted template later, before closing the same document.
+    The body-level template can reach the nested seasonal-cards marker range.
+    Customer submissions must never be interpolated into this raw template.
+  -->
+  <template for="seasonal-cards" data-initial-seasonal>
+    <article class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smoky, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Cold Brew</h3>
