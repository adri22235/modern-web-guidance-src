+  <script type="module">
+    // Server contract (same-origin; HTML endpoints return text/html fragments):
+    // GET /api/menu/seasonal: coffee card children, without the grid wrapper.
+    // GET /api/menu/events: text/event-stream; emit `event: menu-change` with
+    // a data line on each change. EventSource reconnects automatically.
+    // GET /api/reviews/seasonal: customer HTML; always sanitize on insertion.
+    // GET /api/cms/seasonal-promo: trusted, editorial CMS HTML including its
+    // widget script. This endpoint MUST NOT include customer-authored markup.
+    // The static host does not implement these endpoints; keep the initial
+    // cards and rewards link available if any request fails.
+    const nativeSetHTML = Element.prototype.setHTML;
+    const nativeStreamHTML = Element.prototype.streamHTML;
+    const cards = document.getElementById('seasonal-cards');
+    const status = document.getElementById('menu-status');
+    const refreshButton = document.getElementById('refresh-menu');
+    let purifierPromise;
+
+    async function safeSetHTML(target, html) {
+      if (nativeSetHTML) {
+        nativeSetHTML.call(target, html);
+      } else {
+        purifierPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.3.0/+esm');
+        const { default: DOMPurify } = await purifierPromise;
+        target.replaceChildren(DOMPurify.sanitize(html, { RETURN_DOM_FRAGMENT: true }));
+      }
+    }
+
+    // Keep processing instructions intact: unsupported parsers treat them as
+    // comments, which this polyfill recognizes. Native browsers need no shim.
+    if (!('htmlFor' in HTMLTemplateElement.prototype)) {
+      try {
+        await import('https://cdn.jsdelivr.net/npm/template-for-polyfill@0.1.1/dist/template-for-polyfill.js');
+      } catch {
+        // The initial card fragment is authored in this document and inert.
+        const initialCards = document.querySelector('template[for="seasonal-cards"]');
+        if (initialCards) {
+          cards.replaceChildren(initialCards.content.cloneNode(true));
+          initialCards.remove();
+        }
+      }
+    }
 
+    async function fetchHTML(path, signal) {
+      const response = await fetch(path, {
+        signal, cache: 'no-store', credentials: 'same-origin', redirect: 'error',
+        headers: { Accept: 'text/html' }
+      });
+      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('HTML fragment unavailable');
+      }
+      // Never permit a redirect to turn the trusted CMS path into another origin.
+      if (new URL(response.url).origin !== location.origin) throw new Error('Unexpected origin');
+      return response;
+    }
+
+    let refreshing = false;
+    let refreshPending = false;
+    async function refreshMenu() {
+      // Serialize updates and retain changes received while a request is running.
+      if (refreshing) { refreshPending = true; return; }
+      // Preserve the focused card link until the visitor has moved away.
+      if (cards.contains(document.activeElement)) { refreshPending = true; return; }
+      refreshing = true;
+      refreshPending = false;
+      refreshButton.disabled = true;
+      cards.setAttribute('aria-busy', 'true');
+      status.textContent = 'Updating seasonal coffees…';
+      try {
+        const response = await fetchHTML('/api/menu/seasonal');
+        // Stage the response so a failed stream leaves the current menu intact.
+        const next = document.createElement('div');
+        if (nativeStreamHTML && response.body) {
+          await response.body.pipeThrough(new TextDecoderStream()).pipeTo(nativeStreamHTML.call(next));
+        } else {
+          await safeSetHTML(next, await response.text());
+        }
+        if (!next.querySelector('.card')) throw new Error('Empty menu');
+        if (cards.contains(document.activeElement)) {
+          refreshPending = true;
+          status.textContent = 'Menu update ready; waiting until you leave the cards.';
+        } else {
+          cards.replaceChildren(...next.childNodes);
+          status.textContent = 'Seasonal menu updated.';
+        }
+      } catch {
+        status.textContent = 'The menu could not be refreshed. Please try again.';
+      } finally {
+        refreshing = false;
+        refreshButton.disabled = false;
+        cards.removeAttribute('aria-busy');
+        if (refreshPending && !cards.contains(document.activeElement)) void refreshMenu();
+      }
+    }
+    refreshButton.addEventListener('click', refreshMenu);
+    cards.addEventListener('focusout', () => {
+      setTimeout(() => {
+        if (refreshPending && !cards.contains(document.activeElement)) void refreshMenu();
+      }, 0);
+    });
+    // Other same-page menu editors can dispatch this event after saving changes.
+    window.addEventListener('menu-change', refreshMenu);
+    if ('EventSource' in window) {
+      const menuEvents = new EventSource('/api/menu/events');
+      menuEvents.addEventListener('menu-change', refreshMenu);
+      // Revalidate on connection/reconnection to catch changes missed offline.
+      menuEvents.addEventListener('open', refreshMenu);
+      window.addEventListener('pagehide', () => menuEvents.close(), { once: true });
+    }
+
+    async function loadReviews() {
+      const target = document.getElementById('customer-reviews');
+      try {
+        const response = await fetchHTML('/api/reviews/seasonal');
+        // Never use an unsafe setter or runScripts for customer submissions.
+        await safeSetHTML(target, await response.text());
+      } catch {
+        target.textContent = 'Customer reviews are currently unavailable.';
+      }
+    }
+
+    async function loadPromo() {
+      try {
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        const target = document.getElementById('cms-promo');
+        if (!('streamHTMLUnsafe' in target)) {
+          await import('https://cdn.jsdelivr.net/npm/html-setters-polyfill@0.1.1/index.js');
+        }
+        // Only this trusted CMS fragment may execute embedded widget scripts.
+        // The polyfill buffers until close; native support renders incrementally.
+        if (response.body) {
+          await response.body.pipeThrough(new TextDecoderStream())
+            .pipeTo(target.streamHTMLUnsafe({ runScripts: true }));
+        } else {
+          target.setHTMLUnsafe(await response.text(), { runScripts: true });
+        }
+      } catch {
+        // Retain the useful rewards promo when the CMS is unavailable.
+      }
+    }
+    void loadReviews();
+    void loadPromo();
+  </script>
