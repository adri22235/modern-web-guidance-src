+  <script>
+    // Older browsers use WCAG relative luminance to choose the higher-contrast
+    // foreground. Poll computed backgrounds to also catch CSSOM/theme changes.
+    if (!CSS.supports('color', 'contrast-color(#000)')) {
+      const root = document.documentElement;
+      const context = document.createElement('canvas').getContext('2d', {
+        willReadFrequently: true
+      });
+      const surfaces = [
+        [document.querySelector('nav'), '--on-primary'],
+        [document.querySelector('footer'), '--on-secondary']
+      ];
+      const previous = new Map();
+
+      function updateContrast() {
+        for (const [element, property] of surfaces) {
+          const background = getComputedStyle(element).backgroundColor;
+          if (previous.get(property) === background) continue;
+          previous.set(property, background);
+          context.clearRect(0, 0, 1, 1);
+          context.fillStyle = background;
+          context.fillRect(0, 0, 1, 1);
+          const channels = context.getImageData(0, 0, 1, 1).data;
+          const linear = Array.from(channels).slice(0, 3).map(channel => {
+            const value = channel / 255;
+            return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+          });
+          const luminance = linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722;
+          const blackContrast = (luminance + 0.05) / 0.05;
+          const whiteContrast = 1.05 / (luminance + 0.05);
+          root.style.setProperty(property, blackContrast >= whiteContrast ? '#000' : '#fff');
+        }
+        requestAnimationFrame(updateContrast);
+      }
+
+      updateContrast();
+    }
+  </script>
+
