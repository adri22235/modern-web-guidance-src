+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    let positionFrame;
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? document.documentElement.clientHeight) - 16;
+      const anchor = trigger.getBoundingClientRect();
+
+      // Measure the full panel before choosing the side with enough space.
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+      const naturalHeight = panel.getBoundingClientRect().height;
+      const below = Math.max(0, bottomEdge - Math.max(topEdge, anchor.bottom));
+      const above = Math.max(0, Math.min(bottomEdge, anchor.top) - topEdge);
+      const flipUp = naturalHeight > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+
+      const { width, height } = panel.getBoundingClientRect();
+      // Start below, left-aligned; flip to right-aligned on horizontal collision.
+      let left = anchor.left;
+      if (left + width > rightEdge) left = anchor.right - width;
+      left = Math.max(leftEdge, Math.min(left, rightEdge - width));
+      const top = flipUp ? anchor.top - height : anchor.bottom;
+      panel.style.left = `${left}px`;
+      panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`;
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      if (event.newState === 'open') schedulePosition();
+    });
+    window.addEventListener('resize', schedulePosition);
+    window.addEventListener('scroll', schedulePosition, { capture: true, passive: true });
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const resizeObserver = new ResizeObserver(schedulePosition);
+    resizeObserver.observe(trigger);
+    resizeObserver.observe(panel);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
