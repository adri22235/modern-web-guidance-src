+  <script type="module">
+    // Only older browsers download the Popover API compatibility layer.
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.js');
+    }
+
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const nativeAnchors = CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block');
+    let isOpen = false;
+
+    function positionPanel() {
+      if (!isOpen) return;
+
+      const rect = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? document.documentElement.clientHeight) - 16;
+      const below = Math.max(0, bottomEdge - rect.bottom);
+      const above = Math.max(0, rect.top - topEdge);
+
+      panel.style.width = `${Math.max(0, Math.min(240, rightEdge - leftEdge))}px`;
+      panel.style.setProperty('--panel-max-height', `${Math.max(above, below)}px`);
+      const width = panel.getBoundingClientRect().width;
+      const fitsLeft = rect.left >= leftEdge && rect.left + width <= rightEdge;
+      const fitsRight = rect.right - width >= leftEdge && rect.right <= rightEdge;
+      const needsFallback = !nativeAnchors || (!fitsLeft && !fitsRight) ||
+        rect.top < topEdge || rect.bottom > bottomEdge || (viewport?.scale ?? 1) !== 1;
+
+      panel.classList.toggle('positioned-fallback', needsFallback);
+      if (!needsFallback) return;
+
+      const height = panel.getBoundingClientRect().height;
+      const left = fitsLeft ? rect.left : fitsRight ? rect.right - width :
+        Math.max(leftEdge, Math.min(rect.left, rightEdge - width));
+      const top = height <= below || below >= above ? rect.bottom : rect.top - height;
+      panel.style.setProperty('--panel-left', `${left}px`);
+      panel.style.setProperty('--panel-top', `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`);
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      isOpen = event.newState === 'open';
+      if (isOpen) requestAnimationFrame(positionPanel);
+    });
+    panel.addEventListener('toggle', (event) => {
+      isOpen = event.newState === 'open';
+      positionPanel();
+    });
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, { capture: true, passive: true });
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    const observer = new ResizeObserver(positionPanel);
+    observer.observe(trigger);
+    observer.observe(panel);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (action) window.location.assign(action.dataset.href);
+    });
+  </script>
