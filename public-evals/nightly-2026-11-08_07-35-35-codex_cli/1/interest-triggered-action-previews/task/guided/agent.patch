+  <script type="module">
+    const preview = document.getElementById('seasonal-preview');
+    let activeSource = null;
+
+    preview.addEventListener('interest', (event) => {
+      const source = event.source;
+      if (!source?.dataset.drink) return;
+
+      activeSource = source;
+      preview.textContent = source.dataset.drink;
+      preview.style.setProperty('--preview-accent', source.dataset.accent);
+    });
+
+    preview.addEventListener('loseinterest', (event) => {
+      if (event.source !== activeSource) return;
+
+      activeSource = null;
+      preview.textContent = 'Select a drink to preview';
+      preview.style.removeProperty('--preview-accent');
+    });
+
+    // This static site has no bundler; load a pinned polyfill only when needed.
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement')) {
+      await import('https://unpkg.com/interestfor@1.0.12/src/interestfor.min.js');
+    }
+  </script>
