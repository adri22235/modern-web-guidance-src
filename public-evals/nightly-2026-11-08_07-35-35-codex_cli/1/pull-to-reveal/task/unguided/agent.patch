+  <script>
+    const search = document.querySelector('.site-search');
+
+    function startAtNavigation() {
+      // Keep direct links to sections intact.
+      if (!window.location.hash) {
+        window.scrollTo({ top: search.offsetTop + search.offsetHeight, behavior: 'instant' });
+      }
+    }
+
+    startAtNavigation();
+    window.addEventListener('pageshow', (event) => {
+      if (!event.persisted) startAtNavigation();
+    });
+
+    // Keyboard users should see the entire form when tabbing into search.
+    search.addEventListener('focusin', () => {
+      search.scrollIntoView({ block: 'start', behavior: 'instant' });
+    });
