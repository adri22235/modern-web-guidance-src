+  <script type="module">
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const status = document.getElementById('registration-status');
+    let registering = false;
+
+    async function initializePasskeys() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+        status.textContent = 'Passkeys require a supported browser and a secure connection.';
+        return;
+      }
+
+      try {
+        // Load only the JSON polyfills; preserve native implementations when available.
+        if (!PublicKeyCredential.parseCreationOptionsFromJSON || !PublicKeyCredential.prototype.toJSON) {
+          await import('./node_modules/webauthn-polyfills/esm/json_serialization.js');
+        }
+
+        const capabilities = typeof PublicKeyCredential.getClientCapabilities === 'function'
+          ? await PublicKeyCredential.getClientCapabilities()
+          : {
+              conditionalGet: await PublicKeyCredential.isConditionalMediationAvailable?.(),
+              passkeyPlatformAuthenticator:
+                await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.(),
+            };
+        if (!capabilities.conditionalGet || !capabilities.passkeyPlatformAuthenticator) {
+          status.textContent = 'Passkey creation is unavailable on this device or browser.';
+          return;
+        }
+
+        registerButton.disabled = false;
+        status.textContent = '';
+      } catch {
+        status.textContent = 'Unable to check passkey support. Please reload to try again.';
+      }
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        mode: 'same-origin',
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registering || registerButton.disabled) return;
+      registering = true;
+      registerButton.disabled = true;
+      status.textContent = 'Follow your device’s instructions to create a passkey…';
+
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        if (!optionsResponse.ok) throw new Error('Options request failed');
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+        // Use the server's challenge, RP ID, and credential policy without modification.
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential) {
+          status.textContent = 'No passkey was created. You can try again.';
+          return;
+        }
+        const encodedResponse = credential.toJSON();
+
+        // Only verification failures should signal an orphaned credential, never prompt cancellations.
+        try {
+          const verification = await postJSON('/api/register/verify', encodedResponse);
+          if (!verification.ok) throw new Error('Verification request failed');
+          // Accept empty successful responses, but honor an explicit rejection in a JSON body.
+          const result = await verification.text();
+          if (result && JSON.parse(result).verified === false) {
+            throw new Error('Registration rejected');
+          }
+        } catch {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function' && publicKey.rp.id) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rp.id,
+                credentialId: encodedResponse.id,
+              });
+            } catch {
+              // Password-manager synchronization must not hide the verification error.
+            }
+          }
+          status.textContent = 'Registration could not be verified. Please try again.';
+          return;
+        }
+
+        status.textContent = 'Passkey created successfully.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey creation is unavailable because of a secure connection or domain configuration issue.',
+        };
+        status.textContent = messages[error.name] || 'Unable to create a passkey. Please try again.';
+      } finally {
+        registering = false;
+        registerButton.disabled = false;
+      }
+    });
+
+    initializePasskeys();
+  </script>
