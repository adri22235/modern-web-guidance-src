+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('register-status');
+      let registering = false;
+
+      function decodeBase64url(value) {
+        if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value)) {
+          throw new Error('Invalid registration options.');
+        }
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const binary = atob(base64 + '='.repeat((4 - base64.length % 4) % 4));
+        return Uint8Array.from(binary, character => character.charCodeAt(0));
+      }
+
+      function encodeBase64url(value) {
+        const bytes = new Uint8Array(value);
+        let binary = '';
+        for (const byte of bytes) binary += String.fromCharCode(byte);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseOptions(options) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        }
+        const publicKey = {
+          ...options,
+          challenge: decodeBase64url(options.challenge),
+          user: { ...options.user, id: decodeBase64url(options.user.id) },
+          excludeCredentials: (options.excludeCredentials || []).map(credential => ({
+            ...credential,
+            id: decodeBase64url(credential.id)
+          }))
+        };
+        // PRF inputs are the binary extension inputs used during registration.
+        if (options.extensions?.prf?.eval) {
+          const { first, second } = options.extensions.prf.eval;
+          publicKey.extensions = {
+            ...options.extensions,
+            prf: {
+              ...options.extensions.prf,
+              eval: {
+                first: decodeBase64url(first),
+                ...(second === undefined ? {} : { second: decodeBase64url(second) })
+              }
+            }
+          };
+        }
+        return publicKey;
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        return {
+          id: credential.id,
+          rawId: encodeBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+            attestationObject: encodeBase64url(credential.response.attestationObject),
+            transports: credential.response.getTransports?.() || []
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+      }
+
+      async function postJSON(url, body) {
+        const response = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          mode: 'same-origin',
+          redirect: 'error',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body, (key, value) => {
+            // Older browsers can return binary PRF extension results.
+            if (value instanceof ArrayBuffer) return encodeBase64url(value);
+            if (ArrayBuffer.isView(value)) {
+              return encodeBase64url(value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength));
+            }
+            return value;
+          })
+        });
+        if (!response.ok) throw new Error('Registration request failed.');
+        return response.json();
+      }
+
+      button.addEventListener('click', async () => {
+        if (registering) return;
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+          status.textContent = 'Passkeys require a supported browser and a secure connection (HTTPS).';
+          return;
+        }
+
+        registering = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        status.textContent = 'Follow your device’s instructions to create a passkey.';
+        try {
+          const options = await postJSON('/api/register/options', { promotion: true });
+          const credential = await navigator.credentials.create({ publicKey: parseOptions(options.publicKey || options) });
+          if (!credential || credential.type !== 'public-key') {
+            throw new Error('No passkey was created.');
+          }
+          status.textContent = 'Verifying your passkey…';
+          // Only the server can validate the challenge, origin, RP ID and attestation.
+          const result = await postJSON('/api/register/verify', serializeCredential(credential));
+          if (result.verified !== true) throw new Error('Registration was not verified.');
+          status.textContent = 'Your passkey was created successfully.';
+        } catch (error) {
+          if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+            status.textContent = 'Passkey creation was canceled or timed out. You can try again.';
+          } else if (error.name === 'InvalidStateError') {
+            status.textContent = 'A passkey for this account already exists on this device.';
+          } else {
+            status.textContent = 'We couldn’t register your passkey. Please try again.';
+          }
+        } finally {
+          registering = false;
+          button.disabled = false;
+          button.removeAttribute('aria-busy');
+        }
+      });
+    })();
+  </script>
