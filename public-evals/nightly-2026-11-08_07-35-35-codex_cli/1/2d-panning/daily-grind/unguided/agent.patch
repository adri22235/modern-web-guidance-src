+<script>
+    const map = document.querySelector('.map-viewport');
+    const pins = [...document.querySelectorAll('.map-pin')];
+    let gesture = null;
+    let suppressClick = false;
+
+    function resetMap() {
+      map.scrollLeft = 780 - map.clientWidth / 2;
+      map.scrollTop = 490 - map.clientHeight / 2;
+    }
+
+    document.querySelector('.map-reset').addEventListener('click', resetMap);
+    resetMap();
+
+    map.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0) return;
+      suppressClick = false;
+      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY,
+        lastX: event.clientX, lastY: event.clientY, dragging: false };
+    });
+
+    map.addEventListener('pointermove', (event) => {
+      if (!gesture || event.pointerId !== gesture.id) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.dragging && Math.hypot(dx, dy) < 4) return;
+      gesture.dragging = true;
+      suppressClick = true;
+      map.setPointerCapture(event.pointerId);
+      map.classList.add('is-dragging');
+      // Both coordinates are updated on every move: no dominant-axis lock.
+      map.scrollLeft -= event.clientX - gesture.lastX;
+      map.scrollTop -= event.clientY - gesture.lastY;
+      gesture.lastX = event.clientX;
+      gesture.lastY = event.clientY;
+    });
+
+    function endGesture(event) {
+      if (!gesture || event.pointerId !== gesture.id) return;
+      if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+      gesture = null;
+      map.classList.remove('is-dragging');
+    }
+    window.addEventListener('pointerup', endGesture);
+    window.addEventListener('pointercancel', endGesture);
+    map.addEventListener('lostpointercapture', endGesture);
+    map.addEventListener('click', (event) => {
+      if (suppressClick && event.detail !== 0) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+      }
+    }, true);
+
+    map.addEventListener('wheel', (event) => {
+      if (event.ctrlKey) return; // Preserve browser pinch-to-zoom.
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientHeight : 1;
+      const dx = event.shiftKey && event.deltaX === 0 ? event.deltaY : event.deltaX;
+      const dy = event.shiftKey && event.deltaX === 0 ? 0 : event.deltaY;
+      map.scrollLeft += dx * unit;
+      map.scrollTop += dy * unit;
+      event.preventDefault();
+    }, { passive: false });
+
+    pins.forEach((pin) => pin.addEventListener('click', () => {
+      pins.forEach((other) => other.setAttribute('aria-pressed', String(other === pin)));
+      document.querySelector('#location-name').textContent = pin.querySelector('span').textContent;
+      document.querySelector('#location-description').textContent = pin.dataset.description;
+    }));
+  </script>
