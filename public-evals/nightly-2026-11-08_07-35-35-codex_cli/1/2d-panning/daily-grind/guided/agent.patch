+  <script>
+    (() => {
+      const viewport = document.getElementById('cafe-map');
+      const reset = document.getElementById('map-reset');
+      const needsFallback = !CSS.supports('scroll-axis-lock', 'none');
+      let pointer = null;
+
+      const centerMap = () => {
+        viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
+        viewport.scrollTop = (viewport.scrollHeight - viewport.clientHeight) / 2;
+      };
+      centerMap();
+      reset.hidden = false;
+      reset.addEventListener('click', centerMap);
+
+      if (needsFallback) {
+        viewport.classList.add('has-pan-fallback');
+        viewport.addEventListener('wheel', (event) => {
+          // Preserve browser zoom, including trackpad pinch gestures.
+          if (event.ctrlKey) return;
+          event.preventDefault();
+          const lineHeight = parseFloat(getComputedStyle(viewport).lineHeight) || 24;
+          const unitX = event.deltaMode === 1 ? lineHeight : event.deltaMode === 2 ? viewport.clientWidth : 1;
+          const unitY = event.deltaMode === 1 ? lineHeight : event.deltaMode === 2 ? viewport.clientHeight : 1;
+          viewport.scrollLeft += event.deltaX * unitX;
+          viewport.scrollTop += event.deltaY * unitY;
+        }, { passive: false });
+      }
+
+      const endPan = () => {
+        const pointerId = pointer?.id;
+        pointer = null;
+        viewport.classList.remove('is-panning');
+        if (pointerId !== undefined && viewport.hasPointerCapture(pointerId)) {
+          viewport.releasePointerCapture(pointerId);
+        }
+      };
+
+      viewport.addEventListener('pointerdown', (event) => {
+        // Leave touch to native scrolling when supported, and preserve pinch zoom.
+        if (!event.isPrimary) {
+          endPan();
+          return;
+        }
+        if (event.button !== 0 || (!needsFallback && event.pointerType !== 'mouse')) return;
+        const rect = viewport.getBoundingClientRect();
+        const x = event.clientX - rect.left - viewport.clientLeft;
+        const y = event.clientY - rect.top - viewport.clientTop;
+        if (x < 0 || y < 0 || x >= viewport.clientWidth || y >= viewport.clientHeight) return;
+        viewport.focus({ preventScroll: true });
+        pointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
+        viewport.setPointerCapture(event.pointerId);
+        viewport.classList.add('is-panning');
+      });
+
+      viewport.addEventListener('pointermove', (event) => {
+        if (!pointer || event.pointerId !== pointer.id) return;
+        // Apply both raw deltas on every move, even after a direction change.
+        viewport.scrollLeft -= event.clientX - pointer.x;
+        viewport.scrollTop -= event.clientY - pointer.y;
+        pointer.x = event.clientX;
+        pointer.y = event.clientY;
+      });
+
+      for (const type of ['pointerup', 'pointercancel', 'lostpointercapture']) {
+        viewport.addEventListener(type, (event) => {
+          if (event.pointerId === pointer?.id) endPan();
+        });
+      }
+    })();
+  </script>
+
