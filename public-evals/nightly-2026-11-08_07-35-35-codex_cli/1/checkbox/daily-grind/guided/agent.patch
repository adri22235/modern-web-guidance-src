+    /* Keep the native inputs interactive; customize only their presentation. */
+    .customizations {
+      min-inline-size: 0;
+      margin-block-start: 20px;
+      padding: 16px 0 0;
+      border: 0;
+      border-block-start: 1px solid var(--secondary);
