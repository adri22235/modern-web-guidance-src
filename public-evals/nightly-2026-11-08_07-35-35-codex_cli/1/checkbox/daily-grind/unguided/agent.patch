+    /* Native inputs keep keyboard, label, and form behavior. */
+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .card > p {
+      flex-grow: 1;
+    }
+
+    .customizations {
+      min-width: 0;
+      margin-top: 24px;
+      padding: 18px 0 0;
+      border: 0;
+      border-top: 1px solid var(--secondary);
+      text-align: left;
+    }
+
+    .customizations legend {
+      padding-right: 10px;
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.1em;
+      text-transform: uppercase;
+    }
+
+    .customization-hint {
+      margin-bottom: 12px;
+      color: #735d55;
+      font-size: 0.8rem;
+    }
+
+    .customization-option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      margin-top: 8px;
+      padding: 10px 12px;
+      border: 1px solid #e8ded8;
+      border-radius: 8px;
+      background: #fcf9f5;
+      cursor: pointer;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization-option:hover {
+      background: #f5ede4;
+      border-color: #ad8b72;
+    }
+
+    .customization-option:has(input:checked) {
+      background: #fff0d9;
+      border-color: #ae7130;
+    }
+
+    .customization-option:has(input:disabled) {
+      opacity: 0.55;
+      cursor: not-allowed;
+    }
+
+    .customization-option input {
+      appearance: none;
+      -webkit-appearance: none;
+      flex: 0 0 20px;
+      width: 20px;
+      height: 20px;
+      margin: 0;
+      border: 1.5px solid #987f72;
+      border-radius: 5px;
+      background: white;
+      cursor: inherit;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization-option input:checked {
+      background: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .customization-option input:focus-visible {
+      outline: 3px solid #99601d;
+      outline-offset: 4px;
+    }
+
+    .checkbox-tick {
+      position: absolute;
+      left: 15px;
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: #fff4df;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 18;
+      stroke-dashoffset: 18;
+      opacity: 0;
+      transform: scale(0.75);
+      pointer-events: none;
+      transition: stroke-dashoffset 200ms ease, opacity 150ms ease, transform 200ms ease;
+    }
+
+    input:checked + .checkbox-tick {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .option-icon {
+      flex: 0 0 20px;
+      width: 20px;
+      height: 20px;
+      margin-left: auto;
+      fill: none;
+      stroke: #936635;
+      stroke-width: 1.6;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      pointer-events: none;
+    }
+
+    .option-name {
+      font-size: 0.85rem;
+      font-weight: 600;
+    }
+
+    .card > .btn {
+      align-self: center;
+      margin-top: 22px;
+    }
+
+    .drink-context {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .icon-library {
+      position: absolute;
+      width: 0;
+      height: 0;
+      overflow: hidden;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization-option,
+      .customization-option input,
+      .checkbox-tick {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization-option input {
+        appearance: auto;
+        -webkit-appearance: auto;
+      }
+
+      .checkbox-tick {
+        display: none;
+      }
+    }
+
     .btn {
