+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const revealButton = document.getElementById('reveal-coupon');
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      revealButton.setAttribute('aria-expanded', 'true');
+      revealButton.textContent = 'Coupon revealed';
+      revealButton.disabled = true;
+    }
+
+    couponPanel.addEventListener('beforematch', revealCoupon);
+    revealButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+
+    // Preserve native search when hidden="until-found" is unsupported.
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      revealCoupon();
+    }
+
+    // Older browsers may support details without supporting exclusive groups.
+    const businessTabs = document.querySelectorAll('.wholesale-tab');
+    businessTabs.forEach((tab) => {
+      tab.addEventListener('toggle', () => {
+        if (tab.open) {
+          businessTabs.forEach((other) => {
+            if (other !== tab) other.open = false;
+          });
+        }
+      });
+    });
+  </script>
