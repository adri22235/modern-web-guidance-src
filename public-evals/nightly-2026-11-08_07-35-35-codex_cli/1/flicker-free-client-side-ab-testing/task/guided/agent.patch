+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f7f8f2">
+  <meta name="description" content="Morrow is a little space for your next big thing. Clear the noise, choose what matters, and find your focus.">
+  <title>Morrow — Make space for good work.</title>
+  <style>
+    /* Only browsers without native render blocking need the visibility guard. */
+    html.ab-loading body { visibility: hidden; }
+    [data-variant="a"] .variant-b, [data-variant="b"] .variant-a { display: none; }
+  </style>
+  <script>
+    (() => {
+      const root = document.documentElement;
+      let variant;
+      try {
+        variant = localStorage.getItem('morrow-hero-variant');
+        if (variant !== 'a' && variant !== 'b') {
+          variant = crypto.getRandomValues(new Uint8Array(1))[0] < 128 ? 'a' : 'b';
+          localStorage.setItem('morrow-hero-variant', variant);
+        }
+      } catch { variant = Math.random() < .5 ? 'a' : 'b'; }
+      // Choose before first paint; the SDK can read or update this assignment.
+      root.dataset.variant = variant;
+      if (!('blocking' in HTMLScriptElement.prototype)) {
+        root.classList.add('ab-loading');
+      }
+      window.onExperimentReady = () => root.classList.remove('ab-loading');
+      document.addEventListener('experiment:ready', window.onExperimentReady, { once: true });
+    })();
+  </script>
+  <!-- SDK must apply visual changes synchronously, or signal experiment:ready.
+       No timeout reveals an unfinished experiment in fallback browsers. -->
+  <script src="https://cdn.example.com/experiment-sdk.js" async blocking="render"
+    onload="onExperimentReady()" onerror="document.documentElement.dataset.experimentStatus='unavailable';onExperimentReady()"></script>
