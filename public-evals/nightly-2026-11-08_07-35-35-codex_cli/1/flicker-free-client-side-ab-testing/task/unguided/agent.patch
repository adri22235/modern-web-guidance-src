+  <script>
+    // Set the guard before any experiment content can paint. Without JS the page is visible.
+    document.documentElement.classList.add('experiment-pending');
+    window.folioExperiment = (() => {
+      let state = 'pending';
+      let timer;
+      const reveal = () => {
+        document.documentElement.classList.remove('experiment-pending');
+        document.getElementById('experiment-status')?.remove();
+      };
+      return {
+        ready() {
+          if (state !== 'pending') return;
+          state = 'ready';
+          clearTimeout(timer);
+          // Called only AFTER the SDK has finished its DOM changes.
+          requestAnimationFrame(reveal);
+        },
+        failed() {
+          if (state !== 'pending') return;
+          state = 'failed';
+          clearTimeout(timer);
+          // A network error means the script never executed; the fallback is safe.
+          reveal();
+        },
+        start() {
+          timer = setTimeout(() => {
+            if (state !== 'pending') return;
+            // Fail closed: a delayed experiment must never flash the control.
+            const status = document.getElementById('experiment-status');
+            status.hidden = false;
+            status.innerHTML = '<span class="status-dot"></span> Your workspace is taking a moment. <button onclick="location.reload()">Try again ↗</button>';
+          }, 6000);
+          const sdk = document.createElement('script');
+          sdk.src = 'https://cdn.example.com/experiment-sdk.js';
+          sdk.async = true;
+          sdk.onerror = () => this.failed();
+          // SDK integration contract: call folioExperiment.ready() or dispatch
+          // experiment:ready after applying the assigned variant. onload alone
+          // is deliberately insufficient for SDKs that mutate asynchronously.
+          document.addEventListener('experiment:ready', () => this.ready(), { once: true });
+          document.head.appendChild(sdk);
+        }
+      };
+    })();
+  </script>
