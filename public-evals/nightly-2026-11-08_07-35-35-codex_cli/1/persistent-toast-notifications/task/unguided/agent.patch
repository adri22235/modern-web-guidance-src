+    /* Each toast is an independent, nonmodal top-layer popover. */
+    .toast {
+      --toast-height: 64px;
+      position: fixed;
+      inset: auto;
+      right: max(16px, env(safe-area-inset-right));
+      /* Toasts are appended as the last body children, newest at the bottom.
+         Counting later siblings keeps all stacking and reflow in CSS. */
+      bottom: calc(max(16px, env(safe-area-inset-bottom)) +
+        (sibling-count() - sibling-index()) * (var(--toast-height) + 12px));
+      width: min(320px, calc(100vw - 32px));
+      height: var(--toast-height);
+      margin: 0;
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
+      font: inherit;
+      overflow: visible;
+      transition: bottom 200ms ease;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      animation: toast-enter 200ms ease-out both;
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast.is-closing {
+      pointer-events: none;
+      animation: toast-exit 200ms ease-in both;
+    }
+
+    .toast-close {
+      flex: 0 0 36px;
+      height: 36px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @keyframes toast-enter {
+      from { opacity: 0; transform: translateY(12px); }
+      to { opacity: 1; transform: translateY(0); }
+    }
+
+    @keyframes toast-exit {
+      from { opacity: 1; transform: translateX(0); }
+      to { opacity: 0; transform: translateX(16px); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast { transition: none; }
+      .toast:popover-open { animation-duration: 1ms; }
+    }
