+  <script>
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.setAttribute('role', 'status');
+        message.setAttribute('aria-atomic', 'true');
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Dismiss notification');
+        close.textContent = '×';
+
+        toast.append(message, close);
+        // Keep toasts as trailing siblings so CSS can calculate their offsets.
+        document.body.append(toast);
+        toast.showPopover();
+        message.textContent = 'added to cart!';
+
+        let dismissed = false;
+        const dismiss = () => {
+          if (dismissed) return;
+          dismissed = true;
+          clearTimeout(timeout);
+          if (toast.contains(document.activeElement)) trigger.focus();
+          toast.classList.add('is-closing');
+
+          const remove = () => {
+            if (!toast.isConnected) return;
+            toast.hidePopover();
+            toast.remove();
+          };
+          toast.addEventListener('animationend', remove, { once: true });
+          // Also clean up if animations are disabled or interrupted.
+          setTimeout(remove, 220);
+        };
+
+        const timeout = setTimeout(dismiss, 3000);
+        close.addEventListener('click', dismiss);
+      });
+    });
+  </script>
+
