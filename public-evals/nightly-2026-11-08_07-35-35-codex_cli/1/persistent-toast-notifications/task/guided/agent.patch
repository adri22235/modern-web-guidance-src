+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status">added to cart!</span>
+      <button type="button" class="toast-close" aria-label="Close notification"
+        popovertargetaction="hide">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.querySelector('#toast-template');
+    let toastId = 0;
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+        const closeButton = toast.querySelector('.toast-close');
+        toast.id = `cart-toast-${++toastId}`;
+        closeButton.setAttribute('popovertarget', toast.id);
+
+        // Only manage lifecycle here; CSS calculates every stacking offset.
+        document.body.prepend(toast);
+        toast.showPopover();
+
+        let dismissTimer;
+        const dismiss = async () => {
+          if (toast.hasAttribute('data-closing')) return;
+          clearTimeout(dismissTimer);
+          toast.setAttribute('data-closing', '');
+          // Keep the native popover open throughout its exit animation.
+          await Promise.allSettled(
+            toast.getAnimations().map((animation) => animation.finished)
+          );
+          toast.hidePopover();
+          toast.remove();
+        };
+
+        closeButton.addEventListener('click', (event) => {
+          // Delay the declarative hide action until the exit animation ends.
+          event.preventDefault();
+          dismiss();
+        });
+        dismissTimer = setTimeout(dismiss, 3000);
+      });
+    });
+  </script>
