+  <script>
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        preparations: ['Hot', 'Iced']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        preparations: ['Hot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        preparations: ['Iced']
+      }
+    };
+    const orderDialog = document.getElementById('order-dialog');
+    const orderTitle = document.getElementById('order-title');
+    const orderDescription = document.getElementById('order-description');
+    const drinkSelect = document.getElementById('order-drink');
+    const preparationSelect = document.getElementById('order-preparation');
+    let orderTrigger;
+
+    function updateDrink() {
+      const drink = drinks[drinkSelect.value];
+      orderTitle.textContent = drink.name;
+      orderDescription.textContent = drink.description;
+      preparationSelect.replaceChildren(...drink.preparations.map((preparation) => {
+        return new Option(preparation, preparation.toLowerCase());
+      }));
+    }
+
+    document.querySelectorAll('[data-order-drink]').forEach((button) => {
+      button.addEventListener('click', () => {
+        orderTrigger = button;
+        orderDialog.querySelector('form').reset();
+        drinkSelect.value = button.dataset.orderDrink;
+        updateDrink();
+        orderDialog.showModal();
+        orderTitle.focus();
+      });
+    });
+
+    drinkSelect.addEventListener('change', updateDrink);
+    document.getElementById('close-order').addEventListener('click', () => orderDialog.close());
+    // Native cancel behavior handles Escape and platform dismiss requests.
+    orderDialog.addEventListener('close', () => {
+      orderTrigger?.focus({ preventScroll: true });
+    });
+
+    // Dismiss only when both ends of a pointer gesture are outside the panel.
+    function isOutsideDialog(event) {
+      const bounds = orderDialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+    let backdropPointerId = null;
+    orderDialog.addEventListener('pointerdown', (event) => {
+      backdropPointerId = event.target === orderDialog && isOutsideDialog(event)
+        ? event.pointerId : null;
+    });
+    orderDialog.addEventListener('pointerup', (event) => {
+      if (event.pointerId === backdropPointerId && event.target === orderDialog && isOutsideDialog(event)) {
+        orderDialog.close();
+      }
+      backdropPointerId = null;
+    });
+    orderDialog.addEventListener('pointercancel', () => {
+      backdropPointerId = null;
+    });
+  </script>
+
