+  <script>
+    const breadcrumbLabels = {
+      menu: 'Menu',
+      seasonal: 'Maple Oat Latte',
+      espresso: 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew',
+      locations: 'Locations',
+      rewards: 'Rewards',
+      account: 'My Account',
+      logout: 'Logout',
+      'order-online': 'Order Online',
+      about: 'Our Story',
+      careers: 'Join the Team',
+      contact: 'Contact Us',
+      'privacy-policy': 'Privacy'
+    };
+
+    const segments = window.location.pathname.split('/').filter(Boolean);
+    if (segments[segments.length - 1] === 'index.html') segments.pop();
+
+    const crumbs = [{ label: 'Home', href: '/' }];
+    segments.forEach((segment, index) => {
+      crumbs.push({
+        label: breadcrumbLabels[segment] || segment.replace(/[-_]/g, ' '),
+        href: '/' + segments.slice(0, index + 1).join('/')
+      });
+    });
+
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    breadcrumbList.replaceChildren(...crumbs.map((crumb, index) => {
+      const item = document.createElement('li');
+      if (index > 0) {
+        const separator = document.createElement('span');
+        separator.className = 'breadcrumb-separator';
+        separator.setAttribute('aria-hidden', 'true');
+        separator.textContent = '/';
+        item.append(separator);
+      }
+
+      const isCurrentPage = index === crumbs.length - 1;
+      const label = document.createElement(isCurrentPage ? 'span' : 'a');
+      label.textContent = crumb.label;
+      if (isCurrentPage) {
+        label.setAttribute('aria-current', 'page');
+      } else {
+        label.href = crumb.href;
+      }
+      item.append(label);
+      return item;
+    }));
+  </script>
+
 </body>
 
