+  <script>
+    // Use the existing URLs so parent links work with normal browser navigation.
+    const pageLabels = new Map([
+      ['/menu', 'Menu'],
+      ['/menu/seasonal', 'Maple Oat Latte'],
+      ['/menu/espresso', 'Dark Roast Espresso'],
+      ['/menu/cold-brew', 'Cold Brew'],
+      ['/locations', 'Locations'],
+      ['/rewards', 'Rewards'],
+      ['/account', 'My Account'],
+      ['/logout', 'Logout'],
+      ['/order-online', 'Order Online'],
+      ['/about', 'Our Story'],
+      ['/careers', 'Join the Team'],
+      ['/contact', 'Contact Us'],
+      ['/privacy-policy', 'Privacy']
+    ]);
+    const pathname = window.location.pathname.replace(/\/+$/, '') || '/';
+    const segments = pathname === '/index.html' ? [] : pathname.split('/').filter(Boolean);
+    const crumbs = [{ href: '/', label: 'Home' }];
+
+    segments.forEach((segment, index) => {
+      const href = '/' + segments.slice(0, index + 1).join('/');
+      const label = pageLabels.get(href) || segment.replace(/-/g, ' ')
+        .replace(/\b\w/g, character => character.toUpperCase());
+      crumbs.push({ href, label });
+    });
+
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    breadcrumbList.replaceChildren(...crumbs.map((crumb, index) => {
+      const item = document.createElement('li');
+      const link = document.createElement('a');
+      link.href = crumb.href;
+      link.textContent = crumb.label;
+      if (index === crumbs.length - 1) link.setAttribute('aria-current', 'page');
+      item.append(link);
+      return item;
+    }));
+  </script>
 </body>
 
