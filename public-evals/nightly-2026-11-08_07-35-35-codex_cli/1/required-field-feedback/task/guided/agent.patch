@@ -206,7 +276,39 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('email-error-text');
+    const signupStatus = document.getElementById('mailing-list-status');
+
+    const syncEmailError = () => {
+      if (email.matches(':user-invalid')) {
+        emailError.textContent = email.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.';
+        email.setAttribute('aria-invalid', 'true');
+      } else {
+        email.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Let the browser commit its interaction-aware validation state first.
+    email.addEventListener('blur', () => requestAnimationFrame(syncEmailError));
+    email.addEventListener('invalid', () => requestAnimationFrame(syncEmailError));
+    email.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      syncEmailError();
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing list service here before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
