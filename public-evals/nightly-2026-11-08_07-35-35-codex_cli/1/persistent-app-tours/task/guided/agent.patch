+  <script>
+    const feature = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchors = CSS.supports('anchor-name: --rewards-link') && CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Track layout changes as well as scrolling and resizing in older browsers.
+    function trackFeature() {
+      const bounds = feature.getBoundingClientRect();
+      const left = Math.max(16, Math.min(bounds.left + bounds.width / 2 - tourStep.offsetWidth / 2,
+        document.documentElement.clientWidth - tourStep.offsetWidth - 16));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${bounds.bottom + 12}px`;
+      trackingFrame = requestAnimationFrame(trackFeature);
+    }
+
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+    if (!hasAnchors) trackFeature();
+    closeTour.focus({ preventScroll: true });
+
+    closeTour.addEventListener('click', (event) => {
+      event.preventDefault();
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (hasPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      feature.removeAttribute('aria-describedby');
+      feature.focus({ preventScroll: true });
+    });
+
+    // Keep ordinary, modified, keyboard, and middle clicks on this page during the tour.
+    function preventTourNavigation(event) {
+      if (tourOpen) event.preventDefault();
+    }
+    feature.addEventListener('click', preventTourNavigation);
+    feature.addEventListener('auxclick', preventTourNavigation);
+  </script>
