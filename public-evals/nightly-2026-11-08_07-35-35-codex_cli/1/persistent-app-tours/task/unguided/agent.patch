+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = document.getElementById('close-tour');
+
+    // The positioned parent keeps the tour attached during scrolling and layout
+    // changes. Clamp its horizontal position to keep the message on screen.
+    function positionTour() {
+      if (tourStep.hidden) return;
+      const anchor = rewardsLink.getBoundingClientRect();
+      const parent = rewardsLink.parentElement.getBoundingClientRect();
+      const halfWidth = tourStep.offsetWidth / 2;
+      const anchorCenter = anchor.left + anchor.width / 2;
+      const center = Math.max(16 + halfWidth,
+        Math.min(anchorCenter, document.documentElement.clientWidth - 16 - halfWidth));
+      tourStep.style.setProperty('--tour-left', `${center - parent.left}px`);
+      tourStep.style.setProperty('--tour-arrow', `${anchorCenter - center + halfWidth}px`);
+    }
+
+    rewardsLink.addEventListener('click', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+
+    closeTour.addEventListener('click', () => {
+      tourStep.hidden = true;
+      rewardsLink.setAttribute('aria-expanded', 'false');
+      rewardsLink.removeAttribute('aria-describedby');
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    window.addEventListener('resize', positionTour);
+    const tourResizeObserver = new ResizeObserver(positionTour);
+    tourResizeObserver.observe(document.querySelector('nav'));
+    tourResizeObserver.observe(tourStep);
+    positionTour();
+  </script>
 </body>
 
