+++ b/src/crypto.js
@@ -0,0 +1,106 @@
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder('utf-8', { fatal: true });
+const MODES = new Set(['hybrid', 'classical', 'post-quantum']);
+const concat = (...parts) => {
+  const result = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let offset = 0;
+  for (const part of parts) { result.set(part, offset); offset += part.length; }
+  return result;
+};
+const encode = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+const decode = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+
+// Private recipient keys are deliberately held in memory only. A real delivery
+// service must supply authenticated public keys, with private keys held by the recipient.
+export async function createRecipient(mode) {
+  if (!MODES.has(mode)) throw new Error('Unsupported protection level.');
+  if (!globalThis.crypto?.subtle) throw new Error('Encryption requires HTTPS or localhost.');
+  const ec = mode !== 'post-quantum' ? await crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']) : null;
+  const pq = mode !== 'classical' ? ml_kem768.keygen() : null;
+  const publicEC = ec ? new Uint8Array(await crypto.subtle.exportKey('raw', ec.publicKey)) : new Uint8Array();
+  const publicPQ = pq?.publicKey ?? new Uint8Array();
+  const id = encode(await crypto.subtle.digest('SHA-256', concat(encoder.encode(`daily-grind/recipient/v1/${mode}`), publicEC, publicPQ)));
+  return { mode, id, ec, pq, publicEC, publicPQ };
+}
+
+// Fixed-order metadata binds the algorithm, recipient and entire encapsulation
+// transcript to both the KDF and the GCM authentication tag.
+function metadata(envelope) {
+  return encoder.encode(JSON.stringify([
+    'daily-grind/delivery-note/v1', envelope.version, envelope.mode,
+    envelope.recipientId, envelope.createdAt, envelope.ephemeralPublic,
+    envelope.kemCiphertext, envelope.salt, envelope.iv,
+  ]));
+}
+async function deriveKey(sharedSecret, envelope, usage) {
+  const material = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt: decode(envelope.salt), info: metadata(envelope) }, material, { name: 'AES-GCM', length: 256 }, false, [usage]);
+}
+
+export async function encryptNote(note, recipient) {
+  if (typeof note !== 'string' || !note.trim() || note.length > 500) throw new Error('Enter a note of up to 500 characters.');
+  let ecSecret = new Uint8Array();
+  let pqSecret = new Uint8Array();
+  let sharedSecret;
+  let ephemeralPublic = '';
+  let kemCiphertext = '';
+  try {
+    if (recipient.ec) {
+      const ephemeral = await crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']);
+      ecSecret = new Uint8Array(await crypto.subtle.deriveBits({ name: 'ECDH', public: recipient.ec.publicKey }, ephemeral.privateKey, 256));
+      ephemeralPublic = encode(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+    }
+    if (recipient.pq) {
+      const encapsulation = ml_kem768.encapsulate(recipient.publicPQ);
+      pqSecret = encapsulation.sharedSecret;
+      kemCiphertext = encode(encapsulation.cipherText);
+    }
+    const envelope = {
+      version: 1, mode: recipient.mode, recipientId: recipient.id,
+      createdAt: new Date().toISOString(), ephemeralPublic, kemCiphertext,
+      salt: encode(crypto.getRandomValues(new Uint8Array(32))),
+      iv: encode(crypto.getRandomValues(new Uint8Array(12))),
+    };
+    sharedSecret = concat(ecSecret, pqSecret);
+    const key = await deriveKey(sharedSecret, envelope, 'encrypt');
+    const plaintext = encoder.encode(note);
+    try {
+      envelope.ciphertext = encode(await crypto.subtle.encrypt({ name: 'AES-GCM', iv: decode(envelope.iv), additionalData: metadata(envelope), tagLength: 128 }, key, plaintext));
+    } finally { plaintext.fill(0); }
+    return envelope;
+  } finally {
+    ecSecret.fill(0); pqSecret.fill(0); sharedSecret?.fill(0);
+  }
+}
+
+export function validateEnvelope(envelope) {
+  if (!envelope || envelope.version !== 1 || !MODES.has(envelope.mode)) return false;
+  const fields = ['recipientId', 'createdAt', 'ephemeralPublic', 'kemCiphertext', 'salt', 'iv', 'ciphertext'];
+  if (!fields.every(key => typeof envelope[key] === 'string' && envelope[key].length < 5000)) return false;
+  try {
+    return decode(envelope.iv).length === 12 && decode(envelope.salt).length === 32 && decode(envelope.ciphertext).length >= 16 &&
+      decode(envelope.recipientId).length === 32 && Number.isFinite(Date.parse(envelope.createdAt)) &&
+      (envelope.mode === 'post-quantum' ? envelope.ephemeralPublic === '' : decode(envelope.ephemeralPublic).length === 65) &&
+      (envelope.mode === 'classical' ? envelope.kemCiphertext === '' : decode(envelope.kemCiphertext).length === 1088);
+  } catch { return false; }
+}
+
+export async function decryptNote(envelope, recipient) {
+  if (!validateEnvelope(envelope) || envelope.mode !== recipient.mode || envelope.recipientId !== recipient.id) throw new Error('This note cannot be opened with the current session keys.');
+  let ecSecret = new Uint8Array();
+  let pqSecret = new Uint8Array();
+  let sharedSecret;
+  try {
+    if (recipient.ec) {
+      const publicKey = await crypto.subtle.importKey('raw', decode(envelope.ephemeralPublic), { name: 'ECDH', namedCurve: 'P-256' }, false, []);
+      ecSecret = new Uint8Array(await crypto.subtle.deriveBits({ name: 'ECDH', public: publicKey }, recipient.ec.privateKey, 256));
+    }
+    if (recipient.pq) pqSecret = ml_kem768.decapsulate(decode(envelope.kemCiphertext), recipient.pq.secretKey);
+    sharedSecret = concat(ecSecret, pqSecret);
+    const key = await deriveKey(sharedSecret, envelope, 'decrypt');
+    const plaintext = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: decode(envelope.iv), additionalData: metadata(envelope), tagLength: 128 }, key, decode(envelope.ciphertext)));
+    try { return decoder.decode(plaintext); } finally { plaintext.fill(0); }
+  } finally { ecSecret.fill(0); pqSecret.fill(0); sharedSecret?.fill(0); }
+}
