+  $('form-status').style.color = error ? '#a05d40' : '#77876a';
+}
+function renderSaved() {
+  $('saved-note').hidden = !savedEnvelope;
+  if (!savedEnvelope) return;
+  const canOpen = recipients.get(savedEnvelope.mode)?.id === savedEnvelope.recipientId;
+  $('saved-meta').textContent = `${labels[savedEnvelope.mode]} · ${canOpen ? 'Available in this session' : 'Keys expired — replace or delete this note'}`;
