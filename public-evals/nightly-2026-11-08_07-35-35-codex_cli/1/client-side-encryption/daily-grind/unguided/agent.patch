+  if (!busy) status('Ready when you are');
+});
+$('protection').addEventListener('change', () => {
+  const mode = $('protection').value;
+  const heading = $('key-description').previousElementSibling;
+  heading.textContent = mode === 'hybrid' ? 'Two layers. One shared secret.' : mode === 'classical' ? 'A private shared secret.' : 'Built for a quantum future.';
+  $('key-description').textContent = mode === 'hybrid' ? 'Classical + post-quantum key protection.' : mode === 'classical' ? 'P-256 elliptic-curve key agreement.' : 'ML-KEM-768 public-key encapsulation.';
+});
+$('notes-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const note = $('delivery-note').value;
