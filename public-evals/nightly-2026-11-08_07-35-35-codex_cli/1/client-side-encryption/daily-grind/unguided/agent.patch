+  const mode = $('protection').value;
+  const persist = $('remember-note').checked;
+  busy = true;
+  for (const id of ['encrypt-button', 'protection', 'remember-note', 'delivery-note', 'delete-note', 'view-note']) $(id).disabled = true;
+  status('Establishing your shared secret…');
+  try {
+    // Allow the browser to paint the pending state before synchronous ML-KEM work.
+    await new Promise(resolve => requestAnimationFrame(resolve));
