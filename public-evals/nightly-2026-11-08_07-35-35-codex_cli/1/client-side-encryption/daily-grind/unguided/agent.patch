+$('account-button').addEventListener('click', () => showDialog('Make yourself at home.', '<p>You’re exploring The Daily Grind as a guest. Your delivery notes work locally, with no account required.</p><p>Account sign-in and live ordering are not connected in this demo.</p>'));
