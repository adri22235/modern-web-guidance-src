@@ -0,0 +1,132 @@
+import { createDemoRecipient, fromBase64, sealNote, openNote } from './crypto.js';
+import { deliveryRecipient } from './recipient.js';
+
+const $ = id => document.getElementById(id);
+const form = $('notes-form');
+const input = $('delivery-note');
+const submit = $('encrypt-note');
+const status = $('note-status');
+let recipient;
+let envelope;
+let busy = false;
+const demo = !deliveryRecipient;
+
+function announce(message, error = false) {
+  status.textContent = message;
+  status.classList.toggle('error', error);
+}
+function clearResult() {
+  envelope = undefined;
+  $('encrypted-result').hidden = true;
+  $('revealed-note').textContent = '';
+  $('revealed-note').hidden = true;
+  $('reveal-note').textContent = 'Preview decrypted note';
+  $('reveal-note').setAttribute('aria-expanded', 'false');
+  $('envelope-data').textContent = '';
+}
+function updateCount() {
+  $('note-count').textContent = `${input.value.length} / 1,000`;
+  input.setCustomValidity('');
+  input.removeAttribute('aria-invalid');
+}
+// A disabled fieldset in the HTML prevents accidental plaintext submission if JS fails.
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (!input.value.trim()) {
+    input.setCustomValidity('Please add a delivery note before encrypting.');
+    input.setAttribute('aria-invalid', 'true');
+    input.reportValidity();
+    return;
+  }
+  busy = true;
+  submit.disabled = true;
+  input.readOnly = true;
+  $('suggestions').inert = true;
+  submit.textContent = 'Encrypting your note…';
+  announce('Establishing a fresh shared secret and encrypting your note…');
+  clearResult();
+  try {
+    envelope = await sealNote(input.value, recipient);
+    $('envelope-data').textContent = JSON.stringify(envelope, null, 2);
+    $('encrypted-result').hidden = false;
+    $('reveal-note').hidden = !demo;
+    input.value = '';
+    updateCount();
+    announce(demo ? 'Note encrypted. Your local preview is ready; nothing has been sent.' : 'Note encrypted for the delivery team. Download the encrypted file to share it.');
+    $('result-heading').focus();
+  } catch {
+    announce('Your note could not be encrypted. Nothing was sent. Please try again.', true);
+  } finally {
+    busy = false;
+    submit.disabled = false;
+    input.readOnly = false;
+    $('suggestions').inert = false;
+    submit.textContent = 'Encrypt delivery note';
+  }
+});
+input.addEventListener('input', updateCount);
+$('suggestions').addEventListener('click', event => {
+  const button = event.target.closest('button[data-note]');
+  if (!button || busy) return;
+  input.value = [input.value.trim(), button.dataset.note].filter(Boolean).join(' ').slice(0, 1000);
+  updateCount();
+  input.focus();
+});
+$('clear-note').addEventListener('click', () => {
+  if (busy) return;
+  input.value = '';
+  updateCount();
+  clearResult();
+  announce('Your note and encrypted preview have been cleared.');
+  input.focus();
+});
+$('reveal-note').addEventListener('click', async () => {
+  const button = $('reveal-note');
+  if (!envelope || !demo) return;
+  if (!$('revealed-note').hidden) {
+    $('revealed-note').textContent = '';
+    $('revealed-note').hidden = true;
+    button.textContent = 'Preview decrypted note';
+    button.setAttribute('aria-expanded', 'false');
+    return;
+  }
+  button.disabled = true;
+  const previewEnvelope = envelope;
+  try {
+    const plaintext = await openNote(previewEnvelope, recipient);
+    if (envelope !== previewEnvelope) return;
+    $('revealed-note').textContent = plaintext;
+    $('revealed-note').hidden = false;
+    button.textContent = 'Hide decrypted note';
+    button.setAttribute('aria-expanded', 'true');
+  } catch {
+    announce('Authentication failed. This encrypted note could not be opened.', true);
+  } finally { button.disabled = false; }
+});
+$('download-note').addEventListener('click', () => {
+  if (!envelope) return;
+  const url = URL.createObjectURL(new Blob([JSON.stringify(envelope, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `daily-grind-note-${envelope.id}.json`;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+  announce(demo ? 'Encrypted file downloaded. The demo key stays in this tab; the file cannot be reopened after you leave.' : 'Encrypted file downloaded. Only the configured delivery recipient can decrypt it.');
+});
+async function initialize() {
+  try {
+    if (!window.isSecureContext || !crypto.subtle) throw new Error('Secure context required');
+    recipient = demo ? createDemoRecipient() : { id: deliveryRecipient.id, publicKey: fromBase64(deliveryRecipient.publicKey) };
+    if (!recipient.id || recipient.publicKey.length !== 1216) throw new Error('Invalid recipient');
+    $('notes-controls').disabled = false;
+    $('demo-label').textContent = demo ? 'Local demo · nothing is sent' : 'Encrypting for the delivery team';
+    $('privacy-context').textContent = demo
+      ? 'Try real encryption in this tab. Your note is never sent or saved. The demo key is cleared when you leave.'
+      : 'Your note is encrypted for the delivery team before you download it. Share only the encrypted file.';
+    announce('Ready to encrypt in your browser.');
+  } catch {
+    announce('Encrypted notes are unavailable. Use a supported browser over HTTPS or localhost. No note will be submitted.', true);
+  }
+}
+initialize();
