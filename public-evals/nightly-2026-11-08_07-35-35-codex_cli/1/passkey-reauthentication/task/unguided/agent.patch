+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value)) {
+        throw new Error('The server returned invalid verification options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64 + '='.repeat((4 - base64.length % 4) % 4)), c => c.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    async function postReauth(path, body) {
+      const response = await fetch(path, {
+        method: 'POST',
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body)
+      });
+      if (!response.ok) {
+        throw new Error('Identity verification failed. Please try again.');
+      }
+      return response.json();
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthButton.setAttribute('aria-busy', 'true');
+      reauthStatus.textContent = 'Preparing identity verification…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Passkey verification requires a supported browser and a secure connection.');
+        }
+
+        // The authenticated session selects the user; never send a client-selected user ID.
+        const options = await postReauth('/api/reauth/options', {});
+        const publicKey = options.publicKey ?? options;
+        // An empty list permits any discoverable credential, so fail closed here.
+        if (!Array.isArray(publicKey.allowCredentials) || publicKey.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key is available for this account.');
+        }
+        const request = {
+          ...publicKey,
+          challenge: decodeBase64url(publicKey.challenge),
+          allowCredentials: publicKey.allowCredentials.map(credential => {
+            if (credential.type !== 'public-key') {
+              throw new Error('The server returned invalid verification options.');
+            }
+            return { ...credential, id: decodeBase64url(credential.id) };
+          }),
+          userVerification: 'required'
+        };
+
+        reauthStatus.textContent = 'Use your registered passkey or security key to continue…';
+        const assertion = await navigator.credentials.get({ publicKey: request });
+        if (!assertion || assertion.type !== 'public-key') {
+          throw new Error('Identity verification did not complete. Please try again.');
+        }
+
+        reauthStatus.textContent = 'Checking your identity…';
+        const result = await postReauth('/api/reauth/verify', {
+          id: assertion.id,
+          rawId: encodeBase64url(assertion.rawId),
+          type: assertion.type,
+          response: {
+            clientDataJSON: encodeBase64url(assertion.response.clientDataJSON),
+            authenticatorData: encodeBase64url(assertion.response.authenticatorData),
+            signature: encodeBase64url(assertion.response.signature),
+            userHandle: assertion.response.userHandle == null ? null : encodeBase64url(assertion.response.userHandle)
+          },
+          clientExtensionResults: assertion.getClientExtensionResults(),
+          authenticatorAttachment: assertion.authenticatorAttachment ?? null
+        });
+        if (result.verified !== true) {
+          throw new Error('Identity verification failed. Please try again.');
+        }
+        reauthStatus.textContent = 'Identity confirmed. You can continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Verification was cancelled or timed out. Please try again.'
+          : error.message || 'Identity verification failed. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+        reauthButton.removeAttribute('aria-busy');
+      }
+    });
+  </script>
