+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let pendingFrame = false;
+
+    // The document is the scroll root; compare section bounds to the nav edge.
+    function updateStuckHeaders() {
+      pendingFrame = false;
+      for (const container of stickyContainers) {
+        const section = container.parentElement.getBoundingClientRect();
+        const header = container.getBoundingClientRect();
+        container.classList.toggle('is-stuck',
+          section.top < navigationHeight && header.top >= navigationHeight - 1);
+      }
+    }
+
+    function scheduleUpdate() {
+      if (!pendingFrame) {
+        pendingFrame = true;
+        requestAnimationFrame(updateStuckHeaders);
+      }
+    }
+
+    function updateNavigationHeight() {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      if (needsFallback) scheduleUpdate();
+    }
+
+    updateNavigationHeight();
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+
+    if (needsFallback) {
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+    }
+  </script>
+
