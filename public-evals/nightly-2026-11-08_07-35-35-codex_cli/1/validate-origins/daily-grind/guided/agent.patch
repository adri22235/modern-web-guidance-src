+// The parent deliberately omits allow-same-origin, giving this widget an opaque origin.
+const parentOrigin = new URL(document.referrer).origin;
+if (parentOrigin !== 'null') {
+  parent.postMessage({ type: 'init' }, parentOrigin);
+  document.querySelector('button').addEventListener('click', () => {
+    parent.postMessage({
+      type: 'coffee-tip',
+      text: 'For a balanced cup, start with 60 grams of freshly ground coffee per litre of water.',
+    }, parentOrigin);
+  });
+}
