diff --git a/page.mjs b/page.mjs
new file mode 100644
index 0000000..6f2e0ac
--- /dev/null
+++ b/page.mjs
@@ -0,0 +1,65 @@
+import { createValidation } from './origin-validation.mjs';
+
+const validation = createValidation(window.location.href);
+const widget = document.querySelector('#coffee-widget');
+const acceptWidget = validation.pinWidget(widget.contentWindow);
+const status = document.querySelector('#order-status');
+
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object') return;
+
+  if (event.source === widget.contentWindow) {
+    if (!acceptWidget(event)) return;
+    if (data.type === 'coffee-tip' && typeof data.text === 'string' && data.text.length <= 300) {
+      document.querySelector('#coffee-tip').textContent = data.text;
+    }
+    return;
+  }
+
+  if (!validation.isTrustedOrderingMessage(event)) return;
+  if (data.type === 'order-status' && typeof data.text === 'string' && data.text.length <= 300) {
+    status.textContent = data.text;
+  } else if (data.type === 'redirect' && typeof data.url === 'string') {
+    const target = validation.sameSite(data.url);
+    if (target) window.location.assign(target.href);
+  }
+});
+
+// Install the listener before the sandbox can send its one-time init message.
+widget.src = './coffee-widget.html';
+
+function classifyLink(link) {
+  try {
+    const url = new URL(link.href);
+    if (!['https:', 'http:'].includes(url.protocol)) return;
+    const external = !validation.sameSite(link);
+    link.dataset.external = String(external);
+    if (external || link.target === '_blank') link.relList.add('noopener', 'noreferrer');
+  } catch {
+    // Malformed URLs never become trusted internal links.
+    link.dataset.external = 'true';
+  }
+}
+
+document.querySelectorAll('a[href]').forEach(classifyLink);
+document.addEventListener('click', (event) => {
+  const link = event.target.closest?.('a[href]');
+  if (!link) return;
+  classifyLink(link);
+  try {
+    const url = new URL(link.href);
+    if (!['https:', 'http:'].includes(url.protocol)) event.preventDefault();
+  } catch {
+    event.preventDefault();
+  }
+});
+
+// Validate returnTo before exposing it as a navigable destination.
+const returnTo = new URL(window.location.href).searchParams.get('returnTo');
+const returnUrl = returnTo && validation.sameSite(returnTo);
+if (returnUrl) {
+  const link = document.querySelector('#return-link');
+  link.href = returnUrl.href;
+  link.hidden = false;
+}
