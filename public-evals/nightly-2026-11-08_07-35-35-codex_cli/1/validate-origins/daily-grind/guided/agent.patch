diff --git a/origin-validation.mjs b/origin-validation.mjs
new file mode 100644
index 0000000..bcc13e1
--- /dev/null
+++ b/origin-validation.mjs
@@ -0,0 +1,73 @@
+// Deployment configuration: replace with the ordering service's exact HTTPS origin.
+export const TRUSTED_ORDERING_URL = 'https://order.dailygrind.example';
+const SITE_DOMAIN = 'dailygrind.example'; // A private registrable domain we control.
+
+export function createValidation(appHref, OriginAPI = globalThis.Origin) {
+  const appUrl = new URL(appHref);
+  const trustedUrl = new URL(TRUSTED_ORDERING_URL);
+
+  function messageOrigin(event) {
+    try {
+      return OriginAPI.from(event);
+    } catch {
+      // Synthetic MessageEvents lack the browser's internal origin slot.
+      // Never use this fallback for opaque widget identity.
+      return OriginAPI.from(event.origin);
+    }
+  }
+
+  function isTrustedOrderingMessage(event) {
+    try {
+      if (OriginAPI) {
+        return messageOrigin(event).isSameOrigin(OriginAPI.from(trustedUrl));
+      }
+      const sender = new URL(event.origin);
+      return sender.origin !== 'null' && sender.origin === trustedUrl.origin;
+    } catch {
+      return false;
+    }
+  }
+
+  function sameSite(candidate) {
+    try {
+      if (typeof candidate !== 'string' && !(candidate instanceof URL) &&
+          typeof candidate?.href !== 'string') return null;
+      const url = new URL(typeof candidate === 'string' ? candidate : candidate.href, appUrl);
+      if (!['https:', 'http:'].includes(url.protocol) || url.username || url.password) return null;
+      if (OriginAPI) {
+        return OriginAPI.from(url).isSameSite(OriginAPI.from(appUrl)) ? url : null;
+      }
+      // URL has no Public Suffix List. Only allow subdomains of our explicitly
+      // configured private domain; on other hosts conservatively allow same-origin.
+      const inPrivateSite = (host) => host === SITE_DOMAIN || host.endsWith(`.${SITE_DOMAIN}`);
+      const allowed = url.origin === appUrl.origin ||
+        (url.protocol === appUrl.protocol && inPrivateSite(appUrl.hostname) && inPrivateSite(url.hostname));
+      return allowed ? url : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function pinWidget(expectedWindow) {
+    let pinned = false;
+    let pinnedOrigin = OriginAPI ? new OriginAPI() : null;
+    return (event) => {
+      if (!expectedWindow || event.source !== expectedWindow || event.origin !== 'null') return false;
+      try {
+        const sender = OriginAPI ? OriginAPI.from(event) : null;
+        if (OriginAPI && !sender.opaque) return false;
+        if (!pinned) {
+          if (event.data?.type !== 'init') return false;
+          pinnedOrigin = sender;
+          pinned = true;
+        }
+        // Keep checking source too: a WindowProxy survives frame navigation.
+        return OriginAPI ? sender.isSameOrigin(pinnedOrigin) : true;
+      } catch {
+        return false;
+      }
+    };
+  }
+
+  return { isTrustedOrderingMessage, sameSite, pinWidget };
+}
diff --git a/origin-validation.test.mjs b/origin-validation.test.mjs
new file mode 100644
index 0000000..2d61ea9
--- /dev/null
+++ b/origin-validation.test.mjs
@@ -0,0 +1,108 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createValidation } from './origin-validation.mjs';
+
+const fallback = createValidation('https://www.dailygrind.example/menu', null);
+
+test('ordering messages require the exact normalized scheme, host and port', () => {
+  for (const origin of ['https://order.dailygrind.example', 'https://order.dailygrind.example:443']) {
+    assert.equal(fallback.isTrustedOrderingMessage({ origin }), true);
+  }
+  for (const origin of [
+    'https://order.dailygrind.example.attacker.test', 'https://order.dailygrind.example@attacker.test',
+    'https://evilorder.dailygrind.example', 'http://order.dailygrind.example',
+    'https://order.dailygrind.example:8443', 'null', '', 'invalid', 'data:text/html,hello',
+  ]) assert.equal(fallback.isTrustedOrderingMessage({ origin }), false, origin);
+});
+
+test('same-site URLs normalize relative paths and allow configured private subdomains', () => {
+  assert.equal(fallback.sameSite('/orders').href, 'https://www.dailygrind.example/orders');
+  assert.equal(fallback.sameSite('https://billing.dailygrind.example:8443/orders').hostname,
+    'billing.dailygrind.example');
+  assert.ok(fallback.sameSite({ href: 'https://dailygrind.example/' }));
+  for (const url of [
+    'https://dailygrind.example.attacker.test', 'https://evildailygrind.example',
+    '//attacker.test/path', 'http://www.dailygrind.example', 'javascript:alert(1)',
+    'data:text/html,hello', 'blob:https://www.dailygrind.example/id',
+    'https://user:pass@www.dailygrind.example', 'https://dailygrind.example@attacker.test',
+    'https://[invalid', null, undefined, {},
+  ]) assert.equal(fallback.sameSite(url), null, String(url));
+});
+
+test('fallback does not guess registrable domains on multi-label or shared public suffixes', () => {
+  for (const [app, sibling] of [
+    ['https://shop.example.co.uk', 'https://evil.co.uk'],
+    ['https://tenant-a.github.io', 'https://tenant-b.github.io'],
+    ['https://dailygrind.example.attacker.test', 'https://dailygrind.example'],
+  ]) {
+    const validation = createValidation(app, null);
+    assert.equal(validation.sameSite(sibling), null);
+    assert.ok(validation.sameSite('/orders'));
+  }
+});
+
+test('fallback widget pins only after init from the expected opaque sender', () => {
+  const expected = {};
+  const accept = fallback.pinWidget(expected);
+  const message = (source, type, origin = 'null') => ({ source, origin, data: { type } });
+  assert.equal(accept(message({}, 'init')), false);
+  assert.equal(accept(message(expected, 'coffee-tip')), false);
+  assert.equal(accept(message(expected, 'init', 'https://www.dailygrind.example')), false);
+  assert.equal(accept(message(expected, 'init')), true);
+  assert.equal(accept(message(expected, 'coffee-tip')), true);
+  assert.equal(accept(message({}, 'coffee-tip')), false);
+  assert.equal(fallback.pinWidget(null)(message(null, 'init')), false);
+});
+
+// An origin-identity test double models the browser-only MessageEvent origin slot.
+// It deliberately cannot reconstruct an opaque sender from the string "null".
+class TestOrigin {
+  constructor(identity = Symbol(), opaque = true) {
+    this.identity = identity;
+    this.opaque = opaque;
+  }
+  static from(value) {
+    if (value?.internalOrigin) return value.internalOrigin;
+    if (value instanceof URL || typeof value === 'string') {
+      const url = new URL(value);
+      return new TestOrigin(url.origin, url.origin === 'null');
+    }
+    throw new TypeError('No internal origin');
+  }
+  isSameOrigin(other) {
+    assert.ok(other instanceof TestOrigin);
+    return this.identity === other.identity;
+  }
+  isSameSite(other) {
+    assert.ok(other instanceof TestOrigin);
+    // Tests delegate site comparison to the native API; no homegrown PSL model.
+    return this.identity === other.identity;
+  }
+}
+
+test('native path preserves opaque identity and rejects a navigated or different iframe', () => {
+  const validation = createValidation('https://www.dailygrind.example', TestOrigin);
+  const expected = {};
+  const accept = validation.pinWidget(expected);
+  const sender = new TestOrigin();
+  const event = { source: expected, origin: 'null', internalOrigin: sender, data: { type: 'init' } };
+  assert.equal(accept({ ...event, source: {} }), false);
+  assert.equal(accept({ ...event, data: { type: 'coffee-tip' } }), false);
+  assert.equal(accept(event), true);
+  assert.equal(accept({ ...event, data: { type: 'coffee-tip' } }), true);
+  assert.equal(accept({ ...event, internalOrigin: new TestOrigin() }), false);
+  assert.equal(accept({ ...event, internalOrigin: undefined }), false);
+  assert.equal(accept({ ...event, internalOrigin: new TestOrigin('tuple', false) }), false);
+  assert.equal(accept(event), true); // Rejected init never replaces the pinned identity.
+});
+
+test('native ordering extraction supports dispatched and synthetic events, rejects opaque senders', () => {
+  const validation = createValidation('https://www.dailygrind.example', TestOrigin);
+  const trusted = TestOrigin.from('https://order.dailygrind.example');
+  assert.equal(validation.isTrustedOrderingMessage({ internalOrigin: trusted }), true);
+  assert.equal(validation.isTrustedOrderingMessage({ origin: 'https://order.dailygrind.example:443' }), true);
+  assert.equal(validation.isTrustedOrderingMessage({ internalOrigin: new TestOrigin(), origin: 'null' }), false);
+  assert.equal(validation.isTrustedOrderingMessage({ origin: 'null' }), false);
+  assert.ok(validation.sameSite('/orders'));
+  assert.equal(validation.sameSite('https://attacker.test'), null);
+});
