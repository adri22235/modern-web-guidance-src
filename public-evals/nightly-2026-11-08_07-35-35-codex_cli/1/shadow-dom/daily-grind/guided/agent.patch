@@ -0,0 +1,110 @@
+// Page API: drink-title, description, action-href, action-label, and boolean limited.
+// Attribute updates are reflected immediately, including adding/removing limited.
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    article {
+      height: 100%;
+      padding: 20px;
+      border-radius: 8px;
+      background: white;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      color: #3e2723;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-size: 1rem;
+      line-height: 1.6;
+      text-align: center;
+      overflow-wrap: anywhere;
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      color: #4e342e;
+      font-size: 1.17em;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    [hidden] {
+      display: none;
+    }
+
+    a {
+      display: inline-block;
+      margin-top: 15px;
+      padding: 10px 20px;
+      border-radius: 5px;
+      background: #4e342e;
+      color: white;
+      text-decoration: none;
+      transition: background 0.3s;
+    }
+
+    a:hover {
+      background: #3e2723;
+    }
+  </style>
+  <article>
+    <span class="badge" hidden>Limited</span>
+    <h3></h3>
+    <p></p>
+    <a></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = [
+    'drink-title', 'description', 'action-href', 'action-label', 'limited',
+  ];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.shadowRoot.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    this.update();
+  }
+
+  attributeChangedCallback() {
+    this.update();
+  }
+
+  update() {
+    this.shadowRoot.querySelector('h3').textContent = this.getAttribute('drink-title') ?? '';
+    this.shadowRoot.querySelector('p').textContent = this.getAttribute('description') ?? '';
+
+    const action = this.shadowRoot.querySelector('a');
+    action.textContent = this.getAttribute('action-label') ?? 'View Details';
+    if (this.hasAttribute('action-href')) {
+      action.setAttribute('href', this.getAttribute('action-href'));
+    } else {
+      action.removeAttribute('href');
+    }
+
+    this.shadowRoot.querySelector('.badge').hidden = !this.hasAttribute('limited');
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
