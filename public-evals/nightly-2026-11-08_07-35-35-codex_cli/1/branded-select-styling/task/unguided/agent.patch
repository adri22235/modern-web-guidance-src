+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.querySelector('#roast-trigger');
+    const list = document.querySelector('#roast-options');
+    const options = [...list.querySelectorAll('[role="option"]')];
+    let selected = 1;
+    let active = selected;
+
+    function setActive(index) {
+      active = index;
+      options.forEach((option, i) => option.classList.toggle('active', i === active));
+      trigger.setAttribute('aria-activedescendant', options[active].id);
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      setActive(selected);
+    }
+
+    function closeRoasts() {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.removeAttribute('aria-activedescendant');
+    }
+
+    function selectRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === selected)));
+      document.querySelector('#roast-value').textContent = options[selected].textContent.trim();
+      document.querySelector('#roast').value = options[selected].dataset.value;
+      closeRoasts();
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'Tab' || event.key === 'Escape') {
+        closeRoasts();
+        if (event.key === 'Escape') event.preventDefault();
+        return;
+      }
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' '].includes(event.key)) {
+        event.preventDefault();
+        if (list.hidden) {
+          openRoasts();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          selectRoast(active);
+        } else if (event.key === 'Home') {
+          setActive(0);
+        } else if (event.key === 'End') {
+          setActive(options.length - 1);
+        } else {
+          setActive((active + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
+        }
+      } else if (/^[a-z]$/i.test(event.key)) {
+        const index = options.findIndex(option => option.dataset.value.startsWith(event.key.toLowerCase()));
+        if (index !== -1) {
+          event.preventDefault();
+          if (list.hidden) openRoasts();
+          setActive(index);
+        }
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => {
+        selectRoast(index);
+        trigger.focus();
+      });
+      option.addEventListener('mouseenter', () => setActive(index));
+    });
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
