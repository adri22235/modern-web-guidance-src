+  <script>
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('coffee-roast');
+      const label = document.getElementById('roast-label');
+      const picker = document.createElement('details');
+      picker.className = 'roast-fallback';
+      const trigger = document.createElement('summary');
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      value.textContent = select.selectedOptions[0].textContent;
+      trigger.append(value);
+      const options = document.createElement('div');
+      options.className = 'roast-options';
+      options.setAttribute('role', 'radiogroup');
+      options.setAttribute('aria-labelledby', 'roast-label');
+
+      for (const option of select.options) {
+        const item = document.createElement('label');
+        item.className = 'roast-option';
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roast-choice';
+        radio.value = option.value;
+        radio.checked = option.selected;
+        item.append(radio, document.createTextNode(option.textContent));
+        options.append(item);
+        radio.addEventListener('change', () => {
+          select.value = radio.value;
+          value.textContent = option.textContent;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+        // Arrow keys keep focus within the native radio group; clicks commit.
+        radio.addEventListener('click', (event) => {
+          if (event.detail > 0) {
+            picker.open = false;
+            trigger.focus();
+          }
+        });
+      }
+
+      picker.append(trigger, options);
+      select.after(picker);
+      select.hidden = true;
+      label.removeAttribute('for');
+      picker.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' || (event.key === 'Enter' && event.target.matches('input'))) {
+          event.preventDefault();
+          picker.open = false;
+          trigger.focus();
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!picker.contains(event.target)) picker.open = false;
+      });
+      picker.addEventListener('focusout', (event) => {
+        if (!picker.contains(event.relatedTarget)) picker.open = false;
+      });
+    }
+  </script>
