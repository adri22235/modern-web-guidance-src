+    /* Order and reward progress */
+    .progress-section {
+      margin-bottom: 40px;
+      padding: clamp(20px, 4vw, 32px);
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      background: #f5efeb;
+    }
+
+    .progress-eyebrow {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+    }
+
+    .progress-section h2 {
+      margin: 4px 0 20px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 20px;
+    }
+
+    .progress-card {
+      padding: 20px;
+      border-radius: 8px;
+      background: white;
+      box-shadow: 0 2px 5px rgb(0 0 0 / 0.04);
+    }
+
+    .progress-heading {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 4px 12px;
+      margin-bottom: 12px;
+    }
+
+    .progress-heading label {
+      font-weight: 700;
+    }
+
+    .progress-count {
+      color: var(--primary);
+      font-size: 0.85rem;
+    }
+
+    .progress-card p {
+      margin-top: 10px;
+      font-size: 0.9rem;
+    }
+
+    .coffee-progress {
+      --progress-fill: linear-gradient(90deg, var(--primary), #956244);
+      --progress-animation-duration: 2s;
+      appearance: none;
+      border: 0 solid;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      border-radius: 999px;
+      overflow: clip;
+      background: #e9e0db;
+      container-type: inline-size;
+    }
+
+    .coffee-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .coffee-progress::-webkit-progress-value {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress::-moz-progress-bar {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress:indeterminate {
+      --progress-fill: var(--primary);
+      --progress-animation: coffee-loading var(--progress-animation-duration) infinite linear;
+    }
+
+    .coffee-progress:indeterminate:dir(rtl) {
+      --progress-animation: coffee-loading var(--progress-animation-duration) infinite linear reverse;
+    }
+
+    @keyframes coffee-loading {
+      from, to {
+        inline-size: 30%;
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .coffee-progress {
+        --progress-animation-duration: 10s;
+      }
+    }
+
