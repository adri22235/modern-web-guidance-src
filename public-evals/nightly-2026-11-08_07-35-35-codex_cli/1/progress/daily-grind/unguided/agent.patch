+    /* Rewards and order progress */
+    .progress-section {
+      margin-bottom: 40px;
+      padding: 28px;
+      background: #fff8ef;
+      border: 1px solid #e9ddd3;
+      border-radius: 12px;
+    }
+
+    .progress-section > p {
+      color: #72584d;
+      margin-top: 4px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 28px;
+      margin-top: 24px;
+    }
+
+    .progress-heading {
+      display: flex;
+      align-items: baseline;
+      justify-content: space-between;
+      flex-wrap: wrap;
+      gap: 4px 12px;
+      margin-bottom: 10px;
+    }
+
+    .progress-heading h3 {
+      font-size: 1rem;
+    }
+
+    .progress-value {
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: #72584d;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      position: relative;
+      background: #e7dcd4;
+      border-radius: 999px;
+    }
+
+    .progress-fill {
+      display: block;
+      height: 100%;
+      border-radius: inherit;
+      background: var(--primary);
+    }
+
+    .progress-fill--rewards {
+      width: 60%;
+    }
+
+    .progress-fill--pending {
+      width: 35%;
+      position: absolute;
+      background: #b56a25;
+      animation: brewing 1.8s ease-in-out infinite alternate;
+    }
+
+    .progress-note {
+      margin-top: 10px;
+      font-size: 0.85rem;
+      color: #72584d;
+    }
+
+    @keyframes brewing {
+      from { left: 0; }
+      to { left: 65%; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-fill--pending {
+        animation: none;
+        left: 32.5%;
+      }
+    }
+
+    @media (max-width: 600px) {
+      .progress-section {
+        padding: 20px;
+      }
+
+      .progress-grid {
+        grid-template-columns: 1fr;
+        gap: 24px;
+      }
+    }
+
