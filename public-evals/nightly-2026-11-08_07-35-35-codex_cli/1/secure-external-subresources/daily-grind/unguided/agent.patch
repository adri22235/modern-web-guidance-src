+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      if (typeof dayjs === 'function') {
+        document.getElementById('copyright-year').textContent = dayjs().format('YYYY');
+      }
+
+      // Images and CSS font URLs do not support an integrity attribute.
+      // Fetch verifies the bytes before they are passed to an image or FontFace.
+      // Never retry with an unchecked URL if verification or CORS fails.
+      async function verifiedFetch(url, integrity) {
+        if (!/^sha384-[A-Za-z0-9+/]{64}$/.test(integrity)) {
+          throw new Error('Missing or invalid asset integrity digest');
+        }
+        const response = await fetch(url, {
+          integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer'
+        });
+        if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+        return response;
+      }
+
+      async function loadImage(image) {
+        const response = await verifiedFetch(image.dataset.src, image.dataset.integrity);
+        const blob = await response.blob();
+        if (!blob.type.startsWith('image/')) throw new Error('Expected an image');
+        const objectURL = URL.createObjectURL(blob);
+        try {
+          image.src = objectURL;
+          await image.decode();
+        } finally {
+          URL.revokeObjectURL(objectURL);
+        }
+      }
+
+      async function loadFont() {
+        const response = await verifiedFetch(
+          'https://cdn.jsdelivr.net/npm/@fontsource/inter@5.2.5/files/inter-latin-400-normal.woff2',
+          'sha384-gijdfLnskrcqcIndQ6U0wywZhUSIKgq2K0bDl2N/4Plpfkgl7oO1RicuX/dbCo8B'
+        );
+        const font = new FontFace('Inter', await response.arrayBuffer(), { weight: '400' });
+        document.fonts.add(await font.load());
+      }
+
+      loadFont().catch(error => console.warn('Using fallback font:', error));
+      document.querySelectorAll('img[data-integrity]').forEach(image => {
+        loadImage(image).catch(error => console.warn('Verified image unavailable:', error));
+      });
+    });
+  </script>
