+  <script>
+    const navigation = document.querySelector('nav');
+    let currentNavigation;
+
+    async function scrollToTarget(target, signal) {
+      // Listen before scrolling, including for browsers without scroll promises.
+      // The idle check also handles no movement and early root-scroll promises.
+      let finish;
+      const settled = new Promise((resolve) => {
+        let idleTimer;
+        finish = () => {
+          clearTimeout(idleTimer);
+          document.removeEventListener('scroll', onScroll);
+          document.removeEventListener('scrollend', finish);
+          signal.removeEventListener('abort', finish);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 150);
+        };
+        document.addEventListener('scroll', onScroll, { passive: true });
+        document.addEventListener('scrollend', finish);
+        signal.addEventListener('abort', finish, { once: true });
+        onScroll();
+      });
+
+      try {
+        await target.scrollIntoView({
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
+          block: 'start'
+        });
+        await settled;
+      } finally {
+        finish();
+      }
+    }
+
+    navigation.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+
+      currentNavigation?.abort();
+      const controller = new AbortController();
+      currentNavigation = controller;
+      const { signal } = controller;
+      const cancel = () => controller.abort();
+      const cancelOnKey = (event) => {
+        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) cancel();
+      };
+      window.addEventListener('wheel', cancel, { passive: true, signal });
+      window.addEventListener('touchstart', cancel, { passive: true, signal });
+      window.addEventListener('keydown', cancelOnKey, { signal });
+      window.addEventListener('popstate', cancel, { signal });
+
+      document.querySelectorAll('.scroll-arrival').forEach((section) => {
+        section.classList.remove('scroll-arrival');
+      });
+      document.documentElement.style.setProperty('--navigation-offset', `${navigation.getBoundingClientRect().height + 16}px`);
+
+      try {
+        await scrollToTarget(target, signal);
+        if (signal.aborted) return;
+
+        if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+        target.querySelector('h2').focus({ preventScroll: true });
+        target.classList.add('scroll-arrival');
+      } finally {
+        controller.abort();
+        if (currentNavigation === controller) currentNavigation = undefined;
+      }
+    });
+  </script>
