+  <script>
+    (() => {
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let cancelNavigation = () => {};
+      let highlight;
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"]');
+        if (!link || event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+        let id;
+        try {
+          id = decodeURIComponent(link.hash.slice(1));
+        } catch {
+          return;
+        }
+        const target = document.getElementById(id);
+        if (!target) return;
+
+        event.preventDefault();
+        cancelNavigation();
+        highlight?.cancel();
+
+        const controller = new AbortController();
+        const { signal } = controller;
+        const navOffset = document.querySelector('nav').getBoundingClientRect().height + 16;
+        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+        const destination = Math.min(maxScroll,
+          Math.max(0, window.scrollY + target.getBoundingClientRect().top - navOffset));
+        let frame;
+        let finished = false;
+
+        const cleanup = () => {
+          finished = true;
+          controller.abort();
+          cancelAnimationFrame(frame);
+        };
+        cancelNavigation = () => {
+          if (finished) return;
+          cleanup();
+          // Stop any previous native animation before starting another navigation.
+          window.scrollTo({ top: window.scrollY, left: window.scrollX, behavior: 'instant' });
+        };
+
+        const complete = () => {
+          if (finished) return;
+          cleanup();
+          if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+          if (!target.hasAttribute('tabindex')) {
+            target.setAttribute('tabindex', '-1');
+            target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
+          }
+          target.focus({ preventScroll: true });
+          if (!reducedMotion.matches) {
+            highlight = target.animate([
+              { boxShadow: '0 0 0 6px rgba(255, 171, 64, 0.65)' },
+              { boxShadow: '0 0 0 14px rgba(255, 171, 64, 0)' }
+            ], { duration: 700, easing: 'ease-out' });
+          }
+        };
+
+        const atDestination = () => Math.abs(window.scrollY - destination) <= 1;
+        document.addEventListener('scrollend', () => {
+          if (atDestination()) complete();
+        }, { signal });
+
+        // User input cancels pending focus and effects as well as the scroll.
+        for (const type of ['wheel', 'touchstart', 'pointerdown']) {
+          window.addEventListener(type, cancelNavigation, { once: true, passive: true, signal });
+        }
+        window.addEventListener('keydown', (keyEvent) => {
+          if (['Tab', 'Escape', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight',
+               'PageUp', 'PageDown', 'Home', 'End', ' '].includes(keyEvent.key)) cancelNavigation();
+        }, { signal });
+
+        window.scrollTo({ top: destination, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+
+        // Also handles browsers without scrollend and targets already in view.
+        let previousY = window.scrollY;
+        let stableFrames = 0;
+        const started = performance.now();
+        const checkScroll = (now) => {
+          if (finished) return;
+          stableFrames = Math.abs(window.scrollY - previousY) < 0.1 ? stableFrames + 1 : 0;
+          previousY = window.scrollY;
+          if (stableFrames >= 3 && now - started >= 150) {
+            if (atDestination()) complete();
+            else cleanup();
+            return;
+          }
+          frame = requestAnimationFrame(checkScroll);
+        };
+        frame = requestAnimationFrame(checkScroll);
+      });
+    })();
+  </script>
