 <body>
@@ -197,8 +257,20 @@
     </section>
   </main>
 
   <footer>
+    <form class="newsletter" novalidate>
+      <h2>A fresh brew in your inbox</h2>
+      <p>Sign up for coffee news and seasonal favorites.</p>
+      <label for="newsletter-email">Email address</label>
+      <div class="newsletter-controls">
+        <input id="newsletter-email" name="email" type="email" autocomplete="email"
+          placeholder="you@example.com" aria-describedby="newsletter-error" required>
+        <button class="btn" type="submit">Sign up</button>
