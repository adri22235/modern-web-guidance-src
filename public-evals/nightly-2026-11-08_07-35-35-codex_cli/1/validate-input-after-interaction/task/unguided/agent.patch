@@ -206,7 +278,48 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = newsletter.elements.email;
+    const error = document.getElementById('newsletter-error');
+    const status = newsletter.querySelector('.newsletter-status');
+
+    function clearError() {
+      email.removeAttribute('aria-invalid');
+      error.textContent = '';
+    }
+
+    function validateEmail() {
+      const valid = email.validity.valid;
+      if (valid) {
+        clearError();
+      } else {
+        email.setAttribute('aria-invalid', 'true');
+        error.textContent = email.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.';
+      }
+      return valid;
+    }
+
+    // Keep editing neutral, including when correcting a previously invalid email.
+    email.addEventListener('focus', clearError);
+    email.addEventListener('input', () => {
+      clearError();
+      status.textContent = '';
+    });
+    email.addEventListener('blur', validateEmail);
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Enter can submit while the field is focused; end editing before validating.
+      email.blur();
+      if (!validateEmail()) return;
+      status.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
 </html>
