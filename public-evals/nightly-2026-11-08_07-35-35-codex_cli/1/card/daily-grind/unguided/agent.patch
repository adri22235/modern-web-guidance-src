+  <script>
+    const order = new Map();
+    const orderItems = document.querySelector('#order-items');
+    const orderCount = document.querySelector('#order-count');
+    const emptyOrder = document.querySelector('#empty-order');
+    const orderStatus = document.querySelector('#order-status');
+
+    function renderOrder() {
+      orderItems.replaceChildren();
+      let count = 0;
+      for (const [key, item] of order) {
+        count += item.quantity;
+        const row = document.createElement('li');
+        const description = document.createElement('span');
+        description.textContent = `${item.quantity} × ${item.size} ${item.drink}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-item';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${item.drink} from order`);
+        remove.addEventListener('click', () => {
+          const index = [...orderItems.children].indexOf(row);
+          order.delete(key);
+          renderOrder();
+          const buttons = orderItems.querySelectorAll('button');
+          (buttons[Math.min(index, buttons.length - 1)] || document.querySelector('.drink-order button')).focus();
+          orderStatus.textContent = `${item.size} ${item.drink} removed. ${orderCount.textContent} drinks in your order.`;
+          document.querySelectorAll('.card-feedback').forEach(feedback => { feedback.textContent = ''; });
+        });
+        row.append(description, remove);
+        orderItems.append(row);
+      }
+      orderCount.textContent = `(${count})`;
+      emptyOrder.hidden = count > 0;
+    }
+
+    document.querySelectorAll('.drink-order').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        if (!['Small', 'Medium', 'Large'].includes(size)) return;
+        const drink = form.dataset.drink;
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        form.querySelector('.card-feedback').textContent = `${size} added · ${item.quantity} in your order`;
+      });
+      form.addEventListener('change', () => { form.querySelector('.card-feedback').textContent = ''; });
+    });
+  </script>
