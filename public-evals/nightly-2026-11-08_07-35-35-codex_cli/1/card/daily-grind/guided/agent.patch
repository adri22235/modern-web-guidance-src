+  <script>
+    (() => {
+      const drinks = new Map(Array.from(document.querySelectorAll('.drink-form'), form => [
+        form.dataset.drink,
+        form.closest('article').querySelector('h3').textContent
+      ]));
+      const sizes = ['small', 'medium', 'large'];
+      const storageKey = 'daily-grind-seasonal-order';
+      let order = [];
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
+        if (Array.isArray(saved)) {
+          order = saved.filter(item => item && drinks.has(item.drink) &&
+            sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+        }
+      } catch {
+        // Ordering remains usable when browser storage is unavailable.
+      }
+
+      const list = document.getElementById('order-items');
+      const status = document.getElementById('order-status');
+      const clearButton = document.getElementById('clear-order');
+
+      function renderOrder() {
+        list.replaceChildren();
+        let count = 0;
+        for (const item of order) {
+          const row = document.createElement('li');
+          const size = item.size[0].toUpperCase() + item.size.slice(1);
+          row.textContent = `${item.quantity} × ${size} ${drinks.get(item.drink)}`;
+          list.append(row);
+          count += item.quantity;
+        }
+        document.getElementById('order-count').textContent = `${count} ${count === 1 ? 'drink' : 'drinks'}`;
+        document.getElementById('empty-order').hidden = count > 0;
+        list.hidden = count === 0;
+        clearButton.hidden = count === 0;
+        try {
+          localStorage.setItem(storageKey, JSON.stringify(order));
+        } catch {
+          // Keep the current order in memory for this visit.
+        }
+      }
+
+      document.querySelectorAll('.drink-form').forEach(form => {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          const drink = form.dataset.drink;
+          const size = new FormData(form).get('size');
+          if (!drinks.has(drink) || !sizes.includes(size)) return;
+          const existing = order.find(item => item.drink === drink && item.size === size);
+          if (existing) existing.quantity += 1;
+          else order.push({ drink, size, quantity: 1 });
+          renderOrder();
+          status.textContent = `Added ${size} ${drinks.get(drink)}. ${document.getElementById('order-count').textContent} in your order.`;
+        });
+        form.querySelector('button').disabled = false;
+      });
+
+      clearButton.addEventListener('click', () => {
+        order = [];
+        renderOrder();
+        document.querySelector('.size-options input:checked').focus();
+        status.textContent = 'Your order has been cleared.';
+      });
+      renderOrder();
+    })();
+  </script>
