+  <script>
+    const form = document.querySelector('#coffee-preferences');
+    const fields = [...form.querySelectorAll('.content-sized')];
+    const canvas = document.createElement('canvas');
+    const context = canvas.getContext('2d');
+
+    function sizeFields() {
+      const availableWidth = form.clientWidth;
+      fields.forEach((field) => {
+        const style = getComputedStyle(field);
+        context.font = style.font;
+        const value = field.tagName === 'SELECT'
+          ? field.selectedOptions[0].textContent
+          : field.value || field.placeholder || ' ';
+        const textWidth = Math.max(...value.split('\n').map((line) => context.measureText(line).width));
+        const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+        const borders = parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+        const arrowSpace = field.tagName === 'SELECT' ? 28 : 2;
+        const limit = field.tagName === 'TEXTAREA' ? 400 : 320;
+        field.style.width = `${Math.min(availableWidth, limit, Math.max(60, Math.ceil(textWidth + padding + borders + arrowSpace)))}px`;
+
+        if (field.tagName === 'TEXTAREA') {
+          field.style.height = 'auto';
+          field.style.height = `${field.scrollHeight + borders}px`;
+        }
+      });
+    }
+
+    form.addEventListener('input', () => {
+      sizeFields();
+      document.querySelector('#preference-status').textContent = '';
+    });
+    form.addEventListener('change', sizeFields);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = form.elements.name.value.trim();
+      if (!name) {
+        form.elements.name.setCustomValidity('Please enter your name.');
+        form.elements.name.reportValidity();
+        return;
+      }
+      document.querySelector('#preference-status').textContent =
+        `All set, ${name}! Your preference is ${form.elements.drink.value}${form.elements.notes.value.trim() ? ' — ' + form.elements.notes.value.trim() : ''}.`;
+    });
+    form.elements.name.addEventListener('input', () => form.elements.name.setCustomValidity(''));
+    new ResizeObserver(sizeFields).observe(form);
+    document.fonts.ready.then(sizeFields);
+    sizeFields();
+  </script>
+
 </body>
 
