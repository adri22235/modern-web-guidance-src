+  <script>
+    (function () {
+      var supportsScrollAnimation = window.CSS &&
+        typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+
+      // Native CSS handles supported browsers; older browsers use the same range.
+      if (supportsScrollAnimation) return;
+
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var framePending = false;
+      var expandedHeight;
+      var compactHeight;
+
+      function measure() {
+        var styles = window.getComputedStyle(navigation);
+        expandedHeight = parseFloat(styles.getPropertyValue('--nav-expanded-height'));
+        compactHeight = parseFloat(styles.getPropertyValue('--nav-compact-height'));
+        scheduleUpdate();
+      }
+
+      function update() {
+        framePending = false;
+        if (reducedMotion.matches) {
+          navigation.style.removeProperty('height');
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, scrollTop / 120));
+        navigation.style.height = (expandedHeight + (compactHeight - expandedHeight) * progress) + 'px';
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        window.requestAnimationFrame(update);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', measure);
+      window.addEventListener('pageshow', measure);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      measure();
+    }());
+  </script>
