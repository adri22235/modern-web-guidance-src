+  <script type="module">
+    import { sampleEvents, analyzeEvents, formatInterval } from './coffee-events.mjs';
+
+    const button = document.querySelector('#load-events');
+    const status = document.querySelector('#event-status');
+    const results = document.querySelector('#event-results');
+    const rows = document.querySelector('#event-rows');
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Loading sample events…';
+      results.hidden = true;
+      try {
+        // Load only for browsers without native Temporal support.
+        const temporal = globalThis.Temporal ?? (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+        const events = analyzeEvents(sampleEvents, temporal);
+        const fragment = document.createDocumentFragment();
+        for (const event of events) {
+          const row = document.createElement('tr');
+          const values = [event.arrival, event.name, event.service,
+            event.instant.toString({ fractionalSecondDigits: 9 }),
+            event.interval === null ? '— (first event)' : formatInterval(event.interval)];
+          values.forEach((value, index) => {
+            const cell = document.createElement('td');
+            const content = index === 3 ? document.createElement('code') : cell;
+            content.textContent = String(value);
+            if (content !== cell) cell.append(content);
+            if (index === 4) cell.className = 'event-interval';
+            row.append(cell);
+          });
+          fragment.append(row);
+        }
+        rows.replaceChildren(fragment);
+        results.hidden = false;
+        status.textContent = `${events.length} sample events loaded and sorted. Nanosecond precision preserved.`;
+      } catch (error) {
+        status.textContent = 'Could not load the sample events. Please check your connection and try again.';
+        console.error('Coffee event loading failed:', error);
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
