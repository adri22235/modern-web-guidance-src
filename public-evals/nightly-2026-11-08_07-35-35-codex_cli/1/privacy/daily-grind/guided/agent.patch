+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'">
+  <title>Your Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/">Back to home</a>
+  </nav>
+  <main class="container privacy-copy">
+    <h1>Your privacy</h1>
+    <p>Last updated: November 8, 2026.</p>
+    <h2>Browse with less data</h2>
+    <p>This static website does not collect personal information through forms, run analytics, display advertising trackers, or create visitor profiles. Browsing does not require an account.</p>
+    <h2>No tracking or browser storage</h2>
+    <p>Our pages do not run JavaScript, set cookies, or save information in local or session storage. Your browser may cache public pages and images to load them faster. You can remove these using your browser’s site-data controls.</p>
+    <h2>Resources stay on this site</h2>
+    <p>Images and styles are hosted with this website. Viewing these pages does not load external fonts, scripts, social widgets, or embedded services.</p>
+    <h2>Hosting and requests</h2>
+    <p>To deliver a page, the hosting provider receives connection information such as your IP address, the requested address, and browser request headers. The provider may keep operational or security logs. This website does not add analytics logs. Hosting log retention depends on the hosting provider’s configuration.</p>
+    <h2>Accounts, orders, and privacy requests</h2>
+    <p>This version of the website does not implement account registration, checkout, or store customer records. Links to those services may not yet be available. If you have shared information with the coffee shop through another service, contact the shop through the channel you used to request access, correction, or deletion. Avoid sending passwords or payment details.</p>
+    <h2>Changes to these practices</h2>
+    <p>Any future feature that needs personal information should explain its purpose, required information, and retention before collection. Optional marketing requires a separate choice.</p>
+  </main>
+  <footer><p>&copy; 2026 The Daily Grind Coffee Co.</p></footer>
+</body>
+</html>
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..fe88a16
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,54 @@
+import { cp, mkdir, readFile, readdir, rm } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const publicPaths = ['index.html', 'privacy-policy', 'assets', '_headers'];
+
+// Conservative regression guard for this intentionally script-free static site.
+// This is a source audit, not a replacement for CSP or a runtime network audit.
+export function auditSource(source, name) {
+  assert(!/<\s*(?:script|iframe|object|embed|form|base)\b/i.test(source), `${name}: active content requires privacy review`);
+  assert(!/\bon[a-z]+\s*=/i.test(source), `${name}: inline event handler`);
+  assert(!/\bstyle\s*=|<\s*style\b/i.test(source), `${name}: inline styles violate CSP`);
+  assert(!/(?:https?:|\/\/|data:|javascript:|@import|\\)/i.test(source), `${name}: external or encoded resource requires review`);
+  assert(!/\b(?:ping|srcdoc)\s*=/i.test(source), `${name}: hidden requests or embedded content`);
+  if (name.endsWith('.html')) {
+    assert(source.includes('<meta name="referrer" content="no-referrer">'), `${name}: missing referrer protection`);
+    assert(source.includes('http-equiv="Content-Security-Policy"'), `${name}: missing fallback CSP`);
+  }
+}
+
+async function auditTree(path) {
+  for (const entry of await readdir(join(root, path), { withFileTypes: true })) {
+    const name = join(path, entry.name);
+    assert(!entry.isSymbolicLink(), `${name}: publish symlinks are not allowed`);
+    if (entry.isDirectory()) await auditTree(name);
+    else if (/\.(?:css|html)$/.test(name)) auditSource(await readFile(join(root, name), 'utf8'), name);
+    else assert(/\.(?:jpg|png|webp|avif|ico)$/.test(name), `${name}: new asset type requires privacy review`);
+  }
+}
+
+async function build() {
+  const headers = await readFile(join(root, '_headers'), 'utf8');
+  for (const requirement of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "form-action 'none'", "frame-ancestors 'none'", 'Referrer-Policy: no-referrer', 'Permissions-Policy:', 'X-Content-Type-Options: nosniff', 'Strict-Transport-Security:']) {
+    assert(headers.includes(requirement), `Missing security header: ${requirement}`);
+  }
+  const csp = headers.match(/Content-Security-Policy: (.+)/)[1].replace("; frame-ancestors 'none'", '');
+  for (const name of ['index.html', 'privacy-policy/index.html']) {
+    const html = await readFile(join(root, name), 'utf8');
+    auditSource(html, name);
+    assert(html.includes(`content="${csp}"`), `${name}: fallback CSP differs from response policy`);
+  }
+  await auditTree('assets');
+  await auditTree('privacy-policy');
+  const output = join(root, 'dist');
+  await rm(output, { recursive: true, force: true });
+  await mkdir(output);
+  for (const path of publicPaths) await cp(join(root, path), join(output, path), { recursive: true });
+  console.log('Privacy audit passed. Static site built in dist/.');
+}
+
+// Importable for offline audit checks; importing this file never starts a server.
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await build();
