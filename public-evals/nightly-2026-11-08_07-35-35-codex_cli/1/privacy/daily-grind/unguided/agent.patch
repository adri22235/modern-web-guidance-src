+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'">
+  <link rel="stylesheet" href="/assets/styles.css">
+  <title>Privacy | The Daily Grind</title>
+</head>
+<body>
+  <nav aria-label="Main navigation"><a class="logo" href="/">THE DAILY GRIND</a><a href="/">Back to home</a></nav>
+  <main class="container privacy-content">
+    <h1>Privacy at The Daily Grind</h1>
+    <p>This notice covers this static website. Updated November 8, 2026.</p>
+    <h2>Only what is needed to deliver the page</h2>
+    <p>This site has no data collection forms or client-side scripts. It does not set cookies, use browser storage, run analytics, or fingerprint your device. You can browse without creating an account or providing personal details.</p>
+    <h2>No third-party content requests</h2>
+    <p>Images and styles are served from this site. We do not embed advertising, social widgets, external fonts, or tracking pixels. The coffee photo is a locally hosted copy from Unsplash; viewing it does not connect your browser to Unsplash.</p>
+    <h2>Connection information</h2>
+    <p>To deliver a page, the hosting provider receives connection information such as your IP address, requested path, and browser information. Hosting infrastructure may keep access or security logs. This website's code does not control that logging or its retention; those settings must be confirmed with the hosting provider.</p>
+    <h2>Accounts and orders</h2>
+    <p>Account, rewards, and ordering links are navigation placeholders in this static site. This site does not process sign-ins, orders, or payments. Any future service that collects personal information needs its own clear notice and appropriate security controls before collection begins.</p>
+    <h2>Your choices</h2>
+    <p>There are no optional trackers to accept and no site-held profile to delete. Your browser lets you clear cached pages and browsing history. Avoid including personal information in URLs, which can appear in browser history and hosting logs.</p>
+  </main>
+  <footer><a href="/">Return to The Daily Grind</a></footer>
+</body>
+</html>
diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..429f81c
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,71 @@
+import { readdir, readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+// A deliberately restrictive baseline for this script-free, static site.
+// Review changes to this audit alongside any new data collection or vendor.
+const root = process.cwd();
+const errors = [];
+const fail = (file, message) => errors.push(`${file}: ${message}`);
+const headers = await readFile(path.join(root, '_headers'), 'utf8');
+const required = {
+  'Referrer-Policy': 'no-referrer',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Strict-Transport-Security': 'max-age=31536000',
+  'Cache-Control': 'no-store',
+};
+for (const [name, value] of Object.entries(required)) {
+  if (!headers.includes(`  ${name}: ${value}\n`)) fail('_headers', `missing ${name}: ${value}`);
+}
+if (!headers.startsWith('/*\n')) fail('_headers', 'headers must cover every route');
+const csp = headers.match(/^  Content-Security-Policy: (.+)$/m)?.[1] ?? '';
+const baseline = ["default-src 'none'", "script-src 'none'", "style-src 'self'", "img-src 'self'", "font-src 'none'", "connect-src 'none'", "media-src 'none'", "object-src 'none'", "frame-src 'none'", "worker-src 'none'", "manifest-src 'none'", "base-uri 'none'", "form-action 'none'"];
+if (csp !== [...baseline, "frame-ancestors 'none'", 'upgrade-insecure-requests'].join('; ')) {
+  fail('_headers', 'CSP must match the reviewed deny-by-default policy');
+}
+for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'usb', 'browsing-topics']) {
+  const policy = headers.match(/^  Permissions-Policy: (.+)$/m)?.[1] ?? '';
+  if (!policy.split(', ').includes(`${feature}=()`)) fail('_headers', `${feature} must be disabled`);
+}
+function checkURL(file, url) {
+  if (/^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(url.trim())) {
+    fail(file, `external or embedded URL requires privacy review: ${url}`);
+  }
+}
+async function scan(dir) {
+  for (const entry of await readdir(path.join(root, dir), { withFileTypes: true })) {
+    if (['.git', 'node_modules', 'scripts'].includes(entry.name)) continue;
+    const file = path.join(dir, entry.name);
+    if (entry.isDirectory()) { await scan(file); continue; }
+    if (/\.(?:[cm]?js|ts|tsx|jsx)$/i.test(file)) {
+      fail(file, 'client code requires a data flow and storage review');
+      continue;
+    }
+    if (!/\.(?:html|css|svg)$/i.test(file)) continue;
+    const source = await readFile(path.join(root, file), 'utf8');
+    if (/\.(?:html|svg)$/i.test(file)) {
+      if (/<(?:script|iframe|object|embed|form|input|textarea|select)\b/i.test(source)) fail(file, 'active content or collection fields require privacy review');
+      if (/\s(?:on[\w-]+|style|srcdoc|ping)\s*=/i.test(source)) fail(file, 'inline code, styles, or link tracking are prohibited');
+      if (/\s(?:srcset)\s*=/i.test(source)) fail(file, 'responsive resource URLs require privacy review');
+      for (const match of source.matchAll(/\b(?:src|href|action|poster|data|xlink:href)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))/gi)) checkURL(file, match[1] ?? match[2] ?? match[3]);
+    }
+    if (/\.html$/i.test(file)) {
+      if (!source.includes(`<meta http-equiv="Content-Security-Policy" content="${baseline.join('; ')}">`)) fail(file, 'missing fallback CSP');
+      if (!source.includes('<meta name="referrer" content="no-referrer">')) fail(file, 'missing referrer policy');
+      if (/<style\b/i.test(source)) fail(file, 'styles must be served locally from a separate file');
+    }
+    if (/@import\b/i.test(source)) fail(file, 'CSS imports require privacy review');
+    for (const match of source.matchAll(/url\(\s*['"]?([^'"\s)]+)/gi)) checkURL(file, match[1]);
+  }
+}
+await scan('');
+const pkg = JSON.parse(await readFile(path.join(root, 'package.json'), 'utf8'));
+if (Object.keys(pkg.dependencies ?? {}).length || Object.keys(pkg.devDependencies ?? {}).length) {
+  fail('package.json', 'new dependencies require a third-party review');
+}
+if (errors.length) {
+  console.error(errors.join('\n'));
+  process.exitCode = 1;
+} else {
+  console.log('Privacy audit passed: local assets, no client collection code, restrictive policies, and no installed dependencies.');
+}
