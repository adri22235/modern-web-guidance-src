+export default function AccountPrivacyNotice({ purpose }: { purpose: string }) {
+  return (
+    <div id="account-privacy" className="mb-6 space-y-2 text-sm text-gray-700">
+      <p>This is a demo. You can read articles without an account.</p>
+      <p>
+        When you submit, your username and password are sent over HTTPS to the external
+        demo authentication service at <strong className="break-all">us-central1-web-devrel-apps.cloudfunctions.net</strong> to {purpose}.
+        Do not enter personal information or a password you use elsewhere.
+      </p>
+      <p>
+        These forms do not save credentials in browser storage. The service’s retention
+        and account deletion practices have not been verified.{' '}
+        <a className="underline" href={`${import.meta.env.BASE_URL}legal/privacy`}>Read the privacy details</a>.
+      </p>
+    </div>
+  );
+}
