+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.navigation-drawer');
+    const closeButton = drawer.querySelector('.close-menu');
+    let closing = false;
+    let previousOverflow = '';
+    let gesture = null;
+    let outsidePointer = false;
+
+    function closeDrawer() {
+      if (!drawer.open || closing) return;
+      closing = true;
+      drawer.style.removeProperty('transform');
+      drawer.classList.remove('is-open');
+      const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 220;
+      window.setTimeout(() => drawer.close(), delay);
+    }
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      previousOverflow = document.body.style.overflow;
+      drawer.showModal();
+      document.body.style.overflow = 'hidden';
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Commit the offscreen position before starting the slide-in transition.
+      drawer.getBoundingClientRect();
+      drawer.classList.add('is-open');
+    });
+
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      closing = false;
+      gesture = null;
+      drawer.classList.remove('is-open');
+      drawer.style.removeProperty('transform');
+      drawer.style.removeProperty('transition');
+      document.body.style.overflow = previousOverflow;
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus();
+    });
+    drawer.querySelectorAll('a').forEach((link) => {
+      link.addEventListener('click', closeDrawer);
+    });
+
+    function isOutside(event) {
+      const bounds = drawer.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+
+    drawer.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || closing) return;
+      outsidePointer = isOutside(event);
+      if (outsidePointer) return;
+      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0, dragging: false };
+    });
+    drawer.addEventListener('pointermove', (event) => {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.dragging) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
+          gesture = null;
+          return;
+        }
+        if (dx < 10 || dx < Math.abs(dy)) return;
+        gesture.dragging = true;
+        drawer.setPointerCapture(event.pointerId);
+        drawer.style.transition = 'none';
+      }
+      gesture.distance = Math.max(0, dx);
+      drawer.style.transform = `translateX(${gesture.distance}px)`;
+    });
+
+    function finishGesture(event) {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const shouldClose = event.type === 'pointerup' && gesture.dragging &&
+        gesture.distance > Math.min(80, drawer.clientWidth * 0.25);
+      gesture = null;
+      if (drawer.hasPointerCapture(event.pointerId)) drawer.releasePointerCapture(event.pointerId);
+      drawer.style.removeProperty('transition');
+      drawer.style.removeProperty('transform');
+      if (shouldClose) closeDrawer();
+    }
+
+    drawer.addEventListener('pointerup', (event) => {
+      if (outsidePointer && isOutside(event)) closeDrawer();
+      outsidePointer = false;
+      finishGesture(event);
+    });
+    drawer.addEventListener('pointercancel', (event) => {
+      outsidePointer = false;
+      finishGesture(event);
+    });
+  </script>
