+  <script>
+    (() => {
+      const scheme = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+      const reset = document.getElementById('theme-reset');
+      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+      const storageKey = 'daily-grind-theme';
+
+      function isDark() {
+        return scheme.content === 'dark' ||
+          (scheme.content === 'light dark' && systemTheme.matches);
+      }
+
+      function updateControls() {
+        toggle.setAttribute('aria-pressed', String(isDark()));
+        reset.hidden = scheme.content === 'light dark';
+      }
+
+      function setTheme(theme) {
+        scheme.content = theme;
+        updateControls();
+        try {
+          if (theme === 'light dark') localStorage.removeItem(storageKey);
+          else localStorage.setItem(storageKey, theme);
+        } catch { /* Theme switching still works when storage is blocked. */ }
+      }
+
+      toggle.addEventListener('click', () => setTheme(isDark() ? 'light' : 'dark'));
+      reset.addEventListener('click', () => setTheme('light dark'));
+      systemTheme.addEventListener('change', updateControls);
+      window.addEventListener('storage', (event) => {
+        if (event.key !== storageKey && event.key !== null) return;
+        scheme.content = event.newValue === 'light' || event.newValue === 'dark'
+          ? event.newValue : 'light dark';
+        updateControls();
+      });
+
+      updateControls();
+      toggle.closest('.theme-controls').hidden = false;
+    })();
+  </script>
+
