+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const mainContainer = document.getElementById('main-feedback-container');
+    const footerContainer = document.getElementById('footer-feedback-container');
+    const moveButton = document.getElementById('move-feedback');
+    const feedbackForm = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const characterCount = document.getElementById('character-count');
+    const result = document.getElementById('feedback-result');
+
+    document.getElementById('open-feedback').addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    moveButton.addEventListener('click', () => {
+      const target = feedbackDialog.parentElement === mainContainer ? footerContainer : mainContainer;
+      const focusedElement = document.activeElement;
+      const selection = focusedElement === message
+        ? [message.selectionStart, message.selectionEnd, message.selectionDirection] : null;
+      const scrollTop = feedbackDialog.scrollTop;
+      const wasOpen = feedbackDialog.open;
+
+      if (typeof target.moveBefore === 'function') {
+        // Atomic reparenting preserves top-layer membership, focus and form state.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        // Re-establish true modality synchronously in browsers without atomic moves.
+        // Closing first also clears the open attribute retained by some browsers.
+        if (wasOpen) feedbackDialog.close();
+        target.appendChild(feedbackDialog);
+        if (wasOpen) feedbackDialog.showModal();
+      }
+
+      if (feedbackDialog.contains(focusedElement) && document.activeElement !== focusedElement) {
+        focusedElement.focus();
+      }
+      if (selection) message.setSelectionRange(...selection);
+      feedbackDialog.scrollTop = scrollTop;
+
+      const inMain = target === mainContainer;
+      document.getElementById('location-label').textContent = `Currently in: ${inMain ? 'Main page' : 'Footer'}`;
+      moveButton.setAttribute('aria-label', `Move dialog to ${inMain ? 'footer' : 'main page'} container`);
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      // A queued close event from the compatibility move must not reset a live dialog.
+      if (!feedbackDialog.open) feedbackDialog.returnValue = '';
+    });
+
+    message.addEventListener('input', () => {
+      characterCount.textContent = message.value.length;
+      result.textContent = '';
+    });
+    feedbackForm.addEventListener('change', () => { result.textContent = ''; });
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(feedbackForm);
+      try {
+        localStorage.setItem('daily-grind-feedback', JSON.stringify({
+          rating: Number(data.get('rating')),
+          message: data.get('message'),
+          savedAt: new Date().toISOString()
+        }));
+        result.textContent = 'Thank you! Your feedback has been saved on this device.';
+      } catch {
+        result.textContent = 'Your browser couldn’t save this feedback. Your words are still here; please try again.';
+      }
+    });
+  </script>
