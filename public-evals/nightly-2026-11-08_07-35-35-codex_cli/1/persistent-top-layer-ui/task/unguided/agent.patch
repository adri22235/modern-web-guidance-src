+  <button class="feedback-launcher" id="open-feedback" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8H5l-4 3v-11a9 9 0 0 1 18 0Z" transform="translate(1 -2) scale(.95)"/><path d="M8 9h8M8 13h5"/></svg>
+    Share feedback
+  </button>
+
+  <script>
+    // Keep the same dialog and form nodes through every move.
+    const mainHost = document.getElementById('feedback-main-host');
+    const footerHost = document.getElementById('feedback-footer-host');
+    mainHost.innerHTML = `
+      <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title" aria-describedby="feedback-description">
+        <div class="feedback-topline">
+          <span class="feedback-eyebrow">THE DAILY GRIND · YOUR VOICE</span>
+          <button class="feedback-close" type="button" aria-label="Close feedback">×</button>
+        </div>
+        <div class="feedback-content">
+          <div class="feedback-icon" aria-hidden="true">
+            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13h17v8a7 7 0 0 1-7 7h-3a7 7 0 0 1-7-7v-8ZM24 14h2a4 4 0 0 1 0 8h-2M5 29h22M12 4c-3 3 3 3 0 6M18 2c-3 3 3 3 0 6"/></svg>
+          </div>
+          <h2 id="feedback-title">A better brew starts with you.</h2>
+          <p class="feedback-intro" id="feedback-description">How was your Daily Grind experience? We’d love to hear.</p>
+          <form id="feedback-form">
+            <fieldset class="feedback-rating">
+              <legend>How did we do?</legend>
+              <div class="rating-options">
+                ${[1, 2, 3, 4, 5].map(value => `<label class="rating-option"><input type="radio" name="rating" value="${value}" aria-label="${value} out of 5 stars" required><span aria-hidden="true">★</span></label>`).join('')}
+              </div>
+              <div class="rating-captions" aria-hidden="true"><span>Could be better</span><span>Made my day</span></div>
+            </fieldset>
+            <label class="feedback-label" for="feedback-message">Anything else to share? <span class="feedback-optional">(optional)</span></label>
+            <textarea id="feedback-message" name="message" maxlength="2000" placeholder="The coffee, the atmosphere, the little things…"></textarea>
+            <button class="feedback-submit" type="submit">Save feedback <span aria-hidden="true">↗</span></button>
+            <p class="feedback-note">Saved on this device. A little feedback goes a long way.</p>
+          </form>
+          <p class="feedback-success" id="feedback-success" role="status" hidden>Thank you for sharing! Your feedback has been saved on this device.</p>
+        </div>
+        <div class="feedback-bottom">
+          <span class="feedback-location" id="feedback-location" role="status" aria-live="polite">Currently in: Main</span>
+          <button class="feedback-move" type="button" title="Move dialog to the footer container"><span aria-hidden="true">⇄</span> Move</button>
+        </div>
+      </dialog>`;
+
+    const dialog = document.getElementById('feedback-dialog');
+    const launcher = document.getElementById('open-feedback');
+    const form = document.getElementById('feedback-form');
+    const success = document.getElementById('feedback-success');
+    const moveButton = dialog.querySelector('.feedback-move');
+
+    launcher.addEventListener('click', () => {
+      form.hidden = false;
+      success.hidden = true;
+      dialog.showModal();
+    });
+    dialog.querySelector('.feedback-close').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      if (!dialog.open) launcher.focus({ preventScroll: true });
+    });
+
+    moveButton.addEventListener('click', () => {
+      const destination = dialog.parentElement === mainHost ? footerHost : mainHost;
+      const activeElement = document.activeElement;
+      const selection = activeElement instanceof HTMLTextAreaElement
+        ? [activeElement.selectionStart, activeElement.selectionEnd, activeElement.selectionDirection]
+        : null;
+      const scrollTop = dialog.scrollTop;
+
+      if (typeof destination.moveBefore === 'function') {
+        // Atomic reparenting preserves the top layer, modal state and focus.
+        destination.moveBefore(dialog, null);
+      } else {
+        // Older browsers need the modal state restored in the same task.
+        const wasOpen = dialog.open;
+        if (wasOpen) dialog.close();
+        destination.appendChild(dialog);
+        if (wasOpen) dialog.showModal();
+      }
+
+      if (dialog.contains(activeElement) && document.activeElement !== activeElement) {
+        activeElement.focus({ preventScroll: true });
+        if (selection) activeElement.setSelectionRange(...selection);
+      }
+      dialog.scrollTop = scrollTop;
+      const inMain = destination === mainHost;
+      document.getElementById('feedback-location').textContent = `Currently in: ${inMain ? 'Main' : 'Footer'}`;
+      moveButton.title = `Move dialog to the ${inMain ? 'footer' : 'main'} container`;
+    });
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        const feedback = Object.fromEntries(new FormData(form));
+        localStorage.setItem('daily-grind-feedback', JSON.stringify({ ...feedback, savedAt: new Date().toISOString() }));
+        form.hidden = true;
+        success.textContent = 'Thank you for sharing! Your feedback has been saved on this device.';
+        success.hidden = false;
+        dialog.querySelector('.feedback-close').focus();
+      } catch {
+        success.textContent = 'Your browser couldn’t save your feedback. Please allow local storage and try again.';
+        success.hidden = false;
+      }
+    });
+  </script>
+
