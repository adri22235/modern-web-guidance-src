+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const homeSlot = document.getElementById('main-video-slot');
+      const heroSlot = document.getElementById('hero-video-slot');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.getElementById('theater-toggle');
+      const canMove = typeof heroSlot.moveBefore === 'function';
+      let theater = false;
+
+      function positionLegacyPlayer() {
+        if (canMove || !theater) return;
+        const rect = heroSlot.getBoundingClientRect();
+        player.style.width = `${rect.width}px`;
+        heroSlot.style.height = `${player.getBoundingClientRect().height}px`;
+        player.style.left = `${rect.left + window.scrollX}px`;
+        player.style.top = `${rect.top + window.scrollY}px`;
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        theater = !theater;
+        hero.classList.toggle('is-theater', theater);
+        heroSlot.hidden = !theater;
+
+        if (canMove) {
+          // Move the connected panel atomically, preserving its iframe's state.
+          (theater ? heroSlot : homeSlot).moveBefore(player, null);
+        } else {
+          // appendChild/insertBefore would reload the iframe. Move it visually
+          // instead; the original iframe stays connected throughout the toggle.
+          player.classList.toggle('legacy-theater', theater);
+          if (!theater) {
+            player.style.removeProperty('width');
+            player.style.removeProperty('left');
+            player.style.removeProperty('top');
+            heroSlot.style.removeProperty('height');
+          }
+        }
+
+        toggle.setAttribute('aria-pressed', String(theater));
+        toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        positionLegacyPlayer();
+      });
+
+      if (!canMove) {
+        window.addEventListener('resize', positionLegacyPlayer);
+        window.addEventListener('scroll', positionLegacyPlayer, { passive: true });
+        window.addEventListener('load', positionLegacyPlayer);
+        if (typeof ResizeObserver === 'function') {
+          const observer = new ResizeObserver(positionLegacyPlayer);
+          observer.observe(hero);
+          observer.observe(player);
+        }
+      }
+    })();
+  </script>
+
