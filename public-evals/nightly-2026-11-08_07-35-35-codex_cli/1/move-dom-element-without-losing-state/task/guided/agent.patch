+  <script>
+    const player = document.getElementById('roasting-player');
+    const home = document.getElementById('video-home');
+    const hero = document.querySelector('.hero');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const toggle = document.getElementById('theater-toggle');
+    const status = document.getElementById('video-status');
+    const canMove = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionFallback() {
+      if (canMove || !theaterMode) return;
+
+      // Keep the iframe connected in older browsers: insertBefore/appendChild
+      // would reload it. Visually place its existing wrapper over the hero slot.
+      const slot = heroSlot.getBoundingClientRect();
+      player.style.setProperty('--theater-left', `${slot.left + window.scrollX}px`);
+      player.style.setProperty('--theater-top', `${slot.top + window.scrollY}px`);
+      player.style.setProperty('--theater-width', `${slot.width}px`);
+      heroSlot.style.height = `${player.getBoundingClientRect().height}px`;
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', () => {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+      heroSlot.hidden = !theaterMode;
+
+      if (canMove) {
+        // Moving the wrapper atomically also preserves its iframe's browsing context.
+        (theaterMode ? heroSlot : home).moveBefore(player, null);
+      } else {
+        player.classList.toggle('theater-fallback', theaterMode);
+        if (!theaterMode) {
+          ['--theater-left', '--theater-top', '--theater-width'].forEach(property => {
+            player.style.removeProperty(property);
+          });
+          heroSlot.style.removeProperty('height');
+        }
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      status.textContent = theaterMode ? 'Video is in the hero section.' : 'Video is in the main content.';
+      positionFallback();
+      toggle.focus();
+      toggle.scrollIntoView({ block: 'nearest' });
+    });
+
+    if (!canMove) {
+      window.addEventListener('resize', positionFallback);
+      // Observe layout changes too, such as wrapping controls or loading fonts.
+      // The window resize listener remains the fallback for older browsers.
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionFallback);
+        observer.observe(hero);
+        observer.observe(player);
+      }
+    }
+  </script>
