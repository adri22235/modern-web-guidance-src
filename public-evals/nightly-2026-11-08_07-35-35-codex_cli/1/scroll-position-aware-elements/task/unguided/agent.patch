@@ -206,7 +269,47 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" tabindex="-1" aria-hidden="true" inert>
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const sentinel = scroller.querySelector('.scroll-sentinel');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    const observer = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting;
+      // Move focus before making a focused button inert.
+      if (!visible && document.activeElement === backToTop) {
+        scroller.focus({ preventScroll: true });
+      }
+      backToTop.classList.toggle('is-visible', visible);
+      backToTop.inert = !visible;
+      backToTop.tabIndex = visible ? 0 : -1;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+    }, {
+      root: scroller,
+      // Keep the button hidden for the first 120px of scrolling.
+      rootMargin: '120px 0px 0px 0px',
+      threshold: 0,
+    });
+
+    observer.observe(sentinel);
+
+    backToTop.addEventListener('click', () => {
+      // Resume keyboard navigation from the start of the container.
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth',
+      });
+    });
+  </script>
+
 </body>
 
 </html>
