+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            const progress = event.total > 0 ? event.loaded / event.total : event.loaded;
+            status.textContent = `Downloading the browser's AI model: ${Math.round(Math.min(1, Math.max(0, progress)) * 100)}%. The first download may take a few minutes.`;
+          });
+        },
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'Local AI summaries are not supported in this browser. Try a browser with the native Summarizer API on a supported device over HTTPS. You can still read the full journal above.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'Your browser’s local AI model is unavailable on this device. You can still read the full journal above.';
+            return;
+          }
+          status.textContent = availability === 'available'
+            ? 'Get a few key points using AI on your device. The journal text stays in your browser.'
+            : 'The first summary requires a browser AI model download, which may take a few minutes. Select Summarize to continue.';
+          button.disabled = false;
+        } catch {
+          status.textContent = 'Could not check local AI availability. Reload the page to try again. The full journal is available above.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        let summarizer;
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing the browser’s local AI model…';
+
+        try {
+          // Create directly from the click to preserve activation for model downloads.
+          summarizer = await window.Summarizer.create(options);
+          status.textContent = 'Creating a few key points from the journal…';
+          const result = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+          const bullets = result.split(/\r?\n/)
+            .map((line) => line.replace(/^\s*(?:[-*•‣–]|\d+[.)])\s+/, '').trim())
+            .filter(Boolean);
+          if (!bullets.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...bullets.map((text) => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'Summary ready below. Generated by AI on your device; check the journal for the full detail.';
+        } catch (error) {
+          status.textContent = error.name === 'NotAllowedError'
+            ? 'The browser could not start local AI. Select Summarize again to retry, and allow the model download if prompted.'
+            : 'The local AI summary could not be completed. Select Summarize to try again. The full journal is available above.';
+        } finally {
+          if (summarizer) summarizer.destroy();
+          summary.removeAttribute('aria-busy');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
