+    <section class="journal" aria-labelledby="journal-title">
+      <div class="journal-heading">
+        <div>
+          <p class="journal-eyebrow">From seed to cup</p>
+          <h2 id="journal-title">Roaster's Journal</h2>
+        </div>
+        <button type="button" class="btn" id="summarize-journal" aria-controls="journal-summary"
