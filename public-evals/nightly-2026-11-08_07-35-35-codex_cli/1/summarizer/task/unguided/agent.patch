+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalText = document.getElementById('journal-text');
+    const journalStatus = document.getElementById('journal-status');
+    const journalSummary = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (summarizeButton.disabled) return;
+
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summarization is unavailable in this browser. Try a supported desktop browser over HTTPS or localhost. You can still read the full journal above.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      journalSummary.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI…';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to preserve the user activation needed for model downloads.
+        // https://developer.chrome.com/docs/ai/summarizer-api
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading your browser’s AI model: ${Math.round(event.loaded * 100)}%. This may take a few minutes.`;
+            });
+          }
+        });
+
+        journalStatus.textContent = 'Summarizing the journal on your device…';
+        const summary = await summarizer.summarize(journalText.innerText);
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+
+        if (!points.length) throw new Error('Empty summary');
+
+        const items = points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        });
+        summaryPoints.replaceChildren(...items);
+        journalSummary.hidden = false;
+        journalStatus.textContent = 'Summary ready. Generated by your browser’s AI; refer to the full journal for details.';
+      } catch (error) {
+        if (error.name === 'NotSupportedError') {
+          journalStatus.textContent = 'Your browser’s AI model is unavailable on this device. You can still read the full journal above.';
+        } else if (error.name === 'NotAllowedError') {
+          journalStatus.textContent = 'Your browser could not start its AI model. Allow built-in AI for this site in your browser, then try again.';
+        } else {
+          journalStatus.textContent = 'The summary could not be created. Check your connection if the model needs downloading, then try again.';
+        }
+      } finally {
+        summarizer?.destroy();
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        journalSummary.setAttribute('aria-busy', 'false');
+      }
+    });
+  </script>
+
