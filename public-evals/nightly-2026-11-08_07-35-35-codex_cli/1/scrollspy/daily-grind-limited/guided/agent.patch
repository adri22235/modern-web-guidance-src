+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const sectionLinks = navigation.querySelectorAll('a[href^="#"]');
+
+    // Keep anchor destinations clear of the sticky bar, including when it wraps.
+    const updateNavigationHeight = () => {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.getBoundingClientRect().height}px`);
+    };
+    updateNavigationHeight();
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+
+    // CSS tracks the visible target; expose the same state to screen readers.
+    const syncCurrentLink = () => {
+      const currentLink = navigation.querySelector('a:target-current');
+      sectionLinks.forEach(link => {
+        if (link === currentLink) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    };
+
+    requestAnimationFrame(syncCurrentLink);
+    window.addEventListener('load', syncCurrentLink);
+    window.addEventListener('resize', () => requestAnimationFrame(syncCurrentLink));
+    window.addEventListener('hashchange', () => requestAnimationFrame(syncCurrentLink));
+    document.addEventListener('scrollend', syncCurrentLink);
+  </script>
+
