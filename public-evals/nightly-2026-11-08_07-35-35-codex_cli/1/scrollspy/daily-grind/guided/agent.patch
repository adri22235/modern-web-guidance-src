+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const links = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.getAttribute('href')));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let observer;
+    let frame;
+
+    function updateCurrentSection() {
+      frame = null;
+      let current;
+
+      if (nativeTracking) {
+        current = navigation.querySelector('a:target-current');
+      } else {
+        const boundary = navigation.getBoundingClientRect().bottom + 24;
+        const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
+        const visibleSections = sections.filter(section => {
+          const bounds = section.getBoundingClientRect();
+          return bounds.bottom > boundary && bounds.top < window.innerHeight;
+        });
+        const section = atBottom ? visibleSections.at(-1) :
+          visibleSections.find(section => section.getBoundingClientRect().top <= boundary) || visibleSections[0];
+        current = links.find(link => link.hash === `#${section?.id}`);
+      }
+
+      links.forEach(link => {
+        const active = link === current;
+        link.classList.toggle('is-active', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (frame == null) frame = requestAnimationFrame(updateCurrentSection);
+    }
+
+    function measureNavigation() {
+      const height = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${height}px`);
+      if (!nativeTracking) {
+        observer?.disconnect();
+        observer = new IntersectionObserver(scheduleUpdate, {
+          rootMargin: `-${Math.ceil(height)}px 0px 0px 0px`,
+          threshold: [0, 1],
+        });
+        sections.forEach(section => observer.observe(section));
+      }
+      scheduleUpdate();
+    }
+
+    new ResizeObserver(measureNavigation).observe(navigation);
+    document.addEventListener('scroll', scheduleUpdate, { passive: true });
+    document.addEventListener('scrollend', scheduleUpdate);
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    measureNavigation();
+  </script>
+
