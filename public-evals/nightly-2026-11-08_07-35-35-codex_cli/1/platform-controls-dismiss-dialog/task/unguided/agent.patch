+  <script>
+    const dialog = document.getElementById('coffee-details');
+    const title = document.getElementById('coffee-title');
+    const description = document.getElementById('coffee-description');
+    const details = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup. A cozy, gently sweet seasonal favorite.'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'A bold, smoky dark roast espresso with a rich finish. Perfect for a morning boost or an afternoon coffee break.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness, served cold for a refreshing coffee break.'
+      }
+    };
+    const historyKey = 'dailyGrindCoffeeDialog';
+    let activeEntry = null;
+    let returningToPage = false;
+    let trigger = null;
+
+    document.querySelectorAll('[data-coffee]').forEach((button) => {
+      button.addEventListener('click', () => {
+        if (dialog.open || returningToPage) return;
+        const coffee = details[button.dataset.coffee];
+        title.textContent = coffee.title;
+        description.textContent = coffee.description;
+        trigger = button;
+        // A same-URL entry lets browser Back (including mobile gestures) dismiss details.
+        activeEntry = `${Date.now()}-${Math.random()}`;
+        history.pushState({ ...history.state, [historyKey]: activeEntry }, '');
+        dialog.showModal();
+      });
+    });
+
+    // Native dialog cancellation handles Escape and platform close requests.
+    // The close event also covers the form's Close button and light dismissal.
+    dialog.addEventListener('close', () => {
+      trigger?.focus({ preventScroll: true });
+      if (activeEntry && history.state?.[historyKey] === activeEntry) {
+        returningToPage = true;
+        history.back();
+      }
+      activeEntry = null;
+    });
+
+    window.addEventListener('popstate', () => {
+      returningToPage = false;
+      if (dialog.open) {
+        activeEntry = null;
+        dialog.close();
+      }
+    });
+  </script>
+
