@@ -0,0 +1,66 @@
+export type AddressSpace = 'local' | 'loopback';
+export type NetworkPermission = 'local-network' | 'loopback-network';
+
+export const permissionFor = (space: AddressSpace): NetworkPermission =>
+  space === 'local' ? 'local-network' : 'loopback-network';
+
+// Unsupported permission descriptors must never prevent a user-initiated attempt.
+export async function queryNetworkPermission(space: AddressSpace): Promise<PermissionStatus | null> {
+  try {
+    return await navigator.permissions.query({ name: permissionFor(space) as PermissionName });
+  } catch {
+    return null;
+  }
+}
+
+export function parseEndpoint(value: string, space: AddressSpace): URL {
+  let url: URL;
+  try {
+    url = new URL(value.trim());
+  } catch {
+    throw new Error('Enter a complete HTTP or HTTPS endpoint URL, including its port and path.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use HTTP or HTTPS without embedded credentials or a URL fragment.');
+  }
+  const host = url.hostname;
+  const parts = host.split('.').map(Number);
+  const ipv4 = parts.length === 4 && parts.every(part => Number.isInteger(part) && part >= 0 && part <= 255);
+  const loopback = (ipv4 && parts[0] === 127) || host === '[::1]' || host === 'localhost' || host.endsWith('.localhost');
+  const local = (ipv4 && (
+    parts[0] === 10 ||
+    (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) ||
+    (parts[0] === 192 && parts[1] === 168) ||
+    (parts[0] === 169 && parts[1] === 254)
+  )) || host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host);
+
+  if (space === 'loopback' ? !loopback : !local) {
+    throw new Error(space === 'local'
+      ? 'Use a private LAN IP address (such as 192.168.1.100) or a device.local hostname.'
+      : 'Use a loopback address: 127.0.0.1, localhost, or [::1].');
+  }
+  return url;
+}
+
+export async function requestDiagnostics(url: URL, space: AddressSpace, signal: AbortSignal) {
+  const options: RequestInit & { targetAddressSpace: AddressSpace } = {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: space,
+    credentials: 'omit',
+    cache: 'no-store',
+    redirect: 'error',
+    referrerPolicy: 'no-referrer',
+    signal,
+  };
+  const response = await fetch(url.href, options);
+  if (!response.ok) throw new Error(`Endpoint returned HTTP ${response.status}. Check the URL and service configuration.`);
+  const body = await response.text();
+  let preview = body;
+  try {
+    preview = JSON.stringify(JSON.parse(body), null, 2);
+  } catch {
+    // Health endpoints may return plain text or an empty successful response.
+  }
+  return { status: response.status, preview: preview.slice(0, 4000), truncated: preview.length > 4000 };
+}
diff --git a/tests/diagnostics.test.mjs b/tests/diagnostics.test.mjs
new file mode 100644
index 0000000..d370c72
--- /dev/null
+++ b/tests/diagnostics.test.mjs
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { parseEndpoint, queryNetworkPermission, requestDiagnostics } from '../src/utils/diagnostics.ts';
+
+test('LAN and loopback targets remain separate, with private address boundaries enforced', () => {
+  for (const host of ['192.168.1.20', '10.0.0.2', '172.16.0.1', '172.31.255.254', 'device.local', '[fd00::1]']) {
+    assert.equal(parseEndpoint(`http://${host}:8080/status`, 'local').pathname, '/status');
+    assert.throws(() => parseEndpoint(`http://${host}:8080/status`, 'loopback'));
+  }
+  for (const host of ['127.0.0.1', '127.0.0.2', 'localhost', '[::1]']) {
+    assert.equal(parseEndpoint(`http://${host}:45678/health`, 'loopback').pathname, '/health');
+    assert.throws(() => parseEndpoint(`http://${host}:45678/health`, 'local'));
+  }
+  for (const host of ['172.15.0.1', '172.32.0.1', '192.169.1.1', '8.8.8.8', 'example.com']) {
+    for (const space of ['local', 'loopback']) assert.throws(() => parseEndpoint(`http://${host}/`, space));
+  }
+  for (const value of ['invalid', 'ftp://192.168.1.1/', 'http://user:secret@192.168.1.1/', 'http://192.168.1.1/#fragment']) {
+    assert.throws(() => parseEndpoint(value, 'local'));
+  }
+});
+
+test('permission queries use granular names and tolerate unsupported APIs', async t => {
+  const names = [];
+  const status = { state: 'denied' };
+  t.mock.method(navigator.permissions ?? Object.defineProperty(navigator, 'permissions', { configurable: true, value: { query() {} } }).permissions, 'query', async descriptor => {
+    names.push(descriptor.name);
+    return status;
+  });
+  assert.equal(await queryNetworkPermission('local'), status);
+  assert.equal(await queryNetworkPermission('loopback'), status);
+  assert.deepEqual(names, ['local-network', 'loopback-network']);
+  navigator.permissions.query.mock.mockImplementation(async () => { throw new TypeError('Unsupported permission'); });
+  assert.equal(await queryNetworkPermission('local'), null);
+  assert.equal(await queryNetworkPermission('loopback'), null);
+});
+
+test('requests target each address space directly and do not send credentials or follow redirects', async t => {
+  const calls = [];
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    calls.push({ url, options });
+    return new Response('{"healthy":true}', { status: 200 });
+  });
+  for (const space of ['local', 'loopback']) {
+    const url = parseEndpoint(space === 'local' ? 'http://192.168.1.5/status' : 'http://127.0.0.1:45678/health', space);
+    const controller = new AbortController();
+    const result = await requestDiagnostics(url, space, controller.signal);
+    const call = calls.at(-1);
+    assert.equal(call.url, url.href);
+    assert.deepEqual(call.options, {
+      method: 'GET', mode: 'cors', targetAddressSpace: space, credentials: 'omit',
+      cache: 'no-store', redirect: 'error', referrerPolicy: 'no-referrer', signal: controller.signal,
+    });
+    assert.equal(result.status, 200);
+    assert.equal(result.preview, '{\n  "healthy": true\n}');
+  }
+});
+
+test('HTTP errors and network failures reject; empty and long responses are handled', async t => {
+  const url = parseEndpoint('http://127.0.0.1:45678/health', 'loopback');
+  const signal = new AbortController().signal;
+  const mock = t.mock.method(globalThis, 'fetch', async () => new Response('unavailable', { status: 503 }));
+  await assert.rejects(requestDiagnostics(url, 'loopback', signal), /HTTP 503/);
+  mock.mock.mockImplementation(async () => { throw new TypeError('Network failure'); });
+  await assert.rejects(requestDiagnostics(url, 'loopback', signal), /Network failure/);
+  mock.mock.mockImplementation(async () => new Response(null, { status: 204 }));
+  assert.equal((await requestDiagnostics(url, 'loopback', signal)).preview, '');
+  mock.mock.mockImplementation(async () => new Response('x'.repeat(4500)));
+  const result = await requestDiagnostics(url, 'loopback', signal);
+  assert.equal(result.preview.length, 4000);
+  assert.equal(result.truncated, true);
+});
+
+test('cancellation propagates to the fetch rather than reporting a successful connection', async t => {
+  t.mock.method(globalThis, 'fetch', async (_url, { signal }) => {
+    signal.throwIfAborted();
+  });
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(requestDiagnostics(new URL('http://127.0.0.1/health'), 'loopback', controller.signal), { name: 'AbortError' });
+});
