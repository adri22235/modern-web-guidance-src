+import { useEffect, useId, useRef, useState, type FormEvent } from 'react';
+import { parseEndpoint, queryNetworkPermission, requestDiagnostics } from '../utils/diagnostics';
+
+const targets = [
+  { space: 'local' as const, title: 'Hardware test device', label: 'Private Wi-Fi LAN', initial: 'http://192.168.1.100:8080/api/status', description: 'Read diagnostics from a test device on the same Wi-Fi network.', action: 'Connect device' },
+  { space: 'loopback' as const, title: 'Companion CLI', label: 'This machine', initial: 'http://127.0.0.1:45678/health', description: 'Check the companion service running locally on your computer.', action: 'Connect CLI' },
+];
+
+function ConnectionCard({ target }: { target: typeof targets[number] }) {
+  const id = useId();
+  const [endpoint, setEndpoint] = useState(target.initial);
+  const [permission, setPermission] = useState<PermissionState | 'unknown'>('unknown');
+  const [secure, setSecure] = useState<boolean | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [invalid, setInvalid] = useState(false);
+  const [result, setResult] = useState<(Awaited<ReturnType<typeof requestDiagnostics>> & { url: string; time: string }) | null>(null);
+  const pending = useRef<AbortController | null>(null);
+  const input = useRef<HTMLInputElement>(null);
+  const permissionLabel = target.space === 'local' ? 'Local network' : 'Loopback network';
+
+  useEffect(() => {
+    setSecure(window.isSecureContext);
+    let disposed = false;
+    let status: PermissionStatus | null = null;
+    const update = () => {
+      if (disposed || !status) return;
+      setPermission(status.state);
+      if (status.state === 'denied') {
+        pending.current?.abort();
+        setResult(null);
+      }
+    };
+    void queryNetworkPermission(target.space).then(value => {
+      if (disposed) return;
+      status = value;
+      update();
+      status?.addEventListener('change', update);
+    });
+    return () => {
+      disposed = true;
+      status?.removeEventListener('change', update);
+      pending.current?.abort();
+    };
+  }, [target.space]);
+
+  async function connect(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (pending.current) return;
+    setError('');
+    setResult(null);
+    let url: URL;
+    try {
+      url = parseEndpoint(endpoint, target.space);
+    } catch (cause) {
+      setInvalid(true);
+      setError((cause as Error).message);
+      input.current?.focus();
+      return;
+    }
+    setInvalid(false);
+    if (!window.isSecureContext) {
+      setError('Open The DevTools Times over HTTPS before connecting.');
+      return;
+    }
+    const controller = new AbortController();
+    pending.current = controller;
+    setBusy(true);
+    let timedOut = false;
+    // Leave time for the reader to respond to the browser permission prompt.
+    const timeout = window.setTimeout(() => { timedOut = true; controller.abort(); }, 30000);
+    try {
+      const status = await queryNetworkPermission(target.space);
+      if (controller.signal.aborted) return;
+      setPermission(status?.state ?? 'unknown');
+      if (status?.state === 'denied') return;
+      const response = await requestDiagnostics(url, target.space, controller.signal);
+      if (!controller.signal.aborted) {
+        setResult({ ...response, url: url.href, time: new Date().toLocaleTimeString() });
+      }
+    } catch (cause) {
+      if (controller.signal.aborted) {
+        if (timedOut) setError('Connection timed out after 30 seconds. Check the service and try again.');
+      } else {
+        setError(cause instanceof TypeError
+          ? `Could not connect. Check ${permissionLabel} in browser site settings, the endpoint’s CORS configuration, and ${target.space === 'local' ? 'that the device is powered on and on the same Wi-Fi network' : 'that the companion CLI is running on this computer'}. Your browser may require an HTTPS endpoint if local HTTP access is unsupported.`
+          : cause instanceof Error ? cause.message : 'Connection failed. Check the endpoint and try again.');
+      }
+    } finally {
+      window.clearTimeout(timeout);
+      pending.current = null;
+      setBusy(false);
+      const status = await queryNetworkPermission(target.space);
+      setPermission(status?.state ?? 'unknown');
+    }
+  }
+
+  const permissions = { granted: 'Allowed', prompt: 'Ask on connect', denied: 'Blocked', unknown: 'Browser managed' };
+  const controlClass = 'min-h-12 rounded border border-gray-500 px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700';
+
+  return (
+    <form onSubmit={connect} aria-labelledby={`${id}-title`} className="min-w-0 rounded-lg border border-gray-300 bg-white p-5">
+      <p className="mb-1 text-xs font-semibold uppercase tracking-wider text-gray-600">{target.label}</p>
+      <h3 id={`${id}-title`} className="text-xl font-bold text-gray-900">{target.title}</h3>
+      <p className="mt-2 text-sm text-gray-600">{target.description}</p>
+      <p className="my-4 text-xs text-gray-700">{permissionLabel} permission: <strong>{permissions[permission]}</strong></p>
+      <label htmlFor={`${id}-endpoint`} className="mb-2 block text-sm font-semibold">Endpoint URL (required)</label>
+      <input ref={input} id={`${id}-endpoint`} name="endpoint" type="url" required value={endpoint}
+        autoComplete="off" autoCapitalize="none" autoCorrect="off" spellCheck={false} disabled={busy}
+        aria-invalid={invalid || undefined} aria-describedby={`${id}-help ${id}-status`}
+        onChange={event => { setEndpoint(event.target.value); setInvalid(false); setError(''); setResult(null); }}
+        className={`${controlClass} w-full bg-white font-mono text-gray-900 disabled:bg-gray-100`} />
+      <p id={`${id}-help`} className="mt-2 text-xs leading-relaxed text-gray-600">Use your service’s full status URL. Connecting sends one GET request; allow the browser’s access prompt if shown.</p>
+      <div className="mt-4 flex flex-wrap gap-2">
+        <button type="submit" disabled={busy || secure === false || permission === 'denied'}
+          className={`${controlClass} border-gray-900 bg-gray-900 font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-60`}>
+          {busy ? 'Connecting…' : result ? 'Check again' : target.action}
+        </button>
+        {busy && <button type="button" onClick={() => { pending.current?.abort(); setError('Connection cancelled.'); }} className={controlClass}>Cancel</button>}
+        {result && <button type="button" onClick={() => setResult(null)} className={controlClass}>Clear result</button>}
+      </div>
+      <div id={`${id}-status`} role="status" aria-live="polite" className="mt-4 text-sm leading-relaxed">
+        {secure === false && <p className="text-red-800">Open this page over HTTPS to enable connections.</p>}
+        {permission === 'denied' && <p className="text-red-800">Access is blocked. Open this site’s browser settings, allow {permissionLabel} access, then retry. Reload the page if your browser does not update the permission here.</p>}
+        {busy && <p className="text-gray-600">Waiting for the service or browser permission. You can cancel this attempt.</p>}
+        {error && <p className="text-red-800">{error}</p>}
+        {result && <p className="text-green-800">Connection successful · HTTP {result.status} · Checked at {result.time}. This is a snapshot; use Check again to refresh.</p>}
+      </div>
+      {result && <details className="mt-3 text-sm">
+        <summary className="cursor-pointer py-2 font-semibold focus-visible:outline-2 focus-visible:outline-amber-700">Response details</summary>
+        <p className="my-2 break-all font-mono text-xs text-gray-600">{result.url}</p>
+        <pre className="max-h-64 overflow-auto whitespace-pre-wrap break-all rounded bg-gray-100 p-3 text-xs">{result.preview || '(Empty response)'}</pre>
+        {result.truncated && <p className="mt-1 text-xs text-gray-600">Showing the first 4,000 characters.</p>}
+      </details>}
+    </form>
+  );
+}
+
+export default function DiagnosticsConnections() {
+  return (
+    <section aria-labelledby="diagnostics-title" className="border-y border-gray-300 bg-gray-50 p-4 sm:p-6">
+      <div className="mb-5 flex flex-wrap items-start justify-between gap-3">
+        <div>
+          <p className="mb-1 text-xs font-bold uppercase tracking-widest text-amber-800">Developer toolkit</p>
+          <h2 id="diagnostics-title" className="font-brand text-3xl text-gray-900">Diagnostics connections</h2>
+          <p className="mt-2 max-w-2xl text-sm leading-relaxed text-gray-600">Connect your browser to your test bench. Check a hardware device and your local companion CLI independently.</p>
+        </div>
+        <span className="rounded-full border border-gray-300 bg-white px-3 py-1 text-xs text-gray-600">Browser → your device</span>
+      </div>
+      <noscript><p className="mb-4 text-red-800">Enable JavaScript to use diagnostics connections.</p></noscript>
+      <div className="grid gap-4 md:grid-cols-2">
+        {targets.map(target => <ConnectionCard key={target.space} target={target} />)}
+      </div>
+      <details className="mt-4 text-sm text-gray-700">
+        <summary className="cursor-pointer py-2 font-semibold focus-visible:outline-2 focus-visible:outline-amber-700">Service setup &amp; browser support</summary>
+        <div className="mt-2 space-y-2 leading-relaxed">
+          <p>Replace the example URLs with your services’ health or diagnostics endpoints. Each must accept GET and return a successful HTTP status. JSON and plain text responses are supported.</p>
+          <p>Both services must allow this website’s origin with the standard <code>Access-Control-Allow-Origin</code> response header. Requests omit cookies and authorization credentials. They go directly from this browser to the endpoint, without a Times server proxy.</p>
+          <p>Use this website over HTTPS. Browser support for local HTTP connections varies; if blocked, use a browser with Local Network Access support or a service with a trusted HTTPS certificate. Device and CLI access have separate permissions where supported.</p>
+        </div>
+      </details>
+    </section>
+  );
+}
