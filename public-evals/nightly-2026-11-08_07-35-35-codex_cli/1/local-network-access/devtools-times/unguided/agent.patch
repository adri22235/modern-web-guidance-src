+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { ArrowPathIcon, ArrowUpRightIcon, CheckCircleIcon, CommandLineIcon, CpuChipIcon, LinkIcon, SignalIcon } from '@heroicons/react/24/outline';
+import { connectionUrl, type ConnectionKind } from './diagnostics/connection';
+
+type Result = { state: 'idle' | 'checking' | 'success' | 'error'; message: string; detail?: string };
+const initial: Result = { state: 'idle', message: 'Ready when you are' };
+
+function ConnectionCard({ kind }: { kind: ConnectionKind }) {
+  const device = kind === 'device';
+  const [endpoint, setEndpoint] = useState(device ? 'http://192.168.1.42:8080/health' : 'http://127.0.0.1:3000/health');
+  const [result, setResult] = useState<Result>(initial);
+  const active = useRef<AbortController | null>(null);
+  const Icon = device ? CpuChipIcon : CommandLineIcon;
+  const busy = result.state === 'checking';
+
+  useEffect(() => () => active.current?.abort(), []);
+
+  async function connect(event: FormEvent) {
+    event.preventDefault();
+    if (active.current) return;
+    let url: URL;
+    try {
+      url = connectionUrl(endpoint.trim(), kind);
+    } catch (error) {
+      setResult({ state: 'error', message: (error as Error).message });
+      return;
+    }
+    const controller = new AbortController();
+    active.current = controller;
+    setResult({ state: 'checking', message: 'Waiting for the endpoint… Allow browser access if prompted.' });
+    let timedOut = false;
+    const timeout = window.setTimeout(() => { timedOut = true; controller.abort(); }, 15000);
+    const started = performance.now();
+    try {
+      // Keep the request in the reader's browser: these addresses belong to their network.
+      // targetAddressSpace also enables local HTTP access from HTTPS in supporting browsers.
+      const options: RequestInit & { targetAddressSpace: 'local' | 'loopback' } = {
+        method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+        redirect: 'error', signal: controller.signal,
+        targetAddressSpace: device ? 'local' : 'loopback',
+      };
+      const response = await fetch(url.href, options);
+      if (!response.ok) throw new Error(`Endpoint returned HTTP ${response.status}. Check the URL and service logs, then retry.`);
+      // A readable successful HTTP response confirms reachability; no response schema is required.
+      await response.body?.cancel();
+      setResult({ state: 'success', message: 'Connection verified', detail: `HTTP ${response.status} · ${Math.round(performance.now() - started)} ms · ${new Date().toLocaleTimeString()}` });
+    } catch (error) {
+      if (controller.signal.aborted && !timedOut) {
+        setResult(initial);
+      } else {
+        setResult({ state: 'error', message: timedOut ? 'Connection timed out after 15 seconds.' : error instanceof TypeError ? 'Could not reach the endpoint.' : (error as Error).message,
+          detail: 'Check that the service is running, the address is correct, and CORS allows this site. If access was denied, allow local network or loopback access in browser site settings and retry.' });
+      }
+    } finally {
+      window.clearTimeout(timeout);
+      active.current = null;
+    }
+  }
+
+  return (
+    <form onSubmit={connect} className="flex flex-col rounded-lg border border-gray-200 bg-white p-5 sm:p-6">
+      <div className="mb-5 flex items-start justify-between gap-3">
+        <div className="flex items-center gap-3">
+          <span className="rounded-lg border border-gray-200 bg-gray-50 p-2.5"><Icon className="h-5 w-5 text-gray-700" /></span>
+          <div><h3 className="font-bold text-gray-950">{device ? 'Hardware test device' : 'Companion CLI'}</h3><p className="mt-0.5 text-xs text-gray-500">{device ? 'Your private Wi-Fi network' : 'Your machine · loopback'}</p></div>
+        </div>
+        <span className="rounded border border-gray-200 px-2 py-1 font-mono text-[10px] text-gray-500">{device ? 'LAN' : 'LOCAL'}</span>
+      </div>
+      <label htmlFor={`diagnostics-${kind}`} className="mb-2 text-xs font-semibold text-gray-700">{device ? 'Device endpoint' : 'CLI endpoint'}</label>
+      <input id={`diagnostics-${kind}`} type="url" required value={endpoint} disabled={busy} onChange={event => { setEndpoint(event.target.value); setResult(initial); }} spellCheck={false} autoCapitalize="none" autoComplete="off" className="min-w-0 w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-3 font-mono text-xs text-gray-800 outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100 disabled:opacity-60" aria-describedby={`diagnostics-${kind}-hint`} />
+      <p id={`diagnostics-${kind}-hint`} className="mt-2 text-xs leading-5 text-gray-500">{device ? 'Join the same Wi-Fi as your device. Enter its IP, port, and health-check path.' : 'Start your companion CLI, then enter its HTTP health-check endpoint.'}</p>
+      <div className="my-4 min-h-16 rounded-md bg-gray-50 p-3" role="status" aria-live="polite" aria-atomic="true">
+        <p className={`flex items-start gap-2 text-xs font-medium ${result.state === 'error' ? 'text-red-700' : result.state === 'success' ? 'text-emerald-700' : 'text-gray-600'}`}>
+          {result.state === 'success' ? <CheckCircleIcon className="h-4 w-4 shrink-0" /> : <span className={`mt-1 h-1.5 w-1.5 shrink-0 rounded-full ${busy ? 'animate-pulse bg-amber-500' : result.state === 'error' ? 'bg-red-500' : 'bg-gray-400'}`} />}{result.message}
+        </p>
+        {result.detail && <p className="mt-2 text-xs leading-5 text-gray-500">{result.detail}</p>}
+      </div>
+      <div className="mt-auto flex gap-2">
+        <button type="submit" disabled={busy} className="flex flex-1 items-center justify-center gap-2 rounded-md bg-gray-900 px-4 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:cursor-wait disabled:opacity-60">
+          {busy ? <ArrowPathIcon className="h-4 w-4 animate-spin" /> : <LinkIcon className="h-4 w-4" />}{busy ? 'Connecting…' : result.state === 'success' ? 'Check again' : `Connect ${device ? 'device' : 'CLI'}`}
+        </button>
+        {busy && <button type="button" onClick={() => active.current?.abort()} className="rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">Cancel</button>}
+      </div>
+    </form>
+  );
+}
+
+export default function DiagnosticsConnections() {
+  return (
+    <section aria-labelledby="diagnostics-title" className="mx-4 my-8 overflow-hidden rounded-xl border border-gray-300 bg-[#f8f7f3] sm:mx-6">
+      <div className="h-1 bg-amber-400" />
+      <div className="p-5 sm:p-7">
+        <div className="mb-6 flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <p className="mb-2 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-gray-500"><SignalIcon className="h-4 w-4" />The developer workbench</p>
+            <h2 id="diagnostics-title" className="font-brand text-3xl leading-tight text-gray-950 sm:text-4xl">A direct line to your devices.</h2>
+            <p className="mt-2 max-w-xl text-sm leading-6 text-gray-600">Connect your test hardware and local tools, right from your browser.</p>
+          </div>
+          <span className="rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-amber-800">Developer diagnostics</span>
+        </div>
+        <div className="grid gap-4 md:grid-cols-2"><ConnectionCard kind="device" /><ConnectionCard kind="cli" /></div>
+        <div className="mt-5 flex flex-wrap items-start justify-between gap-3 text-xs leading-5 text-gray-500">
+          <p className="max-w-2xl">Requests go directly from your browser to the endpoint you choose. Nothing connects automatically. Your browser may ask for local network access; the endpoint must allow this site through CORS.</p>
+          <a href="https://developer.chrome.com/docs/modern-web-guidance/guides/security/local-network-access" target="_blank" rel="noreferrer" className="inline-flex shrink-0 items-center gap-1 font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 hover:text-amber-700">Connection help <ArrowUpRightIcon className="h-3 w-3" /></a>
+        </div>
+      </div>
+    </section>
+  );
+}
