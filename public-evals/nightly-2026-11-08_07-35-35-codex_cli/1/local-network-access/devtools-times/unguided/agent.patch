index 0000000..90ae1bf
--- /dev/null
+++ b/src/components/diagnostics/connection.ts
@@ -0,0 +1,23 @@
+export type ConnectionKind = 'device' | 'cli';
+
+export function connectionUrl(value: string, kind: ConnectionKind): URL {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error('Enter a complete HTTP or HTTPS endpoint, including the port and path.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const parts = url.hostname.split('.').map(Number);
+  const ipv4 = parts.length === 4 && parts.every(part => Number.isInteger(part) && part >= 0 && part <= 255);
+  const loopback = ipv4 && parts[0] === 127;
+  const privateLan = ipv4 && (parts[0] === 10 || (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) || (parts[0] === 192 && parts[1] === 168));
+  if (kind === 'cli' ? !loopback : !privateLan) {
+    throw new Error(kind === 'cli'
+      ? 'Use a loopback IPv4 address such as 127.0.0.1 for the companion CLI.'
+      : 'Use a private LAN IPv4 address: 192.168.x.x, 10.x.x.x, or 172.16–31.x.x.');
+  }
+  return url;
+}
