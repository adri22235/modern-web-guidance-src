diff --git a/equipment.js b/equipment.js
new file mode 100644
index 0000000..7b4d419
--- /dev/null
+++ b/equipment.js
@@ -0,0 +1,177 @@
+(() => {
+  'use strict';
+
+  // Limit each control to its stated address space; never discover or scan devices.
+  function endpointFor(value, space) {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS status URL without credentials or a fragment.');
+    }
+    const host = url.hostname.toLowerCase();
+    const octets = host.split('.').map(Number);
+    const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+    const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+    const privateLan = !loopback && ((ipv4 && (
+      octets[0] === 10 ||
+      (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+      (octets[0] === 192 && octets[1] === 168) ||
+      (octets[0] === 169 && octets[1] === 254)
+    )) || host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host));
+    if (space === 'loopback' ? !loopback : !privateLan) {
+      throw new Error(space === 'loopback'
+        ? 'Use a loopback address such as http://127.0.0.1:45678/health or localhost.'
+        : 'Use a private LAN address such as http://192.168.1.100/api/status or brewer.local.');
+    }
+    return url.href;
+  }
+
+  if (!window.isSecureContext) {
+    document.querySelector('#equipment-context').textContent = 'Open this homepage over HTTPS to enable local device access. Connections are unavailable in an insecure page.';
+  }
+
+  for (const [id, space, permissionName] of [
+    ['brewer', 'local', 'local-network'],
+    ['helper', 'loopback', 'loopback-network'],
+  ]) {
+    const form = document.getElementById(`${id}-form`);
+    const input = document.getElementById(`${id}-url`);
+    const badge = document.getElementById(`${id}-status`);
+    const feedback = document.getElementById(`${id}-feedback`);
+    const permissionLabel = document.getElementById(`${id}-permission`);
+    const connect = form.querySelector('.equipment-connect');
+    const disconnect = form.querySelector('.equipment-disconnect');
+    const permissionTitle = space === 'local' ? 'Local network' : 'Loopback network';
+    const connectLabel = `Connect ${id}`;
+    let permissionStatus;
+    let controller;
+    let attempt = 0;
+
+    function display(state, title, message) {
+      badge.dataset.state = state;
+      badge.textContent = title;
+      feedback.textContent = message;
+    }
+
+    function resetControls() {
+      connect.disabled = false;
+      connect.textContent = connectLabel;
+      input.readOnly = false;
+      disconnect.hidden = true;
+      disconnect.textContent = 'Disconnect';
+      form.setAttribute('aria-busy', 'false');
+    }
+
+    function stop() {
+      attempt++;
+      controller?.abort();
+      controller = undefined;
+      resetControls();
+    }
+
+    function permissionUI() {
+      const state = permissionStatus?.state;
+      permissionLabel.textContent = state
+        ? `${permissionTitle} access: ${state === 'prompt' ? 'asks when you connect' : state}`
+        : `${permissionTitle} access: browser-managed (permission check unavailable)`;
+      if (state === 'denied') {
+        stop();
+        display('error', 'Access blocked', `Open this site’s browser settings, allow ${permissionTitle}, then connect again.`);
+      }
+    }
+
+    async function checkPermission() {
+      try {
+        if (!permissionStatus && navigator.permissions?.query) {
+          permissionStatus = await navigator.permissions.query({ name: permissionName });
+          permissionStatus.addEventListener('change', permissionUI);
+        }
+      } catch {
+        // Older browsers do not recognize granular permissions. Try only on click.
+      }
+      permissionUI();
+      return permissionStatus?.state || 'prompt';
+    }
+
+    input.addEventListener('input', () => {
+      input.setCustomValidity('');
+      input.removeAttribute('aria-invalid');
+    });
+    disconnect.addEventListener('click', () => {
+      const pending = badge.dataset.state === 'connecting';
+      stop();
+      display('idle', 'Not connected', pending ? 'Connection attempt cancelled. You can try again.' : 'Disconnected. Browser permissions can be managed in site settings.');
+    });
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (!window.isSecureContext) {
+        display('error', 'HTTPS required', 'Open this homepage over HTTPS, then try connecting again.');
+        return;
+      }
+      let endpoint;
+      try {
+        endpoint = endpointFor(input.value.trim(), space);
+      } catch (error) {
+        input.setCustomValidity(error instanceof TypeError ? 'Enter a complete HTTP or HTTPS status URL.' : error.message);
+        input.setAttribute('aria-invalid', 'true');
+        input.reportValidity();
+        return;
+      }
+      stop();
+      const currentAttempt = attempt;
+      connect.disabled = true;
+      connect.textContent = 'Connecting…';
+      disconnect.hidden = false;
+      disconnect.textContent = 'Cancel';
+      input.readOnly = true;
+      form.setAttribute('aria-busy', 'true');
+      display('connecting', 'Connecting', `Allow ${permissionTitle} if your browser asks. Checking your ${id}…`);
+      if (await checkPermission() === 'denied' || currentAttempt !== attempt) return;
+      controller = new AbortController();
+      const requestController = controller;
+      let timedOut = false;
+      const timeout = setTimeout(() => {
+        timedOut = true;
+        requestController.abort();
+      }, 12000);
+      try {
+        const response = await fetch(endpoint, {
+          method: 'GET',
+          mode: 'cors',
+          credentials: 'omit',
+          cache: 'no-store',
+          redirect: 'error',
+          referrerPolicy: 'no-referrer',
+          targetAddressSpace: space,
+          signal: requestController.signal,
+        });
+        if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check its status path and service configuration.`);
+        // Reachability only: no response body or brewing commands are needed.
+        if (response.body) await response.body.cancel();
+        if (currentAttempt !== attempt) return;
+        display('connected', 'Connected', `Endpoint reachable. Last checked at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. Select Check again to refresh.`);
+        connect.textContent = 'Check again';
+        disconnect.textContent = 'Disconnect';
+      } catch (error) {
+        if (currentAttempt !== attempt) return;
+        resetControls();
+        const setup = id === 'brewer'
+          ? 'Check the brewer is on and you’re on the same private Wi-Fi.'
+          : 'Open the desktop helper on this computer and check its port.';
+        display('error', timedOut ? 'Timed out' : 'Could not connect',
+          timedOut ? `No response within 12 seconds. ${setup}` :
+            error instanceof TypeError ? `${setup} Check browser site permissions and endpoint CORS settings. Your browser may not support local HTTP access; try a current Chrome or Edge browser or a trusted HTTPS endpoint.` : error.message);
+      } finally {
+        clearTimeout(timeout);
+        if (currentAttempt === attempt) {
+          controller = undefined;
+          connect.disabled = false;
+          form.setAttribute('aria-busy', 'false');
+        }
+      }
+    });
+
+    // Permission queries do not initiate network requests or permission prompts.
+    void checkPermission();
+  }
+})();
