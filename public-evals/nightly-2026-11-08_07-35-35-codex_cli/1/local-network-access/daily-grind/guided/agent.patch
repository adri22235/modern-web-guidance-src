+.equipment-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
+.equipment-status[data-state="connected"] { background: #eaf1e6; color: #36552b; }
+.equipment-status[data-state="error"] { background: #fff0e8; color: #923b23; }
+.equipment-status[data-state="connecting"] { background: #faf0d7; color: #77551b; }
+.equipment-card h3 { font-size: 1.35rem; letter-spacing: -.025em; margin-block: 5px 8px; }
+.equipment-description { color: #706258; font-size: .9rem; min-height: 3.2em; margin-block-end: 23px; }
+.equipment-card label { display: block; font-weight: 600; font-size: .8rem; margin-block-end: 7px; }
+.equipment-card label span { color: #78685d; font-weight: 400; }
+.equipment-card input { display: block; width: 100%; min-height: 48px; border: 1px solid #8e8073; border-radius: 6px; background: #fdfcf9; padding: 10px 12px; font: inherit; font-size: 1rem; color: #4e342e; }
+.equipment-card input:user-invalid, .equipment-card input[aria-invalid="true"] { border-color: #a44023; }
+.equipment-card input:read-only { background: #f1efeb; }
+.equipment-hint { color: #78685d; font-size: .75rem; margin-block: 7px 18px; min-height: 2.5em; }
+.equipment-actions { display: flex; gap: 10px; flex-wrap: wrap; }
+.equipment-actions button { font: inherit; font-size: .85rem; font-weight: 600; border-radius: 6px; min-height: 48px; padding: 10px 18px; cursor: pointer; }
+.equipment-connect { flex: 1; display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #4e342e; border: 1px solid #4e342e; color: #fff; }
+.equipment-connect:hover { background: #36231f; }
+.equipment-connect:disabled { opacity: .65; cursor: wait; }
+.equipment-disconnect { background: transparent; border: 1px solid #8e8073; color: #4e342e; }
+.equipment-actions [hidden] { display: none; }
+.equipment-feedback { font-size: .78rem; margin-block-start: 13px; min-height: 3.2em; overflow-wrap: anywhere; }
+.equipment-permission { font-size: .7rem; color: #78685d; margin-block-start: 8px; }
+.equipment-footnote { display: flex; align-items: center; gap: 10px; margin-block: 20px 12px; font-size: .78rem; color: #78685d; }
+.equipment-footnote > span { font-size: 1.5rem; }
+.equipment-help { font-size: .8rem; color: #655044; }
+.equipment-help summary { cursor: pointer; padding-block: 10px; font-weight: 600; }
+.equipment-help p { margin-block: 10px; max-width: 85ch; }
