diff --git a/tests/equipment.test.cjs b/tests/equipment.test.cjs
new file mode 100644
index 0000000..f49a68b
--- /dev/null
+++ b/tests/equipment.test.cjs
@@ -0,0 +1,168 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+function setup({ secure = true, permissions = {}, fetchImpl = async () => ({ ok: true }) } = {}) {
+  const nodes = new Map();
+  const handlers = new Map();
+  function node(id) {
+    if (!nodes.has(id)) nodes.set(id, {
+      value: '', textContent: '', hidden: false, disabled: false, readOnly: false,
+      dataset: {}, attributes: {}, children: {},
+      addEventListener(type, fn) { handlers.set(`${id}:${type}`, fn); },
+      setAttribute(key, value) { this.attributes[key] = value; },
+      removeAttribute(key) { delete this.attributes[key]; },
+      setCustomValidity(value) { this.validationMessage = value; },
+      reportValidity() { this.reported = true; },
+      querySelector(selector) { return node(`${id}${selector}`); },
+    });
+    return nodes.get(id);
+  }
+  node('brewer-url').value = 'http://192.168.1.100/api/status';
+  node('helper-url').value = 'http://127.0.0.1:45678/health';
+  const requests = [];
+  const statuses = {};
+  const timers = new Map();
+  let timerId = 0;
+  vm.runInNewContext(readFileSync('equipment.js', 'utf8'), {
+    URL, AbortController, TypeError, Date,
+    window: { isSecureContext: secure },
+    document: { getElementById: node, querySelector: selector => node(selector.slice(1)) },
+    navigator: { permissions: { async query({ name }) {
+      if (permissions[name] === 'unsupported') throw new TypeError('Unsupported');
+      return statuses[name] ||= { state: permissions[name] || 'prompt', addEventListener(type, listener) { this.change = listener; } };
+    } } },
+    fetch: async (url, options) => { requests.push({ url, options }); return fetchImpl(url, options); },
+    setTimeout: fn => { timers.set(++timerId, fn); return timerId; },
+    clearTimeout: id => timers.delete(id),
+  });
+  const settle = () => new Promise(resolve => setImmediate(resolve));
+  return {
+    node, requests, statuses, timers, settle,
+    submit: id => handlers.get(`${id}-form:submit`)({ preventDefault() {} }),
+    click: id => handlers.get(`${id}-form.equipment-disconnect:click`)(),
+  };
+}
+
+test('page load only checks granular permissions and never contacts equipment', async () => {
+  const app = setup();
+  await app.settle();
+  assert.equal(app.requests.length, 0);
+  assert.deepEqual(Object.keys(app.statuses).sort(), ['local-network', 'loopback-network']);
+});
+
+test('each explicit connection uses its own address space, without credentials or redirects', async () => {
+  const app = setup();
+  await app.settle();
+  for (const [id, space] of [['brewer', 'local'], ['helper', 'loopback']]) {
+    await app.submit(id);
+    const request = app.requests.at(-1);
+    assert.equal(request.options.targetAddressSpace, space);
+    assert.equal(request.options.mode, 'cors');
+    assert.equal(request.options.method, 'GET');
+    assert.equal(request.options.credentials, 'omit');
+    assert.equal(request.options.redirect, 'error');
+    assert.equal(request.options.referrerPolicy, 'no-referrer');
+    assert.equal(app.node(`${id}-status`).dataset.state, 'connected');
+  }
+  app.click('brewer');
+  assert.equal(app.node('brewer-status').dataset.state, 'idle');
+  assert.equal(app.node('helper-status').dataset.state, 'connected');
+});
+
+test('public URLs, wrong address spaces, credentials, and non-HTTP URLs are rejected', async () => {
+  const app = setup();
+  await app.settle();
+  for (const [id, url] of [
+    ['brewer', 'http://example.com/status'], ['brewer', 'http://127.0.0.1/health'],
+    ['helper', 'http://192.168.1.100/status'], ['helper', 'http://127.0.0.1.example.com/health'],
+    ['helper', 'http://user:secret@127.0.0.1/health'], ['brewer', 'ftp://192.168.1.100/status'],
+  ]) {
+    app.node(`${id}-url`).value = url;
+    await app.submit(id);
+    assert.ok(app.node(`${id}-url`).validationMessage, url);
+  }
+  assert.equal(app.requests.length, 0);
+});
+
+test('private IPv4, mDNS, IPv6 LAN, and loopback endpoints are accepted', async () => {
+  const app = setup();
+  await app.settle();
+  for (const [id, url] of [
+    ['brewer', 'http://10.0.0.8/status'], ['brewer', 'http://172.16.2.3/status'],
+    ['brewer', 'http://brewer.local/status'], ['brewer', 'http://[fd00::1]/status'],
+    ['helper', 'http://localhost:45678/health'], ['helper', 'http://[::1]:45678/health'],
+  ]) {
+    app.node(`${id}-url`).value = url;
+    await app.submit(id);
+    assert.equal(app.node(`${id}-status`).dataset.state, 'connected', url);
+  }
+});
+
+test('insecure pages send no equipment requests', async () => {
+  const app = setup({ secure: false });
+  await app.submit('brewer');
+  assert.equal(app.requests.length, 0);
+  assert.equal(app.node('brewer-status').textContent, 'HTTPS required');
+});
+
+test('denied LAN permission leaves loopback usable; permission changes revoke state', async () => {
+  const app = setup({ permissions: { 'local-network': 'denied' } });
+  await app.settle();
+  await app.submit('brewer');
+  assert.equal(app.requests.length, 0);
+  assert.match(app.node('brewer-feedback').textContent, /browser settings/);
+  await app.submit('helper');
+  assert.equal(app.node('helper-status').dataset.state, 'connected');
+  app.statuses['loopback-network'].state = 'denied';
+  app.statuses['loopback-network'].change();
+  assert.equal(app.node('helper-status').textContent, 'Access blocked');
+  assert.equal(app.node('helper-url').readOnly, false);
+});
+
+test('unsupported permission queries still allow explicit connection attempts', async () => {
+  const app = setup({ permissions: { 'local-network': 'unsupported', 'loopback-network': 'unsupported' } });
+  await app.settle();
+  assert.equal(app.requests.length, 0);
+  await app.submit('helper');
+  assert.equal(app.node('helper-status').dataset.state, 'connected');
+});
+
+test('HTTP errors and opaque network failures never show a successful connection', async () => {
+  for (const fetchImpl of [async () => ({ ok: false, status: 503 }), async () => { throw new TypeError('Failed to fetch'); }]) {
+    const app = setup({ fetchImpl });
+    await app.settle();
+    await app.submit('brewer');
+    assert.equal(app.node('brewer-status').dataset.state, 'error');
+    assert.equal(app.node('brewer-form.equipment-connect').disabled, false);
+    assert.equal(app.node('brewer-url').readOnly, false);
+  }
+});
+
+test('cancelling ignores a late successful response', async () => {
+  let finish;
+  const app = setup({ fetchImpl: () => new Promise(resolve => { finish = resolve; }) });
+  await app.settle();
+  const pending = app.submit('helper');
+  await app.settle();
+  const signal = app.requests[0].options.signal;
+  app.click('helper');
+  assert.equal(signal.aborted, true);
+  finish({ ok: true });
+  await pending;
+  assert.equal(app.node('helper-status').dataset.state, 'idle');
+});
+
+test('a timed-out request is aborted and offers recovery', async () => {
+  const app = setup({ fetchImpl: (url, { signal }) => new Promise((resolve, reject) => {
+    signal.addEventListener('abort', () => reject(new Error('Aborted')));
+  }) });
+  await app.settle();
+  const pending = app.submit('brewer');
+  await app.settle();
+  for (const timer of app.timers.values()) timer();
+  await pending;
+  assert.equal(app.node('brewer-status').textContent, 'Timed out');
+  assert.equal(app.node('brewer-form.equipment-connect').disabled, false);
+});
