@@ -0,0 +1,99 @@
+'use strict';
+
+// User-initiated health checks only. No discovery, proxying, or brewing commands.
+function validateEndpoint(value, device) {
+  let url;
+  try { url = new URL(value.trim()); } catch { throw new Error('Enter a complete URL, including http:// or https://.'); }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP(S) endpoint without credentials or a fragment.');
+  }
+  const parts = url.hostname.split('.').map(Number);
+  const ipv4 = parts.length === 4 && parts.every(part => Number.isInteger(part) && part >= 0 && part <= 255);
+  const privateLAN = ipv4 && (parts[0] === 10 || (parts[0] === 192 && parts[1] === 168) || (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31));
+  const loopback = url.hostname === 'localhost' || url.hostname === '[::1]' || (ipv4 && parts[0] === 127);
+  if (device === 'brewer' && !privateLAN) throw new Error('Use the brewer’s private LAN IP: 192.168.x.x, 10.x.x.x, or 172.16–31.x.x.');
+  if (device === 'helper' && !loopback) throw new Error('Use 127.0.0.1, localhost, or [::1] for the helper on this computer.');
+  return url;
+}
+
+for (const form of document.querySelectorAll('[data-device]')) {
+  const device = form.dataset.device;
+  const input = form.elements.endpoint;
+  const badge = form.querySelector('.device-status');
+  const button = form.querySelector('button');
+  const buttonLabel = button.firstElementChild;
+  const feedback = form.querySelector('.connection-feedback');
+  const connectLabel = device === 'brewer' ? 'Connect brewer' : 'Connect desktop helper';
+  let state = 'idle';
+  let controller = null;
+  let attempt = 0;
+
+  function render(next, message) {
+    state = next;
+    badge.dataset.state = next;
+    badge.textContent = { idle: 'Not connected', connecting: 'Connecting', connected: 'Connected', error: 'Connection failed' }[next];
+    buttonLabel.textContent = next === 'connecting' ? 'Cancel connection' : next === 'connected' ? 'Disconnect' : next === 'error' ? 'Try again' : connectLabel;
+    input.disabled = next === 'connecting' || next === 'connected';
+    feedback.textContent = message;
+  }
+
+  input.addEventListener('input', () => {
+    input.removeAttribute('aria-invalid');
+    if (state === 'error') render('idle', 'Ready to check your updated endpoint.');
+  });
+
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (state === 'connecting' || state === 'connected') {
+      attempt++;
+      controller?.abort();
+      controller = null;
+      render('idle', state === 'connecting' ? 'Connection cancelled. You can try again any time.' : 'Disconnected. Connect again for a fresh health check.');
+      return;
+    }
+    let endpoint;
+    try {
+      endpoint = validateEndpoint(input.value, device);
+      input.removeAttribute('aria-invalid');
+    } catch (error) {
+      input.setAttribute('aria-invalid', 'true');
+      render('error', error.message);
+      input.focus();
+      return;
+    }
+    if (!window.isSecureContext) {
+      render('error', 'Open this page over HTTPS or localhost to request local network access.');
+      return;
+    }
+    const currentAttempt = ++attempt;
+    const activeController = new AbortController();
+    controller = activeController;
+    let timedOut = false;
+    const timeout = setTimeout(() => { timedOut = true; activeController.abort(); }, 15000);
+    render('connecting', 'Checking the endpoint… Allow local network access if your browser asks.');
+    try {
+      const response = await fetch(endpoint.href, {
+        method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+        redirect: 'error', referrerPolicy: 'no-referrer', signal: activeController.signal,
+        targetAddressSpace: device === 'brewer' ? 'local' : 'loopback'
+      });
+      if (currentAttempt !== attempt) return;
+      if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check its health path and service status.`);
+      // A health check requires only the response headers; do not retain device data.
+      if (response.body) response.body.cancel().catch(() => {});
+      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+      render('connected', `Health check passed at ${time}. Disconnect and reconnect to check again.`);
+    } catch (error) {
+      if (currentAttempt !== attempt) return;
+      const message = timedOut
+        ? 'No response within 15 seconds. Check the address, Wi-Fi or running helper, then try again.'
+        : error instanceof TypeError
+          ? 'Could not reach the endpoint. Check the service, network permission, HTTPS and CORS settings. Open the connection help below.'
+          : error.message;
+      render('error', message);
+    } finally {
+      clearTimeout(timeout);
+      if (currentAttempt === attempt) controller = null;
+    }
+  });
+}
