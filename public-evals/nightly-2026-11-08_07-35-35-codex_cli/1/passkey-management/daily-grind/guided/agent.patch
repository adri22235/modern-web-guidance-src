+(() => {
+  'use strict';
+
+  const storageKey = 'daily-grind:preview-passkeys:v1';
+  const seed = {
+    demo: true,
+    rpId: null,
+    userId: 'amFtaWUtZGF2aXM',
+    credentials: [
+      { id: 'ZGVtby1tYWNib29r', name: 'MacBook Pro', provider: 'iCloud Keychain', device: 'laptop', registeredAt: 1788739200000, lastUsedAt: 1794096000000, current: true },
+      { id: 'ZGVtby1pcGhvbmU', name: 'iPhone 15', provider: 'iCloud Keychain', device: 'phone', registeredAt: 1788739200000, lastUsedAt: 1794009600000 },
+      { id: 'ZGVtby1zZWN1cml0eS1rZXk', name: 'YubiKey 5C', provider: 'Security key', device: 'usb', registeredAt: 1789776000000, lastUsedAt: 1793491200000 }
+    ]
+  };
+  const list = document.querySelector('#passkey-list');
+  const accountStatus = document.querySelector('#account-status');
+  const renameDialog = document.querySelector('#rename-dialog');
+  const deleteDialog = document.querySelector('#delete-dialog');
+  let account;
+  let activeId;
+  let toastTimeout;
+  let saving = false;
+  const dateFormatter = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+
+  const validId = value => typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+  const validCredentials = credentials => Array.isArray(credentials) && credentials.every(key => key && validId(key.id) && typeof key.name === 'string' && Number.isFinite(key.registeredAt));
+
+  function icon(name) {
+    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    svg.classList.add('icon');
+    svg.setAttribute('aria-hidden', 'true');
+    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+    use.setAttribute('href', `#i-${name}`);
+    svg.append(use);
+    return svg;
+  }
+
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+
+  async function request(url, options = {}) {
+    const response = await fetch(url, { credentials: 'same-origin', ...options, headers: { Accept: 'application/json', ...options.headers } });
+    if (response.status === 401 || response.status === 403) throw new Error('Your session has expired. Please sign in again to manage your passkeys.');
+    return response;
+  }
+
+  function loadPreview() {
+    let credentials = structuredClone(seed.credentials);
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (validCredentials(saved)) credentials = saved;
+    } catch { /* Storage can be unavailable in private browsing. */ }
+    return { ...seed, credentials };
+  }
+
+  async function loadAccount() {
+    const response = await request('/api/passkeys');
+    // Static hosting may return index.html for unknown paths. Only a missing API
+    // enters preview mode; authorization, network and server errors stay visible.
+    if (response.status === 404 || (response.ok && response.headers.get('content-type')?.includes('text/html'))) return loadPreview();
+    if (!response.ok) throw new Error('We couldn’t load your passkeys. Please try again.');
+    const result = await response.json();
+    if (!validCredentials(result.credentials) || !validId(result.userId) || typeof result.rpId !== 'string' || !result.rpId.trim()) throw new Error('Your passkey details are unavailable. Please try again later.');
+    return { ...result, demo: false };
+  }
+
+  async function syncCredentials() {
+    const title = document.querySelector('#sync-title');
+    const description = document.querySelector('#sync-description');
+    const label = document.querySelector('#sync-label');
+    if (account.demo) {
+      title.textContent = 'Your passkeys, kept in step.';
+      description.textContent = 'Supported browsers keep your passkey manager up to date when you remove a key.';
+      label.lastChild.textContent = ' Browser sync';
+      return;
+    }
+    if (!window.PublicKeyCredential || typeof window.PublicKeyCredential.signalAllAcceptedCredentials !== 'function') {
+      title.textContent = 'Your account is up to date.';
+      description.textContent = 'This browser doesn’t support auto-sync. Remove deleted keys from your device’s passkey settings, too.';
+      label.lastChild.textContent = ' Manual sync';
+      return;
+    }
+    const ids = account.credentials.map(key => key.id);
+    if (!account.rpId || !validId(account.userId) || !ids.every(validId)) return;
+    try {
+      await window.PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: ids });
+      title.textContent = 'A little less to keep track of.';
+      description.textContent = 'Your latest passkey list has been shared with your browser’s passkey manager.';
+      label.lastChild.textContent = ' Auto-sync';
+    } catch (error) {
+      console.warn('Passkey manager sync was unavailable:', error);
+      title.textContent = 'Your account changes are saved.';
+      description.textContent = 'Browser sync is unavailable right now. You may need to remove deleted keys in your device settings.';
+      label.lastChild.textContent = ' Sync pending';
+    }
+  }
+
+  function render() {
+    list.replaceChildren();
+    document.querySelector('#key-count').textContent = account.credentials.length;
+    if (!account.credentials.length) {
+      const empty = element('div', 'empty-state');
+      empty.append(icon('key'), element('h4', '', 'A fresh start.'), element('p', '', 'You don’t have any registered passkeys. Use your other sign-in method to access your account.'));
+      list.append(empty);
+    }
+    for (const key of account.credentials) {
+      const row = element('article', 'passkey-row');
+      const device = element('div', 'device-icon');
+      device.append(icon(['laptop', 'phone', 'usb'].includes(key.device) ? key.device : 'key'));
+      const info = element('div', 'key-info');
+      const title = element('div', 'key-title');
+      title.append(element('h4', '', key.name));
+      if (key.current) title.append(element('span', 'device-badge', 'This device'));
+      const dates = element('div', 'key-dates');
+      dates.append(element('span', '', `Added ${dateFormatter.format(key.registeredAt)}`), element('span', 'separator', '·'), element('span', 'used', Number.isFinite(key.lastUsedAt) ? `Last used ${dateFormatter.format(key.lastUsedAt)}` : 'Not used yet'));
+      info.append(title, element('p', 'provider', key.provider || 'Passkey provider'), dates);
+      const actions = element('div', 'key-actions');
+      const rename = element('button', 'rename-button');
+      rename.type = 'button';
+      rename.setAttribute('aria-label', `Rename ${key.name}`);
+      rename.append(icon('edit'), document.createTextNode('Rename'));
+      rename.addEventListener('click', () => {
+        activeId = key.id;
+        document.querySelector('#passkey-name').value = key.name;
+        document.querySelector('#rename-error').textContent = '';
+        renameDialog.showModal();
+        document.querySelector('#passkey-name').select();
+      });
+      const remove = element('button', 'delete-button');
+      remove.type = 'button';
+      remove.setAttribute('aria-label', `Remove ${key.name}`);
+      remove.title = `Remove ${key.name}`;
+      remove.append(icon('trash'));
+      remove.addEventListener('click', () => {
+        activeId = key.id;
+        document.querySelector('#delete-key-name').textContent = key.name;
+        document.querySelector('#delete-error').textContent = '';
+        document.querySelector('#delete-notice').textContent = account.credentials.length === 1 ? 'This is your last passkey. Make sure you can sign in using another method before you remove it.' : 'Your other passkeys will still work. You’ll stay signed in on this device.';
+        deleteDialog.showModal();
+      });
+      actions.append(rename, remove);
+      row.append(device, info, actions);
+      list.append(row);
+    }
+    if (account.demo) accountStatus.textContent = 'Preview account · Changes are saved only in this browser. No real passkeys are modified.';
+    else accountStatus.textContent = '';
+  }
+
+  async function mutate(id, name) {
+    if (!account.credentials.some(key => key.id === id)) throw new Error('This passkey is no longer available. Refresh the page to see your latest passkeys.');
+    const credentials = name === undefined ? account.credentials.filter(key => key.id !== id) : account.credentials.map(key => key.id === id ? { ...key, name } : key);
+    if (account.demo) {
+      // Commit UI state only after local persistence succeeds.
+      try { localStorage.setItem(storageKey, JSON.stringify(credentials)); }
+      catch { throw new Error('Your browser couldn’t save this change. Enable site storage and try again.'); }
+      account = { ...account, credentials };
+    } else {
+      const response = await request(`/api/passkeys/${encodeURIComponent(id)}`, {
+        method: name === undefined ? 'DELETE' : 'PATCH',
+        headers: { 'Content-Type': 'application/json', ...(account.csrfToken ? { 'X-CSRF-Token': account.csrfToken } : {}) },
+        ...(name !== undefined ? { body: JSON.stringify({ name }) } : {})
+      });
+      if (!response.ok) throw new Error('We couldn’t save that change. Please try again.');
+      // DELETE returns the authoritative remaining list, avoiding a second fetch
+      // that could fail after deletion and leave a stale credential in the UI.
+      const updated = await response.json();
+      if (!validCredentials(updated.credentials)) throw new Error('The change was submitted, but we couldn’t refresh your passkeys. Please reload this page.');
+      account = { ...account, credentials: updated.credentials };
+    }
+  }
+
+  function toast(message) {
+    clearTimeout(toastTimeout);
+    const node = document.querySelector('#toast');
+    node.querySelector('span').textContent = message;
+    node.hidden = false;
+    toastTimeout = setTimeout(() => { node.hidden = true; }, 5000);
+  }
+
+  async function submit(event, deleting) {
+    event.preventDefault();
+    if (saving) return;
+    const form = event.currentTarget;
+    const error = document.querySelector(deleting ? '#delete-error' : '#rename-error');
+    const name = document.querySelector('#passkey-name').value.trim();
+    error.textContent = '';
+    if (!deleting && (!name || name.length > 60)) { error.textContent = 'Choose a name between 1 and 60 characters.'; return; }
+    saving = true;
+    const button = form.querySelector('[type="submit"]');
+    const originalLabel = button.textContent;
+    button.disabled = true;
+    button.textContent = deleting ? 'Removing…' : 'Saving…';
+    try {
+      await mutate(activeId, deleting ? undefined : name);
+      form.closest('dialog').close();
+      render();
+      // Rendering replaces the original dialog invoker. Restore focus to its
+      // replacement after renaming, or the list heading after deletion.
+      if (deleting) {
+        const heading = document.querySelector('#passkeys-heading');
+        heading.tabIndex = -1;
+        heading.focus();
+        await syncCredentials();
+      } else {
+        const index = account.credentials.findIndex(key => key.id === activeId);
+        list.querySelectorAll('.rename-button')[index]?.focus();
+      }
+      // Individual nicknames are site labels, not user identity details:
+      // never call signalCurrentUserDetails for a passkey rename.
+      toast(deleting ? 'Passkey removed from your account.' : 'Passkey name updated.');
+    } catch (failure) { error.textContent = failure.message; }
+    finally { saving = false; button.disabled = false; button.textContent = originalLabel; }
+  }
+
+  document.querySelector('#rename-form').addEventListener('submit', event => submit(event, false));
+  document.querySelector('#delete-form').addEventListener('submit', event => submit(event, true));
+  document.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => button.closest('dialog').close()));
+  document.querySelector('#learn-button').addEventListener('click', () => document.querySelector('#learn-dialog').showModal());
+  [renameDialog, deleteDialog].forEach(dialog => dialog.addEventListener('cancel', event => { if (saving) event.preventDefault(); }));
+
+  async function initialize() {
+    try {
+      account = await loadAccount();
+      if (!account.demo) {
+        document.querySelector('.account-card strong').textContent = account.displayName || 'Your account';
+        document.querySelector('.avatar').firstChild.textContent = (account.displayName || 'Your account').split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase();
+      }
+      render();
+      await syncCredentials();
+    } catch (error) {
+      list.replaceChildren(element('p', 'loading', error.message));
+      const retry = element('button', 'button secondary retry-button', 'Try again');
+      retry.addEventListener('click', () => { list.replaceChildren(element('p', 'loading', 'Loading your passkeys…')); initialize(); });
+      list.firstChild.append(document.createElement('br'), retry);
+      document.querySelector('#key-count').textContent = '–';
+      document.querySelector('#sync-label').hidden = true;
+      accountStatus.textContent = 'Passkey management is currently unavailable.';
+    }
+  }
+  initialize();
+})();
