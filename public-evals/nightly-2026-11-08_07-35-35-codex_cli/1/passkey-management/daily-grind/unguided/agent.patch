diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
new file mode 100644
index 0000000..20143d0
--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPreviewRepository, validateName, syncAuthenticator } from '../passkeys.mjs';
+function memoryStorage() { const data = new Map(); return { getItem: key => data.get(key) ?? null, setItem: (key, value) => data.set(key, value) }; }
+test('rename and deletion persist across account reloads', async () => {
+  const storage = memoryStorage();
+  const account = createPreviewRepository(storage);
+  await account.rename('sample-mac', '  My laptop  ');
+  await account.remove('sample-phone');
+  const { passkeys } = await createPreviewRepository(storage).list();
+  assert.equal(passkeys.length, 2);
+  assert.equal(passkeys[0].name, 'My laptop');
+  assert.ok(!passkeys.some(key => key.id === 'sample-phone'));
+});
+test('invalid names, missing keys, and storage failure preserve records', async () => {
+  assert.throws(() => validateName('   '));
+  assert.throws(() => validateName('a'.repeat(51)));
+  const account = createPreviewRepository({ getItem: () => '{invalid', setItem: () => { throw Error('Storage blocked'); } });
+  await assert.rejects(account.rename('sample-mac', 'Laptop'), /Storage blocked/);
+  await assert.rejects(account.remove('sample-mac'), /Storage blocked/);
+  await assert.rejects(account.remove('missing'));
+  assert.equal((await account.list()).passkeys.length, 3);
+  assert.equal((await account.list()).passkeys[0].name, 'MacBook Pro');
+});
+test('an empty saved list remains empty on reload', async () => {
+  const storage = memoryStorage();
+  const account = createPreviewRepository(storage);
+  for (const key of (await account.list()).passkeys) await account.remove(key.id);
+  assert.deepEqual((await createPreviewRepository(storage).list()).passkeys, []);
+});
+test('authenticator sync prefers a complete accepted server snapshot', async () => {
+  let received;
+  const snapshot = { rpId: 'example.com', userId: 'dXNlcg', passkeys: [{ credentialId: 'a2V5' }] };
+  const result = await syncAuthenticator(snapshot, 'b2xk', { signalAllAcceptedCredentials: async options => { received = options; }, signalUnknownCredential: () => assert.fail('prefer full snapshot') });
+  assert.equal(result, 'signaled');
+  assert.deepEqual(received, { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] });
+});
+test('sync has an individual-credential fallback and handles unavailable or rejected signals', async () => {
+  let received;
+  const snapshot = { rpId: 'example.com', passkeys: [] };
+  assert.equal(await syncAuthenticator(snapshot, 'b2xk', { signalUnknownCredential: async options => { received = options; } }), 'signaled');
+  assert.deepEqual(received, { rpId: 'example.com', credentialId: 'b2xk' });
+  assert.equal(await syncAuthenticator(snapshot, 'b2xk', {}), 'unsupported');
+  assert.equal(await syncAuthenticator(snapshot, 'b2xk', { signalUnknownCredential: async () => { throw Error('Denied'); } }), 'failed');
+});
+test('account API encodes IDs, sends session and CSRF protection, and surfaces failures', async () => {
+  const { createAccountRepository } = await import('../passkeys.mjs');
+  globalThis.location = { origin: 'https://dailygrind.example' };
+  const calls = [];
+  const account = createAccountRepository({ apiBase: '/api/account/passkeys', csrfToken: 'token' }, async (url, options) => {
+    calls.push({ url, options });
+    return { ok: true, status: 204 };
+  });
+  await account.rename('key/1', '  Work phone  ');
+  assert.equal(calls[0].url, 'https://dailygrind.example/api/account/passkeys/key%2F1');
+  assert.equal(calls[0].options.credentials, 'same-origin');
+  assert.equal(calls[0].options.headers['X-CSRF-Token'], 'token');
+  assert.equal(calls[0].options.method, 'PATCH');
+  assert.deepEqual(JSON.parse(calls[0].options.body), { name: 'Work phone' });
+  await account.remove('key/1');
+  assert.equal(calls[1].options.method, 'DELETE');
+  const expired = createAccountRepository({ apiBase: '/api/account/passkeys' }, async () => ({ ok: false, status: 401 }));
+  await assert.rejects(expired.remove('key'), /session has expired/);
+  assert.throws(() => createAccountRepository({ apiBase: 'https://other.example/keys' }), /same origin/);
+});
