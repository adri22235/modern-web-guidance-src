@@ -0,0 +1,79 @@
+export const SAMPLE_PASSKEYS = [
+  { id: 'sample-mac', name: 'MacBook Pro', kind: 'laptop', provider: 'iCloud Keychain', created: 'Oct 12, 2026', lastUsed: 'Today', current: true },
+  { id: 'sample-phone', name: 'iPhone 15', kind: 'phone', provider: 'iCloud Keychain', created: 'Sep 28, 2026', lastUsed: '3 days ago' },
+  { id: 'sample-key', name: 'YubiKey 5C', kind: 'key', provider: 'Security key', created: 'Aug 15, 2026', lastUsed: '2 weeks ago' },
+];
+export function validateName(value) {
+  const name = value.trim();
+  if (!name) throw new Error('Please enter a name for this passkey.');
+  if (name.length > 50) throw new Error('Keep the name to 50 characters or fewer.');
+  return name;
+}
+export function createPreviewRepository(storage) {
+  const storageKey = 'daily-grind-passkeys-v1';
+  let keys = structuredClone(SAMPLE_PASSKEYS);
+  try {
+    const saved = JSON.parse(storage.getItem(storageKey));
+    if (Array.isArray(saved) && saved.every(key => SAMPLE_PASSKEYS.some(sample => sample.id === key.id) && typeof key.name === 'string' && key.name.trim() && key.name.length <= 50) && new Set(saved.map(key => key.id)).size === saved.length) {
+      keys = saved.map(key => ({ ...SAMPLE_PASSKEYS.find(sample => sample.id === key.id), name: key.name }));
+    }
+  } catch { /* A blocked storage area still allows an in-memory preview. */ }
+  function save(next) {
+    // Do not report a successful change when persistent storage fails.
+    storage.setItem(storageKey, JSON.stringify(next));
+    keys = next;
+  }
+  return {
+    preview: true,
+    async list() { return { passkeys: structuredClone(keys) }; },
+    async rename(id, value) {
+      const name = validateName(value);
+      if (!keys.some(key => key.id === id)) throw new Error('This passkey is no longer available.');
+      save(keys.map(key => key.id === id ? { ...key, name } : key));
+    },
+    async remove(id) {
+      if (!keys.some(key => key.id === id)) throw new Error('This passkey has already been removed.');
+      save(keys.filter(key => key.id !== id));
+    },
+  };
+}
+
+// The server must scope every operation to the authenticated customer and enforce CSRF protection.
+export function createAccountRepository({ apiBase, csrfToken }, request = fetch) {
+  const base = new URL(apiBase, location.origin);
+  if (base.origin !== location.origin) throw new Error('The account API must use the same origin.');
+  async function send(path = '', method = 'GET', body) {
+    const response = await request(`${base.href.replace(/\/$/, '')}${path}`, {
+      method, credentials: 'same-origin', cache: 'no-store',
+      headers: { Accept: 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}), ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+    if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Please sign in again.' : 'We couldn’t save this change. Please try again.');
+    return response.status === 204 ? undefined : response.json();
+  }
+  return {
+    preview: false,
+    list: () => send(),
+    rename: (id, name) => send(`/${encodeURIComponent(id)}`, 'PATCH', { name: validateName(name) }),
+    remove: id => send(`/${encodeURIComponent(id)}`, 'DELETE'),
+  };
+}
+
+// Call only with a fresh server snapshot after a successful server-side deletion.
+export async function syncAuthenticator(snapshot, credentialId, credentialAPI = globalThis.PublicKeyCredential) {
+  if (!credentialAPI) return 'unsupported';
+  try {
+    if (typeof credentialAPI.signalAllAcceptedCredentials === 'function' && snapshot.userId && snapshot.rpId) {
+      await credentialAPI.signalAllAcceptedCredentials({
+        rpId: snapshot.rpId, userId: snapshot.userId,
+        allAcceptedCredentialIds: snapshot.passkeys.map(key => key.credentialId),
+      });
+      return 'signaled';
+    }
+    if (typeof credentialAPI.signalUnknownCredential === 'function' && credentialId && snapshot.rpId) {
+      await credentialAPI.signalUnknownCredential({ rpId: snapshot.rpId, credentialId });
+      return 'signaled';
+    }
+  } catch { return 'failed'; }
+  return 'unsupported';
+}
