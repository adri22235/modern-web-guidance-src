+import { createPreviewRepository, createAccountRepository, validateName, syncAuthenticator } from './passkeys.mjs';
+
+const $ = selector => document.querySelector(selector);
+let storage;
+try { storage = window.localStorage; } catch { storage = { getItem() { return null; }, setItem() { throw new Error('Browser storage is unavailable. Enable storage to save changes.'); } }; }
+const repository = window.dailyGrindAccount?.apiBase
+  ? createAccountRepository(window.dailyGrindAccount)
+  : createPreviewRepository(storage);
+let snapshot = { passkeys: [] };
+let action;
+let selected;
+let busy = false;
+let toastTimer;
+const dialog = $('#action-dialog');
+const form = $('#action-form');
+const list = $('#passkey-list');
+const nameInput = $('#passkey-name');
+
+function icon(type) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+  use.setAttribute('href', `#${type}`);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text) node.textContent = text;
+  return node;
+}
+function render() {
+  $('#key-count').textContent = snapshot.passkeys.length;
+  list.replaceChildren();
+  if (!snapshot.passkeys.length) {
+    const empty = element('div', 'empty-state');
+    empty.append(icon('passkey'), element('h4', '', 'No passkeys registered'), element('p', '', 'Your registered passkeys will appear here. Use another sign-in method to access your account.'));
+    list.append(empty);
+  }
+  for (const key of snapshot.passkeys) {
+    const row = element('article', 'passkey-row');
+    const device = element('div', 'device-icon');
+    device.append(icon(['phone', 'laptop', 'key'].includes(key.kind) ? key.kind : 'key'));
+    const info = element('div', 'device-info');
+    const title = element('div', 'device-title');
+    title.append(element('h4', '', key.name));
+    if (key.current) title.append(element('span', 'current-badge', 'This device'));
+    const meta = element('p', 'device-meta', key.provider || 'Passkey');
+    meta.append(element('span', 'dot', '·'), document.createTextNode(`Added ${key.created || 'recently'}`));
+    const used = element('p', 'device-meta', `Last used: ${key.lastUsed || 'Not yet used'}`);
+    info.append(title, meta, used);
+    const actions = element('div', 'row-actions');
+    for (const [type, label, symbol] of [['rename', 'Rename', 'edit'], ['delete', 'Delete', 'trash']]) {
+      const button = element('button', `icon-button ${type}`);
+      button.type = 'button';
+      button.setAttribute('aria-label', `${label} ${key.name}`);
+      button.title = `${label} passkey`;
+      button.append(icon(symbol));
+      button.addEventListener('click', () => openDialog(type, key));
+      actions.append(button);
+    }
+    row.append(device, info, actions);
+    list.append(row);
+  }
+}
+function notify(message) {
+  clearTimeout(toastTimer);
+  $('#toast').textContent = message;
+  $('#toast').hidden = false;
+  toastTimer = setTimeout(() => { $('#toast').hidden = true; }, 8500);
+}
+function openDialog(type, key) {
+  action = type;
+  selected = key;
+  $('#dialog-error').textContent = '';
+  $('#rename-field').hidden = type !== 'rename';
+  $('#cancel-button').hidden = type === 'about';
+  $('#confirm-button').classList.toggle('danger-button', type === 'delete');
+  $('#confirm-button').textContent = type === 'rename' ? 'Save name' : type === 'delete' ? 'Delete passkey' : 'Got it';
+  if (type === 'rename') {
+    $('#dialog-title').textContent = 'Make it your own.';
+    $('#dialog-description').textContent = 'Give this passkey a name that’s easy to recognize. This label is only used in your Daily Grind account.';
+    nameInput.value = key.name;
+  } else if (type === 'delete') {
+    $('#dialog-title').textContent = 'Remove this passkey?';
+    const lastKey = snapshot.passkeys.length === 1;
+    $('#dialog-description').textContent = `“${key.name}” will no longer be available for signing in.${key.current ? ' This is the passkey for your current device.' : ''}${lastKey ? ' This is your last passkey. Make sure you can sign in with another method before continuing.' : ' You can still use your other passkeys.'}${repository.preview ? ' This preview only removes the sample from this browser.' : ' We’ll notify supported authenticators after removal. You may also need to remove it from your password manager.'}`;
+  } else {
+    $('#dialog-title').textContent = 'A familiar way to sign in.';
+    $('#dialog-description').textContent = 'Passkeys let you use your device’s screen lock, fingerprint, or face instead of a password. Your biometric information stays on your device. Rename a passkey to keep your account organized, or remove one you no longer use. Account labels don’t rename entries in your password manager. Supported browsers can receive updates when a passkey is removed.';
+  }
+  dialog.showModal();
+  if (type === 'rename') { nameInput.focus(); nameInput.select(); }
+  else $('#cancel-button').hidden ? $('#confirm-button').focus() : $('#cancel-button').focus();
+}
+function closeDialog() { if (!busy) dialog.close(); }
+$('.dialog-close').addEventListener('click', closeDialog);
+$('#cancel-button').addEventListener('click', closeDialog);
+$('#about-button').addEventListener('click', () => openDialog('about'));
+dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+dialog.addEventListener('click', event => { if (event.target === dialog && (event.clientX < dialog.getBoundingClientRect().left || event.clientX > dialog.getBoundingClientRect().right || event.clientY < dialog.getBoundingClientRect().top || event.clientY > dialog.getBoundingClientRect().bottom)) closeDialog(); });
+nameInput.addEventListener('input', () => { $('#dialog-error').textContent = ''; });
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (action === 'about') { dialog.close(); return; }
+  let newName;
+  try { if (action === 'rename') newName = validateName(nameInput.value); }
+  catch (error) { $('#dialog-error').textContent = error.message; nameInput.focus(); return; }
+  busy = true;
+  $('#confirm-button').disabled = true;
+  $('#confirm-button').textContent = 'Saving…';
+  try {
+    if (action === 'rename') await repository.rename(selected.id, newName);
+    else await repository.remove(selected.id);
+  } catch (error) {
+    $('#dialog-error').textContent = error.message;
+    busy = false;
+    $('#confirm-button').disabled = false;
+    $('#confirm-button').textContent = action === 'rename' ? 'Save name' : 'Delete passkey';
+    return;
+  }
+  let message = action === 'rename' ? 'Passkey name updated.' : 'Passkey removed.';
+  try {
+    snapshot = await repository.list();
+    render();
+    if (action === 'delete' && !repository.preview) {
+      const sync = await syncAuthenticator(snapshot, selected.credentialId);
+      message += sync === 'signaled' ? ' Your browser has been notified.' : ' Remove it from your device’s password manager too; browser sync is unavailable.';
+    }
+  } catch {
+    // The mutation succeeded. Reflect that without inviting a duplicate delete.
+    snapshot.passkeys = action === 'delete' ? snapshot.passkeys.filter(key => key.id !== selected.id) : snapshot.passkeys.map(key => key.id === selected.id ? { ...key, name: newName } : key);
+    render();
+    message += ' Refresh to get the latest account details. Remove deleted passkeys from your password manager if needed.';
+  }
+  busy = false;
+  $('#confirm-button').disabled = false;
+  dialog.close();
+  // The invoking row button may have been replaced; provide a reliable focus target.
+  $('#passkeys-title').tabIndex = -1;
+  $('#passkeys-title').focus({ preventScroll: true });
+  notify(message);
+});
+async function load() {
+  if (!repository.preview) $('.preview-note').hidden = true;
+  try { snapshot = await repository.list(); render(); }
+  catch (error) {
+    $('#key-count').textContent = '—';
+    const errorState = element('div', 'empty-state');
+    const retry = element('button', 'secondary-button', 'Try again');
+    retry.addEventListener('click', load);
+    errorState.append(element('p', '', error.message), retry);
+    list.replaceChildren(errorState);
+  }
+}
+load();
