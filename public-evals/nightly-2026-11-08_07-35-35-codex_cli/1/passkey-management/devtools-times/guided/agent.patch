diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..792a739
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,28 @@
+import { ApiError, endpoint, json, readJson } from '../../../lib/server/account-api.ts';
+import { getPasskeyStore } from '../../../lib/server/passkey-store.ts';
+
+export const POST = endpoint(async ({ request, session }) => {
+  const { username, password } = await readJson(request);
+  if (typeof username !== 'string' || !username.trim() || username.length > 200 ||
+      typeof password !== 'string' || !password || password.length > 1024) {
+    throw new ApiError(400, 'Enter your username and password.');
+  }
+  const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15_000),
+  });
+  const data = await response.json();
+  if (!response.ok || data.error || data.success === false) {
+    throw new ApiError(response.status >= 500 ? 502 : 401, 'Sign in failed. Check your username and password.');
+  }
+  if (!session) throw new ApiError(503, 'Sign in is temporarily unavailable.');
+  // Trust identity only after the existing password service has authenticated the request.
+  const canonicalUsername = typeof data.user?.username === 'string' ? data.user.username : username;
+  const externalId = data.user?.id ?? data.userId;
+  const identity = typeof externalId === 'string' || typeof externalId === 'number'
+    ? `id:${externalId}` : `username:${canonicalUsername}`;
+  const account = getPasskeyStore().account(identity, canonicalUsername);
+  await session.regenerate();
+  await session.set('userId', account.id);
+  return json({ success: true });
+});
