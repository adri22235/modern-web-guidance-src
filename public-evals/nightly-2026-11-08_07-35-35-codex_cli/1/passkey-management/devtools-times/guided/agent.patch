@@ -0,0 +1,27 @@
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+}
+
+export interface PasskeyList {
+  rpId: string;
+  userId: string;
+  credentials: PasskeySummary[];
+}
+
+export function isBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 &&
+    value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export function validatePasskeyName(value: unknown): string {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > 80) {
+    throw new Error('Enter a passkey name between 1 and 80 characters.');
+  }
+  return value.trim();
+}
diff --git a/src/lib/server/account-api.ts b/src/lib/server/account-api.ts
new file mode 100644
index 0000000..5ffc6b6
--- /dev/null
+++ b/src/lib/server/account-api.ts
@@ -0,0 +1,64 @@
+import type { APIContext, APIRoute } from 'astro';
+import { getPasskeyStore } from './passkey-store.ts';
+
+export class ApiError extends Error {
+  status: number;
+  constructor(status: number, message: string) { super(message); this.status = status; }
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), { status, headers: {
+    'Content-Type': 'application/json', 'Cache-Control': 'no-store',
+  } });
+}
+
+export async function readJson(request: Request): Promise<Record<string, any>> {
+  const body = await request.json();
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    throw new ApiError(400, 'Invalid JSON request.');
+  }
+  return body;
+}
+
+export function endpoint(handler: APIRoute): APIRoute {
+  return async context => {
+    try {
+      if (context.request.method !== 'GET') {
+        if (context.request.headers.get('origin') !== new URL(context.request.url).origin) {
+          throw new ApiError(403, 'Please submit this request from The DevTools Times.');
+        }
+        if (!context.request.headers.get('content-type')?.startsWith('application/json')) {
+          throw new ApiError(415, 'A JSON request is required.');
+        }
+      }
+      return await handler(context);
+    } catch (error) {
+      if (error instanceof ApiError) return json({ error: error.message }, error.status);
+      if (error instanceof SyntaxError) return json({ error: 'Invalid JSON request.' }, 400);
+      console.warn('Account request failed:', error);
+      return json({ error: 'We could not complete that request. Please try again.' }, 500);
+    }
+  };
+}
+
+export async function signedIn(context: APIContext) {
+  const userId = await context.session?.get('userId');
+  const account = typeof userId === 'string' ? getPasskeyStore().getAccount(userId) : undefined;
+  if (!account) throw new ApiError(401, 'Please sign in to manage your passkeys.');
+  return account;
+}
+
+export function passkeyConfig() {
+  // Fixed server configuration, shared by registration, authentication, and synchronization.
+  const origin = process.env.WEBAUTHN_ORIGIN || 'https://astro-news-pytrpecapa-uc.a.run.app';
+  const rpId = process.env.WEBAUTHN_RP_ID || new URL(origin).hostname;
+  return { origin, rpId };
+}
+
+export function listPasskeys(userId: string) {
+  const { rpId } = passkeyConfig();
+  const credentials = getPasskeyStore().list(userId, rpId).map(({
+    id, name, aaguid, registeredAt, lastUsedAt, credentialDeviceType, credentialBackedUp,
+  }) => ({ id, name, aaguid, registeredAt, lastUsedAt, credentialDeviceType, credentialBackedUp }));
+  return { rpId, userId, credentials };
+}
diff --git a/src/lib/server/passkey-store.ts b/src/lib/server/passkey-store.ts
new file mode 100644
index 0000000..7722f9b
--- /dev/null
+++ b/src/lib/server/passkey-store.ts
@@ -0,0 +1,105 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { PasskeySummary } from '../passkeys.ts';
+
+export interface Account { id: string; username: string }
+export interface StoredPasskey extends PasskeySummary {
+  userId: string;
+  rpId: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+}
+
+// A shared SQLite file survives sessions and process restarts. Never store credentials in cookies.
+export class PasskeyStore {
+  private db: DatabaseSync;
+
+  constructor(filename: string) {
+    if (filename !== ':memory:') mkdirSync(dirname(resolve(filename)), { recursive: true });
+    this.db = new DatabaseSync(filename);
+    this.db.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA busy_timeout = 5000;
+      PRAGMA foreign_keys = ON;
+      CREATE TABLE IF NOT EXISTS accounts (
+        id TEXT PRIMARY KEY, identity TEXT NOT NULL UNIQUE, username TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT NOT NULL, rp_id TEXT NOT NULL, user_id TEXT NOT NULL REFERENCES accounts(id),
+        record TEXT NOT NULL, PRIMARY KEY (id, rp_id)
+      );
+      CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(user_id, rp_id);
+      CREATE TABLE IF NOT EXISTS challenges (
+        id TEXT PRIMARY KEY, kind TEXT NOT NULL, user_id TEXT, expires INTEGER NOT NULL
+      );
+    `);
+  }
+
+  account(identity: string, username: string): Account {
+    this.db.prepare('INSERT OR IGNORE INTO accounts VALUES (?, ?, ?)')
+      .run(randomBytes(32).toString('base64url'), identity, username);
+    const account = this.db.prepare('SELECT id, username FROM accounts WHERE identity = ?').get(identity);
+    return account as unknown as Account;
+  }
+
+  getAccount(id: string): Account | undefined {
+    return this.db.prepare('SELECT id, username FROM accounts WHERE id = ?').get(id) as unknown as Account | undefined;
+  }
+
+  list(userId: string, rpId: string): StoredPasskey[] {
+    return this.db.prepare('SELECT record FROM passkeys WHERE user_id = ? AND rp_id = ? ORDER BY rowid DESC')
+      .all(userId, rpId).map(row => JSON.parse(row.record as string));
+  }
+
+  get(id: string, rpId: string): StoredPasskey | undefined {
+    const row = this.db.prepare('SELECT record FROM passkeys WHERE id = ? AND rp_id = ?').get(id, rpId);
+    return row ? JSON.parse(row.record as string) : undefined;
+  }
+
+  add(key: StoredPasskey) {
+    this.db.prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?)')
+      .run(key.id, key.rpId, key.userId, JSON.stringify(key));
+  }
+
+  rename(userId: string, rpId: string, id: string, name: string): boolean {
+    return this.db.prepare(`UPDATE passkeys SET record = json_set(record, '$.name', ?)
+      WHERE user_id = ? AND rp_id = ? AND id = ?`).run(name, userId, rpId, id).changes === 1;
+  }
+
+  remove(userId: string, rpId: string, id: string): boolean {
+    return this.db.prepare('DELETE FROM passkeys WHERE user_id = ? AND rp_id = ? AND id = ?')
+      .run(userId, rpId, id).changes === 1;
+  }
+
+  recordUse(key: StoredPasskey, counter: number, backedUp: boolean): boolean {
+    // Compare-and-swap prevents a concurrent assertion from overwriting a newer counter.
+    return this.db.prepare(`UPDATE passkeys SET record = json_set(record,
+      '$.counter', ?, '$.lastUsedAt', ?, '$.credentialBackedUp', json(?))
+      WHERE id = ? AND rp_id = ? AND json_extract(record, '$.counter') = ?`)
+      .run(counter, Date.now(), JSON.stringify(backedUp), key.id, key.rpId, key.counter).changes === 1;
+  }
+
+  challenge(kind: 'register' | 'authenticate', userId: string | null = null): string {
+    this.db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+    const id = randomBytes(32).toString('base64url');
+    this.db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?)').run(id, kind, userId, Date.now() + 300_000);
+    return id;
+  }
+
+  consumeChallenge(id: string, kind: string, userId: string | null = null): boolean {
+    // DELETE RETURNING consumes a challenge exactly once, even across concurrent requests.
+    return !!this.db.prepare(`DELETE FROM challenges
+      WHERE id = ? AND kind = ? AND user_id IS ? AND expires >= ? RETURNING id`)
+      .get(id, kind, userId, Date.now());
+  }
+
+  close() { this.db.close(); }
+}
+
+let store: PasskeyStore | undefined;
+export function getPasskeyStore() {
+  return store ??= new PasskeyStore(process.env.PASSKEY_DB_PATH || './data/passkeys.sqlite');
+}
