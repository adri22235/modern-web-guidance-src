diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..e6e823d
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,214 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import providers from '../lib/passkey-providers.json';
+import { type PasskeyList, type PasskeySummary, validatePasskeyName } from '../lib/passkeys.ts';
+import { accountRequest, passkeyError, RequestError, signalUnknown, syncAcceptedCredentials } from '../lib/passkey-client.ts';
+
+const baseButton = 'rounded border px-3 py-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-wait disabled:opacity-50';
+const button = `${baseButton} border-gray-300 bg-white hover:bg-gray-100`;
+const primary = `${baseButton} border-gray-900 bg-gray-900 text-white hover:bg-gray-700`;
+const registry = providers as Record<string, { name: string; icon_light?: string }>;
+
+function providerFor(key: PasskeySummary) {
+  return key.aaguid === '00000000-0000-0000-0000-000000000000' ? undefined : registry[key.aaguid.toLowerCase()];
+}
+function date(value: number | null) {
+  return value === null ? 'Not used yet' : new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+export default function PasskeySettings({ username }: { username: string }) {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [needsSignIn, setNeedsSignIn] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [removing, setRemoving] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [canCreate, setCanCreate] = useState(false);
+  const [sync, setSync] = useState<'sent' | 'unsupported' | 'failed' | null>(null);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const trigger = useRef<HTMLButtonElement | null>(null);
+  const mounted = useRef(false);
+
+  function showError(error: unknown) {
+    setError(passkeyError(error));
+    if (error instanceof RequestError && error.status === 401) setNeedsSignIn(true);
+  }
+
+  async function load(signal?: AbortSignal) {
+    setLoading(true);
+    setError('');
+    try {
+      const result = await accountRequest<PasskeyList>('passkeys', 'GET', undefined, signal);
+      if (signal?.aborted) return;
+      setData(result);
+      setSync(await syncAcceptedCredentials(result));
+    } catch (error) { if (!signal?.aborted) showError(error); }
+    finally { if (!signal?.aborted) setLoading(false); }
+  }
+
+  useEffect(() => {
+    mounted.current = true;
+    const controller = new AbortController();
+    void load(controller.signal);
+    if (window.isSecureContext && typeof PublicKeyCredential !== 'undefined') {
+      void PublicKeyCredential.getClientCapabilities().then(capabilities => {
+        if (mounted.current) setCanCreate(!!capabilities.passkeyPlatformAuthenticator && !!capabilities.conditionalGet);
+      }).catch(() => { /* Password sign-in and credential management remain available. */ });
+    }
+    return () => { mounted.current = false; controller.abort(); };
+  }, []);
+
+  function cancel() {
+    setEditing(null);
+    setRemoving(null);
+    const id = trigger.current?.id;
+    requestAnimationFrame(() => { if (id) document.getElementById(id)?.focus(); });
+  }
+
+  async function rename(event: React.FormEvent, key: PasskeySummary) {
+    event.preventDefault();
+    setError('');
+    setMessage('');
+    let clean: string;
+    try { clean = validatePasskeyName(name); }
+    catch (error) { showError(error); return; }
+    setBusy(true);
+    try {
+      const updated = await accountRequest<PasskeyList>(`passkeys/${encodeURIComponent(key.id)}`, 'PUT', { name: clean });
+      setData(updated);
+      // A key's nickname is an account label, not the account username/displayName.
+      cancel();
+      setMessage('Passkey name updated.');
+    } catch (error) { showError(error); }
+    finally { setBusy(false); }
+  }
+
+  async function remove(key: PasskeySummary) {
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      const updated = await accountRequest<PasskeyList>(`passkeys/${encodeURIComponent(key.id)}`, 'DELETE');
+      setData(updated);
+      setRemoving(null);
+      heading.current?.focus();
+      setMessage('Passkey removed. You can still sign in with your password.');
+      // Only signal the server's complete list after a confirmed deletion, even when empty.
+      setSync(await syncAcceptedCredentials(updated));
+    } catch (error) { showError(error); }
+    finally { setBusy(false); }
+  }
+
+  async function create() {
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      const options = await accountRequest<PublicKeyCredentialCreationOptionsJSON>('passkeys/register', 'POST', { action: 'options' });
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created. Please try again.');
+      const encoded = credential.toJSON();
+      let updated: PasskeyList;
+      try {
+        updated = await accountRequest<PasskeyList>('passkeys/register', 'POST', { action: 'verify', credential: encoded });
+      } catch (error) {
+        // A definite verification rejection leaves an orphan. A lost network response may
+        // have committed successfully; let the authoritative list reconcile it on refresh.
+        if (error instanceof RequestError && error.status === 400) await signalUnknown(options.rp.id!, credential.id);
+        throw error;
+      }
+      setData(updated);
+      setMessage('Passkey created. You can give it a name below.');
+      setSync(await syncAcceptedCredentials(updated));
+    } catch (error) { showError(error); }
+    finally { setBusy(false); }
+  }
+
+  async function signOut() {
+    setBusy(true);
+    try {
+      await accountRequest('auth/logout', 'POST');
+      window.location.assign(import.meta.env.BASE_URL);
+    } catch (error) { showError(error); setBusy(false); }
+  }
+
+  return (
+    <div className="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
+      <p className="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">Your account</p>
+      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-gray-900 pb-6">
+        <div>
+          <h1 className="font-brand text-4xl text-gray-900">Account settings</h1>
+          <p className="mt-2 text-sm text-gray-600">Signed in as <strong className="text-gray-900">{username}</strong></p>
+        </div>
+        <button type="button" onClick={signOut} disabled={busy || loading} className={button}>Sign out</button>
+      </div>
+
+      <section aria-labelledby="passkeys-heading" aria-busy={loading} className="py-8">
+        <div className="flex flex-wrap items-center justify-between gap-4">
+          <h2 id="passkeys-heading" ref={heading} tabIndex={-1} className="text-2xl font-bold text-gray-900">Passkeys</h2>
+          <div className="flex gap-2">
+            <button type="button" onClick={() => void load()} disabled={busy || loading || !!editing || !!removing} className={button}>Refresh</button>
+            {canCreate && <button type="button" onClick={create} disabled={busy || loading || !data || !!editing || !!removing} className={primary}>Create passkey</button>}
+          </div>
+        </div>
+        <p className="mt-3 max-w-xl text-sm leading-6 text-gray-600">Sign in securely with your fingerprint, face, device PIN, or security key. Give each passkey a recognizable name and remove any you no longer use.</p>
+        <p role="status" className="mt-4 text-sm text-green-800">{message}</p>
+        {error && <div role="alert" className="mt-4 rounded border border-red-200 bg-red-50 p-4 text-sm text-red-800">
+          {error} {needsSignIn && <a className="font-semibold underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in again</a>}
+        </div>}
+        {loading && <p role="status" className="py-8 text-sm text-gray-600">Loading your passkeys…</p>}
+        {!loading && data && <>
+          {data.credentials.length === 0 ? (
+            <div className="mt-6 rounded border border-dashed border-gray-300 bg-gray-50 px-6 py-10 text-center">
+              <KeyIcon aria-hidden="true" className="mx-auto mb-3 h-8 w-8 text-gray-500" />
+              <h3 className="font-semibold text-gray-900">No passkeys registered</h3>
+              <p className="mt-2 text-sm text-gray-600">{canCreate ? 'Create a passkey to make your next sign-in easier.' : 'You can continue to sign in with your password.'}</p>
+            </div>
+          ) : <ul className="mt-6 divide-y divide-gray-200 rounded border border-gray-200">
+            {data.credentials.map(key => {
+              const provider = providerFor(key);
+              const label = key.name || provider?.name || 'Passkey';
+              return <li key={key.id} className="p-5">
+                <div className="flex items-start gap-3">
+                  {provider?.icon_light ? <img src={provider.icon_light} alt="" width={32} height={32} className="mt-1 h-8 w-8 shrink-0 object-contain" /> : <KeyIcon aria-hidden="true" className="mt-1 h-8 w-8 shrink-0 text-gray-500" />}
+                  <div className="min-w-0 flex-1">
+                    <h3 className="break-words font-semibold text-gray-900">{label}</h3>
+                    <p className="mt-1 text-xs text-gray-500">{provider?.name || 'Unknown passkey provider'} · {key.credentialDeviceType === 'multiDevice' ? 'Sync-capable passkey' : 'Device-bound passkey'}</p>
+                    <dl className="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600">
+                      <div><dt className="inline font-medium">Created: </dt><dd className="inline"><time dateTime={new Date(key.registeredAt).toISOString()}>{date(key.registeredAt)}</time></dd></div>
+                      <div><dt className="inline font-medium">Last used: </dt><dd className="inline">{key.lastUsedAt === null ? 'Not used yet' : <time dateTime={new Date(key.lastUsedAt).toISOString()}>{date(key.lastUsedAt)}</time>}</dd></div>
+                    </dl>
+                    {editing !== key.id && removing !== key.id && <div className="mt-4 flex gap-2">
+                      <button id={`rename-${key.id}`} type="button" aria-label={`Rename ${label}`} disabled={busy || !!editing || !!removing} className={button} onClick={event => { trigger.current = event.currentTarget; setEditing(key.id); setName(label); setError(''); setMessage(''); }}>Rename</button>
+                      <button id={`remove-${key.id}`} type="button" aria-label={`Remove ${label}`} disabled={busy || !!editing || !!removing} className={`${button} text-red-700`} onClick={event => { trigger.current = event.currentTarget; setRemoving(key.id); setError(''); setMessage(''); }}>Remove</button>
+                    </div>}
+                    {editing === key.id && <form className="mt-4" onSubmit={event => void rename(event, key)}>
+                      <label htmlFor={`name-${key.id}`} className="block text-sm font-medium text-gray-800">Passkey display name</label>
+                      <input id={`name-${key.id}`} value={name} onChange={event => setName(event.target.value)} autoFocus required maxLength={80} disabled={busy} className="mt-2 block w-full rounded border border-gray-400 px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900" />
+                      <p className="mt-2 text-xs text-gray-500">This label is shown in your account settings.</p>
+                      <div className="mt-3 flex gap-2"><button type="submit" disabled={busy || !name.trim()} className={primary}>{busy ? 'Saving…' : 'Save name'}</button><button type="button" disabled={busy} onClick={cancel} className={button}>Cancel</button></div>
+                    </form>}
+                    {removing === key.id && <div role="group" aria-label={`Confirm removal of ${label}`} className="mt-4 rounded border border-red-200 bg-red-50 p-4">
+                      <p className="text-sm font-semibold text-gray-900">Remove “{label}”?</p>
+                      <p className="mt-2 text-sm text-gray-700">This passkey will no longer sign you in. You can still use your password{data.credentials.length > 1 ? ' or another registered passkey' : ''}.</p>
+                      <div className="mt-3 flex flex-wrap gap-2"><button type="button" autoFocus disabled={busy} onClick={cancel} className={button}>Keep passkey</button><button type="button" disabled={busy} onClick={() => void remove(key)} className={`${button} border-red-700 text-red-800`}>{busy ? 'Removing…' : 'Remove passkey'}</button></div>
+                    </div>}
+                  </div>
+                </div>
+              </li>;
+            })}
+          </ul>}
+          <div className="mt-6 border-t border-gray-200 pt-4 text-xs leading-5 text-gray-500">
+            <p>Renaming changes the label in this account. Supported browsers are notified of removed passkeys automatically.</p>
+            <p role="status" className="mt-1">{sync === 'sent' ? 'Your browser has been notified of your current passkeys.' : sync === 'unsupported' ? 'This browser cannot synchronize passkey removals. You may also need to remove the key in your password manager.' : sync === 'failed' ? 'Your account is up to date, but browser synchronization did not finish. Refresh to retry, or remove the old key in your password manager.' : ''}</p>
+            {!canCreate && <p className="mt-2">Passkey creation is unavailable in this browser. You can still manage existing keys and sign in with your password.</p>}
+          </div>
+        </>}
+      </section>
+    </div>
+  );
+}
