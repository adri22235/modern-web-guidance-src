+
+test('challenges are expiring, single-use, and tied to account and operation', () => {
+  const database = new PasskeyStore(':memory:');
+  const challenge = database.challenge('register', 'reader');
+  assert.equal(database.consumeChallenge(challenge, 'authenticate', 'reader'), false);
+  assert.equal(database.consumeChallenge(challenge, 'register', 'other'), false);
+  assert.equal(database.consumeChallenge(challenge, 'register', 'reader'), true);
+  assert.equal(database.consumeChallenge(challenge, 'register', 'reader'), false);
+  const expired = database.challenge('authenticate');
+  const originalNow = Date.now;
+  try {
+    Date.now = () => originalNow() + 360_000;
+    assert.equal(database.consumeChallenge(expired, 'authenticate'), false);
+  } finally { Date.now = originalNow; database.close(); }
