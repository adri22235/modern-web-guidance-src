+
+test('Signal API uses the server RP and validates IDs, including the empty final list', async () => {
+  const original = globalThis.PublicKeyCredential;
+  const warn = console.warn;
+  const calls = [];
+  const list = { rpId: 'example.test', userId: b64('reader'), credentials: [{ id: b64('key') }] };
+  try {
+    delete globalThis.PublicKeyCredential;
+    assert.equal(await syncAcceptedCredentials(list), 'unsupported');
+    globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async options => calls.push(options) };
+    assert.equal(await syncAcceptedCredentials(list), 'sent');
+    assert.deepEqual(calls[0], { rpId: 'example.test', userId: list.userId, allAcceptedCredentialIds: [b64('key')] });
+    await syncAcceptedCredentials({ ...list, credentials: [] });
+    assert.deepEqual(calls[1].allAcceptedCredentialIds, []);
+    console.warn = () => {};
+    assert.equal(await syncAcceptedCredentials({ ...list, credentials: [{ id: 'a' }] }), 'failed');
+    assert.equal(await syncAcceptedCredentials({ ...list, userId: 'bad=' }), 'failed');
+    assert.equal(calls.length, 2);
+    globalThis.PublicKeyCredential.signalAllAcceptedCredentials = async () => { throw new Error('Unavailable'); };
+    assert.equal(await syncAcceptedCredentials(list), 'failed');
+  } finally {
+    console.warn = warn;
+    if (original === undefined) delete globalThis.PublicKeyCredential;
+    else globalThis.PublicKeyCredential = original;
+  }
+});
+
+test('password sign-in creates a server session only after upstream authentication; logout clears it', async () => {
+  const originalFetch = globalThis.fetch;
+  const currentSession = session();
+  try {
+    globalThis.fetch = async () => new Response(JSON.stringify({ error: 'Invalid password' }), { status: 401 });
+    assert.equal((await login(context(currentSession, 'POST', { username: 'reader', password: 'wrong' }))).status, 401);
+    assert.equal(await currentSession.get('userId'), undefined);
+    globalThis.fetch = async () => new Response(JSON.stringify({ success: true, user: { id: 'external-reader', username: 'reader' } }));
+    assert.equal((await login(context(currentSession, 'POST', { username: 'reader', password: 'correct' }))).status, 200);
+    const userId = await currentSession.get('userId');
+    assert.ok(isBase64Url(userId));
+    assert.equal((await GET(context(currentSession))).status, 200);
+    await logout(context(currentSession, 'POST'));
+    assert.equal((await GET(context(currentSession))).status, 401);
+  } finally { globalThis.fetch = originalFetch; }
+});
