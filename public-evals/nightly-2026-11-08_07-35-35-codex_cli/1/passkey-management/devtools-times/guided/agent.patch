@@ -0,0 +1,258 @@
+import assert from 'node:assert/strict';
+import { after, test } from 'node:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import { PasskeyStore, getPasskeyStore } from '../src/lib/server/passkey-store.ts';
+import { isBase64Url, validatePasskeyName } from '../src/lib/passkeys.ts';
+import { syncAcceptedCredentials } from '../src/lib/passkey-client.ts';
+import { GET } from '../src/pages/api/passkeys/index.ts';
+import { PUT, DELETE } from '../src/pages/api/passkeys/[id].ts';
+import { POST as register } from '../src/pages/api/passkeys/register.ts';
+import { POST as authenticate } from '../src/pages/api/auth/passkey.ts';
+import { POST as login } from '../src/pages/api/auth/login.ts';
+import { POST as logout } from '../src/pages/api/auth/logout.ts';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-passkeys-'));
+process.env.PASSKEY_DB_PATH = join(directory, 'passkeys.sqlite');
+process.env.WEBAUTHN_ORIGIN = 'https://accounts.example.test';
+process.env.WEBAUTHN_RP_ID = 'example.test';
+const store = getPasskeyStore();
+after(() => { store.close(); rmSync(directory, { recursive: true, force: true }); });
+
+function session(userId) {
+  const values = new Map(userId ? [['userId', userId]] : []);
+  return {
+    get: async key => values.get(key), set: (key, value) => values.set(key, value),
+    delete: key => values.delete(key), destroy: () => values.clear(),
+    regenerate: async () => {},
+  };
+}
+
+function context(currentSession, method = 'GET', body, id, origin = process.env.WEBAUTHN_ORIGIN) {
+  return {
+    session: currentSession, params: { id },
+    request: new Request(`${process.env.WEBAUTHN_ORIGIN}/devtools-times/api/passkeys`, {
+      method, headers: { origin, 'Content-Type': 'application/json' },
+      ...(method !== 'GET' ? { body: JSON.stringify(body ?? {}) } : {}),
+    }),
+  };
+}
+
+const b64 = value => Buffer.from(value).toString('base64url');
+const hash = value => createHash('sha256').update(value).digest();
+
+// A software authenticator exercises real WebAuthn verification without a browser/server.
+function authenticator() {
+  const { publicKey, privateKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32);
+  const cose = isoCBOR.encode(new Map([
+    [1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x, 'base64url')], [-3, Buffer.from(jwk.y, 'base64url')],
+  ]));
+  return {
+    id: b64(id),
+    register(options, origin = process.env.WEBAUTHN_ORIGIN) {
+      const length = Buffer.alloc(2); length.writeUInt16BE(id.length);
+      const authData = Buffer.concat([hash(options.rp.id), Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), length, id, cose]);
+      return {
+        id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {},
+        response: {
+          clientDataJSON: b64(JSON.stringify({ type: 'webauthn.create', challenge: options.challenge, origin })),
+          attestationObject: b64(isoCBOR.encode(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]))),
+          transports: ['internal'],
+        },
+      };
+    },
+    authenticate(options, userId, counter = 1) {
+      const count = Buffer.alloc(4); count.writeUInt32BE(counter);
+      const authenticatorData = Buffer.concat([hash(options.rpId), Buffer.from([0x05]), count]);
+      const clientDataJSON = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge: options.challenge, origin: process.env.WEBAUTHN_ORIGIN }));
+      return {
+        id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {},
+        response: { userHandle: userId, authenticatorData: b64(authenticatorData), clientDataJSON: b64(clientDataJSON),
+          signature: b64(sign('sha256', Buffer.concat([authenticatorData, hash(clientDataJSON)]), privateKey)) },
+      };
+    },
+  };
+}
+
+async function enroll(currentSession, device = authenticator()) {
+  const optionsResponse = await register(context(currentSession, 'POST', { action: 'options' }));
+  assert.equal(optionsResponse.status, 200);
+  const options = await optionsResponse.json();
+  assert.equal(options.authenticatorSelection.residentKey, 'required');
+  assert.equal(options.authenticatorSelection.authenticatorAttachment, undefined);
+  const response = await register(context(currentSession, 'POST', { action: 'verify', credential: device.register(options) }));
+  assert.equal(response.status, 201, JSON.stringify(await response.clone().json()));
+  return { device, list: await response.json() };
+}
+
+test('signed-out readers and cross-origin mutations are rejected', async () => {
+  assert.equal((await GET(context(session()))).status, 401);
+  assert.equal((await PUT(context(session(), 'PUT', { name: 'test' }, b64('key')))).status, 401);
+  assert.equal((await DELETE(context(session(), 'DELETE', {}, b64('key'), 'https://other.example'))).status, 403);
+  assert.equal((await register(context(session(), 'POST', { action: 'options' }))).status, 401);
+});
+
+test('malformed JSON bodies and non-JSON mutations receive clear client errors', async () => {
+  const reader = store.account('json-reader', 'Reader');
+  const currentSession = session(reader.id);
+  for (const body of [null, [], 'text', 42]) {
+    const requestContext = context(currentSession, 'PUT', {}, b64('missing'));
+    requestContext.request = new Request(requestContext.request.url, {
+      method: 'PUT', headers: { origin: process.env.WEBAUTHN_ORIGIN, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    });
+    assert.equal((await PUT(requestContext)).status, 400);
+  }
+  const requestContext = context(currentSession, 'PUT', {}, b64('missing'));
+  requestContext.request = new Request(requestContext.request.url, { method: 'PUT', headers: { origin: process.env.WEBAUTHN_ORIGIN }, body: 'name=Phone' });
+  assert.equal((await PUT(requestContext)).status, 415);
+});
+
+test('real registration, ownership isolation, rename, sign-in, and final deletion', async () => {
+  const alice = store.account('alice', 'Alice');
+  const bob = store.account('bob', 'Bob');
+  const aliceSession = session(alice.id);
+  const bobSession = session(bob.id);
+  const { device, list } = await enroll(aliceSession);
+  assert.equal(list.rpId, 'example.test');
+  assert.equal(list.userId, alice.id);
+  assert.equal(list.credentials.length, 1);
+  assert.equal(list.credentials[0].lastUsedAt, null);
+  assert.equal(list.credentials[0].publicKey, undefined);
+  assert.equal(list.credentials[0].counter, undefined);
+  assert.equal((await (await GET(context(bobSession))).json()).credentials.length, 0);
+  assert.equal((await PUT(context(bobSession, 'PUT', { name: 'Stolen' }, device.id))).status, 404);
+  assert.equal((await DELETE(context(bobSession, 'DELETE', {}, device.id))).status, 404);
+
+  for (const name of ['', '  ', 'x'.repeat(81), 123]) {
+    assert.equal((await PUT(context(aliceSession, 'PUT', { name }, device.id))).status, 400);
+  }
+  const renamed = await PUT(context(aliceSession, 'PUT', { name: '  My laptop  ' }, device.id));
+  assert.equal(renamed.status, 200);
+  assert.equal((await renamed.json()).credentials[0].name, 'My laptop');
+
+  const signInSession = session();
+  const options = await (await authenticate(context(signInSession, 'POST', { action: 'options' }))).json();
+  assert.deepEqual(options.allowCredentials, []);
+  const assertion = device.authenticate(options, alice.id);
+  assert.equal((await authenticate(context(signInSession, 'POST', { action: 'verify', credential: assertion }))).status, 200);
+  assert.equal(await signInSession.get('userId'), alice.id);
+  assert.equal(store.get(device.id, 'example.test').counter, 1);
+  assert.ok(store.get(device.id, 'example.test').lastUsedAt);
+  assert.equal((await authenticate(context(signInSession, 'POST', { action: 'verify', credential: assertion }))).status, 400);
+
+  const removed = await DELETE(context(aliceSession, 'DELETE', {}, device.id));
+  assert.equal(removed.status, 200);
+  assert.deepEqual((await removed.json()).credentials, []);
+  const nextOptions = await (await authenticate(context(signInSession, 'POST', { action: 'options' }))).json();
+  assert.equal((await authenticate(context(signInSession, 'POST', { action: 'verify', credential: device.authenticate(nextOptions, alice.id, 2) }))).status, 404);
+});
+
+test('registration rejects wrong origin and consumes its challenge', async () => {
+  const reader = store.account('origin-reader', 'Reader');
+  const readerSession = session(reader.id);
+  const options = await (await register(context(readerSession, 'POST', { action: 'options' }))).json();
+  const credential = authenticator().register(options, 'https://attacker.example');
+  assert.equal((await register(context(readerSession, 'POST', { action: 'verify', credential }))).status, 400);
+  assert.equal((await register(context(readerSession, 'POST', { action: 'verify', credential }))).status, 400);
+  assert.equal(store.list(reader.id, 'example.test').length, 0);
+});
+
+test('invalid signatures and account handles cannot establish a session', async () => {
+  const reader = store.account('signature-reader', 'Reader');
+  const { device } = await enroll(session(reader.id));
+  const currentSession = session();
+  let options = await (await authenticate(context(currentSession, 'POST', { action: 'options' }))).json();
+  const invalidSignature = device.authenticate(options, reader.id);
