diff --git a/src/pages/api/auth/passkey.ts b/src/pages/api/auth/passkey.ts
new file mode 100644
index 0000000..7ea0cb0
--- /dev/null
+++ b/src/pages/api/auth/passkey.ts
@@ -0,0 +1,39 @@
+import { generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { ApiError, endpoint, json, passkeyConfig, readJson } from '../../../lib/server/account-api.ts';
+import { getPasskeyStore } from '../../../lib/server/passkey-store.ts';
+import { isBase64Url } from '../../../lib/passkeys.ts';
+
+export const POST = endpoint(async context => {
+  if (!context.session) throw new ApiError(503, 'Sign in is temporarily unavailable.');
+  const store = getPasskeyStore();
+  const { origin, rpId } = passkeyConfig();
+  const { action, credential } = await readJson(context.request);
+  if (action === 'options') {
+    const challenge = store.challenge('authenticate');
+    await context.session.set('authenticationChallenge', challenge);
+    return json(await generateAuthenticationOptions({ rpID: rpId, challenge: Buffer.from(challenge, 'base64url'), allowCredentials: [], userVerification: 'required' }));
+  }
+  if (action !== 'verify' || !isBase64Url(credential?.id)) throw new ApiError(400, 'Invalid passkey request.');
+  const challenge = await context.session.get('authenticationChallenge');
+  context.session.delete('authenticationChallenge');
+  if (typeof challenge !== 'string' || !store.consumeChallenge(challenge, 'authenticate')) {
+    throw new ApiError(400, 'This request has expired. Please sign in again.');
+  }
+  const key = store.get(credential.id, rpId);
+  if (!key) throw new ApiError(404, 'This passkey is no longer registered. Sign in with your password.');
+  if (credential.response?.userHandle !== key.userId) throw new ApiError(400, 'This passkey could not be verified.');
+  let result;
+  try {
+    result = await verifyAuthenticationResponse({
+      response: credential, expectedChallenge: challenge, expectedOrigin: origin, expectedRPID: rpId,
+      requireUserVerification: true,
+      credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports },
+    });
+  } catch { throw new ApiError(400, 'This passkey could not be verified. Please try again.'); }
+  if (!result.verified || !store.recordUse(key, result.authenticationInfo.newCounter, result.authenticationInfo.credentialBackedUp)) {
+    throw new ApiError(400, 'This passkey could not be verified. Please try again.');
+  }
+  await context.session.regenerate();
+  await context.session.set('userId', key.userId);
+  return json({ success: true });
+});
diff --git a/src/pages/api/passkeys/[id].ts b/src/pages/api/passkeys/[id].ts
