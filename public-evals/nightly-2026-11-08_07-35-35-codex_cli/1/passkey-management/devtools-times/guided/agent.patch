diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..df37771
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,46 @@
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { ApiError, endpoint, json, listPasskeys, passkeyConfig, readJson, signedIn } from '../../../lib/server/account-api.ts';
+import { getPasskeyStore } from '../../../lib/server/passkey-store.ts';
+
+export const POST = endpoint(async context => {
+  const account = await signedIn(context);
+  const store = getPasskeyStore();
+  const { rpId, origin } = passkeyConfig();
+  const { action, credential } = await readJson(context.request);
+  if (action === 'options') {
+    const challenge = store.challenge('register', account.id);
+    await context.session!.set('registrationChallenge', challenge);
+    const options = await generateRegistrationOptions({
+      rpID: rpId, rpName: 'The DevTools Times',
+      userID: Buffer.from(account.id, 'base64url'), userName: account.username,
+      challenge: Buffer.from(challenge, 'base64url'), attestationType: 'none',
+      excludeCredentials: store.list(account.id, rpId).map(key => ({ id: key.id, transports: key.transports })),
+      // Settings supports both platform authenticators and external security keys.
+      authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+    });
+    return json(options);
+  }
+  if (action !== 'verify' || !credential) throw new ApiError(400, 'Invalid registration request.');
+  const challenge = await context.session!.get('registrationChallenge');
+  context.session!.delete('registrationChallenge');
+  if (typeof challenge !== 'string' || !store.consumeChallenge(challenge, 'register', account.id)) {
+    throw new ApiError(400, 'This request has expired. Please create your passkey again.');
+  }
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: credential, expectedChallenge: challenge, expectedOrigin: origin,
+      expectedRPID: rpId, requireUserVerification: true,
+    });
+  } catch { throw new ApiError(400, 'We could not verify this passkey. Please try again.'); }
+  if (!verification.verified) throw new ApiError(400, 'We could not verify this passkey.');
+  const info = verification.registrationInfo;
+  store.add({
+    id: info.credential.id, userId: account.id, rpId,
+    publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+    counter: info.credential.counter, transports: info.credential.transports || [],
+    name: '', aaguid: info.aaguid, credentialDeviceType: info.credentialDeviceType,
+    credentialBackedUp: info.credentialBackedUp, registeredAt: Date.now(), lastUsedAt: null,
+  });
+  return json(listPasskeys(account.id), 201);
+});
diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
