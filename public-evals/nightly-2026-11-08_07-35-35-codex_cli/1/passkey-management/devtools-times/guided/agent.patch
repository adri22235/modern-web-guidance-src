--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,52 @@
+import 'webauthn-polyfills';
+import { isBase64Url, type PasskeyList } from './passkeys.ts';
+
+export class RequestError extends Error {
+  status: number;
+  constructor(message: string, status: number) { super(message); this.status = status; }
+}
+
+export async function accountRequest<T>(path: string, method = 'GET', body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store', signal,
+    headers: { 'Content-Type': 'application/json' },
+    ...(method !== 'GET' ? { body: JSON.stringify(body ?? {}) } : {}),
+  });
+  let data;
+  try { data = await response.json(); }
+  catch { throw new RequestError('We could not complete that request. Please try again.', response.status); }
+  if (!response.ok) throw new RequestError(data.error || 'Please try again.', response.status);
+  return data;
+}
+
+export async function syncAcceptedCredentials(data: PasskeyList): Promise<'sent' | 'unsupported' | 'failed'> {
+  if (typeof PublicKeyCredential === 'undefined' || !PublicKeyCredential.signalAllAcceptedCredentials) return 'unsupported';
+  const ids = data.credentials.map(key => key.id);
+  if (!data.rpId || !isBase64Url(data.userId) || !ids.every(isBase64Url)) {
+    console.warn('Passkey synchronization skipped: invalid server credential identifiers.');
+    return 'failed';
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: data.rpId, userId: data.userId, allAcceptedCredentialIds: ids });
+    return 'sent';
+  } catch (error) {
+    console.warn('Passkey synchronization was not available:', error);
+    return 'failed';
+  }
+}
+
+export async function signalUnknown(rpId: string, credentialId: string) {
+  if (typeof PublicKeyCredential === 'undefined' || !PublicKeyCredential.signalUnknownCredential || !isBase64Url(credentialId)) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }); }
+  catch (error) { console.warn('Passkey synchronization was not available:', error); }
+}
+
+export function passkeyError(error: unknown): string {
+  if (error instanceof TypeError) return 'We could not complete the connection. Please refresh and try again.';
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey for this account already exists in that authenticator.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable on this address. Use your password to sign in.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
