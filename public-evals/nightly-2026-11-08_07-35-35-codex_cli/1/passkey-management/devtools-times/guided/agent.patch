+test('Base64URL and nickname validation rejects malformed input', () => {
+  for (const value of ['a', '', 'bad=', 'bad:id', 'bad id', null, 123]) assert.equal(isBase64Url(value), false);
+  assert.equal(isBase64Url(b64('credential')), true);
