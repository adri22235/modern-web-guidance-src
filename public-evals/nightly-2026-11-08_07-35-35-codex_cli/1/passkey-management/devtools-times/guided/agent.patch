+  assert.equal((await authenticate(context(currentSession, 'POST', { action: 'verify', credential: device.authenticate(options, b64('other-user')) }))).status, 400);
+  assert.equal(await currentSession.get('userId'), undefined);
+});
+
+test('credentials persist across connections and remain scoped to their RP', () => {
+  const filename = join(directory, 'persistence.sqlite');
+  let database = new PasskeyStore(filename);
+  const reader = database.account('persistent-reader', 'Reader');
+  const key = { id: b64('persistent-key'), userId: reader.id, rpId: 'example.test', name: 'Phone', registeredAt: Date.now(), lastUsedAt: null,
+    aaguid: '', publicKey: b64('public-key'), counter: 0, transports: [], credentialDeviceType: 'singleDevice', credentialBackedUp: false };
+  database.add(key);
