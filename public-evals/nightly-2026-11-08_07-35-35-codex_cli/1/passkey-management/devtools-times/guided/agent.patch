@@ -0,0 +1,26 @@
+import { ApiError, endpoint, json, listPasskeys, passkeyConfig, readJson, signedIn } from '../../../lib/server/account-api.ts';
+import { getPasskeyStore } from '../../../lib/server/passkey-store.ts';
+import { isBase64Url, validatePasskeyName } from '../../../lib/passkeys.ts';
+
+export const PUT = endpoint(async context => {
+  const account = await signedIn(context);
+  const { name } = await readJson(context.request);
+  let cleanName: string;
+  try { cleanName = validatePasskeyName(name); }
+  catch (error) { throw new ApiError(400, (error as Error).message); }
+  const { rpId } = passkeyConfig();
+  if (!isBase64Url(context.params.id) || !getPasskeyStore().rename(account.id, rpId, context.params.id, cleanName)) {
+    throw new ApiError(404, 'This passkey was not found. Refresh the list and try again.');
+  }
+  return json(listPasskeys(account.id));
+});
+
+export const DELETE = endpoint(async context => {
+  const account = await signedIn(context);
+  const { rpId } = passkeyConfig();
+  if (!isBase64Url(context.params.id) || !getPasskeyStore().remove(account.id, rpId, context.params.id)) {
+    throw new ApiError(404, 'This passkey was not found. Refresh the list and try again.');
+  }
+  // Return the complete authoritative list, including an empty list after the last deletion.
+  return json(listPasskeys(account.id));
+});
