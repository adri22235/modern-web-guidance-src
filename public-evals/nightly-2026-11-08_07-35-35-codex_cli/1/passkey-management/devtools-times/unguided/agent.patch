diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..f3a44ca
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,84 @@
+export type Passkey = {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+};
+export type PasskeySnapshot = {
+  user: { username: string; userId: string };
+  rpId: string;
+  passkeys: Passkey[];
+};
+export const accountUrl = (path: string) =>
+  `${import.meta.env.BASE_URL}api/account/${path}`;
+export class AccountError extends Error {
+  status: number;
+  constructor(message: string, status: number) {
+    super(message);
+    this.status = status;
+  }
+}
+export async function accountRequest(
+  path: string,
+  method = "GET",
+  body?: unknown,
+) {
+  const response = await fetch(accountUrl(path), {
+    method,
+    credentials: "same-origin",
+    cache: "no-store",
+    headers:
+      body === undefined ? undefined : { "Content-Type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new AccountError(
+      data.error || "Unable to complete this request.",
+      response.status,
+    );
+  return data;
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalUnknownCredential?: (options: {
+    rpId: string;
+    credentialId: string;
+  }) => Promise<void>;
+};
+export async function syncPasskeys(
+  snapshot: PasskeySnapshot,
+): Promise<string | null> {
+  const api =
+    typeof PublicKeyCredential === "undefined"
+      ? undefined
+      : (PublicKeyCredential as unknown as SignalAPI);
+  if (!api?.signalAllAcceptedCredentials)
+    return "Your browser cannot sync passkey changes automatically. Remove any deleted keys from your password manager too.";
+  try {
+    await api.signalAllAcceptedCredentials({
+      rpId: snapshot.rpId,
+      userId: snapshot.user.userId,
+      allAcceptedCredentialIds: snapshot.passkeys.map((key) => key.id),
+    });
+    return null;
+  } catch {
+    return "Your account is up to date, but browser sync failed. Retry sync or remove deleted keys from your password manager.";
+  }
+}
+export async function signalUnknownPasskey(rpId: string, credentialId: string) {
+  const api =
+    typeof PublicKeyCredential === "undefined"
+      ? undefined
+      : (PublicKeyCredential as unknown as SignalAPI);
+  try {
+    await api?.signalUnknownCredential?.({ rpId, credentialId });
+  } catch {
+    /* Sign-in error remains actionable. */
+  }
+}
diff --git a/src/lib/passkey-store.ts b/src/lib/passkey-store.ts
new file mode 100644
index 0000000..3199982
--- /dev/null
+++ b/src/lib/passkey-store.ts
@@ -0,0 +1,121 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { randomBytes } from "node:crypto";
+import type { WebAuthnCredential } from "@simplewebauthn/server";
+
+// Use a persistent volume for this path when deploying the Node adapter.
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = resolve(
+      process.env.PASSKEY_DATABASE_PATH || "data/passkeys.sqlite",
+    );
+    mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode = WAL;
+      CREATE TABLE IF NOT EXISTS accounts (username TEXT PRIMARY KEY, user_id TEXT UNIQUE NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, username TEXT NOT NULL, rp_id TEXT NOT NULL,
+        name TEXT NOT NULL, created_at TEXT NOT NULL, last_used_at TEXT,
+        credential TEXT NOT NULL
+      );`);
+  }
+  return database;
+}
+
+export function getAccount(username: string) {
+  db()
+    .prepare("INSERT OR IGNORE INTO accounts VALUES (?, ?)")
+    .run(username, randomBytes(32).toString("base64url"));
+  return db()
+    .prepare(
+      "SELECT username, user_id AS userId FROM accounts WHERE username = ?",
+    )
+    .get(username) as { username: string; userId: string };
+}
+
+export type Passkey = {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+};
+export function listPasskeys(username: string, rpId: string): Passkey[] {
+  return db()
+    .prepare(
+      "SELECT id, name, created_at AS createdAt, last_used_at AS lastUsedAt FROM passkeys WHERE username = ? AND rp_id = ? ORDER BY created_at DESC",
+    )
+    .all(username, rpId) as Passkey[];
+}
+export function addPasskey(
+  username: string,
+  rpId: string,
+  name: string,
+  credential: WebAuthnCredential,
+) {
+  const stored = {
+    ...credential,
+    publicKey: Buffer.from(credential.publicKey).toString("base64url"),
+  };
+  db()
+    .prepare("INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, NULL, ?)")
+    .run(
+      credential.id,
+      username,
+      rpId,
+      name,
+      new Date().toISOString(),
+      JSON.stringify(stored),
+    );
+}
+export function renamePasskey(
+  username: string,
+  rpId: string,
+  id: string,
+  name: string,
+) {
+  return (
+    db()
+      .prepare(
+        "UPDATE passkeys SET name = ? WHERE username = ? AND rp_id = ? AND id = ?",
+      )
+      .run(name, username, rpId, id).changes > 0
+  );
+}
+export function removePasskey(username: string, rpId: string, id: string) {
+  return (
+    db()
+      .prepare(
+        "DELETE FROM passkeys WHERE username = ? AND rp_id = ? AND id = ?",
+      )
+      .run(username, rpId, id).changes > 0
+  );
+}
+export function findCredential(id: string, rpId: string) {
+  const row = db()
+    .prepare(
+      "SELECT username, credential FROM passkeys WHERE id = ? AND rp_id = ?",
+    )
+    .get(id, rpId) as { username: string; credential: string } | undefined;
+  if (!row) return;
+  const credential = JSON.parse(row.credential);
+  return {
+    username: row.username,
+    credential: {
+      ...credential,
+      publicKey: new Uint8Array(Buffer.from(credential.publicKey, "base64url")),
+    } as WebAuthnCredential,
+  };
+}
+export function recordAuthentication(id: string, counter: number) {
+  const row = db()
+    .prepare("SELECT credential FROM passkeys WHERE id = ?")
+    .get(id) as { credential: string };
+  const credential = { ...JSON.parse(row.credential), counter };
+  db()
+    .prepare(
+      "UPDATE passkeys SET credential = ?, last_used_at = ? WHERE id = ?",
+    )
+    .run(JSON.stringify(credential), new Date().toISOString(), id);
+}
