diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..6ab517a
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,430 @@
+import { useEffect, useRef, useState } from "react";
+import { startRegistration } from "@simplewebauthn/browser";
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  ArrowPathIcon,
+} from "@heroicons/react/24/outline";
+import {
+  AccountError,
+  accountRequest,
+  syncPasskeys,
+  type PasskeySnapshot,
+  type Passkey,
+} from "../lib/passkey-client";
+
+const button =
+  "rounded border border-gray-300 px-4 py-2 text-sm font-semibold hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-800";
+const primary = `${button} border-gray-900 bg-gray-900 text-white hover:bg-gray-700`;
+const input =
+  "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-2 focus:outline-gray-800";
+function date(value: string | null) {
+  if (!value) return "Not used yet";
+  return new Date(value).toLocaleDateString("en-US", {
+    year: "numeric",
+    month: "short",
+    day: "numeric",
+  });
+}
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<PasskeySnapshot | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+  const [syncWarning, setSyncWarning] = useState<string | null>(null);
+  const [signedOut, setSignedOut] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [editing, setEditing] = useState<Passkey | null>(null);
+  const [removing, setRemoving] = useState<Passkey | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [name, setName] = useState("");
+  const dialog = useRef<HTMLDialogElement>(null);
+  const nameInput = useRef<HTMLInputElement>(null);
+
+  async function refresh() {
+    setLoading(true);
+    setError("");
+    try {
+      const snapshot = (await accountRequest("passkeys")) as PasskeySnapshot;
+      setData(snapshot);
+      setSyncWarning(await syncPasskeys(snapshot));
+    } catch (e) {
+      if (e instanceof AccountError && e.status === 401) setSignedOut(true);
+      setError(
+        e instanceof Error ? e.message : "Unable to load your passkeys.",
+      );
+    } finally {
+      setLoading(false);
+    }
+  }
+  useEffect(() => {
+    setSupported(
+      window.isSecureContext && typeof PublicKeyCredential !== "undefined",
+    );
+    void refresh();
+  }, []);
+  useEffect(() => {
+    if (editing || removing || adding) {
+      dialog.current?.showModal();
+      nameInput.current?.focus();
+    } else dialog.current?.close();
+  }, [editing, removing, adding]);
+  function close() {
+    if (busy) return;
+    setEditing(null);
+    setRemoving(null);
+    setAdding(false);
+    setName("");
+  }
+  async function mutate(event: React.FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    setError("");
+    setMessage("");
+    try {
+      let snapshot: PasskeySnapshot;
+      let success: string;
+      if (removing) {
+        snapshot = await accountRequest(
+          `passkeys/${encodeURIComponent(removing.id)}`,
+          "DELETE",
+        );
+        success = "Passkey removed. It can no longer be used to sign in.";
+      } else if (editing) {
+        snapshot = await accountRequest(
+          `passkeys/${encodeURIComponent(editing.id)}`,
+          "PATCH",
+          { name: name.trim() },
+        );
+        success = "Display name updated.";
+      } else {
+        const optionsJSON = await accountRequest("register/options", "POST");
+        const response = await startRegistration({ optionsJSON });
+        snapshot = await accountRequest("register/verify", "POST", {
+          response,
+          name: name.trim(),
+        });
+        success = "Passkey added. You can now use it to sign in.";
+      }
+      setData(snapshot);
+      setEditing(null);
+      setRemoving(null);
+      setAdding(false);
+      setName("");
+      setMessage(success);
+      setSyncWarning(await syncPasskeys(snapshot));
+    } catch (e) {
+      if (e instanceof AccountError && e.status === 401) {
+        setSignedOut(true);
+        setData(null);
+      }
+      setError(
+        e instanceof Error && e.name === "NotAllowedError"
+          ? "Passkey setup was canceled or timed out. You can try again."
+          : e instanceof Error
+            ? e.message
+            : "Unable to save your changes.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function logout() {
+    setBusy(true);
+    setError("");
+    try {
+      await accountRequest("logout", "POST");
+      window.location.assign(import.meta.env.BASE_URL);
+    } catch {
+      setError("Unable to sign out. Please try again.");
+      setBusy(false);
+    }
+  }
+  const modalOpen = Boolean(editing || removing || adding);
+
+  return (
+    <div className="mx-auto max-w-4xl px-4 py-10 sm:px-8 sm:py-14">
+      <div className="mb-8 flex flex-wrap items-start justify-between gap-4 border-b border-gray-200 pb-7">
+        <div>
+          <p className="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">
+            Your account
+          </p>
+          <h1 className="font-brand text-4xl sm:text-5xl">Account settings</h1>
+          <p className="mt-3 text-sm text-gray-600">
+            {data
+              ? `Signed in as ${data.user.username}`
+              : "Manage how you sign in to The DevTools Times."}
+          </p>
+        </div>
+        {!signedOut && (
+          <button className={button} disabled={busy} onClick={logout}>
+            Sign out
+          </button>
+        )}
+      </div>
+      <section
+        aria-labelledby="passkeys-heading"
+        className="rounded-lg border border-gray-200 bg-white"
+      >
+        <div className="flex flex-wrap items-start justify-between gap-5 border-b border-gray-200 p-6">
+          <div className="flex items-start gap-3">
+            <span className="rounded-full bg-gray-100 p-2.5">
+              <KeyIcon className="h-6 w-6" />
+            </span>
+            <div>
+              <h2 id="passkeys-heading" className="text-xl font-bold">
+                Passkeys
+              </h2>
+              <p className="mt-1 max-w-md text-sm leading-6 text-gray-600">
+                A simpler, more secure way to sign in. Use your fingerprint,
+                face, or device PIN instead of a password.
+              </p>
+            </div>
+          </div>
+          <button
+            className={`${primary} inline-flex items-center gap-2`}
+            disabled={!data || busy || loading || !supported || signedOut}
+            onClick={() => {
+              setError("");
+              setAdding(true);
+              setName("");
+            }}
+          >
+            <PlusIcon className="h-4 w-4" />
+            Add passkey
+          </button>
+        </div>
+        <div className="p-6">
+          {error && !modalOpen && (
+            <p
+              role="alert"
+              className="mb-4 rounded bg-red-50 p-3 text-sm text-red-800"
+            >
+              {error}
+            </p>
+          )}
+          {message && (
+            <p
+              role="status"
+              className="mb-4 rounded bg-green-50 p-3 text-sm text-green-800"
+            >
+              {message}
+            </p>
+          )}
+          {signedOut ? (
+            <p className="text-sm">
+              Your session has ended.{" "}
+              <a
+                className="underline"
+                href={`${import.meta.env.BASE_URL}signin`}
+              >
+                Sign in to manage your passkeys
+              </a>
+              .
+            </p>
+          ) : loading ? (
+            <p role="status" className="py-8 text-center text-sm text-gray-500">
+              Loading your passkeys…
+            </p>
+          ) : !data ? (
+            <button className={button} onClick={refresh}>
+              Try again
+            </button>
+          ) : (
+            <>
+              <p className="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
+                Registered passkeys ({data.passkeys.length})
+              </p>
+              {data.passkeys.length === 0 ? (
+                <div className="rounded border border-dashed border-gray-300 px-4 py-10 text-center">
+                  <KeyIcon className="mx-auto mb-3 h-8 w-8 text-gray-400" />
+                  <h3 className="font-semibold">No passkeys yet</h3>
+                  <p className="mt-2 text-sm text-gray-600">
+                    Add a passkey to sign in securely on your devices.
+                  </p>
+                </div>
+              ) : (
+                <ul className="divide-y divide-gray-200">
+                  {data.passkeys.map((key) => (
+                    <li
+                      key={key.id}
+                      className="flex flex-wrap items-center justify-between gap-4 py-5 first:pt-0"
+                    >
+                      <div className="min-w-0 flex-1">
+                        <h3 className="break-words font-semibold">
+                          {key.name}
+                        </h3>
+                        <p className="mt-1 text-xs leading-5 text-gray-500">
+                          Added {date(key.createdAt)}{" "}
+                          <span aria-hidden="true">·</span> Last used:{" "}
+                          {date(key.lastUsedAt)}
+                        </p>
+                      </div>
+                      <div className="flex gap-2">
+                        <button
+                          className={`${button} inline-flex items-center gap-2`}
+                          disabled={busy}
+                          aria-label={`Rename ${key.name}`}
+                          onClick={() => {
+                            setError("");
+                            setEditing(key);
+                            setName(key.name);
+                          }}
+                        >
+                          <PencilSquareIcon className="h-4 w-4" />
+                          Rename
+                        </button>
+                        <button
+                          className={`${button} inline-flex items-center gap-2 text-red-700`}
+                          disabled={busy}
+                          aria-label={`Remove ${key.name}`}
+                          onClick={() => {
+                            setError("");
+                            setRemoving(key);
+                          }}
+                        >
+                          <TrashIcon className="h-4 w-4" />
+                          Remove
+                        </button>
+                      </div>
+                    </li>
+                  ))}
+                </ul>
+              )}
+              <p className="mt-5 text-xs leading-5 text-gray-500">
+                Display names help you recognize your passkeys here. They do not
+                change the name shown by your device or password manager.
+              </p>
+              {!supported && (
+                <p className="mt-4 text-sm text-amber-800">
+                  To add a passkey, use a browser that supports passkeys over
+                  HTTPS. You can still rename or remove existing keys.
+                </p>
+              )}
+              {syncWarning && (
+                <div className="mt-5 rounded border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
+                  <p>{syncWarning}</p>
+                  <button
+                    className="mt-2 inline-flex items-center gap-1 font-semibold underline disabled:opacity-50"
+                    disabled={busy}
+                    onClick={async () => {
+                      setBusy(true);
+                      try {
+                        await refresh();
+                      } finally {
+                        setBusy(false);
+                      }
+                    }}
+                  >
+                    <ArrowPathIcon className="h-4 w-4" />
+                    Retry sync
+                  </button>
+                </div>
+              )}
+            </>
+          )}
+        </div>
+        <div className="flex items-start gap-3 rounded-b-lg border-t border-gray-200 bg-gray-50 p-5 text-xs leading-5 text-gray-600">
+          <ShieldCheckIcon className="h-5 w-5 shrink-0" />
+          <p>
+            Your biometric information stays on your device. You can always use
+            your password to sign in, even after removing your last passkey.
+          </p>
+        </div>
+      </section>
+      <dialog
+        ref={dialog}
+        aria-labelledby="passkey-dialog-title"
+        onCancel={(e) => {
+          e.preventDefault();
+          close();
+        }}
+        onClose={close}
+        className="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-black/40"
+      >
+        <form onSubmit={mutate}>
+          <h2 id="passkey-dialog-title" className="text-xl font-bold">
+            {removing
+              ? "Remove passkey?"
+              : editing
+                ? "Rename passkey"
+                : "Add a passkey"}
+          </h2>
+          {removing ? (
+            <p className="my-4 break-words text-sm leading-6 text-gray-600">
+              “{removing.name}” will no longer work for this account.{" "}
+              {data?.passkeys.length === 1
+                ? "This is your last passkey. You can still sign in with your password. "
+                : ""}
+              Your browser will be notified when supported. You may also need to
+              remove it from your password manager.
+            </p>
+          ) : (
+            <div className="my-5">
+              <label
+                htmlFor="passkey-name"
+                className="mb-2 block text-sm font-medium"
+              >
+                Display name
+              </label>
+              <input
+                ref={nameInput}
+                id="passkey-name"
+                className={input}
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                maxLength={80}
+                required
+                disabled={busy}
+                placeholder="e.g. Personal laptop"
+              />
+              <p className="mt-2 text-xs text-gray-500">
+                Choose a name you’ll recognize. Up to 80 characters.
+              </p>
+            </div>
+          )}
+          {error && modalOpen && (
+            <p
+              role="alert"
+              className="mb-4 rounded bg-red-50 p-3 text-sm text-red-800"
+            >
+              {error}
+            </p>
+          )}
+          <div className="mt-6 flex justify-end gap-3">
+            <button
+              type="button"
+              className={button}
+              disabled={busy}
+              onClick={close}
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={busy || (!removing && !name.trim())}
+              className={
+                removing
+                  ? `${button} border-red-700 bg-red-700 text-white hover:bg-red-800`
+                  : primary
+              }
+            >
+              {busy
+                ? "Saving…"
+                : removing
+                  ? "Remove passkey"
+                  : editing
+                    ? "Save name"
+                    : "Continue"}
+            </button>
+          </div>
+        </form>
+      </dialog>
+    </div>
+  );
+}
