diff --git a/src/pages/api/account/[...action].ts b/src/pages/api/account/[...action].ts
new file mode 100644
index 0000000..0fcc8e5
--- /dev/null
+++ b/src/pages/api/account/[...action].ts
@@ -0,0 +1,227 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import {
+  getAccount,
+  listPasskeys,
+  addPasskey,
+  renamePasskey,
+  removePasskey,
+  findCredential,
+  recordAuthentication,
+} from "../../../lib/passkey-store";
+
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+export const ALL: APIRoute = async ({ request, params, session }) => {
+  if (!session)
+    return json({ error: "Account sessions are unavailable." }, 503);
+  const url = new URL(request.url);
+  // These routes require same-origin writes even though the demo disables Astro's global check.
+  if (
+    request.method !== "GET" &&
+    request.headers.get("origin") !== url.origin
+  ) {
+    return json(
+      { error: "Please submit this request from The DevTools Times." },
+      403,
+    );
+  }
+  const rpId = process.env.WEBAUTHN_RP_ID || url.hostname;
+  const action = params.action;
+  try {
+    if (action === "login" && request.method === "POST") {
+      const { username, password } = await request.json();
+      if (
+        typeof username !== "string" ||
+        !username.trim() ||
+        typeof password !== "string" ||
+        !password
+      )
+        return json({ error: "Enter your username and password." }, 400);
+      const response = await fetch(
+        "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login",
+        {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ username: username.trim(), password }),
+          signal: AbortSignal.timeout(15000),
+        },
+      );
+      if (!response.ok)
+        return json(
+          { error: "Sign-in failed. Check your username and password." },
+          401,
+        );
+      await session.regenerate();
+      session.set("account", { username: username.trim() });
+      return json({ ok: true });
+    }
+    if (action === "authenticate/options" && request.method === "POST") {
+      const options = await generateAuthenticationOptions({
+        rpID: rpId,
+        userVerification: "required",
+      });
+      session.set("passkeyChallenge", {
+        value: options.challenge,
+        expires: Date.now() + 300000,
+        purpose: "authenticate",
+      });
+      return json(options);
+    }
+    if (action === "authenticate/verify" && request.method === "POST") {
+      const challenge = (await session.get("passkeyChallenge")) as
+        { value: string; expires: number; purpose: string } | undefined;
+      session.delete("passkeyChallenge");
+      if (
+        !challenge ||
+        challenge.purpose !== "authenticate" ||
+        challenge.expires < Date.now()
+      )
+        return json({ error: "Sign-in expired. Please try again." }, 400);
+      const response = await request.json();
+      const stored = findCredential(response.id, rpId);
+      if (!stored)
+        return json(
+          {
+            error:
+              "This passkey is no longer registered. Sign in with your password.",
+            unknownCredentialId: response.id,
+            rpId,
+          },
+          404,
+        );
+      const result = await verifyAuthenticationResponse({
+        response,
+        expectedChallenge: challenge.value,
+        expectedOrigin: url.origin,
+        expectedRPID: rpId,
+        credential: stored.credential,
+        requireUserVerification: true,
+      });
+      if (!result.verified)
+        return json({ error: "Unable to verify this passkey." }, 400);
+      recordAuthentication(response.id, result.authenticationInfo.newCounter);
+      await session.regenerate();
+      session.set("account", { username: stored.username });
+      return json({ ok: true });
+    }
+    const account = (await session.get("account")) as
+      { username: string } | undefined;
+    if (!account)
+      return json({ error: "Please sign in to manage your passkeys." }, 401);
+    if (action === "logout" && request.method === "POST") {
+      session.destroy();
+      return json({ ok: true });
+    }
+    const user = getAccount(account.username);
+    const snapshot = () => ({
+      user,
+      rpId,
+      passkeys: listPasskeys(account.username, rpId),
+    });
+    if (action === "passkeys" && request.method === "GET")
+      return json(snapshot());
+    if (action === "register/options" && request.method === "POST") {
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID: rpId,
+        userName: user.username,
+        userID: new Uint8Array(Buffer.from(user.userId, "base64url")),
+        attestationType: "none",
+        excludeCredentials: listPasskeys(user.username, rpId).map(({ id }) => ({
+          id,
+        })),
+        authenticatorSelection: {
+          residentKey: "required",
+          userVerification: "required",
+        },
+      });
+      session.set("passkeyChallenge", {
+        value: options.challenge,
+        expires: Date.now() + 300000,
+        purpose: "register",
+      });
+      return json(options);
+    }
+    if (action === "register/verify" && request.method === "POST") {
+      const challenge = (await session.get("passkeyChallenge")) as
+        { value: string; expires: number; purpose: string } | undefined;
+      session.delete("passkeyChallenge");
+      if (
+        !challenge ||
+        challenge.purpose !== "register" ||
+        challenge.expires < Date.now()
+      )
+        return json({ error: "Registration expired. Please try again." }, 400);
+      const { response, name } = await request.json();
+      if (typeof name !== "string" || !name.trim() || name.trim().length > 80)
+        return json(
+          { error: "Use a display name between 1 and 80 characters." },
+          400,
+        );
+      const result = await verifyRegistrationResponse({
+        response,
+        expectedChallenge: challenge.value,
+        expectedOrigin: url.origin,
+        expectedRPID: rpId,
+        requireUserVerification: true,
+      });
+      if (!result.verified || !result.registrationInfo)
+        return json({ error: "Unable to verify this passkey." }, 400);
+      addPasskey(
+        user.username,
+        rpId,
+        name.trim(),
+        result.registrationInfo.credential,
+      );
+      return json(snapshot(), 201);
+    }
+    if (action?.startsWith("passkeys/")) {
+      const id = action.slice("passkeys/".length);
+      if (request.method === "PATCH") {
+        const { name } = await request.json();
+        if (typeof name !== "string" || !name.trim() || name.trim().length > 80)
+          return json(
+            { error: "Use a display name between 1 and 80 characters." },
+            400,
+          );
+        if (!renamePasskey(user.username, rpId, id, name.trim()))
+          return json(
+            { error: "This passkey was not found. Refresh the list." },
+            404,
+          );
+        return json(snapshot());
+      }
+      if (request.method === "DELETE") {
+        if (!removePasskey(user.username, rpId, id))
+          return json(
+            { error: "This passkey was not found. Refresh the list." },
+            404,
+          );
+        return json(snapshot());
+      }
+    }
+    return json({ error: "Account endpoint not found." }, 404);
+  } catch (error) {
+    console.error(
+      "Account request failed:",
+      error instanceof Error ? error.name : "UnknownError",
+    );
+    return json(
+      { error: "We could not complete this request. Please try again." },
+      400,
+    );
+  }
+};
diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
new file mode 100644
index 0000000..7a05011
--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,91 @@
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { syncPasskeys } from "../src/lib/passkey-client.ts";
+
+const directory = mkdtempSync(join(tmpdir(), "times-passkeys-"));
+process.env.PASSKEY_DATABASE_PATH = join(directory, "test.sqlite");
+const store = await import("../src/lib/passkey-store.ts");
+after(() => rmSync(directory, { recursive: true, force: true }));
+
+test("passkeys persist with a stable account handle and cannot be changed by another reader or RP", () => {
+  const account = store.getAccount("reader");
+  assert.equal(store.getAccount("reader").userId, account.userId);
+  assert.notEqual(store.getAccount("other").userId, account.userId);
+  store.addPasskey("reader", "news.example", "Laptop", {
+    id: "dGVzdC1rZXk",
+    publicKey: new Uint8Array([1, 2, 3]),
+    counter: 0,
+  });
+  assert.equal(store.listPasskeys("other", "news.example").length, 0);
+  assert.equal(store.listPasskeys("reader", "other.example").length, 0);
+  assert.equal(
+    store.renamePasskey("other", "news.example", "dGVzdC1rZXk", "Stolen"),
+    false,
+  );
+  assert.equal(
+    store.removePasskey("reader", "other.example", "dGVzdC1rZXk"),
+    false,
+  );
+  assert.equal(
+    store.renamePasskey("reader", "news.example", "dGVzdC1rZXk", "Home laptop"),
+    true,
+  );
+  assert.equal(
+    store.listPasskeys("reader", "news.example")[0].name,
+    "Home laptop",
+  );
+  assert.deepEqual(
+    store.findCredential("dGVzdC1rZXk", "news.example").credential.publicKey,
+    new Uint8Array([1, 2, 3]),
+  );
+  store.recordAuthentication("dGVzdC1rZXk", 1);
+  assert.equal(
+    store.findCredential("dGVzdC1rZXk", "news.example").credential.counter,
+    1,
+  );
+  assert.ok(store.listPasskeys("reader", "news.example")[0].lastUsedAt);
+  assert.equal(
+    store.removePasskey("other", "news.example", "dGVzdC1rZXk"),
+    false,
+  );
+  assert.equal(
+    store.removePasskey("reader", "news.example", "dGVzdC1rZXk"),
+    true,
+  );
+  assert.equal(store.findCredential("dGVzdC1rZXk", "news.example"), undefined);
+});
+
+const snapshot = {
+  rpId: "news.example",
+  user: { username: "reader", userId: "dXNlcg" },
+  passkeys: [{ id: "a2V5" }],
+};
+test("sync sends the complete accepted list and handles removing the last passkey", async () => {
+  const calls = [];
+  globalThis.PublicKeyCredential = {
+    signalAllAcceptedCredentials: async (options) => calls.push(options),
+  };
+  assert.equal(await syncPasskeys(snapshot), null);
+  assert.deepEqual(calls[0], {
+    rpId: "news.example",
+    userId: "dXNlcg",
+    allAcceptedCredentialIds: ["a2V5"],
+  });
+  assert.equal(await syncPasskeys({ ...snapshot, passkeys: [] }), null);
+  assert.deepEqual(calls[1].allAcceptedCredentialIds, []);
+  delete globalThis.PublicKeyCredential;
+});
+test("unsupported browsers and failed authenticator sync return actionable guidance", async () => {
+  delete globalThis.PublicKeyCredential;
+  assert.match(await syncPasskeys(snapshot), /password manager/);
+  globalThis.PublicKeyCredential = {
+    signalAllAcceptedCredentials: async () => {
+      throw new Error("Sync unavailable");
+    },
+  };
+  assert.match(await syncPasskeys(snapshot), /account is up to date/);
+  delete globalThis.PublicKeyCredential;
+});
