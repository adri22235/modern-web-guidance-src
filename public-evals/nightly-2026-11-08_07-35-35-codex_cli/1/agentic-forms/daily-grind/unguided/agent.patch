+  <script>
+    const coffeeForm = document.getElementById('coffee-finder-form');
+    const coffees = {
+      bold: {
+        hot: { name: 'Dark Roast Espresso', description: 'A rich, concentrated shot with deep roasted notes and a bold finish.' },
+        iced: { name: 'Iced Americano', description: 'Dark roast espresso poured over cold water and ice for a crisp, bold cup.' }
+      },
+      smooth: {
+        hot: { name: 'Mellow House Coffee', description: 'A smooth, balanced brewed coffee with a gentle roasted finish.' },
+        iced: { name: 'Cold Brew', description: 'Steeped for 18 hours for a mellow, exceptionally smooth cup over ice.' }
+      },
+      sweet: {
+        hot: { name: 'Maple Oat Latte', description: 'Espresso and creamy steamed oat milk with a hint of Vermont maple syrup.' },
+        iced: { name: 'Iced Maple Oat Latte', description: 'Espresso, creamy oat milk, and Vermont maple syrup, served over ice.' }
+      }
+    };
+
+    coffeeForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(coffeeForm);
+      const taste = data.get('taste');
+      const temperature = data.get('temperature');
+      const valid = coffeeForm.reportValidity() &&
+        Object.hasOwn(coffees, taste) && Object.hasOwn(coffees[taste], temperature);
+      let result;
+
+      if (!valid) {
+        result = { error: 'Please choose a valid taste and temperature before finding your coffee.' };
+        document.getElementById('result-label').textContent = 'One more thing';
+        document.getElementById('result-name').textContent = 'Let’s find your match';
+        document.getElementById('result-description').textContent = result.error;
+        document.getElementById('result-meta').textContent = '';
+      } else {
+        result = { ...coffees[taste][temperature], preferences: { taste, temperature } };
+        document.getElementById('result-label').textContent = 'Your coffee match';
+        document.getElementById('result-name').textContent = result.name;
+        document.getElementById('result-description').textContent = result.description;
+        document.getElementById('result-meta').textContent =
+          `${temperature === 'hot' ? 'Served hot' : 'Served over ice'} · Matched to your ${taste} taste`;
+      }
+
+      // Progressive enhancement: the same form also works without WebMCP support.
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(result));
+      }
+    });
+  </script>
