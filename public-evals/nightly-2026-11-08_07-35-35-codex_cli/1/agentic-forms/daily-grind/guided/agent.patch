@@ -0,0 +1,25 @@
+# The Daily Grind
+
+Static homepage with a client-side coffee finder. No build step or backend is required.
+
+## Coffee finder
+
+Choose a temperature, flavor, and optional maximum price, then select **Find My Coffee**. Results include the listed price before tax and a menu link. No-match searches suggest refining the preferences. Editing preferences clears previous results until the next submission.
+
+The catalog in `coffee-finder.js` matches the homepage's seasonal favorites. Update both when changing menu descriptions or listed prices.
+
+## Declarative browser tool
+
+The homepage form exposes `find-coffee` with the WebMCP `toolname`, `tooldescription`, and `toolautosubmit` attributes. Its named native controls supply the browser-generated input schema:
+
+- `temperature`: `any`, `hot`, or `iced`.
+- `flavor`: `any`, `sweet`, `bold`, or `smooth`.
+- `maxPrice`: optional nonnegative USD amount, in increments of 0.01; leave blank for any price.
+
+Agents can fill and submit this read-only finder automatically. The same submit handler updates the visible results and returns a structured response through `SubmitEvent.respondWith()` when invoked by an agent. Responses include preferences, matching coffees, absolute menu URLs, currency, tax information, and a human-readable message. Validation failures return an `error` message.
+
+Native agent discovery requires a browser with experimental WebMCP Declarative API support enabled; serve the page in a secure context. See the [Chrome Declarative API documentation](https://developer.chrome.com/docs/ai/webmcp/declarative-api). Browsers without WebMCP support ignore the annotations and use the normal JavaScript form. With JavaScript disabled, the page directs visitors to browse the seasonal favorites.
+
+## Checks
+
+`node --check coffee-finder.js` checks JavaScript syntax. There is no build script. The implementation was also checked with non-browser assertions covering filters, budgets, validation, empty results, ordinary submissions, and structured agent responses, plus static checks for form labels and tool annotations.
diff --git a/coffee-finder.js b/coffee-finder.js
new file mode 100644
index 0000000..7fd14b9
--- /dev/null
+++ b/coffee-finder.js
@@ -0,0 +1,95 @@
+'use strict';
+
+(() => {
+  const coffees = [
+    {
+      name: 'Maple Oat Latte', temperature: 'hot', flavor: 'sweet', price: 5.50,
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      menuUrl: '/menu/seasonal',
+    },
+    {
+      name: 'Dark Roast Espresso', temperature: 'hot', flavor: 'bold', price: 3.00,
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      menuUrl: '/menu/espresso',
+    },
+    {
+      name: 'Cold Brew', temperature: 'iced', flavor: 'smooth', price: 4.50,
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      menuUrl: '/menu/cold-brew',
+    },
+  ];
+
+  const form = document.getElementById('coffee-finder-form');
+  const status = document.getElementById('finder-status');
+  const results = document.getElementById('finder-results');
+  const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+  function findCoffee() {
+    const data = new FormData(form);
+    const temperature = data.get('temperature');
+    const flavor = data.get('flavor');
+    const rawPrice = data.get('maxPrice');
+    const maxPrice = rawPrice === '' ? null : Number(rawPrice);
+
+    if (!form.checkValidity() ||
+        !['any', 'hot', 'iced'].includes(temperature) ||
+        !['any', 'sweet', 'bold', 'smooth'].includes(flavor) ||
+        (maxPrice !== null && (!Number.isFinite(maxPrice) || maxPrice < 0))) {
+      results.replaceChildren();
+      status.textContent = 'Please choose a temperature and flavor, and enter a valid price of zero or more (up to two decimal places).';
+      form.reportValidity();
+      return { error: status.textContent };
+    }
+
+    const matches = coffees.filter(coffee =>
+      (temperature === 'any' || coffee.temperature === temperature) &&
+      (flavor === 'any' || coffee.flavor === flavor) &&
+      (maxPrice === null || Math.round(coffee.price * 100) <= Math.round(maxPrice * 100))
+    );
+
+    const cards = matches.map(coffee => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const title = document.createElement('h3');
+      title.textContent = coffee.name;
+      const description = document.createElement('p');
+      description.textContent = coffee.description;
+      const price = document.createElement('p');
+      price.className = 'coffee-price';
+      price.textContent = `${currency.format(coffee.price)} · ${coffee.temperature === 'hot' ? 'Hot' : 'Iced'}`;
+      const link = document.createElement('a');
+      link.href = coffee.menuUrl;
+      link.className = 'btn';
+      link.textContent = `View ${coffee.name}`;
+      card.append(title, description, price, link);
+      return card;
+    });
+
+    results.replaceChildren(...cards);
+    status.textContent = matches.length
+      ? `${matches.length} coffee${matches.length === 1 ? '' : 's'} matched your mood. Prices are before tax.`
+      : 'No coffees match just yet. Try another flavor, choose either temperature, or increase your budget.';
+
+    return {
+      preferences: { temperature, flavor, maxPrice },
+      currency: 'USD',
+      pricesIncludeTax: false,
+      matches: matches.map(coffee => ({ ...coffee, menuUrl: new URL(coffee.menuUrl, location.href).href })),
+      message: status.textContent,
+    };
+  }
+
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    const result = findCoffee();
+    // Unsupported browsers use the same form handler and simply ignore WebMCP attributes.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(result));
+    }
+  });
+
+  form.addEventListener('input', () => {
+    results.replaceChildren();
+    status.textContent = 'Preferences updated. Select Find My Coffee to see your matches.';
+  });
+})();
