diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..bb517e0
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,6 @@
+// Optional extensions while the WebMCP declarative API is experimental.
+// Ordinary submit events keep using the same form handler.
+export interface WebMCPSubmitEvent extends SubmitEvent {
+  readonly agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+}
