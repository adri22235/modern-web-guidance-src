diff --git a/src/main.js b/src/main.js
new file mode 100644
--- a/src/main.js
+++ b/src/main.js
@@ -0,0 +1,169 @@
+import * as THREE from 'three';
+import { CSS3DRenderer, CSS3DObject } from 'three/addons/renderers/CSS3DRenderer.js';
+
+const host = document.querySelector('#coffee-scene');
+const label = document.querySelector('#box-label');
+const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+let rotating = !motionPreference.matches;
+const toggle = document.querySelector('#rotation-toggle');
+const syncToggle = () => {
+  toggle.textContent = rotating ? 'Ⅱ' : '▷';
+  toggle.setAttribute('aria-label', rotating ? 'Pause rotation' : 'Resume rotation');
+  toggle.title = rotating ? 'Pause rotation' : 'Resume rotation';
+};
+syncToggle();
+toggle.addEventListener('click', () => { rotating = !rotating; syncToggle(); });
+motionPreference.addEventListener('change', event => { rotating = !event.matches; syncToggle(); });
+
+try {
+  const scene = new THREE.Scene();
+  const htmlScene = new THREE.Scene();
+  const camera = new THREE.PerspectiveCamera(37, 1, 0.1, 100);
+  camera.position.set(0, .15, 8.7);
+  camera.lookAt(0, .05, 0);
+  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
+  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
+  renderer.setClearColor(0x000000, 0);
+  renderer.shadowMap.enabled = true;
+  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
+  renderer.domElement.setAttribute('aria-hidden', 'true');
+  host.prepend(renderer.domElement);
+  const htmlRenderer = new CSS3DRenderer();
+  htmlRenderer.domElement.className = 'css-renderer';
+  host.append(htmlRenderer.domElement);
+  scene.add(new THREE.AmbientLight(0xffffff, 2.5));
+  const sun = new THREE.DirectionalLight(0xfff8e8, 3.2);
+  sun.position.set(-3, 7, 6);
+  sun.castShadow = true;
+  sun.shadow.mapSize.set(1024, 1024);
+  sun.shadow.camera.left = -5; sun.shadow.camera.right = 5;
+  sun.shadow.camera.top = 6; sun.shadow.camera.bottom = -6;
+  sun.shadow.normalBias = .04;
+  scene.add(sun);
+  const box = new THREE.Group();
+  scene.add(box);
+  const body = new THREE.Mesh(new THREE.BoxGeometry(2.89, 4.505, 1.25), new THREE.MeshStandardMaterial({ color: '#a6b793', roughness: .86 }));
+  body.castShadow = true;
+  box.add(body);
+  // Fine folds and a seam give the carton a physical edge.
+  const edges = new THREE.LineSegments(new THREE.EdgesGeometry(body.geometry), new THREE.LineBasicMaterial({color: '#6e855e', transparent: true, opacity: .25}));
+  box.add(edges);
+  const topSeam = new THREE.Mesh(new THREE.BoxGeometry(2.87, .012, .022), new THREE.MeshStandardMaterial({color: '#8fa47a'}));
+  topSeam.position.set(0, 2.26, 0); box.add(topSeam);
+  const shadow = new THREE.Mesh(new THREE.PlaneGeometry(30, 30), new THREE.ShadowMaterial({ opacity: .12 }));
+  shadow.rotation.x = -Math.PI / 2;
+  shadow.position.y = -2.52;
+  shadow.receiveShadow = true; scene.add(shadow);
+  const htmlBox = new THREE.Group();
+  htmlScene.add(htmlBox);
+  const formSurface = new CSS3DObject(label);
+  formSurface.scale.setScalar(.0085);
+  formSurface.position.z = .629;
+  htmlBox.add(formSurface);
+  const resize = () => {
+    const width = host.clientWidth, height = host.clientHeight;
+    camera.aspect = width / height;
+    // Preserve enough room for the box on small screens.
+    camera.position.z = width < 420 ? 9.8 : 8.7;
+    camera.updateProjectionMatrix();
+    renderer.setSize(width, height);
+    htmlRenderer.setSize(width, height);
+  };
+  new ResizeObserver(resize).observe(host);
+  resize();
+  let time = 0, last = 0, offset = 0;
+  let dragging = false, startX = 0, startOffset = 0;
+  renderer.domElement.addEventListener('pointerdown', event => {
+    dragging = true; startX = event.clientX; startOffset = offset;
+    renderer.domElement.setPointerCapture(event.pointerId);
+    renderer.domElement.style.cursor = 'grabbing';
+  });
+  renderer.domElement.addEventListener('pointermove', event => {
+    if (dragging) offset = THREE.MathUtils.clamp(startOffset + (event.clientX - startX) * .003, -.45, .45);
+  });
+  const endDrag = () => { dragging = false; renderer.domElement.style.cursor = 'grab'; };
+  renderer.domElement.addEventListener('pointerup', endDrag);
+  renderer.domElement.addEventListener('pointercancel', endDrag);
+  renderer.domElement.style.cursor = 'grab';
+  // Both renderers share a camera and transform. HTML retains native hit testing.
+  renderer.setAnimationLoop(now => {
+    const delta = last ? Math.min((now - last) / 1000, .05) : 0;
+    last = now;
+    if (rotating && !dragging) time += delta;
+    box.rotation.set(-.055 + Math.sin(time * .5) * .025, -.27 + Math.sin(time * .6) * .22 + offset, -.065 + Math.sin(time * .4) * .025);
+    box.position.y = Math.sin(time * .9) * .055;
+    htmlBox.quaternion.copy(box.quaternion);
+    htmlBox.position.copy(box.position);
+    renderer.render(scene, camera);
+    htmlRenderer.render(htmlScene, camera);
+  });
+} catch (error) {
+  // Ordering stays available if the device has no WebGL context.
+  host.append(label);
+  label.style.cssText = 'position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:90%;';
+  toggle.hidden = true;
+  console.warn('3D rendering unavailable:', error.message);
+}
+
+const quantity = document.querySelector('#quantity');
+const clampQuantity = () => {
+  quantity.value = Math.min(10, Math.max(1, Math.floor(Number(quantity.value) || 1)));
+  document.querySelector('#price').textContent = Number(quantity.value) * 18;
+};
+quantity.addEventListener('change', clampQuantity);
+quantity.addEventListener('input', () => { if (quantity.value) clampQuantity(); });
+for (const [id, amount] of [['increase', 1], ['decrease', -1]]) {
+  document.querySelector(`#${id}`).addEventListener('click', () => { quantity.value = Number(quantity.value) + amount; clampQuantity(); });
+}
+let toastTimeout;
+function notify(message) {
+  const toast = document.querySelector('#toast');
+  toast.textContent = message;
+  toast.classList.add('visible');
+  clearTimeout(toastTimeout);
+  toastTimeout = setTimeout(() => toast.classList.remove('visible'), 4000);
+}
+let bag = [];
+try { bag = JSON.parse(localStorage.getItem('daily-grind-bag') || '[]'); if (!Array.isArray(bag)) bag = []; bag = bag.filter(item => ['House Blend', 'Sunrise Blend', 'Midnight Blend'].includes(item.roast) && typeof item.grind === 'string' && Number.isInteger(item.quantity) && item.quantity > 0); } catch { bag = []; }
+const bagCount = () => document.querySelector('#bag-count').textContent = `(${bag.reduce((sum, item) => sum + item.quantity, 0)})`;
+bagCount();
+document.querySelector('#coffee-form').addEventListener('submit', event => {
+  event.preventDefault(); clampQuantity();
+  const roast = document.querySelector('#roast').value;
+  const grind = document.querySelector('#grind').value;
+  const count = Number(quantity.value);
+  const existing = bag.find(item => item.roast === roast && item.grind === grind);
+  if (existing) existing.quantity += count;
+  else bag.push({ roast, grind, quantity: count });
+  try { localStorage.setItem('daily-grind-bag', JSON.stringify(bag)); } catch { /* Bag still works for this visit. */ }
+  bagCount(); notify(`${count} × ${roast} added to your bag. Good days ahead.`);
+});
+const dialog = document.querySelector('#bag-dialog');
+document.querySelector('#bag-button').addEventListener('click', () => {
+  const items = document.querySelector('#bag-items'); items.replaceChildren();
+  if (!bag.length) { const empty = document.createElement('p'); empty.textContent = 'Your next good morning is waiting. Pick a coffee to get started.'; items.append(empty); }
+  for (const item of bag) {
+    const row = document.createElement('div'); row.className = 'bag-item';
+    const details = document.createElement('div'); details.textContent = `${item.quantity} × ${item.roast}`;
+    const grind = document.createElement('small'); grind.textContent = `${item.grind} · 250g`; details.append(grind);
+    const price = document.createElement('span'); price.textContent = `$${item.quantity * 18}`;
+    row.append(details, price); items.append(row);
+  }
+  document.querySelector('#bag-total').textContent = bag.length ? `Subtotal: $${bag.reduce((sum, item) => sum + item.quantity * 18, 0)}` : '';
+  dialog.showModal();
+});
+document.querySelector('#close-bag').addEventListener('click', () => dialog.close());
+document.querySelector('#continue-shopping').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+document.querySelectorAll('.coffee-card').forEach(card => card.addEventListener('click', () => {
+  document.querySelector('#roast').value = card.dataset.roast;
+  document.querySelector('.product-experience').scrollIntoView({ behavior: motionPreference.matches ? 'instant' : 'smooth', block: 'center' });
+  notify(`${card.dataset.roast} selected. Make it yours above.`);
+}));
+document.querySelector('#newsletter').addEventListener('submit', event => {
+  event.preventDefault();
+  const email = document.querySelector('#email').value;
+  try { localStorage.setItem('daily-grind-newsletter', email); } catch { /* Confirmation remains visible. */ }
+  notify('Thanks! Your email has been saved on this device.');
+  event.target.reset();
+});
