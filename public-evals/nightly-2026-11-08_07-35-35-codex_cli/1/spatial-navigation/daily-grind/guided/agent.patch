diff --git a/spatial-navigation.mjs b/spatial-navigation.mjs
new file mode 100644
index 0000000..80ec79f
--- /dev/null
+++ b/spatial-navigation.mjs
@@ -0,0 +1,97 @@
+const directions = {
+  ArrowRight: ['left', 'right', 'top', 'bottom', 1],
+  ArrowLeft: ['right', 'left', 'top', 'bottom', -1],
+  ArrowDown: ['top', 'bottom', 'left', 'right', 1],
+  ArrowUp: ['bottom', 'top', 'left', 'right', -1],
+};
+
+// Rectangles are supplied afresh on each keypress, never inferred from DOM order.
+export function findSpatialTarget(current, candidates, key) {
+  const direction = directions[key];
+  if (!direction) return;
+  const [near, far, crossStart, crossEnd, sign] = direction;
+  const center = (rect) => (rect[crossStart] + rect[crossEnd]) / 2;
+  let best;
+
+  for (const candidate of candidates) {
+    const gap = sign * (candidate.rect[near] - current[far]);
+    if (gap < -1) continue; // Allow subpixel rounding at touching edges.
+    const overlap = Math.min(current[crossEnd], candidate.rect[crossEnd])
+      - Math.max(current[crossStart], candidate.rect[crossStart]) > 0;
+    const offset = Math.abs(center(candidate.rect) - center(current));
+    const score = Math.max(0, gap) + 2 * offset;
+    const next = { candidate, overlap, gap: Math.max(0, gap), offset, score };
+    if (!best || (overlap && !best.overlap)
+      || (overlap === best.overlap && (overlap
+        ? next.gap < best.gap || (next.gap === best.gap && offset < best.offset)
+        : score < best.score))) {
+      best = next;
+    }
+  }
+  return best?.candidate.element;
+}
+
+function visibleItems(grid) {
+  return [...grid.querySelectorAll('[data-spatial-item]')].filter((item) => {
+    if (item.closest('[hidden], [inert], [aria-hidden="true"]')
+      || item.matches(':disabled, [aria-disabled="true"]')) return false;
+    if (item.checkVisibility) {
+      return item.checkVisibility({ visibilityProperty: true, opacityProperty: true });
+    }
+    // Fallback for browsers without checkVisibility().
+    const style = getComputedStyle(item);
+    return item.getClientRects().length > 0
+      && style.visibility === 'visible' && style.opacity !== '0';
+  });
+}
+
+export function setupSpatialGrid(grid) {
+  const items = [...grid.querySelectorAll('[data-spatial-item]')];
+  const initial = visibleItems(grid)[0];
+  if (!initial) return;
+
+  grid.setAttribute('role', 'grid');
+  grid.setAttribute('aria-labelledby', 'seasonal-heading');
+  // A layout grid uses one logical row; its cells may wrap visually.
+  grid.querySelector('[data-spatial-row]').setAttribute('role', 'row');
+  grid.querySelectorAll('.card').forEach((card) => card.setAttribute('role', 'gridcell'));
+  grid.setAttribute('aria-describedby', 'grid-help');
+  document.getElementById('grid-help').hidden = false;
+
+  const setActive = (active) => {
+    items.forEach((item) => { item.tabIndex = item === active ? 0 : -1; });
+  };
+  setActive(initial);
+
+  grid.addEventListener('focusin', (event) => {
+    const target = event.composedPath()[0];
+    if (items.includes(target)) setActive(target);
+  });
+
+  grid.addEventListener('keydown', (event) => {
+    if (!Object.hasOwn(directions, event.key) || event.defaultPrevented
+      || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey
+      || event.isComposing) return;
+    const target = event.composedPath()[0];
+    if (!items.includes(target)
+      || target.matches(':read-write, select, input, textarea, [role="slider"]')) return;
+
+    const visible = visibleItems(grid);
+    if (!visible.includes(target)) return;
+    const current = target.getBoundingClientRect();
+    const candidates = visible.filter((item) => item !== target)
+      .map((element) => ({ element, rect: element.getBoundingClientRect() }))
+      .filter(({ rect }) => rect.width > 0 && rect.height > 0);
+    const next = findSpatialTarget(current, candidates, event.key);
+    if (!next) return; // Preserve native scrolling at the widget's boundaries.
+
+    event.preventDefault();
+    setActive(next);
+    next.focus({ preventScroll: true });
+    next.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
+  });
+}
+
+if (typeof document !== 'undefined') {
+  document.querySelectorAll('[data-spatial-grid]').forEach(setupSpatialGrid);
+}
diff --git a/spatial-navigation.test.mjs b/spatial-navigation.test.mjs
new file mode 100644
index 0000000..543d8bf
--- /dev/null
+++ b/spatial-navigation.test.mjs
@@ -0,0 +1,107 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { findSpatialTarget, setupSpatialGrid } from './spatial-navigation.mjs';
+
+const rect = (left, top, width = 100, height = 100) => ({
+  left, top, right: left + width, bottom: top + height, width, height,
+});
+const candidate = (element, ...dimensions) => ({ element, rect: rect(...dimensions) });
+
+test('arrows follow physical directions regardless of DOM order, including RTL', () => {
+  const current = rect(120, 120);
+  const candidates = [candidate('down', 120, 240), candidate('left', 0, 120),
+    candidate('up', 120, 0), candidate('right', 240, 120)];
+  for (const direction of ['Right', 'Left', 'Up', 'Down']) {
+    assert.equal(findSpatialTarget(current, candidates, `Arrow${direction}`), direction.toLowerCase());
+  }
+});
+
+test('wrapped grids, incomplete rows, and single columns use current geometry', () => {
+  assert.equal(findSpatialTarget(rect(120, 0), [candidate('last', 0, 120)], 'ArrowDown'), 'last');
+  assert.equal(findSpatialTarget(rect(0, 0), [candidate('below', 0, 120)], 'ArrowDown'), 'below');
+  assert.equal(findSpatialTarget(rect(0, 0), [candidate('below', 0, 120)], 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(rect(120, 0), [candidate('wrapped', 0, 120)], 'ArrowRight'), undefined);
+});
+
+test('overlapping wide or tall cards are not treated as directional neighbors', () => {
+  assert.equal(findSpatialTarget(rect(0, 0, 300), [candidate('overlapping', 200, 0)], 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(rect(0, 0, 100, 300), [candidate('overlapping', 0, 200)], 'ArrowDown'), undefined);
+});
+
+test('aligned neighbors win over closer diagonal cards', () => {
+  const candidates = [candidate('diagonal', 105, 105), candidate('aligned', 300, 0)];
+  assert.equal(findSpatialTarget(rect(0, 0), candidates, 'ArrowRight'), 'aligned');
+});
+
+test('alignment uses gap first and perpendicular offset to break ties', () => {
+  const candidates = [candidate('far', 300, 0), candidate('offset', 120, 80), candidate('near', 120, 0)];
+  assert.equal(findSpatialTarget(rect(0, 0), candidates, 'ArrowRight'), 'near');
+});
+
+test('diagonal fallback favors the closer perpendicular alignment', () => {
+  const candidates = [candidate('far-side', 120, 400), candidate('near-side', 150, 120)];
+  assert.equal(findSpatialTarget(rect(0, 0), candidates, 'ArrowRight'), 'near-side');
+});
+
+test('touching edges tolerate subpixel rounding and boundaries do not wrap', () => {
+  assert.equal(findSpatialTarget(rect(0, 0), [candidate('neighbor', 99.5, 0)], 'ArrowRight'), 'neighbor');
+  assert.equal(findSpatialTarget(rect(0, 0), [], 'ArrowLeft'), undefined);
+  assert.equal(findSpatialTarget(rect(0, 0), [], 'Tab'), undefined);
+});
+
+test('widget integration preserves native keys, scrolls only on moves, and maintains one Tab stop', () => {
+  const listeners = {};
+  const attributes = {};
+  const help = { hidden: true };
+  const items = [0, 120, 240].map((left) => ({
+    box: rect(left, 0), visible: true, attributes: {},
+    closest() { return null; },
+    matches() { return false; },
+    checkVisibility() { return this.visible; },
+    getBoundingClientRect() { return this.box; },
+    setAttribute(name, value) { this.attributes[name] = value; },
+    focus(options) { this.focusOptions = options; },
+    scrollIntoView(options) { this.scrollOptions = options; },
+  }));
+  const grid = {
+    setAttribute(name, value) { attributes[name] = value; },
+    querySelectorAll() { return items; },
+    querySelector() { return { setAttribute() {} }; },
+    addEventListener(name, listener) { listeners[name] = listener; },
+  };
+  globalThis.document = { getElementById() { return help; } };
+  try {
+    setupSpatialGrid(grid);
+    assert.equal(attributes.role, 'grid');
+    assert.equal(help.hidden, false);
+    assert.deepEqual(items.map((item) => item.tabIndex), [0, -1, -1]);
+    const press = (target, key, extra = {}) => {
+      const event = { key, composedPath: () => [target], prevented: false,
+        preventDefault() { this.prevented = true; }, ...extra };
+      listeners.keydown(event);
+      return event.prevented;
+    };
+    assert.equal(press(items[0], 'ArrowLeft'), false);
+    assert.equal(press(items[0], 'Tab'), false);
+    assert.equal(press(items[0], 'Enter'), false);
+    for (const modifier of ['shiftKey', 'ctrlKey', 'altKey', 'metaKey', 'isComposing', 'defaultPrevented']) {
+      assert.equal(press(items[0], 'ArrowRight', { [modifier]: true }), false);
+    }
+    assert.equal(press({ matches: () => true }, 'ArrowRight'), false);
+    items[1].visible = false;
+    assert.equal(press(items[0], 'ArrowRight'), true);
+    assert.deepEqual(items.map((item) => item.tabIndex), [-1, -1, 0]);
+    assert.deepEqual(items[2].focusOptions, { preventScroll: true });
+    assert.deepEqual(items[2].scrollOptions, { block: 'nearest', inline: 'nearest', behavior: 'instant' });
+    assert.equal(items[1].focusOptions, undefined);
+    // Resizing/reordering must take effect without cached positions.
+    items[0].box = rect(240, 120);
+    assert.equal(press(items[2], 'ArrowDown'), true);
+    assert.deepEqual(items.map((item) => item.tabIndex), [0, -1, -1]);
+    // Pointer focus updates the entry point for the next Tab visit.
+    listeners.focusin({ composedPath: () => [items[2]] });
+    assert.deepEqual(items.map((item) => item.tabIndex), [-1, -1, 0]);
+  } finally {
+    delete globalThis.document;
+  }
+});
