diff --git a/spatial-navigation.js b/spatial-navigation.js
new file mode 100644
index 0000000..6bc6b92
--- /dev/null
+++ b/spatial-navigation.js
@@ -0,0 +1,72 @@
+const directions = {
+  ArrowLeft: { axis: 'x', sign: -1 },
+  ArrowRight: { axis: 'x', sign: 1 },
+  ArrowUp: { axis: 'y', sign: -1 },
+  ArrowDown: { axis: 'y', sign: 1 },
+};
+
+// Read physical positions rather than assuming a column count or DOM order.
+// Horizontal movement stays in the current row. Vertical movement selects the
+// closest column in the next row, including a partially filled final row.
+export function findNextCard(rects, currentIndex, key) {
+  const direction = directions[key];
+  const current = rects[currentIndex];
+  if (!direction || !current) return -1;
+
+  const horizontal = direction.axis === 'x';
+  const center = rect => ({
+    x: (rect.left + rect.right) / 2,
+    y: (rect.top + rect.bottom) / 2,
+  });
+  const origin = center(current);
+  let best = -1;
+  let bestPrimary = Infinity;
+  let bestCross = Infinity;
+
+  rects.forEach((rect, index) => {
+    if (index === currentIndex) return;
+    if (horizontal && Math.min(current.bottom, rect.bottom) <= Math.max(current.top, rect.top)) return;
+    // A taller card in the same row must not become an up/down destination.
+    if (!horizontal && Math.min(current.bottom, rect.bottom) > Math.max(current.top, rect.top)) return;
+
+    const point = center(rect);
+    if ((point[direction.axis] - origin[direction.axis]) * direction.sign <= 1) return;
+    // Compare row starts so unequal card heights do not favor another column.
+    const primary = (horizontal ? rect.left - current.left : rect.top - current.top) * direction.sign;
+    const cross = Math.abs(horizontal ? point.y - origin.y : point.x - origin.x);
+    if (primary < bestPrimary - 1 || (Math.abs(primary - bestPrimary) <= 1 && cross < bestCross)) {
+      best = index;
+      bestPrimary = primary;
+      bestCross = cross;
+    }
+  });
+  return best;
+}
+
+export function enableSpatialNavigation(grid) {
+  grid.addEventListener('keydown', event => {
+    if (!Object.hasOwn(directions, event.key) || event.defaultPrevented ||
+        event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.isComposing) return;
+
+    // Only the card's primary link participates; controls within cards retain
+    // their native arrow-key behavior.
+    const cards = Array.from(grid.querySelectorAll(':scope > .card')).flatMap(card => {
+      const link = card.querySelector('a.btn[href]');
+      if (!link || link.tabIndex < 0 || link.closest('[inert], [hidden], [aria-hidden="true"]') ||
+          !link.getClientRects().length || !card.getClientRects().length ||
+          getComputedStyle(link).visibility !== 'visible') return [];
+      return [{ link, rect: card.getBoundingClientRect() }];
+    });
+    const current = cards.findIndex(card => card.link === event.target);
+    if (current < 0) return;
+
+    // Keep arrow presses at a boundary from unexpectedly scrolling the page.
+    event.preventDefault();
+    const next = findNextCard(cards.map(card => card.rect), current, event.key);
+    if (next >= 0) cards[next].link.focus();
+  });
+}
+
+if (typeof document !== 'undefined') {
+  document.querySelectorAll('[data-spatial-grid]').forEach(enableSpatialNavigation);
+}
diff --git a/spatial-navigation.test.js b/spatial-navigation.test.js
new file mode 100644
index 0000000..bcb41f1
--- /dev/null
+++ b/spatial-navigation.test.js
@@ -0,0 +1,102 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { enableSpatialNavigation, findNextCard } from './spatial-navigation.js';
+
+const rect = (left, top, width = 100, height = 100) => ({
+  left, top, right: left + width, bottom: top + height,
+});
+
+test('single row follows physical left/right positions and stops at boundaries', () => {
+  const cards = [rect(0, 0), rect(120, 0), rect(240, 0)];
+  assert.equal(findNextCard(cards, 0, 'ArrowRight'), 1);
+  assert.equal(findNextCard(cards, 2, 'ArrowLeft'), 1);
+  assert.equal(findNextCard(cards, 2, 'ArrowRight'), -1);
+  assert.equal(findNextCard(cards, 0, 'ArrowLeft'), -1);
+  assert.equal(findNextCard(cards, 1, 'ArrowDown'), -1);
+});
+
+test('single column uses up/down without sideways movement', () => {
+  const cards = [rect(0, 0), rect(0, 120), rect(0, 240)];
+  assert.equal(findNextCard(cards, 0, 'ArrowDown'), 1);
+  assert.equal(findNextCard(cards, 2, 'ArrowUp'), 1);
+  assert.equal(findNextCard(cards, 2, 'ArrowDown'), -1);
+  assert.equal(findNextCard(cards, 0, 'ArrowUp'), -1);
+  assert.equal(findNextCard(cards, 1, 'ArrowRight'), -1);
+});
+
+test('multiple columns preserve columns and handle an incomplete last row', () => {
+  const cards = [rect(0, 0), rect(120, 0), rect(0, 120), rect(120, 120), rect(0, 240)];
+  assert.equal(findNextCard(cards, 0, 'ArrowDown'), 2);
+  assert.equal(findNextCard(cards, 1, 'ArrowDown'), 3);
+  assert.equal(findNextCard(cards, 3, 'ArrowDown'), 4);
+  assert.equal(findNextCard(cards, 3, 'ArrowUp'), 1);
+  assert.equal(findNextCard(cards, 1, 'ArrowRight'), -1);
+  assert.equal(findNextCard(cards, 2, 'ArrowLeft'), -1);
+});
+
+test('RTL and CSS reordered cards follow screen positions instead of DOM order', () => {
+  const cards = [rect(240, 0), rect(0, 0), rect(120, 0)];
+  assert.equal(findNextCard(cards, 0, 'ArrowLeft'), 2);
+  assert.equal(findNextCard(cards, 1, 'ArrowRight'), 2);
+});
+
+test('unequal card heights do not cause movement within a row on up/down', () => {
+  const cards = [rect(0, 0, 100, 80), rect(120, 0, 100, 100), rect(0, 120, 100, 150), rect(120, 120)];
+  assert.equal(findNextCard(cards, 0, 'ArrowDown'), 2);
+  assert.equal(findNextCard(cards, 2, 'ArrowUp'), 0);
+  assert.equal(findNextCard(cards, 2, 'ArrowRight'), 3);
+  assert.equal(findNextCard(cards, 0, 'Tab'), -1);
+});
+
+test('keyboard handling preserves native keys, skips unavailable cards, and rereads layout', () => {
+  let handler;
+  let focused = null;
+  const makeCard = (index, position) => {
+    const link = {
+      tabIndex: 0,
+      closest: () => null,
+      getClientRects: () => [position],
+      focus: () => { focused = index; },
+    };
+    return {
+      link, position,
+      querySelector: () => link,
+      getClientRects: () => [position],
+      getBoundingClientRect() { return this.position; },
+    };
+  };
+  const cards = [makeCard(0, rect(0, 0)), makeCard(1, rect(120, 0)), makeCard(2, rect(240, 0))];
+  const grid = {
+    addEventListener: (name, callback) => { assert.equal(name, 'keydown'); handler = callback; },
+    querySelectorAll: () => cards,
+  };
+  const previous = globalThis.getComputedStyle;
+  globalThis.getComputedStyle = () => ({ visibility: 'visible' });
+  try {
+    enableSpatialNavigation(grid);
+    const press = (key, extra = {}) => {
+      let prevented = false;
+      handler({ key, target: cards[0].link, preventDefault: () => { prevented = true; }, ...extra });
+      return prevented;
+    };
+    assert.equal(press('Tab'), false);
+    assert.equal(press('Enter'), false);
+    assert.equal(press('ArrowRight', { ctrlKey: true }), false);
+    assert.equal(press('ArrowRight', { defaultPrevented: true }), false);
+    assert.equal(press('ArrowRight', { target: {} }), false);
+    assert.equal(press('ArrowRight'), true);
+    assert.equal(focused, 1);
+    cards[1].link.closest = () => ({});
+    press('ArrowRight');
+    assert.equal(focused, 2);
+    cards[2].position = rect(0, 120);
+    focused = null;
+    press('ArrowRight');
+    assert.equal(focused, null);
+    press('ArrowDown');
+    assert.equal(focused, 2);
+  } finally {
+    if (previous === undefined) delete globalThis.getComputedStyle;
+    else globalThis.getComputedStyle = previous;
+  }
+});
