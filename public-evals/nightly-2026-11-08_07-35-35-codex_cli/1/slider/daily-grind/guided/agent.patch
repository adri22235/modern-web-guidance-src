+  <script>
+    const brewSlider = document.getElementById('brew-strength');
+    const brewValue = document.getElementById('brew-value');
+    const brewStrengths = ['Mild', 'Mellow', 'Balanced', 'Bold', 'Strong'];
+
+    function syncBrewStrength() {
+      const valueText = `${brewStrengths[Number(brewSlider.value) - 1]} · ${brewSlider.value} of ${brewSlider.max}`;
+      // Sync numeric properties as a fallback for browsers without typed CSS attr().
+      brewSlider.style.setProperty('--attr-min', brewSlider.min);
+      brewSlider.style.setProperty('--attr-max', brewSlider.max);
+      brewSlider.style.setProperty('--control-value', brewSlider.value);
+      brewSlider.setAttribute('aria-valuetext', valueText);
+      brewValue.textContent = valueText;
+      brewValue.hidden = false;
+    }
+
+    brewSlider.addEventListener('input', syncBrewStrength);
+    window.addEventListener('pageshow', syncBrewStrength);
+    syncBrewStrength();
+  </script>
