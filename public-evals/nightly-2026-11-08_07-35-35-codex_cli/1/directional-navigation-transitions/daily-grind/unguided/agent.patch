+  <script>
+    const seasonalItems = document.getElementById('seasonal-items');
+    const seasonalCards = Array.from(seasonalItems.querySelectorAll('.card'));
+    const seasonalPosition = document.getElementById('seasonal-position');
+    let seasonalIndex = 0;
+
+    function changeSeasonalItem(direction) {
+      seasonalCards[seasonalIndex].hidden = true;
+      seasonalIndex = (seasonalIndex + direction + seasonalCards.length) % seasonalCards.length;
+      seasonalItems.dataset.direction = direction === 1 ? 'next' : 'previous';
+      seasonalCards[seasonalIndex].hidden = false;
+      seasonalPosition.textContent = `${seasonalIndex + 1} of ${seasonalCards.length}`;
+    }
+
+    document.getElementById('seasonal-next').addEventListener('click', () => changeSeasonalItem(1));
+    document.getElementById('seasonal-previous').addEventListener('click', () => changeSeasonalItem(-1));
+  </script>
