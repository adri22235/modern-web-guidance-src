+  <script>
+    const slides = [...document.querySelectorAll('#seasonal-items .card')];
+    const previous = document.querySelector('#seasonal-previous');
+    const next = document.querySelector('#seasonal-next');
+    const status = document.querySelector('#seasonal-status');
+    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
+    let current = 0;
+    let busy = false;
+    let transition;
+    let animation;
+
+    motion.addEventListener('change', () => {
+      if (!motion.matches) {
+        transition?.skipTransition();
+        animation?.cancel();
+      }
+    });
+
+    async function step(direction) {
+      if (busy) return;
+      busy = true;
+      previous.setAttribute('aria-disabled', 'true');
+      next.setAttribute('aria-disabled', 'true');
+
+      const update = () => {
+        slides[current].hidden = true;
+        current = (current + direction + slides.length) % slides.length;
+        slides[current].hidden = false;
+        status.textContent = `${current + 1} of ${slides.length}: ${slides[current].querySelector('h3').textContent}`;
+      };
+
+      try {
+        if (motion.matches && document.startViewTransition &&
+            CSS.supports('selector(:active-view-transition-type(forward))')) {
+          transition = document.startViewTransition({
+            update,
+            types: [direction === 1 ? 'forward' : 'backward']
+          });
+          await transition.finished;
+        } else {
+          update();
+          // Keep directional entry on browsers without typed View Transitions.
+          if (motion.matches && slides[current].animate) {
+            animation = slides[current].animate([
+              { transform: `translateX(${direction * 100}%)` },
+              { transform: 'translateX(0)' }
+            ], { duration: 280, easing: 'ease-out' });
+            await animation.finished;
+          }
+        }
+      } catch (error) {
+        // Canceling an animation when reduced motion changes is expected.
+        if (error.name !== 'AbortError') throw error;
+      } finally {
+        busy = false;
+        transition = undefined;
+        animation = undefined;
+        previous.removeAttribute('aria-disabled');
+        next.removeAttribute('aria-disabled');
+      }
+    }
+
+    previous.addEventListener('click', () => step(-1));
+    next.addEventListener('click', () => step(1));
+  </script>
