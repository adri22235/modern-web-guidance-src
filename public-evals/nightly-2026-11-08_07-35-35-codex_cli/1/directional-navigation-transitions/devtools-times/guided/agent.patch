diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..f43b528
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,142 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider
+    class="block bg-white border-b border-gray-300"
+    role="region"
+    aria-label="Top Stories"
+    aria-roledescription="carousel"
+>
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="stories-viewport overflow-hidden">
+            {articles.map((article, index) => (
+                <div
+                    class="story"
+                    role="group"
+                    aria-roledescription="slide"
+                    aria-label={`${index + 1} of ${articles.length}`}
+                    aria-hidden={index !== 0 ? 'true' : 'false'}
+                    inert={index !== 0}
+                >
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                    </a>
+                    <time class="text-xs text-gray-500" datetime={article.data.date.toISOString()}>
+                        {article.data.date.toLocaleDateString()}
+                    </time>
+                </div>
+            ))}
+        </div>
+        <div data-controls hidden class="mt-3 flex items-center gap-3">
+            <button type="button" data-previous disabled={articles.length < 2}>Previous</button>
+            <span data-position role="status" aria-live="polite" aria-atomic="true" class="text-xs text-gray-500">
+                {articles.length ? `Story 1 of ${articles.length}` : 'No stories'}
+            </span>
+            <button type="button" data-next disabled={articles.length < 2}>Next</button>
+        </div>
+    </div>
+</top-stories-slider>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('.story'));
+            const position = this.querySelector<HTMLElement>('[data-position]');
+            let current = 0;
+
+            const move = (direction: number) => {
+                if (stories.length < 2) return;
+                this.dataset.direction = direction > 0 ? 'next' : 'previous';
+                stories[current].setAttribute('aria-hidden', 'true');
+                stories[current].inert = true;
+                current = (current + direction + stories.length) % stories.length;
+                stories[current].setAttribute('aria-hidden', 'false');
+                stories[current].inert = false;
+                if (position) position.textContent = `Story ${current + 1} of ${stories.length}`;
+            };
+
+            this.querySelector('[data-previous]')?.addEventListener('click', () => move(-1));
+            this.querySelector('[data-next]')?.addEventListener('click', () => move(1));
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            if (controls) controls.hidden = false;
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
+
+<style>
+    .stories-viewport {
+        display: grid;
+    }
+
+    .story {
+        grid-area: 1 / 1;
+        min-width: 0;
+        visibility: hidden;
+    }
+
+    .story[aria-hidden='false'] {
+        visibility: visible;
+    }
+
+    [data-controls][hidden] {
+        display: none;
+    }
+
+    button {
+        padding: 0.375rem 0.75rem;
+        border: 1px solid #d1d5db;
+        border-radius: 0.25rem;
+        font-size: 0.875rem;
+        font-weight: 600;
+        cursor: pointer;
+    }
+
+    button:hover:enabled {
+        background: #f3f4f6;
+    }
+
+    button:disabled {
+        opacity: 0.5;
+        cursor: default;
+    }
+
+    button:focus-visible,
+    .story a:focus-visible {
+        outline: 2px solid #b45309;
+        outline-offset: -2px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+        [data-direction='next'] .story[aria-hidden='false'] {
+            animation: story-from-right 300ms ease-out;
+        }
+
+        [data-direction='previous'] .story[aria-hidden='false'] {
+            animation: story-from-left 300ms ease-out;
+        }
+    }
+
+    @keyframes story-from-right {
+        from { transform: translateX(100%); }
+        to { transform: translateX(0); }
+    }
+
+    @keyframes story-from-left {
+        from { transform: translateX(-100%); }
+        to { transform: translateX(0); }
+    }
+</style>
