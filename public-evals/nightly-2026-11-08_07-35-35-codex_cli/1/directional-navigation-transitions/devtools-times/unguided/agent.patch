index 0000000..ea0bdc3
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,114 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-label="Top stories" aria-roledescription="carousel">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="stories-viewport grid overflow-hidden" aria-live="polite" aria-atomic="true">
+            {articles.map((article, index) => (
+                <div class="story" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`} hidden={index !== 0}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                    </a>
+                    <time class="text-xs text-gray-500" datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString()}</time>
+                </div>
+            ))}
+        </div>
+        <div class="mt-3 flex items-center gap-3" data-controls hidden>
+            <button type="button" data-previous class="border border-gray-300 rounded px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50">Previous</button>
+            <button type="button" data-next class="border border-gray-300 rounded px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50">Next</button>
+        </div>
+    </div>
+</top-stories-slider>
+
+<style>
+    .story {
+        grid-area: 1 / 1;
+        min-width: 0;
+    }
+
+    [hidden] {
+        display: none;
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        private cleanup?: () => void;
+
+        connectedCallback() {
+            const slides = Array.from(this.querySelectorAll<HTMLElement>('.story'));
+            const previous = this.querySelector<HTMLButtonElement>('[data-previous]')!;
+            const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
+            const controls = this.querySelector<HTMLElement>('[data-controls]')!;
+            if (slides.length < 2) return;
+
+            controls.hidden = false;
+            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+            const controller = new AbortController();
+            let current = 0;
+            let animations: Animation[] = [];
+            let switching = false;
+
+            const move = async (direction: number) => {
+                if (switching) return;
+                switching = true;
+                previous.disabled = next.disabled = true;
+                const outgoing = slides[current];
+                current = (current + direction + slides.length) % slides.length;
+                const incoming = slides[current];
+                outgoing.inert = true;
+                outgoing.setAttribute('aria-hidden', 'true');
+                incoming.hidden = false;
+
+                try {
+                    if (!reducedMotion.matches) {
+                        const options = { duration: 300, easing: 'ease-in-out' };
+                        animations = [
+                            outgoing.animate([
+                                { transform: 'translateX(0)' },
+                                { transform: `translateX(${-direction * 100}%)` },
+                            ], options),
+                            incoming.animate([
+                                { transform: `translateX(${direction * 100}%)` },
+                                { transform: 'translateX(0)' },
+                            ], options),
+                        ];
+                        await Promise.all(animations.map(animation => animation.finished));
+                    }
+                } finally {
+                    outgoing.hidden = true;
+                    outgoing.inert = false;
+                    outgoing.removeAttribute('aria-hidden');
+                    animations = [];
+                    previous.disabled = next.disabled = false;
+                    switching = false;
+                }
+            };
+
+            previous.addEventListener('click', () => { void move(-1); }, { signal: controller.signal });
+            next.addEventListener('click', () => { void move(1); }, { signal: controller.signal });
+            reducedMotion.addEventListener('change', () => {
+                if (reducedMotion.matches) animations.forEach(animation => animation.finish());
+            }, { signal: controller.signal });
+            this.cleanup = () => {
+                controller.abort();
+                animations.forEach(animation => animation.finish());
+            };
+        }
+
+        disconnectedCallback() {
+            this.cleanup?.();
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
