+    /* Loyalty Rewards */
+    .rewards {
+      display: grid;
+      grid-template-columns: minmax(0, 1fr) auto;
+      align-items: center;
+      gap: 32px;
+      margin-top: 40px;
+      padding: 32px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .rewards-eyebrow {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      margin-bottom: 8px;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .rewards-note {
+      margin-top: 8px;
+      font-size: 0.9rem;
+    }
+
+    .rewards-ring {
+      --reward-progress: 70%;
+      --ring-thickness: 14px;
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 200px;
+      height: 200px;
+      text-align: center;
+    }
+
+    .rewards-ring::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      border: var(--ring-thickness) solid transparent;
+      border-radius: 50%;
+      background: conic-gradient(var(--accent) var(--reward-progress), var(--secondary) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+    }
+
+    @supports not (background-clip: border-area) {
+      .rewards-ring::before {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side,
+          transparent calc(100% - var(--ring-thickness) - 0.5px),
+          black calc(100% - var(--ring-thickness)));
+      }
+    }
+
+    .rewards-progress {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .rewards-ring-content {
+      position: relative;
+      max-width: 150px;
+    }
+
+    .rewards-ring-content strong {
+      display: block;
+      color: var(--primary);
+      font-size: 2.25rem;
+      line-height: 1.2;
+    }
+
+    .rewards-ring-content span {
+      display: block;
+      font-size: 0.85rem;
+    }
+
+    .rewards-ring-content .rewards-remaining {
+      margin-top: 8px;
+      font-weight: 600;
+    }
+
+    @media (max-width: 600px) {
+      .rewards {
+        grid-template-columns: minmax(0, 1fr);
+        justify-items: center;
+        padding: 24px;
+        gap: 24px;
+        text-align: center;
+      }
+    }
+
