+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-options');
+    const options = Array.from(menu.querySelectorAll('[role="option"]'));
+    const roastInput = document.getElementById('roast');
+
+    function closePicker(restoreFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker() {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    trigger.addEventListener('click', () => {
+      if (menu.hidden) openPicker();
+      else closePicker();
+    });
+
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+
+    options.forEach(option => {
+      option.addEventListener('click', () => {
+        options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+        roastInput.value = option.dataset.value;
+        document.getElementById('roast-value').textContent = option.querySelector('strong').textContent + ' roast';
+        document.getElementById('order-now').href = '/order-online?roast=' + roastInput.value;
+        closePicker(true);
+      });
+    });
+
+    picker.addEventListener('keydown', event => {
+      if (menu.hidden) return;
+      const index = options.indexOf(document.activeElement);
+      let nextIndex;
+      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % options.length;
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + options.length) % options.length;
+      if (event.key === 'Home') nextIndex = 0;
+      if (event.key === 'End') nextIndex = options.length - 1;
+      if (nextIndex !== undefined) {
+        event.preventDefault();
+        options[nextIndex].focus();
+      }
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closePicker(true);
+      }
+      if (event.key === 'Tab') closePicker(true);
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
