+  <script>
+    // Preserve the same image grid where customizable selects are unavailable.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('roast');
+      const picker = document.createElement('details');
+      picker.className = 'roast-fallback';
+      const trigger = document.createElement('summary');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      trigger.append(value);
+      const options = document.createElement('div');
+      options.className = 'roast-options';
+      options.setAttribute('role', 'radiogroup');
+      options.setAttribute('aria-labelledby', 'roast-label');
+
+      for (const option of select.options) {
+        const title = option.value[0].toUpperCase() + option.value.slice(1) + ' roast';
+        const card = document.createElement('label');
+        card.className = 'roast-choice';
+        const image = document.createElement('img');
+        image.className = 'roast-image';
+        image.src = option.dataset.image;
+        image.alt = '';
+        image.width = 120;
+        image.height = 80;
+        const name = document.createElement('span');
+        name.className = 'roast-title';
+        name.textContent = title;
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roast';
+        radio.value = option.value;
+        radio.checked = option.selected;
+        if (radio.checked) value.textContent = title;
+        radio.addEventListener('change', () => { value.textContent = title; });
+        // Click/Space confirms; arrow keys can explore the radio group first.
+        card.addEventListener('click', () => {
+          radio.checked = true;
+          value.textContent = title;
+          picker.open = false;
+          trigger.focus();
+        });
+        radio.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter') {
+            event.preventDefault();
+            card.click();
+          }
+        });
+        card.append(image, name, notes, radio);
+        options.append(card);
+      }
+
+      picker.append(trigger, options);
+      select.after(picker);
+      select.hidden = true;
+      select.disabled = true;
+      document.getElementById('roast-label').removeAttribute('for');
+      picker.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          picker.open = false;
+          trigger.focus();
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!picker.contains(event.target)) picker.open = false;
+      });
+      picker.addEventListener('focusout', (event) => {
+        if (!picker.contains(event.relatedTarget)) picker.open = false;
+      });
+    }
+  </script>
