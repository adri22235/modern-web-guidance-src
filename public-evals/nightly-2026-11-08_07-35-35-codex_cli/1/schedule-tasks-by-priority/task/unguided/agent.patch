+<script>
+    (() => {
+      const types = {
+        urgent: { name: 'Checkout', rank: 0, slices: 24 },
+        standard: { name: 'Menu update', rank: 1, slices: 48 },
+        background: { name: 'Telemetry', rank: 2, slices: 72 }
+      };
+      const queue = [];
+      const list = document.getElementById('queue-list');
+      const activity = document.getElementById('activity-log');
+      const status = document.getElementById('queue-status');
+      let sequence = 0;
+      let completed = 0;
+      let scheduled = false;
+      let current = null;
+
+      function log(message) {
+        activity.querySelector('.activity-placeholder')?.remove();
+        const entry = document.createElement('li');
+        const time = document.createElement('time');
+        const now = new Date();
+        time.dateTime = now.toISOString();
+        time.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
+        entry.append(time, document.createTextNode(message));
+        activity.prepend(entry);
+        while (activity.children.length > 40) activity.lastElementChild.remove();
+      }
+
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} ${queue.length === 1 ? 'task' : 'tasks'}`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        status.textContent = queue.length ? 'Working · page stays interactive' : 'Ready when you are';
+        if (!queue.length) {
+          list.innerHTML = '<li class="queue-empty"><span>All quiet at the counter</span>Choose a task above to get things moving.</li>';
+          return;
+        }
+        list.replaceChildren(...queue.map(task => {
+          const row = document.createElement('li');
+          row.className = 'queued-task';
+          const percent = Math.round(task.done / task.slices * 100);
+          row.innerHTML = `<div class="task-heading"><strong>${task.name} #${task.id}</strong><span class="priority priority-${task.type}">${task.type}</span></div><div class="task-state">${task === current ? 'Running' : task.done ? 'Paused · higher priority first' : 'Waiting'} · ${percent}%</div><progress class="task-progress" max="${task.slices}" value="${task.done}" aria-label="${task.name} #${task.id} progress"></progress>`;
+          return row;
+        }));
+      }
+
+      function enqueue(type) {
+        const task = { ...types[type], type, id: ++sequence, done: 0 };
+        queue.push(task);
+        // FIFO within each priority; a paused task keeps its original position.
+        queue.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        log(`Queued ${task.name.toLowerCase()} #${task.id}`);
+        render();
+        if (!scheduled) {
+          scheduled = true;
+          setTimeout(runSlice, 0);
+        }
+      }
+
+      function runSlice() {
+        const task = queue[0];
+        if (!task) {
+          scheduled = false;
+          current = null;
+          render();
+          return;
+        }
+        if (current !== task) {
+          if (current && queue.includes(current)) log(`Paused ${current.name.toLowerCase()} #${current.id}`);
+          log(`${task.done ? 'Resumed' : 'Started'} ${task.name.toLowerCase()} #${task.id}`);
+          current = task;
+        }
+        // Bound CPU work to 4ms, then release the main thread for input and paint.
+        const deadline = performance.now() + 4;
+        let sample = task.done;
+        while (performance.now() < deadline) sample = Math.sqrt(sample + 123.456);
+        task.sample = sample;
+        task.done++;
+        if (task.done === task.slices) {
+          queue.shift();
+          completed++;
+          log(`Completed ${task.name.toLowerCase()} #${task.id}`);
+          current = null;
+        }
+        render();
+        // Re-select the highest priority on every slice, including newly added work.
+        setTimeout(runSlice, 24);
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue(button.dataset.task));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        // Deliberately enqueue out of priority order to demonstrate scheduling.
+        ['background', 'standard', 'urgent'].forEach(enqueue);
+      });
+    })();
+  </script>
