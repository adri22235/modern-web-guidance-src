diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..807c58e
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,125 @@
+(() => {
+  const form = document.querySelector('#language-form');
+  const select = document.querySelector('#language');
+  const button = document.querySelector('#translate-button');
+  const status = document.querySelector('#translation-status');
+  const elements = [...document.querySelectorAll('[data-translate]')];
+  const originals = elements.map((element) => element.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let translator;
+  let readyOptions;
+  let displayedLanguage = 'en';
+
+  const announce = (message) => { status.textContent = message; };
+  const languageName = () => select.selectedOptions[0].textContent;
+
+  function show(language, texts) {
+    elements.forEach((element, index) => {
+      element.textContent = texts[index];
+      element.lang = language;
+      element.dir = language === 'ar' ? 'rtl' : 'ltr';
+    });
+    displayedLanguage = language;
+  }
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    announce('On-device translation is unavailable in this browser. Use a supported desktop browser over HTTPS. You can still read the original English below.');
+    return;
+  }
+
+  select.disabled = false;
+  announce('Choose a language to translate the coffee descriptions and our story.');
+
+  select.addEventListener('change', async () => {
+    const current = ++revision;
+    translator?.destroy();
+    translator = undefined;
+    readyOptions = undefined;
+    button.disabled = true;
+    button.textContent = select.value === 'en' ? 'Show English' : 'Translate';
+
+    if (cache.has(select.value)) {
+      button.disabled = false;
+      announce(select.value === 'en' ? 'Ready to show the original English.' : 'This translation is ready on your device.');
+      return;
+    }
+
+    announce('Checking on-device language support…');
+    const options = { sourceLanguage: 'en', targetLanguage: select.value };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (current !== revision) return;
+      if (!['available', 'downloadable', 'downloading'].includes(availability)) {
+        announce('This language is unavailable on your device. Choose another language. The displayed text has been kept.');
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      button.textContent = availability === 'available' ? 'Translate' : 'Download & translate';
+      announce(availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'A language pack is needed. Select Download & translate to continue.');
+    } catch {
+      if (current !== revision) return;
+      announce('Could not check language support. Choose another language or select this one again to retry. The displayed text has been kept.');
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (button.disabled) return;
+    const language = select.value;
+    if (cache.has(language)) {
+      show(language, cache.get(language));
+      announce(language === 'en' ? 'Original English restored.' : `Coffee descriptions and story shown in ${languageName()}.`);
+      return;
+    }
+    if (!readyOptions || readyOptions.targetLanguage !== language) return;
+
+    const current = ++revision;
+    button.disabled = true;
+    announce('Preparing on-device translation… You can choose another language to cancel.');
+    let session;
+    try {
+      // Create directly in the submit gesture, after the separate availability check.
+      session = await window.Translator.create({
+        ...readyOptions,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            if (current !== revision) return;
+            const percent = Math.round(Math.max(0, Math.min(1, event.loaded)) * 100);
+            announce(`Downloading language pack: ${percent}%. Text will be translated on your device.`);
+          });
+        },
+      });
+      if (current !== revision) return;
+      translator = session;
+      announce('Translating coffee descriptions and story on your device…');
+      const texts = [];
+      // Always translate the English originals, avoiding translation drift.
+      for (const original of originals) {
+        if (current !== revision) return;
+        const translated = await session.translate(original);
+        if (typeof translated !== 'string' || !translated.trim()) {
+          throw new Error('Empty translation');
+        }
+        texts.push(translated);
+      }
+      if (current !== revision) return;
+      cache.set(language, texts);
+      show(language, texts);
+      announce(`Coffee descriptions and story shown in ${languageName()}. Translated on your device.`);
+    } catch {
+      if (current !== revision) return;
+      announce(`Translation could not finish. The ${displayedLanguage === 'en' ? 'original English' : 'previously translated'} text has been kept. Try again or choose another language.`);
+    } finally {
+      session?.destroy();
+      if (current === revision) {
+        translator = undefined;
+        button.disabled = false;
+        button.textContent = 'Translate';
+      }
+    }
+  });
+})();
