@@ -0,0 +1,89 @@
+(() => {
+  'use strict';
+
+  // Bundled copy keeps language changes on the device, without a translation service.
+  // English comes directly from the HTML, which also works when JavaScript is disabled.
+  const nodes = [...document.querySelectorAll('[data-i18n]')];
+  const english = Object.fromEntries(nodes.map(node => [node.dataset.i18n, node.textContent]));
+  const translations = {
+    en: { ...english, announcement: 'Language changed to English.' },
+    es: {
+      menu: 'Menú', locations: 'Locales', rewards: 'Recompensas', account: 'Mi cuenta', logout: 'Cerrar sesión',
+      heroTitle: 'Despierta tus sentidos', heroText: 'Café de origen ético, tostado localmente y servido en tu taza.',
+      order: 'Pedir ahora', favorites: 'Favoritos de temporada',
+      mapleName: 'Latte de avena y arce', mapleText: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.',
+      espressoName: 'Espresso de tueste oscuro', espressoText: 'Intenso, con notas ahumadas y perfecto para empezar la mañana con energía.',
+      coldName: 'Café de extracción en frío', coldText: 'Infusionado durante 18 horas para una suavidad excepcional.', details: 'Ver detalles',
+      storyTitle: 'Nuestra historia',
+      storyText: 'El buen café une a las personas. En The Daily Grind, creemos que cada taza debe empezar con granos de origen ético, un tueste cuidado y una cálida bienvenida.',
+      storyEnd: 'Desde el primer sorbo de la mañana hasta una charla por la tarde, estamos aquí para alegrarte el día. Tostado localmente. Preparado con cariño. Compartido contigo.',
+      careers: 'Únete al equipo', contact: 'Contacto', privacy: 'Privacidad',
+      copyright: '© 2026 The Daily Grind Coffee Co. Todos los derechos reservados.',
+      languageLabel: 'Un poquito más cerca de casa', languageHint: 'Lee nuestro menú y nuestra historia en tu idioma. Disponible sin conexión.',
+      announcement: 'Idioma cambiado a español.'
+    },
+    fr: {
+      menu: 'Carte', locations: 'Nos cafés', rewards: 'Fidélité', account: 'Mon compte', logout: 'Déconnexion',
+      heroTitle: 'Éveillez vos sens', heroText: 'Un café issu de sources éthiques, torréfié localement et servi dans votre tasse.',
+      order: 'Commander', favorites: 'Les favoris de saison',
+      mapleName: 'Latte à l’avoine et à l’érable', mapleText: 'Du lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      espressoName: 'Espresso à la torréfaction foncée', espressoText: 'Intense, aux notes fumées, idéal pour bien commencer la journée.',
+      coldName: 'Café infusé à froid', coldText: 'Infusé pendant 18 heures pour une douceur incomparable.', details: 'Voir les détails',
+      storyTitle: 'Notre histoire',
+      storyText: 'Un bon café rassemble. Chez The Daily Grind, nous pensons que chaque tasse doit commencer par des grains issus de sources éthiques, une torréfaction soignée et un accueil chaleureux.',
+      storyEnd: 'De votre première gorgée du matin à une pause entre amis l’après-midi, nous sommes là pour égayer votre quotidien. Torréfié localement. Préparé avec soin. Partagé avec vous.',
+      careers: 'Rejoindre l’équipe', contact: 'Nous contacter', privacy: 'Confidentialité',
+      copyright: '© 2026 The Daily Grind Coffee Co. Tous droits réservés.',
+      languageLabel: 'Un peu plus près de chez vous', languageHint: 'Découvrez notre carte et notre histoire dans votre langue. Disponible hors ligne.',
+      announcement: 'Langue changée en français.'
+    },
+    de: {
+      menu: 'Kaffeekarte', locations: 'Standorte', rewards: 'Treueprogramm', account: 'Mein Konto', logout: 'Abmelden',
+      heroTitle: 'Wecke deine Sinne', heroText: 'Ethisch bezogen, lokal geröstet und frisch in deiner Tasse.',
+      order: 'Jetzt bestellen', favorites: 'Saisonale Favoriten',
+      mapleName: 'Hafer-Latte mit Ahornsirup', mapleText: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      espressoName: 'Dunkel gerösteter Espresso', espressoText: 'Kräftig, mit rauchigen Noten – perfekt für einen schwungvollen Morgen.',
+      coldName: 'Cold Brew', coldText: 'Für besonders milden Genuss 18 Stunden lang kalt gezogen.', details: 'Mehr erfahren',
+      storyTitle: 'Unsere Geschichte',
+      storyText: 'Guter Kaffee bringt Menschen zusammen. Bei The Daily Grind glauben wir, dass jede Tasse mit ethisch bezogenen Bohnen, einer sorgfältigen Röstung und einem herzlichen Willkommen beginnen sollte.',
+      storyEnd: 'Vom ersten Schluck am Morgen bis zum Plausch am Nachmittag: Wir möchten deinen Alltag ein wenig schöner machen. Lokal geröstet. Mit Sorgfalt zubereitet. Mit dir geteilt.',
+      careers: 'Teil des Teams werden', contact: 'Kontakt', privacy: 'Datenschutz',
+      copyright: '© 2026 The Daily Grind Coffee Co. Alle Rechte vorbehalten.',
+      languageLabel: 'Ein kleines Stück Zuhause', languageHint: 'Lies unsere Kaffeekarte und Geschichte in deiner Sprache. Auch offline verfügbar.',
+      announcement: 'Sprache zu Deutsch geändert.'
+    }
+  };
+
+  const select = document.getElementById('language');
+  const status = document.getElementById('language-status');
+  const preferenceKey = 'daily-grind-language';
+
+  function setLanguage(language, announce = false) {
+    if (!Object.hasOwn(translations, language)) language = 'en';
+    const copy = translations[language];
+    nodes.forEach(node => {
+      node.textContent = copy[node.dataset.i18n] ?? english[node.dataset.i18n];
+    });
+    document.documentElement.lang = language;
+    select.value = language;
+    if (announce) status.textContent = copy.announcement;
+  }
+
+  let savedLanguage = 'en';
+  try {
+    savedLanguage = localStorage.getItem(preferenceKey) || 'en';
+  } catch {
+    // Translation still works when browser storage is unavailable.
+  }
+  setLanguage(savedLanguage);
+  document.getElementById('language-panel').hidden = false;
+
+  select.addEventListener('change', () => {
+    setLanguage(select.value, true);
+    try {
+      localStorage.setItem(preferenceKey, select.value);
+    } catch {
+      // Keeping the choice for this visit does not require browser storage.
+    }
+  });
+})();
