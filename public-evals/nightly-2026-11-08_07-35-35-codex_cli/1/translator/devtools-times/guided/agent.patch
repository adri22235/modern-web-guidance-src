+  .translation-footnote { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 10px 20px; flex-wrap: wrap; padding-top: 11px; border-top: 1px solid #eae3d5; color: #787165; font-size: 11px; line-height: 1.5; }
+  .translation-private { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
+  @media (max-width: 760px) { .translation-bar { grid-template-columns: 1fr; margin: 16px 16px 0; padding: 16px; gap: 12px; } .translation-actions { gap: 8px; } .translation-language { flex: 1; } .translation-heading { font-size: 22px; } }
