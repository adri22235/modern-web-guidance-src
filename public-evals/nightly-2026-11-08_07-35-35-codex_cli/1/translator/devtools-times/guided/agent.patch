diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..1994a62
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,153 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type TranslationSession = { translate(text: string): Promise<string>; destroy(): void };
+type TranslationOptions = {
+  sourceLanguage: string;
+  targetLanguage: string;
+  monitor: (monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }) => void;
+};
+type TranslationAPI = {
+  availability(options: TranslationOptions): Promise<Availability>;
+  create(options: TranslationOptions): Promise<TranslationSession>;
+};
+
+class ArticleTranslation extends HTMLElement {
+  private select!: HTMLSelectElement;
+  private translateButton!: HTMLButtonElement;
+  private restoreButton!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private api?: TranslationAPI;
+  private options!: TranslationOptions;
+  private session?: TranslationSession;
+  private generation = 0;
+  private busy = false;
+  private originals = new Map<Text, string>();
+  private roots: { element: HTMLElement; lang: string | null; dir: string | null }[] = [];
+
+  connectedCallback() {
+    this.select = this.querySelector('select')!;
+    this.translateButton = this.querySelector('[data-translate]')!;
+    this.restoreButton = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[data-status]')!;
+    this.api = (window as Window & { Translator?: TranslationAPI }).Translator;
+    const roots = document.querySelectorAll<HTMLElement>('[data-translate-content]');
+    if (!roots.length) { this.hidden = true; return; }
+    for (const element of roots) {
+      this.roots.push({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') });
+      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+        acceptNode: node => node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, [translate="no"], article-translation') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+      });
+      let node: Node | null;
+      while ((node = walker.nextNode())) this.originals.set(node as Text, node.textContent!);
+    }
+    if (!window.isSecureContext || !this.api) {
+      this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop Chrome or Edge browser.';
+      return;
+    }
+    this.select.disabled = false;
+    this.select.addEventListener('change', () => { void this.checkAvailability(); });
+    this.translateButton.addEventListener('click', () => { void this.translate(); });
+    this.restoreButton.addEventListener('click', () => this.restore());
+    void this.checkAvailability();
+  }
+
+  disconnectedCallback() { this.generation++; this.session?.destroy(); }
+
+  private async checkAvailability() {
+    const generation = ++this.generation;
+    this.translateButton.disabled = true;
+    if (this.select.value === 'en') { this.restore(); return; }
+    this.status.textContent = 'Checking language availability…';
+    const options: TranslationOptions = {
+      sourceLanguage: 'en', targetLanguage: this.select.value,
+      monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+        if (this.busy && this.options === options) this.status.textContent = `Downloading language pack… ${Math.round(event.loaded * 100)}%`;
+      }),
+    };
+    this.options = options;
+    try {
+      const availability = await this.api!.availability(options);
+      if (generation !== this.generation) return;
+      this.translateButton.disabled = availability === 'unavailable';
+      this.status.textContent = availability === 'unavailable'
+        ? 'This language is unavailable on your device. Choose another language.'
+        : availability === 'available'
+          ? 'Ready to translate. Article text stays on your device.'
+          : 'First use downloads a language pack. Translation runs on your device.';
+    } catch {
+      if (generation === this.generation) this.status.textContent = 'Could not check translation availability. Choose a language to try again.';
+    }
+  }
+
+  private async translate() {
+    if (this.busy || !this.api || this.translateButton.disabled) return;
+    const generation = ++this.generation;
+    const options = this.options;
+    this.busy = true;
+    this.select.disabled = this.translateButton.disabled = true;
+    this.restoreButton.hidden = false;
+    this.restoreButton.textContent = 'Cancel / show original';
+    this.translateButton.textContent = 'Translating…';
+    this.status.textContent = 'Preparing on-device translation…';
+    this.setAttribute('aria-busy', 'true');
+    try {
+      // create() is called directly from the click, preserving user activation for downloads.
+      const session = await this.api.create(options);
+      if (generation !== this.generation) { session.destroy(); return; }
+      this.session = session;
+      const results = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      for (const [node, original] of this.originals) {
+        const text = original.trim();
+        let translated = cache.get(text);
+        if (translated === undefined) {
+          translated = await session.translate(text);
+          cache.set(text, translated);
+        }
+        if (generation !== this.generation) return;
+        results.set(node, original.replace(text, () => translated!));
+        this.status.textContent = `Translating article text… ${Math.round(results.size / this.originals.size * 100)}%`;
+      }
+      // Commit together so failed or cancelled requests never leave a partial translation.
+      for (const [node, translated] of results) node.textContent = translated;
+      for (const { element } of this.roots) {
+        element.lang = options.targetLanguage;
+        element.dir = options.targetLanguage === 'ar' || options.targetLanguage === 'he' ? 'rtl' : 'ltr';
+      }
+      const language = this.select.selectedOptions[0].textContent;
+      this.status.textContent = `Reading in ${language}. AI translations may contain errors.`;
+    } catch {
+      if (generation === this.generation) this.status.textContent = 'Translation could not finish. Your current text is unchanged. Please try again or choose another language.';
+    } finally {
+      if (generation === this.generation) {
+        this.session?.destroy();
+        this.session = undefined;
+        this.busy = false;
+        this.select.disabled = this.translateButton.disabled = false;
+        this.translateButton.textContent = 'Translate ↗';
+        this.restoreButton.textContent = 'Show original';
+        this.removeAttribute('aria-busy');
+      }
+    }
+  }
+
+  private restore() {
+    ++this.generation;
+    this.session?.destroy();
+    this.session = undefined;
+    this.busy = false;
+    for (const [node, original] of this.originals) node.textContent = original;
+    for (const { element, lang, dir } of this.roots) {
+      if (lang === null) element.removeAttribute('lang'); else element.setAttribute('lang', lang);
+      if (dir === null) element.removeAttribute('dir'); else element.setAttribute('dir', dir);
+    }
+    this.select.disabled = false;
+    this.translateButton.disabled = this.select.value === 'en';
+    this.translateButton.textContent = 'Translate ↗';
+    this.restoreButton.hidden = true;
+    this.restoreButton.textContent = 'Show original';
+    this.removeAttribute('aria-busy');
+    this.status.textContent = 'Showing the original English articles.';
+  }
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
