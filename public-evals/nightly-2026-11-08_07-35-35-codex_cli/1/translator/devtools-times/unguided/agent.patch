+}
+.translation-bar {
+  margin: 20px 24px 4px;
+  padding: 20px 24px 14px;
+  border: 1px solid #e3dfd4;
+  border-radius: 8px;
+  background: #f8f7f2;
+  color: #242b28;
+  font-family: Arial, sans-serif;
+}
+.translation-main, .translation-intro, .translation-actions,
+.translation-footer, .translation-meta, .translation-private {
+  display: flex;
+  align-items: center;
+}
+.translation-main { justify-content: space-between; gap: 20px; }
+.translation-intro { gap: 14px; }
+.translation-icon {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  flex-shrink: 0;
+  border: 1px solid #dcded2;
+  border-radius: 50%;
+  color: #436044;
+  background: #eeefe5;
+}
+.translation-icon svg { width: 24px; height: 24px; }
+.translation-heading { font-family: "Grenze", serif; font-size: 23px; line-height: 1.2; }
+.translation-heading span { color: #56704d; }
+.translation-description { margin-top: 5px; font-size: 12px; color: #71746a; line-height: 1.5; }
+.translation-actions { gap: 10px; flex-shrink: 0; }
+.translation-source { display: flex; align-items: center; gap: 10px; color: #72766d; font-size: 12px; }
+.translation-source svg { width: 14px; height: 14px; }
+.translation-actions select {
+  width: 154px;
+  height: 40px;
+  border: 1px solid #d7d9d0;
+  border-radius: 5px;
+  padding: 0 8px;
+  background: white;
+  font-size: 12px;
+  color: #343e33;
+}
+.translation-submit {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  height: 40px;
+  padding: 0 15px;
+  border: 1px solid #334d37;
+  border-radius: 5px;
+  background: #334d37;
+  color: white;
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+}
+.translation-submit svg, .translation-private svg { width: 15px; height: 15px; flex-shrink: 0; }
+.translation-submit:hover:enabled { background: #253f2a; }
+.translation-submit:disabled { opacity: .55; cursor: default; }
+.translation-bar :is(button, select):focus-visible { outline: 2px solid #55764c; outline-offset: 3px; }
+.translation-footer { justify-content: space-between; align-items: flex-start; gap: 14px; border-top: 1px solid #e5e4da; margin-top: 16px; padding-top: 11px; }
+.translation-status { font-size: 11px; color: #73766c; line-height: 1.6; }
+.translation-error { color: #9c3e24; }
+.translation-meta { gap: 16px; flex-shrink: 0; }
+.translation-private { gap: 5px; font-size: 10px; letter-spacing: .02em; color: #69765f; white-space: nowrap; }
+.translation-restore { font-size: 11px; color: #405e3c; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
+@media (max-width: 1050px) {
+  .translation-main { align-items: flex-start; flex-direction: column; gap: 18px; }
+  .translation-actions { padding-left: 58px; }
+}
+@media (max-width: 600px) {
+  .translation-bar { margin: 16px 16px 4px; padding: 16px; }
+  .translation-heading { font-size: 21px; }
+  .translation-description { font-size: 11px; }
+  .translation-actions { padding-left: 0; width: 100%; gap: 8px; }
+  .translation-source { font-size: 11px; gap: 6px; }
+  .translation-actions select { flex: 1; min-width: 0; width: 100px; }
+  .translation-submit { padding: 0 10px; }
+  .translation-footer { flex-direction: column; gap: 9px; }
+  .translation-meta { width: 100%; justify-content: space-between; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .translation-submit .animate-spin { animation: none; }
+}
