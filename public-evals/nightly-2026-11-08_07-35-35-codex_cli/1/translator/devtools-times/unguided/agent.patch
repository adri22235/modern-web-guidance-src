diff --git a/src/components/TranslationControl.tsx b/src/components/TranslationControl.tsx
new file mode 100644
index 0000000..2f6ce70
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,184 @@
+import { useEffect, useRef, useState } from 'react';
+import { LanguageIcon, ArrowRightIcon, ShieldCheckIcon, ArrowPathIcon } from '@heroicons/react/24/outline';
+
+interface LocalTranslator {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+}
+interface TranslatorAPI {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<string>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<LocalTranslator>;
+}
+
+type Original = { node: Text; text: string };
+const languages = [
+  ['es', 'Español', 'Spanish'], ['fr', 'Français', 'French'],
+  ['de', 'Deutsch', 'German'], ['it', 'Italiano', 'Italian'],
+  ['pt', 'Português', 'Portuguese'], ['ja', '日本語', 'Japanese'],
+  ['ko', '한국어', 'Korean'], ['zh', '中文', 'Chinese'],
+  ['ar', 'العربية', 'Arabic'], ['hi', 'हिन्दी', 'Hindi'],
+];
+
+function captureOriginals(): Original[] {
+  const originals: Original[] = [];
+  document.querySelectorAll<HTMLElement>('[data-translate]').forEach(root => {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        return node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, [translate="no"]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      },
+    });
+    while (walker.nextNode()) {
+      originals.push({ node: walker.currentNode as Text, text: walker.currentNode.textContent! });
+    }
+  });
+  return originals;
+}
+
+export default function TranslationControl() {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [target, setTarget] = useState('es');
+  const [active, setActive] = useState('en');
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('Text stays on your device. First use may download a language pack.');
+  const [error, setError] = useState(false);
+  const originals = useRef<Original[]>([]);
+  const instance = useRef<LocalTranslator | null>(null);
+  const generation = useRef(0);
+
+  useEffect(() => {
+    const available = window.isSecureContext && 'Translator' in window;
+    setSupported(available);
+    if (!available) setMessage('On-device translation isn’t available here. Try a desktop browser with the Translator API, such as Chrome.');
+    const cleanup = () => {
+      generation.current++;
+      instance.current?.destroy();
+      instance.current = null;
+    };
+    document.addEventListener('astro:before-swap', cleanup);
+    return () => {
+      cleanup();
+      document.removeEventListener('astro:before-swap', cleanup);
+    };
+  }, []);
+
+  function restore() {
+    generation.current++;
+    instance.current?.destroy();
+    instance.current = null;
+    originals.current.forEach(({ node, text }) => { node.textContent = text; });
+    document.querySelectorAll('[data-translate]').forEach(root => {
+      root.setAttribute('lang', 'en');
+      root.removeAttribute('dir');
+    });
+    setActive('en');
+    setBusy(false);
+    setError(false);
+    setMessage('You’re reading the original English edition.');
+  }
+
+  async function translate() {
+    const api = (window as unknown as { Translator?: TranslatorAPI }).Translator;
+    if (!api || busy) return;
+    const run = ++generation.current;
+    const current = () => generation.current === run;
+    const name = languages.find(([code]) => code === target)![2];
+    setBusy(true);
+    setError(false);
+    setMessage('Checking language availability…');
+    let translator: LocalTranslator | null = null;
+    try {
+      const options = { sourceLanguage: 'en', targetLanguage: target };
+      const availability = await api.availability(options);
+      if (!current()) return;
+      if (availability === 'unavailable') throw new Error('unsupported-language');
+      setMessage(availability === 'available' ? 'Preparing translation…' : 'Downloading language pack. This may take a moment…');
+      translator = await api.create({
+        ...options,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            const progress = event as ProgressEvent;
+            if (current()) setMessage(`Downloading language pack… ${Math.round(progress.loaded * 100)}%`);
+          });
+        },
+      });
+      if (!current()) return;
+      instance.current = translator;
+      if (!originals.current.length) originals.current = captureOriginals();
+      if (!originals.current.length) {
+        setMessage('Open a news article or the home page to translate stories.');
+        return;
+      }
+      // Stage every result before changing the page, so failures leave it readable.
+      const results: string[] = [];
+      const cache = new Map<string, string>();
+      for (const { text } of originals.current) {
+        if (!current()) return;
+        let result = cache.get(text);
+        if (result === undefined) {
+          result = await translator.translate(text.trim());
+          cache.set(text, result);
+        }
+        results.push(`${text.match(/^\s*/)?.[0] ?? ''}${result}${text.match(/\s*$/)?.[0] ?? ''}`);
+        if (current()) setMessage(`Translating stories… ${Math.round(results.length / originals.current.length * 100)}%`);
+      }
+      if (!current()) return;
+      originals.current.forEach(({ node }, index) => { node.textContent = results[index]; });
+      document.querySelectorAll('[data-translate]').forEach(root => {
+        root.setAttribute('lang', target);
+        root.setAttribute('dir', target === 'ar' ? 'rtl' : 'ltr');
+      });
+      setActive(target);
+      setMessage(`You’re reading in ${name}. AI translations may contain errors.`);
+    } catch (cause) {
+      if (!current()) return;
+      setError(true);
+      setMessage(cause instanceof Error && cause.message === 'unsupported-language'
+        ? 'This language isn’t supported on your device. Choose another language.'
+        : 'Translation couldn’t finish. Check your connection for the language download, then try again.');
+    } finally {
+      translator?.destroy();
+      if (current()) {
+        instance.current = null;
+        setBusy(false);
+      }
+    }
+  }
+
+  return (
+    <section className="translation-bar" aria-label="Article translation">
+      <div className="translation-main">
+        <div className="translation-intro">
+          <span className="translation-icon"><LanguageIcon aria-hidden="true" /></span>
+          <div>
+            <div className="translation-heading">A world of stories. <span>Your language.</span></div>
+            <p className="translation-description">Read The DevTools Times in a language that feels like home.</p>
+          </div>
+        </div>
+        <div className="translation-actions">
+          <span className="translation-source">English <ArrowRightIcon aria-hidden="true" /></span>
+          <label className="sr-only" htmlFor="translation-language">Translate into</label>
+          <select id="translation-language" value={target} disabled={busy} onChange={event => setTarget(event.target.value)}>
+            {languages.map(([code, label, name]) => <option key={code} value={code}>{label} · {name}</option>)}
+          </select>
+          <button className="translation-submit" onClick={translate} disabled={supported !== true || busy || active === target}>
+            {busy ? <ArrowPathIcon className="animate-spin" aria-hidden="true" /> : <LanguageIcon aria-hidden="true" />}
+            {busy ? 'Translating…' : active === target ? 'Translated' : 'Translate'}
+          </button>
+        </div>
+      </div>
+      <div className="translation-footer">
+        <p className={`translation-status${error ? ' translation-error' : ''}`} role="status" aria-live="polite" aria-atomic="true">{message}</p>
+        <div className="translation-meta">
+          {(active !== 'en' || busy) && <button className="translation-restore" onClick={restore}>{busy ? 'Cancel' : 'Show original'}</button>}
+          <span className="translation-private"><ShieldCheckIcon aria-hidden="true" /> On-device · Private</span>
+        </div>
+      </div>
+      <noscript>Enable JavaScript to use on-device article translation.</noscript>
+    </section>
+  );
+}
