diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,122 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .latte-actions {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .latte-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      display: inline-grid;
+      place-items: center;
+      width: 32px;
+      height: 32px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #maple-tooltip {
+      width: min(270px, calc(100vw - 32px));
+      padding: 8px;
+      border: 0;
+      background: transparent;
+      color: white;
+      overflow: visible;
+      text-align: start;
+      font-size: 0.9rem;
+    }
+
+    .tooltip-content {
+      position: relative;
+      padding: 12px 16px;
+      border-radius: 10px;
+      background: var(--primary);
+      box-shadow: 0 3px 12px rgb(0 0 0 / 18%);
+    }
+
+    /* Keep the information readable when native popovers are unavailable. */
+    @supports not selector(:popover-open) {
+      .info-button {
+        display: none;
+      }
+
+      #maple-tooltip {
+        margin: 8px auto 0;
+      }
+    }
+
+    @supports (anchor-name: --maple-info) {
+      #anchor {
+        anchor-name: --maple-info;
+      }
+
+      #maple-tooltip {
+        position: fixed;
+        position-anchor: --maple-info;
+        inset: auto;
+        margin: 0;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+      }
+
+      @supports (container-type: anchored) {
+        #maple-tooltip {
+          container-type: anchored;
+          container-name: maple-tooltip;
+        }
+
+        .tooltip-content {
+          margin-block: 0 4px;
+          border-radius: 10px 10px 6px 6px;
+        }
+
+        .tooltip-content::before {
+          content: "";
+          position: absolute;
+          inset-inline-start: calc(50% - 7px);
+          inset-block-start: 100%;
+          border: 7px solid transparent;
+          border-block-start-color: var(--primary);
+        }
+
+        @container maple-tooltip anchored(fallback: flip-block) {
+          .tooltip-content {
+            margin-block: 4px 0;
+            border-radius: 6px 6px 10px 10px;
+          }
+
+          .tooltip-content::before {
+            inset-block-start: auto;
+            inset-block-end: 100%;
+            border-block-start-color: transparent;
+            border-block-end-color: var(--primary);
+          }
+        }
+      }
+    }
+
     footer {
