     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      anchor-name: --maple-info;
+      display: inline-grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      border: 1px solid var(--secondary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1.1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #maple-tooltip {
+      position: fixed;
+      width: min(17rem, calc(100vw - 2rem));
+      padding: 0;
+      border: 0;
+      background: transparent;
+      color: white;
+      overflow: visible;
+      container-type: anchored;
+    }
+
+    @supports (position-area: top) {
+      #maple-tooltip {
+        position-anchor: --maple-info;
+        position-area: top;
+        position-try-fallbacks: flip-block;
+        inset: auto;
+        margin: 0;
+      }
+    }
+
+    /* Style the child: a container cannot query and restyle itself. */
+    .tooltip-content {
+      position: relative;
+      margin: 0 0 12px;
+      padding: 14px 16px;
+      border-radius: 10px 10px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 14px rgb(62 39 35 / 20%);
+      font-size: 0.9rem;
+      text-align: left;
+    }
+
+    /* Only show a directional arrow when its flipped state can be queried. */
+    @supports (container-type: anchored) {
+      .tooltip-content::after {
+        content: "";
+        position: absolute;
+        top: 100%;
+        left: 50%;
+        transform: translateX(-50%);
+        border: 7px solid transparent;
+        border-bottom-width: 0;
+        border-top-color: var(--primary);
+      }
+    }
+
+    @container anchored(fallback: flip-block) {
+      .tooltip-content {
+        margin: 12px 0 0;
+        border-radius: 4px 4px 10px 10px;
+      }
+
+      .tooltip-content::after {
+        top: auto;
+        bottom: 100%;
+        border-top: 0;
+        border-bottom: 7px solid var(--primary);
+      }
+    }
+
