+// Reuse with <favorite-toggle drink-name="Drink name" favorite></favorite-toggle>.
+// The optional boolean `favorite` attribute and property set the initial/current state.
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['drink-name', 'favorite'];
+
+  #button;
+  #icon;
+  #status;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host {
+          display: block;
+          margin-top: 12px;
+        }
+
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 16px;
+          border: 1px solid var(--primary, #4e342e);
+          border-radius: 5px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+
+        button:hover {
+          background: var(--secondary, #d7ccc8);
+        }
+
+        button[aria-pressed="true"] {
+          background: var(--primary, #4e342e);
+          color: white;
+        }
+
+        button:focus-visible {
+          outline: 3px solid var(--primary, #4e342e);
+          outline-offset: 3px;
+        }
+      </style>
+      <button type="button" aria-pressed="false">
+        <span class="icon" aria-hidden="true">♡</span>
+        <span>Favorite</span>
+        <span class="status" aria-hidden="true">Off</span>
+      </button>
+    `;
+    this.#button = root.querySelector('button');
+    this.#icon = root.querySelector('.icon');
+    this.#status = root.querySelector('.status');
+    this.#button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      this.dispatchEvent(new CustomEvent('change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkName: this.drinkName, favorite: this.favorite },
+      }));
+    });
+  }
+
+  get drinkName() {
+    return this.getAttribute('drink-name') ?? '';
+  }
+
+  set drinkName(value) {
+    this.setAttribute('drink-name', value);
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  #render() {
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+    // Keep the accessible name stable; aria-pressed announces the changing state.
+    this.#button.setAttribute('aria-label', `Favorite ${this.drinkName}`.trim());
+    this.#icon.textContent = this.favorite ? '♥' : '♡';
+    this.#status.textContent = this.favorite ? 'On' : 'Off';
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
