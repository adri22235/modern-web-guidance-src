+import { createHash } from 'node:crypto';
+import { lookup, resolveTxt } from 'node:dns/promises';
+import { get } from 'node:https';
+import ipaddr from 'ipaddr.js';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const ALGORITHMS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalize = (algorithm) => algorithm === 'Ed25519' ? 'EdDSA' : algorithm;
+const hasher = (data, algorithm) => {
+  if (algorithm !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+
+// DNS delegation alone does not make an issuer safe to fetch. Pin a public
+// address to the TLS request to prevent SSRF and DNS rebinding; reject redirects.
+async function publicJson(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.port || url.username || url.password || url.hash) {
+    throw new Error('Invalid issuer URL');
+  }
+  const addresses = await lookup(url.hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) {
+    throw new Error('Issuer must use public addresses');
+  }
+  return new Promise((resolve, reject) => {
+    const request = get(url, {
+      headers: { Accept: 'application/json' },
+      lookup: (_host, options, callback) => {
+        const selected = addresses[0];
+        if (options.all) callback(null, [selected]);
+        else callback(null, selected.address, selected.family);
+      },
+    }, (response) => {
+      if (response.statusCode !== 200) {
+        response.resume();
+        reject(new Error('Issuer discovery failed'));
+        return;
+      }
+      let length = 0;
+      const chunks = [];
+      response.on('data', (chunk) => {
+        length += chunk.length;
+        if (length > 131072) response.destroy(new Error('Issuer response too large'));
+        else chunks.push(chunk);
+      });
+      response.on('error', reject);
+      response.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch (error) { reject(error); }
+      });
+    });
+    const timer = setTimeout(() => request.destroy(new Error('Issuer timeout')), 5000);
+    request.on('close', () => clearTimeout(timer));
+    request.on('error', reject);
+  });
+}
+
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }) {
+  if (!expectedNonce || !rawToken || rawToken.length > 24576) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const claims = decoded.jwt.payload;
+  const issuer = claims.iss;
+  if (!decoded.kbJwt || claims.email_verified !== true || typeof claims.email !== 'string' ||
+      claims.email.toLowerCase() !== submittedEmail.toLowerCase() || typeof issuer !== 'string') {
+    throw new Error('Invalid email claims');
+  }
+  const issuerUrl = new URL(issuer);
+  if (issuerUrl.protocol !== 'https:' || issuerUrl.origin !== issuer || issuerUrl.port ||
+      issuerUrl.username || issuerUrl.password) throw new Error('Invalid issuer origin');
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  const records = await resolveTxt(`_email-verification.${domain}`);
+  if (!records.some((parts) => {
+    const record = parts.join('');
+    return record.startsWith('iss=') && `https://${record.slice(4).trim()}` === issuer;
+  })) throw new Error('Issuer is not delegated by email domain');
+
+  const metadata = await publicJson(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid issuer metadata');
+  const jwks = createLocalJWKSet(await publicJson(metadata.jwks_uri));
+  const issuerOptions = {
+    typ: 'ev+sd-jwt', issuer, algorithms: ALGORITHMS,
+    requiredClaims: ['iat', 'exp', 'email', 'email_verified', 'cnf'],
+    maxTokenAge: '5m', clockTolerance: 60,
+  };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, signature) => {
+      const jwt = `${data}.${signature}`;
+      try { await jwtVerify(jwt, jwks, issuerOptions); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let matched = false;
+        for await (const key of error) {
+          try { await jwtVerify(jwt, key, issuerOptions); matched = true; break; }
+          catch { /* Try the next issuer key when no kid was supplied. */ }
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature) => {
+      const jwk = claims.cnf?.jwk;
+      const algorithm = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || !ALGORITHMS.includes(jwk.alg) || !ALGORITHMS.includes(algorithm) ||
+          normalize(jwk.alg) !== normalize(algorithm) ||
+          (algorithm !== 'ES256' && jwk.crv !== 'Ed25519')) throw new Error('Invalid holder key');
+      const key = await importJWK(jwk, algorithm);
+      await jwtVerify(`${data}.${signature}`, key, {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [algorithm],
+        requiredClaims: ['iat', 'aud', 'nonce', 'sd_hash'],
+        maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+}
