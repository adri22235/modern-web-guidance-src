new file mode 100644
index 0000000..b2535b2
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,165 @@
+import { createServer } from 'node:http';
+import { randomBytes, randomUUID, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { readFile, mkdir } from 'node:fs/promises';
+import { DatabaseSync } from 'node:sqlite';
+import { verifyEmailVerificationToken } from './lib/verify-email.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.PUBLIC_ORIGIN || `http://localhost:${port}`).origin;
+if (!origin.startsWith('https://') && !/^http:\/\/(localhost|127\.0\.0\.1)(:|$)/.test(origin)) {
+  throw new Error('PUBLIC_ORIGIN must use HTTPS outside localhost');
+}
+const secure = origin.startsWith('https://');
+const cookieName = secure ? '__Host-dg-signup' : 'dg-signup';
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const signupScript = await readFile(new URL('./signup.js', import.meta.url), 'utf8');
+await mkdir(new URL('./data/', import.meta.url), { recursive: true, mode: 0o700 });
+const db = new DatabaseSync(new URL('./data/rewards.sqlite', import.meta.url).pathname);
+db.exec(`PRAGMA journal_mode=WAL;
+  CREATE TABLE IF NOT EXISTS signup_sessions (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+  CREATE TABLE IF NOT EXISTS rewards_accounts (
+    id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL,
+    email_key TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL,
+    marketing INTEGER NOT NULL, email_verified_at INTEGER NOT NULL
+  );`);
+const deriveKey = promisify(scrypt);
+const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({
+  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
+})[char]);
+
+function sessionId(request) {
+  return request.headers.cookie?.split(';').map((part) => part.trim())
+    .find((part) => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1) || '';
+}
+
+function render(request, response, { status = 200, message = '', success = false, name = '', email = '' } = {}) {
+  const now = Date.now();
+  db.prepare('DELETE FROM signup_sessions WHERE expires < ?').run(now);
+  db.prepare('DELETE FROM signup_sessions WHERE id = ?').run(sessionId(request));
+  // Bound persistent anonymous state in this single-instance application.
+  db.prepare('DELETE FROM signup_sessions WHERE id IN (SELECT id FROM signup_sessions ORDER BY expires DESC LIMIT -1 OFFSET 10000)').run();
+  const id = randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  db.prepare('INSERT INTO signup_sessions VALUES (?, ?, ?)').run(id, nonce, now + 600000);
+  response.writeHead(status, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+    'Set-Cookie': `${cookieName}=${id}; Path=/; HttpOnly; SameSite=Lax; Max-Age=600${secure ? '; Secure' : ''}`,
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Content-Security-Policy': "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+    ...(process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL ? { 'Origin-Trial': process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL } : {}),
+  });
+  const notice = message ? `<div class="form-message ${success ? 'is-success' : 'is-error'}" role="${success ? 'status' : 'alert'}" tabindex="-1" autofocus>${escapeHtml(message)}</div>` : '';
+  response.end(template.replace('<!-- SIGNUP_MESSAGE -->', notice)
+    .replace('__SIGNUP_NONCE__', nonce)
+    .replace('__SIGNUP_NAME__', escapeHtml(name))
+    .replace('__SIGNUP_EMAIL__', escapeHtml(email)));
+}
+
+async function readForm(request) {
+  if (!request.headers['content-type']?.startsWith('application/x-www-form-urlencoded')) {
+    throw Object.assign(new Error('Please submit the signup form again.'), { status: 415 });
+  }
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > 40000) throw Object.assign(new Error('The form is too large. Please try again.'), { status: 413 });
+    chunks.push(chunk);
+  }
+  const form = new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+  for (const key of form.keys()) {
+    if (form.getAll(key).length !== 1) throw Object.assign(new Error('Please submit the form again.'), { status: 400 });
+  }
+  return form;
+}
+
+// Small per-address limiter; do not trust forwarded IP headers from arbitrary clients.
+const attempts = new Map();
+function limited(request) {
+  const now = Date.now();
+  for (const [key, entry] of attempts) if (entry.until < now) attempts.delete(key);
+  const address = request.socket.remoteAddress;
+  const entry = attempts.get(address) || { count: 0, until: now + 60000 };
+  entry.count += 1;
+  attempts.set(address, entry);
+  return entry.count > 30;
+}
+
+const server = createServer(async (request, response) => {
+  try {
+    const path = new URL(request.url, origin).pathname;
+    if (limited(request)) {
+      response.writeHead(429, { 'Retry-After': '60', 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
+      response.end('Too many requests. Please try again in one minute.');
+      return;
+    }
+    if (request.method === 'GET' && path === '/') return render(request, response);
+    if (request.method === 'GET' && path === '/signup.js') {
+      response.writeHead(200, { 'Content-Type': 'text/javascript; charset=utf-8', 'X-Content-Type-Options': 'nosniff' });
+      response.end(signupScript);
+      return;
+    }
+    if (path !== '/api/verify-email') {
+      response.writeHead(404, { 'Content-Type': 'text/plain' });
+      response.end('Page not found.');
+      return;
+    }
+    if (request.method !== 'POST') {
+      response.writeHead(405, { Allow: 'POST' });
+      response.end();
+      return;
+    }
+    // Atomic DELETE RETURNING consumes the session even on failed submissions.
+    const session = db.prepare('DELETE FROM signup_sessions WHERE id = ? RETURNING nonce, expires')
+      .get(sessionId(request));
+    if (request.headers.origin !== origin || request.headers['sec-fetch-site'] === 'cross-site') {
+      return render(request, response, { status: 403, message: 'Please sign up from the Daily Grind homepage.' });
+    }
+    if (!session || session.expires < Date.now()) {
+      return render(request, response, { status: 400, message: 'Your signup session expired. Please try again below.' });
+    }
+    const form = await readForm(request);
+    const name = (form.get('name') || '').trim();
+    const email = (form.get('email') || '').trim();
+    const password = form.get('password') || '';
+    const retry = (status, message) => render(request, response, { status, message, name, email });
+    if (!name || name.length > 100 || email.length > 254 ||
+        !/^[^\s@]+@[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$/.test(email) ||
+        password.length < 12 || password.length > 128) {
+      return retry(400, 'Enter your name, a valid email address, and a password with 12–128 characters.');
+    }
+    const rawToken = (form.get('token') || '').trim();
+    if (!rawToken) {
+      return retry(422, 'Your browser could not confirm this email. Try a supported browser while signed in to your email provider, then submit again. No verification email has been sent.');
+    }
+    try {
+      await verifyEmailVerificationToken({ rawToken, submittedEmail: email, expectedNonce: session.nonce, expectedAudience: origin });
+    } catch {
+      // Never log tokens, passwords, or email addresses.
+      console.warn('Email verification rejected');
+      return retry(422, 'We could not verify your email securely. Please check your email provider is signed in and try again. No account was created or verification email sent.');
+    }
+    const salt = randomBytes(16).toString('hex');
+    const hash = await deriveKey(password, salt, 64);
+    const result = db.prepare(`INSERT INTO rewards_accounts
+      (id, name, email, email_key, password_hash, marketing, email_verified_at)
+      VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT(email_key) DO NOTHING`)
+      .run(randomUUID(), name, email, email.toLowerCase(), `${salt}:${hash.toString('hex')}`,
+        form.get('marketing') === 'on' ? 1 : 0, Date.now());
+    if (!result.changes) return retry(409, 'A rewards account already exists for your verified email address.');
+    return render(request, response, { success: true, message: 'Welcome to the Grind! Your email is verified and your rewards account is ready. No code, no inbox detour.' });
+  } catch (error) {
+    console.error('Signup request failed', error.status || 500);
+    if (!response.headersSent) render(request, response, {
+      status: error.status || 500,
+      message: error.status ? error.message : 'We could not complete your signup. Please try again shortly.',
+    });
+    else response.end();
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
