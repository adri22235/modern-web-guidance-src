+// This app runs directly on Node; build checks syntax without importing its entrypoint.
+import { spawnSync } from 'node:child_process';
+for (const path of ['server/index.mjs', 'server/app.mjs', 'server/verification.mjs', 'server/accounts.mjs', 'public/app.js']) {
+  const check = spawnSync(process.execPath, ['--check', path], { stdio: 'inherit' });
+  if (check.status !== 0) process.exit(check.status || 1);
+}
+console.log('Build checks passed. No compilation required.');
diff --git a/server/accounts.mjs b/server/accounts.mjs
new file mode 100644
index 0000000..b3a6156
--- /dev/null
+++ b/server/accounts.mjs
@@ -0,0 +1,36 @@
+import { mkdir, readFile, writeFile, rename } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import { randomBytes, randomUUID, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+const deriveKey = promisify(scrypt);
+
+// Single-process durable storage. Writes are serialized and committed by atomic rename.
+export class AccountStore {
+  #queue = Promise.resolve();
+  constructor(path) { this.path = path; }
+  async create({ firstName, lastName, email, password, marketing }) {
+    const operation = this.#queue.then(async () => {
+      let accounts;
+      try { accounts = JSON.parse(await readFile(this.path, 'utf8')); }
+      catch (error) { if (error.code !== 'ENOENT') throw error; accounts = []; }
+      if (accounts.some((account) => account.email.toLowerCase() === email.toLowerCase())) {
+        return { created: false };
+      }
+      const salt = randomBytes(16).toString('hex');
+      const key = await deriveKey(password, salt, 64, { N: 32768, r: 8, p: 1, maxmem: 64 * 1024 * 1024 });
+      const account = {
+        id: randomUUID(), firstName, lastName, email, emailVerified: true,
+        passwordHash: `scrypt:32768:8:1:${salt}:${key.toString('hex')}`,
+        marketing, points: 0, createdAt: new Date().toISOString(),
+      };
+      accounts.push(account);
+      await mkdir(dirname(this.path), { recursive: true, mode: 0o700 });
+      const temporary = `${this.path}.tmp`;
+      await writeFile(temporary, JSON.stringify(accounts, null, 2), { mode: 0o600 });
+      await rename(temporary, this.path);
+      return { created: true, id: account.id };
+    });
+    this.#queue = operation.catch(() => {});
+    return operation;
+  }
+}
