+
+export function createApp({ template, origin, verifyToken, accounts, trialToken = '', now = Date.now }) {
+  const originURL = new URL(origin);
+  if (originURL.origin !== origin || !['http:', 'https:'].includes(originURL.protocol)) throw new Error('APP_ORIGIN must be an origin without a path');
+  if (originURL.protocol !== 'https:' && !['localhost', '127.0.0.1', '[::1]'].includes(originURL.hostname)) throw new Error('HTTPS is required outside localhost');
+  const secure = originURL.protocol === 'https:';
+  const sessions = new Map();
+  const attempts = new Map();
+  const headers = {
+    'Cache-Control': 'no-store', 'Content-Type': 'text/html; charset=utf-8',
+    'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Content-Security-Policy': "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
+    ...(trialToken ? { 'Origin-Trial': trialToken } : {}),
+  };
+  function clean() {
+    for (const [id, session] of sessions) if (session.expires <= now()) sessions.delete(id);
+    for (const [id, attempt] of attempts) if (attempt.expires <= now()) attempts.delete(id);
+  }
+  function issueForm(request, notice = '', success = false, fields = {}) {
+    clean();
+    let sessionID = cookieValue(request, 'dg_session');
+    let session = sessions.get(sessionID);
+    if (!session) {
+      if (sessions.size >= 10000) sessions.delete(sessions.keys().next().value);
+      sessionID = randomBytes(32).toString('base64url');
+      session = { forms: new Map(), expires: now() + MAX_AGE };
+      sessions.set(sessionID, session);
