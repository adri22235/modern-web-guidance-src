+// Only trusted static markup enters templates; consumer content stays in slots.
+const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--accent, #ffab40); outline-offset: 4px;
+  }
+`;
+const actionStyles = `
+  ::slotted(a[slot="action"]) {
+    display: inline-block; background: var(--primary, #4e342e); color: white;
+    padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 15px;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+`;
+function template(markup, styles) {
+  const element = document.createElement('template');
+  element.innerHTML = `<style>${baseStyles}${styles}</style>${markup}`;
+  return element;
+}
+const cardTemplate = template(`
+  <article part="card">
+    <slot name="title"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </article>
+`, `
+  :host { height: 100%; }
+  article {
+    height: 100%; background: var(--card-background, white); padding: 20px;
+    border-radius: 8px; box-shadow: 0 2px 5px rgb(0 0 0 / 10%); text-align: center;
+  }
+  ::slotted([slot="title"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+  ::slotted([slot="description"]) { margin: 0; }
+  ${actionStyles}
+`);
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(cardTemplate.content.cloneNode(true));
+  }
+}
+const heroTemplate = template(`
+  <header part="hero">
+    <slot name="title"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </header>
+`, `
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+      var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+    background-size: cover; background-position: center;
+    display: flex; flex-direction: column; justify-content: center; align-items: center;
+    color: white; text-align: center; padding: 40px 20px;
+  }
+  ::slotted([slot="title"]) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+  ::slotted([slot="description"]) { margin: 0; }
+  ${actionStyles}
+`);
+export class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(heroTemplate.content.cloneNode(true));
+  }
+}
+const navigationTemplate = template(`
+  <nav aria-label="Main navigation" part="navigation">
+    <div class="brand"><slot name="brand"></slot></div>
+    <button type="button" aria-expanded="false" aria-controls="links" part="toggle">Menu</button>
+    <div id="links" part="links"><slot name="links"></slot></div>
+  </nav>
+`, `
+  :host { position: sticky; top: 0; z-index: 1000; }
+  nav {
+    background: var(--primary, #4e342e); color: white; padding: 1rem 5%;
+    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;
+  }
+  .brand { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  #links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+  #links[hidden] { display: none; }
+  ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; padding-block: 8px; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted([data-outlined]) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button {
+    font: inherit; color: inherit; background: transparent;
+    border: 1px solid var(--accent, #ffab40); border-radius: 4px;
+    min-height: 44px; padding: 8px 16px; cursor: pointer;
+  }
+  button[hidden] { display: none; }
+  @media (max-width: 48rem) {
+    #links { flex-basis: 100%; align-items: stretch; flex-direction: column; gap: 8px; }
+  }
+`);
+export class GrindNavigation extends HTMLElement {
+  #listeners;
+  #media;
+  #button;
+  #links;
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(navigationTemplate.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('#links');
+  }
+  connectedCallback() {
+    // Reconnecting an instance must not accumulate listeners.
+    this.#listeners?.abort();
+    this.#listeners = new AbortController();
+    const options = { signal: this.#listeners.signal };
+    this.#media = window.matchMedia('(max-width: 48rem)');
+    this.#syncLayout();
+    this.#media.addEventListener('change', () => this.#syncLayout(), options);
+    this.#button.addEventListener('click', () => {
+      this.#setExpanded(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, options);
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        event.preventDefault();
+        this.#setExpanded(false);
+        this.#button.focus();
+      }
+    }, options);
+    this.addEventListener('click', (event) => {
+      if (this.#media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.#setExpanded(false);
+        this.#button.focus();
+      }
+    }, options);
+  }
+  disconnectedCallback() { this.#listeners?.abort(); }
+  #syncLayout() {
+    const focusedToggle = this.shadowRoot.activeElement === this.#button;
+    const focusedLink = this.#links.querySelector('slot').assignedElements()
+      .includes(document.activeElement);
+    this.#button.hidden = !this.#media.matches;
+    this.#setExpanded(!this.#media.matches);
+    if (this.#media.matches && focusedLink) this.#button.focus();
+    // A breakpoint change must not leave focus on a now-hidden toggle.
+    if (!this.#media.matches && focusedToggle) {
+      this.#links.querySelector('slot').assignedElements()[0]?.focus();
+    }
+  }
+  #setExpanded(expanded) {
+    this.#button.setAttribute('aria-expanded', String(expanded));
+    this.#links.hidden = !expanded;
+  }
+}
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard], ['coffee-hero', CoffeeHero], ['grind-navigation', GrindNavigation],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
