@@ -0,0 +1,119 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { Window } from 'happy-dom';
+
+const source = await readFile(new URL('../components/daily-grind.js', import.meta.url), 'utf8');
+const homepage = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+
+function setup(t, mobile = false) {
+  const window = new Window({ settings: { disableCSSFileLoading: true, disableJavaScriptFileLoading: true } });
+  t.after(() => window.happyDOM.abort());
+  const media = new window.EventTarget();
+  media.matches = mobile;
+  window.matchMedia = () => media;
+  window.eval(source);
+  window.document.body.innerHTML = `
+    <grind-navigation>
+      <span slot="brand">Coffee shop</span>
+      <a href="/menu">Menu</a>
+    </grind-navigation>`;
+  const navigation = window.document.querySelector('grind-navigation');
+  return {
+    window, media, navigation,
+    button: navigation.shadowRoot.querySelector('button'),
+    links: navigation.shadowRoot.querySelector('#links'),
+  };
+}
+
+test('mobile navigation exposes a native disclosure and closes with Escape', t => {
+  const { window, navigation, button, links } = setup(t, true);
+  assert.equal(button.type, 'button');
+  assert.equal(button.getAttribute('aria-controls'), links.id);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(links.hidden, true);
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  assert.equal(links.hidden, false);
+  const link = navigation.querySelector('a');
+  link.focus();
+  link.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true, composed: true }));
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(links.hidden, true);
+  assert.equal(navigation.shadowRoot.activeElement, button);
+});
+
+test('desktop links stay visible and responsive changes reset the disclosure', t => {
+  const { window, media, button, links } = setup(t);
+  assert.equal(links.hidden, false);
+  media.matches = true;
+  media.dispatchEvent(new window.Event('change'));
+  assert.equal(links.hidden, true);
+  button.click();
+  media.matches = false;
+  media.dispatchEvent(new window.Event('change'));
+  assert.equal(links.hidden, false);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+});
+
+test('choosing a native link closes the mobile navigation', t => {
+  const { window, navigation, button, links } = setup(t, true);
+  button.click();
+  navigation.querySelector('a').addEventListener('click', event => event.preventDefault());
+  navigation.querySelector('a').dispatchEvent(new window.MouseEvent('click', { bubbles: true, composed: true, cancelable: true }));
+  assert.equal(links.hidden, true);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+});
+
+test('navigation removes listeners on disconnect and reconnects without duplicate toggles', t => {
+  const { window, media, navigation, button, links } = setup(t, true);
+  navigation.remove();
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  media.matches = false;
+  media.dispatchEvent(new window.Event('change'));
+  assert.equal(links.hidden, true);
+  media.matches = true;
+  window.document.body.append(navigation);
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  assert.equal(links.hidden, false);
+});
+
+test('homepage upgrades all components while retaining authored content and destinations', t => {
+  const { window } = setup(t);
+  window.document.documentElement.innerHTML = homepage.replace(/<!DOCTYPE html>/i, '').replace(/<\/?html[^>]*>/gi, '');
+  const { document } = window;
+  for (const name of ['grind-navigation', 'coffee-hero', 'coffee-card', 'grind-footer']) {
+    for (const element of document.querySelectorAll(name)) {
+      assert.ok(element.shadowRoot.querySelector('style'));
+    }
+  }
+  assert.equal(document.querySelectorAll('h1').length, 1);
+  assert.ok(document.querySelector(document.querySelector('.skip-link').getAttribute('href')));
+  const cards = [...document.querySelectorAll('coffee-card')];
+  assert.equal(cards.length, 3);
+  assert.deepEqual(cards.map(card => card.querySelector('a').getAttribute('href')), [
+    '/menu/seasonal', '/menu/espresso', '/menu/cold-brew',
+  ]);
+  for (const card of cards) {
+    const title = card.querySelector('h3').textContent;
+    assert.ok(card.querySelector('a').getAttribute('aria-label').includes(title));
+    assert.deepEqual(card.shadowRoot.querySelector('slot[name="heading"]').assignedElements(), [card.querySelector('h3')]);
+    assert.deepEqual(card.shadowRoot.querySelector('slot[name="action"]').assignedElements(), [card.querySelector('a')]);
+    assert.ok(card.shadowRoot.querySelector('article'));
+  }
+  assert.equal(document.querySelector('grind-navigation').shadowRoot.querySelector('nav').getAttribute('aria-label'), 'Main navigation');
+  assert.equal(document.querySelector('grind-footer').shadowRoot.querySelector('nav').getAttribute('aria-label'), 'Footer navigation');
+});
+
+test('an additional coffee card renders through slots without changing component code', t => {
+  const { window } = setup(t);
+  const card = window.document.createElement('coffee-card');
+  card.innerHTML = '<h3 slot="heading">Decaf</h3><p>A mellow cup.</p><a slot="action" href="/menu/decaf" aria-label="View details about Decaf">View Details</a>';
+  window.document.body.append(card);
+  assert.equal(card.shadowRoot.querySelector('slot').assignedElements()[0].textContent, 'Decaf');
