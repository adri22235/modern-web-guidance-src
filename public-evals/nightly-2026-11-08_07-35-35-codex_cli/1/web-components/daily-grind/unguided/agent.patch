+/** Shared styles remain inside each component's shadow root. */
+const baseStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  a:focus-visible, button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
+
+const actionStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a:hover) { background: #3e2723; }
+`;
+
+function mount(element, markup) {
+  element.attachShadow({ mode: 'open' }).innerHTML = markup;
+}
+
+/** Native links are supplied as children so destinations remain authored in HTML. */
+class GrindNavigation extends HTMLElement {
+  constructor() {
+    super();
+    mount(this, `
+      <style>
+        ${baseStyles}
+        :host { position: sticky; top: 0; z-index: 1000; }
+        nav {
+          background: var(--primary, #4e342e); color: white;
+          padding: 1rem 5%; display: flex; justify-content: space-between;
+          align-items: center; gap: 20px; flex-wrap: wrap;
+        }
+        .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+        #links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+        ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; }
+        ::slotted(a:hover) { color: var(--accent, #ffab40); }
+        ::slotted([data-outlined]) {
+          border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px;
+        }
+        button {
+          display: none; font: inherit; color: white; background: transparent;
+          border: 1px solid var(--accent, #ffab40); border-radius: 4px;
+          padding: 8px 12px; cursor: pointer;
+        }
+        @media (max-width: 700px) {
+          button { display: block; }
+          #links { width: 100%; align-items: stretch; flex-direction: column; gap: 16px; }
+          #links[hidden] { display: none; }
+        }
+      </style>
+      <nav aria-label="Main navigation">
+        <div class="logo"><slot name="brand"></slot></div>
+        <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+        <div id="links"><slot></slot></div>
+      </nav>
+    `);
+    this.button = this.shadowRoot.querySelector('button');
+    this.links = this.shadowRoot.querySelector('#links');
+    this.onToggle = () => this.setExpanded(this.button.getAttribute('aria-expanded') !== 'true');
+    this.onEscape = (event) => {
+      if (event.key === 'Escape' && this.media.matches && this.button.getAttribute('aria-expanded') === 'true') {
+        this.setExpanded(false);
+        this.button.focus();
+      }
+    };
+    this.onNavigate = (event) => {
+      if (this.media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.setExpanded(false);
+      }
+    };
+    this.onResize = () => this.setExpanded(false);
+  }
+
+  connectedCallback() {
+    this.media = window.matchMedia('(max-width: 700px)');
+    this.button.addEventListener('click', this.onToggle);
+    this.addEventListener('keydown', this.onEscape);
+    this.addEventListener('click', this.onNavigate);
+    this.media.addEventListener('change', this.onResize);
+    this.setExpanded(false);
+  }
+
+  disconnectedCallback() {
+    this.button.removeEventListener('click', this.onToggle);
+    this.removeEventListener('keydown', this.onEscape);
+    this.removeEventListener('click', this.onNavigate);
+    this.media.removeEventListener('change', this.onResize);
+  }
+
+  setExpanded(expanded) {
+    this.button.setAttribute('aria-expanded', String(expanded));
+    this.links.hidden = this.media.matches && !expanded;
+  }
+}
+
+class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    mount(this, `
+      <style>
+        ${baseStyles}
+        ${actionStyles}
+        header {
+          min-height: 60vh;
+          background: linear-gradient(rgba(0,0,0,.5), rgba(0,0,0,.5)),
+            var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+          background-size: cover; background-position: center;
+          display: flex; flex-direction: column; justify-content: center;
+          align-items: center; color: white; text-align: center; padding: 40px 20px;
+        }
+        ::slotted(h1) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+        ::slotted(p) { margin: 0; }
+      </style>
+      <header><slot name="heading"></slot><slot></slot><slot name="action"></slot></header>
+    `);
+  }
+}
+
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    mount(this, `
+      <style>
+        ${baseStyles}
+        ${actionStyles}
+        :host { min-width: 0; }
+        article {
+          height: 100%; background: white; padding: 20px; border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0,0,0,.1); text-align: center;
+          display: flex; flex-direction: column; align-items: center;
+          overflow-wrap: anywhere;
+        }
+        ::slotted(h3) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        ::slotted(p) { margin: 0; }
+        .description { flex: 1; }
+      </style>
+      <article>
+        <slot name="heading"></slot>
+        <div class="description"><slot></slot></div>
+        <slot name="action"></slot>
+      </article>
+    `);
+  }
+}
+
+class GrindFooter extends HTMLElement {
+  constructor() {
+    super();
+    mount(this, `
+      <style>
+        ${baseStyles}
+        footer { background: var(--secondary, #d7ccc8); text-align: center; padding: 40px 20px; }
+        nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 20px; }
+        ::slotted(a) { color: var(--text, #3e2723); text-decoration: none; font-size: .85rem; }
+        ::slotted(a:hover) { text-decoration: underline; }
+        ::slotted(p) { margin: 0; }
+      </style>
+      <footer><nav aria-label="Footer navigation"><slot name="link"></slot></nav><slot></slot></footer>
+    `);
+  }
+}
+
+customElements.define('grind-navigation', GrindNavigation);
+customElements.define('coffee-hero', CoffeeHero);
+customElements.define('coffee-card', CoffeeCard);
+customElements.define('grind-footer', GrindFooter);
