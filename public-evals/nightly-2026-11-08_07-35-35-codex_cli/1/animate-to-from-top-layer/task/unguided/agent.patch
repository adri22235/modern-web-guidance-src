+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation" autofocus>&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary">Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="order-notice" class="order-notice" aria-label="Online ordering status" hidden>
+    <p role="status" id="order-status"></p>
+    <button type="button" id="close-notice-btn" class="close-button" aria-label="Dismiss ordering notice">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderNotice = document.getElementById('order-notice');
+    const orderStatus = document.getElementById('order-status');
+
+    // Keep each surface mounted until its exit animation finishes.
+    function dismiss(surface) {
+      surface.classList.add('is-closing');
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      logoutDialog.classList.remove('is-closing');
+      logoutDialog.showModal();
+      document.body.classList.add('modal-open');
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', () => dismiss(logoutDialog));
+    document.getElementById('cancel-logout-btn').addEventListener('click', () => dismiss(logoutDialog));
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      dismiss(logoutDialog);
+    });
+    logoutDialog.addEventListener('animationend', (event) => {
+      if (event.target === logoutDialog && event.animationName === 'panel-out' && logoutDialog.classList.contains('is-closing')) {
+        logoutDialog.close();
+      }
+    });
+    logoutDialog.addEventListener('close', () => {
+      document.body.classList.remove('modal-open');
+      logoutDialog.classList.remove('is-closing');
+    });
+
+    orderButton.addEventListener('click', () => {
+      orderNotice.classList.remove('is-closing');
+      orderNotice.hidden = false;
+      orderStatus.textContent = 'online ordering is currently offline';
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', () => dismiss(orderNotice));
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderNotice.hidden) {
+        dismiss(orderNotice);
+      }
+    });
+    orderNotice.addEventListener('animationend', (event) => {
+      if (event.target === orderNotice && event.animationName === 'panel-out' && orderNotice.classList.contains('is-closing')) {
+        if (orderNotice.contains(document.activeElement)) orderButton.focus();
+        orderNotice.hidden = true;
+        orderNotice.classList.remove('is-closing');
+        orderStatus.textContent = '';
+        orderButton.setAttribute('aria-expanded', 'false');
+      }
+    });
+  </script>
+
