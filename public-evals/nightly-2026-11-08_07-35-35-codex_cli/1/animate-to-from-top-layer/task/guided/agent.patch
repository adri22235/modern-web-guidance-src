+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <form method="dialog" class="dialog-actions">
+      <button type="submit" class="btn btn-secondary" value="cancel" autofocus>Cancel</button>
+      <button type="submit" class="btn" value="logout">Log out</button>
+    </form>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" popover="manual" aria-labelledby="ordering-title" hidden>
+    <button type="button" class="overlay-close" id="close-notice-btn" aria-label="Dismiss ordering notice">&times;</button>
+    <h2 id="ordering-title">Ordering update</h2>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep overlays (and the dialog backdrop) rendered until their CSS exits finish.
+    // This also works where discrete display/overlay transitions are unsupported.
+    async function animateClose(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    function closeLogout(value = '') {
+      return animateClose(logoutDialog, () => {
+        logoutDialog.close();
+        if (value === 'logout') window.location.assign(logoutLink.href);
+      });
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeLogout());
+    logoutDialog.querySelector('form').addEventListener('submit', event => {
+      event.preventDefault();
+      closeLogout(event.submitter?.value);
+    });
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogout();
+    });
+
+    function closeNotice() {
+      return animateClose(orderingNotice, () => {
+        if (orderingNotice.contains(document.activeElement)) orderButton.focus();
+        if (supportsPopover) orderingNotice.hidePopover();
+        orderingNotice.hidden = true;
+        orderingNotice.removeAttribute('data-visible');
+        orderButton.setAttribute('aria-expanded', 'false');
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      if (orderingNotice.hasAttribute('data-closing')) return;
+      if (!orderingNotice.hidden) {
+        closeNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      if (supportsPopover) {
+        orderingNotice.showPopover();
+      } else {
+        // Establish the closed style before transitioning the manual fallback.
+        orderingNotice.getBoundingClientRect();
+        orderingNotice.setAttribute('data-visible', '');
+      }
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+
+    document.getElementById('close-notice-btn').addEventListener('click', closeNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !orderingNotice.hidden && !logoutDialog.open) {
+        closeNotice();
+      }
+    });
+  </script>
+
