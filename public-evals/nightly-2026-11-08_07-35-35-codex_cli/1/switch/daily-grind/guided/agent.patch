+  <script>
+    const seasonalToggle = document.getElementById('seasonal-toggle');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+    const seasonalState = document.getElementById('seasonal-state');
+    const seasonalPreferenceKey = 'daily-grind:show-seasonal-favorites';
+
+    function updateSeasonalPreference() {
+      seasonalFavorites.hidden = !seasonalToggle.checked;
+      seasonalState.textContent = seasonalToggle.checked ? 'On' : 'Off';
+    }
+
+    try {
+      seasonalToggle.checked = localStorage.getItem(seasonalPreferenceKey) !== 'false';
+    } catch {
+      // Keep the default when browser storage is unavailable.
+    }
+    updateSeasonalPreference();
+
+    seasonalToggle.addEventListener('change', () => {
+      updateSeasonalPreference();
+      try {
+        localStorage.setItem(seasonalPreferenceKey, String(seasonalToggle.checked));
+      } catch {
+        // The preference still works for this visit without browser storage.
+      }
+    });
+  </script>
+
