+  <script>
+    const darkModeToggle = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+
+    darkModeToggle.checked = document.documentElement.dataset.theme === 'dark';
+    darkModeState.textContent = darkModeToggle.checked ? 'On' : 'Off';
+
+    darkModeToggle.addEventListener('change', () => {
+      document.documentElement.dataset.theme = darkModeToggle.checked ? 'dark' : 'light';
+      darkModeState.textContent = darkModeToggle.checked ? 'On' : 'Off';
+      try {
+        localStorage.setItem('daily-grind-dark-mode', String(darkModeToggle.checked));
+      } catch {
+        // The toggle still works for this visit when storage is unavailable.
+      }
+    });
+  </script>
