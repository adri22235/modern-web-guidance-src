+  <script>
+    (() => {
+      const storageKey = 'daily-grind:show-drink-descriptions';
+      const toggle = document.getElementById('drink-descriptions');
+      const state = document.getElementById('drink-descriptions-state');
+      const descriptions = document.querySelectorAll('.drink-description');
+
+      function applyPreference(enabled) {
+        toggle.checked = enabled;
+        state.textContent = enabled ? 'On' : 'Off';
+        descriptions.forEach(description => {
+          description.hidden = !enabled;
+        });
+      }
+
+      let enabled = true;
+      try {
+        enabled = localStorage.getItem(storageKey) !== 'false';
+      } catch {
+        // Keep the preference usable when browser storage is unavailable.
+      }
+      applyPreference(enabled);
+
+      toggle.addEventListener('change', () => {
+        applyPreference(toggle.checked);
+        try {
+          localStorage.setItem(storageKey, String(toggle.checked));
+        } catch {
+          // The preference still applies for the current visit.
+        }
+      });
+
+      window.addEventListener('storage', event => {
+        if (event.key === storageKey || event.key === null) {
+          applyPreference(event.newValue !== 'false');
+        }
+      });
+    })();
+  </script>
+
