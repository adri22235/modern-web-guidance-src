diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,61 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      padding: 32px 24px;
+    }
+
+    .target {
+      display: grid;
+      place-content: center;
+      width: 112px;
+      height: 112px;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      box-shadow: 0 4px 12px rgb(78 52 46 / 15%);
+      text-align: center;
+      font-size: 0.85rem;
+      font-weight: 700;
+      line-height: 1.4;
+      /* Independent properties keep hover scaling from replacing either animation.
+         Identity transforms establish a stable stacking context before hover. */
+      translate: 0;
+      rotate: 0deg;
+      scale: 1;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.12;
+    }
+
+    @keyframes promo-spin {
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -24px 0; }
+      to { translate: 24px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation-duration: 120s, 30s;
+      }
+
+      .target:hover {
+        scale: 1;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
