+  <script>
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const roastTrack = document.querySelector('.roast-track');
+    const roastToggle = document.querySelector('.roast-toggle');
+    let roastPaused = false;
+
+    // Some event implementations expose the triggering Animation directly.
+    // Standard CSS events may only provide its name/property, so resolve that
+    // specific animation on the target when the direct object is unavailable.
+    function recordAnimationState(event) {
+      const animation = event.animation ?? event.target.getAnimations?.().find(candidate =>
+        (candidate.effect?.pseudoElement || null) === (event.pseudoElement || null) &&
+        (event.animationName ? candidate.animationName === event.animationName :
+          candidate.transitionProperty === event.propertyName));
+      const fallback = event.type.endsWith('cancel') ? 'idle' :
+        event.type.endsWith('end') ? 'finished' : 'running';
+      document.body.dataset.lastAnimationState = animation?.playState ?? fallback;
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState, true);
+    }
+
+    function syncRoast() {
+      const reduced = motionPreference.matches;
+      roastTrack.classList.toggle('is-paused', roastPaused || reduced);
+      roastToggle.disabled = reduced;
+      roastToggle.textContent = reduced ? 'Motion off' : roastPaused ? 'Resume' : 'Pause';
+      roastToggle.setAttribute('aria-pressed', String(roastPaused || reduced));
+      roastToggle.setAttribute('aria-label', reduced ? 'Daily roast motion disabled by your preferences' :
+        roastPaused ? 'Resume daily roast banner' : 'Pause daily roast banner');
+      const animation = roastTrack.getAnimations()[0];
+      document.body.dataset.lastAnimationState = animation?.playState ?? 'idle';
+    }
+    roastToggle.addEventListener('click', () => {
+      roastPaused = !roastPaused;
+      syncRoast();
+    });
+
+    const drinks = {
+      maple: { title: 'Maple Oat Latte', description: 'Rich espresso meets creamy oat milk and a hint of Vermont maple syrup. A cozy, gently sweet seasonal favorite.', notes: 'Tasting notes · Maple, toasted oats, caramel. Made with oat milk.' },
+      espresso: { title: 'Dark Roast Espresso', description: 'A full-bodied espresso with a deep, smoky character and a rich crema. Crafted for a bold start to your day.', notes: 'Tasting notes · Dark cocoa, roasted nuts, smoky finish.' },
+      coldbrew: { title: 'Cold Brew', description: 'Slow-steeped for 18 hours and served cold for a smooth, refreshing cup with a naturally mellow sweetness.', notes: 'Tasting notes · Chocolate, gentle sweetness, smooth finish.' }
+    };
+    const dialog = document.querySelector('.drink-dialog');
+    let closeTimer;
+    let opener;
+
+    function finishClose() {
+      clearTimeout(closeTimer);
+      dialog.close();
+      dialog.classList.remove('is-closing');
+    }
+    function closeDetails() {
+      if (!dialog.open || dialog.classList.contains('is-closing')) return;
+      if (motionPreference.matches) return finishClose();
+      dialog.classList.add('is-closing');
+      // Ensure closing still completes if an animation is canceled or unavailable.
+      closeTimer = window.setTimeout(finishClose, 300);
+    }
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        opener = button;
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        dialog.showModal();
+      });
+    });
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDetails();
+    });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDetails();
+    });
+    dialog.addEventListener('animationend', event => {
+      if (event.target === dialog && !event.pseudoElement && event.animationName === 'details-out') finishClose();
+    });
+    dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));
+    motionPreference.addEventListener('change', () => {
+      syncRoast();
+      if (dialog.classList.contains('is-closing')) finishClose();
+    });
+    syncRoast();
+  </script>
