@@ -0,0 +1,109 @@
+(() => {
+  // Use the exact animation supplied by the event, including pseudo-elements.
+  // Older engines still report a useful lifecycle state without object lookup.
+  const lifecycleStates = {
+    animationstart: 'running', animationiteration: 'running',
+    animationend: 'finished', animationcancel: 'idle',
+    transitionrun: 'running', transitionstart: 'running',
+    transitionend: 'finished', transitioncancel: 'idle',
+  };
+  document.body.dataset.lastAnimationState = 'idle';
+  function recordAnimationState(event) {
+    const animation = event.animation;
+    document.body.dataset.lastAnimationState = animation
+      ? animation.playState
+      : lifecycleStates[event.type];
+  }
+  for (const type of Object.keys(lifecycleStates)) {
+    document.addEventListener(type, recordAnimationState, true);
+  }
+
+  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+  const banner = document.querySelector('.roast-banner');
+  const toggle = document.querySelector('.roast-toggle');
+  let manuallyPaused = false;
+
+  function syncBanner() {
+    const paused = reducedMotion.matches || manuallyPaused;
+    banner.dataset.paused = String(paused);
+    toggle.setAttribute('aria-pressed', String(paused));
+    toggle.disabled = reducedMotion.matches;
+    toggle.textContent = reducedMotion.matches
+      ? 'Motion reduced'
+      : paused ? 'Resume roast banner' : 'Pause roast banner';
+  }
+  toggle.addEventListener('click', () => {
+    manuallyPaused = !manuallyPaused;
+    syncBanner();
+  });
+  reducedMotion.addEventListener('change', syncBanner);
+  syncBanner();
+
+  const drinks = {
+    maple: {
+      name: 'Maple Oat Latte',
+      description: 'Our espresso meets creamy oat milk and a hint of Vermont maple syrup. A cozy, gently sweet cup with a silky finish.',
+      notes: 'Maple · Toasted oats', serving: 'Hot or iced',
+    },
+    espresso: {
+      name: 'Dark Roast Espresso',
+      description: 'A rich, full-bodied espresso with a smoky finish and a velvety crema. Bold and comforting, made for a morning boost.',
+      notes: 'Dark cocoa · Smoky', serving: 'Hot',
+    },
+    'cold-brew': {
+      name: 'Cold Brew',
+      description: 'Slow-steeped for 18 hours for maximum smoothness. Enjoy a refreshing, mellow coffee with a rounded finish, poured over ice.',
+      notes: 'Cocoa · Mellow', serving: 'Over ice',
+    },
+  };
+  const dialog = document.querySelector('#drink-details');
+  for (const button of document.querySelectorAll('[data-drink]')) {
+    button.addEventListener('click', () => {
+      const drink = drinks[button.dataset.drink];
+      document.querySelector('#drink-title').textContent = drink.name;
+      document.querySelector('#drink-description').textContent = drink.description;
+      document.querySelector('#drink-notes').textContent = drink.notes;
+      document.querySelector('#drink-serving').textContent = drink.serving;
+      dialog.showModal();
+    });
+  }
+
+  // Keep the modal in the top layer until its exit completes. This also works
+  // in engines that parse allow-discrete but cannot transition display/overlay.
+  async function closeDetails() {
+    if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+    dialog.setAttribute('data-closing', '');
+    let timeout;
+    await Promise.race([
+      Promise.allSettled(dialog.getAnimations({ subtree: true }).map(animation => animation.finished)),
+      new Promise(resolve => { timeout = window.setTimeout(resolve, 700); }),
+    ]);
+    window.clearTimeout(timeout);
+    dialog.close();
+    dialog.removeAttribute('data-closing');
+  }
+  document.querySelector('#close-details').addEventListener('click', closeDetails);
+  dialog.addEventListener('cancel', event => {
+    event.preventDefault();
+    closeDetails();
+  });
+
+  // Progressive light-dismiss fallback: both press and release must be outside,
+  // so dragging a text selection out of the panel does not dismiss it.
+  if (!('closedBy' in HTMLDialogElement.prototype)) {
+    const outside = event => {
+      const rect = dialog.getBoundingClientRect();
+      return event.clientX < rect.left || event.clientX > rect.right
+        || event.clientY < rect.top || event.clientY > rect.bottom;
+    };
+    let pressedOutside = false;
+    dialog.addEventListener('pointerdown', event => {
+      pressedOutside = event.button === 0 && outside(event);
+    });
+    dialog.addEventListener('pointerup', event => {
+      if (pressedOutside && outside(event)) closeDetails();
+      pressedOutside = false;
+    });
+    dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+  }
+})();
