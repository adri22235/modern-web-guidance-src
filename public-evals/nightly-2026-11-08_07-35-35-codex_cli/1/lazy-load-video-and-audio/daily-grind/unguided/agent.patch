+  <script>
+    (() => {
+      const players = [...document.querySelectorAll('[data-deferred-media]')];
+      let observer;
+
+      function prepare(player) {
+        if (!player.hasAttribute('data-deferred-media')) return;
+        player.removeAttribute('data-deferred-media');
+        // Neither posters nor media URLs are exposed to the browser until now.
+        if (player.dataset.poster) {
+          player.poster = player.dataset.poster;
+          delete player.dataset.poster;
+        }
+        player.querySelectorAll('source[data-src]').forEach(source => {
+          source.src = source.dataset.src;
+          delete source.dataset.src;
+        });
+        player.preload = 'metadata';
+        player.load();
+        observer?.unobserve(player);
+      }
+
+      players.forEach(player => {
+        // Keyboard focus and direct interaction also work before observer delivery.
+        player.addEventListener('focus', () => prepare(player), { once: true });
+        player.addEventListener('pointerdown', () => prepare(player), { once: true });
+        player.addEventListener('error', () => {
+          const message = document.createElement('p');
+          message.className = 'media-error';
+          message.setAttribute('role', 'status');
+          message.textContent = 'This player could not load. Please use the source link below to watch or listen.';
+          player.after(message);
+        }, { once: true });
+      });
+
+      if ('IntersectionObserver' in window) {
+        observer = new IntersectionObserver(entries => {
+          entries.forEach(entry => {
+            if (entry.isIntersecting) prepare(entry.target);
+          });
+        }, { rootMargin: '200px 0px', threshold: 0 });
+        players.forEach(player => observer.observe(player));
+      } else {
+        // Keep deferral in older browsers too; never eagerly hydrate all players.
+        let scheduled = false;
+        function checkViewport() {
+          scheduled = false;
+          players.forEach(player => {
+            const bounds = player.getBoundingClientRect();
+            if (bounds.bottom >= -200 && bounds.top <= window.innerHeight + 200) {
+              prepare(player);
+            }
+          });
+          if (players.every(player => !player.hasAttribute('data-deferred-media'))) {
+            window.removeEventListener('scroll', scheduleCheck);
+            window.removeEventListener('resize', scheduleCheck);
+          }
+        }
+        function scheduleCheck() {
+          if (scheduled) return;
+          scheduled = true;
+          requestAnimationFrame(checkViewport);
+        }
+        window.addEventListener('scroll', scheduleCheck, { passive: true });
+        window.addEventListener('resize', scheduleCheck);
+        checkViewport();
+      }
+    })();
+  </script>
+
