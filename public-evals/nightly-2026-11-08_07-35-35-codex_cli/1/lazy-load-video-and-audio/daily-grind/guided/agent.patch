diff --git a/media.js b/media.js
new file mode 100644
index 0000000..07c7adf
--- /dev/null
+++ b/media.js
@@ -0,0 +1,48 @@
+// URLs start in data attributes so even the HTML preload scanner cannot request
+// offscreen posters or media before native lazy loading / the observer takes over.
+const deferredMedia = document.querySelectorAll('[data-deferred-media]');
+const supportsLazyMedia = Object.hasOwn(HTMLMediaElement.prototype, 'loading');
+
+function restoreMedia(media) {
+  if (!media.hasAttribute('data-deferred-media')) return;
+
+  if (media.dataset.poster) {
+    media.setAttribute('poster', media.dataset.poster);
+    delete media.dataset.poster;
+  }
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+  media.preload = media.dataset.preload;
+  delete media.dataset.preload;
+  media.removeAttribute('data-deferred-media');
+}
+
+if (supportsLazyMedia) {
+  // Native loading="lazy" gates poster and metadata fetches as well as sources.
+  // Avoid load(), which can override the browser's lazy-loading lifecycle.
+  deferredMedia.forEach(restoreMedia);
+} else if ('IntersectionObserver' in window) {
+  const observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting) continue;
+      restoreMedia(entry.target);
+      entry.target.load();
+      observer.unobserve(entry.target);
+    }
+  }, { rootMargin: '200px 0px', threshold: 0 });
+
+  deferredMedia.forEach((media) => observer.observe(media));
+} else {
+  // Very old browsers load on interaction rather than downloading everything.
+  deferredMedia.forEach((media) => {
+    const activate = () => {
+      if (!media.hasAttribute('data-deferred-media')) return;
+      restoreMedia(media);
+      media.load();
+    };
+    media.addEventListener('focus', activate, { once: true });
+    media.addEventListener('pointerdown', activate, { once: true });
+  });
+}
