+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = Array.from(list.querySelectorAll('[role="option"]'));
+    let selected = -1;
+
+    function closePicker(restoreFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker(index = selected < 0 ? 0 : selected) {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function selectRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      const value = document.getElementById('roast-value');
+      value.replaceChildren(...Array.from(options[index].childNodes, node => node.cloneNode(true)));
+      value.style.display = 'flex';
+      value.style.alignItems = 'center';
+      value.style.gap = '12px';
+      document.getElementById('order-button').href = '/order-online?roast=' + encodeURIComponent(options[index].dataset.value);
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker(event.key === 'ArrowUp' ? options.length - 1 : selected < 0 ? 0 : selected);
+      }
+    });
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(index));
+      option.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) {
+          event.preventDefault();
+          options[next].focus();
+        }
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(index);
+        }
+      });
+    });
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !list.hidden) {
+        event.preventDefault();
+        closePicker(true);
+      }
+      if (event.key === 'Tab') closePicker(true);
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
