diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,50 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Typeform — A little type playground</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
+<style>
+:root{font-family:'DM Sans',sans-serif;color:#292923;background:#f7f7f2;font-synthesis:none;--line:#e1e1d8;--muted:#83837a;--accent:#ee7559}*{box-sizing:border-box}body{margin:0}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #ee7559;outline-offset:4px}header{height:91px;max-width:1440px;margin:auto;padding:0 5%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;gap:11px;align-items:center;font-size:25px;font-weight:700;letter-spacing:-1.3px}.brand-mark{background:#292923;color:#f7f7f2;width:31px;height:34px;border-radius:5px 5px 11px 5px;display:grid;place-items:center;font-family:Georgia,serif;font-size:26px;font-style:italic;font-weight:400;letter-spacing:-3px;padding-right:3px}.brand-dot{color:var(--accent)}nav{display:flex;gap:32px;align-items:center;font-size:13px}nav a{color:#78786e;text-decoration:none}nav a.active{color:#292923}nav a.active:after{content:'';display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--accent);vertical-align:middle;margin-left:7px}.nav-tag{border:1px solid var(--line);border-radius:20px;padding:7px 11px;font-size:10px;color:#7b7b71;letter-spacing:1px}main{max-width:1230px;margin:0 auto;padding:58px 30px 0}.eyebrow{font-size:10px;font-weight:600;letter-spacing:1.9px;text-transform:uppercase;color:#88887d;display:flex;align-items:center;gap:9px}.eyebrow:before{content:'';background:var(--accent);width:6px;height:6px;border-radius:50%}.intro{display:flex;align-items:flex-end;justify-content:space-between;margin:17px 0 38px}.intro h1{font-size:46px;font-weight:500;letter-spacing:-2.2px;margin:0 0 13px;line-height:1.13}.intro h1 em{font-family:'Playfair Display',serif;font-weight:500;color:#929487}.intro p{font-size:14px;line-height:1.7;color:#818176;margin:0}.edition{font-family:'IBM Plex Mono',monospace;font-size:10px;color:#97978c;writing-mode:vertical-rl;letter-spacing:1px;padding-bottom:3px}.workspace{display:grid;grid-template-columns:1.6fr 1fr;gap:22px}.panel{background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;padding:21px 24px;border-bottom:1px solid #ebebe5;font-size:13px;font-weight:600}.panel-title{display:flex;align-items:center;gap:10px}.number{font-family:'IBM Plex Mono',monospace;color:#9a9a8e;font-size:10px;font-weight:400}.badge{font-size:9px;letter-spacing:.7px;font-weight:500;color:#788870;background:#edf2e9;border:1px solid #e0e7db;padding:4px 7px;border-radius:4px}.type-preview{min-height:262px;padding:32px 28px;position:relative;background:linear-gradient(transparent 43px,#f3f3ef 44px,transparent 45px);background-size:100% 44px;background-position:0 28px}.preview-label{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:1.2px;color:#a0a095;margin-bottom:26px}.preview-label span{color:#c7c7be;margin:0 9px}#mixed-fonts-container{font-family:'DM Sans',sans-serif;font-size:30px;line-height:1.65;font-size-adjust:.52;letter-spacing:-.7px;margin:0;max-width:570px}#mixed-fonts-container code{font-family:'IBM Plex Mono',monospace;background:#f3efe8;border:1px solid #e9e3d9;border-radius:5px;padding:2px 6px;color:#a27146;letter-spacing:-1px}.specimen-footer{display:flex;justify-content:space-between;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:9px;color:#99998f;margin-top:26px}.green-dot{display:inline-block;background:#879b77;width:5px;height:5px;border-radius:50%;margin-right:6px}.controls{padding:19px 24px;background:#fcfcf9;border-top:1px solid var(--line)}.control-row{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px}.control-row+.control-row{margin-top:21px}.control-name{display:flex;align-items:center;gap:7px}.info{font-size:8px;width:12px;height:12px;border:1px solid #bbbcb1;border-radius:50%;display:inline-grid;place-items:center;color:#96988a}.toggle-wrap{display:flex;gap:9px;align-items:center;color:#7d826e;font-size:10px}.toggle{width:29px;height:17px;border:0;border-radius:20px;background:#809276;padding:2px;display:flex;justify-content:flex-end}.toggle[aria-checked="false"]{background:#c4c4ba;justify-content:flex-start}.toggle:after{content:'';height:13px;width:13px;background:#fff;border-radius:50%;box-shadow:0 1px 2px #0002}.slider-wrap{display:flex;align-items:center;gap:12px}input[type=range]{accent-color:#747f65;width:135px;height:3px}.value{font-family:'IBM Plex Mono',monospace;font-size:10px;border:1px solid #e4e4db;border-radius:4px;padding:5px 8px;background:#fff;color:#77776d}.code-block{padding:21px 24px;background:#f8f8f3;border-top:1px solid var(--line);font-family:'IBM Plex Mono',monospace;font-size:11px;line-height:1.85;color:#79796f;position:relative;min-height:132px}.code-label{font-family:'DM Sans',sans-serif;font-size:9px;letter-spacing:1.2px;color:#a0a095;margin-bottom:9px}.selector{color:#555e4d}.property{color:#9b775a}.code-value{color:#657c59}.copy{position:absolute;right:19px;top:18px;border:0;background:transparent;color:#9b9c91;display:flex;align-items:center;gap:5px;font-family:'DM Sans',sans-serif;font-size:10px}.copy svg{width:12px;height:12px}.theme-preview{padding:22px;background:#f0f0ea}#independent-theme-container{font-size-adjust:.5;aspect-ratio:4 / 3;background:#e9ecdf;color:#3f4a38;border:1px solid #d9decc;border-radius:7px;padding:25px 25px 20px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;transition:background .3s,color .3s}.theme-overline{font-size:8px;letter-spacing:1.5px;font-weight:600;display:flex;align-items:center;gap:6px}.theme-overline:before{content:'✳';font-size:15px}.theme-sample{font-family:'Playfair Display',serif;font-size:43px;line-height:1.08;letter-spacing:-1.7px;font-weight:500;margin:17px 0}.theme-sample em{font-weight:500}.theme-bottom{font-size:9px;display:flex;align-items:center;justify-content:space-between;color:#7e8972}.theme-bottom .arrow{font-size:20px;color:#59674e}.theme-settings{padding:16px 23px 17px;display:flex;justify-content:space-between;align-items:center}.theme-settings label{font-size:10px;color:#8d8d80}.swatches{display:flex;gap:7px}.swatch{height:17px;width:17px;border-radius:50%;border:3px solid white;outline:1px solid transparent;padding:0}.swatch[aria-pressed=true]{outline-color:#959e87}.theme-code{min-height:132px;padding-top:15px;padding-bottom:15px}.theme-code .code-label{margin-bottom:6px}.note{display:flex;align-items:flex-start;gap:13px;background:#eeeee6;border:1px solid #e4e4d9;border-radius:8px;padding:18px 22px;margin-top:23px}.note-icon{font-family:Georgia,serif;font-style:italic;border:1px solid #a7ab98;color:#80896c;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;font-size:12px}.note p{font-size:11px;color:#858579;line-height:1.7;margin:0}.note strong{font-weight:600;color:#54584b}.note code{font-size:10px;color:#666d58}.bottom{display:flex;justify-content:space-between;align-items:center;padding:25px 2px 32px;font-size:10px;color:#99998d}.bottom button{border:0;background:transparent;color:#74796a;font-size:10px;display:flex;gap:7px;align-items:center}footer{border-top:1px solid var(--line);max-width:1170px;margin:0 auto;padding:23px 0;display:flex;justify-content:space-between;font-size:10px;color:#99998f}.footer-name{font-weight:600;color:#6e7063}.heart{color:#b3826d}dialog{border:1px solid var(--line);border-radius:14px;padding:30px;max-width:450px;background:#f7f7f2;color:#292923;line-height:1.7}dialog::backdrop{background:#29292355;backdrop-filter:blur(4px)}dialog h2{font-size:24px;letter-spacing:-1px}dialog p{font-size:14px;color:#737568}dialog button{background:#292923;color:white;border:0;border-radius:6px;padding:9px 18px}@media(min-width:1350px){main{padding-top:70px}.type-preview{min-height:287px}#mixed-fonts-container{font-size:32px}.theme-preview{padding:22px 25px}.theme-sample{font-size:48px}}@media(max-width:760px){header{height:75px;padding:0 6%}nav{gap:18px}.nav-tag{display:none}main{padding:38px 20px 0}.intro h1{font-size:37px}.intro p{font-size:12px}.edition{display:none}.workspace{grid-template-columns:1fr}.type-preview{min-height:240px}#mixed-fonts-container{font-size:28px}.theme-sample{font-size:clamp(40px,10vw,65px)}.note{padding:16px}.bottom{font-size:9px}footer{margin:0 20px;gap:12px;font-size:9px}.panel-head{padding:19px 22px}}
+</style>
+</head>
+<body>
+<header><div class="brand"><span class="brand-mark">tf</span>typeform<span class="brand-dot">.</span></div><nav aria-label="Main navigation"><a href="#playground" class="active">Playground</a><a href="#about" id="about-link">About</a><span class="nav-tag">A LITTLE CSS MAGIC</span></nav></header>
+<main id="playground">
+<div class="eyebrow">THE TYPOGRAPHY PLAYGROUND</div>
+<div class="intro"><div><h1>Different fonts. <em>Same rhythm.</em></h1><p>A small space to explore harmonious type.<br>Mix font families, find your balance, and give every theme its own character.</p></div><div class="edition">EXPERIMENT NO. 001 — TYPE & PROPORTION</div></div>
+<div class="workspace">
+<section class="panel" aria-labelledby="mixed-title">
+<div class="panel-head"><div class="panel-title"><span class="number">01</span><span id="mixed-title">Mixed fonts, in harmony</span></div><span class="badge">AUTO-NORMALIZED</span></div>
+<div class="type-preview"><div class="preview-label">LIVE PREVIEW <span>/</span> SANS + MONO</div><p id="mixed-fonts-container">Good design speaks clearly.<br>Even when it speaks in <code>code</code>.<br>A little <code>font-size-adjust</code><br>keeps everyone on the same page.</p><div class="specimen-footer"><span>DM Sans + IBM Plex Mono</span><span><i class="green-dot"></i><span id="height-status">Balanced x-height</span></span></div></div>
+<div class="controls"><div class="control-row"><span class="control-name">Normalize font height <span class="info" title="font-size-adjust aligns fonts by their x-height.">i</span></span><div class="toggle-wrap"><span id="toggle-label">Enabled</span><button class="toggle" role="switch" aria-checked="true" aria-label="Normalize font height" id="normalize"></button></div></div><div class="control-row"><label for="font-size">Font size</label><div class="slider-wrap"><input id="font-size" type="range" min="20" max="36" value="30"><output class="value" id="size-value" for="font-size">30 px</output></div></div></div>
+<div class="code-block"><div class="code-label">THE CSS BEHIND IT</div><button class="copy" data-copy="mixed" aria-label="Copy mixed fonts CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="9" rx="1"/><path d="M10 3V2H2v9h1"/></svg><span>Copy</span></button><span class="selector">#mixed-fonts-container</span> {<br>&nbsp; <span class="property">font-size-adjust</span>: <span class="code-value" id="mixed-css-value">0.52</span>;<br>}</div>
+</section>
+<section class="panel" aria-labelledby="theme-title"><div class="panel-head"><div class="panel-title"><span class="number">02</span><span id="theme-title">A theme of its own</span></div><span class="badge" style="background:#f2f0e9;color:#96876c;border-color:#e7e2d6">INDEPENDENT</span></div><div class="theme-preview"><div id="independent-theme-container"><div class="theme-overline">THE SLOW STUDIO</div><h2 class="theme-sample">Room to breathe.<br>Space to <em>be.</em></h2><div class="theme-bottom"><span>Thoughtfully set. Naturally balanced.</span><span class="arrow">↗</span></div></div></div><div class="theme-settings"><label>Choose a mood</label><div class="swatches" role="group" aria-label="Theme mood"><button class="swatch" style="background:#d8dfc9" aria-label="Sage theme" aria-pressed="true" data-theme="sage"></button><button class="swatch" style="background:#e9cfbe" aria-label="Clay theme" aria-pressed="false" data-theme="clay"></button><button class="swatch" style="background:#d0dae3" aria-label="Mist theme" aria-pressed="false" data-theme="mist"></button><button class="swatch" style="background:#484b44" aria-label="Ink theme" aria-pressed="false" data-theme="ink"></button></div><span class="value">4 : 3</span></div><div class="code-block theme-code"><div class="code-label">ITS OWN RULES</div><button class="copy" data-copy="theme" aria-label="Copy independent theme CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="9" rx="1"/><path d="M10 3V2H2v9h1"/></svg><span>Copy</span></button><span class="selector">#independent-theme-container</span> {<br>&nbsp; <span class="property">font-size-adjust</span>: <span class="code-value">0.5</span>;<br>&nbsp; <span class="property">aspect-ratio</span>: <span class="code-value">4 / 3</span>;<br>}</div></section>
+</div>
+<div class="note"><span class="note-icon">i</span><p><strong>Small property. Big difference.</strong> &nbsp; <code>font-size-adjust</code> preserves the perceived size of text across font families by matching their x-height.<br>The independent theme sets its own value, while <code>aspect-ratio</code> keeps its canvas in proportion.</p></div>
+<div class="bottom"><span>Made for the details you feel, even when you don't see them.</span><button id="reset"><span>↺</span> Reset playground</button></div>
+</main>
+<footer><span><span class="footer-name">typeform.</span> &nbsp; A little experiment in better typography.</span><span>Built with CSS. Set with <span class="heart">♡</span></span></footer>
+<dialog id="about"><h2>A little type playground.</h2><p>Explore how CSS brings different font families into balance. Toggle normalization to compare the text, adjust its size, or give the independent theme a different mood.</p><p>The previews use <code>font-size-adjust</code> to control perceived font size and <code>aspect-ratio</code> to preserve the theme's proportions.</p><form method="dialog"><button>Back to the playground</button></form></dialog>
+<script>
+const paragraph=document.getElementById('mixed-fonts-container');
+const toggle=document.getElementById('normalize');
+const slider=document.getElementById('font-size');
+const theme=document.getElementById('independent-theme-container');
+function setNormalization(enabled){toggle.setAttribute('aria-checked',String(enabled));paragraph.style.fontSizeAdjust=enabled?'0.52':'none';document.getElementById('toggle-label').textContent=enabled?'Enabled':'Disabled';document.getElementById('height-status').textContent=enabled?'Balanced x-height':'Natural font heights';document.getElementById('mixed-css-value').textContent=enabled?'0.52':'none';document.querySelector('.badge').textContent=enabled?'AUTO-NORMALIZED':'ORIGINAL HEIGHTS';}
+toggle.addEventListener('click',()=>setNormalization(toggle.getAttribute('aria-checked')!=='true'));
+function setSize(){paragraph.style.fontSize=slider.value+'px';document.getElementById('size-value').textContent=slider.value+' px';}
+slider.addEventListener('input',setSize);setSize();
+const themes={sage:['#e9ecdf','#3f4a38','#d9decc'],clay:['#f0ded1','#704d3d','#e2cbbb'],mist:['#e0e8ef','#3b5366','#ccd9e3'],ink:['#41483f','#f0efdf','#565e52']};
+function setTheme(name){const colors=themes[name];theme.style.background=colors[0];theme.style.color=colors[1];theme.style.borderColor=colors[2];theme.querySelector('.theme-bottom').style.color=colors[1];theme.querySelector('.arrow').style.color=colors[1];document.querySelectorAll('[data-theme]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.theme===name)));}
+document.querySelectorAll('[data-theme]').forEach(button=>button.addEventListener('click',()=>setTheme(button.dataset.theme)));
+document.getElementById('reset').addEventListener('click',()=>{setNormalization(true);slider.value=30;setSize();setTheme('sage');});
+document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const css=button.dataset.copy==='mixed'?`#mixed-fonts-container {\n  font-size-adjust: ${toggle.getAttribute('aria-checked')==='true'?'0.52':'none'};\n}`:'#independent-theme-container {\n  font-size-adjust: 0.5;\n  aspect-ratio: 4 / 3;\n}';try{await navigator.clipboard.writeText(css);button.querySelector('span').textContent='Copied!';}catch{button.querySelector('span').textContent='Copy unavailable';}setTimeout(()=>button.querySelector('span').textContent='Copy',2000);}));
+document.getElementById('about-link').addEventListener('click',event=>{event.preventDefault();document.getElementById('about').showModal();});
+</script>
+</body>
+</html>
