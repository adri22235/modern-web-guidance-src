diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,66 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="theme-color" content="#f8f9fc">
+  <title>Typeform — A little harmony for your type</title>
+  <link rel="stylesheet" href="style.css">
+  <script src="app.js" defer></script>
+</head>
+<body>
+  <header class="site-header">
+    <a class="brand" href="./" aria-label="Typeform home"><span class="brand-icon" aria-hidden="true">t<span>f</span></span>typeform<span class="brand-divider"></span><span class="brand-subtitle">The typography playground</span></a>
+    <a class="documentation" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Read the docs <span aria-hidden="true">↗</span></a>
+  </header>
+  <main>
+    <div class="intro">
+      <span class="eyebrow"><span class="tiny-spark" aria-hidden="true">✳</span> SMALL PROPERTY. BIG DIFFERENCE.</span>
+      <h1>Different fonts.<br>Same visual rhythm<span class="purple">.</span></h1>
+      <p>Bring your type together. Explore how modern CSS keeps mixed<br class="desktop-break"> fonts feeling balanced, readable, and beautifully consistent.</p>
+      <div class="feature-pill"><span class="status-dot"></span>Powered by <code>font-size-adjust</code></div>
+    </div>
+
+    <section class="experiment" aria-labelledby="mixed-heading">
+      <div class="section-heading"><div class="heading-start"><span class="step">01</span><div><h2 id="mixed-heading">Mixed fonts, in harmony</h2><p>One paragraph. Two font families. A consistent x-height.</p></div></div><span class="mode-badge">Automatic</span></div>
+      <div class="workbench">
+        <div class="toolbar"><div class="view-switch" aria-label="Mixed fonts view"><button type="button" class="active" data-view="mixed-preview" aria-pressed="true"><span aria-hidden="true">◉</span> Preview</button><button type="button" data-view="mixed-code" aria-pressed="false"><span aria-hidden="true">&lt;/&gt;</span> CSS</button></div><label class="toggle-label" for="normalize">Normalize fonts <input id="normalize" type="checkbox" role="switch" checked><span class="switch" aria-hidden="true"></span></label></div>
+        <div id="mixed-preview" class="preview mixed-preview">
+          <div class="preview-label">THE LITTLE THINGS MAKE THE DIFFERENCE</div>
+          <p id="mixed-fonts-container">Good typography is invisible. Even when you mix<br class="wide-break"> everyday words with <code>inline code</code>, everything should<br class="wide-break"> feel like it belongs on the same page.</p>
+          <div class="font-legend"><span><i class="legend-dot text-dot"></i> Arial <span class="legend-description">/ Body text</span></span><span><i class="legend-dot code-dot"></i> Courier New <span class="legend-description">/ Inline code</span></span></div>
+        </div>
+        <div id="mixed-code" class="code-view" hidden><pre tabindex="0" role="region" aria-label="Mixed font CSS"><code><span class="syntax-selector">#mixed-fonts-container</span> {
+  font-family: Arial, sans-serif;
+  <span class="syntax-property">font-size-adjust</span>: <span class="syntax-value">from-font</span>;
+}
+
+<span class="syntax-selector">#mixed-fonts-container code</span> {
+  font-family: "Courier New", monospace;
+}</code></pre></div>
+        <div class="control-bar"><div class="adjust-info"><span class="mini-icon" aria-hidden="true">↕</span><code>font-size-adjust: <strong id="mixed-value">from-font</strong>;</code></div><label class="size-control" for="font-size">Font size <input type="range" id="font-size" min="16" max="32" value="24"><output for="font-size" id="size-value">24px</output></label></div>
+      </div>
+      <p class="section-note"><span class="info-icon" aria-hidden="true">i</span><span><code>from-font</code> uses the first font’s x-height to automatically align the visual size of every font inside.</span></p>
+    </section>
+
+    <section class="experiment independent" aria-labelledby="theme-heading">
+      <div class="section-heading"><div class="heading-start"><span class="step">02</span><div><h2 id="theme-heading">A theme of its own</h2><p>Independent font family. Explicit proportions. The same balance.</p></div></div><span class="mode-badge numeric">Numeric override</span></div>
+      <div class="workbench">
+        <div class="toolbar"><div class="view-switch" aria-label="Independent theme view"><button type="button" class="active" data-view="theme-preview" aria-pressed="true"><span aria-hidden="true">◉</span> Preview</button><button type="button" data-view="theme-code" aria-pressed="false"><span aria-hidden="true">&lt;/&gt;</span> CSS</button></div><label class="theme-select" for="theme-font">Theme font <select id="theme-font"><option value="Georgia">Georgia</option><option value="Verdana">Verdana</option><option value="Times New Roman">Times New Roman</option></select></label></div>
+        <div id="theme-preview" class="preview theme-preview">
+          <div class="theme-sample"><span class="preview-label">THE EDITORIAL THEME</span><div id="independent-theme-container"><span class="theme-kicker">A different perspective</span><p>Great type doesn’t shout.<br>It finds its own balance.</p></div><span class="theme-caption">A little character. A lot of consistency.</span></div>
+          <div class="ratio-note"><span class="ratio-symbol" aria-hidden="true">Aa<span>↕</span></span><span class="ratio-number">0.5</span><span class="ratio-caption">x-height / font size</span><span class="ratio-line"></span><span class="ratio-description">One fixed ratio.<br>Consistent proportions.</span></div>
+        </div>
+        <div id="theme-code" class="code-view" hidden><pre tabindex="0" role="region" aria-label="Independent theme CSS"><code><span class="syntax-selector">#independent-theme-container</span> {
+  font-family: <span id="theme-code-font">Georgia, serif</span>;
+  <span class="syntax-property">font-size-adjust</span>: <span class="syntax-value">0.5</span>;
+}</code></pre></div>
+        <div class="control-bar"><div class="adjust-info"><span class="mini-icon" aria-hidden="true">↕</span><code>font-size-adjust: <strong>0.5</strong>;</code></div><span class="locked"><span aria-hidden="true">▣</span> Proportions locked</span></div>
+      </div>
+      <p class="section-note"><span class="info-icon" aria-hidden="true">i</span><span>A numeric value sets the x-height ratio explicitly, giving this theme its own consistent proportions.</span></p>
+    </section>
+    <aside class="takeaway"><span class="takeaway-icon" aria-hidden="true">✧</span><div><strong>Small adjustment. Better reading.</strong><p>No manual font sizing. No guesswork. Just a little CSS that lets your type work together.</p></div><code>font-size-adjust</code></aside>
+    <footer><span>Made for the details.</span><span>A tiny exploration of modern CSS <span class="footer-spark" aria-hidden="true">✳</span></span></footer>
+  </main>
+</body>
+</html>
