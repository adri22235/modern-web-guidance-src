+  <script>
+    (() => {
+      const list = document.querySelector('.SwipeableList');
+      const handles = new WeakMap();
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+      const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+        for (const { target } of entries) target.scrollLeft = target.clientWidth;
+      }) : null;
+      const viewportObserver = new IntersectionObserver(entries => {
+        for (const { target: item, isIntersecting } of entries) {
+          if (item.classList.contains('is-removing')) continue;
+          const handle = handles.get(item);
+          if (isIntersecting) {
+            const active = handle || setupItem(item);
+            active.observer.observe(active.content);
+          } else {
+            handle?.observer.unobserve(handle.content);
+          }
+        }
+      });
+
+      function setupItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = track.querySelector('.SwipeableList-content');
+        item.classList.add('is-initialized');
+        // Center before observation so initialization cannot count as a swipe.
+        if (needsScrollWorkaround) {
+          track.scrollLeft = track.clientWidth;
+          resizeObserver.observe(track);
+        }
+        const observer = new IntersectionObserver(entries => {
+          const entry = entries[entries.length - 1];
+          if (!entry.rootBounds || item.classList.contains('is-removing')) return;
+          const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+          if (offset !== 0) item.dataset.swipeDirection = offset > 0 ? 'left' : 'right';
+          item.classList.toggle('is-activating', entry.intersectionRatio < 0.8);
+          if (entry.intersectionRatio < 0.2) removeItem(item);
+        }, { root: track, threshold: [0.2, 0.8] });
+        const handle = { observer, content };
+        handles.set(item, handle);
+        return handle;
+      }
+
+      async function removeItem(item) {
+        if (item.classList.contains('is-removing')) return;
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        const height = item.getBoundingClientRect().height;
+        const offset = content.getBoundingClientRect().x - track.getBoundingClientRect().x;
+        const slide = offset > 0 ? track.clientWidth - offset : -(track.clientWidth + offset);
+        const remaining = [...list.children].filter(row => row !== item && !row.classList.contains('is-removing'));
+        if (item.contains(document.activeElement)) {
+          const next = remaining.find(row => item.compareDocumentPosition(row) & Node.DOCUMENT_POSITION_FOLLOWING)
+            || remaining[remaining.length - 1];
+          (next?.querySelector('.cart-remove') || document.getElementById('cart-title')).focus({ preventScroll: true });
+        }
+        viewportObserver.unobserve(item);
+        resizeObserver?.unobserve(track);
+        handles.get(item)?.observer.disconnect();
+        item.classList.add('is-removing');
+        item.inert = true;
+        document.getElementById('cart-count').textContent = `${remaining.length} ${remaining.length === 1 ? 'item' : 'items'}`;
+        const cents = remaining.reduce((sum, row) => sum + Number(row.dataset.price), 0);
+        document.getElementById('cart-total').textContent = new Intl.NumberFormat('en-US', {
+          style: 'currency', currency: 'USD'
+        }).format(cents / 100);
+        document.getElementById('cart-status').textContent = `${item.dataset.name} removed from your cart.`;
+        const options = { duration: reducedMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+        await Promise.allSettled([
+          item.animate([{ height: `${height}px` }, { height: '0px' }], options).finished,
+          content.animate([{ translate: '0px' }, { translate: `${slide}px` }], options).finished
+        ]);
+        const activeItems = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        list.hidden = activeItems.length === 0;
+        document.getElementById('cart-empty').hidden = activeItems.length !== 0;
+        // Let Safari's gesture momentum settle before detaching the collapsed row.
+        if (globalThis.GestureEvent) setTimeout(() => item.remove(), 5000);
+        else item.remove();
+      }
+
+      for (const item of list.children) viewportObserver.observe(item);
+      list.addEventListener('click', event => {
+        const button = event.target.closest('.cart-remove');
+        if (button) removeItem(button.closest('.SwipeableList-item'));
+      });
+    })();
+  </script>
+
