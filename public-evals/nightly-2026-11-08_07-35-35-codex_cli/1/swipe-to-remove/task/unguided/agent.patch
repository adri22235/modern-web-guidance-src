+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const name = item.querySelector('h3').textContent;
+      const moveFocus = item.contains(document.activeElement);
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-removing');
+      item.inert = true;
+      content.style.transform = `translateX(${direction * content.offsetWidth}px)`;
+
+      // Keep the action color visible during the exit, then close the space.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(() => {
+          const nextButton = item.nextElementSibling?.querySelector('button')
+            || item.previousElementSibling?.querySelector('button');
+          item.remove();
+          const remaining = [...cartList.querySelectorAll('.SwipeableList-item')];
+          document.querySelector('#cart-count').textContent = `${remaining.length} ${remaining.length === 1 ? 'item' : 'items'}`;
+          document.querySelector('#cart-subtotal').textContent = currency.format(
+            remaining.reduce((sum, row) => sum + Number(row.dataset.price), 0) / 100
+          );
+          document.querySelector('.cart-empty').hidden = remaining.length > 0;
+          document.querySelector('#cart-status').textContent = `${name} removed. ${remaining.length} ${remaining.length === 1 ? 'item remains' : 'items remain'}.`;
+          if (moveFocus) {
+            const target = nextButton || document.querySelector('#cart-title');
+            if (!nextButton) target.tabIndex = -1;
+            target.focus({ preventScroll: true });
+          }
+        }, reducedMotion.matches ? 0 : 280);
+      }, reducedMotion.matches ? 0 : 220);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach((item) => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(120, content.offsetWidth * 0.35);
+
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready', 'swiping-right');
+        content.style.transform = '';
+      };
+
+      content.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button')
+          || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, dx: 0, dragging: false };
+        content.setPointerCapture(event.pointerId);
+      });
+
+      content.addEventListener('pointermove', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            reset();
+            return;
+          }
+          if (Math.abs(dx) < 8) return;
+          gesture.dragging = true;
+          item.classList.add('is-dragging');
+        }
+        gesture.dx = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('swiping-right', dx > 0);
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+
+      content.addEventListener('pointerup', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const { dx, dragging } = gesture;
+        gesture = null;
+        if (dragging && Math.abs(dx) >= threshold()) {
+          removeCartItem(item, Math.sign(dx));
+        } else {
+          reset();
+        }
+      });
+
+      content.addEventListener('pointercancel', reset);
+      content.addEventListener('lostpointercapture', () => {
+        if (gesture) reset();
+      });
+      item.querySelector('.cart-remove').addEventListener('click', () => removeCartItem(item));
+    });
+  </script>
+
 </body>
 
