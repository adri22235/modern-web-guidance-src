@@ -0,0 +1,150 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
diff --git a/tests/security.test.mjs b/tests/security.test.mjs
new file mode 100644
index 0000000..2398885
--- /dev/null
+++ b/tests/security.test.mjs
@@ -0,0 +1,76 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+
+const read = (path) => readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+const html = read('index.html');
+const css = read('styles.css');
+const headerFile = read('_headers');
+const headers = Object.fromEntries(
+  headerFile.trim().split('\n').slice(1).map((line) => {
+    const separator = line.indexOf(':');
+    return [line.slice(0, separator).trim(), line.slice(separator + 1).trim()];
+  }),
+);
+const parsePolicy = (policy) => Object.fromEntries(
+  policy.split(';').map((directive) => directive.trim().split(/\s+/))
+    .map(([name, ...values]) => [name, values.join(' ')]),
+);
+const policy = parsePolicy(headers['Content-Security-Policy']);
+
+test('HTML fallback matches the HTTP policy except for header-only frame-ancestors', () => {
+  const meta = html.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/);
+  assert.ok(meta, 'CSP fallback must be present');
+  assert.ok(meta.index < html.indexOf('<link'), 'CSP must precede resource loads');
+  const { 'frame-ancestors': frameAncestors, ...supportedInMeta } = policy;
+  assert.equal(frameAncestors, "'none'");
+  assert.deepEqual(parsePolicy(meta[1]), supportedInMeta);
+});
+
+test('policy denies execution, injection sinks, embedding, base changes, and form submission', () => {
+  for (const directive of [
+    'default-src', 'script-src', 'script-src-attr', 'style-src-attr',
+    'object-src', 'base-uri', 'form-action', 'trusted-types',
+  ]) assert.equal(policy[directive], "'none'", directive);
+  assert.equal(policy['require-trusted-types-for'], "'script'");
+  assert.equal(policy['style-src'], "'self'");
+  assert.equal(policy['img-src'], "'self' https://images.unsplash.com");
+  assert.doesNotMatch(headers['Content-Security-Policy'], /unsafe-inline|unsafe-eval|\*/);
+});
+
+test('markup stays compatible with script and inline-style restrictions', () => {
+  assert.doesNotMatch(html, /<\s*(?:script|style|base|iframe|object|embed|form)\b/i);
+  assert.doesNotMatch(html, /\s(?:on[a-z]+|style)\s*=/i);
+  assert.doesNotMatch(html, /(?:javascript|vbscript|data)\s*:/i);
+  const stylesheets = [...html.matchAll(/<link rel="stylesheet" href="([^"]+)">/g)];
+  assert.equal(stylesheets.length, 1);
+  assert.equal(stylesheets[0][1], '/styles.css');
+  assert.match(css, /\.section-title\s*\{\s*text-align: center;/);
+  for (const [, href] of html.matchAll(/\bhref="([^"]+)"/g)) {
+    assert.match(href, /^\/(?!\/)/, 'links must remain same-origin');
+  }
+});
+
+test('all CSS resources are allowed by the image policy without expanding origins', () => {
+  assert.doesNotMatch(css, /@import|expression\s*\(/i);
+  const images = [...css.matchAll(/url\(['"]?([^)'"\s]+)['"]?\)/g)];
+  assert.equal(images.length, 1);
+  for (const [, url] of images) {
+    assert.equal(new URL(url).origin, 'https://images.unsplash.com');
+  }
+});
+
+test('static hosting configurations apply identical headers to every route', () => {
+  assert.equal(headerFile.split('\n')[0], '/*');
+  const vercel = JSON.parse(read('vercel.json'));
+  assert.equal(vercel.headers.length, 1);
+  assert.equal(vercel.headers[0].source, '/(.*)');
+  assert.deepEqual(Object.fromEntries(vercel.headers[0].headers.map(({ key, value }) => [key, value])), headers);
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['Referrer-Policy'], 'no-referrer');
+  assert.match(html, /<meta name="referrer" content="no-referrer">/);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'usb']) {
+    assert.ok(headers['Permissions-Policy'].includes(`${feature}=()`));
+  }
+});
