@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import test from 'node:test';
+
+const root = new URL('../', import.meta.url);
+const read = (path) => readFile(new URL(path, root), 'utf8');
+function build(extra = {}) {
+  return spawnSync(process.execPath, ['scripts/build.mjs'], {
+    cwd: root,
+    env: { ...process.env, SECURITY_POLICY_MODE: 'enforce', SECURITY_REPORT_URL: '', ...extra },
+    encoding: 'utf8',
+  });
+}
+function success(extra) {
+  const result = build(extra);
+  assert.equal(result.status, 0, result.stderr);
+}
+
+test('static security policies and safe rollout builds', async (t) => {
+  try {
+    await t.test('enforced policy permits current assets without inline execution', async () => {
+      success();
+      const html = await read('dist/index.html');
+      const css = await read('dist/assets/styles.css');
+      const headers = await read('dist/_headers');
+      const csp = headers.match(/^  Content-Security-Policy: (.+)$/m)[1];
+      const fallback = html.match(/http-equiv="Content-Security-Policy" content="([^"]+)"/)[1];
+      assert.equal(csp, `${fallback}; frame-ancestors 'none'`);
+      for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+        "style-src-attr 'none'", "img-src https://images.unsplash.com", "base-uri 'none'",
+        "object-src 'none'", "form-action 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'"]) {
+        assert.ok(csp.split('; ').includes(directive), directive);
+      }
+      assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son[a-z]+\s*=|javascript:/i);
+      assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|nonce-/);
+      assert.ok(html.indexOf('http-equiv="Content-Security-Policy"') < html.indexOf('<link'));
+      assert.match(html, /href="\/assets\/styles.css"/);
+      assert.match(html, /<h2 class="section-title">Seasonal Favorites/);
+      assert.match(css, /\.section-title\s*\{\s*text-align: center;/);
+      assert.match(css, /url\('https:\/\/images.unsplash.com\//);
+      assert.match(headers, /X-Frame-Options: DENY/);
+      assert.match(headers, /X-Content-Type-Options: nosniff/);
+      assert.match(headers, /Referrer-Policy: strict-origin-when-cross-origin/);
+      assert.match(headers, /Permissions-Policy: camera=\(\), microphone=\(\), geolocation=\(\)/);
+      assert.match(headers, /Cross-Origin-Opener-Policy: same-origin-allow-popups/);
+      assert.match(headers, /Cross-Origin-Resource-Policy: same-origin/);
+      assert.match(headers, /Strict-Transport-Security: max-age=300/);
+      assert.doesNotMatch(headers, /Cross-Origin-Embedder-Policy|Reporting-Endpoints|Report-Only/);
+    });
+
+    await t.test('report-only does not accidentally enforce the candidate via meta', async () => {
+      success({ SECURITY_POLICY_MODE: 'report-only', SECURITY_REPORT_URL: 'https://reports.example.test/csp' });
+      const html = await read('dist/index.html');
+      const headers = await read('dist/_headers');
+      assert.doesNotMatch(html, /http-equiv="Content-Security-Policy"/);
+      assert.match(headers, /^  Content-Security-Policy: frame-ancestors 'none'$/m);
+      assert.match(headers, /^  Content-Security-Policy-Report-Only: default-src 'none';/m);
+      assert.match(headers, /report-to security; report-uri https:\/\/reports.example.test\/csp/);
+      assert.match(headers, /Reporting-Endpoints: security="https:\/\/reports.example.test\/csp"/);
+    });
+
+    await t.test('enforcement retains configured reporting', async () => {
+      success({ SECURITY_REPORT_URL: 'https://reports.example.test/csp' });
+      const headers = await read('dist/_headers');
+      assert.match(headers, /^  Content-Security-Policy: .*; report-to security; report-uri https:\/\/reports.example.test\/csp$/m);
+      assert.doesNotMatch(headers, /Content-Security-Policy-Report-Only/);
+    });
+
+    await t.test('invalid rollout settings fail before publishing', () => {
+      assert.notEqual(build({ SECURITY_POLICY_MODE: 'off' }).status, 0);
+      for (const url of ['http://reports.example.test/csp', 'https://user:pass@reports.example.test/csp',
+        'https://reports.example.test/csp?token=secret', 'https://reports.example.test/csp#secret',
+        'https://reports.example.test/csp\nX-Injected: yes', 'https://reports.example.test/a;b',
+        'https://reports.example.test/"bad', 'not-a-url']) {
+        assert.notEqual(build({ SECURITY_REPORT_URL: url }).status, 0, url);
+      }
+    });
+  } finally {
+    // Leave the deployable artifact in the safe default mode.
+    success();
+  }
+});
