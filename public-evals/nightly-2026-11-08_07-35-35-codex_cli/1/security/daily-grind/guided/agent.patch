@@ -0,0 +1,48 @@
+import { cp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+
+// Build static files only. This module never starts or imports a server.
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+const mode = process.env.SECURITY_POLICY_MODE ?? 'enforce';
+if (!['enforce', 'report-only'].includes(mode)) {
+  throw new Error('SECURITY_POLICY_MODE must be enforce or report-only');
+}
+
+let reportURL;
+if (process.env.SECURITY_REPORT_URL) {
+  const value = process.env.SECURITY_REPORT_URL;
+  const url = new URL(value);
+  // URLs appear in HTTP header syntax. Reject delimiters, credentials, and secrets.
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash ||
+      /[\s"<>;\\]/u.test(value)) {
+    throw new Error('SECURITY_REPORT_URL must be an HTTPS URL without credentials, query, fragment, or header delimiters');
+  }
+  reportURL = url.href;
+}
+
+let html = await readFile(new URL('index.html', root), 'utf8');
+let headers = await readFile(new URL('_headers', root), 'utf8');
+const policy = headers.match(/^  Content-Security-Policy: (.+)$/m)?.[1];
+if (!policy) throw new Error('Missing deployment CSP');
+const meta = /  <meta http-equiv="Content-Security-Policy" content="[^"]*">\n/;
+if (!meta.test(html)) throw new Error('Missing HTML CSP fallback');
+
+if (mode === 'report-only') {
+  // Meta CSP cannot be report-only. Keep only the independent framing baseline.
+  html = html.replace(meta, '');
+  headers = headers.replace(`  Content-Security-Policy: ${policy}`,
+    `  Content-Security-Policy: frame-ancestors 'none'\n  Content-Security-Policy-Report-Only: ${policy}`);
+}
+if (reportURL) {
+  const name = mode === 'enforce' ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only';
+  headers = headers.replace(new RegExp(`^  ${name}: (.+)$`, 'm'),
+    (_, value) => `  ${name}: ${value}; report-to security; report-uri ${reportURL}`);
+  headers += `  Reporting-Endpoints: security="${reportURL}"\n`;
+}
+
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+await cp(new URL('assets/', root), new URL('assets/', output), { recursive: true });
+await writeFile(new URL('index.html', output), html);
+await writeFile(new URL('_headers', output), headers);
+console.log(`Built static site with ${mode} CSP${reportURL ? ' and violation reporting' : ''}.`);
