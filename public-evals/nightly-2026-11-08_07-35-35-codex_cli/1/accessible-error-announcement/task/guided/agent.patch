+  <script>
+    const newsletter = document.getElementById('newsletter');
+    const email = document.getElementById('newsletter-email');
+    const error = document.getElementById('newsletter-error');
+    const status = document.getElementById('newsletter-status');
+
+    function syncEmailError() {
+      // Use the same post-interaction state as the visual field styling.
+      // Keep the live region mounted and empty until an error is visible.
+      const showError = email.matches(':user-invalid');
+      const message = showError ? 'Please enter a valid email address, such as you@example.com.' : '';
+
+      if (error.textContent !== message) error.textContent = message;
+      if (showError) {
+        email.setAttribute('aria-invalid', 'true');
+        email.setAttribute('aria-describedby', 'newsletter-error');
+      } else {
+        email.removeAttribute('aria-invalid');
+        email.removeAttribute('aria-describedby');
+      }
+    }
+
+    function syncAfterInteraction() {
+      // Blur and native validation can update :user-invalid after dispatch.
+      requestAnimationFrame(syncEmailError);
+    }
+
+    for (const event of ['focus', 'blur', 'change', 'invalid']) {
+      email.addEventListener(event, syncAfterInteraction);
+    }
+
+    email.addEventListener('input', () => {
+      status.textContent = '';
+      syncEmailError(); // Clear both the message and ARIA state immediately when valid.
+      syncAfterInteraction();
+    });
+
+    newsletter.addEventListener('reset', () => {
+      status.textContent = '';
+      syncAfterInteraction();
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      // This static site has no subscription endpoint configured yet.
+      status.textContent = 'Online signup is coming soon. Please contact us to subscribe.';
+    });
+  </script>
+
 </body>
 
