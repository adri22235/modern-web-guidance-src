+        if (result?.authenticated === true && !busy) {
+          showSignedIn(result.user);
+          if (destination) { window.location.assign(destination); destination = null; }
+        }
+      })
+      .catch(() => { /* Visitors can keep browsing when sign-in is unavailable. */ });
+    prepareQuickSignIn();
+  </script>
 </body>
 
 </html>
