+  <script>
+    const carousel = document.querySelector('.drink-carousel');
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const cards = [...carousel.querySelectorAll('.card')];
+
+    function updateControls() {
+      previous.disabled = carousel.scrollLeft <= 2;
+      next.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 2;
+    }
+    function moveCarousel(direction) {
+      const step = cards[1].offsetLeft - cards[0].offsetLeft;
+      carousel.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    }
+    previous.addEventListener('click', () => moveCarousel(-1));
+    next.addEventListener('click', () => moveCarousel(1));
+    carousel.addEventListener('scroll', updateControls, { passive: true });
+    new ResizeObserver(updateControls).observe(carousel);
+    carousel.addEventListener('keydown', (event) => {
+      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+      event.preventDefault();
+      if (event.key === 'Home' || event.key === 'End') {
+        carousel.scrollTo({ left: event.key === 'Home' ? 0 : carousel.scrollWidth, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      } else {
+        moveCarousel(event.key === 'ArrowRight' ? 1 : -1);
+      }
+    });
+    updateControls();
+
+    const drinks = {
+      maple: { title: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup. A mellow, comforting cup with a gently sweet finish.', note: 'Featuring oat milk and Vermont maple syrup.', href: '/menu/seasonal' },
+      espresso: { title: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost. Enjoy the deep character and concentrated flavor of our dark roast.', note: 'For those who love a bold coffee flavor.', href: '/menu/espresso' },
+      coldbrew: { title: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness. Slow brewing brings out a rounded coffee flavor for a refreshing sip.', note: 'Slow-steeped for 18 hours.', href: '/menu/cold-brew' }
+    };
+    const dialog = document.querySelector('#drink-details');
+    const content = dialog.querySelector('.dialog-content');
+    let activeTrigger;
+    let transition;
+    let closing = false;
+
+    function buttonTransform() {
+      const source = activeTrigger.getBoundingClientRect();
+      const target = dialog.getBoundingClientRect();
+      return `translate(${source.left - target.left}px, ${source.top - target.top}px) scale(${source.width / target.width}, ${source.height / target.height})`;
+    }
+    document.querySelectorAll('.details-button').forEach((button) => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        activeTrigger = button;
+        document.querySelector('#detail-title').textContent = drink.title;
+        document.querySelector('#detail-description').textContent = drink.description;
+        document.querySelector('#detail-note').textContent = drink.note;
+        document.querySelector('#detail-menu-link').href = drink.href;
+        button.setAttribute('aria-expanded', 'true');
+        dialog.showModal();
+        if (!reducedMotion.matches) {
+          transition = dialog.animate([
+            { transform: buttonTransform(), opacity: 0.5, borderRadius: '5px' },
+            { transform: 'none', opacity: 1, borderRadius: '16px' }
+          ], { duration: 420, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
+          content.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 260, delay: 120, fill: 'backwards' });
+        }
+      });
+    });
+    async function closeDetails() {
+      if (closing || !dialog.open) return;
+      closing = true;
+      // Finish the opening motion before measuring the return destination.
+      if (transition) transition.finish();
+      if (!reducedMotion.matches) {
+        transition = dialog.animate([
+          { transform: 'none', opacity: 1 },
+          { transform: buttonTransform(), opacity: 0, borderRadius: '5px' }
+        ], { duration: 240, easing: 'ease-in' });
+        await transition.finished;
+      }
+      dialog.close();
+      activeTrigger.setAttribute('aria-expanded', 'false');
+      activeTrigger.focus({ preventScroll: true });
+      closing = false;
+      transition = null;
+    }
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeDetails(); });
+    dialog.addEventListener('click', (event) => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDetails();
+    });
+  </script>
