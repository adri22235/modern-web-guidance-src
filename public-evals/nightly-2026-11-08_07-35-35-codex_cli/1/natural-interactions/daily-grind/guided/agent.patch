+  <script>
+    const scroller = document.querySelector('#seasonal-drinks');
+    const cards = [...scroller.querySelectorAll('.card')];
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateControls() {
+      previous.setAttribute('aria-disabled', scroller.scrollLeft <= 1);
+      next.setAttribute('aria-disabled', scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 1);
+    }
+
+    function moveDrinks(direction) {
+      const control = direction < 0 ? previous : next;
+      if (control.getAttribute('aria-disabled') === 'true') return;
+      const step = cards[1].offsetLeft - cards[0].offsetLeft;
+      scroller.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    }
+
+    previous.addEventListener('click', () => moveDrinks(-1));
+    next.addEventListener('click', () => moveDrinks(1));
+    scroller.addEventListener('scroll', updateControls, { passive: true });
+    new ResizeObserver(updateControls).observe(scroller);
+    updateControls();
+
+    const dialog = document.querySelector('#drink-details');
+    let openingAnimation;
+    document.querySelectorAll('.details-trigger').forEach(button => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        const origin = button.getBoundingClientRect();
+        document.querySelector('#detail-title').textContent = card.querySelector('h3').textContent;
+        document.querySelector('#detail-summary').textContent = card.querySelector('p').textContent;
+        document.querySelector('#detail-copy').replaceChildren(card.querySelector('template').content.cloneNode(true));
+        const menuLink = document.querySelector('#detail-menu-link');
+        menuLink.href = button.dataset.menuHref;
+        menuLink.setAttribute('aria-label', `Explore menu for ${card.querySelector('h3').textContent}`);
+        dialog.showModal();
+
+        if (!reducedMotion.matches) {
+          const destination = dialog.getBoundingClientRect();
+          // Map the dialog's initial bounds to this specific button, then expand to its final size.
+          openingAnimation = dialog.animate([
+            { transform: `translate(${origin.left - destination.left}px, ${origin.top - destination.top}px) scale(${origin.width / destination.width}, ${origin.height / destination.height})`, opacity: 0.35 },
+            { transform: 'translate(0, 0) scale(1)', opacity: 1 }
+          ], { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
+        }
+      });
+    });
+
+    dialog.addEventListener('close', () => {
+      openingAnimation?.cancel();
+      dialog.returnValue = '';
+    });
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) openingAnimation?.cancel();
+    });
+  </script>
