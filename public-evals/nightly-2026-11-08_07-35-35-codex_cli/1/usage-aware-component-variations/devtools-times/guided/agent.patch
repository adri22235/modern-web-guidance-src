+---
+import Icon from './EditorialIcon.astro';
+interface Props { id: string; title: string; category: string; image?: string; description?: string; author?: string; minutes?: number; time?: string; }
+const { id, title, category, image, description, author, minutes = 4, time } = Astro.props;
+const base = import.meta.env.BASE_URL;
+---
+<article class="context-card" data-category={category.toLowerCase()} data-story={id} data-title={title}>
+  {image && <img src={`${base}${image.replace(/^\//, '')}`} alt="" width="800" height="500" loading="lazy" />}
+  <header>
+    <div class="story-eyebrow"><span class="category-label">{category}</span>{time && <time>{time}</time>}</div>
+    <h3><a class="story-link" href={`${base}articles/${id}`}>{title}</a></h3>
+  </header>
+  {description && <p>{description}</p>}
+  <footer><span>{author ? <><b>{author}</b><span class="meta-dot">·</span></> : null}{minutes} min read</span><button class="save-button" data-save={id} data-title={title} aria-label={`Save ${title}`} aria-pressed="false"><Icon name="bookmark" size={17}/></button></footer>
+</article>
