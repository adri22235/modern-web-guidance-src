+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menuGrid = document.getElementById('seasonal-favorites-grid');
+    const supportsHighlights = Boolean(window.CSS?.highlights && window.Highlight);
+
+    function collectMenuText() {
+      const nodes = [];
+      menuGrid.querySelectorAll('.card').forEach((card) => {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+      });
+      return nodes;
+    }
+
+    const menuTextNodes = collectMenuText();
+
+    searchInput.addEventListener('input', () => {
+      // Clear the previous query before finding any new matches.
+      if (supportsHighlights) {
+        CSS.highlights.delete('menu-search');
+      } else {
+        menuGrid.querySelectorAll('mark.search-match').forEach((mark) => {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        menuGrid.normalize();
+      }
+
+      const query = searchInput.value.toLowerCase();
+      if (!query.trim()) return;
+
+      const ranges = [];
+      const nodes = supportsHighlights ? menuTextNodes : collectMenuText();
+      nodes.forEach((node) => {
+        const text = node.textContent;
+        const lowerText = text.toLowerCase();
+        let start = lowerText.indexOf(query);
+        if (start === -1) return;
+
+        const fragment = document.createDocumentFragment();
+        let end = 0;
+        while (start !== -1) {
+          if (supportsHighlights) {
+            const range = document.createRange();
+            range.setStart(node, start);
+            range.setEnd(node, start + query.length);
+            ranges.push(range);
+          } else {
+            fragment.append(text.slice(end, start));
+            const mark = document.createElement('mark');
+            mark.className = 'search-match';
+            mark.textContent = text.slice(start, start + query.length);
+            fragment.append(mark);
+          }
+          end = start + query.length;
+          start = lowerText.indexOf(query, end);
+        }
+        if (!supportsHighlights) {
+          fragment.append(text.slice(end));
+          node.replaceWith(fragment);
+        }
+      });
+
+      if (supportsHighlights) {
+        CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+    });
+  </script>
+
