+
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root) {
+        animation: page-out 280ms ease-in-out both;
+      }
+
+      ::view-transition-new(root) {
+        animation: page-in 280ms ease-in-out both;
+      }
+
+      html:active-view-transition-type(next) {
+        --page-exit: -40px;
+        --page-enter: 40px;
+      }
+
+      html:active-view-transition-type(previous) {
+        --page-exit: 40px;
+        --page-enter: -40px;
+      }
+
+      @keyframes page-out {
+        to {
+          opacity: 0;
+          transform: translateX(var(--page-exit, 0px));
+        }
+      }
+
+      @keyframes page-in {
+        from {
+          opacity: 0;
+          transform: translateX(var(--page-enter, 0px));
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      nav a, .btn {
+        transition: none;
+      }
+    }
