+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const drinks = document.getElementById('favorites-drinks');
+    const cards = [...drinks.querySelectorAll('.card')];
+    const status = document.getElementById('favorites-status');
+    const buttons = [...toolbar.querySelectorAll('button')];
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+
+    // One tab stop for the toolbar; arrow keys move between its controls.
+    toolbar.addEventListener('keydown', (event) => {
+      const current = buttons.indexOf(document.activeElement);
+      if (current < 0) return;
+      let next;
+      if (event.key === 'ArrowRight') next = (current + 1) % buttons.length;
+      if (event.key === 'ArrowLeft') next = (current - 1 + buttons.length) % buttons.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = buttons.length - 1;
+      if (next === undefined) return;
+      event.preventDefault();
+      buttons[next].focus();
+    });
+    toolbar.addEventListener('focusin', (event) => {
+      if (!buttons.includes(event.target)) return;
+      buttons.forEach((button) => { button.tabIndex = button === event.target ? 0 : -1; });
+    });
+
+    toolbar.querySelectorAll('[data-view]').forEach((button) => {
+      button.addEventListener('click', () => {
+        drinks.classList.toggle('list-view', button.dataset.view === 'list');
+        toolbar.querySelectorAll('[data-view]').forEach((view) => {
+          view.setAttribute('aria-pressed', String(view === button));
+        });
+      });
+    });
+
+    document.getElementById('favorites-details-toggle').addEventListener('click', (event) => {
+      const hidden = drinks.classList.toggle('hide-details');
+      event.currentTarget.setAttribute('aria-pressed', String(!hidden));
+    });
+
+    function applyFilter() {
+      cards.forEach((card) => {
+        card.hidden = !filters.hidden && temperature.value !== 'all' &&
+          card.dataset.temperature !== temperature.value;
+      });
+      status.textContent = `${cards.filter((card) => !card.hidden).length} featured drinks shown.`;
+    }
+
+    document.getElementById('favorites-filters-toggle').addEventListener('click', (event) => {
+      filters.hidden = !filters.hidden;
+      event.currentTarget.setAttribute('aria-pressed', String(!filters.hidden));
+      event.currentTarget.setAttribute('aria-expanded', String(!filters.hidden));
+      applyFilter();
+    });
+    temperature.addEventListener('change', applyFilter);
+
+    document.getElementById('favorites-copy').addEventListener('click', async () => {
+      const text = 'Seasonal Favorites\n' + cards.map((card) =>
+        `${card.querySelector('h3').textContent} — ${card.querySelector('p').textContent}`
+      ).join('\n');
+      try {
+        await navigator.clipboard.writeText(text);
+        status.textContent = 'Featured drinks list copied.';
+      } catch {
+        status.textContent = 'Could not copy the list. Please select and copy the drink text manually.';
+      }
+    });
+  </script>
