+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const drinks = document.getElementById('favorites-drinks');
+    const cards = [...drinks.querySelectorAll('.card')];
+    const controls = [...toolbar.querySelectorAll('button')];
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+    const status = document.getElementById('favorites-status');
+
+    toolbar.querySelectorAll('[data-view]').forEach(button => {
+      button.addEventListener('click', () => {
+        drinks.dataset.view = button.dataset.view;
+        toolbar.querySelectorAll('[data-view]').forEach(control => {
+          control.setAttribute('aria-pressed', String(control === button));
+        });
+      });
+    });
+    document.getElementById('favorites-details-toggle').addEventListener('click', event => {
+      const button = event.currentTarget;
+      const show = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(show));
+      cards.forEach(card => { card.querySelector('p').hidden = !show; });
+    });
+    function filterDrinks() {
+      cards.forEach(card => {
+        card.hidden = !filters.hidden && temperature.value !== 'all' &&
+          card.dataset.temperature !== temperature.value;
+      });
+    }
+    document.getElementById('favorites-filters-toggle').addEventListener('click', event => {
+      const button = event.currentTarget;
+      filters.hidden = !filters.hidden;
+      button.setAttribute('aria-pressed', String(!filters.hidden));
+      button.setAttribute('aria-expanded', String(!filters.hidden));
+      filterDrinks();
+    });
+    temperature.addEventListener('change', filterDrinks);
+
+    let feedbackTimer;
+    let lastMessage = '';
+    async function copyDrinks() {
+      const text = 'Seasonal Favorites\n\n' + cards.map(card =>
+        card.querySelector('h3').textContent + ' — ' + card.querySelector('p').textContent
+      ).join('\n');
+      let message;
+      try {
+        await navigator.clipboard.writeText(text);
+        message = 'Featured drinks list copied.';
+      } catch {
+        message = 'Could not copy the list. Please try again or copy the drink names manually.';
+      }
+      clearTimeout(feedbackTimer);
+      if (message === lastMessage) message += '\u00a0';
+      lastMessage = message;
+      status.textContent = message;
+      feedbackTimer = setTimeout(() => { status.textContent = ''; }, 5000);
+    }
+    if ('CommandEvent' in window) {
+      drinks.addEventListener('command', event => {
+        if (event.command === '--copy') copyDrinks();
+      });
+    } else {
+      toolbar.querySelector('[command="--copy"]').addEventListener('click', copyDrinks);
+    }
+
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      controls.forEach((button, index) => { button.tabIndex = index ? -1 : 0; });
+      toolbar.addEventListener('focusin', event => {
+        if (controls.includes(event.target)) {
+          controls.forEach(button => { button.tabIndex = button === event.target ? 0 : -1; });
+        }
+      });
+      toolbar.addEventListener('keydown', event => {
+        const index = controls.indexOf(document.activeElement);
+        if (index < 0) return;
+        const rtl = getComputedStyle(toolbar).direction === 'rtl';
+        let next;
+        if (event.key === 'ArrowRight') next = index + (rtl ? -1 : 1);
+        else if (event.key === 'ArrowLeft') next = index + (rtl ? 1 : -1);
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = controls.length - 1;
+        else return;
+        event.preventDefault();
+        controls[(next + controls.length) % controls.length].focus();
+      });
+    }
+    if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+      controls.forEach((button, index) => {
+        const tooltip = document.createElement('div');
+        tooltip.id = `favorites-tooltip-${index}`;
+        tooltip.textContent = button.title;
+        tooltip.setAttribute('popover', 'hint');
+        button.setAttribute('interestfor', tooltip.id);
+        button.removeAttribute('title');
+        document.body.append(tooltip);
+      });
+    }
+  </script>
+
 </body>
 
