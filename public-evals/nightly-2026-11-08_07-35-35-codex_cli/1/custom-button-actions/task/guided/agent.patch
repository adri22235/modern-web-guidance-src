+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = new Map([
+      ['--spin', 'is-spun'],
+      ['--grow', 'is-grown'],
+      ['--round', 'is-rounded'],
+    ]);
+    const toggleButtons = document.querySelectorAll('button[commandfor="action-target"][aria-pressed]');
+
+    // Native command events do not bubble, so listen directly on the target.
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command === '--reset') {
+        actionTarget.classList.remove(...commandClasses.values());
+      } else if (commandClasses.has(event.command)) {
+        actionTarget.classList.toggle(commandClasses.get(event.command));
+      } else {
+        return;
+      }
+
+      toggleButtons.forEach((button) => {
+        button.setAttribute('aria-pressed', String(
+          actionTarget.classList.contains(commandClasses.get(button.getAttribute('command')))
+        ));
+      });
+    });
+
+    // Preserve the same declarative routing in browsers without invoker commands.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[commandfor="action-target"]');
+        if (!button || button.disabled || event.defaultPrevented) return;
+        const commandEvent = new Event('command');
+        Object.assign(commandEvent, { command: button.getAttribute('command'), source: button });
+        actionTarget.dispatchEvent(commandEvent);
+      });
+    }
+  </script>
+
