+  <script>
+    (() => {
+      const storageKey = 'daily-grind.coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preferences-status');
+
+      // These are a wall-clock time (HH:mm) and calendar date (YYYY-MM-DD),
+      // not instants. Keep the input strings verbatim: never convert them to
+      // Date objects, UTC, timestamps, or a device time zone.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string') {
+            timeInput.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversaryDate === 'string') {
+            dateInput.value = saved.coffeeAnniversaryDate;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still choose your preferences below.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: timeInput.value,
+            coffeeAnniversaryDate: dateInput.value
+          }));
+          status.textContent = 'Preferences saved.';
+        } catch {
+          status.textContent = 'Preferences could not be saved in this browser. Please enable browser storage and try again.';
+        }
+      });
+    })();
+  </script>
