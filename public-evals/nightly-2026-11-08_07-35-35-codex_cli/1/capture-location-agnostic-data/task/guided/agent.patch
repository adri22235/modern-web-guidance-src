+  <script>
+    (() => {
+      const storageKey = 'daily-grind.coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preferences-status');
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        // Native inputs sanitize malformed stored strings without time zone conversion.
+        if (typeof saved?.pickupReminderTime === 'string') {
+          timeInput.value = saved.pickupReminderTime;
+        }
+        if (typeof saved?.coffeeAnniversaryDate === 'string') {
+          dateInput.value = saved.coffeeAnniversaryDate;
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can select them again.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        // These are floating calendar values, never instants. Use Temporal Plain
+        // types where available; otherwise retain the native input's ISO strings.
+        // The string fallback needs no date arithmetic or time zone polyfill.
+        let pickupReminderTime = timeInput.value;
+        let coffeeAnniversaryDate = dateInput.value;
+        try {
+          if (globalThis.Temporal?.PlainTime && globalThis.Temporal?.PlainDate) {
+            if (pickupReminderTime) {
+              pickupReminderTime = Temporal.PlainTime.from(pickupReminderTime)
+                .toString({ smallestUnit: 'minute' });
+            }
+            if (coffeeAnniversaryDate) {
+              coffeeAnniversaryDate = Temporal.PlainDate.from(coffeeAnniversaryDate).toString();
+            }
+          }
+          // Persist HH:mm and YYYY-MM-DD, with no UTC offset or time zone attached.
+          localStorage.setItem(storageKey, JSON.stringify({ pickupReminderTime, coffeeAnniversaryDate }));
+          status.textContent = 'Preferences saved in this browser. Your selected time and date stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Please try again; your selections are still shown.';
+        }
+      });
+    })();
+  </script>
+
