@@ -0,0 +1,56 @@
+import { mkdir, readFile, writeFile, copyFile, rm } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import { getDomain } from 'tldts';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const { values } = parseArgs({ options: {
+  'old-origin': { type: 'string' }, 'new-origin': { type: 'string' },
+  'old-id': { type: 'string', default: '/' },
+  'old-start-url': { type: 'string', default: '/' },
+} });
+
+function origin(input, name) {
+  if (!input) throw new Error(`Supply --${name}=https://your-hostname (no deployment origins are assumed).`);
+  const url = new URL(input);
+  if (url.protocol !== 'https:' || url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
+    throw new Error(`${name} must be an HTTPS origin without credentials, path, query or fragment.`);
+  }
+  return url.origin;
+}
+const oldOrigin = origin(values['old-origin'], 'old-origin');
+const newOrigin = origin(values['new-origin'], 'new-origin');
+const oldSite = getDomain(new URL(oldOrigin).hostname, { allowPrivateDomains: true });
+const newSite = getDomain(new URL(newOrigin).hostname, { allowPrivateDomains: true });
+if (oldOrigin === newOrigin || !oldSite || oldSite !== newSite) {
+  throw new Error('Migration requires distinct HTTPS origins with the same registrable domain (including private suffixes).');
+}
+function oldUrl(value) {
+  const url = new URL(value, `${oldOrigin}/`);
+  if (url.origin !== oldOrigin || url.username || url.password || url.hash) throw new Error('Old app ID and start URL must belong to the old origin and have no fragment.');
+  return url.href;
+}
+const oldId = oldUrl(values['old-id']);
+const oldStartUrl = oldUrl(values['old-start-url']);
+const manifest = JSON.parse(await readFile(`${root}manifest.webmanifest`, 'utf8'));
+const files = ['index.html', 'app.js', 'settings.js', 'transfer.html', 'transfer.js', 'icon.svg'];
+// Validate all inputs before replacing generated output.
+await rm(`${root}dist`, { recursive: true, force: true });
+for (const role of ['old', 'new']) {
+  const dir = `${root}dist/${role}`;
+  await mkdir(dir, { recursive: true });
+  for (const file of files) await copyFile(`${root}${file}`, `${dir}/${file}`);
+  await writeFile(`${dir}/migration-config.js`, `export default ${JSON.stringify({ role, oldOrigin, newOrigin })};\n`);
+  const appManifest = role === 'old'
+    ? { ...manifest, id: oldId, start_url: oldStartUrl,
+      migrate_to: { id: `${newOrigin}/`, install_url: `${newOrigin}/` } }
+    : { ...manifest, migrate_from: [{ id: oldId, install_url: `${oldOrigin}/`, behavior: 'suggest' }] };
+  await writeFile(`${dir}/manifest.webmanifest`, JSON.stringify(appManifest, null, 2));
+  if (role === 'old') {
+    await mkdir(`${dir}/.well-known`, { recursive: true });
+    await writeFile(`${dir}/.well-known/web-app-origin-association`, JSON.stringify({
+      [`${newOrigin}/`]: { allow_migration: true },
+    }, null, 2));
+  }
+}
+console.log('Generated dist/old and dist/new. Deploy each bundle at the root of its configured HTTPS origin.');
