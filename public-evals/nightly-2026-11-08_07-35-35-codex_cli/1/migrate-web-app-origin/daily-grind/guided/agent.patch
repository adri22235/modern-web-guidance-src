+++ b/transfer.js
@@ -0,0 +1,35 @@
+import config from './migration-config.js';
+import { readSettings, trustedMessage } from './settings.js';
+
+const status = document.querySelector('#transfer-status');
+const nonce = location.hash.slice(1);
+if (config?.role !== 'old' || location.origin !== config.oldOrigin ||
+    !window.opener || !/^[a-f0-9-]{36}$/.test(nonce)) {
+  status.textContent = 'Start the transfer using “Import my settings” at the new Daily Grind address.';
+} else {
+  const receiver = window.opener;
+  let sent = false;
+  const timeout = setTimeout(() => {
+    window.removeEventListener('message', receive);
+    status.textContent = 'The transfer expired. Close this window and try again from the new address.';
+  }, 30000);
+  function receive(event) {
+    if (!trustedMessage(event, receiver, config.newOrigin) || event.data?.nonce !== nonce) return;
+    if (event.data.type === 'daily-grind:request' && !sent) {
+      sent = true;
+      try {
+        receiver.postMessage({ type: 'daily-grind:preferences', nonce, preferences: readSettings(localStorage) }, config.newOrigin);
+        status.textContent = 'Preferences sent. Waiting for the new address to save them…';
+      } catch {
+        receiver.postMessage({ type: 'daily-grind:error', nonce }, config.newOrigin);
+        status.textContent = 'Preferences could not be read. Return to the previous app to export a backup.';
+      }
+    } else if (event.data.type === 'daily-grind:complete' && sent) {
+      clearTimeout(timeout);
+      window.removeEventListener('message', receive);
+      status.textContent = 'Transfer complete. You can close this window.';
+    }
+  }
+  window.addEventListener('message', receive);
+  receiver.postMessage({ type: 'daily-grind:ready', nonce }, config.newOrigin);
+}
