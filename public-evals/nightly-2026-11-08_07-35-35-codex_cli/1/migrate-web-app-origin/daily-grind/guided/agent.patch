new file mode 100644
index 0000000..ac2e334
--- /dev/null
+++ b/settings.js
@@ -0,0 +1,41 @@
+export const SETTINGS_KEY = 'daily-grind:preferences';
+export const defaults = { theme: 'system', favoriteDrink: 'none' };
+
+// Only this documented schema crosses origins; cookies, credentials and arbitrary
+// storage keys must never be copied by the bridge.
+export function validateSettings(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value) ||
+      Object.keys(value).sort().join(',') !== 'favoriteDrink,theme' ||
+      !['system', 'light', 'dark'].includes(value.theme) ||
+      !['none', 'maple-oat-latte', 'espresso', 'cold-brew'].includes(value.favoriteDrink)) {
+    throw new Error('This file does not contain valid Daily Grind preferences.');
+  }
+  return { theme: value.theme, favoriteDrink: value.favoriteDrink };
+}
+
+export function readSettings(storage) {
+  const raw = storage.getItem(SETTINGS_KEY);
+  return raw === null ? null : validateSettings(JSON.parse(raw));
+}
+
+export function saveSettings(storage, value) {
+  const settings = validateSettings(value);
+  // A single write leaves the previous configuration intact on quota errors.
+  storage.setItem(SETTINGS_KEY, JSON.stringify(settings));
+  return settings;
+}
+
+export function trustedMessage(event, expectedWindow, expectedOrigin) {
+  if (!expectedWindow || event.source !== expectedWindow || event.origin === 'null') return false;
+  try {
+    if ('Origin' in globalThis) {
+      // Parse the serialized origin as well for synthetic MessageEvents in tests.
+      return Origin.from(event.origin).isSameOrigin(Origin.from(expectedOrigin));
+    }
+    const actual = new URL(event.origin);
+    const trusted = new URL(expectedOrigin);
+    return actual.origin !== 'null' && actual.origin === trusted.origin;
+  } catch {
+    return false;
+  }
+}
diff --git a/test/migration.test.js b/test/migration.test.js
new file mode 100644
index 0000000..9b8054a
--- /dev/null
+++ b/test/migration.test.js
@@ -0,0 +1,118 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { readFileSync, mkdtempSync, mkdirSync, copyFileSync, symlinkSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { resolve, join } from 'node:path';
+import { runInNewContext } from 'node:vm';
+import { defaults, readSettings, saveSettings, trustedMessage, validateSettings, SETTINGS_KEY } from '../settings.js';
+
+// Build in isolation: running tests must not replace a real deployment bundle.
+const fixture = mkdtempSync(join(tmpdir(), 'daily-grind-test-'));
+mkdirSync(join(fixture, 'scripts'));
+for (const file of ['scripts/build.mjs', 'index.html', 'manifest.webmanifest', 'app.js', 'settings.js', 'transfer.html', 'transfer.js', 'icon.svg']) {
+  copyFileSync(file, join(fixture, file));
+}
+symlinkSync(resolve('node_modules'), join(fixture, 'node_modules'), 'dir');
+after(() => rmSync(fixture, { recursive: true, force: true }));
+
+test('settings survive a storage round trip and missing settings stay absent', () => {
+  const data = new Map();
+  const storage = { getItem: key => data.get(key) ?? null, setItem: (key, value) => data.set(key, value) };
+  assert.equal(readSettings(storage), null);
+  const preferences = { theme: 'dark', favoriteDrink: 'espresso' };
+  saveSettings(storage, preferences);
+  assert.deepEqual(readSettings(storage), preferences);
+  assert.deepEqual([...data.keys()], [SETTINGS_KEY]);
+  assert.throws(() => saveSettings({ setItem() { throw new Error('quota'); } }, preferences), /quota/);
+});
+
+test('only the explicit preference schema is transferable', () => {
+  for (const invalid of [null, [], {}, { ...defaults, theme: 'unknown' }, { ...defaults, favoriteDrink: 'javascript:alert(1)' }, { ...defaults, token: 'secret' }]) {
+    assert.throws(() => validateSettings(invalid));
+  }
+  assert.throws(() => readSettings({ getItem: () => 'malformed' }));
+});
+
+test('messages require the pinned source and exact normalized nonopaque origin', () => {
+  const popup = {};
+  const trusted = 'https://old.example.com';
+  const event = { source: popup, origin: trusted };
+  assert.equal(trustedMessage(event, popup, trusted), true);
+  assert.equal(trustedMessage({ ...event, origin: `${trusted}:443` }, popup, trusted), true);
+  for (const origin of ['null', 'invalid', 'http://old.example.com', 'https://old.example.com.attacker.com', 'https://other.example.com', `${trusted}:444`]) {
+    assert.equal(trustedMessage({ ...event, origin }, popup, trusted), false);
+  }
+  assert.equal(trustedMessage({ ...event, source: {} }, popup, trusted), false);
+  assert.equal(trustedMessage(event, null, trusted), false);
+});
+
+test('build emits reciprocal app identities and secure, role-specific configuration', () => {
+  execFileSync(process.execPath, ['scripts/build.mjs', '--old-origin=https://old.example.co.uk', '--new-origin=https://new.example.co.uk', '--old-id=/coffee?installed=1'], { cwd: fixture });
+  const json = path => JSON.parse(readFileSync(join(fixture, path), 'utf8'));
+  const oldManifest = json('dist/old/manifest.webmanifest');
+  const newManifest = json('dist/new/manifest.webmanifest');
+  assert.equal(oldManifest.id, 'https://old.example.co.uk/coffee?installed=1');
+  assert.deepEqual(oldManifest.migrate_to, { id: 'https://new.example.co.uk/', install_url: 'https://new.example.co.uk/' });
+  assert.deepEqual(newManifest.migrate_from, [{ id: oldManifest.id, install_url: 'https://old.example.co.uk/', behavior: 'suggest' }]);
+  assert.equal(newManifest.id, '/');
+  assert.deepEqual(json('dist/old/.well-known/web-app-origin-association'), { 'https://new.example.co.uk/': { allow_migration: true } });
+  for (const role of ['old', 'new']) {
+    assert.match(readFileSync(join(fixture, `dist/${role}/migration-config.js`), 'utf8'), new RegExp(`"role":"${role}"`));
+    assert.match(readFileSync(join(fixture, `dist/${role}/index.html`), 'utf8'), /rel="manifest"/);
+  }
+});
+
+test('invalid origin pairs fail before replacing the output', () => {
+  const existing = readFileSync(join(fixture, 'dist/new/manifest.webmanifest'), 'utf8');
+  const pairs = [
+    [],
+    ['https://old.example.com', 'https://new.example.org'],
+    ['https://a.github.io', 'https://b.github.io'],
+    ['https://a.co.uk', 'https://b.co.uk'],
+    ['http://old.example.com', 'https://new.example.com'],
+    ['https://old.example.com', 'https://old.example.com'],
+    ['https://old.example.com/path', 'https://new.example.com'],
+    ['https://user:pass@old.example.com', 'https://new.example.com'],
+  ];
+  for (const pair of pairs) {
+    const args = pair.length ? [`--old-origin=${pair[0]}`, `--new-origin=${pair[1]}`] : [];
+    assert.notEqual(spawnSync(process.execPath, ['scripts/build.mjs', ...args], { cwd: fixture }).status, 0);
+    assert.equal(readFileSync(join(fixture, 'dist/new/manifest.webmanifest'), 'utf8'), existing);
+  }
+});
+
+test('old-origin bridge rejects spoofed messages and transfers preferences once without deleting them', () => {
+  const config = { role: 'old', oldOrigin: 'https://old.example.com', newOrigin: 'https://new.example.com' };
+  const nonce = '39b20fa0-2e85-4d5b-83dd-6b29c8ce19af';
+  const messages = [];
+  const receiver = { postMessage: (message, origin) => messages.push({ message, origin }) };
+  const listeners = new Map();
+  const storage = { getItem: key => key === SETTINGS_KEY ? JSON.stringify(defaults) : null };
+  const status = {};
+  const script = readFileSync('transfer.js', 'utf8').replace(/^import .*;\n/gm, '');
+  runInNewContext(script, {
+    config, trustedMessage, readSettings, localStorage: storage,
+    location: { origin: config.oldOrigin, hash: `#${nonce}` },
+    document: { querySelector: () => status },
+    window: { opener: receiver, addEventListener: (type, handler) => listeners.set(type, handler), removeEventListener: type => listeners.delete(type) },
+    setTimeout: () => 1, clearTimeout() {},
+  });
+  assert.equal(messages.length, 1); // Ready signal contains no configuration.
+  assert.equal(messages[0].message.type, 'daily-grind:ready');
+  const request = { source: receiver, origin: config.newOrigin, data: { type: 'daily-grind:request', nonce } };
+  const receive = listeners.get('message');
+  receive({ ...request, origin: 'https://attacker.example.com' });
+  receive({ ...request, source: {} });
+  receive({ ...request, data: { ...request.data, nonce: 'wrong' } });
+  assert.equal(messages.length, 1);
+  receive(request);
+  receive(request);
+  assert.equal(messages.length, 2);
+  assert.equal(messages[1].origin, config.newOrigin);
+  assert.deepEqual(messages[1].message.preferences, defaults);
+  assert.deepEqual(readSettings(storage), defaults);
+  receive({ ...request, data: { type: 'daily-grind:complete', nonce } });
+  assert.equal(listeners.has('message'), false);
+  assert.match(status.textContent, /Transfer complete/);
+});
