@@ -0,0 +1,107 @@
+import config from './migration-config.js';
+import { defaults, readSettings, saveSettings, trustedMessage } from './settings.js';
+
+const status = document.querySelector('#settings-status');
+const theme = document.querySelector('#theme');
+const drink = document.querySelector('#favorite-drink');
+const say = message => { status.textContent = message; };
+function renderSettings() {
+  const settings = readSettings(localStorage) ?? defaults;
+  theme.value = settings.theme;
+  drink.value = settings.favoriteDrink;
+  document.documentElement.dataset.theme = settings.theme;
+}
+try { renderSettings(); } catch { say('Saved preferences could not be read. You can save new preferences below.'); }
+
+document.querySelector('#preferences').addEventListener('submit', event => {
+  event.preventDefault();
+  try {
+    saveSettings(localStorage, { theme: theme.value, favoriteDrink: drink.value });
+    renderSettings();
+    say('Your preferences are saved.');
+  } catch { say('Preferences could not be saved. Check that browser storage is available.'); }
+});
+
+document.querySelector('#export-settings').addEventListener('click', () => {
+  try {
+    const preferences = readSettings(localStorage) ?? defaults;
+    const url = URL.createObjectURL(new Blob([JSON.stringify({ version: 1, preferences }, null, 2)], { type: 'application/json' }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = 'daily-grind-preferences.json';
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+    say('Preferences exported. Keep this file until your move is complete.');
+  } catch { say('Preferences could not be exported. Check that browser storage is available.'); }
+});
+
+document.querySelector('#import-settings').addEventListener('change', async event => {
+  const file = event.target.files[0];
+  if (!file) return;
+  try {
+    if (file.size > 4096) throw new Error('Preference files must be smaller than 4 KB.');
+    const data = JSON.parse(await file.text());
+    if (data.version !== 1) throw new Error('This preference file version is not supported.');
+    saveSettings(localStorage, data.preferences);
+    renderSettings();
+    say('Your preferences have been restored.');
+  } catch (error) { say(`Could not restore preferences. ${error.message}`); }
+  finally { event.target.value = ''; }
+});
+
+if (config && location.origin === config[`${config.role}Origin`]) {
+  const banner = document.querySelector('#migration');
+  banner.hidden = false;
+  const link = document.querySelector('#new-site');
+  link.href = config.newOrigin;
+  link.textContent = config.newOrigin;
+  if (config.role === 'old') {
+    document.querySelector('#old-migration').hidden = false;
+  } else {
+    document.querySelector('#new-migration').hidden = false;
+    document.querySelector('#transfer-settings').addEventListener('click', transferSettings);
+  }
+}
+
+function transferSettings(event) {
+  const button = event.currentTarget;
+  const nonce = crypto.randomUUID();
+  let popup;
+  let timeout;
+  let closed;
+  const finish = message => {
+    clearTimeout(timeout);
+    clearInterval(closed);
+    window.removeEventListener('message', receive);
+    button.disabled = false;
+    say(message);
+  };
+  const receive = event => {
+    if (!trustedMessage(event, popup, config.oldOrigin) || event.data?.nonce !== nonce) return;
+    if (event.data.type === 'daily-grind:ready') {
+      popup.postMessage({ type: 'daily-grind:request', nonce }, config.oldOrigin);
+    } else if (event.data.type === 'daily-grind:preferences') {
+      try {
+        if (event.data.preferences === null) {
+          finish('No saved preferences were found at the previous address. Your current preferences are unchanged.');
+        } else {
+          saveSettings(localStorage, event.data.preferences);
+          renderSettings();
+          finish('Your preferences have been transferred. You can close the transfer window.');
+        }
+        popup.postMessage({ type: 'daily-grind:complete', nonce }, config.oldOrigin);
+      } catch { finish('Preferences could not be transferred. Use the export and restore controls below.'); }
+    } else if (event.data.type === 'daily-grind:error') {
+      finish('The previous site could not read your preferences. Use the export and restore controls below.');
+    }
+  };
+  window.addEventListener('message', receive);
+  popup = window.open(`${config.oldOrigin}/transfer.html#${nonce}`, '_blank', 'popup,width=520,height=420');
+  if (!popup) { finish('The transfer window was blocked. Allow popups or export preferences from the previous site and restore the file below.'); return; }
+  button.disabled = true;
+  say('Connecting to your previous address…');
+  timeout = setTimeout(() => finish('The transfer timed out. Try again, or export preferences from the previous site and restore the file below.'), 30000);
+  closed = setInterval(() => {
+    if (popup.closed) finish('The transfer window closed. Try again, or use a preference backup.');
+  }, 500);
+}
