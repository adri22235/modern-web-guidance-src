+  <script>
+    for (const card of document.querySelectorAll('.swipe-card')) {
+      const content = card.querySelector('.swipe-content');
+      const showButton = card.querySelector('.show-actions');
+      const panel = card.querySelector('.drink-actions');
+
+      showButton.addEventListener('click', () => {
+        card.scrollTo({ left: card.scrollWidth - card.clientWidth });
+        panel.querySelector('a').focus({ preventScroll: true });
+      });
+
+      const closeActions = () => {
+        card.scrollTo({ left: 0 });
+        showButton.focus({ preventScroll: true });
+      };
+
+      card.querySelector('.close-actions').addEventListener('click', closeActions);
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeActions();
+        }
+      });
+
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+  </script>
