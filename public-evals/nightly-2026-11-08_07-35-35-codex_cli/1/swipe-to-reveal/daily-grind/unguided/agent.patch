+  <script>
+    const drinkCards = [...document.querySelectorAll('.swipe-card')];
+
+    function setActionsOpen(card, open) {
+      const actions = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.actions-toggle');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      actions.inert = !open;
+      actions.setAttribute('aria-hidden', String(!open));
+      toggle.setAttribute('aria-expanded', String(open));
+      toggle.textContent = open ? 'Close actions' : 'Actions';
+    }
+
+    drinkCards.forEach(card => {
+      const content = card.querySelector('.drink-content');
+      const toggle = card.querySelector('.actions-toggle');
+      let gesture = null;
+      let suppressClickUntil = 0;
+
+      function openOnlyThisCard(open) {
+        drinkCards.forEach(other => setActionsOpen(other, other === card && open));
+      }
+
+      toggle.addEventListener('click', () => {
+        openOnlyThisCard(!card.classList.contains('is-open'));
+      });
+
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || gesture) return;
+        gesture = {
+          id: event.pointerId, x: event.clientX, y: event.clientY,
+          wasOpen: card.classList.contains('is-open'), dragging: false, offset: 0
+        };
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 10) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { gesture = null; return; }
+          gesture.dragging = true;
+          content.setPointerCapture(event.pointerId);
+          card.classList.add('is-dragging');
+        }
+        const width = card.querySelector('.drink-actions').offsetWidth;
+        gesture.offset = Math.max(-width, Math.min(0, (gesture.wasOpen ? -width : 0) + dx));
+        content.style.transform = `translateX(${gesture.offset}px)`;
+      });
+
+      function finishGesture(event) {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const current = gesture;
+        gesture = null;
+        card.classList.remove('is-dragging');
+        content.style.removeProperty('transform');
+        if (current.dragging) {
+          suppressClickUntil = Date.now() + 400;
+          const cancelled = event.type !== 'pointerup';
+          const width = card.querySelector('.drink-actions').offsetWidth;
+          openOnlyThisCard(cancelled ? current.wasOpen : current.offset < -width / 2);
+        }
+        if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId);
+      }
+
+      content.addEventListener('pointerup', finishGesture);
+      content.addEventListener('pointercancel', finishGesture);
+      content.addEventListener('lostpointercapture', finishGesture);
+      content.addEventListener('pointerleave', event => {
+        if (gesture && !gesture.dragging) finishGesture(event);
+      });
+      content.addEventListener('click', event => {
+        if (Date.now() < suppressClickUntil) {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+        }
+      }, true);
+    });
+
+    document.addEventListener('pointerdown', event => {
+      if (!event.target.closest('.swipe-card')) {
+        drinkCards.forEach(card => setActionsOpen(card, false));
+      }
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape') drinkCards.forEach(card => setActionsOpen(card, false));
+    });
+  </script>
