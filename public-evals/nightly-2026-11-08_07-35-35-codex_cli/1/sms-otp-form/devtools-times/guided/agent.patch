diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..2faf8f1
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,64 @@
+import type { APIRoute } from 'astro';
+import { createChallenge, matchesChallenge, MAX_ATTEMPTS, normalizePhone, RESEND_DELAY_MS, sendSms, validPhone } from '../../server/sms-verification';
+import type { PhoneChallenge } from '../../server/sms-verification';
+
+const reply = (body: object, status = 200) => new Response(JSON.stringify(body), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  // This app disables Astro's global origin check. Enforce it for this mutation.
+  if (request.headers.get('Origin') !== url.origin) return reply({ error: 'Please submit this form from this website.' }, 403);
+  if (!session) return reply({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return reply({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body.phone !== 'string') return reply({ error: 'Enter your phone number, including the country code.' }, 400);
+  const phone = normalizePhone(body.phone);
+  if (!validPhone(phone)) return reply({ error: 'Enter an international phone number, such as +14155552671.', field: 'phone' }, 400);
+  const challenge = await session.get('signupChallenge') as PhoneChallenge | undefined;
+
+  if (body.action === 'send') {
+    const lastSent = await session.get('signupLastSent') as number | undefined;
+    if (lastSent && Date.now() - lastSent < RESEND_DELAY_MS) {
+      return reply({ error: 'Please wait before requesting another code.', retryAfter: Math.ceil((RESEND_DELAY_MS - (Date.now() - lastSent)) / 1000) }, 429);
+    }
+    // Limit sends even if the user changes phone numbers or delivery fails.
+    await session.set('signupLastSent', Date.now());
+    const { code, challenge: next } = createChallenge(phone);
+    await session.delete('signupChallenge');
+    try {
+      await sendSms(phone, code, url.hostname);
+      await session.set('signupChallenge', next, { ttl: 300 });
+      return reply({ phone, expiresIn: 300, retryAfter: 60 });
+    } catch {
+      return reply({ error: 'We could not send a code. Please try again in a minute.', retryAfter: 60 }, 503);
+    }
+  }
+
+  if (body.action !== 'register') return reply({ error: 'Invalid request.' }, 400);
+  if (typeof body.username !== 'string' || !body.username.trim() || typeof body.password !== 'string' || body.password.length < 8 || !/[0-9]/.test(body.password)) {
+    return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+  }
+  if (!challenge || challenge.expiresAt <= Date.now() || challenge.attempts >= MAX_ATTEMPTS) {
+    await session.delete('signupChallenge');
+    return reply({ error: 'This code has expired or reached its attempt limit. Request a new code.', field: 'code' }, 400);
+  }
+  const valid = typeof body.code === 'string' && matchesChallenge(challenge, phone, body.code);
+  challenge.attempts += 1;
+  // Persist failed attempts and consume a valid code before registration.
+  if (valid) await session.delete('signupChallenge');
+  else await session.set('signupChallenge', challenge);
+  if (!valid) return reply({ error: 'The code is incorrect. Check your SMS and try again.', field: 'code' }, 400);
+
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phoneNumber: phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) return reply({ error: 'Registration failed. Check your account details and request a new code.' }, 400);
+    return reply({ success: true });
+  } catch {
+    return reply({ error: 'Registration is unavailable. Please request a new code and try again.' }, 502);
+  }
+};
diff --git a/src/server/sms-verification.test.ts b/src/server/sms-verification.test.ts
new file mode 100644
index 0000000..036d91b
--- /dev/null
+++ b/src/server/sms-verification.test.ts
@@ -0,0 +1,76 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createChallenge, matchesChallenge, MAX_ATTEMPTS, normalizePhone, smsBody, validPhone, sendSms } from './sms-verification.ts';
+
+const phone = '+14155552671';
+
+test('normalizes formatted international phone numbers without guessing a country', () => {
+  assert.equal(normalizePhone('+1 (415) 555-2671'), phone);
+  assert.equal(validPhone(phone), true);
+  for (const invalid of ['4155552671', '+012345678', '+1', '+1234567890123456', '+1415x5552671']) {
+    assert.equal(validPhone(invalid), false);
+  }
+});
+
+test('generates six-digit codes and stores salted hashes rather than plaintext', () => {
+  const first = createChallenge(phone, 1000);
+  const second = createChallenge(phone, 1000);
+  assert.match(first.code, /^[0-9]{6}$/);
+  assert.equal(first.challenge.digest.length, 64);
+  assert.notEqual(first.challenge.salt, second.challenge.salt);
+  assert.equal('code' in first.challenge, false);
+  assert.equal(matchesChallenge(first.challenge, phone, first.code, 1001), true);
+});
+
+test('rejects wrong codes, other phones, expired codes, and exhausted attempts', () => {
+  const { code, challenge } = createChallenge(phone, 1000);
+  const wrong = code === '000000' ? '000001' : '000000';
+  assert.equal(matchesChallenge(challenge, phone, wrong, 1001), false);
+  assert.equal(matchesChallenge(challenge, '+442079460958', code, 1001), false);
+  assert.equal(matchesChallenge(challenge, phone, code, challenge.expiresAt), false);
+  assert.equal(matchesChallenge({ ...challenge, attempts: MAX_ATTEMPTS }, phone, code, 1001), false);
+  assert.equal(matchesChallenge({ ...challenge, attempts: MAX_ATTEMPTS - 1 }, phone, code, 1001), true);
+  assert.equal(matchesChallenge(challenge, phone, '12345', 1001), false);
+});
+
+test('SMS ends with the origin-bound line and preserves leading zeroes', () => {
+  const body = smsBody('news.example.com', '012345');
+  assert.equal(body.split('\n').at(-1), '@news.example.com #012345');
+  assert.match(body, /verification code is 012345/);
+});
+
+test('delivery fails closed when credentials are missing', async () => {
+  const previous = process.env.TWILIO_ACCOUNT_SID;
+  delete process.env.TWILIO_ACCOUNT_SID;
+  try {
+    await assert.rejects(sendSms(phone, '012345', 'news.example.com'), /SMS_UNAVAILABLE/);
+  } finally {
+    if (previous !== undefined) process.env.TWILIO_ACCOUNT_SID = previous;
+  }
+});
+
+test('sends the exact origin-bound SMS through the provider and rejects provider failures', async () => {
+  const originalFetch = globalThis.fetch;
+  const previous = { ...process.env };
+  process.env.TWILIO_ACCOUNT_SID = 'ACtest';
+  process.env.TWILIO_AUTH_TOKEN = 'test-token';
+  process.env.TWILIO_FROM_NUMBER = '+15005550006';
+  try {
+    globalThis.fetch = async (url, init) => {
+      assert.equal(String(url), 'https://api.twilio.com/2010-04-01/Accounts/ACtest/Messages.json');
+      const body = init?.body as URLSearchParams;
+      assert.equal(body.get('To'), phone);
+      assert.equal(body.get('Body'), smsBody('news.example.com', '012345'));
+      return new Response('{}', { status: 201 });
+    };
+    await sendSms(phone, '012345', 'news.example.com');
+    globalThis.fetch = async () => new Response('{}', { status: 429 });
+    await assert.rejects(sendSms(phone, '012345', 'news.example.com'), /SMS_UNAVAILABLE/);
+  } finally {
+    globalThis.fetch = originalFetch;
+    for (const key of ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_FROM_NUMBER']) {
+      if (previous[key] === undefined) delete process.env[key];
+      else process.env[key] = previous[key];
+    }
+  }
+});
