+import { createHash, randomInt, randomBytes, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LIFETIME_MS = 5 * 60 * 1000;
+export const RESEND_DELAY_MS = 60 * 1000;
+export const MAX_ATTEMPTS = 5;
+
+export interface PhoneChallenge {
+  phone: string;
+  salt: string;
+  digest: string;
+  expiresAt: number;
+  attempts: number;
+  sentAt: number;
+}
+
+export function normalizePhone(value: string) {
+  return value.replace(/[\s().-]/g, '');
+}
+
+export function validPhone(value: string) {
+  return /^\+[1-9][0-9]{7,14}$/.test(value);
+}
+
+function digest(code: string, salt: string) {
+  return createHash('sha256').update(`${salt}:${code}`).digest('hex');
+}
+
+export function createChallenge(phone: string, now = Date.now()) {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  const salt = randomBytes(32).toString('hex');
+  const challenge: PhoneChallenge = {
+    phone, salt, digest: digest(code, salt), expiresAt: now + CODE_LIFETIME_MS,
+    attempts: 0, sentAt: now,
+  };
+  return { code, challenge };
+}
+
+export function matchesChallenge(challenge: PhoneChallenge, phone: string, code: string, now = Date.now()) {
+  return challenge.phone === phone && challenge.expiresAt > now &&
+    challenge.attempts < MAX_ATTEMPTS && /^[0-9]{6}$/.test(code) &&
+    timingSafeEqual(Buffer.from(challenge.digest, 'hex'), Buffer.from(digest(code, challenge.salt), 'hex'));
+}
+
+export function smsBody(hostname: string, code: string) {
+  return `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${hostname} #${code}`;
+}
+
+export async function sendSms(phone: string, code: string, hostname: string) {
+  const { TWILIO_ACCOUNT_SID: sid, TWILIO_AUTH_TOKEN: token, TWILIO_FROM_NUMBER: from } = process.env;
+  if (!sid || !token || !from) throw new Error('SMS_UNAVAILABLE');
+  const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: phone, From: from, Body: smsBody(hostname, code) }),
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw new Error('SMS_UNAVAILABLE');
+}
