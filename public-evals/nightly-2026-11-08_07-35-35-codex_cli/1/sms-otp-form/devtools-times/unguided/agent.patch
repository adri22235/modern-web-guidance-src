--- /dev/null
+++ b/src/lib/signup.ts
@@ -0,0 +1,11 @@
+export const PHONE_PATTERN = /^\+[1-9]\d{7,14}$/;
+export const CODE_PATTERN = /^\d{6}$/;
+
+export function normalizePhone(phone: string) {
+  return phone.replace(/[\s().-]/g, '');
+}
+
+export function validAccount(username: unknown, password: unknown): boolean {
+  return typeof username === 'string' && username.trim().length > 0 && username.length <= 100
+    && typeof password === 'string' && password.length >= 8 && password.length <= 128 && /\d/.test(password);
+}
diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..63ee301
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+import { Buffer } from 'node:buffer';
+import { CODE_PATTERN, PHONE_PATTERN, normalizePhone, validAccount } from '../../lib/signup.ts';
+
+type Challenge = { phone: string; sentAt: number; expiresAt: number; attempts: number; verified?: boolean };
+const reply = (status: number, body: Record<string, unknown>) => Response.json(body, {
+  status, headers: { 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // This application disables Astro's global origin check; protect this endpoint explicitly.
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return reply(403, { error: 'Please submit the form from this website.' });
+  }
+  if (!session) return reply(503, { error: 'Sign-up is temporarily unavailable.' });
+
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return reply(400, { error: 'Invalid request.' });
+  }
+  if (!body || typeof body !== 'object' || typeof body.phone !== 'string') {
+    return reply(400, { error: 'Enter a phone number including its country code.' });
+  }
+  const phone = normalizePhone(body.phone);
+  if (!PHONE_PATTERN.test(phone)) return reply(400, { error: 'Enter a valid phone number including + and its country code.' });
+  if (!['send-code', 'register'].includes(body.action)) return reply(400, { error: 'Invalid request.' });
+  if (body.action === 'register' && (!validAccount(body.username, body.password) || typeof body.code !== 'string' || !CODE_PATTERN.test(body.code))) {
+    return reply(400, { error: 'Enter your username, a password of at least 8 characters containing a number, and a 6-digit code.' });
+  }
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) return reply(503, { error: 'SMS verification is not configured. Please try again later.' });
+
+  const verify = async (path: string, params: Record<string, string>) => {
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${service}/${path}`, {
+      method: 'POST',
+      headers: { Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}` },
+      body: new URLSearchParams(params),
+      signal: AbortSignal.timeout(15000),
+    });
+    return { response, data: await response.json() };
+  };
+
+  try {
+    const now = Date.now();
+    const challenge = await session.get('signupChallenge') as Challenge | undefined;
+    if (body.action === 'send-code') {
+      const retryAfter = challenge ? Math.ceil((challenge.sentAt + 30000 - now) / 1000) : 0;
+      if (retryAfter > 0) return reply(429, { error: 'Please wait before requesting another code.', retryAfter });
+      // Reserve the cooldown before contacting the SMS provider, including for failed sends.
+      await session.set('signupChallenge', { phone, sentAt: now, expiresAt: now, attempts: 0 });
+      const { response, data } = await verify('Verifications', { To: phone, Channel: 'sms' });
+      if (!response.ok || data.status !== 'pending') {
+        return reply(response.status === 429 ? 429 : 502, { error: 'Unable to send a code. Check the number and try again shortly.', retryAfter: 30 });
+      }
+      await session.set('signupChallenge', { phone, sentAt: now, expiresAt: now + 10 * 60 * 1000, attempts: 0 });
+      return reply(200, { sent: true, retryAfter: 30 });
+    }
+
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now || (challenge.attempts >= 5 && !challenge.verified)) {
+      return reply(400, { error: 'Your code has expired or you have made too many attempts. Request another code.' });
+    }
+    if (!challenge.verified) {
+      challenge.attempts += 1;
+      await session.set('signupChallenge', challenge);
+      const { response, data } = await verify('VerificationCheck', { To: phone, Code: body.code });
+      if (!response.ok || data.status !== 'approved') {
+        return reply(400, { error: 'The code is incorrect or expired. Try again or request another code.' });
+      }
+      // Retain approval briefly so account API failures can be retried without reusing a consumed SMS code.
+      challenge.verified = true;
+      await session.set('signupChallenge', challenge);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return reply(400, { error: 'Account creation failed. Try a different username or try again shortly.' });
+    await session.delete('signupChallenge');
+    return reply(200, { registered: true });
+  } catch {
+    return reply(502, { error: 'We could not reach the sign-up service. Please try again shortly.' });
+  }
+};
