--- /dev/null
+++ b/tests/signup.test.ts
@@ -0,0 +1,138 @@
+import assert from 'node:assert/strict';
+import { after, beforeEach, test } from 'node:test';
+import { POST } from '../src/pages/api/signup.ts';
+import { normalizePhone, PHONE_PATTERN, validAccount } from '../src/lib/signup.ts';
+
+const originalFetch = globalThis.fetch;
+const envNames = ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_VERIFY_SERVICE_SID'];
+const originalEnv = envNames.map((name) => process.env[name]);
+let store: Map<string, unknown>;
+let calls: { url: string; body: string }[];
+let responses: Response[];
+
+beforeEach(() => {
+  envNames.forEach((name) => { process.env[name] = 'test'; });
+  store = new Map();
+  calls = [];
+  responses = [];
+  globalThis.fetch = async (input, init) => {
+    calls.push({ url: String(input), body: String(init?.body) });
+    const response = responses.shift();
+    assert.ok(response, 'Unexpected outbound request');
+    return response;
+  };
+});
+after(() => {
+  globalThis.fetch = originalFetch;
+  envNames.forEach((name, index) => {
+    if (originalEnv[index] === undefined) delete process.env[name];
+    else process.env[name] = originalEnv[index];
+  });
+});
+const phone = '+12025550123';
+const credentials = { action: 'register', phone, username: 'reader', password: 'password1', code: '123456' };
+function challenge(overrides = {}) {
+  store.set('signupChallenge', { phone, sentAt: Date.now() - 31000, expiresAt: Date.now() + 600000, attempts: 0, ...overrides });
+}
+async function request(body: unknown, origin = 'https://example.com') {
+  const response = await POST({
+    request: new Request('https://example.com/devtools-times/api/signup', {
+      method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    }),
+    session: {
+      get: async (key: string) => structuredClone(store.get(key)),
+      set: async (key: string, value: unknown) => { store.set(key, structuredClone(value)); },
+      delete: async (key: string) => { store.delete(key); },
+    },
+  } as never);
+  return { status: response.status, body: await response.json() };
+}
+
+test('normalizes formatted international numbers and validates accounts', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), phone);
+  assert.ok(PHONE_PATTERN.test(phone));
+  assert.ok(!PHONE_PATTERN.test('2025550123'));
+  assert.ok(!validAccount('reader', 'short1'));
+  assert.ok(!validAccount(' ', 'password1'));
+  assert.ok(!validAccount('reader', 'password'));
+  assert.ok(validAccount('reader', 'password1'));
+});
+test('rejects cross-origin requests without contacting services', async () => {
+  assert.equal((await request(credentials, 'https://other.example')).status, 403);
+  assert.equal(calls.length, 0);
+});
+test('rejects invalid phone numbers, actions and code shapes', async () => {
+  for (const body of [{ action: 'send-code', phone: '123' }, { phone, action: 'unknown' }, { ...credentials, code: 123456 }]) {
+    assert.equal((await request(body)).status, 400);
+  }
