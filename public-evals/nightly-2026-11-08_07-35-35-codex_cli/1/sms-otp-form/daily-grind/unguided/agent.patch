+/* Optional production integration: define window.dailyGrindAuth before this script.
+ * sendCode({ phone, purpose }) -> Promise<{ challengeId: string }>
+ * verifyCode({ challengeId, code, purpose }) -> Promise<{ verified: boolean }>
+ * Both methods must call a server; only the server may issue a session cookie.
+ * The server must enforce expiry, one-time use, resend and attempt limits.
+ * SMS must end with: @YOUR_ACTUAL_HOSTNAME #123456 (no scheme or port).
+ * Without an adapter this is an explicitly labeled, local-only demo.
+ */
+(() => {
+  'use strict';
+  const $ = id => document.getElementById(id);
+  const form = $('otp-form');
+  const phone = $('phone');
+  const code = $('code');
+  const status = $('status');
+  const send = $('send-code');
+  const resend = $('resend');
+  const verify = $('verify-button');
+  const adapter = window.dailyGrindAuth;
+  const demo = !adapter;
+  let purpose = 'rewards';
+  let challenge = null;
+  let controller;
+  let listeningTimeout;
+  let cooldownTimer;
+  let cooldownEnd = 0;
+  let busy = false;
+  let attempts = 0;
+  if (!demo) $('demo-note').hidden = true;
+
+  function message(text, error = false) {
+    status.textContent = text;
+    status.classList.toggle('error', error);
+  }
+  function stopListening() {
+    controller?.abort();
+    clearTimeout(listeningTimeout);
+  }
+  function listenForSMS() {
+    stopListening();
+    if (demo || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    controller = new AbortController();
+    listeningTimeout = setTimeout(() => controller?.abort(), 120000);
+    navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal })
+      .then(credential => {
+        if (credential && /^\d{6}$/.test(credential.code)) {
+          code.value = credential.code;
+          code.removeAttribute('aria-invalid');
+          message('Code filled from your text message. Select Verify to continue.');
+        }
+      }).catch(() => { /* Manual entry and native autofill remain available. */ });
+  }
+  function updateControls() {
+    const remaining = Math.max(0, Math.ceil((cooldownEnd - Date.now()) / 1000));
+    send.disabled = resend.disabled = busy || remaining > 0;
+    verify.disabled = busy;
+    phone.readOnly = busy;
+    code.readOnly = busy;
+    document.querySelectorAll('[data-purpose]').forEach(element => {
+      if (element.tagName === 'BUTTON') element.disabled = busy;
+    });
+    send.textContent = remaining ? `Sent · ${remaining}s` : 'Send code ↗';
+    resend.textContent = remaining ? `Resend in ${remaining}s` : 'Resend code';
+    if (!remaining) clearInterval(cooldownTimer);
+  }
+  function reset() {
+    stopListening();
+    challenge = null;
+    attempts = 0;
+    code.value = '';
+    cooldownEnd = 0;
+    clearInterval(cooldownTimer);
+    phone.removeAttribute('aria-invalid');
+    code.removeAttribute('aria-invalid');
+    message('');
+    updateControls();
+  }
+  function setPurpose(next) {
+    if (busy || next === purpose) return;
+    purpose = next;
+    reset();
+    $('form-content').hidden = false;
+    $('success').hidden = true;
+    document.querySelectorAll('.purpose button').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.purpose === purpose)));
+    $('purpose-description').textContent = purpose === 'rewards'
+      ? 'Sign in to earn points, enjoy little extras, and make every coffee count. No password needed.'
+      : 'Your favorites are a few taps away. Verify your number to get started with your online order.';
+    verify.innerHTML = purpose === 'rewards' ? 'Verify & sign in <span aria-hidden="true">→</span>' : 'Verify & start your order <span aria-hidden="true">→</span>';
+  }
+  document.querySelectorAll('[data-purpose]').forEach(element => element.addEventListener('click', event => {
+    if (busy) { event.preventDefault(); return; }
+    setPurpose(element.dataset.purpose);
+    if (element.tagName === 'A') phone.focus();
+  }));
+  phone.addEventListener('input', () => {
+    reset();
+  });
+  code.addEventListener('input', () => {
+    code.value = code.value.replace(/\D/g, '').slice(0, 6);
+    code.removeAttribute('aria-invalid');
+  });
+  code.addEventListener('paste', event => {
+    const text = event.clipboardData.getData('text');
+    const match = text.match(/(?:^|\D)(\d{6})(?!\d)/);
+    const compact = text.replace(/[\s-]/g, '');
+    if (match || /^\d{6}$/.test(compact)) {
+      event.preventDefault();
+      code.value = match ? match[1] : compact;
+      code.removeAttribute('aria-invalid');
+    }
+  });
+  async function sendCode() {
+    if (busy || Date.now() < cooldownEnd) return;
+    const normalized = phone.value.replace(/[\s().-]/g, '');
+    if (!/^\+?[1-9]\d{7,14}$/.test(normalized)) {
+      phone.setAttribute('aria-invalid', 'true');
+      message('Enter a valid mobile number, including your country code.', true);
+      phone.focus();
+      return;
+    }
+    phone.removeAttribute('aria-invalid');
+    busy = true;
+    challenge = null;
+    code.value = '';
+    updateControls();
+    message(demo ? 'Preparing your demo code…' : 'Sending your code…');
+    listenForSMS();
+    try {
+      const result = demo ? { challengeId: 'local-demo' } : await adapter.sendCode({ phone: normalized, purpose });
+      if (!result || typeof result.challengeId !== 'string' || !result.challengeId) throw new Error('Invalid challenge');
+      challenge = { id: result.challengeId, expiresAt: Date.now() + 300000 };
+      attempts = 0;
+      cooldownEnd = Date.now() + 30000;
+      cooldownTimer = setInterval(updateControls, 1000);
+      message(demo ? 'Demo ready. Enter 123456 below. No text message was sent.' : `Code sent to the number ending in ${normalized.slice(-4)}. It expires in 5 minutes.`);
+      code.focus();
+    } catch {
+      stopListening();
+      message('We couldn’t send your code. Please try again in a moment.', true);
+    } finally {
+      busy = false;
+      updateControls();
+    }
+  }
+  send.addEventListener('click', sendCode);
+  resend.addEventListener('click', sendCode);
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    if (!challenge) { await sendCode(); return; }
+    if (Date.now() > challenge.expiresAt || (demo && attempts >= 5)) {
+      stopListening();
+      message('This code has expired or reached its attempt limit. Request a new code.', true);
+      code.setAttribute('aria-invalid', 'true');
+      code.focus();
+      return;
+    }
+    if (!/^\d{6}$/.test(code.value)) {
+      message('Enter the complete 6-digit verification code.', true);
+      code.setAttribute('aria-invalid', 'true');
+      code.focus();
+      return;
+    }
+    stopListening();
+    busy = true;
+    attempts++;
+    updateControls();
+    message('Checking your code…');
+    try {
+      const result = demo ? { verified: code.value === '123456' } : await adapter.verifyCode({ challengeId: challenge.id, code: code.value, purpose });
+      if (result?.verified !== true) {
+        message('That code wasn’t accepted. Check your latest text and try again.', true);
+        code.setAttribute('aria-invalid', 'true');
+        code.focus();
+        return;
+      }
+      challenge = null;
+      clearInterval(cooldownTimer);
+      code.value = '';
+      $('form-content').hidden = true;
+      $('success').hidden = false;
+      $('success-title').textContent = demo ? 'That’s how easy it is.' : 'You’re all set.';
+      $('success-copy').textContent = demo ? 'Demo complete. No account has been signed in. Your next good coffee is waiting.' : purpose === 'rewards' ? 'Welcome back. Let’s make your next coffee count.' : 'Your number is verified. Let’s get your favorites started.';
+      $('continue-link').href = purpose === 'rewards' ? '/rewards' : '/order-online';
+      $('continue-link').textContent = purpose === 'rewards' ? 'Explore Rewards →' : 'Start your order →';
+      $('success').focus();
+    } catch {
+      message('We couldn’t verify your code. Please try again.', true);
+    } finally {
+      busy = false;
+      updateControls();
+    }
+  });
+  $('start-over').addEventListener('click', () => {
+    reset();
+    phone.value = '';
+    $('success').hidden = true;
+    $('form-content').hidden = false;
+    phone.focus();
+  });
+  window.addEventListener('pagehide', () => { stopListening(); clearInterval(cooldownTimer); });
+})();
