diff --git a/verification.js b/verification.js
new file mode 100644
index 0000000..3d53805
--- /dev/null
+++ b/verification.js
@@ -0,0 +1,256 @@
+(() => {
+  const phoneForm = document.querySelector('#phone-form');
+  const otpForm = document.querySelector('#otp-form');
+  const phone = document.querySelector('#phone');
+  const code = document.querySelector('#otp');
+  const send = document.querySelector('#send-code');
+  const resend = document.querySelector('#resend-code');
+  const verify = document.querySelector('#verify-code');
+  const status = document.querySelector('#verification-status');
+  const phoneError = document.querySelector('#phone-error');
+  const codeError = document.querySelector('#code-error');
+  const hint = document.querySelector('#code-hint');
+  const purposes = [...document.querySelectorAll('input[name="purpose"]')];
+  let challenge = null;
+  let smsController = null;
+  let smsTimer = null;
+  let requestController = null;
+  let cooldownTimer = null;
+  let cooldownUntil = 0;
+  let busy = false;
+  let generation = 0;
+  let extracted = false;
+
+  const purpose = () => purposes.find(input => input.checked).value;
+  const normalizedPhone = () => phone.value.replace(/[\s().-]/g, '');
+
+  function stopSms() {
+    smsController?.abort();
+    smsController = null;
+    clearTimeout(smsTimer);
+  }
+
+  function showError(input, element, message) {
+    element.textContent = message;
+    input.setAttribute('aria-invalid', 'true');
+    input.focus();
+  }
+
+  function clearError(input, element) {
+    input.removeAttribute('aria-invalid');
+    input.setCustomValidity('');
+    element.textContent = '';
+  }
+
+  function updateButtons() {
+    const seconds = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+    send.disabled = busy || seconds > 0;
+    resend.disabled = busy || seconds > 0;
+    verify.disabled = busy;
+    send.textContent = seconds ? 'Sent · ' + seconds + 's' : 'Send code ↗';
+    resend.textContent = seconds ? 'Resend in ' + seconds + 's' : 'Resend code';
+  }
+
+  function resetChallenge() {
+    generation++;
+    requestController?.abort();
+    stopSms();
+    challenge = null;
+    extracted = false;
+    code.value = '';
+    busy = false;
+    cooldownUntil = 0;
+    clearInterval(cooldownTimer);
+    clearError(code, codeError);
+    status.textContent = '';
+    hint.textContent = 'Enter the code sent to your mobile number.';
+    updateButtons();
+  }
+
+  async function post(url, body) {
+    const controller = new AbortController();
+    requestController = controller;
+    const timer = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify(body),
+        signal: controller.signal,
+      });
+      const isJSON = response.headers.get('content-type')?.includes('application/json');
+      if (!isJSON) throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+      const data = await response.json();
+      if (!response.ok) {
+        if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+        if (response.status === 400 || response.status === 401 || response.status === 410) {
+          throw new Error(url === otpForm.action || url === '/api/auth/sms/verify'
+            ? 'That code is incorrect or has expired. Try again or request a new code.'
+            : 'We couldn’t send a code to that number. Check the number and try again.');
+        }
+        throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+      }
+      return data;
+    } finally {
+      clearTimeout(timer);
+      if (requestController === controller) requestController = null;
+    }
+  }
+
+  async function startSms(version) {
+    stopSms();
+    if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    smsController = controller;
+    smsTimer = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({
+        otp: { transport: ['sms'] },
+        signal: controller.signal,
+      });
+      if (!credential || controller.signal.aborted || generation !== version) return;
+      code.value = credential.code;
+      clearError(code, codeError);
+      extracted = true;
+      if (challenge && !busy) otpForm.requestSubmit();
+    } catch {
+      // Permission dismissal, timeout, and unsupported policies retain manual entry.
+    } finally {
+      if (smsController === controller) {
+        clearTimeout(smsTimer);
+        smsController = null;
+      }
+    }
+  }
+
+  async function requestCode(event) {
+    event?.preventDefault();
+    if (busy || Date.now() < cooldownUntil) return;
+    clearError(phone, phoneError);
+    if (!/^\+[1-9][0-9]{7,14}$/.test(normalizedPhone())) {
+      showError(phone, phoneError, 'Enter a valid mobile number with a country code, such as +1 202 555 0123.');
+      return;
+    }
+    stopSms();
+    challenge = null;
+    extracted = false;
+    code.value = '';
+    clearError(code, codeError);
+    const version = ++generation;
+    busy = true;
+    updateButtons();
+    status.textContent = 'Sending your verification code…';
+    // Listen before sending so fast incoming messages are not missed.
+    startSms(version);
+    try {
+      const data = await post(phoneForm.action, { phone: normalizedPhone(), purpose: purpose() });
+      if (generation !== version) return;
+      if (typeof data.challengeId !== 'string' || !data.challengeId) {
+        throw new Error('We couldn’t start verification. Please try again.');
+      }
+      challenge = { id: data.challengeId, phone: normalizedPhone(), purpose: purpose() };
+      hint.textContent = 'Enter the 6-digit code sent to your number ending in ' + challenge.phone.slice(-4) + '.';
+      status.textContent = 'Code sent. Check your texts. Your code may fill in automatically.';
+      cooldownUntil = Date.now() + 30000;
+      clearInterval(cooldownTimer);
+      cooldownTimer = setInterval(() => {
+        updateButtons();
+        if (Date.now() >= cooldownUntil) clearInterval(cooldownTimer);
+      }, 1000);
+      code.focus();
+    } catch (error) {
+      if (generation !== version) return;
+      stopSms();
+      status.textContent = '';
+      showError(phone, phoneError, error.name === 'AbortError'
+        ? 'The request timed out. Please try sending your code again.' : error.message);
+    } finally {
+      if (generation === version) {
+        busy = false;
+        updateButtons();
+        if (extracted && challenge) otpForm.requestSubmit();
+      }
+    }
+  }
+
+  phoneForm.addEventListener('submit', requestCode);
+  resend.addEventListener('click', () => phoneForm.requestSubmit());
+  otpForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    stopSms();
+    clearError(code, codeError);
+    if (!challenge) {
+      showError(phone, phoneError, 'Request a code with your mobile number first.');
+      return;
+    }
+    const version = generation;
+    busy = true;
+    updateButtons();
+    status.textContent = 'Verifying your code…';
+    try {
+      const data = await post(otpForm.action, {
+        challengeId: challenge.id, phone: challenge.phone,
+        code: code.value, purpose: challenge.purpose,
+      });
+      if (generation !== version) return;
+      if (data.verified !== true) throw new Error('That code is incorrect or has expired. Try again or request a new code.');
+      const destination = challenge.purpose === 'order' ? '/order-online' : '/rewards';
+      status.textContent = 'You’re signed in. Taking you to ' + (challenge.purpose === 'order' ? 'your order…' : 'Rewards…');
+      challenge = null;
+      code.value = '';
+      window.location.assign(destination);
+    } catch (error) {
+      if (generation !== version) return;
+      status.textContent = '';
+      showError(code, codeError, error.name === 'AbortError'
+        ? 'Verification timed out. Please try again.' : error.message);
+    } finally {
+      if (generation === version) {
+        busy = false;
+        updateButtons();
+      }
+    }
+  });
+
+  phone.addEventListener('input', () => {
+    resetChallenge();
+    clearError(phone, phoneError);
+  });
+  code.addEventListener('input', () => {
+    extracted = false;
+    clearError(code, codeError);
+  });
+  for (const input of [phone, code]) {
+    input.addEventListener('invalid', () => {
+      const element = input === phone ? phoneError : codeError;
+      const message = input === phone ? 'Enter your mobile number to request a code.' : 'Enter exactly six digits from your text message.';
+      input.setCustomValidity(message);
+      input.setAttribute('aria-invalid', 'true');
+      element.textContent = message;
+    });
+  }
+  purposes.forEach(input => input.addEventListener('change', () => {
+    resetChallenge();
+    verify.firstChild.textContent = purpose() === 'order' ? 'Verify & start order ' : 'Verify & sign in ';
+  }));
+  document.querySelectorAll('[data-purpose]').forEach(link => {
+    link.addEventListener('click', () => {
+      const selected = purposes.find(input => input.value === link.dataset.purpose);
+      if (!selected.checked) {
+        selected.checked = true;
+        selected.dispatchEvent(new Event('change'));
+      }
+      phone.focus({ preventScroll: true });
+    });
+  });
+  window.addEventListener('pagehide', () => {
+    generation++;
+    requestController?.abort();
+    stopSms();
+    clearInterval(cooldownTimer);
+    busy = false;
+  });
+  window.addEventListener('pageshow', updateButtons);
+})();
