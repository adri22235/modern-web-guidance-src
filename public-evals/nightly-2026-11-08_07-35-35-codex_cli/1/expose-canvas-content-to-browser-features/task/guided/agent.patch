+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const controls = document.getElementById('coffee-controls');
+      const cupLabel = document.getElementById('cup-label');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const preview = document.getElementById('cup-name-preview');
+      const summary = document.getElementById('coffee-summary');
+      const ctx = canvas.getContext('2d');
+      const nativeHTML = !!ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+
+      // Keep a single set of real controls, including in browsers without HTML-in-canvas.
+      if (!nativeHTML) {
+        canvas.removeAttribute('content');
+        stage.append(cupLabel, controls);
+      }
+
+      function layout() {
+        const width = canvas.clientWidth;
+        const mobile = width < 678;
+        const formWidth = mobile ? width - 32 : Math.min(400, width * 0.46);
+        const formX = mobile ? 16 : width - formWidth - 32;
+        const formY = mobile ? 350 : 32;
+        const cupX = mobile ? width / 2 : (formX - 16) / 2;
+        const cupY = mobile ? 28 : 82;
+        controls.style.width = `${formWidth}px`;
+        // Growing text / zoom can increase form height; never clip it at the bottom.
+        canvas.style.height = `${Math.max(mobile ? 790 : 470, formY + controls.offsetHeight + 32)}px`;
+        if (!nativeHTML) {
+          controls.style.left = `${formX}px`;
+          controls.style.top = `${formY}px`;
+          cupLabel.style.left = `${cupX - 80}px`;
+          cupLabel.style.top = `${cupY + 144}px`;
+        }
+        return { width, height: canvas.clientHeight, formX, formY, cupX, cupY };
+      }
+
+      function draw() {
+        if (!ctx) return;
+        const { width, height, formX, formY, cupX, cupY } = layout();
+        // All drawing coordinates stay in CSS pixels; the backing store uses device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+        ctx.save();
+        ctx.translate(cupX, cupY);
+
+        ctx.fillStyle = '#e2d3c2';
+        ctx.beginPath();
+        ctx.ellipse(0, 282, 120, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Steam, ceramic handle, and tapered cup.
+        ctx.strokeStyle = '#bca48e';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        for (const x of [-35, 0, 35]) {
+          ctx.beginPath();
+          ctx.moveTo(x, 48);
+          ctx.bezierCurveTo(x - 14, 32, x + 14, 22, x, 8);
+          ctx.stroke();
+        }
+        ctx.strokeStyle = '#fffdf9';
+        ctx.lineWidth = 18;
+        ctx.beginPath();
+        ctx.ellipse(90, 157, 40, 49, 0, 0, Math.PI * 2);
+        ctx.stroke();
+
+        const ceramic = ctx.createLinearGradient(-100, 0, 100, 0);
+        ceramic.addColorStop(0, '#e8d9c8');
+        ceramic.addColorStop(0.5, '#fffdf9');
+        ceramic.addColorStop(1, '#eddfd1');
+        ctx.fillStyle = ceramic;
+        ctx.beginPath();
+        ctx.moveTo(-102, 82);
+        ctx.lineTo(-80, 251);
+        ctx.quadraticCurveTo(0, 282, 80, 251);
+        ctx.lineTo(102, 82);
+        ctx.closePath();
+        ctx.fill();
+
+        ctx.fillStyle = '#4e342e';
+        ctx.fillRect(-92, 133, 184, 92);
+        ctx.fillStyle = '#fffdf9';
+        ctx.beginPath();
+        ctx.ellipse(0, 82, 103, 25, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const coffeeColors = { oat: '#c49770', whole: '#d4ab85', almond: '#b98d68', soy: '#c9a37e', none: '#4b2c20' };
+        ctx.fillStyle = coffeeColors[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(0, 82, 91, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup.value !== 'none') {
+          const syrupColors = { maple: '#8e542a', vanilla: '#f5dfad', caramel: '#b36c28', hazelnut: '#70422b' };
+          ctx.strokeStyle = syrupColors[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(0, 82, 54, 9, 0, 0, Math.PI * 1.7);
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        if (nativeHTML) {
+          // Drawing also synchronizes DOM hit testing and accessibility bounds.
+          ctx.drawElementImage(cupLabel, cupX - 80, cupY + 144);
+          ctx.drawElementImage(controls, formX, formY);
+        }
+      }
+
+      function requestDraw() {
+        if (nativeHTML) canvas.requestPaint();
+        else draw();
+      }
+
+      function update() {
+        const cupName = name.value.trim();
+        preview.textContent = cupName || 'Your daily grind';
+        const milkText = milk.selectedOptions[0].textContent.toLowerCase();
+        const syrupText = syrup.value === 'none' ? 'no syrup' : `${syrup.value} syrup`;
+        summary.textContent = `${cupName ? `${cupName}'s cup` : 'Your cup'}: ${milkText} + ${syrupText}.`;
+        requestDraw();
+      }
+
+      if (nativeHTML) canvas.onpaint = draw;
+      controls.addEventListener('input', update);
+      controls.addEventListener('change', update);
+      controls.addEventListener('submit', (event) => event.preventDefault());
+      // Repaint native input states such as focus rings and text selection, without a polling loop.
+      for (const event of ['focusin', 'focusout', 'selectionchange', 'keyup', 'pointerup']) {
+        controls.addEventListener(event, requestDraw);
+      }
+
+      function resize(entry) {
+        const { width, height } = layout();
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        const ratio = window.devicePixelRatio || 1;
+        canvas.width = Math.max(1, pixels?.inlineSize || Math.round(width * ratio));
+        canvas.height = Math.max(1, pixels?.blockSize || Math.round(height * ratio));
+        requestDraw();
+      }
+
+      const observer = new ResizeObserver(([entry]) => resize(entry));
+      const devicePixelBox = 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, devicePixelBox ? { box: 'device-pixel-content-box' } : {});
+      // Also catch font-size changes that alter the HTML controls' height.
+      new ResizeObserver(() => resize()).observe(controls);
+      window.addEventListener('resize', () => resize());
+      let densityQuery;
+      function watchDensity() {
+        densityQuery?.removeEventListener('change', onDensityChange);
+        densityQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        densityQuery.addEventListener('change', onDensityChange);
+      }
+      function onDensityChange() {
+        watchDensity();
+        resize();
+      }
+      watchDensity();
+      resize();
+      update();
+    })();
+  </script>
