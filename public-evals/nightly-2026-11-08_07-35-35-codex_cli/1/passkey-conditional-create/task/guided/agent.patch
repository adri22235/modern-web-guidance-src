+  <script>
+    // Load local compatibility helpers without delaying password sign-in.
+    const webauthnReady = import('./assets/webauthn-polyfills.js').catch(() => {});
+    const signinForm = document.querySelector('#signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.querySelector('#signin-status');
+
+    async function promotePasskey() {
+      try {
+        await webauthnReady;
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // The authenticated session determines the existing user. The server must
+        // include rp.id and excludeCredentials, and bind the challenge to this
+        // conditional ceremony so only it can relax presence verification.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const encodedResponse = credential.toJSON();
+        let rejected = false;
+        try {
+          const verification = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedResponse)
+          });
+          rejected = !verification.ok;
+          if (verification.ok && verification.status !== 204) {
+            const result = await verification.json();
+            rejected = result.verified === false || result.success === false;
+          }
+        } catch {
+          // A network failure leaves verification uncertain; preserve the key.
+          return;
+        }
+
+        if (rejected && publicKey.rp.id &&
+            typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id
+          });
+        }
+      } catch {
+        // Promotion is optional: unsupported clients, declined creation, and
+        // registration errors must never interrupt a successful password login.
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+
+      try {
+        const response = await fetch('/api/login', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+        // Contract: a successful response establishes the complete session.
+        // An incomplete authentication (including MFA) must not promote a key.
+        const result = response.status === 204 ? {} : await response.json();
+        if (result.success === false || result.authenticated === false ||
+            result.requiresMfa || result.mfaRequired) {
+          throw new Error('Sign-in incomplete');
+        }
+
+        signinForm.elements.password.value = '';
+        signinStatus.textContent = 'You’re signed in.';
+        signinButton.textContent = 'Signed in';
+        void promotePasskey();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Please check your details and try again.';
+        signinButton.disabled = false;
+      }
+    });
+  </script>
