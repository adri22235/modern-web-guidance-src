+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const progress = document.getElementById('setup-progress');
+    const completion = document.getElementById('completion-text');
+    const status = document.getElementById('save-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    let roastConfirmed = false;
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-description').value = `${roastName} · ${roast.value} of 5`;
+      roast.setAttribute('aria-valuetext', `${roastName}, ${roast.value} of 5`);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')))
+        + Number(roastConfirmed);
+      progress.value = completed;
+      progress.textContent = `${completed} of 3 complete`;
+      completion.value = `${completed} of 3 complete`;
+    }
+
+    form.addEventListener('input', (event) => {
+      if (event.target === roast) roastConfirmed = true;
+      status.textContent = '';
+      updateSetup();
+    });
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      roastConfirmed = true;
+      updateSetup();
+      const preferences = {
+        email: email.value.trim(),
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: Number(roast.value),
+        emailUpdates: document.getElementById('email-updates').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved on this device. No subscription has been started.';
+      } catch {
+        status.textContent = 'Your preferences are complete, but this browser could not save them. Please allow local storage and try again.';
+      }
+    });
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved.email === 'string'
+        && ['weekly', 'fortnightly', 'monthly'].includes(saved.frequency)
+        && Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) {
+        email.value = saved.email;
+        form.querySelector(`input[name="frequency"][value="${saved.frequency}"]`).checked = true;
+        roast.value = saved.roast;
+        document.getElementById('email-updates').checked = saved.emailUpdates === true;
+        roastConfirmed = true;
+      }
+    } catch {
+      // Preferences remain usable when local storage is unavailable.
+    }
+    updateSetup();
+  </script>
