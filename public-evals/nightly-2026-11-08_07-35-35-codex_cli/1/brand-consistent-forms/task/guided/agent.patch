+  <script>
+    const form = document.getElementById('subscription-form');
+    const roast = document.getElementById('roast-level');
+    const roastOutput = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const status = document.getElementById('subscription-status');
+    const emailUpdates = document.getElementById('email-updates');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastOutput.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--fill', `${((Number(roast.value) - 1) / 4) * 100}%`);
+      const completed = form.querySelector('input[name="frequency"]:checked') ? 2 : 1;
+      progress.value = completed;
+      progress.textContent = `${completed * 50}%`;
+      progressText.textContent = `${completed * 50}% complete`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        const frequency = Array.from(form.elements.frequency).find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        emailUpdates.checked = saved.emailUpdates === true;
+      }
+    } catch {
+      // Storage may be unavailable or contain an invalid previous value.
+    }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      status.textContent = '';
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      if (!frequency) return;
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          frequency: frequency.value,
+          roast: Number(roast.value),
+          emailUpdates: emailUpdates.checked
+        }));
+        status.textContent = 'Your coffee preferences are saved on this device. No subscription has been started.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Allow site storage and try again.';
+      }
+    });
+    updateSetup();
+  </script>
