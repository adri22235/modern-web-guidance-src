+  <script type="module">
+    const form = document.querySelector('#signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let explicitPending = false;
+    let authenticated = false;
+
+    // Load compatibility helpers only on browsers missing the native APIs.
+    const readiness = (async () => {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+        return false;
+      }
+      if (!PublicKeyCredential.getClientCapabilities ||
+          !PublicKeyCredential.parseRequestOptionsFromJSON ||
+          !PublicKeyCredential.prototype.toJSON) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+      return true;
+    })();
+
+    async function getOptions(signal, explicit) {
+      const response = await fetch('/api/login/options', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ userVerification: explicit ? 'required' : 'preferred' }),
+        signal,
+      });
+      if (!response.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+      const options = await response.json();
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options.publicKey ?? options);
+      // Discoverable credentials allow account selection without typing a username.
+      publicKey.allowCredentials = [];
+      if (explicit) publicKey.userVerification = 'required';
+      return publicKey;
+    }
+
+    async function verify(credential, publicKey, signal) {
+      const encoded = credential.toJSON();
+      const response = await fetch('/api/login/verify', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+        signal,
+      });
+      if (!response.ok) {
+        if (response.status === 404 && publicKey.rpId && PublicKeyCredential.signalUnknownCredential) {
+          // This pre-authentication response explicitly identifies an unknown credential.
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          } catch { /* Password-manager synchronization is optional. */ }
+        }
+        throw new Error('Passkey verification failed. Please try again.');
+      }
+      // Some APIs return an empty successful response; others return a verification flag.
+      const result = response.status === 204 ? null : await response.text();
+      if (result && JSON.parse(result).verified === false) {
+        throw new Error('Passkey verification failed. Please try again.');
+      }
+      if (signal.aborted) return;
+      authenticated = true;
+      status.textContent = 'Signed in successfully.';
+      button.disabled = true;
+    }
+
+    async function authenticate(explicit = false) {
+      if (authenticated || (!explicit && (explicitPending || activeRequest))) return;
+      if (explicit) {
+        if (explicitPending) return;
+        explicitPending = true;
+        button.disabled = true;
+        status.textContent = 'Use your passkey to sign in…';
+        activeRequest?.abort();
+      }
+      const controller = new AbortController();
+      activeRequest = controller;
+      let retryAutofill = false;
+      try {
+        if (!await readiness) {
+          status.textContent = 'Passkey sign-in requires a supported browser and a secure connection.';
+          return;
+        }
+        if (controller.signal.aborted) return;
+        if (!explicit) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities.conditionalGet || controller.signal.aborted) return;
+        }
+        const publicKey = await getOptions(controller.signal, explicit);
+        if (controller.signal.aborted) return;
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: controller.signal,
+            // Conditional mediation registers autofill without opening a modal.
+            ...(explicit ? {} : { mediation: 'conditional' }),
+          });
+        } catch (error) {
+          if (error.name === 'AbortError' || error.name === 'NotAllowedError') {
+            if (explicit && !controller.signal.aborted) {
+              status.textContent = 'Passkey sign-in was cancelled. You can try again.';
+              retryAutofill = true;
+            }
+            return;
+          }
+          throw error;
+        }
+        if (!credential || controller.signal.aborted) return;
+        status.textContent = 'Verifying your passkey…';
+        await verify(credential, publicKey, controller.signal);
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          status.textContent = error.message || 'Unable to sign in. Please try again.';
+        }
+      } finally {
+        if (activeRequest === controller) activeRequest = undefined;
+        if (explicit) {
+          explicitPending = false;
+          button.disabled = authenticated;
+        }
+        if (retryAutofill && !authenticated) void authenticate();
+      }
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      void authenticate(true);
+    });
+    // Arm autofill on load, so focusing the username field offers saved passkeys.
+    void authenticate();
+  </script>
