diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..6529b13
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,174 @@
+// A form-associated control: no proxy input or form-level validation workaround.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'value'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #initialized = false;
+  #disabled = false;
+  #showError = false;
+  #radios;
+  #summary;
+  #error;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; flex-wrap: wrap; gap: 4px; }
+        label { position: relative; cursor: pointer; }
+        input {
+          position: absolute; width: 1px; height: 1px; padding: 0;
+          margin: -1px; overflow: hidden; clip-path: inset(50%);
+        }
+        span {
+          display: grid; place-items: center; width: 48px; height: 48px;
+          border: 1px solid #80716b; border-radius: 5px; font-size: 2rem;
+          line-height: 1; color: #655650; background: white;
+        }
+        label[data-filled] span { color: #855000; background: #fff1d9; }
+        input:checked + span { border: 2px solid #855000; }
+        input:focus-visible + span { outline: 3px solid #955800; outline-offset: 3px; }
+        input:disabled + span { opacity: 0.6; cursor: not-allowed; }
+        .summary { margin: 8px 0 0; font-size: 0.9rem; }
+        .error { color: #a12617; margin: 8px 0 0; }
+        .error:empty { display: none; }
+        @media (forced-colors: active) {
+          input:checked + span { border: 3px solid Highlight; }
+        }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Your coffee rating" aria-describedby="error">
+        ${[1, 2, 3, 4, 5].map(value => `
+          <label>
+            <input type="radio" name="stars" value="${value}" aria-label="${value} ${value === 1 ? 'star' : 'stars'}">
+            <span aria-hidden="true">☆</span>
+          </label>`).join('')}
+      </div>
+      <p class="summary">No rating selected</p>
+      <p class="error" id="error" aria-live="polite"></p>
+    `;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#summary = root.querySelector('.summary');
+    this.#error = root.querySelector('.error');
+
+    // Only the host emits public input/change events. Native radios provide
+    // selection, Space/arrow-key support, and a single tab stop for the group.
+    root.addEventListener('input', event => event.stopPropagation());
+    root.addEventListener('change', event => {
+      event.stopPropagation();
+      if (this.#disabled || !this.#radios.includes(event.target)) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#initialized = true;
+      // Honor properties assigned before the custom element was upgraded.
+      for (const property of ['value', 'required', 'disabled']) {
+        if (Object.hasOwn(this, property)) {
+          const value = this[property];
+          delete this[property];
+          this[property] = value;
+        }
+      }
+      if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    }
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(newValue);
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#showError = false;
+    this.#sync();
+  }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value)); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    // The browser includes ancestor fieldsets here. Never reflect this state
+    // onto the host's disabled attribute: it would prevent re-enabling it.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #normalize(value) {
+    const string = String(value ?? '');
+    return /^[1-5]$/.test(string) ? string : '';
+  }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a rating from 1 to 5 stars.' : '',
+      this.#radios.find(radio => radio.value === this.#value) ?? this.#radios[0],
+    );
+    this.#render();
+  }
+
+  #render() {
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = this.#disabled;
+      const filled = Number(radio.value) <= Number(this.#value);
+      radio.parentElement.toggleAttribute('data-filled', filled);
+      radio.nextElementSibling.textContent = filled ? '★' : '☆';
+    }
+    this.#summary.textContent = this.#value ? `${this.#value} out of 5 stars` : 'No rating selected';
+    const invalid = this.#showError && !this.#disabled && !this.#internals.validity.valid;
+    this.#error.textContent = invalid ? this.validationMessage : '';
+    const group = this.shadowRoot.querySelector('[role="radiogroup"]');
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(this.#disabled));
+    group.setAttribute('aria-invalid', String(invalid));
+  }
+}
+
+if (!customElements.get('star-rating')) customElements.define('star-rating', StarRating);
