diff --git a/feedback.js b/feedback.js
new file mode 100644
index 0000000..bed572e
--- /dev/null
+++ b/feedback.js
@@ -0,0 +1,16 @@
+import './star-rating.js';
+
+const form = document.querySelector('#coffee-feedback');
+const result = document.querySelector('#feedback-result');
+
+form.addEventListener('submit', event => {
+  // Native constraint validation has already run before this event fires.
+  event.preventDefault();
+  const data = new FormData(form);
+  const rating = data.get('rating');
+  const comments = data.get('comments')?.trim();
+  result.textContent = `Your feedback preview: ${data.get('coffee')} — ${rating ?? 'no'} out of 5 stars.${comments ? ` Your comments: ${comments}` : ''} This preview has not been sent or saved.`;
+});
+
+form.addEventListener('reset', () => { result.textContent = ''; });
+form.addEventListener('input', () => { result.textContent = ''; });
