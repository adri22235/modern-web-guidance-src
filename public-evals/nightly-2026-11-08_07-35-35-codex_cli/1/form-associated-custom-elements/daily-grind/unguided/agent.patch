diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..a7eede3
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,148 @@
+// A form-associated custom element: no hidden input or submit-time value copying.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled'];
+
+  #internals;
+  #radios;
+  #output;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+        label { position: relative; cursor: pointer; line-height: 1; }
+        input { position: absolute; width: 1px; height: 1px; opacity: 0; }
+        .star {
+          display: grid; place-items: center; width: 44px; height: 48px;
+          font-size: 38px; color: #fffdf9; -webkit-text-stroke: 1.5px #9c754b;
+          border-radius: 6px; transition: color 120ms;
+        }
+        label[data-filled] .star { color: #b7782d; -webkit-text-stroke-color: #b7782d; }
+        input:focus-visible + .star { outline: 3px solid #94602d; outline-offset: 2px; }
+        label:hover .star { background: #e8ddcf; }
+        input:disabled + .star { opacity: 0.45; cursor: not-allowed; }
+        output { font: 0.85rem 'Segoe UI', sans-serif; color: #715e53; margin-left: 8px; }
+        @media (forced-colors: active) {
+          .star { -webkit-text-stroke: 0; color: CanvasText; }
+          label[data-filled] .star { color: Highlight; }
+          input:checked + .star { outline: 2px solid Highlight; }
+        }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating">
+        ${[1, 2, 3, 4, 5].map(value => `
+          <label><input type="radio" name="stars" value="${value}"
+            aria-label="${value} ${value === 1 ? 'star' : 'stars'}">
+            <span class="star" aria-hidden="true">★</span></label>
+        `).join('')}
+        <output aria-hidden="true">Not rated</output>
+      </div>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#output = root.querySelector('output');
+    root.addEventListener('input', event => event.stopPropagation());
+    root.addEventListener('change', event => {
+      if (this.#disabled || !this.#radios.includes(event.target)) return;
+      this.value = event.target.value;
+      // Native events in a shadow tree do not both cross the shadow boundary.
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) {
+      this.#value = this.#normalize(this.getAttribute('value'));
+    }
+    this.#update();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#update();
+  }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  get labels() { return this.#internals.labels; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formDisabledCallback(disabled) {
+    // The browser includes ancestor fieldsets and their first-legend exception.
+    this.#disabled = disabled;
+    this.#update();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#update();
+  }
+
+  formStateRestoreCallback(state) {
+    this.value = state;
+  }
+
+  #normalize(value) {
+    const text = String(value ?? '');
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #update() {
+    const disabled = this.#disabled || this.disabled;
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(disabled);
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = disabled;
+      radio.parentElement.toggleAttribute('data-filled', Number(radio.value) <= Number(this.#value));
+    }
+    const group = this.shadowRoot.querySelector('[role="radiogroup"]');
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(disabled));
+    this.#output.textContent = this.#value ? `${this.#value} / 5` : 'Not rated';
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true }, 'Please choose a coffee rating.', this.#radios[0],
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+}
+
+customElements.define('star-rating', StarRating);
+
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  // Submission reaches this handler only after native constraint validation.
+  const data = new FormData(form);
+  const rating = data.get('rating');
+  status.textContent = `Thanks for trying the form! You rated your ${data.get('coffee')} ${rating} out of 5. This demo hasn’t sent your feedback.`;
+});
+form.addEventListener('reset', () => { status.textContent = ''; });
+form.addEventListener('input', () => { status.textContent = ''; });
diff --git a/star-rating.test.cjs b/star-rating.test.cjs
new file mode 100644
index 0000000..1de9f18
--- /dev/null
+++ b/star-rating.test.cjs
@@ -0,0 +1,122 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+// Test the element's lifecycle contract with DOM doubles; no browser or server.
+function setup() {
+  let Element;
+  const internals = {
+    setFormValue(value, state) { this.value = value; this.state = state; },
+    setValidity(flags, message = '', anchor) {
+      this.validity = flags;
+      this.validationMessage = message;
+      this.anchor = anchor;
+    },
+    checkValidity() { return !this.validity.valueMissing; },
+    reportValidity() { return this.checkValidity(); },
+  };
+  const radios = [1, 2, 3, 4, 5].map(value => ({
+    value: String(value),
+    parentElement: { toggleAttribute() {} },
+  }));
+  const output = {};
+  const group = { setAttribute() {} };
+  const handlers = {};
+  const root = {
+    querySelectorAll() { return radios; },
+    querySelector(selector) { return selector === 'output' ? output : group; },
+    addEventListener(type, callback) { handlers[type] = callback; },
+  };
+  class HTMLElement {
+    attributes = new Map();
+    events = [];
+    attachInternals() { return internals; }
+    attachShadow() { this.shadowRoot = root; return root; }
+    getAttribute(name) { return this.attributes.get(name) ?? null; }
+    hasAttribute(name) { return this.attributes.has(name); }
+    setAttribute(name, value) {
+      this.attributes.set(name, String(value));
+      if (Element.observedAttributes.includes(name)) this.attributeChangedCallback(name);
+    }
+    toggleAttribute(name, present) {
+      if (present) this.attributes.set(name, '');
+      else this.attributes.delete(name);
+      if (Element.observedAttributes.includes(name)) this.attributeChangedCallback(name);
+    }
+    dispatchEvent(event) { this.events.push(event.type); }
+  }
+  runInNewContext(readFileSync(`${__dirname}/star-rating.js`, 'utf8'), {
+    HTMLElement,
+    Event,
+    customElements: { define(name, constructor) { Element = constructor; } },
+    document: { querySelector() { return { addEventListener() {} }; } },
+  });
+  const element = new Element();
+  element.connectedCallback();
+  return { element, internals, radios, handlers, output, Element };
+}
+
+test('participates in forms and exposes native required validation', () => {
+  const { element, internals, radios, Element } = setup();
+  assert.equal(Element.formAssociated, true);
+  element.required = true;
+  assert.equal(element.checkValidity(), false);
+  assert.equal(element.validity.valueMissing, true);
+  assert.equal(internals.anchor, radios[0]);
+  element.value = '4';
+  assert.equal(internals.value, '4');
+  assert.equal(internals.state, '4');
+  assert.equal(element.checkValidity(), true);
+  assert.equal(radios[3].checked, true);
+  element.value = '0';
+  assert.equal(internals.value, null);
+  assert.equal(element.checkValidity(), false);
+  element.required = false;
+  assert.equal(element.checkValidity(), true);
+});
+
+test('reset restores the default while state restoration restores the saved value', () => {
+  const { element, internals } = setup();
+  element.setAttribute('value', '2');
+  assert.equal(element.value, '2');
+  element.value = '5';
+  element.setAttribute('value', '3');
+  assert.equal(element.value, '5');
+  element.formResetCallback();
+  assert.equal(element.value, '3');
+  element.formStateRestoreCallback('4', 'restore');
+  assert.equal(element.value, '4');
+  assert.equal(internals.state, '4');
+  element.formStateRestoreCallback('invalid', 'autocomplete');
+  assert.equal(element.value, '');
+});
+
+test('fieldset disabling disables every radio and preserves the rating', () => {
+  const { element, radios, handlers } = setup();
+  element.value = '3';
+  element.formDisabledCallback(true);
+  assert.ok(radios.every(radio => radio.disabled));
+  handlers.change({ target: radios[4] });
+  assert.equal(element.value, '3');
+  element.formDisabledCallback(false);
+  assert.ok(radios.every(radio => !radio.disabled));
+  assert.equal(element.value, '3');
+  element.disabled = true;
+  assert.ok(radios.every(radio => radio.disabled));
+  element.disabled = false;
+  assert.ok(radios.every(radio => !radio.disabled));
+});
+
+test('user selection updates form value and emits one input and change pair', () => {
+  const { element, handlers, radios, internals, output } = setup();
+  handlers.change({ target: radios[4] });
+  assert.equal(element.value, '5');
+  assert.equal(internals.value, '5');
+  assert.equal(output.textContent, '5 / 5');
+  assert.deepEqual(element.events, ['input', 'change']);
+  element.formResetCallback();
+  assert.equal(element.value, '');
+  assert.equal(internals.value, null);
+  assert.deepEqual(element.events, ['input', 'change']);
+});
