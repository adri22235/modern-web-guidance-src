+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+  <!-- Critical styles are ready before the incoming snapshot is captured.
+       Keep initial theme/layout scripts in this head, before content renders;
+       async or module initializers must also use blocking="render". -->
+  <link rel="stylesheet" href="/styles.css" blocking="render">
+  <!-- End markers wait for complete sections, without waiting for the footer. -->
+  <link rel="expect" href="#header-ready" blocking="render">
+  <link rel="expect" href="#hero-ready" blocking="render">
+  <link rel="expect" href="#content-ready" blocking="render">
+  <link rel="preload" as="image" fetchpriority="high"
+    href="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&amp;fit=crop&amp;w=1350&amp;q=80">
+</head>
+
+<body>
+
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/" aria-label="The Daily Grind home">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/" aria-current="page">Menu</a></li>
+      <li><a href="/locations/">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+    <span id="header-ready" hidden></span>
+  </nav>
+
+  <header class="hero page-hero">
+    <h1>Your Daily Favorite</h1>
+    <p>Thoughtfully sourced coffee, made just the way you like it.</p>
+    <span id="hero-ready" hidden></span>
+  </header>
+
+  <main class="container">
+    <section aria-labelledby="menu-heading">
+      <h2 id="menu-heading" style="text-align: center;">Our Coffee Menu</h2>
+      <div class="grid">
+        <article class="card" id="seasonal">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <p class="price">Seasonal favorite</p>
+        </article>
+        <article class="card" id="espresso">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <p class="price">Our signature roast</p>
+        </article>
+        <article class="card" id="cold-brew">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <p class="price">Served over ice</p>
+        </article>
+      </div>
+      <a href="/locations/" class="btn">Find a Location</a>
+      <span id="content-ready" hidden></span>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..efc5926
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,219 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Both documents opt in; unsupported browsers keep normal link navigation. */
+@view-transition {
+  navigation: auto;
+}
+
+/* Keep the shared header steady while the page content crossfades. */
+nav {
+  view-transition-name: site-header;
+}
+
+::view-transition-group(root),
+::view-transition-group(site-header) {
+  animation-duration: 240ms;
+  animation-timing-function: ease-in-out;
+}
+
+nav a.logo {
+  font-size: 1.5rem;
+}
+
+nav a[aria-current="page"] {
+  color: var(--accent);
+  text-decoration: underline;
+  text-underline-offset: 5px;
+}
+
+.page-hero {
+  height: 36vh;
+  min-height: 240px;
+}
+
+.card .price {
+  margin-top: 12px;
+  font-weight: bold;
+}
+
+@media (max-width: 640px) {
+  nav {
+    flex-wrap: wrap;
+    gap: 12px;
+  }
+
+  nav ul {
+    flex-wrap: wrap;
+    gap: 10px 16px;
+  }
+
+  nav ul li {
+    margin-left: 0;
+  }
+
+  .hero h1 {
+    font-size: 2.25rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+
+  nav a,
+  .btn {
+    transition: none;
+  }
+}
