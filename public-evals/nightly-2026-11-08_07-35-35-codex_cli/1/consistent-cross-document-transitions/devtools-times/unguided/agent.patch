diff --git a/src/styles/header.css b/src/styles/header.css
new file mode 100644
index 0000000..e4ab673
--- /dev/null
+++ b/src/styles/header.css
@@ -0,0 +1,12 @@
+/* Loaded in the head so the masthead is styled before its snapshot is taken. */
+#masthead {
+  view-transition-name: masthead;
+}
+
+#masthead .masthead-logo {
+  display: block;
+  width: 20rem;
+  max-width: 100%;
+  height: auto;
+  margin-inline: auto;
+}
