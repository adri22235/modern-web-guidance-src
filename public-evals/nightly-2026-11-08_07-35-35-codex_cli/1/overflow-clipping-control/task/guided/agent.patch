     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase: keep the layout outside the two independent clip boundaries. */
+    .showcase {
+      margin-block-end: 48px;
+    }
+
+    .showcase-heading {
+      margin-block-end: 20px;
+      text-align: center;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
+      gap: 32px;
+      align-items: center;
+    }
+
+    .nested-curve-parent {
+      min-inline-size: 0;
+      padding: 18px 24px 24px;
+      border-radius: 40px;
+      background: var(--secondary);
+      /* Fallback keeps descendants contained at the padding edge. */
+      overflow: hidden;
+    }
+
+    .showcase-photo {
+      display: block;
+      inline-size: 100%;
+      block-size: 220px;
+      object-fit: cover;
+      object-position: center 60%;
+    }
+
+    .nested-curve-footer {
+      margin: 0;
+      padding: 24px;
+      background: var(--primary);
+      color: white;
+      text-align: start;
+    }
+
+    .showcase-eyebrow {
+      color: var(--accent);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      margin-block-end: 8px;
+    }
+
+    .nested-curve-footer h3,
+    .promo-copy h3 {
+      font-size: 1.5rem;
+      margin-block-end: 8px;
+    }
+
+    .safety-zone-parent {
+      min-inline-size: 0;
+      padding: 28px 24px 0;
+      border-radius: 24px;
+      background: #f1e9e2;
+      overflow: hidden;
+    }
+
+    /* The safety margin applies to all ink, so text gets its own strict clip. */
+    .promo-copy {
+      overflow: hidden;
+      overflow: clip;
+      overflow-wrap: anywhere;
+    }
+
+    .promo-copy .showcase-eyebrow {
+      color: var(--primary);
+    }
+
+    .promo-action {
+      margin-block-start: 24px;
+    }
+
+    .promo-button {
+      display: block;
+      inline-size: 100%;
+      padding: 16px 20px;
+      border: 0;
+      border-radius: 12px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 28px 5px rgb(255 171 64 / 65%);
+    }
+
+    .promo-button:hover {
+      background: #ffbd69;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* The browser derives concentric curves from the radius and padding. */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
+    @media (max-width: 640px) {
+      .showcase-grid {
+        grid-template-columns: minmax(0, 1fr);
+      }
+    }
+
