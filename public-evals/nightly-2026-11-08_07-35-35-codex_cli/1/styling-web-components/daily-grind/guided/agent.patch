+  <template id="coffee-card-template">
+    <style>
+      /* Priority increases left to right; these layers belong to this shadow root. */
+      @layer reset, base, theme, variants, layout;
+
+      @layer reset {
+        *, *::before, *::after { box-sizing: border-box; }
+        ::slotted(*) { margin: 0; }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          min-width: 0;
+          border: 1px solid transparent;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+          text-align: center;
+          container: coffee-card / inline-size;
+        }
+
+        article {
+          display: grid;
+          gap: 15px;
+          padding: 20px;
+          height: 100%;
+          overflow-wrap: anywhere;
+        }
+
+        .content { display: grid; gap: 10px; }
+        .actions { align-self: end; }
+        ::slotted([slot="title"]) { font-size: 1.17em; font-weight: bold; }
+      }
+
+      @layer theme {
+        /* Read public tokens instead of defining them here, so ancestor overrides inherit.
+           Font and line-height inherit naturally from the site's body. */
+        :host {
+          background: var(--card-background, white);
+          color: var(--text, #3e2723);
+        }
+        .heading { color: var(--primary, #4e342e); }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          border-color: var(--accent, #ffab40);
+          border-top-width: 4px;
+        }
+
+        :host([variant="compact"]) {
+          background: var(--card-background, var(--secondary, #d7ccc8));
+          box-shadow: none;
+        }
+
+        :host([variant="compact"]) article { padding: 16px; }
+      }
+
+      @layer layout {
+        /* Query the host and rearrange its children, never the query container itself. */
+        @container coffee-card (min-width: 28rem) {
+          article {
+            grid-template-columns: minmax(0, 1fr) auto;
+            align-items: center;
+            gap: 24px;
+            text-align: start;
+          }
+          .actions { align-self: center; }
+        }
+
+        @container coffee-card (max-width: 18rem) {
+          article { padding: 16px; }
+          ::slotted([slot="action"]) { display: block; }
+        }
+      }
+    </style>
+    <article part="surface">
+      <div class="content" part="content">
+        <header class="heading" part="heading"><slot name="title"></slot></header>
+        <slot name="description"></slot>
+        <slot></slot>
+      </div>
+      <div class="actions" part="actions"><slot name="action"></slot></div>
+    </article>
+  </template>
+
+  <script type="module">
+    // Parse once and deep-clone per card; projected content remains in the Light DOM.
+    const cardTemplate = document.getElementById('coffee-card-template');
+
+    class CoffeeCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' })
+          .append(cardTemplate.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
+
