+  <template id="drink-card-template">
+    <style>
+      /* Later layers take priority without specificity escalation. */
+      @layer reset, base, variants, responsive;
+
+      @layer reset {
+        :host, *, *::before, *::after {
+          box-sizing: border-box;
+        }
+
+        ::slotted(*) {
+          margin: 0;
+        }
+      }
+
+      @layer base {
+        /* Site tokens and typography inherit through the shadow boundary. */
+        :host {
+          display: block;
+          min-width: 0;
+          height: 100%;
+          border: 1px solid var(--secondary, #d7ccc8);
+          border-radius: 8px;
+          background: var(--card-background, white);
+          color: var(--text, #3e2723);
+          font: inherit;
+          container: drink-card / inline-size;
+        }
+
+        .surface {
+          display: grid;
+          grid-template-rows: auto 1fr auto;
+          gap: 10px;
+          min-width: 0;
+          min-height: 100%;
+          padding: var(--card-padding, 20px);
+          border-radius: inherit;
+          text-align: center;
+          overflow-wrap: anywhere;
+        }
+
+        .heading {
+          color: var(--primary, #4e342e);
+        }
+
+        .actions {
+          padding-top: 5px;
+          align-self: end;
+        }
+
+        ::slotted([slot="title"]) {
+          font-size: 1.17em;
+        }
+
+        ::slotted([slot="action"]) {
+          max-width: 100%;
+        }
+      }
+
+      @layer variants {
+        /* Variants style the custom element's own outer box. */
+        :host([variant="featured"]) {
+          border: 2px solid var(--accent, #ffab40);
+          background: var(--card-featured-background, #fff8ef);
+        }
+
+        :host([variant="compact"]) {
+          --card-padding: 16px;
+          border-style: dashed;
+        }
+      }
+
+      @layer responsive {
+        @container drink-card (max-width: 18rem) {
+          .surface {
+            padding: 16px;
+            gap: 8px;
+          }
+        }
+
+        /* A card in a wider placement can arrange its action alongside copy. */
+        @container drink-card (min-width: 28rem) {
+          .surface {
+            grid-template-columns: minmax(0, 1fr) auto;
+            grid-template-rows: auto 1fr;
+            text-align: left;
+            column-gap: 24px;
+          }
+
+          .heading, .description {
+            grid-column: 1;
+          }
+
+          .actions {
+            grid-column: 2;
+            grid-row: 1 / 3;
+            align-self: center;
+            padding-top: 0;
+          }
+        }
+      }
+    </style>
+    <article class="surface" part="surface">
+      <header class="heading" part="heading"><slot name="title"></slot></header>
+      <div class="description" part="description"><slot name="description"></slot></div>
+      <div class="actions" part="actions"><slot name="action"></slot></div>
+    </article>
+  </template>
+  <script type="module">
+    const drinkCardTemplate = document.getElementById('drink-card-template');
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' })
+          .append(drinkCardTemplate.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
