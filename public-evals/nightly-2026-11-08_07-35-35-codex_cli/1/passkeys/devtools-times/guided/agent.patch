+        <h2 id="verify-title" className="text-lg font-bold">Verify it’s you</h2>
+        <p className="mb-4 mt-2 text-sm text-gray-600">Confirm your identity before changing your account. This verification lasts for 5 minutes.</p>
+        <Notice error={verifyError} />
+        {caps.supported && data.credentials.length > 0 && <button type="button" disabled={busy} className={`${primaryClass} mb-4 w-full`} onClick={() => void reauthenticate('passkey')}><PasskeyIcon />{busy ? 'Verifying…' : 'Verify with a passkey'}</button>}
+        <form onSubmit={e => { e.preventDefault(); void reauthenticate('password'); }} className="space-y-3">
+          <input type="text" name="username" autoComplete="username" value={data.user.name} readOnly hidden />
+          <label htmlFor="verify-password" className="block text-sm font-medium">Confirm with your password</label>
+          <input id="verify-password" name="password" type="password" autoComplete="current-password" required value={password} disabled={busy} onChange={e => setPassword(e.target.value)} className={inputClass} />
+          <div className="flex flex-wrap gap-3"><button type="submit" disabled={busy} className={secondaryClass}>{busy ? 'Verifying…' : 'Verify with password'}</button><button type="button" disabled={busy} onClick={closeVerification} className={secondaryClass}>Cancel</button></div>
+        </form>
+      </section>}
+      <fieldset disabled={busy || verify} className="min-w-0 space-y-6 disabled:opacity-60">
+        <section aria-labelledby="profile-title" className="rounded-lg border border-gray-200 p-6">
+          <h2 id="profile-title" className="mb-4 text-xl font-bold">Profile</h2>
+          <form onSubmit={updateProfile} className="space-y-4">
+            <div><label htmlFor="account-username" className="mb-1 block text-sm font-medium">Username</label><input id="account-username" name="username" autoComplete="username" required minLength={3} maxLength={40} value={name} onChange={e => setName(e.target.value)} className={inputClass} /></div>
+            <div><label htmlFor="display-name" className="mb-1 block text-sm font-medium">Display name</label><input id="display-name" name="displayName" autoComplete="nickname" required maxLength={80} value={displayName} onChange={e => setDisplayName(e.target.value)} className={inputClass} /></div>
+            <button type="submit" className={secondaryClass}>Save profile</button>
+          </form>
+        </section>
+        <section aria-labelledby="passkeys-title" className="rounded-lg border border-gray-200 p-6">
+          <div className="mb-3 flex items-center gap-2"><PasskeyIcon /><h2 id="passkeys-title" className="text-xl font-bold">Passkeys</h2></div>
+          <p className="mb-5 text-sm text-gray-600">Sign in with your fingerprint, face, or screen lock. Passkeys are stored in your password manager, and you can also use a security key.</p>
+          {data.credentials.length === 0 ? <div className="mb-5 rounded-md bg-gray-50 p-5"><p className="font-medium">No passkeys yet</p><p className="mt-1 text-sm text-gray-600">Create your first passkey to make your next sign-in faster. Your password will still work.</p></div> : <ul className="mb-5 divide-y divide-gray-200">
+            {data.credentials.map(key => <li key={key.id} className="py-5 first:pt-0">
+              <div className="flex items-start gap-3">
+                {key.providerIcon ? <img src={key.providerIcon} width={28} height={28} alt="" className="mt-1 h-7 w-7 object-contain" /> : <span className="mt-1 rounded-md bg-gray-100 p-1.5"><PasskeyIcon /></span>}
+                <div className="min-w-0 flex-1"><p className="break-words font-semibold">{key.name}</p><p className="mt-0.5 text-sm text-gray-600">{key.provider} · {key.credentialBackedUp ? 'Backed up' : key.credentialDeviceType === 'multiDevice' ? 'Sync supported' : 'Device-bound'}</p><p className="mt-2 text-xs text-gray-600">Created {date(key.registeredAt)} · Last used: {date(key.lastUsedAt)}</p></div>
+              </div>
