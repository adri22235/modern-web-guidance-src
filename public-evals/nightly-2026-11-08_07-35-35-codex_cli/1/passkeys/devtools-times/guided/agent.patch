--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,83 @@
+export interface AccountUser { id: string; name: string; displayName: string }
+export interface SavedPasskey {
+  id: string; name: string; provider: string; providerIcon?: string; registeredAt: number;
+  lastUsedAt?: number; credentialBackedUp: boolean; credentialDeviceType: string;
+}
+export interface AccountData { user: AccountUser; rpId: string; userId: string; credentials: SavedPasskey[] }
+export const accountUrl = `${import.meta.env.BASE_URL}account/settings`;
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) { super(message); }
+}
+export async function api<T = { user: AccountUser }>(path: string, body?: unknown, method = body === undefined ? 'GET' : 'POST', signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${path}`, {
+    method, credentials: 'same-origin', signal,
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new ApiError(data.error || 'The request failed. Please try again.', response.status, data.code);
+  return data;
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was canceled or timed out. Try again, or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable for this site. Use your password and contact support.';
+    if (error.name === 'AbortError') return 'The passkey request was canceled. You can try again.';
+  }
+  return error instanceof ApiError ? error.message : 'We could not connect. Please try again.';
+}
+
+// Load only in the browser; these polyfills reference browser globals.
+export async function passkeyCapabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return { supported: false, create: false, conditional: false };
+  await import('webauthn-polyfills');
+  try {
+    const caps = await PublicKeyCredential.getClientCapabilities();
+    return { supported: caps.conditionalGet === true, create: caps.passkeyPlatformAuthenticator === true && caps.conditionalGet === true, conditional: caps.conditionalGet === true };
+  } catch { return { supported: false, create: false, conditional: false }; }
+}
+const validId = (id: string) => typeof id === 'string' && id.length > 0 && id.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(id);
+async function passiveSignal(work: () => Promise<void>) {
+  try { await work(); } catch (error) { console.warn('Passkey provider synchronization was skipped:', error); }
+}
+async function signalUnknown(rpId: string | undefined, id: string) {
+  if (rpId && validId(id) && PublicKeyCredential.signalUnknownCredential) {
+    await passiveSignal(() => PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: id }));
+  }
+}
+export async function syncPasskeys(data: AccountData) {
+  if (window.PublicKeyCredential && typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' && data.rpId && validId(data.userId) && data.credentials.every(k => validId(k.id))) {
+    await passiveSignal(() => PublicKeyCredential.signalAllAcceptedCredentials({ rpId: data.rpId, userId: data.userId, allAcceptedCredentialIds: data.credentials.map(k => k.id) }));
+  }
+}
+export async function syncProfile(data: AccountData) {
+  if (window.PublicKeyCredential && typeof PublicKeyCredential.signalCurrentUserDetails === 'function' && data.rpId && validId(data.userId)) {
+    await passiveSignal(() => PublicKeyCredential.signalCurrentUserDetails({ rpId: data.rpId, userId: data.userId, name: data.user.name, displayName: data.user.displayName }));
+  }
+}
+export async function registerPasskey(promotion: boolean, signal: AbortSignal) {
+  const { publicKey: options, requestId } = await api<{ publicKey: PublicKeyCredentialCreationOptionsJSON; requestId: string }>('passkeys/register/options', { promotion }, 'POST', signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('Canceled', 'NotAllowedError');
+  const encoded = credential.toJSON();
+  try { return await api<AccountData>('passkeys/register/verify', { requestId, credential: encoded }, 'POST', signal); }
+  catch (error) {
+    await signalUnknown(publicKey.rp.id, credential.id);
+    throw error;
+  }
+}
+export async function authenticatePasskey(signal: AbortSignal, conditional = false, reauth = false) {
+  const path = reauth ? 'reauth/passkey' : 'passkeys/authenticate';
+  const { publicKey: options, requestId } = await api<{ publicKey: PublicKeyCredentialRequestOptionsJSON; requestId: string }>(`${path}/options`, {}, 'POST', signal);
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  if (reauth && !publicKey.allowCredentials?.length) throw new ApiError('No registered passkeys. Verify with your password.', 400);
+  const credential = await navigator.credentials.get({ publicKey, signal, ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('Canceled', 'NotAllowedError');
+  try { return await api<{ user: AccountUser; verified: boolean }>(`${path}/verify`, { requestId, credential: credential.toJSON() }, 'POST', signal); }
+  catch (error) {
+    if (!reauth && error instanceof ApiError && error.status === 404 && error.code === 'UNKNOWN_CREDENTIAL') await signalUnknown(publicKey.rpId, credential.id);
+    throw error;
+  }
+}
