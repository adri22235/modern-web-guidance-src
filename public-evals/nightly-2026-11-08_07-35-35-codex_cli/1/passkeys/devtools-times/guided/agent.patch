+    pending.current = work || null;
+    setPassword(''); setVerifyError(null); setVerify(true);
+  }
+  function closeVerification() {
+    controller.current?.abort(); pending.current = null;
+    setVerify(false); setPassword(''); setVerifyError(null);
+    returnFocus.current?.focus();
+  }
+  async function perform(work: () => Promise<void>) {
+    if (lock.current) return;
+    lock.current = true; setBusy(true); setError(null); setSuccess(null);
+    try { await work(); }
