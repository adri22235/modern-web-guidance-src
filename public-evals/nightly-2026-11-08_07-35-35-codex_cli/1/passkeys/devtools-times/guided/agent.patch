diff --git a/src/pages/api/auth/[...action].ts b/src/pages/api/auth/[...action].ts
new file mode 100644
index 0000000..f73b11c
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,211 @@
+import type { APIRoute } from 'astro';
+import { createHash } from 'node:crypto';
+import { generateAuthenticationOptions, generateRegistrationOptions, verifyAuthenticationResponse, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { transaction, randomId, hashPassword, checkPassword, type User, type AuthSession } from '../../../lib/server/auth-store';
+import providers from '../../../lib/server/aaguids.json';
+
+class AuthError extends Error {
+  constructor(public status: number, message: string, public code?: string) { super(message); }
+}
+function fail(status: number, message: string, code?: string): never { throw new AuthError(status, message, code); }
+const sessionKey = (value: string) => createHash('sha256').update(value).digest('hex');
+const limits = new Map<string, { count: number; reset: number }>();
+function rateLimit(key: string) {
+  const now = Date.now();
+  for (const [id, value] of limits) if (value.reset < now) limits.delete(id);
+  const value = limits.get(key) || { count: 0, reset: now + 60_000 };
+  limits.set(key, value);
+  if (++value.count > 30) fail(429, 'Too many attempts. Please wait a minute and try again.');
+}
+const publicUser = (user: User) => ({ id: user.id, name: user.name, displayName: user.displayName });
+
+export const ALL: APIRoute = async (context) => {
+  const { request, url, cookies, params } = context;
+  const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+    status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', 'Vary': 'Cookie' },
+  });
+  try {
+    const local = ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
+    const origin = process.env.WEBAUTHN_ORIGIN || (local ? url.origin : 'https://astro-news-pytrpecapa-uc.a.run.app');
+    const rpID = process.env.WEBAUTHN_RP_ID || new URL(origin).hostname;
+    const action = params.action || '';
+    const method = request.method;
+    if (method !== 'GET') {
+      if (request.headers.get('origin') !== origin) fail(403, 'This request must come from this site.');
+      if (!request.headers.get('content-type')?.includes('application/json')) fail(415, 'Expected JSON.');
+      if (Number(request.headers.get('content-length')) > 65536) fail(413, 'Request is too large.');
+    }
+    // Rate limit all ceremony and password endpoints before costly verification.
+    let address = 'local';
+    try { address = context.clientAddress; } catch { /* static adapters may omit client address */ }
+    if (method !== 'GET') rateLimit(address);
+    const rawBody = method === 'GET' ? '{}' : await request.text();
+    if (rawBody.length > 65536) fail(413, 'Request is too large.');
+    let body: Record<string, any> = {};
+    try { body = JSON.parse(rawBody); } catch { fail(400, 'Invalid JSON.'); }
+    if (!body || typeof body !== 'object' || Array.isArray(body)) fail(400, 'Invalid request.');
+    return await transaction(async (store) => {
+      let token = cookies.get('times-auth')?.value;
+      let session: AuthSession | undefined = token ? store.sessions[sessionKey(token)] : undefined;
+      const setCookie = (value: string) => cookies.set('times-auth', value, {
+        httpOnly: true, secure: new URL(origin).protocol === 'https:', sameSite: 'lax',
+        path: import.meta.env.BASE_URL, maxAge: 60 * 60 * 24 * 7,
+      });
+      const newSession = (userId?: string) => {
+        if (token) delete store.sessions[sessionKey(token)];
+        token = randomId();
+        session = { userId, expiresAt: Date.now() + 7 * 86400000, challenges: {} };
+        store.sessions[sessionKey(token)] = session;
+        setCookie(token);
+        return session;
+      };
+      const user = () => store.users.find(u => u.id === session?.userId) || fail(401, 'Sign in to manage your account.');
+      const recent = () => {
+        user();
+        if (!session?.verifiedAt || Date.now() - session.verifiedAt > 5 * 60_000) fail(403, 'Verify your identity to continue.', 'REAUTH_REQUIRED');
+      };
+      const username = () => {
+        if (typeof body.username !== 'string' || !/^[\p{L}\p{N}_.@+ -]{3,40}$/u.test(body.username.trim())) fail(400, 'Use a username of 3–40 letters, numbers, spaces, or . _ @ + -');
+        return body.username.trim();
+      };
+      const password = () => {
+        if (typeof body.password !== 'string' || body.password.length > 1024) fail(400, 'Enter a valid password.');
+        return body.password;
+      };
+      const list = () => ({
+        user: publicUser(user()), rpId: rpID, userId: user().id,
+        credentials: user().passkeys.map(({ publicKey, counter, ...key }) => {
+          const provider = (providers as Record<string, { name: string; icon_light?: string }>)[key.aaguid];
+          return { ...key, provider: provider?.name || 'Unknown passkey provider', providerIcon: provider?.icon_light };
+        }),
+      });
+      const challenge = (kind: string, value: string, requiredUV: boolean, userId?: string) => {
+        if (!session) newSession();
+        const requestId = randomId();
+        // Keep challenges separate so autofill, tabs, and explicit prompts cannot overwrite one another.
+        if (Object.keys(session!.challenges).length >= 12) session!.challenges = {};
+        session!.challenges[requestId] = { challenge: value, kind, userId: userId || session!.userId, requiredUV, expiresAt: Date.now() + 5 * 60_000 };
+        return requestId;
+      };
+      const consume = (kind: string) => {
+        const value = session?.challenges[body.requestId];
+        if (session && typeof body.requestId === 'string') delete session.challenges[body.requestId];
+        if (!value || value.kind !== kind || value.expiresAt < Date.now() || value.userId !== session?.userId) fail(400, 'This verification expired. Please try again.');
+        return value;
+      };
+
+      if (action === 'session' && method === 'GET') return json({ user: session?.userId ? publicUser(user()) : null });
+      if (action === 'logout' && method === 'POST') {
+        if (token) delete store.sessions[sessionKey(token)];
+        cookies.delete('times-auth', { path: import.meta.env.BASE_URL });
+        return json({ success: true });
+      }
+      if (action === 'register' && method === 'POST') {
+        const name = username();
+        const secret = password();
+        if (secret.length < 8 || !/\d/.test(secret)) fail(400, 'Use at least 8 characters and include a number.');
+        if (store.users.some(u => u.name.toLowerCase() === name.toLowerCase())) fail(409, 'That username is already in use.');
+        const created: User = { id: randomId(), name, displayName: name, passwordHash: await hashPassword(secret), passkeys: [] };
+        store.users.push(created);
+        newSession(created.id).verifiedAt = Date.now();
+        return json({ user: publicUser(created) }, 201);
+      }
+      if (action === 'login' && method === 'POST') {
+        const name = username();
+        const secret = password();
+        const found = store.users.find(u => u.name.toLowerCase() === name.toLowerCase());
+        // Do comparable password work for unknown accounts.
+        const hash = found?.passwordHash || `missing-account:${'0'.repeat(128)}`;
+        if (!await checkPassword(secret, hash) || !found) fail(401, 'The username or password is incorrect.');
+        newSession(found.id).verifiedAt = Date.now();
+        return json({ user: publicUser(found) });
+      }
+      if (action === 'reauth/password' && method === 'POST') {
+        if (!await checkPassword(password(), user().passwordHash)) fail(401, 'That password is incorrect.');
+        session!.verifiedAt = Date.now();
+        return json({ verified: true });
+      }
+      if (action === 'passkeys' && method === 'GET') return json(list());
+      if (action === 'passkeys/register/options' && method === 'POST') {
+        recent();
+        const current = user();
+        const options = await generateRegistrationOptions({
+          rpName: 'The DevTools Times', rpID, userID: Buffer.from(current.id, 'base64url'),
+          userName: current.name, userDisplayName: current.displayName, attestationType: 'none',
+          excludeCredentials: current.passkeys.map(k => ({ id: k.id, transports: k.transports })),
+          authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred',
+            ...(body.promotion === true ? { authenticatorAttachment: 'platform' as const } : {}) },
+        });
+        return json({ publicKey: options, requestId: challenge('register', options.challenge, false, current.id) });
+      }
+      if (action === 'passkeys/register/verify' && method === 'POST') {
+        recent();
+        const expected = consume('register');
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: expected.challenge,
+          expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: expected.requiredUV });
+        if (!result.verified) fail(400, 'The passkey could not be verified.');
+        const info = result.registrationInfo;
+        if (store.users.some(u => u.passkeys.some(k => k.id === info.credential.id))) fail(409, 'This passkey is already registered.');
+        const provider = (providers as Record<string, { name: string }>)[info.aaguid];
+        user().passkeys.push({ id: info.credential.id, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+          counter: info.credential.counter, transports: info.credential.transports || [], name: provider?.name || 'My passkey',
+          aaguid: info.aaguid, credentialDeviceType: info.credentialDeviceType,
+          credentialBackedUp: info.credentialBackedUp, registeredAt: Date.now() });
+        return json(list(), 201);
+      }
+      const reauth = action.startsWith('reauth/passkey/');
+      if ((action === 'passkeys/authenticate/options' || action === 'reauth/passkey/options') && method === 'POST') {
+        const current = reauth ? user() : undefined;
+        if (reauth && !current!.passkeys.length) fail(400, 'Use your password to verify your identity.');
+        const options = await generateAuthenticationOptions({ rpID, userVerification: reauth ? 'required' : 'preferred',
+          allowCredentials: current ? current.passkeys.map(k => ({ id: k.id, transports: k.transports })) : [] });
+        return json({ publicKey: options, requestId: challenge(reauth ? 'reauth' : 'login', options.challenge, reauth, current?.id) });
+      }
+      if ((action === 'passkeys/authenticate/verify' || action === 'reauth/passkey/verify') && method === 'POST') {
+        if (reauth) user();
+        const expected = consume(reauth ? 'reauth' : 'login');
+        const owner = store.users.find(u => u.passkeys.some(k => k.id === body.credential?.id));
+        if (!owner) fail(404, 'This passkey is no longer registered.', 'UNKNOWN_CREDENTIAL');
+        if (reauth && owner.id !== user().id) fail(403, 'Use a passkey belonging to your signed-in account.');
+        if (body.credential.response?.userHandle && body.credential.response.userHandle !== owner.id) fail(403, 'The passkey account does not match.');
+        const key = owner.passkeys.find(k => k.id === body.credential.id)!;
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: expected.challenge,
+          expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: expected.requiredUV,
+          credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports } });
+        if (!result.verified) fail(401, 'The passkey could not be verified.');
+        key.counter = result.authenticationInfo.newCounter;
+        key.lastUsedAt = Date.now();
+        key.credentialBackedUp = result.authenticationInfo.credentialBackedUp;
+        if (!reauth) newSession(owner.id);
+        session!.verifiedAt = Date.now();
+        return json({ verified: true, user: publicUser(owner) });
+      }
+      if (action === 'profile' && method === 'PUT') {
+        recent();
+        const name = username();
+        if (store.users.some(u => u.id !== user().id && u.name.toLowerCase() === name.toLowerCase())) fail(409, 'That username is already in use.');
+        if (typeof body.displayName !== 'string' || !body.displayName.trim() || body.displayName.length > 80) fail(400, 'Enter a display name of 1–80 characters.');
+        user().name = name;
+        user().displayName = body.displayName.trim();
+        return json(list());
+      }
+      if (action.startsWith('passkeys/') && ['PUT', 'DELETE'].includes(method)) {
+        recent();
+        const id = action.slice('passkeys/'.length);
+        const key = user().passkeys.find(k => k.id === id) || fail(404, 'Passkey not found.');
+        if (method === 'DELETE') user().passkeys = user().passkeys.filter(k => k.id !== id);
+        else {
+          if (typeof body.name !== 'string' || !body.name.trim() || body.name.length > 80) fail(400, 'Enter a passkey name of 1–80 characters.');
+          key.name = body.name.trim();
+        }
+        return json(list());
+      }
+      return json({ error: 'Endpoint not found.' }, 404);
+    });
+  } catch (error) {
+    if (error instanceof AuthError) return json({ error: error.message, code: error.code }, error.status);
+    // Malformed or cryptographically invalid WebAuthn assertions never create a session.
+    console.warn('Authentication request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'We could not complete this request. Please try again.' }, 400);
+  }
+};
diff --git a/tests/auth-store.test.mjs b/tests/auth-store.test.mjs
new file mode 100644
index 0000000..b5b4c0c
--- /dev/null
+++ b/tests/auth-store.test.mjs
@@ -0,0 +1,60 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm, readFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+// Isolate persistence before importing the server helper (never the application entrypoint).
+const directory = await mkdtemp(join(tmpdir(), 'times-auth-test-'));
+process.env.AUTH_STORE_PATH = join(directory, 'auth.json');
+const { hashPassword, checkPassword, randomId, transaction } = await import('../src/lib/server/auth-store.ts');
+
+test('account authentication primitives and persistent storage', async t => {
+  try {
+    await t.test('password hashes have independent salts and reject incorrect passwords', async () => {
+      const first = await hashPassword('a secure password 42');
+      const second = await hashPassword('a secure password 42');
+      assert.notEqual(first, second);
+      assert.equal(await checkPassword('a secure password 42', first), true);
+      assert.equal(await checkPassword('wrong password 42', first), false);
+      assert.equal(await checkPassword('a secure password 42', second), true);
+    });
+    await t.test('user and ceremony identifiers are unique, valid unpadded Base64URL', () => {
+      const ids = Array.from({ length: 100 }, randomId);
+      assert.equal(new Set(ids).size, 100);
+      for (const id of ids) {
+        assert.match(id, /^[A-Za-z0-9_-]+$/);
+        assert.notEqual(id.length % 4, 1);
+        assert.equal(Buffer.from(id, 'base64url').length, 32);
+      }
+    });
+    await t.test('concurrent transactions persist every write without lost updates', async () => {
+      await Promise.all(Array.from({ length: 10 }, (_, index) => transaction(async store => {
+        await Promise.resolve();
+        store.sessions[`session-${index}`] = { expiresAt: Date.now() + 60000, challenges: {} };
+      })));
+      const persisted = JSON.parse(await readFile(process.env.AUTH_STORE_PATH, 'utf8'));
+      assert.equal(Object.keys(persisted.sessions).length, 10);
+    });
+    await t.test('a consumed challenge remains consumed if verification throws', async () => {
+      await transaction(async store => {
+        store.sessions['session-0'].challenges.once = { challenge: randomId(), kind: 'login', requiredUV: false, expiresAt: Date.now() + 60000 };
+      });
+      await assert.rejects(transaction(async store => {
+        delete store.sessions['session-0'].challenges.once;
+        throw new Error('Verification failed');
+      }), /Verification failed/);
+      await transaction(async store => assert.equal(store.sessions['session-0'].challenges.once, undefined));
+    });
+    await t.test('expired sessions and outstanding challenges are pruned', async () => {
+      await transaction(async store => {
+        store.sessions.expired = { expiresAt: Date.now() - 1, challenges: {} };
+        store.sessions['session-0'].challenges.expired = { challenge: randomId(), kind: 'login', requiredUV: false, expiresAt: Date.now() - 1 };
+      });
+      await transaction(async store => {
+        assert.equal(store.sessions.expired, undefined);
+        assert.equal(store.sessions['session-0'].challenges.expired, undefined);
+      });
+    });
+  } finally { await rm(directory, { recursive: true, force: true }); }
+});
