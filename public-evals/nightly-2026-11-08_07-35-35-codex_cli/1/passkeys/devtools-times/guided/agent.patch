+      if (err instanceof ApiError && err.code === 'REAUTH_REQUIRED') showVerification(work);
+      else if (err instanceof ApiError && err.status === 401) setSignedOut(true);
+      else setError(errorMessage(err));
+    } finally { lock.current = false; setBusy(false); }
+  }
+  async function reauthenticate(method: 'passkey' | 'password') {
+    if (lock.current) return;
+    lock.current = true; setBusy(true); setVerifyError(null);
+    const abort = new AbortController(); controller.current = abort;
+    let verified = false;
+    try {
+      if (method === 'passkey') await authenticatePasskey(abort.signal, false, true);
+      else await api('reauth/password', { password }, 'POST', abort.signal);
+      if (abort.signal.aborted) return;
+      verified = true;
+      const work = pending.current;
+      pending.current = null; setVerify(false); setPassword('');
+      returnFocus.current?.focus();
+      if (work) await work();
+      else setSuccess('Identity verified. You can make account changes for the next 5 minutes.');
+    } catch (err) {
+      if (!abort.signal.aborted) {
+        if (err instanceof ApiError && err.status === 401 && err.message.includes('Sign in')) setSignedOut(true);
+        else if (verified) setError(errorMessage(err));
+        else setVerifyError(errorMessage(err));
+      }
+    } finally { lock.current = false; setBusy(false); }
+  }
+  const updateProfile = (event: FormEvent) => {
+    event.preventDefault();
+    const updated = { username: name, displayName };
+    void perform(async () => {
+      const next = await api<AccountData>('profile', updated, 'PUT');
+      accept(next); setName(next.user.name); setDisplayName(next.user.displayName);
+      await syncProfile(next); setSuccess('Your profile has been updated.');
+    });
+  };
+  const addPasskey = () => void perform(async () => {
+    const abort = new AbortController(); controller.current = abort;
+    const next = await registerPasskey(false, abort.signal);
+    accept(next); await syncPasskeys(next); setSuccess('Passkey created. You can use it the next time you sign in.');
+  });
+
+  return <div className="mx-auto max-w-2xl px-4 py-10 sm:py-14">
+    <a href={import.meta.env.BASE_URL} className="text-sm text-gray-600 underline underline-offset-4">← Back to the Times</a>
