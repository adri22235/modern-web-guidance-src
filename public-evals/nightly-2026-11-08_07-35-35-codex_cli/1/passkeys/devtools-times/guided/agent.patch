+import { useEffect, useState } from 'react';
+import { accountUrl, api } from '../lib/auth';
+
+export default function AccountNav() {
+  const [signedIn, setSignedIn] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    void api('session', undefined, 'GET', controller.signal).then(data => setSignedIn(!!data.user)).catch(() => {});
+    return () => controller.abort();
+  }, []);
+  if (signedIn) return <a href={accountUrl} data-skip-tracking="true" className="whitespace-nowrap rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700">Account settings</a>;
+  return <>
+    <a href={`${import.meta.env.BASE_URL}signup`} data-skip-tracking="true" className="whitespace-nowrap rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700">Sign up</a>
+    <a href={`${import.meta.env.BASE_URL}signin`} data-skip-tracking="true" className="rounded bg-gray-500 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-400">Sign in</a>
+  </>;
+}
