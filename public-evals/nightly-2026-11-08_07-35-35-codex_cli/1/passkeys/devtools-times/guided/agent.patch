+                e.preventDefault(); const newName = nickname;
+                void perform(async () => { const next = await api<AccountData>(`passkeys/${encodeURIComponent(key.id)}`, { name: newName }, 'PUT'); accept(next); setRenaming(null); setSuccess('Passkey renamed.'); });
