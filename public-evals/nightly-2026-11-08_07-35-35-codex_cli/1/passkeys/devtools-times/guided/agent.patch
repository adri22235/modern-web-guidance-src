--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,74 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { randomBytes, scrypt as scryptCallback, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+
+export interface Passkey {
+  id: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  name: string;
+  aaguid: string;
+  credentialDeviceType: string;
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+export interface User {
+  id: string;
+  name: string;
+  displayName: string;
+  passwordHash: string;
+  passkeys: Passkey[];
+}
+export interface AuthSession {
+  userId?: string;
+  expiresAt: number;
+  verifiedAt?: number;
+  challenges: Record<string, { challenge: string; kind: string; userId?: string; expiresAt: number; requiredUV: boolean }>;
+}
+export interface Store { users: User[]; sessions: Record<string, AuthSession> }
+
+const file = resolve(process.env.AUTH_STORE_PATH || '.data/auth.json');
+let queue: Promise<unknown> = Promise.resolve();
+
+// Atomic, serialized transactions for this sample application's single Node instance.
+// Use a shared transactional database before running multiple instances.
+export function transaction<T>(work: (store: Store) => Promise<T>): Promise<T> {
+  const result = queue.then(async () => {
+    let store: Store;
+    try { store = JSON.parse(await readFile(file, 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      store = { users: [], sessions: {} };
+    }
+    for (const [key, session] of Object.entries(store.sessions)) {
+      if (session.expiresAt < Date.now()) delete store.sessions[key];
+      else for (const [id, challenge] of Object.entries(session.challenges)) {
+        if (challenge.expiresAt < Date.now()) delete session.challenges[id];
+      }
+    }
+    // Persist consumed challenges and failed attempt counters even when verification fails.
+    try { return await work(store); }
+    finally {
+      await mkdir(dirname(file), { recursive: true, mode: 0o700 });
+      await writeFile(`${file}.tmp`, JSON.stringify(store), { mode: 0o600 });
+      await rename(`${file}.tmp`, file);
+    }
+  });
+  queue = result.catch(() => undefined);
+  return result;
+}
+
+export const randomId = () => randomBytes(32).toString('base64url');
+const scrypt = promisify(scryptCallback);
+export async function hashPassword(password: string) {
+  const salt = randomId();
+  return `${salt}:${(await scrypt(password, salt, 64) as Buffer).toString('hex')}`;
+}
+export async function checkPassword(password: string, hash: string) {
+  const [salt, expected] = hash.split(':');
+  const actual = await scrypt(password, salt, 64) as Buffer;
+  return timingSafeEqual(actual, Buffer.from(expected, 'hex'));
+}
