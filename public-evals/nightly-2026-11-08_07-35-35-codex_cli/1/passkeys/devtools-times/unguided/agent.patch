new file mode 100644
index 0000000..b0b3c08
--- /dev/null
+++ b/src/lib/server/accounts.ts
@@ -0,0 +1,92 @@
+import { randomBytes, randomUUID, scrypt, timingSafeEqual } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { promisify } from 'node:util';
+
+export type Passkey = {
+  id: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+  backedUp: boolean;
+};
+export type Account = {
+  id: string;
+  username: string;
+  passwordHash?: string;
+  createdAt: string;
+  passkeys: Passkey[];
+};
+export class AuthError extends Error {
+  status: number;
+  constructor(message: string, status = 400) { super(message); this.status = status; }
+}
+
+// A single-instance sample store. Set AUTH_DATA_FILE to a file on a persistent volume.
+const storePath = () => resolve(process.env.AUTH_DATA_FILE || '.data/accounts.json');
+let queue: Promise<unknown> = Promise.resolve();
+export function accounts<T>(operation: (records: Account[]) => T | Promise<T>, write = false): Promise<T> {
+  const result = queue.then(async () => {
+    let records: Account[];
+    try { records = JSON.parse(await readFile(storePath(), 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      records = [];
+    }
+    const value = await operation(records);
+    if (write) {
+      const path = storePath();
+      await mkdir(dirname(path), { recursive: true, mode: 0o700 });
+      const temporary = `${path}.${randomUUID()}.tmp`;
+      await writeFile(temporary, JSON.stringify(records), { mode: 0o600 });
+      await rename(temporary, path);
+    }
+    return value;
+  });
+  queue = result.catch(() => {});
+  return result;
+}
+export function username(value: unknown): string {
+  if (typeof value !== 'string' || !/^[a-zA-Z0-9_.-]{3,40}$/.test(value.trim())) {
+    throw new AuthError('Use 3–40 letters, numbers, dots, underscores, or hyphens for your username.');
+  }
+  return value.trim().toLowerCase();
+}
+export function passkeyName(value: unknown): string {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > 60) {
+    throw new AuthError('Give your passkey a name between 1 and 60 characters.');
+  }
+  return value.trim();
+}
+const derive = promisify(scrypt);
+export async function hashPassword(value: unknown): Promise<string> {
+  if (typeof value !== 'string' || value.length < 8 || value.length > 128 || !/\d/.test(value)) {
+    throw new AuthError('Use 8–128 characters with at least one number for your password.');
+  }
+  const salt = randomBytes(16).toString('hex');
+  const hash = await derive(value, salt, 64) as Buffer;
+  return `${salt}:${hash.toString('hex')}`;
+}
+export async function checkPassword(value: unknown, encoded?: string): Promise<boolean> {
+  if (typeof value !== 'string' || value.length > 128) return false;
+  const [salt, hash] = (encoded || `${'0'.repeat(32)}:${'0'.repeat(128)}`).split(':');
+  const actual = await derive(value, salt, 64) as Buffer;
+  return timingSafeEqual(actual, Buffer.from(hash, 'hex')) && !!encoded;
+}
+export function removePasskey(account: Account, id: string) {
+  if (!account.passkeys.some(key => key.id === id)) throw new AuthError('This passkey was already removed.', 404);
+  if (account.passkeys.length === 1 && !account.passwordHash) {
+    throw new AuthError('Add another passkey before removing your only way to sign in.');
+  }
+  account.passkeys = account.passkeys.filter(key => key.id !== id);
+}
+export function publicAccount(account: Account) {
+  return {
+    id: account.id, username: account.username, createdAt: account.createdAt,
+    hasPassword: !!account.passwordHash,
+    passkeys: account.passkeys.map(({ publicKey, counter, transports, ...key }) => key),
+  };
+}
diff --git a/src/lib/server/auth-policy.ts b/src/lib/server/auth-policy.ts
new file mode 100644
index 0000000..064f3ba
--- /dev/null
+++ b/src/lib/server/auth-policy.ts
@@ -0,0 +1,12 @@
+import { AuthError } from './accounts.ts';
+
+// Session persistence alone cannot prevent two simultaneous requests from consuming
+// the same challenge. Keep an atomic replay guard in this single-instance sample.
+const consumed = new Map<string, number>();
+export function consumeOnce(token: string, expires: number, now = Date.now()) {
+  for (const [key, expiry] of consumed) if (expiry <= now) consumed.delete(key);
+  if (!token || expires <= now || consumed.has(token)) {
+    throw new AuthError('This request expired or was already used. Please try again.', 403);
+  }
+  consumed.set(token, expires);
+}
