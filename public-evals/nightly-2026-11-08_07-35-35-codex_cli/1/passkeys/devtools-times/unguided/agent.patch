+import { useEffect, useState } from 'react';
+import { ArrowRightIcon, CheckIcon, FingerPrintIcon, KeyIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { api, appPath, authenticatePasskey, authMessage, registerPasskey, supportsPasskeys } from '../lib/auth-client';
+
+export default function AuthForm({ mode }: { mode: 'signin' | 'signup' }) {
+  const signup = mode === 'signup';
+  const [method, setMethod] = useState<'passkey' | 'password'>('passkey');
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(false);
+  useEffect(() => {
+    const supported = supportsPasskeys();
+    setSupported(supported);
+    if (!supported) setMethod('password');
+  }, []);
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    setError('');
+    setLoading(true);
+    try {
+      if (method === 'passkey') {
+        if (signup) await registerPasskey(username, 'My first passkey', 'signup');
+        else await authenticatePasskey('signin');
+      } else {
+        await api(`password/${mode}`, { username, password });
+      }
+      window.location.assign(appPath('account'));
+    } catch (error) { setError(authMessage(error)); setLoading(false); }
+  }
+  return (
+    <section className="auth-layout">
+      <aside className="auth-story">
+        <a href={appPath('')} className="auth-wordmark">The DevTools Times<span>INDEPENDENT MINDS. INFORMED READERS.</span></a>
+        <div className="auth-story-content">
+          <div className="auth-eyebrow"><span /> YOUR WORLD, IN PERSPECTIVE</div>
+          <h1>Good journalism.<br />One less password.</h1>
+          <p>A fresh perspective is always within reach. Make yourself at home with a simpler, more secure way to sign in.</p>
+          <div className="auth-story-rule" />
+          <div className="auth-story-benefit"><ShieldCheckIcon /><div><strong>Your account. Better protected.</strong><span>Passkeys keep your sign-in safe and simple.</span></div></div>
+          <div className="auth-story-benefit"><FingerPrintIcon /><div><strong>A familiar touch.</strong><span>Use your fingerprint, face, or device PIN.</span></div></div>
+        </div>
+        <p className="auth-story-foot">A little less friction. A little more perspective.</p>
+      </aside>
+      <div className="auth-form-panel">
+        <div className="auth-eyebrow">THE DEVTOOLS TIMES ACCOUNT</div>
+        <h2>{signup ? 'A new chapter starts here.' : 'Welcome back.'}</h2>
+        <p className="auth-intro">{signup ? 'Create your free account and stay curious.' : 'Sign in to keep reading, saving, and discovering.'}</p>
+        <div className="auth-methods" role="group" aria-label="Sign-in method">
+          <button type="button" aria-pressed={method === 'passkey'} disabled={loading || supported === false} onClick={() => { setMethod('passkey'); setError(''); }}><FingerPrintIcon />Passkey<span className="auth-small-badge">Recommended</span></button>
+          <button type="button" aria-pressed={method === 'password'} disabled={loading} onClick={() => { setMethod('password'); setError(''); }}><KeyIcon />Password</button>
+        </div>
+        {supported === false && <p className="auth-notice" role="status">Passkeys need a supported browser and a secure connection. You can continue with a password.</p>}
+        <form onSubmit={submit} className="auth-form" aria-busy={loading}>
+          {(signup || method === 'password') && <div className="auth-field">
+            <label htmlFor={`${mode}-username`}>Username</label>
+            <input id={`${mode}-username`} name="username" autoComplete="username" autoCapitalize="none" spellCheck={false} required minLength={3} maxLength={40} pattern="[a-zA-Z0-9_.\-]+" placeholder="Your username" value={username} disabled={loading} onChange={e => setUsername(e.target.value)} aria-describedby={signup ? 'username-hint' : undefined} />
+            {signup && <p id="username-hint">3–40 letters, numbers, dots, underscores, or hyphens.</p>}
+          </div>}
+          {method === 'password' ? <div className="auth-field">
+            <label htmlFor={`${mode}-password`}>Password</label>
+            <input id={`${mode}-password`} name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} required minLength={signup ? 8 : undefined} maxLength={128} pattern={signup ? '.*[0-9].*' : undefined} placeholder={signup ? 'Create a strong password' : 'Enter your password'} value={password} disabled={loading} onChange={e => setPassword(e.target.value)} aria-describedby={signup ? 'password-hint' : undefined} />
+            {signup && <p id="password-hint">At least 8 characters, including a number.</p>}
+          </div> : <div className="auth-passkey-explainer">
+            <div className="auth-fingerprint"><FingerPrintIcon /></div>
+            <h3>{signup ? 'A safer way to get started.' : 'Your device is your key.'}</h3>
+            <p>{signup ? 'Create a passkey instead of a password. Your device will guide you through a quick, secure setup.' : 'Use your fingerprint, face, or screen lock to sign in. You can also use a passkey from another device.'}</p>
+            <span><CheckIcon /> No password to remember</span>
+          </div>}
+          {error && <div className="auth-error" role="alert">{error}</div>}
+          <button className="auth-primary" type="submit" disabled={loading || supported === null} data-skip-tracking="true">
+            {loading ? (method === 'passkey' ? 'Follow the prompt on your device…' : 'Please wait…') : method === 'passkey' ? (signup ? 'Create account with a passkey' : 'Sign in with a passkey') : (signup ? 'Create account' : 'Sign in with password')}
+            {!loading && <ArrowRightIcon />}
+          </button>
+          {method === 'passkey' && <p className="auth-device-note"><ShieldCheckIcon /> Your biometric data stays on your device.</p>}
+        </form>
+        <p className="auth-switch">{signup ? 'Already a reader?' : 'New to The DevTools Times?'} <a href={appPath(signup ? 'signin' : 'signup')}>{signup ? 'Sign in' : 'Create an account'} <span aria-hidden="true">↗</span></a></p>
+        {signup && <p className="auth-legal">By creating an account, you agree to our <a href={appPath('legal/terms')}>Terms of Service</a> and <a href={appPath('legal/privacy')}>Privacy Policy</a>.</p>}
+      </div>
+    </section>
+  );
+}
