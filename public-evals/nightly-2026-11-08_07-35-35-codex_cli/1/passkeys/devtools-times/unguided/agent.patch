new file mode 100644
index 0000000..bb94e34
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,212 @@
+import type { APIRoute } from 'astro';
+import { randomUUID } from 'node:crypto';
+import {
+  generateAuthenticationOptions, generateRegistrationOptions,
+  verifyAuthenticationResponse, verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import { accounts, AuthError, checkPassword, hashPassword, passkeyName, publicAccount, removePasskey, username, type Account } from '../../../lib/server/accounts';
+
+import { consumeOnce } from '../../../lib/server/auth-policy';
+
+type Ceremony = {
+  challenge: string; expires: number; purpose: 'signup' | 'add' | 'signin' | 'reauth';
+  accountId?: string; username?: string;
+};
+type Identity = { id: string; expires: number };
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+// Bound memory and rate-limit expensive unauthenticated operations per source address.
+const attempts = new Map<string, { count: number; expires: number }>();
+function rateLimit(address: string) {
+  const now = Date.now();
+  for (const [key, value] of attempts) if (value.expires < now) attempts.delete(key);
+  const entry = attempts.get(address) || { count: 0, expires: now + 60_000 };
+  if (++entry.count > 30 || attempts.size > 10_000) throw new AuthError('Too many attempts. Please wait a minute and try again.', 429);
+  attempts.set(address, entry);
+}
+
+export const ALL: APIRoute = async ({ request, url, params, session, clientAddress }) => {
+  try {
+    if (!session) throw new AuthError('Account sessions are unavailable. Please try again later.', 503);
+    const action = params.action;
+    const origin = process.env.AUTH_ORIGIN || url.origin;
+    const rpID = new URL(origin).hostname;
+    const identity = await session.get('identity') as Identity | undefined;
+    const current = identity && identity.expires > Date.now()
+      ? await accounts(records => records.find(record => record.id === identity.id)) : undefined;
+    const requireAccount = () => {
+      if (!current) throw new AuthError('Please sign in to continue.', 401);
+      return current;
+    };
+    const signIn = async (account: Account) => {
+      await session.regenerate();
+      await session.set('identity', { id: account.id, expires: Date.now() + 7 * 86400_000 });
+      session.delete('ceremony');
+      session.delete('reauth');
+    };
+    if (request.method === 'GET' && action === 'account') {
+      return json({ account: current ? publicAccount(current) : null });
+    }
+    if (request.method !== 'POST') return json({ error: 'Method not allowed.' }, 405);
+    if (request.headers.get('origin') !== origin) throw new AuthError('Please reload this page and try again.', 403);
+    rateLimit(clientAddress);
+    if (!request.headers.get('content-type')?.includes('application/json')) throw new AuthError('A JSON request is required.', 415);
+    if (Number(request.headers.get('content-length')) > 64_000) throw new AuthError('Request too large.', 413);
+    const body = await request.json();
+    const requireReauth = async () => {
+      requireAccount();
+      const grant = await session.get('reauth') as { token: string; accountId: string; expires: number } | undefined;
+      session.delete('reauth');
+      if (!grant || grant.accountId !== current!.id || grant.expires < Date.now()) {
+        throw new AuthError('Confirm your identity before making this change.', 403);
+      }
+      consumeOnce(grant.token, grant.expires);
+    };
+    const takeCeremony = async (purposes: Ceremony['purpose'][]) => {
+      const ceremony = await session.get('ceremony') as Ceremony | undefined;
+      session.delete('ceremony');
+      if (!ceremony || !purposes.includes(ceremony.purpose) || ceremony.expires < Date.now()) {
+        throw new AuthError('This request expired. Please try again.');
+      }
+      consumeOnce(ceremony.challenge, ceremony.expires);
+      return ceremony;
+    };
+    if (action === 'logout') {
+      session.destroy();
+      return json({ ok: true });
+    }
+    if (action === 'password/signup') {
+      const name = username(body.username);
+      const passwordHash = await hashPassword(body.password);
+      const account = await accounts(records => {
+        if (records.some(record => record.username === name)) throw new AuthError('That username is already taken. Try signing in instead.', 409);
+        const account: Account = { id: randomUUID(), username: name, passwordHash, createdAt: new Date().toISOString(), passkeys: [] };
+        records.push(account);
+        return account;
+      }, true);
+      await signIn(account);
+      return json({ account: publicAccount(account) });
+    }
+    if (action === 'password/signin' || action === 'password/reauth') {
+      const reauth = action.endsWith('reauth');
+      const account = reauth ? requireAccount() : await accounts(records => records.find(record => record.username === username(body.username)));
+      if (!await checkPassword(body.password, account?.passwordHash) || !account) {
+        throw new AuthError(reauth ? 'That password is incorrect. Please try again.' : 'The username or password is incorrect.', 401);
+      }
+      if (reauth) await session.set('reauth', { token: randomUUID(), accountId: account.id, expires: Date.now() + 60_000 });
+      else await signIn(account);
+      return json({ ok: true });
+    }
+    if (action === 'passkeys/registration-options') {
+      const adding = body.purpose === 'add';
+      let account: Account;
+      if (adding) {
+        account = requireAccount();
+        await requireReauth();
+      } else {
+        const name = username(body.username);
+        if (await accounts(records => records.some(record => record.username === name))) throw new AuthError('That username is already taken. Try signing in instead.', 409);
+        account = { id: randomUUID(), username: name, createdAt: new Date().toISOString(), passkeys: [] };
+      }
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID, userName: account.username,
+        userID: new TextEncoder().encode(account.id), attestationType: 'none',
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+        excludeCredentials: account.passkeys.map(key => ({ id: key.id, transports: key.transports })),
+      });
+      await session.set('ceremony', {
+        challenge: options.challenge, expires: Date.now() + 300_000,
+        purpose: adding ? 'add' : 'signup', accountId: account.id, username: account.username,
+      } satisfies Ceremony);
+      return json(options);
+    }
+    if (action === 'passkeys/registration-verify') {
+      const ceremony = await takeCeremony(['add', 'signup']);
+      if (ceremony.purpose === 'add' && requireAccount().id !== ceremony.accountId) throw new AuthError('Please sign in again.', 401);
+      const name = passkeyName(body.name || 'My passkey');
+      const verification = await verifyRegistrationResponse({
+        response: body.credential, expectedChallenge: ceremony.challenge,
+        expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true,
+      });
+      if (!verification.verified) throw new AuthError('We could not verify this passkey. Please try again.');
+      const { credential, credentialBackedUp } = verification.registrationInfo;
+      const account = await accounts(records => {
+        if (records.some(record => record.passkeys.some(key => key.id === credential.id))) throw new AuthError('This passkey is already registered.', 409);
+        let account = records.find(record => record.id === ceremony.accountId);
+        if (ceremony.purpose === 'signup') {
+          if (records.some(record => record.username === ceremony.username)) throw new AuthError('That username is already taken.', 409);
+          account = { id: ceremony.accountId!, username: ceremony.username!, createdAt: new Date().toISOString(), passkeys: [] };
+          records.push(account);
+        }
+        if (!account) throw new AuthError('Please sign in again.', 401);
+        if (account.passkeys.length >= 20) throw new AuthError('You can save up to 20 passkeys. Remove one before adding another.');
+        account.passkeys.push({
+          id: credential.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+          counter: credential.counter, transports: credential.transports, name,
+          createdAt: new Date().toISOString(), backedUp: credentialBackedUp,
+        });
+        return account;
+      }, true);
+      if (ceremony.purpose === 'signup') await signIn(account);
+      return json({ account: publicAccount(account) });
+    }
+    if (action === 'passkeys/authentication-options') {
+      const reauth = body.purpose === 'reauth';
+      const account = reauth ? requireAccount() : undefined;
+      if (reauth && !account!.passkeys.length) throw new AuthError('Use your password to confirm your identity.');
+      const options = await generateAuthenticationOptions({
+        rpID, userVerification: 'required',
+        ...(account ? { allowCredentials: account.passkeys.map(key => ({ id: key.id, transports: key.transports })) } : {}),
+      });
+      await session.set('ceremony', {
+        challenge: options.challenge, expires: Date.now() + 300_000,
+        purpose: reauth ? 'reauth' : 'signin', accountId: account?.id,
+      } satisfies Ceremony);
+      return json(options);
+    }
+    if (action === 'passkeys/authentication-verify') {
+      const ceremony = await takeCeremony(['signin', 'reauth']);
+      if (ceremony.purpose === 'reauth' && requireAccount().id !== ceremony.accountId) throw new AuthError('Please sign in again.', 401);
+      const account = await accounts(async records => {
+        const account = records.find(record => record.passkeys.some(key => key.id === body.credential?.id));
+        const key = account?.passkeys.find(key => key.id === body.credential.id);
+        if (!account || !key || (ceremony.accountId && account.id !== ceremony.accountId)) throw new AuthError('This passkey does not match your account.', 401);
+        if (body.credential.response?.userHandle && body.credential.response.userHandle !== Buffer.from(account.id).toString('base64url')) throw new AuthError('This passkey does not match your account.', 401);
+        const verification = await verifyAuthenticationResponse({
+          response: body.credential, expectedChallenge: ceremony.challenge,
+          expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true,
+          credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports },
+        });
+        if (!verification.verified) throw new AuthError('We could not verify this passkey.', 401);
+        key.counter = verification.authenticationInfo.newCounter;
+        key.backedUp = verification.authenticationInfo.credentialBackedUp;
+        key.lastUsedAt = new Date().toISOString();
+        return account;
+      }, true);
+      if (ceremony.purpose === 'reauth') await session.set('reauth', { token: randomUUID(), accountId: account.id, expires: Date.now() + 60_000 });
+      else await signIn(account);
+      return json({ ok: true });
+    }
+    if (action === 'passkeys/rename' || action === 'passkeys/remove') {
+      await requireReauth();
+      const account = await accounts(records => {
+        const account = records.find(record => record.id === current!.id)!;
+        if (action.endsWith('remove')) removePasskey(account, body.id);
+        else {
+          const key = account.passkeys.find(key => key.id === body.id);
+          if (!key) throw new AuthError('This passkey was already removed.', 404);
+          key.name = passkeyName(body.name);
+        }
+        return account;
+      }, true);
+      return json({ account: publicAccount(account) });
+    }
+    return json({ error: 'Endpoint not found.' }, 404);
+  } catch (error) {
+    if (error instanceof AuthError) return json({ error: error.message }, error.status);
+    if (error instanceof SyntaxError || error instanceof TypeError) return json({ error: 'Invalid request. Please try again.' }, 400);
+    console.error('Account operation failed:', error instanceof Error ? error.name : 'Unknown error');
+    return json({ error: 'We could not complete this request. Please try again.' }, 400);
+  }
+};
