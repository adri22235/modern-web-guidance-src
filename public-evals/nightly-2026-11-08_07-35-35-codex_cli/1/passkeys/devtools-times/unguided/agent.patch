+  .account-password p { font-size: 9px; }
+  .auth-dialog { padding: 26px 22px; }
+  .dialog-actions .auth-primary, .dialog-actions .auth-secondary { font-size: 11px; padding: 10px 12px; }
+}
+@media (prefers-reduced-motion: reduce) { .auth-primary, .auth-secondary { transition: none; } }
diff --git a/tests/accounts.test.ts b/tests/accounts.test.ts
new file mode 100644
index 0000000..23e5369
--- /dev/null
+++ b/tests/accounts.test.ts
@@ -0,0 +1,77 @@
+import { after, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { accounts, AuthError, checkPassword, hashPassword, publicAccount, removePasskey, username, type Account, type Passkey } from '../src/lib/server/accounts.ts';
+import { consumeOnce } from '../src/lib/server/auth-policy.ts';
+
+const directory = await mkdtemp(join(tmpdir(), 'times-auth-test-'));
+process.env.AUTH_DATA_FILE = join(directory, 'accounts.json');
+after(async () => { await rm(directory, { recursive: true, force: true }); });
+const key = (id: string): Passkey => ({ id, publicKey: 'private-server-data', counter: 0, name: 'Laptop', createdAt: new Date().toISOString(), backedUp: false });
+const account = (): Account => ({ id: 'reader', username: 'reader', createdAt: new Date().toISOString(), passkeys: [key('first')] });
+
+test('passwords are salted and only the correct password verifies', async () => {
+  const first = await hashPassword('long-password-123');
+  const second = await hashPassword('long-password-123');
+  assert.notEqual(first, second);
+  assert.ok(!first.includes('long-password-123'));
+  assert.equal(await checkPassword('long-password-123', first), true);
+  assert.equal(await checkPassword('incorrect', first), false);
+  assert.equal(await checkPassword('long-password-123'), false);
+  await assert.rejects(hashPassword('short1'), AuthError);
+  await assert.rejects(hashPassword('no-number-password'), AuthError);
+});
+
+test('the last passkey cannot be removed without another sign-in method', () => {
+  const record = account();
+  assert.throws(() => removePasskey(record, 'first'), /only way to sign in/);
+  assert.equal(record.passkeys.length, 1);
+  record.passkeys.push(key('backup'));
+  removePasskey(record, 'first');
+  assert.deepEqual(record.passkeys.map(key => key.id), ['backup']);
+  record.passwordHash = 'password-is-set';
+  removePasskey(record, 'backup');
+  assert.equal(record.passkeys.length, 0);
+  assert.throws(() => removePasskey(record, 'missing'), /already removed/);
+});
+
+test('the client never receives password hashes or credential public keys and counters', () => {
+  const record = account();
+  record.passwordHash = 'secret-hash';
+  const result = publicAccount(record);
+  assert.equal(result.hasPassword, true);
+  assert.ok(!JSON.stringify(result).includes('secret-hash'));
+  assert.ok(!JSON.stringify(result).includes('private-server-data'));
+  assert.ok(!('counter' in result.passkeys[0]));
+});
+
+test('usernames are normalized and invalid identifiers are rejected', () => {
+  assert.equal(username('  Test.Reader  '), 'test.reader');
+  for (const value of ['', 'ab', '<script>', 'has spaces', 'a'.repeat(41), null]) {
+    assert.throws(() => username(value), AuthError);
+  }
+});
+
+test('challenges and reauthentication grants expire and can only be consumed once', () => {
+  consumeOnce('fresh-challenge', 2000, 1000);
+  assert.throws(() => consumeOnce('fresh-challenge', 2000, 1001), AuthError);
+  assert.throws(() => consumeOnce('expired-challenge', 999, 1000), AuthError);
+  assert.throws(() => consumeOnce('', 2000, 1000), AuthError);
+});
+
+test('concurrent account writes are serialized and failed mutations are not persisted', async () => {
+  await Promise.all(Array.from({ length: 12 }, (_, index) => accounts(async records => {
+    await Promise.resolve();
+    records.push({ ...account(), id: `reader-${index}`, username: `reader-${index}` });
+  }, true)));
+  assert.equal(await accounts(records => records.length), 12);
+  await assert.rejects(accounts(records => {
+    records.splice(0);
+    throw new AuthError('Rejected mutation');
+  }, true));
+  assert.equal(await accounts(records => records.length), 12);
+  const stored = JSON.parse(await readFile(process.env.AUTH_DATA_FILE!, 'utf8'));
+  assert.equal(new Set(stored.map((record: Account) => record.id)).size, 12);
+});
