+++ b/src/lib/auth-client.ts
@@ -0,0 +1,39 @@
+import { browserSupportsWebAuthn, startAuthentication, startRegistration } from '@simplewebauthn/browser';
+import type { PublicKeyCredentialCreationOptionsJSON, PublicKeyCredentialRequestOptionsJSON } from '@simplewebauthn/browser';
+
+export type PublicAccount = {
+  id: string; username: string; createdAt: string; hasPassword: boolean;
+  passkeys: { id: string; name: string; createdAt: string; lastUsedAt?: string; backedUp: boolean }[];
+};
+export const appPath = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
+export const supportsPasskeys = () => window.isSecureContext && browserSupportsWebAuthn();
+export async function api<T = { ok: boolean }>(action: string, body?: unknown): Promise<T> {
+  const response = await fetch(appPath(`api/auth/${action}`), {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'We could not complete this request. Please try again.');
+  return data;
+}
+export async function registerPasskey(username: string, name: string, purpose: 'signup' | 'add') {
+  const options = await api<PublicKeyCredentialCreationOptionsJSON>('passkeys/registration-options', { username, purpose });
+  const credential = await startRegistration({ optionsJSON: options });
+  return api<{ account: PublicAccount }>('passkeys/registration-verify', { credential, name });
+}
+export async function authenticatePasskey(purpose: 'signin' | 'reauth') {
+  const options = await api<PublicKeyCredentialRequestOptionsJSON>('passkeys/authentication-options', { purpose });
+  const credential = await startAuthentication({ optionsJSON: options });
+  return api('passkeys/authentication-verify', { credential });
+}
+export function authMessage(error: unknown): string {
+  const name = error instanceof Error ? error.name : '';
+  const code = (error as { code?: string })?.code;
+  if (name === 'NotAllowedError' || name === 'AbortError' || code === 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY') {
+    return 'The passkey request was canceled or timed out. You can try again or use your password.';
+  }
+  if (name === 'InvalidStateError' || code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') return 'A passkey already exists in this password manager. Try another device or password manager.';
+  if (name === 'SecurityError') return 'Passkeys are unavailable on this address. Use a secure connection or sign in with your password.';
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
