+async function authenticate(){supported();if(!account?.keys.length)throw new Error('Create your account with a passkey first.');const challenge=random();const credential=await navigator.credentials.get({publicKey:{challenge,rpId:location.hostname,allowCredentials:account.keys.map(key=>({id:decode(key.id),type:'public-key',transports:key.transports})),userVerification:'required',timeout:60000}});if(!credential)throw new Error('No passkey was selected.');const key=account.keys.find(key=>key.id===credential.id);if(!key)throw new Error('This passkey does not belong to your account.');const response=credential.response;checkClient(response,challenge,'webauthn.get');if(response.userHandle && encode(response.userHandle)!==account.id)throw new Error('This passkey belongs to a different account.');const counter=await checkAuthenticator(response.authenticatorData);const publicKey=await crypto.subtle.importKey('spki',decode(key.publicKey),{name:'ECDSA',namedCurve:'P-256'},false,['verify']);const hash=new Uint8Array(await crypto.subtle.digest('SHA-256',response.clientDataJSON));const authData=new Uint8Array(response.authenticatorData);const signed=new Uint8Array(authData.length+hash.length);signed.set(authData);signed.set(hash,authData.length);if(!await crypto.subtle.verify({name:'ECDSA',hash:'SHA-256'},publicKey,rawSignature(response.signature),signed))throw new Error('Passkey verification failed.');if(counter && key.counter && counter<=key.counter)throw new Error('This passkey returned an invalid signature counter.');key.counter=counter;key.lastUsed=new Date().toISOString();persist();signedIn=true;render();return key;}
