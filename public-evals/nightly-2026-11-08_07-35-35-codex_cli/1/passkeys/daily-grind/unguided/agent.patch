index 0000000..36dffef
--- /dev/null
+++ b/tests/passkeys.test.cjs
@@ -0,0 +1,60 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { webcrypto } = require('node:crypto');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+function setup() {
+  const elements = new Map();
+  const element = () => ({ textContent: '', innerHTML: '', hidden: false, dataset: {}, classList: { toggle() {} }, querySelectorAll: () => [], setAttribute() {}, removeAttribute() {}, addEventListener() {}, scrollIntoView() {} });
+  const document = { getElementById: id => { if (!elements.has(id)) elements.set(id, element()); return elements.get(id); }, querySelectorAll: () => [], querySelector: element };
+  const store = new Map();
+  const context = vm.createContext({ document, window: { isSecureContext: true, PublicKeyCredential: function() {} }, navigator: { credentials: {} }, location: { origin: 'https://coffee.example', hostname: 'coffee.example' }, crypto: webcrypto, localStorage: { getItem: key => store.get(key) || null, setItem: (key, value) => store.set(key, value), removeItem: key => store.delete(key) }, TextEncoder, TextDecoder, Uint8Array, DataView, btoa, atob, setTimeout, clearTimeout, console });
+  vm.runInContext(readFileSync('app.js', 'utf8'), context);
+  return { context, run: code => vm.runInContext(code, context) };
+}
+function toDER(raw) {
+  const part = bytes => { let n = Buffer.from(bytes); while (n.length > 1 && n[0] === 0) n = n.subarray(1); if (n[0] & 128) n = Buffer.concat([Buffer.from([0]), n]); return Buffer.concat([Buffer.from([2, n.length]), n]); };
+  const content = Buffer.concat([part(raw.subarray(0, 32)), part(raw.subarray(32))]);
+  return Buffer.concat([Buffer.from([0x30, content.length]), content]);
+}
+async function fixture(mode = 'valid') {
+  const env = setup();
+  const pair = await webcrypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify']);
+  const spki = await webcrypto.subtle.exportKey('spki', pair.publicKey);
+  env.context.publicKeyFixture = spki;
+  env.run(`account={id:encode(new Uint8Array([1,2,3])),name:'Coffee Lover',email:'coffee@example.com',keys:[{id:'AQID',name:'Test device',publicKey:encode(publicKeyFixture),created:new Date().toISOString(),counter:0}]}`);
+  env.context.navigator.credentials.get = async ({ publicKey }) => {
+    const clientDataJSON = new TextEncoder().encode(JSON.stringify({ type: 'webauthn.get', challenge: Buffer.from(publicKey.challenge).toString('base64url'), origin: mode === 'origin' ? 'https://evil.example' : 'https://coffee.example', crossOrigin: false }));
+    const authData = new Uint8Array(37);
+    authData.set(new Uint8Array(await webcrypto.subtle.digest('SHA-256', new TextEncoder().encode(mode === 'rp' ? 'evil.example' : 'coffee.example'))));
+    authData[32] = mode === 'unverified' ? 1 : 5;
+    new DataView(authData.buffer).setUint32(33, 1);
+    const hash = new Uint8Array(await webcrypto.subtle.digest('SHA-256', clientDataJSON));
+    const message = new Uint8Array(authData.length + hash.length); message.set(authData); message.set(hash, authData.length);
+    const raw = new Uint8Array(await webcrypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, pair.privateKey, message));
+    if (mode === 'signature') raw[0] ^= 1;
+    return { id: 'AQID', response: { clientDataJSON, authenticatorData: authData.buffer, signature: toDER(raw), userHandle: new Uint8Array([1,2,3]).buffer } };
+  };
+  return env;
+}
+
+test('valid signed passkey signs in and persists last-used information', async () => {
+  const env = await fixture(); await env.run('authenticate()');
+  assert.equal(env.run('signedIn'), true); assert.equal(env.run('account.keys[0].counter'), 1);
+  assert.ok(env.run('account.keys[0].lastUsed'));
+});
+for (const [mode, message] of [['origin', /could not be verified/], ['rp', /identity verification/], ['unverified', /identity verification/], ['signature', /verification failed/]]) {
+  test(`rejects ${mode} assertion without signing in`, async () => { const env = await fixture(mode); await assert.rejects(env.run('authenticate()'), message); assert.equal(env.run('signedIn'), false); });
+}
+test('rejects a replayed signature counter', async () => {
+  const env = await fixture(); env.run('account.keys[0].counter=1');
+  await assert.rejects(env.run('authenticate()'), /invalid signature counter/);
+});
+test('unsupported browsers receive an actionable error', () => {
+  const env = setup(); env.context.window.isSecureContext = false;
+  assert.throws(() => env.run('supported()'), /HTTPS or localhost/);
+});
+test('stored account content is escaped before HTML rendering', () => {
+  const env = setup(); assert.equal(env.run(`escapeHTML('<img src=x onerror="alert(1)">')`), '&lt;img src=x onerror=&quot;alert(1)&quot;&gt;');
+});
