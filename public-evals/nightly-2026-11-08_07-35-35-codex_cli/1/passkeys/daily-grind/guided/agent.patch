+async function loadManagement() {
+  const version = ++managementVersion;
+  const accountId = user?.userId;
+  $('#passkey-list').replaceChildren(element('p', 'field-hint', 'Loading your passkeys…'));
+  const data = await api('/api/credentials');
+  if (view !== 'security' || user?.userId !== accountId || version !== managementVersion) return;
+  renderCredentials(data);
+  await syncAccepted(data);
