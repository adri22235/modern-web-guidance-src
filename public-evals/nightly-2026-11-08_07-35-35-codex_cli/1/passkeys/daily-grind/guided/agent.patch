+import 'webauthn-polyfills';
+
+const $ = selector => document.querySelector(selector);
+let user = null;
+let csrfToken = '';
+let view = 'signin';
+let busy = false;
+let supported = false;
+let canCreate = false;
+let conditionalGet = false;
+let autofillController;
+let autofillFinishing = false;
+let managementVersion = 0;
+let serviceReady = false;
+const panels = ['signin', 'signup', 'profile', 'security'];
+
+function message(text = '', isError = false) {
+  const status = $('#status');
+  status.textContent = text;
+  status.classList.toggle('error', isError);
+  status.hidden = !text;
+}
+async function api(url, method = 'GET', body, signal) {
+  let response;
+  try {
+    response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', signal,
+      headers: { 'Content-Type': 'application/json', ...(method !== 'GET' ? { 'X-CSRF-Token': csrfToken } : {}) },
+      ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
+    });
+  } catch (err) {
+    if (err.name === 'AbortError') throw err;
+    throw new Error('We couldn’t connect. Check your connection and try again.');
+  }
+  let data;
+  try { data = await response.json(); }
+  catch { throw new Error('The account service is unavailable. Please try again later.'); }
+  if (data.csrfToken) csrfToken = data.csrfToken;
+  if (!response.ok) {
+    if (response.status === 401) { user = null; updateUser(); showView('signin', false); }
+    throw Object.assign(new Error(data.error || 'Something went wrong. Please try again.'), { status: response.status });
+  }
+  return data;
+}
+function explainError(err) {
+  return ({ NotAllowedError: 'The passkey request was cancelled or timed out. You can try again or use a passkey from another device.', InvalidStateError: 'A passkey already exists in this password manager. Use another device or security key to add a backup.', SecurityError: 'Passkeys require a secure connection and the correct site address. Please open the Daily Grind’s secure website.', NotSupportedError: 'Your device doesn’t support this passkey. Try another device or an up-to-date browser.', AbortError: 'The passkey request was cancelled. You can try again.' })[err.name] || err.message || 'Something went wrong. Please try again.';
+}
+function updateButtons() {
+  document.querySelectorAll('button').forEach(button => {
+    button.disabled = busy || (button.hasAttribute('data-passkey') && (!supported || !serviceReady || (button.id === 'add-passkey' || button.closest('#signup-form')) && !canCreate));
+  });
+  $('.account-card').setAttribute('aria-busy', String(busy));
+}
+function stopAutofill() { autofillController?.abort(); autofillController = undefined; }
+async function run(action) {
+  if (busy) return;
+  busy = true;
+  stopAutofill();
+  updateButtons();
+  message('');
+  try { await action(); }
+  catch (err) { message(explainError(err), true); }
+  finally { busy = false; updateButtons(); if (!user && view === 'signin') void startAutofill(); }
+}
+function updateUser() {
+  $('#sidebar-name').textContent = user ? user.displayName : 'Hello, coffee lover';
+  $('#sidebar-caption').textContent = user ? 'Lovely to have you here.' : 'Your daily grind starts here.';
+  $('#signout').hidden = !user;
+  document.querySelectorAll('.account-nav [data-view="signin"], .account-nav [data-view="signup"]').forEach(button => button.hidden = Boolean(user));
+  if (user) {
+    $('#profile-name').value = user.displayName;
+    $('#profile-email').value = user.name;
+  } else {
+    $('#profile-form').reset();
+    $('#passkey-list').replaceChildren();
+    $('#passkey-count').textContent = '0';
+  }
+}
+function showView(next, focus = true) {
+  stopAutofill();
+  managementVersion++;
+  if (user && ['signin', 'signup'].includes(next)) next = 'profile';
+  if (!user && ['profile', 'security'].includes(next)) { next = 'signin'; message('Sign in with a saved passkey to manage your account.'); }
+  view = next;
+  panels.forEach(name => { $(`#${name}-panel`).hidden = name !== next; });
+  document.querySelectorAll('.account-nav [data-view]').forEach(button => {
+    const active = button.dataset.view === next;
+    button.classList.toggle('active', active);
+    if (active) button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current');
+  });
+  if (focus) $(`#${next}-title`).focus({ preventScroll: true });
+  if (next === 'security') void loadManagement().catch(err => message(explainError(err), true));
+  if (next === 'signin' && !busy && serviceReady) void startAutofill();
+}
+const validBase64 = value => typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+async function signal(method, values) {
+  if (!window.PublicKeyCredential?.[method] || !values.rpId) return;
+  if (values.userId !== undefined && !validBase64(values.userId)) return;
+  if (values.credentialId !== undefined && !validBase64(values.credentialId)) return;
+  if (values.allAcceptedCredentialIds && !values.allAcceptedCredentialIds.every(validBase64)) return;
+  try { await PublicKeyCredential[method](values); }
+  catch (err) { console.warn('Passkey provider synchronization was skipped:', err.message); }
+}
+async function syncAccepted(data) {
+  await signal('signalAllAcceptedCredentials', { rpId: data.rpId, userId: data.userId, allAcceptedCredentialIds: data.credentials.map(c => c.id) });
+}
+async function authenticate(action, controller = new AbortController(), conditional = false) {
+  const { options } = await api('/api/authentication/options', 'POST', { reauthenticate: Boolean(action), ...(action ? { action } : {}) }, controller.signal);
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  const credential = await navigator.credentials.get({ publicKey, signal: controller.signal, ...(conditional ? { mediation: 'conditional' } : {}) });
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  if (conditional) {
+    if (controller.signal.aborted || busy) throw new DOMException('Authentication cancelled', 'AbortError');
+    autofillFinishing = true;
+    busy = true;
+    updateButtons();
+  }
+  // Once a credential is selected, finish verification even if the autofill prompt is closed.
+  try { return await api('/api/authentication/verify', 'POST', { credential: credential.toJSON() }); }
+  catch (err) {
+    if (err.status === 404 && !user) await signal('signalUnknownCredential', { rpId: options.rpId, credentialId: credential.id });
+    throw err;
+  }
+}
+async function signedIn(data) {
+  user = data.user;
+  updateUser();
+  showView('security');
+  message(`Welcome, ${user.displayName}. You’re signed in securely.`);
+}
+async function startAutofill() {
+  if (!conditionalGet || !serviceReady || busy || user || view !== 'signin' || autofillController) return;
+  const controller = new AbortController();
+  autofillController = controller;
+  try {
+    const data = await authenticate(null, controller, true);
+    if (!controller.signal.aborted) await signedIn(data);
+  } catch (err) {
+    if (!['AbortError', 'NotAllowedError'].includes(err.name) && !controller.signal.aborted) message(explainError(err), true);
+  } finally {
+    if (autofillController === controller) autofillController = undefined;
+    if (autofillFinishing) { autofillFinishing = false; busy = false; updateButtons(); }
+  }
+}
+async function register(profile = {}) {
+  const { options } = await api('/api/registration/options', 'POST', profile);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  // Keep authenticatorAttachment unset so customers can also add security keys.
+  const credential = await navigator.credentials.create({ publicKey });
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  try { return await api('/api/registration/verify', 'POST', { credential: credential.toJSON() }); }
+  catch (err) {
+    await signal('signalUnknownCredential', { rpId: options.rp.id, credentialId: credential.id });
+    throw err;
+  }
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS(svg.namespaceURI, 'use');
+  use.setAttribute('href', `#i-${name}`);
+  svg.append(use);
+  return svg;
+}
+function actionButton(text, handler, className = 'text-button') {
+  const button = element('button', className, text);
+  button.type = 'button';
+  button.addEventListener('click', handler);
+  return button;
+}
+const date = value => new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value));
+function renderCredentials(data) {
+  const list = $('#passkey-list');
+  list.replaceChildren();
+  $('#passkey-count').textContent = String(data.credentials.length);
+  if (!data.credentials.length) list.append(element('p', 'field-hint', 'No passkeys found. Add a passkey to sign in securely.'));
+  data.credentials.forEach(credential => {
+    const row = element('article', 'passkey-row');
+    const summary = element('div', 'passkey-summary');
+    const providerIcon = element('span', 'provider-icon');
+    if (credential.providerIcon?.startsWith('data:image/')) {
+      const img = element('img'); img.src = credential.providerIcon; img.alt = ''; img.width = 20; img.height = 20; providerIcon.append(img);
+    } else providerIcon.append(icon('key'));
+    const meta = element('div', 'passkey-meta');
+    meta.append(element('strong', '', credential.name), element('p', '', `${credential.provider} · ${credential.credentialBackedUp ? 'Backed up' : 'Passkey'}`), element('p', '', `Added ${date(credential.registeredAt)} · ${credential.lastUsedAt ? `Last used ${date(credential.lastUsedAt)}` : 'Not yet used to sign in'}`));
+    summary.append(providerIcon, meta);
+    const actions = element('div', 'passkey-actions');
+    const rename = actionButton('Rename', () => showEditor('rename'));
+    rename.setAttribute('aria-label', `Rename ${credential.name}`);
+    const remove = actionButton('Remove', () => showEditor('remove'), 'text-button danger');
+    remove.setAttribute('aria-label', `Remove ${credential.name}`);
+    actions.append(rename, remove);
+    row.append(summary, actions);
+    list.append(row);
+    function showEditor(mode) {
+      row.querySelector('.inline-form')?.remove();
+      const editor = element('form', 'inline-form');
+      editor.method = 'post';
+      editor.action = `/api/credentials/${encodeURIComponent(credential.id)}`;
+      editor.setAttribute('aria-label', `${mode === 'rename' ? 'Rename' : 'Remove'} ${credential.name}`);
+      const buttons = element('div', 'inline-actions');
+      const cancel = actionButton('Cancel', () => { editor.remove(); (mode === 'rename' ? rename : remove).focus(); });
+      const submit = element('button', `button ${mode === 'rename' ? 'outline' : 'primary'}`, mode === 'rename' ? 'Save name' : 'Verify & remove');
+      submit.type = 'submit';
+      if (mode === 'rename') {
+        const id = `rename-${credential.id}`;
+        const label = element('label', '', 'Passkey name'); label.htmlFor = id;
+        const input = element('input'); input.id = id; input.name = 'name'; input.value = credential.name; input.required = true; input.maxLength = 60;
+        editor.append(label, input);
+      } else if (data.credentials.length === 1) {
+        editor.append(element('p', '', 'This is your last passkey. Add another one before removing it so you can still sign in.'));
+        submit.hidden = true;
+      } else {
+        editor.append(element('p', '', 'Remove this passkey from your account? It will no longer work for sign-in. You may also need to remove its saved copy from your password manager.'));
