+  event.preventDefault();
+  const profile = Object.fromEntries(new FormData(event.currentTarget));
+  void run(async () => {
+    message('Verify your identity to save your profile…');
+    await authenticate('profile');
+    const data = await api('/api/profile', 'PUT', profile);
+    user = { userId: data.userId, name: data.name, displayName: data.displayName }; updateUser();
+    await signal('signalCurrentUserDetails', { rpId: data.rpId, userId: data.userId, name: data.name, displayName: data.displayName });
+    message('Your profile is up to date.');
+  });
+});
