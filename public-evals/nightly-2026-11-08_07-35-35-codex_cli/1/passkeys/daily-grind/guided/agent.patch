+}));
+async function initialize() {
+  updateButtons();
+  try {
+    if (window.isSecureContext && window.PublicKeyCredential && navigator.credentials) {
+      supported = true;
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      conditionalGet = capabilities.conditionalGet === true;
+      // Older capability implementations report the local authenticator separately.
+      canCreate = conditionalGet && (capabilities.passkeyPlatformAuthenticator ?? capabilities.userVerifyingPlatformAuthenticator) === true;
+    }
+  } catch { supported = false; }
+  if (!supported || !canCreate) {
+    $('#capability-note').textContent = !supported ? 'Passkeys aren’t available here. Open this site over HTTPS in a current browser on a device that supports passkeys.' : 'You can use an existing passkey, but this browser cannot create one here. Try a current browser with a device screen lock enabled.';
+    $('#capability-note').hidden = false;
+  }
+  try {
+    const session = await api('/api/session');
+    serviceReady = true;
+    user = session.user;
+    updateUser();
+    showView(user ? 'security' : 'signin', false);
+  } catch (err) { message(explainError(err), true); }
+  updateButtons();
+}
+void initialize();
+window.addEventListener('pagehide', stopAutofill);
+window.addEventListener('pageshow', event => { if (event.persisted) void initialize(); });
