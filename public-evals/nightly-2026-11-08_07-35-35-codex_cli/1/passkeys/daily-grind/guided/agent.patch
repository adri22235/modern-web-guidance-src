+            await loadManagement();
+            message('Passkey name updated.');
+          } else {
+            await authenticate(`delete:${credential.id}`);
+            const updated = await api(editor.action, 'DELETE', {});
+            renderCredentials(updated);
+            await syncAccepted(updated);
+            message('Passkey removed. Your other passkeys are ready to use.');
+          }
