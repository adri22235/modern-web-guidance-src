+  <script>
+    const gallery = document.querySelector('#gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const nativeSnapChanging = 'onscrollsnapchanging' in gallery;
+    let settleTimer;
+    let pointerDown = false;
+
+    function showPending(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.toggle('pending', items[index] === item);
+      });
+    }
+
+    function selectItem(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        const selected = items[index] === item;
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', selected);
+        if (selected) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function nearestItem() {
+      const left = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      return items.reduce((nearest, item) =>
+        Math.abs(item.getBoundingClientRect().left - left) <
+        Math.abs(nearest.getBoundingClientRect().left - left) ? item : nearest);
+    }
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      if (!pointerDown) selectItem(nearestItem());
+    }
+
+    // Snap events expose the browser's intended destination before scrolling ends.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      if (event.snapTargetInline) showPending(event.snapTargetInline);
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      if (event.snapTargetInline) selectItem(event.snapTargetInline);
+    });
+    gallery.addEventListener('scrollend', finishScroll);
+
+    // Keep feedback working in browsers without CSS Scroll Snap events.
+    gallery.addEventListener('scroll', () => {
+      if (!nativeSnapChanging) showPending(nearestItem());
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }, { passive: true });
+
+    gallery.addEventListener('pointerdown', () => { pointerDown = true; });
+    function releasePointer() {
+      if (!pointerDown) return;
+      pointerDown = false;
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }
+    window.addEventListener('pointerup', releasePointer);
+    window.addEventListener('pointercancel', releasePointer);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const item = items[index];
+        const distance = item.getBoundingClientRect().left -
+          gallery.getBoundingClientRect().left - gallery.clientLeft;
+        if (Math.abs(distance) < 1) {
+          selectItem(item);
+          return;
+        }
+        showPending(item);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + distance,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
+
