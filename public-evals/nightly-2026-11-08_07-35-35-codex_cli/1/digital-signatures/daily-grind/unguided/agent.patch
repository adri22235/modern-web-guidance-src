+const $ = id => document.getElementById(id);
+const encoder = new TextEncoder();
+let mode = 'receipt', signingKeys, signingId, latestDocument = null, database, revision = 0;
+const trusted = new Map();
+const money = value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
+const canonical = value => {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+};
+const toBase64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+const fromBase64 = text => Uint8Array.from(atob(text), char => char.charCodeAt(0));
+async function fingerprint(key) {
+  const jwk = await crypto.subtle.exportKey('jwk', key);
+  const digest = await crypto.subtle.digest('SHA-256', encoder.encode(canonical({ crv: jwk.crv, kty: jwk.kty, x: jwk.x, y: jwk.y })));
+  return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+function status(message, error = false) {
+  $('status').hidden = false;
+  $('status').className = 'status' + (error ? ' error' : '');
+  $('status').textContent = message;
+}
+function store(action, key, value) {
+  return new Promise((resolve, reject) => {
+    const transaction = database.transaction('keys', action === 'get' ? 'readonly' : 'readwrite');
+    const request = action === 'get' ? transaction.objectStore('keys').get(key) : transaction.objectStore('keys').put(value, key);
+    transaction.oncomplete = () => resolve(request.result);
+    transaction.onerror = () => reject(transaction.error);
+    transaction.onabort = () => reject(transaction.error);
+  });
+}
+function download(data, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url; link.download = filename; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+function invalidate() {
+  revision++;
+  latestDocument = null;
+  $('download').disabled = true;
+  $('preview-signature').classList.remove('signed');
+  $('preview-signature').replaceChildren();
+  const icon = document.createElement('span'); icon.textContent = '◇';
+  const text = document.createElement('div'); text.textContent = 'Ready for your signature';
+  const note = document.createElement('small'); note.textContent = 'A little trust, waiting to happen.';
+  text.append(note); $('preview-signature').append(icon, text);
+  $('status').hidden = true;
+}
+function updatePreview() {
+  invalidate();
+  const voucher = mode === 'voucher';
+  const quantity = Number($('quantity').value) || 1;
+  const amount = voucher ? Number($('amount').value) || 0 : Number($('item').value) * quantity;
+  $('preview-kind').textContent = voucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT';
+  $('preview-ref').textContent = '#' + ($('reference').value || 'YOUR-REFERENCE');
+  $('preview-date').textContent = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
+  $('preview-customer').textContent = voucher ? 'For ' + ($('recipient').value || 'someone special') : ($('customer').value || 'A well-deserved coffee break.');
+  $('preview-item').textContent = voucher ? ($('message').value || 'A little coffee, a little joy.') : $('item').selectedOptions[0].textContent + ' × ' + quantity;
+  $('preview-price').textContent = money(amount);
+  $('total-label').textContent = voucher ? 'A gift of' : 'Total paid';
+  $('preview-total').replaceChildren(document.createTextNode(money(amount) + ' '));
+  const currency = document.createElement('small'); currency.textContent = 'USD'; $('preview-total').append(currency);
+}
+function selectTab(tab) {
+  document.querySelectorAll('[data-tab]').forEach(button => {
+    const active = button.dataset.tab === tab;
+    button.classList.toggle('selected', active); button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1;
+  });
+  $('status').hidden = true;
+  $('create-panel').hidden = tab === 'verify'; $('verify-panel').hidden = tab !== 'verify';
+  if (tab === 'verify') return;
+  mode = tab;
+  $('create-panel').setAttribute('aria-labelledby', tab + '-tab');
+  const voucher = tab === 'voucher';
+  $('receipt-fields').hidden = voucher; $('voucher-fields').hidden = !voucher;
+  $('amount').required = voucher;
+  $('quantity').required = !voucher;
+  $('quantity').disabled = voucher; $('amount').disabled = !voucher;
+  $('form-title').textContent = voucher ? 'A little joy, ready to give.' : 'Your coffee, on the record.';
+  $('form-description').textContent = voucher ? 'Make someone’s next coffee break a little sweeter.' : 'The small details of a very good coffee break.';
+  $('sign-label').textContent = voucher ? 'Sign gift voucher' : 'Sign coffee receipt';
+  updatePreview();
+}
+document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => selectTab(button.dataset.tab)));
+document.querySelector('.tabs').addEventListener('keydown', event => {
+  const tabs = [...document.querySelectorAll('[data-tab]')];
+  const index = tabs.indexOf(document.activeElement);
+  let next;
+  if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+  if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
+  if (event.key === 'Home') next = 0;
+  if (event.key === 'End') next = tabs.length - 1;
+  if (next !== undefined) { event.preventDefault(); tabs[next].click(); tabs[next].focus(); }
+});
+$('sign-form').addEventListener('input', updatePreview);
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const button = event.submitter;
+  if (!signingKeys) return status('Signing is unavailable. Use a secure connection and allow browser storage.', true);
+  button.disabled = true;
+  const signingRevision = revision;
+  try {
+    const payload = {
+      issuer: 'The Daily Grind — browser demonstration', type: mode, reference: $('reference').value.trim(),
+      customer: $('customer').value.trim(), issuedAt: new Date().toISOString(), currency: 'USD',
+      documentId: crypto.randomUUID(), redeemable: false
+    };
+    if (!payload.reference) throw new Error('Please enter an order reference.');
+    if (mode === 'voucher') {
+      payload.amountCents = Math.round(Number($('amount').value) * 100);
+      if (!Number.isSafeInteger(payload.amountCents) || payload.amountCents < 100 || payload.amountCents > 100000) throw new Error('Choose a gift amount between $1 and $1,000.');
+      payload.recipient = $('recipient').value.trim(); payload.message = $('message').value.trim();
+    } else {
+      const quantity = Number($('quantity').value);
+      if (!Number.isInteger(quantity) || quantity < 1 || quantity > 99) throw new Error('Choose a quantity from 1 to 99.');
+      payload.items = [{ name: $('item').selectedOptions[0].textContent, quantity, unitPriceCents: Math.round(Number($('item').value) * 100) }];
+      payload.amountCents = payload.items[0].unitPriceCents * quantity;
+    }
+    const envelope = { format: 'daily-grind/v1', algorithm: 'ECDSA-P256-SHA256', keyId: signingId, payload };
+    const signature = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, signingKeys.privateKey, encoder.encode(canonical(envelope)));
+    if (revision !== signingRevision) {
+      status('Your details changed while signing. Sign again to protect the updated document.');
+      return;
+    }
+    latestDocument = { ...envelope, signature: toBase64(signature) };
+    $('download').disabled = false;
+    $('preview-signature').classList.add('signed');
+    $('preview-signature').firstElementChild.textContent = '✓';
+    const description = $('preview-signature').lastElementChild;
+    description.replaceChildren(document.createTextNode('Digitally signed'));
+    const note = document.createElement('small'); note.textContent = 'ECDSA P-256 · Every detail protected.'; description.append(note);
+    status('Signed successfully. Download your document to save or share it.');
+  } catch (error) { status(error.message || 'Could not sign this document.', true); }
+  finally { button.disabled = false; }
+});
+$('download').addEventListener('click', () => {
+  if (latestDocument) download(latestDocument, `daily-grind-${latestDocument.payload.type}-${latestDocument.payload.documentId}.json`);
+});
+$('export-key').addEventListener('click', async () => {
+  try {
+    if (!signingKeys) throw new Error('Your signing key is not available.');
+    download({ format: 'daily-grind-public-key/v1', keyId: signingId, publicKey: await crypto.subtle.exportKey('jwk', signingKeys.publicKey) }, 'daily-grind-public-key.json');
+  } catch (error) { status(error.message, true); }
+});
+async function readJsonFile(file) {
+  if (!file) throw new Error('Choose a JSON file first.');
+  if (file.size > 100000) throw new Error('Choose a document smaller than 100 KB.');
+  return file.text();
+}
+$('import-key').addEventListener('change', async event => {
+  try {
+    const data = JSON.parse(await readJsonFile(event.target.files[0]));
+    if (data.format !== 'daily-grind-public-key/v1' || !data.publicKey || data.publicKey.d || data.publicKey.kty !== 'EC' || data.publicKey.crv !== 'P-256') throw new Error('Choose a Daily Grind P-256 public key file.');
+    const key = await crypto.subtle.importKey('jwk', data.publicKey, { name: 'ECDSA', namedCurve: 'P-256' }, true, ['verify']);
+    const id = await fingerprint(key);
+    if (id !== data.keyId) throw new Error('The public key fingerprint does not match this file.');
+    const saved = await store('get', 'trusted') || {};
+    saved[id] = key; await store('put', 'trusted', saved); trusted.set(id, key);
+    status('Trusted public key imported: ' + id + '. Only trust keys obtained directly from the issuer.');
+  } catch (error) { status(error instanceof SyntaxError ? 'This file is not valid JSON.' : error.message, true); }
+  finally { event.target.value = ''; }
+});
+$('verify-file').addEventListener('change', async event => {
+  try { $('verify-json').value = await readJsonFile(event.target.files[0]); await verify(); }
+  catch (error) { status(error.message, true); }
+});
+$('verify-button').addEventListener('click', verify);
+async function verify() {
+  try {
+    const raw = $('verify-json').value;
+    if (!raw.trim()) throw new Error('Upload or paste a signed document first.');
+    if (raw.length > 100000) throw new Error('Choose a document smaller than 100 KB.');
+    const data = JSON.parse(raw);
+    if (!data || data.format !== 'daily-grind/v1' || data.algorithm !== 'ECDSA-P256-SHA256' || typeof data.signature !== 'string' || typeof data.keyId !== 'string' || !data.payload || !['receipt', 'voucher'].includes(data.payload.type)) throw new Error('This is not a supported signed Daily Grind document.');
+    if (Object.keys(data).sort().join(',') !== 'algorithm,format,keyId,payload,signature') throw new Error('Unexpected fields in this signed document.');
+    const key = trusted.get(data.keyId);
+    if (!key) throw new Error('Unknown signing key. Import the issuer’s public key from a trusted source before verifying.');
+    const { signature, ...envelope } = data;
+    const valid = await crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, fromBase64(signature), encoder.encode(canonical(envelope)));
+    if (!valid) throw new Error('Signature invalid. This document has changed or was not signed by the trusted key.');
+    status(`Signature verified. This ${data.payload.type} is intact and matches trusted key ${data.keyId.slice(0, 16)}… Reference: ${data.payload.reference}. This confirms integrity and key ownership, not payment or voucher redemption.`);
+  } catch (error) { status(error instanceof SyntaxError ? 'This document is not valid JSON.' : error.message || 'Unable to verify this document.', true); }
+}
+document.querySelectorAll('[data-coffee]').forEach(button => button.addEventListener('click', () => {
+  selectTab('receipt'); $('item').value = button.dataset.coffee; updatePreview(); $('studio').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
+}));
+async function initialize() {
+  $('sign-form').querySelector('button[type="submit"]').disabled = true;
+  $('export-key').disabled = true;
+  selectTab('receipt');
+  try {
+    if (!globalThis.isSecureContext || !crypto.subtle) throw new Error('Digital signing needs HTTPS or localhost with Web Crypto support.');
+    database = await new Promise((resolve, reject) => {
+      const request = indexedDB.open('daily-grind-keys', 1);
+      request.onupgradeneeded = () => request.result.createObjectStore('keys');
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(new Error('Allow browser storage to keep your signing key.'));
+    });
+    // A write transaction prevents simultaneous tabs from replacing the initial identity.
+    signingKeys = await store('get', 'identity');
+    if (!signingKeys) {
+      const generated = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+      signingKeys = await new Promise((resolve, reject) => {
+        const transaction = database.transaction('keys', 'readwrite');
+        const keys = transaction.objectStore('keys');
+        let identity;
+        const request = keys.get('identity');
+        request.onsuccess = () => { identity = request.result || generated; if (!request.result) keys.put(identity, 'identity'); };
+        transaction.oncomplete = () => resolve(identity);
+        transaction.onerror = () => reject(transaction.error);
+      });
+    }
+    signingId = await fingerprint(signingKeys.publicKey);
+    trusted.set(signingId, signingKeys.publicKey);
+    const saved = await store('get', 'trusted') || {};
+    Object.entries(saved).forEach(([id, key]) => trusted.set(id, key));
+    $('key-info').textContent = 'ECDSA P-256 · Key ' + signingId.slice(0, 20) + '… · Stored only on this device';
+    $('key-info').title = signingId;
+    $('sign-form').querySelector('button[type="submit"]').disabled = false;
+    $('export-key').disabled = false;
+  } catch (error) {
+    signingKeys = null;
+    $('key-info').textContent = 'Signing unavailable'; status(error.message || 'Your browser could not initialize secure signing.', true);
+  }
+}
+initialize();
