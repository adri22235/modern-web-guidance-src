diff --git a/tests/signatures.test.mjs b/tests/signatures.test.mjs
new file mode 100644
index 0000000..4ac71bb
--- /dev/null
+++ b/tests/signatures.test.mjs
@@ -0,0 +1,39 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createIssuer, signDocument, verifyDocument, exportPublicKey, importPublicKey } from '../js/signatures.mjs';
+
+const doc = { type: 'receipt', issuer: 'Daily Grind · local issuer', id: 'DG-test', recipient: 'Alex ☕', description: 'Maple Oat Latte × 1', amountCents: 550, currency: 'USD', issuedAt: new Date().toISOString() };
+
+test('receipts and vouchers verify after public-key export/import; private key is non-exportable', async () => {
+  const issuer = await createIssuer();
+  assert.equal(issuer.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('pkcs8', issuer.privateKey));
+  const trusted = await importPublicKey(JSON.parse(JSON.stringify(exportPublicKey(issuer))));
+  for (const type of ['receipt', 'voucher']) {
+    const payload = { ...doc, type };
+    const envelope = await signDocument(issuer, payload);
+    assert.deepEqual(await verifyDocument(trusted, JSON.parse(JSON.stringify(envelope))), payload);
+  }
+});
+
+test('rejects altered amounts, document types, signatures, keys, and missing trust', async () => {
+  const issuer = await createIssuer();
+  const envelope = await signDocument(issuer, doc);
+  await assert.rejects(verifyDocument(null, envelope), /trusted/);
+  await assert.rejects(verifyDocument(await createIssuer(), envelope), /Unknown issuer/);
+  for (const altered of [{ ...doc, amountCents: 50000 }, { ...doc, type: 'voucher' }]) {
+    await assert.rejects(verifyDocument(issuer, { ...envelope, payload: JSON.stringify(altered) }), /Signature invalid/);
+  }
+  await assert.rejects(verifyDocument(issuer, { ...envelope, signature: 'AAAA' }), /Signature invalid/);
+  await assert.rejects(verifyDocument(issuer, { ...envelope, suite: 'none' }), /Unsupported/);
+  await assert.rejects(importPublicKey({ ...exportPublicKey(issuer), keyId: 'forged' }), /fingerprint/);
+});
+
+test('rejects malformed documents and invalid monetary values', async () => {
+  const issuer = await createIssuer();
+  for (const amountCents of [-1, 0, 1.1, 100001, NaN]) {
+    await assert.rejects(signDocument(issuer, { ...doc, amountCents }), /Invalid/);
+  }
+  await assert.rejects(signDocument(issuer, { ...doc, recipient: '' }), /Invalid/);
+  await assert.rejects(verifyDocument(issuer, { version: 1, suite: 'ECDSA-P256-SHA256', payload: null }), /Unsupported/);
+});
