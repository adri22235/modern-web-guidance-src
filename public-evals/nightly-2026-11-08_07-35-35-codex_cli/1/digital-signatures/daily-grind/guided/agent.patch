--- /dev/null
+++ b/js/app.mjs
@@ -0,0 +1,198 @@
+import { createIssuer, exportPublicKey, importPublicKey, signDocument, verifyDocument } from './signatures.mjs';
+
+const $ = id => document.getElementById(id);
+const form = $('document-form');
+let issuer;
+let trusted;
+let signed;
+let busy = false;
+let revision = 0;
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const setText = (id, value) => { $(id).textContent = value; };
+function status(message, state = '') {
+  setText('status', message);
+  $('status').dataset.state = state;
+}
+function type() { return new FormData(form).get('type'); }
+function showMode(mode) {
+  const create = mode === 'create';
+  $('create-panel').hidden = !create;
+  $('verify-panel').hidden = create;
+  $('create-mode').setAttribute('aria-pressed', String(create));
+  $('verify-mode').setAttribute('aria-pressed', String(!create));
+  if (create) updateDraft();
+  status(create ? 'Create and sign a document with your local issuer key.' : 'Choose a signed document. Verification uses the trusted key shown in issuer settings.');
+}
+$('create-mode').addEventListener('click', () => showMode('create'));
+$('verify-mode').addEventListener('click', () => showMode('verify'));
+
+function preview(doc, state = 'LIVE PREVIEW') {
+  setText('preview-type', doc.type === 'voucher' ? 'Gift voucher' : 'Coffee receipt');
+  setText('preview-recipient', doc.recipient || 'Your customer');
+  setText('preview-description', doc.description || 'A little everyday goodness');
+  setText('preview-amount', money(doc.amountCents || 0));
+  setText('preview-line-price', money(doc.amountCents || 0));
+  setText('preview-id', doc.id || 'DG — — — —');
+  setText('preview-date', doc.issuedAt ? new Date(doc.issuedAt).toLocaleString() : 'Made with care, just for you');
+  setText('preview-state', state);
+}
+function draft() {
+  return { type: type(), recipient: $('recipient').value.trim(), description: $('description').value.trim(), amountCents: Math.round(Number($('amount').value) * 100) };
+}
+function updateDraft() {
+  revision++;
+  signed = undefined;
+  $('download').disabled = true;
+  $('use-document').disabled = true;
+  const voucher = type() === 'voucher';
+  setText('sign-button', voucher ? 'Sign this voucher ↗' : 'Sign this receipt ↗');
+  $('description-label').firstChild.textContent = voucher ? 'Gift message ' : 'Order details ';
+  preview(draft());
+  setText('stamp-title', 'A signature of care.');
+  setText('stamp-copy', 'Your digital signature will appear here.');
+  status('Preview updated. Sign to protect these details.');
+}
+form.addEventListener('input', updateDraft);
+form.addEventListener('change', event => {
+  if (event.target.name === 'type') {
+    const voucher = type() === 'voucher';
+    $('description').value = voucher ? 'A coffee break, on me. Enjoy!' : 'Maple Oat Latte × 1';
+    $('amount').value = voucher ? '25.00' : '5.50';
+    updateDraft();
+  }
+});
+function showTrusted() {
+  setText('trusted-id', trusted ? `Trusted verification key (SHA-256): ${trusted.keyId}` : 'No verification key selected.');
+}
+async function run(task) {
+  if (busy) return;
+  busy = true;
+  const buttons = [$('sign-button'), $('verify-form').querySelector('button'), $('export-key')];
+  buttons.forEach(button => { button.disabled = true; });
+  try { await task(); }
+  catch (error) { status(error instanceof Error ? error.message : 'The operation failed. Please try again.', 'error'); }
+  finally {
+    busy = false;
+    $('sign-button').disabled = false;
+    $('verify-form').querySelector('button').disabled = false;
+    $('export-key').disabled = !issuer;
+  }
+}
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  run(async () => {
+    const current = revision;
+    const doc = { ...draft(), issuer: 'Daily Grind · local issuer', currency: 'USD', id: `DG-${crypto.randomUUID()}`, issuedAt: new Date().toISOString() };
+    status('Creating your digital signature…');
+    if (!issuer) {
+      issuer = await createIssuer();
+      if (!trusted) trusted = issuer;
+      setText('key-id', `Local issuer key (SHA-256): ${issuer.keyId}`);
+      showTrusted();
+    }
+    const result = await signDocument(issuer, doc);
+    if (current !== revision) { status('Details changed while signing. Sign again to use the latest details.'); return; }
+    signed = result;
+    preview(doc, 'DIGITALLY SIGNED');
+    setText('stamp-title', 'Digitally signed. Details protected.');
+    setText('stamp-copy', `ECDSA P-256 · Key ${issuer.keyId.slice(0, 12)}…`);
+    $('download').disabled = false;
+    $('use-document').disabled = false;
+    status(`${doc.type === 'voucher' ? 'Gift voucher' : 'Receipt'} signed. Download the document and public key to keep a verifiable record.`, 'success');
+  });
+});
+function download(data, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download').addEventListener('click', () => {
+  if (signed) download(signed, `${JSON.parse(signed.payload).id}.json`);
+});
+$('export-key').addEventListener('click', () => {
+  if (issuer) download(exportPublicKey(issuer), `daily-grind-public-key-${issuer.keyId.slice(0, 12)}.json`);
+});
+$('use-document').addEventListener('click', () => {
+  if (!signed) return;
+  $('verify-json').value = JSON.stringify(signed, null, 2);
+  showMode('verify');
+  $('verify-json').focus();
+});
+async function readJSONFile(input) {
+  const file = input.files[0];
+  if (!file) return null;
+  if (file.size > 40000) throw new Error('Choose a JSON file smaller than 40 KB.');
+  return file.text();
+}
+$('document-file').addEventListener('change', () => run(async () => {
+  signed = undefined;
+  $('download').disabled = true;
+  $('use-document').disabled = true;
+  setText('preview-state', 'AWAITING VERIFICATION');
+  setText('stamp-title', 'Verification needed.');
+  setText('stamp-copy', 'Select Verify signature to check the uploaded document.');
+  $('verify-json').value = '';
+  const text = await readJSONFile($('document-file'));
+  if (text === null) return;
+  JSON.parse(text);
+  $('verify-json').value = text;
+  status('Document loaded. Select Verify signature to check it.');
+}));
+$('key-file').addEventListener('change', () => run(async () => {
+  const text = await readJSONFile($('key-file'));
+  if (text === null) return;
+  trusted = await importPublicKey(JSON.parse(text));
+  showTrusted();
+  setText('preview-state', 'KEY CHANGED');
+  setText('stamp-title', 'Ready for a fresh verification.');
+  setText('stamp-copy', 'Verify your document against the newly selected key.');
+  status('Verification key imported. Check the full fingerprint with the issuer through a trusted channel before relying on it.');
+}));
+$('verify-json').addEventListener('input', () => {
+  signed = undefined;
+  $('download').disabled = true;
+  $('use-document').disabled = true;
+  $('verify-json').removeAttribute('aria-invalid');
+  setText('preview-state', 'AWAITING VERIFICATION');
+  setText('stamp-title', 'Verification needed.');
+  setText('stamp-copy', 'Select Verify signature to check the current document.');
+  status('Document changed. Verify it again to check the signature.');
+});
+$('verify-form').addEventListener('submit', event => {
+  event.preventDefault();
+  run(async () => {
+    signed = undefined;
+    $('download').disabled = true;
+    $('use-document').disabled = true;
+    setText('preview-state', 'CHECKING');
+    setText('stamp-title', 'Checking signature…');
+    setText('stamp-copy', 'Comparing with your trusted public key.');
+    const source = $('verify-json').value;
+    const key = trusted;
+    try {
+      const envelope = JSON.parse(source);
+      const doc = await verifyDocument(key, envelope);
+      if (source !== $('verify-json').value || key !== trusted) throw new Error('The document or key changed. Verify again.');
+      preview(doc, 'SIGNATURE VERIFIED');
+      signed = envelope;
+      $('download').disabled = false;
+      $('use-document').disabled = false;
+      setText('stamp-title', 'Signature verified. Details intact.');
+      setText('stamp-copy', `Matches trusted key ${key.keyId.slice(0, 12)}…`);
+      status(`Valid signature: ${doc.type === 'voucher' ? 'gift voucher' : 'receipt'} for ${doc.recipient}, ${money(doc.amountCents)}. This confirms integrity and your trusted key, not payment or redemption.`, 'success');
+    } catch (error) {
+      $('verify-json').setAttribute('aria-invalid', 'true');
+      setText('preview-state', 'NOT VERIFIED');
+      setText('stamp-title', 'Document could not be verified.');
+      setText('stamp-copy', 'Check the signed document and your trusted issuer key.');
+      throw error;
+    }
+  });
+});
+if (!globalThis.isSecureContext || !globalThis.crypto?.subtle) {
+  status('Digital signatures require a secure HTTPS connection and a browser with Web Crypto support.', 'error');
+  document.querySelectorAll('.workspace button, .workspace input, .workspace textarea').forEach(control => { control.disabled = true; });
+}
diff --git a/js/signatures.mjs b/js/signatures.mjs
new file mode 100644
index 0000000..a2c7b66
--- /dev/null
+++ b/js/signatures.mjs
@@ -0,0 +1,77 @@
+const encoder = new TextEncoder();
+const suite = 'ECDSA-P256-SHA256';
+const params = { name: 'ECDSA', hash: 'SHA-256' };
+const domain = 'daily-grind/document/v1';
+
+export function toBase64(bytes) {
+  return btoa(String.fromCharCode(...new Uint8Array(bytes)));
+}
+
+function fromBase64(value) {
+  if (typeof value !== 'string' || value.length > 20000) throw new Error('Invalid encoded data.');
+  return Uint8Array.from(atob(value), c => c.charCodeAt(0));
+}
+
+async function fingerprint(bytes) {
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), b => b.toString(16).padStart(2, '0')).join('');
+}
+
+function frame(payload) {
+  // A length-prefixed application domain separates these signatures from other protocols.
+  const context = encoder.encode(domain);
+  const bytes = encoder.encode(payload);
+  const result = new Uint8Array(1 + context.length + bytes.length);
+  result[0] = context.length;
+  result.set(context, 1);
+  result.set(bytes, 1 + context.length);
+  return result;
+}
+
+export async function createIssuer() {
+  const pair = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+  const spki = await crypto.subtle.exportKey('spki', pair.publicKey);
+  return { privateKey: pair.privateKey, publicKey: pair.publicKey, keyId: await fingerprint(spki), spki: toBase64(spki) };
+}
+
+export function exportPublicKey(issuer) {
+  return { version: 1, suite, keyId: issuer.keyId, spki: issuer.spki };
+}
+
+export async function importPublicKey(data) {
+  if (data.version !== 1 || data.suite !== suite) throw new Error('Unsupported public key format.');
+  const bytes = fromBase64(data.spki);
+  const keyId = await fingerprint(bytes);
+  if (keyId !== data.keyId) throw new Error('Public key fingerprint does not match.');
+  const publicKey = await crypto.subtle.importKey('spki', bytes, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+  return { publicKey, keyId, spki: data.spki };
+}
+
+function validateDocument(doc) {
+  if (!doc || doc.issuer !== 'Daily Grind · local issuer' || !['receipt', 'voucher'].includes(doc.type) ||
+      typeof doc.id !== 'string' || !doc.id || typeof doc.description !== 'string' || !doc.description ||
+      typeof doc.recipient !== 'string' || !doc.recipient || doc.currency !== 'USD' ||
+      !Number.isSafeInteger(doc.amountCents) || doc.amountCents < 1 || doc.amountCents > 100000 ||
+      typeof doc.issuedAt !== 'string' || !Number.isFinite(Date.parse(doc.issuedAt))) {
+    throw new Error('Invalid receipt or voucher details.');
+  }
+}
+
+export async function signDocument(issuer, doc) {
+  validateDocument(doc);
+  const payload = JSON.stringify(doc);
+  const signature = await crypto.subtle.sign(params, issuer.privateKey, frame(payload));
+  return { version: 1, suite, keyId: issuer.keyId, payload, signature: toBase64(signature) };
+}
+
+export async function verifyDocument(trusted, envelope) {
+  if (!trusted) throw new Error('Import a trusted issuer public key first, or sign a document in this session.');
+  if (envelope.version !== 1 || envelope.suite !== suite || typeof envelope.payload !== 'string' || envelope.payload.length > 20000) {
+    throw new Error('Unsupported signed document format.');
+  }
+  if (envelope.keyId !== trusted.keyId) throw new Error('Unknown issuer. This document does not match your trusted key.');
+  const valid = await crypto.subtle.verify(params, trusted.publicKey, fromBase64(envelope.signature), frame(envelope.payload));
+  if (!valid) throw new Error('Signature invalid. The document was changed or signed by a different key.');
+  const doc = JSON.parse(envelope.payload);
+  validateDocument(doc);
+  return doc;
+}
