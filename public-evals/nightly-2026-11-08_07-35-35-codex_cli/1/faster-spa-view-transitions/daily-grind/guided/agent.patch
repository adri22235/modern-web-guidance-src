+(() => {
+  // The cache is bounded to these five static views. Never replace their DOM.
+  const views = new Map(
+    [...document.querySelectorAll('.spa-view')].map(view => [view.dataset.route, view])
+  );
+  const navigationLinks = document.querySelectorAll('nav a[href^="#/"]');
+  let currentRoute;
+
+  function showRoute({ initial = false } = {}) {
+    const route = location.hash.slice(1).replace(/\/$/, '') || '/';
+    const nextRoute = views.has(route) ? route : '/';
+    if (currentRoute === nextRoute) return;
+
+    const nextView = views.get(nextRoute);
+    // Release focus before making its previous container inaccessible.
+    if (!initial && document.activeElement instanceof HTMLElement) {
+      document.activeElement.blur();
+    }
+    for (const [viewRoute, view] of views) {
+      const inactive = viewRoute !== nextRoute;
+      view.classList.toggle('inactive', inactive);
+      view.toggleAttribute('inert', inactive);
+      if (inactive) view.setAttribute('aria-hidden', 'true');
+      else view.removeAttribute('aria-hidden');
+    }
+    for (const link of navigationLinks) {
+      if (link.hash.slice(1) === nextRoute) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+    document.title = nextRoute === '/'
+      ? 'The Daily Grind | Artisanal Coffee'
+      : `${nextView.querySelector('h1').textContent} | The Daily Grind`;
+    currentRoute = nextRoute;
+    if (!initial) {
+      const heading = nextView.querySelector('h1');
+      heading.tabIndex = -1;
+      heading.focus();
+      window.scrollTo(0, 0);
+    }
+  }
+
+  // Native hash links retain modifier-click behavior and browser history, and
+  // work on static hosts without requiring a server-side route fallback.
+  window.addEventListener('hashchange', () => showRoute());
+  showRoute({ initial: true });
+
+  const menuSearch = document.getElementById('menu-search');
+  const menuItems = [...document.querySelectorAll('[data-menu-item]')];
+  menuSearch.addEventListener('input', () => {
+    const query = menuSearch.value.trim().toLocaleLowerCase();
+    let count = 0;
+    for (const item of menuItems) {
+      item.hidden = !item.textContent.toLocaleLowerCase().includes(query);
+      if (!item.hidden) count++;
+    }
+    document.getElementById('menu-status').textContent = query
+      ? `${count} ${count === 1 ? 'drink' : 'drinks'} found.`
+      : '';
+  });
+})();
