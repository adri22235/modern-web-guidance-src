+(() => {
+  const outlet = document.querySelector('#views');
+  const views = new Map([['home', outlet.querySelector('[data-view="home"]')]]);
+  const routes = new Map([
+    ['/', 'home'], ['/menu', 'menu'], ['/locations', 'locations'],
+    ['/rewards', 'rewards'], ['/account', 'account'],
+  ]);
+  const titles = { home: 'Artisanal Coffee', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+  const scrollPositions = new Map();
+  let activeView;
+
+  function getView(name) {
+    if (!views.has(name)) {
+      // Mount once. Hidden views retain their DOM, listeners, and user input.
+      const fragment = document.querySelector(`#view-${name}`).content.cloneNode(true);
+      const view = fragment.firstElementChild;
+      view.hidden = true;
+      outlet.append(fragment);
+      initializeView(name, view);
+      views.set(name, view);
+    }
+    return views.get(name);
+  }
+
+  function initializeView(name, view) {
+    if (name === 'menu') {
+      view.querySelector('[data-menu-search]').addEventListener('input', (event) => {
+        const query = event.target.value.trim().toLowerCase();
+        const drinks = [...view.querySelectorAll('[data-drink]')];
+        drinks.forEach((drink) => { drink.hidden = !drink.textContent.toLowerCase().includes(query); });
+        view.querySelector('[data-menu-empty]').hidden = drinks.some((drink) => !drink.hidden);
+      });
+    }
+    if (name === 'locations') {
+      view.querySelector('[data-location-filter]').addEventListener('change', (event) => {
+        view.querySelectorAll('[data-neighborhood]').forEach((location) => {
+          location.hidden = event.target.value !== 'all' && location.dataset.neighborhood !== event.target.value;
+        });
+      });
+    }
+    if (name === 'account') {
+      view.querySelector('form').addEventListener('submit', (event) => {
+        event.preventDefault();
+        view.querySelector('[data-account-status]').textContent = 'Preferences saved for this visit.';
+      });
+    }
+  }
+
+  function navigate() {
+    const path = window.location.hash.slice(1) || '/';
+    const name = routes.get(path) || 'home';
+    if (name === activeView) return;
+    if (activeView) {
+      scrollPositions.set(activeView, window.scrollY);
+      views.get(activeView).hidden = true;
+    }
+    const view = getView(name);
+    view.hidden = false;
+    const isNavigation = activeView !== undefined;
+    activeView = name;
+    document.title = `The Daily Grind | ${titles[name]}`;
+    document.querySelectorAll('nav a').forEach((link) => {
+      if (link.getAttribute('href') === `#${path}` && routes.has(path)) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+    if (isNavigation) {
+      const heading = view.querySelector('h1');
+      heading.setAttribute('tabindex', '-1');
+      heading.focus({ preventScroll: true });
+    }
+    window.scrollTo({ top: scrollPositions.get(name) || 0, behavior: 'instant' });
+  }
+
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', navigate);
+  navigate();
+})();
