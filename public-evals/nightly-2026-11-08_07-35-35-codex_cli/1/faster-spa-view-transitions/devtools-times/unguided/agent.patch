diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..fb4f41c
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,63 @@
+import { swapFunctions } from "astro:transitions/client";
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Keep the active view and up to four recently visited views. Keeping inactive
+// views connected also keeps their Astro islands mounted until eviction.
+const MAX_VIEWS = 5;
+const ROOT = "main[data-view-cache]";
+
+document.addEventListener("astro:before-swap", (event) => {
+  const transition = event as TransitionBeforeSwapEvent;
+  const currentRoot = document.querySelector<HTMLElement>(ROOT);
+  const nextRoot = transition.newDocument.querySelector<HTMLElement>(ROOT);
+  const incoming = nextRoot?.querySelector<HTMLElement>("[data-page-view]");
+
+  // Leave navigation to pages without this layout to Astro's normal swap.
+  if (!currentRoot || !nextRoot || !incoming) return;
+
+  transition.swap = () => {
+    const newDocument = transition.newDocument;
+
+    // Do this before transferring the incoming view out of the parsed document,
+    // so Astro can still deduplicate its scripts against previously run scripts.
+    swapFunctions.deselectScripts(newDocument);
+
+    const views = Array.from(currentRoot.children) as HTMLElement[];
+    const cacheable = incoming.dataset.cacheView === "true";
+    const restored = cacheable && transition.navigationType !== "replace"
+      ? views.find((view) => view.dataset.pageView === incoming.dataset.pageView)
+      : undefined;
+
+    for (const view of views) {
+      // Clear cached content at authentication boundaries. A replace navigation
+      // also replaces the destination's cached view with the fresh response.
+      if (
+        !cacheable ||
+        view.dataset.cacheView !== "true" ||
+        (view !== restored && view.dataset.pageView === incoming.dataset.pageView)
+      ) {
+        view.remove();
+      } else {
+        view.hidden = true;
+        view.inert = true;
+      }
+    }
+
+    const active = restored || incoming;
+    active.hidden = false;
+    active.inert = false;
+    // DOM order doubles as the LRU list: the active view is always last.
+    currentRoot.append(active);
+    while (currentRoot.childElementCount > MAX_VIEWS) {
+      currentRoot.firstElementChild?.remove();
+    }
+
+    // Retain Astro's head/title updates, focus handling, media initialization,
+    // and persistent-element transfer while reusing the main view container.
+    swapFunctions.swapRootAttributes(newDocument);
+    swapFunctions.swapHeadElements(newDocument);
+    const restoreFocus = swapFunctions.saveFocus();
+    swapFunctions.swapBodyElement(newDocument.body, document.body);
+    restoreFocus();
+  };
+});
