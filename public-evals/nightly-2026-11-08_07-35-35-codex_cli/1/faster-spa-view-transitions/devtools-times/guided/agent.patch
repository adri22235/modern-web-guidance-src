diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..cc6d6c4
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,79 @@
+// Astro still fetches each destination and updates its head/history normally.
+// Only the page's rendered contents are reused; the header and footer stay fresh.
+export {};
+
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const initialView = document.querySelector<HTMLElement>("[data-view-key]");
+if (initialView?.dataset.viewCacheable === "true") {
+  views.set(initialView.dataset.viewKey!, initialView);
+}
+
+function setInactive(view: HTMLElement, inactive: boolean) {
+  view.classList.toggle("inactive", inactive);
+  view.inert = inactive;
+  if (inactive) view.setAttribute("aria-hidden", "true");
+  else view.removeAttribute("aria-hidden");
+}
+
+document.addEventListener("astro:before-swap", (event) => {
+  const host = document.querySelector<HTMLElement>("[data-view-cache]");
+  const incomingHost = event.newDocument.querySelector<HTMLElement>("[data-view-cache]");
+  const incoming = incomingHost?.querySelector<HTMLElement>("[data-view-key]");
+  if (!host || !incomingHost || !incoming) return;
+
+  const key = event.to.pathname + event.to.search;
+  const current = host.querySelector<HTMLElement>("[data-view-key]:not(.inactive)");
+  const cacheable = incoming.dataset.viewCacheable === "true";
+  // An explicit reload/refresh of the current URL must use the fresh response.
+  const cached = cacheable && current?.dataset.viewKey !== key ? views.get(key) : undefined;
+  const next = cached ?? incoming;
+  const swap = event.swap;
+
+  event.swap = () => {
+    // Do not mutate visible content until Astro actually commits the navigation.
+    const focused = document.activeElement;
+    if (focused instanceof HTMLElement && current?.contains(focused)) {
+      focused.blur();
+    }
+    for (const view of host.querySelectorAll<HTMLElement>("[data-view-key]")) {
+      setInactive(view, true);
+      if (
+        view.dataset.viewCacheable !== "true" ||
+        (view.dataset.viewKey === key && view !== next)
+      ) {
+        views.delete(view.dataset.viewKey!);
+        view.remove();
+      }
+    }
+
+    if (!cached) {
+      // Keep new contents outside the persist placeholder during Astro's swap.
+      // Astro can then initialise fresh islands/media before we move them in.
+      incomingHost.after(incoming);
+      incoming.dataset.viewKey = key;
+    }
+
+    // Touch the destination to maintain least-recently-used insertion order.
+    views.delete(key);
+    if (cacheable) views.set(key, next);
+    while (views.size + (cacheable ? 0 : 1) > MAX_VIEWS) {
+      const oldest = views.keys().next().value!;
+      views.get(oldest)!.remove();
+      views.delete(oldest);
+    }
+
+    swap();
+
+    if (!cached) {
+      // Use an atomic move when available to preserve freshly hydrated state.
+      const parent = host as HTMLElement & {
+        moveBefore?: (node: Node, child: Node | null) => void;
+      };
+      if (parent.moveBefore) parent.moveBefore(next, null);
+      else host.append(next);
+    }
+    setInactive(next, false);
+    next.focus({ preventScroll: true });
+  };
+});
