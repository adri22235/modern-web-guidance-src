+/* Keep inactive DOM and rendering state without contributing to page height. */
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+  block-size: 0;
+  overflow: clip;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  background: none;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
