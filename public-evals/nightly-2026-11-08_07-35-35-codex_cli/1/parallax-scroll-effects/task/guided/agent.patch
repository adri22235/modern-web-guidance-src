+    /* Decorative layers stay static unless motion and timeline support allow it. */
+    .coffee-story {
+      position: relative;
+      isolation: isolate;
+      overflow: clip;
+      display: grid;
+      place-items: center;
+      min-height: 560px;
+      padding: 6rem 24px;
+      background: #21140f;
+      color: #fff8ef;
+      text-align: center;
+    }
+
+    .coffee-story__layer {
+      position: absolute;
+      pointer-events: none;
+    }
+
+    .coffee-story__photo {
+      inset: -64px 0;
+      z-index: -3;
+      --travel: 48px;
+    }
+
+    .coffee-story__photo img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .coffee-story::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      z-index: -2;
+      pointer-events: none;
+      background: linear-gradient(90deg, #21140fe6, #21140fcc, #21140fe6);
+    }
+
+    .coffee-story__halo {
+      width: min(80vw, 620px);
+      aspect-ratio: 1;
+      border: 1px solid #ffcf8c40;
+      border-radius: 50%;
+      box-shadow: 0 0 0 36px #ffcf8c08, 0 0 0 72px #ffcf8c06;
+      z-index: -1;
+      --travel: 80px;
+    }
+
+    .coffee-story__beans {
+      inset: -120px 0;
+      z-index: -1;
+      --travel: 112px;
+    }
+
+    .coffee-story__beans span {
+      position: absolute;
+      width: clamp(28px, 5vw, 64px);
+      aspect-ratio: 0.7;
+      border-radius: 50%;
+      background: linear-gradient(100deg, #885234 44%, #29180f 47%, #29180f 51%, #a76d43 55%, #57301e);
+      box-shadow: 6px 12px 18px #0005;
+      transform: rotate(-35deg);
+    }
+
+    .coffee-story__beans span:nth-child(1) { left: 6%; top: 30%; }
+    .coffee-story__beans span:nth-child(2) { right: 8%; top: 62%; transform: rotate(30deg); }
+    .coffee-story__beans span:nth-child(3) { right: 18%; top: 17%; transform: rotate(65deg); }
+
+    .coffee-story__copy {
+      max-width: 540px;
+    }
+
+    .coffee-story__eyebrow {
+      color: #ffcf8c;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.2em;
+      text-transform: uppercase;
+    }
+
+    .coffee-story h2 {
+      margin: 1rem 0;
+      font-family: Georgia, 'Times New Roman', serif;
+      font-size: clamp(2rem, 5vw, 3.5rem);
+      line-height: 1.15;
+      text-wrap: balance;
+    }
+
+    .coffee-story__copy > p:last-child {
+      color: #f1e4d6;
+      font-size: 1.05rem;
+    }
+
+    @keyframes coffee-depth {
+      from { transform: translateY(var(--travel)); }
+      to { transform: translateY(calc(-1 * var(--travel))); }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .coffee-story {
+          view-timeline: --coffee-story block;
+        }
+
+        .coffee-story__layer {
+          animation: coffee-depth linear both;
+          /* Keep these after the shorthand, which resets the timeline. */
+          animation-timeline: --coffee-story;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
