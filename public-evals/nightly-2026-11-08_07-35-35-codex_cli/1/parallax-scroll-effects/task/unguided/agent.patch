+    /* Transform-only animations follow this section through the viewport.
+       Overscan on the photo prevents exposed edges at either endpoint. */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-story {
+          view-timeline-name: --coffee-scroll;
